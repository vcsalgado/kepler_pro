<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Campa&#241;as"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="86,52,10,10" brdr="0,5" tit="Campa&#241;as" fnt="Arial,16">		<tab/>		<txt>Sucursal: </txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" tooltip="Sucursal" available="Y" modify="Y"/>		<tab/><br/>					<tab n="1"/><txt clr="0,58,112">Serie:</txt><tab/>		<inp id="input_serie" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  available="S" modify="Y" OnChange="LimpiaDatos()"/>	<sp/>		<img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="buscar_datos()" available="Y" clrBrdr="0,0,0" visible="Y"/>		<br/>			<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" OnEnter="Exit" OnMouseD="Exit" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="80,15" modify="N" nren="fijo">		<col id="clave" name="Clave" OnActive="consulta_adicionales()"/>		<col id="status" name="Status" OnActive="consulta_adicionales()"/>		<col id="descr" name="Descripcion" OnActive="consulta_adicionales()"/>		<col id="fecha" name="Fecha Realizacion" OnActive="consulta_adicionales()" type="date" nc="-1" fmt="DD/MM/CCYY"/>		<col id="tipo" name="Tipo" OnActive="consulta_adicionales()"/>		<col id="orden" name="Orden" OnActive="consulta_adicionales()"/>		<col id="notas" name="Notas" visible="N" OnActive="consulta_adicionales()"/>		<col id="comentarios" name="Comentarios" visible="N" OnActive="consulta_adicionales()"/>		<col id="url" name="URL" visible="N" OnActive="consulta_adicionales()"/>				</tbl> 		<br/>		<tab/><txt clr="0,58,112">Campa&#241;a: </txt>		<inp id="cve_campana" dim="10,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="capital" brdr="0,2"/><tab n="2"/>		<bot id="bot" dim="12,0" brdr="5" text="Actualizar Estatus" tooltip="Actualizar estatus de campa&#241;a" OnEnter="ActualizaCamp()"/>		<br/>		<tab/><txt clr="0,58,112">Notas de la campa&#241;a:</txt><br/><tab/>		<inp id="notas" dim="80,2" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  available="Y" modify="N" type="capital"/>		<br/>		<tab/><txt clr="0,58,112">Comentarios para el cliente:</txt><br/><tab/>		<inp id="comentarios" dim="80,2" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  available="Y" modify="N"/>		<br/>		<tab/><txt clr="0,58,112">URL publicacion boletines:</txt><br/><tab/>		<inp id="url" dim="80,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  available="Y" modify="N"/>		</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,cmd,ok,cuboResultados,mensajeError,sucursal,serie,llamadaPadre;			var usuario, rol_usuario, suc_usuario, asterisco;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								llamadaPadre = frn.param(0);								rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				Inicializa();			}						fun Inicializa(){				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"campanas.Inicializa()");						ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_sucn",getXml(cuboResultados));								if (llamadaPadre &="s"){					sucursal = frP.get("k_sucN", -1, 1);									frn.set("k_sucn",descr_combo("k_sucn",1,sucursal));						serie =  frP.get("serie");					frn.set("input_serie", serie);					frn.setAtt("buscar_datos", "visible", "N");					frn.setAtt("k_sucn", "modify", "N");					frn.setAtt("input_serie", "modify", "N");					buscar_datos();									} else{					frn.set("k_sucn",descr_combo("k_sucn",1,suc_usuario));					frn.setAtt("buscar_datos", "visible", "Y");					frn.setAtt("k_sucn", "modify", "Y");					frn.setAtt("input_serie", "modify", "Y");									}			}					fun buscar_datos() {				LimpiaDatos();				var totresultados , contresultados;				sucursal = frn.get("k_sucn", -1, 1);				serie =  frn.get("input_serie");/*				cmd= "select cpna.c3,cpna.c4,cat.c2,to_char(cpna.c5,'DD/MM/YYYY') as c5 ,cpna.c7,cpna.c8 					from keplersc.kdsercampana as cpna 					inner join keplersc.kdcatcampana as cat on cat.c1=cpna.c3";								cmd= cmd & " where cpna.c1='" & frn.get("input_serie") & "' and cpna.c6='" & sucursal & "'" ;*/							cmd= "select cpna.c3,case when cpna.c4=0 then 'PENDIENTE' when cpna.c4=10 then 'REALIZADA' when cpna.c4=15 then 'OTRO DISTRIBUIDOR' end c4,cat.descripcion,cpna.c5,cpna.c7,cpna.c8, cat.notas, cat.comentarios_cliente, cat.url_boletines 						from keplersc.kdsercampana as cpna 						inner join keplersc.kdsercampanacat as cat on cat.clave_campana=cpna.c3						where cpna.c2='" & frn.get("input_serie") & "'" ;frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmd");				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"campanas.buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								totresultados = nXml(cuboResultados);				if (totresultados > 0){					frn.rst("tabla");					for (contresultados=0; contresultados<totresultados ; contresultados++){									frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"c3"),"tabla",contresultados,"clave");						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"c4"),"tabla",contresultados,"status");						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"descripcion"),"tabla",contresultados,"descr");						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"c5"),"tabla",contresultados,"fecha");							frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"c7"),"tabla",contresultados,"tipo");						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"c8"),"tabla",contresultados,"orden");						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"notas"),"tabla",contresultados,"notas");						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"comentarios_cliente"),"tabla",contresultados,"comentarios");						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"url_boletines"),"tabla",contresultados,"url");					}						frn.set("notas", frn.get("tabla",-1,"notas"));					frn.set("comentarios",frn.get("tabla",-1,"comentarios"));					frn.set("url",frn.get("tabla",-1,"url"));									frn.set("cve_campana", frn.get("tabla",-1,"clave"));				} else{					frn.message("El no. de serie no existe","Atencion","Aceptar");					return;				}			}						fun consulta_adicionales(){				frn.set("cve_campana", frn.get("tabla",-1,"clave"));				frn.set("notas", frn.get("tabla",-1,"notas"));				frn.set("comentarios",frn.get("tabla",-1,"comentarios"));				frn.set("url",frn.get("tabla",-1,"url"));			}						fun ActualizaCamp(){				frn.dialog("actualiza_estatus_campanas",sucursal,serie,frn.get("cve_campana"),"s");			}						fun LimpiaDatos(){				frn.rst("tabla");				frn.set("cve_campana", "");				frn.set("notas", "");				frn.set("comentarios","");				frn.set("url","");			}						fun CambiaSucursal(){				frn.set("input_serie", "");				LimpiaDatos();			}						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}						}	</script></pag>