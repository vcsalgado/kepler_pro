<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Catalogo Refacciones"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="82,50,10,10" brdr="0,5" tit="Refacciones" fnt="Arial,16">		<tab n="7"/><inp id="k_f0" clr="64,64,64"  dim="6,1" available="N" type="string" fnt="Arial,16">Refaccion:</inp>				<inp id="input_ref" dim="23,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><sp n="3"/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		<br/>			<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="76,22" modify="N" nren="fijo">		<col id="ref_clave" name="Clave"/>		<col id="ref_desc" name="Nombre"/>		</tbl>  <br/>		<tab n="7"/>		<bot id="k_btn_nvo" dim="10,10" brdr="5" text="Nuevo" hk="K" default="0" step="0"  OnEnter="abrir_curd(Nuevo)" fnt="Arial,16"/> 		<bot id="k_btn_mod" dim="10,10" brdr="5" text="Modificar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Modificar)" fnt="Arial,16"/> 		<bot id="k_btn_elimnr" dim="10,10" brdr="5" text="Eliminar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Eliminar)" fnt="Arial,16"/> 		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Consultar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Consultar)" fnt="Arial,16"/> <br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("s,KDMS");												}								fun Buscar() {							var xmlRequest,cmd,ok,cuboResultados, totRef , contRef, ref_clave, ref_desc;						var criterio = frn.get("input_ref");							cmd= "select c1,c2 from keplersc.kdini where c1 like upper('%" & criterio & "%') or c2 like upper('%" & criterio & "%')";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_prod_view.Buscar()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								totRef = nXml(cuboResultados);							frn.rst("tabla");				for (contRef=0; contRef<totRef; contRef++){								ref_clave= getXmlAtt(cuboResultados,"r"&contRef,"c1");					ref_desc= getXmlAtt(cuboResultados,"r"&contRef,"c2");									frn.setX(ref_clave,"tabla",contRef,"ref_clave");					frn.setX(ref_desc,"tabla",contRef,"ref_desc");								}							}							fun abrir_curd(accion){							if (accion &! "Nuevo"){									var param = frn.get("tabla", -1, "ref_clave");													if (param &= ""){										frn.message("No has seleccionado refaccion","Error","Aceptar");									}else{										frn.dialog("cat_prod_crud",accion, param,"n","x");					}				}else {									//accion="Nuevo",param="x",externo="n"					frn.dialog("cat_prod_crud", accion,"x","n", "x");									}							}							}	</script></pag>