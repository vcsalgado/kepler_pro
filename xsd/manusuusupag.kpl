<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" dim="0,0,10,10" tit="Cat&#225;logo de usuarios">	<grp id="grpMain" brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="-1,-1,10,20"  clrBrdr="0,97,181"  bclr="192,205,213" unfont="0" tit="Cat&#225;logo de usuarios" OnPgUp="PgUp" OnPgDn="PgDn" OnCtrPgUp="CtrPgUp" OnCtrPgDn="CtrPgDn" OnF1="" OnCtrIni="CtrIni" OnCtrEnd="CtrEnd" OnCtrDel="CtrDel" OnEnter="Exit"><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="58,46,7,12"  tit="Datos del usuario" fnt="Arial,16"><sp/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255" hk="C">Clave</txt><tab n="3"/>				<edt id="clave" clr="64,64,64" clrBrdr="255,255,255"  dim="22,1" type="capital" bclr="255,255,255" brdr="2,0" OnChange="Busca" nc="20" hk="C" OnF9="BusquedaClave()" OnButton="BusquedaClave()" fnt="Arial,16"/><br/><sp/><tab/>			<txt clr="0,58,112" fnt="Arial,16">Nombre</txt><tab n="2"/>				<inp id="nombre" clr="64,64,64" clrBrdr="255,255,255"  dim="62,1" bclr="255,255,255" brdr="2,0" type="string" nc="60" OnChange="Cambio(2,nombre)"/><br/><sp/><tab/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112">Password</txt><tab/>				<inp id="pass" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(3,pass)" nc="15" type="password"/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Perfil</txt>	<tab n="3"/>				<cmb id="perfil" clr="64,64,64" clrBrdr="255,255,255"  dim="30,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(4,perfil)" type="string"/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Activo </txt>			<tab n="2"/>				<chck id="chact" clr="64,64,64"  dim="3,16" bclr="255,255,255" brdr="3,0" OnChange="Cambio(5,chact)" YN="SN" clrBrdr="255,255,255"/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Caducidad</txt><tab/>				<edt id="caducidad" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" type="date" nc="10" OnChange="Cambio(6,caducidad)" OnButton="Dialog(1,_ks_fecha,caducidad)" OnF9="Dialog(1,_ks_fecha,caducidad)"/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Hora</txt>				<inp id="horacaducidad" clr="64,64,64" clrBrdr="255,255,255"  dim="16,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(7,horacaducidad)" nc="-1" type="time" available="Y"/><tab n="2"/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Imagen</txt>			<tab n="2"/>				<inp id="imagen" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" OnChange="ActualizaImagen()" nc="18" type="capital"/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112">Sucursal</txt><tab n="2"/>				<cmb id="sucursal" clr="64,64,64" clrBrdr="255,255,255"  dim="52,36" bclr="255,255,255" brdr="2,0" type="capital" OnChange="Cambio(10,sucursal,1)"/><br/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Email</txt><tab n="3"/>				<inp id="email" clr="64,64,64" clrBrdr="255,255,255"  dim="62,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(9,email)" nc="60" type="string"/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Puesto</txt><tab n="2"/>				<inp id="puesto" clr="64,64,64" clrBrdr="255,255,255"  dim="62,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(11,puesto)" nc="60" type="string"/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Comentarios</txt><tab/>				<inp id="comentarios" clr="64,64,64" clrBrdr="255,255,255"  dim="62,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(12,comentarios)" nc="60" type="string"/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Tel&#233;fonos</txt><tab n="2"/>				<inp id="telefono1" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(13,telefono1)" nc="15" type="string"/><tab/>				<inp id="telefono2" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(14,telefono2)" nc="15" type="string"/><br/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">&#218;ltimo acceso</txt><tab/>				<inp id="ultacc" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" OnChange="Cambio(15,ultacc)" nc="-1" type="date" modify="N"/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Hora</txt><tab/>				<inp id="horaultacc" clr="64,64,64" clrBrdr="255,255,255"  dim="16,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(16,horaultacc)" nc="14" type="string" modify="N"/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255"> Acceso previo</txt><tab/>				<inp id="preacc" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" OnChange="Cambio(17,preacc)" nc="-1" type="date" modify="N"/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Hora</txt><tab/>				<inp id="horapreacc" clr="64,64,64" clrBrdr="255,255,255"  dim="16,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(18,horapreacc)" nc="14" type="string" modify="N"/><br/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Par&#225;metros mail </txt><br/><tab n="2"/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Puerto SMTP</txt><tab/>				<inp id="puertosmtp" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(19,puertosmtp)" nc="15" type="string"/><tab/><br/><tab n="2"/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Servidor SMTP</txt><tab/>				<inp id="servidorsmtp" clr="64,64,64" clrBrdr="255,255,255"  dim="62,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(20,servidorsmtp)" nc="60" type="string"/><br/><tab n="2"/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Remitente</txt><tab n="2"/>				<inp id="remitente" clr="64,64,64" clrBrdr="255,255,255"  dim="62,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(21,remitente)" nc="60" type="string"/><br/><tab n="2"/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Usuario SMTP</txt><tab/>				<inp id="usuariosmtp" clr="64,64,64" clrBrdr="255,255,255"  dim="62,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(22,usuariosmtp)" nc="60" type="string"/><br/><tab n="2"/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Password SMTP</txt><tab/>				<inp id="passsmtp" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(23,passsmtp)" nc="15" type="password"/>		</grp>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="30,20,7,12">			<img id="arch_img" dim="30,180"  brdr="0,1" bPx="0"/>			</grp><br/>		</grp>	<tools>		<tool name="endleft" OnMouseL="CtrIni()" img="_TL_First.png"/>		<tool name="left" OnMouseL="PgUp()" img="_TL_Previous.png"/>		<tool name="right" OnMouseL="PgDn()" img="_TL_Next.png"/>		<tool name="endright" OnMouseL="CtrEnd()" img="_TL_Last.png"/>	</tools>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys;			/* PARÁMETROS (Tienen sentido cuando la opción se ha ejecutado como diálogo.)			Param(0) = Nombre del campo (o tabla) al que se devolverá la clave o descripción en la pantalla padre			Param(1) = (Opcional) Nombre de la columna al que se devolverá la clave en la pantalla padre(Se debe especificar el grid en el parametro anterior)			Param(2) = (Opcional) Bandera binaria de control. Es un string que indica ciertos parámetros de funcionamiento de la opción							Los caracteres se toman de izquierda a derecha y tienen el siguiente significado:							Bit 1= Si toma valor de 1, se devuelve la clave. Si toma valor de 0, se devuelve la descripción. Por default se toma valor de 1.							Bit 2= Si toma valor de 1, permite modificar el catálogo. Si toma valor de 0, no permite modificación. Por default se toma valor de 1.							Bit 3= Si toma valor de 1, permite insertar/borrar registros. Si toma valor de 0, no permite insertar/borrar. Por default se toma valor de 1.							Bit 4= Si toma valor de 1, permite cambiar de registro. Si toma valor de 0, no permite cambiar de registro. Por default se toma valor de 1.							Bit 5= Si toma valor de 1, regresa un cubo de memoria con campos principales de TODOS los registros(para guardar la info en un combo). Si toma valor de 0, solo regresa la clave o descripción. Por default se toma valor de 1.			Param(3) = (Opcional) Función de la pantalla padre a ejecutar antes de regresarle el control.										Valor de retorno = clave o descripción del producto			*/			var bit1,bit2,bit3,bit4,bit5;//Banderas de comportamiento (Ver descripción arriba)			var tabla_base;//Tabla base del catalogo (Se abre con el alias "a")			var camposDeseados;//Campos de la tabla que se requieren(Ej: a1...a4)			fun Main() {				frn=new FRNT; 				frP=new FRNTP; 				kdb=new KDB;				sys=new SYS;				bit1=1;bit2=1;bit3=1;bit4=1;bit5=1;//Inicializa las banderas con los valores default.				var bCtrl=trim(frn.param(2));				if (strlen(bCtrl)>0){ //Se especificó una bandera de control.					bit1=mid(bCtrl,0,1);bit2=mid(bCtrl,1,1);bit3=mid(bCtrl,2,1);					bit4=mid(bCtrl,3,1);bit5=mid(bCtrl,4,1);				}				if (strlen(trim(frn.param(1)))>0){ bit5=0;}//Si se especifica una columna, no se devolverán todos los registros, solo el actual				kdb.connect();				tabla_base="\\\\kdku";//Usuarios				camposDeseados="a1...a30,s2";//Ver el comando kdb.rel de abajo para entender s2				kdb.open("a," & tabla_base);				kdb.open("s,kdms,p,\\\\kdkp");//Sucursales,Movimientos de inventario				kdb.open("w,kdlogmov");				kdb.table("tsucursal,s,1,&,s2,s1");				kdb.table("tperfil,p,1,&,p1");				kdb.exec();				frn.set("sucursal",kdb.get("tsucursal"));				frn.set("perfil",kdb.get("tperfil"));				kdb.rel("s1=a10");//Relaciona las tablas de sucursal con almacen mediante el campo1. (Cuando el campo 1 de almacen cambie, todo el registro de sucursal cambia)				var valor_inicial=(bit1==1)? frP.get(frn.param(0),-1,0): frP.get(frn.param(0),-1,1);				if (strlen(trim(frn.param(1)))>0){ valor_inicial=frP.get(frn.param(0),-1,frn.param(1)); }//Se devolverá el valor a una tabla 				frn.set("clave",valor_inicial);//Se llena la clave si es ventana de diálogo.				Bus(1);				if(bit2==0)deshabilita_campos();			}						fun ActualizaImagen(){				frn.setAtt("arch_img","img",frn.get("imagen"));//Se muestra la imagen				Cambio(8,"imagen");			}			fun BusquedaClave(){				Dialog(1,"busqueda","clave","","\\\\kdku");			}			fun camposLlave() {var llave= frn.get("clave"); 				if (bit4==0){ setmfy("clave"); } //Desactiva los campos de la llave para que no pueda cambiarse de registro				return llave;}//Campos que forman la llave. Puede ser una llave combinada			fun setData(){				set("clave","a1"); set("nombre","a2"); 				set("pass","a3"); 				set("perfil","a4"); 				set("chact","a5"); 				set("caducidad","a6"); 				set("horacaducidad","a7"); 				set("imagen","a8"); 				frn.setAtt("arch_img","img",kdb.get("datos","a8"));//Se muestra la imagen				set("email","a9"); 				set("sucursal","s2");				set("puesto","a11"); 				set("comentarios","a12"); 				set("telefono1","a13"); 				set("telefono2","a14"); 				set("ultacc","a15"); 				set("horaultacc","a16"); 				set("preacc","a17"); 				set("horapreacc","a18"); 				set("puertosmtp","a19"); 				set("servidorsmtp","a20"); 				set("remitente","a21"); 				set("usuariosmtp","a22"); 				set("passsmtp","a23"); 			}			fun verifica_borrar()//Esta función valida si el registro actual se puede borrar. Ej. Un producto NO se puede borrar si hay facturas con ese produccto.			{				//Falta validar que no exista ningun movimiento con este usuario. 				//Error("Existe al menos un movimiento con este usuario, NO es posible borrarlo");return 0;				return frn.message("Está a punto de borrar el usuario " & frn.get("nombre") & ". ¿Desea Continuar?","Precaución",1);//Regresa 1 si se puede borrar. 0 si no.			}			fun deshabilita_campos(){//Deshabilita todos los campos que no sean parte de la llave. Pone invisibles los botones				setmfy("nombre"); setmfy("pass"); setmfy("perfil"); 				setmfy("chact"); setmfy("caducidad"); setmfy("horacaducidad"); setmfy("imagen"); setmfy("email"); 				setmfy("sucursal"); setmfy("puesto"); setmfy("comentarios"); setmfy("telefono1"); setmfy("telefono2"); 				setmfy("ultacc"); setmfy("horaultacc"); setmfy("preacc"); setmfy("horapreacc"); setmfy("puertosmtp"); setmfy("servidorsmtp"); 				setmfy("remitente"); setmfy("usuariosmtp"); setmfy("passsmtp"); 				//Invisbles los botones			}			fun Exit() {				kdb.exec(); //Ejecuta instrucciones pendientes (Cambios)				if (strlen(trim(frn.param(0)))>0){ //Solo si se especificó un campo a devolver los datos 					if(bit5==1){//Se regresará un cubo de memoria con todos los registros (para llenar un combo o una lista)						var cmd="dat1,a,1,&,a1,a2";//Por default se ordena por clave, y el campo visible es la clave(bit1=1)						if(bit1==0) cmd="dat1,a,2,&,a2,a1";//Se ordena por descripción, y el campo visible es la descripción						kdb.table(cmd);kdb.exec();						frP.set(frn.param(0),kdb.get("dat1"));//Se llenan los combos					}					var valor_retorno=frn.get("clave");//Por default se devuelve la clave(bit1=1)					if( bit1==0 ){						valor_retorno=frn.get("nombre");//Se devuelve el nombre					}					if (strlen(trim(frn.param(1)))>0){ //Se devolverá el valor a una tabla 						frP.setX(valor_retorno,trim(frn.param(0)),-1,trim(frn.param(1))); 						frP.scriptElm(frn.param(0),"OnChange",frn.param(1));					}					else{ //se devolverá el valor a un campo						frP.set(frn.param(0),valor_retorno); 						frP.scriptElm(frn.param(0),"OnChange");					}				}				if (strlen(trim(frn.param(3)))>0){ //Se ejecutará la función indicada en la ventana padre.					frP.script(frn.param(3));				}				frn.exit();			}			fun valoresDefault(){				var valores="5,S";//Número_de_campo1,valor_default1[,Número_de_campoN,valor_defaultN,...]				return valores;			}			//Funciones Auxiliares Para Catálogos(Genericas). 			//Necesitan las variable globales tabla_base y camposDeseados. 			//tabla_base especifíca el nombre de la tabla del catálogo que se está editando			//camposDeseados indica los campos que se modificaran de la tabla. Ej a1...a70			//Ademas de una funcion camposLlave que devuleva los campos que forman la clave			//Una funcion setData que establece en pantalla los valores de la base de datos. (Cubo de información: "datos")			//Una funcion verifica_borrar() que regresa 1 si se puede borrar el registro, 0 si no se debe borrar.			fun set(objeto,campo) { frn.set(objeto,kdb.get("datos",campo));}//Establece el valor de un campo de la BD al objeto indicado			fun Busca() {if(bit4==1) Bus(0);}			fun PgUp() {if(bit4==1) Bus(6);}			fun PgDn() {if(bit4==1) Bus(5);}			fun CtrIni() {if(bit4==1) Bus(7);}			fun CtrEnd() {if(bit4==1) Bus(8);}			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}			fun Error(string){frn.messageBar(string,1); frn.sound(1);}//Establece un mensaje de error en la barra de estado. Y emite un sonido de alerta.			fun Bus(relacional) { //1:>=	2:<=		3:>	 4:<		 5:Siguiente		6:Anterior		7:Primero		8:Ultimo				frn.messageBar("");				var cmd="datos,a,1," & relacional & "," & camposLlave() & ",&," & camposDeseados;				kdb.search(cmd); kdb.exec(); setData();			}			fun Cambio(numero_campo,objeto,desplazamiento) { //Realiza un cambio de valor en la BD				if (strlen(frn.get("clave"))==0) {					frn.message("Datos incompletos, favor de verificar");					return;				}else{					if(bit3==0){//No permite insertar nuevos registros						if(kdb.ok("datos")==0){frn.message("No es posible dar de alta nuevos registros","Permisos restringidos");break;}					}					var cmd="datos,a,1," & camposLlave() & ",&," & numero_campo & "," & frn.get(objeto,-1,desplazamiento) & ",&," & valoresDefault() & ",&," & camposDeseados;					//Agrega el LOG				kdb.write("logmov,w,1,'"&strFormat("ucase",frn.config("user","name"))&"','"&sys.date()&"','"&sys.time()&"','"&frn.FileName()&"',&,1,'"&strFormat("ucase",frn.config("user","name"))&"',2,'"&sys.date()&"',3,'"&sys.time()&"',4,'"&frn.FileName()&"',5,'"&numero_campo&"',6,'"&frn.get(objeto,-1,desplazamiento)&"',7,'"&frn.getPrv(objeto,-1,desplazamiento)&"',8,'"&tabla_base&"',9,'"&camposLlave()&"'");					kdb.write(cmd);kdb.exec();setData();				}				}//de la funcion							fun CtrDel() {//Borra el registro actual y devuelve el siguiente				if(bit3==1){					if ( verifica_borrar()==1 ){//Solo borrará el registro si la funcion verifica_borrar devuelve 1. Cada catálogo define su validacion para borrar.						var cmd="datos,a,1," & camposLlave() & ",&," & camposDeseados;						//Agrega LOG						kdb.write("logmov,w,1,'"&strFormat("ucase",frn.config("user","name"))&"','"&sys.date()&"','"&sys.time()&"','"&frn.FileName()&"',&,1,'"&strFormat("ucase",frn.config("user","name"))&"',2,'"&sys.date()&"',3,'"&sys.time()&"',4,'"&frn.FileName()&"',5,BORR,6,'"&camposLlave()&"',8,'"&tabla_base&"'");						kdb.del(cmd); kdb.exec(); 						if(bit4==1)setData();else frn.exit();//Si no se puede posicionar en otro registro, se sale de la opción después de borrar.					}				}			}			fun setmfy(campo,valor){//Modifica el atrbuto modify de cierto objeto(0=no permite modificacion. 1=Permite modificacion)				var atrib=(valor==1)?"Y":"N";				frn.setAtt(campo,"modify",atrib);			}			fun setvbl(campo,valor){//Modifica el atrbuto visible de cierto objeto(0=no lo muestra. 1=si lo muestra)				var atrib=(valor==1)?"Y":"N";				frn.setAtt(campo,"visible",atrib);			}		}		/*		AUTOR							FECHA						CAMBIO		------------------------------------------------------------------------------------------------------------------------------------		EFDA							28/oct/2011					Se abre la tabla kdlogmov con alias w																		Se define la variable sys y su instanciacion de la clase SYS																		Se modifica la funcion Cambio p/escribir a la tabla kdlogmov																		Se modifica la funcion CtrDel p/escribir a la tabla kdlogmov		*/	</script></pag>