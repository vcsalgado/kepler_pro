<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Catalogo de Proveedores"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,14,15" bclr="192,205,213" unfont="0">	<tab/><inp id="k_titulo" dim="35,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"				type="string" modify="N" available="N" fnt="Arial,25"/>	<br/>	<br/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<!-- tit="Catalogo de Autos Alta Nuevo" -->		<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="55,60,15,7" brdr="0,5" tit="Catalogo de Proveedores Alta Nuevo" fnt="Arial,16">			<sp/>				<inp id="clave" dim="15,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,18"/>			<sp/>				<inp id="k_clave" dim="30,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="N" fnt="Arial,18"  nc="7" OnChange="clave_tabla()"/>			<tab/>			<br/>			<sp/>				<inp id="nombre" dim="15,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,18"/>			<sp/>				<inp id="k_nombre" dim="30,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="Y" fnt="Arial,18" nc="90"/>			<br/>			<sp/>				<inp id="direccion" dim="15,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,18"/>			<sp/>				<inp id="k_direccion" dim="30,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="Y" fnt="Arial,18" nc="70"/>			<br/>						<sp/>				<inp id="colonia" dim="15,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,18"/>			<sp/>				<inp id="k_colonia" dim="30,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="Y" fnt="Arial,18" nc="70"/>			<br/>						<sp/>				<inp id="poblacion" dim="15,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,18"/>			<sp/>				<inp id="k_poblacion" dim="30,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="Y" fnt="Arial,18" nc="70"/>			<br/>			<sp/>				<inp id="telefono" dim="15,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,18"/>			<sp/>				<inp id="k_telefono1" dim="30,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="Y" fnt="Arial,18" nc="20"/>			<br/>						<tab n= '5'/><sp n="2"/>				<inp id="k_telefono2" dim="30,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="Y" fnt="Arial,18" nc="20"/>			<br/>			<sp/>				<inp id="fax" dim="15,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,18"/>			<sp/>				<inp id="k_fax" dim="30,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="Y" fnt="Arial,18" nc="20"/>			<sp/>			<br/>			<sp/>				<inp id="rfc" dim="15,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,18"/>			<sp/>				<inp id="k_rfc" dim="30,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="Y" fnt="Arial,18" nc="13"/>			<sp/>			<br/>			<sp/>				<inp id="cp" dim="15,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,18"/>			<sp/>				<inp id="k_cp" dim="30,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="Y" fnt="Arial,18" nc="5"/>			<sp/>			<br/>			<sp/>				<inp id="dir_internet" dim="15,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,18"/>			<sp/>				<!-- "g" Se detecto que este OBJ No es correcto de acuerdo al uso del KPL -->				<inp id="k_dir_internet" dim="30,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="string" modify="N" available="Y" fnt="Arial,18" nc="80"/>			<sp/>			<br/>			<sp/>				<inp id="sol_rfc_cp" dim="15,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,18"/>			<sp/>			<chck id="k_sol_rfc_cp" clr="64,64,64"  dim="3,16" bclr="255,255,255" brdr="1,1" YN="10" clrBrdr="255,255,255" modify="N" available="Y"/>            <br/>			<sp/>				<inp id="limite_credito" dim="15,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,18" visible="Y"/>			<sp/>				<inp id="k_limite_credito" dim="30,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="number" modify="N" available="Y" fnt="Arial,18" nc="15" nd="2" visible="Y"/>			<sp/>						<br/>			<sp/>				<inp id="plazo" dim="15,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,18"/>			<sp/>				<inp id="k_plazo" dim="30,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="number" modify="N" available="Y" fnt="Arial,18" nc="3" nd="0"/>			<sp/> <br/>								<br/><br/>		<tab n="8"/>		<bot id="k_btn_cons" dim="7,10" brdr="5" text="Guardar" hk="K" step="0"  OnEnter="aplica_crud(accion)" fnt="Arial,16"/> <br/>		</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;			var tipoOper,consPlantilla, accion; //Variables relacionadas con parametros (colsulta , eliminar, baja)			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna; 			//Added 20240120 by JMM (Para uso de creacion automatica con datos de UIID)			var UUID_ST, paramRutina;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								accion = frn.param(0);				// Added by JMM 20240120				UUID_ST = 0;				paramRutina = "";				if ( frn.nParam() >= 2 ) {					if ( frn.param(2) &= "UUID" ) { 						UUID_ST = 1; 						if ( frn.nParam() >= 3 ) {							paramRutina = trim(frn.param(3));						}					}				}				ConfiguraUI();								Inicializa();						}		fun aplica_crud(accion){			var query_prov, cuboQuery, resultado, mensaje, mensajeError, query;			accion = frn.param(0);			var k_suc = "01";			var k_clave=frn.get("k_clave");			var k_nombre=frn.get("k_nombre");			var k_desc=frn.get("k_desc");			var k_direccion=frn.get("k_direccion");			var k_colonia=frn.get("k_colonia");			var k_poblacion=frn.get("k_poblacion");			var k_telefono1=frn.get("k_telefono1");			var k_telefono2=frn.get("k_telefono2");			var k_fax=frn.get("k_fax");			var k_rfc=frn.get("k_rfc");			var k_dir_internet=frn.get("k_dir_internet");			var k_cp=frn.get("k_cp");			var k_sol_rfc_cp=frn.get("k_sol_rfc_cp");			var k_limite_credito=frn.get("k_limite_credito");			var k_plazo=frn.get("k_plazo"); // 20240130					if(accion &= "Nuevo"){				if(k_clave &= ""){					frn.message("La clave no puede estar vacia","Mensaje","&Aceptar");					frn.setPos("k_clave");				}else if(k_nombre &= ""){					frn.setPos("k_nombre");					frn.message("El nombre no puede estar vacio","Mensaje","&Aceptar");				}else if(k_rfc &= ""){					frn.setPos("k_rfc");					frn.message("El RFC no puede estar vacio","Mensaje","&Aceptar");				}else /*if(k_cp &= ""){					// Condition Added / Commented by JMM 20240129 ... To check this must be applied  					// for this condition vs everytime					if ( UUID_ST == 1 ) {						frn.setPos("k_cp");						frn.message("El Codigo Postal no puede estar vacio","Mensaje","&Aceptar");					}									}else*/ {					query_prov = "insert into keplersc.kdxd (c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c27, c28)                    values ('"& k_suc &"','"& k_clave &"','"& k_nombre &"','"& k_direccion &"','"& k_colonia &"','"& k_poblacion &"','"& k_telefono1 &"','"& k_telefono2 &"'					,'"& k_fax &"','"& k_rfc &"','"& k_dir_internet &"','"& k_cp &"','"& k_sol_rfc_cp &"')";					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",query_prov,"cat_crud_aplica_crud.guardar()");	                resultado = getXml(cuboQuery,"resultado");					if(resultado &= "0"){							mensajeError = getXml(cuboQuery ,"mensaje");				        frn.message(mensajeError,"Error","Aceptar");				        return;				    }else{						mensaje = "Registro de Proveedor "& k_clave &" Generado con Exito";						frn.dialog("cat_crud_proveedores","Consultar", k_clave); 						frn.exit();							Inicializa();					}				}			}else if(accion &= "Modificar"){				if(k_clave &= ""){					frn.message("La clave no puede estar vacia","Mensaje","&Aceptar");					frn.setPos("k_clave");				}else if(k_nombre &= ""){					frn.setPos("k_nombre");					frn.message("El nombre no puede estar vacio","Mensaje","&Aceptar");				}else if(k_rfc &= ""){					frn.setPos("k_rfc");					frn.message("El RFC no puede estar vacio","Mensaje","&Aceptar");				}else /*if(k_cp &= ""){					// Condition Added / Commented by JMM 20240129 ... To check this must be applied  					// for this condition vs everytime										if ( UUID_ST == 1 ) {						frn.setPos("k_cp");						frn.message("El Codigo Postal no puede estar vacio","Mensaje","&Aceptar");					}				}else*/ {					if (k_sol_rfc_cp ==0){						k_sol_rfc_cp = "N";					}else{						k_sol_rfc_cp = "S";					}					query_prov = "update keplersc.kdxd set c3 = '"& k_nombre &"',c4 = '"& k_direccion &"'						,c5 = '"& k_colonia &"',c6 = '"& k_poblacion &"', c7 = '"& k_telefono1 &"', c8 = '"& k_telefono2 &"'						,c9 = '"& k_fax &"',c10 = '"& k_rfc &"',c11 = '"& k_dir_internet &"'						,c27 = '"& k_cp &"',c28 = '"& k_sol_rfc_cp &"',c15 = '"& k_limite_credito &"'						,c16 = '"& k_plazo &"'						where c2= '"& k_clave &"'";					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",query_prov,"cat_crud_aplica_crud.guardar()");						                resultado = getXml(cuboQuery,"resultado");					if(resultado &= "0"){						mensajeError = getXml(cuboQuery ,"mensaje");						frn.message(mensajeError,"Error","Aceptar");						return;					}else{						mensaje = "Registro "& k_clave &" Actualizado con Exito ";						frn.message(mensaje,"Error","Aceptar");						// Added 20240120 by JMM						if ( strlen( trim(paramRutina) ) > 0 ) { frP.script(paramRutina); }						frn.exit();							Inicializa();					}                }			}else{				frn.exit();				}		}		fun cargaCata(){			var queryCata, cubo_cata, ok, mensajeError, xml_cubo_cata, clave, cubo, cmd;			clave = frn.param(1);			queryCata = "select c2 as k_clave,							c3 as k_nombre,							c4 as k_direccion,							c5 as k_colonia,							c6 as k_poblacion,							c7 as k_telefono1,							c8 as k_telefono2,							c9 as k_fax,							c10 as k_rfc,							c27 as k_cp,							c11 as k_dir_internet,							c28 as k_sol_rfc_cp,							c29 as k_val_rfc,							/*c16*/c15 as k_limite_credito							, c16 as k_plazo							from keplersc.kdxd							where c2 = '"& clave &"'";				cubo_cata= frn.lib("libGeneral.kpl","EjecutarSqlSel",queryCata,"conpolizasView.cargarpolizas()");				ok=getXmlAtt(cubo_cata,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}	//			frn.lib("libGeneral.kpl","FileSave",cubo_cata,"C:\Basura\cubo_cata");			xml_cubo_cata=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cubo_cata,"r0");//			frn.lib("libGeneral.kpl","FileSave",xml_cubo_cata,"C:\Basura\xml_cubo_cata");			frn.setX(xml_cubo_cata);			if (tipoOper &= "Nuevo" || tipoOper &="Modificar"){				activaCampos();			 }		}			fun ConfiguraUI(){				consPlantilla="PLANTILLA"; //AQUI DEFINE LA CONSTANTE PARA COMPARAR EN PARAMETROS				if (frn.nParam() == 0){					frn.message("Accion no permitida.","Error","&Aceptar");					frn.open("redirect",2);					return;				}				tipoOper = frn.param(0);				//Establecer titulo de la ventana				if (tipoOper &= "PLANTILLA"){					frn.setAtt("gpo_2","tit","Catalogo PLANTILLA...");					frn.set("k_titulo","Catalogo Proveedores Plantilla");				}				else if (tipoOper &= "Nuevo"){					//frn.setAtt("gpo_2","tit","Catalogo de Autos Alta Nuevo");					frn.setAtt("gpo_2","tit","Catalogo de Proveedores Alta Nuevo"); // 20240130					frn.set("k_titulo","Catalogo Proveedores Alta");				}				else if (tipoOper &= "Modificar"){					//frn.setAtt("gpo_2","tit","Catalogo de Autos Modificar");					frn.setAtt("gpo_2","tit","Catalogo de Proveedores Modificar"); // 20240130					frn.set("k_titulo","Catalogo Proveedores Modificar");				}				else if (tipoOper &= "Eliminar"){					//frn.setAtt("gpo_2","tit","Catalogo de Autos Elimina Auto");					frn.setAtt("gpo_2","tit","Catalogo de Proveedores Elimina Proveedor"); // 20240130					frn.set("k_titulo","Catalogo Proveedores Eliminar");				}				else if (tipoOper &= "Consultar"){					//frn.setAtt("gpo_2","tit","Catalogo de Autos Consulta");					frn.setAtt("gpo_2","tit","Catalogo de Proveedores Consulta"); // 20240130					frn.set("k_titulo","Catalogo Proveedores Consulta");				}				else{					frn.message("Accion no permitida.","Error","&Aceptar");					frn.open("redirect",2);					return;				}			}								fun Inicializa(){				frn.rst("gpo_2");				Inicia_Forma();				}			fun activaCampos(){				frn.setAtt("k_clave", "available", "Y");				frn.setAtt("k_clave", "bclr", "255,255,255");				frn.setAtt("k_nombre", "available", "Y");				frn.setAtt("k_nombre", "bclr", "255,255,255");				frn.setAtt("k_direccion", "available", "Y");				frn.setAtt("k_direccion", "bclr", "255,255,255");				frn.setAtt("k_colonia", "available", "Y");				frn.setAtt("k_colonia", "bclr", "255,255,255");				frn.setAtt("k_poblacion", "available", "Y");				frn.setAtt("k_poblacion", "bclr", "255,255,255");				frn.setAtt("k_telefono1", "available", "Y");				frn.setAtt("k_telefono1", "bclr", "255,255,255");				frn.setAtt("k_telefono2", "available", "Y");				frn.setAtt("k_telefono2", "bclr", "255,255,255");				frn.setAtt("k_fax", "available", "Y");				frn.setAtt("k_fax", "bclr", "255,255,255");				frn.setAtt("k_rfc", "available", "Y");				frn.setAtt("k_rfc", "bclr", "255,255,255");				frn.setAtt("k_cp", "available", "Y");				frn.setAtt("k_cp", "bclr", "255,255,255");				frn.setAtt("k_dir_internet", "available", "Y");				frn.setAtt("k_dir_internet", "bclr", "255,255,255");				frn.setAtt("k_sol_rfc_cp", "available", "Y");				frn.setAtt("k_sol_rfc_cp", "bclr", "255,255,255");				frn.setAtt("k_limite_credito", "available", "Y");				frn.setAtt("k_limite_credito", "bclr", "255,255,255");				frn.setAtt("k_plazo", "available", "Y");				frn.setAtt("k_plazo", "bclr", "255,255,255");				// Added by JMM 20240129				frn.setAtt("limite_credito", "visible", "Y");				frn.setAtt("k_limite_credito", "visible", "Y");				frn.setAtt("k_btn_cons", "text", "Guardar");				if(tipoOper&="Modificar"){					frn.setAtt("k_clave", "available", "N");					frn.setAtt("k_clave", "bclr", "236,240,243");					// Added by JMM 20240120					if ( UUID_ST == 1 ) {						frn.setAtt("k_nombre", "available", "N");						frn.setAtt("k_nombre", "bclr", "236,240,243");						frn.setAtt("k_rfc", "available", "N");						frn.setAtt("k_rfc", "bclr", "236,240,243");						frn.setAtt("k_limite_credito", "available", "N");						frn.setAtt("k_limite_credito", "visible", "N");						frn.setAtt("limite_credito", "visible", "N");						frn.setAtt("k_plazo", "available", "N");						frn.setAtt("k_plazo", "bclr", "236,240,243");					}				}else if(tipoOper&="Nuevo"){					var cmd = "select concat('D',cast(right(c2, 6) as int)+1) as sig_clave from keplersc.kdxd order by c2 desc limit 1";					var cubo_cata= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_crud_proveedores.activa_campos()");					var folio =getXmlAtt(cubo_cata,"r0", "sig_clave");					frn.set("k_clave",folio);					frn.setAtt("k_clave", "available", "N");					frn.setAtt("k_clave", "bclr", "236,240,243");									}							}			fun Inicia_Forma(){				var cmd,ok,mensajeError, cubo, cmdQueryanio, cmdQuerymes;				//Etiquetas 				frn.set("clave","Clave");				frn.set("nombre","Nombre ");				frn.set("direccion","Direccion");				frn.set("colonia","Colonia");				frn.set("poblacion","Poblacion");				frn.set("telefono","Telefonos");				frn.set("fax","Fax");				frn.set("rfc","RFC");				frn.set("cp","Codigo Postal");				frn.set("dir_internet","Direccion de Internet");				frn.set("sol_rfc_cp","Solicita RFC y CP");				frn.set("limite_credito","Limite de Credito");				frn.set("plazo","Plazo ( Pago C x P )");				frn.setAtt("k_clave", "available", "N");				frn.setAtt("k_clave", "bclr", "236,240,243");				frn.setAtt("k_nombre", "available", "N");				frn.setAtt("k_nombre", "bclr", "236,240,243");				frn.setAtt("k_direccion", "available", "N");				frn.setAtt("k_direccion", "bclr", "236,240,243");				frn.setAtt("k_colonia", "available", "N");				frn.setAtt("k_colonia", "bclr", "236,240,243");				frn.setAtt("k_poblacion", "available", "N");				frn.setAtt("k_poblacion", "bclr", "236,240,243");				frn.setAtt("k_telefono1", "available", "N");				frn.setAtt("k_telefono1", "bclr", "236,240,243");				frn.setAtt("k_telefono2", "available", "N");				frn.setAtt("k_telefono2", "bclr", "236,240,243");				frn.setAtt("k_fax", "available", "N");				frn.setAtt("k_fax", "bclr", "236,240,243");				frn.setAtt("k_rfc", "available", "N");				frn.setAtt("k_rfc", "bclr", "236,240,243");				frn.setAtt("k_cp", "available", "N");				frn.setAtt("k_cp", "bclr", "236,240,243");				frn.setAtt("k_dir_internet", "available", "N");				frn.setAtt("k_dir_internet", "bclr", "236,240,243");				frn.setAtt("k_sol_rfc_cp", "available", "N");				frn.setAtt("k_sol_rfc_cp", "bclr", "236,240,243");						frn.setAtt("k_limite_credito", "available", "N");				frn.setAtt("k_limite_credito", "bclr", "236,240,243");				frn.setAtt("k_plazo", "available", "N");				frn.setAtt("k_plazo", "bclr", "236,240,243");					frn.setAtt("k_btn_cons", "text", "Aceptar");								cargaCata();				frn.setPos("k_clave");				//Obtencion de registros			}		//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------GAD fl4r30n									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>