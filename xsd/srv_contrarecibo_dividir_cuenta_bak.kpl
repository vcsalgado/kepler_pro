<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()" tit=""><br/>		<grp dim="66,13,7,12" bclr="236,240,243" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Dividir Cuenta">			<br/><txt> Cuenta origen: </txt>			<inp id="k_cuenta_origen" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/><sp/>			<inp id="k_descripcion_origen" dim="40,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/><tab/><txt>Monto: </txt>			<inp id="k_monto_origen" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N"/>			<sp/><inp id="k_asiento_origen" dim="2,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="1" modify="N" available="N"/><br/>			<br/><txt> Nueva Cuenta: </txt>			<inp id="k_cuenta_nueva" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" 				OnF9="seleciona_cuenta()" OnChange="valida_cuenta()"/><sp/>			<inp id="k_descripcion_nueva" dim="40,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/><tab/><txt>Monto:</txt><sp/>			<inp id="k_monto_nueva" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nc="12" min="0"/><tab/>			<br/><br/><tab n="11"/>			<bot id="Aceptar" dim="20,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,sys,kdb;			var tabla, cmdQuery, anio_contable;			var nombre_tbl;			fun Main() {				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;								kdb.connect();				nombre_tbl=frn.param(0);				if (!nombre_tbl || nombre_tbl==""){					nombre_tbl="k_mov_ctas";				};				anio_contable = mid(fnDate("year",sys.date()),2);				mostrar_cuenta_base();			}			fun Execute() {				var nueva_cuenta, monto_nueva, asiento, monto_origen,referencia_uuid;				var renglon;				nueva_cuenta=frn.get("k_cuenta_nueva");				monto_nueva=frn.get("k_monto_nueva");				asiento=frn.get("k_asiento_origen");				monto_origen=frn.get("k_monto_origen");				referencia_uuid=frP.get("k_mov",-1,"k_referencia_uuid");				if (monto_nueva > monto_origen){										frn.setPos("k_monto_nueva");					frn.message("El monto de la nueva cuenta no puede ser mayor al de la origen","Error","&Aceptar");					return;				}				monto_origen = monto_origen - monto_nueva;				if (nueva_cuenta &! "" && monto_nueva != 0){					renglon=frP.N("k_mov");					renglon=renglon - 1;					frP.setX(nueva_cuenta, "k_mov",renglon,"k_cuenta");					frP.setX(frn.get("k_descripcion_nueva"), "k_mov",renglon,"k_cuentadesc");					if(asiento &= "C"){						frP.setX(monto_nueva, "k_mov",renglon,"k_cargo");						frP.setX(monto_nueva, "k_mov",renglon,"k_cargo_origen");						frP.setX(monto_origen, "k_mov",-1,"k_cargo");						frP.setX(monto_origen, "k_mov",-1,"k_cargo_origen");					}else{						frP.setX(monto_nueva, "k_mov",renglon,"k_abono");						frP.setX(monto_nueva, "k_mov",renglon,"k_abono_origen");						frP.setX(monto_origen, "k_mov",-1,"k_abono");						frP.setX(monto_origen, "k_mov",-1,"k_abono_origen");					}					frP.setX("N", "k_mov",renglon,"k_cuenta_grupo");					frP.setX("N", "k_mov",renglon,"k_cuenta_divisible");					frP.setX("", "k_mov",renglon,"k_campo_cuenta_plantilla");										frP.setX(nueva_cuenta, "k_mov",renglon,"k_cuenta_origen");					frP.setX("N", "k_mov",renglon,"k_cuenta_grupo_origen");					frP.setX("N", "k_mov",renglon,"k_cuenta_divisible_origen");					frP.setX("", "k_mov",renglon,"k_campo_cuenta_plantilla_origen");					frP.setX(frn.get("k_cuenta_origen"), "k_mov",renglon,"k_cuenta_base");					frP.setX(referencia_uuid, "k_mov",renglon,"k_referencia_uuid");										frP.script("RecalcularPoliza()");														}				frn.exit();			}						fun mostrar_cuenta_base(){				var cuenta,monto,asiento;				cuenta=frP.get("k_mov",-1,"k_cuenta");				frn.setX(cuenta,"k_cuenta_origen");				monto=frP.get("k_mov",-1,"k_cargo");								frn.setX("C","k_asiento_origen");				if (monto==0){					monto=frP.get("k_mov",-1,"k_abono");					frn.SetX("A","k_asiento_origen");				}				frn.setX(frP.get("k_mov",-1,"k_cuentadesc"),"k_descripcion_origen");								frn.setX(monto,"k_monto_origen");				frn.setAtt("k_monto_nueva","max",monto);			}						fun seleciona_cuenta(){				tabla = " keplersc.kdc1" & anio_contable;				cmdQuery = "select c1 as clave_cuenta, c2 as desc_cuenta from " & tabla;				frn.dialog("genlistafiltrosel","Cuentas",cmdQuery ,"clave_cuenta","k_cuenta_nueva","", "","N");			}						fun valida_cuenta(){				var valTecleado, valValido,cmdQuery,cuboQuery,cuenta,aoo,mensajeError,ok,resultado,mensaje,adicionales,desc;				aoo=anio_contable;				if(frn.get("k_cuenta_nueva") &= frn.get("k_cuenta_origen" )){					frn.setX("","k_descripcion_nueva");					frn.setX("","k_cuenta_nueva");					frn.setPos("k_cuenta_nueva");					frn.message("La nueva cuenta no pueder ser igual que la original", "Error","&Aceptar");					return;				}				cuenta=frn.get("k_cuenta_nueva");									//Valida que la cuenta exista y sea de ultimo nivel				cmdQuery="SELECT * FROM keplersc.verify_cuenta_ult_nivel('" & cuenta & "','" & aoo & "')";																	kdb.rst(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"Cuenta()");								ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									resultado= getXml(cuboQuery,"resultado");				mensaje= getXml(cuboQuery,"mensaje");					adicionales = getXml(cuboQuery,"adicionales");				if(resultado &! "1"){					frn.setX("","k_descripcion_nueva");					frn.setX("","k_cuenta_nueva");					frn.setPos("k_cuenta_nueva");					frn.message(mensaje, "Error","&Aceptar");					return;				}								cmdQuery="select c1 as cuenta, c2 as k_descr from keplersc.kdc1" & aoo & " where c1='" & cuenta & "' ";				kdb.rst(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"Cuenta()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, "C:\Basura\xmlCuenta");				desc=getXmlAtt(cuboQuery,"r0","k_descr");								frn.setX(desc,"k_descripcion_nueva");				frn.setPos("k_monto_nueva");			}		}	</script></pag>