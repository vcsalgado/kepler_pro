<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Cheque">	<grp dim="1,-1,10,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<tab/><inp id="idOperacion" dim="30,1" fnt=",22" clr="0,0,0" type="string" modify="N" available="N"/><br/>		<tab/><hLine clr="0,0,0"/>	<br/> <br/><tab/>		<grp dim="46,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">			<txt>  Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" tooltip="Sucursal" available="Y" modify="Y"/>			<br/><br/>			<txt>  Tipo :        </txt>			<cmb id="k_tipon" dim="50,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo()" tooltip="Tipo de Movimiento" available="N"/>			<br/>			<sp n="11"/><inp id="statusdoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/>		</grp>		<sp/>		<grp dim="34,10,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C"/><tab/> <br/>			<txt id="textFolio" visible="N">  Folio :  </txt>			<edt id="k_folio" dim="30,1" brdr="2,0" bclr="255,255,255"  OnChange="Formar_folio()" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="10" tooltip="Folio ( F9 b&#250;squeda )" modify="Y" available="N" visible="N" OnF9="ObtenerFolio()" 			OnButton="ObtenerFolio()"/>			<sp n="2"/>			<img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="BuscarFolio()" available="Y" clrBrdr="0,0,0" visible="N"/>			 <br/>			<sp n="1"/>			<inp id="k_docto" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="C"/> <br/>			<txt>  Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N" tooltip="Fecha"/> 			<sp n="1"/> 			<txt>  Hora : </txt> 			<sp n="1"/> 			<edt id="k_hora" dim="15,1" type="time" nc="-1" bclr="240,240,240"  fmt="HH:MM:SS" available="N"/> 			<br/>		</grp>		<br/>		<br/>		<tab/>		<grp dim="81,12,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Proveedor">				<grp dim="38,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">								<sp n="1"/> <txt clr="0,58,112" hk="P">Proveedor : </txt><tab/>				<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnButton="Dialog(3,cxpcatprobus,k_clave)" OnF9="Dialog(3,cxpcatprobus,k_clave)" OnChange="BuscarProveedor()" 					type="capital" nc="7" tooltip="Proveedor ( F9 b&#250;squeda )" modify="Y" hk="C" available="Y"/> 				<br/>				<sp n="1"/> <txt>RFC : </txt><sp n="5"/>				<!-- dim="18,1" -->				<inp id="k_rfc" clr="64,64,64"  dim="20,1" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>				<br/>			</grp>			<sp n="1"/>			<grp dim="75,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="1,5" fnt="Arial,16">				<sp n="1"/> <txt>Datos del proveedor : </txt>				<br/>				<sp n="1"/>					<inp id="k_nombreprov" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_calleprov" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_coloniaprov" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_poblacionprov" clr="64,64,64" clrBrdr="255,255,255"  dim="50,1" fnt="Arial,16" type="string" modify="N" available="N" nc="50" visible="Y"/>				<sp n="1"/>				<inp id="k_cpprov" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt="Arial,16" type="string" modify="N" available="N" nc="10" visible="Y"/>			</grp>			<br/>					</grp>		<br/>		<br/>		<tab/>				<!-- np="145" 4 k_factura -->		<!-- np="120" 4 k_monto_factura -->		<!-- np="120" 4 k_iva_factura -->		<!-- OnF9="ObtenerFactura()" 4 k_factura -->				<grp dim="81,24,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" fnt=",0" tit="Seleccion de Documentos  -   Ctrl + Del [Eliminar Registro]">		<!-- <tab/> -->		<sp n="1"/>		<!-- dim="110,8" -->		<tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" 				dim="114,7"  hk="z" Reorder="N" modify="Y" insdel="Y">			<col id="c_serie" name="Serie"  type="string" OnF9="" visible="Y" modify="N" available="N" np="40"/>			<col id="c_folio" name="Folio"  type="string" OnF9="" visible="Y" modify="N" available="N" np="70"/>			<col id="c_saldo" name="Saldo"  type="number" OnF9="" visible="Y" modify="N" available="N" nc="15" nd="2" np="70"/>			<col id="c_vence" name="Vence"  type="string" nc="12" OnF9="" visible="Y" modify="N" available="N" np="70"/>			<col id="k_factura" name="Factura"  type="capital" OnF9="ObtenerCxP()" OnChange="ObtenerFactura()" visible="Y" modify="N" available="Y" np="120"/>			<col id="k_monto_factura" name="Monto"  type="number" OnChange="monto()" nd="2" nc="15" modify="Y" np="70"/>			<col id="k_iva_factura" name="IVA"  type="number" nd="2"  nc="15" OnChange=""  modify="N" visible="Y" np="60"/>			<col id="k_factura_rfc" name="rfc"  modify="N" visible="N" available="N"/>						<col id="k_prov" name="Prov Oper"  type="string" OnF9="" visible="Y" modify="N" available="N" np="40"/>					</tbl>		<br/>		<!-- <tab/> --> 		<sp n="1"/>		<grp dim="70,20,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,16" hSpace="4" fnt=",0">			<!-- <br/> -->						<sp/><txt fnt=",">Referencia:  </txt>			<inp id="k_refer" dim="46,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="capital" just="L" nc="40" fnt=",0" clr="64,64,64" available="y"/>			<br/>			<br/>			<sp/><txt fnt=",">Notas:  </txt>			<inp id="k_coment" dim="50,4" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="capital"  fnt=",0" clr="64,64,64" modify="Y" available="Y"/>			<br/>				</grp>			<tab n="2"/>		<grp dim="40,20,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,16" hSpace="4" fnt=",0" clr="64,64,64">			<sp/><txt fnt=",">Subtotal:  </txt>	<tab n="3"/>			<inp id="k_subtotal" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0" clr="64,64,64"/>			<br/>						<sp/><txt fnt=",">IVA a Acreditar:  </txt>	<sp/>	<tab n="1"/>			<inp id="k_iva" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0" clr="64,64,64"/>			<br/>			<sp/><txt fnt=",">Monto del Cheque:  </txt>			<inp id="k_monto" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0b" clr="64,64,64"/>			<br/>						<br/>			<sp n="1"/>			<!-- "EjecReporte()" -->			<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Ejecuta_Reporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>						<sp n="5"/>			<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>						<sp n="5"/>			<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>				</grp>				</grp>								</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Variables de control			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal, tabla, estatus_doc ;			var fileSavePath;			//Variables validacion factura			var	str_uuid, fecha_uuid, rfc_uuid, total_uuid;								//Variables de parametros         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd;			var editable; //Se controla si la poliza se puede editar, cancelar o dar de baja				//Porcentajes kdmm			var prc_iva ;			//cont			var presupuesto , saldo, fecha_baja, cargos_factura, abonos_factura, cargos_iva_factura, abonos_iva_factura;			var uen;					fun Main() {			frn=new FRNT;			kdb=new KDB;			rep=new REP;			frP=new FRNTP;			sys=new SYS;			kdb.connect();			kdb.kde("KDE");			kdb.exec();			anio_contable = kdb.get("KDE","14");			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			suc_usuario = frn.lib("libKepler","UserInfo(1)");			fileSavePath = "C:\Basura";			Inicializa();			ConfiguraControlesOpcion();								}					fun Inicializa(){ //Inicializa los valores en Pantalla			// Revisa parametros recibidos			if( frn.nParam() == 7 ){ //Se han mandado parï¿½metros a la pï¿½gina                gen_doc=trim(frn.param(0));                 nat_doc=trim(frn.param(1));                 gpo_doc=trim(frn.param(2));                tip_doc=trim(frn.param(3));                 tip_ope=trim(frn.param(4));                paramProd=trim(frn.param(5));			} else {				frn.message("Operacion no valida ...", "Mensaje","&Aceptar");				frn.open("redirect",2);				return;			}         if (gpo_doc &= "31"){				frn.set("idOperacion","Cheque");         }else{				frn.set("idOperacion","Cargo a Cuentas X Pagar");         }                     			if(tip_ope &= "A"){ //Alta				frn.set("operacion","ALTA");			} else {				if(tip_ope &= "B"){ //Baja					frn.set("operacion","BAJA");				} else {					if(tip_ope &= "C"){ //Consulta						frn.set("operacion","CONSULTA");					} else {						frn.message("Operacion no valida ...", "Mensaje","&Aceptar");						frn.open("index",4);						return;								}				}			}									uen=trim(frn.param(6));			if (uen &= ""){				uen="XXX";			}							// Fill Combo Sucursal (Con Query de PostgreSQL)			cmdQuery = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdms";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_sucn",cuboQuery);								// Fill Combo Tipo (Con Query FTO Kepler) 			cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;			cmdQuery = cmdQuery & " and c4='" & tip_doc & "'"; //Condition used by JMM 20240312 as temporary until define DOCs or DOC Type 			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.Inicializa()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error BD","Aceptar");				return;			}			frn.set("k_tipon",getXml(cuboQuery));						frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				frn.set("k_vence",sys.date());							// Fill k_docto | referencia docto			ArmarRefDocto();					porcentajes_kdmm();		}					// Armado del Docto Referencia		fun ArmarRefDocto {			var cadena = frn.get("k_tipon", -1, 5);			var fol = frn.get("k_folio");			if (tip_ope &! "A" && fol &! ""){				cadena = strSplit(cadena,"-",0) & "-" & fol;			}					frn.set("k_docto", cadena);		}					fun PadLeft(pText,pRelleno,pCaracterRelleno) {			var Resultado;			var pos_ini = pText;			var nReg = strlen(pText);			for (var cont = nReg; cont < pRelleno; cont++) {				Resultado = pCaracterRelleno & Resultado;			}			Resultado = Resultado & pText;                			return Resultado;		}				fun CambiaTipo() {				tip_doc  = frn.get("k_tipon", -1, 4);			porcentajes_kdmm();			borrar_datos();			LimpiaEncabezado();								//TODO, borrar todos los datos			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();						}				fun porcentajes_kdmm (){						var cmd, cuboResultados ,ok,mensajeError;								cmd= " select c15,c16,c33,c75 from keplersc.kdmm where c1='" & gen_doc & "'" ;							cmd = cmd & " and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4='" & tip_doc & "'";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.porcentajes_kdmm()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				prc_iva = getXmlAtt(cuboResultados , "r0","c16");					}				fun CambiaSucursal() {			sucursal_id = frn.get("k_sucn",-1,1);			LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();						}				// imodo Added by JMM, 20240205		fun LimpiaEncabezado(imodo) {			if ( imodo != 1 ) { frn.set("k_folio", ""); } // Adapted by JMM, 20240205 			frn.set("k_docto", "");			frn.set("k_fecha", "");			frn.set("k_hora", "");			LimpiaDatosProv();			frn.set("k_clave", "");		}				fun borrar_datos(){			frn.rst("k_mov");			frn.rst("k_refer");			frn.rst("k_coment");			frn.set("k_subtotal", 0);			frn.set("k_iva", 0);			frn.set("k_monto", 0);		}				fun BuscarFolio() {			var folio;			folio = frn.get("k_folio");			folio = PadLeft(folio, 7, "0");			ArmarRefDocto();			borrar_datos();			MostrarDatos(folio);			}		fun Cancela() {			CambiaSucursal();			borrar_datos();			Inicializa();			ConfiguraControlesOpcion();		}		fun ObtenerFolio() {			sucursal_id = frn.get("k_sucn",-1,1);			cmdQuery = "select c6 as folio, substring(cast(c9 as VARCHAR),1,10) as fecha, c10 as cve_proveedor, " &						"c11 as factura, c16 as monto, c43 estatus " &						"from keplersc.kdm1 " &						"where c1='" & sucursal_id & "' and c2='" & gen_doc & "' and c3='" & nat_doc & "' and c4=" & gpo_doc & " and c5=" & tip_doc;									cmdQuery = cmdQuery & " order by c9 desc, c6 desc"; // Added by JMM, 20240202									frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryfoliomov");							frn.dialog("genlistafiltrosel","Folios de Cheques",cmdQuery,"folio","k_folio","0","","S");					}				fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    			1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 			2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 			3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			// var tip_ope; 			var tip_oper;			if(iModo==0)				page=pag; 			else if(iModo==2&&(strlen(par0)>0)){				//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       				if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 				if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;			}			else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     		}					//------------------------------PROVEEDOR-----------------------			fun BuscarProveedor(){			var xmlProd;											sucursal_id = frn.get("k_sucn",-1,1);			proveedor_id = frn.get("k_clave");			LimpiaDatosProv();					if (strlen(frn.get("k_clave")) == 0) {				return;			}							if (strlen(frn.get("k_refer")) > 0) {				refer_id = frn.get("k_refer");			} else {				frn.set("k_fecha_exp", "");			}						/*			cmdQuery = "select c10 as k_rfc, c3 as k_nombreprov, c4 as k_calleprov, c5 as k_coloniaprov, c6 as k_poblacionprov, c27 as k_cpprov, c16 as k_plazo " &									"from keplersc.kdxd where c1='" & sucursal_id & "' and c2='" & proveedor_id & "'" ;			*/						// Query updated	by JMM	20240202			cmdQuery = "select keplersc.full_replace(c10,'-','') as k_rfc, c3 as k_nombreprov, c4 as k_calleprov, c5 as k_coloniaprov, c6 as k_poblacionprov, c27 as k_cpprov, c16 as k_plazo " &									"from keplersc.kdxd where c1='" & sucursal_id & "' and c2='" & proveedor_id & "'" ;						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.BuscaProveedor()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.setPos("k_clave");				frn.message("El proveedor no existe","Error","Aceptar");				return;				}			//Plazo();				rstXml(xmlProd);			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");			frn.setX(xmlProd);									}				fun LimpiaDatosProv() {			frn.set("k_rfc", "");			frn.set("k_nombreprov", "");			frn.set("k_calleprov", "");			frn.set("k_coloniaprov", "");			frn.set("k_poblacionprov", "");			frn.set("k_fecha_exp", "");						frn.set("k_refer", "");			frn.set("k_fecha_exp", "");			frn.set("k_cpprov", "");						borrar_datos(); // Added by JMM 20240202		}			//-----------------------------------FACTURA------------------------				// Added by JMM, 20240204		fun ObtenerCxP() {					proveedor_id = frn.get("k_clave");			if (strlen(proveedor_id ) == 0){				frn.message("Debes Seleccionar el Proveedor ...","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				frn.setX("", "k_mov", -1, "k_factura_rfc");				borrar_datos_factura();				return;			}			sucursal_id = frn.get("k_sucn",-1,1);						// UPD by JMM 20240303 , Including Prov Pago Selection			cmdQuery = "" &				"select " & 				"/* e.c5 gen, e.c6 gpo, e.c7 nat, e.c8 tip, e.c9 fol, */ " &				"m.c5 origen " &				", w.c9 fecha, w.c6 folio, w.c16 total_doc " & // Added by JMM 20240408 				"/*, w.uuid_serie, w.uuid_folio, w.uuid_fecha, w.uuid_total*/ " & // Commented by JMM 20240425				", abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) saldo " &				", (to_date(g.c12::text,'yyyy-mm-dd'))::text vencimiento " &   				", w.uuid_serie, w.uuid_folio/*, w.uuid_fecha, w.uuid_total*/ " & // Moved by JMM 20240425  				", g.c4 uuid_o_ref /*, to_date(g.c12::text,'yyyy-mm-dd') vencimiento*/ " & 				", w.doc_refer_compl ref_compl " & // Added by JMM 20240408 				"/* g.* */  /* e.* */ " & 				", w.uuid_fecha, w.uuid_total" & // Moved by JMM 20240425  				", g.c3 prov_operacion, d.c3 prov_nombre " & // Added by JMM 20240303 				"from keplersc.kduxg g " &  				"inner join keplersc.kduxe e on g.c1 = e.c1 and g.c2 = e.c5 and g.c3 = e.c2 and g.c4 = e.c3 " & 				"/*added by JMM 20240724*/ and e.c6 = 'A' and e.c11 = g.c11 " & 				"/*and e.c5 = 'X' and e.c6 = 'A' and e.c7 = 55 and e.c8 = 1 -- Getting Specific Doc*/ " & 				"inner join keplersc.kdmm m on m.c1 = e.c5 and m.c2 = e.c6 and m.c3 = e.c7 and m.c4 = e.c8 " & 				"inner join keplersc.kdm1 w on w.c1 = e.c1 and w.c2 = e.c5 and w.c3 = e.c6 and w.c4 = e.c7 and w.c5 = e.c8 and w.c6 = e.c9 " & 				"/*line added 240303*/ inner join keplersc.kdxd d on d.c1 = g.c1 and d.c2 = g.c3 "; 					// Select Conditions UPD by JMM 20240303 				// "where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and g.c3 = '" & proveedor_id & "' " &  				// "and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10 /*to check GAP in balance to show record*/ ";							cmdQuery = cmdQuery & "" & 				"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and ( g.cve_prov_pago = '" & proveedor_id & "' or ( g.c3 = '" & proveedor_id & "' and length(g.cve_prov_pago) = 0 ) ) " &  				"and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10 /*to check GAP in balance to show record*/ " &				"/*added by JMM 20240724*/ and w.c16 > 0 ";					      // Condicion si solo muestra las C x P vencidas   			//cmdQuery = cmdQuery & " and g.c12 <= current_date /*to check if this condition will be used*/ "; 						cmdQuery = cmdQuery & " order by g.c12 ";									//frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQuery_ObtenerCxP");							frn.dialog("genlistafiltrosel","C x P  del  Proveedor",cmdQuery,"uuid_o_ref"/*"folio"*/,"k_mov",-1,"k_factura"/*"k_folio"*/,"S");								}						fun ObtenerFactura(){			proveedor_id = frn.get("k_clave");			if (strlen(proveedor_id ) == 0){				frn.message("Debes Seleccionar un Proveedor antes","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				frn.setX("", "k_mov", -1, "k_factura_rfc");				borrar_datos_factura();				return;			}						// No se Seleccionara la C x P desde un XML sino de las C x P Registradas ... by JMM, 20240204			/*			var nCampos,uuid="ZZZZZZ-5E76-413F-7FF8-17F7A1962A87|RAJM-891017-H31|2022-08-19|440";			//Regresara la funcion UUID cadena con UUID, rfc, fecha, total			uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID","k_refer", 0,"0");			nCampos = strSplit(uuid,"|",-1);			if (nCampos > 1) {					str_uuid = strSplit(uuid,"|",0);		//UUID					rfc_uuid = strSplit(uuid,"|",1);		//rfc					fecha_uuid = strSplit(uuid,"|",2);		//fecha					total_uuid = strSplit(uuid,"|",3);		//monto de la factura										var nreg = frn.N("k_mov")-1;//cuantos renglones hay					for(var i=0; i<nreg; i++){									if (frn.get("k_mov",i,"k_factura") &= str_uuid ){							frn.message("Ya seleccionaste esta factura.","Error","Aceptar");							return;						}					}					frn.setX(str_uuid, "k_mov", -1, "k_factura");								} else{				frn.setX("", "k_mov", -1, "k_factura");				frn.message("Faltan datos del UUID","Error","Aceptar");				return;			}			*/						// Adapted (in this schema) by JMM, 20240204			str_uuid = "";			str_uuid = frn.get("k_mov", -1, "k_factura");			var irow = frn.getJ("k_mov");						var nreg = frn.N("k_mov")-1;//cuantos renglones hay			for(var i=0; i<nreg; i++){				if (frn.get("k_mov",i,"k_factura") &= str_uuid && i != irow ){					frn.message("Ya seleccionaste esta factura ...","Error","Aceptar");					borrar_datos_factura(); // Adapted (in this schema) by JMM, 20240204					return;				}			}							sucursal_id = frn.get("k_sucn",-1,1);						var res = factura_cargos_abonos(str_uuid);			if (res == 1){				return ;			}						var monto = abonos_factura - cargos_factura;					frn.setX(monto ,"k_mov", -1, "k_monto_factura");			//frn.setX(rfc_uuid ,"k_mov", -1, "k_factura_rfc"); // Commented by JMM 20240204 						iva(monto);						}					fun monto(){					proveedor_id = frn.get("k_clave");			if (strlen(proveedor_id ) == 0){				frn.message("Debes Seleccionar un Proveedor antes","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				borrar_datos_factura();				return;			}						var monto_factura = frn.get("k_mov", -1, "k_monto_factura");			if (monto_factura <= 0){				frn.message("No se puede dejar el monto en 0s","Error","Aceptar");				borrar_datos_factura();				return;			}						sucursal_id = frn.get("k_sucn",-1,1);			var factura = frn.get("k_mov", -1, "k_factura");			var res = factura_cargos_abonos(factura);			if (res == 1){				return ;			}						var saldo_temporal = (monto_factura  + cargos_factura) - abonos_factura ;						if (saldo_temporal > 0){				frn.message("No puede pagar superior al saldo de una factura","Error","Aceptar");				borrar_datos_factura(1);				var monto = abonos_factura - cargos_factura;				frn.setX(monto ,"k_mov", -1, "k_monto_factura");				iva(monto);				return;			}						iva(monto_factura);				}				fun borrar_datos_factura(imodo){					var irow = frn.getJ("k_mov"); // Added by JMM 20240204						frn.setX("", "k_mov", -1, "k_monto_factura");			frn.setX("", "k_mov", -1, "k_iva_factura");						// Added by JMM 20240204 			// /*			frn.setX("", "k_mov", -1, "k_factura_rfc");			if ( imodo != 1 ) { 			  frn.setX("", "k_mov", -1, "k_factura");			  frn.setX("", "k_mov", -1, "c_serie");			  frn.setX("", "k_mov", -1, "c_folio");			  frn.setX("", "k_mov", -1, "c_saldo");			  frn.setX("", "k_mov", -1, "c_vence");			  frn.setX("", "k_mov", -1, "k_prov");			}			// */			}				fun factura_cargos_abonos(factura) {					var fechvenc, fechoper;						// Addapted by JMM, 20240204			/*			cmdQuery="SELECT c6 as cargos, c7 as abonos, c8 as cargos_iva,c9 as abonos_iva from keplersc.kduxg where c1 = '" & sucursal_id & "' and c2='" & gen_doc & "'";			cmdQuery = cmdQuery & " and c3='" & proveedor_id & "' and c4='" & factura  & "'";			*/						// UPD by JMM 20240303 , Including Prov Pago Selection			cmdQuery = "" &				"select " & 				"/* e.c5 gen, e.c6 gpo, e.c7 nat, e.c8 tip, e.c9 fol, */ " &				"m.c5 origen " &				", w.uuid_serie, w.uuid_folio, w.uuid_fecha, w.uuid_total " &				", abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) saldo " &  				", g.c4 uuid, to_date(g.c12::text,'yyy-mm-dd') vencimiento " & 				"/* g.* */  /* e.* */ " & 				", g.c6 as cargos, g.c7 as abonos, g.c8 as cargos_iva, g.c9 as abonos_iva " & 				"/*line added 240303*/ , g.c3 prov_operacion " & 				"from keplersc.kduxg g " &  				"inner join keplersc.kduxe e on g.c1 = e.c1 and g.c2 = e.c5 and g.c3 = e.c2 and g.c4 = e.c3 " & 				"/*and e.c5 = 'X' and e.c6 = 'A' and e.c7 = 55 and e.c8 = 1 -- Getting Specific Doc*/ " & 				"inner join keplersc.kdmm m on m.c1 = e.c5 and m.c2 = e.c6 and m.c3 = e.c7 and m.c4 = e.c8 " & 				"inner join keplersc.kdm1 w on w.c1 = e.c1 and w.c2 = e.c5 and w.c3 = e.c6 and w.c4 = e.c7 and w.c5 = e.c8 and w.c6 = e.c9 "; /*&*/								// Select Conditions UPD by JMM 20240303  				//"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and g.c3 = '" & proveedor_id & "' " &  				//"and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10 /*to check GAP in balance to show record*/ ";							cmdQuery = cmdQuery & "" & 				"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and ( g.cve_prov_pago = '" & proveedor_id & "' or ( g.c3 = '" & proveedor_id & "' and length(g.cve_prov_pago) = 0 ) ) " &  				"and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10 /*to check GAP in balance to show record*/ ";											// Condicion si solo muestra las C x P vencidas   			//cmdQuery = cmdQuery & " and g.c12 <= current_date /*to check if this condition will be used*/ "; 						cmdQuery = cmdQuery & " and g.c4 = '" & factura & "' ";						frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\RequestCrudCheque");								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_cheque_crud.factura_cargos_abonos()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery ,fileSavePath & "\cuboQueryCrudCheque");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			var totReg=nXml(cuboQuery);			if(totReg==0){				frn.message(/*"La Factura no esta registrada todavía."*/"La Factura No esta Registrada con el Proveedor especificado ...","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				borrar_datos_factura();				return 1;			}						cargos_factura = getXmlAtt(cuboQuery, "r0", "cargos" );			abonos_factura = getXmlAtt(cuboQuery, "r0", "abonos" );			cargos_iva_factura = getXmlAtt(cuboQuery, "r0", "cargos_iva" );			abonos_iva_factura = getXmlAtt(cuboQuery, "r0", "abonos_iva" );						//Code below Added by JMM 20240205			frn.setX(getXmlAtt(cuboQuery, "r0", "uuid_serie" ) , "k_mov", -1, "c_serie");			frn.setX(getXmlAtt(cuboQuery, "r0", "uuid_folio" ) , "k_mov", -1, "c_folio");			frn.setX(getXmlAtt(cuboQuery, "r0", "saldo" ) , "k_mov", -1, "c_saldo");			//frn.setX(mid(getXmlAtt(cuboQuery, "r0", "vencimiento",0,10) ) , "k_mov", -1, "c_vence");			frn.setX(getXmlAtt(cuboQuery, "r0", "vencimiento" ) , "k_mov", -1, "c_vence");						// Added by JMM 20240303 			frn.setX(getXmlAtt(cuboQuery, "r0", "prov_operacion" ) , "k_mov", -1, "k_prov");						fechvenc = mid(frn.get("k_mov", -1, "c_vence"),0,10);						if ( strlen(fechvenc) == 0 ) {				frn.message("No se pudo obtener la Fecha de Vencimiento de la C x P ...","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				borrar_datos_factura();				return 1;			}						frn.setX(fechvenc, "k_mov", -1, "c_vence");			fechvenc = formato_fecha(fechvenc);						fechoper = frn.get("k_fecha");			if ( strlen(fechoper) == 0 ) { fechoper = sys.date(); };			fechoper = formato_fecha(fechoper);						// Commented by JMM, This validation was postponeb by Juan Sabas (requested on meeting)			/*			if ( fnDate("cmp", fechvenc, fechoper ) > 0 ) {				frn.message("La Fecha de Operacion esta por debajo de la Fecha de Vencimiento ..." & "|" & " " & 					"|" & " " & fechvenc ,"Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				borrar_datos_factura();				return 1;			} 			*/								} // End : factura_cargos_abonos 						// New Func 20240205 by JMM		fun formato_fecha(fech) {			var strFech, tmpData;						strFech = fnDate("year", fech) & "/";			tmpData = fnDate("month", fech);			if(strlen(tmpData) == 1){				tmpData = "0" & tmpData;			}			strFech = strFech & tmpData & "/";			tmpData = fnDate("day", fech);			if(strlen(tmpData) == 1){				tmpData = "0" & tmpData;			}			strFech = strFech & tmpData;						return strFech;			} // end fun - formato_fecha						fun iva(monto){					//TODO,ver como se calcula realmente			//var iva = monto * (1-(1/(1+prc_iva/100)));						var iva = (monto * abonos_iva_factura)/abonos_factura;			frn.setX(iva ,"k_mov", -1, "k_iva_factura");						CalcTotal();		}				fun CalcTotal() { 						var monto_facturas =0, iva_facturas=0; 								for (var i=0,n=frn.N("k_mov")-1;i<n;i++) { 					monto_facturas=monto_facturas +frn.get("k_mov",i,"k_monto_factura");					iva_facturas=iva_facturas+frn.get("k_mov",i,"k_iva_factura");				}								frn.set("k_subtotal", monto_facturas - iva_facturas, "k_iva" ,iva_facturas, "k_monto", monto_facturas);				}					//-----------------------------------------------				fun ConfiguraControlesOff() {							frn.setAtt("textFolio", "visible", "N");			frn.setAtt("k_folio", "available", "N");			frn.setAtt("k_folio", "visible", "N");			frn.setAtt("k_mov", "modify", "N");			frn.setAtt("k_mov", "available", "N", "k_factura");			frn.setAtt("k_clave", "available", "N");			frn.setAtt("k_refer", "available", "N");			frn.setAtt("k_coment","modify", "N");			frn.setAtt("k_coment","available", "N");			frn.setAtt("Imprimir", "visible", "N");			frn.setAtt("Cancelar", "visible", "N");			frn.setAtt("Aceptar", "visible", "N");			frn.setAtt("buscar_datos", "visible", "N");						frn.setAtt("k_factura_rfc", "available", "N");			frn.setAtt("k_factura_rfc", "visible", "N");						frn.setAtt("k_fecha", "available", "N"); // Added by JMM, 20240207 						frn.setAtt("k_tipon", "available", "N"); // Added by JMM, 20240312						}						fun ConfiguraControlesOpcion() {						ConfiguraControlesOff();			if(tip_ope &= "A"){ //Alta				frn.setAtt("k_clave", "available", "Y");				frn.setAtt("k_refer", "available", "y");				frn.setAtt("k_mov", "modify", "Y");				frn.setAtt("k_mov", "available", "Y", "k_factura");				frn.setAtt("k_coment","modify", "Y");				frn.setAtt("k_coment","available", "Y");				frn.setAtt("k_fecha", "available", "N"/*"Y"*/);	//MSS Habilitar fecha // Unabled by JMM, 20240207				frn.setAtt("Cancelar", "visible", "Y");				frn.setAtt("Aceptar", "visible", "Y");									frn.setAtt("k_tipon", "available", "N"); // Added by JMM, 20240312											} else {				if(tip_ope &= "B"){ //Baja									frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");							frn.setAtt("Aceptar", "visible", "Y");						frn.setAtt("buscar_datos", "visible", "Y");																frn.setAtt("k_fecha", "available", "N"/*"Y"*/);	//MSS Habilitar fecha // Unabled by JMM, 20240207					frn.setAtt("k_tipon", "available", "N"); // Added by JMM, 20240312									} else {					if(tip_ope &= "C"){ //Consulta						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");											frn.setAtt("Imprimir", "visible", "Y");						frn.setAtt("buscar_datos", "visible", "Y");												frn.setAtt("k_tipon", "available", "Y"); // Added by JMM, 20240312							} else {						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");						frn.setAtt("k_fecha", "available", "Y");						frn.setAtt("k_hora", "available", "Y");												frn.setAtt("k_tipon", "available", "N"); // Added by JMM, 20240312									}					}			}		}				//---------------------------------------EJECUTA---------------------------------			fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			var resultado, mensaje, folio;							fecha = sys.date();			hora= sys.time();							if (tip_ope &= "A") {							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;				ValidarDatos();				if(ok &! "1" || resVal == 0){					return;				}								continua = frn.message("Desea continuar con la alta?","Atencion",2);				if (continua == 0){					return;				}									xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;											setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);				setXml(xmlPantalla,"k_tabla_mov","kdm5");				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);								// Added by JMM 20240304				setXml(xmlPantalla,"ambiente","schema","CXP_PAGO");									frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudCheque");								// For Testing ... 20240111 				/*				frn.message("La Informacion se Procesara ...","Info !!!","Aceptar");				return;				*/				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cuboQuery);				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_cheque_crud.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudCheque");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					tip_ope = "C";					frn.set("k_folio", mensaje); 					frn.set("operacion", "CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto", strTmp);					strMsg = "El Folio utilizado para esta operacion fue : " & mensaje;					ConfiguraControlesOpcion(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");					MostrarDatos(folio);						//BuscarFolio();				} else {					frn.message(mensaje, "Error", "Aceptar");				}			} else {				if (tip_ope &= "B") {									if (estatus_doc &= "C"){						frn.message("No puedes dar de baja un folio cancelado.", "Error", "Aceptar");						return ;					}					continua = frn.message("Desea continuar con la baja?","Atencion",2);					if (continua == 0){						return;					}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;													setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);					setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);					//setXml(xmlPantalla,"operacion","CHEQUE_ROLLBACK"); /*UPD by JMM 20240516*/					setXml(xmlPantalla,"operacion","CHEQUE_BAJA"); /*Adapted by JMM 20240813*/										setXml(xmlPantalla,"ambiente","uen",uen);										// Added by JMM 20240304, UPD by JMM 20240516					setXml(xmlPantalla,"ambiente","schema","CXP_CHEQUE_BAJA");										frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudChequeBaja");					// Commented by JMM 20240516 ... docdis won't be used for this option					//cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					cmdQuery="SELECT * FROM keplersc.cheque_rollback('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					rstXml(cuboQuery);											cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_cheque_crud.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudChequeBaja");											resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok) {						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}					if(resultado &= "1") {						/*						tip_ope = "C";						frn.set("operacion", "CONSULTA");						ConfiguraControlesOpcion();						BuscarFolio();						*/						folio = frn.get("k_folio");						tip_ope = "C";						frn.set("operacion", "CONSULTA");						strMsg = "El Documento ha sido cancelado satisfactoriamente ...";						ConfiguraControlesOpcion(); 						frn.message(strMsg, "Mensaje", "Aceptar");						Formar_folio();						BuscarFolio();						/*MostrarDatos(folio);*/						} else {						frn.message(mensaje, "Error", "Aceptar");					}				} else {					folio = frn.get("k_folio");					MostrarDatos(folio);				}	/*End Consulta*/ 			}						}				//Validacion Datos Generales y Partidas antes de Guardar.		//El resultado de cada validacion se guarda en la variable global resVal.		fun ValidarDatos() {			var totReg, strTotal=0,subTotal=0, iva=0, total=0, renglones, str;			//Obtener variables			sucursal_id = frn.get("k_sucn",-1,1);			proveedor_id = frn.get("k_clave");			refer_id = frn.get("k_refer");										//Validar Proveedor			cmdQuery="SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_id & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				resVal=0; return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.setPos("k_clave");				frn.message("El Proveedor No Existe ...","Error","Aceptar");				resVal=0; return;			}			//Validar Referencia			if (refer_id &= ""){				frn.setPos("k_refer");				resVal=0;				frn.message("Es Necesario Registrar la Referencia ...","Error","Aceptar");				return;			}					var nreg = frn.N("k_mov")-1;//cuantos renglones hay			if(nreg ==0){				frn.message("No es posible dar de alta un Cheque sin datos. Favor de verificar", "Error","&Aceptar");				resVal=0;return;			}					for(var i=0; i<nreg; i++){							var fac = frn.get("k_mov",i,"k_factura");				var fac_monto = frn.get("k_mov",i,"k_monto_factura");				var factura_numero = i + 1 ;								//Added by JMM 20240206				var fac_saldo = frn.get("k_mov",i,"c_saldo");				var fac_vence = frn.get("k_mov",i,"c_vence");				var fechvenc, fechoper;											if (strlen(fac) == 0){					frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : No se especifica la Factura" ,"Error","&Aceptar");					frn.setPos("k_mov", i/*-1*/,"k_factura");					resVal=0;return;				}								if (strlen(fac_monto) == 0 || fac_monto == 0){					frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : No se especifica el monto de la Factura" ,"Error","&Aceptar");					frn.setPos("k_mov", i/*-1*/,"k_monto_factura");					resVal=0;return;				}												//Conditions Added by JMM, 20240206 				if ( fac_monto > fac_saldo ) {					frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : Monto del Pago Mayor al Saldo del Documento" ,"Error","&Aceptar");					frn.setPos("k_mov", i/*-1*/,"k_monto_factura");					resVal=0;return;				}				if ( strlen(fac_vence) == 0 ) {					frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : No se cuenta con la Fecha de Vencimiento" ,"Error","&Aceptar");					frn.setPos("k_mov", i/*-1*/,"k_monto_factura");					resVal=0;return;				}				fechvenc = formato_fecha(fac_vence);								fechoper = sys.date();				fechoper = formato_fecha(fechoper);							// Validation commented by JMM 20240303 ... Based on meeting ( Juan Sabas )				//if ( fnDate("cmp", fechvenc, fechoper ) > 0 /*strFecha > fech_limit*/ ) {				/*				if ( fnDate("cmp", fechvenc, fechoper ) > 0 ) {					frn.message("Se ha generado el siguiente error en la factura " & factura_numero & " : Fecha de Operacion por debajo de la Fecha de Vencimiento" 						& "|" & " "   						& "|" & " " & fechoper & "  VS.  " & fechvenc ,"Error","Aceptar");					frn.setPos("k_mov",-1,"k_factura");					resVal=0;return;				} 				*/								//Validar que rfc de facturas correspondan al del proveedor				// Commented by JMM, 20240204, las CxP se seleccionan del Proveedor ...				/*				if (frn.get("k_rfc") &! frn.get("k_mov",i,"k_factura_rfc")) {					frn.message("El RFC de la factura " & factura_numero  & " no corresponde al proveedor.","Error","Aceptar");					resVal=0;return;				}				*/								//Validar quee Factura corresponda al Proveedor de Pago				cmdQuery="SELECT count(*) as totreg from keplersc.kduxg where c2 = 'X' and c4 = '" & fac & "' and ( cve_prov_pago = '" & proveedor_id & "' or ( c3 = '" & proveedor_id & "' and length(cve_prov_pago) = 0 ) ) ";				rstXml(cuboQuery);								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					resVal=0; return;				}				totReg=getXmlAtt(cuboQuery,"r0","totreg");				if(totReg==0){					frn.setPos("k_mov", i/*-1*/,"k_factura");					frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : No corresponde al Proveedor de Pago" ,"Error","&Aceptar");					resVal=0; return;				}			}											} // End ValidarDatos()						//-----------------------BAJA,CONSULTA----------------------------			fun MostrarDatos(nFolio) {					var cmd,xmlRequest,xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError,   ;						sucursal_id = frn.get("k_sucn",-1,1);					cmd= " select c10 as k_clave, c9 as k_fecha,c11 as k_refer ,c69 as k_hora , c24 as k_coment, c43 as estatus_doc , c197 as fecha_baja " ;			cmd = cmd & " , c14 as k_iva, c16 as k_monto, (c16-c14) as k_subtotal "; /*Added by JMM 20240606*/						cmd = cmd & " from keplersc.kdm1 where c1='" & sucursal_id  & "' and c2='" & gen_doc  &"' and c3='" & nat_doc & "' and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cheque_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			var xml_kdm1  = getXml(cuboResultados,"r0" );			//frn.setX(cuboResultados ); TODO, checar setX			// Moved down by JMM, 20240202			frn.set("k_clave",getXmlAtt(xml_kdm1,"k_clave") );			/*			frn.set("k_fecha",getXmlAtt(xml_kdm1,"k_fecha") );			frn.set("k_hora",getXmlAtt(xml_kdm1,"k_hora") );			frn.set("k_coment",getXmlAtt(xml_kdm1,"k_coment") );			*/						BuscarProveedor();						// Moved here by JMM, 20240202			//frn.set("k_clave",getXmlAtt(xml_kdm1,"k_clave") );			frn.set("k_fecha",getXmlAtt(xml_kdm1,"k_fecha") );			frn.set("k_hora",getXmlAtt(xml_kdm1,"k_hora") );			frn.set("k_coment",getXmlAtt(xml_kdm1,"k_coment") );						frn.set("k_refer",getXmlAtt(xml_kdm1  ,"k_refer") );									fecha_baja = getXmlAtt(xml_kdm1  ,"fecha_baja");						estatus_doc = getXmlAtt(xml_kdm1  ,"estatus_doc");							if (estatus_doc &= "C"){	// C=Cancelado				frn.message("El Cheque se encuentra cancelado","Error","Aceptar");				frn.set("statusdoc", "CANCELADO");			}else{				frn.set("statusdoc", "");			}			rstXml(cmd);						// Commented by JMM, 20240205			/*			cmd = "select c14 as k_factura,c12 as k_monto_factura,c13 as k_iva_factura from keplersc.kdm5 where c1='" & sucursal_id & "' and c2='" & gen_doc &"' and c3='" & nat_doc & "'";			cmd = cmd & " and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";			*/						//Updated with ORs TBLs.doc_refer_compl in links selects , 20240409			cmd = "select " &  				"coalesce(w1.uuid_serie,'') c_serie, coalesce(w1.uuid_folio, '') c_folio, " &				"abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) saldo, to_date( coalesce(g.c12::text , current_date::text) ,'yyy-mm-dd') vencimiento, " &				"/*coalesce(w1.c11,w5.c14) UPD by JMM 20240724*/ coalesce(w5.c14, coalesce(w1.c11,'') ) k_factura, " &				"w5.c12 k_monto_factura, w5.c13 k_iva_factura, '' k_factura_rfc, w5.cve_prov_oper k_prov " &				"from keplersc.kdm5 w5 " &				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kduxg g on g.c1 = w5.c1 and g.c2 = w5.c2 and (g.c4 = w5.c14 or g.doc_refer_compl = w5.c14) " & 				" and w5.cve_prov_oper = g.c3 /*= w1.c10 upd for addapting 20240624*/ /*Added by JMM 20240606*/ and w5.cve_prov_pago = g.cve_prov_pago /*Added by JMM 20240624*/ " &  				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kduxe e on e.c1 = g.c1 and e.c2 = g.c3 and e.c3 = g.c4 and e.c5 = g.c2 and e.c6 = 'A' and e.c11 = g.c11 " & 				"/*Added by JMM 20240724*/ and ( e.c13 > 0 /* or monto_rollback = 0 */ )" & 				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kdm1 w1 on w1.c1 = w5.c1 and w1.c2 = w5.c2 and w1.c3 = 'A' and w1.c4 = e.c7 and w1.c5 = e.c8  and (w1.c11 = w5.c14 or w1.doc_refer_compl = w5.c14) /*and w1.c43 <> 'C'*//*Added 20240515 Commented 20240624*/ " &				" and w1.c10 = w5.cve_prov_oper /*Added by JMM 20240606*/ and w1.cve_prov_pago = w5.cve_prov_pago /*Added by JMM 20240624*/ " & 				" /*Added by JMM 20240724*/ and w1.c6 = e.c9 " & 				"where w5.c1='" & sucursal_id & "' and w5.c2='" & gen_doc &"' and w5.c3='" & nat_doc & "' and w5.c4=" & gpo_doc & " " & 				"and w5.c5=" & tip_doc & " and w5.c6='" & nFolio & "' ";						frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\Query_MostrarDatos");						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cheque_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_MostrarDatos");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}						frn.setX(cuboResultados, "k_mov");			//Commented by JMM 20240606 			//CalcTotal();						// Added by JMM 20240606 			// /*			frn.set("k_subtotal",getXmlAtt(xml_kdm1,"k_subtotal") );			frn.set("k_iva",getXmlAtt(xml_kdm1,"k_iva") );			frn.set("k_monto",getXmlAtt(xml_kdm1,"k_monto") );			// */						ArmarRefDocto();													} //End MostrarDatos()								//-----------------REPORTE-----------						// ----------------------------------------------	 START : NEW FUNCTIONS IMPLEMENTED BY JMM 20240606  --------------------------------------------				// ZONA	CODIGO REPORTE(S) 						fun IniParams(){//Inicializa parámetros de impresión. Pueden ser cambiados por el usuario final mediante menú: Archivo -> Configurar Página				frn.set("param_paper","letter");	//Tamaño de papel predefinido:	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tamaño de papel personalizado	"size=21.59,27.94cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//Márgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0");	//Escala de impresión (1=100 por ciento)	"F=1,1"				frn.set("param_landscape","L"/*Y*/);	//Orientación	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"				frn.set("param_emp","L");	//Posición de "Razón social"(izq,der,cen)	@emp=L|R|C"			}						fun setRepPage() {//Establece los parámetros finales de impresión.				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Ejecuta_Reporte() {							// Commented 20221208 				//IniParams(); //Inicializa parámtros de impresión entre otros							Reporte();						} /* END Func Ejecuta_Reporte() */						fun Reporte() {							// Our Vars				var compania, titrep, titrepaux;				//var contProd, contDet, tmpStr ,xmlDet, xmlCurDocto;				var nFolio;				//var p_fecha, var_fecha;				//var p_subtotal, p_utilidad, p_perce, p_costo, p_total, p_iva;				//var gt_subtotal, gt_utilidad, gt_perce, gt_costo, gt_total, gt_iva;								if( strlen(trim(frn.get("k_folio")))==0 || strlen(trim(frn.get("k_fecha")))==0 ){ 					frn.message("Es necesario seleccionar un documento valido a consultar ...","Error","&Aceptar");					frn.setPos("k_folio");					return;				}								//Obtener datos generales				kdb.kde("KDE");//Configuracion del servidor				kdb.exec();				compania = kdb.get("KDE","1");									// Se define el formato a usar y se liga a la variable del reporte "rep"	// Se define el formato a usar y se liga a la variable del reporte "rep"				rep.rst(); // 20121208				IniParams(); // 20121208				kdb.readPage("datFto","srv_cheque_doc_fto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				//rep.rst(); // 20121208				setRepPage();//Establece los parámetros finales de impresión(rep.page(...);), pues pueden haber cambiado por el usuario 				//Da valor a los inputs del reporte(rep.set();), e indica la ejecución de "grupos de renglones de impresión" (rep.exe();)								titrepaux = frn.get("k_tipon", -1, 0);				titrep = "C H E Q U E  -  ";				rep.set("leyendatx", "[ " & frn.get("k_clave") & " ]   " & frn.get("k_nombreprov") & "   [ " & frn.get("k_rfc") & " ]");				rep.set("fechoper","Datos Transaccion  :  Folio  " & frn.get("k_folio") & "  ,  Fecha  " & frn.get("k_fecha"));				if( strlen(trim(frn.get("statusdoc"))) > 0 ){ 					rep.set("estatustx", frn.get("statusdoc") );				}								rep.set("fecha",sys.date());				rep.set("hora",sys.time());				rep.set("nombreempresa",compania);				rep.set("tituloreporte",titrep & titrepaux);									rep.exe("encabezado");												sucursal_id = frn.get("k_sucn",-1,1);				nFolio = frn.get("k_folio");								cmdQuery = "select " &  				"w5.cve_prov_pago k_clave, coalesce(d.c3, coalesce(d2.c3,'No Existe ...')  ) k_nombreprov, coalesce(w5.cta_deposito,'') c_cuenta, " &				"coalesce(w1.uuid_serie,'') c_serie, coalesce(w1.uuid_folio, '') c_folio, " &				"abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) saldo, to_date( coalesce(g.c12::text , current_date::text) ,'yyy-mm-dd') vencimiento, " &				"/*coalesce(w1.c11,w5.c14) UPD by JMM 20240724*/ coalesce(w5.c14, w1.c11) k_factura, " &				"w5.c12 k_monto_factura, w5.c13 k_iva_factura, '' k_factura_rfc, w5.cve_prov_oper k_prov " &				", coalesce(w5.st_x_comprobar,'') paso /*added by JMM 20240605*/ " & 				", coalesce(d2.c3,'') provopernomb /*added by JMM 20240606*/ " & 				"from keplersc.kdm5 w5 " &				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kduxg g on g.c1 = w5.c1 and g.c2 = w5.c2 and (g.c4 = w5.c14 or g.doc_refer_compl = w5.c14) " &				"/*line added by JMM 20240520*/ and w5.cve_prov_oper = g.c3 and w5.cve_prov_pago = g.cve_prov_pago " &				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kduxe e on e.c1 = g.c1 and e.c2 = g.c3 and e.c3 = g.c4 and e.c5 = g.c2 and e.c6 = 'A' and e.c11 = g.c11 " & 				"/*Added by JMM 20240724*/ and ( e.c13 > 0 /* or monto_rollback = 0 */ )" & 				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kdm1 w1 on w1.c1 = w5.c1 and w1.c2 = w5.c2 and w1.c3 = 'A' and w1.c4 = e.c7 and w1.c5 = e.c8 and (w1.c11 = w5.c14 or w1.doc_refer_compl = w5.c14) /*and w1.c43 <> 'C'*//*Added 20240515 Commented 20240520*/ " &				"/*line added by JMM 20240520*/ and w1.c10 = w5.cve_prov_oper and w1.cve_prov_pago = w5.cve_prov_pago " & 				" /*Added by JMM 20240724*/ and w1.c6 = e.c9 " &				"left join keplersc.kdxd d on d.c1 = w5.c1 and d.c2 = w5.cve_prov_pago " &  				"left join keplersc.kdxd d2 on d2.c1 = '" & sucursal_id & "' and d2.c2 = w5.cve_prov_oper " & /* w1.c10  ... '" & prov_hist & "' */				"where w5.c1='" & sucursal_id & "' and w5.c2='" & gen_doc &"' and w5.c3='" & nat_doc & "' and w5.c4=" & gpo_doc & " " & 				"and w5.c5=" & tip_doc & " and w5.c6='" & nFolio & "' ";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_transfer_crud()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\srv_transfer_crud_rpt");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									for(var x=0; x < nXml(cuboQuery); x++)				{											rep.set("fact", getXmlAtt(cuboQuery,"r"&x,"k_factura"));					rep.set("monto",getXmlAtt(cuboQuery,"r"&x,"k_monto_factura"));					rep.set("iva", getXmlAtt(cuboQuery,"r"&x,"k_iva_factura"));					rep.set("provoper", getXmlAtt(cuboQuery,"r"&x,"k_prov"));					rep.set("nombre", getXmlAtt(cuboQuery,"r"&x,"provopernomb"));																						rep.exe("detalle");				}								if (nXml(cuboQuery) > 0) { 									rep.exe("linea_t1"); 										rep.set("tsubt", frn.get("k_subtotal"));					rep.set("tiva", frn.get("k_iva"));					rep.set("ttot", frn.get("k_monto"));					rep.set("ttottx", strFormat("number",frn.get("k_monto"),0) );					rep.exe("total");										rep.exe("linea_t2");										rep.set("ref", frn.get("k_refer"));					rep.set("comment", frn.get("k_coment"));					rep.exe("comentarios");									}													//Modos de impresión 				rep.win(); //Muestra la vista previa de la impresión. A partir de la vista previa (Preprint) se decide si se imprime o no.				//rep.print("\\192.168.1.100\HPLaserJet"); //Envía el reporte directamente a una impresora, sin mostrar la vista previa.				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresión. No muestra la vista previa.				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardará el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html										} /* END Func Reporte() */									// END : ZONA	CODIGO REPORTE(S)						// ----------------------------------------------	 END : NEW FUNCTIONS IMPLEMENTED BY JMM 20240606  --------------------------------------------							//Commented by JMM 20240605, for New Print Fto ... old functions related to printing rpt --> Poliza, were commented			/*			fun EjecReporte(){								var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var cuboResultados, xmlRequest,sqlXmlResultados,xmlCurDocto,xmlCurMovto,cmd,ok,mensaje;								kdb.kde("KDE");//Configuraciï¿½n del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();								kdb.readPage("datos","srv_cheque_crudfto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parï¿½metros finales de impresiï¿½n.(rep.page(...);)				rep.set("suc_desc", frn.get("k_sucn", -1, 0));				rep.set("docto",frn.get("k_docto"));				rep.set("fecha",frn.get("k_fecha"));				rep.set("rep_fecha",fechaImpresion);				rep.set("rep_hora",horaImpresion);				rep.set("k_clave",frn.get("k_clave"));				rep.set("k_nombreprov",frn.get("k_nombreprov"));				rep.set("k_calleprov",frn.get("k_calleprov"));				rep.set("k_coloniaprov",frn.get("k_coloniaprov"));				rep.set("k_poblacionprov",frn.get("k_poblacionprov"));				rep.set("k_cpprov",frn.get("k_cpprov"));				rep.set("k_rfc",frn.get("k_rfc"));				rep.set("referencia",frn.get("k_refer"));				rep.set("k_monto",frn.get("k_monto"));								//TODO				rep.set("cantidad_en_letra",strFormat("number",frn.get("k_monto"),0));				rep.exe("encabezado");				rep.exe("tit_reporte");				rep.exe("encabezadoColumnas");				rep.exe("linea_encabezados");				//Procesa poliza contable				var tablakdc1_alta = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;				var tablakdc2_alta = " keplersc.kdc2" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) & strSplit(frn.get("k_fecha"), "-", 1);				var tablakdc1_baja = " keplersc.kdc1" & mid(strSplit(fecha_baja, "-", 0), 2,2) ;				var tablakdc2_baja = " keplersc.kdc2" & mid(strSplit(fecha_baja, "-", 0), 2,2) & strSplit(fecha_baja, "-", 1);				var tipo = ""; var nPolAlta = "" ;				if (tablakdc2_baja &= tablakdc2_alta ){					tipo = "Misma_tabla";										cmd= " select c1 as num_pol from " & tablakdc2_alta & " where c14='" & sucursal_id  & "' and c15='" & gen_doc & "' and c16= '" & nat_doc & "'" ;					cmd = cmd & " and c17='" & gpo_doc & "' and c18='" & tip_doc & "' and c19='" & frn.get("k_folio")& "'";									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.GenerarReporte()");					frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");									ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}									nPolAlta =getXmlAtt(cuboResultados,"r0", "num_pol" );								}				imprime_poliza(tablakdc1_alta , tablakdc2_alta, "Alta", tipo, nPolAlta);								if (estatus_doc &= "C" && fecha_baja &! "1800-01-01" && fecha_baja &! "" ){					imprime_poliza(tablakdc1_baja , tablakdc2_baja, "Baja", tipo, nPolAlta);				}								rep.set("desc_notas",frn.get("k_coment"));				rep.exe("notastitulos");				rep.exe("extras");				rep.win();									}									fun imprime_poliza(tablakdc1 , tablakdc2, operacion, tipo, nPolAlta ){							var cmd, cuboResultados , ok;								//Procesa poliza contable				cmd= " select kc2.c1 as num_pol, kc2.c3 as cuenta, kc2.c4 as tipo_asiento, kc2.c5 as monto, kc1.c2 as desc_pol, kc2.c7 as refer, kc2.c8 as tipo_pol from " & tablakdc2 & " as kc2 " ;				cmd = cmd & " inner join " & tablakdc1 & " as kc1 on kc1.c1=kc2.c3 ";				cmd = cmd & " where kc2.c14='" & frn.get("k_sucn", -1, 1) & "' and kc2.c15='" & gen_doc & "' and kc2.c16= '" & nat_doc & "' and kc2.c17='" & gpo_doc & "' and kc2.c18='" & tip_doc & "' and kc2.c19='" & frn.get("k_folio")& "'";				if (operacion &= "Alta" && tipo &= "Misma_tabla"){					cmd = cmd & " and kc2.c1 = " & nPolAlta ; 				}				if (operacion &= "Baja" && tipo &= "Misma_tabla"){					cmd = cmd & " and kc2.c1 <> " & nPolAlta ; 				}												//Added by JMM 20240314				cmd = cmd & " order by kc2.c1, kc2.c10 "; 				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.imprime_poliza()");				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var nRenPol= nXml(cuboResultados);				var tPoliza=getXmlAtt(cuboResultados,"r0", "tipo_pol" );				var nPoliza=getXmlAtt(cuboResultados,"r0", "num_pol" );								if (strlen(tPoliza)>0 && strlen(nPoliza)>0 ){						rep.set("tPol",tPoliza);						rep.set("nPol",nPoliza);						rep.exe("encabezadoPol");						var tAbonosPol=0, tCargosPol=0;						for(var i=0;i<nRenPol;i++){							if (getXmlAtt(cuboResultados,"r"&i, "tipo_asiento" )&= "A"){								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave2",cuenta );								rep.set("PolDescr2",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolHaber",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tAbonosPol=tAbonosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								pol_saldo_presupuesto(cuenta);								rep.set("PolSaldo2",saldo);								rep.set("PolPresupuesto2",presupuesto );								rep.exe("partPolA");							}else{								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave",cuenta );								rep.set("PolDescr",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolDebe",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tCargosPol=tCargosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								pol_saldo_presupuesto(cuenta);								rep.set("PolSaldo",saldo );								rep.set("PolPresupuesto",presupuesto );								rep.exe("partPolC");							}						}						rep.set("totCargo",tCargosPol);						rep.set("totAbono",tAbonosPol);						rep.exe("PolTotales");				}			}						fun pol_saldo_presupuesto(cuenta){						var cmd, cuboResultados , ok, mensajeError  ;								var mes = strSplit(frn.get("k_fecha"), "-", 1);				tabla = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2);								var col_cargos = 26 + mes;				var col_abonos = 62 + mes;				var col_presupuesto= 38 + mes;				 				cmd= " select c" & col_cargos & " as cargos ,c" & col_abonos & " as abonos ,c" & col_presupuesto & " as pres from " & tabla & " where c1='" & cuenta & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.pol_saldo_presupuesto()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				var cargos = getXmlAtt(cuboResultados,"r0", "cargos" );				var abonos = getXmlAtt(cuboResultados,"r0", "abonos" );				presupuesto = getXmlAtt(cuboResultados,"r0", "pres" );				saldo = cargos - abonos;			}					*/								fun Formar_folio(){							var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);								//Added by JMM, 20240205 				borrar_datos();				LimpiaEncabezado(1);							} // End : Formar_folio()								//Commented by JMM 20240605, for New Print Fto			/*						fun IniParams(){//Inicializa parï¿½metros de impresiï¿½n, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Pï¿½gina				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}			fun setRepPage() {//Establece los parï¿½metros finales de impresiï¿½n.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						*/				} // End of class Main	</script></pag>