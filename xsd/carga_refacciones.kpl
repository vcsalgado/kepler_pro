<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Carga Refacciones"><grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><tab/><txt fnt=",22" clr="0,0,0">Carga de Refacciones</txt><br/><tab/>	<hLine dim="0,1" clr="0,0,0"/> 	<br/> <br/>	<tab n="1"/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="64,10,7,12" tit="Datos generales"  fnt="Arial,16"><tab/>		<txt clr="0,58,112" hk="S">Sucursal</txt><tab n="2"/>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="BorraDatos()" available="Y"/><br/><tab/>	   <txt clr="0,58,112">Tipo docto</txt><tab n="1"/>		<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255"  dim="35,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="TipoMov()" OnEnter="TipoMov()"/><br/><tab/>		<inp id="tipo_movto" clr="64,64,64"  dim="40,1" brdr="0,1" fnt=",16b" available="N" visible="N" type="string"/><br/>	</grp><sp/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="45,10,7,12" tit="Documento" fnt="Arial,16">		<tab n="3"/><inp id="operacion" clr="64,64,64"  dim="18,1" brdr="0,1" fnt=",18bs" available="N" type="string"/><br/><tab/>		<txt id="foliotxt"  visible="N" hk="F" clr="0,58,112" fnt="Arial,16">Folio</txt><tab/>		<edt id="k_folio" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" visible="N" hk="F"  			tooltip="Folio del movimiento ( F9 b&#250;squeda )"  OnF9="ObtenerFolio()" OnMouseL="ObtenerFolio()" OnChange="Formar_folio()" nc="10"/><tab/>		<img id="k_buscar_folio" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_folio()" 			tooltip="Consultar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>		<inp id="statusDoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/>			<br/><tab/>		<inp id="k_docto" clr="64,64,64"  dim="25,1" brdr="0,1" fnt="Arial,16" available="N" link="k_tipon,5" type="string"/><br/><tab/><txt clr="0,58,112" fnt="Arial,16">Fecha</txt><tab/>		<edt id="k_fecha" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" modify="Y" available="Y"/><br/><tab/> 			</grp><br/><br/>	<tab n="1"/>	<grp id="grpDetalle" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5" dim="78,18,7,10" tit="Orden"  fnt="Arial,16" available="Y" modify="Y"><br/>		<tab/><txt id="Orden_txt" clr="0,58,112" visible="Y">Orden</txt><tab/>		<sp/>		<cmb id="k_tipo_orden" clr="64,64,64" clrBrdr="255,255,255" OnChange="BorraDatos(bus_orden)" dim="20,40" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N" visible="Y" available="Y" modify="Y"/>		<sp/>		<inp id="k_orden" clr="64,64,64"  dim="20,1" fnt="Arial,16"  OnF9="SeleccionarOrden()"   OnChange="Orden()" tooltip="Seleccionar orden F9"  clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" modify="Y" type="capital"/>						<tab n="1"/>		<inp id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="8,1" fnt="Arial,16" type="string" modify="N" available="N"/><sp/>		<inp id="k_nombre" clr="64,64,64" clrBrdr="255,255,255"  dim="30,1" fnt="Arial,16" type="string" modify="N" available="N"/>		<br/>	<br/>						<tab n="1"/><tbl id="tabla_puntos" dim="106,6" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" modify="N" nren="fijo">		<col id="tipo_punto" name="Tipo Punto"/>		<col id="clave_paquete"  name="Paquete" visible="N"/>		<col id="clave_campana"   name="Campana" visible="N"/>		<col id="trabajo_a_realizar"   name="Descripcion"/>		<col id="operario"  name="Operario"/>		<col id="estatus" name="Estatus"/>		</tbl> 						</grp>		<sp/>				<grp bclr="236,240,243" fntClrBrdr="236,240,243"  unfont="0" fntBrdr="Arial,18"  tit="Resumen de la Orden" clrBrdr="0,58,112" dim="31,18,10,10" brdr="0,5" fnt="Arial,16">			<br/>				<tab n="1"/><sp n="2"/><txt  fnt="Arial,16,b">Mano de Obra:</txt>	<sp/>				<inp id="mano_obra"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N" nd="2" clrBrdr="255,255,255"/>				<br/>	<tab n="1"/><sp n="2"/><txt  fnt="Arial,16,b">Refacciones:</txt>	<sp n="2"/>				<inp id="refacciones"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N"  nd="2" clrBrdr="255,255,255"/>				<br/>	<tab n="1"/><sp n="2"/><txt  fnt="Arial,16,b">TOTs:</txt>	<sp n="7"/>				<inp id="tots"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N" nd="2" clrBrdr="255,255,255"/>				<br/>	<tab n="1"/><sp n="2"/><txt  fnt="Arial,16,b">Cargos Varios:</txt>	<sp/>				<inp id="cargos_varios"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N"  nd="2" clrBrdr="255,255,255"/>				<br/>	<tab n="1"/><sp n="2"/><txt  fnt="Arial,16,b">Subtotal:</txt>	<sp n="5"/>				<inp id="subtotal"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N"  nd="2" clrBrdr="255,255,255"/>				<br/>	<tab n="1"/><sp n="2"/><txt  fnt="Arial,16,b">IVA:</txt>	<sp n="8"/>				<inp id="iva"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N"  nd="2" clrBrdr="255,255,255"/>				<br/>	<tab n="1"/><sp n="2"/><txt  fnt="Arial,16,b">Importe:</txt>	<sp n="5"/>				<inp id="importe"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255"  nd="2" available="N"  clrBrdr="255,255,255"/>		</grp>										<br/>		<br/>	<tab n="1"/>	<grp id="gpo_ref" bclr="236,240,243" fntClrBrdr="236,240,243"  fntBrdr="Arial,18" hSpace="0" tit="Refacciones" clrBrdr="0,58,112" dim="110,32,7,12" brdr="0,5"  fnt="Arial,16"><tab n="4"/><br/><tab/><txt id="tipoprecio_txt" clr="0,58,112" visible="Y">Tipo de Precio</txt><tab/>		<cmb id="k_tipoprecio" clr="64,64,64" clrBrdr="255,255,255" OnChange="calc_precio()" dim="20,40" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N" visible="Y"/>		<br/><br/>		<tab n="1"/><inp id="tit_tabla_1" clr="64,64,64"  dim="18,1" brdr="0,1" fnt="Arial,16" available="N"  type="string"/> <tab n="15"/><sp/>		<inp id="tit_tabla_2" clr="64,64,64"  dim="18,1" brdr="0,1" fnt="Arial,16" available="N"  type="string"/> <tab n="9"/><sp n="2"/>		<inp id="tit_tabla_3" clr="64,64,64" brdr="0,1" fnt="Arial,16" available="N"  type="string" dim="18,1"/>		<br/>				<tab n="1"/>		<tbl id="k_mov" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="150,10"  hk="z" OnChange="" Reorder="N" modify="Y" available="Y">			<col id="k_parte" name="Articulo" type="capital" nc="18" tooltip="[F9] Buscar Refaccion, [F10] Crear Refaccion, [F11] Modificar Refaccion"						OnF9="ConsultaProductos()" OnMouseL="ConsultaProductos()"			OnF10="Dialog(3,cat_prod_crud,Nuevo,x,s)" 			OnF11="Dialog(3,cat_prod_crud,Modificar,x,s)" OnF7="Dialog(3,invrepestprod,s)"    OnF8="Dialog(3,reemplazo_ref,s)"			OnChange="ValidaArticulo()" OnActive="CalcTotalImporte()" modify="Y"/>			<col id="k_q" name="Cantidad"  type="number" nd="-1" OnChange="Cantidad()" OnActive="CalcTotalImporte()"/>			<col id="k_unidad" name="Unidad" modify="N" type="capital" OnActive="CalcTotalImporte()"/>			<col id="k_precio" name="Precio" modify="Y" type="number" OnChange="Cantidad()" nd="2" visible="Y" OnF11="CambiarPrecio()" OnActive="CalcTotalImporte()" tooltip="[F11] Actualizar Precio"/>			<col id="k_monto" name="Importe"  type="number"  nd="6" min="0" OnChange="Monto()" OnActive="CalcTotalImporte()" modify="N"/>			<col id="k_control" name="Punto" type="number" nc="2" OnChange="valida_punto()" OnActive="CalcTotalImporte()"/>			<col id="k_descr" name="Descripci&#243;n" modify="N" OnActive="CalcTotalImporte()"/>			<col id="k_partesel" name="Ref. Original" type="capital" nc="18" modify="N" OnActive="CalcTotalImporte()"/>			</tbl>						<tab n="1"/>		<sp/>				<tbl id="refacciones_cargadas" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  hk="z" OnChange="" Reorder="N" modify="N" available="Y" visible="N">			<col id="articulo_cargado" name="Articulo" type="capital" nc="18"	 modify="Y"/>			<col id="cantidad" name="Cant"  type="number" nd="-1"/>			<col id="monto" name="Importe"  type="number" nd="2" min="0"/>			<col id="punto" name="Punto"/>			<col id="folio" name="Folio"/>			<col id="k_partesel" name="Ref. Original" type="capital"/>		</tbl>				<sp/>						<tbl id="refacciones_necesarias" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  hk="z" OnChange="" Reorder="N"  available="Y" visible="N">			<col id="articulo_necesario" name="Articulo" type="capital" nc="18" modify="N"/>			<col id="cantidad" name="Cant" modify="N"  type="number" nd="-1"/>			<col id="punto" modify="N"  name="Punto"/>			<col id="cadena_reemplazo" name="Cadena Reemplazo"  available="Y"/>		</tbl>				<br/><tab/><txt clr="255,0,34" fnt=",14">* El precio es el de la refacci&#243;n original, F11 para actualizar.</txt><br/>				<br/>		<grp dim="90,4,7,12" brdr="0,5">			<tab n="2"/><txt clr="0,58,112">Comentarios</txt>			<tab/><inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="70,3" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" type="capital" available="Y"/>		<sp/>		</grp>		<tab n="4"/>				<grp dim="80,5,7,12" brdr="0,5">			<tab n="1"/><txt>Subtotal</txt><tab n="2"/>			<inp id="subt" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" available="N"/>			<br/>			<tab n="1"/><txt>IVA</txt><tab n="3"/>			<inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="6" modify="N" available="N"/>			<br/>			<tab n="1"/><txt fnt=",16b">IMPORTE</txt><tab/>			<inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="N"/>		</grp>		<br/><br/>		<tab n="37"/>		<grp dim="16,4,7,12" brdr="0,5">			<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="n datos" available="Y" clrBrdr="0,0,0" visible="Y"/><tab/>			<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Alta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><tab/>			</grp>	</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb, sys, rep;			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc, tip_ope, anio_contable, sucursal_id;			var usuario,suc_usuario, rol_usuario,asterisco,refer_orden,nuevo_folio, etiqueta_necesarias , etiqueta_cargadas  ;			var especificaciones_doc ;			var monto_total,uen;			var folio;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();				sys=new SYS;				rep=new REP;				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				if(frn.param(0)&= "")				{					frn.message("Esta accion no esta permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}				gen_doc=trim(frn.param(0)); 				nat_doc=trim(frn.param(1)); 				gpo_doc=trim(frn.param(2));				tip_doc=1;				fija_doc=trim(frn.param(4));				tip_ope=trim(frn.param(5));				uen=trim(frn.param(6));				if (uen &= ""){					uen="XXX";				}				ctrls_off();				Inicializa();					}						//--------------------------------------------CONFIGURACIONES--------------------------------------									fun Inicializa(){				kdb.kde("KDE");//Configuracion del servidor				kdb.exec();				anio_contable = kdb.get("KDE","14");				var cmd, cubo, ok,resValidacion,resMensaje ;				//Valida usuario administrador				kdb.rst();				frn.rst("results");				frn.set("k_hora",sys.time());							//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";								if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR" && rol_usuario &! "Administrador Kepler 8.0" && rol_usuario &! ""){											cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",getXml(cubo));					rstXml(cubo);				cmd = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Inicializa()");//				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTipoDocto");						ok=getXmlAtt(cubo ,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo ,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error BD","Aceptar");					return;				}				frn.set("k_tipon",getXml(cubo ));				frn.set("k_docto",frn.get("k_tipon",-1,5));								//Llenar combo tipo de precio				cmd = "select '['||c1||'] '||c2 as descripcion,c1 as clave from keplersc.kdicatprecio";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);										frn.message(mensajeError,"Error","Aceptar");					return;				}						//frn.setX("", "k_tipoprecio",0,0);				llenar_cmb(cubo,"k_tipoprecio");					frn.setPos("k_tipoprecio","val:'[TALL] TALLER'");				//frn.setX("", "k_tipoprecio",0,0);								LlenarTipoOrden();				if (tip_ope== 0){					fecha_config();				}			}						fun LlenarTipoOrden(){				var cmd,cubo, ok, tip_mov ;				//Llenar combo tipo orden				tip_doc=frn.get("k_tipon",-1,4);				if (tip_doc &= "1"){					cmd = "select '['||c1||'] '||c3 as descripcion, c1 as clave  from keplersc.kdmargen where c1 not in ('C','G')";								}else{					cmd = "select '['||c1||'] '||c3 as descripcion, c1 as clave  from keplersc.kdmargen where c1 in ('C','G')";				}				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);										frn.message(mensajeError,"Error","Aceptar");					return;				}			   var cmd_tipo_orden = "k_tipo_orden";				frn.rst("k_tipo_orden");				llenar_cmb(cubo ,cmd_tipo_orden);									frn.set("k_tipo_orden", "[T] Normal");										}									fun ctrls_off() {				frn.setAtt("foliotxt", "visible", "N" );				frn.setAtt("k_folio", "visible", "N" );				frn.setAtt("k_buscar_folio", "visible", "N" );				frn.setAtt("Aceptar", "visible", "N" );				frn.setAtt("Cancelar", "visible", "N" );				frn.setAtt("k_mov", "modify", "N" );				frn.setAtt("k_fecha", "modify", "N" );				frn.setAtt("k_coment","modify", "N");				frn.setAtt("k_orden", "modify", "N" );				frn.setAtt("k_tipo_orden", "modify", "N" );				frn.setAtt("k_tipoprecio", "visible", "N" );				frn.setAtt("tipoprecio_txt", "visible", "N" );				frn.setAtt("tabla_puntos", "visible", "N", "clave_paquete" );				frn.setAtt("tabla_puntos", "visible", "N", "clave_campana" );				frn.setAtt("buscar_orden", "visible", "N" );											dimensiones_tablas_default();								if (tip_ope== 0){					botones_alta();								}else{					botones_consulta();				}			}						fun botones_alta(){					frn.set("operacion","ALTA");					frn.setAtt("Aceptar", "visible", "Y" );					frn.setAtt("Cancelar", "visible", "Y" );					frn.setAtt("k_fecha", "modify", "Y" );					frn.setAtt("k_orden", "modify", "Y" );					frn.setAtt("k_tipo_orden", "modify", "Y" );					frn.setAtt("k_mov", "modify", "Y" );					frn.setAtt("k_coment","modify", "Y");					frn.setAtt("k_tipoprecio", "visible", "Y");					frn.setAtt("tipoprecio_txt", "visible", "Y" );					frn.setAtt("buscar_orden", "visible", "Y" );								}						fun botones_consulta(){				frn.set("operacion","CONSULTA");				frn.setAtt("foliotxt", "visible", "Y" );				frn.setAtt("k_buscar_folio", "visible", "Y" );				frn.setAtt("k_folio", "visible", "Y" );				frn.set("tit_tabla_1", "CARGADAS" );				frn.set("tit_tabla_2", "" );				frn.set("tit_tabla_3", "" );							}							fun BorraDatos(origen) {				frn.rst("k_mov");				frn.rst("refacciones_cargadas");				frn.rst("refacciones_necesarias");				frn.rst("k_monto");				frn.rst("k_coment");				frn.rst("subt");				frn.rst("k_iva");				frn.rst("k_monto");				if (origen &! "bus_orden"){					frn.set("k_tipo_orden", "[T] Normal");				}										frn.set("k_orden", "");				//frn.set("k_tipoprecio", " ");				frn.rst("tabla_puntos");				frn.rst("resumen_ord");				frn.rst("mano_obra");				frn.rst("refacciones");				frn.rst("tots");				frn.rst("cargos_varios");				frn.rst("subtotal");				frn.rst("iva");				frn.rst("importe");				frn.rst("k_clave");				frn.rst("k_nombre");			}									fun dimensiones_tablas_default(){										frn.set("tit_tabla_1", "SELECCIONA" );								frn.setAtt("tit_tabla_2", "dim", "18,1" );				frn.setAtt("tit_tabla_3", "dim", "18,1" );										frn.setAtt("refacciones_cargadas", "visible", "N" );				frn.setAtt("refacciones_necesarias", "visible", "N" );								frn.setAtt("refacciones_cargadas", "dim", "" );				frn.setAtt("refacciones_necesarias", "dim",  "" );				frn.setAtt("k_mov", "dim", "150,10" );			}									fun ajusta_dimensiones_tablas(){						dimensiones_tablas_default();																if (etiqueta_cargadas &= "S"){									frn.setAtt("refacciones_cargadas", "dim",  "45,10" );					frn.setAtt("refacciones_cargadas", "visible", "Y" );					frn.setAtt("k_mov", "dim", "92,10" );								}								if (etiqueta_necesarias &= "S"){									frn.setAtt("refacciones_necesarias", "dim",  "42,10" );					frn.setAtt("refacciones_necesarias", "visible", "Y" );					frn.setAtt("k_mov", "dim", "95,10" );				}												frn.set("tit_tabla_2", "" );				frn.set("tit_tabla_3", "" );											if (etiqueta_necesarias &= "S" && etiqueta_cargadas &= "S" ){									frn.setAtt("k_mov", "dim", "62,10" );					frn.set("tit_tabla_2", "CARGADAS" );					frn.set("tit_tabla_3", "NECESARIAS" );							}												if (etiqueta_cargadas &= "S" &&  etiqueta_necesarias &= "N" ){					frn.set("tit_tabla_3", "" );					frn.setAtt("tit_tabla_3", "dim", "" );					frn.setAtt("tit_tabla_2", "dim", "50,1" );									frn.set("tit_tabla_2", "                                                    CARGADAS" );									}															if (etiqueta_necesarias &= "S" &&  etiqueta_cargadas &= "N" ){										frn.set("tit_tabla_3", "" );					frn.setAtt("tit_tabla_3", "dim", "" );					frn.setAtt("tit_tabla_2", "dim", "50,1" );													frn.set("tit_tabla_2", "                                                           NECESARIAS" );								}								}														//-----------------------------------------------BUSCAR ORDEN-------------------------------								fun SeleccionarOrden(){				BorraDatos("bus_orden");				var cmdQuery;				cmdQuery="select c3 as Folio, to_char(c4,'yyyy-mm-dd') as Fecha, c10 as Cliente, c11 as Nombre from keplersc.kdord ord where ord.c1='" & 					frn.get("k_sucn",-1,1) & "' and c2='" & frn.get("k_tipo_orden",-1,1) & "' order by c4 desc, c3 desc ";				frn.dialog("genlistafiltrosel","Movimiento a taller",cmdQuery,"folio","k_orden","0","","S");			}											fun Orden(){									etiqueta_necesarias = "N"; etiqueta_cargadas = "N"; 				var cuboResultados , cmd, ok, totOrd,contOrd;				var ordn = frn.get("k_orden");				var tordn = frn.get("k_tipo_orden" , -1, 1);				BorraDatos("bus_orden");				ordn=frn.lib("libGeneral.kpl","PadLeft",ordn,10,"0");				frn.set("k_orden",ordn);				sucursal_id=frn.get("k_sucn",-1,1);											cmd =	" select c6,c10,c11 from keplersc.kdord where c1='" & sucursal_id & "' and c2='" & tordn &  "' and c3='" & ordn & "'";								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Orden()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\ordenSelXml");				ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				totOrd= nXml(cuboResultados);				if(totOrd ==0){					frn.message("La orden no existe","Mensaje","&Aceptar");					return;				}								var cli =getXmlAtt(cuboResultados,"r0","c10");				var nombre_cli = getXmlAtt(cuboResultados,"r0","c11");				frn.setX(cli,"k_clave");				frn.setX(nombre_cli,"k_nombre");									obtener_puntos();				resumen_orden();												var xmlRequest;								setXml(xmlRequest,"document","sucursal_id",sucursal_id);				setXml(xmlRequest,"document","tipo_orden",tordn );				setXml(xmlRequest,"document","orden",ordn );				setXml(xmlRequest,"document","ident",getXmlAtt(cuboResultados,"r0","c6"));								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestREFS");								cmd="select * from keplersc.carga_refacciones_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Orden()");				//frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");				ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados ");								var cubo_refacciones_cargadas;				var strTmp = getXmlAtt(cuboResultados,"r0","xml_cargadas");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_refacciones_cargadas,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_refacciones_cargadas,"C:\Basura\cubo_refacciones_cargadas");								if( nXml(cubo_refacciones_cargadas) > 0 ){									etiqueta_cargadas = "S";									}								ajusta_dimensiones_tablas();								frn.setX(cubo_refacciones_cargadas,"refacciones_cargadas");  												var cubo_refacciones_necesarias;				rstXml(strTmp);				strTmp = getXmlAtt(cuboResultados,"r0","xml_necesarias");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_refacciones_necesarias,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_refacciones_necesarias,"C:\Basura\cubo_refacciones_necesarias");				frn.setX(cubo_refacciones_necesarias,"refacciones_necesarias");  							}					//-------------------------------------------------ALTA-------------------------------------------			fun Alta(){						var xmlRequest;				var resultado, mensaje, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd;				var no_partidas, prod_ui, prod_original;				var partidasValidas = 0;				var orden;								var resultado_validaciones = Validaciones_pre_ejecucion();				if (resultado_validaciones == 0 ){					return;				}				xmlRequest = frn.dataPag();					fecha = sys.date();				hora= sys.time();				//cubo = "dat";				kdb.rst();				frn.rst("results");				frn.rst(xmlRequest );				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								xmlRequest = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento y datos adicionales				orden = frn.get("k_orden");				orden = frn.lib("libGeneral.kpl","PadLeft",orden,10,"0");				orden = mid(orden,2,8);				setXml(xmlRequest ,"k_refer",frn.get("k_tipo_orden",-1,1) & " " & orden);				setXml(xmlRequest ,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlRequest ,"movimiento","fecha",strFecha);				setXml(xmlRequest ,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));				setXml(xmlRequest ,"k_mov","no_partidas",frn.N("k_mov")-1);				setXml(xmlRequest ,"ambiente","anio_contable",anio_contable);				setXml(xmlRequest,"ambiente","uen",uen);				no_partidas=frn.N("k_mov") -1;				for(var i =0;i<no_partidas;i++){					prod_ui = getXml(xmlRequest,"k_mov","r" & i ,"k_parte");					prod_original = getXml(xmlRequest,"k_mov","r" & i ,"k_partesel");					setXml(xmlRequest,"k_mov","r" & i,"k_parte",prod_original);					setXml(xmlRequest,"k_mov","r" & i,"k_partesel",prod_ui);				}								frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest");				cmd="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"carga_refacciones.Alta");								resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");								if(resultado &= "1"){					tip_ope = 1;					frn.set("k_folio",mensaje); 					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);						nuevo_folio = mensaje;								mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;					frn.message(mensaje, "Mensaje","&Aceptar");					ctrls_off();				}else{					frn.message(mensaje, "Error","&Aceptar");				}							resumen_orden();			}								fun Validaciones_pre_ejecucion(){		   				var resultado, mensaje, cubo,fecha, hora, cmd,ok,clave_producto,cantidad,precio,precio_ini;				var num_partes = frn.N("k_mov")-1;				var suc = frn.get("k_sucn", -1, 1);						//Validar fecha				kdb.rst();				frn.rst("results");								fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				cmd= "select * from keplersc.verify_year('" & fecha & "')";				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"carga_refacciones.Validaciones_pre_ejecucion()");							resultado= getXml(cubo,"validacion","resultado");				mensaje = getXml(cubo,"validacion","mensaje");				if(mensaje &! ""){					frn.message(mensaje,"Error al generar el documento","Aceptar");				}									if(resultado &= "0"){					frn.setPos("k_fecha");					return 0;				}				//Validar Orden				if(strlen(trim(frn.get("k_orden")))==""){ 					frn.message("Es necesario especificar Orden","Error","&Aceptar");					frn.setPos("k_orden");return 0;					}									for(var i =0;i<frn.N("k_mov");i++){						precio = frn.get("k_mov",i,"k_precio");		//MSS 170724						clave_producto = frn.get("k_mov",i,"k_parte");						cantidad = frn.get("k_mov",i,"k_q");						if(clave_producto &!"" || cantidad &!""){							if(cantidad <=0 || strlen(cantidad)==0){								frn.message("Se ha generado el siguiente error: producto con cantidad 0","Error al generar el documento","Aceptar");								frn.setPos("k_mov","ren:"&i);								return 0;							}							if(clave_producto &= ""){								frn.message("Se ha generado el siguiente error: clave de producto vacia","Error al generar el documento","Aceptar");								frn.setPos("k_mov","ren:"&i);								return 0;							}							if(frn.get("k_mov",i,"k_unidad")&=""){								frn.message("Se ha generado el siguiente error: unidad de producto vacia","Error al generar el documento","Aceptar");								frn.setPos("k_mov","ren:"&i);								return 0;							}							if(frn.get("k_mov",i,"k_precio")&="" || frn.get("k_mov",i,"k_precio")&="0"){								frn.message("Se ha generado el siguiente error: precio de producto cero","Error al generar el documento","Aceptar");								frn.setPos("k_mov","ren:"&i);								return 0;							}														if(frn.get("k_mov",i,"k_control")&=""){								frn.message("Se ha generado el siguiente error: punto de producto vacio","Error al generar el documento","Aceptar");								frn.setPos("k_mov","ren:"&i);								return 0;							}														//MSS 170724 Validar precio no sea menor al inicial								precio_ini = valida_precio(i);							if (precio < precio_ini){								frn.setPos("k_mov",i,"k_precio");								frn.setX(precio_ini ,"k_mov",i,"k_precio");								precio = frn.get("k_mov",i,"k_precio");								var importe =  precio*cantidad;								frn.setX(importe ,"k_mov",i,"k_monto");								CalcTotalImporte();								frn.message("El precio no puede ser menor al precio inicial "&precio_ini,"Atencion","Aceptar");								return 0;							}						}										}												if( frn.get("k_monto") <= 0 ){					frn.message("No se puede dar de alta el documento ya que el importe es cero","Error","Aceptar");return 0;				}				return 1;			}									//-------------------------------------------------GRID PRINCIPAL----------------------------						fun Cantidad(){				var precio_ini;				var clave_producto= frn.get("k_mov", -1, "k_parte");					var cantidad= frn.get("k_mov", -1, "k_q");				var precio= frn.get("k_mov", -1, "k_precio");				var num_punto= frn.get("k_mov", -1, "k_control");				if (cantidad >= 0){					//MSS 170724 Validar precio no sea menor al inicial						precio_ini = valida_precio(-1);					if (precio < precio_ini){						frn.setPos("k_mov",-1,"k_precio");						frn.setX(precio_ini ,"k_mov",-1,"k_precio");						precio= frn.get("k_mov", -1, "k_precio");						var importe =  precio*cantidad;						frn.setX(importe ,"k_mov",-1,"k_monto");						CalcTotalImporte();						frn.message("El precio no puede ser menor al precio inicial "&precio_ini,"Atencion","Aceptar");						return;					}					if ( valida_refs_cargadas() == 1 ){						return ;					}					if ( valida_existencias() == 1 ){						return ;					}					var importe =  precio*cantidad;					frn.setX(importe ,"k_mov",-1,"k_monto");				}				CalcTotalImporte();			}						fun valida_precio(i){	//MSS 170724				var cmd ="",cuboProd,ok,mensajeError,resultado,xmlRequest,strNative,precio_especifico;				if (frn.get("k_tipoprecio",-1,"c1") &= ""){					frn.message("No se a seleccionado un tipo de precio.","Mensaje","Aceptar");					return;				}												setXml(xmlRequest,"document","sucursal_id",frn.get("k_sucn",-1,"c1"));				setXml(xmlRequest,"document","nombre_precio",frn.get("k_tipoprecio",-1,"c1"));				setXml(xmlRequest,"document","producto",frn.get("k_mov", i, "k_partesel"));								//frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestPrecio");				cmd="select * from keplersc.invr_calc_precio_metodo_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				rstXml(cuboProd);				cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.precio_especifico()");					//frn.lib("libGeneral.kpl","FileSave",cuboProd,"C:\Basura\xmlCuboPrecio");													resultado=getXml(cuboProd,"resultado");							ok=getXmlAtt(cuboProd,"ok");				if(ok &! "" && !ok){					strNative = getXmlAtt(cuboProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",strNative);					frn.message(mensajeError,"Error","Aceptar");					return;				}								precio_especifico = getXmlAtt(cuboProd,"r0" ,"precio");				return precio_especifico;			}						fun valida_existencias(){				var clave_producto,cmd,cubo,ok,producto_original; 				clave_producto= frn.get("k_mov", -1, "k_parte");				producto_original= frn.get("k_mov", -1, "k_partesel");				//Obtener clave del producto original								cmd = "select c5-c6 as disponibles from keplersc.kdinl where c1='" & frn.get("k_sucn", -1, 1) & "' and  c2='" & producto_original & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.valida_existencias()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");									var inv_disponible  =getXmlAtt(cubo,"r"&0,"disponibles");								var cantidad = 0;				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {					if ( frn.get("k_mov", i, "k_parte") &= clave_producto){						cantidad += frn.get("k_mov", i, "k_q");					}				}								if (cantidad > inv_disponible ){										var mensaje= "No hay suficiente inventario del producto: " & clave_producto & " (F7 estadisticas del producto, F8 cadena de reemplazo) ";					frn.message(mensaje,"Error","Aceptar");					frn.setX(0 ,"k_mov", -1, "k_q");					frn.setX(0 ,"k_mov", -1, "k_monto");					CalcTotalImporte();					return 1;									}							}									fun valida_punto(){					var num_punto = frn.get("k_mov",-1 ,"k_control");					var estatus_punto = frn.get("tabla_puntos",num_punto - 1 ,"estatus");					var prod = frn.get("k_mov",-1 ,"k_parte");											if (estatus_punto &= "" || num_punto == 0 ){						frn.message("El articulo " & prod & " no esta correctamente relacionado con un punto de la orden.","Error","Aceptar");						frn.setX("","k_mov",-1,"k_control");						return ;					}											if (estatus_punto &! "A"  ){						frn.message("Solamente se le puede cargar refacciones a puntos Activos, modifique estatus en control.","Error","Aceptar");						frn.setX("","k_mov",-1,"k_control");						return ;					}										if (frn.get("tabla_puntos",num_punto - 1 ,"tipo_punto") &= "L" ){						frn.message("No se le pueden cargar refacciones a puntos L (LAVADO).","Error","Aceptar");						frn.setX("","k_mov",-1,"k_control");						return ;					}															 valida_refs_cargadas();							}						fun valida_refs_cargadas(){							var clave_producto = frn.get("k_mov", -1, "k_parte");				var num_punto= frn.get("k_mov", -1, "k_control");				var cantidad = frn.get("k_mov", -1, "k_q");							if (cantidad >= 0){								if (num_punto &! ""){						if (frn.get("tabla_puntos", num_punto - 1 , "tipo_punto") &= "S" &&  num_punto != 0 ){												var ctd_necesarias, cadena_reemplazo;							//refacciones necesarias							for (var i=0,n=frn.N("refacciones_necesarias")-1;i<n;i++){								if (frn.get("refacciones_necesarias", i, "articulo_necesario") &= clave_producto && frn.get("refacciones_necesarias", i, "punto") &= num_punto ){									ctd_necesarias =  frn.get("refacciones_necesarias", i, "cantidad");										cadena_reemplazo = frn.get("refacciones_necesarias", i, "cadena_reemplazo");									}															}																						//Si no se encontro refaccion busca en cadena de reemplazo											if (cadena_reemplazo &=  ""){										var ctd_refs_necesarias = frn.N("refacciones_necesarias");								for (var i=0,n=frn.N("refacciones_necesarias")-1;i<n;i++){															var cadena = frn.get("refacciones_necesarias", i, "cadena_reemplazo");										var len_cadena = strSplit(cadena ,"|", -1);																		for (var z=0,w=len_cadena;z<w;z++){										if (strSplit(cadena ,"|", z) &=  clave_producto && frn.get("refacciones_necesarias", i, "punto") &= num_punto ){											ctd_necesarias =  frn.get("refacciones_necesarias", i, "cantidad");												cadena_reemplazo = frn.get("refacciones_necesarias", i, "cadena_reemplazo");											}									}								}							}																					if (cadena_reemplazo &=  ""){								frn.message("A un punto S solamente se le puede cargar las refacciones necesarias o sus reemplazos","Error","Aceptar");								frn.setX("","k_mov",-1,"k_control");								return 1;														}																					//refacciones cargadas 							var ctd_cadena = strSplit(cadena_reemplazo ,"|", -1); var ctd_cargadas = 0;							for (var i=0,n=ctd_cadena;i<n;i++){								var ref_cadena =  strSplit(cadena_reemplazo ,"|", i) ;								for (var x=0,q=frn.N("refacciones_cargadas")-1;x<q;x++){									var ref_cargada = frn.get("refacciones_cargadas", x, "articulo_cargado");									if (ref_cargada  &= ref_cadena && frn.get("refacciones_cargadas", x, "punto") &= num_punto ){										ctd_cargadas = ctd_cargadas +  frn.get("refacciones_cargadas", x, "cantidad");									}								}																//refeacciones seleccionadas								for (var y=0,k=frn.N("k_mov")-1;y<k;y++){									var ref_sel = frn.get("k_mov", y, "k_parte");									if ( ref_sel &= ref_cadena && frn.get("k_mov", y, "k_control") &= num_punto ){										if (ctd_cargadas &! ""){											ctd_cargadas = ctd_cargadas + frn.get("k_mov", y, "k_q");										}										}								}															}														if (ctd_cargadas > ctd_necesarias ){								frn.message("No se puede cargar mas refacciones " & clave_producto  & " o sus reemplazos de las necesarias para el punto " & num_punto & " de la orden." ,"Error","Aceptar");								frn.setX(0,"k_mov",-1,"k_q");								frn.setX(0,"k_mov",-1,"k_monto");								frn.setX("","k_mov",-1,"k_control");								CalcTotalImporte();								return 1;							}													}					}							}							}						fun CalcTotalImporte(){				monto_total = 0;				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {					monto_total  += frn.get("k_mov", i, "k_monto");				}				frn.set("subt", monto_total);				var importe_iva = monto_total * 0.16;				frn.set("k_iva", importe_iva );				monto_total += importe_iva ;				frn.set("k_monto",monto_total);			}										fun Monto(){				var monto= frn.get("k_mov", -1, "k_monto");				var cantidad= frn.get("k_mov", -1, "k_q");				var precio;					if (cantidad != 0){					precio=  monto/cantidad;				}								frn.setX(precio,"k_mov",-1,"k_precio");								CalcTotalImporte();									}						fun ValidaArticulo() 			{				var cmd ="",cuboProd,ok,mensajeError,prodExiste, valorRetorno, prod_original, xmlRequest;				var suc,nombre_precio,resultado,strNative,cuboProd,precio_especifico;								valorRetorno = frn.get("k_mov",-1,"k_parte");				cmd="select * from keplersc.prod_obtener_original('" & valorRetorno & "')";				cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.ValidaArticulo()");				ok=getXmlAtt(cuboProd,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												prod_original = getXmlAtt(cuboProd,"r0","prod_obtener_original");				if (prod_original &= "0"){					mensajeError="El producto " & valorRetorno & " es reemplazo de otro producto el cual no existe como original.";					frn.message(mensajeError,"Error","&Aceptar");					frn.setX("","k_mov",-1,"k_parte");					frn.setX("","k_mov",-1,"k_q");					frn.setX("","k_mov",-1,"k_unidad");					frn.setX("","k_mov",-1,"k_precio");					frn.setX("","k_mov",-1,"k_monto");					frn.setX("","k_mov",-1,"k_control");					frn.setX("","k_mov",-1,"k_descr");					return;				}				//Obtener detalle de producto				rstXml(cuboProd);								valorRetorno = frn.get("k_mov",-1,"k_parte");				cmd = "select c1,c2,c19,c11 from keplersc.kdini where c1 = '" & prod_original &  "'"; 				cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.ValidaArticulo()");				//frn.lib("libGeneral.kpl","FileSave",cuboProd,"C:\Basura\cuboProdKDF3PS");				ok=getXmlAtt(cuboProd,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				//				prodExiste = getXmlAtt(cuboProd,"r0","c1");				frn.setX(getXmlAtt(cuboProd,"r0","c2"),"k_mov",-1,"k_descr");				frn.setX("0","k_mov",-1,"k_q");				frn.setX(getXmlAtt(cuboProd,"r0","c19"),"k_mov",-1,"k_unidad");				frn.setX(getXmlAtt(cuboProd,"r0","c11"),"k_mov",-1,"k_precio");					frn.setX(prod_original,"k_mov",-1,"k_partesel");							//Calcular Precio				suc = frn.get("k_sucn",-1,"c1");				nombre_precio = frn.get("k_tipoprecio",-1,"c1");						if (nombre_precio &= ""){					frn.message("No se a seleccionado un tipo de precio.","Mensaje","Aceptar");					return;				}												setXml(xmlRequest,"document","sucursal_id",suc);				setXml(xmlRequest,"document","nombre_precio",nombre_precio);				setXml(xmlRequest,"document","producto",prod_original);				//frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestPrecio");				cmd="select * from keplersc.invr_calc_precio_metodo_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				rstXml(cuboProd);				cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.precio_especifico()");	//frn.lib("libGeneral.kpl","FileSave",cuboProd,"C:\Basura\xmlCuboPrecio");													resultado=getXml(cuboProd,"resultado");							ok=getXmlAtt(cuboProd,"ok");				if(ok &! "" && !ok){					strNative = getXmlAtt(cuboProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",strNative);					frn.message(mensajeError,"Error","Aceptar");					return;				}								precio_especifico = getXmlAtt(cuboProd,"r0" ,"precio");				frn.setX(precio_especifico ,"k_mov",-1,"k_precio");				//No se duplique el articulo				refacc_duplicada();			}						//Valida refacciones duplicadas			fun refacc_duplicada(){					var renglon_id, renglones, articulo;				renglones = frn.N("k_mov")-1;				renglon_id = frn.getIdJ("k_mov");				articulo = frn.get("k_mov",-1,"k_parte");				for (var i=0; i<renglones; i++) {					if (renglon_id != i){						if ( (frn.get("k_mov",i,"k_parte") &= articulo)) { 							frn.setX("","k_mov",-1,"k_parte");							frn.setX("","k_mov",-1,"k_q");							frn.setX("","k_mov",-1,"k_unidad");							frn.setX("","k_mov",-1,"k_precio");							frn.setX("","k_mov",-1,"k_monto");							frn.setX("","k_mov",-1,"k_control");							frn.setX("","k_mov",-1,"k_descr");							frn.setX("","k_mov",-1,"k_partesel");							frn.message("Verifique, esta intentado dar de alta la misma refaccion: "& articulo,"Error","Aceptar");							return;						}					}					}			}			//Consulta productos			fun ConsultaProductos(){				var cmdQuery,suc,producto;				suc = frn.get("k_sucn",-1,1);				producto=frn.get("k_mov", -1, "k_parte");				cmdQuery="";										frn.dialog("prodlistafiltrosel","Refacciones",cmdQuery,"clave_actual","k_mov",-1,"k_parte","N","N",suc,producto,"Clave");			}									fun CambiarPrecio(){				var cmd, cubo, ok, xmlRequest, strNative, mensajeError;				var cmdQuery, xmlReques,suc,nombre_precio,producto,producto_original;				suc = frn.get("k_sucn",-1,"c1");				nombre_precio = frn.get("k_tipoprecio",-1,"c1");				producto=frn.get("k_mov", -1, "k_parte");				producto_original=frn.get("k_mov", -1, "k_partesel");				cmdQuery="";//frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\xmlQueryConsulptaProductos");											frn.dialog("cat_kdtvr2_crud","MODIFICAR",producto_original,"calc_precio()");						}									//---------------------------------------TIPO DE PRECIO-------------------------------------------------------------									fun precio_especifico(param, suc, precio){								var cmd, cubo, ok, xmlRequest, strNative, mensajeError;									setXml(xmlRequest,"document","sucursal_id",suc);				setXml(xmlRequest,"document","nombre_precio",precio);								setXml(xmlRequest,"document","producto",frn.get("k_mov", param, "k_partesel")); //Precio sobre refaccion original								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestPrecio");				cmd="select * from keplersc.invr_calc_precio_metodo_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";								cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.precio_especifico()");					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");													var resultado=getXml(cubo,"resultado");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					strNative = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",strNative);					frn.message(mensajeError,"Error","Aceptar");					return;				}								var precio_especifico = getXmlAtt(cubo,"r0" ,"precio");								frn.setX(precio_especifico ,"k_mov",param,"k_precio");							}						fun calc_precio()	{							var suc = frn.get("k_sucn",-1,"c1");				var precio = frn.get("k_tipoprecio",-1,"c1");							for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {									if (frn.get("k_mov",i,"k_parte") &! "" ){										precio_especifico(i,suc,precio);											var cantidad_parte = frn.get("k_mov",i,"k_q");						var precio_parte = frn.get("k_mov",i,"k_precio");											if (cantidad_parte >= 0){											var importe =  precio_parte * cantidad_parte ;							frn.setX(importe ,"k_mov",i,"k_monto");						}					}				}								CalcTotalImporte();			}										//--------------------------------------------------CONSULTA----------------------------------									fun ObtenerFolio(){				BorraDatos();				var cmdQuery;				cmdQuery="select c6 as folio, substring(cast(c9 as VARCHAR),1,10) as fecha, c121 as tipo_orden, c122 as orden, case when c43 = 'C' then 'CANCELADO' end as status , c10 as cliente, c32 as nombre " & 					"from keplersc.kdm1 where c1='" & 					frn.get("k_sucn",-1,1) & "' and c2='" & gen_doc & "' and c3='" & nat_doc & "' and c4=" & gpo_doc 					& " and c5=" & frn.get("k_tipon",-1,4) & " order by c9 desc, c6 desc ";					frn.dialog("genlistafiltrosel","Movimiento a taller",cmdQuery,"folio","k_folio","0","","S");							}									fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								frn.lib("libGeneral.kpl","FileSave",xmlReqEst,"C:\Basura\xmlReqEst");										cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);			}									fun Buscar_folio() {				BorraDatos();				var cmd, cubo,ok, xmlRequest, cuboProd,prod_original;				var mensaje = "Folio no encontrado" ;				var suc_id =  frn.get("k_sucn",-1,1);				folio = frn.get("k_folio");				TipoMov();				cmd = "select c8,c9,c10,c11,c12,c13,c27,c28 from keplersc.kdm2 where c1='" & suc_id & 					"' and c2= '" & gen_doc & "' and c3= '" & nat_doc & "' and c4=" & gpo_doc & 					" and c5= " & tip_doc & " and c6 = '" & folio & "'";				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdXmlmov_taller");				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Buscar_folio()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");				var lenght_xml = nXml(cubo); 				if(lenght_xml != 0 ){					for (var i=0;i<lenght_xml;i++) {						var clave_prod =getXmlAtt(cubo,"r"&i,"c8");						var descripcion =getXmlAtt(cubo,"r"&i,"c10");						var cantidad=getXmlAtt(cubo,"r"&i,"c9");						var unidad =getXmlAtt(cubo,"r"&i,"c11");						var precio_unitario =getXmlAtt(cubo,"r"&i,"c12");						var importe_partida=getXmlAtt(cubo,"r"&i,"c13");						var punto=getXmlAtt(cubo,"r"&i,"c27");						prod_original=getXmlAtt(cubo,"r"&i,"c28");											if(prod_original &="0" || prod_original &=""){								cmd="select * from keplersc.prod_obtener_original('" & clave_prod & "')";							cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.ValidaArticulo()");							prod_original = getXmlAtt(cuboProd,"r0","prod_obtener_original");						}											frn.setX(clave_prod ,"k_mov",i,"k_parte");						frn.setX(descripcion ,"k_mov",i,"k_descr");						frn.setX(cantidad,"k_mov",i,"k_q");						frn.setX(unidad ,"k_mov",i,"k_unidad");						frn.setX(precio_unitario ,"k_mov",i,"k_precio");						frn.setX(importe_partida,"k_mov",i,"k_monto");						frn.setX(punto,"k_mov",i,"k_control");						frn.setX(prod_original,"k_mov",i,"k_partesel");					}					var campos =" k1.c9,k1.c10,k1.c12,k1.c14,k1.c16,k1.c24,k1.c32,k1.c161,k1.c122,'['||mar.c1||'] '||mar.c3 as tipo_orden"					cmd = " select " & campos & " from keplersc.kdm1 as k1 inner join keplersc.kdmargen as mar on k1.c121=mar.c1" 					cmd = cmd & " where k1.c1='" & suc_id & "' and k1.c2= '" & gen_doc & "' and k1.c3= '" & nat_doc & "' and k1.c4='" & gpo_doc & "' and k1.c5= '" & tip_doc & "' and k1.c6=upper('" & folio & "')";										frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdXmlmov_taller_2");					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Buscar_folio()");					ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}									frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");					lenght_xml = nXml(cubo); 					if(lenght_xml != 0 ){						frn.set("k_fecha",getXmlAtt(cubo,"r"&0,"c9"));						frn.set("k_clave",getXmlAtt(cubo,"r"&0,"c10"));						frn.set("k_tipo_orden",getXmlAtt(cubo,"r"&0,"tipo_orden"));											frn.set("k_orden",getXmlAtt(cubo,"r"&0,"c122"));						var IVA = getXmlAtt(cubo,"r"&0,"c14");						var MONTO = getXmlAtt(cubo,"r"&0,"c16");						frn.set("subt",MONTO - IVA);						frn.set("k_iva",IVA );						frn.set("k_monto",MONTO );						frn.set("k_coment",getXmlAtt(cubo,"r"&0,"c24"));						frn.set("k_nombre",getXmlAtt(cubo,"r"&0,"c32"));												obtener_puntos();						resumen_orden();									}else {											frn.message(mensaje ,"Error","Aceptar");					}									}else  {									frn.message(mensaje ,"Error","Aceptar");				}			}															fun resumen_orden(){					var xmlRequest, cmd, cubo, ok, mensajeError ;				setXml(xmlRequest,"sucursal_id", frn.get("k_sucn",-1,1));				setXml(xmlRequest,"tipo_orden", frn.get("k_tipo_orden",-1,1));				setXml(xmlRequest, "folio_orden", frn.get("k_orden"));								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestcerrarorden");				cmd="select * from keplersc.ser_calculos_montos_orden(' <document> " & getXmlStr(xmlRequest,"EOF:13_10") & " </document> ')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcerrarorden.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultadoscerrarorden");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								var cubo_datos;				var strTmp = getXmlAtt(cubo,"r0","ser_calculos_montos_orden");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_datos,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_datos,"C:\Basura\cubo_datos_cerrar_orden");								frn.set("mano_obra", getXml(cubo_datos,"importe_total_horas"));				frn.set("refacciones", getXml(cubo_datos,"importe_total_refs"));				frn.set("tots", getXml(cubo_datos,"importe_total_tots"));				frn.set("cargos_varios", getXml(cubo_datos,"importe_total_car"));				frn.set("subtotal", getXml(cubo_datos,"subtotal"));				frn.set("iva", getXml(cubo_datos,"iva_total"));				frn.set("importe", getXml(cubo_datos,"importe_total"));						}									fun obtener_puntos(){							var cmd= "select c6 as tipo_punto, c5 as clave_paquete, c50 as clave_campana , c8 as trabajo_a_realizar, c9 as operario,  c7 as estatus  ";				cmd = cmd &	"  from keplersc.kdpun where c1='" & frn.get("k_sucn",-1,1) & "' and c2='" & frn.get("k_tipo_orden", -1, 1) & "' and c3='" & frn.get("k_orden") & "' order by c4";								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmd ");								var cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Buscar_folio()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\ordenSelXml");				var ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.setAtt("tabla_puntos", "visible", "N", "clave_paquete" );				frn.setAtt("tabla_puntos", "visible", "N", "clave_campana" );					var lenght_xml = nXml(cuboResultados );				for (var i=0;i<lenght_xml;i++) {					if ( getXmlAtt(cuboResultados,"r"&i,"clave_campana") &! ""){						frn.setAtt("tabla_puntos", "visible", "Y", "clave_campana" );					}					if ( getXmlAtt(cuboResultados,"r"&i,"clave_paquete") &! ""){						frn.setAtt("tabla_puntos", "visible", "Y", "clave_paquete" );					}															if ( getXmlAtt(cuboResultados,"r"&i,"tipo_punto") &= "S"){						etiqueta_necesarias = "S";					}														}					frn.setX(cuboResultados,"tabla_puntos");							}												//----------------------------------------------------EXTRAS----------------------------------------------------------------------------											fun fecha_config(){				//validar k_fecha				//se basa en k75 SUB CFD_FOLIO								var cmd, cubo, ok;				sucursal_id=frn.get("k_sucn",-1,1);				cmd = "select C4 from keplersc.kdcfdconfig where c1='" & sucursal_id & "'";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.fecha_config()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var fec = getXmlAtt(cubo,"r0", "c4");							if (fec  &= "1"){					frn.set("k_fecha",sys.date(sys.date("year"),sys.date("month")-1,31));				}else{					frn.set("k_fecha",sys.date());				}								Fecha();				Ajustes_doc();							}			//validaciones por tipo de documento 			fun Ajustes_doc() {				//se basa en k75 SUB DEFINE_CFD_LINKS y en SUB CFD_FOLIO				var cmd,cubo,ok;				cmd = "select c80 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4='" & tip_doc & "'" ;				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Ajustes_doc()");				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				if (getXmlAtt(cubo,"r"&0,"c80") &= "S"){					frn.setAtt("k_fecha", "modify", "N" );				}else {					frn.setAtt("k_fecha", "modify", "Y" );				}		   }			fun TipoMov(){				frn.set("k_docto",frn.get("k_tipon",-1,5));				tip_doc = frn.get("k_tipon",-1,4);				BorraDatos();				LlenarTipoOrden();				if (tip_ope == 0){					Valida_Tipo_Docto();					Ajustes_doc();				}			}									fun llenar_cmb(cuboResultados, cmb){				var len_cubo = nXml(cuboResultados);				var pos_ini = frn.N(cmb);				for (var cont=0; cont<len_cubo ; cont++){					var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");					frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);				}				}												fun Fecha(){//Verifica que la fecha del documento sea correcta. 				var cubo, cmd, resValidacion, resMensaje, fecha;				var validDate=frn.lib("libKepler","ValidOpDate",frn.get("k_fecha"));								fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				if (tip_ope == 0 ){					cmd= "select * from keplersc.verify_year('" & fecha & "')";					cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"carga_refacciones.Fecha()");					resValidacion= getXml(cubo,"validacion","resultado");					resMensaje = getXml(cubo,"validacion","mensaje");					if(resMensaje &! ""){						frn.message(resMensaje, "Mensaje","&Aceptar");					}											if(resValidacion &= "0"){						frn.setPos("k_fecha");						return;					}									}							}						fun Valida_Tipo_Docto(){				var resValidacion, resMensaje, cubo, cmd, ok;							//Valida documento vigente				kdb.rst();				cmd= "select * from keplersc.verify_valid_document('" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & frn.get("k_tipon",-1,4) & ")"; //genero text, naturaleza text, grupo integer, tipo_movto integer				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"carga_refacciones.Valida_Tipo_Docto()");				resValidacion= getXml(cubo,"validacion","resultado");				resMensaje = getXml(cubo,"validacion","mensaje");				if(resMensaje &! ""){					frn.message(resMensaje, "Mensaje","&Aceptar");					frn.setPos("k_tipon");				}										}									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validacion. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validacion. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para paginas de operacion:Solo si se esta en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolvera el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}			/*V1.1 ...PANTALLA MODIFICADA PARA BUSQUEDA DE ARTICULOS, MODIFICACION Y CREACION. 14 / DIC/ 2022 20:53 - SALTIEL CRUZ.*/		}	</script></pag>