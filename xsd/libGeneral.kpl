<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Libreria">	<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,20" bclr="192,205,213"><br/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="70,50,7,12" brdr="0,5" tit="Datos generales" fnt="Arial,16"><br/>		</grp><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,sys,frP;						var bConect;//Bandera que indica si ya estï¿½ conectado o no.			/*			Ejemplo de uso de librerï¿½as en Kepler.			Funcionalidad de librerï¿½as: Permiten definir cï¿½digos genï¿½ricos que se utilizarï¿½n en varias pantallas y reutilizar ese cï¿½digo.			Limitante: Las librerï¿½a no pueden modificar objetos grï¿½ficos de la ventana padre.			Nota: A diferencia de las patallas de diï¿½logo, al mandar llamar a una librerï¿½a desde el script de la pï¿½gina padre, 					se detiene la ejcuciï¿½n de la pï¿½gina padre hasta que la librerï¿½a le regrese el control			Las funciones de las librerï¿½as reciben, como cualquier otra funciï¿½n, variables XML, por lo que pueden recibir estructuras complejas.			Asï¿½ mismo cada rutina devuelve una estructura(variable) XML.			Ejemplo:			=====			Funciï¿½n definida en librerï¿½a			====			fun rutina1(elmXml1,elmXml2){				var dato1=elmXml1;				var dato2=getXml(elmXml2,"hijo","nieto",...);				var resultado;				setXml(resultado,"r0","val1","Valor de respuesta");				setXml(resultado,"r1","val1","Otro valor de respuesta");			return resultado;			}			====			Pï¿½gina padre:			====			var input;			setXml(input,"hijo","nieto",...,"VALOR");			var output=frn.lib("libGeneral.kpl","rutina1",450,input);			var temp;			temp=getXml(output,"r0","val1");			temp=getXml(output,"r1","val1");			*/			fun Main() {				frn=new FRNT;//Solo para frn.message, no se puede modificar objetos grï¿½ficos de la ventana principal				kdb=new KDB;				sys=new SYS;								bConect=0;				//Esta rutina se ejecuta solo la primera vez que se manda llamar alguna funciï¿½n de la librerï¿½a. 			}			fun valida_rfc(str){				var letra, letra_abc, num;				var rfc = rfc;				var rfcn= strlen(rfc);				var abc="ABCDEFGHIJKLMNï¿½OPQRSTUVWXYZ";				var nums="0123456789";				var abcn= strlen(abc);				var numsn= strlen(nums);				var patron = "";				for (var i=0;i<rfcn;i++){					letra=mid(rfc,i,1);					for (var a=0;a<abcn;a++){						letra_abc = mid(abc,a,1);						if(letra &= letra_abc){							patron = patron & "X";						}					}					for (var e=0;e<numsn;e++){						num = mid(nums,e,1);						if (num &= letra){							patron = patron & "0";													}					}				}				if (patron &= "XXXX000000000" || patron &= "XXXX00000000X" || 					patron &= "XXXX0000000X0" || patron &= "XXXX0000000XX" ||					patron &= "XXXX000000X00" || patron &= "XXXX000000X0X" ||					patron &= "XXXX000000XX0" || patron &= "XXXX000000XXX"){				}else{										return 0;				}			}			fun Conexion(){//Cuando se quiera accesar a base de datos, ejecutar esta funciï¿½n, antes de cualquier cosa. 				if(bConect==0){kdb.connect();bConect=1;}			}			//====================			//||RUTINAS GENï¿½RICAS||			//====================			fun libCalculaEdad(fecNacimiento,fecReferencia){//Calcula la edad de una persona. 				//El parï¿½metro fecReferencia es opcional. Si se omite considera la fecha actual.				if(fecReferencia&="")fecReferencia=sys.date();				var edad=fnDate("year",fecReferencia)-fnDate("year",fecNacimiento);				if( (fnDate("month",fecReferencia) < fnDate("month",fecNacimiento)) || (fnDate("month",fecReferencia)==fnDate("month",fecNacimiento)&& fnDate("day",fecReferencia) < fnDate("day",fecNacimiento)) )					edad--;				return edad;			}			fun libAnioTrabajo(){ //Devuelve el aï¿½o a trabajar de la sesiï¿½n actual				var anio;				if(frn.config("temp","k_workDate")){					anio=frn.config("temp","k_workYear");				}else{					Conexion();					kdb.kde("KDE");					kdb.exec();					anio=trim(kdb.get("KDE",14));					if(anio>=70)anio+=1900;					else anio+=2000;				}				return anio;			}						//funciona para crear el archivo xml para la cita en Outlook			fun CreaRegistroOutlook(asunto,fIni,hIni,fFin,hFin,comentarios,com2,com3,archivo){				var citaXml="";				var fechai=fIni;				var fechaf=fFin;				var horai=mid(hIni,0,2) & mid(hIni,3,2) & "00"; if (mid(hIni,3,2) &="") { horai=horai & "00"; }				var horaf=mid(hFin,0,2) & mid(hFin,3,2) & "00"; if (mid(hFin,3,2) &="") { horaf=horaf & "00"; }				var fechaActual=sys.date();				var mesI=fnDate("month",fechai); if (mesI<=9) { mesI="0"&mesI; }				var mesF=fnDate("month",fechaf); if (mesF<=9) { mesF="0"&mesF; }				var diaI=fnDate("day",fechai); if (diaI<=9) { diaI="0"&diaI; }				var diaF=fnDate("day",fechaf); if (diaF<=9) { diaF="0"&diaF; }				setXml(citaXml,"r0","BEGIN:VCALENDAR"); 				setXml(citaXml,"r1","CALSCALE:GREGORIAN");				setXml(citaXml,"r2","METHOD:PUBLISH");				setXml(citaXml,"r3","BEGIN:VEVENT");				setXml(citaXml,"r4","DTSTAMP:" & fnDate("year",fechaActual) & fnDate("month",fechaActual) &  fnDate("day",fechaActual));				setXml(citaXml,"r5","LAST-MODIFIED"  & fnDate("year",fechaActual) & fnDate("month",fechaActual) &  fnDate("day",fechaActual)); //:20090304T090405\#013";				setXml(citaXml,"r6","CREATED: "  & fnDate("year",fechaActual) & fnDate("month",fechaActual) &  fnDate("day",fechaActual)); //20090304T090405\#013";				setXml(citaXml,"r7","SEQUENCE:");				setXml(citaXml,"r8","ORGANIZER:MAILTO:servidor@kepler.com.mx");				setXml(citaXml,"r9","DTSTART:"  & fnDate("year",fechai) & mesI &  diaI & "T" & horai); //20090309T183000\#013";				setXml(citaXml,"r10","DTEND:" & fnDate("year",fechaf) & mesF &  diaF & "T" & horaf); //20090310T191500\#013";				setXml(citaXml,"r11","UID:servidor@kepler.com.mx");				setXml(citaXml,"r12","SUMMARY:" & asunto);				setXml(citaXml,"r13","LOCATION:" & com2);				setXml(citaXml,"r14","URL:http://www.kepler.com.mx");				setXml(citaXml,"r15","DESCRIPTION:'" & comentarios & "'"); //cita de prospecto kepler\#013";				setXml(citaXml,"r16","CLASS:PUBLIC");				setXml(citaXml,"r17","CATEGORIES:");				setXml(citaXml,"r18","STATUS:CONFIRMED");				setXml(citaXml,"r19","PARTSTAT:NEEDS-ACTION");				setXml(citaXml,"r20","END:VEVENT");				setXml(citaXml,"r21","END:VCALENDAR");				var ruta="_"&archivo;//"c:\crmkepler.ics"; //Nombre del archivo				//Escribe el archivo en la maquina cliente				Conexion();				kdb.file("datExistente,list,'" & ruta & "'"); 				kdb.exec(); 				var cmd="datFile,write,'" & ruta & "',EOL:13_10";//Se puede agregar: ",append" para agregar el texto a un archivo ya existente				kdb.file(cmd,citaXml);				kdb.exec(); 				if(kdb.get("datFile","ok")) { return 1; }				else { return 0; }			}							fun Triggers(gen,nat,gpo,tip,reporte,pagina)			{				Conexion();				//Obtiene la informacion que se requiere				var docto=getXml(pagina,"k_docto");				var descDocto=getXml(pagina,"k_tipoN");				var nombre=getXml(pagina,"k_datCve");				var asuntoMsj="Documento: " & descDocto & "," & docto;				//Obtiene el usuario				var userasig=frn.config("user","name"); 				userasig=strFormat("ucase",userasig);				//Busca en la BD de triggers				kdb.open("h,kdtriggers,l,kdmensajes,u,\\\\kdku");				kdb.lim("h1='" & gen & "'");				kdb.lim("h2='" & nat & "'");				kdb.lim("h3='" & gpo & "'");				kdb.lim("h4='" & tip & "'");				kdb.rel("u1=h5");				kdb.table("datejec,h,1,&,h5...h20,u9"); 				kdb.exec();				var nReg=kdb.N("datejec");				var mensaje;				var destinatario;				var userDirig;				var banderaM=1,banderaC=1;				var operador;				var valor;				for (var i=0;i<nReg;i++){					destinatario=kdb.get("datejec","r"&i,"u9");					userDirig=kdb.get("datejec","r"&i,"h5");					mensaje=kdb.get("datejec","r"&i,"h9") & "\#013" & "Datos Generales: '" & nombre;					//Revisa si existe filtro por monto					if (kdb.get("datejec","r"&i,"h10")&="S"){						banderaM=0;						operador=kdb.get("datejec","r"&i,"h11");							valor=kdb.get("datejec","r"&i,"h12");						var monto=getXml(pagina,"k_monto");						if (operador &= "=") { if (monto==valor) { banderaM=1;}}						else if (operador &= ">") { if (monto > valor) { banderaM=1;}}						else if (operador &= "<") { if (monto < valor) { banderaM=1;}}						else if (operador &= ">=") { if (monto >= valor) { banderaM=1;}}						else if (operador &= "<=") { if (monto <= valor) { banderaM=1;}}						else if (operador &= "&=") { if (monto &= valor) { banderaM=1;}}						else if (operador &= "&!") { if (monto &! valor) { banderaM=1;}}					}					//Revisa si existe filtro por Clave					if (kdb.get("datejec","r"&i,"h13")&="S"){						banderaC=0;						operador=kdb.get("datejec","r"&i,"h14");							valor=kdb.get("datejec","r"&i,"h15");						var clave=getXml(pagina,"k_clave");						if (operador &= "=") { if (clave == valor) { banderaC=1;}}						else if (operador &= ">") { if (clave > valor) { banderaC=1;}}						else if (operador &= "<") { if (clave < valor) { banderaC=1;}}						else if (operador &= ">=") { if (clave >= valor) { banderaC=1;}}						else if (operador &= "<=") { if (clave <= valor) { banderaC=1;}}						else if (operador &= "&=") { if (clave &= valor) { banderaC=1;}}						else if (operador &= "&!") { if (clave &! valor) { banderaC=1;}}					}					if (banderaM==1&&banderaC==1){						//Envia el correo solo si debe hacerlo						if (kdb.get("datejec","r"&i,"h6")&="S")							//frn.dialog("utilSendMail",asuntoMsj,destinatario,mensaje,"servidor@kepler.com.mx",reporte,"26","mail.kepler.com.mx","servidor@kepler.com.mx","server123");							frn.dialog("utilSendMail",asuntoMsj,destinatario,mensaje);						//Adicionalmente manda un mensaje al usuario que corresponde						//Primero obtiene el folio que sigue						kdb.iov("GET,FMENSAJE,a1,$,datos,$,1");kdb.exec();                  var fol=kdb.get("datos","a1");						var cmd="kdmensajes,1,'" & fol & "',&";						cmd=cmd & ",1,'" & fol&"'";						cmd=cmd & ",2,'SERVIDOR'";						cmd=cmd & ",3,'" & sys.date()&"'";						cmd=cmd & ",4,'" & sys.time()&"'";						cmd=cmd & ",5,'" & userDirig&"'";						cmd=cmd & ",6,'" & sys.date()&"'";						cmd=cmd & ",7,'" & mensaje &"\#013" & asuntoMsj&"'";						kdb.update(cmd);kdb.exec();					}				}			}						//====================			//Descripcion: Ejecuta un comando sql que retorna un cubo resultado de un select en la base de datos 			// Para cualquier error se guarda texto en log local y se reporta como 0 con el correspondiente detalle			//Autor: Victor Salgado			//Fecha: 27/Julio/2021			//====================			fun EjecutarSqlSel(expSql,parent_call){				var mensaje,cubo,ok,okCnc;				var cmd;				Conexion();				cubo = "dat";				kdb.rst();				cmd= expSql;						cmd = delScpScn(cmd); //Eliminar secuencias escape								kdb.native(cmd,cubo);				okCnc=kdb.exec();				//FileSave(kdb.get(cubo),"D:\Basura\EjecutarSqlSel");												if(!okCnc){					mensaje = "Sin conexiï¿½n";					GuardarLog("ERROR", parent_call, mensaje,"");				}else{					ok=kdb.get(cubo,"ok");					if(ok &! "" && !ok){						var err=kdb.get(cubo,"err"),ierr=kdb.get(cubo,"ierr"),mssg=kdb.get(cubo,"mssg");						var native1=kdb.get(cubo,"native1"),native2=kdb.get(cubo,"native2"),native3=kdb.get(cubo,"native3");						mensaje = "'" & mssg & "'|" & err & "|" & ierr & "|" & native1 & "|" & native2 & "|" & native3 & "|";						GuardarLog("ERROR",parent_call & ". " & expSql, mensaje,getXmlStr(kdb.get(cubo),"EOF:13_10"));					}				}				return kdb.get(cubo);			}									//====================			//Descripcion: Ejecuta un comando sql que invoca una funcion en la bd donde se realiza 			// toda la validacion y se obtiene el resultado en una tabla con los campos 			// resultado, mensaje y adicionales, es utilizada para realizar alta, baja y modificaciones			// de registros			// En esta funcion se analiza el resultado en la tabla obtenida desde la base de datos, 			// crea el cubo de retorno con los datos resultado, mensaje y adicionales.			// Para cualquier error se guarda texto en log local y se reporta como 0 con el correspondiente detalle			//Autor: Victor Salgado			//Fecha: 27/Julio/2021			//====================			fun EjecutarSql(expSql){				var resultado,mensaje,cubo,resultadoXML,ok,okCnc,resMensaje,resValidacion,adicionales;				Conexion();				cubo = "dat";				kdb.rst();				frn.rst("results");				var cmd= expSql;						cmd = delScpScn(cmd); //Eliminar secuencias escape				resultado = 1;								rstXml(resultadoXML);								kdb.native(cmd,cubo);								okCnc=kdb.exec();								FileSave(kdb.get(cubo),"C:\Basura\EjecutarSql");								if(!okCnc){					mensaje = "Sin conexiï¿½n";					GuardarLog("ERROR", expSql, mensaje,"");					setXml(resultadoXML,"resultado",0);					setXml(resultadoXML,"mensaje",mensaje);					setXml(resultadoXML,,"adicionales","");					resultado = 0;				}else{					ok=kdb.get(cubo,"ok");					if(ok &! "" && !ok){						var err=kdb.get(cubo,"err"),ierr=kdb.get(cubo,"ierr"),mssg=kdb.get(cubo,"mssg");						var native1=kdb.get(cubo,"native1"),native2=kdb.get(cubo,"native2"),native3=kdb.get(cubo,"native3");						mensaje = "'" & mssg & "'|" & err & "|" & ierr & "|" & native1 & "|" & native2 & "|" & native3 & "|";						GuardarLog("ERROR", expSql, mensaje,getXmlStr(kdb.get(cubo),"EOF:13_10"));						setXml(resultadoXML,"resultado",0);						setXml(resultadoXML,"mensaje",native3);						setXml(resultadoXML,"adicionales","");					}					else					{						resValidacion= getXmlAtt(kdb.get(cubo),"r0","resultado");						resMensaje = getXmlAtt(kdb.get(cubo),"r0","mensaje");						adicionales = getXmlAtt(kdb.get(cubo),"r0","adicionales");						setXml(resultadoXML,"resultado",resValidacion);						setXml(resultadoXML,"mensaje",resMensaje);						setXml(resultadoXML,"adicionales",adicionales);											}					return resultadoXML;				}			}									//====================			//Descripcion: Ejecuta un comando sql que invoca una funcion en la bd donde se realiza 			// toda la validacion y se obtiene el resultado en una tabla con los campos 			// resultado, mensaje y adicionales.			// En esta funcio se analiza el resultado en la tabla obtenida desde la base de datos, 			// crea el cubo de retorno con los datos resultado, mensaje y adicionales.			// Para cualquier error se guarda texto en log local y se reporta como 0 con el correspondiente detalle			//Autor: Victor Salgado			//Fecha: 27/Julio/2021			//====================			fun ValidarCondicion(expSql){				var resultado,mensaje,cubo,resultadoXML,ok,okCnc,resMensaje,resValidacion,adicionales;				Conexion();				cubo = "dat";				kdb.rst();				frn.rst("results");				var cmd= expSql;						cmd = delScpScn(cmd); //Eliminar secuencias escape				resultado = 1;								rstXml(resultadoXML);								kdb.native(cmd,cubo);								okCnc=kdb.exec();								if(!okCnc){					mensaje = "Sin conexiï¿½n";					GuardarLog("ERROR", expSql, mensaje,"");					setXml(resultadoXML,"validacion","resultado",0);					setXml(resultadoXML,"validacion","mensaje",mensaje);					setXml(resultadoXML,"validacion","adicionales","");					resultado = 0;				}else{					ok=kdb.get(cubo,"ok");					if(ok &! "" && !ok){						var err=kdb.get(cubo,"err"),ierr=kdb.get(cubo,"ierr"),mssg=kdb.get(cubo,"mssg");						var native1=kdb.get(cubo,"native1"),native2=kdb.get(cubo,"native2"),native3=kdb.get(cubo,"native3");						mensaje = "'" & mssg & "'|" & err & "|" & ierr & "|" & native1 & "|" & native2 & "|" & native3 & "|";						GuardarLog("ERROR", expSql, mensaje,getXmlStr(kdb.get(cubo),"EOF:13_10"));						setXml(resultadoXML,"validacion","resultado",0);						setXml(resultadoXML,"validacion","mensaje",native3);						setXml(resultadoXML,"validacion","adicionales","");					}					else					{						resValidacion= getXmlAtt(kdb.get(cubo),"r0","resultado");						resMensaje = getXmlAtt(kdb.get(cubo),"r0","mensaje");						adicionales = getXmlAtt(kdb.get(cubo),"r0","adicionales");						setXml(resultadoXML,"validacion","resultado",resValidacion);						setXml(resultadoXML,"validacion","mensaje",resMensaje);						setXml(resultadoXML,"validacion","adicionales",adicionales);											}					return resultadoXML;				}			}												//====================			//Descripcion: Ejecuta un comando sql validando resultado de ejecucion,			//  los errores se registran en un archivo texto y se regresa el xml con 			//  los resultados de la operacion			//Autor: Victor Salgado			//Fecha: 27/Julio/2021			//====================			fun EjecutarSql_bak(expSql){				var resultado, mensaje, cubo, resultadoXML;				Conexion();				cubo = "dat";				kdb.rst();				frn.rst("results");				var cmd= expSql;						cmd = delScpScn(cmd); //Eliminar secuencias escape				resultado = 1;				kdb.native(cmd,cubo);								var okCnc=kdb.exec();								if(!okCnc){					mensaje = "Sin conexiï¿½n";					GuardarLog("ERROR", expSql, mensaje,"");					resultado = 0;				}else{					var ok=kdb.get(cubo,"ok");					if(ok &! "" && !ok){						var err=kdb.get(cubo,"err"),ierr=kdb.get(cubo,"ierr"),mssg=kdb.get(cubo,"mssg");						var native1=kdb.get(cubo,"native1"),native2=kdb.get(cubo,"native2"),native3=kdb.get(cubo,"native3");						mensaje = "'" & mssg & "'|" & err & "|" & ierr & "|" & native1 & "|" & native2 & "|" & native3 & "|";						GuardarLog("ERROR", expSql, mensaje,getXmlStr(kdb.get(cubo),"EOF:13_10"));						resultado = 0;					}					else					{						resultado = 1;					}										resultadoXML = cubo; //kdb.get(cubo);					return resultadoXML;				}			}						//====================			//Descripcion: Guarda a disco un mensaje catalogado como error,			//  la carpeta debe existir de forma previa			//Autor: Victor Salgado			//Fecha: 27/Julio/2021			//====================			fun GuardarLog(tipoMensaje, origen, mensaje, mensajeXml){				var fileName,fecha,time,cadena;				fecha = sys.date(); //2021/07/27				time = sys.time();				fileName = "D:\Basura\K80_" & mid(fecha,0,4) & mid(fecha,5,2) & mid(fecha,8,2) & ".log";				cadena = fecha & " " & time & " " & tipoMensaje & " Descripcion: " & mensaje & " Origen: " & origen;				kdb.save("_"&fileName,cadena);			}						//====================			//Descripcion: Guarda a disco un mensaje formato xml en un archivo especifico,			//  la carpeta debe existir de forma previa			//Autor: Victor Salgado			//Fecha: 27/Julio/2021			//====================				fun FileSave(xmlVar,FileName){//Lectura/escritura				var documentXml = getXmlStr(xmlVar,"EOF:13_10");				kdb.save("_"&FileName&".txt",documentXml);			}						//====================			//Descripcion: Cambia el formato de una fecha aaaa/mm/dd a otro formato			//Parametros: fecha. Fecha a convertir con el formato aaaa/mm/dd			//	modo. Formato a cambiar, 1 --> dd/mm/aaaa			//Autor: Victor Salgado			//Fecha: 06/Septiembre/2021			//====================				fun Fecha_conversion(fecha,modo){				var fecha_conv = fecha;				if (modo=="1"){					//fecha_conv = fnDate("day",fecha) & "/" & fnDate("month",fecha) &  "/" & fnDate("year",fecha); 				}				return fecha_conv;			}									//====================			//Descripcion: Obtiene la descripcion del error de BD sin referencias			//Parametros: cadenaError. string de error, normalmente es el parametro native3 del cubo resultado			//Autor: Victor Salgado			//Fecha: 27/Septiembre/2021			//====================				fun ErrorBD(cadenaError){				var strMensaje, strTmp, lenCadena;				var xmlValores;				xmlValores = strSplit(cadenaError,":");				strTmp = getXml(xmlValores,"r1");				lenCadena = strlen(strTmp);				lenCadena = lenCadena - 8;				strMensaje = mid(strTmp,1,lenCadena);				return strMensaje;			}							//====================			//Descripcion: Genera un xml(cubo) desde los atributos de un tag, esto es util cuando se quiere llenar una			//		pantlla directamente desde un cubo, donde coincide el nombre dl elemento grafico con el nombre			//		del tag en el xml considerando que K80 es key sensitive			//Parametros: xml. Contiene una cadena xml con el siguiente formato ejemplo:			//	<r0 c1="02" k_diasvenbusmen="0" k_delaytraslado="0" k_minanticipo="100"/>			//	Observese que solo trae un renglon, en este caso identificado como r0, pero pueder ser rowu otro nombre del tag			//Salida: xml con el siguiente formato:			//<row xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">			//	<c1>02</c1>			//	<k_diasvenbusmen>0</k_diasvenbusmen>			//	<k_delaytraslado>0</k_delaytraslado>			//	<k_minanticipo>100</k_minanticipo>			//</row>						//Autor: Victor Salgado			//Fecha: 05/Mayo/2022			//====================				fun CreaXmlDesdeAtt(parXml, tagId){				var strCampos = getXmlAtt(parXml,"k_ColName");				var totCampos = strSplit(strCampos,",",-1);				var curCampo, curValor, xmlDetalle, xmlRow;				for(var i=0; i<totCampos ; i++){					curCampo= strSplit(strCampos,",",i);					curValor = getXmlAtt(parXml,tagId,curCampo);					setXml(xmlDetalle,"row",curCampo,curValor);				}				rstXml(xmlRow);				xmlRow= getXmlX(xmlDetalle,3,0); //Se asume que solo se trae un evento				return xmlRow;			}			//====================			//Descripcion: Genera un xml(cubo) desde los atributos de un tag, esto es util cuando se quiere llenar una			//		pantlla directamente desde un cubo, donde coincide el nombre dl elemento grafico con el nombre			//		del tag en el xml considerando que K80 es key sensitive			//Parametros: xml. Contiene una cadena xml con el siguiente formato ejemplo:			//	<r0 c1="02" k_diasvenbusmen="0" k_delaytraslado="0" k_minanticipo="100"/>			//  <r1 c1="02" k_diasvenbusmen="0" k_delaytraslado="0" k_minanticipo="100"/>			//  <r2 c1="02" k_diasvenbusmen="0" k_delaytraslado="0" k_minanticipo="100"/>			//	Observese que solo trae un renglon, en este caso identificado como r0, pero pueder ser rowu otro nombre del tag			//Salida: xml con el siguiente formato:			//<r0>			//	<c1>02</c1>			//	<k_diasvenbusmen>0</k_diasvenbusmen>			//	<k_delaytraslado>0</k_delaytraslado>			//	<k_minanticipo>100</k_minanticipo>			//</r0>			//<r1>			//	<c1>02</c1>			//	<k_diasvenbusmen>0</k_diasvenbusmen>			//	<k_delaytraslado>0</k_delaytraslado>			//	<k_minanticipo>100</k_minanticipo>			//</r1>			//<r2>			//	<c1>02</c1>			//	<k_diasvenbusmen>0</k_diasvenbusmen>			//	<k_delaytraslado>0</k_delaytraslado>			//	<k_minanticipo>100</k_minanticipo>			//</r2>				//Parametros: sourceId = xml a convertir,			//    tagId = identficador del tag			//    objRelId = Contenedor (nombre grid a donde se espera			//    pegar la info del cubo			//Autor: Victor Salgado			//Fecha: 15/Junio/2022			//====================				fun CreaXmlDesdeAttRows(sourceXml, tagId, objRelId){				var xmlRow, targetXml, rowId, nRows;				rstXml(targetXml);				nRows = nXml(sourceXml);				for(var contRow=0; contRow < nRows; contRow++){					rstXml(xmlRow);					rowId=tagId&contRow;					xmlRow = frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",sourceXml,rowId);					setXml(targetXml,objRelId,rowId,xmlRow);				}				return targetXml;			}			/*===========================				Autor: Victor Salgado				Fecha: 15/Junio/2022			=========================== */			fun CreaXmlDesdeTagRow(sourceXml, tagId, objRelId){				var xmlRow, targetXml, rowId, nRows;				rstXml(targetXml);				nRows = nXml(sourceXml);				for(var contRow=0; contRow < nRows; contRow++){					rstXml(xmlRow);					rowId=tagId&contRow;					xmlRow = frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",sourceXml,rowId);					setXml(targetXml,objRelId,rowId,xmlRow);				}				return targetXml;			}			/*===========================				Descripcion: Para un xml donde los renglones estan como					<row> </row>					<row> </row>					se reformatea y se regresa como					<r0> </r0>					<r1> </r1>				Autor: Victor Salgado				Fecha: 09/Sep/2022			=========================== */			fun FormateaXmlNoRowId(sourceXml, tagId, objRelId){				var xmlRow, targetXml, rowId, nRows;				rstXml(targetXml);				nRows = nXml(sourceXml);				for(var contRow=0; contRow < nRows; contRow++){					rstXml(xmlRow);					rowId=tagId&contRow;					xmlRow = getXmlX(sourceXml,3,contRow);					setXml(targetXml,objRelId,rowId,xmlRow);				}				return targetXml;			}						/*====================				Descripcion: Rellena con ceros a la izquierda				Parametros> Texto, numero de caracteres a rellenar, caracter de relleno				Autor: Saltiel Ramirez				Fecha: 07/Jun/2022			====================			*/			fun PadLeft(pText,pRelleno,pCaracterRelleno){				var pos_ini,Resultado,nReg;				Resultado;				pos_ini = pText;				nReg= strlen(pText);				for (var cont = nReg; cont < pRelleno; cont++){					Resultado = pCaracterRelleno & Resultado;				}				Resultado = Resultado & pText;                				return Resultado;			}			/*====================				Descripcion: Reemplaza un caracter por otro en una cadena				Parametros> Texto, caracter original, nuevo caracter				Autor: Victor Salgado				Fecha: 07/Jun/2022			====================			*/			fun StrReplace(strCadena,strSource,strTarget){				var cont, strResultado, strCur;				for(cont=0; cont<strlen(strCadena); cont++){					strCur=mid(strCadena,cont,1);					if(strCur&=strSource){						strCur=strTarget;					}					strResultado = strResultado & strCur;				}				return strResultado;			}						fun funcionGetAttXMLUUID(strCtrlSet,strRenglon,strColumna)			{				var frn_local, 					 kdb_local,					 frP;								frn_local =new FRNT;				//frP = new FRNTP;								kdb_local = new KDB;				kdb_local.connect();								var cubo;				var path = frn_local.openFile("","Archivos XML,*.xml",sys.path(),"Ubica El archivo del SAT.");//Ruta de carpeta				kdb_local.load("dat","_"&path);				kdb_local.exec();				var temcubo =kdb_local.get("dat");				setXmlStr(temcubo,kdb_local.get("dat"));				var UUID = getXmlAtt(temcubo,"cfdi:Comprobante","cfdi:Complemento","tfd:TimbreFiscalDigital","UUID");				var Rfc = getXmlAtt(temcubo,"cfdi:Comprobante","cfdi:Emisor","Rfc");				var UuidFecha = getXmlAtt(temcubo,"cfdi:Comprobante","cfdi:Complemento","tfd:TimbreFiscalDigital","FechaTimbrado");				var Total = getXmlAtt(temcubo,"cfdi:Comprobante","Total");					var Rfc_receptor = getXmlAtt(temcubo,"cfdi:Comprobante","cfdi:Receptor","Rfc");				var valorSel = (UUID &"|"& Rfc &"|"& UuidFecha &"|"& Total &"|"& Rfc_receptor);				return valorSel;			}			/*====================				Descripcion: Obtiene las ubicaciones de una refaccion para una sucursal				Parametros> Texto, caracter original, nuevo caracter				Autor: Victor Salgado				Fecha: 07/Jun/2022			====================			*/			fun ObtenerLocalizacion(sucursal,refaccion){				var xmlRequest,cmd,cuboResultados,ok,cmd,cubo,mensajeError,cuboProd ;				var loc1,loc2,loc3,ref_original;				var xmlLoc;								//Obtener clave original				cmd="select * from keplersc.prod_obtener_original('" & refaccion & "')";				rstXml(cuboProd);				cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"LibGeneral.ObtenerLocalizacion()");				ok=getXmlAtt(cuboProd,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												ref_original= getXmlAtt(cuboProd,"r0","prod_obtener_original");																cmd = "select * from keplersc.kdlocref where c1='" & sucursal & "' and c2='" & ref_original & "'";				rstXml(cubo);								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_prod_crud.ObtenerLocalicacion()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboLocalizacion");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){				   mensajeError = getXmlAtt(cubo,"native3");				   mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								return cubo;			}			/*====================				Descripcion: Valida si tiene permiso del usuario a una opción				Parametros> Clave sucursal, nombre opcion, usuario				Autor: Miriam Santana				Fecha: 01/Nov/2024			====================			*/			fun ValidaPermisosUsr(suc,opcion,usuario){				var cmd, cuboXml, ok,mensajeError,asterisco;				asterisco = "*";				if (suc &=""){					suc = frn.lib("libKepler","UserInfo(1)");								}				if (usuario &=""){					usuario = frn.lib("libKepler","UserInfo(3)");				}				cmd = "select count(*) as permiso from keplersc.param_opc_usr_sec";				if (suc &! asterisco && suc &! ""){					cmd = cmd & " where sucursal ='" & suc & "' and opcion='" & opcion & "' and lower(usuario) = lower('" & usuario & "')"; 				}else {					cmd = cmd & " where opcion='" & opcion & "' and lower(usuario) = lower('" & usuario & "') limit 1";					}				rstXml(cuboXml);				cuboXml= EjecutarSqlSel(cmd,"ValidaPermisosUsr()");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;				}					return(getXmlAtt(cuboXml,"r0","permiso"));								}					} //Fin Script	</script></pag>