<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Factura Auto">	<grp id="grpMain" brdr="0,0" clr="0,58,112" fnt="Arial,18b" id="k_titulo_inicial" dim="1,-1,10,8" bclr="192,205,213" clrBrdr="0,97,181" OnF1="Dialog(1,altapedido_crud)" tit="Factura Auto" unfont="0">		<br/>	<tab/><inp id="k_titulo_inicial" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>	<br/><tab/><hLine clr="0,0,0"/>	<br/><br/>	<tab/>		<grp id="grpDatosGenerales" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="45,10,7,12" tit="Datos generales"  fnt="Arial,16" available="Y" modify="Y">		<sp/><txt clr="0,58,112" hk="S">Sucursal</txt><tab/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" 				brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y" OnChange="CambiaSucursal()"/>			<br/>						<sp/><txt clr="0,58,112">Grupo docto</txt>			<cmb id="grpDoc" clr="64,64,64" clrBrdr="255,255,255" dim="30,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N"  available="N" modify="Y"/>			<inp id="k_grupodocto_desc" clr="64,64,64"  dim="5,1" brdr="0,1" fnt="Arial,16" type="string" available="N" modify="N" visible="N" just="R"/><sp/>			<cmb id="k_grupodocto" clr="64,64,64" clrBrdr="255,255,255"  dim="8,1" bclr="255,255,255" 				brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="N" OnChange="MostrarGrupo()" modify="N" visible="N"/>						<br/>			<sp/><txt clr="0,58,112">Tipo docto</txt><tab/>			<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255" dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="Valida_Tipo_Docto()" available="Y"/><br/>								<sp/><inp id="datcfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="3,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="1" modify="Y" available="Y" visible="N"/>		</grp><sp/>		<grp id="grpDocumentos" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="30,10,7,12" tit="Documento"  fnt="Arial,16" available="Y" modify="Y">			<sp/><inp id="operacion" clr="64,64,64"  dim="40,1" brdr="0,1" fnt=",18b" available="N" type="string" just="C"/><br/><sp/>			<txt id="foliotxt"  visible="N" hk="F" clr="0,58,112">Folio </txt>			<edt id="k_folio" clr="64,64,64" clrBrdr="255,255,255"  dim="18,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" visible="N" hk="F" type="capital" nc="10"				OnF9="ObtenerFolio()" OnButton="ObtenerFolio()" 				OnChange = "Formar_folio()"				modify="N" available="Y"/><sp/>				<txt id="capturaFolio" visible="N" clr="254,1,1" fnt=",b">Captura Folio</txt>							<img id="buscar_folio" dim="20,20"  brdr="0,1" bPx="Y" img="_20_Find.png" OnEnter="ConsultarFolio()" clrBrdr="0,0,0" visible="N" modify="Y" available="Y"/>				<br/><sp/>							<inp id="k_docto" clr="64,64,64"  dim="40,1" brdr="0,1" fnt="Arial,16b" available="N" link="k_tipon,5" type="string" just="C"/><br/>			<sp/><txt clr="0,58,112">Fecha</txt><tab/>			<edt id="k_fecha" dim="15,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" OnButton="Dialog(0,_ks_fecha,k_fecha)" OnF9="Dialog(0,_ks_fecha,k_fecha)" modify="N" available="N"/><br/><tab/>			<inp id="statusDoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/><br/><tab n="2"/>					</grp><br/><br/><br/>		<tab/>		<grp id="grpDetalle" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5" dim="76,29,7,12" tit="Detalle"  fnt="Arial,16" available="Y" modify="Y">			<grp id="grpInventario" dim="109,28,7,12" hSpace="4" available="Y" modify="Y"><txt id="txt_factura" visible="N">     Factura  </txt><sp/>				<inp id="k_factura" clr="64,64,64" clrBrdr="255,255,255" dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="10" available = "N" modify="N" visible="N" OnChange="Formar_folio_factura()" OnF9="BusquedaFactura()" tooltip="Factura [F9]"/>								<sp n="1"/>							<img id="buscar_factura" dim="20,20"  brdr="0,1" bPx="Y" img="_20_Find.png" OnEnter="MostrarFactura()" clrBrdr="0,0,0" visible="N" modify="Y" available="Y"/><tab n="2"/>				<txt id="txt_motivo_cancel" visible="N">Razon de cancelaci&#243;n : </txt>				<cmb id="k_motivo_cancel" dim="50,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="N" visible="N" available="Y"/>								<br/><txt>     Inventario </txt>				<inp id="k_inventario" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="10" available = "Y" modify="Y"				OnChange="MostrarInventario()" OnF9="BusquedaInventario()" tooltip="Inventario [F9]"/>				<tab n="1"/><txt>Producto:</txt>				<inp id="k_producto" clr="64,64,64" dim="25,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>					<tab/><inp id="k_importado" clr="64,64,64" dim="20,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="N" available="Y"/>				<br/>				<tab/><txt>No-Serie:</txt><tab n="1"/>				<inp id="k_serie_inv" clr="64,64,64" dim="50,1" visible="Y" fnt="Arial,16" type="string" modify="N" available="N"/>				<br/><txt>     Descripci&#243;n: </txt>				<inp id="k_desc_inv" clr="64,64,64"  dim="65,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/><txt>   Cliente</txt>				<inp id="k_cliente" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="10" available = "Y" tooltip="Modificar F11" modify="N" 					OnChange="MostrarCliente()"					OnF11 = "Dialog(3,cat_cli_crud,Modificar,x,s,k_cliente)"/>				<br/>				<sp/>				<grp id="grpDatosClientes" bclr="255,255,255" fntClrBrdr="240,220,200" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="106,5,7,12" fnt="Arial,16" available="Y" modify="Y">								<inp id="k_c10" clr="64,64,64" clrBrdr="255,255,255" dim="15,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N" type="string"/>				<tab/><inp id="k_nombre_impresion" clr="64,64,64" clrBrdr="255,255,255"  dim="80,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N" type="string"/>				<br/>				<inp id="k_c30" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" bclr="255,255,255"  fnt="Arial,16" nr="3,60" modify="Y" available="N" type="string"/>								<inp id="k_c4" clr="64,64,64" clrBrdr="255,255,255"  dim="36,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N"/>				<br/>				<inp id="k_c5" clr="64,64,64" clrBrdr="255,255,255"  dim="60,1" bclr="255,255,255"  fnt="Arial,16" nr="3,60" modify="Y" available="N"/>								<inp id="k_c6" clr="64,64,64" clrBrdr="255,255,255"  dim="46,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N"/>				<br/>				</grp><sp/>				<br/>				<tab n="2"/><txt>Cr&#233;dito o Contado :</txt><tab n="2"/>				<cmb id="k_creditocontado" clr="64,64,64" clrBrdr="255,255,255" dim="15,5" bclr="255,255,255" brdr="4,0" fnt="Arial,16" Null="N" available="Y" modify="Y"/>				<tab n="10"/><txt>  Importe: </txt>				<inp id="k_importeprevio" clr="64,64,64" dim="18,1" visible="Y" fnt="Arial,16" type="number" nc="16" modify="N" available="N" nd="2" just="R"/>				<br/>				<tab n="2"/><txt id="txt_gmac_ally" visible="N">Contrato GMAC-ALLY :</txt><tab/>				<inp id="k_gmac_ally" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="15" modify="N" visible="N" available="N"/><tab n="2"/><txt>Precio del Veh&#237;culo :</txt>								<inp id="k_preciovehiculo" clr="64,64,64" dim="18,1" visible="Y" fnt="Arial,16" type="number" nc="16" modify="N" available="N" nd="2" just="R"/>				<br/>				<tab n="24"/><sp n="2"/><txt> ISAN :</txt><tab n="1"/>				<inp id="k_isan" clr="64,64,64" dim="18,1" visible="Y" fnt="Arial,16" type="number" nc="16" modify="N" available="N" nd="2" just="R"/>				<br/>				<tab n="25"/><sp/><txt>IVA :</txt>				<inp id="k_iva" clr="64,64,64" dim="18,1" visible="Y" fnt="Arial,16" type="number" nc="16" modify="N" available="N" nd="6" just="R"/>				<br/>				<tab n="24"/><txt> Importe :</txt><tab n="1"/>				<inp id="k_monto" clr="64,64,64" dim="18,1" visible="Y" fnt="Arial,16" type="number" nc="16" modify="N" available="N" nd="2" just="R"/>				<br/>				<br/>				<tab n="1"/><txt>M&#233;todo de Pago :</txt>				<inp id="k_m_pago" clr="64,64,64" dim="10,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>								<tab n="1"/><txt>Forma de Pago :</txt>				<inp id="k_forma_pago" clr="64,64,64" dim="25,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>				<tab/><txt>Uso del CFDI:</txt>				<inp id="k_cfdi" clr="64,64,64" dim="23,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>				<br/>				<tab n="1"/><txt>Cuenta:</txt>				<inp id="k_cuenta" clr="64,64,64" dim="30,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="Y" available="Y" bclr="246,246,246"/>								<tab n="1"/><txt>Correo Electr&#243;nico:</txt>				<inp id="k_correo" clr="64,64,64" dim="49,1" visible="Y" fnt="Arial,16" type="string" nc="100" modify="N" available="N"/>			</grp>		</grp>		<br/><tab/>					<grp dim="50,10,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" fnt="Arial,16">			<tab n="1"/><txt clr="0,58,112">Comentarios:</txt><br/><tab n="2"/>			<inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="60,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="capital"/>			<br/><tab n="2"/><inp id="k_coment2" clr="64,64,64" clrBrdr="255,255,255"  dim="60,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="capital"/>			<br/><tab n="2"/><inp id="k_coment3" clr="64,64,64" clrBrdr="255,255,255"  dim="60,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="capital"/>		</grp>		<grp dim="26,10,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" fnt="Arial,16">			<br/>			<bot id="bot_sofia" dim="15,0" brdr="5" text="Pre-SOFIA" OnEnter="CapturaSofia()" clr="0,0,0" visible="N" available="Y"/>			<tab/>			<bot id="bot_selec_anticipos" dim="15,0" brdr="5" text="Anticipos" OnEnter="SeleccionAnticipos()" clr="0,0,0" visible="N" available="Y"/>			<br/><br/><tab n="3"/>			<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Consulta()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="N" clrBrdr="0,0,0" visible="N" modify="Y"/>			<tab/>			<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatosPantalla()" tooltip="Refrescar datos" available="Y" clrBrdr="0,0,0" visible="Y"/><tab/>			<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><tab/>				</grp>				</grp>	<script>		InstallDriver("KDB75");		class Main {			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc,usuario,sucursal_id,suc_usuario,rol_usuario,asterisco, v_inventario,valorRetorno,v_IvaAuto,v_correo,v_uso_cfdi;			var frn,kdb,rep,frP,sys;			var tip_ope;//Tipo de operacion. "0" indica Alta; "1" indica consulta; "2" indica cancelacion; "3" indica baja; "4" Indica modificacion			var uen,v_nat36,v_gru37,v_tipo38,v_KDM1_iva, v_KDM1_IEPS,v_KDM1_precio, v_KDM1_precio_vehiculo;			var anio_contable;			var v_A98,resVal,folioManual,nfolioManual,marca,nvous;			var tot_reg,interfaz_gm;			/* PARAMETROS de la pagina indicados desde Tree, o desde frn.Dialog			param(0) = Genero			param(1) = Naturaleza			param(2) = Grupo			param(3) = Tipo			param(4) = Fija Documento. Si "1", no permite seleccionar otro tipo de documento. Si "0" los combos de grupo  y tipo de documento se habilitan.			param(5) = Tipo de operacion. "0" indica Alta; "1" indica consulta; "2" indica cancelacion; "3" indica baja; "4" Indica modificacion			*/						fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("c,kdm1");				ConfiguraControlesOff();				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				inicializa();				frn.setPos("k_folio");			}						fun BorraDatosPantalla(){				frn.rst("k_factura");				frn.rst("k_motivo_cancel");				frn.rst("k_gmac_ally");				frn.rst("k_inventario");				frn.rst("k_producto");				frn.rst("k_serie_inv");				frn.rst("k_desc_inv");					frn.set("datcfdi","N");		//Pantalla validacion CFDI				frn.rst("k_cliente");					frn.rst("grpDatosClientes");					frn.rst("k_c10");					frn.rst("k_nombre_impresion");					frn.rst("k_c30");					frn.rst("k_c4");				frn.rst("k_c5");				frn.rst("k_c6");				frn.rst("k_importeprevio");				frn.rst("k_preciovehiculo");					frn.rst("k_isan");					frn.rst("k_iva");					frn.rst("k_monto");					frn.rst("k_m_pago");					frn.rst("k_forma_pago");					frn.rst("k_cfdi");				frn.rst("k_cuenta");				frn.rst("k_correo");				frn.rst("k_coment");							}						fun Formar_folio_factura(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_factura"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",v_nat36 );				setXml(xmlReqEst,"document","k_tipon","r3",v_gru37 );				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);frn.lib("libGeneral.kpl","FileSave",xmlReqEst,"C:\Basura\xmlReqFolio");					cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_factura", fol);			}						fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;									setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));					setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));					setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));					setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));					setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));					setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));					setXml(xmlReqEst,"document","uen",uen);										cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";					cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");					var resultado =getXmlAtt(cubofol,"r0", "resultado");					if(resultado &= "0"){						mensajeError = getXmlAtt(cubofol,"r0", "mensaje");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					var fol = getXmlAtt(cubofol,"r0", "mensaje");					frn.set("k_folio", fol);					if(tip_ope == 0){ //Alta			//MSS 15102024: Permitir capturar un folio manual						if (folioManual &= "S"){										FolioManual();							ArmarRefDocto();						}							}				}					fun ConsultarFolio()			{					var xmlRequest,				 cmd,				 ok, 				 cuboResultados,				 mensajeError;				 				cmd = "select * from keplersc.kdm1 where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc &"' and c3 = '" & nat_doc &  "' and c4 = '" & gpo_doc &  "' and c5 = '" & tip_doc &  "' and c6 = '" & frn.get("k_folio") & "' order by c9 desc";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.MostrarCliente()");frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboConsultarFactura");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				frn.set("k_inventario",getXmlAtt(cuboResultados,"r0","c100"));				frn.set("k_cliente",getXmlAtt(cuboResultados,"r0","c10"));				frn.set("k_nombre_impresion",getXmlAtt(cuboResultados,"r0","c32"));				frn.set("k_c30",getXmlAtt(cuboResultados,"r0","c33"));				frn.set("k_c10",getXmlAtt(cuboResultados,"r0","c22"));				frn.set("k_c5",getXmlAtt(cuboResultados,"r0","c163"));				frn.set("k_creditocontado",getXmlAtt(cuboResultados,"r0","c44"));				frn.set("k_importeprevio",getXmlAtt(cuboResultados,"r0","c16"));								v_KDM1_iva = getXmlAtt(cuboResultados,"r0","c14");				v_KDM1_IEPS = getXmlAtt(cuboResultados,"r0","c15");				v_KDM1_precio = getXmlAtt(cuboResultados,"r0","c16");				v_KDM1_precio_vehiculo = v_KDM1_precio - v_KDM1_iva - v_KDM1_IEPS;								frn.set("k_preciovehiculo",v_KDM1_precio_vehiculo);				frn.set("k_isan",v_KDM1_IEPS);				frn.set("k_iva",v_KDM1_iva);				frn.set("k_monto",v_KDM1_precio);								frn.set("k_factura",getXmlAtt(cuboResultados,"r0","c39"));				frn.set("k_fecha",getXmlAtt(cuboResultados,"r0","c9"));								frn.set("k_m_pago",getXmlAtt(cuboResultados,"r0","c162"));				frn.set("k_forma_pago",getXmlAtt(cuboResultados,"r0","c160"));				frn.set("k_cfdi",getXmlAtt(cuboResultados,"r0","c164"));				frn.set("k_correo",getXmlAtt(cuboResultados,"r0","c165"));				//seccion de KDINF								cmd = "select c.c3,c.c4,c.c5,(select h.c52 from keplersc.KDIV h where h.c1 = c.c3) as c52, c.c17 as marca,c.c21 as nvous from keplersc.kdinf c where c.c1 = '" & sucursal_id &  "' and c.c2 = '" & frn.get("k_inventario") &  "' ";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.MostrarCliente()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				frn.set("k_producto",getXmlAtt(cuboResultados,"r0","c3"));				frn.set("k_desc_inv",getXmlAtt(cuboResultados,"r0","c4"));				frn.set("k_serie_inv",getXmlAtt(cuboResultados,"r0","c5"));				frn.set("k_importado",getXmlAtt(cuboResultados,"r0","c52"));				marca = getXmlAtt(cuboResultados,"r0","marca");			//MSS 15052025: Llamar pantallas para completar informacion para interface SOFIA				nvous = getXmlAtt(cuboResultados,"r0","nvous");			//MSS 15052025: Llamar pantallas para completar informacion para interface SOFIA				//seccion KDVENTAS																if (HabilitaSofia() &="S"){									//MSS 30052025: Mostrar los datos Contrato GM-Ally y motivo de cancelacion					cmd = "select vt.contrato_gmac_ally, rc.codigo_cancelacion ||'-'||rc.razon_cancelacion as descripcion_cancel from keplersc.kdventas vt					 left join keplersc.ifz_sofia_razon_cancelacion rc on rc.codigo_cancelacion=vt.codigo_cancelacion					 where vt.c1 = '" & sucursal_id &  "' and vt.c4 = '" & gen_doc &"' and vt.c5 = '" & nat_doc &  "' and vt.c6 = '" & gpo_doc &  "' and vt.c7 = '" & tip_doc &  "' and vt.c8 = '" & frn.get("k_folio") & "'";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.MostrarCliente()");					ok = getXmlAtt(cuboResultados ,"ok");					if(ok &! "" && !ok)					{						mensajeError = getXmlAtt(cuboResultados ,"native3");						frn.message(mensajeError,"Criterios no encontrados","Aceptar");						return;					}					if(nXml(cuboResultados) > 0){						frn.set("k_gmac_ally",getXmlAtt(cuboResultados,"r0","contrato_gmac_ally"));						frn.set("k_motivo_cancel",getXmlAtt(cuboResultados,"r0","descripcion_cancel"));					}				}				ArmarRefDocto();				ConfiguraCamposOpcion();										//MSS 15052025: Llamar pantallas para completar informacion para interface SOFIA			}			fun MostrarFactura()			{				var xmlRequest,cmd,ok, cuboResultados,mensajeError,v_tipo_n;					v_tipo_n = frn.get("k_tipon",-1,4);							 				//MSS 25042025 Si es factura sustituida no permitir realizar la anulacion en esta opcion				cmd = "select c6 as fact_nvaxsust from keplersc.kdm1 where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc&  "' and c36 = '" & v_nat36 &  "' and c37 = '" & v_gru37 &  "' and c38 = '" & v_tipo_n & "' and c39='" & frn.get("k_factura") & "' and tipo_relacion ='04'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_AltaVehiculoFactura_crud.MostrarFactura()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultadosfact_nvaxsust");									ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								if (getXmlAtt(cuboResultados,"r0","fact_nvaxsust") &! "") {					frn.message("No es posible utilizar esta opcion|Esta factura tiene una anulacion por sustitucion pendiente","Atencion","Aceptar");					return;				}				cmd = "select * from keplersc.kdm1 where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc&  "' and c3 = '" & v_nat36 &  "' and c4 = '" & v_gru37 &  "' and c5 = '" & v_tipo_n &  "' and c6 = '" & frn.get("k_factura") & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.MostrarCliente()");frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboMostrarFactura");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				frn.set("k_inventario",getXmlAtt(cuboResultados,"r0","c100"));				frn.set("k_cliente",getXmlAtt(cuboResultados,"r0","c10"));				frn.set("k_nombre_impresion",getXmlAtt(cuboResultados,"r0","c32"));				frn.set("k_c30",getXmlAtt(cuboResultados,"r0","c33"));				frn.set("k_c10",getXmlAtt(cuboResultados,"r0","c22"));				frn.set("k_c5",getXmlAtt(cuboResultados,"r0","c163"));				frn.set("k_creditocontado",getXmlAtt(cuboResultados,"r0","c44"));				frn.set("k_importeprevio",getXmlAtt(cuboResultados,"r0","c16"));								v_KDM1_iva = getXmlAtt(cuboResultados,"r0","c14");				v_KDM1_IEPS = getXmlAtt(cuboResultados,"r0","c15");				v_KDM1_precio = getXmlAtt(cuboResultados,"r0","c16");				v_KDM1_precio_vehiculo = v_KDM1_precio - v_KDM1_iva - v_KDM1_IEPS;								frn.set("k_preciovehiculo",v_KDM1_precio_vehiculo);				frn.set("k_monto",v_KDM1_precio);				frn.set("k_isan",v_KDM1_IEPS);				frn.set("k_iva",v_KDM1_iva);									frn.set("k_m_pago",getXmlAtt(cuboResultados,"r0","c162"));				frn.set("k_forma_pago",getXmlAtt(cuboResultados,"r0","c160"));				frn.set("k_cfdi",getXmlAtt(cuboResultados,"r0","c164"));				frn.set("k_correo",getXmlAtt(cuboResultados,"r0","c165"));				//seccion de KDINF								cmd = "select c.c3,c.c4,c.c5,(select h.c52 from keplersc.KDIV h where h.c1 = c.c3) as c52, c.c17 as marca,c.c21 as nvous from keplersc.kdinf c where c.c1 = '" & sucursal_id &  "' and c.c2 = '" & frn.get("k_inventario") &  "' ";								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.MostrarCliente()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				frn.set("k_producto",getXmlAtt(cuboResultados,"r0","c3"));				frn.set("k_desc_inv",getXmlAtt(cuboResultados,"r0","c4"));				frn.set("k_serie_inv",getXmlAtt(cuboResultados,"r0","c5"));								frn.set("k_importado",getXmlAtt(cuboResultados,"r0","c52"));				marca = getXmlAtt(cuboResultados,"r0","marca");			//MSS 15052025: Llamar pantallas para completar informacion para interface SOFIA				nvous = getXmlAtt(cuboResultados,"r0","nvous");			//MSS 15052025: Llamar pantallas para completar informacion para interface SOFIA				ConfiguraCamposOpcion();										//MSS 15052025: Llamar pantallas para completar informacion para interface SOFIA			}						fun BusquedaFactura() 			{				var cmdQuery ="",v_tipo_n;					v_tipo_n = frn.get("k_tipon",-1,4);					sucursal_id = frn.get("k_sucn",-1,1);											cmdQuery = "select c6 as folio, to_char(c9, 'dd/mm/yyyy') as fecha,c10 as cliente,c11 as referencia, c16 as monto, c43 as status from keplersc.kdm1 where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc&  "' and c3 = '" & v_nat36 &  "' and c4 = '" & v_gru37 &  "' and c5 = '" & v_tipo_n &  "' ";					cmdQuery = cmdQuery & " order by c6 desc ";	frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\cmdVe");					frn.dialog("genlistasel","Facturas",cmdQuery,"folio","k_factura","0","","N");			}						fun ObtenerFolio()			{				   var cmdQuery ="",v_tipo_n;					v_tipo_n = frn.get("k_tipon",-1,4);					sucursal_id = frn.get("k_sucn",-1,1);					cmdQuery = "select c1 as tip, c6 as folio, to_char(c9, 'dd/mm/yyyy') as fecha,c11 as referencia, c16 as monto,c43 as status from keplersc.kdm1  where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc&  "' and c3 = '" & nat_doc&  "' and c4 = '" & gpo_doc&  "' and c5 = '" & v_tipo_n &  "' ";					cmdQuery = cmdQuery & " order by c6 desc ";					frn.dialog("genlistasel","Documentos",cmdQuery,"folio","k_folio","0","","N");			}						fun clientesView()			{				//frn.dialog("cat_cli_crud","MODIFICAR", "C100000", "n");				frn.dialog("cat_cli_crud","MODIFICAR","x","s","c_cliente");			}				 			fun MostrarCliente()			{				var xmlRequest,					 cmd,					 ok, 					 cuboResultados,					 mensajeError, 					 v_cliente;					 v_correo = "";					 v_uso_cfdi="";					 v_cliente= frn.get("k_cliente" , -1, 1);					 cmd = "select c30,c4,c5,c6,c10,c11,c16,c52,c53 from keplersc.kdud where c2 = '" & v_cliente & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.MostrarCliente()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				frn.set("k_nombre_impresion",getXmlAtt(cuboResultados,"r0","c30"));				frn.set("k_c30",getXmlAtt(cuboResultados,"r0","c30"));				frn.set("k_c4",getXmlAtt(cuboResultados,"r0","c4"));				frn.set("k_c5",getXmlAtt(cuboResultados,"r0","c5"));				frn.set("k_c6",getXmlAtt(cuboResultados,"r0","c6"));				frn.set("k_c10",getXmlAtt(cuboResultados,"r0","c10"));				v_correo = getXmlAtt(cuboResultados,"r0","c11");				v_uso_cfdi = getXmlAtt(cuboResultados,"r0","c53");								frn.set("k_correo",v_correo );				frn.set("k_cfdi",v_uso_cfdi );				frn.set("k_m_pago",getXmlAtt(cuboResultados,"r0","c52"));											}			//INVENT								fun MostrarInventario() //INV_FACTURA_LINK			{				var xmlRequest,					 cmd,					 ok, 					 cuboResultados,					 mensajeError,					 totOrd,					 contOrd;					 					 sucursal_id = frn.get("k_sucn",-1,1);					 v_inventario = frn.get("k_inventario");					 				cmd = "select c2,c3,c4,c5,C20,c17 as marca,c21 as nvous from keplersc.kdinf where c1 = '" & sucursal_id &  "' and c2 = '" & v_inventario & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.MostrarInventrio()");					BorraDatosPantalla();				if (nXml(cuboResultados) == 0 ){					frn.message("Criterios no encontrados","Criterios no encontrados","Aceptar");					frn.rst("k_inventario");					return;				}					var a= getXmlAtt(cuboResultados,"r0","c5");				var b= getXmlAtt(cuboResultados,"r0","c3");				var c= getXmlAtt(cuboResultados,"r0","c4");				marca = getXmlAtt(cuboResultados,"r0","marca");			//MSS 15052025: Llamar pantallas para completar informacion para interface SOFIA				nvous = getXmlAtt(cuboResultados,"r0","nvous");			//MSS 15052025: Llamar pantallas para completar informacion para interface SOFIA								frn.set("k_inventario",getXmlAtt(cuboResultados,"r0","c2"));																				frn.set("k_serie_inv",a);				frn.set("k_producto",b);				frn.set("k_desc_inv",c);				frn.set("k_monto",0);				frn.set("k_iva",0);				frn.set("subt",0);				//********************************************Obtener informacion de INV_FACTURA_LINK				cmd = "select kp.c9,kp.c12,kp.c13,kp.c14, ku.c3, ku.c4,ku.c5,ku.c6,ku.c10,ku.c11,ku.c52, ku.c53 from keplersc.KDPEDIDO kp inner join keplersc.kdud ku on kp.c9 = ku.c2  and kp.c1 = '" & sucursal_id &  "' and kp.c2 = '" & v_inventario & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.MostrarInventrio()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				//var a= getXmlAtt(cuboResultados,"r0","c2");								frn.set("k_cliente",getXmlAtt(cuboResultados,"r0","c9"));				frn.set("k_nombre_impresion",getXmlAtt(cuboResultados,"r0","c3"));				frn.set("k_c10",getXmlAtt(cuboResultados,"r0","c10"));				frn.set("k_c30",getXmlAtt(cuboResultados,"r0","c3"));				frn.set("k_c4",getXmlAtt(cuboResultados,"r0","c4"));				frn.set("k_c5",getXmlAtt(cuboResultados,"r0","c5"));				frn.set("k_c6",getXmlAtt(cuboResultados,"r0","c6"));				//				var v_resultado;				v_resultado = (getXmlAtt(cuboResultados,"r0","c14")-getXmlAtt(cuboResultados,"r0","c13")-getXmlAtt(cuboResultados,"r0","c12"));				frn.set("k_importeprevio",v_resultado);				frn.set("k_preciovehiculo",v_resultado);				frn.set("k_isan",getXmlAtt(cuboResultados,"r0","c12"));				frn.set("k_iva",getXmlAtt(cuboResultados,"r0","c13"));				frn.set("k_monto",getXmlAtt(cuboResultados,"r0","c14"));				// Metodos de pagos				frn.set("k_m_pago",getXmlAtt(cuboResultados,"r0","c52"));				frn.set("k_forma_pago","99");				frn.set("k_cuenta","");				frn.set("k_cfdi",getXmlAtt(cuboResultados,"r0","c53"));				frn.set("k_correo",getXmlAtt(cuboResultados,"r0","c11"));								if(getXmlAtt(cuboResultados,"r0","c10") &= "")				{					v_A98 = "N";				}				ConfiguraCamposOpcion();					//MSS 15052025: Llamar pantallas para completar informacion para interface SOFIA			}					fun BusquedaInventario()			{				var cmdQuery ="";					sucursal_id = frn.get("k_sucn",-1,1);					cmdQuery = "select c2 as inventario, c3 as Clave,c4 as Descripcion, c5 as Serie from keplersc.kdinf where c1 = '" & sucursal_id &  "' and c31 =20 and c32 = 10 ";						cmdQuery = cmdQuery & " order by c2 asc ";						frn.dialog("genlistasel","Alta Factura Vehiculo / Inventario.",cmdQuery,"inventario","k_inventario","0","","N");            			}			fun MostrarGrupo() 			{				inicializa();			}						fun inicializa(){//Da valor a los combos y prepara la pagina dependiendo del tipo de Operacion a realizar				var resValidacion, resMensaje,cubo, cmd, ok,mensajeError,sucursal_id,v_cliente,v_tipoOperacion;				kdb.kde("KDE");//	Configuracion del servidor				kdb.exec();				anio_contable = kdb.get("KDE","14");				frn.set("k_fecha",sys.date());												if(frn.nParam()>0 ){//Se han mandado parametros a la pagina					gen_doc=trim(frn.param(0)); 					nat_doc=trim(frn.param(1)); 					gpo_doc=trim(frn.param(2));					tip_doc=trim(frn.param(3)); 					fija_doc=trim(frn.param(4));					tip_ope=trim(frn.param(5));					uen=trim(frn.param(6));				}				else				{					frn.message("Esta accion no esta permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}				ConfiguraCamposOpcion();				if(tip_ope==0)				{//Alta					v_tipoOperacion = "Alta Factura Auto";					v_nat36 = "A";					v_gru37 = 35;					v_tipo38 = 1;				}				if(tip_ope==3)				{//Nota de Credito					v_tipoOperacion = "Nota de Credito";					v_nat36 = "D";					v_gru37 = 6;					v_tipo38 = 1;//					gpo_doc = frn.get("k_grupodocto");				}				if(tip_ope==2)				{//Anulacion					v_tipoOperacion = "Anulacion";					v_nat36 = "D"; 					v_gru37 = 6;					v_tipo38 = 1;//					gpo_doc = frn.get("k_grupodocto");				}				if(tip_ope==1)				{//Consulta 					if (gpo_doc &= "6"){						v_tipoOperacion = "Consulta Alta Factura";					}else{											if (gpo_doc &= "60"){							v_tipoOperacion = "Consulta Nota Credito";						}						if (gpo_doc &= "63"){							v_tipoOperacion = "Consulta Nota Credito Reportados";						}												if (gpo_doc &= "70"){							v_tipoOperacion = "Consulta Anulacion";						}												frn.setAtt("txt_factura","visible","Y");						frn.setAtt("k_factura","visible","Y");						frn.setAtt("k_factura","OnF9","");						frn.setAtt("k_factura","tooltip","");						frn.setAtt("Imprimir","visible","N");					}				}				frn.set("k_titulo_inicial",v_tipoOperacion);				addDocto(v_tipoOperacion,gen_doc,nat_doc,gpo_doc,0,0,v_nat36,v_gru37,v_tipo38);											//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_AltaVehiculoFactura_crud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));								//Llena combo tipo				LlenaCmbTipo();												frn.setX("CRÉDITO", "k_creditocontado",0,0);				frn.setX("CONTADO", "k_creditocontado",1,0);								Fecha();//Indica fecha correcta, y trae monedas y paridades de esa fecha. 				if (strlen(tip_doc)>0) frn.setPos("k_tipon",-1,4,"internal:Y","val:" & tip_doc);//Posiciona el combo de Tipo de documento al especificado como parametro								//LlenaCmbMoneda();				//Llenar Vendedor k_vendedor	k_tipo_operacion k_coach	k_cliente				LlenaCmbVendedores();								//Llenar k_cliente				//cmd = "select '['||c2||'-'||c3||']' as c3, c2  from keplersc.kdud";				cmd = "select '['||c2||']-'||c3||'' as c3, c2  from keplersc.kdud";									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaFacturaVehiculo.Cliente()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_cliente",getXml(cubo));								//				if(tip_ope==0){//Alta					frn.set("operacion","ALTA");frn.setPos("k_inventario");				}				else if(tip_ope==1){//Consulta					frn.set("operacion","CONSULTA");				}				else if(tip_ope==2){//Cancelacion					frn.set("operacion","ANULACION");				}					else if(tip_ope==3){//Baja					frn.set("operacion","NOTA CREDITO");				}					else if(tip_ope==4){//Modificacion					frn.set("operacion","MODIFICACION");				}				v_A98 = "S";				//interfaz_qm				cmd="SELECT count(*) as totreg from keplersc.param_oper where parametro in ('interfaz_gm')";				rstXml(cubo);								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_AltaVehiculoFactura_crud.inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				tot_reg=getXmlAtt(cubo,"r0","totreg");							if(tot_reg == 1){					cmd="SELECT valor from keplersc.param_oper where parametro in ('interfaz_gm')";					rstXml(cubo);									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_AltaVehiculoFactura_crud.inicializa()");					ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					interfaz_gm= getXmlAtt(cubo,"r0","valor");				}				//llenar k_motivo_cancel				cmd = "select codigo_cancelacion ||'-'||razon_cancelacion as descripcion, codigo_cancelacion from keplersc.ifz_sofia_razon_cancelacion order by codigo_cancelacion";				rstXml(cubo);					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaFacturaVehiculo.Cliente()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_motivo_cancel",getXml(cubo));				frn.set("k_motivo_cancel","");								// Fill k_docto | referencia docto				ArmarRefDocto();								BorraDatos();				if (tip_ope== 0){					fecha_config();				}						frn.set("datcfdi","N");			//Pantalla validacion CFDI				ActivaFolioManual();			//MSS 15102024: Permitir capturar un folio manual			}						fun LlenaCmbTipo(){				var cubo,cmd,ok,mensajeError;				sucursal_id=frn.get("k_sucn",-1,1);															cmd = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and length(c4::text)=1 and col_sucursal='" & sucursal_id & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTipoDocto");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_tipon",getXml(cubo));			}							fun LlenaCmbVendedores(){				var cubo,cmd,ok,mensajeError;				sucursal_id = frn.get("k_sucn",-1,1);				cmd = "select '['||c2||'] '||c3 as c1, c3,c2 from keplersc.kduv where c1 = '" & sucursal_id &  "'";									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaPedido.Vendedor()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_vendedor",getXml(cubo));			}						fun CambiaSucursal(){				sucursal_id = frn.get("k_sucn",-1,1);				LlenaCmbTipo();				LlenaCmbVendedores();				Valida_Tipo_Docto();				ArmarRefDocto();				if (tip_ope== 0){					fecha_config();				}				ActivaFolioManual();			//MSS 015102024: Permitir capturar un folio manual											}							fun LlenaCmbMoneda(){				frn.setX("PESOS","k_moneda",0,0);			} 						fun Valida_Tipo_Docto(){				var resValidacion, resMensaje, cubo, cmd, ok, tip_doc;							//Valida documento vigente				tip_doc=frn.get("k_tipon",-1,4);				kdb.rst();								BorraDatosPantalla();								cmd= "select * from keplersc.verify_valid_document('" & frn.get("k_sucn",-1,1) & "','" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & tip_doc & ")"; //suc text, genero text, naturaleza text, grupo integer, tipo_movto integer				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Valida_Tipo_Docto()");								resValidacion= getXml(cubo,"validacion","resultado");				resMensaje = getXml(cubo,"validacion","mensaje");				if(resMensaje &! ""){					frn.message(resMensaje, "Mensaje","&Aceptar");					frn.setPos("k_tipon");				}				frn.set("k_folio", "");			//MSS 15102024: Permitir capturar un folio manual				ArmarRefDocto();				ActivaFolioManual();			//MSS 15102024: Permitir capturar un folio manual							}			// Armado del Docto Referencia			fun ArmarRefDocto() {						//MSS 15102024: Armado de k_docto				var cadena,tmpFolio, tmpGrupo, tmpTipo;				tmpFolio = frn.get("k_folio");				tmpFolio = PadLeft(tmpFolio,"7","0");				tmpGrupo = PadLeft(gpo_doc,"2","0");				tip_doc = frn.get("k_tipon", -1,4);				tmpTipo = PadLeft(tip_doc,"3","0");				cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;				frn.set("k_docto", cadena);			}						fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;				var nReg = strlen(pText);				for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;				}				Resultado = Resultado & pText;                				return Resultado;			}						fun ConfiguraControlesOff()			{				var strValAtr;				strValAtr = "N";				//Deshabilita todos los campos y botones				frn.setAtt("capturaFolio", "visible", "N");			//MSS 15102024: Permitir capturar un folio manual				frn.setAtt("grpDatosGenerales","available",strValAtr);				frn.setAtt("grDocumentos","available",strValAtr);								frn.setAtt("grpDoc","available","N");				frn.setAtt("grpDetalle","available",strValAtr);				frn.setAtt("grpInventario","available",strValAtr);				frn.setAtt("grpconceptosextras","available",strValAtr);				frn.setAtt("grpComentarios","available",strValAtr);				frn.setAtt("Aceptar","available",strValAtr);				frn.setAtt("Aceptar","visible",strValAtr);				frn.setAtt("Imprimir","available",strValAtr);				frn.setAtt("Imprimir","visible",strValAtr);					frn.setAtt("Cancelar","available",strValAtr);				frn.setAtt("Cancelar","visible",strValAtr);				frn.setAtt("foliotxt","visible",strValAtr);								frn.setAtt("k_folio","modify",strValAtr);					frn.setAtt("k_folio","visible",strValAtr);										frn.setAtt("k_fecha","modify",strValAtr);					frn.setAtt("k_fecha","available",strValAtr);				frn.setAtt("k_refer","modify",strValAtr);					frn.setAtt("k_refer","available",strValAtr);				frn.setAtt("k_fecref","modify",strValAtr);					frn.setAtt("k_fecref","available",strValAtr);				frn.setAtt("k_plazo","modify",strValAtr);					frn.setAtt("k_plazo","available",strValAtr);				frn.setAtt("k_cond","modify",strValAtr);					frn.setAtt("k_cond","available",strValAtr);					frn.setAtt("k_coment","modify",strValAtr);				frn.setAtt("k_coment","available",strValAtr);				frn.setAtt("k_coment2","modify",strValAtr);				frn.setAtt("k_coment2","available",strValAtr);								frn.setAtt("k_coment3","modify",strValAtr);				frn.setAtt("k_coment3","available",strValAtr);				frn.setAtt("k_c10","available",strValAtr);				frn.setAtt("k_c30","available",strValAtr);				frn.setAtt("k_c4","available",strValAtr);				frn.setAtt("k_c5","available",strValAtr);				frn.setAtt("k_c6","available",strValAtr);						frn.setAtt("k_creditocontado","modify",strValAtr);							frn.setAtt("k_factura_desc","available",strValAtr);					frn.setAtt("k_factura_desc","modify",strValAtr);				frn.setAtt("k_factura_desc","visible",strValAtr);				frn.setAtt("k_factura","available",strValAtr);					frn.setAtt("buscar_factura","visible",strValAtr);				frn.setAtt("txt_factura","visible",strValAtr);				frn.setAtt("k_factura","modify",strValAtr);				frn.setAtt("k_factura","visible",strValAtr);				frn.setAtt("k_factura","OnF9","BusquedaFactura()");				frn.setAtt("k_factura","tooltip","Factura [F9]");				frn.setAtt("k_grupodocto_desc","available",strValAtr);				frn.setAtt("k_grupodocto_desc","modify",strValAtr);				frn.setAtt("k_grupodocto_desc","visible",strValAtr);				frn.setAtt("k_grupodocto","available",strValAtr);				frn.setAtt("k_grupodocto","modify",strValAtr);				frn.setAtt("k_grupodocto","visible",strValAtr);				frn.setAtt("buscar_folio","visible",strValAtr);				frn.setAtt("k_inventario","OnF9","");				frn.setAtt("k_inventario","tooltip","");				frn.setAtt("k_inventario","modify",strValAtr);				frn.setAtt("bot_selec_anticipos","visible",strValAtr);		//MSS 04032025 Seleccion de anticipos				frn.setAtt("bot_sofia","visible",strValAtr);						//MSS 15052025: Llamar pantallas para completar informacion para interface SOFIA				frn.setAtt("txt_gmac_ally","visible",strValAtr);				frn.setAtt("k_gmac_ally","visible",strValAtr);								frn.setAtt("k_gmac_ally","modify",strValAtr);				frn.setAtt("k_gmac_ally","available",strValAtr);								frn.setAtt("txt_motivo_cancel","visible",strValAtr);				frn.setAtt("k_motivo_cancel","modify",strValAtr);				frn.setAtt("k_motivo_cancel","visible",strValAtr);				}						fun ConfiguraCamposOpcion(){				var strValAtr;				ConfiguraControlesOff();				//HAbilita segun tipo de operacion				strValAtr = "Y";				switch(tip_ope){					case 0: //Alta						if (folioManual&="S"){		//MSS 15102024: Permitir capturar un folio manual							frn.setAtt("foliotxt","visible","Y");		//etiqueta Folio							frn.setAtt("capturaFolio", "visible", "Y");								frn.setAtt("k_folio", "available", "Y");							frn.setAtt("k_folio", "visible", "Y");							frn.setAtt("k_folio","modify","Y");						}						frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpDatosGenerales","modify",strValAtr);						frn.setAtt("grDocumentos","available",strValAtr);						frn.setAtt("grDocumentos","modify",strValAtr);						frn.setAtt("grpDetalle","available",strValAtr);						frn.setAtt("grpDetalle","modify",strValAtr);						frn.setAtt("grpInventario","available",strValAtr);						frn.setAtt("grpInventario","modify",strValAtr);						frn.setAtt("grpconceptosextras","available",strValAtr);						frn.setAtt("grpconceptosextras","modify",strValAtr);						frn.setAtt("grpComentarios","available",strValAtr);						frn.setAtt("grpComentarios","modify",strValAtr);						frn.setAtt("Aceptar","available",strValAtr);						frn.setAtt("Aceptar","visible",strValAtr);							frn.setAtt("Cancelar","available",strValAtr);						frn.setAtt("Cancelar","visible",strValAtr);								frn.setAtt("k_inventario","OnF9","BusquedaInventario()");						frn.setAtt("k_inventario","tooltip","Inventario [F9]");						frn.setAtt("k_inventario","modify",strValAtr);												frn.setAtt("k_cuenta","available",strValAtr);						frn.setAtt("k_cuenta","visible",strValAtr);								frn.setAtt("k_creditocontado","modify",strValAtr);														//frn.setAtt("k_fecha","modify",strValAtr);							//frn.setAtt("k_fecha","available",strValAtr);						frn.setAtt("k_refer","modify",strValAtr);							frn.setAtt("k_refer","available",strValAtr);						frn.setAtt("k_fecref","modify",strValAtr);							frn.setAtt("k_fecref","available",strValAtr);						frn.setAtt("k_plazo","modify",strValAtr);							frn.setAtt("k_plazo","available",strValAtr);						frn.setAtt("k_cond","modify",strValAtr);							frn.setAtt("k_cond","available",strValAtr);													frn.setAtt("k_coment","modify",strValAtr);						frn.setAtt("k_coment","available",strValAtr);						frn.setAtt("k_coment2","modify",strValAtr);						frn.setAtt("k_coment2","available",strValAtr);						frn.setAtt("k_coment3","modify",strValAtr);						frn.setAtt("k_coment3","available",strValAtr);						frn.setAtt("bot_selec_anticipos","visible",strValAtr);		//MSS 04032025 Seleccion de anticipos						if(interfaz_gm &= "S"){							frn.setAtt("txt_gmac_ally","visible",strValAtr);							frn.setAtt("k_gmac_ally","visible",strValAtr);							frn.setAtt("k_gmac_ally","modify",strValAtr);							frn.setAtt("k_gmac_ally","available",strValAtr);						}						break;					case 1: //Consulta												frn.setAtt("grpDatosGenerales","available",strValAtr);						//frn.setAtt("grpDocumentos","available",strValAtr);						//frn.setAtt("grpDocumentos","modify",strValAtr);						frn.setAtt("foliotxt","visible",strValAtr);							frn.setAtt("k_folio","modify",strValAtr);							frn.setAtt("k_folio","visible",strValAtr);												frn.setAtt("k_folio","available",strValAtr);						frn.setAtt("Imprimir","available",strValAtr);						frn.setAtt("Imprimir","visible",strValAtr);							frn.setAtt("buscar_folio","visible",strValAtr);						frn.setAtt("bot_selec_anticipos","visible",strValAtr);		//MSS 04032025 Seleccion de anticipos						if(interfaz_gm &= "S" && gpo_doc &! "6"){							frn.setAtt("txt_motivo_cancel","visible",strValAtr);							frn.setAtt("k_motivo_cancel","visible",strValAtr);								frn.setAtt("k_motivo_cancel","available",strValAtr);														frn.setAtt("txt_gmac_ally","visible",strValAtr);							frn.setAtt("k_gmac_ally","visible",strValAtr);						}						frn.setAtt("k_gmac_ally","visible",strValAtr);						break;					case 2: // Anulacion											frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpDatosGenerales","modify",strValAtr);						frn.setAtt("grDocumentos","available",strValAtr);						frn.setAtt("grDocumentos","modify",strValAtr);						frn.setAtt("grpDetalle","available",strValAtr);						frn.setAtt("grpDetalle","modify",strValAtr);						frn.setAtt("grpInventario","available",strValAtr);						frn.setAtt("grpInventario","modify",strValAtr);						frn.setAtt("grpProveedor","available","N");						frn.setAtt("grpProveedor","modify","N");						frn.setAtt("grpconceptosextras","available","N");						frn.setAtt("grpconceptosextras","modify","N");						frn.setAtt("Aceptar","available",strValAtr);						frn.setAtt("Aceptar","visible",strValAtr);							frn.setAtt("Cancelar","available",strValAtr);						frn.setAtt("Cancelar","visible",strValAtr);														frn.set("k_factura_desc","Factura");						frn.setAtt("k_factura_desc","available","Y");							frn.setAtt("k_factura_desc","modify","Y");						frn.setAtt("k_factura_desc","visible","Y");						frn.setAtt("k_factura","available","Y");							frn.setAtt("k_factura","modify","Y");						frn.setAtt("k_factura","visible","Y");						frn.setAtt("txt_factura","visible",strValAtr);						frn.setAtt("buscar_factura","visible",strValAtr);											frn.setAtt("k_grupodocto_desc","available",strValAtr);						frn.setAtt("k_grupodocto_desc","modify",strValAtr);						frn.setAtt("k_grupodocto_desc","visible",strValAtr);											//frn.setAtt("k_fecha","modify",strValAtr);							//frn.setAtt("k_fecha","available",strValAtr);															if(interfaz_gm &= "S"){							frn.setAtt("txt_motivo_cancel","visible",strValAtr);							frn.setAtt("k_motivo_cancel","modify",strValAtr);							frn.setAtt("k_motivo_cancel","visible",strValAtr);								frn.setAtt("k_motivo_cancel","available",strValAtr);														frn.setAtt("txt_gmac_ally","visible",strValAtr);							frn.setAtt("k_gmac_ally","visible",strValAtr);							frn.setAtt("k_gmac_ally","available",strValAtr);										}						//TODO,	verificar	como	se pasa	grupo para anulacion						frn.setX("70", "k_grupodocto",0,0);									break;					case 3: // NOTA DE CREDITO						frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpDatosGenerales","modify",strValAtr);						frn.setAtt("grDocumentos","available",strValAtr);						frn.setAtt("grDocumentos","modify",strValAtr);						frn.setAtt("grpDetalle","available",strValAtr);						frn.setAtt("grpDetalle","modify",strValAtr);						frn.setAtt("grpInventario","available",strValAtr);						frn.setAtt("grpInventario","modify",strValAtr);						frn.setAtt("grpProveedor","available","N");						frn.setAtt("grpProveedor","modify","N");						frn.setAtt("grpconceptosextras","available","N");						frn.setAtt("grpconceptosextras","modify","N");						frn.setAtt("Aceptar","available",strValAtr);						frn.setAtt("Aceptar","visible",strValAtr);							frn.setAtt("Cancelar","available",strValAtr);						frn.setAtt("Cancelar","visible",strValAtr);													frn.set("k_factura_desc","Factura");						frn.setAtt("k_factura_desc","available","Y");							frn.setAtt("k_factura_desc","modify","Y");						frn.setAtt("k_factura_desc","visible","Y");						frn.setAtt("k_factura","available","Y");							frn.setAtt("k_factura","modify","Y");						frn.setAtt("k_factura","visible","Y");						frn.setAtt("txt_factura","visible",strValAtr);						frn.setAtt("buscar_factura","visible",strValAtr);											frn.setAtt("k_grupodocto_desc","available",strValAtr);						frn.setAtt("k_grupodocto_desc","modify",strValAtr);						frn.setAtt("k_grupodocto_desc","visible",strValAtr);												//frn.setAtt("k_fecha","modify",strValAtr);							//frn.setAtt("k_fecha","available",strValAtr);												if(interfaz_gm &= "S"){							frn.setAtt("txt_motivo_cancel","visible",strValAtr);							frn.setAtt("k_motivo_cancel","modify",strValAtr);							frn.setAtt("k_motivo_cancel","visible",strValAtr);								frn.setAtt("k_motivo_cancel","available",strValAtr);														frn.setAtt("txt_gmac_ally","visible",strValAtr);							frn.setAtt("k_gmac_ally","visible",strValAtr);							frn.setAtt("k_gmac_ally","available",strValAtr);										}						frn.setX("60", "k_grupodocto",0,0);												break;					case 4: // MODIFICACION						break;					default:				}							if (HabilitaSofia() &="S" && marca &="CHEVR" && nvous &="NUEVO"){					frn.setAtt("bot_sofia","visible",strValAtr);				//MSS 15052025: Llamar pantallas para completar informacion para interface SOFIA				}							}									fun BorraDatos(){ //Limpia todos los campos para generar un nuevo documento. 				frn.set("k_folio","","statusDoc","","k_clave","","k_refer","","k_fecref",""); 				frn.rst("k_mov");frn.rst("k_poliza");								Clave(1);				if(tip_ope>0) 				{					if (tip_ope == 3)					{						frn.setPos("k_factura");											}					else					{						frn.setPos("k_folio");									}				}							}						fun addDocto(Descripcion,Gen,Nat,Gru,bTipo_Especifico,bSoloAutorizado,NatPrv,GruPrv,Gru2Prv){				var renglon=frn.N("grpDoc");				frn.setX(trim(Descripcion),"grpDoc",renglon,0);				frn.setX(trim(Gen),"grpDoc",renglon,1);				frn.setX(trim(Nat),"grpDoc",renglon,2);				frn.setX(trim(Gru),"grpDoc",renglon,3);				frn.setX(trim(bTipo_Especifico),"grpDoc",renglon,4);				frn.setX(trim(bSoloAutorizado),"grpDoc",renglon,5);				frn.setX(trim(NatPrv),"grpDoc",renglon,6);				frn.setX(trim(GruPrv),"grpDoc",renglon,7);				frn.setX(trim(Gru2Prv),"grpDoc",renglon,8);			}								fun Clave(iModo){//Actualiza los datos del cliente o Proveedor 				if(iModo==0){					var cmd="datos,u,1,0,'" & frn.get("k_clave") & "',&,u1...u50,v3";kdb.rel("v2=u12"); kdb.search(cmd); 					kdb.exec(); 					if(kdb.ok("datos")==0){						if(strlen(trim(frn.get("k_clave")))>0)	frn.message("La clave "&frn.get("k_clave")&" no se encontro","Error","&Aceptar");						frn.setPos("k_clave");//La clave no existe					}				}else{kdb.rst("datos");}//Borra la info anterior				frn.set("k_clave",kdb.get("datos","u2"),"k_rfc",kdb.get("datos","u10"),"k_plazo",kdb.get("datos","u16"));				frn.set("k_nombreprov",kdb.get("datos","u3"));				frn.set("k_calleprov",kdb.get("datos","u4"));				frn.set("k_coloniaprov",kdb.get("datos","u5"));				frn.set("k_poblacionprov",kdb.get("datos","u6"));				frn.set("k_cpprov",kdb.get("datos","u27"));								//frn.setM("k_datCve",kdb.get("datos","u3"),kdb.get("datos","u4"),kdb.get("datos","u5"),kdb.get("datos","u6"),kdb.get("datos","u27"));				frn.setM("k_coment",kdb.get("datos","u24"),kdb.get("datos","u25"),kdb.get("datos","u26"));								Plazo();				CalcTotal();//para que aplique descuentos, etc.			}						fun Plazo(){ //Calcula la fecha de pago, y las condiciones de pago en base al plazo				frn.set("k_vence",fnDate("addC",frn.get("k_fecha"),frn.get("k_plazo")));//Suma dias comerciales				var cond=frn.get("k_plazo") & " dias fecha factura";				if (frn.get("k_plazo")==0) cond="Pago de contado";				frn.set("k_cond",cond);  			}						fun fecha_config(){				//validar k_fecha				//se basa en k75 SUB CFD_FOLIO								var cmd, cubo, ok;				sucursal_id=frn.get("k_sucn",-1,1);				cmd = "select C4 from keplersc.kdcfdconfig where c1='" & sucursal_id & "'";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.fecha_config()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var fec = getXmlAtt(cubo,"r0", "c4");							if (fec  &= "1"){					frn.set("k_fecha",sys.date(sys.date("year"),sys.date("month")-1,31));				}else{					frn.set("k_fecha",sys.date());				}								Fecha();							}						fun Fecha(){//Verifica que la fecha del documento sea correcta. Ademas trae monedas y paridades de esa fecha. 				var cubo, cmd, resValidacion, resMensaje, fecha;				var validDate=frn.lib("libKepler","ValidOpDate",frn.get("k_fecha"));												frn.set("k_moneda","PESOS");				frn.set("k_paridad",0);								kdb.rst();				frn.rst("results");				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				if (tip_ope == 0 ){					cmd= "select * from keplersc.verify_year('" & fecha & "')";					cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Fecha()");									;										resValidacion= getXml(cubo,"validacion","resultado");					resMensaje = getXml(cubo,"validacion","mensaje");					if(resMensaje &! ""){						frn.message(resMensaje, "Mensaje","&Aceptar");					}											if(resValidacion &= "0"){						frn.setPos("k_fecha");						return;					}									}				//Plazo();			}									fun CalcTotal(){ //Calcula los importes parciales y el total				var bConsulta=((tip_ope>=1)&&(tip_ope<=3))?1:0;//Se esta consultando el documento. Solo recalcular subtotales				var T=0,IVA=0; //SUBTOTAL, IVA x partida				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {					if ( (frn.get("k_mov",i,"k_precio")==0)&&(frn.get("k_mov",i,"k_monto")>0) ){//Se requiere calcular el precio en base al importe						var prc=frn.get("k_mov",i,"k_monto")/frn.get("k_mov",i,"k_Q");						frn.setX(prc,"k_mov",i,"k_precio"); 					}					var imp=frn.get("k_mov",i,"k_Q")*frn.get("k_mov",i,"k_precio");//importe de partida					frn.setX(imp,"k_mov",i,"k_monto");										T=T+ math("round",imp,2);					//Impuesto por producto					if (frn.get("k_tipon",-1,6)==99)//Iva por producto						if (frn.get("k_mov",i,"k_iva")<0){								T=T-math("round",imp,2);								imp=frn.get("k_mov",i,"k_Q")*frn.get("k_mov",i,"k_precio");//importe de partida							  imp=imp/(1+((-1)*(frn.get("k_mov",i,"k_iva")/100)));//desglosar el IVA							  								T=T+ math("round",imp,2);								IVA=IVA+imp*(-1)*(frn.get("k_mov",i,"k_iva")/100);													}else {														IVA=IVA+imp*frn.get("k_mov",i,"k_iva")/100;						}								}				frn.set("subt",T); 				if(bConsulta)return;				if (frn.get("k_tipon",-1,6)==99){					frn.set("k_iva",IVA*0.16);//Al tener iva por producto;				}				else{					frn.set("k_iva",(frn.get("subt"))*frn.get("k_tipon",-1,6)/100);				}								frn.set("k_ivaRet",frn.get("subt")*frn.get("k_tipo",-1,8)/100);				frn.set("k_monto",frn.get("subt")+frn.get("k_iva")-frn.get("k_ivaRet"));			}							fun CalcFolio(){//Se ejecuta despues de consultar documento en disco (consulta,documento previo,etc), para manipulaciones adicionales en pantalla				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {//Se recalcula el precio con mayor precision (decimales)					var prc=frn.get("k_mov",i,"k_monto")/frn.get("k_mov",i,"k_Q");					frn.setX(prc,"k_mov",i,"k_precio");				}				CalcTotal();//Recalcula Totales			}			fun Ejecuta(){				if(tip_ope==0){Alta();}				else if(tip_ope==1){Consulta();}				else if(tip_ope==2){Baja();}				else if(tip_ope==3){Baja();}				else if(tip_ope==4){Modifica();}			}									fun Alta()			{				var resultado, mensaje, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd, continua;				var partidasValidas = 0;				kdb.rst();				frn.rst("results");				//Validar folio manual				resVal = 1;				FolioManual();					//MSS 15102024: Permitir capturar un folio manual				if( frn.get("k_monto") <= 0 )				{					frn.message("Monto cero o negativo","Error","&Aceptar");					return;				}				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				cmd= "select * from keplersc.verify_year('" & fecha & "')";				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"ven_AltaVehiculoFactura_crew.Alta()");				resultado= getXml(cubo,"validacion","resultado");				mensaje = getXml(cubo,"validacion","mensaje");				if(mensaje &! ""){					frn.message(mensaje,"Error al generar el documento","Aceptar");				}									if(resultado &= "0"){					frn.setPos("k_fecha");					return;				}									if(resVal == 0){			//MSS 15102024: Permitir capturar un folio manual					return;				}								//Valida contrato gmac_ally				if (interfaz_gm &= "S"){//					if (frn.get("k_gmac_ally") &= ""){//						frn.message("Ingresar el contrato GMAC ALLY","Error","Aceptar");//						return;//					}				}								//Pantalla validacion CFDI				if (frn.get("datcfdi") &= "N"){					frn.dialog("icfdreview",frn.get("k_sucn",-1,1),frn.get("k_cliente"),"Alta","inp",frn.get("k_forma_pago"),frn.get("k_cuenta"),frn.get("k_m_pago"),"inp",frn.get("k_cfdi"));					return;				}					continua = frn.message(" Desea continuar con la alta de la factura?","Atencion",2);				if (continua == 0){					frn.set("datcfdi","N");	//Pantalla validacion CFDI					return;				}															fecha = sys.date();				hora= sys.time();				//cubo = "dat";				kdb.rst();				frn.rst("results");				frn.rst(xmlPantalla);				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;				if (frn.get("k_cuenta") &="" ) 				{					frn.set("k_cuenta","000000");				}				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;						setXml(xmlPantalla,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));								setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"k_clave",frn.get("k_cliente" , -1, 1));				setXml(xmlPantalla,"k_vendedor","");				setXml(xmlPantalla,"k_refer",frn.get("k_inventario"));				setXml(xmlPantalla,"k_natdocto",nat_doc);				setXml(xmlPantalla,"k_gpodocto",35); //definido para Alta				setXml(xmlPantalla,"k_tipodocto",tip_doc); 				setXml(xmlPantalla,"k_fecref",strFecha);				setXml(xmlPantalla,"operacion",frn.get("operacion"));				setXml(xmlPantalla,"k_ivadesglosado","N");				setXml(xmlPantalla,"k_nombreimprfact",frn.get("k_c30"));				setXml(xmlPantalla,"k_claveinv",frn.get("k_inventario"));				setXml(xmlPantalla,"k_tipopagos","0");				setXml(xmlPantalla,"k_tipoauto","N");								setXml(xmlPantalla,"k_pedimento","");				setXml(xmlPantalla,"k_status_validacion","1");				setXml(xmlPantalla,"k_f_pago","r1",frn.get("k_forma_pago"));				setXml(xmlPantalla,"k_mov","no_partidas",0);				setXml(xmlPantalla,"k_foliodocto","VXX0000001");				setXml(xmlPantalla,"k_serievehiculo",frn.get("k_serie_inv"));								setXml(xmlPantalla,"k_proyecto",frn.get("k_creditocontado"));				setXml(xmlPantalla,"k_miepsret",frn.get("k_isan"));				setXml(xmlPantalla,"k_mivaret",frn.get("k_iva"));											cmd="SELECT * FROM keplersc.verify_invalta('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"altavevehiculofactura.verify_invalta");				resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");				if(resultado &= "0")				{					frn.message(mensaje, "Error","&Aceptar");					frn.set("datcfdi","N");	//Pantalla validacion CFDI					return;				}								frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlAltaVehiculoFactura");								cmd="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"ven_AltaVehiculoFactura_crew.Alta");								resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");								if(resultado &= "1")				{					tip_ope = 1;					frn.set("k_folio",mensaje); 					frn.set("operacion","CONSULTA");										strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);					ConfiguraCamposOpcion();										mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;					frn.message(mensaje, "Mensaje","&Aceptar");				}else{					frn.message(mensaje, "Error","&Aceptar");					frn.set("datcfdi","N");	//Pantalla validacion CFDI				}			}						fun Consulta(){//Imprime el reporte del documento especificado 				if(strlen(trim(frn.get("k_folio")))==0){ 					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");					frn.setPos("k_folio");return;					}				ArmarRefDocto();				reporte();				frn.setPos("k_folio");			}								fun Baja()			{ 				var resultado, mensaje, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd, continua;				var partidasValidas = 0;				kdb.rst();				frn.rst("results");								if( frn.get("k_monto") <= 0 )				{					frn.message("Monto cero o negativo","Error","&Aceptar");return;				}				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				cmd= "select * from keplersc.verify_year('" & fecha & "')";				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"ven_AltaVehiculoFactura_crew.Baja()");				resultado= getXml(cubo,"validacion","resultado");				mensaje = getXml(cubo,"validacion","mensaje");				if(mensaje &! ""){					frn.message(mensaje,"Error al generar el documento","Aceptar");				}									if(resultado &= "0"){					frn.setPos("k_fecha");					return;				}																//Pantalla validacion CFDI				if (frn.get("datcfdi") &= "N"){					frn.dialog("icfdreview",frn.get("k_sucn",-1,1),frn.get("k_cliente"),"Baja","inp",frn.get("k_forma_pago"),frn.get("k_cuenta"),frn.get("k_m_pago"),"inp",frn.get("k_cfdi"));					return;				}					continua = frn.message(" Desea continuar con la operacion?","Atencion",2);				if (continua == 0){					frn.set("datcfdi","N");	//Pantalla validacion CFDI					return;				}																			fecha = sys.date();				hora= sys.time();				//cubo = "dat";				kdb.rst();				frn.rst("results");				frn.rst(xmlPantalla);				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;				if (frn.get("k_cuenta") &="" ) 				{					frn.set("k_cuenta","000000");				}				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;								setXml(xmlPantalla,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));								setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"k_clave",frn.get("k_cliente" , -1, 1));				setXml(xmlPantalla,"k_vendedor","");				setXml(xmlPantalla,"k_refer",frn.get("k_inventario"));				//setXml(xmlPantalla,"k_refer",frn.get("k_factura"));								setXml(xmlPantalla,"k_natdocto","D");				setXml(xmlPantalla,"k_gpodocto",6); //definido para Alta				setXml(xmlPantalla,"k_tipodocto",tip_doc); 				setXml(xmlPantalla,"k_fecref",strFecha);				setXml(xmlPantalla,"k_ivadesglosado","N");				setXml(xmlPantalla,"k_nombreimprfact",frn.get("k_c30"));				setXml(xmlPantalla,"k_claveinv",frn.get("k_inventario"));				setXml(xmlPantalla,"k_tipopagos","0");				setXml(xmlPantalla,"k_tipoauto","N");								setXml(xmlPantalla,"k_pedimento","");				setXml(xmlPantalla,"k_status_validacion","1");				setXml(xmlPantalla,"operacion","BAJA");							setXml(xmlPantalla,"k_f_pago","r1",frn.get("k_forma_pago"));				setXml(xmlPantalla,"k_mov","no_partidas",0);				setXml(xmlPantalla,"k_foliodocto",frn.get("k_factura"));				setXml(xmlPantalla,"k_serievehiculo",frn.get("k_serie_inv"));				setXml(xmlPantalla,"k_proyecto",frn.get("k_creditocontado"));				setXml(xmlPantalla,"k_miepsret",frn.get("k_isan"));				setXml(xmlPantalla,"k_mivaret",frn.get("k_iva"));												frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantalla");													cmd="SELECT * FROM keplersc.verify_invalta('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"bajavevehiculofactura.verify_invalta");				resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");				if(resultado &= "0")				{					frn.message(mensaje, "Error","&Aceptar");					frn.set("datcfdi","N");					return;				}					//frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlBajaPedidoAutos");				cmd="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"ven_BajaVehiculoFactura_crew.Alta");								resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");								if(resultado &= "1")				{					tip_ope = 1;					frn.set("k_folio",mensaje); 					frn.set("operacion","CONSULTA");										strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);					ConfiguraCamposOpcion();										mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;					frn.message(mensaje, "Mensaje","&Aceptar");				}else{					frn.message(mensaje, "Error","&Aceptar");					frn.set("datcfdi","N");				}			}							fun Modifica(){				frn.message("Funcion no implementada...","Error","&Aceptar");			}			fun ActivaFolioManual(){		//MSS 15102024: Permitir capturar un folio manual				var cuboQuery,cmdQuery,ok,mensajeError;				var configfolio;				cmdQuery = "select folio_manual " & 							"from keplersc.kdmm " &							"where col_sucursal='" &sucursal_id& "' and c1='" &gen_doc& "' and c2='" &nat_doc& "' and c3 =" &gpo_doc& " and c4= " & tip_doc;								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.ActivaFolioManual()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, "c:\Basura\FolioManual");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				configfolio = getXmlAtt(cuboQuery,"r0","folio_manual");						if (configfolio &= "S") {	// Folio Manual					folioManual = "S";					frn.setAtt("capturaFolio", "visible", "Y");					//frn.message("El movimiento requiere folio manual","Atencion","Aceptar");				} else{					folioManual = "N";					frn.setAtt("capturaFolio", "visible", "N");					}				ConfiguraCamposOpcion();			}			fun FolioManual(){					//Valida Folio Manual				//MSS 09112024: Permitir capturar un folio manual				var totReg;				var cuboQuery,cmdQuery,ok,mensajeError;				nfolioManual = frn.get("k_folio");				if (folioManual &="S"){					if (nfolioManual &= ""){						frn.setPos("k_folio");						resVal=0;						frn.message("Es necesario capturar el Folio","Error","Aceptar");						return;					} else{								//valida longitud del folio						if (strlen(nfolioManual) > 10){							frn.setPos("k_folio");							resVal=0;							frn.message("El folio no puede tener mas de 10 caracteres....Verifique","Error","Aceptar");							return;						}						//valida que no exista						cmdQuery = "select count(*) as totreg " & 							"from keplersc.kdm1 " &							"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc & " and c6= '" & nfolioManual & "'";										rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.FolioManual()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery, "c:\Basura\ExisteFolioManual");						ok = getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok) {							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;							}						totReg=getXmlAtt(cuboQuery,"r0","totreg");						if (totReg > 0){							frn.setPos("k_folio");							resVal=0;							frn.message("El folio capturado ya existe....Verifique","Error","Aceptar");							return;						}					}				}			}			fun SeleccionAnticipos(){					//MSS 04032025 Seleccion de anticipos				if (frn.get("k_inventario") &! ""){					frn.dialog("venseleccionanticipos.kpl");				} else{					frn.message("Es necesario capturar primero el No. Inventario","Error","Aceptar");					return;					}				}			fun CapturaSofia(){							//MSS 15052025: Llamar pantallas para completar informacion para interface SOFIA				if (frn.get("k_folio") &! ""){					if(tip_ope==0){				//Factura						frn.dialog("ifz_sofiainvoicenotification","INVOICENOTIFICATION", "ALTA", frn.get("k_folio"),frn.get("k_tipon",-1,4));					} else if(tip_ope==1){		//Consulta						//Dependiendo del tipo de docto llamar a la pantalla correspondiente						if (gen_doc&nat_doc&gpo_doc &= "UD6"){							frn.dialog("ifz_sofiainvoicenotification","INVOICENOTIFICATION", "ALTA", frn.get("k_folio"),frn.get("k_tipon",-1,4));						} else if (gen_doc&nat_doc&gpo_doc &= "UA60"){							frn.dialog("ifz_sofiainvoicecancelled","INVOICECANCELLED", "ALTA", frn.get("k_folio"),60,frn.get("k_tipon",-1,4));						} else if (gen_doc&nat_doc&gpo_doc &= "UA70"){							frn.dialog("ifz_sofiainvoicecancelled","INVOICECANCELLED", "ALTA", frn.get("k_folio"),70,frn.get("k_tipon",-1,4));						} 					} else if(tip_ope==2){		//Anulacion						frn.dialog("ifz_sofiainvoicecancelled","INVOICECANCELLED", "ALTA", frn.get("k_folio"),70,frn.get("k_tipon",-1,4));					} else if(tip_ope==3){		//Nota de credito						frn.dialog("ifz_sofiainvoicecancelled","INVOICECANCELLED", "ALTA", frn.get("k_folio"),60,frn.get("k_tipon",-1,4));					}				} else{					frn.message("Es necesario el No. Folio. Grabe primero el movimiento","Error","Aceptar");					return;					}				}			fun HabilitaSofia(){				var cuboQuery,cmdQuery,ok,mensajeError,ifz_sofia;				sucursal_id=frn.get("k_sucn",-1,1);					cmdQuery = "select valor from keplersc.param_oper where sucursal='" & sucursal_id & "' and parametro='interfaz_gm'";				frn.lib("libGeneral.kpl","FileSave",cmdQuery,"c:\basura\cmdselparamoper");				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ven_AltaVehiculoFactura_crud.Inicializa()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				ifz_sofia = getXmlAtt(cuboQuery,"r0", "valor");				return ifz_sofia;			}			fun reporte()			{					sucursal_id = frn.get("k_sucn",-1,1);									v_inventario = frn.get("k_inventario");					var cmd ="",cuboProd,,cuboProdB,ok,mensajeError,prodExiste;					cmd = "select c2,c4,c5,c6,c15,c21,c26,c27,c28,(select l.c2 from keplersc.KDMARCA l where l.c1 = c.c17) as c17,(select p.c4 from keplersc.KDICE2 p where p.c1 = c.c3 and p.c3 = c.c10) as c4a,(select o.c2 from keplersc.KDIC o where o.c1 = c.c18) as c18,(select h.c50 from keplersc.KDIV h where h.c1 = c.c3) as c50, (select h.c51 from keplersc.KDIV h where h.c1 = c.c3) as c51, (select h.c52 from keplersc.KDIV h where h.c1 = c.c3) as c52, (select h.c53 from keplersc.KDIV h where h.c1 = c.c3) as c53, (select h.c54 from keplersc.KDIV h where h.c1 = c.c3) as c54 from keplersc.KDINF c where c.c1 = '"& sucursal_id &"' and c.c2 = '"&v_inventario&"'";					cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaPedidoAutos.ConsultarDescripcionKDINF()");										ok=getXmlAtt(cuboProd,"ok");					if(ok &! "" && !ok)					{						mensajeError = getXmlAtt(cuboProd,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					prodExiste = getXmlAtt(cuboProd,"r0","c2");										if (prodExiste <= "0")					{						frn.message("El producto no existe.","Error","&Aceptar");						return;					}					cmd = "select c11,c14,c16,c32,c33,c34,c35,c44,(C16-C14-c15) as montobase from keplersc.kdm1 where c1 ='"& sucursal_id &"' and c2 = '"&gen_doc&"' and c3 = '"&nat_doc&"' and c4="&gpo_doc&" and c5="&tip_doc&" and c11 = '"&v_inventario&"' and c6 = '"& frn.get("k_folio")&"'";					cuboProdB = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaPedidoAutos.ConsultarDescripcionKDINF()");										ok=getXmlAtt(cuboProdB,"ok");					if(ok &! "" && !ok)					{						mensajeError = getXmlAtt(cuboProdB,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					prodExiste = getXmlAtt(cuboProdB,"r0","c11");										if (prodExiste <= "0")					{						frn.message("El producto no existe.","Error","&Aceptar");						return;					}									var prefix=frn.lib("libKepler","langPrefix");								kdb.readPage("datos","ven_AltaVehiculoFactura_crud_fto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos")); 				rep.rst(); 				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");								rep.set("titulo",frn.get("k_tipon"));				rep.exe("tit");								rep.set("rep_suc",frn.get("k_sucn",-1,0));					rep.set("rep_docto","UD06001-" &frn.get("k_folio"));				rep.set("rep_refer",frn.get("k_folio"));				rep.set("rep_fecha",frn.get("k_fecha"));				rep.exe("encabezado");								rep.set("rep_nombrecliente",frn.get("k_cliente"));				rep.set("rep_nombreimpresion",frn.get("k_nombre_impresion"));				rep.set("rep_clientedir2",frn.get("k_c30") &" "&frn.get("k_c4") &" "& frn.get("k_c5") &" "& frn.get("k_c6"));								rep.set("rep_rfc",frn.get("k_c10"));				rep.set("rep_colonia",getXmlAtt(cuboProdB,"r0","c34"));				rep.set("rep_poblacion",getXmlAtt(cuboProd,"r0","c35"));				rep.set("rep_telefono","");								rep.set("rep_inventario",frn.get("k_inventario"));								rep.set("rep_serie",getXmlAtt(cuboProd,"r0","c5"));				rep.set("rep_credito_contado",getXmlAtt(cuboProdB,"r0","c44"));				rep.set("rep_importado",getXmlAtt(cuboProd,"r0","c52"));								rep.set("rep_c17",getXmlAtt(cuboProd,"r0","c17"));				rep.set("rep_c18",getXmlAtt(cuboProd,"r0","c18"));				rep.set("rep_c15",getXmlAtt(cuboProd,"r0","c15"));				rep.set("rep_c4",getXmlAtt(cuboProd,"r0","c4"));								rep.set("rep_H10","Cil: " & getXmlAtt(cuboProd,"r0","c50"));				rep.set("rep_H51","Cap: " & getXmlAtt(cuboProd,"r0","c51"));				rep.set("rep_H53",getXmlAtt(cuboProd,"r0","c53"));				rep.set("rep_c6",getXmlAtt(cuboProd,"r0","c6"));				rep.set("rep_c54","Puertas: " & getXmlAtt(cuboProd,"r0","c54"));																rep.set("rep_1","1" & getXmlAtt(cuboProd,"r0","c18") & " " & getXmlAtt(cuboProd,"r0","c21") &" MARCA: "& getXmlAtt(cuboProd,"r0","c17"));				rep.set("rep_2","MODELO :" & getXmlAtt(cuboProd,"r0","c15") & " TIPO: " & getXmlAtt(cuboProd,"r0","c4"));				rep.set("rep_3","COLOR: " & getXmlAtt(cuboProd,"r0","c4a"));				rep.set("rep_4","CON EL PRECIO BASE DE ......................................................................................");						rep.set("rep_4a",getXmlAtt(cuboProdB,"r0","montobase"));								rep.set("rep_5","PEDIMENTO: " & getXmlAtt(cuboProd,"r0","c26"));				rep.set("rep_6","FECHA DE IMPORTACION: " & getXmlAtt(cuboProd,"r0","c27"));				rep.set("rep_7","LUGAR DE IMPORTACION: "& getXmlAtt(cuboProd,"r0","c28"));								rep.set("rep_8","EL PRECIO SOBRE LA UNIDAD ANTERIORMENTE");				rep.set("rep_9","DESCRITA, INCLUYE EL IMPUESTO SOBRE VEHICULOS");				rep.set("rep_10","NUEVOS DE ACUERDO AL ARTICULO 13 DE LA LEY RESPECTIVA.");				rep.set("rep_11","PAGO EN UNA SOLA EXHIBICION Y EFECTOS FISCALES AL PAGO.");												rep.set("rep_8a","$ " & getXmlAtt(cuboProdB,"r0","montobase"));				rep.set("rep_9a","");				rep.set("rep_10a","$ " & getXmlAtt(cuboProdB,"r0","c14"));				rep.set("rep_11a","");				rep.set("rep_12a","$ " & getXmlAtt(cuboProdB,"r0","c16"));								rep.set("rep_13","***" & strFormat(getXmlAtt(cuboProdB,"r0","c16"),150.23,0));								rep.set("rep_14","ING JUAN SABAS LEAL MULDOON");				rep.set("rep_15","DIRECTOR GENERAL");				rep.exe("seccion_detalle");				rep.set("rep_ad_administra","0");								rep.win(); 			}					fun Documentos(tipo) {//Tipo: 1)Permite consultar documentos; 2) Permite referenciar documentos previos; 3) Permite referenciar partidas previas				//var pag_dialogo="doc_part_prv";				switch(tipo){					case 1:						frn.dialog("doc_consulta","k_folio",frn.get("grpDoc",-1,1));						break;					case 2:						break;					case 3:						break;				}			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validacion. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validacion. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para paginas de operacion:Solo si se esta en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolvera el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}				//version 1.0 27/Dic/2022 Se actualiza el campo Credito o Contado en KDM1 c44 			//version 1.1 29/Dic/2022 Se actualiza el campo IMPORTE, se ajustan y alinean campos para descripcion.			//Saltiel Cruz.		}				</script></pag>