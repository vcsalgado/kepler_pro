<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp id="grpMain" brdr="0,0" clr="0,58,112" fnt="Arial,18b"  dim="1,-1,10,8" bclr="192,205,213" clrBrdr="0,97,181" tit="Carta Factura" unfont="0">			<tab/><txt fnt=",22" clr="0,0,0">Impresi&#243;n de Documentos</txt><br/><tab/><hLine clr="0,0,0"/><br/><tab n="2"/>		<br/><br/>		<tab/>		<grp id="grpDatosGenerales" dim="60,72,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" tit="Datos generales"  fnt="Arial,16" available="Y" modify="Y">			<br/>			<tab/><txt clr="0,58,112" hk="S">Sucursal :</txt><tab n="2"/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="60,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y" OnChange="CambiaSucursal()"/>						<br/>			<tab/><txt>Empresa : </txt><tab n="2"/>			<inp id="k_empresa" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="N" nc="60"/>			<br/>			<tab/><txt>Inventario : </txt><tab n="2"/>			<inp id="k_inventario" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" tooltip="F9 Consultar" 				OnF9="ConsultarInventario()" OnChange="ObtenerInventario()" nc="10"/>			<br/>			<tab/><txt>Fecha Venta:</txt><sp/><tab/>			<edt id="k_fecha_venta" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" fmt="DD/MM/CCYY"/><tab n="4"/>			<txt>Fecha impresi&#243;n : </txt><tab/>			<edt id="k_fecha" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" fmt="DD/MM/CCYY" nc="10" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)"/>			<br/><br/>			<tab/><txt>Vendio a :</txt><tab n="2"/>			<inp id="k_comprador" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="130"/>			<br/><tab n="6"/>			<inp id="k_calle" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="80"/>			<br/><tab n="6"/>			<inp id="k_colonia" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="70"/>			<br/><tab n="6"/>			<inp id="k_ciudad" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="70"/>			<br/><tab n="6"/>			<inp id="k_diradic" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="70"/>			<br/>						<tab/><txt>Tel&#233;fono :</txt><tab n="3"/>			<inp id="k_telefono" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="60" modify="Y" available="Y"/>			<br/>			<tab/><txt>Marca :</txt><tab n="3"/>			<inp id="k_marca" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="10"/>						<br/>			<tab/><txt>Modelo :</txt><tab n="3"/>			<inp id="k_modelo" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="10"/>			<br/>			<tab/><txt>Opci&#243;n :</txt><tab n="3"/>			<inp id="k_opcion" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="10"/>			<br/>			<tab/><txt>Tipo :</txt><tab n="4"/>			<inp id="k_tipo" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="60"/>			<br/>			<tab/><txt>Motor :</txt><tab n="3"/>			<inp id="k_motor" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<br/>			<tab/><txt>Serie :</txt><tab n="3"/>			<inp id="k_serie" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<br/>			<tab/><txt>Color :</txt><tab n="3"/>			<inp id="k_color" dim="23,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<tab n="2"/><txt>Interior :</txt><tab n="1"/><sp/>			<inp id="k_int" dim="23,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/><tab/>						<br/>			<tab/><txt>Transmisi&#243;n :</txt><tab/>			<inp id="k_transmision" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<br/>			<tab/><txt>R.F.V. :</txt><tab n="3"/>			<inp id="k_rfv" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<br/>			<tab/><txt>Clave Vehicular :</txt><tab/>			<inp id="k_clavevehi" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<br/>			<tab/><txt>Combustible :</txt><tab/>			<inp id="k_combustible" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<br/>			<tab/><txt>Cilindros :</txt><tab n="2"/>			<inp id="k_cilindros" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="2"/>			<br/>			<tab/><txt>Pasajeros :</txt><tab n="2"/>			<inp id="k_pasajeros" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="2"/>			<br/>			<tab/><txt>No. Puertas :</txt><tab n="2"/>			<inp id="k_puertas" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="2"/>			<br/>			<tab/><txt>Procedencia :</txt><tab/>			<inp id="k_procedencia" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<br/>			<tab/><txt>Pedimento :</txt><tab n="2"/>			<inp id="k_pedimento" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="25"/>			<br/>			<tab/><txt>Precio Venta :</txt><tab/>			<inp id="k_precio" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nc="15" nd="2" min="0" max="99999999"/>			<br/>			<tab/><txt>Factura No. :</txt><tab n="2"/>			<inp id="k_factura" dim="22,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<br/>			<tab/><txt>Vendedor :</txt><tab n="2"/>			<inp id="k_clave_vendedor" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<sp/>			<inp id="k_nombre_vendedor" dim="49,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<br/>			<tab/><txt>Tipo Operacion :</txt><sp/>			<inp id="k_clave_operacion" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<sp/>			<inp id="k_nombre_operacion" dim="49,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<br/>			<tab/><txt>Numero de Solicitud (TFS):</txt><sp/>			<inp id="k_numero_solicitud" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<br/>			<br/><tab n="2"/>						<bot id="btn_carta" dim="15,0" brdr="5" text="Carta Factura" OnEnter="ReporteCarta()"/><tab/>			<bot id="bot_entrega" dim="15,0" brdr="5" text="Carta Entrega" OnEnter="ReporteEntrega()" visible="N"/><tab/>			<bot id="bot_encuesta" dim="15,0" brdr="5" text="Encuesta Salida" OnEnter="ReporteEncuesta()"/><tab/>			<bot id="bot_fromato_unico" dim="15,0" brdr="5" text="Formato Unico" OnEnter="ReporteFormatoUnico()" visible="N"/><br/>			<br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,frP,sys;			var cmd,cubo,ok,mensajeError,xmlCarta;			var usuario,rol_usuario,suc_usuario,asterisco;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;								kdb.connect();				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				Inicializa();			}						fun Inicializa(){				//Llenar combo sucursales				cmd = "select c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_sucn",getXml(cubo));				checkEmpresa();			}			fun ConsultarInventario(){					var cmdQuery = "select c2 as inventario, c3 as clave_vehiculo, c4 as descripcion, c5 as serie from keplersc.kdinf where c1='" & frn.get("k_sucn", -1, 1) & "'";					frn.dialog("genlistafiltrosel","Inventarios",cmdQuery,"inventario","k_inventario","0","","S");			}						fun ObtenerInventario(){				var xmlPar,tmpStr;				setXml(xmlPar,"document","sucursal_id", frn.get("k_sucn",-1,1));				setXml(xmlPar,"document","inventario", frn.get("k_inventario"));				rstXml(cubo);				cmd="select * from keplersc.autos_carta_factura('"& getXmlStr(xmlPar,"EOF:13_10") &"')";				frn.lib("libGeneral.kpl","FileSave",cmd, "C:\Basura\cmdCartaFactura");				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_carta_factura_Execute()");				frn.lib("libGeneral.kpl","FileSave",cubo, "C:\Basura\cuboCartaFactura");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",cubo, "C:\Basura\cuboCartaFactura");										tmpStr=getXmlAtt(cubo,"r0","autos_carta_factura");				rstXml(xmlCarta);				tmpStr=delScpScn(tmpStr);				setXmlStr(xmlCarta,tmpStr);				xmlCarta= getXml(xmlCarta,"row");				frn.lib("libGeneral.kpl","FileSave",xmlCarta, "C:\ObtenerInventario");								frn.setX(xmlCarta);					}						fun FechaTexto(fecha,sep){				var tmpStr,texto,strMes;				tmpStr=strSplit(fecha,sep,1);				if (tmpStr &= "01"){ strMes="enero";}				if (tmpStr &= "02"){ strMes="febrero";}				if (tmpStr &= "03"){ strMes="marzo";}				if (tmpStr &= "04"){ strMes="abril";}				if (tmpStr &= "05"){ strMes="mayo";}				if (tmpStr &= "06"){ strMes="junio";}				if (tmpStr &= "07"){ strMes="julio";}				if (tmpStr &= "08"){ strMes="agosto";}				if (tmpStr &= "09"){ strMes="septiembre";}				if (tmpStr &= "10"){ strMes="octubre";}				if (tmpStr &= "11"){ strMes="noviembre";}				if (tmpStr &= "12"){ strMes="diciembre";}				texto=strSplit(fecha,sep,2) & " de " & strMes & " del " & strSplit(fecha,sep,0);								return texto;			}						fun LugarExpedicion(){				var lugarexp;				cmd = "select c4 from keplersc.kdms where c1='" & frn.get("k_sucn",-1,1) &"'";										cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_carta_factura.LugarExpedicion()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								lugarexp=getXmlAtt(cubo,"r0","c4");				return lugarexp;						}						fun CambiaSucursal(){				frn.set("k_empresa","");				frn.set("k_inventario","");				frn.set("k_fecha_venta","");				frn.set("k_fecha",sys.date());				frn.set("k_comprador","");				frn.set("k_calle","");				frn.set("k_colonia","");				frn.set("k_ciudad","");				frn.set("k_diradic","");				frn.set("k_telefono","");				frn.set("k_marca","");				frn.set("k_modelo","");				frn.set("k_opcion","");				frn.set("k_tipo","");				frn.set("k_motor","");				frn.set("k_serie","");				frn.set("k_color","");				frn.set("k_int","");				frn.set("k_transmision","");				frn.set("k_rfv","");								frn.set("k_clavevehi","");				frn.set("k_combustible","");				frn.set("k_cilindros","");				frn.set("k_pasajeros","");				frn.set("k_puertas","");				frn.set("k_procedencia","");				frn.set("k_pedimento","");				frn.set("k_precio","");				frn.set("k_factura","");				frn.set("k_clave_vendedor","");				frn.set("k_nombre_vendedor","");				frn.set("k_clave_operacion","");				frn.set("k_nombre_operacion","");				frn.set("k_numero_solicitud","");				checkEmpresa();			}			fun checkEmpresa(){				cmd = "select oem from keplersc.notif_api_config";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_carta_factura.checkEmpresa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");				}				frn.lib("libGeneral.kpl","FileSave",cubo, "C:\Basura\cuboCheckEmpresa");				if( getXmlAtt(cubo,"r0","oem") &= "SUB" ){					frn.setAtt("bot_entrega", "visible", "N");					frn.setAtt("bot_fromato_unico", "visible", "N");				}			}						fun ReporteCarta() {				var fechaTexto,fechaVenta, reporte_formato, fechaformat;				var prefix=frn.lib("libKepler","langPrefix");				if (frn.get("k_inventario") &=""){					frn.message("Debe seleccionar un No. Inventario","Atencion","Aceptar");					return;				}				fechaTexto=frn.get("k_fecha");				fechaVenta=frn.get("k_fecha_venta");										fechaTexto=FechaTexto(fechaTexto,"-");				fechaTexto=LugarExpedicion() & " a " & fechaTexto;	//MSS Parametrizar lugar de expedicion				fechaVenta=FechaTexto(fechaVenta,"-");				reporte_formato = "ven_carta_facturafto";				fechaformat = "CON LA PRESENTE HACEMOS DE SU CONOCIMIENTO QUE CON FECHA " & fechaVenta & " VENDIMOS A ";				cmd = "select valor from keplersc.param_oper where parametro = 'Carta Factura formato'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_carta_factura.ReporteCarta()");				ok=getXmlAtt(cubo,"ok");				if (getXmlAtt(cubo,"r0","valor") &! ""){					reporte_formato = getXmlAtt(cubo,"r0","valor");					fechaformat =  fechaVenta;				}				kdb.readPage("datos", reporte_formato);				kdb.exec();				rep.source(kdb.get("datos")); 				rep.rst(); 				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");								rep.set("titulo",frn.get("k_tipon"));				rep.exe("tit");								rep.set("rep_suc",frn.get("k_sucn",-1,0));					rep.set("linea_fecha_carta",fechaTexto);				rep.exe("encabezado");				rep.set("linea_fecha",fechaformat);				rep.set("linea_comprador",frn.get("k_comprador"));				rep.set("linea_calle",frn.get("k_calle"));				rep.set("linea_colonia",frn.get("k_colonia"));				rep.set("linea_municipio",frn.get("k_ciudad"));				rep.set("linea_adicional",frn.get("k_diradic"));				rep.set("marca",frn.get("k_marca"));				rep.set("modelo",frn.get("k_modelo"));				rep.set("opcion",frn.get("k_opcion"));				rep.set("tipo",frn.get("k_tipo"));				rep.set("motor",frn.get("k_motor"));				rep.set("serie",frn.get("k_serie"));				rep.set("color",frn.get("k_color"));				rep.set("transmision",frn.get("k_transmision"));				rep.set("rfv",frn.get("k_rfv"));				rep.set("clave_vehi",frn.get("k_clavevehi"));				rep.set("combustible",frn.get("k_combustible"));				rep.set("cilindros",frn.get("k_cilindros"));				rep.set("pasajeros",frn.get("k_pasajeros"));				rep.set("puertas",frn.get("k_puertas"));				rep.set("procedencia",frn.get("k_procedencia"));				rep.set("pedimento",frn.get("k_pedimento"));				rep.set("precio",frn.get("k_precio"));				rep.set("factura",frn.get("k_factura"));				rep.set("firma_atn_ctes",getXml(xmlCarta,"k_firma_atn_ctes"));				rep.exe("seccion_detalle");				rep.win();			}						fun ReporteEntrega() {				var fechaTexto,fechaVenta;				var prefix=frn.lib("libKepler","langPrefix");				if (frn.get("k_inventario") &=""){					frn.message("Debe seleccionar un No. Inventario","Atencion","Aceptar");					return;				}				fechaTexto=frn.get("k_fecha");				fechaVenta=frn.get("k_fecha_venta");						fechaTexto=FechaTexto(fechaTexto,"-");				fechaTexto=LugarExpedicion() & " a " & fechaTexto;	//MSS Parametrizar lugar de expedicion				//fechaTexto="Pachuca, Hgo. a " & fechaTexto;				fechaVenta=FechaTexto(fechaVenta,"-");				kdb.readPage("datos","ven_carta_entregafto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos")); 				rep.rst(); 				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");								rep.set("titulo",frn.get("k_tipon"));				rep.exe("tit");								rep.set("rep_suc",frn.get("k_sucn",-1,0));				rep.exe("encabezado");				rep.set("linea_comprador",frn.get("k_comprador"));				rep.set("linea_calle",frn.get("k_calle"));				rep.set("linea_colonia",frn.get("k_colonia"));				rep.set("linea_municipio",frn.get("k_ciudad"));				rep.set("linea_adicional",frn.get("k_diradic"));				rep.set("rep_suc_2",frn.get("k_sucn",-1,0));					rep.set("linea_fecha_carta",fechaTexto);				rep.exe("seccion_detalle");				rep.win();			}						fun ReporteEncuesta() {				var fechaTexto,fechaVenta;				var prefix=frn.lib("libKepler","langPrefix");				if (frn.get("k_inventario") &=""){					frn.message("Debe seleccionar un No. Inventario","Atencion","Aceptar");					return;				}				fechaTexto=frn.get("k_fecha");				fechaVenta=frn.get("k_fecha_venta");						fechaTexto=FechaTexto(fechaTexto,"-");				fechaTexto=LugarExpedicion() & " a " & fechaTexto;	//MSS Parametrizar lugar de expedicion				//fechaTexto="Pachuca, Hgo. a " & fechaTexto;				fechaVenta=FechaTexto(fechaVenta,"-");				kdb.readPage("datos","ven_encuesta_salidafto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos")); 				rep.rst(); 				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");								rep.exe("tit");								rep.set("rep_suc",frn.get("k_sucn",-1,0));					rep.set("distribuidor",frn.get("k_empresa"));					rep.set("linea_fecha_carta",frn.get("k_fecha"));				rep.set("linea_comprador",frn.get("k_comprador"));				rep.set("fol_factura",frn.get("k_factura"));				rep.set("fecha_factura",frn.get("k_fecha_venta"));				rep.set("telefono",frn.get("k_telefono"));				rep.set("clave_vendedor",frn.get("k_clave_vendedor"));				rep.set("nombre_vendedor",frn.get("k_nombre_vendedor"));				rep.set("inventario",frn.get("k_inventario"));				rep.set("tipo_auto",frn.get("k_opcion") & " " & frn.get("k_tipo"));				rep.set("serie",frn.get("k_serie"));				rep.set("motor",frn.get("k_motor"));				rep.set("modelo",frn.get("k_modelo"));				rep.set("ext",frn.get("k_color"));				rep.set("int",frn.get("k_int"));				rep.exe("encabezado");				rep.exe("seccion_detalle");				rep.win();			}				fun ReporteFormatoUnico() {				var fechaTexto,fechaVenta,continua,resultado,mensaje,xmlRequest,xml;				var prefix=frn.lib("libKepler","langPrefix");				if (frn.get("k_inventario") &=""){					frn.message("Debe seleccionar un No. Inventario","Atencion","Aceptar");					return;				}				continua = frn.message("¿Desea continuar? se geneara un folio para el Formato unico de salida","Atencion",2);				if (continua == 0){					return;				}								xmlRequest = getXml(frn.dataPag());				xml ="'<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>'";						cmd="select * from keplersc.obtener_folio_documento('" & "FORMUNICOSALIDA." & frn.get("k_sucn",-1,1) & "',0,0," & xml & ")";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"venfactdirecta.Alta");								resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");							fechaTexto=frn.get("k_fecha");				fechaVenta=frn.get("k_fecha_venta");						fechaTexto=FechaTexto(fechaTexto,"-");				fechaTexto=LugarExpedicion() & " a " & fechaTexto;	//MSS Parametrizar lugar de expedicion				//fechaTexto="Pachuca, Hgo. a " & fechaTexto;				fechaVenta=FechaTexto(fechaVenta,"-");				kdb.readPage("datos","ven_formato_unicofto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos")); 				rep.rst(); 				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");															rep.set("rep_suc",frn.get("k_sucn",-1,0));					rep.set("direccion_distribuidor",getXml(xmlCarta,"k_direccion_distribuidor"));				rep.set("adicionales_distribuidor",getXml(xmlCarta,"k_adicionales_distribuidor"));				rep.exe("tit");				rep.exe("encabezado");								rep.set("linea_fecha_carta",frn.get("k_fecha"));				rep.set("linea_comprador",frn.get("k_comprador"));				rep.set("distribuidor",frn.get("k_empresa"));				rep.set("num_distribuidor",getXml(xmlCarta,"k_num_distribuidor"));				rep.set("fol_factura",frn.get("k_factura"));				rep.set("fecha_factura",frn.get("k_fecha_venta"));				rep.set("telefono",frn.get("k_telefono"));				rep.set("clave_vendedor",frn.get("k_clave_vendedor"));				rep.set("nombre_vendedor",frn.get("k_nombre_vendedor"));				rep.set("folio",mensaje);				rep.set("inventario",frn.get("k_inventario"));				rep.set("tipo_auto",frn.get("k_tipo"));				rep.set("marca",getXml(xmlCarta,"k_marca"));				rep.set("serie",frn.get("k_serie"));				rep.set("motor",frn.get("k_motor"));				rep.set("modelo",frn.get("k_modelo"));				rep.set("ext",frn.get("k_color"));				rep.set("int",frn.get("k_int"));				rep.set("clave_operacion",frn.get("k_clave_operacion"));				rep.set("nombre_operacion",frn.get("k_nombre_operacion"));				rep.set("num_solicitud",frn.get("k_numero_solicitud"));				rep.exe("detalle");				rep.win();			}									}	</script></pag>