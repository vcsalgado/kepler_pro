<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte Auxiliar">	<grp dim="1,-1,10,20" brdr="0,0" bclr="192,205,213" clr="0,58,112" fnt="Arial,16" unfont="0" OnF1="Ventana(rep_Hlp)"><br/>	<tab n="1"/>	<txt fnt=",22" clr="0,0,0">Reasignar cuenta</txt><br/><tab/>	<hLine dim="0,1" clr="0,0,0"/> 	<br/> 	<br/><tab n="1"/>		<grp dim="55,45,10,5" bclr="236,240,243" tit="Criterio de proceso" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">			<grp dim="70,41,10,5" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4"><tab/>				<txt>Sucursal:</txt><tab n="1"/>				<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="30,1" bclr="254,254,254" brdr="0,0" fnt="Arial,16" Null="N" hk="S"  					available="Y" modify="Y"/>				<br/><tab/><txt>A&#241;o:</txt><tab n="2"/>				<cmb id="k_anio" dim="8,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N"/>				<br/><tab/><txt>Mes:</txt><tab n="2"/>				<cmb id="k_mes" dim="8,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"/>				<br/><tab/><txt>Cuenta origen:  </txt>				<inp id="cuenta_origen" dim="10,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20" OnChange="valida_cuenta(origen)"/><tab/><inp id="desc_origen" dim="28,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>				<br/><tab/><txt>Cuenta destino:</txt>				<inp id="cuenta_destino" dim="10,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20" OnChange="valida_cuenta(destino)"/><tab/><inp id="desc_destino" dim="28,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>				<br/><br/><br/><tab n="8"/>				<img id="Ejecutar" dim="40,40" bPx="Y" brdr="0,1" img="_60_DocNew.png" OnEnter="Ejecuta()"  available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Ejecutar proceso definitivo"/>				</grp>		</grp>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys, year, month,usuario,suc_usuario,perfil_usuario,rol_usuario,asterisco;			var cubo, ok, cmd, mensajeError, xmlRequest;						fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;				kdb.connect();				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";								Inicializa();			}				//Valida si la cuenta es de ultimo nivel			fun valida_cuenta(tipo_cuenta){				var cmdQuery, cuboQuery, cont, cuenta, resultado, mensaje;				if(tipo_cuenta &= "origen"){					cuenta = frn.get("cuenta_origen");				}else{					cuenta = frn.get("cuenta_destino");				}				setXml(xmlRequest,"document","cuenta",cuenta);				setXml(xmlRequest,"document","anio",frn.get("k_anio",-1,1));				cmd="select * from keplersc.verify_cuenta_ult_nivel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdValidaCta");				            rstXml(cuboQuery);            cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cont_reasignar_cuenta.valida_cuenta()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery ,"C:\Basura\cuboValidaCta");				                        ok=getXmlAtt(cuboQuery,"ok");            if(ok &! "" && !ok){                mensajeError = getXmlAtt(cuboQuery,"native3");                mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);                frn.message(mensajeError,"Error","Aceptar");                return;            }				resultado= getXmlAtt(cuboQuery,"r0","resultado");				mensaje= getXmlAtt(cuboQuery,"r0","mensaje");								if(resultado &= "0"){					if(tipo_cuenta &= "origen"){						frn.setPos("cuenta_origen");					}else{						frn.setPos("cuenta_destino");					}						frn.message(mensaje, "Error","&Aceptar");				}				if(tipo_cuenta &= "origen"){					frn.set("desc_origen",mensaje);				}else{					frn.set("desc_destino",mensaje);				}				return resultado;			}			fun Inicializa(){//Inicializa los valores en Pantalla				year = sys.date();				year=mid(year,0,4);				month= sys.date();				month=mid(month,5,2);				IniCombos();			}									fun IniCombos(){				var cmdQuery, cuboQuery, cont;            //Llenar combo sucursales				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";					}				}                        rstXml(cuboQuery);            cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comdevdircrud.IniCombos()");            ok=getXmlAtt(cuboQuery,"ok");            if(ok &! "" && !ok){                mensajeError = getXmlAtt(cuboQuery,"native3");                mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);                frn.message(mensajeError,"Error","Aceptar");                return;            }            frn.set("k_sucn",cuboQuery);            				for (cont=2022; cont <=year; cont++){					frn.setX(cont,"k_anio",cont-2022,0);					frn.setX(mid(cont,2,2),"k_anio",cont-2022,1);				}				frn.set("k_anio",year);								for (cont=101; cont <=112; cont++){					frn.setX(mid(cont,1,2),"k_mes",cont-101,0);					frn.setX(mid(cont,1,2),"k_mes",cont-101,1);				}				frn.set("k_mes",month);					}						fun Ejecuta(){//Prepara datos del reporte 				var resultado,mensaje,validacion; 				validacion = valida_cuenta("origen");				if (validacion==0){					return;				}				validacion = valida_cuenta("destino");				if (validacion==0){					return;				}								if (frn.message("La reasignacion puede tardar varios minutos, no salga de esta pantalla ni interrumpa el proceso. Ejecutar proceso? ","Confirmacion",2)==0){						return;				}				//Agregar el tipo de proceso y datos adicionales				usuario = frn.config("user","name");								setXml(xmlRequest,"document","k_sucn",frn.get("k_sucn",-1,1));				setXml(xmlRequest,"document","k_anio",frn.get("k_anio",-1,0));				setXml(xmlRequest,"document","k_mes",frn.get("k_mes",-1,0));				setXml(xmlRequest,"document","cuenta_origen",frn.get("cuenta_origen"));				setXml(xmlRequest,"document","cuenta_destino",frn.get("cuenta_destino"));				setXml(xmlRequest,"document","movimiento","usuario",usuario);								cmd="select * from keplersc.cont_reasignar_cuentas('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdReasignarCtas");								frn.messageBar("Actualizando saldos de cuentas...",0);								cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cont_resignar_cuenta.Ejecuta()");				frn.messageBar("",1);				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboReasignarCtas");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				resultado= getXmlAtt(cubo,"r0","resultado");				mensaje= getXmlAtt(cubo,"r0","mensaje");								if(resultado &= "1"){					frn.message("Proceso terminado, " & mensaje,"Mensaje","Aceptar");				}else{					frn.message(mensaje, "Error","&Aceptar");				}				frn.messageBar("",1);			}		}	}	</script></pag>