<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<tab/><txt fnt="Arial,22" clr="0,0,0">TOTs</txt>		<br/><tab/><hLine clr="0,0,0"/> 		<br/> <br/><tab/>		<grp dim="46,11,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros"><txt>  Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" tooltip="Sucursal" available="Y" modify="Y"/>			<br/><br/>			<txt>  Tipo :        </txt>			<cmb id="k_tipon" dim="40,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo()" tooltip="Tipo de Movimiento"/>			<br/>		</grp>		<sp/>		<grp dim="34,11,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C"/><tab/> <br/>			<txt id="textFolio" visible="Y">  Folio :  </txt>			<edt id="k_folio" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" tooltip="Folio ( F9 b&#250;squeda )" modify="Y" available="Y" visible="Y" 			OnF9="ObtenerFolio()" OnButton="ObtenerFolio()" OnChange="Formar_folio()"/><tab n="2"/>			<img id="BuscarFol" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="BuscarFolio()" visible="Y"/> <br/>			<sp n="1"/>			<inp id="k_docto" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="C"/> <br/>			<txt>  Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha"  clrBrdr="255,255,255" available="N" tooltip="Fecha"/> 			<sp n="1"/> 			<txt>  Hora : </txt> 			<sp n="1"/> 			<edt id="k_hora" dim="15,1" type="time" nc="-1" bclr="240,240,240" modify="Y" fmt="HH:MM:SS" available="N"/> 			<br/>		</grp>		<br/>		<br/><tab/>		<grp dim="81,16,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Proveedor">				<grp dim="38,9,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<sp n="1"/> <txt clr="0,58,112" hk="P">Proveedor : </txt><tab/>				<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnButton="Dialog(3,cxpcatprobus,k_clave)" OnF9="Dialog(3,cxpcatprobus,k_clave)" OnChange="BuscarProveedor()" 					type="capital" nc="7" tooltip="Proveedor ( F9 b&#250;squeda )" modify="Y" hk="P" available="N"/> 				<br/>				<sp n="1"/> <txt>RFC : </txt><sp n="5"/>				<inp id="k_rfc" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="20,1" fnt="Arial,16" type="string" nc="16" modify="Y" available="N"/>				<br/>			</grp>			<sp n="1"/>			<grp dim="75,11,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="1,5" fnt="Arial,16">				<sp n="1"/> <txt>Datos del proveedor : </txt>				<br/>				<sp n="1"/>				<inp id="k_nombreprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="70,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_calleprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="70,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_coloniaprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="70,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_poblacionprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="50,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="50" visible="Y"/>				<sp n="1"/>				<inp id="k_cpprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="15,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="10" visible="Y"/>			</grp>			<br/>			<sp n="1"/> <txt clr="0,58,112">Factura del proveedor : </txt><sp/>			<inp id="k_refer" clr="64,64,64" clrBrdr="255,255,255"  dim="80,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "N" modify="Y" 				tooltip="Factura del Proveedor"/>					<sp n="2"/>			<bot id="Buscar" dim="10" brdr="5" OnEnter="ObtenerFactura()" tooltip="Busca UUID de la factura del proveedor" available="N" visible="Y"/>			</grp>		<br/>		<br/><tab/>			<grp dim="81,21,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Movimientos">			<sp n="1"/> 			<tbl id="k_mov" dim="113,6" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" hk="z" OnChange="" Reorder="N" modify="Y" insdel="Y" available="Y">				<col id="k_tipo_orden" name="T"  type="capital" tooltip="Tipo de Orden ( F9 b&#250;squeda )" nc="2" OnF9="ObtenerTipoOrden()" OnChange="BuscarTipoOrden()"					OnMouseL="ObtenerTipoOrden()" modify="Y" available="N" visible="Y"/>				<col id="k_desc_tipo" name="Desc. Tipo Orden" type="capital" modify="N" tooltip="Descripci&#243;n Tipo de Orden" nc="15" visible="Y" available="N"/>							<col id="k_num_orden" name="Orden" type="capital" OnF9="ObtenerNumOrden()" 					OnMouseL="ObtenerNumOrden()" modify="N" tooltip="N&#250;mero de Orden ( F9 b&#250;squeda )" nc="15" visible="Y" available="N"/>						<col id="k_punto" name="Punto"  type="number"  modify="N" OnF9="ObtenerPunto()" OnMouseL="ObtenerPunto()" 					OnChange="ValidaPuntoOrden()" OnActive="" visible="Y" tooltip="Punto ( F9 b&#250;squeda )" nc="5" available="N"/>				<col id="k_desc_punto" name="Desc. Punto" type="capital" modify="N" tooltip="Descripci&#243;n Punto" nc="40" visible="Y" available="N"/>							<col id="k_descriptot" name="Descripci&#243;n TOTs"  type="capital" OnChange="ValidaDescripcion()" OnF9="" OnMouseL="ValidaDescripcion()" modify="Y" available="N" tooltip="Descripci&#243;n" nc="70" visible="Y"/>				<col id="k_costo" name="Costo"  type="number" nd="2"	OnChange="CalculaPrecio()" tooltip="Costo" modify="Y" available="N" visible="Y"/>									<col id="k_precio" name="Precio"  type="number" nd="2" min="0" OnF9="" OnMouseL="" OnChange="" OnActive="" tooltip="Precio" modify="Y" visible="Y" available="N"/>			</tbl>			<br/>			<sp/>			<grp dim="70,8,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">								<sp n="1"/> <txt clr="0,58,112">N O T A S:</txt>					<inp id="k_plazo" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nd="0" min="0" OnChange="Plazo()" modify="Y" available="N" visible="N"/>					<edt id="k_vence" clr="64,64,64"  dim="15,1" brdr="2,0" bclr="255,255,255" type="date" nc="-1" fnt="Arial,0" available="N" fmt="DD/MM/CCYY" page="_ks_fecha,k_vence" OnF9="Dialog(3,_ks_fecha,k_vence)" clrBrdr="255,255,255" visible="N"/><tab/>					<sp n="1"/> 					<inp id="k_cond" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="33" modify="N" available="N" visible="N"/>				<br/>				<sp n="1"/> <inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="68,3" brdr="2,0" fnt="Arial,16" modify="N" available="Y" type="string" bclr="255,255,255"/>			</grp>				<sp n="2"/>			<grp dim="41,10,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<sp n="2"/><txt>Antes de IVA : </txt> 				<inp id="k_subtotal" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/>				<br/>				<sp n="2"/> <txt>IVA :</txt><tab n="2"/><sp n="3"/> <inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/>				<txt>  (</txt>				<inp id="k_porciva" dim="5,1" bclr="240,240,240" clrBrdr="255,255,255" type="string" modify="N" available="N" just="C"/>				<txt> %)</txt>							<br/>				<sp n="2"/> <txt fnt=",16b">Importe : </txt>				<sp n="1"/><tab/> <inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="N"/>  				<br/>			<sp n="10"/>			<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="EjecReporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>							<sp n="5"/>			<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="N"/>							<sp n="5"/>			<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>			</grp>				</grp>							</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Variables de control			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, tiporden,desc_tipo, numorden, punto, descripcion, costo, resVal, porc_iva;			var fileSavePath, asterisco ;			//Variables validacion factura			var	str_uuid, fecha_uuid, rfc_uuid, total_uuid;								//Variables de parametros				var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd,uen;								fun Main() {			frn=new FRNT;			kdb=new KDB;			rep=new REP;			frP=new FRNTP;			sys=new SYS;			kdb.connect();			kdb.kde("KDE");			kdb.exec();			anio_contable = kdb.get("KDE","14");			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			suc_usuario = frn.lib("libKepler","UserInfo(1)");			asterisco = "*";			fileSavePath = "C:\Basura";			Inicializa();							ConfiguraControlesOpcion();		}							//Validacion Datos Generales y Partidas antes de Guardar.		//El resultado de cada validacion se guarda en la variable global resVal.		fun ValidarDatos() {			var totReg, strTotal=0,subTotal=0, iva=0, total=0, renglones, str,vdiferencia;			//Obtener variables			sucursal_id = frn.get("k_sucn",-1,1);			proveedor_id = frn.get("k_clave");			refer_id = frn.get("k_refer");										//Validar Proveedor			cmdQuery="SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_id & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("El proveedor no existe.","Error","Aceptar");				resVal=0;				return;			}			//Validar Referencia			if (refer_id &= ""){				frn.setPos("k_refer");				resVal=0;				frn.message("Es necesario seleccionar la factura del proveedor","Error","Aceptar");				return;			}			//Validar datos del Punto			for (var i=1,n=frn.N("k_mov");i<n-1;i++) {				tiporden = frn.get("k_mov",i,"k_tipo_orden");				numorden = frn.get("k_mov",i,"k_num_orden");				punto = frn.get("k_mov",i,"k_punto");				descripcion = frn.get("k_mov",i,"k_descriptot");				costo = frn.get("k_mov",i,"k_costo");				if ((tiporden &! "") && (numorden &! "")) {					if (tiporden &= ""){						frn.setPos("k_mov",i,"k_tipo_orden");						resVal=0;						frn.message("Debe seleccionar tipo de órden","Error","Aceptar");					}					if (numorden &= ""){						frn.setPos("k_mov",i,"k_num_orden");						resVal=0;						frn.message("Debe seleccionar número de órden","Error","Aceptar");					}					if (punto &= ""){						frn.setPos("k_mov",i,"k_punto");						resVal=0;						frn.message("Debe seleccionar un punto","Error","Aceptar");					}					if (descripcion &= ""){						frn.setPos("k_mov",i,"k_descriptot");						resVal=0;						frn.message("Debe capturar la descripción del punto","Error","Aceptar");					}					if (costo == ""){						frn.setPos("k_mov",i,"k_costo");						resVal=0;						frn.message("Debe capturar el costo del punto","Error","Aceptar");					}					if(resVal==0){						return;					}				}			}			//Validar Costos			for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {				frn.setPos("k_mov",i,"k_costo");				CalculaTotales();							}			//Validar Margen de utilidad			if (ValidaMargenUtilidad()==0){				resVal=0;				return;			};						//Validar Totales			subTotal=frn.get("k_subtotal");			iva=frn.get("k_iva");			total=frn.get("k_monto");			if (total <= 0){				resVal=0;				frn.message("El total de la operación no puede ser cero.","Error","Aceptar");				return;			}			//Validar rfc y monto total de factura correspondan a datos de UUID			strTotal = frn.get("k_monto");			vdiferencia = (strTotal-total_uuid);			if (vdiferencia < 0){				vdiferencia = vdiferencia *(-1); 			}			if (vdiferencia > 0.1) {				resVal=0;				frn.message("El importe total del TOT no corresponde al de la factura.","Error","Aceptar");				return;			}			if (frn.get("k_rfc") &! rfc_uuid) {				resVal=0;				frn.message("El RFC del TOT no corresponde al de la factura.","Error","Aceptar");				return;			}									} // End ValidarDatos()			fun ValidaPuntoDuplicado() {			var renglon_id, renglones;			renglones = frn.N("k_mov")-1;			renglon_id = frn.getIdJ("k_mov");			tiporden = frn.get("k_mov",-1,"k_tipo_orden");			numorden = frn.get("k_mov",-1,"k_num_orden");			punto = frn.get("k_mov",-1,"k_punto");			for (var i=0; i<renglones; i++) {				if (renglon_id != i){					if ( (frn.get("k_mov",i,"k_tipo_orden") &= tiporden) && (frn.get("k_mov",i,"k_num_orden") &= numorden) &&						(frn.get("k_mov",i,"k_punto") &= punto)) {  						frn.message("Verifique, esta intentado dar de alta el mismo TOT","Error","Aceptar");						return;					}				}				}			}		fun BuscarFolio() {			var folio;			folio = frn.get("k_folio");			resVal = 1;			ArmarRefDocto();			ValidaFolioCancelado(folio);			if(resVal == 0){				return;			}			else{				MostrarDatos(folio);			}					}		fun Cancela() {			CambiaSucursal();			Inicializa();			ConfiguraControlesOpcion();		}					fun ModoBuscar() {			LimpiaEncabezado();			ConfiguraControlesOpcion();		}				fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			var resultado, mensaje, folio;							fecha = sys.date();			hora= sys.time();							if (tip_ope &= "A") {							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;				ValidarDatos();				if(ok &! "1" || resVal == 0){					return;				}				continua = frn.message("¿Desea continuar con la alta?","Atención",2);				if (continua == 0){					return;				}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;											setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);									frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudTOTs");				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cuboQuery);				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvtalltotscrud.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudTOTs");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					tip_ope = "C";					frn.set("k_folio", mensaje); 					frn.set("operacion", "CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto", strTmp);					strMsg = "El Folio utilizado para esta operación fue : " & mensaje;					ConfiguraControlesOpcion(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");					MostrarDatos(folio);						BuscarFolio();				} else {					frn.message(mensaje, "Error", "Aceptar");					return;				}			} else {				if (tip_ope &= "B") {					resVal = 1;					ValidaBajaTot();					if(resVal == 0){					return;					}						continua = frn.message("¿Desea continuar con la baja?","Atención",2);					if (continua == 0){						return;					}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;													setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);											frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudTOTs");					cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					rstXml(cuboQuery);											cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvtalltotscrud.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudTOTs");											resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok) {						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}					if(resultado &= "1") {						tip_ope = "C";						frn.set("operacion", "CONSULTA");						ConfiguraControlesOpcion();						strMsg = "El TOTs se ha dado de baja";						frn.message(strMsg, "Mensaje", "Aceptar");					} else {						frn.message(mensaje, "Error", "Aceptar");						return;					}				} else {					folio = frn.get("k_folio");					MostrarDatos(folio);				}	/*End Consulta*/ 			}						} // FIN ... Ejecuta()								fun Inicializa(){ //Inicializa los valores en Pantalla			// Revisa parametros recibidos			if( frn.nParam() == 6 ){ //Se han mandado parámetros a la página                gen_doc=trim(frn.param(0));                 nat_doc=trim(frn.param(1));                 gpo_doc=trim(frn.param(2));                tip_doc=trim(frn.param(3));                 tip_ope=trim(frn.param(4));                uen=trim(frn.param(5));				if (uen &= ""){					uen="XXX";				}			} else {				frn.message("Operación no válida ...", "Mensaje","&Aceptar");				frn.open("redirect",2);				return;			}            			if(tip_ope &= "A"){ //Alta				frn.set("operacion","ALTA");			} else {				if(tip_ope &= "B"){ //Baja					frn.set("operacion","BAJA");				} else {					if(tip_ope &= "C"){ //Consulta						frn.set("operacion","CONSULTA");					} else {						frn.message("Operación no válida ...", "Mensaje","&Aceptar");						frn.open("index",4);						return;								}				}			}										//Llenar combo sucursales			var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmd = cmd & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmd = cmd & " where c1='" & suc_usuario & "'";				}			}							var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");					ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}								frn.set("k_sucn",getXml(cubo));							sucursal_id=frn.get("k_sucn",-1,1);									// Fill Combo Tipo (Con Query FTO Kepler) 			LlenaCmbTipo();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());								// Fill k_docto | referencia docto			ArmarRefDocto();			LimpiaDatosProv();			IniParams();		}				fun LlenaCmbTipo(){			sucursal_id=frn.get("k_sucn",-1,1);									cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 						from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'";			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.Inicializa()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error BD","Aceptar");				return;			}			frn.set("k_tipon",getXml(cuboQuery));		}					fun CalculaPrecio(){			var precio_punto= 0, margen = 0, iva = 0, margenUtil = 0, totalcte = 0;			var msgTxt;			tiporden = frn.get("k_mov",-1,"k_tipo_orden");			porc_iva = frn.get("k_tipon",-1,6);			numorden = frn.get("k_mov",-1,"k_num_orden"); 			punto = frn.get("k_mov",-1,"k_punto"); 			if (tiporden &= "" ){				frn.set("k_mov",-1,"k_costo","");				frn.setPos("k_mov",-1,"k_tipo_orden");				frn.message("Debe seleccionar tipo de órden","Error","Aceptar");				return;			}				cmdQuery = "select c6 from keplersc.kdmargen " &						"where c1 = '" & tiporden & "'";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.CalculaPrecio()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboMargen");					ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			margen = getXmlAtt(cuboQuery,"r0" ,"c6");							//Calcula precio del punto			precio_punto= frn.get("k_mov",-1,"k_costo")*(1+margen/100);			frn.setX(precio_punto,"k_mov",-1,"k_precio");						CalculaTotales();			if (frn.get("k_mov",-1,"k_descriptot") &= ""){				frn.setPos("k_mov",-1,"k_descriptot");				frn.message("La descripción del TOT no puede ir en blanco","Error","Aceptar");				return;				}		}		fun ValidaMargenUtilidad(){			var margenUtil = 0, margen = 0;			var descripTxt;			for (var i=0,renglones = frn.N("k_mov"); i<renglones; i++) {				tiporden = frn.get("k_mov",i,"k_tipo_orden");				margenUtil = (frn.get("k_mov",i,"k_precio")-frn.get("k_mov",i,"k_costo"))/frn.get("k_mov",i,"k_costo")*100;				cmdQuery = "select c6 from keplersc.kdmargen " &						"where c1 = '" & tiporden & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.CalculaPrecio()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboMargen");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				margen = getXmlAtt(cuboQuery,"r0" ,"c6");				//Calcula margen de utilidad				margenUtil = (frn.get("k_mov",i,"k_precio")-frn.get("k_mov",i,"k_costo"))/frn.get("k_mov",i,"k_costo")*100;				descripTxt = frn.get("k_mov",i,"k_descriptot");				if (margen>math("round",margenUtil,2)){										frn.setPos("k_mov",-1,"k_tipo_orden");					frn.message("El TOT o Refaccion: " & frn.get("k_mov",-1,"k_descriptot") & " No tiene el margen de utilidad minimo cargado","Error","Aceptar");									if (margenUtil <= 0){						resVal=0;						frn.message("El TOT o Refaccion: " & frn.get("k_mov",-1,"k_descriptot") & " El margen de utilidad no puede ser 0 o negativo","Error","Aceptar");						return;												//TO DO: PANTALLA DE PASSWORD DE AUTORIZACION Y resVal=1					}					}				return resVal;				}		}					// Armado del Docto Referencia		fun ArmarRefDocto {			var cadena,tmpFolio, tmpGrupo, tmpTipo;			tmpFolio = frn.get("k_folio");			tmpFolio = PadLeft(tmpFolio,"7","0");			tmpGrupo = PadLeft(gpo_doc,"2","0");			tmpTipo = PadLeft(tip_doc,"3","0");			cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;			frn.set("k_docto", cadena);		}					fun PadLeft(pText,pRelleno,pCaracterRelleno) {			var Resultado;			var pos_ini = pText;			var nReg = strlen(pText);			for (var cont = nReg; cont < pRelleno; cont++) {				Resultado = pCaracterRelleno & Resultado;			}			Resultado = Resultado & pText;                			return Resultado;		}		fun ConfiguraControlesOff() {							frn.setAtt("textFolio", "visible", "N");			frn.setAtt("k_folio", "available", "N");			frn.setAtt("k_folio", "visible", "N");							frn.setAtt("k_fecha", "available", "N");			frn.setAtt("k_hora", "available", "N");			frn.setAtt("k_clave", "available", "N");			frn.setAtt("k_refer", "available", "N");							frn.setAtt("Imprimir", "visible", "N");			frn.setAtt("Cancelar", "visible", "N");			frn.setAtt("Aceptar", "visible", "N");			frn.setAtt("BuscarFol", "visible", "N");			frn.setAtt("Buscar", "available", "N");							}					fun ConfiguraControlesOpcion() {						ConfiguraControlesOff();			if(tip_ope &= "A"){ //Alta				//frn.setAtt("k_fecha", "available", "Y");				//frn.setAtt("k_hora", "available", "Y");				frn.setAtt("k_clave", "available", "Y");				frn.setAtt("k_refer", "available", "N");				frn.setAtt("k_mov", "modify", "Y", "k_tipo_orden");				frn.setAtt("k_mov", "available", "Y", "k_tipo_orden");				frn.setAtt("k_mov", "modify", "Y", "k_descriptot");				frn.setAtt("k_mov", "modify", "Y", "k_costo");				frn.setAtt("k_mov", "available", "Y", "k_num_orden");				frn.setAtt("k_mov", "available", "Y", "k_punto");				frn.setAtt("k_mov", "available", "Y", "k_descriptot");				frn.setAtt("k_mov", "available", "Y", "k_costo");				frn.setAtt("k_mov", "available", "Y", "k_precio");				frn.setAtt("k_coment","modify", "Y");				frn.setAtt("k_coment","available", "Y");				frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "Y");									frn.setAtt("BuscarFol", "visible", "N");				frn.setAtt("Buscar", "available", "Y");				} else {				if(tip_ope &= "B"){ //Baja									frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");					//frn.setAtt("k_fecha", "available", "Y");					//frn.setAtt("k_hora", "available", "Y");					frn.setAtt("k_mov", "modify", "N", "k_descriptot");					frn.setAtt("k_mov", "modify", "N", "k_costo");					frn.setAtt("k_mov", "available", "N", "k_tipo_orden");					frn.setAtt("k_mov", "available", "N", "k_num_orden");					frn.setAtt("k_mov", "available", "N", "k_punto");					frn.setAtt("k_mov", "available", "N", "k_descriptot");					frn.setAtt("k_mov", "available", "N", "k_costo");					frn.setAtt("k_mov", "available", "N", "k_precio");					frn.setAtt("k_coment","modify", "N");					frn.setAtt("k_coment","available", "Y");															frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "N");					frn.setAtt("Aceptar", "visible", "Y");												frn.setAtt("BuscarFol", "visible", "Y");					frn.setAtt("Buscar", "available", "N");				} else {					if(tip_ope &= "C"){ //Consulta						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("k_fecha", "available", "N");						frn.setAtt("k_hora", "available", "N");											frn.setAtt("k_mov", "available", "N", "k_tipo_orden");						frn.setAtt("k_mov", "available", "N", "k_num_orden");						frn.setAtt("k_mov", "available", "N", "k_punto");						frn.setAtt("k_mov", "available", "N", "k_descriptot");						frn.setAtt("k_mov", "available", "N", "k_costo");						frn.setAtt("k_mov", "available", "N", "k_precio");						frn.setAtt("k_coment","modify", "N");						frn.setAtt("k_coment","available", "Y");						frn.setAtt("Imprimir", "visible", "Y");						frn.setAtt("Cancelar", "visible", "N");						frn.setAtt("Aceptar", "visible", "N");						frn.setAtt("BuscarFol", "visible", "Y");						frn.setAtt("Buscar", "available", "N");					} else {						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");						//frn.setAtt("k_fecha", "available", "Y");						//frn.setAtt("k_hora", "available", "Y");													frn.setAtt("k_mov", "modify", "Y", "k_descriptot");						frn.setAtt("k_mov", "modify", "Y", "k_costo");					}					}			}		}					fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    			1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 			2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 			3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			// var tip_ope; 			var tip_oper;			if(iModo==0)				page=pag; 			else if(iModo==2&&(strlen(par0)>0)){				//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       				if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 				if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;			}			else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     		}								fun LimpiaDatosProv() {			frn.set("k_rfc", "");			frn.set("k_nombreprov", "");			frn.set("k_calleprov", "");			frn.set("k_coloniaprov", "");			frn.set("k_poblacionprov", "");			frn.set("k_cpprov", "");			LimpiaDatosDoc();			LimpiaTotalesDoc();					frn.set("k_refer", "");			frn.set("k_fecha_exp", "");		}					fun LimpiaDatosDoc() {			frn.set("k_mov", "");			frn.set("k_plazo", "");			frn.set("k_vence", "");			frn.set("k_cond", "");			frn.set("k_coment", "");		}					fun LimpiaTotalesDoc() {			frn.set("k_subtotal", "");			frn.set("k_iva", "");			frn.set("k_monto", "");		}					fun LimpiaEncabezado() {			frn.set("k_folio", "");			frn.set("k_docto", "");			frn.set("k_fecha", "");			frn.set("k_hora", "");			LimpiaDatosProv();			frn.set("k_clave", "");		}				fun LimpiaTipOrden(){			frn.setX("","k_mov",-1,"k_desc_tipo");				frn.setX("","k_mov",-1,"k_num_orden");				LimpiaNumOrden();		}					fun LimpiaNumOrden(){			frn.setX("","k_mov",-1,"k_punto");			LimpiaPunto();		}		fun LimpiaPunto(){			frn.setX("","k_mov",-1,"k_desc_punto");			frn.setX("","k_mov",-1,"k_descriptot");			frn.setX("","k_mov",-1,"k_costo");			frn.setX("","k_mov",-1,"k_precio");		}		fun CambiaSucursal() {			LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());							LlenaCmbTipo();			ArmarRefDocto();						}					fun CambiaTipo() {			LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();						}		fun BuscarProveedor(){			var xmlProd;											sucursal_id = frn.get("k_sucn",-1,1);			proveedor_id = frn.get("k_clave");			LimpiaDatosProv();			LimpiaDatosDoc();			LimpiaTotalesDoc();											if (strlen(frn.get("k_clave")) == 0) {				return;			}							if (strlen(frn.get("k_refer")) > 0) {				refer_id = frn.get("k_refer");			} else {				frn.set("k_fecha_exp", "");			}							cmdQuery = "select c10 as k_rfc, c3 as k_nombreprov, c4 as k_calleprov, c5 as k_coloniaprov, c6 as k_poblacionprov, c27 as k_cpprov, c16 as k_plazo " &									"from keplersc.kdxd where c2='" & proveedor_id & "'" ;			//and c1 ='" & sucursal_id & "' ... TO DO : NO VIENE DATO DE LA SUCURSAL A NIVEL DEL PROVEEDOR AUNQUE ESTA EL CAMPO ...			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.BuscaProveedor()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.setPos("k_clave");				frn.message("El proveedor no existe","Error","Aceptar");				return;				}			Plazo();				rstXml(xmlProd);			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");			frn.setX(xmlProd);									}					fun ObtenerFactura(){			var nCampos, uuid="";			//Regresara la funcion UUID cadena con UUID, rfc, fecha, total			uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID","k_refer", 0,"0");			nCampos = strSplit(uuid,"|",-1);			if (nCampos > 1) {					str_uuid = strSplit(uuid,"|",0);		//UUID					rfc_uuid = strSplit(uuid,"|",1);		//rfc					fecha_uuid = strSplit(uuid,"|",2);		//fecha					total_uuid = strSplit(uuid,"|",3);		//monto de la factura									frn.set("k_refer",str_uuid);			} else{				frn.set("k_refer","");				frn.message("Faltan datos del UUID","Error","Aceptar");					}		}			fun ObtenerTipoOrden() {						proveedor_id = frn.get("k_clave");			sucursal_id = frn.get("k_sucn",-1,1);				LimpiaTipOrden();			CalculaTotales();			cmdQuery = "select C1 as tipo, C3 as descripcion from keplersc.kdmargen";													frn.dialog("genlistasel","Tipos de órden",cmdQuery,"tipo","k_mov",-1,"k_tipo_orden","S");        }		fun BuscarTipoOrden(){			var xmlProd;			tiporden=frn.get("k_mov", -1,"k_tipo_orden");			cmdQuery = "select C3 as descripcion from keplersc.kdmargen " &					"where c1='" & tiporden & "'";									rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcargosvarios.BuscarTipoOrden()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cubo");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if((nXml(cuboQuery) == 0) && (tiporden &! "")) {				frn.setPos("k_mov", -1,"k_tipo_orden");				frn.message("El tipo de orden no existe","Error","Aceptar");				return;			} else{				desc_tipo = getXmlAtt(cuboQuery,"r0","descripcion");				frn.setX(desc_tipo,"k_mov", -1,"k_desc_tipo");					}					}		fun ObtenerNumOrden() {			proveedor_id = frn.get("k_clave");			sucursal_id = frn.get("k_sucn",-1,1);			tiporden = frn.get("k_mov",-1,"k_tipo_orden"); 			if (tiporden &= ""){				frn.message("Debe seleccionar tipo de órden","Error","Aceptar");				return;			}				LimpiaNumOrden();			CalculaTotales();			cmdQuery = "select C3 as orden, C4 as fecha, C6 as serie,C11 as cliente " &						"from keplersc.kdord " & 						"where c1 = '" & sucursal_id & "' and c2= '" & tiporden & "' and c7=0";			frn.dialog("genlistasel","Ordenes",cmdQuery,"orden","k_mov",-1,"k_num_orden","S");					}         		fun ObtenerPunto() {			proveedor_id = frn.get("k_clave");			sucursal_id = frn.get("k_sucn",-1,1);			tiporden = frn.get("k_mov",-1,"k_tipo_orden"); 			numorden = frn.get("k_mov",-1,"k_num_orden"); 			if (tiporden &= ""){				frn.setPos("k_mov",-1,"k_tipo_orden");				frn.message("Debe seleccionar tipo de órden","Error","Aceptar");				return;			}			if (numorden &= ""){				frn.setPos("k_mov",-1,"k_num_orden");				frn.message("Debe seleccionar número de órden","Error","Aceptar");				return;			}				LimpiaPunto();			CalculaTotales();			cmdQuery = "select c4 as punto, c9 as operario, c8 Descripcion " & 						"from keplersc.kdpun " &						"where c1= '" & sucursal_id & "' and c2= '" & tiporden & "' and c3 = '" & numorden & "'";			frn.dialog("genlistasel","Puntos de órden",cmdQuery,"punto","k_mov",-1,"k_punto","S");						}		fun ObtenerFolio() {			sucursal_id = frn.get("k_sucn",-1,1);			LimpiaEncabezado();			cmdQuery = "select c6 as folio,  to_char(c9, 'dd/mm/yyyy') as fecha , c10 as cve_cliente, " &						"c11 as factura, c16 as monto " &						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc" &						" order by c9 desc";							frn.dialog("genlistasel","Folios de TOTs",cmdQuery,"folio","k_folio","0","","S");					}		fun ValidaFolioCancelado(folio){		var statusfolio;			cmdQuery = "select c43 as status_folio " & 						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc & " and c6= '" & folio & "'";						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidaFolioCancelado()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ValidaFolioCancelado");			ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			statusfolio = getXmlAtt(cuboQuery,"r0","status_folio");			if (statusfolio &= "C"){	// C=Cerrado				resVal=0;				frn.message("El TOTs se encuentra cancelado","Error","Aceptar");				return;			}		}		fun CambiaFolio() {			frn.set("k_docto", "");			frn.set("k_fecha", "");			frn.set("k_hora", "");			LimpiaDatosProv();			frn.set("k_clave", "");		}				fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				CambiaFolio();								setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvtalltotscrud.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);			}		fun ValidaPuntoOrden(){			var tipopunto, status, cerradotots, desc_punto, punto_existe, totReg; 			punto = frn.get("k_mov",-1,"k_punto"); 			cmdQuery = "select c6 as tipunto, c7 as statuspunto, c8 as descpunto, c23 as statustots " & 						"from keplersc.kdpun " &						"where c1= '" & sucursal_id & "' and c2= '" & tiporden & "' and c3 = '" & numorden & 						"' and c4 = " & punto;						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidaPuntoOrden()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\validapuntoorden");			ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			desc_punto	= getXmlAtt(cuboQuery,"r0","descpunto");			frn.setX(desc_punto,"k_mov",-1,"k_desc_punto");			tipopunto = getXmlAtt(cuboQuery,"r0","tipunto");			status = getXmlAtt(cuboQuery,"r0","statuspunto");			cerradotots = getXmlAtt(cuboQuery,"r0","statustots");						//Validar que el TOT no este dado de alta con KDTOT			ValidaExisteTot();						//Validar que no ingresen el mismo punto			ValidaPuntoDuplicado();			if (cerradotots &= "C"){	// C=Cerrado				frn.setX("","k_mov",-1,"k_punto");				LimpiaPunto(); 				frn.message("No se pueden cargar horas a un punto que esta cerrado por TOTs","Error","Aceptar");				return;			}			if (tipopunto &= "N"){ //N=No autorizados				frn.setX("","k_mov",-1,"k_punto");				LimpiaPunto();				frn.message("No puede cargar TOTs a puntos No Autorizados","Error","Aceptar");				return;			} else { 				if(tipopunto &= "P"){	//P=Por presupuestar					frn.setX("","k_mov",-1,"k_punto");					LimpiaPunto();					frn.message("No puede cargar TOTs a puntos Por Presupuestar","Error","Aceptar");					return;				} else { 					if(tipopunto &= "L"){	//L=Sin cargo al cliente						frn.setX("","k_mov",-1,"k_punto");						LimpiaPunto();						frn.message("No puede cargar TOTs a puntos Sin Cargo al Cliente","Error","Aceptar");						return;					} else{						if(tipopunto &= "S"){	//S=Paquetes de serivicios							frn.setX("","k_mov",-1,"k_punto");							LimpiaPunto();							frn.message("No puede cargar TOTs a Paquetes de Servicios","Error","Aceptar");							return;						}						}				}					}			if(status &= "P"){	//P=Pendiente				frn.setX("","k_mov",-1,"k_punto");				LimpiaPunto();				frn.message("No puede cargar TOTs a puntos pendientes","Error","Aceptar");				return;			} else{				if(status &= "S"){	//S=Suspendido					frn.setX("","k_mov",-1,"k_punto");					LimpiaPunto();					frn.message("No puede cargar TOTs a puntos suspendidos","Error","Aceptar");					return;				}			}						}		fun ValidaExisteTot(){			var punto_existe;			cmdQuery = "select count(*) as totexiste " & 						"from keplersc.kdtot " &						"where c1= '" & sucursal_id & "' and c2= '" & tiporden & "' and c3 = '" & numorden & 						"' and c4 = " & punto & " and c5= '" & gen_doc & "' and c6= '" & nat_doc & "' and c7= " & gpo_doc & " and c8= " & tip_doc; 							rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidaPuntoOrden()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\validapuntoexiste");			ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			punto_existe = getXmlAtt(cuboQuery,"r0","totexiste");			if (punto_existe > 0){				frn.setX("","k_mov",-1,"k_tipo_orden");				LimpiaTipOrden();				frn.message("No puede dar de alta un TOT que ya esta registrado||Tipo orden: "&tiporden&" Orden: "&numorden&" Punto :"&punto,"Error","Aceptar");				return;			}		}				fun ValidaDescripcion(){			punto = frn.get("k_mov",-1,"k_punto"); 			if (punto &= ""){				frn.setPos("k_mov",-1,"k_punto");				frn.message("Debe seleccionar un punto","Error","Aceptar");				return;			}							if (frn.get("k_mov",-1,"k_descriptot") &= ""){				frn.setPos("k_mov",-1,"k_descriptot");				frn.message("La descripción del TOT no puede ir en blanco","Error","Aceptar");				return;				}			}         		fun ValidaBajaTot(){			var cerradotots, renglones; 			renglones = frn.N("k_mov")-1;						for (var i=0; i<renglones; i++) {				tiporden = frn.get("k_mov",i,"k_tipo_orden");				numorden = frn.get("k_mov",i,"k_num_orden");				punto = frn.get("k_mov",i,"k_punto"); 				cmdQuery = "select c23 as statustots " & 						"from keplersc.kdpun " &						"where c1= '" & sucursal_id & "' and c2= '" & tiporden & "' and c3 = '" & numorden & 						"' and c4 = '" & punto & "'";							rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidaPuntoOrden()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\validapuntoorden");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				cerradotots = getXmlAtt(cuboQuery,"r0","statustots");				if (cerradotots &= "C"){	// C=Cerrado					resVal=0;					frn.message("Imposible borrar un TOT de un Punto que ya esta cerrado, Orden: "&tiporden& " " &numorden& " Punto: " &punto,"Error","Aceptar");					return;				}			}		} 		fun MostrarDatos(nFolio) {			var folio, refer, xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle;			var tmpStr, tmpXml, contDet, xmlCurDet, xmlDetConv;			// Guarda Datos para Busqueda 			frn.set("k_fecha_exp", "");			sucursal_id = frn.get("k_sucn",-1,1);							refer = frn.get("k_refer");			proveedor_id = frn.get("k_clave");			folio = nFolio;											setXml(xmlRequest,"document","sucursal_id",sucursal_id);			setXml(xmlRequest,"document","proveedor_id",proveedor_id);			setXml(xmlRequest,"document","referencia",refer);			setXml(xmlRequest,"document","genero",gen_doc);			setXml(xmlRequest,"document","naturaleza",nat_doc);			setXml(xmlRequest,"document","grupo",gpo_doc);			setXml(xmlRequest,"document","tipo",tip_doc);			setXml(xmlRequest,"document","folio",folio);				cmdQuery = "select * from keplersc.ser_tots_alta_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";			frn.lib("libGeneral.kpl","FileSave",xmlRequest, fileSavePath & "\srvtalltotscrud_xmlRequestFromK80TOPostgreSql_buscar");							rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\srvtalltotscrud_xml_GottenOfPostgreSql_buscar");							ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}								//Datos de encabezado			tmpStr=getXmlAtt(cuboQuery,"r0","encabezado");			rstXml(xmlEncabezado);			tmpStr=delScpScn(tmpStr);			setXmlStr(xmlEncabezado,tmpStr);			tmpXml = getXml(xmlEncabezado,"row");			frn.lib("libGeneral.kpl","FileSave",tmpXml , fileSavePath & "\srvtalltotscrud_xml_Converted_Enc_buscar");							frn.setX(tmpXml);			if(nXml(tmpXml) == 0){				frn.message("El TOTs : " & folio & ", No se encontró ...","Error","Aceptar");				return;							}										//Datos Detalle			rstXml(xmlDetConv);			tmpStr=getXmlAtt(cuboQuery,"r0","detpartidas");			rstXml(xmlDetalle);			tmpStr=delScpScn(tmpStr);			setXmlStr(xmlDetalle,tmpStr);			contDet=nXml(xmlDetalle);			for(var y=0; y< contDet; y++){				rstXml(xmlCurDet);				xmlCurDet= getXmlX(xmlDetalle,3,y);										setXml(xmlDetConv,"k_mov","r"&y,xmlCurDet);			}				frn.setX(xmlDetConv);			if (tip_ope &= "B") {				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());				}			frn.lib("libGeneral.kpl","FileSave",xmlDetConv, fileSavePath & "\srvtalltotscrud_xml_Converted_Det_buscar");										return;									} //End MostrarDatos()		fun CalculaTotales() {			var subTotal = 0, iva = 0, total = 0, costo = 0, renglones;			costo = frn.get("k_mov",-1,"k_costo");						//Calcular totales			renglones = frn.N("k_mov");			for (var i=0; i<renglones; i++) {				subTotal = subTotal + frn.get("k_mov",i,"k_costo");			}			iva = subTotal * (porc_iva)/100;			total = subTotal + iva;							frn.set("k_subtotal",subTotal);			frn.set("k_iva",iva);			frn.set("k_porciva",porc_iva);			frn.set("k_monto",total);						}					fun Plazo(){ //Calcula la fecha de pago, y las condiciones de pago en base al plazo			frn.set("k_vence",fnDate("addC",frn.get("k_fecha"),frn.get("k_plazo")));//Suma días comerciales			var cond=frn.get("k_plazo") & " días fecha factura";			if (frn.get("k_plazo")==0) cond="Pago de contado";				frn.set("k_cond",cond);  			}		fun IniParams(){//Inicializa parÃ¡metros de impresiÃ³n, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar PÃ¡gina				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1","param_borderT","1.5","param_borderR","1","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}						fun setRepPage() {//Establece los parï¿½metros finales de impresiï¿½n.			var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";			var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";			var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");			var lndsp="landscape=" & frn.get("param_landscape");			var emp="@emp=" & frn.get("param_emp");			rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);		}			fun EjecReporte(){//Imprime el reporte del documento especificado 				if(strlen(trim(frn.get("k_folio")))==0){ 					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");					frn.setPos("k_folio");return;					}				Reporte();				frn.setPos("k_folio");			}							fun Reporte(){				var compania,contProd, contDet, tmpStr;				var xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle;				var tmpXml, contDet, xmlCurDet, xmlDetConv, datdoc;				var desc_sucursal, fecha, total, importe, folio, docto;				var cmd, cuboResultados , ok;								sucursal_id = frn.get("k_sucn",-1,1);				desc_sucursal = frn.get("k_sucn",-1,0);				proveedor_id = frn.get("k_clave");				refer_id = frn.get("k_refer");				folio = frn.get("k_folio");				docto = frn.get("k_docto");				//Armar xml con los parametros				setXml(xmlRequest,"document","sucursal_id",sucursal_id);				setXml(xmlRequest,"document","proveedor_id",proveedor_id);				setXml(xmlRequest,"document","referencia",refer_id);				setXml(xmlRequest,"document","genero",gen_doc);				setXml(xmlRequest,"document","naturaleza",nat_doc);				setXml(xmlRequest,"document","grupo",gpo_doc);				setXml(xmlRequest,"document","tipo",tip_doc);				setXml(xmlRequest,"document","folio",folio);				cmdQuery="select * from keplersc.ser_tots_cons_rep('"& getXmlStr(xmlRequest,"EOF:13_10") &"')";				rstXml(cuboQuery);    //xml general con todos los datos				cuboQuery= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.Reporte()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									//Procesa xml encabezado				frn.lib("libGeneral.kpl","FileSave",cuboQuery , fileSavePath & "\xmlResQueryReporteCompleto ");					tmpStr=getXmlAtt(cuboQuery,"r0","encabezado");				rstXml(xmlEncabezado);				tmpStr=delScpScn(tmpStr);					rstXml(xmlEncabezado);				setXmlStr(xmlEncabezado,tmpStr);				tmpXml = getXml(xmlEncabezado,"row");				frn.lib("libGeneral.kpl","FileSave",tmpXml , fileSavePath & "\xmlResQueryReporte");																//Obtener datos de encabezado				kdb.kde("KDE");//Configuraci??el servidor				kdb.exec();				compania = kdb.get("KDE","1");   // Se obtiene el nombre de la compania								// Se define el formato a usar y se liga a la variable del reporte "rep"				kdb.readPage("datFto","srvtalltotscrudfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				rep.rst();				setRepPage();//Establece los par?metros finales de impresi?n(rep.page(...);), pues pueden haber cambiado por el usuario 				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				//Da valor a los inputs del reporte(rep.set();), e indica la ejecuci?n de "grupos de renglones de impresi?n" (rep.exe();)				rep.set("fecha",sys.date());				rep.set("hora",sys.time());				rep.set("nombreempresa",compania);				rep.set("desc_sucursal",desc_sucursal);				rep.set("docto",docto);				rep.set("folio",folio);				rep.set("proveedor_id",getXml(tmpXml,"k_clave"));				rep.set("nombre",getXml(tmpXml,"k_nombreprov"));				rep.set("direccion",getXml(tmpXml,"k_calleprov"));				rep.set("colonia",getXml(tmpXml,"k_coloniaprov"));				rep.set("cp",getXml(tmpXml,"k_cpprov"));				rep.set("rfc",getXml(tmpXml,"k_rfc"));				rep.set("referencia",getXml(tmpXml,"k_refer"));				rep.set("monto_total",getXml(tmpXml,"k_monto"));				rep.exe("encabezado");								//Procesa poliza contable				var tablakdc1_alta = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;				var tablakdc2_alta = " keplersc.kdc2" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) & strSplit(frn.get("k_fecha"), "-", 1);				//var tablakdc1_baja = " keplersc.kdc1" & mid(strSplit(fecha_baja, "-", 0), 2,2) ;				//var tablakdc2_baja = " keplersc.kdc2" & mid(strSplit(fecha_baja, "-", 0), 2,2) & strSplit(fecha_baja, "-", 1);				var tipo = ""; var nPolAlta = "" ;				//if (tablakdc2_baja &= tablakdc2_alta ){					tipo = "Misma_tabla";										cmd= " select c1 as num_pol from " & tablakdc2_alta & " where c14='" & sucursal_id  & "' and c15='" & gen_doc & "' and c16= '" & nat_doc & "'" ;					cmd = cmd & " and c17='" & gpo_doc & "' and c18='" & tip_doc & "' and c19='" & frn.get("k_folio")& "'";									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvtalltotscrud.Reporte()");					frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");									ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}									nPolAlta =getXmlAtt(cuboResultados,"r0", "num_pol" );								//}				imprime_poliza(tablakdc1_alta , tablakdc2_alta, "Alta", tipo, nPolAlta);								rep.set("desc_notas",getXml(tmpXml,"k_coment"));					rep.exe("notastitulos");								//Procesar xml detalle				rstXml(xmlDetConv);				tmpStr=getXmlAtt(cuboQuery,"r0","detpartidas");				frn.lib("libGeneral.kpl","FileSave",tmpStr , fileSavePath & "\xmlResQueryRepDetalle");					rstXml(xmlDetalle);				tmpStr=delScpScn(tmpStr);				setXmlStr(xmlDetalle,tmpStr);				contDet=nXml(xmlDetalle);				total = 0;				for(var y=0; y< contDet; y++){					rstXml(xmlCurDet);					xmlCurDet= getXmlX(xmlDetalle,3,y);						frn.lib("libGeneral.kpl","FileSave",xmlCurDet , fileSavePath & "\xmlResQueryRepCurDetalle");											rep.set("tipo_orden",getXml(xmlCurDet,"k_tipo_orden"));					rep.set("num_orden",getXml(xmlCurDet,"k_num_orden"));					rep.set("punto",getXml(xmlCurDet,"k_punto"));					rep.set("desc_tot",getXml(xmlCurDet,"k_descriptot"));					rep.set("costo",getXml(xmlCurDet,"k_costo"));					rep.set("precio",getXml(xmlCurDet,"k_precio"));					rep.set("min",getXml(xmlCurDet,"k_margtots"));					rep.set("carg",getXml(xmlCurDet,"k_marg_calc"));					rep.set("cliente",getXml(xmlCurDet,"k_cliente"));					rep.exe("detalle");				}										rep.set("subtotal",getXml(tmpXml,"k_subtotal"));				rep.set("monto_iva",getXml(tmpXml,"k_iva"));				rep.set("monto_total",getXml(tmpXml,"k_monto"));				rep.exe("totalproducto");									rep.win(); //Muestra la vista previa de la impresi?n. A partir de la vista previa (Preprint) se decide si se imprime o no.			}						fun imprime_poliza(tablakdc1 , tablakdc2, operacion, tipo, nPolAlta ){							var cmd, cuboResultados , ok;								//Procesa poliza contable				cmd= " select kc2.c1 as num_pol, kc2.c3 as cuenta, kc2.c4 as tipo_asiento, kc2.c5 as monto, kc1.c2 as desc_pol, kc2.c7 as refer, kc2.c8 as tipo_pol from " & tablakdc2 & " as kc2 " ;				cmd = cmd & " inner join " & tablakdc1 & " as kc1 on kc1.c1=kc2.c3 ";				cmd = cmd & " where kc2.c14='" & frn.get("k_sucn", -1, 1) & "' and kc2.c15='" & gen_doc & "' and kc2.c16= '" & nat_doc & "' and kc2.c17='" & gpo_doc & "' and kc2.c18='" & tip_doc & "' and kc2.c19='" & frn.get("k_folio")& "'";				if (operacion &= "Alta" && tipo &= "Misma_tabla"){					cmd = cmd & " and kc2.c1 = " & nPolAlta ; 				}				if (operacion &= "Baja" && tipo &= "Misma_tabla"){					cmd = cmd & " and kc2.c1 <> " & nPolAlta ; 				}												//Added by JMM 20240314				cmd = cmd & " order by kc2.c1, kc2.c10 "; 				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.imprime_poliza()");				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var nRenPol= nXml(cuboResultados);				var tPoliza=getXmlAtt(cuboResultados,"r0", "tipo_pol" );				var nPoliza=getXmlAtt(cuboResultados,"r0", "num_pol" );								if (strlen(tPoliza)>0 && strlen(nPoliza)>0 ){						rep.set("tPol",tPoliza);						rep.set("nPol",nPoliza);						rep.exe("encabezadoPol");						var tAbonosPol=0, tCargosPol=0;						for(var i=0;i<nRenPol;i++){							if (getXmlAtt(cuboResultados,"r"&i, "tipo_asiento" )&= "A"){								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave2",cuenta );								rep.set("PolDescr2",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolHaber",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tAbonosPol=tAbonosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								//pol_saldo_presupuesto(cuenta);								//rep.set("PolSaldo2",saldo);								//rep.set("PolPresupuesto2",presupuesto );								rep.exe("partPolA");							}else{								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave",cuenta );								rep.set("PolDescr",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolDebe",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tCargosPol=tCargosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								//pol_saldo_presupuesto(cuenta);								//rep.set("PolSaldo",saldo );								//rep.set("PolPresupuesto",presupuesto );								rep.exe("partPolC");							}						}						rep.set("totCargo",tCargosPol);						rep.set("totAbono",tAbonosPol);						rep.exe("PolTotales");				}			}		} // End of class Main	</script></pag>