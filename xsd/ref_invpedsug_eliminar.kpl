<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<tab/><txt fnt=",22" clr="0,0,0">Eliminar Pedido Sugerido</txt><br/>	<!-- dim="81,0" --> 	<tab/><hLine clr="0,0,0"/> 	<br/> <br/>		<!-- <grp dim="46,9,7,12" -->		<tab/>		<grp dim="50,23,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">			<br/>			<sp n="2"/> <txt>Sucursal : </txt>			<sp n="1"/> <cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>			<br/><br/>			<sp n="2"/> <txt clr="0,58,112">Referencia Sugerido : </txt> 			<sp n="1"/> <edt id="k_refer" clr="64,64,64" clrBrdr="255,255,255"  dim="30,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="10" available = "Y" modify="Y" 						OnF9="ObtenerRef()" OnChange="BuscarRef()" OnButton="ObtenerRef()"/>					<br/><br/>			<sp n="2"/>	<txt>Fecha : </txt>			<sp n="3"/> <edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N"/> 			<br/><br/>			<sp n="2"/>	<txt>Estatus : </txt>			<sp n="1"/> <inp id="k_st" dim="3,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="L" available="N"/>			<sp n="1"/> <inp id="k_status" dim="30,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="L" available="N"/>			<br/><br/><br/>			<sp n="60"/>			<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			<br/>		</grp>		<br/>		<br/>			</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable, asterisco ;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal;			var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd,uen;                  // Vart Reports			var cmd, xmlResQuery, strTmp;			var sucursal, fech_oper, tipo_auto, xmlPar;			var fech_original;										fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				rol_usuario = frn.config("user","role");				asterisco = "*";				//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";				fileSavePath = "C:\Basura";				Inicializa();								ConfiguraControlesOpcion();			}			//Validacion Datos Generales y Partidas antes de Guardar.			//El resultado de cada validacion se guarda en la variable global resVal.			fun ValidarDatos(iModo) {				var totReg, dato_num, dato_txt;								//Obtener variables				sucursal_id = frn.get("k_sucn",-1,1);				refer_id = frn.get("k_refer");											//Validar Referencia				cmdQuery = "select count(*) as totreg from keplersc.kdpedref " & 					 "where c1 = '" & sucursal_id &  "' and c2 = '" & refer_id &  "'"; /* and c4 = 10*/											rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refinvpedsug_eliminar.ValidarDatos()");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error DB","Aceptar"); //TO DO Homologar mensaje en todo el proyecto, agregar DB					return;				}				totReg = getXmlAtt(cuboQuery,"r0","totreg");				if(totReg==0){					frn.message("El Pedido Sugerido No Existe ...","Error","Aceptar"); /*o No esta Disponible [Editable] para Eliminarse*/					resVal=0;					return;				}					else	{							// /*					dato_num = frn.get("k_st");					if ( strlen(dato_num) > 0 ) {						if (dato_num < 0) {							frn.message("Referencia del Pedido Sugerido No Existe ...","Error","Aceptar");							resVal=0;							return;						}						if (dato_num == 0) {							frn.message("El Pedido Sugerido ya ha sido eliminado previamente ...","Error","Aceptar");							resVal=0;							return;						}						if (dato_num == 20) {							frn.message("El Pedido Sugerido ya fue Solicitado, No se puede realizar esta operacion ...","Error","Aceptar");							resVal=0;							return;						}							if (dato_num != 10) {							frn.message("El Estatus del Pedido No es Valido, No se puede realizar esta opcion ...","Error","Aceptar");							resVal=0;							return;						}						} else {						frn.message("El Estatus del Pedido No es Valido, No se puede realizar esta opcion ...","Error","Aceptar"); /*o No esta Disponible [Editable] para Eliminarse*/						resVal=0;						return;					}					// */								}							} // End ValidarDatos()							fun Cancela() {				CambiaSucursal();				Inicializa();				ConfiguraControlesOpcion();			}									fun ModoBuscar() {				tip_ope = "C";				frn.set("operacion", "CONSULTA");				LimpiaDatosDoc();				ConfiguraControlesOpcion();			}								fun Ejecuta() {				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg;				var resultado, mensaje, folio;								fecha = sys.date();				hora = sys.time();								if (tip_ope &= "A") { 								//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok					resVal = 1;					ValidarDatos();					if(ok &! "1" || resVal == 0){						return;					}					//Para Homologar los TAGs que envía el Grid (KMov) al XML que generará la Pantalla					//DetallaGRD();										// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;												setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",						frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 						frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					//setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")/*-1*//*commented 220726*/);					//setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);					setXml(xmlPantalla,"ambiente","uen",uen);					frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\XmlEliminaPedidoSug");										/*					// For Testing 					frn.message("El pedido sugerido se procesara ...", "Info", "Aceptar");					return;					*/					// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 								cmdQuery="SELECT * FROM keplersc.cat_pedidosugerido_eliminasugerido_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					rstXml(cuboQuery);					cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"refinvpedsug_eliminar.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_EliminaPedidoSug");										// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										//resultado = "1";					//mensaje = "0000009";										resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");																				if(resultado &= "1") {											frn.message(mensaje, "El Pedido Sugerido ha sido Eliminado ...", "Aceptar");											//ModoBuscar(); // 220721 ... added 												//tip_ope = "C"; -- 220721 ... commented & included en ModoBuscar();						frn.set("k_refer", mensaje); 						//frn.set("operacion", "CONSULTA"); -- 220721 ... commented & included en ModoBuscar();						/*						strTmp = frn.get("k_docto");								strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;						frn.set("k_docto", strTmp);						*/						// //ConfiguraCamposOpcion();											//strMsg = "El Folio utilizado para esta operación fue : " & mensaje;						//ConfiguraControlesOpcion(); // TO CHECK ... Esto No se ejecuta si se pone después del Message * * *  						//frn.message(strMsg, "Mensaje", "Aceptar");						//folio = frn.get("k_folio");						//MostrarDOC(folio);							BuscarRef();					} else {						frn.message(mensaje, "Error", "Aceptar");					}				} /*End Alta*/ else {					if (tip_ope &= "B") {						/*Ini Baja*/												frn.message("Opcion No Disponible ...", "Info", "Aceptar");						return;												// IMPORTANTE ... No aplica la operacion para esta opcion  ... 																		folio = frn.get("k_folio");												//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok						resVal = 1;						ValidarDatos(1);						if(ok &! "1" || resVal == 0){							return;						}																xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;						//Agregar usuario, fecha y hora de movimiento						strFecha = fnDate("year",fecha) & "-";						strTmp = fnDate("month",fecha);						if(strlen(strTmp) == 1){							strTmp = "0" & strTmp;						}						strFecha = strFecha & strTmp & "-";						strTmp = fnDate("day",fecha);						if(strlen(strTmp) == 1){							strTmp = "0" & strTmp;						}						strFecha = strFecha & strTmp;													setXml(xmlPantalla,"movimiento","usuario",usuario);						setXml(xmlPantalla,"movimiento","fecha",strFecha);						setXml(xmlPantalla,"movimiento","hora",							frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 							frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));						setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov"));						setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);						setXml(xmlPantalla,"ambiente","uen",uen);											frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\Xml_Pedido_Baja");																		// For Testing ... 						/*						frn.message("La Baja se Procesara ... [ En Desarrollo ]", "Info", "Aceptar");						return;						*/												// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 									cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						//kdb.rst(cuboQuery);						rstXml(cuboQuery);						cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"refaltapedcrud.Ejecuta_Baja");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_BajaPedido");											// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 											//resultado = "1";						//mensaje = folio /*"0000009"*/;											resultado = getXml(cuboQuery,"resultado");						mensaje = getXml(cuboQuery,"mensaje");										// /*																	if(resultado &= "1") {												frn.message(mensaje, "Folio Cancelado ...", "Aceptar");												ModoBuscar(); // 220721 ... added 													//tip_ope = "C"; -- 220721 ... commented & included en ModoBuscar();							//frn.set("k_folio", mensaje); 							frn.set("k_folio", folio);							//frn.set("operacion", "CONSULTA"); -- 220721 ... commented & included en ModoBuscar();							/*							strTmp = frn.get("k_docto");							strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;							frn.set("k_docto", strTmp);							*/							// //ConfiguraCamposOpcion();												//strMsg = "El Folio utilizado para esta operación fue : " & mensaje;							//ConfiguraControlesOpcion(); // TO CHECK ... Esto No se ejecuta si se pone después del Message * * *  							//frn.message(strMsg, "Mensaje", "Aceptar");							//folio = frn.get("k_folio");							//MostrarDOC(folio);								BuscarRef();						} else {							frn.message(mensaje, "Error", "Aceptar");						}						// */												//frn.message("En Construcción, OPC {Baja}", "Info", "Aceptar");					} /*End Baja*/ else {						frn.message("Opcion No Disponible ...", "Info", "Aceptar");						return;												// IMPORTANTE ... No aplica la operacion para esta opcion ... 						/*Ini Consulta*/						folio = frn.get("k_folio");						ModoBuscar(); // 220721 ... added						frn.set("k_folio", folio); // 220721 ... added						//MostrarDOC(folio); // 220722 ... commented 						/*						strTmp = frn.get("k_docto");						strTmp = strSplit(strTmp,"-",0) & "-" & folio;						frn.set("k_docto", strTmp);							*/						BuscarRef();					}	/*End Consulta (for exception)*/ 				}							} // FIN ... Ejecuta()									fun Inicializa(){ //Inicializa los valores en Pantalla				// Our code 				// Revisa y Carga en Variables los Parámetros Recibidos en la corrida				if( frn.nParam() == 1/*6*/ ){ //Se han mandado parámetros a la página					/*					gen_doc = trim(frn.param(0));                nat_doc = trim(frn.param(1));                gpo_doc = trim(frn.param(2));               tip_doc = trim(frn.param(3));                tip_ope = trim(frn.param(4));               */               uen = trim(frn.param(0/*5*/));               tip_ope = "A";               tip_ope_original = tip_ope; /*220726*/					if (uen &! "REF"/*&= ""*/) {						//uen="REF";						frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");						frn.open("redirect",2);						return;					}				} else {					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}				// Testing Code //				/*				gen_doc = "N"; 				nat_doc = "D"; 				gpo_doc = "21";				tip_doc = "1"; 				*/				tip_ope = "A"; // "C" 				uen = "REF";               				if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					/*if(tip_ope &= "B"){ //Baja						frn.set("operacion","BAJA");					} else {						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} else {*/					      frn.message("Operación no válida ...", "Mensaje","&Aceptar");							//frn.open("anuncios",4);							frn.open("index",4);							return;									/*}					}*/				}  									//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));																								} // End Fun Inicializa												fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         }			fun ConfiguraControlesOff() {									frn.setAtt("k_refer", "available", "N");						frn.setAtt("k_fecha", "available", "N");				frn.setAtt("k_st", "available", "N");				frn.setAtt("k_status", "available", "N");											frn.setAtt("Aceptar", "visible", "N");											}						fun ConfiguraControlesOpcion() {							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta					frn.setAtt("k_refer", "available", "Y");					frn.setAtt("Aceptar", "visible", "Y");													} else {					if(tip_ope &= "B"){ //Baja										frn.setAtt("k_refer", "available", "N");						frn.setAtt("Aceptar", "visible", "N");								} else {						frn.setAtt("k_refer", "available", "N");						frn.setAtt("Aceptar", "visible", "N");					}				}			}						fun LimpiaDatosDoc {				frn.set("k_refer", "");				frn.set("k_fecha", "");				frn.set("k_st", "");				frn.set("k_status", "");			}						/*			fun LimpiaTotalesDoc {				//frn.set("k_subtotal", "");				//frn.set("k_iva", "");				frn.set("k_monto", "");			}			*/						/*			fun LimpiaEncabezado {				frn.set("k_folio", "");				frn.set("k_docto", "");				frn.set("k_fecha", "");				frn.set("k_hora", "");				frn.set("c_st", "");			}			*/						fun CambiaSucursal {				LimpiaDatosDoc();				if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} /*else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						}					}*/								}			}						fun ObtenerRef() {							var win_tit, field_key, field_col, cmdQuery;				            proveedor_id = frn.get("k_clave");            sucursal_id = frn.get("k_sucn",-1,1);	                        win_tit = "Pedidos Sugeridos";				field_key = "referencia";				field_col = "k_refer";            cmdQuery = "select c2 as referencia, c3 as fecha from keplersc.kdpedref " &                 "where c1 = '" & sucursal_id &  "' and c4 = 10";            cmdQuery = cmdQuery & " order by c2 desc ";                        	         frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");                     }                                   fun BuscarRef() {				var folio;				folio = frn.get("k_refer");				//frn.lib("libGeneral.kpl","PadLeft", folio, 7, "0");				folio = PadLeft(folio, 10, "0");				frn.set("k_refer", folio);				MostrarRef();			}                           fun MostrarRef() {					var refer;				var n_st;																	sucursal_id = frn.get("k_sucn",-1,1);				refer = frn.get("k_refer");												//Reset campos				LimpiaDatosDoc();								frn.set("k_refer", refer);												cmdQuery = "" &					"select * from keplersc.kdpedref " &					"where c1 = '" & sucursal_id & "'" & " and c2 = '" & refer & "'";									rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refinpedsug_eliminar.mostrarref()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrar_ref_pedsug_eliminar");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.message("El Pedido No Existe ...","Info","Aceptar");					frn.set("k_status", "No Existe");					frn.setPos("k_refer");					return;					}					//frn.set(cuboQuery);						frn.set("k_fecha", getXmlAtt(cuboQuery,"r0", "c3"));				frn.set("k_st", getXmlAtt(cuboQuery,"r0", "c4"));								n_st = frn.get("k_st");								if ( n_st == 0 ) {					frn.set("k_status", "Eliminado");				} else {					if ( n_st == 10 ) {						frn.set("k_status", "Editable");					} else {						if ( n_st == 20 ) {							frn.set("k_status", "Solicitado");						} else {							frn.set("k_status", "Indefinido ...");						}					}				}											return;						   } // End MostrarRef()													} // End of class Main			</script></pag>