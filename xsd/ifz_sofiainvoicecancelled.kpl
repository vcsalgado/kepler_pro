<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Invoice Cancelled"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0">	<br/>	<tab/><inp id="inp_titulo" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>	<br/><tab/><hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp dim="80,30,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">        <tab n="1"/><txt clr="0,58,112" hk="S">Sucursal:</txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><sp/><tab/>		<txt clr="132,20,7">Codigo del distribuidor : </txt><tab/><sp n="1"/>				<inp id="invcan_codigodistribuidor" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="number" nc="9" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Codigo del distribuidor"/><br/>				<br/><tab/>      <txt clr="132,20,7">Codigo BAC del distribuidor :</txt><tab n="2"/>		<inp id="invcan_dealerbac" dim="12,1"  type="number" nc="9" fmt="5" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" available="N" modify="Y" tooltip="Codigo BAC del distribuidor"/><sp/><tab/>		<txt clr="132,20,7">Codigo secundario del distribuidor : </txt>				<inp id="invcan_secondarydealernumberid" dim="12,1" type="number" nc="9" fmt="5" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="N" visible="Y" tooltip="Codigo secundario del distribuidor"/>       <br/><tab/>		<ratio id="rd_anulacion" dim="2,16" clr="64,64,64" bclr="255,255,255"/><tab/><txt>Anulacion</txt><tab/>		<ratio id="rd_nota_credito" dim="2,16" clr="64,64,64" bclr="255,255,255"/><txt>Nota de credito</txt>		<tab n="2"/><txt clr="132,20,7">Numero de folio :</txt><tab/>				<inp id="invcan_numeronotacredito" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="capital" nc="10" fmt="5" just="L" fnt="Arial,0" OnF9="ObtenerFolio()" OnChange="LimpiarInf()" 			clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Numero de nota de credito con que se reporta la cancelacion ( F9 b&#250;squeda )"/>		<tab/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y" tooltip="Buscar"/>        <tab/>		<inp id="strfolio" clr="64,64,64" clrBrdr="255,255,255"  dim="7,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "N" modify="Y" visible="N"			OnChange="SeparaFolio()"/><br/><tab/>        <txt clr="132,20,7">Razon de cancelacion :</txt><tab n="3"/>		<cmb id="invcan_codigorazoncancelacion" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital"  OnChange="" modify="Y" available="Y" visible="Y" tooltip="Razon de cancelacion"/>		<br/><tab/>        <txt clr="132,20,7">Identificador del documento : </txt><tab n="2"/>				<inp id="invcan_identificadordocumento" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="number" nc="9" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Identificador del documento"/>		<tab/><txt clr="132,20,7">Fecha de cancelacion :</txt><tab/>		<edt id="invcan_fechacancelacionfactura" dim="10,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="" page="_ks_fecha,invcan_fechacancelacionfactura" OnF9="Dialog(3,_ks_fecha,invcan_fechacancelacionfactura)" modify="Y" available="Y" tooltip="Fecha de cancelacion de la factura"/>		<br/><tab/>		<txt clr="132,20,7">Numero de serie : </txt><tab n="4"/>				<inp id="invcan_numeroserie" clr="64,64,64"  dim="25,1" brdr="2,0" bclr="255,255,255" type="capital" nc="17" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Numero de serie de la unidad vendida"/>		<br/><tab/>		<txt clr="132,20,7">Cadena original del timbre : </txt><tab n="2"/>				<inp id="invcan_cadenaoriginaltimbre" clr="64,64,64"  dim="55,3" brdr="2,0" bclr="255,255,255" type="string" nc="500" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="N" tooltip="Cadena original del timbre"/>		<br/>      <br/>      <tab n="15"/>		<txt clr="132,20,7">Datos obligatorios en color &lt;Rojo&gt;</txt>			<tab/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>		<sp n="2"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>				</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco, externo ;		var cmdQuery, cuboQuery, ok, mensajeError, fileSavePath;		var tipoOper; //Variables relacionadas con parametros		var accion,straccion,resVal,suc_bus,genero,naturaleza,grupo,tipo,folio,RdAnulacion,RdNotaCredito, id_docto;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			asterisco = "*";			fileSavePath = "C:\Basura";			ConfiguraUI();			Inicializa();		}					fun ConfiguraUI(){			var nparam;			tipoOper = strFormat("ucase",frn.param(0));			nparam = frn.nParam();			accion = strFormat("ucase",frn.param(1));			id_docto = strFormat("ucase",frn.param(2));			grupo = frn.param(3);			tipo = frn.param(4);			if (frn.nParam() == 0){				frn.message("Accion no permitida.","Error","&Aceptar");				frn.open("redirect",2);				return;			}			//Establecer titulo de la ventana			if (accion &= "ALTA"){				straccion = "Alta " ;            }else if (accion &= "CONSULTA"){				straccion = "Consulta ";         }     			if (tipoOper &= "INVOICECANCELLED"){				frn.set("inp_titulo",straccion & "Invoice Cancelled");											}					}						fun Inicializa(){			var cmd,cubo;							//Llenar combo sucursales			cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmd = cmd & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmd = cmd & " where c1='" & suc_usuario & "'";				}			}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ifz_sofiainvoicecancelled.Inicializa()");					ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_sucn",getXml(cubo));			frn.set("k_sucn",descr_combo("k_sucn",1,suc_usuario));							//Llena Combo Razon de cancelacion			cmd = "select codigo_cancelacion||'-'||razon_cancelacion as razon_cancelacion, codigo_cancelacion from keplersc.ifz_sofia_razon_cancelacion";			IniCombos("invcan_codigorazoncancelacion",cmd);								frn.set("invcan_codigorazoncancelacion", "");			frn.set("invcan_dealerbac", "320134");			frn.set("invcan_secondarydealernumberid", "320134");			genero = "U";			naturaleza = "A";			if (grupo == 60){			//Se envia el grupo desde otra pantalla				frn.set("rd_nota_credito","1");			} else if (grupo == 70){				frn.set("rd_anulacion","1");			} else {				frn.set("rd_anulacion","1");			}									if (id_docto &! ""){			//Se envia el folio desde otra pantalla				frn.set("invcan_numeronotacredito",id_docto);				Buscar();				}		}					fun IniCombos(ctrl_combo, query){			cmdQuery = query;			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ifz_sofiainvoicecancelled.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set(ctrl_combo,cuboQuery);		}		fun SeparaFolio(){			var nCampos,nfolio;				//Separa el folio y tipo, vienen concatenados con ~			nCampos = strSplit(frn.get("strfolio"),"~",-1);			if (nCampos > 1) {				tipo = strSplit(frn.get("strfolio"),"~",0);				nfolio = strSplit(frn.get("strfolio"),"~",1);							}else{				nfolio = frn.get("strfolio");			}				folio = nfolio;			frn.set("invcan_numeronotacredito", folio);		}			fun ObtenerFolio() {			suc_bus = frn.get("k_sucn",-1,1);			LimpiarInf();			RdAnulacion = frn.get("rd_anulacion");			RdNotaCredito = frn.get("rd_nota_credito");				if (RdAnulacion &= "1") {				grupo = 70;			}			if (RdNotaCredito &= "1") {				grupo = 60;			}				cmdQuery = "select c2 as gen, c3 as nat, c4 as gpo, c5 as tipo, c6 as folio, to_char(c9, 'DD/MM/YYYY') as fecha, c100 as inventario,concat(c5,'~',c6) as llave " &						"from keplersc.kdm1 " &						"where c1='" &suc_bus& "' and c2='" &genero& "' and c3='" &naturaleza& "' and c4 =" & grupo &						" order by c9 desc";			frn.dialog("genlistafiltrosel","Folios",cmdQuery,"llave","strfolio","0","0","N","S");			}				fun Buscar() {			var xmlTimbre,cmd,ok,cuboResultados, xmlProd,vfmov,vfreg,resultado,mensaje,nat_cfd,gpo_cfd,tipo_cfd,folio_cfd;			suc_bus = frn.get("k_sucn", -1, 1);			folio = frn.get("invcan_numeronotacredito");			RdAnulacion = frn.get("rd_anulacion");			RdNotaCredito = frn.get("rd_nota_credito");				if (RdAnulacion &= "1") {				grupo = 70;			}			if (RdNotaCredito &= "1") {				grupo = 60;			}				if (folio &=""){				frn.message("Debe seleccionar un folio","Error","Aceptar");				return;			} 			cmd = "select v.codigo_cancelacion invcan_codigorazoncancelacion, v.c7 as tipo, s.c5 invcan_codigodistribuidor, right (v.c8::varchar,7) invcan_identificadordocumento,					v.c9 invcan_fechacancelacionfactura,'' invcan_cadenaoriginaltimbre, i.c5 invcan_numeroserie, k.c36 as nat_fact, k.c37 as gpo_fact, k.c38 as tipo_fact, k.c39 as folio_fact					from keplersc.kdventas v					inner join keplersc.kdm1 k on k.c1 = v.c1 and k.c2 = v.c4 and k.c3 = v.c5 and k.c4 = v.c6 and k.c5 = v.c7 and k.c6 = v.c8					inner join keplersc.kdmm m on m.c1 = k.c2 and m.c2 = k.c3 and m.c3 = k.c4 and m.c4 = k.c5					inner join keplersc.kdinf i on i.c2 = v.c2					inner join keplersc.kdms s on s.c1 = v.c1";			if (tipo &=""){						cmd = cmd & " where  v.c1 ='" & suc_bus & "' and v.c4 ='" & genero & "' and v.c5 ='" & naturaleza & "' and v.c6 = " & grupo & " and v.c8 ='" & folio & "'";			} else{				cmd = cmd & " where  v.c1 ='" & suc_bus & "' and v.c4 ='" & genero & "' and v.c5 ='" & naturaleza & "' and v.c6 = " & grupo & " and v.c7= " & tipo & " and v.c8 ='" & folio & "'";			}					frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRequestBuscar");								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ifz_sofiainvoicecancelled.Buscar()");			ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}						if(nXml(cuboResultados) == 0){				frn.setPos("invcan_numeronotacredito");				frn.message("El folio no existe","Error","Aceptar");				return;			}								rstXml(xmlProd);			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboResultados,"r0");			LimpiarInf();			frn.setX(xmlProd);			tipo = getXmlAtt(cuboResultados,"r0","tipo");			//Obtiene cadena timbre			if (RdAnulacion &= "1") {			//Si es anulacion envia los datos de la factura para obtener el selloCFD				folio_cfd = getXmlAtt(cuboResultados,"r0","folio_fact");				nat_cfd = getXmlAtt(cuboResultados,"r0","nat_fact");				gpo_cfd = getXmlAtt(cuboResultados,"r0","gpo_fact");				tipo_cfd = getXmlAtt(cuboResultados,"r0","tipo_fact");			} else {				folio_cfd = frn.get("invcan_numeronotacredito");				nat_cfd = naturaleza;				gpo_cfd = grupo;				tipo_cfd = tipo;			}			setXml(xmlTimbre,"sucursal",frn.get("k_sucn",-1,1));			setXml(xmlTimbre,"genero",genero);			setXml(xmlTimbre,"naturaleza",nat_cfd);			setXml(xmlTimbre,"grupo",gpo_cfd);			setXml(xmlTimbre,"tipo",tipo_cfd);			setXml(xmlTimbre,"folio",folio_cfd);			setXml(xmlTimbre,"dato_consulta","selloCFD");			cmdQuery="SELECT * FROM keplersc.cfd_datos_timbrado('<document>" & getXmlStr(xmlTimbre,"EOF:13_10") & "</document>')";			frn.lib("libGeneral.kpl","FileSave",cmdQuery, fileSavePath & "\CmdResCadenatimbre");			rstXml(cuboResultados);								cuboResultados= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"ifz_sofiainvoicecancelled.Buscar");							frn.lib("libGeneral.kpl","FileSave",cuboResultados, fileSavePath & "\XmlResCadenatimbre");								resultado = getXml(cuboResultados,"resultado");			mensaje = getXml(cuboResultados,"mensaje");								if(resultado &= "1") {				frn.set("invcan_cadenaoriginaltimbre",mensaje);			} else {				frn.message(mensaje, "Error", "Aceptar");				return;			}						//Llenar combos			frn.set("invcan_codigorazoncancelacion",descr_combo("invcan_codigorazoncancelacion",1,getXml(xmlProd, "invcan_codigorazoncancelacion")));		}		fun LimpiarInf(){			frn.set("invcan_codigorazoncancelacion", "");			frn.set("invcan_numeroserie", "");			frn.set("invcan_codigodistribuidor", "");			frn.set("invcan_identificadordocumento", "");			frn.set("invcan_fechacancelacionfactura", "");			frn.set("invcan_cadenaoriginaltimbre", "");		}			fun BorraDatos(){			frn.set("invcan_numeroserie","");			frn.set("invcan_codigorazoncancelacion", "");			frn.set("invcan_numeronotacredito", "");			frn.set("invcan_codigodistribuidor", "");			frn.set("invcan_identificadordocumento", "");			frn.set("invcan_fechacancelacionfactura", "");			frn.set("invcan_cadenaoriginaltimbre", "");		}				fun Ejecuta(){			var xmlPantalla,resultado,mensaje,continua;			var strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			fecha = sys.date();			hora= sys.time();			strFecha = fnDate("year",fecha) & "-";			strTmp = fnDate("month",fecha);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "-";			strTmp = fnDate("day",fecha);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp;			resVal = 1;			ValidarDatos();			if(resVal == 0){				return;			}			continua = frn.message("Desea continuar ?","Atencion",2);			if (continua == 0){				return;			}						xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			setXml(xmlPantalla,"invcan_numeronotacredito",mid(frn.get("invcan_numeronotacredito"),3,7));			setXml(xmlPantalla,"sucursal",frn.get("k_sucn",-1,1));			setXml(xmlPantalla,"genero",genero);			setXml(xmlPantalla,"naturaleza",naturaleza);			setXml(xmlPantalla,"grupo",grupo);			setXml(xmlPantalla,"tipo",tipo);			setXml(xmlPantalla,"folio",folio);			setXml(xmlPantalla,"serie",frn.get("invcan_numeroserie"));			setXml(xmlPantalla,"fecha",fecha);			setXml(xmlPantalla,"movto_sofia","Invoice Cancelled");			setXml(xmlPantalla,"tip_ope",tipoOper);			setXml(xmlPantalla,"movimiento","usuario",usuario);			setXml(xmlPantalla,"movimiento","fecha",strFecha);			setXml(xmlPantalla,"movimiento","hora",			frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 			frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaifz_sofiainvoicecancelled");			cmdQuery="SELECT * FROM keplersc.ifz_sofiainvoicecancelled('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";			rstXml(cuboQuery);								cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"ifz_sofiainvoicecancelled.Ejecuta");							frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadifz_sofiainvoicecancelled");								resultado = getXml(cuboQuery,"resultado");			mensaje = getXml(cuboQuery,"mensaje");								ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(resultado &= "1") {				strMsg = "Se guardo correctamente la informacion para SOFIA";				frn.message(strMsg, "Mensaje", "Aceptar");				 frn.setAtt("bot_seleccionar", "visible", "N" );			} else {				frn.message(mensaje, "Error", "Aceptar");				return;			}			frn.exit();  		}        fun validaDatoVacio(dato,msg){			if (frn.get(dato) &= ""){				resVal= 0;				frn.setPos(dato);				frn.message("Debe especificar " & msg & "|El dato no puede estar vacio","Error","Aceptar");				return;			}		}		fun ValidarDatos(){			validaDatoVacio("invcan_dealerbac","Codigo BAC del distribuidor");			validaDatoVacio("invcan_secondarydealernumberid","Codigo secundario del distribuidor");			validaDatoVacio("invcan_codigorazoncancelacion","Razon de cancelacion");			validaDatoVacio("invcan_numeronotacredito","Numero de nota de crédito");			validaDatoVacio("invcan_codigodistribuidor","Codigo de distribuidor que se reporta");			validaDatoVacio("invcan_identificadordocumento","Identificador del documento");			validaDatoVacio("invcan_fechacancelacionfactura","Fecha de cancelacion");			validaDatoVacio("invcan_numeroserie","Numero de serie");			validaDatoVacio("invcan_cadenaoriginaltimbre","Cadena original del timbre");			if (strlen(frn.get("invcan_numeroserie")) != 17){				resVal= 0;				frn.setPos("invcan_numeroserie");				frn.message("La serie debe ser de 17 digitos","Error","Aceptar");				return;			}        }//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------		fun descr_combo(combo,posicion,valor){			var descr, valor_actual;			var len_combo = frn.N(combo);			for (var cont=0; cont<len_combo ; cont++){				valor_actual= frn.get(combo,cont,posicion);				if (valor_actual &=  valor){					descr = frn.get(combo,cont,0);					return descr;				}			}		}					fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO						1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana						2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)						3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			if(iModo==0)				page=pag;			else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.				if( frn.getAtt(par0,"modify",par1) &= "N" ) 					b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) 					b_valido=0;				if( frn.getAtt(par0,"visible",par1) &= "N" ) 					b_valido=0;			}			if(iModo==3)				frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>