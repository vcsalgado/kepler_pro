<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Esquema Coach Ventas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="1,-1,7,11" bclr="192,205,213" unfont="0">	<tab/><txt fnt=",22" clr="0,0,0">Esquema Coach Ventas</txt><tab/>	<br/>	<tab/>	<hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp id="gpo_1" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" 		clrBrdr="0,58,112" dim="85,7,7,11" brdr="0,5" tit="Criterio de selecci&#243;n" fnt="Arial,16">        <tab/><txt>Sucursal:</txt>		<sp/>		<cmb id="k_sucn" dim="35,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="N" OnChange="CambiaSucursal()" tooltip="Sucursal"/>        <tab/><txt>Esquema:</txt>		<inp id="k_esquema" dim="8,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="5" modify="Y" available="Y" fnt="Arial,0" OnF9="ObtenerEsquema()" OnChange="ResetEsquema()" tooltip="Esquema ( F9 b&#250;squeda )"/>		<tab/>        <img id="img_buscar" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="BuscarEsquema()"/>	        <br/>        <tab/><txt>* El esquema 1 es de GV, los siguientes n&#250;meros son para Coach</txt>		</grp>	<br/><br/><tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="85,78,7,11" brdr="0,5" tit="Detalle de Esquema" fnt="Arial,16" available="N">		<tab/><txt>Bono x Alcanzar 1er objetivo Entregas Nuevos :</txt>        <inp id="bono1objent_nvos" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono x Alcanzar 1er objetivo Entregas Nuevos"/>        <br/>        <tab/><txt>Bono x Alcanzar 2do objetivo Entregas Nuevos :</txt>        <inp id="bono2objent_nvos" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono x Alcanzar 2ndo objetivo Entregas Nuevos"/>        <br/>        <br/>        <tab/><txt>Bono por Alcanzar Objetivo de MARGEN DE UTILIDAD :</txt>        <inp id="bonobjmar_util" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono por Alcanzar Objetivo de MARGEN DE UTILIDAD"/>        <br/>        <br/>        <tab/><txt>Bono por Alcanzar Objetivo de % Share Financiera 1 :</txt>        <inp id="bonobjsh_fin1" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono por Alcanzar Objetivo de % Share Financiera 1"/>        <br/>        <tab/><txt>Bono por Alcanzar Objetivo de % Share Financiera 2 :</txt>        <inp id="bonobjsh_fin2" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono por Alcanzar Objetivo de % Share Financiera 2"/>        <br/>        <br/>        <tab/><txt>Bono por Alcanzar Objetivo 1 de CSI :</txt>        <inp id="bonobj1_csi" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono por Alcanzar Objetivo 1 de CSI"/>        <br/>        <tab/><txt>Bono por Alcanzar Objetivo 2 de CSI :</txt>        <inp id="bonobj2_csi" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono por Alcanzar Objetivo 2 de CSI"/>        <br/>        <br/>        <tab/><txt>Descuento por Unidades Atrasadas en Nuevos :</txt><tab n="2"/>        <inp id="desctounid_atras_nvos" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Descuento por Unidades Atrasadas en Nuevos"/>        <br/>        <tab/><txt>Descuento por Unidades Atrasadas en Seminuevos :</txt><tab/>        <inp id="desctounid_atras_seminvos" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Descuento por Unidades Atrasadas en Seminuevos"/>        <br/>        <br/>        <tab/><txt>Bono Combinado :</txt><tab/>        <inp id="bonocomb" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono Combinado"/>        <br/>        <br/>        <tab/><txt>Bono Objetivo de Facturaci&#243;n de Nuevos :</txt>        <inp id="bonobjfact_nvos" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono Objetivo de Facturacion de Nuevos"/>        <br/>        <br/>        <tab/><txt>Bono Objetivo de Tomas :</txt>        <inp id="bonobj_tomas" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono Objetivo de Tomas"/>        <br/>        <br/>        <tab/><txt>Bono Objetivo de Venta de Garant&#237;a Extendida :</txt>        <inp id="bonobjvta_gext" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono Objetivo de Venta de Garantia Extendida"/>        <br/>        <br/>        <tab/><txt>Bono por Alcance de Entregas Trimestrales :</txt>        <inp id="bonoent_trim" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono por Alcance de Entregas Trimestrales"/>        <br/>        <br/>        <tab/><txt>Bono por Alcance Objetivo Accesorios :</txt>        <inp id="bonobj_acces" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono por Alcance Objetivo Accesorios"/>        <br/>        <br/>        <tab/><txt>Bono por Alcance Objetivo de Seguros Contado :</txt>        <inp id="bonobjseg_contado" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono por Alcance Objetivo de Seguros Contado"/>        <br/>        <br/>        <tab/><txt>Bono Combinado de Seminuevos :</txt>        <inp id="bonocomb_seminvos" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono Combinado de Seminuevos"/>        <br/>        <tab/><txt>Bono Facturaci&#243;n de Seminuevos :</txt>        <inp id="bonofact_seminvos" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono Facturaci&#243;n de Seminuevos"/>        <br/>        <br/>        <tab/><txt>Bono x Alcanzar 1er objetivo Entregas Seminuevos :</txt>        <inp id="bonobj1ent_seminvos" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono x Alcanzar 1er objetivo Entregas Seminuevos"/>        <br/>        <tab/><txt>Bono x Alcanzar 2do objetivo Entregas Seminuevos :</txt>        <inp id="bonobj2ent_seminvos" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono x Alcanzar 2do objetivo Entregas Seminuevos"/>        <br/>        <br/>        <tab/><txt>Bono x Alcanzar 1er objetivo Financiera Seminuevos :</txt>        <inp id="bonobj1finan_seminvos" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono x Alcanzar 1er objetivo Financiera Seminuevos"/>        <br/>        <tab/><txt>Bono x Alcanzar 2do objetivo Financiera Seminuevos :</txt>        <inp id="bonobj2finan_seminvos" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Bono x Alcanzar 2ndo objetivo Financiera Seminuevos"/>        <br/>        <br/>        <tab/><txt>Pagar Flotillas : </txt>        <inp id="pagar_flotilla" dim="2,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="1" tooltip="Pagar Flotillas S &#243; N (Doble Click para cambiar)" modify="Y" OnMouseD="Flotilla()" OnChange="ValidaSN()"/>        <tab n="2"/><txt>S para Pagarlas</txt>		<br/><tab n="25"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" default="0" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;		var tipoOper; //Variables relacionadas con parametros		var clave, sucursal_id, esquema_id; 		var cmdQuery, cuboQuery, ok, mensajeError;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			rol_usuario = frn.config("user","role");			asterisco = "*";			tipoOper = frn.param(0);			clave = frn.param(1);			llena_combos();			ConfiguraUI();			Inicializa();		}            		fun llena_combos(){				//Llenar combo sucursales			var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmd = cmd & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmd = cmd & " where c1='" & suc_usuario & "'";				}			}							var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");					ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}								frn.set("k_sucn",getXml(cubo));						}        fun ObtenerEsquema(){			sucursal_id = frn.get("k_sucn",-1,1);			cmdQuery = "select c1 as esquema from keplersc.kdesqgv where c25 ='" & sucursal_id & "'";							frn.dialog("genlistafiltrosel","Esquemas",cmdQuery,"esquema","k_esquema","0","0","N","S");	            ResetEsquema();        }				fun ResetEsquema(){			frn.set("bono1objent_nvos", "");            frn.set("bono2objent_nvos", "");            frn.set("bonobjmar_util", "");            frn.set("bonobjsh_fin1", "");            frn.set("bonobjsh_fin2", "");            frn.set("bonobj1_csi", "");            frn.set("bonobj2_csi", "");            frn.set("desctounid_atras_nvos", "");            frn.set("desctounid_atras_seminvos", "");            frn.set("bonocomb", "");            frn.set("bonobjfact_nvos", "");            frn.set("bonobj_tomas", "");            frn.set("bonobjvta_gext", "");            frn.set("bonoent_trim", "");            frn.set("bonobj_acces", "");            frn.set("bonobjseg_contado", "");            frn.set("bonocomb_seminvos", "");            frn.set("bonofact_seminvos", "");            frn.set("bonobj1ent_seminvos", "");            frn.set("bonobj2ent_seminvos", "");            frn.set("bonobj1finan_seminvos", "");            frn.set("bonobj2finan_seminvos", "");            frn.set("pagar_flotilla", "N");            frn.setAtt("gpo_2", "available", "N");		}		        fun CambiaSucursal(){            frn.set("k_esquema", "");            ResetEsquema();        }        fun CambiaEsquema(){            ResetEsquema();        }		fun BuscarEsquema(){			var xmlProd, suc, esq, nuevo;            suc = frn.get("k_sucn",-1,1);            esq = frn.get("k_esquema");            if (esq&=""){				frn.setPos("k_esquema");				frn.message("Es necesario indicar el Esquema","Error","Aceptar");				return;				}			cmdQuery = "select c2 as bono1objent_nvos,c3 as bono2objent_nvos,c4 as bonobjmar_util,c5 as bonobjsh_fin1,c6 as bonobjsh_fin2," &                    "c7 as bonobj1_csi,c8 as bonobj2_csi,c9 as desctounid_atras_nvos,c10 as desctounid_atras_seminvos,c11 as bonocomb,c12 as bonobjfact_nvos," &                    "c13 as bonobj_tomas,c14 as bonobjvta_gext,c15 as bonoent_trim,c16 as bonobj_acces,c17 as bonobjseg_contado,c18 as bonocomb_seminvos," &                    "c19 as bonofact_seminvos,c20 as bonobj1ent_seminvos,c21 as bonobj2ent_seminvos,c22 as bonobj1finan_seminvos,c23 as bonobj2finan_seminvos,c24  as pagar_flotilla " &                    "from keplersc.kdesqgv " &                    "where c1='" & esq & "' and c25 ='" & suc & "'";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_esquema_coach_ventas.ObtenerEsquema");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}            if(nXml(cuboQuery) == 0){				frn.setPos("bono1objent_nvos");				nuevo = frn.message("El esquema no existe. ¿Desea crearlo como nuevo?","Atención",2);				if (nuevo == 0){                    frn.setPos("k_esquema");                    frn.setAtt("gpo_2", "available", "N");					return;                }else{                    frn.setAtt("gpo_2", "available", "Y");   				}			}else {            rstXml(xmlProd);			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");            ResetEsquema(); //Limpiar antes de cargar datos            frn.setAtt("gpo_2", "available", "Y");			frn.setX(xmlProd);            }			}				fun Ejecuta(){			var xmlPantalla,continua,resultado,mensaje,adicionales;			            continua = frn.message("¿Desea continuar?","Atención",2);			if (continua == 0){				return;			}			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;						frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaEsquemas");			cmdQuery="select * from keplersc.com_esquemacoachvtas_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						kdb.rst(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_crud_esquema_coach_ventas");			resultado= getXml(cuboQuery,"resultado");			mensaje= getXml(cuboQuery,"mensaje");							if(resultado &= "0"){				frn.message(mensaje,"Error","Aceptar");				return;			}            frn.setPos("k_esquema");			frn.message("Esquema registrado","Mensaje","Aceptar");            BuscarEsquema();            frn.setAtt("gpo_2", "available", "N");		}				fun ConfiguraUI(){			if (frn.nParam() == 0){				frn.message("Acción no permitida.","Error","&Aceptar");//				frn.open("redirect",2);				return;			}		}				fun Inicializa(){			ResetEsquema();		}		fun Flotilla() {			var irow, icol;			if (frn.get("pagar_flotilla") &= "N") {				frn.set("pagar_flotilla","S");			} else {                frn.set("pagar_flotilla","N");			}		}            fun ValidaSN(){            if (frn.get("pagar_flotilla") &! "N" && frn.get("pagar_flotilla") &! "S"){                frn.setPos("pagar_flotilla");				frn.message("Sólo puede ser S o N","Error","&Aceptar");                return;			}          }               					}				</script></pag>