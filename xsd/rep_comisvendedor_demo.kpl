<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Historial Inventario">	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<br/><tab/><txt clr="0,0,0" fnt=",22">Demostraci&#243;n de Comisi&#243;n</txt>		<br/><tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grpDatosGenerales" dim="30,12,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5"  tit="Demostraci&#243;n de comisi&#243;n"  fnt="Arial,16" available="Y" modify="Y">							<br/><tab/><txt>Sucursal:</txt><sp n="8"/><cmb id="k_sucn" dim="40,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" Null="N" modify="Y" available="Y"/>			<br/>			<tab/>			<txt id="txt_inventario">Inventario: </txt> <sp n="7"/>			<inp id="k_inventario" dim="20,1" bclr="255,255,255" clr="64,64,64" modify="Y" OnF9="consulta_inventario()" tooltip="F9 selecciona inventario" 				OnChange="identificador_inventario()" clrBrdr="255,255,255"  type="capital" brdr="0,2"/>		   <br/> <br/> 			<tab n="9"/><bot id="bot_ejecutar" dim="15,0" brdr="5" text="Ejecutar" OnEnter="GenerarReporte()" default="1"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys,suc_usuario ,perfil_usuario,asterisco, fileSavePath , rol_usuario  ;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;								kdb.connect();				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				asterisco = "*";				rol_usuario = frn.config("user","role");				fileSavePath = "C:\Basura";				Inicializa();							}						fun Inicializa(){//Inicializa los valores en Pantalla				IniCombos();				IniParams();//Inicializa parámtros de impresión entre otros			}									fun IniCombos(){				var cmd, cubo , xmlResQuery, ok, mensajeError, strTmp;								//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));																		}			fun consulta_inventario() {				var sucursal_id = frn.get("k_sucn",-1,1);				frn.set("inventario", "");				var cmdQuery = "select c2 as inventario, c3 as clave, c4 as descripcion, c2 as identificador from keplersc.kdinf where c1= '" & sucursal_id & "' ";				frn.dialog("genlistafiltrosel","Inventario",cmdQuery,"identificador","k_inventario","0","","S");				}						fun GenerarReporte(){				var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var cubo, cmd,ok,mensajeError , xmlRequest, strTmp, totres, cont  ;				kdb.kde("KDE");//Configuración del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();				var incluir_salto_pagina= frn.get("salto_de_pagina");								kdb.readPage("datos","rep_comisvendedor_demofto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parámetros finales de impresión.(rep.page(...);)				rep.set("suc_desc",frn.get("k_sucn",-1,0));				rep.set("rep_fecha",fechaImpresion);				rep.set("rep_hora",horaImpresion);				rep.set("inventario_rep",frn.get("inventario"));				rep.exe("encabezado");								setXml(xmlRequest,"document","k_sucn",frn.get("k_sucn",-1,1));				setXml(xmlRequest,"document","k_inventario",frn.get("k_inventario"));					frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest_demo");								cmd="select * from keplersc.com_vendedor_demo('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_comisvendedor_demo.GenerarReporte()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				totres=nXml(cubo);								for (cont=0; cont<=totres; cont++){					rep.set("inp_variable",getXmlAtt(cubo,"r"&cont,"variable"));					rep.set("inp_valor1",getXmlAtt(cubo,"r"&cont,"valor1"));					rep.set("inp_valor2",getXmlAtt(cubo,"r"&cont,"valor2"));					rep.exe("detalle");									}				rep.win();			}														//-------------------------------------------------extras------------------------------------------------								fun IniParams(){//Inicializa parámetros de impresión, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Página				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","N");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"			}									fun setRepPage() {//Establece los parámetros finales de impresión.				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}											fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}																											}	</script></pag>