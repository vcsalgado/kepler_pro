<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/><tab/><txt fnt=",22" clr="0,0,0">Fin de a&#241;o</txt>		<br/><tab/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grupo_crud" dim="60,22,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" available="Y" tit="Detalle de la Cuenta"><tab/>			<br/><tab/><txt>A&#241;o a cerrar:</txt><tab/>			<cmb id="k_anio_c" clr="64,64,64" clrBrdr="192,205,213" dim="6,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" available="Y" modify="Y" Null="N"					OnChange="calcular_cta_final()"/><br/><tab/><txt>Nuevo a&#241;o:</txt><tab/>			<cmb id="k_anio_d" dim="6,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" available="N" modify="N"/>						<br/><tab/><txt>Primera cuenta de resultados:</txt><tab/>			<inp id="k_cuentares_prim" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number" nc="4" available="N" 				 modify="N" fmt="5" max="9999"/><br/><tab/><txt>&#218;ltima cuenta de resultados:</txt><tab/>			<inp id="k_cuentares_ult" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" fmt="5" min="0" max="9999" modify="N" available="N"/><br/><tab/><txt>Cuenta de Utilidad Ej. Anterior</txt><tab/>			<inp id="k_cuentautil_ant" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" fmt="5" min="0" max="9999" modify="N" available="N"/><br/><tab/><txt fnt=",14" clr="250,50,0">Nota:Si las cuentas de su estado de resultados no caen en un solo rango o </txt><br/><tab n="2"/><txt fnt=",14" clr="250,50,0">en dicho rango hay cuentas que no sean de resultados, no use esta rutina</txt><tab/><sp/>			<br/><tab/><br/><tab/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="0" visible="Y" available="Y"/><br/>		</grp>		<br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP,sys, accion,clave_sel,sucursal_id,cve_color,resVal,straccion,anio_sel,funParent;			var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError;			var saldo_actual;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				kdb.connect();				Inicializa();			}						fun Inicializa(){				var cmd,cubo,anio,cuenta;				//Llena combo de año				cmd="SELECT concat(substring(table_name,5,2)) as anio FROM INFORMATION_SCHEMA.TABLES 					WHERE TABLE_NAME LIKE 'kdc22%' and TABLE_NAME >= 'kdc224'					group by anio					order by anio desc";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cont_fin_anio.Inicia_Forma()");				frn.set("k_anio_c",getXml(cubo));				anio=mid(fnDate(sys.date()),2,2);				anio=anio-1;				frn.set("k_anio_c",anio);				frn.set("k_anio_d",getXml(cubo));												//Cuentas de resultados				cmd = "select c4 as cuenta from keplersc.sqliov where c1='CUENTAS' and c2=12";				rstXml(cubo);				cubo=frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cont_fin_anio.Inicia_Forma()");//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\xmlcuboCuenta");							cuenta=getXmlAtt(cubo,"r0","cuenta");				if (cuenta &= ""){					frn.message("No se tiene configurada la primera cuenta de resultados.","Error","Aceptar");					ctlrs_off();					return;				}				frn.set("k_cuentares_prim",cuenta);								cmd = "select c4 as cuenta from keplersc.sqliov where c1='CUENTAS' and c2=21";				rstXml(cubo);				cubo=frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cont_fin_anio.Inicia_Forma()");//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\xmlcuboCuenta");							cuenta=getXmlAtt(cubo,"r0","cuenta");				if (cuenta &= ""){					frn.message("No se tiene configurada la ultima cuenta de resultados.","Error","Aceptar");					ctlrs_off();					return;				}				frn.set("k_cuentares_ult",cuenta);				cmd = "select valor as cuenta from keplersc.param_oper where parametro='Cuenta Utildad Anterior'";				rstXml(cubo);				cubo=frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cont_fin_anio.Inicia_Forma()");//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\xmlcuboCuenta");							cuenta=getXmlAtt(cubo,"r0","cuenta");				if (cuenta &= ""){					frn.message("No se tiene configurada la cuenta de utilidad.","Error","Aceptar");					frn.setAtt("btn_aceptar","visible","N");					ctlrs_off();					return;				}				frn.set("k_cuentautil_ant",cuenta);					ctlrs_opcion();			}									fun ctlrs_off(){				frn.setAtt("btn_aceptar","visible","N");			}							fun ctlrs_opcion(){				frn.setAtt("btn_aceptar","visible","Y");			}							fun calcular_cta_final(){				var anio;				anio=frn.get("k_anio_c");				anio=anio+1;				frn.set("k_anio_d",anio);			}							fun Execute() {				var difsaldo, ini, fin;				//Validación	de datos									ini=frn.get("k_anio_c");				fin=frn.get("k_anio_d");				if(ini>=fin){					frn.setPos("k_anio_c");					frn.message("El año a cerrar debe ser menor que el nuevo","Error","Aceptar");					return;				}								ini=frn.get("k_cuentares_prim");				fin=frn.get("k_cuentares_ult");				if(ini>=fin){					frn.setPos("k_cuentares_prim");					frn.message("La primera cuenta de resultados debe ser menor que la última","Error","Aceptar");					return;				}				ini=frn.get("k_cuentautil_ant");				if(ini &= "0"){					frn.setPos("k_cuentautil_ant");					frn.message("La cuenta de utilidad esta vacía o es cero","Error","Aceptar");					return;									}				var resultado_confirmacion = frn.message("¿Confirma la operación?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}								xmlRequest = getXml(frn.dataPag());								cmdQuery="SELECT * FROM keplersc.cont_fin_anio('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\cmdCat_cuentas_crud");								cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_cuentas_crud.Execute()");	frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.message("Operación realizada correctamente","Mensaje","Aceptar");			}				}	</script></pag>