<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><txt fnt=",23b">Refacciones - Backorder - Entradas</txt><br/>	<!-- dim="81,0" --> 	<hLine dim="85,0"/> 	<br/> 	<br/> 		<!-- <grp dim="46,9,7,12" -->				<grp dim="48,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">			<txt>  Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>			<br/><br/>			<txt>  Tipo :        </txt>			<cmb id="k_tipon" dim="40,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="N" OnChange="CambiaTipo() "/>			<br/>		</grp>		<sp/>		<!-- dim="34,9,7,12" -->		<grp dim="36,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C"/><tab/> <br/>			<txt id="textFolio" visible="Y">  Folio :  </txt>			<edt id="k_folio" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" visible="Y" OnButton="ObtenerFolios()" OnF9="ObtenerFolios()" OnChange="BuscarFolio()"/> <br/>			<sp n="1"/>			<inp id="k_docto" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="C"/> <br/>			<txt>  Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N"/> 			<sp n="1"/> 			<txt>  Hora : </txt> 			<sp n="1"/> 			<edt id="k_hora" dim="15,1" type="string" nc="-1" bclr="240,240,240" modify="N" fmt="HH:MM:SS" available="N"/> 			<br/>		</grp>				<br/>		<br/> 				<!-- dim="81,18,27,12" --> 		<grp id="grid" dim="85,28,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,16" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Motivos validos : [P] Precio, [E] Existencia, [C] Venta otra Distribuidora  /  [F9] Catalogo Productos  /  CTRL + DEL Borrar Linea">					<sp n="1"/> 			<!-- fnt="Arial,15" dim="114,6" -->			<tbl id="k_mov" dim="119,10" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" hk="z" OnMouseD="ToDel()" Reorder="N" modify="N" insdel="N" visible="Y">							<col id="c_reemplazo" name="Reemplazo"  type="capital" nc="18" modify="N" available="N" visible="Y"/>									<col id="borrar" name="Borrar" OnActive="Get_Data_Row()" type="capital" nc="1" modify="N" available="N" visible="N"/>				<col id="ctrlerr" name="ERR" OnActive="Get_Data_Row()" type="capital" nc="1" modify="N" available="N" visible="N"/>				<col id="k_parte" name="Producto"  OnActive="Get_Data_Row()" type="capital" nc="18" modify="N" available="Y" visible="Y" OnF9="Get_Cat(1)" OnChange="Get_Cat_Data(1, 1)"/>				<col id="k_descr" name="Descripcion" OnActive="Get_Data_Row()" type="string" nc="30" OnChange="" OnF9="" OnMouseL="" modify="N" available="N" visible="Y"/>				<col id="k_q" name="Cantidad" OnActive="Get_Data_Row()" type="number" nd="2" modify="N" available="Y" visible="Y" OnChange="Get_Cat_Data(0,1,1)"/> <!-- Get_Cat_Data(0,1) -->				<col id="k_unidad" name="U.M." OnActive="Get_Data_Row()" type="capital" nc="10" modify="N" available="N" visible="Y" OnChange="Get_Cat_Data(0,1)" nc="1"/> <!-- Get_Cat_Data(0,1) -->				<col id="k_precio" name="Unitario" OnActive="Get_Data_Row()" type="number" nd="2" modify="N" available="Y" visible="Y" OnChange="Get_Cat_Data(0,1,1)"/> <!-- Get_Cat_Data(0,1) -->				<col id="k_monto" name="Importe" OnActive="Get_Data_Row()" type="number" nd="2" modify="N" available="N" visible="Y" OnChange="Get_Cat_Data(0,1)"/> <!-- Get_Cat_Data(0,1) --> 								<!--				<col id="serie" name="Serie" OnActive="Get_Data_Row()" type="string" nc="20" modify="Y" available="Y" visible="Y" OnChange="Get_Cat_Data(0,1)"/>				<col id="color" name="Color" OnActive="Get_Data_Row()" type="string" nc="10" modify="Y" available="Y" visible="Y" OnF9="Get_Cat(3)" OnChange="Get_Cat_Data(3, 1)"/>				<col id="vest" name="Vest" OnActive="Get_Data_Row()" type="string" nc="10" modify="Y" available="Y" visible="Y" OnF9="Get_Cat(4)" OnChange="Get_Cat_Data(4, 1)"/>				<col id="ref" name="Referencia" OnActive="Get_Data_Row()" type="string" nc="12" OnF9="" OnF10="" modify="Y" visible="Y" OnChange="Get_Cat_Data(0,1)"/>						<col id="suc" name="Sucursal" OnActive="Get_Data_Row()" type="string" nc="5" OnF9="Get_Cat(5)" OnChange="Get_Cat_Data(5, 1)" modify="Y" visible="Y"/>				<col id="fech" name="fech asig" OnActive="Get_Data_Row()" type="string" nc="10" modify="N" visible="N"/>				-->		   </tbl>		   			<br/>			<sp n="1"/> <txt fnt=",16b">Importe : </txt>			<sp n="1"/><tab/> <inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="N"/>  						<br/>						<sp n="1"/> <txt clr="0,58,112">Comentarios:</txt>			<sp n="1"/> <inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="107,3" brdr="2,0" fnt="Arial,16" nr="3,100" modify="N" available="Y" type="string" nc="300" bclr="255,255,255" visible="Y"/>			<br/>			<sp n="13"/> <inp id="k_coment2" clr="64,64,64" clrBrdr="255,255,255"  dim="107,1" brdr="2,0" fnt="Arial,16" nr="3,60" modify="N" available="N" type="string" bclr="255,255,255" nc="60" visible="Y"/>			<br/>			<sp n="13"/> <inp id="k_coment3" clr="64,64,64" clrBrdr="255,255,255"  dim="107,1" brdr="2,0" fnt="Arial,16" nr="3,60" modify="N" available="N" type="string" bclr="255,255,255" nc="60" visible="Y"/>						<br/>						<sp/><txt clr="132,20,7">Mensaje : </txt> 			<inp id="k_err" dim="110,1" clr="132,20,7" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="-1"/>					</grp>		<br/>		<br/>				<sp n="15"/>		<img id="Imprimir" dim="35,35" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Ejecuta_Reporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>					<sp n="25"/>		<img id="Cancelar" dim="35,35" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="N"/>					<sp n="10"/>		<img id="Aceptar" dim="35,35" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Crear registros &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>							</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal;			var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd, uen;         var row_grid, err_data, err_empty, fech_original, view_adicionales;                  // Vars Reports			var cmd, xmlResQuery, strTmp;			var sucursal, fech_oper, tipo_auto, xmlPar;										fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";				fileSavePath = "C:\Basura";								row_grid = 0;				err_empty = 0;				err_data = 0;								Inicializa();								ConfiguraControlesOpcion();				//frn.message("k_mov.modify : " & frn.getAtt("k_mov", "modify") & " ; k_mov.insdel : " & frn.getAtt("k_mov", "insdel") & " ; k_mov.nren : " & frn.getAtt("k_mov", "nren"), "Info Attribs - After", "Aceptar");							} /* END Func Main() */						fun ToDel() {							var irow, icol;							if (tip_ope &= "B") {					if ( strlen(frn.get("k_mov",-1,"modelo")) != 0 ) {						if ( strlen(frn.get("k_mov",-1,"borrar")) == 0 || frn.get("k_mov",-1,"borrar") &= "" ) {							frn.setX("X","k_mov",-1,"borrar");						} else {							frn.setX("","k_mov",-1,"borrar");						}					}							}									} /* END Func ToDel() */			fun Clean_Ctrls_Panel() {				frn.setX("", "k_err");				} /* END Func Clean_Ctrls_Panel() */									fun Get_Cat(imodo) {            				var suc_id, dato_id;				var win_tit, field_key, field_col, cmdQuery;            				if ( imodo <= 0 || imodo > 5 || tip_ope &! "A" ) {					// No es opcion de CAT Valida ...					return;				} 				win_tit = "";				field_key = "";				field_col = "";				cmdQuery = "";				if (imodo == 1) {						win_tit = "CAT Productos";						field_key = "clave";						field_col = "k_parte";						cmdQuery = "select C1 as clave, C2 as descripción from keplersc.kdini"; /* where c8 = 'N' */				}																							                      if ( strlen(win_tit) > 0 && strlen(field_key) > 0 && strlen(field_col) > 0 && strlen(cmdQuery) > 0 ) {                            					frn.dialog("genlistasel", win_tit,cmdQuery, field_key,"k_mov",-1, field_col,"S");				}							} /*END Func Get_Cat()*/		   fun Get_Cat_Data(imodo, icall, icalc) {						var dato_id;				var field_ori,field_dest, tbl, field_dscr;				var field_add, dato_id_add;				var field_dest_2, dato_id_2;								if ( imodo < 0 || imodo > 1/*5*/  || ( tip_ope &! "A" && icall != 2 ) ) {					// No es opcion de CAT Valida ...					return;				}								if ( icalc == 1 ) { 					CalculaTotales(); 				}								sucursal_id = frn.get("k_sucn",-1,1);								field_dscr = "";				field_ori = "";				field_dest = "";				tbl = "";				cmdQuery = "";								dato_id = "";										if (imodo == 1) {					field_dscr = "Producto";					field_ori = "k_parte";					field_dest = "k_descr";					tbl = "kdini";					cmdQuery = "select i.c2 as " & field_dest & ", i.c19 as unidad, l.c14 as costo from keplersc." & tbl & 					" i left join keplersc.kdinl l on l.c2 = i.c1 and l.c1 = '" & sucursal_id  & "' " & 					" where i.c1 = '" & frn.get("k_mov",-1,field_ori) & "'";										}				if ( tip_ope &= "A" ) {					if (imodo == 2) {						field_dscr = "Inventario";						field_ori = "invent";						field_dest = "anio";						tbl = "kddinv";						//cmdQuery = "select C3 as " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'"; 						cmdQuery = "select i.C3 as anio from keplersc.kddinv i inner join keplersc.kdiv k on k.c8 = i.c7 and k.c1 = '" & frn.get("k_mov",-1,"modelo") & "'" & 							" where i.c1 = '" & frn.get("k_mov",-1,field_ori) & "' and i.c7 = 'N'";					}				}											if (imodo == 3) {					field_dscr = "Color Exterior";					field_ori = "color";					field_dest = "color";					field_dest_2 = "descrip";					tbl = "kdice2";					if ( frn.get("k_mov",-1,"anio") &! "--" && trim(frn.get("k_mov",-1,"anio")) &! "" ) {						cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '" & frn.get("k_mov",-1,"modelo") & "' and c3 = '" & frn.get("k_mov",-1,field_ori) & "'";					} else {						cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '' and c3 = ''";					}				}											if (imodo == 4) {					field_dscr = "Color Vestidura";					field_ori = "vest";					field_dest = "vest";					field_dest_2 = "descrip";					tbl = "kdice3";					if ( frn.get("k_mov",-1,"anio") &! "--" && trim(frn.get("k_mov",-1,"anio")) &! "" ) {						cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '" & frn.get("k_mov",-1,"modelo") & "' and c3 = '" & frn.get("k_mov",-1,field_ori) & "'";					} else {						cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '' and c3 = ''";					}				}								if (imodo == 5) {					field_dscr = "Sucursal";					field_ori = "suc";					field_dest = "suc";					field_dest_2 = "descrip";					tbl = "kdms";					if ( frn.get("k_mov",-1,"anio") &! "--" && trim(frn.get("k_mov",-1,"anio")) &! "" ) {						cmdQuery = "select C1 as " & field_dest & ", c2 as " & field_dest_2 &" from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'";					} else {						cmdQuery = "select C1 as " & field_dest & ", c2 as " & field_dest_2 &" from keplersc." & tbl & " where c1 = 'none!@?'";					}				}								if (imodo == 0 && icall == 1) {					Eval_Data_Row(frn.getJ("k_mov"));				}								if (icall == 2 && tip_ope &! "A") {					frn.setX(frn.get("k_mov",-1,"fech"), "k_fecha_asig");				}											field_add = "";				/*				if (imodo == 1) { field_add = "k_descrip"; }				if (imodo == 3) { field_add = "k_color_ext"; }				if (imodo == 4) { field_add = "k_color_vest"; }					if (imodo == 5) { field_add = "k_suc"; }					*/											if ( strlen(field_dscr) > 0 && strlen(field_ori) > 0 && strlen(field_dest) > 0 && strlen(tbl) > 0 && strlen(cmdQuery) > 0 ) {					if ( strlen(frn.get("k_mov",-1,field_ori)) != 0 ) {						//dato_id = frn.get("k_mov",-1,field_ori);						//cmdQuery = "select C2 as descrip from keplersc.kdiv where c1 = '" & dato_id & "'";						rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comaltasigcrud.Get_Cat_" & tbl & "()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\Get_Cat_" & tbl);						ok=getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok){							dato_id = "--";							if (imodo == 1) {								dato_id = "[ERR] verificando " &  field_dscr & " ...";							}							frn.setX(dato_id,"k_mov",-1, field_dest);							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							dato_id_add = "";							if (imodo == 1) { dato_id_add = dato_id; }							if (imodo == 3 || imodo == 4 || imodo == 5) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							//if (imodo == 4) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							//if (imodo == 5) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							if ( strlen(field_add) != 0 ) { frn.setX(dato_id_add, field_add); }							return;						}						dato_id = "";						dato_id = getXmlAtt(cuboQuery,"r0", field_dest);					   if( strlen(dato_id) == 0 ){							//dato_id = "--";							dato_id = "";							if (imodo == 1 /*&& icall ==1*/) {								/*								if ( strlen(frn.get("k_mov",-1,"invent")) > 0 ) {									frn.setX(dato_id, "k_mov",-1, "invent");									frn.setX(dato_id, "k_mov",-1, "anio");								}								if ( strlen(frn.get("k_mov",-1,"color")) > 0 ) {									frn.setX(dato_id, "k_mov",-1, "color");									frn.setX("Color Exterior No Valido ...", "k_color_ext");								}								if ( strlen(frn.get("k_mov",-1,"vest")) > 0 ) {									frn.setX(dato_id, "k_mov",-1, "vest");									frn.setX("Color Vestidura No Valido ...", "k_color_vest");								}								if ( strlen(frn.get("k_mov",-1,"suc")) > 0 ) {									frn.setX(dato_id, "k_mov",-1, "suc");									frn.setX("Sucursal No Valido ...", "k_suc");								}								if ( strlen(frn.get("k_mov",-1,"serie")) > 0 ) {									frn.setX("", "k_mov",-1, "serie");								}								if ( strlen(frn.get("k_mov",-1,"ref")) > 0 ) {									frn.setX("", "k_mov",-1, "ref");								}								*/																// New Code 20230907								/*								frn.setX(dato_id, "k_mov",-1, "ctrlerr");								frn.setX(dato_id, "k_mov",-1, "k_q");								frn.setX(dato_id, "k_mov",-1, "k_precio");								frn.setX(dato_id, "k_mov",-1, "k_monto");								frn.setX(dato_id, "k_mov",-1, "k_unidad");								*/																//frn.setX("", "k_mov",-1, "ctrlerr");								/*								frn.setX("", "k_marca");								frn.setX("", "k_clase");								frn.setX("", "k_tipo_auto");								frn.setX("", "k_fecha_asig");								*/								frn.setX("", "k_err");												dato_id = field_dscr & " No existe ...";							}							frn.setX(dato_id, "k_mov",-1, field_dest);										/*							dato_id_add = "";						   if (imodo == 1) { dato_id_add = dato_id; }							if (imodo == 3 || imodo == 4 || imodo == 5) { dato_id_add = field_dscr & " No Existe ..."; }							if ( strlen(field_add) != 0 ) { frn.setX(dato_id_add, field_add); }							*/														Eval_Data_Row(frn.getJ("k_mov"));									return;												} else {													frn.setX(dato_id,"k_mov",-1,field_dest);							if (imodo == 1 && icall == 1) {								dato_id_2 = ""; 								//frn.setX(dato_id_2, "k_mov",-1, "k_descr");								frn.setX(dato_id_2, "k_mov",-1, "k_q");								frn.setX(dato_id_2, "k_mov",-1, "k_precio");								frn.setX(dato_id_2, "k_mov",-1, "k_monto");								frn.setX(dato_id_2, "k_mov",-1, "k_unidad");								Clean_Ctrls_Panel();							}														// Fill Data Panel of OBJs Adds 							if (imodo == 3 || imodo == 4  || imodo == 5) {								dato_id_2 = "";								dato_id_2 = getXmlAtt(cuboQuery,"r0", field_dest_2); 							}							/*							if (imodo == 1) { dato_id_add = dato_id; }							if (imodo == 3 || imodo == 4 || imodo == 5) { dato_id_add = dato_id_2; }							if ( imodo == 1 || imodo == 3 || imodo == 4 || imodo == 5 ) { frn.setX(dato_id_add, field_add); }							*/							// Fill Other Data of OBJs Adds related to field : Producto							// /*							if (imodo == 1) { 								frn.setX(getXmlAtt(cuboQuery,"r0", "unidad"), "k_mov",-1, "k_unidad");								frn.setX(getXmlAtt(cuboQuery,"r0", "costo"), "k_mov",-1, "k_precio");							}							// */														Eval_Data_Row(frn.getJ("k_mov"));												}					} else {											frn.setX(dato_id,"k_mov",-1,field_dest);							dato_id_add = dato_id;												if ( imodo == 1 ) {							/*							frn.setX(dato_id, "k_mov",-1, "ctrlerr");							frn.setX(dato_id, "k_mov",-1, "k_q");							frn.setX(dato_id, "k_mov",-1, "k_precio");							frn.setX(dato_id, "k_mov",-1, "k_monto");							frn.setX(dato_id, "k_mov",-1, "k_unidad");							Clean_Ctrls_Panel();											*/							}												/*if ( imodo == 1 || imodo == 3 || imodo == 4 || imodo == 5 ) { frn.setX(dato_id_add, field_add); }*/																	Eval_Data_Row(frn.getJ("k_mov"));											}				}					} /*END Fun Get_Cat_Data()*/			fun Get_Data_Row() {								var irow, icol;				var rows, evalrow;								rows = frn.N("k_mov") - 1;								icol = frn.getI("k_mov");				irow = frn.getJ("k_mov");								if ( row_grid != frn.getJ("k_mov") /*rows - 1*/ ) {									//Eval_Data_Row(row_grid); // was commented										// code added 20230907										/*					if ( irow == rows ) {						return;					}					*/										evalrow = Eval_Data_Row(row_grid);					if ( evalrow >= 0 ) {						if ( row_grid != rows ) {							frn.setPos("k_mov",row_grid, icol); // -1						} else {							row_grid = frn.getJ("k_mov");						}						return;					}										row_grid = frn.getJ("k_mov"); // commented									if ( strlen(frn.get("k_mov",-1,"k_parte")) == 0 ) {						Clean_Ctrls_Panel();					} else { 						for (var i=0; i<=5; i++) {							if ( tip_ope &! "A" ) {								Get_Cat_Data(i,2);							} else {								Get_Cat_Data(i);							}						}						Eval_Data_Row(row_grid); // commented						//row_grid = frn.getJ("k_mov"); // New 											}						}								//frn.setX("REN " & irow + 1 & " , COL " & icol, "k_err");			   //frn.setPos("k_mov",-1, icol);								} /*END Func Get_Data_Row()*/			fun Eval_Data_Row(nRow, imodo) {				var ColIni, ColEnd, EvalCols, ErrText;				var FieldsListData, FieldListEmpty;				var monto;								if ( nRow == imodo && nRow != 0 ) { 					return -1; 				}								if ( tip_ope &! "A" ) { 					return; 				}								ColEnd = 7; /*10*/				ColIni = 2;				EvalCols = ColEnd - ColIni + 1;				ErrText = "";							err_empty = 0;				err_data = 0;								FieldsListData = "";				FieldListEmpty = "";						// New code 20230907				if ( strlen(frn.get("k_mov", nRow, "k_parte")) != 0 ) {					monto = frn.get("k_mov", nRow, "k_q") * frn.get("k_mov", nRow, "k_precio");					frn.setX(monto, "k_mov", nRow, "k_monto");				} else {					frn.setX("", "k_mov", nRow, "k_monto");				}								// Evaluando vacios ...				for (var i=ColIni; i<=ColEnd; i++) {					if ( strlen( frn.get("k_mov", nRow, Get_Column(i) )) == 0 ) { 						err_empty = err_empty + 1;						FieldListEmpty = FieldListEmpty & Get_Column_Dscr(i) & " | "; 					} 				}								// Evaluando datos ...				for (var i=ColIni; i<=ColEnd; i++) {									if ( strlen( frn.get("k_mov", nRow, Get_Column(i) )) != 0 ) { // New condition 20230907											if ( (i == 3 || i == 4 || i == 6 || i == 7 ) && frn.get("k_mov", nRow, Get_Column(i)) &= "--"  ) { err_data = err_data + 1; } 											if ( i == 3/*5*/ && frn.get("k_mov", nRow, Get_Column(i)) &= "Producto No existe ..."  ) { 							err_data = err_data + 1; 							//if ( i == 3) {								FieldsListData = FieldsListData & Get_Column_Dscr(2) & " No Existe | ";							//} else {							//	FieldsListData = FieldsListData & Get_Column_Dscr(i) & " No Existe | ";							//}						} 					}										if ( i == 4 /*|| i == 6 || i == 7*/ ) {						if ( /*i == 4 &&*/ frn.get("k_mov", nRow, "k_q") <= 0 ) {							err_data = err_data + 1;							FieldsListData = FieldsListData & Get_Column_Dscr(4) & " <= 0 | ";						}												}										if ( i == 6 && frn.get("k_mov", nRow, "k_precio") <= 0 ) {						err_data = err_data + 1;						FieldsListData = FieldsListData & Get_Column_Dscr(6) & " <= 0 | ";					}													if ( i == 7 && frn.get("k_mov", nRow, "k_monto") <= 0 ) {						err_data = err_data + 1;						FieldsListData = FieldsListData & Get_Column_Dscr(7) & " <= 0 | ";					}											}				 								if ( err_data > 0 ) { ErrText = ErrText & "[No Validos] : " & FieldsListData; }					if ( err_empty > 0 /*&& err_empty < EvalCols*/ ) { ErrText = ErrText & "[Sin Registrar] : " & FieldListEmpty; }								//if ( err_empty == EvalCols && err_data == 0 ) { return; }				if ( strlen( ErrText ) == 0 ) { 					frn.setX("", "k_err");					frn.setX("", "k_mov", nRow, "ctrlerr");					return -1; 				}								frn.setX(ErrText, "k_err");				frn.setX("X", "k_mov", nRow, "ctrlerr");				return nRow;						} /*END Func Eval_Data_Row()*/			fun Get_Column(imodo) {				var colName;				switch(imodo) { 					case 2: colName = "k_parte";break; 					case 3: colName = "k_descr";break;					case 4: colName = "k_q";break;					case 5: colName = "k_unidad";break;					case 6: colName = "k_precio";break;					case 7: colName = "k_monto";break;					default: colName = "";break;				}				return colName;			} /*END Func Get_Column()*/			fun Get_Column_Dscr(imodo) {				var colName;				switch(imodo) { 					case 2: colName = "Producto";break; 					case 3: colName = "Descripcion";break;					case 4: colName = "Cantidad";break;					case 5: colName = "U.M.";break;					case 6: colName = "Unitario";break;					case 7: colName = "Importe";break;					default: colName = "";break;				}				return colName;			} /*END Func Get_Column()*/			fun Cancela() {				CambiaSucursal();				Inicializa();				ConfiguraControlesOpcion();			} /* END Func Cancela() */									/*			fun ModoBuscar(imodo, iview) {				tip_ope = "C";				frn.set("operacion", "CONSULTA");				if ( ( imodo == 1 || imodo == 2 ) && tip_ope_original &= "A" ) {					frn.set("k_fecha", fech_original);  				} else { 					LimpiaEncabezado();				}				ConfiguraControlesOpcion(imodo);				CambiaSucursal(imodo);			} 			*/			/*END Func ModoBuscar()*/						fun ModoBuscar() {				tip_ope = "C";				frn.set("operacion", "CONSULTA");				LimpiaEncabezado();				ConfiguraControlesOpcion();			}									fun ObtenerFolios() {			            sucursal_id = frn.get("k_sucn",-1,1);	            cmdQuery = "" &						"select w.c6 as folio, w.c9 as fecha from keplersc.kdm1 w " & 						"where w.c1 = '" & /*"02"*/sucursal_id & "' and w.c2 = '" & gen_doc & "' and w.c3 = '" & nat_doc & "' and w.c4 = " & gpo_doc & " and w.c5 = " & tip_doc  & " order by w.c6 desc";						                                    frn.dialog("genlistasel","Relacion de Pedidos",cmdQuery,"folio","k_folio","0","","N");                     }									fun BuscarFolio() {				var folio;				folio = frn.get("k_folio");				//frn.lib("libGeneral.kpl","PadLeft", folio, 7, "0");				folio = PadLeft(folio, 7, "0");				ArmarRefDocto();				MostrarDOC(folio);				}									fun Ejecuta() {				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg;				var resultado, mensaje, adicionales, folio;				var RowErr, iLim;								//fecha = sys.date();				//hora = sys.time();								resultado = "";				mensaje = "";				adicionales = "";				view_adicionales = "";								if (tip_ope &= "A") { 								// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ...					RowErr = -1;					iLim = frn.N("k_mov") - 1;					if ( iLim == 0 ) {						frn.message("No hay registros a procesar ...", "Info !!! ", "Aceptar");						return;							}					for (var i=0; i<=iLim ; i++) {						RowErr = Eval_Data_Row(i, iLim);						if ( RowErr != -1 ) { break; }					}					if ( RowErr != -1 ) {						frn.setPos("k_mov", RowErr, "ctrlerr");						frn.message("Se encontraron registros con errores.", "Info !!! ", "Aceptar");						return;					}					// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ...																// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;										//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;												setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",						frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 						frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));											//setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")/*-1*//*commented 220726*/);					setXml(xmlPantalla,"k_mov","no_partidas", iLim);										setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);					setXml(xmlPantalla,"ambiente","uen",uen);					frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\XmlAltaBackOrder");											// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ...															// FOR TESTING 					/*					mensaje = "La Transaccion se Procesara ...";					frn.message(mensaje, "Info !!!", "Aceptar");					return;					*/										// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 					cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					rstXml(cuboQuery);					cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"refbackordercrud.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_backorder");										// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										//resultado = "1";					//mensaje = "0000009";										resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");																				if(resultado &= "1") {											frn.message(mensaje, "Folio Generado para esta operacion : ", "Aceptar");											ModoBuscar(); // 220721 ... added 												//tip_ope = "C"; -- 220721 ... commented & included en ModoBuscar();						frn.set("k_folio", mensaje); 						//frn.set("operacion", "CONSULTA"); -- 220721 ... commented & included en ModoBuscar();						/*						strTmp = frn.get("k_docto");								strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;						frn.set("k_docto", strTmp);						*/						// //ConfiguraCamposOpcion();											//strMsg = "El Folio utilizado para esta operación fue : " & mensaje;						//ConfiguraControlesOpcion(); // TO CHECK ... Esto No se ejecuta si se pone después del Message * * *  						//frn.message(strMsg, "Mensaje", "Aceptar");						//folio = frn.get("k_folio");						//MostrarDOC(folio);							BuscarFolio();					} else {						frn.message(mensaje, "Error", "Aceptar");					}				} /*End Alta*/ else {					if (tip_ope &= "B") {						/*Ini Baja*/												frn.message("Opcion No Desarrollada ...", "Info", "Aceptar");						return;																		// IMPORTANTE ... EL CODIGO DE ABAJO DEBE SER RECONSTRUIDO ... ESTE ES DE OTRA OPCION 												folio = frn.get("k_folio");												//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok						resVal = 1;												// No existe en esta scr esta funcion						/*						ValidarDatos(1); 						if(ok &! "1" || resVal == 0){							return;						}										*/												xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;						//Agregar usuario, fecha y hora de movimiento						strFecha = fnDate("year",fecha) & "-";						strTmp = fnDate("month",fecha);						if(strlen(strTmp) == 1){							strTmp = "0" & strTmp;						}						strFecha = strFecha & strTmp & "-";						strTmp = fnDate("day",fecha);						if(strlen(strTmp) == 1){							strTmp = "0" & strTmp;						}						strFecha = strFecha & strTmp;													setXml(xmlPantalla,"movimiento","usuario",usuario);						setXml(xmlPantalla,"movimiento","fecha",strFecha);						setXml(xmlPantalla,"movimiento","hora",							frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 							frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));						setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")/*-1*//*commented 220726*/);						setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);											frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\Xml_Pedido_Baja");						// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 									cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						//kdb.rst(cuboQuery);						rstXml(cuboQuery);						cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"refaltapedcrud.Ejecuta_Baja");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_Baja");											// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 											//resultado = "1";						//mensaje = folio /*"0000009"*/;											resultado = getXml(cuboQuery,"resultado");						mensaje = getXml(cuboQuery,"mensaje");										// /*																	if(resultado &= "1") {												frn.message(mensaje, "Folio de Cancelacion : ", "Aceptar");												ModoBuscar(); // 220721 ... added 													//tip_ope = "C"; -- 220721 ... commented & included en ModoBuscar();							frn.set("k_folio", mensaje); 							//frn.set("operacion", "CONSULTA"); -- 220721 ... commented & included en ModoBuscar();							/*							strTmp = frn.get("k_docto");							strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;							frn.set("k_docto", strTmp);							*/							// //ConfiguraCamposOpcion();												//strMsg = "El Folio utilizado para esta operación fue : " & mensaje;							//ConfiguraControlesOpcion(); // TO CHECK ... Esto No se ejecuta si se pone después del Message * * *  							//frn.message(strMsg, "Mensaje", "Aceptar");							//folio = frn.get("k_folio");							//MostrarDOC(folio);								BuscarFolio();						} else {							frn.message(mensaje, "Error", "Aceptar");						}						// */												//frn.message("En Construcción, OPC {Baja}", "Info", "Aceptar");																	} /*End Baja*/ else {						frn.message("Opcion No Desarrollada ...", "Info", "Aceptar");						return;						/*Ini Consulta*/						folio = frn.get("k_folio");						ModoBuscar(); // 220721 ... added						frn.set("k_folio", folio); // 220721 ... added						//MostrarDOC(folio); // 220722 ... commented 						/*						strTmp = frn.get("k_docto");						strTmp = strSplit(strTmp,"-",0) & "-" & folio;						frn.set("k_docto", strTmp);							*/						BuscarFolio();					}	/*End Consulta (for exception)*/ 				}							} /* END Func Ejecuta() */									fun Inicializa(){ //Inicializa los valores en Pantalla				// Our code				var fech_init, strFecha, strTmp,fecha; 			   // Revisa y Carga en Variables los Parámetros Recibidos en la corrida				if( frn.nParam() >= 5 ){ //Se han mandado parámetros a la página					gen_doc = trim(frn.param(0));                nat_doc = trim(frn.param(1));                gpo_doc = trim(frn.param(2));               tip_doc = trim(frn.param(3));                tip_ope = trim(frn.param(4));               uen = trim(frn.param(5));               tip_ope_original = tip_ope; /*220726*/					//if (uen &= "") {						uen="REF";					//}				} else {					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					//frn.open("index",4);					frn.open("redirect",2);					return;				}							// Testing Code //				/*				gen_doc = "N"; 				nat_doc = "D"; 				gpo_doc = "22";				tip_doc = "1"; 				tip_ope = "A"; // "C" 				uen = "REF";				tip_ope_original = tip_ope;				*/				//frn.message("Parameters : " & frn.nParam() & " ; tip_ope : " & tip_ope, "Info Parameters", "Aceptar");								if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					/*					if(tip_ope &= "B"){ //Baja						frn.set("operacion","BAJA");					} else {*/						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} else {					      frn.message("Operación no válida ...", "Mensaje","&Aceptar");							//frn.open("anuncios",4);							frn.open("index",4);							return;									}					/*}*/				}												LimpiaDatosDoc();								/*if(tip_ope &! "A"){*/					// Fill Combo Sucursal (Con Query de PostgreSQL)					cmdQuery = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdms";					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ventascaidas.IniCombos()");					frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\sucursal_combo");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.set("k_sucn",cuboQuery);										//CambiaSucursal();										// Fill Combo Tipo (Con Query FTO Kepler) 					cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm " &					"where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4 = '" & tip_doc & "'" ;					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"fefaltapedcrud.Inicializa()");					//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboTipoDocto");							ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error BD","Aceptar");						return;					}					frn.set("k_tipon",getXml(cuboQuery));									/*} else {*/					row_grid = -1 /*0*/;					err_empty = 0;					err_data = 0;							/*}*/								frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());									// Fill k_docto | referencia docto				ArmarRefDocto();								/*				strFecha = sys.date();				fech_init = strFecha;				frn.set("k_fecha", fech_init);				fech_original = frn.get("k_fecha");				*/							} /* END Func Inicializa() */						// Armado del Docto Referencia			fun ArmarRefDocto {				var cadena,tmpFolio, tmpGrupo, tmpTipo;				tmpFolio = frn.get("k_folio");				// //tmpFolio = frn.lib("libGeneral.kpl","PadLeft",tmpFolio,"7","0");				tmpFolio = PadLeft(tmpFolio,"7","0");				tmpGrupo = PadLeft(gpo_doc,"2","0");				tmpTipo = PadLeft(tip_doc,"3","0");				//cadena = trim(gen_doc) & trim(nat_doc) & trim(gpo_doc) & trim(tip_doc) & "-" & tmpFolio;				cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;				frn.set("k_docto", cadena);			}						fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         } /* END Func PadLeft() */			fun ConfiguraControlesOff() {								frn.setAtt("textFolio", "visible", "N");				frn.setAtt("k_folio", "available", "N");				frn.setAtt("k_folio", "visible", "N");								frn.setAtt("k_fecha", "available", "N");				frn.setAtt("k_hora", "available", "N");				frn.setAtt("k_refer", "available", "N");				frn.setAtt("k_fecref", "available", "N");								frn.setAtt("k_coment", "visible", "Y");				frn.setAtt("k_coment2", "visible", "Y");				frn.setAtt("k_coment3", "visible", "Y");				frn.setAtt("k_coment", "modify", "N");				frn.setAtt("k_coment2", "modify", "N");				frn.setAtt("k_coment3", "modify", "N");				frn.setAtt("k_coment", "available", "N");				frn.setAtt("k_coment2", "available", "N");				frn.setAtt("k_coment3", "available", "N");								//frn.setAtt("suctxt", "visible", "N");				//frn.setAtt("k_sucn", "visible", "N");												frn.setAtt("grid", "tit", "Registro Items : ");								frn.setAtt("k_mov", "modify", "N");				frn.setAtt("k_mov", "insdel", "N");				//frn.setAtt("k_mov", "nren", "fijo");								//modify="Y" insdel="N" nren="fijo"			   frn.setAtt("k_fecha", "available", "N");								frn.setAtt("k_mov", "available", "N", "c_reemplazo");				frn.setAtt("k_mov", "modify", "N", "c_reemplazo");				frn.setAtt("k_mov", "visible", "N", "c_reemplazo");								frn.setAtt("k_mov", "modify", "N", "borrar");				frn.setAtt("k_mov", "visible", "N", "borrar");				frn.setAtt("k_mov", "modify", "N", "ctrlerr");				frn.setAtt("k_mov", "visible", "N", "ctrlerr");					frn.setAtt("k_mov", "modify", "N", "k_parte");				frn.setAtt("k_mov", "visible", "Y", "k_parte");								frn.setAtt("k_mov", "modify", "N", "k_descr");				frn.setAtt("k_mov", "visible", "Y", "k_descr");					frn.setAtt("k_mov", "modify", "N", "k_q");				frn.setAtt("k_mov", "visible", "Y", "k_q");					frn.setAtt("k_mov", "modify", "N", "k_precio");				frn.setAtt("k_mov", "visible", "Y", "k_precio");											frn.setAtt("k_mov", "modify", "N", "k_monto");				frn.setAtt("k_mov", "visible", "Y", "k_monto");											frn.setAtt("k_mov", "modify", "N", "k_unidad");				frn.setAtt("k_mov", "visible", "Y", "k_unidad");																						frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											} /* END Func ConfiguraControlesOff() */									fun ConfiguraControlesOpcion(imodo) {				var text_grid;								text_grid = "Motivos validos : [P] Precio, [E] Existencia, [C] Venta otra Distribuidora  /  [F9] Catalogo Productos  /  CTRL + DEL Borrar Linea";							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta									frn.setAtt("k_coment", "modify", "Y");					frn.setAtt("k_coment2", "modify", "Y");					frn.setAtt("k_coment3", "modify", "Y");					frn.setAtt("k_coment", "available", "Y");					frn.setAtt("k_coment2", "available", "Y");					frn.setAtt("k_coment3", "available", "Y");								frn.setAtt("k_fecha", "available", "N");										frn.setAtt("grid", "tit", text_grid);				   // " [ F9 ] obtener valores de Catalogos ");										frn.setAtt("k_mov", "modify", "Y");					frn.setAtt("k_mov", "insdel", "Y");					//frn.setAtt("k_mov", "nren", "");										frn.setAtt("k_mov", "available", "N", "c_reemplazo");					frn.setAtt("k_mov", "modify", "N", "c_reemplazo");					frn.setAtt("k_mov", "visible", "N", "c_reemplazo");											frn.setAtt("k_mov", "modify", "N", "borrar");					frn.setAtt("k_mov", "visible", "N", "borrar");					frn.setAtt("k_mov", "modify", "N", "ctrlerr");					frn.setAtt("k_mov", "visible", "Y", "ctrlerr");										frn.setAtt("k_mov", "modify", "Y", "k_parte");					frn.setAtt("k_mov", "visible", "Y", "k_parte");									frn.setAtt("k_mov", "modify", "N", "k_descr");					frn.setAtt("k_mov", "visible", "Y", "k_descr");						frn.setAtt("k_mov", "modify", "Y", "k_q");					frn.setAtt("k_mov", "visible", "Y", "k_q");						frn.setAtt("k_mov", "modify", "Y", "k_precio");					frn.setAtt("k_mov", "visible", "Y", "k_precio");												frn.setAtt("k_mov", "modify", "N", "k_monto");					frn.setAtt("k_mov", "visible", "Y", "k_monto");												frn.setAtt("k_mov", "modify", "Y", "k_unidad");					frn.setAtt("k_mov", "visible", "Y", "k_unidad");																				frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");													} else {														if(tip_ope &= "B"){ //Baja											frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");											frn.setAtt("k_coment", "modify", "Y");						frn.setAtt("k_coment2", "modify", "Y");						frn.setAtt("k_coment3", "modify", "Y");						frn.setAtt("k_coment", "available", "Y");						frn.setAtt("k_coment2", "available", "Y");						frn.setAtt("k_coment3", "available", "Y");											frn.setAtt("grid", "tit", text_grid);												frn.setAtt("k_mov", "modify", "N");						frn.setAtt("k_mov", "insdel", "N");						//frn.setAtt("k_mov", "nren", "fijo");								frn.setAtt("k_mov", "available", "N", "c_reemplazo");						frn.setAtt("k_mov", "modify", "N", "c_reemplazo");						frn.setAtt("k_mov", "visible", "N", "c_reemplazo");										frn.setAtt("k_mov", "modify", "N", "borrar");						frn.setAtt("k_mov", "visible", "Y", "borrar");						frn.setAtt("k_mov", "modify", "N", "ctrlerr");						frn.setAtt("k_mov", "visible", "N", "ctrlerr");								frn.setAtt("k_mov", "modify", "N", "k_parte");						frn.setAtt("k_mov", "visible", "Y", "k_parte");										frn.setAtt("k_mov", "modify", "N", "k_descr");						frn.setAtt("k_mov", "visible", "Y", "k_descr");							frn.setAtt("k_mov", "modify", "N", "k_q");						frn.setAtt("k_mov", "visible", "Y", "k_q");							frn.setAtt("k_mov", "modify", "N", "k_precio");						frn.setAtt("k_mov", "visible", "Y", "k_precio");													frn.setAtt("k_mov", "modify", "N", "k_monto");						frn.setAtt("k_mov", "visible", "Y", "k_monto");													frn.setAtt("k_mov", "modify", "N", "k_unidad");						frn.setAtt("k_mov", "visible", "N", "k_unidad");																												frn.setAtt("Imprimir", "visible", "N");						frn.setAtt("Cancelar", "visible", "Y");						frn.setAtt("Aceptar", "visible", "Y");															} else {											frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("k_coment", "modify", "N");						frn.setAtt("k_coment2", "modify", "N");						frn.setAtt("k_coment3", "modify", "N");						frn.setAtt("k_coment", "available", "Y");						frn.setAtt("k_coment2", "available", "N");						frn.setAtt("k_coment3", "available", "N");												frn.setAtt("grid", "tit", text_grid);												frn.setAtt("k_mov", "modify", "N");						frn.setAtt("k_mov", "insdel", "N");						//frn.setAtt("k_mov", "nren", "fijo");											frn.setAtt("k_mov", "available", "N", "c_reemplazo");						frn.setAtt("k_mov", "modify", "N", "c_reemplazo");						frn.setAtt("k_mov", "visible", "Y", "c_reemplazo");														frn.setAtt("k_mov", "modify", "N", "borrar");						frn.setAtt("k_mov", "visible", "N", "borrar");						frn.setAtt("k_mov", "modify", "N", "ctrlerr");						frn.setAtt("k_mov", "visible", "N", "ctrlerr");									frn.setAtt("k_mov", "modify", "N", "k_parte");						frn.setAtt("k_mov", "visible", "Y", "k_parte");										frn.setAtt("k_mov", "modify", "N", "k_descr");						frn.setAtt("k_mov", "visible", "Y", "k_descr");							frn.setAtt("k_mov", "modify", "N", "k_q");						frn.setAtt("k_mov", "visible", "Y", "k_q");							frn.setAtt("k_mov", "modify", "N", "k_precio");						frn.setAtt("k_mov", "visible", "Y", "k_precio");													frn.setAtt("k_mov", "modify", "N", "k_monto");						frn.setAtt("k_mov", "visible", "Y", "k_monto");													frn.setAtt("k_mov", "modify", "N", "modelo");						frn.setAtt("k_mov", "visible", "N", "modelo");												frn.setAtt("Imprimir", "available", "Y");						frn.setAtt("Imprimir", "visible", "Y");						frn.setAtt("Cancelar", "visible", "N");						frn.setAtt("Aceptar", "visible", "N");						}				}			} /* END Func ConfiguraControlesOpcion() */			/*			fun LimpiaDatosDoc {				// Limpia todos los objetos asociados a los detalles incluido el k_mov				frn.set("k_mov", "");			} 			*/			/* END Func LimpiaDatosDoc() */			/*			fun LimpiaTotalesDoc {				// Limpia todos los objetos totalizadores asociados a los detalles y encabezados incluido el k_mov				// N.A.  para este formulario ...			} 			*/			/* END Func LimpiaTotalesDoc() */			/*			fun LimpiaEncabezado {				// Limpia todos los objetos asociados al encabezado por lo regular predecesores al k_mov				frn.set("k_fecha", "");			} 			*/			/* END Func LimpiaEncabezado() */						fun LimpiaDatosDoc {				//frn.set("k_refer", "");				//frn.set("k_fecref", "");				frn.set("k_mov", "");				frn.set("k_coment", "");				frn.set("k_coment2", "");				frn.set("k_coment3", "");			}						fun LimpiaTotalesDoc {				//frn.set("k_subtotal", "");				//frn.set("k_iva", "");				frn.set("k_monto", "");			}						fun LimpiaEncabezado {				frn.set("k_folio", "");				frn.set("k_docto", "");				frn.set("k_fecha", "");				frn.set("k_hora", "");			}									/*			fun CambiaSucursal(imodo) {				if (imodo != 1 && imodo != 2) {					LimpiaEncabezado();					frn.set("k_fecha",sys.date());				}				//frn.set("k_hora",sys.time());					//ArmarRefDocto();				row_grid = -1;							if (tip_ope &! tip_ope_original && imodo != 1 && imodo != 2) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						// if(tip_ope &= "B"){ //Baja						//	frn.set("operacion","BAJA");						//} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						// }					}				} 								if(tip_ope &! "A" || imodo == 1 || imodo == 2){					if (imodo != 1 && imodo != 2) {						frn.set("k_fecha","");					}					MostrarDatosGrd(imodo);					frn.setPos("k_mov", 0, "modelo");					Get_Data_Row();				}							} 			*/			/* END Func CambiaSucursal() */						fun CambiaSucursal {				LimpiaDatosDoc();				LimpiaTotalesDoc();				LimpiaEncabezado();				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());					ArmarRefDocto();				row_grid = -1;							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						}					}								}			}						fun CambiaTipo {				LimpiaDatosDoc();				LimpiaTotalesDoc();				LimpiaEncabezado();				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());					ArmarRefDocto();				row_grid = -1;								if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						}					}								}			}					   		   		   fun MostrarDOC(nFolio) {							var xmlGrd, flagErr;												flagErr = 0;								sucursal_id = frn.get("k_sucn",-1,1);								LimpiaDatosDoc();				LimpiaTotalesDoc();				LimpiaEncabezado();								cmdQuery = "" & 					"select w.c6 as folio, w.c9 as fecha, w.c11 as refer, w.c24 as cmnt1, w.c25 as cmnt2, w.c26 as cmnt3, w.c41 as fechref, w.c69 as hora from keplersc.kdm1 w " & 					"where w.c1 = '" & sucursal_id & "' and w.c2 = '" & gen_doc & "' and w.c3 = '" & nat_doc & "' and w.c4 = " & gpo_doc & " and w.c5 = " & tip_doc  & " " &					"and w.c6 = '" & nFolio & "' order by w.c6 desc";				//frn.message(cmdQuery,"Info !","Aceptar");								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.upd()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosdocbackorderentr");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					//frn.setAtt("Aceptar", "visible", "N");					//ConfiguraControlesOff();					frn.message("Sin Datos por mostrar ...","Info","Aceptar");					flagErr = 1;					ArmarRefDocto();					return;					//Cancela();					}	else {					if(tip_ope &! "C"){						frn.setAtt("Aceptar", "visible", "Y");					}				}				//frn.set(cuboQuery);								//if ( flagErr == 1 ) { Cancela(); }				ConfiguraControlesOpcion();								/*				frn.setX(getXmlAtt(cuboQuery,"r0", "folio"), "k_folio");				frn.setX(getXmlAtt(cuboQuery,"r0", "fecha"), "k_fecha");				frn.setX(getXmlAtt(cuboQuery,"r0", "refer"), "k_refer");				frn.setX(getXmlAtt(cuboQuery,"r0", "fechref"), "k_fecref");				frn.setX(getXmlAtt(cuboQuery,"r0", "hora"), "k_hora");				frn.setX(getXmlAtt(cuboQuery,"r0", "cmnt1"), "k_coment");				frn.setX(getXmlAtt(cuboQuery,"r0", "cmnt2"), "k_coment2");				frn.setX(getXmlAtt(cuboQuery,"r0", "cmnt3"), "k_coment3");				*/								frn.set("k_folio", getXmlAtt(cuboQuery,"r0", "folio"));				frn.set("k_fecha", getXmlAtt(cuboQuery,"r0", "fecha"));				//frn.set("k_refer", getXmlAtt(cuboQuery,"r0", "refer"));				//frn.set("k_fecref", getXmlAtt(cuboQuery,"r0", "fechref"));				frn.set("k_hora", getXmlAtt(cuboQuery,"r0", "hora"));				frn.set("k_coment", getXmlAtt(cuboQuery,"r0", "cmnt1"));				frn.set("k_coment2", getXmlAtt(cuboQuery,"r0", "cmnt2"));				frn.set("k_coment3", getXmlAtt(cuboQuery,"r0", "cmnt3"));								ArmarRefDocto();								MostrarDOCDet(nFolio);						}			fun MostrarDOCDet(nFolio) {					var refer;				var xmlGrd;																	sucursal_id = frn.get("k_sucn",-1,1);								//Reset campos				frn.set("k_mov", "");							CalculaTotales();								cmdQuery = "" &				"select x.c8 k_parte, x.c10 k_descr, x.c9 k_q, x.c11 k_unidad, x.c12 k_precio, x.c13 k_monto " &				", (select * from keplersc.reemplazo_prod_text(x.c8)) as c_reemplazo " & 				", k.c11 as c_especial, k.c17 as c_stock " & 				"from keplersc.kdm2 x " & 				"inner join keplersc.kdm1 m on m.c1 = x.c1 and m.c2 = x.c2 and m.c3 = x.c3 and m.c4 = x.c4 and m.c5 = x.c5 and m.c6 = x.c6 " & 				"left join keplersc.kdpedrefmov k on k.c1 = m.c1 and k.c2 = m.c11 and k.c3 = x.c8 " & 				"where x.c1 = '" & sucursal_id & "' and x.c2 = '" & gen_doc & "' and x.c3 = '" & nat_doc & "' and x.c4 = " & gpo_doc & " and x.c5 = " & tip_doc  & " " &				"and x.c6 = '" & nFolio & "' order by x.c7";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refbackordercrud.mostrardatosgrid()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosdocgrid_backorder");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.message("Sin Registros por mostrar ...","Info","Aceptar");					return;					}					//frn.set(cuboQuery);							rstXml(xmlGrd);				xmlGrd=frn.lib("libGeneral.kpl","CreaXmlDesdeTagRow",cuboQuery,"r","k_mov");				frn.lib("libGeneral.kpl","FileSave",xmlGrd, fileSavePath & "\mostrardatosdocgrid_backorder_parsed");				frn.setX(xmlGrd);												CalculaTotales();									return;						   } // End MostrarDOCDet()		   		   			fun CalculaTotales(iModo) {				var monto = 0, monto_acum = 0;				var cantValida = 1, rows;								rows = frn.N("k_mov") - 1; 				//Calcular totales				for (var i=0; i < rows/*frn.N("k_mov")*/; i++) {					if ( strlen(frn.get("k_mov",i,"k_parte")) != 0 ) {						monto = frn.get("k_mov",i,"k_q") * frn.get("k_mov",i,"k_precio");						monto_acum = monto_acum + monto;						frn.setX(monto, "k_mov", i, "monto");					} else {						frn.setX("", "k_mov", i, "monto");					}				}								//frn.set("k_subtotal",subTotal);				//frn.set("k_iva",iva);								frn.set("k_monto",monto_acum);								return cantValida;			}					   					// ZONA	CODIGO REPORTE(S) 						fun IniParams(){//Inicializa parámetros de impresión. Pueden ser cambiados por el usuario final mediante menú: Archivo -> Configurar Página				frn.set("param_paper","letter");	//Tamaño de papel predefinido:	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tamaño de papel personalizado	"size=21.59,27.94cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//Márgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0");	//Escala de impresión (1=100 por ciento)	"F=1,1"				frn.set("param_landscape","N");	//Orientación	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"				frn.set("param_emp","L");	//Posición de "Razón social"(izq,der,cen)	@emp=L|R|C"			}						fun setRepPage() {//Establece los parámetros finales de impresión.				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Ejecuta_Reporte() {							if (  ( frn.N("k_mov") == 0 ) || ( strlen( trim(frn.get("k_folio")) ) == 0 )  ) {					frn.message("Sin Registros por mostrar ...","Info","Aceptar");					return;				}							// Commented 20221208 				//IniParams(); //Inicializa parámtros de impresión entre otros							//Code Added 20121208 				/*				//rstXml(xmlPar);				*/								/*				if ( tip_ope_original &= "C" && tip_ope &= "C" ) {					CambiaSucursal(3); 				}				*/									// fech_original = "2022-11-03"; // 4 Testing				// tip_ope_original = "A"; // 4 Testing								//...(cubos de datos e información necesaria)				sucursal = frn.get("k_sucn",-1,1);				/*				if ( tip_ope_original &= "A" && tip_ope &= "C" ) {					fech_oper = fech_original; // frn.get("k_fecha");				}				tipo_auto = "NUEVO";				*/								/*				// setXml(xmlPar,"document","sucursal_id",sucursal);				*/								/*				if ( tip_ope_original &= "A" && tip_ope &= "C" ) {					setXml(xmlPar,"document","fech_oper", fech_oper); 				}				setXml(xmlPar,"document","tipo_auto", tipo_auto);				*/								//code Added 20221208 by JMM				/*				if ( strlen(frn.get("k_fecha")) > 0 ) { 					setXml(xmlPar,"document","fech_I", frn.get("k_fecha"));				}				if ( strlen(frn.get("k_fecha_F")) > 0 ) { 					setXml(xmlPar,"document","fech_F", frn.get("k_fecha_F"));				}					*/								/*				//setXml(xmlPar,"document","folio",frn.get("k_folio"));				//setXml(xmlPar,"document","fecha",frn.get("k_fecha"));				*/								/*				frn.lib("libGeneral.kpl","FileSave",xmlPar, fileSavePath & "\refalatapedcrud_rpt_xmlPar");												cmd="select * from keplersc.autos_com_asig_rpt('"& getXmlStr(xmlPar,"EOF:13_10") &"')";				rstXml(xmlResQuery);				xmlResQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comaltasigcrudN_rpt.Ejecuta_Reporte()");				ok=getXmlAtt(xmlResQuery ,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlResQuery ,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						frn.lib("libGeneral.kpl","FileSave",xmlResQuery, fileSavePath & "\comaltasigcrudN_rpt_xmlResQuery");								*/								Reporte();						} /* END Func Ejecuta_Reporte() */						fun Reporte() {							// Our Vars				var compania, titrep;				var contProd, contDet, tmpStr ,xmlDet, xmlCurDocto;				//var folio;				var p_fecha, var_fecha;				var p_subtotal, p_utilidad, p_perce, p_costo, p_total, p_iva;				var gt_subtotal, gt_utilidad, gt_perce, gt_costo, gt_total, gt_iva;								//Obtener datos generales				kdb.kde("KDE");//Configuracion del servidor				kdb.exec();				compania = kdb.get("KDE","1");									// Se define el formato a usar y se liga a la variable del reporte "rep"	// Se define el formato a usar y se liga a la variable del reporte "rep"				rep.rst(); // 20121208				IniParams(); // 20121208				kdb.readPage("datFto","refbackordercrudfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				//rep.rst(); // 20121208				setRepPage();//Establece los parámetros finales de impresión(rep.page(...);), pues pueden haber cambiado por el usuario 				//Da valor a los inputs del reporte(rep.set();), e indica la ejecución de "grupos de renglones de impresión" (rep.exe();)								/*				if ( tip_ope_original &= "A" && tip_ope &= "C" ) {					titrep = "Asignacion del Inventario - Autos Nuevos"; 					rep.set("suctx","suc.");					rep.set("leyendatx","Del dia " & fech_original);				} else {					titrep = "Unidades Asignadas sin dar de Entrada la Compra - Autos Nuevos";					rep.set("leyendatx","Sucursal " & sucursal);				}				*/								titrep = "ENTRADA A BACKORDER";								//code Added 20221208				/*				if ( tip_ope_original &! "A" && tip_ope &= "C" ) {					if ( strlen(frn.get("k_fecha")) > 0 ) { 						rep.set("fechItx","Desde : ");						rep.set("fechI",frn.get("k_fecha"));					}					if ( strlen(frn.get("k_fecha_F")) > 0 ) { 						rep.set("fechFtx","Hasta : ");						rep.set("fechF",frn.get("k_fecha_F"));							}					}				*/												rep.set("fecha",sys.date());				rep.set("hora",sys.time());				rep.set("nombreempresa",compania);				rep.set("tituloreporte",titrep);								rep.set("suc",sucursal);				rep.set("foldoc",frn.get("k_folio"));				rep.set("fechdoc",frn.get("k_fecha"));								//contProd=nXml(xmlResQuery);				contProd=frn.N("k_mov")-1;				rep.exe("encabezado");														for(var x=0; x<contProd; x++){									/*					rep.set("invent",getXmlAtt(xmlResQuery,"r"&x,"c_cveinv"));					rep.set("modelo",getXmlAtt(xmlResQuery,"r"&x,"c_cvemod"));					rep.set("anio",getXmlAtt(xmlResQuery,"r"&x,"c_anio"));					rep.set("descrip",getXmlAtt(xmlResQuery,"r"&x,"c_descrip"));					rep.set("serie",getXmlAtt(xmlResQuery,"r"&x,"c_serie"));					rep.set("color",getXmlAtt(xmlResQuery,"r"&x,"c_color"));					rep.set("vest",getXmlAtt(xmlResQuery,"r"&x,"c_vest"));					if ( tip_ope_original &= "A" && tip_ope &= "C" ) {						rep.set("suc",getXmlAtt(xmlResQuery,"r"&x,"c_suc"));					}					*/											rep.set("reemplazo",frn.get("k_mov",x,"c_reemplazo"));					rep.set("producto",frn.get("k_mov",x,"k_parte"));					rep.set("descrip",frn.get("k_mov",x,"k_descr"));					rep.set("cantidad",frn.get("k_mov",x,"k_q"));					rep.set("um",frn.get("k_mov",x,"k_unidad"));					rep.set("importe",frn.get("k_mov",x,"k_monto"));					/*					rep.set("stock",frn.get("k_mov",x,"c_stock"));					rep.set("especial",frn.get("k_mov",x,"c_especial"));					*/										rep.exe("detalle");				}						rep.set("c_subt",frn.get("k_monto"));				rep.set("c_iva",0);				rep.set("c_tot",frn.get("k_monto"));								rep.exe("total");										rep.set("c_cmnt1",frn.get("k_coment"));				rep.set("c_cmnt2",frn.get("k_coment2"));				rep.set("c_cmnt3",frn.get("k_coment3"));								rep.exe("coments");								//Modos de impresión 				rep.win(); //Muestra la vista previa de la impresión. A partir de la vista previa (Preprint) se decide si se imprime o no.				//rep.print("\\192.168.1.100\HPLaserJet"); //Envía el reporte directamente a una impresora, sin mostrar la vista previa.				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresión. No muestra la vista previa.				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardará el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html										} /* END Func Reporte() */									// END : ZONA	CODIGO REPORTE(S) 											} // End of class Main			</script></pag>