<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Bonos por L&#237;nea"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">	<tab/><txt fnt=",22" clr="0,0,0">Comisiones Variables</txt><tab/>	<br/>	<tab/>	<hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" 		clrBrdr="0,58,112" dim="36,5,10,17" brdr="0,5" tit="Criterio de selecci&#243;n" fnt="Arial,16"><txt> Sucursal:</txt>		<sp/>		<cmb id="k_sucn" dim="25,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="Y" Null="N" OnChange="ResetDetalle()"/>		<tab/><txt>Esquema:</txt>		<cmb id="k_esquema" dim="5,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y" fnt="Arial,0" Null="N" OnChange="ResetDetalle()"/>        <tab/><txt>Mes:</txt>		<cmb id="k_mes" dim="5,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y" fnt="Arial,0" Null="N" OnChange="ResetDetalle()"/>        <tab/><txt>A&#241;o:</txt>		<cmb  id="k_anio" dim="5,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y" fnt="Arial,0" Null="N" OnChange="ResetDetalle()"/><tab n="2"/>		<br/><tab n="12"/>		<txt>&#191;Copiar objetivos del mes pasado?: </txt>		<cmb id="k_pasado" dim="5,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" Null="N" OnChange="ResetDetalle()"/><tab n="2"/>		<img id="img_buscar" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="ObtenerEsquemaPeriodo()"/>			</grp>	<br/><br/><tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="36,14,10,17" brdr="0,5" tit="Detalle de Comisiones" fnt="Arial,16">		<sp/>		<tbl id="k_mov" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="70,10" modify="Y" Reorder="Y" available="Y">			<col name="Sucursal" id="k_t_suc" modify="N" type="capital" nc="2" visible="N"/>			<col name="Esquema" id="k_t_esquema" modify="N" type="capital" nc="5" visible="N"/>			<col name="Mes" id="k_t_mes" modify="N" type="capital" nc="2" visible="N"/>         			<col name="Anio" id="k_t_anio" modify="N" type="capital" nc="2" visible="N"/>						<col name="Consec" id="k_t_consec" modify="N" type="number" nc="2" visible="Y" available="N"/>         <col id="k_t_ns" name="N/S" modify="Y" type="capital" nc="1" visible="Y" available="Y"/>			<col id="k_t_descripcion" name="Descripci&#243;n" type="capital" nc="30" visible="Y" modify="Y" available="Y"/>						<col id="k_t_porcomis" type="number" nc="5" visible="Y" nd="2" min="0.01" max="100.00" name="Comisi&#243;n" modify="Y" available="Y"/>			<col id="k_t_objetivo" name="Objetivo" type="number" nc="5" nd="2" min="1.00" max="100.00" visible="Y" available="Y" modify="Y"/>			<col id="k_t_resultado" name="Resultado" type="number" nc="5" nd="2" min="1.00" max="100.00" visible="Y" modify="Y" available="Y"/>		</tbl>		<br/><sp/>		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Guardar" hk="K" default="1" step="0"  OnEnter="Guardar()" fnt="Arial,16"/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;		var tipoOper,consPlantilla, accion; //Variables relacionadas con parametros (colsulta , eliminar, baja)		var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna, clave, modelo, clave_2; 		var cmdQuery, cuboQuery, ok, mensajeError;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			rol_usuario = frn.config("user","role");			asterisco = "*";			tipoOper = frn.param(0);			clave = frn.param(1);			llena_combos();			ConfiguraUI();			Inicializa();		}            		fun llena_combos(){									//Llenar combo sucursales			var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmd = cmd & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmd = cmd & " where c1='" & suc_usuario & "'";				}			}							var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");					ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}								frn.set("k_sucn",getXml(cubo));							//Esquema			cmdQuery = "select c1 as esquema from keplersc.kdesqgv";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comdevdircrud.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}						frn.set("k_esquema",cuboQuery);						//Anio			cmdQuery = "SELECT concat('20',substring(table_name,5,2)) as anio FROM INFORMATION_SCHEMA.TABLES 							WHERE TABLE_NAME LIKE 'kdc22%'							group by anio							order by anio desc";			rstXml(cuboQuery);										cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comdevdircrud.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}						frn.set("k_anio",cuboQuery);			frn.set("k_anio",mid(fnDate(sys.date()),0,4));						//Mes			cmdQuery = "select substring(table_name,7,2) as mes from information_schema.tables				where table_name  like 'kdc22%'  and substring(table_name,7,2) != '' group  by mes";			rstXml(cuboQuery);												cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comdevdircrud.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}									frn.set("k_mes",cuboQuery);			frn.set("k_mes",mid(fnDate(sys.date()),5,2));						//Opcion copiar mes pasado			frn.setX("NO","k_pasado",0,0);			frn.setX("N","k_pasado",0,1);			frn.setX("SI","k_pasado",1,0);			frn.setX("S","k_pasado",1,1);			ObtenerEsquemaPeriodo();		}				fun ResetDetalle(){			frn.rst("k_mov");		}				fun ObtenerEsquemaPeriodo(){			var xmlPantalla,no_partidas;			ResetDetalle();						xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaLineas");						cmdQuery = "select sucursal,esquema,mes,anio,consecutivo,ns,descripcion,porcomis,objetivo,resultado from keplersc.com_comisvariables_sel('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_comisionesvariables.ObtenerEsquemaPeriodo");			frn.lib("libGeneral.kpl","FileSave",cuboQuery,"C:\Basura\xmlCuboQuery");						ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}						frn.set("k_mov",cuboQuery);						no_partidas=frn.N("k_mov") - 1;			if (no_partidas==0) {				frn.message("No se encontraron registros","Mensaje","Aceptar");				return;			}					}				fun Guardar(){			var xmlPantalla,no_partidas,resultado,mensaje,adicionales;			var cont;			//Validaciones			no_partidas=frn.N("k_mov") - 1;			if (no_partidas==0) {				frn.message("Error, no se tiene registros de configuración","Error","Aceptar");				return;			}									for (cont=0; cont<no_partidas; cont++){				if(frn.get("k_mov",cont,"k_t_ns") &! "N" && frn.get("k_mov",cont,"k_t_ns") &! "S"){					frn.message(frn.get("k_mov",cont,"k_t_ns"),"Error","Aceptar");					//frn.message("Utilice[N] ó [S] para Nuevo o Seminuevo en renglón: " & cont,"Error","Aceptar");					return;				}				if(frn.get("k_mov",cont,"k_t_descripcion") &= ""){					frn.message("Descripción no válida en renglón: " & cont+1,"Error","Aceptar");					return;				}				if(frn.get("k_mov",cont,"k_t_porcomis") &= ""){					frn.message("Porcentaje de comisión no válido en renglón: " & cont+1,"Error","Aceptar");					return;				}				if(frn.get("k_mov",cont,"k_t_objetivo") &= ""){					frn.message("Porcentaje de objetivo no válido en renglón: " & cont+1,"Error","Aceptar");					return;				}												if(frn.get("k_mov",cont,"k_t_resultado") &= ""){					frn.message("Porcentaje de resultado no válido en renglón: " & cont+1,"Error","Aceptar");					return;				}			} //Fin for validacion de datos en grid						//Registro en BD			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			no_partidas=no_partidas-1;			setXml(xmlPantalla ,"k_partidas","no_partidas",no_partidas);						frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaComisVariables");			cmdQuery="select * from keplersc.com_comisvariables_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						kdb.rst(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"carga_refacciones.Alta");			resultado= getXml(cuboQuery,"resultado");			mensaje= getXml(cuboQuery,"mensaje");							if(resultado &= "0"){				frn.message(mensaje,"Error","Aceptar");				return;			}			frn.set("k_pasado","NO");			ObtenerEsquemaPeriodo();			frn.message("Esquema registrado","Mensaje","Aceptar");		}				fun ConfiguraUI(){			if (frn.nParam() == 0){				frn.message("Acción no permitida.","Error","&Aceptar");//				frn.open("redirect",2);				return;			}		}				fun Inicializa(){			frn.rst("gpo_2");		}			}	</script></pag>