<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">
<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0">
	<br/>
	<br/>
	<tab/>
    <grp id="gpo_general" bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="85,26,7,11" brdr="0,5" fnt="Arial,16" tit="Datos Recoleccion">
		<br/><txt fnt=",b">  Domicilio : </txt>
		<br/><txt>  Calle: </txt>
		<inp id="calle" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="0,2"  dim="50,1" fnt="Arial,16" type="capital" modify="Y" available="Y" nc="70" visible="Y"/>
		<sp/><txt>No.Ext.:</txt>
		<inp id="num_ext" dim="6,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y"  brdr="0,2" nc="6" fmt="5"/>
		<sp/><txt>  No.Int.:</txt>
		<inp id="num_int" dim="3,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y"  brdr="0,2"/><br/>
		<txt>  Colonia: </txt>
		<inp id="colonia" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="0,2" dim="38,1" fnt="Arial,16" type="capital" modify="Y" available="Y" nc="70" visible="Y"/>
		<sp/><txt>Poblacion: </txt>
		<inp id="poblacion" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="0,2" dim="25,1" fnt="Arial,16" type="capital" modify="Y" available="Y" nc="50" visible="Y"/>
		<br/><txt>  Municipio: </txt>
		<inp id="municipio" dim="29,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y"  brdr="0,2"/>
		<sp/><txt>Estado: </txt>
		<inp id="estado" dim="20,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y"  brdr="0,2"/>
		<sp/><txt>CP: </txt>
		<inp id="cp" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="0,2" dim="10,1" fnt="Arial,16" type="string" modify="Y" available="Y" nc="5" visible="Y"/>
		<br/><br/><txt>  Contacto:</txt>
		<inp id="contacto" dim="73,1" clr="64,64,64" clrBrdr="255,255,255"
			type="capital" modify="Y" available="Y" nc="50" bclr="255,255,255" brdr="0,2"/>
		<sp n="2"/><br/><txt>  Fecha recoleccion: </txt>
		<edt id="fecha" dim="12,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha" OnF9="Dialog(3,_ks_fecha,fecha)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" brdr="0,2"/>
		<sp/><txt>Hora:</txt>
		<inp id="horario" dim="6,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="time" brdr="0,2"/><txt>(00:00)    Unidad se regresa a domicilio S/N: </txt>
		<inp id="regresa_domicilio" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="0,2" dim="3,1" fnt="Arial,16" type="capital" modify="Y" available="Y" nc="1" visible="Y" OnChange="ValidaSoN(regresa_domicilio)"/>
		<br/><txt>  Observaciones: </txt><br/>
		<sp n="2"/><inp id="observaciones" dim="81,2" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y"  brdr="0,2"/>
	   <br/>
      <br/>
		<tab n="12"/>
		<bot id="bot_aceptar" dim="14,0" brdr="5" text="Aceptar" hk="K" step="0" OnEnter="Aceptar()"/>
      <br/>
	</grp>
</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,frP,kdb,sys,cmd,cubo,ok,mensajeError;
			var sucursal_id,origen,folio,tipo_ope;
			fun Main(){
				frn=new FRNT;
				kdb=new KDB;
				frP=new FRNTP;
				sys=new SYS;
				kdb.connect();
				/*
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				perfil_usuario = frn.lib("libKepler","UserInfo(2)");
				rol_usuario = frn.config("user","role");
				*/
				sucursal_id = frn.param(0);         //Sucursal
				origen = frn.param(1);					//Origen C-citas O-ordenes
				folio = frn.param(2);					//Tipo operacion 0=Alta 1=Modificacion
				folio = frn.param(3);					//No. cita o No. orden
				Inicializa();
				frn.setPos("calle");

			}

			fun Aceptar(){
				frP.set("calle_recoleccion",frn.get("calle"));
				frP.set("num_ext_recoleccion",frn.get("num_ext"));
				frP.set("num_int_recoleccion",frn.get("num_int"));
				frP.set("colonia_recoleccion",frn.get("colonia"));
				frP.set("poblacion_recoleccion",frn.get("poblacion"));
				frP.set("municipio_recoleccion",frn.get("municipio"));
				frP.set("estado_recoleccion",frn.get("estado"));
				frP.set("cp_recoleccion",frn.get("cp"));
				frP.set("contacto_recoleccion",frn.get("contacto"));
				frP.set("fecha_recoleccion",frn.get("fecha"));
				frP.set("horario_recoleccion",frn.get("horario"));
				frP.set("regresa_domicilio",frn.get("regresa_domicilio"));
				frP.set("observaciones_recoleccion",frn.get("observaciones"));
                frn.exit();                    
			}

					
			fun Inicializa(){
				frn.rst("gpo_general");
				Inicia_Forma();	

				}

			fun Inicia_Forma(){
				frn.set("calle",frP.get("calle_recoleccion"));
				frn.set("num_ext",frP.get("num_ext_recoleccion"));
				frn.set("num_int",frP.get("num_int_recoleccion"));
				frn.set("colonia",frP.get("colonia_recoleccion"));
				frn.set("poblacion",frP.get("poblacion_recoleccion"));
				frn.set("municipio",frP.get("municipio_recoleccion"));
				frn.set("estado",frP.get("estado_recoleccion"));
				frn.set("cp",frP.get("cp_recoleccion"));
				frn.set("contacto",frP.get("contacto_recoleccion"));
				if (frP.get("fecha_recoleccion") &="" || frP.get("fecha_recoleccion") &="1800-01-01T00:00:00"){
					frn.set("fecha",sys.date());
				} else{
					frn.set("fecha",frP.get("fecha_recoleccion"));
				}	
				frn.set("horario",frP.get("horario_recoleccion"));
				frn.set("regresa_domicilio",frP.get("regresa_domicilio"));
				frn.set("observaciones",frP.get("observaciones_recoleccion"));
			}

			fun ValidaSoN(campo){
                if (frn.get(campo) &! "S" && frn.get(campo) &! "N"){
                    frn.setPos(campo);
                    frn.message("Sólo puede ser S o N","Error","&Aceptar");
                    return;
                }  
			}
//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------GAD fl4r30n
						
			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){
				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO
							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana
							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)
							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje
				*/
				var prefix=frn.lib("libKepler","langPrefix");
				var page=prefix&pag;
				var b_valido=1;
				if(iModo==0)page=pag;
				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.
					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;
				}
				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);
			}
		}
	</script>
</pag>