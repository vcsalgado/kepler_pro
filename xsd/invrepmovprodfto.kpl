<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de " scale="48">	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,15" unfont="0">		<br exe="encabezado"/>		<hLine dim="90,0" g="2" type="1"/>		<br exe="encabezado"/>		<grp dim="10,7,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>		<tab n="1"/>		<grp dim="62,5,7,12">			<br/>			<inp id="k_empresa" fnt=",20b" dim="80,1" clr="0,58,112" type="string" available = "N"/>			<br/>			<txt fnt=",16b" clr="0,58,112">Reporte de Movimientos por Producto del </txt>			<inp id="k_fecha_ini" fnt=",16b" dim="10,1" clr="0,58,112" type="date" just="C" fmt="DD/MM/CCYY" available = "N"/>			<txt fnt=",16b" clr="0,58,112"> al </txt>			<inp id="k_fecha_fin" fnt=",16b" dim="10,1" clr="0,58,112" type="date" just="C" fmt="DD/MM/CCYY" available = "N"/>			<br/>				<inp id="k_sucursal" fnt=",16b" dim="80,1" clr="0,58,112" type="string" available = "N"/>			<br/>		</grp>		<tab n="1"/>		<grp dim="20,5,7,12">			<br/>			<txt>P&#225;g:</txt><tab/><inp id="k_pag" dim="4,1" type="number" just="L" mcr="k_pag"/>			<br/>			<txt>Fecha:</txt><tab/><inp id="k_fecha_imp" dim="10,1" type="date" just="L" fmt="DD-MM-CCYY"/>			<br/>			<txt>Hora:</txt><sp/><tab n="1"/><inp id="K_hora_imp" dim="5,1" type="time" just="L"/>		</grp>		<br exe="encabezado"/>		<sp/><txt fnt=",-1b">Fecha</txt>		<tab n="2"/><txt fnt=",-1b">Documento</txt>		<tab n="3"/><txt fnt=",-1b">Descripci&#243;n</txt>		<tab n="5"/><txt fnt=",-1b">Entradas</txt>		<tab n="2"/><txt fnt=",-1b">Salidas</txt>		<tab n="2"/><txt fnt=",-1b">Unidad</txt>		<tab n="1"/><txt fnt=",-1b">Tipo</txt>		<tab n="3"/><txt fnt=",-1b">Monto</txt>			<br exe="encabezado"/>		<hLine dim="90,0" g="2" type="1"/>		<br exe="encabezado"/>				<sp/><inp id="k_clave_producto" dim="10,1" type="string" fnt=",-1b"/>		<sp/><inp id="k_producto_descripcion" dim="30,1" type="string" fnt=",-1b"/>			<br exe="seccion_inicial"/>						<sp/><txt fnt=",-1b">Inicial</txt>		<tab n="8"/><inp id="k_inventario_inicial" dim="10,1" type="decimal" fnt=",-1b"just="R"/>		<tab n="14"/><inp id="k_monto_inicial" dim="10,1" type="decimal" fnt=",-1b"just="R"/>		<br exe="seccion_inicial"/>						<sp/><inp id="k_fecha" dim="7,1" type="date" just="L" fmt="DD/MM/CCYY"/>		<tab n="1"/><inp id="k_documento" dim="12,1" type="string"/>		<tab n="1"/><inp id="k_descripcion" dim="20,1" type="string"/>				<tab n="1"/><inp id="k_entradas" dim="8,1" type="decimal" just="R"/>		<tab n="1"/><inp id="k_salidas" dim="8,1" type="decimal" just="R"/>		<tab n="2"/><inp id="k_unidad" dim="3,1" type="string"/>		<tab n="1"/><inp id="k_tipo" dim="4,1" type="string"/>		<tab n="1"/><inp id="k_monto" dim="10,1" type="decimal" just="R"/>		<br exe="seccion_detalle"/>					<sp/><txt fnt=",-1b">Total</txt>		<tab n="7"/><inp id="dummy_total" dim="20,1" type="string"></inp>				<tab n="1"/><inp id="k_total_prod_entradas" dim="8,1" type="decimal" fnt=",-1b" just="R"/>		<tab n="1"/><inp id="k_total_prod_salidas" dim="8,1" type="decimal" fnt=",-1b" just="R"/>		<tab n="6"/><inp id="k_total_prod_monto" dim="10,1" type="decimal" fnt=",-1b" just="R"/>		<br exe="seccion_total_prod"/>										<sp/><txt fnt=",-1b">Final</txt>		<tab n="8"/><inp id="k_inventario_final" dim="10,1" type="decimal" fnt=",-1b" just="R"/>		<tab n="14"/><inp id="k_monto_final" dim="10,1" type="decimal" fnt=",-1b" just="R"/>		<br exe="seccion_final_prod"/>		<br exe="seccion_final_prod"/>						<hLine dim="90,0" g="2" type="1"/>		<br exe="seccion_total_reporte"/>				<sp/><txt fnt=",-1b">Valor Final del Inventario</txt>		<tab n="4"/><inp id="k_inventario_reporte" dim="10,1" type="decimal" fnt=",-1b" just="R"/>		<tab n="14"/><inp id="k_monto_reporte" dim="10,1" type="decimal" fnt=",-1b" just="R"/>		<br exe="seccion_total_reporte"/>	</grp></pag>