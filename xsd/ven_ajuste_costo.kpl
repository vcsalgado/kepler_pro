<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>	<tab/><inp id="k_titulo" dim="65,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213" type="string" modify="N" available="N" fnt="Arial,22"/>	<br/>	<br/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grupo_crud" dim="66,33,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" available="Y" tit="Actualizar Costo"><tab/>			<br/>			<sp/><txt fnt=",">Sucursal:</txt><sp/><tab/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="50,1" bclr="254,254,254" brdr="0,0" fnt="Arial,16" Null="N" hk="S"  					OnChange="resetCampos()" available="Y" modify="Y"/><tab/>						<br/>						<sp/><txt>Inventario: </txt><sp/><tab/>			<inp id="inventario" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="10" available="Y" 				OnF9="ConsultarInventario"  OnChange="MostrarInventario" tooltip="Clave del Inventario" modify="Y"/>			<br/><br/>			<sp/><txt fnt=",b">Compra: </txt>			<inp id="movcompra" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="30" clrBrdr="255,255,255" tooltip="Movimiento de compra" available="N" modify="N"/><tab/><txt>Fecha:</txt>			<inp id="fecha_compra" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" modify="N" available="N" fmt="DD/MM/CCYY" nc="-1"/><tab/>			<br/><tab n="6"/>			<txt fnt=",14b">Costo</txt><tab n="4"/><txt fnt=",14b">IVA</txt><tab n="4"/><txt fnt=",14b">Total</txt>			<br/>			<tab n="2"/><txt fnt=",14b">Actual:</txt><tab/>						<inp id="costo_compra" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" nd="2"/><tab/>						<inp id="iva_compra" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" nd="2"/><tab/>						<inp id="total_compra" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" nd="2"/><tab/>			<br/><tab n="2"/><txt fnt=",14b">Nuevo </txt><tab/>			<inp id="monto_costo" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" max="99999999"				OnChange="ActualizarTotal"/><tab/>			<inp id="monto_iva" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" max="99999999"				OnChange="ActualizarTotal"/><tab/>			<inp id="monto_total" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" modify="N" available="N"/>			<br/><br/>			<txt fnt=",b"> Venta:</txt><tab/>			<inp id="movvta" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="30" clrBrdr="255,255,255" tooltip="Movimiento de venta" available="N" modify="N"/><tab/><txt>Fecha:</txt>			<inp id="fecha_vta" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" modify="N" available="N" fmt="MM/DD/CCYY" nc="-1"/>						<br/><tab n="6"/><txt fnt=",b">Precio</txt><tab n="4"/><txt fnt=",14b">IVA</txt><tab n="4"/><txt fnt=",14b">Total</txt>			<br/><tab n="5"/>					<inp id="precio_venta" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" nd="2"/><tab/>						<inp id="iva_venta" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" nd="2"/><tab/>						<inp id="total_venta" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" nd="2"/><tab/>			<br/><br/><txt fnt=",b"> Vale :</txt><tab/>			<inp id="movvale" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="30" clrBrdr="255,255,255" tooltip="Vale de salida" available="N" modify="N"/><tab/><txt>Fecha:</txt>			<inp id="fecha_vale" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" modify="N" available="N" fmt="DD/MM/CCYY" nc="-1"/>			<br/><sp/><tab/>			<br/>            <tab n="8"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="0" visible="Y" available="Y"/><br/>			<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP, accion,externo, clave_sel,sucursal_id,cve_color,resVal,straccion;         var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError;			var usuario,suc_usuario, rol_usuario,asterisco,refer_orden,nuevo_folio, etiqueta_necesarias , etiqueta_cargadas  ;            			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();								usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";											   Inicializa();				ctlrs_off();				ctlrs_opcion();			}						fun Inicializa(){				var cmd;				frn.set("k_titulo", "Actualizar Costo de Inventario");				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";								if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR" && rol_usuario &! ""){											cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",getXml(cubo));			}						fun ctlrs_off(){			}							fun ctlrs_opcion(){				frn.setAtt("btn_aceptar", "available", "Y" );						}						fun ResetDatos(){				frn.set("inventario","");				frn.set("movcompra","");				frn.set("fecha_compra","");				frn.set("costo_compra","");				frn.set("iva_compra","");				frn.set("total_compra","");				frn.set("monto_costo","");				frn.set("monto_iva","");				frn.set("monto_total","");				frn.set("movvta","");				frn.set("fecha_vta","");				frn.set("precio_venta","");				frn.set("iva_venta","");				frn.set("total_venta","");				frn.set("movvale","");				frn.set("fecha_vale","");			}							fun ConsultarInventario(){					ResetDatos();				cmdQuery="select vta.c100 as inventario, vta.c2||'-'||vta.c3||'-'||vta.c4||'-'||vta.c5||'-'||vta.c6 as movvta,				to_char(vta.c9, 'dd/mm/yyyy') as fecha_vta,vta.c16 as importe_venta, vta.c14 as iva_venta,				mc.c2||'-'||mc.c3||'-'||mc.c4||'-'||mc.c5||'-'||mc.c6 as movcompra,mc.c9 as fecha_compra, mc.c16 as importe_compra, mc.c14 as iva_compra,				val.c2||'-'||val.c3||'-'||val.c4||'-'||val.c5||'-'||val.c6 as movvale,val.c9 as fecha_vale				from keplersc.kdm1 vta 				left outer join keplersc.kdm1 mc on vta.c1=mc.c1 and vta.c100=mc.c100				and mc.c2='X' and mc.c3='A' and (mc.c4=6 or mc.c4=7) 				left outer join keplersc.kdm1 val on vta.c1=val.c1 and vta.c100=val.c100				and val.c2='N' and val.c3='A' and val.c4=13 				where vta.c1='01' and vta.c2='U' and vta.c3='D' and vta.c4=6 				and vta.c6 not in (select mexv.c39 from keplersc.kdm1 mexv where vta.c1=mexv.c1 and vta.c6=mexv.c39)				and mc.c6 not in(select kexc.c39 from keplersc.kdm1 kexc where kexc.c1=mc.c1 and mc.c6=kexc.c39)				and val.c43 <>'C'";				if (frn.get("inventario" &! "")){					cmdQuery = cmdQuery & " and val.c100='" & frn.get("inventario") &"' ";				}				cmdQuery = cmdQuery & "order by val.c100";								frn.dialog("genlistafiltrosel","Inventario vendidos",cmdQuery,"inventario","inventario","0","","N","N");			}			fun MostrarInventario(){				var xmlInvent;				cmdQuery="select vta.c100 as inventario, vta.c2||'-'||vta.c3||'-'||vta.c4||'-'||vta.c5||'-'||vta.c6 as movvta, 				vta.c9 as fecha_vta,vta.c16 as total_venta, vta.c14 as iva_venta, vta.c16-vta.c14 as precio_venta,				mc.c2||'-'||mc.c3||'-'||mc.c4||'-'||mc.c5||'-'||mc.c6 as movcompra,mc.c9 as fecha_compra, mc.c16 as total_compra, 				mc.c14 as iva_compra, mc.c16-mc.c14 as costo_compra,				val.c2||'-'||val.c3||'-'||val.c4||'-'||val.c5||'-'||val.c6 as movvale,val.c9 as fecha_vale				from keplersc.kdm1 vta 				left outer join keplersc.kdm1 mc on vta.c1=mc.c1 and vta.c100=mc.c100				and mc.c2='X' and mc.c3='A' and (mc.c4=6 or mc.c4=7) 				left outer join keplersc.kdm1 val on vta.c1=val.c1 and vta.c100=val.c100				and val.c2='N' and val.c3='A' and val.c4=13 				where vta.c1='01' and vta.c2='U' and vta.c3='D' and vta.c4=6 				and vta.c6 not in (select mexv.c39 from keplersc.kdm1 mexv where vta.c1=mexv.c1 and vta.c6=mexv.c39)				and mc.c6 not in(select kexc.c39 from keplersc.kdm1 kexc where kexc.c1=mc.c1 and mc.c6=kexc.c39)				and val.c43 <>'C' and val.c100='";				cmdQuery=cmdQuery & frn.get("inventario") & "' ";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ven_ajuste_costo.MostrarInventario()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\xmlInventario");				rstXml(xmlInvent);				xmlInvent=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cubo,"r0");				frn.setX(xmlInvent);			}			fun ActualizarTotal(){				var monto, iva, total;				monto=frn.get("monto_costo");				iva=frn.get("monto_iva");				total=monto+iva;				frn.set("monto_total",total);											}			fun ValidarDatos(){				var monto, iva, inventario;				inventario=frn.get("inventario");				monto=frn.get("monto_costo");				iva=frn.get("monto_iva");				if(inventario&=""){					resVal=0;					frn.message("Debe ingresar un inventario.","Error","Aceptar");				}				if(monto<iva){					resVal=0;					frn.message("El IVA no puede ser mayor al monto","Error","Aceptar");									}			}			fun Execute() {				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}								var resultado_confirmacion = frn.message("¿Confirma el proceso de ajuste de costo?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}								xmlRequest = getXml(frn.dataPag());				setXml(xmlRequest,"movimiento","usuario",usuario);				frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestCosto");									cmdQuery="SELECT * FROM keplersc.autos_com_costo_upd('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"ven_ajuste_costo.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");				var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.message("Proceso terminado.");								ResetDatos();			}							}	</script></pag>