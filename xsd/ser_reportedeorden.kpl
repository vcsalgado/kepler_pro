	if (nXml(xmlAlt) > 0) { rep.exe("section-carg_line"); }					// END Cargos Varios ...					rep.exe("section-puntos-det-final");									}	// End For PUNTOS {cuboQuery}						//if (nXml(cuboQuery) > 0) { rep.exe("section-puntos-final"); }								// DATOS TOTALES ORDEN 								h11 = 0;								dato_id = "";				cmdQuery = "select c11 as h11 from keplersc.kdmargen where c1 = '" & v_tipoorden & "'";				rstXml(xmlDet);				xmlDet = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",xmlDet, fileSavePath & "\ser_ordenrpt_data_h_rpt");				ok=getXmlAtt(xmlDet,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlDet,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(xmlDet,"r0", "h11");				if ( strlen(dato_id) == 0 ) {					// Not records found				} else {					h11 = getXmlAtt(xmlDet,"r0", "h11");				}					b14 = 0;				b15 = 0;				b16 = 0;				b17 = 0;				b18 = 0;								b14 = b10 + b11 + b12 + b13;				b16 = b14 - b15;				b17 = (b16 * h11) / 100;				b18 = b16 + b17;								rep.set("totord_mo",b10);									rep.set("totord_ref",b11);				rep.set("totord_tots",b12);				rep.set("totord_carg",b13);								rep.set("totord_subt1",b14);				rep.set("totord_desc",b15);				rep.set("totord_subt2",b16);				rep.set("totord_iva",b17);				rep.set("totord_total",b18);								rep.exe("section-totales-orden");												// DATOS FACTURACION ORDEN 								dato_id = "";				cmdQuery = "select c6 as g6, c51 as g51, c52 as g52, c53 as g53, c54 as g54, c9 as g9, c10 as g10, c32 as g32, c33 as g33, " & 				"c34 as g34, c35 as g35, c22 as g22, c51 as g51, c52 as g52, c53 as g53, c54 as g54, c13 as g13, c14 as g14, c16 as g16 " & 				"from keplersc.kdm1 where c1 = '" & i1 & "' and c2 = '" & i40 & "'" & " and c3 = '" & i41 & "' and c6 = '" & i44 & "' " &				" and c4 = " & i42 & "and c5 = " & i43;				rstXml(xmlAlt);				xmlAlt = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",xmlAlt, fileSavePath & "\ser_ordenrpt_data_g_rpt");				ok=getXmlAtt(xmlAlt,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlAlt,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(xmlAlt,"r0", "g6");				if ( strlen(dato_id) == 0 ) {					// Not records found				} else {									dato_id = "";					cmdQuery = "select c5 as f5 from keplersc.kdmm " & 					"where c1 = '" & i40 & "' and c2 = '" & i41 & "'" & " and c3 = " & i42 & " and c4 = " & i43; 					rstXml(xmlDet);					xmlDet = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");					frn.lib("libGeneral.kpl","FileSave",xmlDet, fileSavePath & "\ser_ordenrpt_data_f_rpt");					ok=getXmlAtt(xmlDet,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(xmlDet,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					dato_id = getXmlAtt(xmlDet,"r0", "f5");					if ( strlen(dato_id) == 0 ) {						// Not records found					} else {						f5 = getXmlAtt(xmlDet,"r0", "f5");					}									g51 = getXmlAtt(xmlAlt,"r0", "g51");					g52 = getXmlAtt(xmlAlt,"r0", "g52");					g53 = getXmlAtt(xmlAlt,"r0", "g53");					g54 = getXmlAtt(xmlAlt,"r0", "g54");					g9 = getXmlAtt(xmlAlt,"r0", "g9");					g10 = getXmlAtt(xmlAlt,"r0", "g10");					g32 = getXmlAtt(xmlAlt,"r0", "g32");					g33 = getXmlAtt(xmlAlt,"r0", "g33");					g34 = getXmlAtt(xmlAlt,"r0", "g34");					g35 = getXmlAtt(xmlAlt,"r0", "g35");					g22 = getXmlAtt(xmlAlt,"r0", "g22");					g51 = getXmlAtt(xmlAlt,"r0", "g51");					g52 = getXmlAtt(xmlAlt,"r0", "g52");					g53 = getXmlAtt(xmlAlt,"r0", "g53");					g54 = getXmlAtt(xmlAlt,"r0", "g54");					g13 = getXmlAtt(xmlAlt,"r0", "g13");					g14 = getXmlAtt(xmlAlt,"r0", "g14");					g16 = getXmlAtt(xmlAlt,"r0", "g16");										r10 = i40 & i41 & PadLeft(i42,"2","0") & PadLeft(i43,"3","0") & "-" & i44;					b1 = g51 + g52 + g53 + g54;										rep.set("docfech",g9);					rep.set("docfolio",r10);					rep.set("docdscr",f5);										rep.set("factcve",g10);					rep.set("factclie",g32);					rep.set("factdir",g33);					rep.set("factcol",g34);					rep.set("factedo",g35);					rep.set("factrfc",g22);										rep.set("fact_mo",g51);					rep.set("fact_ref",g52);					rep.set("fact_tots",g53);					rep.set("fact_carg",g54);										rep.set("fact_subt",b1);					rep.set("fact_desc",g13);					rep.set("fact_iva",g14);					rep.set("fact_total",g16);									rep.exe("section-fact");									}															// Historial Documentos ...				dato_id = "";				cmdQuery = "select c6 as cv6, c7 as cv7, c8 as cv8, c9 as cv9, c10 as cv10, c11 as cv11, c12 as cv12, c13 as cv13, " &				"c20 as cv20, c21 as cv21, c22 as cv22, c23 as cv23, c24 as cv24, c25 as cv25, c26 as cv26 " & 				"from keplersc.kdvntall " &				"where c1 = '" & i1 & "' and c2 = '" & i2 & "'" & " and c3 = '" & i3 & "'";				rstXml(xmlAlt);				xmlAlt = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",xmlAlt, fileSavePath & "\ser_ordenrpt_data_cv_rpt");				ok=getXmlAtt(xmlAlt,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlAlt,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									/*if (nXml(xmlAlt) > 0) { rep.exe("section-carg"); }*/ // This N.A. for this section 								rep.exe("section-hist");									if (nXml(xmlAlt) > 0) {										for(var yx=0; yx < nXml(xmlAlt); yx++)					{													cv6 = getXmlAtt(xmlAlt,"r"&yx,"cv6");						cv7 = getXmlAtt(xmlAlt,"r"&yx,"cv7");						cv8 = getXmlAtt(xmlAlt,"r"&yx,"cv8");						cv9 = getXmlAtt(xmlAlt,"r"&yx,"cv9");						cv10 = getXmlAtt(xmlAlt,"r"&yx,"cv10");						cv11 = getXmlAtt(xmlAlt,"r"&yx,"cv11");						cv12 = getXmlAtt(xmlAlt,"r"&yx,"cv12");						cv13 = getXmlAtt(xmlAlt,"r"&yx,"cv13");						cv20 = getXmlAtt(xmlAlt,"r"&yx,"cv20");						cv21 = getXmlAtt(xmlAlt,"r"&yx,"cv21");						cv22 = getXmlAtt(xmlAlt,"r"&yx,"cv22");						cv23 = getXmlAtt(xmlAlt,"r"&yx,"cv23");						cv24 = getXmlAtt(xmlAlt,"r"&yx,"cv24");						cv25 = getXmlAtt(xmlAlt,"r"&yx,"cv25");						cv26 = getXmlAtt(xmlAlt,"r"&yx,"cv26");												r10 = "";						r11 = "";						r12 = "";						rc = "";								b1 = cv20 + cv21 + cv22 + cv23;						r10 = cv6 & cv7 & PadLeft(cv8,"2","0") & PadLeft(cv9,"3","0") & "-" & cv10;																		dato_id = "";						cmdQuery = "select c5 as f5 from keplersc.kdmm " & 						"where c1 = '" & cv6 & "' and c2 = '" & cv7 & "'" & " and c3 = " & cv8 & " and c4 = " & cv9; 						rstXml(xmlDet);						xmlDet = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");						frn.lib("libGeneral.kpl","FileSave",xmlDet, fileSavePath & "\ser_ordenrpt_data_f_rpt");						ok=getXmlAtt(xmlDet,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(xmlDet,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;						}						dato_id = getXmlAtt(xmlDet,"r0", "f5");						if ( strlen(dato_id) == 0 ) {							// Not records found						} else {							f5 = getXmlAtt(xmlDet,"r0", "f5");							r11 = f5;						}																		dato_id = "";						cmdQuery = "select c3 as d3 from keplersc.kdud " & 						"where c2 = '" & cv12 & "'"; 						rstXml(xmlDet);						xmlDet = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");						frn.lib("libGeneral.kpl","FileSave",xmlDet, fileSavePath & "\ser_ordenrpt_data_d_rpt");						ok=getXmlAtt(xmlDet,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(xmlDet,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;						}						dato_id = getXmlAtt(xmlDet,"r0", "d3");						if ( strlen(dato_id) == 0 ) {							// Not records found						} else {							d3 = getXmlAtt(xmlDet,"r0", "d3");							r12 = d3;						}																			rc = "[" & cv12 & "]  " & r12;												rep.set("hist_fech",cv11);											rep.set("hist_folio",r10);						rep.set("hist_tipo",r11);						rep.set("hist_clie",rc);						rep.set("hist_asesor",cv13);													rep.set("hist_mo",cv20);											rep.set("hist_ref",cv21);						rep.set("hist_tots",cv22);						rep.set("hist_carg",cv23);												rep.set("hist_sub",b1);						rep.set("hist_iva",cv25);						rep.set("hist_total",cv26);																			rep.exe("section-hist-det");												}								}									/*if (nXml(xmlAlt) > 0) { rep.exe("section-carg_line"); }*/ // This N.A. for this section 								// END Historial Documentos ...														//rep.exe("endrep");														//Modos de impresión 				rep.win(); //Muestra la vista previa de la impresión. A partir de la vista previa (Preprint) se decide si se imprime o no.				//rep.print("\\192.168.1.100\HPLaserJet"); //Envía el reporte directamente a una impresora, sin mostrar la vista previa.				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresión. No muestra la vista previa.				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardará el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html										} /* END Func Reporte() */									// END : ZONA	CODIGO REPORTE(S) 										} // End of class Main			</script></pag>