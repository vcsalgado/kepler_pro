<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><txt fnt=",23b">Reporte Orden de Servicio</txt><br/>	<!-- dim="81,0" --> 	<hLine dim="85,0"/> 	<br/> <br/>		<!-- <grp dim="46,10,7,12" -->		<grp dim="48,11,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">			<br/>			<txt>  Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>			<br/>			<txt>  Tipo :        </txt>			<cmb id="k_tipon" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="CambiaTipo()" available="Y" modify="Y"/>			<br/>			<txt id="textFolio" visible="Y">  Folio :       </txt>			<edt id="k_folio" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" visible="Y" OnButton="ObtenerFolios()" OnF9="ObtenerFolios()" OnChange="BuscarFolio()"/> 			<br/>		</grp>		<sp/>		<!-- dim="34,11,7,12" -->		<grp dim="36,11,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<br/>			<sp n="1"/>			<txt>  Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N"/> 			<sp n="1"/> 			<txt>  Hora : </txt> 			<sp n="1"/> 			<edt id="k_hora" dim="15,1" type="string" nc="-1" bclr="240,240,240" modify="N" fmt="HH:MM:SS" available="N"/> 			<br/>		</grp>		<br/>		<br/>				<!-- dim="81,18,7,12" --> 		<grp dim="85,14,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Totales ">			<sp n="1"/> 			<!-- fnt="Arial,15" dim="114,6" -->			<tbl id="k_mov" dim="119,6" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" hk="z" OnChange="" Reorder="N" modify="Y" insdel="N" nren="fijo">								<!--				<col id="c_reemplazo" name="Reemplazo"  type="capital" nc="18" modify="N" available="Y" visible="Y"/>											<col id="k_parte" name="Producto"  type="capital" nc="18" modify="N" available="Y"/>			   <col id="k_descr" name="Descripcion"  modify="N" nc="30"/>						<col id="k_q" name="Cantidad"  type="number" nd="-1" min="0" modify="N" OnF9="" OnMouseL="" 					OnChange="" OnActive="" OnF10="" visible="Y" available="Y"/>				<col id="k_unidad" name="U.M."  type="capital" OnChange="" OnF9="" OnMouseL="" modify="N" available="Y" visible="Y"/>				<col id="k_precio" name="Unitario"  type="number" nd="2" modify="N" available="Y" visible="Y"/>									<col id="k_monto" name="Importe"  type="number" nd="2" OnF9="" OnMouseL="" 					OnChange="" OnActive="" OnF10="" modify="N" available="Y" visible="Y"/>									<col id="c_stock" name="Stock"  type="number" nd="2" OnF9="" OnMouseL="" 					OnChange="" OnActive="" OnF10="" modify="N" available="N" visible="N"/>				<col id="c_especial" name="Especial"  type="number" nd="2" OnF9="" OnMouseL="" 					OnChange="" OnActive="" OnF10="" modify="N" available="N" visible="N"/>				-->								<col id="tipo" name="Tipo"  type="string" modify="N" available="Y"/>				<col id="folio" name="Folio" type="string" modify="N" available="Y"/>				<col id="estatus" name="Estatus"  type="string"/>				<col id="fecha" name="Fecha"  type="date" modify="N" available="Y" fmt="DD/MM/CCYY"/>				<col id="hora" name="Hora"  type="string" modify="N" available="Y"/>				<col id="num_serie" name="Num_Serie"  type="string" modify="N" available="Y"/>				<col id="kilometraje" name="Kilometraje"  type="number" modify="N" available="Y"/>				</tbl>			<br/>					</grp>				<br/>		<br/>						<sp n="15"/>		<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Ejecuta_Reporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>					<sp n="25"/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="N"/>					<sp n="10"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>							</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal;			var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd,uen;         var v_tipoorden, v_folio;                  // Vars Reports			var cmd, xmlResQuery, strTmp;			var fech_original;										fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";				fileSavePath = "C:\Basura";				Inicializa();								ConfiguraControlesOpcion();			}			//Validacion Datos Generales y Partidas antes de Guardar.			//El resultado de cada validacion se guarda en la variable global resVal.			fun ValidarDatos(iModo) {				var totReg, subTotal=0, iva=0, total=0;				var no_part=0;								//Obtener variables				sucursal_id = frn.get("k_sucn",-1,1);				refer_id = frn.get("k_refer");											//Validar Referencia            cmdQuery = "select count(*) as totreg from keplersc.kdpedref " &                 "where c1 = '" & sucursal_id &  "' and c2 = '" & refer_id &  "' and c4 = 10";										rstXml(cuboQuery);				if (iModo != 1) {  // 20220814					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.ValidarDatos()");				} else { 					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.ValidarDatos_Baja()");				}				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error DB","Aceptar"); //TO DO Homologar mensaje en todo el proyecto, agregar DB					return;				}				totReg=getXmlAtt(cuboQuery,"r0","totreg");				if(totReg==0){					frn.message("La referencia no existe o no esta disponible ...","Error","Aceptar");					resVal=0;					return;				}												no_part = frn.N("k_mov");								/*				if (iModo != 1) {  // 20220814  					//Validar Cantidades					//for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {					for (var i=0,n=frn.N("k_mov");i<n;i++) { 						frn.setPos("k_mov",i,"k_q");						resVal=CalculaTotales(1);						if(resVal==0){							return;						}					}				} else { 				*/					if (frn.N("k_mov") == 0) {						frn.message("La operacion no tiene partidas.","Error","Aceptar");						resVal=0;						return;					}					else { CalculaTotales(); } // Added ... 20230903				/*}*/							//Validar Totales				//subTotal = frn.get("k_subtotal");				//iva  =frn.get("k_iva");				total = frn.get("k_monto");				if (total <= 0){					frn.message("El total de la operación no puede ser cero.","Error","Aceptar");					resVal = 0;					return;				}							} // End ValidarDatos()						/*			fun DetallaGRD() {				for (var i=0; i<frn.N("k_mov"); i++) {					if ( (strlen(frn.get("k_mov",i,"k_q")) == 0) || (frn.get("k_mov",i,"k_q") <= 0) ) {  						frn.setX("0","k_mov",i,"k_q"); 						frn.setX("0","k_mov",i,"k_precio"); 						frn.setX("0","k_mov",i,"k_monto"); 					} else {						frn.setX(frn.get("k_mov",i,"k_ic"),"k_mov",i,"k_precio"); 					}				}					}			*/						fun BuscarFolio() {				var folio, folio2;				folio = frn.get("k_folio");								//Added 230926				folio2 = PadLeft(folio, 10, "0");				frn.set("k_folio", folio2);								//frn.lib("libGeneral.kpl","PadLeft", folio, 7, "0");				folio = PadLeft(folio, 7, "0");				ArmarRefDocto();				MostrarDOC(folio);				}			fun Cancela() {				CambiaSucursal();				Inicializa();				ConfiguraControlesOpcion();			}						fun ModoBuscar() {				tip_ope = "C";				frn.set("operacion", "CONSULTA");				LimpiaEncabezado();				ConfiguraControlesOpcion();			}					fun Ejecuta() {				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg;				var resultado, mensaje, folio;								fecha = sys.date();				hora = sys.time();								if (tip_ope &= "A") { 								//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok					resVal = 1;					ValidarDatos();					if(ok &! "1" || resVal == 0){						return;					}					//Para Homologar los TAGs que envía el Grid (KMov) al XML que generará la Pantalla					//DetallaGRD();										// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;												setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",						frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 						frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")/*-1*//*commented 220726*/);					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);					setXml(xmlPantalla,"ambiente","uen",uen);					frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\XmlAltaPedido");										/*					// For Testing 					frn.message("El pedido se procesara ...", "Info", "Aceptar");					return;					*/					// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 								cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					rstXml(cuboQuery);					cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"refaltapedcrud.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado");										// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										//resultado = "1";					//mensaje = "0000009";										resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");																				if(resultado &= "1") {											frn.message(mensaje, "Folio Generado para esta operacion : ", "Aceptar");											ModoBuscar(); // 220721 ... added 												//tip_ope = "C"; -- 220721 ... commented & included en ModoBuscar();						frn.set("k_folio", mensaje); 						//frn.set("operacion", "CONSULTA"); -- 220721 ... commented & included en ModoBuscar();						/*						strTmp = frn.get("k_docto");								strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;						frn.set("k_docto", strTmp);						*/						// //ConfiguraCamposOpcion();											//strMsg = "El Folio utilizado para esta operación fue : " & mensaje;						//ConfiguraControlesOpcion(); // TO CHECK ... Esto No se ejecuta si se pone después del Message * * *  						//frn.message(strMsg, "Mensaje", "Aceptar");						//folio = frn.get("k_folio");						//MostrarDOC(folio);							BuscarFolio();					} else {						frn.message(mensaje, "Error", "Aceptar");					}				} /*End Alta*/ else {					if (tip_ope &= "B") {						/*Ini Baja*/												frn.message("Opcion No Desarrollada ...", "Info", "Aceptar");						return;												// IMPORTANTE ... EL CODIGO DE ABAJO DEBE SER RECONSTRUIDO ... ESTE ES DE OTRA OPCION 												folio = frn.get("k_folio");												//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok						resVal = 1;						ValidarDatos(1);						if(ok &! "1" || resVal == 0){							return;						}																xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;						//Agregar usuario, fecha y hora de movimiento						strFecha = fnDate("year",fecha) & "-";						strTmp = fnDate("month",fecha);						if(strlen(strTmp) == 1){							strTmp = "0" & strTmp;						}						strFecha = strFecha & strTmp & "-";						strTmp = fnDate("day",fecha);						if(strlen(strTmp) == 1){							strTmp = "0" & strTmp;						}						strFecha = strFecha & strTmp;													setXml(xmlPantalla,"movimiento","usuario",usuario);						setXml(xmlPantalla,"movimiento","fecha",strFecha);						setXml(xmlPantalla,"movimiento","hora",							frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 							frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));						setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")/*-1*//*commented 220726*/);						setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);											frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\Xml_Pedido_Baja");						// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 									cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						//kdb.rst(cuboQuery);						rstXml(cuboQuery);						cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"refaltapedcrud.Ejecuta_Baja");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_Baja");											// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 											//resultado = "1";						//mensaje = folio /*"0000009"*/;											resultado = getXml(cuboQuery,"resultado");						mensaje = getXml(cuboQuery,"mensaje");										// /*																	if(resultado &= "1") {												frn.message(mensaje, "Folio de Cancelacion : ", "Aceptar");												ModoBuscar(); // 220721 ... added 													//tip_ope = "C"; -- 220721 ... commented & included en ModoBuscar();							frn.set("k_folio", mensaje); 							//frn.set("operacion", "CONSULTA"); -- 220721 ... commented & included en ModoBuscar();							/*							strTmp = frn.get("k_docto");							strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;							frn.set("k_docto", strTmp);							*/							// //ConfiguraCamposOpcion();												//strMsg = "El Folio utilizado para esta operación fue : " & mensaje;							//ConfiguraControlesOpcion(); // TO CHECK ... Esto No se ejecuta si se pone después del Message * * *  							//frn.message(strMsg, "Mensaje", "Aceptar");							//folio = frn.get("k_folio");							//MostrarDOC(folio);								BuscarFolio();						} else {							frn.message(mensaje, "Error", "Aceptar");						}						// */												//frn.message("En Construcción, OPC {Baja}", "Info", "Aceptar");					} /*End Baja*/ else {						frn.message("Opcion No Desarrollada ...", "Info", "Aceptar");						return;						/*Ini Consulta*/						folio = frn.get("k_folio");						ModoBuscar(); // 220721 ... added						frn.set("k_folio", folio); // 220721 ... added						//MostrarDOC(folio); // 220722 ... commented 						/*						strTmp = frn.get("k_docto");						strTmp = strSplit(strTmp,"-",0) & "-" & folio;						frn.set("k_docto", strTmp);							*/						BuscarFolio();					}	/*End Consulta (for exception)*/ 				}							} // FIN ... Ejecuta()									fun Inicializa(){ //Inicializa los valores en Pantalla				// Our code 				// Revisa y Carga en Variables los Parámetros Recibidos en la corrida				if( frn.nParam() == 1 ){ //Se han mandado parámetros a la página					/*					gen_doc = trim(frn.param(0));                nat_doc = trim(frn.param(1));                gpo_doc = trim(frn.param(2));               tip_doc = trim(frn.param(3));                tip_ope = trim(frn.param(4));               uen = trim(frn.param(5));               tip_ope_original=tip_ope; // -- 220726               */               uen = trim(frn.param(0));					if (uen != "SER"/*&= ""*/) {						//uen="SER";						frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");						frn.open("redirect",2);						return;					}				} else {					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}				// Testing Code //				/*				gen_doc = "N"; 				nat_doc = "D"; 				gpo_doc = "21";				tip_doc = "1"; 				tip_ope = "C"; // "A" 				uen = "SER";            */            tip_ope = "C";            uen = "SER";            				if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					if(tip_ope &= "B"){ //Baja						frn.set("operacion","BAJA");					} else {						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} else {					      frn.message("Operación no válida ...", "Mensaje","&Aceptar");							//frn.open("anuncios",4);							frn.open("index",4);							return;									}					}				}								// Fill Combo Sucursal (Con Query de PostgreSQL)				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.IniCombos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",cuboQuery);									// Fill Combo Tipo (Con Query FTO Kepler) 				/*				cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm " &				"where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4 = '" & tip_doc & "'" ;				*/				rstXml(cuboQuery);				cmdQuery = "select '['||c1||'] '||c3 as c2, c1 from keplersc.kdmargen";				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Inicializa()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboTipoDocto");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error BD","Aceptar");					return;				}				frn.set("k_tipon",getXml(cuboQuery));								frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());									// Fill k_docto | referencia docto				//ArmarRefDocto();							}						// Armado del Docto Referencia			fun ArmarRefDocto {				/*				var cadena,tmpFolio, tmpGrupo, tmpTipo;				tmpFolio = frn.get("k_folio");				// //tmpFolio = frn.lib("libGeneral.kpl","PadLeft",tmpFolio,"7","0");				tmpFolio = PadLeft(tmpFolio,"7","0");				tmpGrupo = PadLeft(gpo_doc,"2","0");				tmpTipo = PadLeft(tip_doc,"3","0");				//cadena = trim(gen_doc) & trim(nat_doc) & trim(gpo_doc) & trim(tip_doc) & "-" & tmpFolio;				cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;				frn.set("k_docto", cadena);				*/			}						fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         }			fun ConfiguraControlesOff() {								frn.setAtt("textFolio", "visible", "N");				frn.setAtt("k_folio", "available", "N");				frn.setAtt("k_folio", "visible", "N");								frn.setAtt("k_fecha", "available", "N");				frn.setAtt("k_hora", "available", "N");				frn.setAtt("k_refer", "available", "N");				frn.setAtt("k_fecref", "available", "N");								frn.setAtt("k_coment", "available", "N");				frn.setAtt("k_coment2", "available", "N");				frn.setAtt("k_coment3", "available", "N");								//frn.setAtt("k_mov", "visible", "N", "c_reemplazo");								frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											}						fun ConfiguraControlesOpcion() {							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta					//frn.setAtt("k_fecha", "available", "Y");					//frn.setAtt("k_hora", "available", "Y");					frn.setAtt("k_refer", "available", "Y");								frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");													} else {					if(tip_ope &= "B"){ //Baja										frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("Imprimir", "visible", "N");						frn.setAtt("Cancelar", "visible", "Y");						frn.setAtt("Aceptar", "visible", "Y");															} else {						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("Imprimir", "visible", "Y");						frn.setAtt("Cancelar", "visible", "N");						frn.setAtt("Aceptar", "visible", "N");						}				}			}						fun LimpiaDatosDoc {				frn.set("k_refer", "");				frn.set("k_fecref", "");				frn.set("k_mov", "");				frn.set("k_coment", "");				frn.set("k_coment2", "");				frn.set("k_coment3", "");			}						fun LimpiaTotalesDoc {				//frn.set("k_subtotal", "");				//frn.set("k_iva", "");				frn.set("k_monto", "");			}						fun LimpiaEncabezado {				frn.set("k_folio", "");				frn.set("k_docto", "");				frn.set("k_fecha", "");				frn.set("k_hora", "");			}						fun CambiaSucursal {				LimpiaDatosDoc();				LimpiaTotalesDoc();				LimpiaEncabezado();				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());					ArmarRefDocto();							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						}					}								}			}						fun CambiaTipo {				LimpiaDatosDoc();				//LimpiaTotalesDoc();				LimpiaEncabezado();				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());					ArmarRefDocto();								if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						}					}								}			}			fun ObtenerRef() {							var win_tit, field_key, field_col, cmdQuery;				            proveedor_id = frn.get("k_clave");            sucursal_id = frn.get("k_sucn",-1,1);	                        win_tit = "Pedidos Sugeridos";				field_key = "referencia";				field_col = "k_refer";            cmdQuery = "select c2 as referencia, c3 as fecha from keplersc.kdpedref " &                 "where c1 = '" & sucursal_id &  "' and c4 = 10";            cmdQuery = cmdQuery & " order by c2 desc ";                        	         frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");                     }         			fun ObtenerFolios() {			            sucursal_id = frn.get("k_sucn",-1,1);	            cmdQuery = "" &						"select i.c3 as folio, i.c11 as cliente, i.c4 as fecha from keplersc.kdord i " & 						"where i.c1 = '" & /*"02"*/sucursal_id & "' and i.c2 = '" & frn.get("k_tipon",-1,1)  & "' order by i.c3 desc";						                                    frn.dialog("genlistasel","Relacion de Ordenes",cmdQuery,"folio","k_folio","0","","N");                     }                  fun MostrarRef() {					var refer;				var xmlGrd;																	sucursal_id = frn.get("k_sucn",-1,1);				refer = frn.get("k_refer");												//Reset campos				LimpiaDatosDoc();				LimpiaTotalesDoc();								frn.set("k_refer", refer);								CalculaTotales();								cmdQuery = "" &					"select h.c3 k_parte, i.c2 k_descr, h.c18 k_q, i.c19 k_unidad " & 					", coalesce(l.c14, 1) k_precio, ( h.c18 * coalesce(l.c14, 1) ) k_monto " & 					", (select * from keplersc.reemplazo_prod_text(h.c3)) as c_reemplazo " & 					"from keplersc.kdpedrefmov h " &					"inner join keplersc.kdini i on i.c1 = h.c3 " &					"left join keplersc.kdinl l on l.c1 = h.c1 and l.c2 = h.c3 " &  					"where h.c1 = '" & sucursal_id & "'" & " and h.c2 = '" & refer & "'" & " and h.c18 > 0 order by h.c2, h.c3";									rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.mostrardatosgrid()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosgrid");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.message("Sin Registros por mostrar ...","Info","Aceptar");					frn.set("k_fecref", "Referencia Invalida");					frn.setPos("k_refer");					return;					}					//frn.set(cuboQuery);							rstXml(xmlGrd);				xmlGrd=frn.lib("libGeneral.kpl","CreaXmlDesdeTagRow",cuboQuery,"r","k_mov");				frn.lib("libGeneral.kpl","FileSave",xmlGrd, fileSavePath & "\mostrardatosgrid_parsed");				frn.setX(xmlGrd);								// Traer Fecha Referencia 				var dato_id;							dato_id = "";				cmdQuery = "select c3 as campo from keplersc.kdpedref where c1 = '" & sucursal_id & "'" & " and c2 = '" & refer & "'";								if(tip_ope &= "A"){ //Alta		         cmdQuery = cmdQuery & " and c4 = 10";				} 					rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.Valida_Ref()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\refaltapedcrud_Valida_Ref");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								dato_id = getXmlAtt(cuboQuery,"r0", "campo");								if ( strlen(dato_id) > 0 ) {					frn.set("k_fecref", dato_id);				} else {					frn.set("k_fecref", "Referencia Invalida");				}								CalculaTotales();									return;						   } // End MostrarRef()		   			fun MostrarDOC(nFolio) {							var xmlGrd, flagErr;												flagErr = 0;								sucursal_id = frn.get("k_sucn",-1,1);				v_tipoorden = frn.get("k_tipon",-1,1);				v_folio = frn.get("k_folio");								LimpiaDatosDoc();				//LimpiaTotalesDoc();				//LimpiaEncabezado();								/*				cmdQuery = "" & 					"select w.c6 as folio, w.c9 as fecha, w.c11 as refer, w.c24 as cmnt1, w.c25 as cmnt2, w.c26 as cmnt3, w.c41 as fechref, w.c69 as hora from keplersc.kdm1 w " & 					"where w.c1 = '" & sucursal_id & "' and w.c2 = '" & gen_doc & "' and w.c3 = '" & nat_doc & "' and w.c4 = " & gpo_doc & " and w.c5 = " & tip_doc  & " " &					"and w.c6 = '" & nFolio & "' order by w.c6 desc";				*/								cmdQuery = "" &				"select i.c3 folio, i.c4 fecha, i.c5 hora " &				"from keplersc.kdord i where i.c1 = '" & /*"02"*/sucursal_id & "' and i.c2 = '" & v_tipoorden & "' and i.c3 = '" & v_folio  & "'";								//frn.message(cmdQuery,"Info !","Aceptar");								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.upd()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosorden");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					//frn.setAtt("Aceptar", "visible", "N");					//ConfiguraControlesOff();					frn.message("Sin Datos por mostrar ...","Info","Aceptar");					flagErr = 1;					ArmarRefDocto();					return;					//Cancela();					}	else {					if(tip_ope &! "C"){						frn.setAtt("Aceptar", "visible", "Y");					}				}				//frn.set(cuboQuery);								//if ( flagErr == 1 ) { Cancela(); }				ConfiguraControlesOpcion();								/*				frn.setX(getXmlAtt(cuboQuery,"r0", "folio"), "k_folio");				frn.setX(getXmlAtt(cuboQuery,"r0", "fecha"), "k_fecha");				frn.setX(getXmlAtt(cuboQuery,"r0", "refer"), "k_refer");				frn.setX(getXmlAtt(cuboQuery,"r0", "fechref"), "k_fecref");				frn.setX(getXmlAtt(cuboQuery,"r0", "hora"), "k_hora");				frn.setX(getXmlAtt(cuboQuery,"r0", "cmnt1"), "k_coment");				frn.setX(getXmlAtt(cuboQuery,"r0", "cmnt2"), "k_coment2");				frn.setX(getXmlAtt(cuboQuery,"r0", "cmnt3"), "k_coment3");				*/								frn.set("k_folio", getXmlAtt(cuboQuery,"r0", "folio"));				frn.set("k_fecha", getXmlAtt(cuboQuery,"r0", "fecha"));				frn.set("k_hora", getXmlAtt(cuboQuery,"r0", "hora"));				/*				frn.set("k_refer", getXmlAtt(cuboQuery,"r0", "refer"));				frn.set("k_fecref", getXmlAtt(cuboQuery,"r0", "fechref"));				frn.set("k_coment", getXmlAtt(cuboQuery,"r0", "cmnt1"));				frn.set("k_coment2", getXmlAtt(cuboQuery,"r0", "cmnt2"));				frn.set("k_coment3", getXmlAtt(cuboQuery,"r0", "cmnt3"));				*/								ArmarRefDocto();								MostrarDOCDet(nFolio);						}			fun MostrarDOCDet(nFolio) {					var refer;				var xmlGrd;																				sucursal_id = frn.get("k_sucn",-1,1);				v_tipoorden = frn.get("k_tipon",-1,1);				v_folio = frn.get("k_folio");								//Reset campos				frn.set("k_mov", "");							//CalculaTotales();								/*				cmdQuery = "" &					"select c8 k_parte, c10 k_descr, c9 k_q, c11 k_unidad " & 					", c12 k_precio, c13 k_monto " & 					"from keplersc.kdm2 " &					"where c1 = '" & sucursal_id & "' and c2 = '" & gen_doc & "' and c3 = '" & nat_doc & "' and c4 = " & gpo_doc & " and c5 = " & tip_doc  & " " &					"and c6 = '" & nFolio & "' order by c7";				*/								/*				cmdQuery = "" &				"select x.c8 k_parte, x.c10 k_descr, x.c9 k_q, x.c11 k_unidad, x.c12 k_precio, x.c13 k_monto " &				", (select * from keplersc.reemplazo_prod_text(x.c8)) as c_reemplazo " & 				", k.c11 as c_especial, k.c17 as c_stock " & 				"from keplersc.kdm2 x " & 				"inner join keplersc.kdm1 m on m.c1 = x.c1 and m.c2 = x.c2 and m.c3 = x.c3 and m.c4 = x.c4 and m.c5 = x.c5 and m.c6 = x.c6 " & 				"left join keplersc.kdpedrefmov k on k.c1 = m.c1 and k.c2 = m.c11 and k.c3 = x.c8 " & 				"where x.c1 = '" & sucursal_id & "' and x.c2 = '" & gen_doc & "' and x.c3 = '" & nat_doc & "' and x.c4 = " & gpo_doc & " and x.c5 = " & tip_doc  & " " &				"and x.c6 = '" & nFolio & "' order by x.c7";				*/								// Based on Saltiel Query 				cmdQuery = "" &				"select i.c2 tipo, i.c3 folio, case when i.c8 = 0 then 'PENDIENTE' when i.c8 = 10 then 'ACTIVA' when i.c8 = 20 then 'SUSPENDIDA' " &				"when i.c8 = 30 then 'TERMINADA' when i.c8 = 40 then 'CERRADA'  when i.c8 = 50 then 'FUERA TALLER' end estatus, i.c4 fecha, i.c5 hora, " &				"i.c6 num_serie, i.c20 kilometraje from keplersc.kdord i where i.c1 = '" & /*"02"*/sucursal_id & "' and i.c2 = '" & v_tipoorden & "' and i.c3 = '" & v_folio  & "'";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.mostrardatosgrid()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosdocgrid");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.message("Sin Registros por mostrar ...","Info","Aceptar");					return;					}					//frn.set(cuboQuery);							rstXml(xmlGrd);				xmlGrd=frn.lib("libGeneral.kpl","CreaXmlDesdeTagRow",cuboQuery,"r","k_mov");				frn.lib("libGeneral.kpl","FileSave",xmlGrd, fileSavePath & "\mostrardatosdocgrid_parsed");				frn.setX(xmlGrd);												//CalculaTotales();									return;						   } // End MostrarDOCDet()	   			fun CalculaTotales(iModo) {				var monto = 0, monto_acum = 0;				var cantValida = 1;				//Calcular totales				for (var i=0; i<frn.N("k_mov"); i++) {					 monto = frn.get("k_mov",i,"k_monto");					 monto_acum = monto_acum + monto;				}								//frn.set("k_subtotal",subTotal);				//frn.set("k_iva",iva);								frn.set("k_monto",monto_acum);								return cantValida;			}											// ZONA	CODIGO REPORTE(S) 						fun IniParams(){//Inicializa parámetros de impresión. Pueden ser cambiados por el usuario final mediante menú: Archivo -> Configurar Página				frn.set("param_paper","letter");	//Tamaño de papel predefinido:	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tamaño de papel personalizado	"size=21.59,27.94cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//Márgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0");	//Escala de impresión (1=100 por ciento)	"F=1,1"				frn.set("param_landscape","N"/*"Y"*/);	//Orientación	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"				frn.set("param_emp","L");	//Posición de "Razón social"(izq,der,cen)	@emp=L|R|C"			}						fun setRepPage() {//Establece los parámetros finales de impresión.				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Ejecuta_Reporte() {							if (  ( frn.N("k_mov") == 0 ) || ( strlen( trim(/*frn.get("k_folio")*/frn.get("k_mov",-1,"folio")) ) == 0 )  ) {					frn.message("Sin Registros por mostrar ...","Info","Aceptar");					return;				}							// Commented 20221208 				//IniParams(); //Inicializa parámtros de impresión entre otros							//Code Added 20121208 				/*				//rstXml(xmlPar);				*/								/*				if ( tip_ope_original &= "C" && tip_ope &= "C" ) {					CambiaSucursal(3); 				}				*/									// fech_original = "2022-11-03"; // 4 Testing				// tip_ope_original = "A"; // 4 Testing								//...(cubos de datos e información necesaria)				//sucursal = frn.get("k_sucn",-1,1);				/*				if ( tip_ope_original &= "A" && tip_ope &= "C" ) {					fech_oper = fech_original; // frn.get("k_fecha");				}				tipo_auto = "NUEVO";				*/								/*				// setXml(xmlPar,"document","sucursal_id",sucursal);				*/								/*				if ( tip_ope_original &= "A" && tip_ope &= "C" ) {					setXml(xmlPar,"document","fech_oper", fech_oper); 				}				setXml(xmlPar,"document","tipo_auto", tipo_auto);				*/								//code Added 20221208 by JMM				/*				if ( strlen(frn.get("k_fecha")) > 0 ) { 					setXml(xmlPar,"document","fech_I", frn.get("k_fecha"));				}				if ( strlen(frn.get("k_fecha_F")) > 0 ) { 					setXml(xmlPar,"document","fech_F", frn.get("k_fecha_F"));				}					*/								/*				//setXml(xmlPar,"document","folio",frn.get("k_folio"));				//setXml(xmlPar,"document","fecha",frn.get("k_fecha"));				*/								/*				frn.lib("libGeneral.kpl","FileSave",xmlPar, fileSavePath & "\refalatapedcrud_rpt_xmlPar");												cmd="select * from keplersc.autos_com_asig_rpt('"& getXmlStr(xmlPar,"EOF:13_10") &"')";				rstXml(xmlResQuery);				xmlResQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comaltasigcrudN_rpt.Ejecuta_Reporte()");				ok=getXmlAtt(xmlResQuery ,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlResQuery ,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						frn.lib("libGeneral.kpl","FileSave",xmlResQuery, fileSavePath & "\comaltasigcrudN_rpt_xmlResQuery");								*/								Reporte();						} /* END Func Ejecuta_Reporte() */						fun Reporte() {							// Our Vars				var compania, titrep;				var contProd, contDet, tmpStr;								var dato_id; 								var sucursal, sucursaltx, fech_oper, xmlAlt ,xmlDet;								var i1, i2, i3, i4, i5, i6, i7, i10, i35, i37, i21, i20, i22, i19, i55, i24, i25, i26, i27, i28, i29, i40, i41, i42, i43, i44;				var q2, q12, q13;				var r202, r200, r201, r19, r200_1, r1, r2, r10, r11, r12, r13, r14, r15, rc;				var b1, b2, b10, b11, b12, b13, b14, b15, b16, b17, b18; 				var a4, a10, a11, a12, a13;				var d2, d3, d4, d6, d47, d45, d46, d48, d49, d27, d5, d7, d8, d9, d33, d34, d35, d36, d37, d10;				var k2, k3, k11, k14, k4, k5, k6, k7, k10, k13;				var dd4, dd5, dd6, dd7;				var o2, l2, m3, p3, z2, cu12, h11, f5;				var c7, c8, c9, c10;				var x2, x3, x7;				var j6, j7, punto, j8, j9, j17, j15, j18, j19, j10, j11, j12, j13, j14, j42, j43, j44, j45, j46, j47;				var j20, j21, j22, j23, j24;				var sc6, sc7, sd1, sd2, se2, se3;				var enter_dt, dt6, dt7, dt8, dt9, dt10, dt19, dt11, dt12, dt13, dt14, dt15, dt16, dt21, dt22, dt23, dt26, dt27, dt28, dt29, dt30, dt31;				var dt24, dt18;				var y6, y7, y8, y9, y10, y11;				var t6, t7, t8, t14;				var u5, u6, u7, u8, u9, u11, u12, u13, u14, u15, u16;				var v5, v6, v7, v8, v9, v10, v16;				var w6, w7, w10;				var g51, g52, g53, g54, g9, g10, g32, g33, g34, g35, g22, g51, g52, g53, g54, g13, g14, g16;				var cv6, cv7, cv8, cv9, cv10, cv11, cv12, cv13, cv20, cv21, cv22, cv23, cv24, cv25, cv26;  								//var folio;				var p_fecha, var_fecha;				var p_subtotal, p_utilidad, p_perce, p_costo, p_total, p_iva;				var gt_subtotal, gt_utilidad, gt_perce, gt_costo, gt_total, gt_iva;								sucursal_id = frn.get("k_sucn",-1,1);				v_tipoorden = frn.get("k_tipon",-1,1);				v_folio = frn.get("k_folio");								sucursal = frn.get("k_sucn",-1,1);				sucursaltx = frn.get("k_sucn",-1,0);								//Obtener datos generales				kdb.kde("KDE");//Configuracion del servidor				kdb.exec();				compania = kdb.get("KDE","1");									// Se define el formato a usar y se liga a la variable del reporte "rep"	// Se define el formato a usar y se liga a la variable del reporte "rep"				rep.rst(); // 20121208				IniParams(); // 20121208				kdb.readPage("datFto","ser_reportedeordenfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				//rep.rst(); // 20121208				setRepPage();//Establece los parámetros finales de impresión(rep.page(...);), pues pueden haber cambiado por el usuario 				//Da valor a los inputs del reporte(rep.set();), e indica la ejecución de "grupos de renglones de impresión" (rep.exe();)												titrep = "R E P O R T E   I N T E R N O   D E   L A   O R D E N";												rep.set("fecha",sys.date());				rep.set("hora",sys.time());				rep.set("nombreempresa",compania);				rep.set("tituloreporte",titrep);								rep.set("suctx",sucursaltx);				rep.set("tipdoc",frn.get("k_tipon",-1,1));				rep.set("foldoc",frn.get("k_folio"));								b10 = 0;				b11 = 0;				b12 = 0;				b13 = 0;								dato_id = "";				cmdQuery = "select c1 as i1, c2 as i2, c3 as i3, c4 as i4, c5 as i5, c6 as i6, c7 as i7, c10 as i10, c35 as i35, c37 as i37, " &				"c21 as i21, c20 as i20, c22 as i22, c19 as i19, c55 as i55, c24 as i24, c25 as i25, c26 as i26, c27 as i27, c28 as i28, c29 as i29, " & 				"c40 as i40, c41 as i41, c42 as i42, c43 as i43, c44 as i44 " & 				"from keplersc.kdord " &				"where c1 = '" & /*"02"*/sucursal_id & "' and c2 = '" & v_tipoorden & "'" & " and c3 = '" & v_folio & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ser_ordenrpt_data_i_rpt");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "i3");				if ( strlen(dato_id) == 0 ) {					// Not records found				} else {					i1 = getXmlAtt(cuboQuery,"r0", "i1");					i2 = getXmlAtt(cuboQuery,"r0", "i2");					i3 = getXmlAtt(cuboQuery,"r0", "i3");					i4 = getXmlAtt(cuboQuery,"r0", "i4");					i5 = getXmlAtt(cuboQuery,"r0", "i5");					i6 = getXmlAtt(cuboQuery,"r0", "i6");					i7 = getXmlAtt(cuboQuery,"r0", "i7");					i10 = getXmlAtt(cuboQuery,"r0", "i10");					i35 = getXmlAtt(cuboQuery,"r0", "i35");					i37 = getXmlAtt(cuboQuery,"r0", "i37");										i21 = getXmlAtt(cuboQuery,"r0", "i21");					i20 = getXmlAtt(cuboQuery,"r0", "i20");					i22 = getXmlAtt(cuboQuery,"r0", "i22");					i19 = getXmlAtt(cuboQuery,"r0", "i19");					i55 = getXmlAtt(cuboQuery,"r0", "i55");					i24 = getXmlAtt(cuboQuery,"r0", "i24");					i25 = getXmlAtt(cuboQuery,"r0", "i25");					i26 = getXmlAtt(cuboQuery,"r0", "i26");					i27 = getXmlAtt(cuboQuery,"r0", "i27");					i28 = getXmlAtt(cuboQuery,"r0", "i28");					i29 = getXmlAtt(cuboQuery,"r0", "i29");										i40 = getXmlAtt(cuboQuery,"r0", "i40");					i41 = getXmlAtt(cuboQuery,"r0", "i41");					i42 = getXmlAtt(cuboQuery,"r0", "i42");					i43 = getXmlAtt(cuboQuery,"r0", "i43");					i44 = getXmlAtt(cuboQuery,"r0", "i44");															r202 = "";					if ( i7 == 0 ) { r202 = "-  Orden Abierta"; }					if ( i7 == 10 ) { r202 = "-  Orden Cerrada y Lista para Facturar"; }					if ( i7 == 20 ) { r202 = "-  Orden Lista para Imprimir Vale de Salida"; }										r19 = i37 & ":00";								}												dato_id = "";				cmdQuery = "select c2 as d2, c3 as d3, c4 as d4, c6 as d6, c47 as d47, c45 as d45, c46 as d46, c48 as d48, c49 as d49, c27 as d27, " &				"c5 as d5, c7 as d7, c8 as d8, c9 as d9, c33 as d33, c34 as d34, c35 as d35, c36 as d36, c37 as d37, c10 as d10 " &  				"from keplersc.kdud where c2 = '" & i10 & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ser_ordenrpt_data_d_kdud_rpt");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"