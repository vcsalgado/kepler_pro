			rep.set("refsusp_cve",y6);								rep.set("refsusp_dscr",y7);								rep.set("refsusp_cant",y8);								rep.set("refsusp_um",y9); 								rep.set("refsusp_precio",y10);								rep.set("refsusp_importe",y11);																		rep.exe("section-refsusp-det");														}										}											if (nXml(xmlAlt) > 0) { rep.exe("section-refsusp_line"); }										} // End IF 															if ( strlen(j15) > 0 ) {						rep.set("pundet_nota15",j15);								rep.exe("section-notas-15");					}										if ( strlen(j18) > 0 ) {						rep.set("pundet_nota18",j18);								rep.exe("section-notas-18");					}										if ( strlen(j19) > 0 ) {						rep.set("pundet_nota19",j19);								rep.exe("section-notas-19");					}															if ( strlen(j10) > 0 || strlen(j11) > 0 || strlen(j12) > 0 || strlen(j13) > 0 || strlen(j14) > 0 ) {											rep.set("prob_cf",j10);						rep.set("prob_qc",j11);												rep.set("prob_prob1",j12);						rep.set("prob_prob2",j42);						rep.set("prob_prob3",j43);								rep.set("prob_caus1",j13);						rep.set("prob_caus2",j44);						rep.set("prob_caus3",j45);												rep.set("prob_corr1",j14);						rep.set("prob_corr2",j46);						rep.set("prob_corr3",j47);											rep.exe("section-problem");											}																				if ( j20 &= "C" ){						r11 = "Cerrado";					} else {						r11 = "Abierto";					} 					if ( j21 &= "C" ){						r12 = "Cerrado";					} else {						r12 = "Abierto";					} 					if ( j22 &= "C" ){						r13 = "Cerrado";					} else {						r13 = "Abierto";					} 					if ( j23 &= "C" ){						r14 = "Cerrado";					} else {						r14 = "Abierto";					} 					if ( j24 &= "C" ){						r15 = "Cerrado";					} else {						r15 = "Abierto";					} 										rep.set("resst_ref",r11);					rep.set("resst_tab",r13);					rep.set("resst_tot",r14);					rep.set("resst_carg",r15);										rep.exe("section-res-st");																		if ( enter_dt == 1 ) { 											rep.set("inftaller_pnto",punto);													rep.set("inftaller_res",dt11);						rep.set("inftaller_cmnt",dt14);						rep.set("inftaller_obs",dt15);												rep.set("inftaller_obs1",dt26);						rep.set("inftaller_obs2",dt27);						rep.set("inftaller_obs3",dt28);												rep.set("inftaller_recom",dt16);												rep.set("inftaller_recom1",dt29);						rep.set("inftaller_recom2",dt30);						rep.set("inftaller_recom3",dt31);												rep.set("inftaller_resp1",dt12);						rep.set("inftaller_resp2",dt13);						rep.set("inftaller_resp3",dt21);												rep.set("inftaller_respgar",dt22);						rep.set("inftaller_gar1",dt23);						rep.set("inftaller_gar2",dt24);												rep.exe("section-inf-taller");												dato_id = "";						cmdQuery = "select c12 as cu12 from keplersc.kdusrinfo where c1 = '" & dt18 & "'";						rstXml(xmlDet);						xmlDet = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");						frn.lib("libGeneral.kpl","FileSave",xmlDet, fileSavePath & "\ser_ordenrpt_data_se_rpt");						ok=getXmlAtt(xmlDet,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(xmlDet,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;						}						dato_id = getXmlAtt(xmlDet,"r0", "cu12");						if ( strlen(dato_id) == 0 ) {							// Not records found						} else {							cu12 = getXmlAtt(xmlDet,"r0", "cu12");							rep.set("inftaller_usrcal",cu12);							rep.exe("section-inf-taller-usr");						}										}															// Horas ...					dato_id = "";					cmdQuery = "select c6 as t6, c7 as t7, c8 as t8, c14 as t14 from keplersc.kdhoras " &					"where c1 = '" & sucursal_id & "' and c2 = '" & v_tipoorden & "'" & " and c3 = '" & v_folio & "' and c4 = " & punto;					rstXml(xmlAlt);					xmlAlt = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");					frn.lib("libGeneral.kpl","FileSave",xmlAlt, fileSavePath & "\ser_ordenrpt_data_t_rpt");					ok=getXmlAtt(xmlAlt,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(xmlAlt,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										if (nXml(xmlAlt) > 0) { rep.exe("section-horas"); }										if (nXml(xmlAlt) > 0) {											for(var yx=0; yx < nXml(xmlAlt); yx++)						{														t6 = getXmlAtt(xmlAlt,"r"&yx,"t6");							t7 = getXmlAtt(xmlAlt,"r"&yx,"t7");							t8 = getXmlAtt(xmlAlt,"r"&yx,"t8");							t14 = getXmlAtt(xmlAlt,"r"&yx,"t14");														b2 = t8 * t14;							b10 = b10 + b2;																			rep.set("horas_cve",t6);							rep.set("horas_dscr",t7);							rep.set("horas_cant",t8);							rep.set("horas_importe",b2);																	rep.exe("section-horas-det");													}									}										if (nXml(xmlAlt) > 0) { rep.exe("section-horas_line"); }					// END Horas ...															// Refacciones ...					dato_id = "";					cmdQuery = "select c5 as u5, c6 as u6, c7 as u7, c8 as u8, c9 as u9, c11 as u11, c12 as u12, c13 as u13, c14 as u14, " &					"c15 as u15, c16 as u16 from keplersc.kdref " &					"where c1 = '" & /*"02"*/sucursal_id & "' and c2 = '" & v_tipoorden & "'" & " and c3 = '" & v_folio & "' and c4 = " & punto;					rstXml(xmlAlt);					xmlAlt = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");					frn.lib("libGeneral.kpl","FileSave",xmlAlt, fileSavePath & "\ser_ordenrpt_data_u_rpt");					ok=getXmlAtt(xmlAlt,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(xmlAlt,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										if (nXml(xmlAlt) > 0) { rep.exe("section-refacc"); }										if (nXml(xmlAlt) > 0) {											for(var yx=0; yx < nXml(xmlAlt); yx++)						{														u5 = getXmlAtt(xmlAlt,"r"&yx,"u5");							u6 = getXmlAtt(xmlAlt,"r"&yx,"u6");							u7 = getXmlAtt(xmlAlt,"r"&yx,"u7");							u8 = getXmlAtt(xmlAlt,"r"&yx,"u8");							u9 = getXmlAtt(xmlAlt,"r"&yx,"u9");							u11 = getXmlAtt(xmlAlt,"r"&yx,"u11");							u12 = getXmlAtt(xmlAlt,"r"&yx,"u12");							u13 = getXmlAtt(xmlAlt,"r"&yx,"u13");							u14 = getXmlAtt(xmlAlt,"r"&yx,"u14");							u15 = getXmlAtt(xmlAlt,"r"&yx,"u15");							u16 = getXmlAtt(xmlAlt,"r"&yx,"u16");														b1 = u15;							b2 = u16;							b11 = b11 + b2;														r10 = u5 & u6 & PadLeft(u7,"2","0") & PadLeft(u8,"3","0") & "-" & u9;														rep.set("refacc_folio",r10);												rep.set("refacc_cve",u11);							rep.set("refacc_dscr",u12);							rep.set("refacc_cant",u13);							rep.set("refacc_um",u14);							rep.set("refacc_unit",b1);							rep.set("refacc_importe",b2);																	rep.exe("section-refacc-det");													}									}										if (nXml(xmlAlt) > 0) { rep.exe("section-refacc_line"); }					// END Refacciones ...																			// TOTs ...					dato_id = "";					cmdQuery = "select c5 as v5, c6 as v6, c7 as v7, c8 as v8, c9 as v9, c10 as v10, c16 as v16 " &					"from keplersc.kdtot " &					"where c1 = '" & /*"02"*/sucursal_id & "' and c2 = '" & v_tipoorden & "'" & " and c3 = '" & v_folio & "' and c4 = " & punto;					rstXml(xmlAlt);					xmlAlt = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");					frn.lib("libGeneral.kpl","FileSave",xmlAlt, fileSavePath & "\ser_ordenrpt_data_v_rpt");					ok=getXmlAtt(xmlAlt,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(xmlAlt,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										if (nXml(xmlAlt) > 0) { rep.exe("section-tots"); }										if (nXml(xmlAlt) > 0) {											for(var yx=0; yx < nXml(xmlAlt); yx++)