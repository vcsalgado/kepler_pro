<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>	<tab/><txt fnt=",22" clr="0,0,0">Cerrar orden en ceros</txt><br/>	<br/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grupo_crud" dim="80,22,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" 			hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" available="Y" tit="Cerrar orden en 0s"><tab/>			<br/>			<tab/>			<txt>Sucursal : </txt>						<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" tooltip="Sucursal" available="Y" modify="Y"/>			<br/>			<br/><tab/> <txt clr="0,58,112">Tipo :</txt><tab n="2"/>			<cmb id="k_tipo_orden" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "Y" modify="Y" 				 tooltip="Tipo de Orden" OnChange="SelTipoOrden()"/>			<sp n="3"/> <txt clr="0,58,112">Orden : </txt>			<inp id="k_orden" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" available = "Y" modify="Y" visible="Y"				 tooltip="N&#250;mero de &#243;rden ( F9 b&#250;squeda )" OnF9="ObtenerNumOrden()" OnChange="BuscarOrden()"/>			<br/><tab/>	 						<txt>Usuario : </txt><tab/>			<inp id="k_usuario" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="18" available="N" OnChange="" tooltip="Clave de Usuario" modify="N"/>			<br/><tab/><txt>Fecha :  </txt><tab/>			<inp id="k_fecha" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="date" nc="-1" available="N" OnChange="" tooltip="Fecha de proceso" modify="N" fmt="DD/MM/YY"/>			<br/><tab/><txt>Motivo :  </txt><tab/>			<inp id="k_motivo" dim="65,2" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="100" clrBrdr="255,255,255" tooltip="Motivo para cerrar en 0s"/>			<br/>			<br/>            <tab n="11"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Ejecuta()" visible="Y" available="Y"/><br/><br/><tab/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP,sys,resVal;            var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError,cuboQuery,usuario,fileSavePath;            var sucursal_id,tiporden,numorden,rol_usuario,suc_usuario,asterisco   ;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				kdb.connect();			   usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				fileSavePath = "C:\Basura";				Inicializa();								//ConfiguraControlesOpcion();			}						fun Inicializa(){													//Llenar combo sucursales				var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}												IniCombos("k_sucn",cmd );							//Fill Combo Tipo de Orden 				cmdQuery = "select c1||'-'||c3 as c2, c1  from keplersc.kdmargen";				IniCombos("k_tipo_orden",cmdQuery);				frn.set("k_tipo_orden", "");							frn.set("k_fecha",sys.date());				frn.set("k_usuario",usuario);			}					fun IniCombos(ctrl_combo, query){				cmdQuery = query;				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.IniCombos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set(ctrl_combo,cuboQuery);			}			fun SelTipoOrden(){				LimpiaTipOrden();			}			fun LimpiaTipOrden(){				frn.set("k_orden", "");					frn.set("k_motivo", "");				}			fun ObtenerNumOrden() {							sucursal_id = frn.get("k_sucn",-1,1);				tiporden = frn.get("k_tipo_orden",-1,1);				if (tiporden &= ""){					frn.message("Debe seleccionar tipo de Orden","Error","Aceptar");					return;				}					LimpiaNumOrden();				cmdQuery = "select C3 as orden, to_char(C4, 'dd/mm/yyyy') as fecha, C6 as serie,C11 as cliente " &							"from keplersc.kdord " & 							"where c1 = '" & sucursal_id & "' and c2= '" & tiporden & "' and c7=0 order by c4 desc";				frn.dialog("genlistasel","Ordenes",cmdQuery,"orden","k_orden","","","S");							}					fun LimpiaNumOrden(){				frn.set("k_motivo", "");			}									fun BuscarOrden(){					var xmlRef, nCampos, xmlRequest, xmlEncabezado;				var tmpStr, tmpXml, contDet, xmlCurDet, xmlDetConv, tmpUsocfdi;				// Guarda Datos para Busqueda 				sucursal_id = frn.get("k_sucn",-1,1);												tiporden = frn.get("k_tipo_orden",-1,1);				numorden = PadLeft(frn.get("k_orden"),"10","0"); 				frn.set("k_orden",numorden);					if (tiporden &= ""){					frn.setPos("k_tipo_orden");					frn.message("Debe seleccionar tipo de Orden","Error","Aceptar");					return;				}						//Valdar orden en ceros				cmdQuery = "select c3 from keplersc.kdordceros							where c1='" & sucursal_id & "' and c2='" & tiporden & "' and c3='" & numorden & "'";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcerrarordenceros.BuscarOrden()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboorden");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if((nXml(cuboQuery) > 0)) {					frn.setPos("k_orden");					frn.message("La orden ya se encuentra cerrada en 0s","Error","Aceptar");					return;								}				cmdQuery = "select c3 as orden, c7 as estatus from keplersc.kdord " &						"where c1='" & sucursal_id & "' and c2='" & tiporden & "' and c3='" & numorden & "'";										rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcerrarordenceros.BuscarOrden()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cubo");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}								if((nXml(cuboQuery) == 0) && (numorden &! "")) {					frn.setPos("k_orden");					frn.message("La orden no existe","Error","Aceptar");					return;				}				if (getXmlAtt(cuboQuery,"r0","estatus") &="20"){					frn.setPos("k_orden");					frn.message("La orden ya esta facturada","Error","Aceptar");					return;				}				if (getXmlAtt(cuboQuery,"r0","estatus") &="30"){					frn.setPos("k_orden");					frn.message("La orden ya tiene vale de salida","Error","Aceptar");					return;				}				ValPuntos();			}							fun ValPuntos(){				var punto, estatus;				cmdQuery = "select count(*) as ptosabiertos from keplersc.kdpun							where c1='" & frn.get("k_sucn",-1,1) & "' and c2='" & frn.get("k_tipo_orden",-1,1) & 							"' and c3='" & frn.get("k_orden") & "' and c7<>'T'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcerrarordenceros.ValPuntos()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ValPuntos");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if (getXmlAtt(cuboQuery,"r0","ptosabiertos") > 0){					frn.message("La orden tiene puntos sin terminar","Aviso","Aceptar");				}			}			fun ValidarDatos(){				if (frn.get("k_tipo_orden") &= "") {											frn.setPos("k_tipo_orden");					resVal=0;					frn.message("Debe especificar el tipo de la órden, verificar","Error","Aceptar");				}				if (frn.get("k_orden") &= "") {											frn.setPos("k_orden");					resVal=0;					frn.message("Debe especificar el folio de la órden, verificar","Error","Aceptar");				}				if (frn.get("k_motivo") &= "") {											frn.setPos("k_motivo");					resVal=0;					frn.message("El motivo no puede estar en blanco, favor de especificar","Error","Aceptar");				}else{					if (strlen(frn.get("k_motivo")) <=5){						frn.setPos("k_motivo");						resVal=0;						frn.message("Especifique un motivo valido","Error","Aceptar");					}				}			}			fun Ejecuta() {				var xmlPantalla,continua,partidas;				partidas = 1;				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}				continua = frn.message("¿Desea continuar para cerrar en ceros?","Atención",2);				if (continua == 0){					return;				}				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;								setXml(xmlPantalla,"tabla","r0","seleccionar","S");				setXml(xmlPantalla,"tabla","r0","k_tipo_orden",frn.get("k_tipo_orden",-1,1));				setXml(xmlPantalla,"tabla","r0","k_orden",frn.get("k_orden"));				setXml(xmlPantalla,"tabla","r0","k_motivo",frn.get("k_motivo"));				setXml(xmlPantalla,"tabla","no_partidas",partidas);				frn.lib("libGeneral.kpl","FileSave",xmlPantalla ,"C:\Basura\xmlPantalla ");						cmdQuery="SELECT * FROM keplersc.cerrar_orden_ceros('<document>" & getXmlStr(xmlPantalla ,"EOF:13_10") & "</document>')";				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvcerrarordenceros.Ejecuta()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");				var mensaje = getXml(cubo,"mensaje");				if(resultado &= "0"){					frn.message(mensaje ,"Error","Aceptar");					return;				}					if(resultado &= "1"){					frn.message(mensaje ,"Atencion","Aceptar");				}							}						fun PadLeft(pText,pRelleno,pCaracterRelleno) {			var Resultado;			var pos_ini = pText;			var nReg = strlen(pText);			for (var cont = nReg; cont < pRelleno; cont++) {				Resultado = pCaracterRelleno & Resultado;			}			Resultado = Resultado & pText;                			return Resultado;		}							}	</script></pag>