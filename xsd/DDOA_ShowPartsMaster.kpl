<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Selecci&#243;n de Registro"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,15,12" bclr="192,205,213" unfont="0">	<tab/>	<inp id="inp_titulo" dim="50,1" clr="0,0,0"  type="string" modify="N" available="N" fnt="Arial,22"/>	<br/>	<tab n="1"/>	<hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="50,60,10,10" brdr="0,5" tit="Seleccion de registros a consultar" fnt="Arial,16">		<sp/><txt>Inicial:</txt>		<inp id="k_prod_ini" dim="15,1" bclr="255,255,255" clr="64,64,64" clrBrdr="192,205,213" type="string" brdr="2,0"/>		<tab n="2"/><txt>Final:</txt>		<inp id="k_prod_fin" dim="15,1" bclr="255,255,255" clr="64,64,64" clrBrdr="192,205,213" type="string" brdr="2,0"/><tab n="3"/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_Registros()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>				<br/>		<sp/>		<tbl clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" brdr="1,0" id="results" dim="73,10" 			modify="N" nren="fijo" Reorder="Y" OnEnter="MostrarRegistro()" OnMouseL="MostrarRegistro()">			<col name="Resultados" id="Rsultados"/>		</tbl><br/>		<grp id="gpo_3" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="70,3,10,10" brdr="0,5" fnt="Arial,16" visible="S">			<sp/>			<bot id="banterior"  dim="6,10" brdr="5" text="&lt;&lt;" fnt="Arial,16" OnEnter="Buscar_Registros(-100)" visible="N" tooltip="Anterior p&#225;gina de resultados" available="N" modify="N"/><tab/>			<inp id="reg_mostrados" dim="20,1" clr="0,0,0"  type="string" modify="N" available="N" fnt="Arial,16"/>			<tab/>			<bot id="bsiguiente"  dim="6,0" brdr="5" text="&gt;&gt;" fnt="Arial,16" OnEnter="Buscar_Registros(100)" visible="N" tooltip="Siguiente p&#225;gina de resultados" available="N" modify="N"/><tab n="10"/>			<img id="Exportar" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_60_Save.png" OnEnter="guardar_tabla(results)"/> 		</grp>		<br/>				<hLine clr="0,0,0"/>		<br/><sp/><txt>Detalle del registro</txt><br/>		<sp/>		<tbl id="tbl_registros" dim="73,19" brdr="1,0" clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" modify="N" Reorder="N" insdel="N">			<col id="Dato" name="Dato"/>			<col id="Valor" name="Valor"/>		</tbl><br/>			</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,cuboXml;			var expSql,titulo,mostrarRegs,asterisco;			var accion,tipoOper; //Variables relacionadas con parametros			var regTotales; //variables del llenado de la tabla			var strTitulo, strQuery;			var offset,iniciando;						var consecutivo_pml;			var consecutivo_pmh;			var partname;			var itemid;			var packagequantity;			var programcode;			var supersedingpartnumberid;			var supersedingpartquantity;			var brand;			var stratificationcode;			var parttobereturnedindicator;			var minimumbuyquantity;			var unitcode;			var itemweightmeasure;			var maximumbuyquantity;			var supersedingreason;			var partchangestatus;			var unitpriceamount;			var unitpriceamount_currencyid;			var retailpriceamount;			var retailpriceamount_currencyid;			var wholesalepriceamount;			var wholesalepriceamount_currencyid;			var fechaoperacion;			var procesado;			var fechaprocesado;				fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				titulo="DDOA Consulta Partes Toyota";				iniciando="S";				asterisco = "*";				ConfiguraUI();				Inicializa();				mostrarRegs="S"; //Habilita consulta de registros			}			/*"consecutivo_pml,consecutivo_pmh,partname,itemid,packagequantity,programcode,supersedingpartnumberid,supersedingpartquantity,brand,stratificationcode,parttobereturnedindicator,minimumbuyquantity,unitcode,itemweightmeasure,maximumbuyquantity,supersedingreason,partchangestatus,unitpriceamount,unitpriceamount_currencyid,retailpriceamount,retailpriceamount_currencyid,wholesalepriceamount,wholesalepriceamount_currencyid,fechaoperacion,procesado,fechaprocesado"*/			fun MostrarRegistro(){				var col,cols,row,dato,valor;				cols=25;				frn.rst("tbl_registros");								frn.setX("Consecutivo PML","tbl_registros",0,"Dato");								frn.setX("Consecutivo OMH","tbl_registros",1,"Dato");				frn.setX("Part Name","tbl_registros",2,"Dato");				frn.setX("Item id","tbl_registros",3,"Dato");				frn.setX("Package Quantity","tbl_registros",4,"Dato");				frn.setX("Program Code","tbl_registros",5,"Dato");				frn.setX("Superseding Part Number ID","tbl_registros",6,"Dato");				frn.setX("Superseding Part Quantity","tbl_registros",7,"Dato");				frn.setX("Brand","tbl_registros",8,"Dato");				frn.setX("Stratification Code","tbl_registros",9,"Dato");				frn.setX("Part to be returned Indicator","tbl_registros",10,"Dato");				frn.setX("Mnimum buy Quantity","tbl_registros",11,"Dato");				frn.setX("Unit Code","tbl_registros",12,"Dato");				frn.setX("Item Weight Measure","tbl_registros",13,"Dato");				frn.setX("Maximum Buy Quantity","tbl_registros",14,"Dato");				frn.setX("Supers Edingreason","tbl_registros",15,"Dato");								frn.setX("Part Change Status","tbl_registros",16,"Dato");				frn.setX("Unit Price Amount","tbl_registros",17,"Dato");				frn.setX("Unit Price Amount Currency ID","tbl_registros",18,"Dato");				frn.setX("Retail Price Amount","tbl_registros",19,"Dato");				frn.setX("Retail Price Amount Currency ID","tbl_registros",20,"Dato");				frn.setX("Wholesale Price Amount","tbl_registros",21,"Dato");				frn.setX("Wholesale Price Amount Currency ID","tbl_registros",22,"Dato");				frn.setX("Fecha Operacion","tbl_registros",23,"Dato");				frn.setX("Procesado","tbl_registros",24,"Dato");				frn.setX("Fecha Procesado","tbl_registros",25,"Dato");				frn.setX(frn.get("results",-1,consecutivo_pml),"tbl_registros",0,"Valor");								frn.setX(frn.get("results",-1,consecutivo_pmh),"tbl_registros",1,"Valor");				frn.setX(frn.get("results",-1,partname),"tbl_registros",2,"Valor");				frn.setX(frn.get("results",-1,itemid),"tbl_registros",3,"Valor");				frn.setX(frn.get("results",-1,packagequantity),"tbl_registros",4,"Valor");				frn.setX(frn.get("results",-1,programcode),"tbl_registros",5,"Valor");				frn.setX(frn.get("results",-1,supersedingpartnumberid),"tbl_registros",6,"Valor");				frn.setX(frn.get("results",-1,supersedingpartquantity),"tbl_registros",7,"Valor");				frn.setX(frn.get("results",-1,brand),"tbl_registros",8,"Valor");				frn.setX(frn.get("results",-1,stratificationcode),"tbl_registros",9,"Valor");				frn.setX(frn.get("results",-1,parttobereturnedindicator),"tbl_registros",10,"Valor");				frn.setX(frn.get("results",-1,minimumbuyquantity),"tbl_registros",11,"Valor");				frn.setX(frn.get("results",-1,unitcode),"tbl_registros",12,"Valor");				frn.setX(frn.get("results",-1,itemweightmeasure),"tbl_registros",13,"Valor");				frn.setX(frn.get("results",-1,maximumbuyquantity),"tbl_registros",14,"Valor");				frn.setX(frn.get("results",-1,supersedingreason),"tbl_registros",15,"Valor");								frn.setX(frn.get("results",-1,partchangestatus),"tbl_registros",16,"Valor");				frn.setX(frn.get("results",-1,unitpriceamount),"tbl_registros",17,"Valor");				frn.setX(frn.get("results",-1,unitpriceamount_currencyid),"tbl_registros",18,"Valor");				frn.setX(frn.get("results",-1,retailpriceamount),"tbl_registros",19,"Valor");				frn.setX(frn.get("results",-1,retailpriceamount_currencyid),"tbl_registros",20,"Valor");				frn.setX(frn.get("results",-1,wholesalepriceamount),"tbl_registros",21,"Valor");				frn.setX(frn.get("results",-1,wholesalepriceamount_currencyid),"tbl_registros",22,"Valor");				frn.setX(frn.get("results",-1,fechaoperacion),"tbl_registros",23,"Valor");				frn.setX(frn.get("results",-1,procesado),"tbl_registros",24,"Valor");				frn.setX(frn.get("results",-1,fechaprocesado),"tbl_registros",25,"Valor");											}			fun Encabezados(){				var colIds, totReg;				frn.rst("results");								totReg=nXml(cuboXml);				colIds=getXmlAtt(cuboXml,"k_ColName");				if(colIds &! ""){					frn.setX(colIds,"results","k_ColName");					frn.setX(getXmlAtt(cuboXml,"k_ColType"),"results","k_ColType");					frn.setX(getXmlAtt(cuboXml,"k_ColNd"),"results","k_ColNd");					frn.setAtt("llave","visible","N");				}			}			fun ConfiguraUI(){				frn.set("inp_titulo",titulo); //EL TITULO DEL REPORTE EN PANTALLA				frn.setAtt("gpo_2","Resultados de busqueda"); //TITULO DE GRUPO EN PANTALLA							}								fun Inicializa(){				frn.rst("gpo_2");				consecutivo_pml="consecutivo_pml";				consecutivo_pmh="consecutivo_pmh";				partname="partname";				itemid="itemid";				packagequantity="packagequantity";				programcode="programcode";				supersedingpartnumberid="supersedingpartnumberid";				supersedingpartquantity="supersedingpartquantity";				brand="brand";				stratificationcode="stratificationcode";				parttobereturnedindicator="parttobereturnedindicator";				minimumbuyquantity="minimumbuyquantity";				unitcode ="unitcode";				itemweightmeasure="itemweightmeasure";				maximumbuyquantity="maximumbuyquantity";				supersedingreason="supersedingreason";				partchangestatus="partchangestatus";				unitpriceamount="unitpriceamount";				unitpriceamount_currencyid="unitpriceamount_currencyid";				retailpriceamount="retailpriceamount";				retailpriceamount_currencyid="retailpriceamount_currencyid";				wholesalepriceamount="wholesalepriceamount";				wholesalepriceamount_currencyid="wholesalepriceamount_currencyid";				fechaoperacion="fechaoperacion";				procesado="procesado";				fechaprocesado="fechaprocesado";									Encabezados();				Inicia_Forma();			}				fun Inicia_Forma(){				//Etiquetas 				frn.set("inp_mensaje","No se encontraron registros...");				//Obtencion de registros				//Buscar_Registros(); 			}			fun valida_offset(n_reg_tabla){				var txt = "Mostrando registos del " & (offset+1) & " al " & offset + 100 & " de " & n_reg_tabla;				if (offset <= 0) {											frn.setAtt("banterior", "available", "N" );					frn.setAtt("banterior", "modify", "N" );					frn.setAtt("banterior", "visible", "N" );				}else{					frn.setAtt("banterior", "available", "Y" );					frn.setAtt("banterior", "modify", "Y" );					frn.setAtt("banterior", "visible", "Y" );				}								if (offset+100 >= n_reg_tabla){										frn.setAtt("bsiguiente", "available", "N" );					frn.setAtt("bsiguiente", "modify", "N" );					frn.setAtt("bsiguiente", "visible", "N" );					txt = "Mostrando registos del " & (offset+1) & " al " & n_reg_tabla & " de " & n_reg_tabla;								}else{					frn.setAtt("bsiguiente", "available", "Y" );					frn.setAtt("bsiguiente", "modify", "Y" );					frn.setAtt("bsiguiente", "visible", "Y" );				}				if (mostrarRegs &= "S"){					frn.set("reg_mostrados", txt);				}			}						fun Buscar_Registros(pag){				var cmd, mensajeError,ok,nReg;				var tabla,expSelect,expWhere,expOrder;				var prodIni, prodFin, criterio;				if (pag==0){					offset=0;				}				offset = offset+pag;				kdb.rst();				frn.rst("results");				prodIni = frn.get("k_prod_ini");				prodFin = frn.get("k_prod_fin");				criterio =""; 				if (prodIni &! "" || prodFin &! ""){									if (prodFin &= ""){						prodFin = prodIni;					}					if (prodIni &= ""){						prodIni = prodFin;					}					if (prodIni > prodFin){						frn.set("k_prod_ini",prodFin);						frn.set("k_prod_fin",prodIni);					}else{						frn.set("k_prod_ini",prodIni);						frn.set("k_prod_fin",prodFin);					}				prodIni = frn.get("k_prod_ini");				prodFin = frn.get("k_prod_fin");					criterio = " and itemid >= '" & prodIni & "' and itemid <= '" & prodFin & "'"; 				}				expSql= "select * from keplersc.ddoa_showpartsmasterline where 1=1 " & criterio; 				expSelect = "select * from (" & expSql & ") as resultado " ;				expSelect = expSelect & expWhere & expOrder;				frn.lib("libGeneral.kpl","FileSave",expSelect,"C:\Basura\cmdSPM");				var n_reg_tabla = "SELECT COUNT(*) FROM ("& expSelect &") AS subconsulta";				rstXml(cuboXml);				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",n_reg_tabla,"DDOA_ShowPartsMaster.buscar_registros()");				frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\DDOA_ShowPartsMaster");				n_reg_tabla = getXmlAtt(cuboXml,"r0","count");								valida_offset(n_reg_tabla);				expSelect= expSelect & " LIMIT 100 OFFSET " & offset;								rstXml(cuboXml);				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",expSelect,"DDOA_ShowPartsMaster.buscar_registros()");				frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\cuboXmlDDOA");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}					Encabezados();				frn.set("results",cuboXml);				nReg=nXml(cuboXml);				regTotales = nReg;				if(nReg == 0){					frn.message("No se encontraron registros","Mensaje", "Aceptar");					return;							}				MostrarRegistro();							}			fun guardar_tabla(tabla){				var save = frn.saveFile("tabla","Todos los archivos,*.*","_C:","Para guardar archivo");				frn.dialog("guarda_tabla",tabla,save); 			}					}	</script></pag>