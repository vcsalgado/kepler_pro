<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Ordenes Taller"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab n="2"/><txt clr="0,0,0" fnt="Arial,25">Iniciar Trabajos</txt><br/>	<tab/><hLine/>	<br/><br/>	<tab/>	<grp dim="110,10,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle de la orden">		<sp/><txt fnt=",18b">Sucursal:</txt><sp/><inp id="k_sucursal" dim="5,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",18"/>		<sp/><inp id="k_sucnombre" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",18"/><tab/><txt fnt=",18b">Fecha:  </txt>		<inp id="k_fecha" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" modify="N" available="N" fmt="DD/MM/CCYY" nc="-1" fnt=",18"/><tab/><txt fnt=",18b">Estatus:</txt>		<inp id="k_estatusdesc" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",18"/><tab n="2"/>		<br/>		<sp/><txt  fnt="Arial,18,b">Tipo:</txt><sp/><inp id="k_tipo" clr="64,64,64"  dim="3,1" fnt="Arial,18" clrBrdr="255,255,255"   bclr="255,255,255" modify="N" visible="Y" type="string" brdr="2,0"/>		<sp/><inp id="k_tipodesc" dim="25,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" fnt=",18" modify="N" available="N"/>		<tab/><txt  fnt="Arial,18,b">Folio:</txt><sp/><inp id="k_folio" clr="64,64,64"  dim="18,1" fnt="Arial,18" clrBrdr="255,255,255"   bclr="255,255,255" brdr="2,0"  modify="N" visible="Y" type="string"/>		<tab/><txt fnt=",18b">Cliente: </txt><sp/><inp id="k_cliente" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",18"/>		<sp/><inp id="k_nombre" dim="50,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",18"/>		<br/>		<sp/><txt fnt=",b">VIN: </txt><sp/><inp id="k_serie" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",18"/>		<tab/><txt fnt=",18b"> Marca:</txt><sp/>	<inp id="k_marca" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",18"/>		<tab/><txt fnt=",18b">Modelo:</txt><sp/><inp id="k_modelo" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",18"/>		<tab/><txt fnt=",18b">A&#241;o:</txt><sp/><inp id="k_anio" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",18"/>		<tab/><txt fnt=",18b">Placas:</txt><sp/><inp id="k_placa" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",18"/>		<tab/><txt fnt=",18b">Bonete:</txt><sp/><inp id="k_bonete" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",18"/>	</grp>	<br/><br/>		<tab n="1"/>	<grp dim="110,34,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle de puntos">		<sp/>		<tbl id="tabla_puntos" dim="154,9"  bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  hk="z" OnChange="" Reorder="N" modify="Y" available="Y">			<col id="numero_punto" name="Numero de Punto" modify="N"  type="capital"/>			<col id="desc_punto" name="Tipo de Punto" modify="N"  type="capital"/>			<col id="trabajo_a_realizar" name="Descripcion" modify="Y" type="capital"/>			<col id="clave_operario" name="Operario"/>			<col id="status" name="Estatus"  modify="N"/>		</tbl>		<br/><br/>		<tab n="46"/><bot id="bot_iniciar" dim="14,0" brdr="5" text="Iniciar Trabajo" default="0" OnEnter="iniciar_trabajo()"/>		<br/><br/>		<sp/>			<tbl id="tabla_sintomas" dim="115,9"  bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  hk="z" OnChange="" Reorder="N" modify="Y" available="Y">			<col id="tipo_sint" name="Tipo Sintoma" modify="N"/>			<col id="clave_sint" name="Clave Sintoma" modify="N"/>			<col id="desc_sint" name="Descripcion"/>			<col id="comentarios" name="Comentarios"/>			<col id="punto_sint" name="Punto"  modify="N"/>			<col id="partida" name="Partida" modify="Y"/>		</tbl>	</grp>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,usuario,perfil_usuario,rol_usuario  ,asterisco, externo, sucursal,folio_orden, tipo_orden , vin;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								usuario = frn.config("user","name");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								sucursal =trim(frn.param(0));				folio_orden=trim(frn.param(1));				tipo_orden=trim(frn.param(2));				Inicializa();			}												fun Inicializa(){							var  cmd, cubo, ok, mensajeError ;								cmd = " select c1 from keplersc.kdoper where c20='" & usuario & "'";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_iniciar_trabajo.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\perfil_usuario");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}			 				var clave_usuario = getXmlAtt(cubo ,"r0","c1");							var xmlOrden, xmlDatos;							xmlOrden= frn.lib("libOrdenes.kpl","ConsultaOrden",sucursal,tipo_orden,folio_orden);								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				xmlDatos = frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",xmlOrden,"r0");				frn.lib("libGeneral.kpl","FileSave",xmlOrden,"C:\Basura\xmlOrden");					frn.lib("libGeneral.kpl","FileSave",xmlDatos,"C:\Basura\xmlDatos");							frn.setX(xmlDatos);								cmd = " select pun.c4 as numero_punto,cat.c2 desc_punto, pun.c8 as trabajo_a_realizar,pun.c9 as clave_operario,  pun.c7 as status  ";				cmd = cmd & "from keplersc.kdpun as pun inner join keplersc.catpuntos as cat on cat.c1=pun.c6 ";				cmd = cmd & " left outer join keplersc.kdpunres as rec on rec.c1=pun.c1 and rec.c2=pun.c2 and rec.c3=pun.c3 and rec.c4=pun.c4 " ;				cmd = cmd & " where pun.c1='" & sucursal & "' and pun.c2='" & tipo_orden & "' and pun.c3='" & folio_orden & "' and pun.c7= 'A' and pun.c9='" & clave_usuario & "'";				cmd = cmd & " and (rec.c5 is null or rec.c5 <> 10 )";								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\puntosquery");					rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_iniciar_trabajo.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\puntos");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												frn.setX(cubo,"tabla_puntos");								cmd = " select sint.c6 as tipo_sint ,sint.c7 as clave_sint,cat.c3 as desc_sint,sint.c8 as comentarios, sint.c4 as punto_sint, sint.c5 as partida  ";				cmd = cmd & "from keplersc.kdordsint as sint inner join keplersc.kdvaltipsin as cat on cat.c1=sint.c6 and cat.c2=sint.c7  ";				cmd = cmd & " inner join keplersc.kdpun as pun on pun.c1=sint.c1 and pun.c2=sint.c2 and pun.c3=sint.c3 and pun.c4=sint.c4  ";				cmd = cmd & " left outer join keplersc.kdpunres as rec on rec.c1=sint.c1 and rec.c2=sint.c2 and rec.c3=sint.c3 and rec.c4=sint.c4 " ;				cmd = cmd & " where sint.c1='" & sucursal & "' and sint.c2='" & tipo_orden & "' and sint.c3='" & folio_orden & "' and pun.c7= 'A' and pun.c9='" & clave_usuario & "'";				cmd = cmd & " and (rec.c5 is null or rec.c5 <> 10 )";										rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_iniciar_trabajo.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\puntos");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												frn.setX(cubo,"tabla_sintomas");				}						fun iniciar_trabajo(){													var cmd, cubo, ok, mensajeError,xmlRequest ;							setXml(xmlRequest,"sucursal_id", sucursal );				setXml(xmlRequest, "tipo_orden", tipo_orden);				setXml(xmlRequest,"folio_orden", folio_orden);				setXml(xmlRequest,"numero_punto", frn.get("tabla_puntos", -1, "numero_punto"));				setXml(xmlRequest,"clave_operario", perfil_usuario );							frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.ser_iniciar_trabajo(' <document> " & getXmlStr(xmlRequest,"EOF:13_10") & " </document> ')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_iniciar_trabajo.iniciar_trabajo()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var resultado = getXmlAtt(cubo,"r0","resultado");							if(resultado &= "0"){					mensajeError = getXmlAtt(cubo,"r0","mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								if(resultado &= "1"){					var mensaje = getXmlAtt(cubo,"r0","mensaje");					frn.message(mensaje ,"Atencion","Aceptar");					Inicializa();				}													}						fun salir (){							frn.exit();			}							//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------								fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}																}	</script></pag>