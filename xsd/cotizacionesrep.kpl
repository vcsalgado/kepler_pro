<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<tab/><txt fnt=",22" clr="0,0,0">Reporte de Cotizaciones</txt><br/>		<tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp dim="140,45,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="8" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Criterio de selecci&#243;n">			<tab/><txt>Sucursal:</txt><sp/>			<cmb id="cmb_sucursal" dim="50,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" Null="N" modify="Y" available="Y"/><tab n="2"/><txt>Operador : </txt>			<cmb id="cmb_operador" dim="50,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y"/>			<br/><tab/><txt>Recepcionista: </txt>			<cmb id="cmb_recepcionista" dim="46,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y"/><tab n="2"/><txt>Tipo autorizacion: </txt><cmb id="cmb_tipoauto" dim="20,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"/>			<br/>			<tab/><txt>Fecha inicial: </txt>			<edt id="edt_fecha_ini" dim="14,1" brdr="0,5" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" fmt="DD/MM/CCYY" fnt="Arial,16" page="_ks_fecha,edt_fecha_ini"/>			<tab n="2"/><txt>Fecha final: </txt>			<edt id="edt_fecha_fin" dim="14,1" brdr="0,5" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" fmt="DD/MM/CCYY" fnt="Arial,16" page="_ks_fecha,edt_fecha_fin"/><tab n="2"/>			<img id="bot_buscar" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			<br/><br/>						<tab/><tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="194,20">				<col id="folio" name="Folio"/>				<col id="orden" name="Orden"/>				<col id="unidad" name="Unidad"/>				<col id="vin" name="Vin"/>				<col id="asesor" name="Asesor"/>				<col id="cve_oper" name="cve_operador"/>				<col id="operador" name="Operador"/>								<col id="solicitud" name="Fec. Sol."/>				<col id="cotizacion" name="Fec. Cot."/>				<col id="autorizacion" name="Fec. Aut."/>					<col id="punto" name="Punto"/>					<col id="num_parte" name="Parte"/>					<col id="descripcion" name="Descripcion"/>					<col id="stock" name="Stock"/>					<col id="cantidad" name="Cantidad"/>				<col id="precio" name="Precio"/>					<col id="importe" name="Importe"/>					<col id="tipo_autorizacion" name="Tipo Aut."/>					<col id="tipo_parte" name="Tipo Parte"/>				<col id="razon" name="Razon"/>			</tbl> 			<br/><br/>			<tab/>			<img id="Exportar" dim="40,40" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(k_mov)" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y" tooltip="Guardar tabla"/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys,rol_usuario,suc_usuario ,asterisco;			fun Main() {				frn=new FRNT;				kdb=new KDB;				sys=new SYS;				kdb.connect();				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				Inicializa();			}			fun Inicializa(){//Inicializa los valores en Pantalla				frn.set("edt_fecha_ini",sys.date(sys.date("year"),sys.date("month"),1));				frn.set("edt_fecha_fin",sys.date(sys.date("year"),sys.date("month"),31));				IniCombos();				frn.set("ch_excluir","1");			}									fun IniCombos(){				var cmd, cuboQuery, xmlResQuery, ok, mensajeError, strTmp;				cuboQuery="datDoc";											//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("cmb_sucursal",getXml(cubo));								//Combo Asesores				cmd = "select 'TODOS' as c2, '' as c1 union select c1 || ' - ' || c2 as c2, c1 from keplersc.kdrecep where c1 <> '' order by c2";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cotizacionesrep.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("cmb_recepcionista",getXml(cubo));								//Llenar combo operadores				cmd = "select 'TODOS' as c3, '' as c1 union select c1 || ' - ' || c3 as c3, c1 from keplersc.kdoper where c1 <> '' order by c3";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cotizacionesrep.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("cmb_operador",getXml(cubo));								//Llenar combo autorizacion				frn.setX("AUTORIZADO","cmb_tipoauto",0,0);				frn.setX("10","cmb_tipoauto",0,1);								frn.setX("NO AUTORIZADO","cmb_tipoauto",1,0);				frn.setX("20","cmb_tipoauto",1,1);				frn.setX("SIN AUTORIZACION","cmb_tipoauto",2,0);				frn.setX("0","cmb_tipoauto",2,1);								frn.setX("TODAS","cmb_tipoauto",3,0);				frn.setX("","cmb_tipoauto",3,1);			}			fun Buscar(){							var cmd, cubo, ok,mensajeError,sucursal_id,recep,oper,tipo_auto ; 								sucursal_id = frn.get("k_sucN",-1,1);				recep = frn.get("cmb_recepcionista",-1,1);				oper = frn.get("cmb_operador",-1,1);				tipo_auto=frn.get("cmb_tipoauto",-1,1);								cmd = "select ref.c2 as folio, cot.c12 || ' ' || cot.c13 as orden, ser.c3 as unidad, ser.c4 as vin, " &					"recep.c2 as asesor, cot.c21 as cve_operador, oper.c3 as operador, " &					"substring(cot.c3::text,1,10) || ' ' || cot.c4 as solicitud, substring(cot.c6::text,1,10) || ' ' || cot.c7 as cotizacion, substring(cot.c9::text,1,10) || ' ' || cot.c10 as autorizacion, " &					"ref.c3 as punto, ref.c4 num_parte, ref.c5 as descripcion, " &					"inl.c5-inl.c6 as stocl, " &					"ref.c6 as cantidad, ref.c7 as precio, ref.c8 as importe, " &					"case ref.c11 when 0 then 'SIN AUTORIZACION' when 10 then 'AUTORIZADO' when 20 then 'NO AUTORIZADO' end as tipo_autorizacion, " &					"tipref.c2 as tipo_parte, coalesce(traz.c2,'') as razon " &					"from keplersc.kdsercotref ref " &					"inner join keplersc.kdsercot cot on cot.c1=ref.c1 and cot.c2=ref.c2 " &					"inner join keplersc.kdord ord on ord.c1=ref.c1 and ord.c2=cot.c12 and ord.c3=cot.c13 " &					"inner join keplersc.kdserie ser on ser.c1=ord.c6 " &					"left outer join keplersc.kdinl inl on inl.c1=ref.c1 and inl.c2=ref.c4 " &					"inner join keplersc.kdsercottipref tipref on tipref.c1=ref.c9 " &					"left outer join keplersc.kdsercotraz traz on traz.c1=ref.c10 " &					"inner join keplersc.kdrecep recep on recep.c1=ord.c22 " &					"inner join keplersc.kdoper oper on oper.c1=cot.c21 " &					"where cot.c3 >= '" & frn.get("edt_fecha_ini") & " 00:00:00" & "' and cot.c3<='" & frn.get("edt_fecha_fin") & " 23:59:59' ";					if (recep &! ""){						cmd = cmd & "and recep.c1 = '" & recep & "' ";					}					if (oper &! ""){						cmd = cmd & "and oper.c1 = '" & oper & "' ";					}					if (tipo_auto &! ""){						cmd = cmd & "and ref.c11 = '" & tipo_auto & "' ";					}										cmd = cmd & "order by ref.c1,ref.c2,ref.c4 ";								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdCotizaciones");									rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cotizacionesrep.Buscar()");								frn.lib("libGeneral.kpl","FileSave",cubo,"c:\Basura\cuboCotizaciones");										ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_mov",cubo);			}									fun guardar_tabla(tabla){				var save = frn.saveFile("tabla","Todos los archivos,*.csv","_C:","Para guardar archivo");				frn.dialog("guarda_tabla",tabla,save); 			}		}	</script></pag>