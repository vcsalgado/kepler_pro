<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/><tab/><inp id="k_titulo" dim="65,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"				type="string" modify="N" available="N" fnt="Arial,22"/>	<br/>	<br/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grupo_crud" dim="80,16,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="Nuevo" available="Y"><tab/>			<br/><br/><tab n="3"/><txt>   Marca : </txt>			<cmb id="k_marca" dim="25,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" fnt=",16" available="Y" modify="Y"/><tab/>			<br/><sp/><tab n="3"/><txt>    Clave : </txt>			<inp id="k_clave" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="10" available="Y" OnChange="" tooltip="Clave de la L&#237;nea" modify="Y"/>			<br/><sp/><tab n="2"/>			<txt>Descripci&#243;n :  </txt>			<inp id="k_descripcion" dim="50,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="30" clrBrdr="255,255,255" tooltip="Descripci&#243;n de la l&#237;nea"/><sp/>			<br/>			<tab n="2"/><txt>    Tipo Veih : </txt>			<cmb id="k_tipo_vei" dim="18,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" fnt=",16"/><tab/>			<br/><sp/><tab n="13"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/><br/>			<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>							</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP, accion,externo, clave_sel,sucursal_id,cve_color,resVal,straccion, marca_sel;            var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError,cuboQuery;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();			    Inicializa();				ctlrs_off();				insertar_datos();				ctlrs_opcion();			}						fun Inicializa(){				accion = frn.param(0);				frn.set("input_crud", accion);				frn.rst("grupo_crud");				externo	= frn.param(2);                if (accion &= "NUEVO"){                    straccion = "Nuevo" ;                   }else if (accion &= "CONSULTAR"){                    straccion = "Consultar";                }else if (accion &= "MODIFICAR"){                    straccion = "Modificar";                }else if (accion &= "ELIMINAR"){                    straccion = "Eliminar";                }     								frn.setAtt("grupo_crud", "tit", straccion );				clave_sel = frn.param(1);				marca_sel = frn.param(3);				if (accion &! "NUEVO"){					frn.set("k_clave", clave_sel);				}				}						fun ctlrs_off(){				frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );			}							fun ctlrs_opcion(){				if (accion &= "NUEVO"){					frn.setAtt("k_clave","available","Y");					frn.setAtt("k_clave", "modify", "Y" );					frn.setAtt("k_marca","available","Y");					frn.setAtt("k_marca", "modify", "Y" );				    frn.set("k_titulo","Catálogo de Modelos");								}else { 					frn.setAtt("k_clave", "available", "N" );                    frn.setAtt("k_clave", "modify", "N" );					frn.setAtt("k_marca", "available", "N" );                    frn.setAtt("k_marca", "modify", "N" );					if (accion &= "MODIFICAR") {                        frn.setAtt("grupo_crud", "available","Y");						frn.setAtt("k_descripcion", "available", "Y" );						frn.setAtt("k_tipo_vei", "available", "Y" );						                    }else{						frn.setAtt("k_marca", "available","N");                        frn.setAtt("k_clave", "available","N");                        frn.setAtt("k_clave", "modify", "N" );                        frn.setAtt("k_descripcion", "available","N");                        frn.setAtt("k_tipo_vei", "modify", "N" );						frn.setAtt("btn_aceptar", "visible", "N" );                    }									}				if (accion &! "CONSULTAR"){					frn.setAtt("btn_aceptar", "available", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );				}			}							fun insertar_datos(){					cmdQuery = "select '['||c1||'] '||c2 as c2, c1, c2 as c3  from keplersc.kdmarcas order by c1";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_modelos.IniCombos()");				frn.set("k_marca",cuboQuery);					frn.setX("[A] Auto", "k_tipo_vei",1,0);				frn.setX("A", "k_tipo_vei",1,1);				frn.setX("[C] Camion", "k_tipo_vei",2,0);				frn.setX("C", "k_tipo_vei",2,1);					if (accion &= "MODIFICAR"){					//llamada externa(padre)					if (externo &= "s"){						if (clave_sel &= ""){							frn.message("selecciona una clave con F9 para modificar","Error","Aceptar");							frn.setAtt("btn_aceptar", "visible", "N" );							return;						}					}				}				if (accion &! "NUEVO") {					cmdQuery="select c1,c2,c3,c4 from keplersc.kdmodelos where c1='" & marca_sel & "' and c2 ='"& clave_sel &"'"; 					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_lineas_crud.insertar_datos()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.setX(getXmlAtt(cuboResultados,"r"&0,"c1"),"k_marca",0,0);					frn.setX(getXmlAtt(cuboResultados,"r"&0,"c1"),"k_marca",0,1);					//frn.set("k_marca",getXmlAtt(cuboResultados,"r"&0,"c1"));					frn.set("k_descripcion",getXmlAtt(cuboResultados,"r"&0,"c3"));					frn.setX(getXmlAtt(cuboResultados,"r"&0,"c4"),"k_tipo_vei",0,0);					frn.setX(getXmlAtt(cuboResultados,"r"&0,"c4"),"k_tipo_vei",0,1);                }else{                    frn.setAtt("grupo_crud", "available","Y");                    frn.setPos("k_clave");    				}			}						fun ValidarDatos(){				if (frn.get("k_marca") &= "") {											frn.setPos("k_marca");					resVal=0;					frn.message("Debe especificar la descripción de Modelo, verificar","Error","Aceptar");				}				if (frn.get("k_clave") &= "") {											frn.setPos("k_clave");					resVal=0;					frn.message("Debe especificar la clave de Modelo, verificar","Error","Aceptar");				}				if (frn.get("k_descripcion") &= "") {											frn.setPos("k_descripcion");					resVal=0;					frn.message("Debe especificar la descripción de Modelo, verificar","Error","Aceptar");				}				if (frn.get("k_tipo_vei") &= "") {											frn.setPos("k_tipo_vei");					resVal=0;					frn.message("Debe especificar la descripción de Modelo, verificar","Error","Aceptar");				}			}			fun Execute() {				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}								var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}								xmlRequest = getXml(frn.dataPag());					frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmdQuery="SELECT * FROM keplersc.cat_crud_modelos('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_exteriores_crud.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frP.script("Inicia_Forma()");				if (accion &= "NUEVO" || accion &= "MODIFICAR") {						var sms =  "";					if (accion &= "NUEVO"){						sms = "Registro guardado";					}else {						sms = "Registro modificado";					}					accion="CONSULTAR";					ctlrs_opcion();					frn.message(sms ,"Mensaje","Aceptar");						frn.exit();					}				if (accion &= "ELIMINAR"){					frn.message("Registro eliminado","Mensaje","Aceptar");					frn.exit();							}			}							}	</script></pag>