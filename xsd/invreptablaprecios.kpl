<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Tabla de Precios">	<grp dim="1,-1,10,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<grp dim="40,27,7,12" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Tabla de Precios">			<sp/><txt>Sucursal:</txt>			<inp id="k_sucursal" dim="47,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="N" available="N"/><br/>			<sp/><txt>Producto:</txt>			<inp id="k_producto" dim="47,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="N" available="N"/><br/>			<sp/>			<tbl id="k_precios" dim="55,15" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" 				nren="fijo" Reorder="N" insdel="N" modify="N">				<col id="k_cveprecio" name="Clave" nc="12" available="Y" visible="Y"/>				<col id="k_descripcion" name="Descripcion" nc="25" available="Y" visible="Y"/>				<col id="k_precio" name="Precio" nc="12" type="number" nd="2" available="Y" visible="Y"/>			</tbl>		</grp>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb;			var sucursal_id, suc_descrip, producto, prod_descrip;			var strSucursal, strProducto;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();				IniciarForma();			}						fun IniciarForma(){				var sqlXmlRequest, cmd,ok,mensaje, xmlResultado,mensajeError;							//Asignar variables de param a variables locales				sucursal_id = trim(frn.param(0));				suc_descrip = trim(frn.param(1));				producto = trim(frn.param(2));				prod_descrip = trim(frn.param(3));				strSucursal = suc_descrip;				strProducto = "[" & producto & "] " & prod_descrip ;				frn.set("k_sucursal",strSucursal);				frn.set("k_producto",strProducto);								//Obtener precios				setXml(sqlXmlRequest,"document","sucursal_id",sucursal_id);								setXml(sqlXmlRequest,"document","producto",producto);				setXml(sqlXmlRequest,"document","movimiento","usuario",frn.lib("libKepler","UserInfo"));												cmd="select * from keplersc.invr_calc_tabla_pecios_sel('" & getXmlStr(sqlXmlRequest,"EOF:13_10") & "')";GuardarLog("INFO","PROG",cmd,"");				rstXml(xmlResultado);				xmlResultado = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepetablaPrecios");				frn.lib("libGeneral.kpl","FileSave",xmlResultado ,"D:\Basura\xmlListaPrecios");												ok=getXmlAtt(xmlResultado,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlResultado,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);										if(memcmp(mensajeError,"P0001",5)==0){						frn.message("Error de logica","Error","Aceptar");					}else{						frn.message(mensajeError,"Error","Aceptar");					}					return;				}								frn.set("k_precios",xmlResultado);							}						//====================			//Descripcion: Guarda a disco un mensaje catalogado como error,			//  la carpeta debe existir de forma previa			//Autor: Victor Salgado			//Fecha: 27/Julio/2021			//====================			fun GuardarLog(tipoMensaje, origen, mensaje, mensajeXml){				var fileName,fecha,time,cadena;				fecha = "";				time = "";				fileName = "D:\Basura\K80.log";				cadena = fecha & " " & time & " " & tipoMensaje & " Descripcion: " & mensaje & " Origen: " & origen;				kdb.save("_"&fileName,cadena);			}								}	</script></pag>