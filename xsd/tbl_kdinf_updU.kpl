<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><txt fnt=",23" clr="0,0,0">Autos Usados - Actualizaci&#243;n  [ kdinf ]</txt><br/>	<!-- dim="81,0" --> 	<!-- dim="85,0" -->	<hLine dim="101,0"/> 	<br/> 	<br/>			<!-- dim="81,14,7,12" -->		<!-- dim="85,17,7,13" -->		<grp dim="48,36,7,13" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos del Inventario seleccionado : ">				<sp n="1"/> <txt>Sucursal :</txt> 			<sp n="1"/> <inp id="c_suc" dim="5,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>			<sp n="1"/> <inp id="k_suc" dim="38,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/> 			<br/>			<sp n="1"/> <txt>Inventario : </txt> 			<inp id="c_invent" dim="10,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>			<sp n="14"/> <txt>Inventario Anterior : </txt> 			<inp id="c_inventant" dim="10,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>			<br/>			<sp n="1"/> <txt>Nuevo/Usado :</txt> 			<sp n="1"/> <inp id="k_tipo_auto" clr="64,64,64" clrBrdr="255,255,255"  dim="10,1" fnt="Arial,16" type="string" modify="N" available="N" nc="10" visible="Y"/>			<sp n="11"/> <txt>Mod. Ref. :</txt> 			<sp n="1"/> <inp id="c_modelo" dim="18,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>			<br/>			<sp n="1"/> <txt>Descripcion : </txt> 			<br/>			<sp n="1"/> <inp id="k_descrip" clr="64,64,64" clrBrdr="255,255,255"  dim="65,3" fnt="Arial,16" type="string" modify="Y" available="N" OnChange="Valida_Descrip(1)" OnF10="Recupera_Descrip()" nc="210" visible="Y"/>			<br/>			<sp n="1"/> <txt>Serie :</txt> 			<sp n="1"/> <inp id="c_serie" dim="25,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" OnChange="Valida_Serie(1)" OnF10="Recupera_Serie()" nc="20"/>			<sp n="3"/> <txt>A&#241;o Modelo :</txt> 			<sp n="1"/> <inp id="v_anio" dim="6,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>			<sp n="1"/> <inp id="c_anio" dim="6,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="N"/>				<br/>				<sp n="1"/> <txt>Motor :</txt> 			<sp n="1"/> <inp id="c_motor" dim="25,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="20" bclr="250,250,250"/>			<br/>			<sp n="1"/> <txt>Transmision :</txt>			<sp n="1"/> <inp id="c_transmision" dim="25,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="20" bclr="250,250,250"/>				<br/>			<sp n="1"/> <txt>Clave Vehicular :</txt> 			<sp n="1"/> <inp id="c_cveveh" dim="10,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="7" bclr="250,250,250"/>					<br/>			<sp n="1"/> <txt>Registro Federal Vehiculos :</txt>			<sp n="1"/> <inp id="c_regfed" dim="13,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="10" bclr="250,250,250"/>			<br/>			<sp n="1"/> <txt>Color Exterior : </txt>			<sp n="1"/> <inp id="c_color_ext" dim="10,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" visible="Y" OnF9="Get_Cat(3)" OnChange="Get_Cat_Data(3,2)" nc="10" bclr="250,250,250"/>			<!-- <br/> -->			<sp n="1"/> <inp id="k_color_ext" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" fnt="Arial,16" type="string" modify="N" available="N" nc="40" visible="Y"/>			<br/>			<sp n="1"/> <txt>Color Vestid. : </txt>			<sp n="1"/> <inp id="c_color_vest" dim="10,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" OnF9="Get_Cat(4)" OnChange="Get_Cat_Data(4,2)" nc="10" bclr="250,250,250"/>			<!-- <br/> -->			<sp n="1"/> <inp id="k_color_vest" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" fnt="Arial,16" type="string" modify="N" available="N" nc="40" visible="Y"/>			<br/>			<sp n="1"/> <txt>Existe Eje Trasero ( N {vacio}, S ):</txt>			<sp n="1"/> <inp id="c_eje" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" OnChange="Valida_Eje(1)" nc="1" bclr="250,250,250"/>			<br/>			<sp n="1"/> <txt>Marca :</txt>			<sp n="2"/> <inp id="v_marca" clr="64,64,64" clrBrdr="255,255,255"  dim="45,1" fnt="Arial,16" type="string" modify="N" available="N" nc="50" visible="Y"/>			<!-- OnF9="Get_Cat(7)" OnChange="Get_Cat_Data(7,2)" -->			<sp n="1"/> <inp id="c_marca" dim="1,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" visible="N" available="N" OnF9="" OnChange="" nc="5"/>			<br/>			<sp n="1"/> <txt>Modelo :</txt>			<sp n="1"/> <inp id="v_modelo" clr="64,64,64" clrBrdr="255,255,255"  dim="45,1" fnt="Arial,16" type="string" modify="N" available="N" nc="50" visible="Y"/>			<br/>			<sp n="1"/> <txt>Clase : </txt>			<sp n="1"/> <inp id="c_clase" dim="7,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" OnF9="Get_Cat(6)" OnChange="Get_Cat_Data(6,2)" nc="5" bclr="250,250,250"/>			<sp n="1"/> <inp id="k_clase" clr="64,64,64" clrBrdr="255,255,255"  dim="30,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>			<br/>			<sp n="1"/> <txt>Pedimento :</txt>			<sp n="1"/> <inp id="c_pedimento" dim="20,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="20" bclr="250,250,250" OnChange="Valida_Pedimento()"/>						<sp n="1"/>	<txt>Fecha :</txt>			<sp n="1"/> <edt id="c_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="250,250,250" clr="64,64,64" page="_ks_fecha,c_fecha" OnF9="Dialog(3,_ks_fecha,c_fecha)" clrBrdr="255,255,255" available="N"/>			<br/>			<sp n="1"/> <txt>Lugar :</txt>			<sp n="1"/> <inp id="c_lugarped" dim="40,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="40" bclr="250,250,250"/>						<br/>			<sp n="1"/> <txt>Procedencia :</txt>			<sp n="1"/> 			<cmb id="v_procedencia" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16"			 type="string"  OnChange="" modify="Y" available="Y" visible="Y" tooltip="Procedencia"/>			<sp n="5"/> <txt>Combustible :</txt>			<sp n="1"/> <inp id="v_combustible" clr="64,64,64" clrBrdr="255,255,255"   bclr="250,250,250" dim="26,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="10" visible="Y"/>			<br/>			<sp n="1"/> <txt>Ocupantes :</txt>			<sp n="1"/> <inp id="v_ocupantes" clr="64,64,64" clrBrdr="255,255,255"  bclr="250,250,250" dim="3,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="2" visible="Y"/>			<sp n="3"/> <txt>Cilindros :</txt>			<sp n="1"/> <inp id="v_cilindros" clr="64,64,64" clrBrdr="255,255,255"  bclr="250,250,250" dim="2,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="1" visible="Y"/>			<sp n="3"/> <txt>Puertas :</txt>			<sp n="1"/> <inp id="v_puertas" clr="64,64,64" clrBrdr="255,255,255"  bclr="250,250,250" dim="2,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="1" visible="Y"/>									<!--			<br/>					<sp n="1"/> <txt clr="132,20,7">ERR LN Descrip : </txt>			<br/>			<sp n="1"/> <inp id="k_err" dim="53,2" clr="132,20,7" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="50"/>			-->						<!--			<sp/><txt>Fecha Asignacion : </txt> <sp/>				<inp id="k_fecha_asig" dim="15,1" type="string" clr="64,64,64" clrBrdr="255,255,255" available="N" nc="-1" modify="N" fmt="DD/MM/CCYY"/>            Sucursal :  </txt>			-->							</grp>		<!-- <sp n="1"/> -->				<grp dim="54,36,7,13" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos del Inventario seleccionado : ">						<sp n="1"/> <txt>PAQUETE ( L1 .. L21 ) : </txt> 			<br/>			<sp n="1"/> <txt>[L01]</txt> 			<sp n="1"/> <inp id="c_pq01" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>				<br/>			<sp n="1"/> <txt>[L02]</txt> 			<sp n="1"/> <inp id="c_pq02" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>						<br/>			<sp n="1"/> <txt>[L03]</txt> 			<sp n="1"/> <inp id="c_pq03" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>						<br/>			<sp n="1"/> <txt>[L04]</txt> 			<sp n="1"/> <inp id="c_pq04" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>						<br/>			<sp n="1"/> <txt>[L05]</txt> 			<sp n="1"/> <inp id="c_pq05" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>						<br/>			<sp n="1"/> <txt>[L06]</txt> 			<sp n="1"/> <inp id="c_pq06" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>						<br/>			<sp n="1"/> <txt>[L07]</txt> 			<sp n="1"/> <inp id="c_pq07" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>				<br/>			<sp n="1"/> <txt>[L08]</txt> 			<sp n="1"/> <inp id="c_pq08" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>						<br/>			<sp n="1"/> <txt>[L09]</txt> 			<sp n="1"/> <inp id="c_pq09" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>						<br/>			<sp n="1"/> <txt>[L10]</txt> 			<sp n="1"/> <inp id="c_pq10" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>						<br/>			<sp n="1"/> <txt>[L11]</txt> 			<sp n="1"/> <inp id="c_pq11" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>						<br/>			<sp n="1"/> <txt>[L12]</txt>			<sp n="1"/> <inp id="c_pq12" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>						<br/>			<sp n="1"/> <txt>[L13]</txt> 			<sp n="1"/> <inp id="c_pq13" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>						<br/>			<sp n="1"/> <txt>[L14]</txt> 			<sp n="1"/> <inp id="c_pq14" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>						<br/>					<sp n="1"/> <txt>[L15]</txt> 			<sp n="1"/> <inp id="c_pq15" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>					<br/>			<sp n="1"/> <txt>[L16]</txt> 			<sp n="1"/> <inp id="c_pq16" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>				<br/>			<sp n="1"/> <txt>[L17]</txt> 			<sp n="1"/> <inp id="c_pq17" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>				<br/>			<sp n="1"/> <txt>[L18]</txt> 			<sp n="1"/> <inp id="c_pq18" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>				<br/>			<sp n="1"/> <txt>[L19]</txt> 			<sp n="1"/> <inp id="c_pq19" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>			<br/>			<sp n="1"/> <txt>[L20]</txt> 			<sp n="1"/> <inp id="c_pq20" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>			<br/>			<sp n="1"/> <txt>[L21]</txt> 			<sp n="1"/> <inp id="c_pq21" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" nc="50" bclr="250,250,250"/>		</grp>		<br/>		<!-- hSpace="4" -->		<!-- Mensajes de Error en Datos : -->		<grp dim="81,5,7,13" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="3" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="[ F10 ] Recupera ultimos valores guardados en los campos : Descripcion y Serie ">						<sp n="1"/> <txt clr="132,20,7">[Faltantes]   :</txt>			<sp n="1"/> <inp id="k_err" dim="100,1" clr="132,20,7" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="95"/>			<br/>			<sp n="1"/> <txt clr="132,20,7">[No Validos] :</txt>			<sp n="1"/> <inp id="k_err_d" dim="100,1" clr="132,20,7" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="95"/>						</grp>		<!--		<br/>		<br/>		-->		<!-- 		<sp n="18"/>		<img id="Imprimir" dim="45,45" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Reporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="N" clrBrdr="0,0,0" visible="Y" modify="Y"/>		-->				<!-- <sp n="25"/> -->		<sp n="4"/>		<img id="Cancelar" dim="45,45" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Salir ..." available="Y" clrBrdr="0,0,0" visible="Y"/>					<!-- <sp n="10"/> -->		<!-- &lt;Ctrl&gt;&lt;T&gt; -->		<!-- modify="Y" -->		<sp n="3"/>		<img id="Aceptar" dim="45,45" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Actualizar registro ..." available="Y" clrBrdr="0,0,0" visible="N"/>							</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal;			var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var row_grid, err_data, err_empty, fech_original, view_adicionales, serie_original, descrip_original;                  var paramInv, paramOper, paramRutina, paramST;										fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";				fileSavePath = "C:\Basura";								err_empty = 0;				err_data = 0;								Inicializa();								//ConfiguraControlesOpcion();				} /* END Func Main() */			fun Valida_Pedimento(){				var strTmp;				strTmp=frn.get("c_pedimento");				strTmp = trim(frn.lib("libGeneral.kpl","StrReplace",strTmp," ",""));				frn.set("c_pedimento",strTmp);			}						fun Valida_Descrip(imodo) {				var dato_id;							frn.setX(trim(frn.get("k_descrip")), "k_descrip");				dato_id = frn.get("k_descrip");				if ( strlen(dato_id) == 0 ) {					if ( imodo == 1 ) {						frn.message("La Descripcion del Vehiculo No puede estar vacia ... " & "|" & "Teclea F10 sobre el campo [Descripcion] para recuperar el texto que existia originalmente al ingresar a la pantalla.","Error","Aceptar");					} 					Eval_Data_Row();					return;				} else {					Eval_Data_Row(); 				}										} // END -	Fun - Valida_Descrip			fun Valida_Eje(imodo) {				var dato_id, err_msg;							err_msg = "";							dato_id = trim(frn.get("c_eje"));				dato_id = strFormat("ucase", dato_id);				if ( strlen(dato_id) > 0 && dato_id &! "S" && dato_id &! "N") {					if ( imodo == 1 ) {						frn.message("Valor de campo Tiene Eje Trasero ? No valido : " & dato_id,"Error","Aceptar");						frn.setX("-", "c_eje");							Eval_Data_Row();						return;					} else {						err_msg = "Eje Invalido";						return err_msg;					}					}	else	{					frn.setX(dato_id, "c_eje");					if ( imodo == 1 ) { Eval_Data_Row(); } 				}										} // END -	Fun - Valida_Eje			fun Valida_Serie(imodo) {				var dato_id, err_msg;							err_msg = "";							dato_id = "";				//cmdQuery = "select C8 as campo from keplersc.kdiv where c1 = '" & frn.get("k_mov",-1,"modelo") & "'";				if ( frn.get("k_tipo_auto") &= "USADO" ) {					cmdQuery = "select max(c2) max_invent from keplersc.kdinf where c5 = '" & frn.get("c_serie") & "' and c2 <> '" & frn.get("c_invent") & "' /*and c31 = 10*/ " & 						" and ( c31 = 10 or ( c31 > 0 and c32 < 60 ) ) ";						//Se actualizo la consideracion de Estatus para la discriminacion de Registros a Evaluar, por JMM 20230213					//				} else {					cmdQuery = "select max(c2) max_invent from keplersc.kdinf where c5 = '" & frn.get("c_serie") & "' and c2 <> '" & frn.get("c_invent") & "' and c31 <> 0" & 						" and c2 not in (select c2 from keplersc.kdinf where c31 = 20 and c32 = 70) ";						//2nd Linea Agregada por JMM para discriminar operaciones de Traspasos de Autos, 20230213 				}				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"tbl_kdinf_upd.Valida_Serie()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\tbl_kdinf_upd_Valida_Serie");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "max_invent");								if ( strlen(dato_id) > 0 ) {					if ( imodo == 1 ) {						frn.message("La Serie que registraste ya esta asignada a otro Numero de Inventario : " & dato_id & "|" & "Teclea F10 sobre el campo [serie] para recuperar el ultimo Num. de Serie guardado en este Num. Inventario.","Error","Aceptar");						//frn.setX("--", "c_serie");							Eval_Data_Row();						return;					} else {						err_msg = dato_id;						return err_msg;					}				} else {					if ( imodo == 1 ) { 						if ( strlen( trim(frn.get("c_serie")) ) == 0 ) {							frn.message("La Serie No puede estar vacia ... " & "|" & "Teclea F10 sobre el campo [serie] para recuperar el ultimo Num. de Serie guardado en este Num. Inventario.","Error","Aceptar");						}						Eval_Data_Row(); 					}				}							}	// END -	Fun - Valida_Serie 						fun Recupera_Serie() {				frn.setX(serie_original, "c_serie");				Eval_Data_Row();			}			fun Recupera_Descrip() {				frn.setX(descrip_original, "k_descrip");				Eval_Data_Row();			}												fun Get_Cat(imodo) {            				var suc_id, dato_id;				var win_tit, field_key, field_col, cmdQuery;            				if ( imodo <= 0 || imodo > 7 /*|| tip_ope &! "A"*/ ) {					// No es opcion de CAT Valida ...					return;				}								win_tit = "";				field_key = "";				field_col = "";				cmdQuery = "";				/*				if (imodo == 1) {					win_tit = "CAT Vehiculos";					field_key = "clave";					field_col = "modelo";					cmdQuery = "select C1 as clave, C2 as descripciï¿½n from keplersc.kdiv";				}				*/								/*				if (imodo == 2) {					win_tit = "CAT Inventarios";					field_key = "clave";					field_col = "invent";										dato_id = "";					cmdQuery = "select C8 as campo from keplersc.kdiv where c1 = '" & frn.get("k_mov",-1,"modelo") & "'";					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"tbl_kdinf_updU.Get_Cat_kdiv_c8()");					//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\Get_Cat_Get_Cat_kdiv_c8()");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					dato_id = getXmlAtt(cuboQuery,"r0", "campo");					cmdQuery = "select d.C1 as clave, d.C2 as descripciï¿½n from keplersc.kddinv d where d.c7 = '" & dato_id & "'";				}				*/				       				if (imodo == 3) {					win_tit = "CAT Colores Exteriores";					field_key = "clave";					field_col = "c_color_ext";					cmdQuery = "select C3 as clave, C4 as descripciï¿½n from keplersc.kdice2 where c1 =  '" & frn.get("c_modelo") & "'";				}			         				if (imodo == 4) {					win_tit = "CAT Colores Vestiduras";					field_key = "clave";					field_col = "c_color_vest";					cmdQuery = "select C3 as clave, C4 as descripciï¿½n from keplersc.kdice3 where c1 =  '" & frn.get("c_modelo") & "'";				}					         				/*				if (imodo == 5) {					win_tit = "CAT Sucursales";					field_key = "clave";					field_col = "c_suc";					cmdQuery = "select C1 as clave, C2 as descripciï¿½n from keplersc.kdms";					objeto = "c_suc";				}					*/								if (imodo == 6) {					win_tit = "CAT Clases Vehiculares";					field_key = "clave";					field_col = "c_clase";					cmdQuery = "select C1 as clave, C2 as descripciï¿½n from keplersc.kdic";				}									/*				if (imodo == 7) {					win_tit = "CAT Marcas Vehiculares";					field_key = "clave";					field_col = "c_marca";					cmdQuery = "select C1 as clave, C2 as descripciï¿½n from keplersc.kdmarca";				}					*/								                      if ( strlen(win_tit) > 0 && strlen(field_key) > 0 && strlen(field_col) > 0 && strlen(cmdQuery) > 0 /*&& strlen(objeto) > 0*/ ) {                                        					//frn.dialog("genlistasel", win_tit,cmdQuery, field_key, "k_mov",-1, field_col,"S");  * * *  USADO EN GRIDS					//frn.dialog("genlistasel","Catï¿½logo de Proveedores",cmdQuery,"k_claveprov","k_clave","0","","N");  * * *  USADO EN CTRLS SIMPLES										frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");				}							} /*END Func Get_Cat()*/		   fun Get_Cat_Data(imodo, icall) {						var suc_id, dato_id;				var field_ori,field_dest, tbl, field_dscr;				var field_add, dato_id_add;				var field_dest_2, dato_id_2;								if ( imodo < 0 || imodo > 6 /*7*/  /*|| ( tip_ope &! "A" && icall != 2 )*/ ) {					// No es opcion de CAT Valida ...					return;				}				 				field_dscr = "";				field_ori = "";				field_dest = "";				tbl = "";				cmdQuery = "";								dato_id = "";								/*						if (imodo == 1) {					field_dscr = "Modelo";					field_ori = "modelo";					field_dest = "descrip";					tbl = "kdiv";					//cmdQuery = "select C2 as " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'";					cmdQuery = "select k.c1 as cve, k.c2 as " & field_dest & ", k.c4 as clase, tcl.c2 as clase_descr, k.c5 as marca, tmr.c2 as marca_descr, " & 						"k.c6 as codISAN, tis.c2 as codISAN_descr, k.c8 as tipo_auto from keplersc.kdiv k " & 						"left join keplersc.kdic tcl on k.c4 = tcl.c1 " & 						"left join keplersc.kdmarca tmr on k.c5 = tmr.c1 " &  						"left join keplersc.kdtisan tis on k.c6 = tis.c1 " & 						"where k.c1 = '" & frn.get("k_mov",-1,"modelo") & "'";				}				*/								/*				if ( tip_ope &= "A" ) {					if (imodo == 2) {						field_dscr = "Inventario";						field_ori = "invent";						field_dest = "anio";						tbl = "kddinv";						//cmdQuery = "select C3 as " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'"; 						cmdQuery = "select i.C3 as anio from keplersc.kddinv i inner join keplersc.kdiv k on k.c8 = i.c7 and k.c1 = '" & frn.get("k_mov",-1,"modelo") & "'" & 							" where i.c1 = '" & frn.get("k_mov",-1,field_ori) & "'";					}				}								*/								if (imodo == 3) {					field_dscr = "Color Exterior";					field_ori = "c_color_ext";					field_dest = "k_color_ext";					//field_dest_2 = "descrip";					tbl = "kdice2";					//cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '" & frn.get("k_mov",-1,"modelo") & "' and c3 = '" & frn.get("k_mov",-1,field_ori) & "'";					cmdQuery = "select C4 as " & field_dest & " from keplersc." & tbl & " where c1 =  '" & frn.get("c_modelo") & "' and c3 = '" & frn.get(field_ori) & "'";				}											if (imodo == 4) {					field_dscr = "Color Vestidura";					field_ori = "c_color_vest";					field_dest = "k_color_vest";					//field_dest_2 = "descrip";					tbl = "kdice3";					//cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '" & frn.get("k_mov",-1,"modelo") & "' and c3 = '" & frn.get("k_mov",-1,field_ori) & "'";					cmdQuery = "select c4 as " & field_dest & " from keplersc." & tbl & " where c1 =  '" & frn.get("c_modelo") & "' and c3 = '" & frn.get(field_ori) & "'";				}								if (imodo == 5) {					field_dscr = "Sucursal";					field_ori = "c_suc";					field_dest = "k_suc";					//field_dest_2 = "descrip";					tbl = "kdms";					//cmdQuery = "select C1 as " & field_dest & ", c2 as " & field_dest_2 &" from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'";					cmdQuery = "select c2 as " & field_dest &" from keplersc." & tbl & " where c1 = '" & frn.get(field_ori) & "'";				}				if (imodo == 6) {					field_dscr = "Clase Vehiculo";					field_ori = "c_clase";					field_dest = "k_clase";					//field_dest_2 = "descrip";					tbl = "kdic";					//cmdQuery = "select C1 as " & field_dest & ", c2 as " & field_dest_2 &" from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'";					cmdQuery = "select c2 as " & field_dest &" from keplersc." & tbl & " where c1 = '" & frn.get(field_ori) & "'";				}				/*				if (imodo == 7) {					field_dscr = "Marca Vehiculo";					field_ori = "c_marca";					field_dest = "k_marca";					//field_dest_2 = "descrip";					tbl = "kdmarca";					//cmdQuery = "select C1 as " & field_dest & ", c2 as " & field_dest_2 &" from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'";					cmdQuery = "select c2 as " & field_dest &" from keplersc." & tbl & " where c1 = '" & frn.get(field_ori) & "'";				}				*/								if (imodo == 0 && icall == 1) {					Eval_Data_Row();				}								field_add = "";				//if (imodo == 1) { field_add = "k_descrip"; }				if (imodo == 3) { field_add = "k_color_ext"; }				if (imodo == 4) { field_add = "k_color_vest"; }					if (imodo == 5) { field_add = "k_suc"; }					if (imodo == 6) { field_add = "k_clase"; }				//if (imodo == 7) { field_add = "k_marca"; }											if ( strlen(field_dscr) > 0 && strlen(field_ori) > 0 && strlen(field_dest) > 0 && strlen(tbl) > 0 && strlen(cmdQuery) > 0 ) {					//if ( strlen(frn.get("k_mov",-1,field_ori)) != 0 ) {						//dato_id = frn.get("k_mov",-1,field_ori);						//cmdQuery = "select C2 as descrip from keplersc.kdiv where c1 = '" & dato_id & "'";						rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"tbl_kdinf_updU.Get_Cat_" & tbl & "()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\Get_Cat_" & tbl);						ok=getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok){							dato_id = "--";							if (imodo == 1) {								dato_id = "[ERR] verificando " &  field_dscr & " ...";							}							frn.setX(dato_id,"k_mov",-1, field_dest);							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							dato_id_add = "";							if (imodo == 1) { dato_id_add = dato_id; }							if (imodo == 3 || imodo == 4 || imodo == 5) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							//if (imodo == 4) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							//if (imodo == 5) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							if ( strlen(field_add) != 0 ) { frn.setX(dato_id_add, field_add); }							return;						}						dato_id = "";						dato_id = getXmlAtt(cuboQuery,"r0", field_dest);					   if( strlen(dato_id) == 0 ){					   							// Code Adapted for this option							frn.setX(trim(frn.get(field_ori)), field_ori);							if (imodo == 5) {								dato_id = "--";							} else {								if ( strlen(frn.get(field_ori)) > 0 ) {									dato_id = "--";								} else {									dato_id = "";								}							}														//dato_id = "--";							if (imodo == 1 /*&& icall ==1*/) {								frn.setX("", "k_marca");								frn.setX("", "k_clase");								frn.setX("", "k_tipo_auto");								dato_id = field_dscr & " No existe ...";							}														frn.setX(dato_id, field_dest);										if (icall == 2 ) { Eval_Data_Row(); }									return;												} else {													frn.setX(dato_id,field_dest);														if (icall == 2 ) { Eval_Data_Row(); }												}				}					} /*END Fun Get_Cat_Data()*/			fun Get_Data_Row() {				for (var i=0; i<=6/*7*/; i++) {					Get_Cat_Data(i);				}								Eval_Data_Row();						} /*END Func Get_Data_Row()*/			fun Eval_Data_Row(/*nRow,*/ imodo) {				var ColIni, ColEnd, EvalCols, ErrText, ErrTextData;				var FieldsList, FieldListData, FlagErr;								ErrText = "";				ErrTextData = "";							err_empty = 0;				err_data = 0;								FieldsList = "";				FieldListData = "";								// Evaluando vacios ...								frn.setX(trim(frn.get("k_descrip")), "k_descrip");				//EvalCols = strlen( frn.get("k_descrip") );				frn.setX(trim(frn.get("c_serie")), "c_serie");				frn.setX(trim(frn.get("c_color_ext")), "c_color_ext");				frn.setX(trim(frn.get("c_color_vest")), "c_color_vest");							if ( strlen( frn.get("c_invent") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "c_invent | "; 				}				if ( strlen( frn.get("c_suc") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "c_suc | "; 				}				if ( strlen( frn.get("c_anio") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "c_anio | "; 				}				if ( strlen( frn.get("k_tipo_auto") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "N/U | "; 				}				if ( strlen( frn.get("c_modelo") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "modelo | "; 				}				if ( strlen( frn.get("k_descrip") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "descripcion | "; 				}				if ( strlen( frn.get("c_serie") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "serie | "; 				}				if ( strlen( frn.get("c_color_ext") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "color_ext | "; 				}				if ( strlen( frn.get("c_color_vest") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "color_vest | "; 				}																				EvalCols = strlen(FieldsList) - 1;				if ( err_empty > 0 ) { FieldsList = mid(FieldsList, 0, EvalCols); } 												// Evaluando datos ...								FlagErr = "";				FlagErr = Valida_Serie();				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "Invent.Serie [" & FlagErr &  "] | ";				} 								FlagErr = "";				FlagErr = Valida_Eje();				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "tiene_eje_tr | ";				} 								if ( frn.get("k_suc") &= "--" ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "sucursal | ";				} 								if ( frn.get("k_color_ext") &= "--" ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "color_ext | ";				} 				if ( frn.get("k_color_vest") &= "--" ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "color_vest | ";				}				 				/*				if ( frn.get("k_marca") &= "--" ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "marca | ";				} 				*/				if ( frn.get("k_clase") &= "--" ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "clase | ";				}																	if ( err_data > 0 ) { ErrTextData = "| " & FieldListData; }					if ( err_empty > 0 ) { ErrText = "| " & FieldsList; }								frn.setX(ErrText, "k_err");				frn.setX(ErrTextData, "k_err_d");								if ( strlen( ErrText ) == 0 && strlen( ErrTextData ) == 0 ) {					return -1;				}								return 1;							} /*END Func Eval_Data_Row()*/			fun Cancela() {				if ( strlen( trim(paramRutina) ) > 0 ) { frP.script(paramRutina); }				frn.exit();			} /* END Func Cancela() */									fun Ejecuta() {				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg;				var resultado, mensaje, adicionales, folio;				var RowErr, iLim;											Get_Data_Row();											if ( strlen(trim(frn.get("k_err"))) > 0 || strlen(trim(frn.get("k_err_d"))) > 0 ) {					frn.message("Existen Errores en los Datos, No se podra Actualizar la Informacion del Numero de Inventario ... ", "Alto !!! ", "Aceptar");					return;				}					//fecha = sys.date();				//hora = sys.time();								resultado = "";				mensaje = "";				adicionales = "";								xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;									frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\XmltoPostgres_KDINF_UPDU");													// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 							cmdQuery="SELECT * FROM keplersc.tbl_kdinf_upd('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				rstXml(cuboQuery);				cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"tbl_kdinf_updU.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_KDINF_UPDU");									// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										/*				resultado = "1";				mensaje = "Las partidas han sido registradas exitosamente ..." & "|" & "Testing Pipe separator";				//adicionales = "Testing Active Button ...";				*/									// /*				resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");				adicionales = getXml(cuboQuery,"adicionales");				// */																	if( resultado &= "1" ) {					if ( strlen(adicionales ) == 0 ) {						frn.message("Resultado [" & resultado & "] ; " & mensaje, "Info !!! ", "Aceptar");					} else {						frn.message("Resultado [" & resultado & "] ; " & mensaje & "|" & adicionales , "Info !!! ", "Aceptar");					}											MostrarDatos();					Get_Data_Row();					frn.setPos("c_pq01");										if ( strlen( trim(paramRutina) ) > 0 ) { frP.script(paramRutina); } // 221010				} else {					if ( strlen(adicionales ) == 0 ) {						frn.message(mensaje, "Error", "Aceptar");					} else {						frn.message(mensaje & "|" & adicionales, "Error", "Aceptar");					}				}			} /* END Func Ejecuta() */									fun Inicializa(){ //Inicializa los valores en Pantalla				// Our code				var fech_init, strFecha, strTmp,fecha; 				ConfiguraControlesOff();				paramInv = "";            paramOper = "";				paramRutina = "";								// Revisa y Carga en Variables los Parï¿½metros Recibidos en la corrida				//if( frn.nParam() == 5 ){ //Se han mandado parï¿½metros a la pï¿½gina				if( frn.nParam() >= 2 ){ //Se han mandado parï¿½metros a la pï¿½gina	                             //paramInv = "0107-IRN21";               //paramOper = "C";               paramInv = trim(frn.param(0));                paramOper = trim(frn.param(1));               					if ( frn.nParam() > 2 ) { paramRutina = trim(frn.param(2)); }                           } else {            					// To testing after including parameter(s)					/*					paramInv = "0145-IRU22"; // 0100-IRU21 ; 0097-IRU21 ; 0107-IRN21 ; 0095-IRU21 ; 0106-IRU21					paramOper = "C";					paramRutina = "";					*/					// /*					frn.message("Operación no válida [ sin Parametros ] ...", "Mensaje","&Aceptar");					//frn.open("anuncios",4);					//frn.open("index",4);					return;					// */									}								//frn.set("c_invent", paramInv);								frn.setX("NACIONAL", "v_procedencia",0,0);				frn.setX("NACIONAL", "v_procedencia",0,1);				frn.setX("IMPORTADO", "v_procedencia",1,0);				frn.setX("IMPORTADO", "v_procedencia",1,1);								MostrarDatos();				Get_Data_Row();				frn.setPos("c_pq01");							//frn.message("Parameters : " & frn.nParam() & " ; tip_ope : " & tip_ope, "Info Parameters", "Aceptar");								} /* END Func Inicializa() */									fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         } /* END Func PadLeft() */			fun ConfiguraControlesOff() {								frn.setAtt("k_descrip", "available", "N");			   frn.setAtt("c_serie", "available", "N");				frn.setAtt("c_motor", "available", "N");					frn.setAtt("c_transmision", "available", "N");				frn.setAtt("c_cveveh", "available", "N");				frn.setAtt("c_regfed", "available", "N");				frn.setAtt("c_color_ext", "available", "N");				frn.setAtt("c_color_vest", "available", "N");				frn.setAtt("c_eje", "available", "N");				frn.setAtt("c_marca", "available", "N");				frn.setAtt("c_clase", "available", "N");				frn.setAtt("c_pedimento", "available", "N");				frn.setAtt("c_fecha", "available", "N");				frn.setAtt("c_lugarped", "available", "N");								frn.setAtt("c_pq01", "available", "N");				frn.setAtt("c_pq02", "available", "N");				frn.setAtt("c_pq03", "available", "N");				frn.setAtt("c_pq04", "available", "N");				frn.setAtt("c_pq05", "available", "N");				frn.setAtt("c_pq06", "available", "N");				frn.setAtt("c_pq07", "available", "N");				frn.setAtt("c_pq08", "available", "N");				frn.setAtt("c_pq09", "available", "N");				frn.setAtt("c_pq10", "available", "N");				frn.setAtt("c_pq11", "available", "N");				frn.setAtt("c_pq12", "available", "N");				frn.setAtt("c_pq13", "available", "N");				frn.setAtt("c_pq14", "available", "N");				frn.setAtt("c_pq15", "available", "N");				frn.setAtt("c_pq16", "available", "N");				frn.setAtt("c_pq17", "available", "N");				frn.setAtt("c_pq18", "available", "N");				frn.setAtt("c_pq19", "available", "N");				frn.setAtt("c_pq20", "available", "N");				frn.setAtt("c_pq21", "available", "N");													/*											frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				*/				frn.setAtt("Aceptar", "visible", "N");											} /* END Func ConfiguraControlesOff() */									fun ConfiguraControlesOpcion(imodo) {							//ConfiguraControlesOff();				frn.setAtt("k_descrip", "available", "Y");			   frn.setAtt("c_serie", "available", "Y");				frn.setAtt("c_motor", "available", "Y");					frn.setAtt("c_transmision", "available", "Y");				frn.setAtt("c_cveveh", "available", "Y");				frn.setAtt("c_regfed", "available", "Y");				frn.setAtt("c_color_ext", "available", "Y");				frn.setAtt("c_color_vest", "available", "Y");				frn.setAtt("c_eje", "available", "Y");				//frn.setAtt("c_marca", "available", "Y");				frn.setAtt("c_clase", "available", "Y");				frn.setAtt("c_pedimento", "available", "Y");				frn.setAtt("c_fecha", "available", "Y");				frn.setAtt("c_lugarped", "available", "Y");								frn.setAtt("v_procedencia", "available", "Y");				frn.setAtt("v_combustible", "available", "Y");				frn.setAtt("v_ocupantes", "available", "Y");				frn.setAtt("v_cilindros", "available", "Y");				frn.setAtt("v_puertas", "available", "Y");												frn.setAtt("c_pq01", "available", "Y");				frn.setAtt("c_pq02", "available", "Y");				frn.setAtt("c_pq03", "available", "Y");				frn.setAtt("c_pq04", "available", "Y");				frn.setAtt("c_pq05", "available", "Y");				frn.setAtt("c_pq06", "available", "Y");				frn.setAtt("c_pq07", "available", "Y");				frn.setAtt("c_pq08", "available", "Y");				frn.setAtt("c_pq09", "available", "Y");				frn.setAtt("c_pq10", "available", "Y");				frn.setAtt("c_pq11", "available", "Y");				frn.setAtt("c_pq12", "available", "Y");				frn.setAtt("c_pq13", "available", "Y");				frn.setAtt("c_pq14", "available", "Y");				frn.setAtt("c_pq15", "available", "Y");				frn.setAtt("c_pq16", "available", "Y");				frn.setAtt("c_pq17", "available", "Y");				frn.setAtt("c_pq18", "available", "Y");				frn.setAtt("c_pq19", "available", "Y");				frn.setAtt("c_pq20", "available", "Y");				frn.setAtt("c_pq21", "available", "Y");													frn.setAtt("Aceptar", "visible", "Y");			} /* END Func ConfiguraControlesOpcion() */			   fun MostrarDatos(imodo) {		   				var xmlGrd, pedfech, flagErr;				var x_marca, x_modelo, x_anio, x_version, x_serie; 				var x_procedencia, x_combustible, x_ocupantes, x_cilindros, x_puertas;												flagErr = 0;								if ( paramOper &= "C" ) {					paramST = "10";				} else {					paramST = "20";				}				cmdQuery = "select c1 as c_suc, c2 as c_invent, c9 as c_inventant, c21 as k_tipo_auto, c3 as c_modelo, c4 as k_descrip, c5 as c_serie, c6 as c_motor, c8 as c_transmision, " & 						"c13 as c_cveveh, c15 as c_anio, c14 as c_regfed, c10 as c_color_ext, c11 as c_color_vest, c12 as c_eje, c17 as c_marca, c18 as c_clase, " & 						"c26 as c_pedimento, c27 as c_fecha, c28 as c_lugarped, c60 as c_pq21, " & 						"c40 as c_pq01, c41 as c_pq02, c42 as c_pq03, c43 as c_pq04, c44 as c_pq05, c45 as c_pq06, c46 as c_pq07, c47 as c_pq08, c48 as c_pq09, c49 as c_pq10, " &						"c50 as c_pq11, c51 as c_pq12, c52 as c_pq13, c53 as c_pq14, c54 as c_pq15, c55 as c_pq16, c56 as c_pq17, c57 as c_pq18, c58 as c_pq19, c59 as c_pq20 " & 						",c85 as x_marca, c86 as x_modelo, c87 as x_anio, c88 as x_version, c89 as x_serie, c90 as x_procedencia, c91 as x_ocupantes, c92 as x_cilindros, c93 as x_puertas, c94 as x_combustible " & 						"from keplersc.kdinf where c2 = '" & paramInv & "'" & " and c31 = " & paramST;				frn.lib("libGeneral.kpl","FileSave",cmdQuery, fileSavePath & "\cmdmostrardatostblkdinf");								//frn.message(cmdQuery,"Info !","Aceptar");								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"tblkdinf.upd()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatostblkdinf");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					//frn.setX("", "c_invent");					//frn.setAtt("Aceptar", "visible", "N");					ConfiguraControlesOff();					frn.message("Sin Datos por mostrar ...","Info","Aceptar");					flagErr = 1;					return;					//Cancela();					}	else {					frn.setAtt("Aceptar", "visible", "Y");				}				//frn.set(cuboQuery);								//if ( flagErr == 1 ) { Cancela(); }				ConfiguraControlesOpcion();								frn.setX(getXmlAtt(cuboQuery,"r0", "c_suc"), "c_suc");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_invent"), "c_invent");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_inventant"), "c_inventant");				frn.setX(getXmlAtt(cuboQuery,"r0", "k_tipo_auto"), "k_tipo_auto");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_modelo"), "c_modelo");				frn.setX(getXmlAtt(cuboQuery,"r0", "k_descrip"), "k_descrip");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_serie"), "c_serie");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_motor"), "c_motor");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_transmision"), "c_transmision");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_cveveh"), "c_cveveh");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_anio"), "c_anio");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_regfed"), "c_regfed");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_color_ext"), "c_color_ext");					frn.setX(getXmlAtt(cuboQuery,"r0", "c_color_vest"), "c_color_vest");						frn.setX(getXmlAtt(cuboQuery,"r0", "c_eje"), "c_eje");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_marca"), "c_marca");					frn.setX(getXmlAtt(cuboQuery,"r0", "c_clase"), "c_clase");					frn.setX(getXmlAtt(cuboQuery,"r0", "c_pedimento"), "c_pedimento");				//frn.setX(getXmlAtt(cuboQuery,"r0", "c_fecha"), "c_fecha");					//pedfech = getXmlAtt(cuboQuery,"r0", "c_fecha");				//frn.set("c_fecha", pedfech);				frn.set("c_fecha", getXmlAtt(cuboQuery,"r0", "c_fecha"));				frn.setX(getXmlAtt(cuboQuery,"r0", "c_lugarped"), "c_lugarped");												frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq01"), "c_pq01");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq02"), "c_pq02");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq03"), "c_pq03");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq04"), "c_pq04");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq05"), "c_pq05");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq06"), "c_pq06");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq07"), "c_pq07");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq08"), "c_pq08");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq09"), "c_pq09");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq10"), "c_pq10");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq11"), "c_pq11");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq12"), "c_pq12");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq13"), "c_pq13");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq14"), "c_pq14");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq15"), "c_pq15");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq16"), "c_pq16");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq17"), "c_pq17");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq18"), "c_pq18");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq19"), "c_pq19");				frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq20"), "c_pq20");								frn.setX(getXmlAtt(cuboQuery,"r0", "c_pq21"), "c_pq21");								serie_original = frn.get("c_serie");				descrip_original = frn.get("k_descrip");								if ( frn.get("k_tipo_auto") &= "USADO" ) {									x_marca = getXmlAtt(cuboQuery,"r0", "x_marca");					x_modelo = getXmlAtt(cuboQuery,"r0", "x_modelo");					x_anio = getXmlAtt(cuboQuery,"r0", "x_anio");					x_version = getXmlAtt(cuboQuery,"r0", "x_version");					x_serie = getXmlAtt(cuboQuery,"r0", "x_serie");										//Added by JMM - 20230308					x_procedencia = getXmlAtt(cuboQuery,"r0", "x_procedencia");					x_combustible = getXmlAtt(cuboQuery,"r0", "x_combustible");					x_ocupantes = getXmlAtt(cuboQuery,"r0", "x_ocupantes");					x_cilindros = getXmlAtt(cuboQuery,"r0", "x_cilindros");					x_puertas = getXmlAtt(cuboQuery,"r0", "x_puertas");										// JM 20230222 ... Se elimino condicion en base a lo revisado con ES y VS para Usados ... Todos entrara en esquema de TBL Extendida (TBL Puente)  					//if ( strlen(x_marca) > 0 && strlen(x_modelo) > 0 && strlen(x_anio) > 0 && strlen(x_version) > 0 && strlen(x_serie) > 0 ) {						frn.setAtt("k_descrip", "available", "N");						frn.setAtt("c_serie", "available", "N");					//}										//Added by JMM - 20230215					frn.setX(x_marca, "v_marca");					frn.setX(x_modelo, "v_modelo");					frn.setX(x_anio, "v_anio");														frn.set("v_procedencia",descr_combo("v_procedencia",1, x_procedencia));											frn.setX(x_ocupantes, "v_ocupantes");					frn.setX(x_cilindros, "v_cilindros");					frn.setX(x_puertas, "v_puertas");					frn.setX(x_combustible, "v_combustible");									}						   } /* END Func MostrarDatosGrd() */		   		   		   		   fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);					for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}					   									} // End of class Main			</script></pag>