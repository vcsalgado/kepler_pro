<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Diario de Movimientos">	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<grp dim="40,20,7,13" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Diario de Movimientos">			<tab/><txt>Sucursal:</txt><sp n="2"/><cmb id="cmb_sucursal" dim="50,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" Null="N" modify="Y" available="Y"/><tab/><br/><br/>			<tab/><txt>Fecha inicial: </txt>			<edt id="edt_fecha_ini" dim="14,1" brdr="0,5" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" fmt="DD/MM/CCYY" fnt="Arial,16" page="_ks_fecha,edt_fecha_ini"/>			<tab n="2"/><txt>Fecha final: </txt>			<edt id="edt_fecha_fin" dim="14,1" brdr="0,5" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" fmt="DD/MM/CCYY" fnt="Arial,16" page="_ks_fecha,edt_fecha_fin"/><br/><br/><br/>			<tab n="6"/><txt id="genero">Documento inicial:</txt><sp/>			<tab/>			<inp id="k_genero_ini" dim="4,1" brdr="1,5" bclr="255,255,255" type="capital" fnt="Arial,18" clr="64,64,64" hk="u" tooltip="Genero Inicial"/>			<tab/>			<inp id="k_naturaleza_ini" dim="4,1" brdr="1,5" bclr="255,255,255" type="capital" fnt="Arial,18" clr="64,64,64" hk="u" tooltip="Naturaleza Inicial"/>			<tab/>			<inp id="k_grupo_ini" dim="4,1" brdr="1,5" bclr="255,255,255" type="number" fnt="Arial,18" clr="64,64,64" hk="u" tooltip="Grupo Inicial"/>			<tab/>			<inp id="k_tipo_ini" dim="4,1" brdr="1,5" bclr="255,255,255" type="number" fnt="Arial,18" clr="64,64,64" hk="u" tooltip="Tipo Inicial"/>			<tab n="5"/>			<br/>			<tab n="6"/>			<br/>			<tab n="6"/>			<txt id="genero">Documento Final:</txt><sp/>			<tab/>			<inp id="k_genero_fin" dim="4,1" brdr="1,5" bclr="255,255,255" type="capital" fnt="Arial,18" clr="64,64,64" hk="u" tooltip="Genero Final"/>			<tab/>			<inp id="k_naturaleza_fin" dim="4,1" brdr="1,5" bclr="255,255,255" type="capital" fnt="Arial,18" clr="64,64,64" hk="u" tooltip="Naturaleza Final"/>			<tab/>			<inp id="k_grupo_fin" dim="4,1" brdr="1,5" bclr="255,255,255" type="number" fnt="Arial,18" clr="64,64,64" hk="u" tooltip="Grupo Final"/>			<tab/>			<inp id="k_tipo_fin" dim="4,1" brdr="1,5" bclr="255,255,255" type="number" fnt="Arial,18" clr="64,64,64" hk="u" tooltip="Tipo Final"/>			<br/><br/><br/>			<tab n="9"/>			<bot id="bot_ejecutar" dim="20,0" brdr="5" text="Ejecutar" OnEnter="Execute()" default="1"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys,suc_usuario ,perfil_usuario,asterisco   ;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;								kdb.connect();				kdb.open("i,kdini,j,kdinm,k,kdinr,s,kdms,m,kdmm");								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				asterisco = "*";				Inicializa();							}						fun Inicializa(){//Inicializa los valores en Pantalla				frn.set("edt_fecha_ini",sys.date(sys.date("year"),sys.date("month")-3,1));				frn.set("edt_fecha_fin",sys.date(sys.date("year"),sys.date("month")-3,31));				IniCombos();				IniParams();//Inicializa parámtros de impresión entre otros				ValFecha();			}									fun IniCombos(){				var cmd, cuboQuery, xmlResQuery, ok, mensajeError, strTmp,cubo;				cuboQuery="datDoc";																	//Llenar combo sucursales								cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";								if (perfil_usuario &! "ADMINISTRADOR"  && perfil_usuario &! "ADMINISTRATOR" && perfil_usuario &! "Administrador Kepler 8.0"){													cmd = cmd & " where c1='" & suc_usuario & "'";									}else {									if (suc_usuario &! asterisco && suc_usuario &! "" ){									cmd = cmd & " where c1='" & suc_usuario & "'";										}								}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepdiariomov.IniCombos()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}												frn.set("cmb_sucursal",getXml(cubo));													//Llenar combos de productos				kdb.search("datosI,i,1,7,&,i1");				kdb.search("datosF,i,1,8,&,i1");				kdb.exec();				frn.set("edt_prod_ini",kdb.get("datosI","i1"));				frn.set("edt_prod_fin",kdb.get("datosF","i1"));					//frn.lib("libGeneral.kpl","FileSave",kdb.get("datalm"),"D:\Basura\datalm");											}			fun IniParams(){//Inicializa parámetros de impresión, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Página				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}			fun setRepPage() {//Establece los parámetros finales de impresión.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}						fun ValFecha(){				if(frn.get("edt_fecha_ini")&="")					frn.set("edt_fecha_ini",sys.date(sys.date("year"),sys.date("month"),1));				if(frn.get("edt_fecha_fin")&="")					frn.set("edt_fecha_fin",sys.date(sys.date("year"),sys.date("month"),31));			}												fun Execute() {				if (ValidarInfo() == 0){					return;				};				GenerarReporte();								//var val=frn.get("input");				//frn.message("Valor proporcionado:" & val,"Notificación","Aceptar");			}						fun GenerarReporte(){				var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var sqlXmlSaldos,cmd,ok,mensaje;				var cuboSaldos,contSaldos,totSaldos;				var clave,producto,fecha,documento,descripcion,tipo,cantidad,unidad,entrada,salida;				var totcantidad, totentrada, totsalida;				var movtoEnt, movtoSal;				kdb.kde("KDE");//Configuración del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();								//Obtener saldos totales //				setXml(sqlXmlSaldos,"document","sucursal_id",frn.get("cmb_sucursal",-1,1));				setXml(sqlXmlSaldos,"document","fecha_ini",frn.get("edt_fecha_ini"));				setXml(sqlXmlSaldos,"document","fecha_fin",frn.get("edt_fecha_fin"));				setXml(sqlXmlSaldos,"document","genero",frn.get("k_genero_ini"));				setXml(sqlXmlSaldos,"document","naturaleza",frn.get("k_naturaleza_ini"));				setXml(sqlXmlSaldos,"document","grupo",frn.get("k_grupo_ini"));				setXml(sqlXmlSaldos,"document","tipo",frn.get("k_tipo_ini"));								frn.lib("libGeneral.kpl","FileSave",sqlXmlSaldos,"C:\Basura\sqlXmlSaldos");								cmd="select * from keplersc.inv_rep_movdiario('" & getXmlStr(sqlXmlSaldos,"EOF:13_10") & "')";				cuboSaldos = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepdiariomov.GenerarReporte()");					frn.lib("libGeneral.kpl","FileSave",cuboSaldos,"C:\Basura\cuboSaldos");				ok=getXmlAtt(cuboSaldos,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboSaldos,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								kdb.readPage("datos","invrepdiariomovfto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parámetros finales de impresión.(rep.page(...);)				rep.set("k_empresa",compania);				rep.set("k_sucursal",frn.get("cmb_sucursal",-1,0)); 				rep.set("k_fecha_ini",frn.get("edt_fecha_ini"));				rep.set("k_fecha_fin",frn.get("edt_fecha_fin"));				rep.set("k_fecha_imp",fechaImpresion);				rep.set("K_hora_imp",horaImpresion);				rep.exe("encabezado");					//Iniciar Totales				totentrada=0;				totsalida=0;				totSaldos = nXml(cuboSaldos);				//totSaldos=1;				for(contSaldos=0; contSaldos<totSaldos; contSaldos++){					clave= getXmlAtt(cuboSaldos,"r"&contSaldos,"clave");					producto = getXmlAtt(cuboSaldos,"r"&contSaldos,"producto");					fecha = getXmlAtt(cuboSaldos,"r"&contSaldos,"fecha");					documento = getXmlAtt(cuboSaldos,"r"&contSaldos,"documento");					descripcion = getXmlAtt(cuboSaldos,"r"&contSaldos,"descripcion");					tipo = getXmlAtt(cuboSaldos,"r"&contSaldos,"tipo");					cantidad = getXmlAtt(cuboSaldos,"r"&contSaldos,"cantidad");					unidad = getXmlAtt(cuboSaldos,"r"&contSaldos,"unidad");					entrada = getXmlAtt(cuboSaldos,"r"&contSaldos,"entrada");					salida = getXmlAtt(cuboSaldos,"r"&contSaldos,"salida");					totentrada = totentrada + entrada;					totsalida = totsalida + salida;					rep.set("clave",clave);					rep.set("producto",producto);					rep.set("fecha",fecha);					rep.set("documento",documento);					rep.set("descripcion",descripcion);					rep.set("tipo",tipo);						rep.set("cantidad",cantidad);					rep.set("unidad",unidad);					rep.set("entrada",entrada);					rep.set("salida",salida);					rep.exe("seccion_detalle");				}				rep.set("total_entrada",strFormat("nfmt",totentrada,2));				rep.set("total_salida",strFormat("nfmt",totsalida,2));				rep.exe("seccion_total_reporte");				rep.win();			}			fun ValidarInfo(){				var fecha_ini, fecha_fin;				//Validacion de fechas				ValFecha();				fecha_ini = frn.get("edt_fecha_ini");				fecha_fin = frn.get("edt_fecha_fin");								if (fnDate("dif",fecha_fin,fecha_ini ) < 0) {					frn.message("La fecha de inicio no puede ser mayor a la final.","Error","Aceptar");					return 0;				}				return 1;			}											}	</script></pag>