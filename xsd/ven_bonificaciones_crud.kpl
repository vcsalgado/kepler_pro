<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Cheque">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<tab/><inp id="inp_titulo" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>		<br/><tab/>		<hLine clr="0,0,0"/> 		<br/> <br/><tab/> 		<grp dim="46,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros"><txt>  Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" tooltip="Sucursal" available="Y" modify="Y"/>			<br/><br/>			<txt>  Tipo :        </txt>			<cmb id="k_tipon" dim="40,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo()" tooltip="Tipo de Movimiento"/>			<br/>			<tab n="4"/><inp id="statusdoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N" type="string" visible="Y" just="C"/>		</grp>		<sp/>		<grp dim="34,10,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C"/>			<inp id="strfolio" clr="64,64,64" clrBrdr="255,255,255"  dim="7,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "N" modify="Y" visible="N"				OnChange="SeparaFolio()"/><br/>				<txt id="textFolio" visible="N">  Folio :  </txt>			<edt id="k_folio" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="10" tooltip="Folio ( F9 b&#250;squeda )" modify="Y" available="N" visible="N"				 OnF9="ObtenerFolio()" OnButton="ObtenerFolio()" OnChange="Formar_folio()"/>			<sp n="2"/>			<img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="BuscarFolio()" available="Y" clrBrdr="0,0,0" visible="N"/>			 <br/>			<sp n="1"/>			<inp id="k_docto" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="C"/> <br/>			<txt>  Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="Y" tooltip="Fecha"/> 			<sp n="1"/> 			<txt>  Hora : </txt> 			<sp n="1"/> 			<edt id="k_hora" dim="15,1" type="time" nc="-1" bclr="240,240,240"  fmt="HH:MM:SS" available="Y"/> 			<br/>		</grp>		<br/><br/><tab/>		<grp dim="81,26,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" fnt=",0"><tab/>			<tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" 					dim="110,8"  hk="z" Reorder="N" modify="N"   insdel="N" available="Y">				<col id="k_factura" name="Inventario"  type="capital" OnF9="ObtenerInventario()" OnChange="ValidaInv()" OnActive="CalcTotal()" np="145" visible="Y" modify="Y" available="Y" tooltip="Inventario ( F9 b&#250;squeda )"/>				<col id="k_monto_factura" name="Monto"  type="number" OnChange="monto()" OnActive="CalcTotal()" nd="2" nc="15" np="120" modify="N" tooltip="Monto" available="N"/>				<col id="k_iva_factura" name="IVA"  type="number" nd="2"  nc="15" OnActive="CalcTotal()" np="120" modify="N" visible="Y"/>				<col id="k_folio_bon" name="Folio Bonificacion"  type="capital" nd="2"  nc="15" np="120" modify="N" visible="N" OnChange="ObtenerBonif()"/>			</tbl>			<br/>            <grp dim="70,13,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" fnt=",0">                <br/>                <tab/><txt fnt=",">Referencia:  </txt>                <inp id="k_refer" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="capital" available="Y" modify="Y" tooltip="Referencia o Num. Factura Proveedor"/><br/>				<br/>                <tab/><txt fnt=",">N o t a s:  </txt>                <sp n="2"/>                 <inp id="k_coment" dim="55,4" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="capital" modify="Y" available="Y"/><br/>            </grp>            <tab n="2"/>            <grp dim="38,13,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" fnt=",0">                <tab/><txt fnt=",">Subtotal:  </txt>                <inp id="k_subtotal" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0b" available="N"/><br/>                <tab/><txt fnt=",">IVA:  </txt>	<sp/>	<tab n="1"/>                <inp id="k_iva" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0b" available="N"/><br/>                <tab/><txt>Importe:  </txt><sp/>                <inp id="k_monto" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0b" available="N"/><br/>                <br/>                <sp n="6"/><tab n="2"/>                <img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="EjecReporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>                <sp n="3"/>                <img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>                <sp n="3"/>                <img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>                           </grp>            <br/>						</grp>				</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable, asterisco ;			// Variables de control			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal, tabla, estatus_doc ;			var fileSavePath;			//Variables validacion factura			var	str_uuid, fecha_uuid, rfc_uuid, total_uuid;								//Variables de parametros         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, uen;			var editable; //Se controla si la poliza se puede editar, cancelar o dar de baja				//Porcentajes kdmm			var prc_iva ;			//cont			var presupuesto , saldo, fecha_baja, cargos_factura, abonos_factura, cargos_iva_factura, abonos_iva_factura;				fun Main() {			frn=new FRNT;			kdb=new KDB;			rep=new REP;			frP=new FRNTP;			sys=new SYS;			kdb.connect();			kdb.kde("KDE");			kdb.exec();			anio_contable = kdb.get("KDE","14");			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			suc_usuario = frn.lib("libKepler","UserInfo(1)");			asterisco = "*";			fileSavePath = "C:\Basura";			Inicializa();			ConfiguraControlesOpcion();								}					fun Inicializa(){ //Inicializa los valores en Pantalla			// Revisa parametros recibidos			if( frn.nParam() == 6 ){ //Se han mandado parï¿½metros a la pï¿½gina                gen_doc=trim(frn.param(0));                 nat_doc=trim(frn.param(1));                 gpo_doc=trim(frn.param(2));                tip_doc=trim(frn.param(3));                 tip_ope=trim(frn.param(4));                uen=trim(frn.param(5));				if (uen &= ""){					uen="XXX";				}			} else {				frn.message("Operación no válida ...", "Mensaje","&Aceptar");//				frn.open("redirect",2);				return;			}            			if(tip_ope &= "A"){ //Alta				frn.set("operacion","ALTA");			} else {				if(tip_ope &= "B"){ //Baja					frn.set("operacion","BAJA");				} else {					if(tip_ope &= "C"){ //Consulta						frn.set("operacion","CONSULTA");					} else {						frn.message("Operación no válida ...", "Mensaje","&Aceptar");						frn.open("index",4);						return;								}				}			}			//Establecer titulo de la ventana			if (nat_doc &= "D"){				frn.set("inp_titulo","Bonificaciones");											}else {				 if (nat_doc &= "A"){					frn.set("inp_titulo","Baja de Bonificaciones");									}			}				//Llenar combo sucursales			var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmd = cmd & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmd = cmd & " where c1='" & suc_usuario & "'";				}			}							var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");					ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}								frn.set("k_sucn",getXml(cubo));						sucursal_id=frn.get("k_sucn",-1,1);							// Fill Combo Tipo (Con Query FTO Kepler) 			LlenaCmbTipo();							// Fill k_docto | referencia docto			ArmarRefDocto();					porcentajes_kdmm();		}				fun LlenaCmbTipo(){			sucursal_id=frn.get("k_sucn",-1,1);							// Fill Combo Tipo (Con Query FTO Kepler) 			cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and col_sucursal='" & sucursal_id & "'";			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.Inicializa()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error BD","Aceptar");				return;			}			frn.set("k_tipon",getXml(cuboQuery));		}						// Armado del Docto Referencia		fun ArmarRefDocto {			var cadena = frn.get("k_tipon", -1, 5);			var fol = frn.get("k_folio");			if (tip_ope &! "A" && fol &! ""){				cadena = strSplit(cadena,"-",0) & "-" & fol;			}					frn.set("k_docto", cadena);		}					fun PadLeft(pText,pRelleno,pCaracterRelleno) {			var Resultado;			var pos_ini = pText;			var nReg = strlen(pText);			for (var cont = nReg; cont < pRelleno; cont++) {				Resultado = pCaracterRelleno & Resultado;			}			Resultado = Resultado & pText;                			return Resultado;		}				fun CambiaTipo() {				tip_doc  = frn.get("k_tipon", -1, 4);			porcentajes_kdmm();			borrar_datos();			LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();						}		      fun ObtenerInventario() {			sucursal_id = frn.get("k_sucn",-1,1);			if (tip_ope &="A"){				cmdQuery = "select c1 as sucursal, c2 as inventario,c4 as descripcion " &						   "from keplersc.kdinf ";				frn.dialog("genlistafiltrosel","Números de Inventario",cmdQuery,"inventario","k_mov",-1,"k_factura","N","S");				} else{				if (tip_ope &="B"){				cmdQuery = "select dm5.c1 as sucursal,dm5.c14 as inventario,dm5.c12 as monto,dm5.c13 as iva,dm5.c6 as folio " & 							"from keplersc.kdm5 dm5 " &							"inner join keplersc.kdm1 dm1 on dm1.c1=dm5.c1 and dm1.c2=dm5.c2 and dm1.c3=dm5.c3 and dm1.c4=dm5.c4 and dm1.c5=dm5.c5 and dm1.c6=dm5.c6 " &							"where dm5.c1 = '" & sucursal_id &"' and dm5.c2 = '" & gen_doc & "' and dm5.c3 = 'D' and dm5.c4 ='" & gpo_doc & "' and dm5.c5 = " & tip_doc & " and dm1.c43 <>'C'";				frn.dialog("genlistafiltrosel","Números de Inventario",cmdQuery,"folio","k_mov",-1,"k_folio_bon","N","S");								}			}			}		fun ObtenerBonif(){			var nFolioBon,cmd,cuboResultados,inventario,montobon,ivabon;			sucursal_id = frn.get("k_sucn",-1,1);						nFolioBon = frn.get("k_mov",-1,"k_folio_bon");			cmd = "select c14 as k_factura,c12 as k_monto_factura,c13 as k_iva_factura, c6 as k_folio_bon " &                 "from keplersc.kdm5 where c1='" & sucursal_id & "' and c2='" & gen_doc &"' and c3='D'" &			    " and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolioBon & "'";						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_bonificaciones_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultadosDetFolioBon");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}						inventario = getXmlAtt(cuboResultados,"r0","k_factura");			frn.setX(inventario,"k_mov", -1,"k_factura");				montobon = getXmlAtt(cuboResultados,"r0","k_monto_factura");			ivabon = getXmlAtt(cuboResultados,"r0","k_iva_factura");			frn.setX(montobon ,"k_mov", -1,"k_monto_factura");			frn.setX(ivabon ,"k_mov", -1,"k_iva_factura");			CalcTotal();		}		fun ValidaInv(){			var totReg,inv;			sucursal_id = frn.get("k_sucn",-1,1);			if (frn.get("k_mov",-1,"k_factura") &=""){				frn.setPos("k_mov",-1,"k_factura");				frn.message("Debe seleccionar un Número de Inventario","Error","Aceptar");				return;			}			//Validar Inventario			inv = frn.get("k_mov",-1,"k_factura");			cmdQuery="SELECT count(*) as totreg from keplersc.kdinf where c1 = '" & sucursal_id & "' and c2='" & inv & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ven_bonificaciones_crud.ValidaInv()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("El inventario no existe.","Error","Aceptar");				resVal=0;				return;			}         //Valida que no ingresen el mismo inventario          ValidaDuplicado();		}        fun ValidaDuplicado(){			var renglon_id, renglones, cveinv;			sucursal_id = frn.get("k_sucn",-1,1);						renglones = frn.N("k_mov")-1;			renglon_id = frn.getIdJ("k_mov");			cveinv = frn.get("k_mov",-1,"k_factura");						for (var i=0; i<renglones; i++) {				if (renglon_id != i){					if (frn.get("k_mov",i,"k_factura") &= cveinv) {  						frn.message("Verifique, esta intentado dar de alta el mismo Número de Inventario","Error","Aceptar");						return;					}				}				}			}		fun porcentajes_kdmm(){			var cmd, cuboResultados ,ok,mensajeError;			sucursal_id=frn.get("k_sucn",-1,1);			tip_doc=frn.get("k_tipon",-1,4);					cmd= " select c15,c16,c33,c75 from keplersc.kdmm where c1='" & gen_doc & "'" ;						cmd = cmd & " and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4='" & tip_doc & "' and col_sucursal='" & sucursal_id & "'";			cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.porcentajes_kdmm()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			prc_iva = getXmlAtt(cuboResultados , "r0","c16");		}				fun CambiaSucursal() {			sucursal_id = frn.get("k_sucn",-1,1);			LimpiaEncabezado();			borrar_datos();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				LlenaCmbTipo();			ArmarRefDocto();			porcentajes_kdmm();						}				fun LimpiaEncabezado() {			frn.set("k_folio", "");			frn.set("k_docto", "");			frn.set("k_fecha", "");			frn.set("k_hora", "");		}				fun borrar_datos(){			frn.rst("k_mov");			frn.rst("k_refer");			frn.rst("k_coment");			frn.set("k_subtotal", 0);			frn.set("k_iva", 0);			frn.set("k_monto", 0);		}				fun BuscarFolio() {			var folio;			folio = frn.get("k_folio");			folio = PadLeft(folio, 7, "0");			ArmarRefDocto();			borrar_datos();			MostrarDatos(folio);								}		fun Cancela() {			CambiaSucursal();			borrar_datos();			Inicializa();			ConfiguraControlesOpcion();		}		fun SeparaFolio(){			var folio,nCampos,nfolio;				//Separa el folio y tipo, vienen concatenados con ~			nCampos = strSplit(frn.get("strfolio"),"~",-1);			if (nCampos > 1) {				tip_doc = strSplit(frn.get("strfolio"),"~",0);				nfolio = strSplit(frn.get("strfolio"),"~",1);				frn.set("k_tipon",descr_combo("k_tipon",4,tip_doc));			}else{				nfolio = frn.get("strfolio");			}				folio = nfolio;			frn.set("k_folio", folio);		}		fun ObtenerFolio() {			sucursal_id = frn.get("k_sucn",-1,1);			LimpiaEncabezado();			borrar_datos();			cmdQuery = "select c5 as tipo, c6 as folio, to_char(c9, 'dd/mm/yyyy') as fecha, " &						"c11 as referencia, c16 as monto, c43 estatus, concat(c5,'~',c6) as llave " &						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" & gpo_doc & 						" order by c9 desc";									frn.dialog("genlistafiltrosel","Folios de Bonificaciones",cmdQuery,"llave","strfolio","0","0","N","S");					}				fun descr_combo(combo,posicion,valor){			var descr, valor_actual;			var len_combo = frn.N(combo);			for (var cont=0; cont<len_combo ; cont++){				valor_actual= frn.get(combo,cont,posicion);				if (valor_actual &=  valor){					descr = frn.get(combo,cont,0);					return descr;				}			}		}				fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    			1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 			2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 			3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			// var tip_ope; 			var tip_oper;			if(iModo==0)				page=pag; 			else if(iModo==2&&(strlen(par0)>0)){				//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       				if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 				if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;			}			else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     		}						//-----------------------------------FACTURA------------------------					fun monto(){            ValidaDuplicado();			if (strlen(frn.get("k_mov", -1, "k_factura")) == 0){                frn.setPos("k_mov", -1, "k_factura");				frn.message("Debe seleccionar un Número de Inventario antes","Error","Aceptar");				borrar_datos_factura();				return;			}						var monto_factura = frn.get("k_mov", -1, "k_monto_factura");			if (monto_factura <= 0){				frn.message("No se puede dejar el monto en 0s","Error","Aceptar");				borrar_datos_factura();				return;			}			iva(monto_factura);				}				fun borrar_datos_factura(){			frn.setX("", "k_mov", -1, "k_monto_factura");			frn.setX("", "k_mov", -1, "k_iva_factura");		}								fun iva(monto){		    var iva = monto * (1-(1/(1+prc_iva/100)));			frn.setX(iva ,"k_mov", -1, "k_iva_factura");						CalcTotal();		}				fun CalcTotal() { 						var monto_facturas =0, iva_facturas=0; 								for (var i=0,n=frn.N("k_mov")-1;i<n;i++) { 					monto_facturas=monto_facturas +frn.get("k_mov",i,"k_monto_factura");					iva_facturas=iva_facturas+frn.get("k_mov",i,"k_iva_factura");				}								frn.set("k_subtotal", monto_facturas - iva_facturas, "k_iva" ,iva_facturas, "k_monto", monto_facturas);				}			//-----------------------------------------------				fun ConfiguraControlesOff() {							frn.setAtt("textFolio", "visible", "N");			frn.setAtt("k_folio", "available", "N");			frn.setAtt("k_folio", "visible", "N");			frn.setAtt("k_mov", "modify", "N");			frn.setAtt("k_mov", "available", "N", "k_factura");			frn.setAtt("k_mov", "available", "N", "k_monto_factura");			frn.setAtt("k_mov", "visible", "N", "k_folio_bon");			frn.setAtt("k_mov", "modify", "N", "k_factura");			frn.setAtt("k_mov", "modify", "N", "k_monto_factura");			frn.setAtt("k_refer", "available", "N");			frn.setAtt("k_coment","modify", "N");			frn.setAtt("k_coment","available", "N");			frn.setAtt("Imprimir", "visible", "N");			frn.setAtt("Cancelar", "visible", "N");			frn.setAtt("Aceptar", "visible", "N");			frn.setAtt("buscar_datos", "visible", "N");							}						fun ConfiguraControlesOpcion() {						ConfiguraControlesOff();			if(tip_ope &= "A"){ //Alta				frn.setAtt("k_refer", "available", "Y");				frn.setAtt("k_mov", "modify", "Y");				frn.setAtt("k_mov", "available", "Y", "k_factura");				frn.setAtt("k_mov", "available", "Y", "k_monto_factura");				frn.setAtt("k_mov", "visible", "N", "k_folio_bon");				frn.setAtt("k_mov", "modify", "Y", "k_factura");				frn.setAtt("k_mov", "modify", "Y", "k_monto_factura");				frn.setAtt("k_coment","modify", "Y");				frn.setAtt("k_coment","available", "Y");				frn.setAtt("Cancelar", "visible", "Y");				frn.setAtt("Aceptar", "visible", "Y");												} else {				if(tip_ope &= "B"){ //Baja								frn.setAtt("k_refer", "available", "Y");				frn.setAtt("k_mov", "available", "Y", "k_factura");				frn.setAtt("k_mov", "available", "N", "k_monto_factura");				frn.setAtt("k_mov", "visible", "N", "k_folio_bon");				frn.setAtt("k_mov", "modify", "Y", "k_factura");				frn.setAtt("k_coment","modify", "Y");				frn.setAtt("k_coment","available", "Y");				frn.setAtt("Cancelar", "visible", "Y");				frn.setAtt("Aceptar", "visible", "Y");												} else {					if(tip_ope &= "C"){ //Consulta						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");											frn.setAtt("Imprimir", "visible", "Y");						frn.setAtt("buscar_datos", "visible", "Y");								frn.setAtt("k_mov", "available", "Y");						frn.setAtt("k_mov", "visible", "N", "k_folio_bon");						frn.setAtt("k_refer", "available", "N");						frn.setAtt("k_coment","modify", "N");						frn.setAtt("k_coment","available", "Y");					} else {						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");						frn.setAtt("k_fecha", "available", "Y");						frn.setAtt("k_hora", "available", "Y");									}					}			}		}				//---------------------------------------EJECUTA---------------------------------			fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			var resultado, mensaje, folio;							fecha = sys.date();			hora= sys.time();							if (tip_ope &= "A") {							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;				ValidarDatos();				if(ok &! "1" || resVal == 0){					return;				}				if (nat_doc &= "D"){					continua = frn.message("¿Desea continuar con la Bonificación?","Atención",2);				}else {					if (nat_doc &= "A"){						continua = frn.message("¿Desea continuar con la Baja de Bonificación?","Atención",2);					}				}									if (continua == 0){					return;				}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;				setXml(xmlPantalla,"k_var_sr","VENTAS");				setXml(xmlPantalla,"k_foliodocto","VXX0000001");				setXml(xmlPantalla,"k_claveinv",frn.get("k_mov",-1,"k_factura"));				setXml(xmlPantalla,"k_valorunid",1);				setXml(xmlPantalla,"k_porcenganche",frn.get("k_mov",-1,"k_monto_factura"));				setXml(xmlPantalla,"k_valorenganche",frn.get("k_mov",-1,"k_iva_factura"));				setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);									frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaBonifAlta");				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_bonificaciones_crud.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoBonifAlta");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					tip_ope = "C";					frn.set("k_folio", mensaje); 					frn.set("operacion", "CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto", strTmp);					strMsg = "El Folio utilizado para esta operación fue : " & mensaje;					ConfiguraControlesOpcion(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");					MostrarDatos(folio);					} else {					frn.message(mensaje, "Error", "Aceptar");					return;				}			} else {				if (tip_ope &= "B") {					if (estatus_doc &= "C"){						frn.message("No puedes dar de baja un folio cancelado.", "Error", "Aceptar");						return ;					}					continua = frn.message("¿Desea continuar con la Baja de Bonificación?","Atención",2);					if (continua == 0){						return;					}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;					setXml(xmlPantalla,"k_var_sr","VENTAS");					setXml(xmlPantalla,"k_foliodocto","VXX0000001");					setXml(xmlPantalla,"k_claveinv",frn.get("k_mov",-1,"k_factura"));					setXml(xmlPantalla,"k_valorunid",1);					setXml(xmlPantalla,"k_porcenganche",frn.get("k_mov",-1,"k_monto_factura"));					setXml(xmlPantalla,"k_valorenganche",frn.get("k_mov",-1,"k_iva_factura"));								setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);					setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);					setXml(xmlPantalla,"operacion","BAJAB");	//No se envia BAJA xq debe entrar al docdis_na y si se ponde BAJA entra al docdis_na_baja					setXml(xmlPantalla,"ambiente","uen",uen);																frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaBonifBaja");					cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					rstXml(cuboQuery);											cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_bonificaciones_crud.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoBonifBaja");											resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok) {						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}					if(resultado &= "1") {						tip_ope = "C";						frn.set("k_folio", mensaje); 						frn.set("operacion", "CONSULTA");						strTmp = frn.get("k_docto");						strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;						frn.set("k_docto", strTmp);						strMsg = "El Folio utilizado para esta operación fue : " & mensaje;						ConfiguraControlesOpcion(); 						frn.message(strMsg, "Mensaje", "Aceptar");						folio = frn.get("k_folio");						MostrarDatos(folio);						} else {						frn.message(mensaje, "Error", "Aceptar");						return;					}				} else {					folio = frn.get("k_folio");					MostrarDatos(folio);				}			}						}				//Validacion Datos Generales y Partidas antes de Guardar.		//El resultado de cada validacion se guarda en la variable global resVal.		fun ValidarDatos() {			var totReg, strTotal=0,subTotal=0, iva=0, total=0, renglones, str;			//Obtener variables			sucursal_id = frn.get("k_sucn",-1,1);			refer_id = frn.get("k_refer");										//Validar Referencia			if (refer_id &= ""){				frn.setPos("k_refer");				resVal=0;				frn.message("Es necesario indicar la referencia","Error","Aceptar");				return;			}					var nreg = frn.N("k_mov")-1;//cuantos renglones hay			if(nreg ==0){				frn.message("No es posible dar de alta una un Bonificación sin datos. Favor de verificar", "Error","Aceptar");				resVal=0;return;			}            //Valida que tengan datos el Num Inventario y Monto de cada renglon			for(var i=0; i<nreg; i++){				var fac = frn.get("k_mov",i,"k_factura");				var fac_monto = frn.get("k_mov",i,"k_monto_factura");				var factura_numero = i +1 ;				if (strlen(fac) == 0){					frn.message("En la Bonificación " & factura_numero  & " |No se especifica el Número de Inventario","Error","&Aceptar");					frn.setPos("k_mov",-1,"k_factura");					resVal=0;return;				}				if (strlen(fac_monto) == 0 || fac_monto == 0){					frn.message("En la Bonificación " & factura_numero  & " |No se especifica el monto" ,"Error","&Aceptar");					frn.setPos("k_mov",-1,"k_monto_factura");					resVal=0;return;				}			}                        //Calcula Totales            CalcTotal();		} // End ValidarDatos()		//-----------------------BAJA,CONSULTA----------------------------			fun MostrarDatos(nFolio) {					var cmd,xmlRequest,xmlPoliza,xmlPartidas,tmpXml,tmpCubo,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError,   ;						sucursal_id = frn.get("k_sucn",-1,1);					cmd="select c6 as k_folio,c9 as k_fecha,c11 as k_refer,c14 as k_iva,c16-c14 as k_subtotal,c16 as k_monto,c69 as k_hora," & 				 "concat(regexp_replace(c24,'\r|\n',' ', 'g'),' ',c25,' ',c26) as k_coment,c43 as statusdoc,c197 as fecha_baja " &						    "from keplersc.kdm1 where c1='" & sucursal_id  & "' and c2='" & gen_doc  &"' and c3='" & nat_doc & "' and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_bonificaciones_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultadosRes");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			//Limpiar antes de presentar datos			LimpiaEncabezado();			borrar_datos();			rstXml(xmlPoliza);			xmlPoliza=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboResultados,"r0");			frn.setX(xmlPoliza);			if (getXmlAtt(cuboResultados,"r0","statusdoc") &= "C"){	// C=Baja Bonificacion				//frn.message("La Bonificacion esta dada de baja","Error","Aceptar");				frn.set("statusdoc", "B A J A");			}else{				frn.set("statusdoc", "");			}			rstXml(cmd);							cmd = "select c14 as k_factura,c12 as k_monto_factura,c13 as k_iva_factura " &                 "from keplersc.kdm5 where c1='" & sucursal_id & "' and c2='" & gen_doc &"' and c3='" & nat_doc & "'" &			    " and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_bonificaciones_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultadosDet");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}						frn.setX(cuboResultados , "k_mov");						ArmarRefDocto();											} //End MostrarDatos()								//-----------------REPORTE-----------		fun IniParams(){//Inicializa parÃ¡metros de impresiÃ³n, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar PÃ¡gina				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1","param_borderT","1.5","param_borderR","1","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}						fun setRepPage() {//Establece los parï¿œmetros finales de impresiï¿œn.			var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";			var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";			var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");			var lndsp="landscape=" & frn.get("param_landscape");			var emp="@emp=" & frn.get("param_emp");			rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);		}			fun EjecReporte(){//Imprime el reporte del documento especificado 				if(strlen(trim(frn.get("k_folio")))==0){ 					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");					frn.setPos("k_folio");return;					}				Reporte();				frn.setPos("k_folio");			}							fun Reporte(){				var compania,contProd, contDet, tmpStr;				var xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle;					var tmpXml, contDet, xmlCurDet, xmlDetConv, datdoc;				var desc_sucursal, fecha, total, importe, folio, docto, notas;								sucursal_id = frn.get("k_sucn",-1,1);				desc_sucursal = frn.get("k_sucn",-1,0);				refer_id = frn.get("k_refer");				folio = frn.get("k_folio");				docto = frn.get("k_docto");				notas = frn.get("k_coment");								//Obtener datos de encabezado				kdb.kde("KDE");//Configuraci??el servidor				kdb.exec();				compania = kdb.get("KDE","1");   // Se obtiene el nombre de la compania								// Se define el formato a usar y se liga a la variable del reporte "rep"				kdb.readPage("datFto","ven_bonificaciones_crudfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				rep.rst();				setRepPage();//Establece los par?metros finales de impresi?n(rep.page(...);), pues pueden haber cambiado por el usuario 				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				//Da valor a los inputs del reporte(rep.set();), e indica la ejecuci?n de "grupos de renglones de impresi?n" (rep.exe();)				rep.set("fecha",sys.date());				rep.set("hora",sys.time());				rep.set("nombreempresa",compania);				rep.set("desc_sucursal",desc_sucursal);				rep.set("docto",docto);				rep.set("folio",folio);								rep.exe("encabezado");								//Procesa poliza contable				kdb.sp("k_getDoc","datDoc",sucursal_id,gen_doc,nat_doc,gpo_doc,tip_doc,folio); 				kdb.exec();				var nRenPol=kdb.NR("datDoc","k_poliza");				var tPoliza=kdb.get("datDoc","k_poliza","tpoliza");				var nPoliza=kdb.get("datDoc","k_poliza","npoliza");			   				if (strlen(tPoliza)>0 && strlen(nPoliza)>0 ){						rep.set("tPol",tPoliza);						rep.set("nPol",nPoliza);						rep.exe("encabezadoPol");						var tAbonosPol=0, tCargosPol=0;						for(var i=0;i<nRenPol;i++){							if (kdb.get("datDoc","k_poliza","r"&i,"k_cargo")==0){								rep.set("PolClave2",kdb.get("datDoc","k_poliza","r"&i,"k_cuenta"));								rep.set("PolDescr2",kdb.get("datDoc","k_poliza","r"&i,"k_ctaDescr"));								rep.set("PolHaber",kdb.get("datDoc","k_poliza","r"&i,"k_abono"));								tAbonosPol=tAbonosPol+kdb.get("datDoc","k_poliza","r"&i,"k_abono");								rep.exe("partPolA");							}else{								rep.set("PolClave",kdb.get("datDoc","k_poliza","r"&i,"k_cuenta"));								rep.set("PolDescr",kdb.get("datDoc","k_poliza","r"&i,"k_ctaDescr"));								rep.set("PolDebe",kdb.get("datDoc","k_poliza","r"&i,"k_cargo"));								tCargosPol=tCargosPol+kdb.get("datDoc","k_poliza","r"&i,"k_cargo");								rep.exe("partPolC");							}						}						rep.set("totCargo",tCargosPol);						rep.set("totAbono",tAbonosPol);						rep.exe("PolTotales");				}								rep.set("desc_notas",notas);					rep.exe("notastitulos");								rep.exe("totalproducto");									rep.win(); //Muestra la vista previa de la impresi?n. A partir de la vista previa (Preprint) se decide si se imprime o no.			}				//-----------------------------------			fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);			}				} // End of class Main	</script></pag>