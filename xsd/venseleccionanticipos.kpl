<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit=""><grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0">	<br/>	<br/>	<tab/>    <grp id="gpo_general" bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="85,26,7,11" brdr="0,5" fnt="Arial,16" tit="Anticipos">		<br/>        <tab/><sp n="3"/><txt>S/N (Doble click para seleccionar)</txt>        <br/><tab/>        <tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" 				bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="80,7"  hk="z"  Reorder="N" modify="N" available="Y">            <col id="sel" name="S/N" modify="N" available="Y" OnChange="ValidaSoN()" OnActive="consulta_comentarios()"/>			<col id="gen_anticipo" name="G"  type="string"  visible="N"/> 			<col id="nat_anticipo" name="N"  type="string"  visible="N"/> 			<col id="gpo_anticipo" name="Gpo"  type="string"  visible="N"/>			<col id="tpo_anticipo" name="Tpo"  type="string"  visible="N"/>			<col id="folio" name="Folio"  type="string"  modify="N" OnActive="consulta_comentarios()"/>			<col id="fecha" name="Fecha"  type="date"  modify="N" OnActive="consulta_comentarios()" nc="-1" fmt="DD/MM/CCYY"/>				<col id="monto_factura" name="Monto" nd="2"  type="number" OnActive="consulta_comentarios()"/>			<col id="iva_factura" name="IVA"  type="number" nd="6" min="0" modify="N" OnActive="consulta_comentarios()"/>            <col id="referencia" name="Referencia"  type="string"  modify="N" OnActive="consulta_comentarios()"/>			 <col id="estatus" name="Estatus"  type="string"  modify="N" visible="S" OnActive="consulta_comentarios()"/>             <col id="cmnts_anticipo" name="Observaciones"  type="string"  visible="N" modify="N" OnActive="consulta_comentarios()"/>				</tbl>        <br/>        <tab/><txt>Observaciones: </txt><br/>		<sp n="2"/><inp id="comentarios" dim="81,2" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="N" available="N" brdr="0,2"/>	   <br/>      <br/>		<tab n="9"/><sp n="2"/>		<bot id="bot_aceptar" dim="12,0" brdr="5" text="Aceptar" hk="K" step="0" OnEnter="Ejecuta()" visible="N"/><tab n="2"/>		<bot id="bot_cancelar" dim="12,0" brdr="5" text="Cancelar" hk="K" step="0" OnEnter="Cancelar()" visible="N"/>	</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,cmdQuery,cuboQuery,ok,mensajeError;			var sucursal_id,origen,cve_cliente,rfc,inventario,tip_ope,resVal;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								tip_ope=trim(frP.param(5));				Inicializa();				ConfiguraCamposOpcion();			}								fun Inicializa(){				var fecha_anticipos;				frn.rst("gpo_general");                sucursal_id=frP.get("k_sucn",-1,1);                cve_cliente=frP.get("k_cliente");				rfc=frP.get("k_c10");				inventario=frP.get("k_inventario");								cmdQuery = "select valor from keplersc.param_oper where sucursal='" & sucursal_id & "' and parametro='Fecha considerar anticipos'";				frn.lib("libGeneral.kpl","FileSave",cmdQuery,"c:\basura\cmdselparamoper");				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venseleccionanticipos.Inicializa()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				fecha_anticipos = getXmlAtt(cuboQuery,"r0", "valor");				//Si tiene tipo_relacion=07 y folio_relacionado tiene valor, ya esta seleccionado a la factura, si c8=10 ya esta aplicado a la factura 				if (tip_ope &= "0") {//					if (rfc &= "XAXX010101000" || rfc &="XEXX010101000"){			//Pongo comentario en el if y else hasta que se depuren las claves de los clientes						cmdQuery = "select 'N',dm1.c2,dm1.c3,dm1.c4,dm1.c5,dm1.c6,dm1.c9,dm1.c16,dm1.c14,dm1.c11,'',concat(dm1.c24,' ',dm1.c25,' ',dm1.c26) " &								"from keplersc.kdm1 dm1 " & 								"inner join keplersc.kdf3ncant nca on nca.c1=dm1.c1 and nca.c2=dm1.c2 and nca.c3=dm1.c3 and nca.c4=dm1.c4 and nca.c5=dm1.c5 and nca.c6=dm1.c6 and nca.c8=0 " &								"and nca.tipo_relacion ='' and (nca.folio_relacionado= '' or substring(nca.folio_relacionado,1,1) ~ '^[0-9\.]+$' = true) " &								"where dm1.c1 = '" & sucursal_id& "' and dm1.c2 = 'U' and dm1.c3 = 'D' and dm1.c4 = '79' and dm1.c10='" & cve_cliente & "' ";/*					} else {						cmdQuery = "select 'N',dm1.c2,dm1.c3,dm1.c4,dm1.c5,dm1.c6,dm1.c9,dm1.c16,dm1.c14,dm1.c11,'',concat(dm1.c24,' ',dm1.c25,' ',dm1.c26) " &								"from keplersc.kdm1 dm1 " & 								"inner join keplersc.kdf3ncant nca on nca.c1=dm1.c1 and nca.c2=dm1.c2 and nca.c3=dm1.c3 and nca.c4=dm1.c4 and nca.c5=dm1.c5 and nca.c6=dm1.c6 and nca.c8=0 " &								"and nca.tipo_relacion = '' and (nca.folio_relacionado= '' or substring(nca.folio_relacionado,1,1) ~ '^[0-9\.]+$' = true) " &								"where dm1.c1 = '" & sucursal_id& "' and dm1.c2 = 'U' and dm1.c3 = 'D' and dm1.c4 = '79' and dm1.c22='" & rfc & "' ";					}*/										if (fecha_anticipos &! "") {						cmdQuery = cmdQuery & "and dm1.c9 >= '" & fecha_anticipos & "' ";					}										cmdQuery = cmdQuery & "order by dm1.c9 desc";					frn.lib("libGeneral.kpl","FileSave",cmdQuery,"c:\basura\cmdselanticipos");					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venseleccionanticipos.Inicializa()");					frn.lib("libGeneral.kpl","FileSave",cuboQuery,"c:\basura\selanticipos");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					if(nXml(cuboQuery) == 0){						frn.message("No hay anticipos registrados", "Error", "Aceptar");						return;					} else{						frn.setX(cuboQuery,"k_mov");											}					}				if (tip_ope &= "1") {					cmdQuery = "select 'S',ant.c2,ant.c3,ant.c4,ant.c5,ant.c6,ant.c9,ant.c16,ant.c14,ant.c11,case when nca.c8=10 and nca.c12 <> '' then 'APLICADO' else 'SELECCIONADO' end ,concat(ant.c24,' ',ant.c25,' ',ant.c26) " &								"from keplersc.kdm1 dm1 " & 								"inner join keplersc.kdf3ncant nca on nca.c1=dm1.c1 and nca.genero_doctorel =dm1.c2 and nca.naturaleza_doctorel =dm1.c3 and nca.grupo_doctorel =dm1.c4 and nca.tipo_doctorel =dm1.c5 and nca.folio_relacionado=dm1.c6 " &								"inner join keplersc.kdm1 ant on ant.c1=dm1.c1 and ant.c2 =nca.c2 and ant.c3 =nca.c3 and ant.c4 =nca.c4 and ant.c5 =nca.c5 and ant.c6=nca.c6 " &								"where dm1.c1='"&sucursal_id&"' and dm1.c2='"&frP.get("k_tipon",-1,1)&"' and dm1.c3='"&frP.get("k_tipon",-1,2)&"' and dm1.c4='"&frP.get("k_tipon",-1,3)&"' and dm1.c5='"&frP.get("k_tipon",-1,4)&"' and dm1.c6='"&frP.get("k_folio")&"' "&								"order by dm1.c9 desc";										frn.lib("libGeneral.kpl","FileSave",cmdQuery,"c:\basura\cmdselanticipos");					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venseleccionanticipos.Inicializa()");					frn.lib("libGeneral.kpl","FileSave",cuboQuery,"c:\basura\selanticipos");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}								if (nXml(cuboQuery) == 0){						frn.message("No hay anticipos seleccionados/aplicados", "Error", "Aceptar");						return;									} else{						frn.setX(cuboQuery,"k_mov");					}				}				}			fun ConfiguraControlesOff()			{				frn.setAtt("bot_cancelar","visible","N");				frn.setAtt("bot_aceptar","visible","N");				frn.setAtt("comentarios","available","N");				//frn.setAtt("k_mov","available","N","sel");				frn.setAtt("k_mov","OnMouseD","","sel");			}			fun ConfiguraCamposOpcion()			{				ConfiguraControlesOff();				if (tip_ope &= "0") {					frn.setAtt("bot_cancelar","visible","Y");					frn.setAtt("bot_aceptar","visible","Y");					frn.setAtt("comentarios","available","Y");					//frn.setAtt("k_mov","available","Y","sel");					frn.setAtt("k_mov","OnMouseD","SoN()","sel");				} else if (tip_ope &= "1") {					frn.setAtt("bot_cancelar","visible","N");					frn.setAtt("bot_aceptar","visible","N");					frn.setAtt("comentarios","available","Y");					//frn.setAtt("k_mov","available","N","sel");				}			}            fun SoN() {				if (frn.get("k_mov",-1,"sel") &= "S"){					frn.setX("N","k_mov",-1,"sel");                } else {					frn.setX("S","k_mov",-1,"sel");                }            }			fun ValidaSoN(){            //solo si el campo esta disponible                 if (frn.get("k_mov",-1,"sel") &! "S" && frn.get("k_mov",-1,"sel") &! "N"){                    frn.setPos("k_mov",-1,"sel");                    frn.message("Sólo puede ser S o N","Error","&Aceptar");                    return;                }  			}            fun consulta_comentarios(){				frn.set("comentarios",frn.get("k_mov",-1,"cmnts_anticipo"));			}			fun Ejecuta() {				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;				var resultado, mensaje, folio;				fecha = sys.date();				hora= sys.time();					if (tip_ope &= "0") {								//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok					resVal = 1;					ValidarDatos();					if(ok &! "1" || resVal == 0){						return;					}					continua = frn.message("¿Desea seleccionar los anticipos?","Atención",2);					if (continua == 0){						return;					}									xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					setXml(xmlPantalla,"k_sucursal",sucursal_id);					setXml(xmlPantalla,"k_inventario",inventario);					setXml(xmlPantalla,"tip_ope",tip_ope);								setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);																frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"c:\basura\xmlPantallaSA");										cmdQuery="SELECT * FROM keplersc.ven_seleccion_anticipos('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					rstXml(cuboQuery);						cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"venseleccionanticipos.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, "c:\basura\xmlResultadoSelanticpos");											resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok) {						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}					if(resultado &= "1") {						frn.message(mensaje, "Mensaje", "Aceptar");						frn.exit();					} else {						frn.message(mensaje, "Error", "Aceptar");						return;					}				} else {					frn.exit();				}					}			fun ValidarDatos(){				var renglones, regSel;				renglones=frn.N("k_mov");				regSel=0;				for (var i=0; i<renglones; i++){					if (frn.get("k_mov",-1,"sel") &= "S") {						regSel = regSel+1;					}				}				if (regSel ==0){					frn.message("No ha seleccionado anticipos", "Error", "Aceptar");					resVal=0;				} 			}			fun Cancelar(){				frn.exit();						}			//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>