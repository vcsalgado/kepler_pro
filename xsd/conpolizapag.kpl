<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="P&#243;lizas"><grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,20" bclr="192,205,213" unfont="0"	OnF1="Dialog(1,conpolizaayu)" tit="Polizas contables" clrBrdr="0,97,181"><br/><tab/><txt fnt=",22" clr="0,0,0">P&#243;liza Contable</txt>	<br/><tab/><hLine clr="0,0,0"/> 	<hLine clr="0,0,0"/>	<br/><br/><tab/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="40,12,7,12" tit="Datos Generales" fnt="Arial,16" unfont="0">				<sp/><cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>		<br/>				<sp/>		<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">A&#241;o</txt><sp/>		<inp id="anio" clr="64,64,64" clrBrdr="255,255,255"  dim="6,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nc="2" min="19" available="Y" modify="Y" just="R" fmt="5" max="26"/><tab/>		<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Mes</txt>		<sp/>		<inp id="mes" clr="64,64,64" clrBrdr="255,255,255"  dim="6,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nc="2" min="1" max="12" available="Y" modify="Y" tooltip="Mes de trabajo(Si desea trabajar en otro mes, cambiar la fecha)" fmt="5"/><tab/>		<sp/><br/><txt> Grupo docto</txt><tab/>		<cmb id="grpDoc" clr="64,64,64" clrBrdr="255,255,255"  dim="41,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="Grupo()" available="N"/>		<br/><sp/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Tipo</txt><tab/>		<cmb id="tipopoliza" clr="64,64,64" clrBrdr="255,255,255"  dim="27,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" available="Y" type="string" OnChange="Tipo(1)"  Null="N" modify="Y"/>		<inp id="k_tipo" clr="64,64,64"  dim="4,1" brdr="0,1" fnt="Arial,16" type="string" OnChange="Tipo()"  available="N" modify="N"/>		<br/>		<sp/><txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Referencia</txt><tab/>		<inp id="k_refer" clr="64,64,64" clrBrdr="255,255,255"  dim="12,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="10" modify="Y" available="Y"/>	</grp>	<sp/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="40,12,7,12" tit="Documento" fnt="Arial,16" unfont="0">		<tab/><inp id="operacion" clr="64,64,64"  dim="18,1" brdr="0,1" fnt=",16b" available="N" type="string" modify="N"/><br/><tab/>		<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">No. Poliza</txt><tab/>		<inp id="k_npoliza" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nc="7" OnEnter="Poliza()" type="number" modify="N" available="N" fmt="5" nd="0"/>		<br/>		<tab n="1"/><inp id="k_docto" clr="64,64,64"  dim="25,1" brdr="0,1" fnt="Arial,16" available="N" type="string"/>				<br/>		<tab n="1"/><txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Fecha</txt>		<tab n="1"/><edt id="k_fecha" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" OnButton="Dialog(0,_ks_fecha,k_fecha)" OnF9="Dialog(2,_ks_fecha,k_fecha)" modify="Y" available="Y"/>		<br/><tab/>		<inp id="statusDoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt="Arial,16b" available="N" type="string" visible="N" modify="N"/>		<br/>		<tab/>			<br/>	</grp>		<br/><br/><tab/>	<grp dim="81,25,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" fnt=",0"><tab/>		<tbl id="k_poliza" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" 				dim="110,15"  hk="z" Reorder="N" modify="Y" OnChange="CalcTotal()" available="Y" insdel="Y">			<col id="k_cuenta" name="Cuenta"  type="capital" OnF9="consulta_cuentas()" 				OnF10="Dialog(2,conCatCuePag,k_poliza,k_cuenta,10010)" OnChange="Cuenta()" OnActive="statusCta()" nc="20" np="145" visible="Y" modify="Y"/>			<col id="k_cuentadesc" name="Nombre Cuenta" type="string" nc="35" modify="N" visible="Y" available="N" np="145"/>				<col id="k_cuentasaldo" name="Cuenta Saldo"  type="number" nd="2" nc="15" np="120" modify="Y" visible="N" available="N"/>			<col id="k_cargo" name="Cargo"  type="number" nd="2" OnChange="Cargo()" nc="15" np="120" modify="Y" visible="Y"/>			<col id="k_abono" name="Abono"  type="number" nd="2" OnChange="Abono()" nc="15" np="120" modify="Y" visible="Y"/>			<col id="k_descr" name="Descripci&#243;n" modify="Y" visible="Y" nc="60" np="200"/>		</tbl>		<br/>				<grp dim="82,5,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" fnt=",0"><tab n="3"/>			<inp id="statusCta" clr="64,64,64"  dim="60,1" fnt="Arial,16" type="string" nd="2" modify="N" available="N" nc="-1"/>			<br/>			<tab/><txt fnt=",b">TOTALES</txt><tab/><txt fnt=",">Cargos:  </txt>			<inp id="totalCargos" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0b"/><tab n="2"/><txt fnt=",">Abonos: </txt>			<inp id="totalAbonos" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0b"/><br/>		</grp><sp/>		<grp dim="43,5,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" fnt=",0">			<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="reporte()" tooltip="Imprimir documento" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>			<tab n="3"/>			<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos " hk="C" available="Y" clrBrdr="0,0,0" visible="Y"/>			<sp/>			<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" available="Y" clrBrdr="0,0,0" tooltip="Aceptar documento" visible="Y"/>		</grp>			</grp>	</grp>	<tools/>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,frP,sys;			var cmdQuery, cuboQuery, ok, mensajeError;			var fecha_permitida; //Modo de funcionamiento: 0: Respeta "anio a trabjar" y "mes a trabajar" del servidor; 1: Solo toma en cuenta "anio a trabajar" 2: No impone ninguna restriccion en la fecha de la poliza         var gen_doc, nat_doc, gpo_doc, tip_doc, polizaFolio, sucursal_id, anio, mes, polizaTipo;			var tip_ope;//Tipo de operacion. "0" indica Alta; "1" indica consulta; "2" indica cancelacion; "3" indica baja; "4" Indica modificacion			var usuario, rol_usuario, suc_usuario, asterisco, anio_contable, fileSavePath; 			var editable; //Se controla si la poliza se puede editar, cancelar o dar de baja			/* PARaMETROS de la pagina indicados desde Tree, o desde frn.Dialog			param(0) = Genero			param(1) = Naturaleza			param(2) = Grupo			param(3) = Tipo			param(4) = Tipo Movto			param(5) = No. Poliza			*/						fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				fileSavePath = "C:\Basura";				if(frn.param(0)&= "")				{					frn.message("Esta accion no esta permitida.","Estimado Usuario","&Aceptar");//					frn.open("redirect",2);					return;				}					leeParam();				inicializa();				ConfiguraControlesOpcion();			}						fun leeParam(){				var param, nParam;										gen_doc=trim(frn.param(0));					nat_doc=trim(frn.param(1)); 					gpo_doc=trim(frn.param(2));					tip_doc=trim(frn.param(3)); 					tip_ope=trim(frn.param(4)); //Alta,Edita,Baja,Consulta,Elimina					sucursal_id=trim(frn.param(5));					anio=trim(frn.param(6));					mes=trim(frn.param(7));					polizaTipo=trim(frn.param(8));					polizaFolio=trim(frn.param(9));				nParam=frn.nParam();				/*				if( nParam == 6 || nParam == 10 ){ //Se han mandado parametros correctos a la pagina					param=param;					            } else {               frn.message("Operacion no valida. Error en parametros." & nParam, "Mensaje","&Aceptar");               frn.open("redirect",2);					return;            }*/									}						fun inicializa(){//Da valor a los combos y prepara la pagina dependiendo del tipo de Operacion a realizar				var descripcion;				frn.rst("tipopoliza");					frn.rst("grpDoc");							if(tip_ope &= "A"){	//Alta de poliza, el movimiento por efecto viene en parametros, normalmente N,A,21, el tipo puede ser 1,2 o 3					frn.setX("Diario","tipopoliza",0,0);						frn.setX("D","tipopoliza",0,1);					frn.setX(gen_doc,"tipopoliza",0,2);					frn.setX(nat_doc,"tipopoliza",0,3);					frn.setX(gpo_doc,"tipopoliza",0,4);					frn.setX("1","tipopoliza",0,5);					frn.setX("Egreso","tipopoliza",1,0);						frn.setX("E","tipopoliza",1,1);					frn.setX(gen_doc,"tipopoliza",1,2);					frn.setX(nat_doc,"tipopoliza",1,3);					frn.setX(gpo_doc,"tipopoliza",1,4);									frn.setX("2","tipopoliza",1,5);					frn.setX("Ingreso","tipopoliza",2,0);						frn.setX("I","tipopoliza",2,1);					frn.setX(gen_doc,"tipopoliza",2,2);					frn.setX(nat_doc,"tipopoliza",2,3);					frn.setX(gpo_doc,"tipopoliza",2,4);									frn.setX("3","tipopoliza",2,5);										frn.setX("Poliza Contable","grpDoc",0,0);										}else{//Modificacion de poliza de cualquier tipo, en parametros viene el tipo, se acompleta con la descripcion en kdmm									cmdQuery = "select c5 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3=" & gpo_doc & 							   " and c4=" & tip_doc;					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conpolizapag.Inicializa()");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}						descripcion = getXmlAtt(cuboQuery,"r0","c5");										//Mostrar tipo de documento					frn.setX(descripcion,"grpDoc",0,0);						//Mostrar	tipo	de poliza										if (polizaTipo&="D"){						frn.setX("Diario","tipopoliza",0,0);						frn.setX("D","tipopoliza",0,1);					}else if (polizaTipo&="I"){						frn.setX("Ingreso","tipopoliza",0,0);						frn.setX("I","tipopoliza",0,1);					}else{						frn.setX("Egreso","tipopoliza",0,0);						frn.setX("E","tipopoliza",0,1);					}					frn.setX(gen_doc,"tipopoliza",0,2);					frn.setX(nat_doc,"tipopoliza",0,3);					frn.setX(gpo_doc,"tipopoliza",0,4);					frn.setX(tip_doc,"tipopoliza",0,5);				}												kdb.date("SrvDate");	//Fecha del servidor				kdb.kde("KDE");//Configuracion del servidor				kdb.exec();				//Llenar combo sucursales				cmdQuery = "select '['||c1||'] '||c2 as c2, c1, c2 as c3 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";					}				}						rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conpolizapag.Inicializa()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",cuboQuery);				//setGrupos(); //Llena combo con posibles tipo de movimiento				frn.setPos("grpDoc",2,0,"internal:Y");				ArmarRefDocto(); //Arma cadena con el tipo de documento												// Revisa y Carga en Variables los Parametros Recibidos en la corrida				frn.setAtt("grpDoc","available","N");				if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");					Tipo(1);				} else if(tip_ope &= "M"){ //Edicion					frn.set("operacion","EDICION");					Consulta();				} else if(tip_ope &= "B"){ //Baja					frn.set("operacion","BAJA");					Consulta();					if(editable &!"S"){						frn.message("La poliza ya se dio de baja o esta cancelada.","Mensaje","&Aceptar");						tip_ope = "C"; //Se cambia modo a consulta					}							} else if(tip_ope &= "C"){ //Consulta					frn.set("operacion","CONSULTA");					Consulta();				} else if(tip_ope &= "E"){ //Elimiar					frn.set("operacion","ELIMINAR");					Consulta();				} else {					frn.message("Operacion no valida ...", "Mensaje","&Aceptar");					//frn.open("principal",4);					return;				}						}						fun ArmarRefDocto() {				var cadena,tmpFolio, tmpGrupo, tmpTipo;				tip_doc = frn.get("tipopoliza",-1,5);				tmpFolio = frn.lib("libGeneral.kpl","PadLeft",tmpFolio,"7","0");				tmpGrupo = frn.lib("libGeneral.kpl","PadLeft",gpo_doc,"2","0");				tmpTipo = frn.lib("libGeneral.kpl","PadLeft",tip_doc,"3","0");				cadena = trim(gen_doc) & trim(nat_doc) & trim(gpo_doc) & trim(tip_doc) & "-" & tmpFolio;				cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;				frn.set("k_docto", cadena);			}						fun BorraDatos(){ //Limpia todos los campos para generar un nuevo documento.				var dia,mes,anio;				frn.set("statusDoc","","k_descr","","k_refer","","statusCta","");				frn.rst("k_poliza");				anio=kdb.get("KDE",14);												//frn.set("anio",kdb.get("KDE",14));				dia=fnDate("day",kdb.get("SrvDate"));				mes=fnDate("month",kdb.get("SrvDate"));				anio=fnDate("year",kdb.get("SrvDate"));				anio=mid(anio,2,2);				frn.set("anio",anio);				frn.set("mes",mes);								frn.set("k_fecha",fnDate(anio,mes,dia));				CalcTotal();			}			/*						fun setGrupos(){//Especifica los grupos de polizas que se pueden generar en esta pagina.				addGpo("Poliza Contable",	1,0,0,0); //Grupo 0			}			fun addGpo(Descripcion, iCuenta, iConcepto, iDepto, iProy){				var renglon=frn.N("grpDoc");				frn.setX(trim(Descripcion),"grpDoc",renglon,0);			}*/			fun Grupo() {				BorraDatos();				ArmarRefDocto();			}						fun Tipo(bTomaCombo){ 				if(bTomaCombo)					frn.set("k_tipo",frn.get("tipopoliza",-1,1));//Traduce nombre descriptivo en Tipo de Poliza (I, E, D, etc)				else 					frn.setPos("tipopoliza",-1,1,"internal:Y","val:'"& frn.get("k_tipo") &"'");						BorraDatos();				ArmarRefDocto();			}			fun ConfiguraControlesOff() {				frn.setAtt("k_sucn","available","N");				frn.setAtt("k_sucn","modify","N");				frn.setAtt("anio", "available", "N");				frn.setAtt("mes", "available", "N");				frn.setAtt("grpDoc", "available", "N");				frn.setAtt("tipopoliza", "available", "N");				frn.setAtt("tipopoliza", "modify", "N");				frn.setAtt("k_npoliza", "available", "N");				frn.setAtt("k_npoliza", "modify", "N");								frn.setAtt("k_fecha", "available", "N");				frn.setAtt("k_fecha", "modify", "N");				frn.setAtt("k_refer", "available", "N");				frn.setAtt("k_refer", "modify", "N");								frn.setAtt("k_poliza", "modify", "N", "k_cuenta");				frn.setAtt("k_poliza", "modify", "N", "k_cargo");				frn.setAtt("k_poliza", "modify", "N", "k_abono");				frn.setAtt("k_poliza", "modify", "N", "k_descr");				frn.setAtt("k_poliza", "insdel", "N");							frn.setAtt("statusDoc","visible","N");				frn.setAtt("statusDoc","modify","N");								frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											}						fun ConfiguraControlesOpcion() {							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta					frn.setAtt("k_sucn","available","Y");					frn.setAtt("k_sucn","modify","Y");					frn.setAtt("anio", "available", "Y");					frn.setAtt("mes", "available", "Y");										frn.setAtt("tipopoliza", "available", "Y");					frn.setAtt("tipopoliza", "modify", "Y");					frn.setAtt("k_fecha", "available", "Y");					frn.setAtt("k_fecha", "modify", "Y");					frn.setAtt("k_refer", "available", "Y");					frn.setAtt("k_refer", "modify", "Y");																frn.setAtt("k_poliza", "modify", "Y", "k_cuenta");					frn.setAtt("k_poliza", "modify", "Y", "k_cargo");					frn.setAtt("k_poliza", "modify", "Y", "k_abono");					frn.setAtt("k_poliza", "modify", "Y", "k_descr");					frn.setAtt("k_poliza", "insdel", "Y");													frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");													} else {					frn.setAtt("statusDoc","visible","Y");					if(tip_ope &= "M"){ //Editar						frn.setAtt("k_fecha", "available", "Y");									frn.setAtt("k_poliza", "modify", "Y", "k_cuenta");						frn.setAtt("k_poliza", "modify", "Y", "k_cargo");						frn.setAtt("k_poliza", "modify", "Y", "k_abono");						frn.setAtt("k_poliza", "modify", "Y", "k_descr");										frn.setAtt("Cancelar", "visible", "Y");						frn.setAtt("Aceptar", "visible", "Y");												} else {						if(tip_ope &= "B"){ //BAja							frn.setAtt("Aceptar", "visible", "Y");						} else {							if(tip_ope &= "C"){ //Consulta								frn.setAtt("Imprimir", "visible", "Y");								frn.setAtt("Imprimir", "available", "Y");							} else {								if(tip_ope &= "E"){ //Eliminar									frn.setAtt("Aceptar", "visible", "Y");											}							}						}					}				}			}			fun Cuenta() {				var valTecleado, valValido,cmdQuery,cuboQuery,cuenta,aoo,mensajeError,ok,resultado,mensaje,adicionales,desc;				if(strlen(frn.get("k_poliza",-1,"k_cuenta"))==0){					frn.setX("","k_poliza",-1,"ctaDescr");					frn.setX("","k_poliza",-1,"saldo");					return;				}				aoo=fnDate("year",frn.get("k_fecha"));				aoo = mid(aoo,2,2);				cuenta=frn.get("k_poliza",-1,"k_cuenta");								//Valida que la cuenta exista y sea de ultimo nivel				cmdQuery="SELECT * FROM keplersc.verify_cuenta_ult_nivel('" & cuenta & "','" & aoo & "')";																	kdb.rst(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"Cuenta()");								ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									resultado= getXml(cuboQuery,"resultado");				mensaje= getXml(cuboQuery,"mensaje");					adicionales = getXml(cuboQuery,"adicionales");				if(resultado &! "1"){					frn.setX("","k_poliza",-1,"k_cuenta");					frn.setX("","k_poliza",-1,"k_cuentadesc");					frn.message(mensaje, "Error","&Aceptar");					return;				}								cmdQuery="select c1 as cuenta, c2 as k_descr from keplersc.kdc1" & aoo & " where c1='" & cuenta & "' ";				kdb.rst(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"Cuenta()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, "C:\Basura\xmlCuenta");												desc=getXmlAtt(cuboQuery,"r0","k_descr");								frn.setX(desc,"k_poliza",-1,"k_cuentadesc");								/*				kdb.sp("k_cuenta","dat",frn.get("k_poliza",-1,"k_cuenta"),aoo);				kdb.exec();				frn.lib("libGeneral.kpl","FileSave",kdb.get("dat"), "C:\Basura\datCuenta");				valTecleado=frn.get("k_poliza",-1,"k_cuenta");				valValido=kdb.get("dat","k_cuenta");				if(valTecleado &! valValido){					frn.setX("","k_poliza",-1,"k_cuenta");					frn.setX("","k_poliza",-1,"k_cuentadesc");					if(valValido &! ""){						frn.message("La cuenta " & valTecleado & " no es de ultimo nivel.", "Mensaje","&Aceptar");						return;					}else{						frn.message("La cuenta " & valTecleado & " no existe.", "Mensaje","&Aceptar");						return;					}				}				frn.setX(kdb.get("dat","k_descr"),"k_poliza",-1,"k_cuentadesc");				frn.setX(kdb.get("dat","k_saldo"),"k_poliza",-1,"k_cuentasaldo");				*/				statusCta();			}			fun statusCta(){				var ctaDecr;				if(tip_ope &! "A"){					return;				}				ctaDecr=frn.get("k_poliza",-1,"k_cuentadesc");				if(strlen(trim(ctaDecr))>0)frn.set("statusCta",ctaDecr & "  Saldo: " & strFormat("nfmt",frn.get("k_poliza",-1,"k_cuentasaldo"),2));				else frn.set("statusCta","");			}						fun Cargo() {				if(frn.getJ("k_poliza")>0){ //Trae informacion del renglon anterior(descripcion, depto, proyecto), si el renglon actual no tiene especificado algo					var renAnterior=frn.getJ("k_poliza")-1;					if(strlen(frn.get("k_poliza",-1,"k_descr"))==0)frn.setX(frn.get("k_poliza",renAnterior,"k_descr"),"k_poliza",-1,"k_descr");				}				frn.setX("","k_poliza",-1,"k_abono");				CalcTotal();			}						fun Abono() {				if(frn.getJ("k_poliza")>0){ //Trae informacion del renglon anterior(descripcion, depto, proyecto), si el renglon actual no tiene especificado algo					var renAnterior=frn.getJ("k_poliza")-1;					if(strlen(frn.get("k_poliza",-1,"k_descr"))==0)frn.setX(frn.get("k_poliza",renAnterior,"k_descr"),"k_poliza",-1,"k_descr");				}				frn.setX("","k_poliza",-1,"k_cargo");				CalcTotal();			}			fun CalcTotal() { 				var C=0,A=0; 				for (var i=0,n=frn.N("k_poliza")-1;i<n;i++) { 					C=C+frn.get("k_poliza",i,"k_cargo");					A=A+frn.get("k_poliza",i,"k_abono");				}				//frn.setX("TOTALES","k_poliza","k_totales","k_cuenta");				//frn.setX(C,"k_poliza","k_totales","k_cargo");				//frn.setX(A,"k_poliza","k_totales","k_abono");				frn.set("totalCargos",C,"totalAbonos",A);			}						//------Inicio. Funcion RevCol -- Revisa las columnas 			fun RevCol(param1){				var nreg,abono,cargo,valCol,banCol;//definicion de variables				nreg = frn.N("k_poliza")-1;//cuantos renglones hay				banCol = 0;				for(var i=0; i<nreg; i++){					abono = frn.get("k_poliza",i,"k_cargo");					cargo = frn.get("k_poliza",i,"k_abono");					if((cargo+abono) > 0){						valCol = frn.get("k_poliza",i,param1);//valor de la columna (proyecto, concepto, departamento)						if(strlen(valCol) == 0){							banCol = 1;//se prende la bandera de que falta definir  proyecto, concepto o departamento en una partida 						}//fin if valor de la columna esta vacia					}//fin if la suma de cargo y abono es > a 0				}//fin for p/recorrer las partidas en el grid				return banCol;			}			//------Fin. Funcion RevCol						fun Ejecuta(){				if(tip_ope &= "A" ){					Alta();				}else if(tip_ope &="C"){					Consulta();				}else if(tip_ope &="E"){					Cancela();				}else if(tip_ope &="B"){					Baja();				}else if(tip_ope &="M"){					Modifica();				}			}						fun Consulta(){				var cmd,xmlRequest,xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr;				setXml(xmlRequest,"document","sucursal_id",sucursal_id);				setXml(xmlRequest,"document","anio",anio);				setXml(xmlRequest,"document","mes",mes);				setXml(xmlRequest,"document","tipo_poliza",polizaTipo);				setXml(xmlRequest,"document","poliza_inicial",polizaFolio);				setXml(xmlRequest,"document","poliza_final",polizaFolio);				setXml(xmlRequest,"document","movimiento","usuario",frn.lib("libKepler","UserInfo"));							cmdQuery="select * from keplersc.cont_rep_poliza('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\cmdPolizaConsulta");				cuboQuery=frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conpolizapag.Consulta()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									cuboQuery= getXmlAtt(cuboQuery,"r0","cont_rep_poliza");				cuboQuery= delScpScn(cuboQuery);								setXmlStr(xmlPoliza,cuboQuery);frn.lib("libGeneral.kpl","FileSave",xmlPoliza,"C:\Basura\xmlPoliza");				//Asignar valores a UI				tmpStr =  getXml(xmlPoliza,"document","r0","sucursal_id");				tmpStr = "[" & tmpStr & "] ";				tmpStr = tmpStr & getXml(xmlPoliza,"document","r0","suc_desc");				frn.setPos("k_sucn","val:'" & tmpStr & "'");								frn.set("anio",anio);				frn.set("mes",mes);				tmpStr = getXml(xmlPoliza,"document","r0","tipo_poliza");				frn.set("k_tipo",tmpStr);				tmpStr=getXml(xmlPoliza,"document","r0","poliza");				tmpStr= frn.lib("libGeneral","PadLeft",tmpStr,7,"0");				frn.set("k_npoliza",tmpStr);				tmpStr=getXml(xmlPoliza,"document","r0","doc");				frn.set("k_docto",tmpStr);				tmpStr=getXml(xmlPoliza,"document","r0","fecha_pol");				frn.set("k_fecha",tmpStr);								editable="S";				tmpStr=getXml(xmlPoliza,"document","r0","status_movto");				if(tmpStr &= ""){					frn.set("statusDoc","Poliza Activa");				}				if(tmpStr &= "C"){					editable="N";					frn.set("statusDoc","Poliza Baja/Cancelada");				}								//Partidas				rstXml(xmlPartidas);				xmlPartidas=getXml(xmlPoliza,"document","r0","polizas");								totRen = nXml(xmlPartidas);								for(contRen=0; contRen<totRen; contRen++){					tmpStr=getXml(xmlPartidas,"r"&contRen,"cuenta");					frn.setX(getXml(xmlPartidas,"r"&contRen,"cuenta"),"k_poliza",contRen,"k_cuenta");					frn.setX(getXml(xmlPartidas,"r"&contRen,"desc_cuenta"),"k_poliza",contRen,"k_cuentadesc");					tmpStr=getXml(xmlPartidas,"r"&contRen,"cargo_abono");					if(tmpStr &= "C"){						frn.setX(getXml(xmlPartidas,"r"&contRen,"monto"),"k_poliza",contRen,"k_cargo");					}else{						frn.setX(getXml(xmlPartidas,"r"&contRen,"monto"),"k_poliza",contRen,"k_abono");					}					tmpStr=getXml(xmlPartidas,"r"&contRen,"descripcion");					frn.setX(tmpStr,"k_poliza",contRen,"k_descr");					frn.setX(getXml(xmlPartidas,"r"&contRen,"refer"),"k_refer");				}													CalcTotal();				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\xmlPantallaPoliza");			}						fun Alta() {				var xmlPantalla;				var resultado, mensaje, folio;				var fecha,hora,strFecha,strTmp;				 if(frn.N("k_poliza")-1==0){					frn.message("No es posible dar de alta una Poliza sin datos. Favor de verificar", "Error","&Aceptar");					return;				}			 				if (frn.get("totalCargos")!=frn.get("totalAbonos")) {					frn.message("Poliza descuadrada. Favor de verificar", "Error","&Aceptar");					return;				}				if(RevCol("k_cuenta") == 1){						frn.message("Se ha generado el siguiente error: " & "No se especifico cuenta en la poliza" ,"Error","&Aceptar");						frn.setPos("k_poliza",-1,"k_descr");return;				}				if(RevCol("k_descr") == 1){						frn.message("Se ha generado el siguiente error: " & "No se especifico descripcion en la poliza" ,"Error","&Aceptar");						frn.setPos("k_poliza",-1,"k_descr");return;				}								if (frn.message("Registrar Poliza?", "Alta de poliza","&Si","&No")!=1)					return;									//Guardar poliza				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				fecha = sys.date();				hora= sys.time();				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;				var tipopoliza;				tipopoliza=frn.get("tipopoliza",-1,5);				setXml(xmlPantalla,"k_tipon","r0","ALTA DE POLIZA");				setXml(xmlPantalla,"k_tipon","r1",gen_doc);				setXml(xmlPantalla,"k_tipon","r2",nat_doc);				setXml(xmlPantalla,"k_tipon","r3",gpo_doc);				setXml(xmlPantalla,"k_tipon","r4",tipopoliza);//frn.setX("1","tipopoliza",0,5);								setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0") & ":" &					frn.lib("libGeneral.kpl","PadLeft",sys.time("seg",hora) ,2,"0"));				setXml(xmlPantalla,"k_poliza","no_partidas",frn.N("k_poliza")/*-1*//*commented 220726*/);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);									frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\xmlPantallaPoliza");				cmdQuery="SELECT * FROM keplersc.cont_poliza_alta('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";																	kdb.rst(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"Alta.Alta");								ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									resultado= getXml(cuboQuery,"resultado");				mensaje= getXml(cuboQuery,"mensaje");					var adicionales = getXml(cuboQuery,"adicionales");				if(resultado &= "1"){					mensaje = "Poliza registrada. " & mensaje;					frn.message(mensaje & "-" & adicionales, "Mensaje","&Aceptar");					//Cambiar a modo de Consulta					frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "N");					frn.setAtt("Aceptar", "visible", "N");															frn.set("k_npoliza",folio);					//tip_ope="C";					polizaFolio=folio;					//inicializa();					//ConfiguraControlesOpcion();									}else{					frn.message(mensaje, "Error","&Aceptar");				}			}						fun Baja() {				var xmlPantalla,mensajeCon;				var resultado, mensaje, folio;				var fecha,hora,strFecha,strTmp;				if(strlen(trim(frn.get("k_npoliza")))==0){ 					frn.message("Es necesario especificar la poliza a dar de baja","Error","&Aceptar");					frn.setPos("k_npoliza");return;				}				if(editable &= "N"){					mensajeCon = "La Poliza tiene movimientos de baja. |";				}				mensajeCon = mensajeCon & "Confirma dar de baja la poliza " & frn.get("k_tipo") & " " & frn.get("k_npoliza");				if (frn.message(mensajeCon,"Mensaje","&Si","&No")!=1){					return;				}				rstXml(xmlPantalla);				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				fecha = sys.date();				hora= sys.time();				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_poliza","no_partidas",frn.N("k_poliza"));				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);//frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\xmlPantallaPoliza");										cmdQuery="SELECT * FROM keplersc.cont_poliza_baja('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";																	kdb.rst(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"conpolizapag.Baja");								ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									resultado= getXml(cuboQuery,"resultado");				mensaje= getXml(cuboQuery,"mensaje");									if(resultado &= "1"){					mensaje = "La poliza se dio de baja.";					frn.message(mensaje, "Mensaje","&Aceptar");					//Cambiar a modo de Consulta					frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "N");					frn.setAtt("Aceptar", "visible", "N");															//tip_ope="C";					//inicializa();					//ConfiguraControlesOpcion();									}else{					frn.message(mensaje, "Error","&Aceptar");				}			}			fun Modifica(){//Modifica la poliza actual				var xmlPantalla,mensajeCon;				var resultado, mensaje, folio;				var fecha,hora,strFecha,strTmp;							if(strlen(trim(frn.get("k_npoliza")))==0){ 					frn.message("Es necesario especificar la poliza a modificar","Error","&Aceptar");					frn.setPos("k_npoliza");return;				}				if (frn.get("totalCargos")==0 || frn.get("totalAbonos")==0 ) {					frn.message("La suma de cargos y/o abonos no puede ser cero. Favor de verificar", "Error","&Aceptar");					return;				}											if (frn.get("totalCargos")!=frn.get("totalAbonos")) {					frn.message("Poliza descuadrada. Favor de verificar", "Error","&Aceptar");					return;				}								var nr=frn.N("k_poliza")-1;  //Revisa el numero de registros en el Grid				if(nr==0){					frn.message("No es posible dar de alta una Poliza sin datos. Favor de verificar", "Error","&Aceptar");					frn.setPos("k_npoliza");					return; 				}            if(RevCol("k_descr") == 1){						frn.message("Se ha generado el siguiente error: " & "No se especifico descripcion en la poliza" ,"Error","&Aceptar");						frn.setPos("k_poliza",-1,"k_descr");						return;				}				if (frn.message("Desea continuar?", "Modificacion de poliza","&Si","&No")!=1)				{					return;				}									rstXml(xmlPantalla);				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				fecha = sys.date();				hora= sys.time();				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_poliza","no_partidas",frn.N("k_poliza"));				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\xmlPantallaPolizaModificar");										cmdQuery="SELECT * FROM keplersc.cont_poliza_modificacion('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";																	kdb.rst(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"conpolizapag.Baja");								ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									resultado= getXml(cuboQuery,"resultado");				mensaje= getXml(cuboQuery,"mensaje");									if(resultado &= "1"){					mensaje = "La poliza fue actualizada.";					frn.message(mensaje, "Mensaje","&Aceptar");					//Cambiar a modo de Consulta					tip_ope="C";					inicializa();					ConfiguraControlesOpcion();									}else{					frn.message(mensaje, "Error","&Aceptar");				}							}				fun Cancela() { //Cancela la poliza especificado. (No borra el folio, pues deja huella del documento en KDC2)				if(strlen(trim(frn.get("k_npoliza")))==0){ 					frn.message("Es necesario especificar la poliza a cancelar","Error","&Aceptar");					frn.setPos("k_npoliza");return;				}				if (frn.message("Esta a punto de cancelar la poliza " & frn.get("k_tipo") & frn.get("k_npoliza") & " Desea Continuar?","PRECAUCION","&Si","&No")!=1)						return;				kdb.sp("k_poliza","baja","dat",frn.get("k_fecha"),frn.get("k_tipo"),frn.get("k_npoliza"),1);				kdb.exec();				if (kdb.get("dat")){					frn.message("Se cancelo la poliza " & kdb.get("dat","doc"),"Poliza Cancelada","&Aceptar");					BorraDatos(); frn.setPos("k_npoliza");				} else {					if (kdb.get("dat","err")==1)						frn.message("Poliza no encontrada, no se cancelo","Error","&Aceptar");					else						frn.message("No se cancelo la poliza","Error","&Aceptar");				}			}						fun reporte(){//			frn.message(anio & "-" & mes & "-" & polizaTipo & "-" & polizaFolio,"Mensaje","&Aceptar");				frn.dialog("repcontpoliza",sucursal_id,frn.get("anio"),frn.get("mes"),frn.get("k_tipo"),frn.get("k_npoliza"),frn.get("k_npoliza"),"0");				//frn.dialog("repcontpoliza",sucursal_id,anio,mes,polizaTipo,polizaFolio,polizaFolio,"0");			}						fun consulta_cuentas(){				anio=frn.get("anio");				cmdQuery = "select c1 as cuenta, c2 as descripcion from keplersc.kdc1" & anio &" order by c1 ";				frn.dialog("genlistafiltrosel","Cuentas",cmdQuery,"cuenta","k_poliza",-1,"k_cuenta","N","N","N");				}			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validacion. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validacion. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para paginas de operacion:Solo si se esta en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolvera el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}				}				/*		Autor					Fecha			Cambio		------------------------------------------------------------------		VSALGADO			17-08-2022	Creacion del programa		*/	</script></pag>