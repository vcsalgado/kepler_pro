<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,9" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><tab/><txt clr="0,0,0" fnt=",22">Bonificacion Con CxP</txt>		<br/><tab/>		<hLine clr="0,0,0"/> 		<br/> <br/><tab/>		<grp dim="50,12,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">			<sp n="2"/>			<txt>Sucursal :</txt>			<sp n="2"/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="54,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" tooltip="Sucursal" available="Y" modify="Y"/>			<br/> <!-- <br/> -->			<sp n="2"/>			<txt>Tipo :</txt>			<sp n="6"/>			<cmb id="k_tipon" dim="54,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo()" tooltip="Tipo de Movimiento"/>						<br/>			<sp n="2"/> <txt id="textProvPago" clr="6,31,255" hk="P" visible="Y">Proveedor de Pago :</txt>			<sp n="1"/>			<edt id="k_clave_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 				OnButton="Get_Cat(1)" OnF9="Get_Cat(1)" OnChange="BuscarProvPago()" 				type="capital" nc="7" tooltip="Proveedor de Pago" modify="Y" hk="C" available="Y" visible="Y"/> 			<br/>			<sp n="13"/>			<!-- clr="64,64,64" -->			<inp id="k_nombreprov_pago" clr="6,31,255" clrBrdr="255,255,255"  dim="54,1" fnt="Arial,16" type="capital" modify="N" available="N" nc="50" visible="Y"/>						</grp>				<sp/>			<grp dim="37,12,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="2"/>			<inp id="operacion" dim="48,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C"/><tab/> <br/>			<sp n="2"/>			<txt id="textFolio" visible="N">Folio :  </txt>			<edt id="k_folio" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" tooltip="Folio ( F9 b&#250;squeda )" modify="Y" available="N" visible="N" 			OnF9="ObtenerFolio()" OnButton="ObtenerFolio()" OnChange="Formar_folio()"/><tab n="2"/>			<img id="BuscarFol" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="BuscarFolio()" visible="N"/> <br/>			<sp n="2"/>			<inp id="k_docto" dim="48,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="C"/> <br/>			<sp n="2"/>			<txt>Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N" tooltip="Fecha"/> 			<sp n="1"/> 			<txt>  Hora : </txt> 			<sp n="1"/> 			<edt id="k_hora" dim="15,1" type="time" nc="-1" bclr="240,240,240" modify="Y" fmt="HH:MM:SS" available="Y"/> 			<br/>				<sp n="2"/> <inp id="statusDoc" clr="64,64,64"  dim="48,1" brdr="0,1" fnt=",16b" available="N" just="C"/> <br/>					</grp>		<br/>		<br/><tab/> 		<grp dim="88,21,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Proveedor">						<sp n="1"/> <txt clr="0,58,112" fnt=",b">Selecciona UUID : </txt>			<sp n="3"/>			<inp id="k_refer" clr="64,64,64" clrBrdr="255,255,255"  dim="80,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "N" modify="Y" 				tooltip="Factura del Proveedor"/>					<sp n="5"/>			<bot id="Buscar" dim="10" brdr="5" OnEnter="ProcesarFactura()" tooltip="Busca UUID de la factura del proveedor" available="Y" visible="Y"/>				<br/>			<grp dim="52,16,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<sp n="1"/> <txt clr="0,58,112">Proveedor : </txt><tab/>				<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnButton="Dialog(3,cxpcatprobus,k_clave)" OnF9="Dialog(3,cxpcatprobus,k_clave)" OnChange="BuscarProveedor()" 					type="capital" nc="7" tooltip="Proveedor ( F9 b&#250;squeda )" modify="Y" hk="P" available="N"/> 				<!-- <inp id="k_clave" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="20,1" fnt="Arial,16" type="string" nc="16" modify="Y" available="N"/> -->				<br/>				<sp n="1"/> <txt clr="0,58,112">RFC : </txt><sp n="5"/>				<inp id="k_rfc" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="20,1" fnt="Arial,16" type="string" nc="16" modify="Y" available="N"/>				<br/>				<sp n="1"/> <txt clr="0,58,112" fnt=",b">Datos UUID : </txt><sp n="5"/>				<br/>				<sp n="1"/> <txt clr="0,58,112">Serie : </txt><sp n="1"/>				<inp id="k_uuid_serie" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="20,1" fnt="Arial,16" type="string" nc="18" modify="N" available="N"/>				<br/>				<sp n="1"/> <txt clr="0,58,112">Folio : </txt><sp n="1"/>				<inp id="k_uuid_folio" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="30,1" fnt="Arial,16" type="string" nc="18" modify="N" available="N"/>				<br/>								<sp n="1"/> <txt clr="0,58,112">Total : </txt> <sp n="1"/> 				<inp id="k_uuid_monto" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="17,1" fnt="Arial,16" type="string" nc="18" modify="N" available="N"/>								<sp n="1"/> <txt clr="0,58,112">Impuesto : </txt> <!-- <sp n="1"/> -->				<inp id="k_uuid_impuesto" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="15,1" fnt="Arial,16" type="string" nc="18" modify="N" available="N"/>								<br/>								<sp n="1"/> <txt clr="0,58,112">Ret. IVA : </txt> <!-- <sp n="1"/> -->				<inp id="k_uuid_retiva" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="15,1" fnt="Arial,15" type="string" nc="18" modify="N" available="N"/>				<sp n="2"/> <txt clr="0,58,112">Ret. ISR : </txt> <!-- <sp n="1"/> -->				<inp id="k_uuid_retisr" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="15,1" fnt="Arial,15" type="string" nc="18" modify="N" available="N"/>								<br/>								<!-- dim="20,1" -->				<sp n="1"/> <txt clr="0,58,112">Fecha : </txt> <!-- <sp n="1"/> -->				<inp id="k_uuid_fecha" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="17,1" fnt="Arial,16" type="string" nc="12" modify="N" available="N"/>										</grp>			<grp dim="71,11,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="1,5" fnt="Arial,16">							<sp n="1"/> <txt fnt=",b">Datos del proveedor : </txt>				<br/>								<sp n="1"/>				<inp id="k_nombreprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="69,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_calleprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="69,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_coloniaprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="69,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_poblacionprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="54,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="50" visible="Y"/>				<sp n="1"/>				<inp id="k_cpprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="14,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="10" visible="Y"/>								<br/>				<sp n="1"/> <txt clr="0,58,112">Plazo :</txt><sp n="1"/>				<inp id="k_plazo" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nd="0" min="0" OnChange="Plazo()" modify="Y" available="N" visible="Y"/>				<sp n="1"/> 				<inp id="k_cond" clr="64,64,64" clrBrdr="255,255,255"  dim="28,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="33" modify="N" available="N" visible="Y"/>				<sp n="2"/> <txt clr="0,58,112">Vencimiento :</txt><sp n="1"/>				<edt id="k_vence" clr="64,64,64"  dim="13,1" brdr="2,0" bclr="255,255,255" type="date" nc="-1" fnt="Arial,0" available="N" fmt="DD/MM/CCYY" page="_ks_fecha,k_vence" OnF9="Dialog(3,_ks_fecha,k_vence)" clrBrdr="255,255,255" visible="Y"/><tab/>			</grp>				</grp>				<br/><br/><tab/>		<grp dim="88,29,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" fnt=",0" tit="Documentos Relacionados">			<sp n="1"/>			<tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" 				dim="122,7"  hk="z" Reorder="N" modify="Y" insdel="Y">				<col id="k_factura" name="Factura"  type="capital" OnF9="" OnChange="" visible="Y" modify="N" available="Y"/>				<col id="c_saldo" name="Saldo" type="number" OnF9="" visible="Y" modify="N" available="Y" nc="15" nd="2" np="70"/>				<col id="k_monto_factura" name="Monto"  type="number" OnChange="monto()" nd="2" nc="15"  modify="N" np="70"/>				<col id="k_iva_factura" name="IVA"  type="number" nd="2"  nc="15" OnChange=""  modify="N" visible="Y" np="60"/>				<col id="k_vencimiento_factura" name="Vence"  type="string" nc="12" OnF9="" visible="Y" modify="N" available="N" np="70"/>				<col id="k_folio_movto" name="Folio"  modify="N" visible="Y" available="N"/>				<col id="c_serie" name="Serie UUID" type="string" OnF9="" visible="Y" modify="N" available="Y"/>				<col id="c_folio" name="Folio UUID" type="string" OnF9="" visible="Y" modify="N" available="Y" np="70"/>				<col id="k_prov" name="Prov Oper"  type="string" OnF9="" visible="Y" modify="N" available="N" np="40"/>			</tbl>			<br/>			<sp n="1"/>			<grp dim="70,20,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,16" hSpace="4" fnt=",0">				<sp/><txt fnt=",">Referencia:  </txt>				<inp id="k_refer" dim="56,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="capital" just="L" nc="40" fnt=",0" clr="64,64,64" available="y"/>				<br/><br/>				<sp/><txt fnt=",">Notas:  </txt>				<inp id="k_coment" dim="60,4" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="capital"  fnt=",0" clr="64,64,64" modify="Y" available="Y"/>				<br/>				<tbl id="k_tmp" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" 				dim="122,7"  hk="z" Reorder="N" modify="Y" insdel="Y" visible="N">								<col id="tmp_factura" name="Factura"  type="capital" visible="Y" modify="N" available="Y"/>					<col id="tmp_saldo" name="Saldo" type="number" OnF9="" visible="Y" modify="N" available="Y" nc="15" nd="2" np="70"/>					<col id="tmp_monto_factura" name="Monto"  type="number" nd="2" nc="15" modify="Y" np="70"/>					<col id="tmp_iva_factura" name="IVA"  type="number" nd="2"  nc="15" modify="N" visible="Y" np="60"/>					<col id="tmp_vence" name="Vence"  type="string" nc="12" OnF9="" visible="Y" modify="N" available="N" np="70"/>					<col id="tmp_folio_movto" name="rfc"  modify="N" visible="N" available="N"/>					<col id="tmp_serie" name="Serie" type="string" OnF9="" visible="Y" modify="N" available="Y"/>					<col id="tmp_folio" name="Folio" type="string" OnF9="" visible="Y" modify="N" available="Y" np="70"/>					<col id="tmp_prov" name="Prov Oper"  type="string" visible="Y" modify="N" available="N" np="40"/>			</tbl>			</grp>			<tab n="1"/>			<grp dim="48,20,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,16" hSpace="4" fnt=",0" clr="64,64,64">				<sp/><tab n="3"/><txt fnt=",">Subtotal UUID:  </txt>	<tab n="4"/>				<inp id="k_subtotal" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0" clr="64,64,64"/>				<br/>				<sp/><tab n="3"/><txt fnt=",">IVA a Acreditar UUID:  </txt>	<sp/>	<tab n="1"/>				<inp id="k_iva" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0" clr="64,64,64"/>				<br/>				<sp/><tab n="3"/><txt fnt=",">Monto UUID:   </txt><tab n="4"/>				<inp id="k_monto" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0b" clr="64,64,64"/><br/>				<br/>				<sp/><tab n="3"/><txt fnt=",">Total Doctos. Relacionados: </txt>				<inp id="k_total_doctos" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0" clr="64,64,64"/>				<br/>				<sp/><tab n="3"/><txt fnt=",">Saldo Doctos. Relacionados:</txt>				<inp id="k_total_saldo" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0" clr="64,64,64"/>								<br/><br/>				<sp n="1"/><tab n="5"/>				<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Ejecuta_Reporte" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>							<sp n="5"/>				<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>							<sp n="5"/>				<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>					</grp>				</grp>											</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Variables de control			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, tiporden,desc_tipo, numorden, punto, descripcion, costo, resVal, porc_iva, tabla, estatus_doc;			var fileSavePath,asterisco;						//Variables validacion factura			var str_uuid, fecha_uuid, rfc_uuid, subtotal_uuid, total_uuid;			var nombre_uuid, regimen_uuid, folio_uuid, serie_uuid, NewProvId;			var paramProvPago, proveedor_pago_id;			var impuesto_uuid;			var retisr_uuid, retiva_uuid;			var tipRel_uuid, totRel_uuid, folioRel_uuid;						//Variables de parametros			var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd,uen;			//Porcentajes kdmm			var prc_iva ;			//cont			var presupuesto , saldo, fecha_baja, cargos_factura, abonos_factura, cargos_iva_factura, abonos_iva_factura,subt_facturas, total_iva_facturas, total_facturas;											fun Main() {			frn=new FRNT;			kdb=new KDB;			rep=new REP;			frP=new FRNTP;			sys=new SYS;			kdb.connect();			kdb.kde("KDE");			kdb.exec();			anio_contable = kdb.get("KDE","14");			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			suc_usuario = frn.lib("libKepler","UserInfo(1)");			asterisco="*";			fileSavePath = "C:\Basura";			Inicializa();							ConfiguraControlesOpcion();		}					fun Inicializa(){ //Inicializa los valores en Pantalla					paramProvPago = 0; 					// Revisa parametros recibidos			if( frn.nParam() == 6 ){ //Se han mandado parámetros a la página                gen_doc=trim(frn.param(0));                 nat_doc=trim(frn.param(1));                 gpo_doc=trim(frn.param(2));                tip_doc=trim(frn.param(3));                 tip_ope=trim(frn.param(4));                uen=trim(frn.param(5));				if (uen &= ""){					uen="XXX";				}			} else {				frn.message("Operación no válida ...", "Mensaje","&Aceptar");				frn.open("redirect",2);				return;			}            			if(tip_ope &= "A"){ //Alta				frn.set("operacion","ALTA");			} else {				if(tip_ope &= "B"){ //Baja					frn.set("operacion","BAJA");				} else {					if(tip_ope &= "C"){ //Consulta						frn.set("operacion","CONSULTA");					} else {						frn.message("Operación no válida ...", "Mensaje","&Aceptar");							}				}			}							// Fill Combo Sucursal (Con Query de PostgreSQL)			cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}			}			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_sucn",cuboQuery);				sucursal_id = frn.get("k_sucn",-1,1);										paramProvPago = ProvPago_Sec(usuario);											// Fill Combo Tipo (Con Query FTO Kepler) 			cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.Inicializa()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboTipo");				ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error BD","Aceptar");				return;			}			frn.set("k_tipon",getXml(cuboQuery));						frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());								// Fill k_docto | referencia docto			ArmarRefDocto();			LimpiaDatosProv();			IniParams();		}					// Armado del Docto Referencia		fun ArmarRefDocto {			var cadena,tmpFolio, tmpGrupo, tmpTipo;			tmpFolio = frn.get("k_folio");			tmpFolio = PadLeft(tmpFolio,"7","0");			tmpGrupo = PadLeft(gpo_doc,"2","0");			tmpTipo = PadLeft(frn.get("k_tipon",-1,4),"3","0");			cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;			frn.set("k_docto", cadena);		}				fun PadLeft(pText,pRelleno,pCaracterRelleno) {			var Resultado;			var pos_ini = pText;			var nReg = strlen(pText);			for (var cont = nReg; cont < pRelleno; cont++) {				Resultado = pCaracterRelleno & Resultado;			}			Resultado = Resultado & pText;                			return Resultado;		}							fun CambiaTipo() {			LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());			porcentajes_kdmm();				ArmarRefDocto();						}					fun porcentajes_kdmm (){						var cmd, cuboResultados ,ok,mensajeError;								cmd= " select c15,c16,c33,c75 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "'" ;							cmd = cmd & " and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4='" & frn.get("k_tipon",-1,4) & "'";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvbonifcxpcrud.porcentajes_kdmm()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				prc_iva = getXmlAtt(cuboResultados , "r0","c16");					}					fun CambiaSucursal() {			sucursal_id = frn.get("k_sucn",-1,1);			paramProvPago = ProvPago_Sec(usuario);			LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();						limpiar_datos_uuid();		}				fun LimpiaEncabezado() {			frn.set("k_folio", "");			frn.set("k_docto", "");			frn.set("statusDoc","");			frn.set("k_fecha", "");			frn.set("k_hora", "");			LimpiaDatosProv();			frn.set("k_clave", "");			frn.set("k_clave_pago", "");			frn.set("k_nombreprov_pago", "");		}					fun borrar_datos(){			frn.rst("k_mov");			frn.rst("k_refer");			frn.rst("k_coment");			frn.set("k_subtotal", 0);			frn.set("k_iva", 0);			frn.set("k_monto", 0);			frn.set("k_total_doctos", 0);			frn.set("k_total_saldo", 0);		}				fun BuscarFolio() {			var folio;			folio = frn.get("k_folio");			resVal = 1;			ArmarRefDocto();						var stDoc = ValidaFolioCancelado(folio);			frn.set( "statusDoc", stDoc );			MostrarDatos(folio);		}				fun Cancela() {			CambiaSucursal();			borrar_datos();			Inicializa();			ConfiguraControlesOpcion();		}				fun ObtenerFolio() {			sucursal_id = frn.get("k_sucn",-1,1);			LimpiaEncabezado();			limpiar_datos_uuid();			cmdQuery = "select c6 as folio, substring(cast(c9 as VARCHAR),1,10) as fecha, c10 as cve_cliente, " &						"c11 as factura, c16 as monto, c43 as estatus " &						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & frn.get("k_tipon",-1,4) &						" order by c9 desc, c6 desc";							frn.dialog("genlistafiltrosel","Folios de Bonificaciones CxP",cmdQuery,"folio","k_folio","0","","S");					}				fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    			1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 			2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 			3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			// var tip_ope; 			var tip_oper;			if(iModo==0)				page=pag; 			else if(iModo==2&&(strlen(par0)>0)){				//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       				if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 				if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;			}			else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     		}								fun BuscarProveedor(){			var xmlProd;						var NewProv, ST_FUN, continua, resultado, mensaje, xmlAlta;			var vProvPago;							sucursal_id = frn.get("k_sucn",-1,1);			proveedor_id = frn.get("k_rfc");						LimpiaDatosProv();			frn.set("k_rfc", proveedor_id);						if (strlen(frn.get("k_rfc"/*"k_clave"*/)) == 0) {				return;			}							cmdQuery = "select c2 as k_clave, c3 as k_nombreprov, c4 as k_calleprov, c5 as k_coloniaprov, c6 as k_poblacionprov, c27 as k_cpprov, c16 as k_plazo " &									"from keplersc.kdxd where keplersc.full_replace(c10,'-','') ='" & proveedor_id & "'" ;						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.BuscaProveedor()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.set("k_clave","No Existe ...");  							if (strlen(NewProvId) > 0 ) { 									frn.message("El proveedor no existe","Error","Aceptar");					return;									} else {									frn.message("El Proveedor No existe ..." & "|" & " " & 					"|" & " " & "Nombre : " & nombre_uuid &					"|" & " " & "R.F.C. : " & rfc_uuid & 					"|" & " " & "Fecha Docto. Seleccionado : " & fecha_uuid & 					"|" & " " & "Total Docto. Seleccionado : " & total_uuid & 					"|" & " " & "|" & " " & 					"Puede crearse Automaticamente, se recomienda complementar los Datos.", "Info !!!","Aceptar");					continua = frn.message("¿Continuar con el Alta del Proveedor?","Atencion !!!",2);					if (continua == 0){										return;										}	else {										setXml(xmlAlta,"sucursal",sucursal_id);						setXml(xmlAlta,"nombre",nombre_uuid);						setXml(xmlAlta,"rfc",rfc_uuid);											frn.lib("libGeneral.kpl","FileSave",xmlAlta,fileSavePath & "\XmlAltaProv_To_Send");											cmdQuery="SELECT * FROM keplersc.uuid_tools_alta_proveedor('<document>" & getXmlStr(xmlAlta,"EOF:13_10") & "</document>')";						rstXml(cuboQuery);											cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvbonifcxpcrud.Alta_Proveedor");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlAltaProv_Result");											resultado = getXml(cuboQuery,"resultado");						mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok) {							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;							}						if(resultado &= "1") {							NewProv = mensaje;							//frn.dialog("cat_crud_proveedores","Modificar"/*accion*/, NewProv/*param1*/,"UUID" /*param2*/);							//prov_data_upd(NewProv);							return NewProv/*1*/;						} else {							frn.set("k_clave","");							frn.message(mensaje,"Error","Aceptar");							return;						}										} // End ... If ( continua )								} // End ... If (  )							}						rstXml(xmlProd);			frn.lib("libGeneral.kpl","FileSave",cuboQuery/*xmlAlta*/,fileSavePath & "\XmlAltaProv_To_Get");			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");			frn.setX(xmlProd);						vProvPago = trim(frn.get("k_clave_pago"));			if ( strlen(trim(frn.get("k_clave"))) > 0 ) {				if ( strlen( vProvPago ) == 0 ) {					frn.set("k_clave_pago", frn.get("k_clave"));					BuscarProvPago();				} else {					if ( CheckProvPago() == 0 ) {						frn.set("k_clave_pago", frn.get("k_clave"));						BuscarProvPago();						}				}			}						Plazo();		}					fun LimpiaDatosProv() {			frn.set("k_rfc", "");			frn.set("k_nombreprov", "");			frn.set("k_calleprov", "");			frn.set("k_coloniaprov", "");			frn.set("k_poblacionprov", "");			frn.set("k_cpprov", "");			LimpiaDatosDoc();			LimpiaTotalesDoc();					}		//-----------------------------------FACTURA------------------------	fun SeleccionarCxP() {		//En k_factura OnF9 para seleccionar facturas					proveedor_id = frn.get("k_clave");			if (strlen(proveedor_id ) == 0){				frn.message("Debes Seleccionar el Proveedor ...","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				frn.setX("", "k_mov", -1, "k_folio_movto");				borrar_datos_factura();				return;			}			sucursal_id = frn.get("k_sucn",-1,1);						cmdQuery = "select " & 				"m.c5 origen, w.c9 fecha, w.c6 folio, w.c16 total_doc, abs(( coalesce(g.c6,0) - coalesce(g.c7,0)) ) saldo " &				", g.c4 uuid_o_ref, to_date(g.c12::text,'yyyy-mm-dd') vencimiento, g.c3 prov_operacion " &  				"from keplersc.kduxg g " &  				"inner join keplersc.kduxe e on g.c1 = e.c1 and g.c2 = e.c5 and g.c3 = e.c2 and g.c4 = e.c3 and e.c11 = g.c11 " & 				"inner join keplersc.kdmm m on m.col_sucursal = e.c1 and m.c1 = e.c5 and m.c2 = e.c6 and m.c3 = e.c7 and m.c4 = e.c8 " & 				"inner join keplersc.kdm1 w on w.c1 = e.c1 and w.c2 = e.c5 and w.c3 = e.c6 and w.c4 = e.c7 and w.c5 = e.c8 and w.c6 = e.c9 ";								cmdQuery = cmdQuery & "" & 				"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and g.c3 = '" & proveedor_id & "' " &  				"and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10 and g.c10=0 and w.c16 > 0 ";					      // Condicion si solo muestra las C x P vencidas   			//cmdQuery = cmdQuery & " and g.c12 <= current_date /*to check if this condition will be used*/ "; 						cmdQuery = cmdQuery & " order by g.c12 ";									frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQuerySeleccionarCxP");							frn.dialog("genlistafiltrosel","CxP  del  Proveedor: " & proveedor_id,cmdQuery,"uuid_o_ref","k_mov",-1,"k_factura","S","S");								}			fun ObtenerFactura(){					var nCampos, uuid="";			var NewProv;						limpiar_datos_uuid();						uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID_Relacionados","k_refer", 0,"0");						nCampos = strSplit(uuid,"|",-1);			if (nCampos > 1) {					str_uuid = strSplit(uuid,"|",0);		  //UUID					rfc_uuid = strSplit(uuid,"|",1);		  //rfc					fecha_uuid = strSplit(uuid,"|",2);	  //fecha					total_uuid = strSplit(uuid,"|",3);	  //monto de la factura										nombre_uuid = strSplit(uuid,"|",5);	  //nombre					regimen_uuid = strSplit(uuid,"|",6);  //regimen					folio_uuid = strSplit(uuid,"|",7);	  //folio					serie_uuid = strSplit(uuid,"|",8);	  //serie										impuesto_uuid = strSplit(uuid,"|",9); //impuesto										retisr_uuid = strSplit(uuid,"|",10); //retencion isr					retiva_uuid = strSplit(uuid,"|",11); //retencion iva					subtotal_uuid = strSplit(uuid,"|",12);	  //monto de la factura										tipRel_uuid = strSplit(uuid,"|",13); //tipo relacion cfdi					totRel_uuid = strSplit(uuid,"|",14); //no. folios relacionados															if ( strlen(nombre_uuid) == 0 || strlen(rfc_uuid) == 0 || strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {						frn.message("No se pudieron obtener todos los datos mandatorios del UUID.","Error","Aceptar");										} else {											frn.set("k_refer",str_uuid);						frn.set("k_rfc",rfc_uuid);										if ( BuscarUUIDAjuste(str_uuid) > 0 ) {														frn.set("k_clave","");							frn.message("Este Documento [UUID] ya ha sido utilizado para ajuste de bonificacion previamente ...","Error","Aceptar");							return;						}						if ( BuscarUUID(str_uuid) > 0 ) {														frn.set("k_clave","");							frn.message("Este Documento [UUID] ya ha sido bonificado previamente ...","Error","Aceptar");							return;						} 													frn.set("k_uuid_fecha",mid(fecha_uuid,0,10));						if ( Validar_Fecha_UUID() == 0 ) { 														frn.set("k_clave","");							return;						}												NewProv = "";						NewProv = BuscarProveedor();						if (strlen(NewProv) > 0/*== 1*/) {							//BuscarProveedor(NewProv);							NewProvId = NewProv;							frn.set("k_clave",NewProvId);						} else {							NewProvId = "";						}												if ( strlen(frn.get("k_clave")) > 0 && frn.get("k_clave") &! strFormat("ucase","No Existe ...") ) {																		frn.set("k_uuid_serie",serie_uuid);							frn.set("k_uuid_folio",folio_uuid);							frn.set("k_uuid_monto",total_uuid);							frn.set("k_uuid_fecha",mid(fecha_uuid,0,10));													frn.set("k_uuid_impuesto",impuesto_uuid);							frn.set("k_uuid_retisr",retisr_uuid);							frn.set("k_uuid_retiva",retiva_uuid);															var sumrets = retisr_uuid + retiva_uuid;							frn.set("k_sumrets",sumrets);							frn.set("k_subtotal",subtotal_uuid);							frn.set("k_iva",impuesto_uuid);							frn.set("k_monto",total_uuid);							}														 					}					if (totRel_uuid > 0){						var res, datos_encabezado = 14;		//No. de datos que se envian antes de los folios relacionados						for (var i=0; i<totRel_uuid; i++) {							folioRel_uuid = strSplit(uuid,"|",datos_encabezado+i+1);							frn.setX(folioRel_uuid ,"k_mov", i, "k_factura");							res = factura_cargos_abonos(frn.get("k_mov", i, "k_factura"));							if (res ==1){								frn.setX("--", "k_mov", i, "c_serie");								frn.setX("--", "k_mov", i, "c_folio");								frn.setX("--Factura no registrada--", "k_mov", i, "k_folio_movto");								frn.setX("--", "k_mov", i, "k_vencimiento_factura");								frn.setX("--", "k_mov", i, "k_prov");							}						}						if (res==1){							frn.message("Hay facturas que no se encontraron registradas ...","Error","Aceptar");						}						CalcTotal();						}						} else{				frn.message("Faltan datos del UUID ...","Error","Aceptar");					}		}	// End Fun - Obtener Factura							fun monto(){					proveedor_id = frn.get("k_clave");			if (strlen(proveedor_id ) == 0){				frn.message("Debes Seleccionar un Proveedor antes","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				borrar_datos_factura();				return;			}						var monto_factura = frn.get("k_mov", -1, "k_monto_factura");			var saldo_temporal = (monto_factura  + cargos_factura) - abonos_factura ;						if (saldo_temporal > 0){				frn.message("No puede bonificar superior al saldo de una factura","Error","Aceptar");				borrar_datos_factura(1);				var monto = abonos_factura - cargos_factura;				frn.setX(monto ,"k_mov", -1, "k_monto_factura");				iva(monto);				return;			}else{				frn.message("No puede bonificar menos del saldo de una factura","Error","Aceptar");		//Debe bonificarse el total				borrar_datos_factura(1);				var monto = abonos_factura - cargos_factura;				frn.setX(monto ,"k_mov", -1, "k_monto_factura");				iva(monto);				return;			}						iva(monto_factura);				}				fun borrar_datos_factura(imodo){					var irow = frn.getJ("k_mov"); 						frn.setX("", "k_mov", -1, "k_monto_factura");			frn.setX("", "k_mov", -1, "k_iva_factura");						frn.setX("", "k_mov", -1, "k_folio_movto");			if ( imodo != 1 ) { 				frn.setX("", "k_mov", -1, "k_factura");				frn.setX("", "k_mov", -1, "c_serie");				frn.setX("", "k_mov", -1, "c_folio");				frn.setX("", "k_mov", -1, "c_saldo");				frn.setX("", "k_mov", -1, "k_vencimiento_factura");				frn.setX("", "k_mov", -1, "k_prov");			}					}				fun ObtenerCxP(){			//En el OnChange="ObtenerCxP()" de k_factura para obtener 			var factura, res; 			factura = frn.get("k_mov", -1, "k_factura");			var nreg = frn.N("k_mov")-1;			if (nreg != 1){				for(var i=0; i<nreg - 1; i++){					if ( frn.get("k_mov",i,"k_factura") &= factura){						frn.message("Ya seleccionaste esta factura.","Error","Aceptar");						borrar_datos_factura();						return;					}				}						}				res = factura_cargos_abonos(factura);		}				fun factura_cargos_abonos(factura) {					var fechvenc, fechoper;			proveedor_id = frn.get("k_clave");			cmdQuery = "select m.c5 origen " &				", w.uuid_serie, w.uuid_folio, w.uuid_fecha, w.uuid_total " &				", abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) saldo " &  				", g.c4 uuid, to_date(g.c12::text,'yyy-mm-dd') vencimiento " & 				", g.c6 as cargos, g.c7 as abonos, g.c8 as cargos_iva, g.c9 as abonos_iva " & 				", e.c9 folio_movto, g.c3 prov_operacion " & 				"from keplersc.kduxg g " &  				"inner join keplersc.kduxe e on g.c1 = e.c1 and g.c2 = e.c5 and g.c3 = e.c2 and g.c4 = e.c3 " & 				"inner join keplersc.kdmm m on m.col_sucursal = e.c1 and m.c1 = e.c5 and m.c2 = e.c6 and m.c3 = e.c7 and m.c4 = e.c8 " & 				"inner join keplersc.kdm1 w on w.c1 = e.c1 and w.c2 = e.c5 and w.c3 = e.c6 and w.c4 = e.c7 and w.c5 = e.c8 and w.c6 = e.c9 ";							cmdQuery = cmdQuery & "" & 				"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and g.c3 = '" & proveedor_id & "' ";  				"and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10 and g.c10=0 and w.c16 > 0";						cmdQuery = cmdQuery & " and g.c4 = '" & factura & "' ";						frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryObtenerCxP");								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.factura_cargos_abonos()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery ,fileSavePath & "\cuboQuerybonifcxp");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			var totReg=nXml(cuboQuery);			if(totReg==0){//				frn.message("La Factura No esta Registrada ...","Error","Aceptar");				return 1;			}						cargos_factura = getXmlAtt(cuboQuery, "r0", "cargos" );			abonos_factura = getXmlAtt(cuboQuery, "r0", "abonos" );			cargos_iva_factura = getXmlAtt(cuboQuery, "r0", "cargos_iva" );			abonos_iva_factura = getXmlAtt(cuboQuery, "r0", "abonos_iva" );					frn.setX(getXmlAtt(cuboQuery, "r0", "uuid_serie" ) , "k_mov", -1, "c_serie");			frn.setX(getXmlAtt(cuboQuery, "r0", "uuid_folio" ) , "k_mov", -1, "c_folio");			frn.setX(getXmlAtt(cuboQuery, "r0", "saldo" ) , "k_mov", -1, "c_saldo");						frn.setX(getXmlAtt(cuboQuery, "r0", "vencimiento" ) , "k_mov", -1, "k_vencimiento_factura");			frn.setX(getXmlAtt(cuboQuery, "r0", "folio_movto" ) , "k_mov", -1, "k_folio_movto");			frn.setX(getXmlAtt(cuboQuery, "r0", "prov_operacion" ) , "k_mov", -1, "k_prov");						fechvenc = mid(frn.get("k_mov", -1, "k_vencimiento_factura"),0,10);						if ( strlen(fechvenc) == 0 ) {				frn.message("No se pudo obtener la Fecha de Vencimiento de la C x P ...","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				borrar_datos_factura();				return 2;			}						frn.setX(frn.get("k_mov",-1,"c_saldo"),"k_mov", -1,"k_monto_factura");			frn.setX(abonos_iva_factura-cargos_iva_factura,"k_mov", -1,"k_iva_factura");			frn.setX(fechvenc, "k_mov", -1, "k_vencimiento_factura");			fechvenc = formato_fecha(fechvenc);						fechoper = frn.get("k_fecha");			if ( strlen(fechoper) == 0 ) { fechoper = sys.date(); };			fechoper = formato_fecha(fechoper);					} // End : factura_cargos_abonos 					fun formato_fecha(fech) {			var strFech, tmpData;						strFech = fnDate("year", fech) & "/";			tmpData = fnDate("month", fech);			if(strlen(tmpData) == 1){				tmpData = "0" & tmpData;			}			strFech = strFech & tmpData & "/";			tmpData = fnDate("day", fech);			if(strlen(tmpData) == 1){				tmpData = "0" & tmpData;			}			strFech = strFech & tmpData;						return strFech;			} // end fun - formato_fecha				fun iva(monto){					//TODO,ver como se calcula realmente			//var iva = monto * (1-(1/(1+prc_iva/100)));						var iva = (monto * abonos_iva_factura)/abonos_factura;			frn.setX(iva ,"k_mov", -1, "k_iva_factura");		}				fun CalcTotal() { 						var monto_facturas =0, saldo_facturas=0; 								for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {						monto_facturas=monto_facturas +frn.get("k_mov",i,"k_monto_factura");						saldo_facturas=saldo_facturas+frn.get("k_mov",i,"c_saldo");				}								frn.set("k_total_doctos", monto_facturas, "k_total_saldo" ,saldo_facturas);		}		fun ConfiguraControlesOff() {							frn.setAtt("textFolio", "visible", "N");			frn.setAtt("k_folio", "available", "N");			frn.setAtt("k_folio", "visible", "N");							frn.setAtt("k_fecha", "available", "N");			frn.setAtt("k_hora", "available", "N");			frn.setAtt("k_clave", "available", "N");			frn.setAtt("k_refer", "available", "N");						frn.setAtt("k_plazo", "visible", "Y");			frn.setAtt("k_vence", "visible", "Y");			frn.setAtt("k_cond", "visible", "Y");			frn.setAtt("k_plazo", "available", "N");			frn.setAtt("k_vence", "available", "N");			frn.setAtt("k_cond", "available", "N");							frn.setAtt("Imprimir", "visible", "N");			frn.setAtt("Cancelar", "visible", "N");			frn.setAtt("Aceptar", "visible", "N");			frn.setAtt("BuscarFol", "visible", "N");			frn.setAtt("Buscar", "available", "N");							frn.setAtt("Buscar", "visible", "N");			frn.setAtt("Buscar", "available", "N");						frn.setAtt("textProvPago", "visible", "Y");			frn.setAtt("k_clave_pago", "visible", "Y");			frn.setAtt("k_nombreprov_pago", "visible", "Y");			frn.setAtt("k_clave_pago", "available", "N");			frn.setAtt("k_nombreprov_pago", "available", "N");		}		fun ConfiguraControlesOpcion() {						ConfiguraControlesOff();			if(tip_ope &= "A"){ //Alta				frn.setAtt("k_fecha", "available", "N"); 				frn.setAtt("k_hora", "available", "Y"); 				frn.setAtt("k_clave", "available", "N"); 				frn.setAtt("k_refer", "available", "N");				frn.setAtt("k_mov", "modify", "Y");				frn.setAtt("k_mov", "available", "Y", "k_factura");				frn.setAtt("k_coment","modify", "Y");				frn.setAtt("k_coment","available", "Y");				frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "Y"/*"N"*/);				frn.setAtt("Aceptar", "visible", "Y");									frn.setAtt("BuscarFol", "visible", "N");				frn.setAtt("Buscar", "available", "Y");									frn.setAtt("Buscar", "visible", "Y");				frn.setAtt("Buscar", "available", "Y");				if ( paramProvPago > 0 ) {									frn.setAtt("k_clave_pago", "available", "Y");				} else {					frn.setAtt("k_clave_pago", "available", "N");				}							} else {				if(tip_ope &= "B"){ //Baja									frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");					frn.setAtt("k_fecha", "available", "Y");					frn.setAtt("k_hora", "available", "Y");															frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "N");					frn.setAtt("Aceptar", "visible", "Y");												frn.setAtt("BuscarFol", "visible", "Y");					frn.setAtt("Buscar", "available", "N");										frn.setAtt("k_clave_pago", "available", "N");									} else {					if(tip_ope &= "C"){ //Consulta						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("k_fecha", "available", "N");						frn.setAtt("k_hora", "available", "N");											frn.setAtt("Imprimir", "visible", "Y");						frn.setAtt("Cancelar", "visible", "N");						frn.setAtt("Aceptar", "visible", "N");						frn.setAtt("BuscarFol", "visible", "Y");						frn.setAtt("Buscar", "available", "N");												frn.setAtt("k_clave_pago", "available", "N"); 											} else {						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");						frn.setAtt("k_fecha", "available", "Y");						frn.setAtt("k_hora", "available", "Y");													frn.setAtt("k_clave_pago", "available", "N"); 					}					}			}		}						fun Ejecuta() {		var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua, valTmp;			var resultado, mensaje, folio;							fecha = sys.date();			hora= sys.time();							if (tip_ope &= "A") {											//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}				continua = frn.message("Desea continuar con la bonificacion?","Atencion",2);				if (continua == 0){					return;				}								xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;											setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov") -1);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				//PARAMETRO NECESARIO PARA FUNCION cxcp_alta_conmov()				setXml(xmlPantalla,"k_tabla_mov","kdm5");								//Datos de uuid				setXml(xmlPantalla,"uuid","serie",serie_uuid);				setXml(xmlPantalla,"uuid","folio",folio_uuid);				setXml(xmlPantalla,"uuid","total",total_uuid);				setXml(xmlPantalla,"uuid","fechatimbrado",fecha_uuid);				setXml(xmlPantalla,"uuid","impuesto",impuesto_uuid);				setXml(xmlPantalla,"uuid","retisr",retisr_uuid);				setXml(xmlPantalla,"uuid","retiva",retiva_uuid);				setXml(xmlPantalla,"k_miepsret",frn.get("k_uuid_retisr"));				setXml(xmlPantalla,"k_mivaret",frn.get("k_uuid_retiva"));									frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudbonifcxp");				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cuboQuery);				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvbonifcxpcrud.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoBonifCxp");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					tip_ope = "C";					frn.set("k_folio", mensaje); 					frn.set("operacion", "CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto", strTmp);					strMsg = "El Folio utilizado para esta operacion fue : " & mensaje;					ConfiguraControlesOpcion(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");					BuscarFolio();				} else {					frn.message(mensaje, "Error", "Aceptar");					frn.set("datcfdi","N");	//Pantalla validacion CFDI				}			}						} // FIN ... Ejecuta()										fun ValidarDatos() {			var totReg, strTotal=0,subTotal=0, iva=0, total=0, renglones, str,vdiferencia;			var gapMonto, gapDias; 						//Obtener variables			sucursal_id = frn.get("k_sucn",-1,1);			proveedor_id = frn.get("k_clave");			refer_id = frn.get("k_refer");						proveedor_pago_id = trim(frn.get("k_clave_pago"));						if (refer_id &= ""){				frn.setPos("k_refer");				resVal=0;				frn.message("Es necesario seleccionar la Factura del Proveedor ...","Error","Aceptar");				return;			}						if ( strlen(nombre_uuid) == 0 || strlen(rfc_uuid) == 0 || strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {				frn.message("No se cuenta con todos los datos mandatorios del UUID.","Error","Aceptar");				resVal=0;				return;			}			if ( Validar_Fecha_UUID() == 0 ) {					resVal = 0;				return;			}						if ( strlen(frn.get("k_clave")) == 0 || frn.get("k_clave") &= strFormat("ucase","No Existe ...") ) {				if ( strlen(frn.get("k_clave")) == 0 ) {					frn.message("No hay Proveedor Asociado a la Operacion ...","Error","Aceptar");				} else {					frn.message("El Proveedor No Existe ...","Error","Aceptar");				}				resVal=0;				return;			}						cmdQuery="SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_id & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("El Proveedor No Existe ...","Error","Aceptar");				resVal=0;				return;			}			if ( strlen(frn.get("k_clave_pago")) == 0 || frn.get("k_nombreprov_pago") &= strFormat("ucase","No Existe ...") ) {				if ( strlen(frn.get("k_clave_pago")) == 0 ) {					frn.message("No hay Proveedor de Pago Asociado a la Operacion ...","Error","Aceptar");				} else {					frn.message("El Proveedor de Pago No Existe ...","Error","Aceptar");				}				resVal=0;				return;			}			cmdQuery = "SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_pago_id & "'";			cmdQuery = cmdQuery & " and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')"; 			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("El Proveedor de Pago No Existe.","Error","Aceptar");				resVal=0;				return;			}						//Depurar k_mov solo con facturas con monto para afectar cxp			frn.rst("k_tmp");			var j=0;			for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {				if (frn.get("k_mov", i, "k_monto_factura") != 0){					frn.setX(frn.get("k_mov", i, "c_serie") ,"k_tmp", j, "tmp_serie");					frn.setX(frn.get("k_mov", i, "c_folio") ,"k_tmp", j, "tmp_folio");					frn.setX(frn.get("k_mov", i, "c_saldo") ,"k_tmp", j, "tmp_saldo");					frn.setX(frn.get("k_mov", i, "k_vencimiento_factura") ,"k_tmp", j, "tmp_vence");					frn.setX(frn.get("k_mov", i, "k_factura") ,"k_tmp", j, "tmp_factura");					frn.setX(frn.get("k_mov", i, "k_monto_factura") ,"k_tmp", j, "tmp_monto_factura");					frn.setX(frn.get("k_mov", i, "k_iva_factura") ,"k_tmp", j, "tmp_iva_factura");					frn.setX(frn.get("k_mov", i, "k_folio_movto") ,"k_tmp", j, "tmp_folio_movto");					frn.setX(frn.get("k_mov", i, "k_prov") ,"k_tmp", j, "tmp_prov");					j=j+1;				}			}			frn.rst("k_mov");			for (var i=0,n=frn.N("k_tmp")-1;i<n;i++) {				frn.setX(frn.get("k_tmp", i, "tmp_serie") ,"k_mov", i, "c_serie");				frn.setX(frn.get("k_tmp", i, "tmp_folio") ,"k_mov", i, "c_folio");				frn.setX(frn.get("k_tmp", i, "tmp_saldo") ,"k_mov", i, "c_saldo");				frn.setX(frn.get("k_tmp", i, "tmp_vence") ,"k_mov", i, "k_vencimiento_factura");				frn.setX(frn.get("k_tmp", i, "tmp_factura") ,"k_mov", i, "k_factura");				frn.setX(frn.get("k_tmp", i, "tmp_monto_factura") ,"k_mov", i, "k_monto_factura");				frn.setX(frn.get("k_tmp", i, "tmp_iva_factura") ,"k_mov", i, "k_iva_factura");				frn.setX(frn.get("k_tmp", i, "tmp_folio_movto") ,"k_mov", i, "k_folio_movto");				frn.setX(frn.get("k_tmp", i, "tmp_prov") ,"k_mov", i, "k_prov");							}					if (frn.get("k_rfc") &! rfc_uuid) {				resVal=0;				frn.message("El RFC no corresponde al de la factura.","Error","Aceptar");				return;			}									} // End ValidarDatos()		fun MostrarDatos(nFolio) {			var folio, refer, xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle;			var tmpStr, tmpXml, contDet, xmlCurDet, xmlDetConv;			// Guarda Datos para Busqueda 			frn.set("k_fecha_exp", "");			sucursal_id = frn.get("k_sucn",-1,1);							folio = nFolio;		cmdQuery= "select dm1.C9 as k_fecha, dm1.c69 as k_hora, dm1.C10 as k_clave, dm1.C11 as k_refer,dm1.C16-dm1.c14 as k_subtotal,dm1.c14 as k_iva, 			dm1.C16 as k_monto,round((dm1.c14/(dm1.c16 - dm1.c14  + (dm1.c15 + dm1.c23) ))*100,2) as k_porciva,			xd.c10 as k_rfc, xd.c3 as k_nombreprov, xd.c4 as k_calleprov, xd.c5 as k_coloniaprov, xd.c6 as k_poblacionprov, xd.c27 as k_cpprov,			concat(regexp_replace(dm1.c24,'\r|\n',' ', 'g'),' ',dm1.c25,' ',dm1.c26) as k_coment,			dm1.c17 as k_plazo, dm1.c18 as k_vence,			dm1.uuid_serie as k_uuid_serie, dm1.uuid_folio as k_uuid_folio, dm1.uuid_fecha as k_uuid_fecha, dm1.uuid_total as k_uuid_monto,			dm1.uuid_impuesto as k_uuid_impuesto, dm1.cve_prov_pago as k_clave_pago,			dm1.uuid_retisr as k_uuid_retisr, dm1.uuid_retiva as k_uuid_retiva,			c43 as estatus_doc , c197 as fecha_baja  			from keplersc.kdm1 dm1 inner join keplersc.kdxd xd on xd.c2 = dm1.c10 			where dm1.c1 = '" & sucursal_id & "' and dm1.c2 = '" & gen_doc & "' and dm1.c3 = '" & nat_doc & "' and dm1.c4 =" & gpo_doc & " and dm1.c5 =" & frn.get("k_tipon",-1,4) & " and dm1.c6 = '" & folio &"'";  					frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryMostrarDatosEnc");								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.MostrarDatos()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery ,fileSavePath & "\cuboQuerybonifcxp");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			var totReg=nXml(cuboQuery);			if(totReg==0){				frn.message("El folio no esta registrado ...","Error","Aceptar");				borrar_datos_factura();				return;			}else{				rstXml(xmlEncabezado);				xmlEncabezado=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");				frn.setX(xmlEncabezado);							}					var vProvPago = trim(frn.get("k_clave_pago"));			if ( strlen(trim(frn.get("k_clave"))) > 0 ) {				if ( strlen( vProvPago ) > 0 ) { BuscarProvPago(); }			}							//Datos Detalle			cmdQuery= "select m.c14 as k_factura, abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) saldo, m.c12 as k_monto_factura, m.c13 as k_iva_factura,				m.c15 as k_venciemiento_factura, e.c9 folio_movto, w.uuid_serie, w.uuid_folio, g.c3 prov_operacion,				w.uuid_fecha, w.uuid_total				from keplersc.kdm5 m 				inner join keplersc.kduxg g on g.c1=m.c1 and g.c2 = m.c2 and g.c3 ='" & frn.get("k_clave") & "' and g.c4=m.c14				inner join keplersc.kduxe e on e.c1=g.c1 and e.c2=g.c3 and e.c3=m.c14 and e.c4=m.c11::integer and e.c5= m.c2 and e.c6 = m.c3 and e.c7=m.c4 and e.c8=m.c5 and e.c9=m.c6				inner join keplersc.kdm1 w on w.c1 = e.c1 and w.c2 = e.c5 and w.c3 = e.c6 and w.c4 = e.c7 and w.c5 = e.c8 and w.c6 = e.c9				where m.c1='" & sucursal_id & "' and m.c2='" & gen_doc & "' and m.c3='" & nat_doc & "' and m.c4=" & gpo_doc & " and m.c5= " & frn.get("k_tipon",-1,4) & " and m.c6='" & folio & "'";							frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryMostrarDatosDet");								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.MostrarDatos()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery ,fileSavePath & "\cuboQuerybonifcxpDet");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}						frn.setX(cuboQuery,"k_mov");			CalcTotal();										} //End MostrarDatos()							fun ModoBuscar() {			LimpiaEncabezado();			ConfiguraControlesOpcion();		}						fun LimpiaDatosDoc() {			frn.set("k_mov", "");			frn.set("k_plazo", "");			frn.set("k_vence", "");			frn.set("k_cond", "");			frn.set("k_coment", "");		}					fun LimpiaTotalesDoc() {			frn.set("k_subtotal", "");			frn.set("k_iva", "");			frn.set("k_porciva", ""); 			frn.set("k_monto", "");			frn.set("k_total_doctos", "");			frn.set("k_total_saldo", "");			frn.set("k_sumrets",""); 		}						fun prov_data_upd(Prov){			frn.dialog("cat_crud_proveedores","Modificar"/*accion*/, Prov/*IdProv*/,"UUID" /*param2 UUIDCtrl*/,"BuscarProveedor()"/*paramRutina*/);		}								fun limpiar_datos_uuid() {			frn.set("k_clave","");			frn.set("k_rfc","");			frn.set("k_refer","");						frn.set("k_uuid_serie","");			frn.set("k_uuid_folio","");			frn.set("k_uuid_monto","");			frn.set("k_uuid_fecha","");						NewProvId = "";			LimpiaDatosProv();						frn.set("k_uuid_impuesto","");						frn.set("k_uuid_retisr","");				frn.set("k_uuid_retiva","");						str_uuid = "";				rfc_uuid = "";				fecha_uuid = ""; 			total_uuid = "";								nombre_uuid = "";			regimen_uuid = "";			folio_uuid = "";			serie_uuid = "";			impuesto_uuid = "";						retisr_uuid = "";			retiva_uuid = "";						if ( paramProvPago  > 0 ) {				if ( tip_ope &= "A" ) {						frn.setAtt("k_clave_pago", "available", "Y");				} else {					frn.setAtt("k_clave_pago", "available", "N");				}				if ( CheckProvPago() == 0 ) {					frn.set("k_clave_pago","");					frn.set("k_nombreprov_pago","");				}			} else {				frn.setAtt("k_clave_pago", "available", "N");				frn.set("k_clave_pago","");				frn.set("k_nombreprov_pago","");			}		}								fun BuscarUUID(referencia){			var xmlProd, respfunc;											sucursal_id = frn.get("k_sucn",-1,1);			respfunc = 1;														if (strlen(str_uuid) == 0) {				frn.message("No se tiene una Referencia [UUID] para validarse ...","Error","Aceptar");				return;			}						cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &				"and c2 = '" & gen_doc & "' and c3 = '" & nat_doc & "' and c4 = " & gpo_doc & " and c11 = '" & referencia & "' and c43 <> 'C'";	 						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.BuscaFactura()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}						respfunc = nXml(cuboQuery);						return respfunc;									} // End Fun - BuscarUUID				fun BuscarUUIDAjuste(referencia){			var xmlProd, respfunc;											sucursal_id = frn.get("k_sucn",-1,1);			respfunc = 1;														if (strlen(str_uuid) == 0) {				frn.message("No se tiene una Referencia [UUID] para validarse ...","Error","Aceptar");				return;			}						cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &				"and c2 = '" & gen_doc & "' and c3 = '" & nat_doc & "' and c4 = 42 and c11 = '" & referencia & "' and c43 <> 'C'";	 						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.BuscaFactura()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}						respfunc = nXml(cuboQuery);						return respfunc;									} // End Fun - BuscarUUIDAjuste				fun Validar_Fecha_UUID() {			var fech_hoy, fech_ini, fech_limit, strFecha, strTmp, fech_lim_ini, fech_lim_fin, fech_buff;			var aj_dias, respfunc, gapDias,superUsuario,mensajeAdv,mensajeProceso;					respfunc = 0;			//VCSS 03/07/2024 Obtener usuario con nivel para poder hacer operaciones sin validaciones			cmdQuery="SELECT count(*) as superusuario from keplersc.param_opc_usr_sec where sucursal = '" & sucursal_id & "' and opcion = 'Operaciones Sin Validacion GAP' and usuario='" & usuario & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.ValidarDatos()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlSuperUsuario");								ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return respfunc;			}			superUsuario = getXmlAtt(cuboQuery,"r0","superusuario");			// { GAP Dias Fecha Gastos }			cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Dias Fecha Gastos'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.ValidarDatos()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPDias");								ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return respfunc;			}			if (nXml(cuboQuery) > 0) {				gapDias = getXmlAtt(cuboQuery,"r0","paramvalor");			} else {				frn.message("Hubo problemas para obtener los Parametros [GAP Dias Fecha Gastos] ...","Error","Aceptar");				return respfunc;			}							fech_hoy = sys.date();				strFecha = fnDate("year", fech_hoy) & "/" /*"-"*/;			strTmp = fnDate("month", fech_hoy);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "/" /*"-"*/ & "01";								fech_ini = strFecha;								//fech_hoy = "2024/12/05";  // For testing calc fech 			strTmp = fnDate("month", fech_hoy);			if ( strTmp == 12 ) {				strFecha = fnDate("year", fech_hoy) & "/12/31";								fech_limit = strFecha;							} else {				strFecha = fnDate("year", fech_hoy) & "/";				strTmp = fnDate("month", fech_hoy) + 1;				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "/" & "01";								fech_limit = fnDate("add",strFecha,-1);							} 						fech_limit = formato_fecha(fech_limit);									if ( gapDias > 0 ) { 				aj_dias = (gapDias /*+ 1*/) * (-1); 			} else {				aj_dias = gapDias /*- 1*/;			}			if ( gapDias == 0 ) {				fech_buff = fech_hoy;			} else {				fech_buff = fnDate("add", fech_hoy, aj_dias);			}			strTmp = fnDate("month", fech_buff);			if ( strTmp == 12 ) {				strFecha = fnDate("year", fech_buff) & "/12/31";								fech_lim_fin = strFecha;							} else {				strFecha = fnDate("year", fech_buff) & "/";				strTmp = fnDate("month", fech_buff) + 1;				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "/" & "01";								fech_lim_fin = fnDate("add",strFecha,-1);							} 								fech_lim_fin = formato_fecha(fech_lim_fin);										strFecha = fnDate("year", fech_lim_fin) & "/";			strTmp = fnDate("month", fech_lim_fin);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "/" /*"-"*/ & "01";						fech_lim_ini = strFecha;			fech_lim_ini = formato_fecha(fech_lim_ini);									if ( strlen( frn.get("k_uuid_fecha") ) == 0 ) {				frn.message("No hay Fecha UUID de Referencia para validar ...","Error","Aceptar");				return respfunc;			} 						strFecha = frn.get("k_uuid_fecha");			strFecha = formato_fecha(strFecha);						//VCSS	INI Validaciones para usuarios normales (no superUsuario)			if (superUsuario != "1"){				if ( fnDate("cmp", strFecha, fech_hoy) > 0 /*strFecha > fech_hoy*/ ) {					mensajeError="La Fecha del UUID, es mayor al dia de hoy ..." & "|" & " " & "|" & " " & strFecha;					mensajeAdv=mensajeAdv & "; " & mensajeError;					frn.message(mensajeError ,"Error","Aceptar");					return respfunc;				} 							if ( fnDate("cmp", strFecha, fech_limit) > 0 /*strFecha > fech_limit*/ ) {					mensajeError = "La Fecha del UUID, fuera de Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;					mensajeAdv=mensajeAdv & "; " & mensajeError;					frn.message(mensajeError ,"Error","Aceptar");					return respfunc;				} 							if ( fnDate("cmp", strFecha, fech_ini) < 0 /*strFecha < fech_ini*/ ) {					if ( fnDate("cmp", strFecha, fech_lim_ini) < 0 /*strFecha < fech_lim_ini*/ ) {						mensajeError = "La Fecha del UUID, es menor al Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;						mensajeAdv=mensajeAdv & "; " & mensajeError;						frn.message(mensajeError ,"Error","Aceptar");						return respfunc;					} else {						if ( fnDate("cmp", strFecha, fech_lim_fin) > 0 /*strFecha > fech_lim_fin*/ ) {						mensajeError = "La Fecha del UUID, fuera del Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;						mensajeAdv=mensajeAdv & "; " & mensajeError;						frn.message(mensajeError ,"Error","Aceptar");						return respfunc;						}					}				}			} 			//VCSS 17/06/2024 INI Evaluacion de fecha de transaccion, las transacciones que se realizan dentro de los primeros 			//dias del mes dentro del gap y la fecha del xml es del mes anterior o anteriores, 			//se registran el día último del mes del xml			var fechaMovto,fechaXml,fechaRefer,mesesDif; 			fechaXml= frn.get("k_uuid_fecha");			fechaXml= formato_fecha(fechaXml);										var diaMovto=fnDate("day", fech_hoy);			var mesMovto=fnDate("month",fechaXml);			//Calcular dierencia en meses del mes actual y del xml				strTmp=fnDate("month",fechaXml);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}										fechaXml=fnDate("year",fechaXml) & "/" & strTmp & "/" & "01";						strTmp=fnDate("month",fech_hoy);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}							fech_hoy=fnDate("year",fech_hoy) & "/" & strTmp & "/" & "01";			//Validar si xml es del mismo mes			if (fnDate("cmp",fechaXml,fech_hoy) == 0){ //Mismo mes				mesesDif=0;			}else{				fech_hoy=fnDate("add",fech_hoy,-1);				fech_hoy= formato_fecha(fech_hoy);				strTmp=fnDate("month",fech_hoy);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}								fech_hoy=fnDate("year",fech_hoy) & "/" & strTmp & "/" & "01";												if (fnDate("cmp",fechaXml,fech_hoy) == 0){					mesesDif=1;				}else{					mesesDif=2;				}			}							fechaMovto= frn.get("k_uuid_fecha");			if(mesesDif==2 && superUsuario==0){				mensajeError = "La Fecha del UUID, " & fechaMovto & " está fuera del Periodo Vigente.";				frn.message(mensajeError ,"Error","Aceptar");				return respfunc;			}			if (mesesDif != 0){				fechaMovto= frn.get("k_uuid_fecha");				strTmp=fnDate("month",fechaMovto);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}											fechaMovto=fnDate("year",fechaMovto) & "/" & strTmp & "/" & "31";				fechaMovto=formato_fecha(fechaMovto);				frn.set("k_fecha",fechaMovto);				frn.message("Los movimientos de meses anteriores se registrarán al último día del mismo mes.","Mensaje","Aceptar");			}			//VCSS 17/06/2024 FIN Evaluacion de fecha de transaccion...			respfunc = 1;			return respfunc;				} // End Fun - Validar_Fecha_UUID		fun ProcesarFactura() {					ObtenerFactura();						if ( strlen(NewProvId) > 0 ) {				prov_data_upd(NewProvId);			}						// Se elimina esta parte porque l ejecuta antes de abrir el dialogo ...			// /*			if ( strlen(NewProvId) > 0 ) {				BuscarProveedor();			}			// */					} // End Fun - ProcesarFactura 				 		fun Get_Cat(imodo) {            				var suc_id, dato_id;				var win_tit, field_key, field_col, cmdQuery;								sucursal_id = frn.get("k_sucn",-1,1);	            				if ( imodo <= 0 || imodo > /*2*/ 1 /*7*/ ) {					// No es opcion de CAT Valida ...					return;				}								win_tit = "";				field_key = "";				field_col = "";				cmdQuery = "";			       				if (imodo == 1) {									if ( strlen( frn.get("k_clave") ) == 0 || strlen( frn.get("k_rfc") ) == 0 ) {						frn.message("Para Modificar el Proveedor de Pago primero se debe tener un Proveedor de Documento valido ...", "Error","Aceptar");						return;					}									win_tit = "CAT Proveedores de Pago";					field_key = "clave";					field_col = "k_clave_pago";					cmdQuery = "select C2 as clave, C3 as nombre from keplersc.kdxd where pagador = 1 or c2 = '" & frn.get("k_clave") & "' order by C3";				}			         	         				if (imodo == 2) {					win_tit = "CAT Proveedores";					field_key = "clave";					field_col = "k_clave";					cmdQuery = "select C2 as clave, C3 as nombre from keplersc.kdxd order by C3";				}					            if ( strlen(win_tit) > 0 && strlen(field_key) > 0 && strlen(field_col) > 0 && strlen(cmdQuery) > 0  ) {									frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");				}						} /*END Func Get_Cat()*/		fun BuscarProvPago(){			var xmlProd;											sucursal_id = frn.get("k_sucn",-1,1);			proveedor_pago_id = frn.get("k_clave_pago");			proveedor_pago_id = trim(proveedor_pago_id);					if (strlen( proveedor_pago_id ) == 0) {				frn.set("k_nombreprov_pago","");				return;			}							cmdQuery = "select c3 as k_nombreprov_pagos " &									"from keplersc.kdxd where  c2 = '" & proveedor_pago_id & "' ";								cmdQuery = cmdQuery & "and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')";								rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.BuscarProvPago()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				frn.set("k_nombreprov_pago","ERROR EN BUSQUEDA ...");				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.set("k_nombreprov_pago","NO EXISTE ...");				frn.setPos("k_clave_pago");				frn.message("El Proveedor de Pago No existe ...","Error","Aceptar");				return;				} 						frn.set("k_nombreprov_pago", getXmlAtt(cuboQuery,"r0", "k_nombreprov_pagos") );					} // End : Fun BuscarProvPago()					fun ProvPago_Sec(referencia){			var respfunc;											sucursal_id = frn.get("k_sucn",-1,1);			respfunc = 0; //Default es sin Permiso 						frn.setAtt("k_clave_pago", "available", "N");														if (strlen(referencia) == 0) {				return;			}						cmdQuery = "select * from keplersc.param_opc_usr_sec where sucursal = '" & sucursal_id & "' " & 				"and upper(opcion) = upper('Proveedor Pago') and upper(usuario) = upper('" & referencia & "')";						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.ProvPagoSec()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}						respfunc = nXml(cuboQuery);						if ( respfunc  > 0 ) {								if ( tip_ope &= "A" ) {						frn.setAtt("k_clave_pago", "available", "Y");				} else {					frn.setAtt("k_clave_pago", "available", "N");				}			} else {				frn.setAtt("k_clave_pago", "available", "N");			}						return respfunc;									} // End Fun - ProvPago_Sec 				 		fun CheckProvPago(){			var respfunc;											sucursal_id = frn.get("k_sucn",-1,1);			proveedor_pago_id = frn.get("k_clave_pago");			proveedor_pago_id = trim(proveedor_pago_id);						respfunc = 0; 					if (strlen( proveedor_pago_id ) == 0) {				frn.set("k_nombreprov_pago","");				return;			}							cmdQuery = "select c3 as k_nombreprov_pagos " &									"from keplersc.kdxd where c2 = '" & proveedor_pago_id & "' ";								cmdQuery = cmdQuery & "and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')";								rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.BuscarProvPago()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				frn.set("k_nombreprov_pago","ERROR EN BUSQUEDA ...");				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.set("k_nombreprov_pago","NO EXISTE ...");				return;				} 						respfunc = 1;									return respfunc;					} // End : Fun CheckProvPago()								fun ValidaFolioCancelado(folio){		var statusfolio;			cmdQuery = "select c43 as status_folio " & 						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & frn.get("k_tipon",-1,4) & " and c6= '" & folio & "'";						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvbonifcxpcrud.ValidaFolioCancelado()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ValidaFolioCancelado");			ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return "Error obteniendo Estatus"; 			}			statusfolio = getXmlAtt(cuboQuery,"r0","status_folio");			if (statusfolio &= "C"){	// C=Cancelado				resVal=0;				frn.message("El Documento se encuentra cancelado","Atencion","Aceptar");				return "CANCELADO";  			} else { 				return ""; } 		}		fun CambiaFolio() {			frn.set("k_docto", "");			frn.set("k_fecha", "");			frn.set("k_hora", "");			limpiar_datos_uuid();			frn.set("k_clave_pago", "");			frn.set("k_nombreprov_pago", "");		}				fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				CambiaFolio();				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvbonifcxpcrud.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);			}							fun Plazo(){ //Calcula la fecha de pago, y las condiciones de pago en base al plazo			frn.set("k_vence",fnDate("addC",frn.get("k_fecha"),frn.get("k_plazo")));//Suma días comerciales			var cond=frn.get("k_plazo") & " dias fecha factura"/*" días fecha factura"*/;			if (frn.get("k_plazo")==0) cond="Pago de contado";				frn.set("k_cond",cond);  			}		fun IniParams(){//Inicializa parÃ¡metros de impresiÃ³n, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar PÃ¡gina				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1","param_borderT","1.5","param_borderR","1","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}						fun setRepPage() {//Establece los parï¿½metros finales de impresiï¿½n.			var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";			var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";			var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");			var lndsp="landscape=" & frn.get("param_landscape");			var emp="@emp=" & frn.get("param_emp");			rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);		}			fun EjecReporte(){//Imprime el reporte del documento especificado 				if(strlen(trim(frn.get("k_folio")))==0){ 					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");					frn.setPos("k_folio");return;				}else{					ValidaFolioCancelado(frn.get("k_folio"));									}				//Reporte();				frn.setPos("k_folio");			}							fun Reporte(){				}									} // End of class Main	</script></pag>