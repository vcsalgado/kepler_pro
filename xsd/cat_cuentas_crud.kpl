<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<br/><tab/>		<inp id="k_titulo" dim="65,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"				type="string" modify="N" available="N" fnt="Arial,22"/>			<br/><tab/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grupo_crud" dim="80,18,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" available="Y" tit="Detalle de la Cuenta"><tab/>			<br/><tab/><txt>A&#241;o: </txt><tab n="3"/>			<cmb id="k_anio" clr="64,64,64" clrBrdr="192,205,213" dim="6,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" available="N" modify="N"/>						<br/><tab/><txt>Cuenta : </txt><tab n="2"/>			<inp id="k_clave" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="20" available="N" OnChange="" tooltip="Clave de la Cuenta" modify="N"/><br/><tab/><txt>Descripci&#243;n : </txt>			<inp id="k_descripcion" dim="50,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="40" clrBrdr="255,255,255" tooltip="Descripci&#243;n de la Cuenta" available="N" modify="N"/><br/><tab/><txt>Saldo:</txt><tab n="2"/>			<inp id="k_saldo" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" just="R" nd="2" available="N" modify="N"/><txt clr="250,50,0" fnt=",12"> * Cantidades negativas para saldo acreedor</txt>			<br/>						<tab/><br/><tab/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="N" available="N"/><br/>		</grp>		<br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP, accion,clave_sel,sucursal_id,cve_color,resVal,straccion,anio_sel,funParent;			var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError;			var saldo_actual;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();				Inicializa();				ctlrs_opcion();			}						fun Inicializa(){				var cmd,cubo;				accion = frn.param(0);				clave_sel = frn.param(1);				anio_sel = frn.param(2);								funParent=frn.param(3);				frn.rst("grupo_crud");            if (accion &= "NUEVO"){                straccion = "Agregar " ;               }else if (accion &= "CONSULTAR"){                straccion = "Consultar ";            }else if (accion &= "MODIFICAR"){                straccion = "Modificar ";            }else if (accion &= "ELIMINAR"){					straccion = "Eliminar ";            }else if (accion &= "SALDO"){					saldo_actual=0;					straccion = "Saldo ";            }                 				frn.set("k_titulo",straccion & "Cuenta");				frn.setAtt("grupo_crud", "tit", "Detalle de la Cuenta");				if (accion &! "NUEVO"){					frn.set("k_clave", clave_sel);				}					//Llena combo de año				cmd="SELECT concat(substring(table_name,5,2)) as anio FROM INFORMATION_SCHEMA.TABLES 					WHERE TABLE_NAME LIKE 'kdc22%'					group by anio					order by anio desc";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"conpolizasView.Inicia_Forma()");				frn.set("k_anio",getXml(cubo));				frn.set("k_anio",anio_sel);								//Obtiene detalle de la cuenta				if(accion &! "NUEVO"){					ObtenerDetalleCuenta();				}			}									fun ctlrs_off(){				frn.setAtt("k_anio","available","N");				frn.setAtt("k_anio", "modify", "N" );							frn.setAtt("k_clave","available","N");				frn.setAtt("k_clave", "modify", "N" );				frn.setAtt("k_descripcion", "available","N");				frn.setAtt("k_descripcion", "modify","N");				frn.setAtt("k_saldo", "available","N");				frn.setAtt("k_saldo", "modify","N");								//Por defecto, el boton aceptar siempre está habilitado				frn.setAtt("btn_aceptar", "available", "Y" );				frn.setAtt("btn_aceptar", "visible", "Y" );			}							fun ctlrs_opcion(){				ctlrs_off();				if (accion &= "NUEVO"){					frn.setAtt("k_anio","available","Y");					frn.setAtt("k_anio", "modify", "Y" );								frn.setAtt("k_clave","available","Y");					frn.setAtt("k_clave", "modify", "Y" );					frn.setAtt("k_descripcion", "available","Y");					frn.setAtt("k_descripcion", "modify","Y");					   }else if (accion &= "CONSULTAR"){					frn.setAtt("btn_aceptar", "available", "N" );					frn.setAtt("btn_aceptar", "visible", "N" );			   					//Botones en default			   }else if (accion &= "MODIFICAR"){					frn.setAtt("k_descripcion", "available","Y");					frn.setAtt("k_descripcion", "modify","Y");			   }else if (accion &= "ELIMINAR"){					//Botones en default				}else if (accion &= "SALDO"){					frn.setAtt("k_saldo", "available","Y");					frn.setAtt("k_saldo", "modify","Y");				}else {									frn.setAtt("btn_aceptar", "available", "N" );					frn.setAtt("btn_aceptar", "visible", "N" );				}			}							fun ObtenerDetalleCuenta(){				var tabla, descripcion,saldo;				tabla = "keplersc.kdc1" & anio_sel;				cmdQuery="SELECT c2 as descripcion, c14 as saldo FROM " & tabla & " WHERE c1='" & clave_sel & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_cuentas_crud.ObtenerDetalleCuenta()");		frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\xmlObtenerDetalleCuenta");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					frn.setAtt("btn_aceptar", "available", "N" );					frn.setAtt("btn_aceptar", "visible", "N" );										return;				}											descripcion=getXmlAtt(cubo,"r0","descripcion");				saldo=getXmlAtt(cubo,"r0","saldo");				frn.set("k_descripcion",descripcion);				frn.set("k_saldo",saldo);				saldo_actual=saldo;			}			fun Execute() {				var difsaldo;				//Validación	de datos					if (frn.get("k_clave") &= "") {											frn.setPos("k_clave");					frn.message("Debe especificar la clave de cuenta.","Error","Aceptar");					return;				}				if (frn.get("k_descripcion") &= "") {											frn.setPos("k_descripcion");					frn.message("Debe ingresar la descripción de la cuenta.","Error","Aceptar");					return;									}												var resultado_confirmacion = frn.message("¿Confirma la operación?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}								xmlRequest = getXml(frn.dataPag());				setXml(xmlRequest,"k_movto",accion);				//Calcula el saldo de la cuenta, esto para actualizacion de saldos, accion = SALDO				difsaldo=frn.get("k_saldo");				difsaldo = difsaldo - saldo_actual;//frn.message(difsaldo,"Mensaje","Aceptar");				setXml(xmlRequest,"k_saldo",difsaldo);				frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");				cmdQuery="SELECT * FROM keplersc.cat_cuentas_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_cuentas_crud.Execute()");		frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.message("Operación realizada correctamente","Mensaje","Aceptar");				if (funParent &! ""){					frP.script(funParent);				}				frn.exit();				}				}	</script></pag>