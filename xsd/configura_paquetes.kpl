<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Configura Paquetes">
	<grp id="grpMain" brdr="0,0" clr="0,58,112" fnt="Arial,18b"  dim="1,-1,10,8" bclr="192,205,213" clrBrdr="0,97,181"  tit="Configura Paquetes" unfont="0">
		<tab/><txt clr="0,0,0" fnt=",22">Configura Paquetes</txt><br/>
		<tab/><hLine clr="0,0,0"/><br/>
		<br/><br/>
		<tab/>
			
		<grp id="grpPartidas" dim="60,48,7,12"  bclr="236,240,243" fntBrdr="Arial,18" clrBrdr="0,58,112" brdr="0,5" hSpace="4" fntClrBrdr="236,240,243" fnt="Arial,16" tit="Configura Paquetes" brdr="0,5" available="Y" modify="Y">
			
			
				<tab/><txt clr="0,58,112" hk="S">Sucursal:</txt>
				<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="45,36" bclr="255,255,255" brdr="2,0"  fnt="Arial,16" Null="N" hk="S" available="Y"/>
				
				<br/>	<br/>
				<tab/><txt>Marca</txt><tab n="4"/>
				<inp id="marca"  bclr="255,255,255" clr="64,64,64" OnF9="Sel_marca()" OnChange="Ins_marca()" nc="5" tooltip="F9 Marcas" type="capital" clrBrdr="255,255,255"  dim="15,1" fnt="Arial,16"/>
				
				
				<br/>
				
				<tab n="1"/><txt>Modelo</txt><tab n="4"/>
				<inp id="modelo" bclr="255,255,255" clr="64,64,64" OnF9="Sel_modelo()" OnChange="Ins_modelo()" tooltip="F9 Modelos"  type="capital" clrBrdr="255,255,255"  dim="15,1" fnt="Arial,16"/>
				<br/>	<br/>
				
					
				<tab/><txt>Paquete</txt><tab n="4"/>
				<inp id="paquete" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  OnF9="Sel_paquete()" OnChange="Ins_paquete()" tooltip="F9 Paquetes"  type="capital" dim="15,1" fnt="Arial,16"/>
				<br/>
				
				<tab/><txt>Descripcion</txt><tab n="3"/>
				<inp id="descripcion" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"   brdr="2,0" modify= "N" dim="60,1" fnt="Arial,16"/>
				<br/>
				
				<tab/><txt>Fuera de Garantia </txt><tab n="1"/>
				<inp id="fuera_garantia" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="text" nc="1" tooltip="Doble Click"  OnMouseD="cambia_s_n()" modify="N" dim="2,1" fnt="Arial,16"/>
				<tab/><txt> [S]i/[N]o * Indica si el paquete es para veh&#237;culos fuera de garant&#237;a. </txt>
				<br/><br/>
				
				<tab/><txt>Varios</txt><tab n="2"/>
				<inp id="varios" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="mano_obra_refacciones()"  type="number" nd="2" dim="15,1" fnt="Arial,16" min="0"/>
				<br/>
				
					
				<tab/><txt>Horas</txt><tab n="3"/>
				<inp id="horas" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  type="number"  dim="15,1" fnt="Arial,16" min="0"/>
				<tab n="1"/><txt>Estas horas las multiplicara por el factor.</txt>
				<br/><br/>
				
				<tab/><txt>Subtotal</txt><tab n="2"/>
				<inp id="subt" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"   dim="15,1" fnt="Arial,16" type="number" nd="2" brdr="2,0" modify="N" available="N"/>
				<br/>
				<tab/><txt>IVA</txt><tab n="3"/>
				<inp id="iva" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"   dim="15,1" fnt="Arial,16" type="number" nd="2" brdr="2,0" modify="N" available="N"/>
				<br/>
				<tab/><txt fnt=",16b">IMPORTE</txt><tab/>
				<inp id="precio_paquete" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  OnChange="Importe()" dim="15,1" fnt=",16b" bclr="255,255,255" brdr="2,0" type="number" nd="2" min="0"/><tab/><br/>
				<br/>
				
				
			
				
				
			<tab/>	
			<tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="80,10"  hk="z"  Reorder="N" modify="Y">
				<col id="k_parte" name="Clave"  type="capital" nc="18" OnChange="Ins_refaccion()"
					OnF9="Dialog(3,invcatprdbus,k_mov,k_parte)" 
					OnF5="Dialog(3,invrepestprod,s)"
					OnF10="Dialog(3,cat_prod_crud,Nuevo,x,s)" OnF11="Dialog(3,cat_prod_crud,Modificar,x,s)" 
					OnMouseL="Dialog(3,invcatprdbus,k_mov,k_parte)"  modify="Y" available="Y"/>
				<col id="k_descr" name="Descripci&#243;n"  modify="N"/>		
				<col id="k_Q" name="Cantidad"  type="number" nd="-1" min="0" OnChange="Cantidad()"/>
				<col id="k_precio" name="Precio Unitario"  type="number" nd="2" modify="N" available="Y"/>
				<col id="k_monto" name="Importe"  type="number" nd="2" min="0" modify="N" available="Y"/>
							</tbl><br/>
		
		
				<tab/><txt>Mano de Obra</txt><tab n="1"/>
				<inp id="mano_obra" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt="Arial,16" type="number" nd="2" brdr="2,0" modify="N" available="N"/>
				<br/>
				<tab/><txt>Refacciones</txt><tab n="2"/>
				<inp id="refacciones" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt="Arial,16" type="number" nd="2" brdr="2,0" modify="N" available="N"/>
	
			
				<tab n="13"/>
				<bot id="btn_guardar" dim="10,10" brdr="5" text="Guardar" hk="K" default="0" step="0"  OnEnter="Guardar()" fnt="Arial,16"/>
		
		</grp>
	</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var  usuario, suc_usuario,rol_usuario,asterisco;
			var frn,kdb,rep,frP,sys;
			var tip_ope;//Tipo de operaci�n. "0" indica Alta; "1" indica consulta; "2" indica cancelaci�n; "3" indica baja; "4" Indica modificaci�n
			
	
			//Variables validacion factura
			fun Main() {
				frn=new FRNT;
				kdb=new KDB;
				rep=new REP;
				frP=new FRNTP;
				sys=new SYS;
				kdb.connect();
				usuario = frn.config("user","name");
				rol_usuario = frn.config("user","role");
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				asterisco = "*";
				inicializa();
			}
			
			fun inicializa(){
				
		
				if( frn.nParam()&= 0 ){
	
					frn.message("Esta acci�n no est� permitida.","Estimado Usuario","&Aceptar");
					frn.open("redirect",2);
					return;
				}
				
				
				
				//Llenar combo sucursales
				var cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";
				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){
					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";
				}else {
					if (suc_usuario &! asterisco && suc_usuario &! "" ){
						cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";
					}
				}	
				
				cmdQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery ,"cat_crud_vendedores.Inicializa()");
					
				var ok=getXmlAtt(cmdQuery ,"ok");
				if(ok &! "" && !ok){
					var mensajeError = getXmlAtt(cmdQuery ,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				frn.set("k_sucN",getXml(cmdQuery ));
				frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));	

				frn.set("fuera_garantia", "N");

			}
			
			fun cambia_s_n (){
			
				if (frn.get("fuera_garantia") &= "N"){
					frn.set("fuera_garantia", "S");
				}else{
					frn.set("fuera_garantia", "N");
				}
			
			
			}
			
			
			
			fun Sel_marca(){
				  
				var cmdQuery = "select c1 as clave, c2 as descripcion from keplersc.kdmarcas ";
			
				frn.dialog("genlistafiltrosel","Marcas",cmdQuery,"clave","marca","0","","S");
					          
			}
			
			fun Ins_marca(){
			
				var xmlRequest,cmd,ok, cuboResultados, mensajeError;	
				
				var marca =  frn.get("marca");
	
				frn.rst("marca");
				frn.rst("modelo");
				
				cmd = "select c1 from keplersc.kdmarcas where c1 = '" & marca  &  "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"configura_paquetes.Ins_marca()");
			
				if(nXml(cuboResultados) &=0 ){
				   mensajeError = getXmlAtt(cuboResultados ,"native3");
					frn.message("Marca no existe","Criterios no encontrados","Aceptar");
					return;
				}	
				
				frn.set("marca", marca );
				
			
			}
			

			
			fun Sel_modelo(){
			
			
				var marca = frn.get("marca");
				
				if (marca &= ""){
				
					frn.message("Debes seleccionar una marca antes","","Aceptar");
					return;
				
				}
				  
				var cmdQuery = "select c2 as clave ,c3 as descripcion from keplersc.kdmodelos where c1='" & marca &  "'";
			
				frn.dialog("genlistafiltrosel","Modelos",cmdQuery,"clave","modelo","0","","S");
					          
			}
			
			fun Ins_modelo(){
			
				var xmlRequest,cmd,ok, cuboResultados, mensajeError;	
				
				var marca = frn.get("marca");
				
				if (marca &= ""){
				
					frn.message("Debes seleccionar una marca antes","","Aceptar");
					frn.set("modelo", "");
					return;
				
				}
							 
				cmd = "select c1 from keplersc.kdmodelos where c1 = '" & marca  &  "' and c2='" & frn.get("modelo") & "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"configura_paquetes.Ins_modelo()");
			
				if(nXml(cuboResultados) &=0 ){
				   mensajeError = getXmlAtt(cuboResultados ,"native3");
					frn.message("Modelo no existe","Criterios no encontrados","Aceptar");
					frn.set("modelo", "");
					return;
				}	
				
			
			}
			
			
			
			
			fun Sel_paquete(){
			
				if (frn.get("marca") &= "" || frn.get("modelo") &= "" ){
					frn.message("Debes seleccionar Marca y Modelo anrtes","","Aceptar");
					return ;
				}
				  
				var cmdQuery = "select c1 as clave, c2 as descripcion, c3 as clasificacion from keplersc.kdcatpaq ";
			
				frn.dialog("genlistafiltrosel","Paquetes",cmdQuery,"clave","paquete","0","","S");
					          
			}
			
			
			fun borrar_datos() {
			
			
				frn.rst("paquete");
				frn.rst("descripcion");
				frn.rst("fuera_garantia");
				frn.rst("varios");
				frn.rst("horas");
				frn.rst("subt");
				frn.rst("iva");
				frn.rst("precio_paquete");
				frn.rst("mano_obra");
				frn.rst("refacciones");
				frn.rst("k_mov");
			
			}
			
			
			
			fun Ins_paquete(){
			
				var xmlRequest,cmd,ok, cuboResultados, mensajeError;	
				
				if (frn.get("marca") &= "" || frn.get("modelo") &= "" ){
					frn.message("Debes seleccionar Marca y Modelo anrtes","","Aceptar");
					return ;
				}
				  
				
				var paquete =  frn.get("paquete");
				
				borrar_datos();
		
				
				cmd = "select c1, c2 from keplersc.kdcatpaq where c1 = '" & paquete &  "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"configura_paquetes.Ins_paquete()");
			
				if(nXml(cuboResultados) &=0 ){
				   mensajeError = getXmlAtt(cuboResultados ,"native3");
					frn.message("Paquete no existe","","Aceptar");
					return;
				}	
				
				frn.set("paquete", paquete );
				
				frn.set("descripcion", getXmlAtt(cuboResultados , "r0", "c2") );
				
				
				//buscar si ya existe configuracion en kdspaq
				cmd = "select c8,c9,c10,c11 from keplersc.kdspaq where c1 ='" & frn.get("marca") & "' and c2='" & frn.get("modelo") & "' and c4='" & paquete & "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"configura_paquetes.Ins_paquete()");
			
				if(nXml(cuboResultados) > 0 ){
					frn.message("Se encontro una configuracion para la marca,modelo y paquete seleccionados.","","Aceptar");
				
					frn.set("precio_paquete", getXmlAtt(cuboResultados , "r0", "c10") );
					frn.set("fuera_garantia", getXmlAtt(cuboResultados , "r0", "c11") );
					Importe();
				
					frn.set("varios", getXmlAtt(cuboResultados , "r0", "c8") );
					frn.set("horas", getXmlAtt(cuboResultados , "r0", "c9") );
					
			
					
					cmd = "select paq.c6,ref.c2,paq.c7 from keplersc.kdspaqm as paq inner join keplersc.kdini as ref on paq.c6=ref.c1 " ;
					cmd =  cmd & " where paq.c1 ='" & frn.get("marca") & "' and paq.c2='" & frn.get("modelo") & "' and paq.c4='" & paquete & "'";
					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"configura_paquetes.Ins_paquete()");
					
					
					//buscar refacciones en kdspaqm 
					for (var i=0,n=nXml(cuboResultados);i<n;i++) {
					
						var clave_ref = getXmlAtt(cuboResultados , "r" & i, "c6");
						
						frn.setX(clave_ref  , "k_mov", i, "k_parte");
						var desc = getXmlAtt(cuboResultados , "r" & i, "c2");
						frn.setX(desc , "k_mov", i, "k_descr" );
						var ctd_ref = getXmlAtt(cuboResultados , "r" & i, "c7");
						frn.setX(ctd_ref , "k_mov", i, "k_Q" );			
						
					
						var precio_unitario = obtener_precio_unitario(clave_ref);
						
						frn.setX(precio_unitario , "k_mov",  i, "k_precio" ); 
						frn.setX(precio_unitario * ctd_ref , "k_mov",  i, "k_monto" ); 
					}
					
				}	
				
				mano_obra_refacciones();
				
		
			}
			
			fun obtener_precio_unitario(ref){
			
				//obtener configuraciones para precio al publico
				var cmd_cat_precio = "select c6,c3,c4,c5 from keplersc.kdicatprecio where c1='PUBLI' " ;
				var cubo_cat_precio = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd_cat_precio ,"configura_paquetes.Ins_paquete()");
				
				var cmd = "select c5,c6,c8,c9,c14 from keplersc.kdinl where c1='" & frn.get("k_sucN", -1, 1)  & "' and c2='" & ref & "'";
				var cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"configura_paquetes.obtener_precio_unitario()");
			
				var existencias = getXmlAtt(cuboResultados , "r0", "c5") - getXmlAtt(cuboResultados , "r0", "c6");
				var costo_promedio =  (getXmlAtt(cuboResultados , "r0" , "c8") -  getXmlAtt(cuboResultados , "r0", "c9"))/existencias ;
				var ultimo_costo =  getXmlAtt(cuboResultados , "r0" , "c14");
				
				
				//OBTENER PRECIO UNITARIO REFACCION 
				var cmd_precio = "select * from keplersc.calcula_precio_ref ('" & ref & "'," & getXmlAtt(cubo_cat_precio , "r0" , "c6") & "," & getXmlAtt(cubo_cat_precio , "r0" , "c3");
				cmd_precio = cmd_precio &  "," & getXmlAtt(cubo_cat_precio , "r0" , "c4") & "," & getXmlAtt(cubo_cat_precio , "r0" , "c5") & "," & ultimo_costo & "," & costo_promedio & ")";
						
				frn.lib("libGeneral.kpl","FileSave",cmd_precio ,"C:\Basura\cmd_precio ");

				var cuboResultadosprecio = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd_precio ,"configura_paquetes.Ins_paquete()");
			
				frn.lib("libGeneral.kpl","FileSave",cuboResultadosprecio ,"C:\Basura\cuboResultadosprecio ");
						
				var precio_unitario = getXmlAtt(cuboResultadosprecio, "r0", "precio");
				
				return precio_unitario;
		
			}
			
			
				
			fun mano_obra_refacciones(){
			
			
				var refacciones = 0;
				for(var i =0;i<frn.N("k_mov");i++){
				
					refacciones = refacciones + frn.get("k_mov",i,"k_monto");
				}
				frn.set("refacciones", refacciones );
				
				var mano_obra = frn.get("subt") - refacciones - frn.get("varios");
				frn.set("mano_obra", mano_obra);
			
			}
			
			fun Cantidad (){
			
				if (frn.get("k_mov",-1,"k_parte") &= ""){
					frn.message("Debes seleccionar una parte antes","","Aceptar");
					frn.setX("", "k_mov", -1, "k_Q");
					return;
				}
			
				frn.setX(frn.get("k_mov",-1,"k_Q") * frn.get("k_mov",-1,"k_precio"), "k_mov", -1, "k_monto");
				
				mano_obra_refacciones();
			
			}
			
			
			fun Ins_refaccion(){
			
				var xmlRequest,cmd,ok, cuboResultados, mensajeError;
					
				frn.setX("", "k_mov", -1, "k_Q");
				frn.setX("", "k_mov", -1, "k_precio");
				frn.setX("", "k_mov", -1, "k_monto");	
		
				cmd = "select c1,c2 from keplersc.kdini where c1 = '" & frn.get("k_mov",-1,"k_parte") &  "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"configura_paquetes.Ins_marca()");
			
				if(nXml(cuboResultados) &=0 ){
				   mensajeError = getXmlAtt(cuboResultados ,"native3");
					frn.message("Refaccion no existe","","Aceptar");
					frn.setX("", "k_mov", -1, "k_parte");
					frn.setX("", "k_mov", -1, "k_descr");
					return;
				}	
			
				
				frn.setX(getXmlAtt(cuboResultados , "r0", "c2"), "k_mov", -1, "k_descr");
				
				var precio_unitario =  obtener_precio_unitario(getXmlAtt(cuboResultados , "r0", "c1"));
				
				frn.setX(precio_unitario  , "k_mov", -1, "k_precio");
				
			}
			
			
			
			fun Importe(){
			
				var importe = frn.get("precio_paquete");
				
				var subtotal = importe / ( 1+(16/100) );
				
				frn.set("subt", subtotal );
				
				var iva = importe - subtotal ;
				
				frn.set("iva", iva);
				
				mano_obra_refacciones();
				
			}
			
			fun Guardar(){
				var xmlPantalla,resultado,mensaje,adicionales,valor;
			
				//Validacion de datos
				valor=frn.get("mano_obra");
				if (valor<0){
					frn.message("La mano de obra no puede ser negativa.","Error","Aceptar");
					return;
				}
				
				valor=frn.get("refacciones");
				if (valor<0){
					frn.message("El importe de refacciones no puede ser negativa.","Error","Aceptar");
					return;
				}
								
				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
				
				setXml(xmlPantalla ,"k_partidas","no_partidas",frn.N("k_mov")-1);
					
				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallapaquetes");
				
				var cmdQuery="select * from keplersc.configuracion_paquetes('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";		
				var cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"configura_paquetes.Guardar()");
				resultado= getXml(cuboQuery,"resultado");
				mensaje= getXml(cuboQuery,"mensaje");
				
				if(resultado &= "0"){
					frn.message(mensaje,"Error","Aceptar");
					return;
				}
				frn.message("Configuracion guardada","Mensaje","Aceptar");
			
			}
			
			
			//----------------------------------------------------------EXTRAS---------------------------------------------
					
			fun descr_combo(combo,posicion,valor){

				var descr, valor_actual;
				var len_combo = frn.N(combo);

				for (var cont=0; cont<len_combo ; cont++){
					valor_actual= frn.get(combo,cont,posicion);
					if (valor_actual &=  valor){
						descr = frn.get(combo,cont,0);
						return descr;
					}
				}
			}
			
           
		
						
			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){
				/*iModo: 0)No hace mayor validaci�n. Siempre despliega la ventana. NO CONCATENA PREFIJO
							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci�n. Siempre despliega la ventana
							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)
							3)Modo especial para p�ginas de operacion:Solo si se est� en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje
				*/
				var prefix=frn.lib("libKepler","langPrefix");
				var page=prefix&pag;
				var b_valido=1;
				if(iModo==0)page=pag;
				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver� el resultado.
					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;
				}
				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;
				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);
			}		
		}			
	</script>
</pag>