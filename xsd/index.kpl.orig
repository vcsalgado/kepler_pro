rga Refacciones" hk="C">							<branch txt="Carga Refacciones" hk="A" pag="carga_refacciones.kpl"  param="U,D,7,,1,0,REF" roles="ADMINISTRADOR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ,RDSILVA,RJCRUZ,REGARCIA"/>					<branch txt="Consulta Carga Refacciones" hk="C" pag="carga_refacciones.kpl"  param="U,D,7,,1,1,REF" roles="ADMINISTRADOR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ,RDSILVA,RJCRUZ,REGARCIA"/>					<branch txt="Descarga Refacciones" hk="D" pag="descarga_refacciones.kpl"  param="U,A,12,,1,0,REF" roles="ADMINISTRADOR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ,RDSILVA,RJCRUZ,REGARCIA"/>					<branch txt="Consulta Descarga Refacciones" hk="C" pag="descarga_refacciones.kpl"  param="U,A,12,,1,1,REF" roles="ADMINISTRADOR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ,RDSILVA,RJCRUZ,REGARCIA"/>					<branch txt="Cierra Orden" hk="d" pag="ordenview.kpl" param="REFSCIERRA" roles="ADMINISTRADOR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ,RDSILVA,RJCRUZ,REGARCIA"/>					<branch txt="Abre Orden" hk="d" pag="ordenview.kpl" param="REFSABRE" roles="ADMINISTRADOR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ,RDSILVA,RJCRUZ,REGARCIA"/>				</branch>				<branch txt="Facturaci&#243;n Directa" hk="F">					<branch txt="Alta" hk="A">						<branch txt="Alta de Factura" hk="A" pag="venfactdirecta.kpl"  param="U,D,22,,1,0,REF" roles="ADMINISTRADOR,CAJAR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ,RDSILVA,RJCRUZ,REGARCIA"/>						<branch txt="Consulta de Factura" hk="C" pag="venfactdirecta.kpl"  param="U,D,22,,1,1,REF" roles="ADMINISTRADOR,CAJAR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ,RDSILVA,REGARCIA"/>					</branch>					<branch txt="Nota de Cr&#233;dito" hk="N">						<branch txt="Alta Nota de Credito" hk="A" pag="venfactdirecta_notacredito.kpl"  param="U,A,9,,1,0,REF" roles="ADMINISTRADOR,CAJAR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ,RDSILVA,RJCRUZ,REGARCIA"/>						<branch txt="Consulta Nota de Credito" hk="C" pag="venfactdirecta_notacredito.kpl"  param="U,A,9,,1,1,REF" roles="ADMINISTRADOR,CAJAR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ,RDSILVA,RJCRUZ,REGARCIA"/>					</branch>				</branch>				<branch txt="Reportes" hk="P">				<branch txt="Ventas por Producto" hk="P" pag="venrepvtasxprod" roles="ADMINISTRADOR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ"/></branch>			</branch>			<branch txt="Compras" hk="O">				<branch txt="Compras Directas" hk="D">					<branch txt="Alta de compra" hk="A" param="X,A,04,,1,0.REF" pag="comopecompras.kpl" roles="ADMINISTRADOR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ,RDSILVA,RJCRUZ,REGARCIA"/>					<branch txt="Consulta de compra" hk="C" param="X,A,04,,1,1,REF" pag="comopecompras.kpl" roles="ADMINISTRADOR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ,RDSILVA,RJCRUZ,REGARCIA"/>				</branch>				<branch txt="Devoluciones Directas" hk="D">				<branch txt="Alta de Devoluci&#243;n" hk="A" pag="comdevdircrud.kpl" param="X,D,40,1,A,REF" roles="ADMINISTRADOR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ"/>				<branch txt="Baja de Devoluci&#243;n" hk="B" pag="comdevdircrud.kpl" param="X,D,40,1,B,REF" roles="ADMINISTRADOR,RAMARMOLEJO,RCXP,RCZAVALA,REGOMEZ,RGGARCIA,RLJIMENEZ"/>				</branch>			</branch><branch txt="Reportes" hk="R"><branch txt="Orden de Servicio" hk="O" pag="ser_reportedeorden.kpl" roles="ADMINISTRADOR,REGARCIA" param="SER"/>						</branch>		</branch>			<branch txt="Comisiones" hk="I" roles="ADMINISTRADOR" img="60_Comisiones.png">			<branch txt="Operarios" hk="P"  roles="ADMINISTRADOR">				<branch txt="Catalogos">					<branch txt="X Operarios OLCP -- Gad" hk="O"/>					<branch txt="X Clasificacion de Pagos OLCI Gad" hk="C"/>				</branch>				<branch txt="Alta Pago Operario" hk="A" param="N,A,19,,1,0,SER" pag="srv_pago_operarios.kpl" roles="ADMINISTRADOR"/>					<branch txt="Baja Pago Operario" hk="A"  param="N,A,19,,1,1,SER" pag="srv_pago_operarios.kpl" roles="ADMINISTRADOR"/>				<branch txt="Consulta Pago Operario" hk="B"  param="N,A,19,,1,2,SER" pag="srv_pago_operarios.kpl" roles="ADMINISTRADOR"/>			</branch>			<branch txt="Coaches" hk="C" pag="">				<branch txt="Catalogos">					<branch txt="Catalogo de Esquemas OVMAA Gad" hk="E"/>					<branch txt="Valuadores OVMAV"/>					<branch txt="Esquema Coach OVMAH"/>					<branch txt="Tipos de Comision OVMAC"/>					<branch txt="Captura CSI Ventas OVMAI"/>					<branch txt="Coaches OVMEA"/></branch>					<branch txt="Objetivos por linea" pag="cat_crud_bonosporlinea.kpl" param="XXX" hk="L" roles="ADMINISTRADOR"/>					<branch txt="Esquema Coach Ventas OVMEV"/>					<branch txt="Objetivos Mensuales" pag="gencatalogoview2.kpl" param="C_COACHESOBJMENS,Modificar" hk="M" roles="ADMINISTRADOR"/>					<branch txt="Comisiones Variables OVMEG" hk="V"/>				<branch txt="Comisiones" hk="C" pag="rep_comisiones_coaches.kpl" roles="ADMINISTRADOR"/>			</branch>						<branch txt="Vendedores" hk="M" roles="ADMINISTRADOR">				<branch txt="Catalogos">					<branch txt="Tabla de Vendedores OVMW" hk="V"/>					<branch txt="Tabla de Porcentajes" pag="cat_crud_porcentajes.kpl" roles="ADMINISTRADOR" param="XXX"/>					<branch txt="Tabla de Tipos" pag="cat_tipocomis_view.kpl" roles="ADMINISTRADOR"/>					<branch txt="Bonos por Linea OVMI"/>				</branch>				<branch txt="Genera Comisiones" hk="G" pag="com_vendedores_generar.kpl" roles="ADMINISTRADOR"/>					<branch txt="Reportes">					<branch txt="Mensuales" pag="venrepcomismens.kpl"/>					<branch txt="Quincenales" pag="venrepcomisquincenal.kpl"/>					<branch txt="Demostracion OVMRD"/>												</branch>			</branch>			</branch>			<branch txt="Mantenimiento" hk="M" roles="ADMINISTRADOR" img="60_System_Maint.png">			<branch txt="Mantenimiento" hk="M" roles="ADMINISTRADOR" img="60_System_Maint.png">				<branch txt="Generales" hk="G">					<branch txt="Tipos de Operaciones" hk="T">						<branch txt="Cat&#225;logo de Mo