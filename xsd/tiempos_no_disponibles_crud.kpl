<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<grp id="grupo_crud" dim="50,28,20,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18"><tab/>			<br/>						<tab n="1"/><txt>Fecha:</txt>	<tab n="2"/>			<edt id="fecha" dim="12,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha" OnF9="Dialog(3,_ks_fecha,fecha)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2" modify="N"/>			<br/>			<tab/><txt clr="0,58,112" hk="S">Tipo :</txt><tab n="2"/>			<cmb id="tipo_ope" clr="64,64,64" clrBrdr="255,255,255"  OnChange="Operarios()" dim="12,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  modify="N"/>			<tab n="1"/><br/>			<tab/><txt clr="0,58,112" hk="S">Recep/Ope :</txt><tab n="1"/>			<cmb id="operario" clr="64,64,64" clrBrdr="255,255,255"  dim="12,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  modify="N"/><tab n="1"/>			<br/>				<tab n="1"/>			<txt>Horas:</txt><tab n="2"/>			<inp id="horas" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nd="6"  clrBrdr="255,255,255"/><br/><tab n="1"/><txt>Comentarios:</txt><tab n="1"/>			<inp id="comentarios" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt>Horario Ini (00:00):</txt>			<inp id="horario_ini" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="time" nc="5" clrBrdr="255,255,255"/><br/><tab/>						<txt>Horario Fin (00:00):</txt>			<inp id="horario_fin" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="time" nc="5" clrBrdr="255,255,255"/><br/><tab/>															<br/>			<tab n="5"/><bot id="btn_aceptar" dim="5,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="0" visible="Y" modify="Y"/><br/>						<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>									</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP,accion,oper,tipo_ope,fecha;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();								accion = frn.param(0);				oper = frn.param(1);				tipo_ope = frn.param(2);				fecha = frn.param(3);								inicializa();				ctlrs_off();				insertar_datos();														}					fun inicializa(){										var cmd,cubo,ok;												frn.set("fecha" , fecha);							//Llenar combo tipo operarios				cmd = "select '['||c1||'] '||c2 as descripcion, c1 as clave  from keplersc.kdtoper ";											cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tiempos_no_disponibles_view.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								var cmd_tipo_ope = "tipo_ope";				frn.setX("RECEPCIONISTA", cmd_tipo_ope ,0,0);				frn.setX("RECEP", cmd_tipo_ope ,0,1);				llenar_cmb(cubo ,cmd_tipo_ope );								frn.set(cmd_tipo_ope ,descr_combo(cmd_tipo_ope ,1,tipo_ope ));													Operarios();													}						fun Operarios(){							var cmd_operario = "operario";								frn.rst(cmd_operario );								tipo_ope = frn.get("tipo_ope" , -1, 1);								var cmd;								if (tipo_ope &= "RECEP"){									cmd = "select '['||c1||'] '||c2 as descripcion, c1 as clave from keplersc.kdrecep where c11='S' ";				}else {								//Llenar combo operarios					cmd = "select '['||c1||'] '||c3 as descripcion, c1 as clave from keplersc.kdoper where c12='S'";														if (tipo_ope &! "" ){						cmd = "select '['||c1||'] '||c3 as descripcion, c1 as clave from keplersc.kdoper where c2='" & tipo_ope & "' and c12='S' ";					}									}							var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tiempos_no_disponibles_view.Inicializa()");									var ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}											frn.setX("", cmd_operario ,0,0);				llenar_cmb(cubo ,cmd_operario );									frn.set(cmd_operario ,descr_combo(cmd_operario ,1,oper ));																	}						fun ctlrs_off(){							accion = frn.param(0);				frn.set("input_crud", accion);				frn.rst("grupo_crud");							frn.setAtt("grupo_crud", "tit", accion );							frn.setAtt("fecha", "modify", "N" );				frn.setAtt("tipo_ope", "modify", "N" );				frn.setAtt("operario", "modify", "N" );										frn.setAtt("btn_aceptar", "modify", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );								if (accion &= "Nuevo"){					frn.setAtt("fecha", "modify", "Y" );					frn.setAtt("tipo_ope", "modify", "Y" );					frn.setAtt("operario", "modify", "Y" );				}								if (accion &! "Consultar"){					frn.setAtt("btn_aceptar", "modify", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );				}						}												fun insertar_datos(){				var xmlRequest,cmd,ok, cuboResultados;							if (accion &! "Nuevo") {									if (oper &! "" && tipo_ope &! "" && fecha &! "" ){											cmd="select c4,c7, c9, c10 from keplersc.kdtiemposnd where c1 ='" & oper & "' and c2='" & tipo_ope & "' and c3='" & fecha & "'"; 										cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tiempos_no_disponibles_crud.insertar_datos()");										frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");											ok=getXmlAtt(cuboResultados,"ok");						if(ok &! "" && !ok){							var mensajeError = getXmlAtt(cuboResultados,"native3");							frn.message(mensajeError,"Error","Aceptar");							return;						}										frn.set("horas",getXmlAtt(cuboResultados,"r0","c4"));						frn.set("comentarios",getXmlAtt(cuboResultados,"r0","c7"));												frn.set("horario_ini",getXmlAtt(cuboResultados,"r0","c9"));						frn.set("horario_fin",getXmlAtt(cuboResultados,"r0","c10"));											}					}			}								fun Execute() {						var xmlRequest,cmd,cuboResultados,ok,cmd,cubo, mensajeError ;								var resultado_confirmacion = frn.message("¿ Estas seguro ?","Mensaje de Confirmacion", 2);									if (resultado_confirmacion &! 1)  {					return;				}																	xmlRequest = getXml(frn.dataPag()); 							frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmd="SELECT * FROM keplersc.tiempos_no_disponibles_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";					cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"tiempos_no_disponibles_crud.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");													var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;						}												if (accion &= "Nuevo" || accion &= "Modificar") {									var mensaje = "Registro guardado";					var renglon = 0;					if (accion &= "Modificar" ){						mensaje = "Registro modificado";						renglon = -1;					}										frP.setX(frn.get("fecha"),"tabla",renglon ,"fecha"); 					frP.scriptElm("tabla","OnChange","fecha");										var tip_ope = frn.get("tipo_ope", -1 , 1);											frP.setX(tip_ope ,"tabla",renglon ,"top"); 					frP.scriptElm("tabla","OnChange","top");									var cmd_tip_ope = "select c2 from keplersc.kdtoper where c1='" & tip_ope & "'";					var cubo_tip_ope = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd_tip_ope ,"tiempos_no_disponibles_crud.Execute()");					var desc_tip_ope =getXmlAtt(cubo_tip_ope ,"r0", "c2");										if (tip_ope &= "RECEP"){						desc_tip_ope = "RECEPCIONISTA";					}										frP.setX(desc_tip_ope ,"tabla",renglon ,"tipo_recep_ope_desc"); 					frP.scriptElm("tabla","OnChange","tipo_recep_ope_desc");												var ope = frn.get("operario",-1,1);					frP.setX(ope ,"tabla",renglon ,"recep_oper"); 					frP.scriptElm("tabla","OnChange","recep_oper");									var cmd_ope = "select c3 as re_ope from keplersc.kdoper where c1='" & ope & "'";									if (tip_ope &= "RECEP"){						cmd_ope = "select c2 as re_ope from keplersc.kdrecep where c1='" & ope & "'";					}										var cubo_ope = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd_ope ,"tiempos_no_disponibles_crud.Execute()");					var nombre_ope =getXmlAtt(cubo_ope ,"r0", "re_ope");										frP.setX(nombre_ope ,"tabla",renglon ,"nombre_recep_ope"); 					frP.scriptElm("tabla","OnChange","nombre_recep_ope");										frP.setX(frn.get("horas"),"tabla",renglon ,"horas"); 					frP.scriptElm("tabla","OnChange","horas");										frP.setX(frn.get("comentarios"),"tabla",renglon ,"comentarios"); 					frP.scriptElm("tabla","OnChange","comentarios");														frn.message(mensaje ,"Mensaje","Aceptar");					frn.exit();										}								if (accion &= "Eliminar"){											frP.setX("","tabla",-1,"fecha"); 					frP.scriptElm("tabla","OnChange","fecha");											frP.setX("","tabla",-1,"top"); 					frP.scriptElm("tabla","OnChange","top");										frP.setX("","tabla",-1,"tipo_recep_ope_desc"); 					frP.scriptElm("tabla","OnChange","tipo_recep_ope_desc");												frP.setX("","tabla",-1,"recep_oper"); 					frP.scriptElm("tabla","OnChange","recep_oper");										frP.setX("","tabla",-1,"nombre_recep_ope"); 					frP.scriptElm("tabla","OnChange","nombre_recep_ope");										frP.setX("","tabla",-1,"horas"); 					frP.scriptElm("tabla","OnChange","horas");										frP.setX("","tabla",-1,"comentarios"); 					frP.scriptElm("tabla","OnChange","comentarios");										frn.message("Registro eliminado","Mensaje","Aceptar");					frn.exit();									}						}									fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}																					fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}													}	</script></pag>