<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<tab/><txt fnt=",22" clr="0,0,0">Alta Sustitucion de Cobros</txt><br/>	<!-- dim="81,0" --> 	<tab/><hLine clr="0,0,0"/> 	<br/> <br/><tab/>		<!-- <grp dim="46,9,7,12" -->		<grp dim="48,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros"><txt>  Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>			<br/>			<txt>  Tipo :        </txt>			<cmb id="k_tipon" dim="52,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo()"/>			<br/>			<txt>  Fecha : </txt> <sp n="3"/> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" clrBrdr="255,255,255" available="Y" modify="N"/> 			<sp n="1"/> 			<tab n="1"/><inp id="statusdoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/>			<sp/><inp id="datcfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="3,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="1" modify="Y" available="Y" visible="N"/>								</grp>		<grp dim="36,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle Documento">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="Y" fnt=",18b" just="C"/><tab/> <br/>			<txt id="textFolio" visible="N">  Folio :  </txt>					<edt id="k_folio" dim="30,1" brdr="2,0" nc="10" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" visible="N" OnF9="ObtenerFolio()" OnChange="Formar_folio()" OnButton="ObtenerFolio()"/> 			<tab n="2"/><img id="buscar" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="BuscarFolio()" available="N" clrBrdr="0,0,0" visible="N"/>			<br/>			<sp n="1"/>			<inp id="k_docto" dim="37,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="Y" fnt=",16b" just="C"/>						<sp n="3"/>												<br/>					</grp>		<br/><tab/>		<grp dim="84,25,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<br/>             <sp n="1"/>            <txt id="txt_facturax" visible="Y">Tipo docto. a sustituir </txt>				<cmb id="k_tipo_sus" dim="45,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" fnt=",16" OnChange="borrar_datos()" available="Y"/><tab n="2"/>				<txt>Folio Cobro  </txt>				<inp id="k_folio_cobro" clr="64,64,64" clrBrdr="255,255,255" dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="-1" available = "Y" modify="Y" visible="Y" 					OnChange="Formar_folio_cobro()" OnF9="BusquedaFolioCobro()" tooltip="Folio Cobro [F9]"/>								<sp n="1"/>							<img id="buscar_folio_cobro" dim="20,20"  brdr="0,1" bPx="Y" img="_20_Find.png" OnEnter="MostrarFolioCobro()" clrBrdr="0,0,0" visible="Y" modify="Y" available="Y"/>            <br/>			<sp n="1"/> <txt clr="0,58,112" hk="P">Cliente: </txt><tab/>			<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnChange="BuscarCliente()"					OnF11 = "Dialog(3,cat_cli_crud,Modificar,x,s,k_clave)" 					type="capital" nc="7" tooltip="Cliente ( F11 Modificar )" modify="N" hk="C" available="Y"/> 			<sp n="5"/> <inp id="c_dias" clr="64,64,64"  dim="4,1" fnt="Arial,16" type="string" nc="4" modify="N" available="N" visible="N"/>			<sp n="1"/> <txt>RFC : </txt> <sp n="5"/>			<inp id="k_rfc" clr="64,64,64"  dim="18,1" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>							    <tab/>			<sp n="9"/> <txt>C.P. : </txt> <sp n="1"/>			<inp id="k_cp" clr="64,64,64"  dim="7,1" fnt="Arial,16" type="string" nc="5" modify="N" available="N"/>			<br/>			<sp n="9"/>			<inp id="k_nombrecli" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>			<br/>			<sp n="9"/>			<inp id="k_callecli" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>			<br/>			<sp n="9"/>			<inp id="k_coloniacli" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>			<br/>			<sp n="9"/>			<inp id="k_poblacioncli" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>			<br/>			<grp id="grpconceptosextras" tit="" dim="160,12,7,12" bclr="236,240,243" brdr="0,5" 			clrBrdr="0,58,112" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" fnt=",0" available="Y" modify="Y"><tab/>				<tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" 				bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="65,7"  hk="z"  Reorder="N" available="Y">										<col id="k_factura" name="Factura"  type="string"  modify="N"/>					<col id="k_monto_factura" name="Monto" OnChange="monto()" nd="2"  type="number" modify="Y"/>					<col id="k_iva_factura" name="IVA"  type="number" nd="6" min="0" modify="N"/>							</tbl>				<sp n="1"/> <txt clr="0,58,112">N O T A S:</txt>				<sp n="1"/> <inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="30,8" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="capital" nc="1000" bclr="255,255,255"/>										    </grp><br/>		</grp>		<br/><tab/>			<grp dim="84,15,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">									<grp dim="80,12,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">							<sp n="1"/> <txt>M&#233;todo de Pago: </txt> 				<sp n="2"/> <inp id="k_m_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="18,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16"   modify="Y" available="N" type="string"/>				<br/>				<sp n="1"/> <txt>Forma de Pago: </txt> 				<sp n="3"/>		<cmb id="k_f_pago" dim="18,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y"/>						<sp n="10"/> <txt>Antes de IVA : </txt><sp n="1"/> <inp id="subt" clr="64,64,64" nd="2" dim="15,1" fnt="Arial,16" type="number"  modify="N" available="N"/>								<br/>				<sp n="1"/> <txt>Cuenta : </txt> 				<sp n="4"/><tab/><sp/><tab/> <inp id="k_cuenta" clr="64,64,64" clrBrdr="255,255,255"  dim="18,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nd="0" min="0" OnChange="Plazo()" modify="Y" available="Y" fmt="5"/>				<sp n="10"/><txt>IVA : </txt> <sp n="9"/> 				<inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="6" modify="Y" available="N" OnChange="CalculaTotales(1)"/>				<br/>				<sp n="1"/> <txt>Uso del CFDI : </txt> 				<sp n="2"/><tab/> <inp id="k_cfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="18,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  modify="Y" available="N" type="string"/>				<sp n="10"/> <txt fnt=",16b">Importe : </txt>				<sp n="5"/> <inp id="k_monto" clr="64,64,64"  dim="15,1" fnt=",16b" type="number"   nd="2" modify="N" available="N" clrBrdr="255,255,255"/>				<br/>				<sp n="1"/> <txt>Correo Electr&#243;nico :</txt> <inp id="k_correo" clr="64,64,64" clrBrdr="255,255,255"  dim="35,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  modify="Y" available="N"/>				<br/><txt>  Fecha Pago :</txt><tab n="2"/>				<edt id="k_vence" clr="64,64,64"  dim="15,1" brdr="2,0" bclr="255,255,255" type="date" nc="-1" fnt="Arial,0"  fmt="DD/MM/CCYY" page="_ks_fecha,k_vence" OnF9="Dialog(3,_ks_fecha,k_vence)" clrBrdr="255,255,255" available="Y"/>						</grp>						<grp dim="80,12,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">							<tab n="3"/><br/><br/><tab n="5"/><br/><br/><br/><tab n="5"/>				<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="borrar_datos()" tooltip="Cancelar / Limpiar" available="Y" clrBrdr="0,0,0" visible="Y"/>				<sp n="3"/>				<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			</grp>						<br/>						<sp n="1"/> <inp id="k_err" dim="109,1" clr="132,20,7" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="140" fnt="Arial,16" visible = "N"/>					   		</grp>		<br/>		<br/>							</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario,asterisco,anio_contable;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, cliente_id , refer_id, resVal;			var str_uuid, fecha_uuid, rfc_uuid, total_uuid, rfc_receptor_uuid ;					var  saldo, cargos_factura, abonos_factura, cargos_iva_factura, abonos_iva_factura;			var fecha_baja, estatus_doc, iva_configurado  ;						var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, uen;                  var row_grid, err_data, err_empty;			// Vart Reports			var cmd, xmlResQuery, strTmp;			var sucursal, fech_oper, tipo_auto, xmlPar;													fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";				suc_usuario = frn.lib("libKepler","UserInfo(1)");								fileSavePath = "C:\Basura";				Inicializa();								ConfiguraControlesOpcion();			}						fun ConsultarClientes(ctrl_clave){				cmdQuery = "select c2 as clave, c3 as nombre, c10 as rfc from keplersc.kdud order by c2";				frn.dialog("genlistafiltrosel","Catalogo de clientes",cmdQuery,"clave",ctrl_clave,"0","0","N","S");						}									fun Inicializa(){			var tmpval;				// Our code 				// Revisa y Carga en Variables los Parametros Recibidos en la corrida				if( frn.nParam() == 6 ){ //Se han mandado par?metros a la p?gina                    gen_doc=trim(frn.param(0));                     nat_doc=trim(frn.param(1));                     gpo_doc=trim(frn.param(2));                    tip_doc=trim(frn.param(3));                     tip_ope=trim(frn.param(4));                    uen=trim(frn.param(5));                    tip_ope_original=tip_ope; /*220726*/            } else {               frn.message("Operacion no valida ...", "Mensaje","&Aceptar");               //frn.open("anuncios",4);               frn.open("redirect",2);			      return;            }            				if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					if(tip_ope &= "C"){ //CONSULTA						frn.set("operacion","CONSULTA");					} else {											frn.message("Operacion no valida ...", "Mensaje","&Aceptar");						//frn.open("anuncios",4);						frn.open("index",4);						return;					}				}								//Llenar combo sucursales				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";					}				}								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cob_AltadeCobros_crud.IniCombos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",cuboQuery);									// Fill Combo Tipo (Con Query FTO Kepler) 				LlenaCmbTipo();                LlenaCmbTipo_sus();								frn.set("k_m_pago", "PPD");								// Fill Combo forma de pago(Con Query de PostgreSQL)				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3fp";				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cob_AltadeCobros_crud.Inicializa()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_f_pago",cuboQuery);													frn.set("k_fecha",sys.date());									tip_doc = frn.get("k_tipon",-1,4); // 221005				frn.set("datcfdi","N");		//Pantalla validacion CFDI								// Fill k_docto | referencia docto				ArmarRefDocto();								LimpiaDatosCli();								configuraciones_kdmm();				if(tip_ope &= "A"){					fecha_config();				}			}						fun LlenaCmbTipo(){			// Fill Combo Tipo (Con Query FTO Kepler) 				cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm 								where col_sucursal='" & frn.get("k_sucn",-1,1) & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4>=11								order by c4";				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cob_AltadeCobros_crud.Inicializa()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboTipoDocto");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error BD","Aceptar");					return;				}				frn.set("k_tipon",getXml(cuboQuery));			}            			fun LlenaCmbTipo_sus(){				var cubo,cmd,ok,mensajeError;				var criterioin;				sucursal_id=frn.get("k_sucn",-1,1);						frn.rst("k_tipo_sus");                //Los tipos de movimientos solo seran correspondientes 1-11, 2-12, 3-13 etc				cmd = "select c5 || '-' || c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0') as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm 					where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3=" & gpo_doc;				cmd=cmd & " and right(c4::text,1)::integer in (" & mid(frn.get("k_tipon",-1,4),1,1) & ") order by c4";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTipoDoctoSus");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_tipo_sus",getXml(cubo));			}						fun fecha_config(){				//validar k_fecha				//se basa en k75 SUB CFD_FOLIO				sucursal_id=frn.get("k_sucn",-1,1);								cmdQuery = "select C4 from keplersc.kdcfdconfig where c1='" & sucursal_id & "'";								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.fecha_config()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery ,"C:\Basura\cuboc4");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fec = getXmlAtt(cuboQuery,"r"&0,"c4");					if (getXmlAtt(cuboQuery,"r"&0,"c4") &= "1"){					frn.set("k_fecha",sys.date(sys.date("year"),sys.date("month")-1,31));					//frn.message(sys.date(sys.date("year"));					//frn.message(sys.date("month"));				}else{					frn.set("k_fecha",sys.date());				}				Ajustes_doc();			}			//validaciones por tipo de documento 			fun Ajustes_doc() {				//se basa en k75 SUB DEFINE_CFD_LINKS y en SUB CFD_FOLIO				cmdQuery = "select c80 from keplersc.kdmm where col_sucursal='" & frn.get("k_sucn",-1,1) & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4='" & tip_doc & "'" ;				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.Ajustes_doc()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				if (getXmlAtt(cuboQuery,"r"&0,"c80") &= "S"){					frn.setAtt("k_fecha", "modify", "N" );				}else {					frn.setAtt("k_fecha", "modify", "Y" );				}			}							// Armado del Docto Referencia			fun ArmarRefDocto {				var cadena,tmpFolio, tmpGrupo, tmpTipo;				tmpFolio = frn.get("k_folio");				// //tmpFolio = frn.lib("libGeneral.kpl","PadLeft",tmpFolio,"7","0");				tmpFolio = PadLeft(tmpFolio,"7","0");				tmpGrupo = PadLeft(gpo_doc,"2","0");				tmpTipo = PadLeft(tip_doc,"3","0");				//cadena = trim(gen_doc) & trim(nat_doc) & trim(gpo_doc) & trim(tip_doc) & "-" & tmpFolio;				cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;				frn.set("k_docto", cadena);			}						fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         }                           fun borrar_datos(){				frn.set("k_clave", "");				LimpiaDatosCli();				frn.rst("k_mov");				frn.set("datcfdi","N");		//Pantalla validacion CFDI												LimpiaDatosDoc();				LimpiaTotalesDoc();				}											         fun LimpiaDatosCli() {         				frn.set("k_rfc", "");				frn.set("k_cp", "");				frn.set("k_nombrecli", "");				frn.set("k_callecli", "");				frn.set("k_coloniacli", "");				frn.set("k_poblacioncli", "");				frn.set("k_cuenta", "");				frn.set("k_cfdi", "");				frn.set("k_correo", "");						}									fun LimpiaDatosDoc() {                frn.set("k_folio_cobro", "");				frn.set("k_m_pago", "");				frn.set("k_f_pago", "");				frn.set("k_cuenta", "");				frn.set("k_cfdi", "");				frn.set("k_correo", "");				frn.set("k_plazo", "");				frn.set("k_vence", sys.date());				frn.set("k_coment", "");			}						fun LimpiaTotalesDoc() {				frn.set("subt", "");				frn.set("k_iva", "");				frn.set("k_monto", "");			}									fun ConfiguraControlesOff() {								frn.setAtt("textFolio", "visible", "N");				frn.setAtt("k_folio", "available", "N");				frn.setAtt("k_folio", "visible", "N");				frn.setAtt("k_fecha", "available", "N");				frn.setAtt("buscar", "available", "N");				frn.setAtt("buscar", "visible", "N");                frn.setAtt("k_tipo_sus", "available", "N");                frn.setAtt("k_folio_cobro", "available", "N");                frn.setAtt("buscar_folio_cobro", "available", "N");												frn.setAtt("k_clave", "available", "N");				frn.setAtt("subt", "available", "N");				frn.setAtt("k_plazo", "available", "N");				frn.setAtt("k_iva", "available", "N");				frn.setAtt("k_monto", "available", "N");				frn.setAtt("k_coment", "modify", "N");				frn.setAtt("k_coment", "available", "N");				frn.setAtt("k_mov", "available", "N");				frn.setAtt("k_f_pago", "available", "N");				frn.setAtt("k_cuenta", "available", "N");				frn.setAtt("k_vence", "available", "N");								frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											}						fun ConfiguraControlesOpcion() {							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta					frn.setAtt("k_fecha", "available", "Y");					frn.setAtt("k_clave", "available", "Y");					frn.setAtt("k_coment", "modify", "Y");					frn.setAtt("k_coment", "available", "Y");						frn.setAtt("k_mov", "available", "Y");					frn.setAtt("k_vence", "available", "Y");					frn.set("k_vence", sys.date());					frn.setAtt("k_f_pago", "available", "Y");					frn.setAtt("k_cuenta", "available", "Y");                    frn.setAtt("k_tipo_sus", "available", "Y");                    frn.setAtt("k_folio_cobro", "available", "Y");                    frn.setAtt("buscar_folio_cobro", "available", "Y");									frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");													} else {								frn.setAtt("buscar", "available", "Y");					frn.setAtt("buscar", "visible", "Y");												frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");					frn.setAtt("k_coment", "available", "Y");					frn.setAtt("k_mov", "available", "Y");				}			}									fun LimpiaEncabezado {				if(tip_ope &= "A"){ 					frn.set("k_folio", "");					frn.set("k_docto", "");				}				frn.set("k_fecha", "");				LimpiaDatosCli();				frn.set("k_clave", "");				frn.set("k_err", "");			}									fun CambiaSucursal {							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} 					}								}								LlenaCmbTipo();				borrar_datos();				frn.set("k_fecha",sys.date());									tip_doc = frn.get("k_tipon",-1,4); // 221005								ArmarRefDocto();				configuraciones_kdmm();				if(tip_ope &= "A"){					fecha_config();				}									} // END -	Fun - CambiaSucursal 									fun CambiaTipo {				borrar_datos();				if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} 					}								}											frn.set("k_fecha",sys.date());									tip_doc = frn.get("k_tipon",-1,4); 								ArmarRefDocto();													configuraciones_kdmm();                LlenaCmbTipo_sus();										} // END -	Fun - CambiaTipo 						fun configuraciones_kdmm(){						cmdQuery="select c16 from keplersc.kdmm where col_sucursal='" & frn.get("k_sucn",-1,1) & "' and c1 = '" & frn.get("k_tipon",-1,1) & "' and c2='" & frn.get("k_tipon",-1,2)& "' and c3='" & frn.get("k_tipon",-1,3) & "' and c4='" & frn.get("k_tipon",-1,4) & "'";					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cob_AltadeCobros_crud.configuraciones_kdmm()");							frn.lib("libGeneral.kpl","FileSave",cuboQuery ,fileSavePath & "\cob_AltadeCobros_crud");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}					iva_configurado  = getXmlAtt(cuboQuery, "r0", "c16" );				} 									fun BuscarCliente(){				var xmlCli;												sucursal_id = frn.get("k_sucn",-1,1);				cliente_id = frn.get("k_clave");				LimpiaDatosCli();						if (strlen(frn.get("k_clave")) == 0) {					return;				}								if (strlen(frn.get("k_refer")) > 0) {					refer_id = frn.get("k_refer");				} else {					frn.set("k_fecha_exp", "");				}								cmdQuery = "select c10 as k_rfc, c3 as k_nombrecli, c4 as k_callecli, c5 as k_coloniacli, c6 as k_poblacioncli, c27 as k_cp, c16 as k_plazo, c53 as k_cfdi, c11 as k_correo " &									"from keplersc.kdud where c2='" & cliente_id & "'" ;									frn.lib("libGeneral.kpl","FileSave",cmdQuery , fileSavePath & "\cmdQuery");									rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.BuscarCliente()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.setPos("k_clave");					frn.message("El cliente no existe","Error","Aceptar");					return;					}				rstXml(xmlCli);				xmlCli=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");				frn.setX(xmlCli);									}						//----------------------------------------------------------FACTURAS---------------------------------------------		fun SeleccionarFactura(){					sucursal_id = frn.get("k_sucn",-1,1);			cliente_id = frn.get("k_clave");			if (strlen(cliente_id ) == 0){				borrar_datos_factura();				frn.message("Debes Seleccionar un Cliente.","Error","Aceptar");					return;			}			//Obtener registros de facturas pendientes del cliente			cmdQuery = "select c4 as factura, c6 as monto, c8 as iva, c11 as fecha_expedicion from keplersc.kduxg where c1='" & sucursal_id  & "' and c3='" & cliente_id & "' and c10=0";			frn.dialog("genlistafiltrosel","Facturas pendientes",cmdQuery,"factura","k_mov",-1,"k_factura","S","S");						}				fun ObtenerFactura(){					str_uuid=frn.get("k_mov",-1,"k_factura");			var nreg = frn.N("k_mov")-1;			if (nreg != 1){				for(var i=0; i<nreg - 1; i++){					if ( frn.get("k_mov",i,"k_factura") &= str_uuid ){						frn.message("Ya seleccionaste esta factura.","Error","Aceptar");						borrar_datos_factura();						return;					}				}						}														var res = factura_cargos_abonos(str_uuid);			if (res == 1){				return ;			}						var monto = cargos_factura - abonos_factura ;					frn.setX(monto ,"k_mov", -1, "k_monto_factura");			monto();						}					fun monto(){					cliente_id = frn.get("k_clave");			if (strlen(cliente_id ) == 0){				borrar_datos_factura();				frn.message("Debes Seleccionar un Cliente antes","Error","Aceptar");				return;			}								sucursal_id = frn.get("k_sucn",-1,1);			var factura = frn.get("k_mov", -1, "k_factura");			var res = factura_cargos_abonos(factura);			if (res == 1){				return ;			}						var monto_factura = frn.get("k_mov", -1, "k_monto_factura");			if (monto_factura <= 0){				frn.message("No se puede dejar el monto en 0s","Error","Aceptar");				frn.setX(cargos_factura - abonos_factura ,"k_mov", -1, "k_monto_factura");				iva();				return;			}								var saldo_temporal = (monto_factura  + abonos_factura ) - cargos_factura ;						if (saldo_temporal > 0){				frn.message("No puede pagar superior al saldo de una factura","Error","Aceptar");				frn.setX(cargos_factura - abonos_factura ,"k_mov", -1, "k_monto_factura");				iva();				return;			}						iva();				}						fun iva(){			var factura_cob, num_reg, porcIva, monto, iva;			factura_cob = frn.get("k_mov", -1, "k_factura");			monto = frn.get("k_mov", -1, "k_monto_factura");						cmdQuery = "select mm.c16 as porcIva " & 					"from keplersc.kdm1 m1 " &					"inner join keplersc.kdmm mm on col_sucursal=m1.c1 and mm.c1=m1.c2 and mm.c2=m1.c3 and mm.c3=m1.c4 and mm.c4=m1.c5 " &					"where m1.c1='" & sucursal_id  & "' and m1.c6='" & factura_cob & "' and m1.c10='" & cliente_id & "'";							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cob_AltadeCobros_crud.iva()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery ,fileSavePath & "\IvaKdmmCobros");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			var totReg=nXml(cuboQuery);			porcIva= getXmlAtt(cuboQuery, "r0", "porciva");			if(totReg==0){				frn.message("El movimiento de la Factura no esta registrado.","Error","Aceptar");				borrar_datos_factura();				return 1;			} else if(totReg==1){				iva = monto*(1-(1/(1+porcIva/100)));					// calculo iva k75 A103=A102*(1-(1/(1+M16/100)))							}			else if(totReg>1){ //Asi estaba el calculo antes				iva = (monto * cargos_iva_factura)/cargos_factura;						}						if (iva_configurado == 0){				iva = 0;			}			frn.setX(iva ,"k_mov", -1, "k_iva_factura");						CalcTotal();		}				fun CalcTotal() { 					var monto_facturas =0, iva_facturas=0; 							for (var i=0,n=frn.N("k_mov")-1;i<n;i++) { 				monto_facturas=monto_facturas +frn.get("k_mov",i,"k_monto_factura");				iva_facturas=iva_facturas+frn.get("k_mov",i,"k_iva_factura");			}						frn.set("subt", monto_facturas - iva_facturas, "k_iva" ,iva_facturas, "k_monto", monto_facturas);				}				fun borrar_datos_factura(){			frn.setX("", "k_mov", -1, "k_factura");			frn.setX("", "k_mov", -1, "k_monto_factura");			frn.setX("", "k_mov", -1, "k_iva_factura");				}								fun factura_cargos_abonos(factura) {						cmdQuery="SELECT c6 as cargos, c7 as abonos, c8 as cargos_iva,c9 as abonos_iva from keplersc.kduxg where c1 = '" & sucursal_id & "' and c2='" & gen_doc & "'";			cmdQuery = cmdQuery & " and c3='" & cliente_id & "' and c4='" & factura  & "'";						frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\RequestCrudCheque");								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_cheque_crud.factura_cargos_abonos()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery ,fileSavePath & "\cuboQueryCrudCheque");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			var totReg=nXml(cuboQuery);			if(totReg==0){				frn.message("La Factura no esta registrada todavia.","Error","Aceptar");				borrar_datos_factura();				return 1;			}						cargos_factura= getXmlAtt(cuboQuery, "r0", "cargos" );			abonos_factura= getXmlAtt(cuboQuery, "r0", "abonos" );			cargos_iva_factura= getXmlAtt(cuboQuery, "r0", "cargos_iva" );			abonos_iva_factura= getXmlAtt(cuboQuery, "r0", "abonos_iva" );		}													//---------------------------------------EJECUTA---------------------------------			fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua, valTmp;			var resultado, mensaje, folio;							fecha = sys.date();			hora= sys.time();							if (tip_ope &= "A") {							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok							var cmp_fechas = fnDate("cmp", fecha , frn.get("k_vence") ) ;								if(cmp_fechas == -1){					frn.message("La fecha de pago debe ser igual o menor al dia de hoy.","Error","Aceptar");					return;				}								valTmp=frn.get("k_monto");				if(valTmp<=0){					frn.message("El importe no puede ser cero.","Error","Aceptar");					return;				}				//Pantalla validacion CFDI				if (frn.get("datcfdi") &= "N"){					frn.dialog("icfdreview",frn.get("k_sucn",-1,1),frn.get("k_clave"),"Ejecuta","cmb",frn.get("k_f_pago",-1,1),frn.get("k_cuenta"),frn.get("k_m_pago"), "inp", frn.get("k_cfdi"));					return;				}									continua = frn.message("Desea continuar con la alta de la factura?","Atencion",2);				if (continua == 0){					frn.set("datcfdi","N");					return;				}								xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;											setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov") -1);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				//PARAMETRO NECESARIO PARA FUNCION cxcp_alta_conmov()				setXml(xmlPantalla,"k_tabla_mov","kdm5");            setXml(xmlPantalla,"k_gendocto",frn.get("k_tipo_sus",-1,1));				setXml(xmlPantalla,"k_natdocto",frn.get("k_tipo_sus",-1,2));				setXml(xmlPantalla,"k_gpodocto",frn.get("k_tipo_sus",-1,3)); //definido para Alta				setXml(xmlPantalla,"k_tipodocto",frn.get("k_tipo_sus",-1,4)); 				setXml(xmlPantalla,"k_foliodocto",frn.get("k_folio_cobro"));				setXml(xmlPantalla,"k_tipo_rel","04");				setXml(xmlPantalla,"ambiente","flag_factura_sust","FACTURA_X_SUST");												cmd="select * from keplersc.verify_es_cobro_sustituible('" & sucursal_id & "','" & frn.get("k_tipo_sus",-1,1) & "','" & frn.get("k_tipo_sus",-1,2) & "','" & frn.get("k_tipo_sus",-1,3) & "','" & frn.get("k_tipo_sus",-1,4) & "','" & frn.get("k_folio_cobro") & "')";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.MostrarCliente()");frn.lib("libGeneral.kpl","FileSave",cuboQuery,"C:\Basura\verify_es_factura_sustituible");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboQuery,"native3");					frn.message(mensajeError,"Error en consulta","Aceptar");					return;				}												var resVerify=getXmlAtt(cuboQuery,"r0","resultado");				var menVerify=getXmlAtt(cuboQuery,"r0","mensaje");				var adicVerify=getXmlAtt(cuboQuery,"r0","adicionales");				if (resVerify==0){					//BorraDatosPantalla();					frn.message(menVerify,"Error","Aceptar");					return;									}									frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCobrosSust");				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";								rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cob_AltadeCobros_crud.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCobros");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					tip_ope = "C";					frn.set("k_folio", mensaje); 					frn.set("operacion", "CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto", strTmp);					strMsg = "El Folio utilizado para esta operacion fue : " & mensaje;					ConfiguraControlesOpcion(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");					//MostrarDatos(folio);						//BuscarFolio();				} else {					frn.message(mensaje, "Error", "Aceptar");					frn.set("datcfdi","N");	//Pantalla validacion CFDI				}			}						}		//--------------------------------------------------------------CONSULTA--------------------------------				fun BuscarFolio() {			var folio;			folio = frn.get("k_folio");			//folio = PadLeft(folio, 7, "0");			ArmarRefDocto();			borrar_datos();			MostrarDatos(folio);								}						fun MostrarDatos(nFolio) {					var xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError,   ;						sucursal_id = frn.get("k_sucn",-1,1);					cmd= " select c10 as k_clave, c9 as k_fecha, c24 as k_coment, c43 as estatus_doc ,c38 as tipo_docto, c39 as k_foliodocto, c197 as fecha_baja, " &				"c160 as k_f_pago, c161 as k_cuenta, c162 as k_m_pago, c164 as k_cfdi, c165 as k_correo, c18 as k_vence, " &				"c32 as k_nombre, c33 as k_calle,c34 as k_colonia,c35 as k_poblacion, c163 as k_cp, c22 as k_rfc " &				"from keplersc.kdm1 where c1='" & sucursal_id  & "' and c2='" & gen_doc  &"' and c3='" & nat_doc & "' and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_AltadeCobros_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultadoskdm1");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			var xml_kdm1  = getXml(cuboResultados,"r0" );			frn.set("k_folio_cobro",getXmlAtt(xml_kdm1,"k_foliodocto"));			frn.set("k_tipo_sus",descr_combo("k_tipo_sus",4,getXmlAtt(xml_kdm1,"tipo_docto")));			frn.set("k_clave",getXmlAtt(xml_kdm1  ,"k_clave") );			//BuscarCliente();			frn.set("k_fecha",getXmlAtt(xml_kdm1 ,"k_fecha") );			frn.set("k_coment",getXmlAtt(xml_kdm1   ,"k_coment") );						var f_pago = getXmlAtt(xml_kdm1   ,"k_f_pago");			frn.set("k_f_pago",descr_combo("k_f_pago",1, f_pago ));						frn.set("k_cuenta",getXmlAtt(xml_kdm1   ,"k_cuenta") );			frn.set("k_m_pago",getXmlAtt(xml_kdm1   ,"k_m_pago") );			frn.set("k_cfdi",getXmlAtt(xml_kdm1   ,"k_cfdi") );			frn.set("k_correo",getXmlAtt(xml_kdm1   ,"k_correo") );			frn.set("k_vence",getXmlAtt(xml_kdm1   ,"k_vence") );			frn.set("k_rfc",getXmlAtt(xml_kdm1,"k_rfc") );			frn.set("k_cp",getXmlAtt(xml_kdm1,"k_cp") );			frn.set("k_nombrecli",getXmlAtt(xml_kdm1,"k_nombre") );			frn.set("k_callecli",getXmlAtt(xml_kdm1,"k_calle") );			frn.set("k_coloniacli",getXmlAtt(xml_kdm1,"k_colonia") );			frn.set("k_poblacioncli",getXmlAtt(xml_kdm1,"k_poblacion") );			fecha_baja = getXmlAtt(xml_kdm1  ,"fecha_baja");			estatus_doc = getXmlAtt(xml_kdm1  ,"estatus_doc");							if (estatus_doc &= "C"){	// C=Cancelado				frn.message("El Documento se encuentra cancelado","Error","Aceptar");				frn.set("statusdoc", "CANCELADO");			}else{				frn.set("statusdoc", "");			}			rstXml(cmd);							cmd = "select c14 as k_factura,c12 as k_monto_factura,c13 as k_iva_factura from keplersc.kdm5 where c1='" & sucursal_id & "' and c2='" & gen_doc &"' and c3='" & nat_doc & "'";			cmd = cmd & " and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_AltadeCobros_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultadoskdm5");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}						frn.setX(cuboResultados , "k_mov");			CalcTotal();																} //End MostrarDatos()		//------------------------------------------------FOLIO COBRO-----------------------------------------------							fun BusquedaFolioCobro() {			var v_tipo_n;			v_tipo_n = frn.get("k_tipo_sus",-1,4);			sucursal_id = frn.get("k_sucn",-1,1);									cmdQuery = "select c6 as folio, to_char(c9, 'dd/mm/yyyy') as fecha,c10 as cliente, c16 as monto, "; 			cmdQuery = cmdQuery & "(select mensaje from keplersc.verify_es_cobro_sustituible(c1,c2,c3,c4::text,c5::text,c6)) as estatus ";			cmdQuery = cmdQuery & "from keplersc.kdm1 where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc&  "' and c3 = '" & nat_doc&  "' and c4 = '" & gpo_doc &  "' and c5 = '" & v_tipo_n & "' ";			cmdQuery = cmdQuery & " order by c9 desc ";	        frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\cmdVe");			frn.dialog("genlistafiltrosel","Folios Cobro",cmdQuery,"folio","k_folio_cobro","0","0","S","N");		}        fun MostrarFolioCobro(){            var xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError,   ;			var factSust,resVerify, menVerify,adicVerify, fact_nueva;			sucursal_id = frn.get("k_sucn",-1,1);					cmd= " select c10 as k_clave, c24 as k_coment, c43 as estatus_doc, c197 as fecha_baja, " &					"c160 as k_f_pago, c161 as k_cuenta, c162 as k_m_pago, c164 as k_cfdi, c165 as k_correo, " &				"c32 as k_nombre, c33 as k_calle,c34 as k_colonia,c35 as k_poblacion, c163 as k_cp, c22 as k_rfc " &				"from keplersc.kdm1 where c1='" & sucursal_id  & "' and c2='" & frn.get("k_tipo_sus",-1,1)  &"' and c3='" & frn.get("k_tipo_sus",-1,2) & "' and c4='" & frn.get("k_tipo_sus",-1,3) & "' and c5='" & frn.get("k_tipo_sus",-1,4) & "' and c6='" & frn.get("k_folio_cobro") & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_AltadeCobrosSustitucion_crud.MostrarFolioCobro()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultadoskm1");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			var xml_kdm1  = getXml(cuboResultados,"r0" );			frn.set("k_clave",getXmlAtt(xml_kdm1  ,"k_clave") );			frn.set("k_coment",getXmlAtt(xml_kdm1   ,"k_coment") );						var f_pago = getXmlAtt(xml_kdm1   ,"k_f_pago");			frn.set("k_f_pago",descr_combo("k_f_pago",1, f_pago ));						frn.set("k_cuenta",getXmlAtt(xml_kdm1   ,"k_cuenta") );			frn.set("k_m_pago",getXmlAtt(xml_kdm1   ,"k_m_pago") );			frn.set("k_cfdi",getXmlAtt(xml_kdm1   ,"k_cfdi") );			frn.set("k_correo",getXmlAtt(xml_kdm1   ,"k_correo") );			frn.set("k_rfc",getXmlAtt(xml_kdm1,"k_rfc") );			frn.set("k_cp",getXmlAtt(xml_kdm1,"k_cp") );			frn.set("k_nombrecli",getXmlAtt(xml_kdm1,"k_nombre") );			frn.set("k_callecli",getXmlAtt(xml_kdm1,"k_calle") );			frn.set("k_coloniacli",getXmlAtt(xml_kdm1,"k_colonia") );			frn.set("k_poblacioncli",getXmlAtt(xml_kdm1,"k_poblacion") );					fecha_baja = getXmlAtt(xml_kdm1  ,"fecha_baja");			estatus_doc = getXmlAtt(xml_kdm1  ,"estatus_doc");							if (estatus_doc &= "C"){	// C=Cancelado				frn.message("El Documento se encuentra cancelado","Error","Aceptar");				frn.set("statusdoc", "CANCELADO");			}else{				frn.set("statusdoc", "");			}			rstXml(cmd);							cmd = "select c14 as k_factura,c12 as k_monto_factura,c13 as k_iva_factura from keplersc.kdm5 where c1='" & sucursal_id & "' and c2='" & frn.get("k_tipo_sus",-1,1) &"' and c3='" & frn.get("k_tipo_sus",-1,2) & "'";			cmd = cmd & " and c4='" & frn.get("k_tipo_sus",-1,3) & "' and c5='" & frn.get("k_tipo_sus",-1,4) & "' and c6='" & frn.get("k_folio_cobro") & "'";						frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultadoskdm5");			cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_AltadeCobrosSustitucion_crud.MostrarFolioCobro()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultadoskdm5");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}					frn.setX(cuboResultados , "k_mov");			//Si es factura sustituida mostrar la factura nueva, si no mostrar la factura del recibo			if (frn.N("k_mov")-1 == 1){				cmd = "select c6 as fact_nueva from keplersc.kdm1 where c39='" & frn.get("k_mov",-1,"k_factura") & "' and tipo_relacion ='04'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_AltadeCobrosSustitucion_crud.MostrarFolioCobro()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultadosfact_nueva");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				fact_nueva = getXmlAtt(cuboResultados,"r0","fact_nueva");				if (fact_nueva &! "") {					frn.setX(fact_nueva,"k_mov", -1, "k_factura");					frn.message("Es un cobro de factura por sustitución","Atencion","Aceptar");				}			}			CalcTotal();            cmd="select * from keplersc.verify_es_cobro_sustituible('" & sucursal_id & "','" & frn.get("k_tipo_sus",-1,1) & "','" & frn.get("k_tipo_sus",-1,2) & "','" & frn.get("k_tipo_sus",-1,3) & "','" & frn.get("k_tipo_sus",-1,4) & "','" & frn.get("k_folio_cobro") & "')";				rstXml(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_AltadeCobrosSustitucion_crud.MostrarFolioCobro()");frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\verify_es_factura_sustituible");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Error en consulta","Aceptar");					return;				}												resVerify=getXmlAtt(cuboResultados,"r0","resultado");				menVerify=getXmlAtt(cuboResultados,"r0","mensaje");				adicVerify=getXmlAtt(cuboResultados,"r0","adicionales");				if (resVerify==0){					borrar_datos();					frn.message(menVerify,"Error","Aceptar");					return;									}        }				//--------------------------------------------------------------EXTRAS---------------------------------------------------								fun ObtenerFolio() {			sucursal_id = frn.get("k_sucn",-1,1);			cmdQuery = "select c6 as folio, to_char(c9, 'DD/MM/YYYY') as fecha, c10 as cve_cliente, " &						" c16 as monto, c43 estatus " &						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc						& " order by c6 desc";									frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryfoliomov");							frn.dialog("genlistafiltrosel","Folios de Documentos",cmdQuery,"folio","k_folio","0","","S");					}						fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);		}						fun Formar_folio_cobro(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio_cobro"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipo_sus",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipo_sus",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipo_sus",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipo_sus",-1,4));				setXml(xmlReqEst,"document","uen",uen);                //frn.lib("libGeneral.kpl","FileSave",xmlReqEst,"C:\Basura\xmlReqFolio");				borrar_datos();					cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio_cobro", fol);			}				fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    				1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 				2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 				3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				// var tip_ope; 				var tip_oper;				if(iModo==0)					page=pag; 				else if(iModo==2&&(strlen(par0)>0)){					//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     			}													} // End of class Main			</script></pag>