<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Bonos por L&#237;nea"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">	<tab/><txt fnt=",22" clr="0,0,0">Comisiones Telemarketing</txt><tab/>	<br/><tab/><hLine clr="0,0,0"/><br/><br/><tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" 		clrBrdr="0,58,112" dim="40,5,10,17" brdr="0,5" tit="Criterio de selecci&#243;n" fnt="Arial,16"><txt> Sucursal:</txt>		<sp/>		<cmb id="k_sucn" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="Y" Null="N" OnChange="ResetDetalle()"/>		<tab/><txt>A&#241;o:</txt>				<cmb  id="k_anio" dim="5,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y" fnt="Arial,0" Null="N" OnChange="ResetDetalle()"/>		<tab/><txt>  Mes:</txt>		<cmb id="k_mes" dim="5,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y" fnt="Arial,0" Null="N" OnChange="ResetDetalle()"/><tab/><txt>Quincena:</txt>		<cmb id="k_quincena" dim="12,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"/><tab/>				<br/><txt> Asesor:</txt>		<cmb id="k_asesor" dim="30,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y" fnt="Arial,0" Null="N" OnChange="ResetDetalle()"/><tab/>				<img id="img_buscar" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="ConsultarComisiones()"/>			</grp>	<br/><br/><tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="40,14,10,17" brdr="0,5" tit="Paquetes" fnt="Arial,16">		<sp/>		<tbl id="k_paq" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="78,11" modify="Y" Reorder="Y" nren="fijo" available="Y">			<col name="Asesor" id="k_p_asesor" modify="N" type="capital" nc="10" visible="Y"/>			<col name="Quincena" id="k_p_quincena" modify="N" type="capital" nc="10" visible="Y"/>			<col name="Cita" id="k_p_cita" modify="N" type="capital" nc="10" visible="Y"/>			<col name="T" id="k_p_tipo_orden" modify="N" type="capital" nc="2" visible="Y"/>						<col name="Orden" id="k_p_orden" modify="N" type="capital" nc="10" visible="Y"/>						<col name="Paquete" id="k_p_paquete" modify="N" type="capital" nc="5" visible="Y"/>         <col name="Descripci&#243;n" id="k_p_descrip" modify="N" type="capital" nc="30" visible="Y"/>			<col name="Comisi&#243;n" id="k_p_comision" type="number" nc="10" visible="Y" nd="2"/>		</tbl>		<br/><txt fnt=",b">  Primera quincena: </txt>		<inp id="inp_p_q1" dim="10,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" available="Y" modify="N" just="R" nd="2" fnt=",0b"/><tab/><txt fnt=",b">Segunda quincena: </txt>		<inp id="inp_p_q2" dim="10,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" available="Y" modify="N" just="R" nd="2" fnt=",0b"/>	</grp>	<br/><br/><tab/>		<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="40,14,10,17" brdr="0,5" tit="Resumen comisiones" fnt="Arial,16">		<sp/>		<tbl id="k_tipo" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="78,11" modify="Y" Reorder="Y" nren="fijo" available="Y">			<col name="Asesor" id="k_t_asesor" modify="N" type="capital" nc="10" visible="Y"/>			<col name="Tipo" id="k_t_tipo" modify="N" type="capital" nc="10" visible="Y"/>						<col name="Quincena" id="k_t_quincena" modify="N" type="capital" nc="10" visible="Y"/>			<col name="Lim. Inf." id="k_t_inf" modify="N" type="capital" nc="4" visible="Y"/>						<col name="Lim. Sup" id="k_t_sup" modify="N" type="capital" nc="4" visible="Y"/>			<col name="Comisi&#243;n" id="k_t_comision" type="number" nc="10" visible="Y" nd="2" modify="N"/>			<col name="Citas" id="k_t_citas" type="number" nc="5" visible="Y" modify="N"/>					<col name="Total" id="k_t_total" type="number" nc="10" visible="Y" nd="2" modify="N"/>						</tbl><br/><txt fnt=",b">  Primera quincena: </txt>		<inp id="inp_t_q1" dim="10,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" available="Y" modify="N" just="R" nd="2" fnt=",0b"/><tab/><txt fnt=",b">Segunda quincena: </txt>		<inp id="inp_t_q2" dim="10,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" available="Y" modify="N" just="R" nd="2" fnt=",0b"/><tab n="4"/><txt fnt=",b">Total: </txt><inp id="totComis" dim="12,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" fnt=",0b" just="R" nd="2"/>	</grp>		</grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;		var tipoOper,consPlantilla, accion; //Variables relacionadas con parametros (colsulta , eliminar, baja)		var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna, clave, modelo, clave_2; 		var cmdQuery, cuboQuery, ok, mensajeError;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			rol_usuario = frn.config("user","role");			asterisco = "*";			llena_combos();			ConfiguraUI();			Inicializa();		}            		fun llena_combos(){			var cont,maxCont,nMes;								//Llenar combo sucursales			var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmd = cmd & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmd = cmd & " where c1='" & suc_usuario & "'";				}			}							var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");					ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}								frn.set("k_sucn",getXml(cubo));														//Anio			maxCont=mid(fnDate(sys.date()),2,4);			for(cont=20; cont<=maxCont; cont++) {				frn.setX(cont,"k_anio",cont-20,0);							frn.setX(cont,"k_anio",cont-20,1);			}			frn.set("k_anio",mid(fnDate(sys.date()),2,2));									//Mes			maxCont=12;			for(cont=1; cont<=maxCont; cont++) {				nMes=cont;				if (strlen(nMes) == 1){					nMes="0" & nMes;				}				frn.setX(nMes,"k_mes",cont-1,0);				frn.setX(nMes,"k_mes",cont-1,1);			}			nMes=fnDate("month",sys.date());			if (strlen(nMes) == 1){				nMes="0" & nMes;			}						frn.set("k_mes",nMes);						//Opcion copiar mes pasado			frn.setX("PRIMERA","k_quincena",0,0);						frn.setX("1","k_quincena",0,1);			frn.setX("SEGUNDA","k_quincena",1,0);			frn.setX("2","k_quincena",1,1);			frn.setX("AMBAS","k_quincena",2,0);			frn.setX("0","k_quincena",2,1);			//Asesores			cmdQuery = "select * from (select 'TODOS' as c2, 'TODOS' as c1 union select c2, c1  from keplersc.kdsercattmkt where c3='A') as res order by c2";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"tmkt_comisiones_rep.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_asesor",cuboQuery);		}				fun ResetDetalle(){			frn.rst("k_paq");			frn.rst("k_tipo");		}				fun ConsultarComisiones(){			var totQ1,totQ2,totComis,cont, nMax,factor,cantidad,comision,quincena,nRenglon;			cmdQuery = "select asesor_tmkt as k_p_asesor,";			cmdQuery = cmdQuery & "case when periodo='1' then 'PRIMERA' else 'SEGUNDA' end as k_p_quincena, ";			cmdQuery = cmdQuery & "folio_cita as k_p_cita, ";			cmdQuery = cmdQuery & "tipo_orden as k_p_tipo_orden, ";			cmdQuery = cmdQuery & "folio_orden as k_p_orden, ";			cmdQuery = cmdQuery & "clave_paquete as k_p_paquete, ";			cmdQuery = cmdQuery & "desc_punto as k_p_descrip, ";			cmdQuery = cmdQuery & "paq_comision as k_p_comision ";			cmdQuery = cmdQuery & "from keplersc.kdtmktcomis_det ";			cmdQuery = cmdQuery & "where sucursal = '" & frn.get("k_sucn",-1,1) & "' ";			cmdQuery = cmdQuery & "and anio='" & frn.get("k_anio",-1,1) & "' and mes='" & frn.get("k_mes",-1,1) & "' ";			if (frn.get("k_asesor",-1,1) &! "TODOS"){				cmdQuery = cmdQuery & "and asesor_tmkt='" & frn.get("k_asesor",-1,1) & "' ";						}			if (frn.get("k_quincena",-1,1) &! "0"){				cmdQuery = cmdQuery & "and periodo='" & frn.get("k_quincena",-1,1) & "' ";						}			cmdQuery = cmdQuery & "order by asesor_tmkt,folio_orden,periodo ";			cmdQuery = cmdQuery & "";frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\xmlTmktComisiones");						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"tmkt_comisiones_rep.IniCombos()");frn.lib("libGeneral.kpl","FileSave",cuboQuery,"C:\Basura\xmlTmktComisiones");						ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_paq",cuboQuery);								totQ1=0;			totQ2=0;			nMax=frn.N("k_paq");			for(cont=0; cont<nMax; cont++){				comision=frn.get("k_paq",cont,"k_p_comision");				quincena=frn.get("k_paq",cont,"k_p_quincena");				if(quincena &= "PRIMERA"){					totQ1 = totQ1 + comision;				}else{					totQ2 = totQ2 + comision;				}			}			frn.set("inp_p_q1",totQ1);			frn.set("inp_p_q2",totQ2);						//Resumen			cmdQuery = "select asesor_tmkt as k_t_asesor,";			cmdQuery = cmdQuery & "tipo_trabajo as k_t_tipo, ";//			cmdQuery = cmdQuery & "case when tipo_trabajo ='P' then 'PROACTIVA' else 'PASIVA' end as k_t_tipo, ";			cmdQuery = cmdQuery & "case when periodo='1' then 'PRIMERA' else 'SEGUNDA' end as k_t_quincena, ";						cmdQuery = cmdQuery & "inferior as k_t_inf, ";			cmdQuery = cmdQuery & "superior as k_t_sup, ";			cmdQuery = cmdQuery & "comision as k_t_comision, ";			cmdQuery = cmdQuery & "citas as k_t_citas, ";			cmdQuery = cmdQuery & "comision*citas as k_t_total ";			cmdQuery = cmdQuery & "from keplersc.kdtmktcomis_trabajo ";			cmdQuery = cmdQuery & "where sucursal = '" & frn.get("k_sucn",-1,1) & "' ";			cmdQuery = cmdQuery & "and anio='" & frn.get("k_anio",-1,1) & "' and mes='" & frn.get("k_mes",-1,1) & "' ";			if (frn.get("k_asesor",-1,1) &! "TODOS"){				cmdQuery = cmdQuery & "and asesor_tmkt='" & frn.get("k_asesor",-1,1) & "' ";						}			if (frn.get("k_quincena",-1,1) &! "0"){				cmdQuery = cmdQuery & "and periodo='" & frn.get("k_quincena",-1,1) & "' ";						}			cmdQuery = cmdQuery & "order by asesor_tmkt,periodo,tipo_trabajo";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"tmkt_comisiones_rep.IniCombos()");frn.lib("libGeneral.kpl","FileSave",cuboQuery,"C:\Basura\xmlTmktComisTipo");						ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_tipo",cuboQuery);							//Paquetes			nRenglon=frn.N("k_tipo");			frn.setX("k_tipo",nRenglon,"k_t_tipo","PAQUETE");			frn.setX("k_tipo",nRenglon,"k_t_tipo","PRIMERA");												totQ1=0;			totQ2=0;			nMax=frn.N("k_tipo");			for(cont=0; cont<nMax; cont++){				comision=frn.get("k_tipo",cont,"k_t_total");				quincena=frn.get("k_tipo",cont,"k_t_quincena");				if(quincena &= "PRIMERA"){					totQ1 = totQ1 + comision;				}else{					totQ2 = totQ2 + comision;				}			}						totComis=totQ1 + totQ2;						frn.set("inp_t_q1",totQ1);			frn.set("inp_t_q2",totQ2);			frn.set("totComis",totComis);/*select dcser.c3 as Asesor, dcser.c2 as folio_cita, dcser.c6 as serie,dcser.c21 as tipo_orden, dcser.c22 as folio_orden,imov.c3 as punto_cita,imov.c4 as tipo_punto,imov.c6 as paquete_cita,imov.c7 as desc_punto, kp.c6 as tipo_punto_orden, kp.c5 as paquete_orden, kp.c8 as des_punto_ordenfrom keplersc.kdctasser dcserinner join keplersc.kdctassermov imov on imov.c1=dcser.c1 and imov.c2=dcser.c2 full outer join keplersc.kdpun kp on kp.c1=dcser.c1 and kp.c2=dcser.c21 and kp.c3=dcser.c22and kp.c5=imov.c6where dcser.c3='MNAVARRETE' and dcser.c12 >= '2023-09-01 00:00:00' and dcser.c22<>'' and dcser.c20=20order by asesor,folio_cita,punto_cita*/					}				fun ConfiguraUI(){		}				fun Inicializa(){			frn.rst("gpo_2");		} /*Bitacora de cambios: Fecha: Autor: Descripcion: Se cambia forma de llenar combo de anio y mes */          					}				</script></pag>