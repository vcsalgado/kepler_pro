<?xml version="1.0" encoding="UTF-8"?><pag xmlns='www.kepler.com.mx/2003/KSchema' tit='Orden' scale="48"><grp dim='1,-1,10,20' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0"><br/>	<grp dim="15,8,7,12"><sp/>		<img id="img"  dim="14,80" brdr="0,1" img="logocliente.jpg"/>	</grp>	<grp dim="40,8,7,1">		<inp id="titulo"  dim="50,1" brdr="0,1" type="string" fnt="Arial,30b"/><br/><tab n="4"/><sp/>		<br/>		<txt fnt="Arial,18">Sucursal:</txt>		<inp id="suc_desc"  just="L" dim="60,1" brdr="0,1" type="string" fnt="Arial,17" nc="20"/><br/>	</grp>		<tab n="15"/>	<grp id="tipo" dim="20,5,7,2"><br/>		<sp/><txt>Fecha:</txt>			<tab n="2"/><inp id="rep_fecha" dim="20,1" brdr="0,1" type="date" fnt="Arial,15" fmt="DD/MM/CCYY" nc="-1"/><br/>			<br/><br/>		<sp/><txt>Hora:</txt>			<tab n="2"/><inp id="rep_hora" dim="20,1" brdr="0,1" type="string" fnt="Arial,15"  nc="-1"/><br/><br/><br/>		<sp/><txt>Pagina:</txt><tab n="2"/><inp id="k_pag" dim="4,1" type="number" just="L" mcr="k_pag"/>			</grp>	<br exe="encabezado"/><grp dim='100,3,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">	<br/>	<tab n="5"/><txt fnt="Arial,18b">HISTORIAL DEL INVENTARIO </txt>	<inp id="inventario_rep"  dim="50,1" brdr="0,1" bclr="255,255,255" fnt="Arial,18b"/></grp><br exe="encabezado"/><hLine dim="120,0" g="2"/><br exe="encabezado"/><br/><br/><grp dim='140,23,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">	<br/>	<tab n="1"/><txt fnt="Arial,18b">DATOS DEL INVENTARIO </txt>	<br/><br/>	<tab n="2"/><txt fnt="Arial,16b">Vehiculo:</txt>	<sp/><inp id="vehiculo"  type="string" dim="15,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><sp n="2"/><inp id="vehiculo_desc"  type="string" dim="25,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/>	<tab n="2"/><txt fnt="Arial,16b">Serie:</txt>	<sp/><inp id="serie"  type="string" dim="15,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>		<tab n="12"/><txt fnt="Arial,16b">Motor:</txt>	<sp/><tab n="3"/><inp id="motor"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>		<br/>	<tab n="2"/><txt fnt="Arial,16b">Transmision:</txt>	<sp/><inp id="transmision"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>		<tab n="11"/><txt fnt="Arial,16b">Inventario Ant.:</txt><tab/><inp id="inventario_anterior"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<br/>	<tab n="2"/><txt fnt="Arial,16b">Color Exterior:</txt><inp id="color_exterior"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<sp/><inp id="color_exterior_desc"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<tab n="7"/><txt fnt="Arial,16b">Clave Vehicular:</txt><tab/><inp id="clave_vehicular"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<br/>	<tab n="2"/><txt fnt="Arial,16b">Vestiduras: </txt>	<tab/><sp/><inp id="vestiduras"  type="string" dim="15,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<sp/><inp id="vestiduras_desc"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<tab n="6"/><txt fnt="Arial,16b">A&#241;o Modelo:</txt>	<sp/><tab/><inp id="anio_modelo"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<br/><tab n="2"/><txt fnt="Arial,16b">Capacidad:</txt>	<sp n="2"/><inp id="num_pasajeros"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<tab n="11"/><txt fnt="Arial,16b">No. Puertas:</txt>	<sp/><tab/><inp id="num_puertas"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<br/><tab n="2"/><txt fnt="Arial,16b">No. Cilindros:</txt>	<sp/><inp id="num_cilindros"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>		<tab n="2"/><br/><tab n="2"/><txt fnt="Arial,16b">Existe Eje Trasero:</txt>	<sp/><inp id="eje_trasero"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>			<tab n="10"/><txt fnt="Arial,16b">Registro Federal de Vehiculos:</txt>	<sp/><inp id="rfv"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<br/><br/>		<tab n="2"/><txt fnt="Arial,16b">Marca:</txt><inp id="marca"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<sp/><inp id="marca_desc"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<tab n="5"/><txt fnt="Arial,16b">Pedimento:</txt>	<sp/><inp id="pedimento"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<br/>	<tab n="2"/><txt fnt="Arial,16b">Clase:</txt>	<sp/><inp id="clase"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<sp/><inp id="clase_desc"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>		<tab n="5"/><txt fnt="Arial,16b">Fecha:</txt>	<sp/><tab/><inp id="fecha_pedimento"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>		<br/>		<tab n="2"/><txt fnt="Arial,16b">Tipo:</txt>	<sp/><inp id="tipo_v"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<sp/><inp id=""  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	<tab n="5"/><txt fnt="Arial,16b">Lugar:</txt>	<sp/><tab/><inp id="lugar_pedimento"  type="string" dim="12,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>	</grp><br exe="datos_inventario"/><grp dim='180,3,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0"><br/>	<tab n="1"/><txt fnt="Arial,18b">FACTURA(S) DE COMPRA AL PROVEEDOR</txt></grp><br exe="titulo_facturas_compra"/><grp dim='180,21,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0"><tab n="2"/><txt fnt="Arial,16b">Folio del Sistema:</txt><sp/><inp id="folio_compra"  dim="20,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><tab n="5"/><sp/><inp id="tipo_mov_compra"  dim="20,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><tab n="2"/><txt fnt="Arial,16b">Fecha:</txt><sp/><inp id="fecha_factura_compra"  dim="20,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><tab n="5"/><txt fnt="Arial,16b">Numero CDO:</txt><sp/><inp id="numero_cdo"  dim="20,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><br/><tab n="2"/><txt fnt="Arial,16b">Proveedor:</txt><sp/><inp id="clave_prov"  dim="10,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><sp/><inp id="nombre_prov"  dim="30,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><tab n="2"/><sp/><inp id="calle_prov"  dim="20,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><sp/><inp id="colonia_prov"  dim="20,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><tab n="2"/><sp/><inp id="poblacion_prov"  dim="20,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><sp/><inp id="rfc_prov"  dim="10,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><br/><br/><tab n="2"/><txt fnt="Arial,16b">Costo:</txt><sp n="16"/><inp id="costo_factura_compra"  dim="15,1" type="number" nd="2" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><tab n="2"/><txt fnt="Arial,16b">Impuesto al Valor Agregado:</txt><sp/><inp id="iva_factura_compra"  dim="15,1" type="number" nd="2" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><tab n="2"/><txt fnt="Arial,16b">HoldBack:</txt><sp n="13"/><inp id="hold_back"  dim="15,1" type="number" nd="2" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><tab n="2"/><txt fnt="Arial,16b">Importe Final:</txt><sp n="11"/><inp id="importe_compra"  dim="15,1" type="number" nd="2" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/></grp><br exe="datos_facturas_compra"/><br/><grp dim='180,3,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0"><br/>	<tab n="1"/><txt fnt="Arial,18b">DATOS DEL PEDIDO</txt></grp><br exe="titulo_pedidos"/><grp dim='180,28,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0"><tab n="2"/><txt fnt="Arial,16b">Folio del Sistema:</txt><sp/><inp id="folio_pedido"  dim="20,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><tab n="2"/><txt fnt="Arial,16b">Fecha:</txt><sp/><inp id="fecha_pedido"  dim="20,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><br/><tab n="2"/><txt fnt="Arial,16b">Clave Vendedor:</txt><sp/><inp id="clave_vendedor"  dim="7,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><tab n="1"/><inp id="nombre_vendedor"  dim="20,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><tab n="2"/><txt fnt="Arial,16b">Tipo Operacion:</txt><sp/><inp id="tipo_operacion"  dim="7,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><tab n="1"/><inp id="tipo_operacion_desc"  dim="30,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><tab n="2"/><txt fnt="Arial,16b">Impresion:</txt><sp/><inp id="impresion"  dim="30,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><br/><tab n="2"/><txt fnt="Arial,16b">Cliente:</txt><sp/><inp id="clave_cli"  dim="10,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><sp/><inp id="nombre_cli"  dim="30,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><tab n="2"/><sp/><inp id="calle_cli"  dim="20,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><sp/><inp id="colonia_cli"  dim="20,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><tab n="2"/><sp/><inp id="poblacion_cli"  dim="20,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><sp/><inp id="rfc_cli"  dim="10,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><br/><br/><tab n="2"/><txt fnt="Arial,16b">Resumen de Adicionales registrados en el pedido:</txt><br/><br/><tab n="2"/><txt fnt="Arial,16b">Subsidio:</txt><sp n="8"/><inp id="subsidio"  dim="15,1" type="number" nd="2" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><tab n="2"/><txt fnt="Arial,16b">Bonificacion:</txt><sp n="5"/><inp id="bonificacion"  dim="15,1" type="number" nd="2" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><tab n="2"/><txt