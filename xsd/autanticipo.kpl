<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Anticipos">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>	<txt fnt=",22" clr="0,0,0">Anticipo</txt><br/>	<hLine dim="85,0" clr="0,0,0"/> 	<br/> <br/>	<grp dim="48,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros"><txt>  Sucursal : </txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>		<br/><br/>		<txt>  Tipo :        </txt>		<cmb id="k_tipon" dim="40,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo() "/>		<br/>	</grp>	<sp/>	<grp dim="36,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">		<sp n="1"/>		<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C"/><tab/> <br/>		<txt id="textFolio" visible="N">  Folio :  </txt>		<edt id="k_folio" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" visible="N" OnButton="ObtenerFolios_DEVs()" OnF9="ObtenerFolios_DEVs()" OnChange="BuscarFolio()"/> <br/>		<sp n="1"/>		<inp id="k_docto" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="C"/> <br/>		<txt>  Fecha : </txt> 		<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="Y"/> 		<sp n="1"/> 		<txt>  Hora : </txt> 		<sp n="1"/> 		<edt id="k_hora" dim="15,1" type="time" nc="-1" bclr="240,240,240" modify="Y" fmt="HH:MM:SS" available="Y"/> 		<br/>	</grp>		<br/><br/>	<grp dim="85,20,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle"/>		<br/>						<sp n="15"/>		<img id="Imprimir" dim="45,45" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Reporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="N" clrBrdr="0,0,0" visible="N" modify="Y"/>					<sp n="25"/>		<img id="Cancelar" dim="45,45" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>					<sp n="10"/>		<img id="Aceptar" dim="45,45" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id;			var fileSavePath, tip_ope_original;												// Vars Parameters			 var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				fileSavePath = "C:\Basura";				Inicializa();								ConfiguraControlesOpcion();			}			fun Inicializa(){ //Inicializa los valores en Pantalla				// Revisa y Carga en Variables los Parámetros Recibidos en la corrida				if( frn.nParam() == 5 ){ //Se han mandado parámetros a la página				    gen_doc=trim(frn.param(0)); 				    nat_doc=trim(frn.param(1)); 				    gpo_doc=trim(frn.param(2));				    tip_doc=trim(frn.param(3)); 				    tip_ope=trim(frn.param(4));				    tip_ope_original=tip_ope;			         } else {			            frn.message("Operación no válida ...", "Mensaje","&Aceptar");			            //frn.open("principal",4);				    return;				 }            				if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					if(tip_ope &= "B"){ //Baja						frn.set("operacion","BAJA");					} else {						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} else {					      frn.message("Operación no válida ...", "Mensaje","&Aceptar");							//frn.open("principal",4);							return;									}					}				}								// Fill Combo Sucursal (Con Query de PostgreSQL)				cmdQuery = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdms";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comdevdircrud.IniCombos()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlSucursales");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",cuboQuery);					// Fill Combo Tipo (Con Query FTO Kepler) 				cmdQuery = "select '['||c4||'] '||c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comopecompras.Inicializa()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboTipoDocto");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error BD","Aceptar");					return;				}				frn.set("k_tipon",getXml(cuboQuery));								frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());									// Fill k_docto | referencia docto				ArmarRefDocto();								//LimpiaDatosProv();			}			// Armado del Docto Referencia			fun ArmarRefDocto {				var cadena,tmpFolio, tmpGrupo, tmpTipo;				cadena = frn.get("k_tipon",-1,5);				frn.set("k_docto", cadena);			}			fun CambiaTipo() {				ArmarRefDocto();			}			fun ConfiguraControlesOff() {								frn.setAtt("textFolio", "visible", "N");				frn.setAtt("k_folio", "available", "N");				frn.setAtt("k_folio", "visible", "N");								frn.setAtt("k_fecha", "available", "N");				frn.setAtt("k_hora", "available", "N");				frn.setAtt("k_clave", "available", "N");				frn.setAtt("k_refer", "available", "N");								frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											}						fun ConfiguraControlesOpcion() {							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta					frn.setAtt("k_fecha", "available", "Y");					frn.setAtt("k_hora", "available", "Y");					frn.setAtt("k_clave", "available", "Y");					frn.setAtt("k_refer", "available", "Y");								frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");													} else {					if(tip_ope &= "B"){ //Baja										frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("Imprimir", "visible", "N");						frn.setAtt("Cancelar", "visible", "Y");						frn.setAtt("Aceptar", "visible", "Y");															} else {						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");						frn.setAtt("Imprimir", "visible", "Y");						frn.setAtt("Cancelar", "visible", "N");						frn.setAtt("Aceptar", "visible", "N");						}				}			}			fun Execute() {				var val=frn.get("input");				//frn.message("Valor proporcionado:" & val,"Notificación","Aceptar");			}		}	</script></pag>