<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Monitoreo de Operaciones"><grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,10" bclr="192,205,213" unfont="0"	OnF1="Dialog(1,invEntSalAyu)" clrBrdr="0,97,181" tit=""><br/>	<tab/><txt fnt=",22" clr="0,0,0">Monitoreo de Operaciones</txt><br/><tab/><hLine clr="0,0,0"/><br/><tab n="2"/>		<br/>		<tab/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="80,7,7,12" tit="Filtros de Consulta"  fnt="Arial,16"><tab/>		<txt clr="0,58,112" hk="S">Sucursal</txt><tab n="2"/>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="45,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="obtener_datos_sucursal()" available="Y"/><br/><tab/>	   <txt clr="0,58,112">Fecha Inicial:</txt><tab n="1"/>		<edt id="fecha_ini" dim="12,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_ini" OnF9="Dialog(3,_ks_fecha,fecha_ini)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2"/>		<sp n="2"/>		<txt>Fecha Final:</txt>		<edt id="fecha_fin" dim="12,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_fin" OnF9="Dialog(3,_ks_fecha,fecha_fin)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2"/>		<sp n="2"/><img id="k_buscar_registros" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="buscar_datos()" tooltip="Consultar registros" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		<br/><sp n="1"/> 	</grp><tab/>	<br/><br/>	<tab/>		<br/>	<tab/>		<grp  bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="0" clrBrdr="0,58,112" dim="80,50,7,10" brdr="1,5"  fnt="Arial,16"><tab/><br/>		<tab n="3"/>	<br/><tab n="2"/><txt fnt=",18">Autorizacion de Precios</txt><br/>		<tab n="2"/>		<tbl id="aut_precios" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="100,12"  hk="z" OnChange="" Reorder="Y" modify="N">			<col id="aut_fecha" name="Fecha Reg."  modify="N"/>			<col id="aut_usuario" name="Usuario" modify="N" type="string" visible="Y" nd="2"/>			<col id="aut_detalle" name="Detalle de Proceso" modify="N" type="string" visible="Y" nd="6"/>		</tbl>		<tab n="1"/>		<img id="Exportar" dim="25,25" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(aut_precios)" available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Generar Excel"/>				<br/><br/>				<tab n="2"/>		<txt fnt="Arial,18" clr="0,58,112" bclr="255,255,255">Modificacion de Polizas</txt><br/>		<tab n="2"/>				<tbl id="mod_poliza" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="100,12"  hk="z" OnChange="" Reorder="Y" modify="N">			<col id="mod_fecha" name="Fecha Reg."  modify="N"/>			<col id="mod_usuario" name="Usuario" modify="N" type="string" visible="Y" nd="2"/>			<col id="mod_detalle" name="Detalle de Proceso" modify="N" type="string" visible="Y" nd="6"/>		</tbl>		<tab/>		<img id="Exportar_sin" dim="25,25" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(mod_poliza)" available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Generar Excel"/>		<br/>	</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb, sys, rep;			var anio_contable, usuario, suc_usuario, perfil_usuario, asterisco;			var sucursal_id, cmdQuery, rol_usuario;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();				sys=new SYS;				rep=new REP;							suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								ctrls_off();				Inicializa();										}					fun Inicializa(){				kdb.kde("KDE");//								Configuraci�n del servidor				kdb.exec();				anio_contable = kdb.get("KDE","14");			//MSS----------------------				usuario = frn.config("user","name");			//-------------------------						var cmd, cubo, ok;							//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));							}									fun ctrls_off() {				frn.setAtt("k_buscar_registros", "visible", "Y" );			}									fun buscar_datos(){				var ok, cmd, cuboResultados, mensajeError;				sucursal_id = frn.get("k_sucn",-1,1);				var k_fecha_ini = frn.get("fecha_ini");				var k_fecha_fin = frn.get("fecha_fin");								if(k_fecha_ini &= "")				{					frn.message("Fecha Inicial esta vacia, favor de capturar.","Error","Aceptar");					return;				} else {					k_fecha_ini = k_fecha_ini & " 00:00:00";				}								if(k_fecha_fin &= "")				{					frn.message("Fecha Final esta vacia, favor de capturar.","Error","Aceptar");					return;				} else {					k_fecha_fin = k_fecha_fin & " 23:59:59";				}								//Proceso para Autorizacion de Precios				cmd= "  select TO_CHAR(fecha_registro, 'DD/MM/YYYY') as k_fecha, c1 as k_usuario, c11 as k_detalle from keplersc.kdusraccess " ;							cmd = cmd & " where c4='" & sucursal_id  & "' and upper(c10)='AUT PRECIO' and fecha_registro between '" & k_fecha_ini & "' and '" & k_fecha_fin & "'";				cmd = cmd & "order by fecha_registro desc";								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"monitoreo_operaciones.buscar_datos()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\autPrecios");									ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.setX(cuboResultados, "aut_precios");								//Proceso para Modificacion de Polizas				cmd= "  select TO_CHAR(fecha_registro, 'DD/MM/YYYY') as k_fecha, c1 as k_usuario, c5||c6||LPAD(c7::text, 2, '0')||LPAD(c8::text, 3, '0')||c9||'|'||c11 as k_detalle from keplersc.kdusraccess " ;							cmd = cmd & " where c4='" & sucursal_id  & "' and upper(c10)='MODPOLIZA' and fecha_registro between '" & k_fecha_ini & "' and '" & k_fecha_fin & "'";				cmd = cmd & "order by fecha_registro desc";								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"monitoreo_operaciones.buscar_datos()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\modPolizas");									ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.setX(cuboResultados, "mod_poliza");								}									fun guardar_tabla(tabla){				var save = frn.saveFile(tabla,"Todos los archivos,*.*","_C:","Para guardar archivo");				frn.dialog("guarda_tabla",tabla,save); 			}					fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci�n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci�n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p�ginas de operacion:Solo si se est� en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver� el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}					}	</script></pag>