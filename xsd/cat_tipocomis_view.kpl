<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Catalogo Comisiones"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp  bclr="236,240,243" fntClrBrdr="236,240,243"  unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="82,45,10,10" brdr="0,5" tit="Comisiones" fnt="Arial,16">		<tab/><txt clr="0,58,112">Tipo Comision:</txt>		<inp id="tipo_comision" dim="23,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><tab n="1"/>			<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><br/>			<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" OnEnter="Exit" OnMouseD="Exit" dim="76,22" modify="N" nren="fijo">		<col id="clave" name="Clave"/>		<col id="desc" name="Descripcion"/>		<col id="tipo" name="Tipo Calc." type="number"/>		<col id="lim1" name="Lim. Sup. Edad 1" type="number"/>		<col id="lim2" name="Lim. Sup. Edad 2" type="number"/>		<col id="lim3" name="Lim. Sup. Edad 3" type="number"/>			</tbl>  <br/>		<tab n="7"/>		<bot id="k_btn_nvo" dim="10,10" brdr="5" text="Nuevo" hk="K" default="0" step="0"  OnEnter="abrir_curd(Nuevo)" fnt="Arial,16b" visible="Y"/> 		<bot id="k_btn_mod" dim="10,10" brdr="5" text="Modificar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Modificar)" fnt="Arial,16b" visible="Y"/> 		<bot id="k_btn_elimnr" dim="10,10" brdr="5" text="Eliminar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Eliminar)" fnt="Arial,16b" visible="N"/> 		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Consultar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Consultar)" fnt="Arial,16b" visible="Y"/> <br/>				</grp>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,asterisco ,externo,rol_usuario  ;			fun Main(){				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								ctrls_off();								Inicializa();										}						fun ctrls_off(){						frn.setAtt("k_btn_nvo", "visible", "N");				frn.setAtt("k_btn_mod", "visible", "N");				frn.setAtt("k_btn_elimnr", "visible", "N");				frn.setAtt("k_btn_cons", "visible", "N");						}						fun Inicializa(){							externo = frn.param(0);												if (externo &! "s"){					frn.setAtt("k_btn_nvo", "visible", "Y");					frn.setAtt("k_btn_mod", "visible", "Y");					frn.setAtt("k_btn_elimnr", "visible", "N");					frn.setAtt("k_btn_cons", "visible", "Y");				}										}						fun Buscar() {							var xmlRequest,cmd,ok,cuboResultados, tot , cont, clave, desc;						var criterio = frn.get("tipo_comision");								cmd= "select c1,c2,c3,c4,c5,c6 from keplersc.kdtipocomis ";								if ( criterio  &! "" ) {					cmd= cmd & " where (c1 like upper('%" & criterio & "%') or c2 like upper('%" & criterio & "%'))";							}							cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_tipo_comis_view.Buscar()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								tot = nXml(cuboResultados);							frn.rst("tabla");				for (cont=0; cont<tot; cont++){								clave= getXmlAtt(cuboResultados,"r"&cont,"c1");					desc= getXmlAtt(cuboResultados,"r"&cont,"c2");								frn.setX(clave,"tabla",cont,"clave");					frn.setX(desc,"tabla",cont,"desc");					frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c3"),"tabla",cont,"tipo");					frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c4"),"tabla",cont,"lim1");					frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c5"),"tabla",cont,"lim2");					frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c6"),"tabla",cont,"lim3");											}							}									fun abrir_curd(accion){							if (accion &! "Nuevo"){									var param = frn.get("tabla", -1, "clave");													if (param &= ""){										frn.message("No has seleccionado una Comision","Error","Aceptar");									}else{										frn.dialog("cat_tipocomis_crud",accion, param, "n");					}				}else {									frn.dialog("cat_tipocomis_crud", accion, "x", "n");									}							}									fun Exit(){							var clave_seleccionada = frn.get("tabla", -1, "clave");												if (externo &= "s"){									frP.set(frn.param(1),clave_seleccionada ); 					frP.scriptElm(frn.param(1),"OnChange");					frn.exit();									}					}								}	</script></pag>