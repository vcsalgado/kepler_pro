		<txt clr="0,58,112">Colonia: </txt><tab n="1"/>		
		<inp id="k_colonia" dim="31,1" type="capital" nc="70" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="Colonia"/><sp/>
		<br/><tab/>
		
		<txt clr="0,58,112">No. Exterior: </txt><tab n="1"/>		
		<inp id="k_no_exterior" dim="31,1" type="capital" nc="27" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="No.Exterior"/><sp/>
		<br/><tab/>
		
			
		<txt clr="0,58,112">No. Interior: </txt><tab n="1"/>		
		<inp id="k_no_interior" dim="31,1" type="capital" nc="27" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="No.Interior"/><sp/>
		<br/><tab/>
		
		<txt clr="0,58,112">Poblaci&#243;n: </txt><tab n="1"/>		
		<inp id="k_poblacion" dim="31,1" type="capital" nc="70" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="Poblaci&#243;n"/><sp/>
		<br/><tab/>
						
		<txt clr="0,58,112">Municipio: </txt><tab n="1"/>		
		<inp id="k_municipio" dim="31,1" type="capital" nc="70" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="Municipio"/><sp/>
		<br/><tab/>
		
		<txt clr="0,58,112">Estado: </txt><tab n="2"/>		
		<inp id="k_estado" dim="31,1" type="capital" nc="35" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="Estado"/><sp/>
		<br/><tab/>
		
		
		<txt clr="0,58,112">Pais: </txt><tab n="2"/>		
		<inp id="k_pais" dim="31,1" type="capital" nc="835" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="Pais"/><sp/>
		<br/><tab/>
		
		<txt clr="0,58,112">CP: </txt><tab n="2"/>		
		<inp id="k_cp" dim="31,1" type="capital" nc="5" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="CP"/><sp/>
		<br/><tab n="1"/><txt clr="0,58,112">RFC: </txt><tab n="2"/>		
		<inp id="k_rfc" dim="31,1" type="capital" nc="13" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="RFC"/><sp/>
		<br/><tab/>
		
		<txt clr="0,58,112">Email: </txt><tab n="2"/>		
		<inp id="k_email" dim="31,1" type="capital" nc="80" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="Email"/><sp/>
		<br/><tab/>
		
		<br/><br/>
		
		<tab/>
		<txt>Forma Pago :</txt><tab/>
		<cmb id="k_f_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="31,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string"  OnChange="" modify="Y" available="Y" visible="Y" tooltip="Forma de pago"/>
		<br/><tab/>
		<txt clr="0,58,112">M&#233;todo Pago : </txt>
		<inp id="k_m_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="3" modify="Y" available="Y" visible="Y" tooltip="M&#233;todo de pago"/>
		<tab/><txt clr="0,58,112">(PUE o PPD)</txt>
		<br/><tab/>
		<txt clr="0,58,112">Cuenta : </txt><tab/>		
		<inp id="k_cuenta" clr="64,64,64"  dim="31,1" brdr="2,0" bclr="255,255,255" type="number" nc="18" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="N&#250;mero de cuenta" fmt="5"/>
		<br/><tab/>
		<txt clr="0,58,112">Uso CFDI : </txt><tab/>
		<cmb id="k_cfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="31,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" modify="Y" available="Y" visible="Y" tooltip="Uso de CFDI"/>
		<br/><tab/>	
		<txt>R&#233;g. Fiscal:</txt><tab/>
		<cmb id="k_regfiscal" clr="64,64,64" clrBrdr="255,255,255"  dim="31,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" modify="Y" available="Y" visible="Y" tooltip="R&#233;gimen Fiscal"/><br/><tab/>	
		<txt id="relcfdi_txt" visible="Y">Relacion CFDI:</txt>
		<cmb id="k_tiporelacion" clr="64,64,64" clrBrdr="255,255,255"  dim="17,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" modify="Y" available="Y" visible="Y" tooltip="Tipo Relacion de CFDI" OnChange="tipo_rel()"/>
		<txt id="folio_rel_txt" visible="Y"> Folio:</txt>
		<edt id="k_folio_rel" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="10" tooltip="Folio ( F9 b&#250;squeda )" modify="Y" available="Y" visible="Y"
		OnF9="ObtenerFolio()" OnButton="ObtenerFolio()" OnChange="verifica_folio_rel()"/><br/>
		<br/>		

		<tab/><bot id="bot_aceptar" dim="14,0" brdr="5" text="Aceptar" default="0" OnEnter="Execute()"/>
		<tab/><bot id="bot_canelar" dim="14,0" brdr="5" text="Cancelar" default="0" OnEnter="Cancelar()"/>
	</grp>
</grp>
<script>
	InstallDriver("KDB75");
	class Main {
		var frn,frP,kdb,sys;
		var sucursal_id,clave_cliente,ejecutaFuncion,val_fpago,val_cuenta,val_mpago,tipo_obj, val_uso_cfdi ,tipo_obj_2, resVal,suc_usuario,nombre_usuario,gen_param,nat_param,gpo_param,tpo_param;   
		var cmdQuery, cuboQuery, ok, mensajeError, fileSavePath;
		
		fun Main(){
			frn=new FRNT;
			kdb=new KDB;
			frP=new FRNTP;
			sys=new SYS;
			kdb.connect();
			
			fileSavePath = "C:\Basura";
			suc_usuario = frn.lib("libKepler","UserInfo(1)");				//MSS 13022025 Relacion CFDI
			nombre_usuario = frn.lib("libKepler","UserInfo(3)");			//MSS 13022025 Relacion CFDI
			Inicializa();
		}
			
	
				
		fun Inicializa(){
			var cmd,cubo;					
			sucursal_id = frn.param(0);
			clave_cliente = frn.param(1);
			ejecutaFuncion = frn.param(2);
			tipo_obj = frn.param(3);
			val_fpago = frn.param(4);
			val_cuenta = frn.param(5);
			val_mpago = frn.param(6);
			tipo_obj_2 = frn.param(7);
			val_uso_cfdi = frn.param(8);
			
			//Llena Combo Forma de pago
			cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3fp";
			IniCombos("k_f_pago",cmd);
				
			//Llena Combo Uso Cfdi
			cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3uso";
			IniCombos("k_cfdi",cmd);
			
			//Llena Combo Regimen fiscal
			cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3rf";
			IniCombos("k_regfiscal",cmd);
			
			//Llena Combo Tipo relacion
			Llena_cmbtipo_relacion();			//MSS 13022025 Relacion CFDI
			
			frn.set("k_f_pago", "");
			frn.set("k_cfdi", "");
			frn.set("k_regfiscal","");
			frn.set("k_tiporelacion","");		//MSS 13022025 Relacion CFDI
			frn.set("k_folio_rel","");			//MSS 13022025 Relacion CFDI
			
			buscar_cliente_cfd();
			ActivaRelacioncfdi();						//MSS 13022025 Relacion CFDI
			if (frP.param(0) &="CFDIFOLIO"){			//MSS 13022025 Relacion CFDI
				gen_param=frP.get("k_gen");
				nat_param=frP.get("k_nat");
				gpo_param=frP.get("k_gpo");
				tpo_param=frP.get("k_tpo");
			} else{
				gen_param=frP.param(0);
				nat_param=frP.param(1);
				gpo_param=frP.param(2);
				tpo_param=frP.param(3);
			}
	
		}
			
		fun IniCombos(ctrl_combo, query){
			cmdQuery = query;
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"icfdreview.IniCombos()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			frn.set(ctrl_combo,cuboQuery);
		}
		
		fun buscar_cliente_cfd(){
		
				var cmd, cuboResultados, ok, totRes;
				cmd= "select c1,c2,c3,c4,c5,c6,c7,c8,c9,c10,c11,c12,c14,c20,c21,c22,c23,c24 from keplersc.kdudcfd where c1= '" & clave_cliente & "'";
				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdkdudcfd");					
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"icfdreview.buscar_cliente_cfd()");

				frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\kdudcfd");
				
				ok=getXmlAtt(cuboResultados,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboResultados,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				totRes = nXml(cuboResultados);
				
				if ( totRes == 1 ){
					frn.set("k_clave",getXmlAtt(cuboResultados,"r0" ,"c1"));
					frn.set("k_nombre",getXmlAtt(cuboResultados,"r0" ,"c2"));
					frn.set("k_calle",getXmlAtt(cuboResultados,"r0" ,"c3"));
					frn.set("k_colonia",getXmlAtt(cuboResultados,"r0" ,"c4"));
					frn.set("k_no_exterior",getXmlAtt(cuboResultados,"r0" ,"c5"));
					frn.set("k_no_interior",getXmlAtt(cuboResultados,"r0" ,"c6"));
							
					frn.set("k_municipio",getXmlAtt(cuboResultados,"r0" ,"c7"));
					frn.set("k_estado",getXmlAtt(cuboResultados,"r0" ,"c8"));
					frn.set("k_pais",getXmlAtt(cuboResultados,"r0" ,"c9"));
					frn.set("k_cp",getXmlAtt(cuboResultados,"r0" ,"c10"));
					frn.set("k_rfc",getXmlAtt(cuboResultados,"r0" ,"c11"));
					frn.set("k_email",getXmlAtt(cuboResultados,"r0" ,"c12"));
					frn.set("k_poblacion",getXmlAtt(cuboResultados,"r0" ,"c14"));

					frn.set("k_f_pago",descr_combo("k_f_pago",1,getXmlAtt(cuboResultados,"r0","c20")));	
					frn.set("k_cuenta",getXmlAtt(cuboResultados,"r0" ,"c22"));
					frn.set("k_m_pago",getXmlAtt(cuboResultados,"r0" ,"c21"));
					frn.set("k_cfdi",descr_combo("k_cfdi",1,getXmlAtt(cuboResultados,"r0","c23")));	
					frn.set("k_regfiscal",descr_combo("k_regfiscal",1,getXmlAtt(cuboResultados,"r0","c24")));	
				
				}else {
					cmd= "select c2,c3,c4,c5,c6,c45,c46,c47,c48,c49,c27,c10,c11,c52,c53,c54 from keplersc.kdud where c2= '" & clave_cliente & "'";
					
					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"icfdreview.buscar_cliente_cfd()");
				
					frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\kdud");
				
					ok=getXmlAtt(cuboResultados,"ok");
					if(ok &! "" && !ok){
						mensajeError = getXmlAtt(cuboResultados,"native3");
						frn.message(mensajeError,"Error","Aceptar");
						return;
					}

					totRes = nXml(cuboResultados);
					frn.set("k_clave",getXmlAtt(cuboResultados,"r0" ,"c2"));
					frn.set("k_nombre",getXmlAtt(cuboResultados,"r0" ,"c3"));
					frn.set("k_calle",getXmlAtt(cuboResultados,"r0" ,"c4"));
					frn.set("k_colonia",getXmlAtt(cuboResultados,"r0" ,"c5"));
					frn.set("k_poblacion",getXmlAtt(cuboResultados,"r0" ,"c6"));
					frn.set("k_no_exterior",getXmlAtt(cuboResultados,"r0" ,"c45"));
					frn.set("k_no_interior",getXmlAtt(cuboResultados,"r0" ,"c46"));
							
					frn.set("k_municipio",getXmlAtt(cuboResultados,"r0" ,"c47"));
					frn.set("k_estado",getXmlAtt(cuboResultados,"r0" ,"c48"));
					frn.set("k_pais",getXmlAtt(cuboResultados,"r0" ,"c49"));
					frn.set("k_cp",getXmlAtt(cuboResultados,"r0" ,"c27"));
					frn.set("k_rfc",getXmlAtt(cuboResultados,"r0" ,"c10"));
					frn.set("k_email",getXmlAtt(cuboResultados,"r0" ,"c11"));

					frn.set("k_f_pago",descr_combo("k_f_pago",1,getXmlAtt(cuboResultados,"r0","c52")));	
					frn.set("k_cfdi",descr_combo("k_cfdi",1,getXmlAtt(cuboResultados,"r0","c53")));	
					frn.set("k_regfiscal",descr_combo("k_regfiscal",1,getXmlAtt(cuboResultados,"r0","c54")));	
				
				
				}
/*				
				//Actualiza los valores con los de la pantalla padre
				if ( totRes == 1 ){
					frn.set("k_f_pago",descr_combo("k_f_pago",1,val_fpago));
					frn.set("k_cuenta",val_cuenta);
					frn.set("k_m_pago",val_mpago);
					frn.set("k_cfdi",descr_combo("k_cfdi",1,val_uso_cfdi));	
				}
*/
		}
		
		
		fun Execute(){
		
			var xmlRequest , cmd, cubo,tp_folrel; 
			resVal=1;
			//Valida metodo de pago
			if (frn.get("k_m_pago") &!"PUE" && frn.get("k_m_pago") &!"PPD"){
				frn.setPos("k_m_pago");
				frn.message("El metodo de pago solo puede ser PUE o PPD","Error","Aceptar");
				resVal=0;
				return;
			}

			//Valida tipo de relacion				//MSS 13022025 Relacion CFDI
			tipo_rel();
			
			//Valida folio relacionado y obtiene que tipo es				//MSS 13022025 Relacion CFDI
			if (frn.get("k_folio_rel")&! ""){
				verifica_folio_rel();
				if (frn.get("k_tiporelacion",-1,1)&= "" ){
					frn.message("Falta especificar el tipo de relacion del CFDI","Error","Aceptar");
					frn.setPos("k_tiporelacion");
					resVal=0;
					return;
				}
				//Obtiene tp de folio relacionado
				cmdQuery = "select dm1.c5 as tp " &
							"from keplersc.kdm1 dm1 " &
							"where dm1.c1='" &sucursal_id& "' and dm1.c2='" &gen_param& "' and dm1.c3='" &nat_param& "' and dm1.c4=" &gpo_param& 
							"::integer and dm1.c6 ='" & frn.get("k_folio_rel") & "' and dm1.c10='" &clave_cliente& "'";
				rstXml(cuboQuery);				
				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"icfdreview.ValidarDatos()");
				ok=getXmlAtt(cuboQuery,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboQuery,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				tp_folrel=getXmlAtt(cuboQuery,"r0","tp");				


			} else{
				if (frn.get("k_tiporelacion",-1,1)&! "" ){
					frn.message("Falta especificar el folio relacionado","Error","Aceptar");
					frn.setPos("k_folio_rel");
					resVal=0;
					return;
				}
			}	

			if( resVal == 0){						//MSS 13022025 Relacion CFDI
				return;
			}

			xmlRequest = getXml(frn.dataPag());
			setXml(xmlRequest,"k_sucn",sucursal_id);

			setXml(xmlRequest,"gen_folrel",gen_param);			//MSS 17022025 Relacion CFDI
			setXml(xmlRequest,"nat_folrel",nat_param);
			setXml(xmlRequest,"gpo_folrel",gpo_param);
			setXml(xmlRequest,"tpo_folrel",tp_folrel);
			
			frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");

			cmd="SELECT * FROM keplersc.cfd_upd('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";
	
			cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"icfdreview.Execute()");	

			frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");					
				
			var resultado=getXml(cubo ,"resultado");
				
			mensajeError = getXml(cubo ,"mensaje");
			if(resultado &= "0"){
				frn.message(mensajeError,"Error","Aceptar");
				return; 
			}else{
				frn.message(mensajeError," ","Aceptar");
			}
			
			frP.set("datcfdi","S");
			//Actualiza fpago, cuenta y mpago a la ventana padre
			if (tipo_obj &= "cmb"){
				frP.set("k_f_pago",descr_combo("k_f_pago",1,frn.get("k_f_pago",-1,1)));
			} else if (tipo_obj &= "inp"){
				frP.set("k_f_pago",frn.get("k_f_pago",-1,1));
			}
			
			//Actualiza Uso de CFDI de ventana padre
			if (tipo_obj_2 &= "cmb"){
				frP.set("k_cfdi",descr_combo("k_cfdi",1,frn.get("k_cfdi",-1,1)));
			} else if (tipo_obj_2 &= "inp"){
				frP.set("k_cfdi",frn.get("k_cfdi",-1,1));
			}

			frP.set("k_cuenta",frn.get("k_cuenta"));
			frP.set("k_m_pago",frn.get("k_m_pago"));			
			frP.script(ejecutaFuncion &"()");				
			frn.exit();	
		
		}
		
	
		fun Cancelar(){
			frP.set("datcfdi","N");				
			frn.exit();			
		}


		fun ObtenerFolio() {					//MSS 13022025 Relacion CFDI

			cmdQuery = "select dm1.c2 as g, dm1.c3 as n, dm1.c4 as gp, dm1.c5 as tp, dm1.c6 as folio, to_char(dm1.c9, 'dd/mm/yyyy') as fecha, dm1.c16 as monto " &
						"from keplersc.kdm1 dm1 " &
						"inner join keplersc.kdmm mm on mm.c1=dm1.c2 and mm.c2=dm1.c3 and mm.c3=dm1.c4 and mm.c4=dm1.c5 and mm.c80='S' " &
						"where dm1.c1='" &sucursal_id& "' and dm1.c2='" &gen_param& "' and dm1.c3='" &nat_param& "' and dm1.c4=" &gpo_param& 
						"::integer and dm1.c6 <>'" & frP.get("k_folio") & "' and dm1.c10='" &clave_cliente& "' " &
						"order by dm1.c9 desc";
				
			frn.dialog("genlistafiltrosel","Folios CDFI´s del cliente",cmdQuery,"folio","k_folio_rel","0","0","N","S");	
			
		}


		fun verifica_folio_rel{					//MSS 17022025 Relacion CFDI
			var totReg;

			//Validar que el folio pertenezca al cliente y sea del mismo g,n,gpo
			if (frn.get("k_folio_rel") &!""){
				cmdQuery="SELECT count(*) as totreg 
							from keplersc.kdm1 dm1 " &
							"inner join keplersc.kdmm mm on mm.c1=dm1.c2 and mm.c2=dm1.c3 and mm.c3=dm1.c4 and mm.c4=dm1.c5 and mm.c80='S' " &
							"where dm1.c1='" &sucursal_id& "' and dm1.c2='" &gen_param& "' and dm1.c3='" &nat_param& "' and dm1.c4=" &gpo_param& "::integer and dm1.c6='" & frn.get("k_folio_rel") &
						 	"' and dm1.c10='" &clave_cliente& "'";
				rstXml(cuboQuery);				
				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"icfdreview.ValidarDatos()");
				ok=getXmlAtt(cuboQuery,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboQuery,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				totReg=getXmlAtt(cuboQuery,"r0","totreg");
				if(totReg==0){
					frn.message("El folio no existe para relacionar|Consulte con F9","Error","Aceptar");
					frn.setPos("k_folio_rel");
					resVal=0;
					return;
				}
				//Validar que no se relacione a si mismo
				if (frP.get("k_folio")&=frn.get("k_folio_rel")){		
					frn.message("No se puede relacionar a si mismo","Error","Aceptar");
					frn.setPos("k_folio_rel");
					resVal=0;
					return;
				}
			}
		}

	
		fun ActivaRelacioncfdi(){				//MSS 13022025 Relacion CFDI
			var configrel_cfdi;
			configrel_cfdi = frn.lib("libGeneral.kpl","ValidaPermisosUsr",suc_usuario, "Tipo relacion CFDI",nombre_usuario);
			if (configrel_cfdi==0){
				frn.setAtt("relcfdi_txt", "visible", "N" );
				frn.setAtt("folio_rel_txt", "visible", "N" );
				frn.setAtt("k_tiporelacion", "visible", "N" );
				frn.setAtt("k_folio_rel", "visible", "N" );
			} else{	
				frn.setAtt("relcfdi_txt", "visible", "Y" );
				frn.setAtt("folio_rel_txt", "visible", "Y" );
				frn.setAtt("k_tiporelacion", "visible", "Y" );
				frn.setAtt("k_folio_rel", "visible", "Y" );
			}
		}

		fun Llena_cmbtipo_relacion(){			//MSS 13022025 Relacion CFDI
			var cmd, cubo, ok,mensajeError; 
			cmd = "select '['||tipo_relacion||'] '||upper(descripcion) as descripcion, tipo_relacion as clave from keplersc.kdf3tiporelacion order by tipo_relacion";	

			cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"icfdreview.Llena_cmbtipo_relacion()");
				
			ok=getXmlAtt(cubo,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cubo,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			frn.rst("k_tiporelacion");
			frn.setX("","k_tiporelacion", 0 ,0);
			llenar_cmb(cubo,"k_tiporelacion");
		}		
		
		fun llenar_cmb(cuboResultados, cmb){			//MSS 13022025 Relacion CFDI
			var len_cubo = nXml(cuboResultados);
			var pos_ini = frn.N(cmb);
			for (var cont=0; cont<len_cubo ; cont++){
				var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");
				var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");
				frn.setX(desc, cmb, cont+pos_ini ,0);
				frn.setX(clave, cmb, cont+pos_ini ,1);
		
			}	
		}

		fun tipo_rel(){									//MSS 17022025 Relacion CFDI
			if (frn.get("k_tiporelacion",-1,1)&! "" && frn.get("k_tiporelacion",-1,1) &!"04"){
				frn.setPos("k_tiporelacion");
				frn.message("La relacion del CFDI por el momento solo puede ser 04","Error","Aceptar");
				resVal=0;
				return;
			}

		}
			
//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------
		fun descr_combo(combo,posicion,valor){
			var descr, valor_actual;
			var len_combo = frn.N(combo);

			for (var cont=0; cont<len_combo ; cont++){
				valor_actual= frn.get(combo,cont,posicion);
				if (valor_actual &=  valor){
					descr = frn.get(combo,cont,0);
					return descr;
				}
			}
		}
			
		fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){
			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO
						1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana
						2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)
						3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje
			*/
			var prefix=frn.lib("libKepler","langPrefix");
			var page=prefix&pag;
			var b_valido=1;
			if(iModo==0)
				page=pag;
			else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.
				if( frn.getAtt(par0,"modify",par1) &= "N" ) 
					b_valido=0;
				if( frn.getAtt(par0,"available",par1) &= "N" ) 
					b_valido=0;
				if( frn.getAtt(par0,"visible",par1) &= "N" ) 
					b_valido=0;
			}
			if(iModo==3)
				frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);
			}
		}
	</script>
</pag>