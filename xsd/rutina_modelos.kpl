<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Rutina Modelos">	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<grp dim="30,23,7,12" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Rutina Modelos">						<br/><tab/><txt>Sucursal:</txt><sp n="2"/><cmb id="k_sucN" dim="43,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y"/>			      <br/>  <br/>			      			 									<tab n="5"/><txt>Marca Origen:</txt>	<tab/>			      <inp id="marca_origen" dim="15,1" bclr="255,255,255" OnF9="Sel_marca(marca_origen)"  type="capital" OnChange="Ins_marca(marca_origen)" clr="64,64,64"  clrBrdr="255,255,255"  type="string" brdr="0,2"/>			      <br/>			        			      <tab n="5"/><txt>Modelo Origen:</txt>	<tab/>			      <inp id="modelo_origen" dim="15,1" bclr="255,255,255" OnF9="Sel_modelo(modelo_origen)" type="capital" OnChange="Ins_modelo(modelo_origen)" clr="64,64,64" clrBrdr="255,255,255"  type="string" brdr="0,2"/>			      <br/>			        			      <tab n="5"/><txt>Marca Destino:</txt>	<tab/>			      <inp id="marca_destino" dim="15,1" bclr="255,255,255"  OnF9="Sel_marca(marca_destino)" type="capital" OnChange="Ins_marca(marca_destino)" clr="64,64,64"  clrBrdr="255,255,255"  type="string" brdr="0,2"/>			      <br/>			        			         <tab n="5"/><txt>Modelo Destino:</txt>	<tab/>			      <inp id="modelo_destino" dim="15,1" bclr="255,255,255" OnF9="Sel_modelo(modelo_destino)" type="capital" OnChange="Ins_modelo(modelo_destino)" clr="64,64,64"  clrBrdr="255,255,255"  type="string" brdr="0,2"/>			      <br/><br/>			        			        <tab/><txt>Esta rutina modifica las siguientes tablas: KDSERIE,KDMARCAS</txt>	<tab/>			        <br/>			        <tab/><txt>KDMODELOS, KDCTASSER,KDTAB,KDVNTALL,KDSPAQ,KDSPAQM</txt><br/><br/>								       			      <tab n="8"/><bot id="bot_ejecutar" dim="15,0" brdr="5" text="Ejecutar" OnEnter="Ejecutar()" default="0"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,sys,suc_usuario ,perfil_usuario,asterisco  ;			fun Main() {				frn=new FRNT;				kdb=new KDB;				sys=new SYS;								kdb.connect();				kdb.open("s,kdms,i,kdini,c,kdud");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				asterisco = "*";				Inicializa();							}												fun Inicializa(){				var cmd, cuboQuery, xmlResQuery, ok, mensajeError, strTmp;				cuboQuery="datDoc";										//Llenar combo sucursales								cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (perfil_usuario &! "ADMINISTRADOR"  && perfil_usuario &! "ADMINISTRATOR" && "Administrador Kepler 8.0"){							cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rutina_modelos.Inicializa()");								ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_sucN",getXml(cuboQuery));											}									fun Sel_marca(campo_pegar){				  				var cmdQuery = "select c1 as clave, c2 as descripcion from keplersc.kdmarcas ";							frn.dialog("genlistafiltrosel","Marcas",cmdQuery,"clave",campo_pegar,"0","","S");					          			}									fun Ins_marca(campo_pegar){							var xmlRequest,cmd,ok, cuboResultados, mensajeError;									var marca =  frn.get(campo_pegar);								if (campo_pegar &= "marca_origen" ){					frn.rst("marca_origen");					frn.rst("modelo_origen");				}else{					frn.rst("marca_destino");					frn.rst("modelo_destino");				}											cmd = "select c1 from keplersc.kdmarcas where c1 = '" & marca  &  "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rutina_modelos.Ins_marca()");							if(nXml(cuboResultados) &=0 ){				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message("Marca no existe","","Aceptar");					return;				}									frn.set(campo_pegar, marca );										}																fun Sel_modelo(campo_pegar){											var marca;				if (campo_pegar &= "modelo_origen"){					marca = frn.get("marca_origen");									}else{					marca = frn.get("marca_destino");				}								if (marca &= ""){					frn.message("Debes seleccionar una marca antes","","Aceptar");					return;				}				 				var cmdQuery = "select c2 as clave ,c3 as descripcion from keplersc.kdmodelos where c1='" & marca &  "'";							frn.dialog("genlistafiltrosel","Modelos",cmdQuery,"clave",campo_pegar,"0","","S");					          			}										fun Ins_modelo(campo_pegar){							var xmlRequest,cmd,ok, cuboResultados, mensajeError;																	var marca;				if (campo_pegar &= "modelo_origen"){					marca = frn.get("marca_origen");									}else{					marca = frn.get("marca_destino");				}								if (marca &= ""){					frn.message("Debes seleccionar una marca antes","","Aceptar");					frn.rst(campo_pegar);					return;				}								 				cmd = "select c1 from keplersc.kdmodelos where c1 = '" & marca  &  "' and c2='" & frn.get(campo_pegar) & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rutina_modelos.Ins_modelo()");							if(nXml(cuboResultados) &=0 ){				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message("Modelo no existe","","Aceptar");					frn.rst(campo_pegar );					return;				}											}									fun Ejecutar (){										var xmlPantalla,resultado,mensaje,adicionales;							xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaRutinaModelos");								var cmdQuery="select * from keplersc.rutina_modelos('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						var cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"rutina_modelos.Ejecutar()");				resultado= getXml(cuboQuery,"resultado");				mensaje= getXml(cuboQuery,"mensaje");								if(resultado &= "0"){					frn.message(mensaje,"Error","Aceptar");					return;				}				frn.message("Rutina Ejecutada","Mensaje","Aceptar");			}																																			//--------------------------------------EXTRAS-----------------------------------						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}																											}	</script></pag>