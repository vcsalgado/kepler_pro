<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Traspaso">	<grp id="grpMain" brdr="0,0" clr="0,58,112" fnt="Arial,18b" id="k_titulo_inicial" dim="1,-1,10,8" bclr="192,205,213" clrBrdr="0,97,181" tit="Traspaso" unfont="0">		<br/>	<tab/><inp id="k_titulo_inicial" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>	<br/><tab/><hLine clr="0,0,0"/>	<br/><br/>	<tab/>		<grp id="grpDatosGenerales" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="50,10,7,12" tit="Datos generales"  fnt="Arial,16" available="Y" modify="Y">		<sp/><txt clr="0,58,112" hk="S">Sucursal</txt><tab/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" 				brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y"/>			<br/>							<br/>			<sp/><txt clr="0,58,112">Tipo docto</txt><tab/>			<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255" dim="35,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="Valida_Tipo_Docto()" available="Y"/><br/>								<sp/><inp id="datcfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="3,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="1" modify="Y" available="Y" visible="N"/>		</grp><sp/>		<grp id="grpDocumentos" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="25,10,7,12" tit="Documento"  fnt="Arial,16" available="Y" modify="Y">			<tab n="2"/><inp id="operacion" clr="64,64,64"  dim="18,1" brdr="0,1" fnt=",18b" available="N" type="string"/><br/><tab/>			<txt id="foliotxt"  visible="N" hk="F" clr="0,58,112">Folio</txt><tab n="2"/>			<edt id="k_folio" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" visible="N" hk="F" type="string" nc="10"				OnF9="ObtenerFolio()" OnChange = "Formar_folio()"	modify="N" available="Y"/>				<sp n="1"/>							<img id="buscar_folio" dim="20,20"  brdr="0,1" bPx="Y" img="_20_Find.png" OnEnter="ConsultarFolio()" clrBrdr="0,0,0" visible="N" modify="N" available="Y"/>				<br/><tab/>			<inp id="k_docto" clr="64,64,64"  dim="25,1" brdr="0,1" fnt="Arial,16" available="N" link="k_tipon,5" type="string"/><br/>			<tab/><txt clr="0,58,112">Fecha</txt><tab/>			<edt id="k_fecha" dim="15,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" OnButton="Dialog(0,_ks_fecha,k_fecha)" OnF9="Dialog(0,_ks_fecha,k_fecha)" modify="N" available="Y"/><br/><tab/>			<inp id="statusDoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/><br/><tab n="2"/>					</grp><br/><br/><br/>		<tab/>		<grp id="grpDetalle" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5" dim="76,36,7,12" tit="Detalle"  fnt="Arial,16" available="Y" modify="Y">			<grp id="grpInventario" dim="165,40,7,12" hSpace="4" available="Y" modify="Y">								<br/>				<txt>Inventario</txt>				<inp id="k_inventario" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="10" available = "Y" tooltip="Inventario ..." modify="Y" 				OnF9="BusquedaInventario()"				OnChange="MostrarInventario()"/>				<tab n="1"/><txt>Producto:</txt>				<inp id="k_producto" clr="64,64,64" dim="18,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>								<tab/><txt>No-Serie:</txt>				<inp id="k_serie" clr="64,64,64" dim="22,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>								<tab/><txt> Importe :</txt><tab n="1"/>				<inp id="k_importeprevio" clr="64,64,64" dim="10,1" visible="Y" fnt="Arial,16" type="number" modify="N" available="N" nd="2" just="R"/>								<br/><txt>Descripci&#243;n: </txt><tab n="1"/>				<inp id="k_desc_inv" clr="64,64,64"  dim="30,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>								<tab n="2"/><txt>Cliente</txt>				<inp id="k_clave" clr="64,64,64" clrBrdr="255,255,255" tooltip="Seleccionar F9,Nuevo F10,Modificar F11" dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="10" available = "Y" modify="N" 					OnChange="MostrarCliente()"					OnF9="Dialog(3,cat_cli_view,s,k_clave)" OnF10="Dialog(3,cat_cli_crud,Nuevo,x,s,k_clave)" OnF11 = "Dialog(3,cat_cli_crud,Modificar,x,s,k_clave)"/> <tab/>				<br/><grp id="grpDatosClientes" bclr="255,255,255" fntClrBrdr="240,220,200" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="120,7,7,12" fnt="Arial,16" available="Y" modify="Y">								<inp id="k_rfccli" clr="64,64,64" clrBrdr="255,255,255" dim="15,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N" type="string"/>				<tab/><inp id="k_nombreimprfact" clr="64,64,64" clrBrdr="255,255,255"  dim="80,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N" type="string"/>				<br/>				<inp id="k_nombrecli" clr="64,64,64" clrBrdr="255,255,255"  dim="60,1" bclr="255,255,255"  fnt="Arial,16" nr="3,60" modify="Y" available="N" type="string"/>								<inp id="k_callecli" clr="64,64,64" clrBrdr="255,255,255"  dim="50,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N"/>				<br/>				<inp id="k_coloniacli" clr="64,64,64" clrBrdr="255,255,255"  dim="50,1" bclr="255,255,255"  fnt="Arial,16" nr="3,60" modify="Y" available="N"/>								<inp id="k_poblacioncli" clr="64,64,64" clrBrdr="255,255,255"  dim="50,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N"/>				<inp id="k_cpcli" clr="64,64,64" clrBrdr="255,255,255"  dim="8,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N"/>				<br/>				</grp><sp/>				<br/>										<tab n="20"/><txt>Precio del Veh&#237;culo :</txt>				<inp id="k_preciovehiculo" clr="64,64,64" dim="18,1" visible="Y" fnt="Arial,16" type="number" nc="16" modify="N" available="N" nd="2" just="R"/>				<br/>				<tab n="24"/><sp/><txt>IVA :</txt>				<inp id="k_iva" clr="64,64,64" dim="18,1" visible="Y" fnt="Arial,16" type="number" nc="16" modify="N" available="N" nd="6" just="R"/>				<br/>				<tab n="23"/><txt> Importe :</txt><tab n="1"/>				<inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"   bclr="255,255,255" dim="18,1" visible="Y" fnt="Arial,16" type="number" OnChange="monto()" nc="16" modify="Y" available="Y" nd="2" just="R"/>				<br/>				<br/>				<tab n="1"/> <txt>Forma de Pago: </txt> 				<cmb id="k_f_pago" dim="25,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y"/>				<tab n="1"/>				<txt>Cuenta:</txt>				<inp id="k_cuenta" clr="64,64,64" dim="30,1" visible="Y" fnt="Arial,16" type="string"  modify="Y" available="Y" bclr="246,246,246"/>											<br/>								<tab n="1"/><txt id="txt_metodo_pago" visible="Y">Metodo de pago :</txt>				<inp id="k_m_pago" clr="64,64,64" dim="10,1" fnt="Arial,16" type="string" nc="16" modify="N"/>				<tab n="1"/><txt id="txt_uso_cfdi" visible="Y">Uso del CFDI:</txt>				<inp id="k_cfdi" clr="64,64,64" dim="10,1"  fnt="Arial,16" type="string" nc="16" modify="N"/>								<tab n="1"/><txt id="txt_correo" visible="Y">Correo:</txt>				<inp id="k_correo" clr="64,64,64" dim="40,1" fnt="Arial,16" type="string" nc="16" modify="N"/>							<br/>								<tab n="1"/><txt clr="0,58,112">Comentarios:</txt><br/><tab n="2"/>				<inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="60,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y"/>				<br/><tab n="2"/><inp id="k_coment2" clr="64,64,64" clrBrdr="255,255,255"  dim="60,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y"/>				<br/><tab n="2"/><inp id="k_coment3" clr="64,64,64" clrBrdr="255,255,255"  dim="60,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y"/>							</grp>		</grp>		<br/>		<tab n="17"/>		<img id="Cancelar" dim="60,60" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/><tab/>		<img id="Aceptar" dim="60,60" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><tab/>			</grp>	<tools>		<tool OnMouseL="Ejecuta()" tooltip="Aceptar documento(Ctrl+T)" scut="Ctrl+T" img="_TL_Execute.png"/>	</tools>	<script>		InstallDriver("KDB75");		class Main {			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc,usuario,sucursal_id,suc_usuario,rol_usuario,asterisco, v_inventario,valorRetorno,v_IvaAuto,v_correo,v_uso_cfdi;			var frn,kdb,rep,frP,sys;			var tip_ope;//Tipo de operación. "0" indica Alta; "1" indica consulta;			var uen,v_KDM1_iva,v_KDM1_precio, v_KDM1_precio_vehiculo, fileSavePath;			var anio_contable;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("c,kdm1,i,kdini,q,kdiq,m,kdmm,s,kdms,u,kdxd,v,kdxv,p,kdip,e,kdxe,f,kdxf,w,kdc2");				ConfiguraControlesOff();				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				fileSavePath = "C:\Basura";				asterisco = "*";				inicializa();			}					fun ConsultarFolio()			{				var xmlRequest,cmd,ok, cuboResultados, mensajeError;				 				cmd = "select * from keplersc.kdm1 where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc &"' and c3 = '" & nat_doc &  "' and c4 = '" & gpo_doc &  "' and c5 = '" & tip_doc &  "' and c6 = '" & frn.get("k_folio") & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.ConsultarFolio()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				frn.set("k_inventario",getXmlAtt(cuboResultados,"r0","c100"));				frn.set("k_clave",getXmlAtt(cuboResultados,"r0","c10"));						MostrarCliente();				v_KDM1_iva = getXmlAtt(cuboResultados,"r0","c14");				v_KDM1_precio = getXmlAtt(cuboResultados,"r0","c16");				v_KDM1_precio_vehiculo = v_KDM1_precio - v_KDM1_iva ;								frn.set("k_monto",v_KDM1_precio);				frn.set("k_importeprevio",v_KDM1_precio_vehiculo);				frn.set("k_preciovehiculo",v_KDM1_precio_vehiculo);				frn.set("k_iva",v_KDM1_iva);				frn.set("k_f_pago",descr_combo("k_f_pago",1, getXmlAtt(cuboResultados,"r0","c160") ) );					frn.set("k_m_pago",getXmlAtt(cuboResultados,"r0","c162"));				frn.set("k_cfdi",getXmlAtt(cuboResultados,"r0","c164"));				frn.set("k_correo",getXmlAtt(cuboResultados,"r0","c165"));								frn.set("k_coment",getXmlAtt(cuboResultados,"r0","c24"));				frn.set("k_coment2",getXmlAtt(cuboResultados,"r0","c25"));				frn.set("k_coment3",getXmlAtt(cuboResultados,"r0","c26"));				//sección de KDINF								cmd = "select c3,c4,c5 from keplersc.kdinf where c1 = '" & sucursal_id &  "' and c2 = '" & frn.get("k_inventario") &  "' ";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.ConsultarFolio()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				frn.set("k_producto",getXmlAtt(cuboResultados,"r0","c3"));				frn.set("k_desc_inv",getXmlAtt(cuboResultados,"r0","c4"));				frn.set("k_serie",getXmlAtt(cuboResultados,"r0","c5"));			}								fun ObtenerFolio()			{				   var cmdQuery ="",v_tipo_n;					v_tipo_n = frn.get("k_tipon",-1,4);					sucursal_id = frn.get("k_sucn",-1,1);					cmdQuery = "select c1 as tip, c6 as folio, c9 as fecha,c11 as referencia, c16 as monto from keplersc.kdm1  where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc&  "' and c3 = '" & nat_doc&  "' and c4 = '" & gpo_doc&  "' and c5 = '" & v_tipo_n &  "' ";					cmdQuery = cmdQuery & " order by c6 asc ";					frn.dialog("genlistasel","Documentos de Traspasos",cmdQuery,"folio","k_folio","0","","N");			}												fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);		}											fun Consulta(){//Imprime el reporte del documento especificado 				if(strlen(trim(frn.get("k_folio")))==0){ 					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");					frn.setPos("k_folio");return;					}				//reporte();				frn.setPos("k_folio");			}									fun MostrarCliente()			{				var xmlRequest,					 cmd,					 ok, 					 cuboResultados,					 mensajeError, 					 v_cliente;					 v_correo = "";					 v_uso_cfdi="";					 v_cliente= frn.get("k_clave" , -1, 1);					 cmd = "select c30,c4,c5,c6,c10,c11,c16,c52,c53,c27 from keplersc.kdud where c2 = '" & v_cliente & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.MostrarCliente()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				frn.set("k_nombreimprfact",getXmlAtt(cuboResultados,"r0","c30"));				frn.set("k_nombrecli",getXmlAtt(cuboResultados,"r0","c3"));				frn.set("k_callecli",getXmlAtt(cuboResultados,"r0","c4"));				frn.set("k_coloniacli",getXmlAtt(cuboResultados,"r0","c5"));				frn.set("k_poblacioncli",getXmlAtt(cuboResultados,"r0","c6"));				frn.set("k_rfccli",getXmlAtt(cuboResultados,"r0","c10"));				frn.set("k_cpcli",getXmlAtt(cuboResultados,"r0","c27"));				v_correo = getXmlAtt(cuboResultados,"r0","c11");				v_uso_cfdi = getXmlAtt(cuboResultados,"r0","c53");				frn.set("k_m_pago",getXmlAtt(cuboResultados,"r0","c52"));				frn.set("k_cfdi",v_uso_cfdi );				frn.set("k_correo",v_correo );			}			//INVENT								fun MostrarInventario() 			{				var xmlRequest,cmd,ok, cuboResultados, mensajeError,totOrd,contOrd;					 				sucursal_id = frn.get("k_sucn",-1,1);				v_inventario = frn.get("k_inventario");									 				cmd = "select c2,c3,c4,c5,c20 from keplersc.kdinf where c1 ='" & sucursal_id &  "' and c2 ='" & v_inventario & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.MostrarInventario()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}							frn.set("k_serie",getXmlAtt(cuboResultados,"r0","c5"));				frn.set("k_producto",getXmlAtt(cuboResultados,"r0","c3"));				frn.set("k_desc_inv",getXmlAtt(cuboResultados,"r0","c4"));											frn.set("k_monto",0);				frn.set("k_iva",0);				frn.set("subt",0);												cmd = "select c31,c33 from keplersc.kdicom where c1 = '" & sucursal_id &  "' and c2 = '" & v_inventario & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.MostrarInventario()");								var totres = nXml(cuboResultados);				if (totres > 0){					var subtotal_compra= getXmlAtt(cuboResultados,"r0","c31");					var hold_back = getXmlAtt(cuboResultados,"r0","c33");					var importe = (subtotal_compra + hold_back)*(1+16/100);					frn.set("k_monto" , importe );								}else{									cmd = "select c8,c9 from keplersc.kdlinv where c1 = '" & sucursal_id &  "' and c2 = '" & v_inventario & "'";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.MostrarInventario()");					ok = getXmlAtt(cuboResultados ,"ok");					if(ok &! "" && !ok)					{					  mensajeError = getXmlAtt(cuboResultados ,"native3");					  frn.message(mensajeError,"Criterios no encontrados","Aceptar");					  return;					}									totres = nXml(cuboResultados);					if (totres > 0){											var ultimo_costo = getXmlAtt(cuboResultados,"r0","c8");						var ultimo_iva = getXmlAtt(cuboResultados,"r0","c9");						frn.set("k_monto" , ultimo_costo + ultimo_iva );										}								}								monto();			}						fun monto(){							var precio_vehiculo = frn.get("k_monto")/(1+16/100);				frn.set("k_iva",frn.get("k_monto") - precio_vehiculo );				frn.set("k_importeprevio" ,precio_vehiculo  );				frn.set("k_preciovehiculo" ,precio_vehiculo  );						}					fun BusquedaInventario()			{				var cmdQuery ="";					sucursal_id = frn.get("k_sucn",-1,1);					cmdQuery = "select c2 as inventario, c3 as Clave,c4 as Descripcion, c5 as Serie from keplersc.kdinf where c1 = '" & sucursal_id &  "' and c31 =20 and c32 = 0 ";						cmdQuery = cmdQuery & " order by c2 asc ";						frn.dialog("genlistasel","Inventarios",cmdQuery,"inventario","k_inventario","0","","N");            			}							fun inicializa(){//Da valor a los combos y prepara la página dependiendo del tipo de Operación a realizar				var resValidacion, 						resMensaje, 						cubo, 						cmd, 						ok,						mensajeError,						sucursal_id,						v_cliente,						v_tipoOperacion;				kdb.kde("KDE");//								Configuración del servidor				kdb.exec();				anio_contable = kdb.get("KDE","14");				frn.set("k_fecha",sys.date());												if(frn.nParam()>0 ){//Se han mandado parámetros a la página					gen_doc=trim(frn.param(0)); 					nat_doc=trim(frn.param(1)); 					gpo_doc=trim(frn.param(2));					tip_doc=trim(frn.param(3)); 					fija_doc=trim(frn.param(4));					tip_ope=trim(frn.param(5));					uen=trim(frn.param(6));				}				else				{					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}				ConfiguraCamposOpcion();				if(tip_ope==0)				{					v_tipoOperacion = "Alta Traspaso";				}								if(tip_ope==1)				{					v_tipoOperacion = "Consulta Traspaso";				}				frn.set("k_titulo_inicial",v_tipoOperacion);							//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_sucn",getXml(cubo));													cmd = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTipoDocto");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_tipon",getXml(cubo));								// Fill Combo forma de pago(Con Query de PostgreSQL)				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3fp";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd ,"ven_traspaso_crud.Inicializa()");				ok=getXmlAtt(cubo ,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo ,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_f_pago",cubo );																Fecha();//Indica fecha correcta, y trae monedas y paridades de esa fecha. 				if (strlen(tip_doc)>0) frn.setPos("k_tipon",-1,4,"internal:Y","val:" & tip_doc);//Posiciona el combo de Tipo de documento al especificado como parï¿½metro								//				if(tip_ope==0){//Alta					frn.set("operacion","ALTA");				}				else if(tip_ope==1){//Consulta					frn.set("operacion","CONSULTA");				}							BorraDatos();								frn.set("datcfdi","N");		//Pantalla validacion CFDI			}								fun ConfiguraControlesOff()			{				var strValAtr;				strValAtr = "N";				//Deshabilita todos los campos y botones				frn.setAtt("grpDatosGenerales","available",strValAtr);				frn.setAtt("grDocumentos","available",strValAtr);								frn.setAtt("grpDetalle","available",strValAtr);				frn.setAtt("grpInventario","available",strValAtr);				frn.setAtt("grpconceptosextras","available",strValAtr);				frn.setAtt("grpComentarios","available",strValAtr);				frn.setAtt("Aceptar","available",strValAtr);				frn.setAtt("Aceptar","visible",strValAtr);					frn.setAtt("Cancelar","available",strValAtr);				frn.setAtt("Cancelar","visible",strValAtr);					frn.setAtt("foliotxt","visible",strValAtr);								frn.setAtt("k_folio","modify",strValAtr);					frn.setAtt("k_folio","visible",strValAtr);				frn.setAtt("buscar_folio","modify",strValAtr);					frn.setAtt("buscar_folio","visible",strValAtr);									frn.setAtt("k_coment","modify",strValAtr);				frn.setAtt("k_coment","available",strValAtr);				frn.setAtt("k_coment2","modify",strValAtr);				frn.setAtt("k_coment2","available",strValAtr);									frn.setAtt("k_monto","modify",strValAtr);								frn.setAtt("k_coment3","modify",strValAtr);				frn.setAtt("k_coment3","available",strValAtr);				frn.setAtt("k_rfccli","available",strValAtr);				frn.setAtt("k_nombrecli","available",strValAtr);				frn.setAtt("k_callecli","available",strValAtr);				frn.setAtt("k_coloniacli","available",strValAtr);				frn.setAtt("k_poblacioncli","available",strValAtr);				frn.setAtt("k_cpcli","available",strValAtr);					frn.set("k_f_pago",descr_combo("k_f_pago",1, "99"));								}						fun ConfiguraCamposOpcion(){				var strValAtr;				ConfiguraControlesOff();				//HAbilita segun tipo de operacion				strValAtr = "Y";				switch(tip_ope){					case 0: //Alta						frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpDatosGenerales","modify",strValAtr);						frn.setAtt("grDocumentos","available",strValAtr);						frn.setAtt("grDocumentos","modify",strValAtr);						frn.setAtt("grpDetalle","available",strValAtr);						frn.setAtt("grpDetalle","modify",strValAtr);						frn.setAtt("grpInventario","available",strValAtr);						frn.setAtt("grpInventario","modify",strValAtr);						frn.setAtt("grpconceptosextras","available",strValAtr);						frn.setAtt("grpconceptosextras","modify",strValAtr);						frn.setAtt("grpComentarios","available",strValAtr);						frn.setAtt("grpComentarios","modify",strValAtr);						frn.setAtt("k_monto","modify",strValAtr);							frn.setAtt("Aceptar","available",strValAtr);						frn.setAtt("Aceptar","visible",strValAtr);							frn.setAtt("Cancelar","available",strValAtr);						frn.setAtt("Cancelar","visible",strValAtr);								frn.setAtt("k_cuenta","available",strValAtr);						frn.setAtt("k_cuenta","visible",strValAtr);								frn.setAtt("k_coment","modify",strValAtr);						frn.setAtt("k_coment","available",strValAtr);						frn.setAtt("k_coment2","modify",strValAtr);						frn.setAtt("k_coment2","available",strValAtr);						frn.setAtt("k_coment3","modify",strValAtr);						frn.setAtt("k_coment3","available",strValAtr);																		break;					case 1: //Consulta												frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("k_folio","modify",strValAtr);							frn.setAtt("k_folio","visible",strValAtr);												frn.setAtt("k_folio","available",strValAtr);						frn.setAtt("foliotxt","visible",strValAtr);										frn.setAtt("buscar_folio","modify",strValAtr);							frn.setAtt("buscar_folio","visible",strValAtr);																break;					default:				}											}									fun BorraDatos(){ //Limpia todos los campos para generar un nuevo documento. 				frn.set("k_folio","","statusDoc","","k_clave","");								if(tip_ope>0) frn.setPos("k_folio");					frn.set("k_f_pago",descr_combo("k_f_pago",1, "99"));					frn.rst("k_clave");				frn.rst("k_nombrecli");				frn.set("datcfdi","N");		//Pantalla validacion CFDI				frn.rst("k_callecli");				frn.rst("k_coloniacli");				frn.rst("k_poblacioncli");				frn.rst("k_cpcli");				frn.rst("k_m_pago");					frn.rst("k_cfdi");				frn.rst("k_cuenta");						frn.rst("k_correo");				frn.rst("k_inventario");				frn.rst("k_producto");				frn.rst("k_serie");					frn.rst("k_importeprevio");					frn.rst("k_preciovehiculo");						frn.rst("k_iva");						frn.rst("k_monto");							}										fun Ejecuta(){				if(tip_ope==0){Alta();}				else if(tip_ope==1){Consulta();}			}									fun Alta()			{				var resultado, mensaje , mensajeError , cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd,ok,continua ;				var partidasValidas = 0;				kdb.rst();				frn.rst("results");								if( frn.get("k_monto") <= 0 )				{					frn.message("Monto cero ó negativo","Error","&Aceptar");return;				}												//Pantalla validacion CFDI				if (frn.get("datcfdi") &= "N"){					frn.dialog("icfdreview",frn.get("k_sucn",-1,1),frn.get("k_clave"),"Alta","cmb",frn.get("k_f_pago",-1,1),frn.get("k_cuenta"),frn.get("k_m_pago"), "inp", frn.get("k_cfdi") );					return;				}					continua = frn.message("¿Desea continuar con la alta de la factura?","Atención",2);				if (continua == 0){					frn.set("datcfdi","N");	//Pantalla validacion CFDI					return;				}				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;																fecha = sys.date();				hora= sys.time();				//cubo = "dat";				kdb.rst();				frn.rst("results");								strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								 //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				setXml(xmlPantalla ,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlPantalla ,"movimiento","fecha",strFecha);				setXml(xmlPantalla ,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"k_refer",frn.get("k_inventario"));				setXml(xmlPantalla,"k_claveinv",frn.get("k_inventario"));				setXml(xmlPantalla,"k_serievehiculo",frn.get("k_serie"));				setXml(xmlPantalla,"k_cond","Contado");						frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantalla");				cmd ="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cubo);				rstXml(cubo);									cubo= frn.lib("libGeneral.kpl","EjecutarSql",cmd ,"ven_traspaso_crud.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cubo, fileSavePath & "\XmlResultado");									resultado = getXml(cubo,"resultado");				mensaje = getXml(cubo,"mensaje");									ok = getXmlAtt(cubo,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}										if(resultado &= "1")				{					tip_ope = 1;					frn.set("k_folio",mensaje); 					frn.set("operacion","CONSULTA");										strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);					ConfiguraCamposOpcion();										mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;					frn.message(mensaje, "Mensaje","&Aceptar");				}else{					frn.message(mensaje, "Error","&Aceptar");					frn.set("datcfdi","N");	//Pantalla validacion CFDI				}			}													//-------------------------------------------EXTRAS----------------------------------------------------						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}													fun Valida_Tipo_Docto(){				var resValidacion, resMensaje, cubo, cmd, ok, tip_doc;							//Valida documento vigente				tip_doc=frn.get("k_tipon",-1,4);				kdb.rst();								cmd= "select * from keplersc.verify_valid_document('" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & tip_doc & ")"; //genero text, naturaleza text, grupo integer, tipo_movto integer				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Valida_Tipo_Docto()");								resValidacion= getXml(cubo,"validacion","resultado");				resMensaje = getXml(cubo,"validacion","mensaje");				if(resMensaje &! ""){					frn.message(resMensaje, "Mensaje","&Aceptar");					frn.setPos("k_tipon");				}								}												fun Fecha(){//Verifica que la fecha del documento sea correcta. Ademï¿½s trae monedas y paridades de esa fecha. 				var cubo, cmd, resValidacion, resMensaje, fecha;				var validDate=frn.lib("libKepler","ValidOpDate",frn.get("k_fecha"));								kdb.rst();				frn.rst("results");				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				if (tip_ope == 0 ){					cmd= "select * from keplersc.verify_year('" & fecha & "')";					cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Fecha()");									;										resValidacion= getXml(cubo,"validacion","resultado");					resMensaje = getXml(cubo,"validacion","mensaje");					if(resMensaje &! ""){						frn.message(resMensaje, "Mensaje","&Aceptar");					}											if(resValidacion &= "0"){						frn.setPos("k_fecha");						return;					}									}			}													fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaciï¿½n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se estï¿½ en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}			}				</script></pag>