<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<tab/><txt fnt=",22" clr="0,0,0">Asignacion de autos Nuevos Toyota</txt><br/>		<tab/><hLine clr="0,0,0"/> 		<br/>		<br/>		<grp id="grid" dim="85,25,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">			<sp n="1"/> 			<tbl id="k_mov" dim="119,14" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" hk="z" Reorder="N" modify="Y" insdel="N" visible="Y">				<col id="Sel" name="Sel" type="capital" nc="1" modify="Y" available="Y" visible="Y"/>				<col id="modelo" name="Modelo"  type="capital" nc="18" modify="N" available="Y" visible="Y"/>			   <col id="invent" name="Invent." type="capital" modify="N" nc="10" visible="Y"/>						<col id="anio" name="Anio" type="string" nc="4" modify="N" visible="Y"/>				<col id="descrip" name="Descripcion" type="string" nc="50" modify="N" available="Y" visible="Y"/>				<col id="serie" name="Serie" type="capital" nc="17" modify="N" available="Y" visible="Y"/>				<col id="color" name="Color" type="string" nc="10" modify="N" available="Y" visible="Y"/>				<col id="vest" name="Vest"  type="string" nc="10" modify="N" available="Y" visible="Y"/>				<col id="ref" name="Referencia" type="string" nc="12" modify="N" visible="Y"/>				   </tbl><br/><br/><tab/><bot id="bot_aceptar" dim="10,0" brdr="5" text="Aceptar"/>			<br/>		</grp>		</grp>			<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP,sys;			var cmdQuery, cuboQuery, ok, mensajeError, usuario, asterisco;						fun Main() {				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;								sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				asterisco = "