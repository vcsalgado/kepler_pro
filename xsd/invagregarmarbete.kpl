<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<br/>		<tab/><txt clr="0,0,0" fnt=",22">Agregar Marbete</txt>		<br/>		<tab/><hLine dim="-1,1" clr="0,0,0"/>		<br/>		<tab/>		<br/>		<tab/>				<grp dim="60,13,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Generar Marbetes">			<br/>			<sp/><txt> Sucursal: </txt>			<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/>			<br/>			<sp/><txt> Parte: </txt>			<inp id="k_parte" dim="12,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="20" tooltip="F9 consultar partes" 				OnChange="ValidaArticulo()" OnF9="ConsultaProductos()"/>			<sp/>			<inp id="inp_descripcion" dim="40,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>			<br/><sp n="2"/><br/><tab n="9"/>			<bot id="bot_aceptar" dim="7" brdr="5" text="Agregar" hk="G" OnEnter="Execute()"/>		</grp>		<br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco ;			var cmd,cubo,ok,mensajeError ;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";				Inicializa();							}			fun Inicializa(){				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invgenerarmarbets.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));				//frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));				}									fun Execute() {				var xmlRequest;				xmlRequest="<document>" & "<sucursal_id>" & frn.get("k_sucN",-1,1) & "</sucursal_id><parte>" & frn.get("k_parte")& "</parte>" &"</document>";								cmd="SELECT * FROM keplersc.invr_generar_marbetes('" & xmlRequest & "')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"invgenerarmarbetes.Execute()");										frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboMarbetes");							var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								if(resultado &= "1"){					var mensaje = "Parte agregada.";					frn.message(mensaje ,"Mensaje","Aceptar");				}			}						fun ValidaArticulo() {				var cuboProd,ok,mensajeError,prodExiste, valorRetorno, prod_original, xmlRequest;				frn.set("inp_descripcion","");								valorRetorno = frn.get("k_parte");				cmd="select * from keplersc.prod_obtener_original('" & valorRetorno & "')";				cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"generacotizacion.ValidaArticulo()");//frn.lib("libGeneral.kpl","FileSave",cuboProd,"C:\Basura\cuboParte");				ok=getXmlAtt(cuboProd,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												prod_original = getXmlAtt(cuboProd,"r0","prod_obtener_original");				if (prod_original &= "0"){					mensajeError="El producto " & valorRetorno & " no existe.";					frn.message(mensajeError,"Error","Aceptar");					return;				}else{					if (prod_original &! valorRetorno){						mensajeError="El producto " & valorRetorno & " no es el original, se reemplazará por " & prod_original;						frn.message(mensajeError,"Mensaje","Aceptar");						frn.set("k_parte",getXmlAtt(cuboProd,"r0","prod_obtener_original"));					}				}								//Obtener detalle de producto				rstXml(cuboProd);								valorRetorno = frn.get("k_mov",-1,"k_parte");				cmd = "select c1,c2,c19,c11 from keplersc.kdini where c1 = '" & prod_original &  "'"; 				cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"generacotizacion.ValidaArticulo()");//frn.lib("libGeneral.kpl","FileSave",cuboProd,"C:\Basura\cuboParte");				ok=getXmlAtt(cuboProd,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				prodExiste = nXml(cuboProd);				if (prodExiste==0){					frn.message("El producto no existe.","Error","Aceptar");					return;				}								frn.set("inp_descripcion",getXmlAtt(cuboProd,"r0","c2"));			}												fun ConsultaProductos(){				var cmdQuery;				cmdQuery="select c1 as parte,c2 as descripcion from keplersc.kdini";				frn.dialog("genlistafiltrosel","Catálogo de partes",cmdQuery,"parte","k_parte","0","","","N");			}												}	</script></pag>