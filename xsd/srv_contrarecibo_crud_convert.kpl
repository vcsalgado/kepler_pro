<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Contrarecibo - Compr">	<!-- dim="1,-1,10,20" -->	<grp dim="1,-1,10,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<!-- <tab/> -->  <sp n="2"/>	<txt fnt=",22" clr="0,0,0">Contrarecibo - Comprobacion de Documento</txt><br/>	<!-- <tab/> -->  <sp n="2"/>	<hLine clr="0,0,0"/> 	<br/> <br/>	<!-- <tab/> -->  <sp n="2"/>		<!-- dim="46,9,7,12" -->		<!--dim="49,11,7,12" -->		<grp dim="40,12,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,16" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">			<sp n="1"/> <txt>Sucursal :</txt> <sp n="2"/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="43,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" tooltip="Sucursal" available="Y" modify="Y"/>			<br/> <!-- <br/> -->			<sp n="1"/> <txt>Tipo :</txt> <sp n="6"/>			<cmb id="k_tipon" dim="43,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo()" tooltip="Tipo de Movimiento" available="N"/>			<br/>			<!-- <tab n="4"/> --> <sp n="12"/>			<inp id="statusdoc" clr="64,64,64"  dim="43,1" brdr="0,1" fnt=",16b" available="N"/>						<br/>			<sp n="1"/> <txt id="textProvPago" clr="6,31,255" hk="P" visible="Y">Proveedor de Pago :</txt>			<sp n="1"/>			<edt id="k_clave_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 				OnButton="Get_Cat(1)" OnF9="Get_Cat(1)" OnChange="BuscarProvPago()" 				type="capital" nc="7" tooltip="Proveedor de Pago" modify="Y" hk="C" available="N" visible="Y"/> 			<br/>			<sp n="1"/>			<!-- clr="64,64,64" -->			<inp id="k_nombreprov_pago" clr="6,31,255" clrBrdr="255,255,255"  dim="54,1" fnt="Arial,16" type="capital" modify="N" available="N" nc="50" visible="Y"/>						</grp>		<sp/>		<!-- dim="34,10,7,12" -->		<!-- dim="38,11,7,12" -->		<!-- dim="47,11,7,12" -->		<grp dim="55,12,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,16" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="1"/>			<inp id="operacion" dim="22,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="L" available="N"/>			<!-- <tab/> -->						<sp n="3"/> <txt>F.Compr :</txt> <sp n="1"/> 			<edt id="k_fecha" dim="14,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N" tooltip="Fecha"/> 			<sp n="2"/> 			<txt>Hora Doc. :</txt> <sp n="1"/> 			<edt id="k_hora" dim="14,1" type="time" nc="-1" bclr="240,240,240" fmt="HH:MM:SS" available="N"/> 						<br/>			<sp n="1"/> <txt id="textProvOper" hk="P" visible="Y">Proveedor Doc. :</txt>			<sp n="1"/>			<edt id="k_clave_oper" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 				OnButton="Get_Cat(3)" OnF9="Get_Cat(3)" OnChange="BuscarProvOper()" 				type="capital" nc="7" tooltip="Proveedor Documento" modify="Y" hk="C" available="Y" visible="Y"/> 						<sp n="4"/> <txt>RFC : </txt><sp n="1"/>			<inp id="k_rfc_oper" clr="64,64,64"  dim="20,1" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>				<br/>			<sp n="1"/>			<!-- clr="64,64,64" -->			<inp id="k_nombreprov_oper" clr="64,64,64" clrBrdr="255,255,255"  dim="66,1" fnt="Arial,16" type="capital" modify="N" available="N" nc="50" visible="Y"/>						<br/>									<sp n="1"/> <txt id="textFolio" visible="Y">Folio :</txt> <!-- <sp n="1"/> -->			<!-- "ObtenerFolio()" -->			<!-- "Formar_folio()" -->			<edt id="k_folio" dim="16,1" brdr="2,0" OnChange="Formar_folio()" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="10" tooltip="Folio ( F9 b&#250;squeda )" modify="Y" available="Y" visible="Y" OnF9="ObtenerCxP()" 			OnButton="ObtenerCxP()"/>	<sp n="2"/>			<!-- "BuscarFolio()" -->			<img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="BuscarDoc()" available="Y" clrBrdr="0,0,0" visible="Y"/>						<sp n="2"/> <txt>F. Doc. :</txt> <sp n="1"/> 			<edt id="c_fecha" dim="14,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N" tooltip="Fecha Docto"/> 			<sp n="2"/>			<txt fnt=",">Monto :</txt> <!-- <sp n="1"/> -->			<inp id="c_monto" dim="14,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="L" nd="2" fnt=",0b" clr="64,64,64" available="N"/>			<br/>			<!-- <br/> -->			<sp n="1"/> <txt id="textRefDoc" visible="Y">Referencia Complemento :</txt> <sp n="2"/>			<!-- fnt=",16" -->			<inp id="k_docto" dim="52,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="L"/>						<!-- <br/> -->					</grp>				<br/>		<br/>				<!-- <tab/> -->  <sp n="2"/>		<!-- dim="81,16,7,12" -->		<!-- dim="88,16,7,12" -->		<!-- dim="88,18,7,12" -->		<grp dim="96,18,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,16" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Proveedor">						<!-- Selecciona UUID : -->			<sp n="1"/> <txt id="textRef" clr="0,58,112">Selecciona XML / Captura Referencia :</txt>			<sp n="2"/> <!-- <sp/> -->						<!-- dim="80,1" -->			<inp id="k_refer" clr="64,64,64" clrBrdr="255,255,255"  dim="60,1" bclr="255,255,255" brdr="2,0" nc="40" fnt="Arial,16" type="capital"  modify="Y" 					 tooltip="Factura del Proveedor" available="N"/>					<sp n="5"/>			<!-- OnEnter="ObtenerFactura()" -->			<bot id="Buscar" dim="10" brdr="5" OnEnter="ProcesarFactura()" tooltip="Busca UUID de la factura del proveedor" available="N" visible="N"/>				<!-- <br/> -->						<!--			<sp n="4"/>			<txt id="text_chk" fnt="Arial,16b" clr="0,58,112" bclr="255,255,255" visible="Y">Por Comprobar  </txt>			<chck id="chk_pc" clr="64,64,64"  dim="3,21" bclr="255,255,255" brdr="2,0" YN="10" clrBrdr="255,255,255" OnChange="Change_Mode()" available="Y" visible="Y"/>			-->			<br/>						<!-- dim="38,9,7,12" -->			<!-- dim="48,11,7,12" -->			<!-- dim="48,13,7,12" -->			<!-- dim="52,13,7,12" -->			<grp dim="58,13,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">								<sp n="1"/> <txt clr="0,58,112" hk="P">Proveedor : </txt><tab/>				<!-- OnChange="BuscarProveedor()" -->				<!-- OnButton="Dialog(3,cxpcatprobus,k_clave)" -->				<!-- OnF9="Dialog(3,cxpcatprobus,k_clave)" -->				<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnButton="Get_Cat(2)" OnF9="Get_Cat(2)" OnChange="BuscarProveedor_NoXML()" 					type="capital" nc="7" tooltip="Proveedor ( F9 b&#250;squeda )" modify="Y" hk="C" available="N"/> 				<br/>				<sp n="1"/> <txt>RFC : </txt><sp n="5"/>				<inp id="k_rfc" clr="64,64,64"  dim="20,1" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>					<br/>				<sp n="1"/> <txt clr="0,58,112" fnt=",b">Datos UUID : </txt><sp n="5"/>				<br/>				<sp n="1"/> <txt clr="0,58,112">Serie : </txt> <sp n="1"/> 				<!-- dim="20,1" -->				<inp id="k_uuid_serie" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="30,1" fnt="Arial,16" type="string" nc="18" modify="N" available="N"/>				<br/>				<sp n="1"/> <txt clr="0,58,112">Folio : </txt> <sp n="1"/> 				<inp id="k_uuid_folio" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="30,1" fnt="Arial,16" type="string" nc="18" modify="N" available="N"/>				<br/>								<sp n="1"/> <txt clr="0,58,112">Total : </txt> <sp n="1"/>				<!-- dim="20,1" --> 				<inp id="k_uuid_monto" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="17,1" fnt="Arial,16" type="string" nc="18" modify="N" available="N"/>												<sp n="3"/> <txt clr="0,58,112">Impuesto : </txt> <!-- <sp n="1"/> -->				<inp id="k_uuid_impuesto" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="17,1" fnt="Arial,16" type="string" nc="18" modify="N" available="N"/>								<br/>								<sp n="1"/> <txt clr="0,58,112">Fecha : </txt> <!-- <sp n="1"/> -->				<!-- dim="20,1" -->				<inp id="k_uuid_fecha" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="17,1" fnt="Arial,16" type="string" nc="12" modify="N" available="N"/>										</grp>			<sp n="1"/>						<!-- dim="75,9,7,12" -->			<!-- dim="75,13,7,12" -->			<!-- dim="71,13,7,12" -->			<grp dim="77,13,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="1,5" fnt="Arial,16">				<sp n="2"/> <txt>Datos del proveedor : </txt>				<br/>				<sp n="2"/>					<inp id="k_nombreprov" clr="64,64,64" clrBrdr="255,255,255"  dim="73,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="2"/>				<inp id="k_calleprov" clr="64,64,64" clrBrdr="255,255,255"  dim="73,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="2"/>				<inp id="k_coloniaprov" clr="64,64,64" clrBrdr="255,255,255"  dim="73,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="2"/>				<inp id="k_poblacionprov" clr="64,64,64" clrBrdr="255,255,255"  dim="55,1" fnt="Arial,16" type="string" modify="N" available="N" nc="50" visible="Y"/>				<sp n="3"/>				<inp id="k_cpprov" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt="Arial,16" type="string" modify="N" available="N" nc="10" visible="Y"/>								<br/>				<sp n="2"/><txt fnt=",">Plazo:</txt> <sp n="1"/>				<!-- OnChange="plazo()" Updated by JMM 20240206 -->				<inp id="k_plazo" dim="8,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" OnChange="Plazo()" just="R" clr="64,64,64" available="N" fmt="5"/>				<!-- <br/> -->				<sp n="7"/><txt fnt=",">Fecha de Pago :</txt> <sp n="1"/>				<edt id="k_vence" dim="15,1" type="date" OnChange="Vence()" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_vence" OnF9="Dialog(3,_ks_fecha,k_vence)" clrBrdr="255,255,255" available="N" tooltip="Fecha"/> 			</grp>								</grp>		<br/>		<br/>			<!-- <tab/> -->  <sp n="2"/>		<!-- dim="81,28,7,12" -->		<!-- dim="88,23,7,12" -->		<grp dim="88,18,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="236,240,243" fntBrdr="Arial,16" hSpace="4" fnt="Arial,16" tit="Seleccion de Documentos  -   Ctrl + Del [Eliminar Registro]">		<!-- <tab/> -->  		<sp n="1"/> 		<!-- dim="110,8" -->		<!-- fnt="Arial,15" -->		<tbl id="k_mov" dim="123,7" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" 				  hk="z" Reorder="N" modify="N" OnChange="CalcTotal()"  insdel="Y" available="N">			<col id="k_cuenta" name="Cuenta"  type="capital" OnF9="select_cuenta()"  OnChange="Cuenta()" visible="Y" modify="Y" np="90" available="Y"/>			<col id="k_cuentadesc" name="Nombre Cuenta" type="string" nc="35" modify="N" visible="Y" available="N" np="150"/>				<col id="k_cuentasaldo" name="Cuenta Saldo"  type="number" nd="2" nc="15" np="120" modify="Y" visible="N" available="N"/>			<col id="k_cargo" name="Cargo"  type="number" nd="2" OnChange="Cargo()" nc="15" available="Y" modify="Y" visible="Y" np="80"/>			<col id="k_abono" name="Abono"  type="number" nd="2" OnChange="Abono()" nc="15" available="Y" modify="Y" visible="Y" np="80"/>			<col id="k_inventario" name="Inventario" visible="Y" modify="Y" available="Y" OnF9="busca_inv()" OnChange="Inventario()" np="80"/>			<col id="k_afecta" name="Afecta U / A" type="capital" visible="Y" modify="Y" available="Y" OnChange="Afecta()"  np="60" nc="1"/>			<col id="k_ctopto" name="Presupuesto" type="capital" visible="Y" modify="Y" available="Y" OnF9="busca_ctopto()" OnChange="Prspto()"  np="60" nc="10"/>		</tbl>		<br/>				<!-- <tab/> -->				<!-- dim="70,20,7,12" -->		<grp dim="75,19,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,16" hSpace="4" fnt=",0">				<!-- <br/> -->				<sp n="1"/> <txt fnt=",">Comentarios:  </txt>		<inp id="k_coment" dim="60,4" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="capital" modify="N" available="Y" clr="64,64,64"/>		<br/> 		<br/> 		<!-- <br/> -->				<!-- Aqui estaban botones de Accion -->				</grp>				<!-- <tab n="2"/> -->  <sp n="5"/>				<!-- dim="40,20,7,12" -->		<grp dim="43,19,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,16" hSpace="4" fnt=",0">		<sp/><txt fnt=",">Subtotal:  </txt><tab n="3"/>		<inp id="k_subtotal" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" clr="64,64,64" available="N"/><br/>				<sp/><txt fnt=",">IVA:  </txt><tab n="4"/>		<inp id="k_iva" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" clr="64,64,64" available="N"/><br/>				<!-- Commented by JMM 20240228		<sp/><txt fnt=",">Subtotal:  </txt><tab n="3"/>		<inp id="k_subtotal_con_iva" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" clr="64,64,64"/><br/>		<sp/><txt fnt=",">Retenci&#243;n ISR:  </txt><tab n="1"/>		<inp id="k_retencion_isr" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" clr="64,64,64"/><br/>			<sp/><txt fnt=",">Retenci&#243;n IVA:  </txt><tab n="1"/>		<inp id="k_retencion_iva" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" clr="64,64,64"/><br/>				<sp/><txt fnt=",">Otras Retenciones:</txt><tab n="1"/>		<inp id="k_otras_retenciones" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" clr="64,64,64"/><br/>		-->				<sp/><txt fnt=",">Importe:  </txt><tab n="3"/>		<inp id="k_monto" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0b" clr="64,64,64" available="N"/><br/>			</grp>				</grp>				<!-- Esta seccion se saco del Grupo del Grid para crear un Gpo Contiguo -->				<!-- <sp n="1"/> -> Created & Removed --> 		<grp dim="8,10,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,16" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit=" ">				<!-- <br/> -->								<br/>		<sp n="3"/>		<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="EjecReporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>						<!-- <sp n="5"/> -->		<br/>		<br/>		<sp n="3"/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>						<!-- <sp n="5"/> -->		<br/>		<br/>		<sp n="3"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		</grp>								</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Variables de control			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal, tabla, estatus_doc ;			var fileSavePath;			//Variables validacion factura			var	str_uuid, fecha_uuid, rfc_uuid, total_uuid;								//Variables de parametros         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd;			var editable; //Se controla si la poliza se puede editar, cancelar o dar de baja				//Porcentajes kdmm			var prc_retencion_isr,prc_iva ,prc_retencion_iva, prc_otras_retenciones, afecta_costo_inv  ;			//cont			var presupuesto , saldo, fecha_baja ;			var uen;						//Added by JMM 20240208			var nombre_uuid, regimen_uuid, folio_uuid, serie_uuid, NewProvId;			//Added by JMM 20240215			var paramProvPago, proveedor_pago_id;			//Added by JMM 20240224			var impuesto_uuid;			//Added by JMM 202240331			var proveedor_oper_id;					fun Main() {			frn=new FRNT;			kdb=new KDB;			rep=new REP;			frP=new FRNTP;			sys=new SYS;			kdb.connect();			kdb.kde("KDE");			kdb.exec();			anio_contable = kdb.get("KDE","14");			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			suc_usuario = frn.lib("libKepler","UserInfo(1)");			fileSavePath = "C:\Basura";			Inicializa();			ConfiguraControlesOpcion();								}					fun Inicializa(){ //Inicializa los valores en Pantalla					paramProvPago = 0; // Added by JMM 20240227						// Revisa parametros recibidos			if( frn.nParam() == 7 ){  // Adapted by JMM, 20240215; Backed out by JMM 20240227			/*if( frn.nParam() >= 7 && frn.nParam() <= 8){*/  // Updated by JMM 20240215; Commented by JMM 20240227                gen_doc=trim(frn.param(0));                 nat_doc=trim(frn.param(1));                 gpo_doc=trim(frn.param(2));                tip_doc=trim(frn.param(3));                 tip_ope=trim(frn.param(4));                paramProd=trim(frn.param(5));                //Commented & adapted by JMM, 20240227                 /*                // Added by JMM 20240215                 if ( frn.nParam() == 8 ) {						paramProvPago=trim(frn.param(7));					 } else {						paramProvPago="";					 }					 */			} else {				frn.message("Operacion no valida ...", "Mensaje","&Aceptar");				frn.open("redirect",2);				return;			}            			if(tip_ope &= "A"){ //Alta				frn.set("operacion","COMPROBACION"/*"ALTA"*/);			} else {				// Adapted by JMM 20240513				// /*				if(tip_ope &= "B"){ //Baja					frn.set("operacion","REVERTIR"/*"BAJA"*/);				} else {				// */					if(tip_ope &= "C"){ //Consulta						frn.set("operacion","CONSULTA");					} else {						frn.message("Operacion no valida ...", "Mensaje","&Aceptar");						frn.open("index",4);						return;								}				}			}						uen=trim(frn.param(6));			if (uen &= ""){				uen="XXX";			}							// Fill Combo Sucursal (Con Query de PostgreSQL)			cmdQuery = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdms";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_sucn",cuboQuery);				sucursal_id = frn.get("k_sucn",-1,1);						// Added by JMM 20240227 ... Check Security PARAM for User to use PROV PAGO			paramProvPago = ProvPago_Sec(usuario);										// Fill Combo Tipo (Con Query FTO Kepler) 			//Adapted by JMM 20240513 			//if(tip_ope &= "A"){ 				cmdQuery = "select /*c5*/'Contrarecibo Universal' as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;				cmdQuery = cmdQuery & " and c4='" & tip_doc & "'"; //Condition used by JMM 20240312 as temporary until define DOCs or DOC Type 			//} else {			//	cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;			//}						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.Inicializa()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error BD","Aceptar");				return;			}			frn.set("k_tipon",getXml(cuboQuery));						frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				//frn.set("k_vence",sys.date()); // Commented by JMM, 20240208 							// Fill k_docto | referencia docto			ArmarRefDocto();					configuraciones_kdmm();		}					// Armado del Docto Referencia		fun ArmarRefDocto {			// Commented by JMM 20240329 			/*			var cadena = frn.get("k_tipon", -1, 5);			var fol = frn.get("k_folio");			if (tip_ope &! "A" && fol &! ""){				cadena = strSplit(cadena,"-",0) & "-" & fol;			}					frn.set("k_docto", cadena);			*/		}					fun PadLeft(pText,pRelleno,pCaracterRelleno) {			var Resultado;			var pos_ini = pText;			var nReg = strlen(pText);			for (var cont = nReg; cont < pRelleno; cont++) {				Resultado = pCaracterRelleno & Resultado;			}			Resultado = Resultado & pText;                			return Resultado;		}				fun CambiaTipo() {				tip_doc  = frn.get("k_tipon", -1, 4);			configuraciones_kdmm();			borrar_datos();			LimpiaEncabezado();								//TODO, borrar todos los datos			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();							limpiar_datos_uuid();	// Added by JMM 20240215					}				fun configuraciones_kdmm(){						var cmd, cuboResultados ,ok,mensajeError;								cmd= " select c15,c16,c33,c75,c77 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "'" ;							cmd = cmd & " and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4='" & tip_doc & "'";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.configuraciones_kdmm()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				// Commented by JMM 20240228				/*				prc_retencion_isr = getXmlAtt(cuboResultados , "r0","c15");				prc_iva = getXmlAtt(cuboResultados , "r0","c16");				prc_retencion_iva = getXmlAtt(cuboResultados , "r0","c33");				prc_otras_retenciones = getXmlAtt(cuboResultados , "r0","c75");				*/				afecta_costo_inv = getXmlAtt(cuboResultados , "r0","c77");								//Commented Temporary by JMM 20240306 				/*				if (afecta_costo_inv &= "S"){									frn.setAtt("k_mov" ,"available" , "Y", "k_inventario");					frn.setAtt("k_mov" ,"visible" , "Y", "k_inventario");					frn.setAtt("k_mov" ,"modify" , "Y", "k_inventario");					frn.setAtt("k_mov" ,"OnF9" , "busca_inv()", "k_inventario");										frn.setAtt("k_mov" ,"available" , "Y", "k_afecta"); //Added by JMM 20240306					frn.setAtt("k_mov" ,"visible" , "Y", "k_afecta"); //Added by JMM 20240306					frn.setAtt("k_mov" ,"modify" , "Y", "k_afecta"); //Added by JMM 20240306									}else{									frn.setAtt("k_mov" ,"available" , "N", "k_inventario");					frn.setAtt("k_mov" ,"visible" , "N", "k_inventario");					frn.setAtt("k_mov" ,"modify" , "N", "k_inventario");					frn.setAtt("k_mov" ,"OnF9" , "", "k_inventario");										frn.setAtt("k_mov" ,"available" , "N", "k_afecta"); //Added by JMM 20240306					frn.setAtt("k_mov" ,"visible" , "N", "k_afecta"); //Added by JMM 20240306					frn.setAtt("k_mov" ,"modify" , "N", "k_afecta"); //Added by JMM 20240306									}					*/						}				fun CambiaSucursal() {			sucursal_id = frn.get("k_sucn",-1,1);						// Added by JMM 20240227 ... Check Security PARAM for User to use PROV PAGO			paramProvPago = ProvPago_Sec(usuario);						LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();							limpiar_datos_uuid();	// Added by JMM 20240208					}				fun LimpiaEncabezado(imodo) {			frn.set("k_folio", "");			frn.set("k_docto", "");			if ( imodo != 1 ) {				frn.set("k_fecha", "");				frn.set("k_hora", "");				//Added by JMM 20240330 				frn.set("k_clave_oper", "");				frn.set("k_nombreprov_oper", "");				frn.set("k_rfc_oper", "");			} 			LimpiaDatosProv();			frn.set("k_clave", "");			//Added by JMM 20240215			frn.set("k_clave_pago", "");			frn.set("k_nombreprov_pago", "");			//Added by JMM 20240330			frn.set("c_fecha", "");			frn.set("c_monto", "");			//Added by JMM 20240331			frn.setAtt("Buscar", "visible", "N");			frn.setAtt("Buscar", "available", "N");			//Added by JMM 20240401			frn.set("k_plazo", "");			frn.set("k_vence", "");			//Added by JMM 20240402			frn.rst("k_mov");			frn.setAtt("k_mov", "modify", "N");			frn.setAtt("k_mov", "available", "N");			//Added by JMM 20240403			frn.set("k_coment", "");			limpiar_datos_uuid();		}				fun borrar_datos(){			// Commented by JMM 20240329			/*			if ( frn.get("chk_pc") != 1 ) { //Condition Added by JMM 20240325			*/				frn.rst("k_mov");					//Condition Added by JMM 20240513					if(tip_ope &= "A"){						//Added by JMM 20240402						frn.setAtt("k_mov", "modify", "Y");						frn.setAtt("k_mov", "available", "Y");					} else {						frn.setAtt("k_mov", "modify", "N");						frn.setAtt("k_mov", "available", "N");					}								/* } */ // Commented by JMM 20240329			frn.set("totalCargos", 0);			frn.set("totalAbonos", 0);			//frn.set("k_vence", sys.date()); //Commented by JMM, 20240208						// Commented by JMM 20240401			/*			frn.set("k_plazo", 0);			frn.set("k_vence", ""); //Added by JMM, 20240208			*/						//frn.rst("k_coment"); // Commented by JMM 20240403						frn.set("k_subtotal", 0);			frn.set("k_iva", 0);						// Commented by JMM 20240228			/*			frn.set("k_subtotal_con_iva", 0);			frn.set("k_retencion_isr", 0);			frn.set("k_retencion_iva", 0);			frn.set("k_otras_retenciones", 0);			*/						frn.set("k_monto", 0);						//Added by JMM 20240330					}				fun BuscarFolio() {			var folio;			folio = frn.get("k_folio");			folio = PadLeft(folio, 7, "0");			ArmarRefDocto();			borrar_datos();			MostrarDatos(folio);				}		fun Cancela() {			CambiaSucursal();			borrar_datos();			Inicializa();			ConfiguraControlesOpcion();		}		fun ObtenerFolio() {			if ( strlen( frn.get("k_clave_oper") ) == 0 || strlen( frn.get("k_rfc_oper") ) == 0 ) {				frn.message("Debes seleccionar primero un Proveedor de Documento valido ...", "Error","Aceptar");				return;			}			sucursal_id = frn.get("k_sucn",-1,1);			//Commented by JMM 20240330 			//LimpiaEncabezado(); //Added by JMM 20240215			//UPD by JMM 20240307			cmdQuery = "select c6 as folio, substring(cast(c9 as VARCHAR),1,10) as fecha, c10 as cve_proveedor, " &						"c11 as factura, c16 as monto, c43 estatus " &						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc & " order by c9 desc, c6 desc ";									frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryfoliomov");							frn.dialog("genlistafiltrosel","Folios de Contrarecibos",cmdQuery,"folio","k_folio","0","","S");					}				fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    			1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 			2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 			3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			// var tip_ope; 			var tip_oper;			if(iModo==0)				page=pag; 			else if(iModo==2&&(strlen(par0)>0)){				//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       				if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 				if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;			}			else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     		}					//------------------------------PROVEEDOR-----------------------					// Adapted by JMM 20240225		// /*		fun BuscarProveedor_NoXML(){			var xmlProd, vProvPago;											sucursal_id = frn.get("k_sucn",-1,1);			proveedor_id = frn.get("k_clave");			LimpiaDatosProv();					if (strlen(frn.get("k_clave")) == 0) {				return;			}							if (strlen(frn.get("k_refer")) > 0) {				refer_id = frn.get("k_refer");			} else {				frn.set("k_fecha_exp", "");			}							cmdQuery = "select c10 as k_rfc, c3 as k_nombreprov, c4 as k_calleprov, c5 as k_coloniaprov, c6 as k_poblacionprov, c27 as k_cpprov, c16 as k_plazo " &									"from keplersc.kdxd where c2='" & proveedor_id & "'" ;								rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscaProveedorNoXML()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");								// Added 20240227				if ( CheckProvPago() == 0 ) {					frn.set("k_clave_pago","");					frn.set("k_nombreprov_pago","");				}								return;				}			if(nXml(cuboQuery) == 0){				frn.setPos("k_clave");				frn.message("El proveedor no existe","Error","Aceptar");								// Added 20240227				if ( CheckProvPago() == 0 ) {					frn.set("k_clave_pago","");					frn.set("k_nombreprov_pago","");				}								return;				}						//Plazo();				rstXml(xmlProd);			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");			frn.setX(xmlProd);						// Added by JMM 20240227 			vProvPago = trim(frn.get("k_clave_pago"));			if ( strlen(trim(frn.get("k_clave"))) > 0 ) {				if ( strlen( vProvPago ) == 0 ) {					frn.set("k_clave_pago", frn.get("k_clave"));					BuscarProvPago();				} else {					if ( CheckProvPago() == 0 ) {						frn.set("k_clave_pago", frn.get("k_clave"));						BuscarProvPago();						}				}			}						Plazo(); // Added by JMM, 20240206, Originally it was commented above									}		// */				/*		fun LimpiaDatosProv() {			frn.set("k_rfc", "");			frn.set("k_nombreprov", "");			frn.set("k_calleprov", "");			frn.set("k_coloniaprov", "");			frn.set("k_poblacionprov", "");			frn.set("k_fecha_exp", "");						frn.set("k_refer", "");			frn.set("k_fecha_exp", "");			frn.set("k_cpprov", "");		}		*/					//------------------------Implementing UUID, by JMM 20240208----------------------------				fun LimpiaDatosProv() {			frn.set("k_rfc", ""); // Commented 20240111 , Descommented 20240131			frn.set("k_nombreprov", "");			frn.set("k_calleprov", "");			frn.set("k_coloniaprov", "");			frn.set("k_poblacionprov", "");			frn.set("k_cpprov", "");			// Commented by JMM 20240208, replaced by fun borrar_datos			/*			LimpiaDatosDoc();			LimpiaTotalesDoc();			*/			borrar_datos(); // Added by JMM, 20240208 			// Commented 20240111 ... Estos datos se gestionan al cargar UUID 			/*					frn.set("k_refer", "");			frn.set("k_fecha_exp", "");			*/		}				fun BuscarProveedor(/*imodo*/){			var xmlProd;						// Added by JMM 20240119			var NewProv, ST_FUN, continua, resultado, mensaje, xmlAlta;			// Added by JMM 20240227 			var vProvPago;							sucursal_id = frn.get("k_sucn",-1,1);						// UPD 20240111			//proveedor_id = frn.get("k_clave");			proveedor_id = frn.get("k_rfc");						LimpiaDatosProv();			// 20240111 ... Los Ejecuta en : LimpiaDatosProv()			/*			LimpiaDatosDoc();			LimpiaTotalesDoc();			*/			//Added 20240131			frn.set("k_rfc", proveedor_id);						if (strlen(frn.get("k_rfc"/*"k_clave"*/)) == 0) {				return;			}						// Commented 20240111 			/*			if (strlen(frn.get("k_refer")) > 0) {				refer_id = frn.get("k_refer");			} else {				frn.set("k_fecha_exp", "");			}			*/							cmdQuery = "select c2 as k_clave, /*c10 as k_rfc,*/ c3 as k_nombreprov, c4 as k_calleprov, c5 as k_coloniaprov, c6 as k_poblacionprov, c27 as k_cpprov, c16 as k_plazo " &									"from keplersc.kdxd where keplersc.full_replace(c10,'-','') /*c2*/='" & proveedor_id & "'" ;			//and c1 ='" & sucursal_id & "' ... TO DO : NO VIENE DATO DE LA SUCURSAL A NIVEL DEL PROVEEDOR AUNQUE ESTA EL CAMPO ...			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscaProveedor()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){							// Addapted 20240111				//frn.setPos("k_clave");				frn.set("k_clave","No Existe ...");  							// Commented by JMM 20240401				// if (/*imodo == 1*/ strlen(NewProvId) > 0 ) { 									frn.message("El proveedor no existe","Error","Aceptar");					return;								// Commented by JMM 20240401				/*					} else {									frn.message("El Proveedor No existe ..." & "|" & " " & 					"|" & " " & "Nombre : " & nombre_uuid &					"|" & " " & "R.F.C. : " & rfc_uuid & 					"|" & " " & "Fecha Docto. Seleccionado : " & fecha_uuid & 					"|" & " " & "Total Docto. Seleccionado : " & total_uuid & 					"|" & " " & "|" & " " & 					"Puede crearse Automaticamente, se recomienda complementar los Datos.", "Info !!!","Aceptar");					continua = frn.message(" Continuar con el Alta del Proveedor?","Atencion !!!",2);					if (continua == 0){										return;										}	else {										setXml(xmlAlta,"sucursal",sucursal_id);						setXml(xmlAlta,"nombre",nombre_uuid);						setXml(xmlAlta,"rfc",rfc_uuid);											frn.lib("libGeneral.kpl","FileSave",xmlAlta,fileSavePath & "\XmlAltaProv_To_Send");											cmdQuery="SELECT * FROM keplersc.uuid_tools_alta_proveedor('<document>" & getXmlStr(xmlAlta,"EOF:13_10") & "</document>')";						rstXml(cuboQuery);											cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_contrarecibo_crud.Alta_Proveedor");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlAltaProv_Result");											resultado = getXml(cuboQuery,"resultado");						mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok) {							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;							}						if(resultado &= "1") {							NewProv = mensaje;							//frn.dialog("cat_crud_proveedores","Modificar", NewProv,"UUID");							//prov_data_upd(NewProv);							return NewProv; //1						} else {							// Added 20240130 (else section)							frn.set("k_clave","");							frn.message(mensaje,"Error","Aceptar");							return;						}										} // End ... If ( continua )								} // End ... If ( imodo )				*/			}						//Plazo();				rstXml(xmlProd);			frn.lib("libGeneral.kpl","FileSave",cuboQuery/*xmlAlta*/,fileSavePath & "\XmlAltaProv_To_Get");			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");			frn.setX(xmlProd);						// Added by JMM 20240227 			vProvPago = trim(frn.get("k_clave_pago"));			if ( strlen(trim(frn.get("k_clave"))) > 0 ) {				if ( strlen( vProvPago ) == 0 ) {					frn.set("k_clave_pago", frn.get("k_clave"));					BuscarProvPago();				} else {					if ( CheckProvPago() == 0 ) {						frn.set("k_clave_pago", frn.get("k_clave"));						BuscarProvPago();						}				}			}						// Commented by JMM 20240401 			//Plazo(); // Moved 20240131							} // End : Fun BuscarProveedor						// Commented by JMM 20240401		// New Func 20240120 by JMM		//fun prov_data_upd(Prov){		//	frn.dialog("cat_crud_proveedores","Modificar"/*accion*/, Prov/*IdProv*/,"UUID" /*param2 UUIDCtrl*/,"BuscarProveedor()"/*paramRutina*/);		//}								// New Func 20240111 by JMM			fun limpiar_datos_uuid() {			frn.set("k_clave","");			frn.set("k_rfc","");			frn.set("k_refer","");						frn.set("k_uuid_serie","");			frn.set("k_uuid_folio","");			frn.set("k_uuid_monto","");			frn.set("k_uuid_fecha","");						// Added 20240120			NewProvId = "";			LimpiaDatosProv();						//Added 20240225			frn.set("k_uuid_impuesto","");						//Added 20240328 			str_uuid = "";				rfc_uuid = "";				fecha_uuid = ""; 			total_uuid = "";								nombre_uuid = "";			regimen_uuid = "";			folio_uuid = "";			serie_uuid = "";			impuesto_uuid = "";						//Commented by JMM 20240328			/*				//Added 20240227			if ( paramProvPago > 0 ) {  // &= "P"								if ( tip_ope &= "A" ) {						frn.setAtt("k_clave_pago", "available", "Y");				} else {					frn.setAtt("k_clave_pago", "available", "N");				}					frn.setAtt("k_clave_pago", "available", "N"); //Added by JMM 20240328										if ( CheckProvPago() == 0 ) {					frn.set("k_clave_pago","");					frn.set("k_nombreprov_pago","");				}			} else { */				// Commented by JMM 20240401				/*				frn.setAtt("k_clave_pago", "available", "N");				frn.set("k_clave_pago","");				frn.set("k_nombreprov_pago","");				*/			/* } */					}								// New Func 20240115 by JMM		fun BuscarUUID(referencia){			var xmlProd, respfunc;											sucursal_id = frn.get("k_sucn",-1,1);			respfunc = 1;														if (strlen(str_uuid) == 0) {				frn.message("No se tiene una Referencia [UUID] para validarse ...","Error","Aceptar");				return;			}						/*			cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &				"and c2 = '" & gen_doc & "' and c3 = '" & nat_doc & "' and c4 = " & gpo_doc & " and c5 = " & tip_doc & " and c11 = '" & referencia & "'";			*/						// Query updated at { C x P } validation, 20240201 			cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &				"and c2 = 'X' and c3 = 'A' and c11 = '" & referencia & "'";	 						// Query updated at { C x P } validation, 20240718 				cmdQuery = cmdQuery & " and c43 <> 'C' ";						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscaFactura()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			/*			if ( nXml(cuboQuery) == 0 ) {				respfunc = 0;			}			*/			respfunc = nXml(cuboQuery);						return respfunc;									} // End Fun - BuscarUUID						// New Func 20240112 by JMM		fun Validar_Fecha_UUID() {			var fech_hoy, fech_ini, fech_limit, strFecha, strTmp, fech_lim_ini, fech_lim_fin, fech_buff;			var aj_dias, respfunc, gapDias,superUsuario,mensajeAdv,mensajeProceso;					respfunc = 0;			//VCSS 03/07/2024 Obtener usuario con nivel para poder hacer operaciones sin validaciones			cmdQuery="SELECT count(*) as superusuario from keplersc.param_opc_usr_sec where sucursal = '" & sucursal_id & "' and upper(opcion) = upper('Operaciones Sin Validacion GAP') and upper(usuario) = upper('" & usuario & "') ";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlSuperUsuario");								ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return respfunc;			}			superUsuario = getXmlAtt(cuboQuery,"r0","superusuario");			// { GAP Dias Fecha Gastos }			cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Dias Fecha Gastos'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPDias");								ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return respfunc;			}			if (nXml(cuboQuery) > 0) {				gapDias = getXmlAtt(cuboQuery,"r0","paramvalor");			} else {				frn.message("Hubo problemas para obtener los Parametros [GAP Dias Fecha Gastos] ...","Error","Aceptar");				return respfunc;			}							fech_hoy = sys.date();				strFecha = fnDate("year", fech_hoy) & "/" /*"-"*/;			strTmp = fnDate("month", fech_hoy);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "/" /*"-"*/ & "01";								fech_ini = strFecha;								//fech_hoy = "2024/12/05";  // For testing calc fech 			strTmp = fnDate("month", fech_hoy);			if ( strTmp == 12 ) {				strFecha = fnDate("year", fech_hoy) & "/12/31";								fech_limit = strFecha;							} else {				strFecha = fnDate("year", fech_hoy) & "/";				strTmp = fnDate("month", fech_hoy) + 1;				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "/" & "01";								fech_limit = fnDate("add",strFecha,-1);							} 						//fech_limit = fnDate("add",fech_limit,gapDias);  // Not Apply 			fech_limit = formato_fecha(fech_limit);									if ( gapDias > 0 ) { 				aj_dias = (gapDias /*+ 1*/) * (-1); 			} else {				aj_dias = gapDias /*- 1*/;			}			if ( gapDias == 0 ) {				fech_buff = fech_hoy;			} else {				fech_buff = fnDate("add", fech_hoy, aj_dias);			}			strTmp = fnDate("month", fech_buff);			if ( strTmp == 12 ) {				strFecha = fnDate("year", fech_buff) & "/12/31";								fech_lim_fin = strFecha;							} else {				strFecha = fnDate("year", fech_buff) & "/";				strTmp = fnDate("month", fech_buff) + 1;				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "/" & "01";								fech_lim_fin = fnDate("add",strFecha,-1);							} 								fech_lim_fin = formato_fecha(fech_lim_fin);										strFecha = fnDate("year", fech_lim_fin) & "/";			strTmp = fnDate("month", fech_lim_fin);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "/" /*"-"*/ & "01";						fech_lim_ini = strFecha;			fech_lim_ini = formato_fecha(fech_lim_ini);									if ( strlen( frn.get("k_uuid_fecha") ) == 0 ) {				frn.message("No hay Fecha UUID de Referencia para validar ...","Error","Aceptar");				return respfunc;			} 						strFecha = frn.get("k_uuid_fecha");			strFecha = formato_fecha(strFecha);						//VCSS	INI Validaciones para usuarios normales (no superUsuario)			if (superUsuario != "1"){				if ( fnDate("cmp", strFecha, fech_hoy) > 0 /*strFecha > fech_hoy*/ ) {					mensajeError="La Fecha del UUID, es mayor al dia de hoy ..." & "|" & " " & "|" & " " & strFecha;					mensajeAdv=mensajeAdv & "; " & mensajeError;					frn.message(mensajeError ,"Error","Aceptar");					return respfunc;				} 							if ( fnDate("cmp", strFecha, fech_limit) > 0 /*strFecha > fech_limit*/ ) {					mensajeError = "La Fecha del UUID, fuera de Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;					mensajeAdv=mensajeAdv & "; " & mensajeError;					frn.message(mensajeError ,"Error","Aceptar");					return respfunc;				} 							if ( fnDate("cmp", strFecha, fech_ini) < 0 /*strFecha < fech_ini*/ ) {					if ( fnDate("cmp", strFecha, fech_lim_ini) < 0 /*strFecha < fech_lim_ini*/ ) {						mensajeError = "La Fecha del UUID, es menor al Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;						mensajeAdv=mensajeAdv & "; " & mensajeError;						frn.message(mensajeError ,"Error","Aceptar");						return respfunc;					} else {						if ( fnDate("cmp", strFecha, fech_lim_fin) > 0 /*strFecha > fech_lim_fin*/ ) {						mensajeError = "La Fecha del UUID, fuera del Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;						mensajeAdv=mensajeAdv & "; " & mensajeError;						frn.message(mensajeError ,"Error","Aceptar");						return respfunc;						}					}				}			} 			//VCSS 17/06/2024 INI Evaluacion de fecha de transaccion, las transacciones que se realizan dentro de los primeros 			//dias del mes dentro del gap y la fecha del xml es del mes anterior o anteriores, 			//se registran el día último del mes del xml			var fechaMovto,fechaXml,fechaRefer,mesesDif; 			fechaXml= frn.get("k_uuid_fecha");			fechaXml= formato_fecha(fechaXml);										var diaMovto=fnDate("day", fech_hoy);			var mesMovto=fnDate("month",fechaXml);			//Calcular dierencia en meses del mes actual y del xml				strTmp=fnDate("month",fechaXml);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}										fechaXml=fnDate("year",fechaXml) & "/" & strTmp & "/" & "01";						strTmp=fnDate("month",fech_hoy);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}							fech_hoy=fnDate("year",fech_hoy) & "/" & strTmp & "/" & "01";			//Validar si xml es del mismo mes			if (fnDate("cmp",fechaXml,fech_hoy) == 0){ //Mismo mes				mesesDif=0;			}else{				fech_hoy=fnDate("add",fech_hoy,-1);				fech_hoy= formato_fecha(fech_hoy);				strTmp=fnDate("month",fech_hoy);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}								fech_hoy=fnDate("year",fech_hoy) & "/" & strTmp & "/" & "01";												if (fnDate("cmp",fechaXml,fech_hoy) == 0){					mesesDif=1;				}else{					mesesDif=2;				}			}							fechaMovto= frn.get("k_uuid_fecha");			if(mesesDif==2 && superUsuario==0){				mensajeError = "La Fecha del UUID, " & fechaMovto & " está fuera del Periodo Vigente.";				frn.message(mensajeError ,"Error","Aceptar");				return respfunc;			}			if (mesesDif != 0){				fechaMovto= frn.get("k_uuid_fecha");				strTmp=fnDate("month",fechaMovto);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}											fechaMovto=fnDate("year",fechaMovto) & "/" & strTmp & "/" & "31";				fechaMovto=formato_fecha(fechaMovto);				frn.set("k_fecha",fechaMovto);				frn.message("Los movimientos de meses anteriores se registrarán al último día del mismo mes.","Mensaje","Aceptar");			}			//VCSS 17/06/2024 FIN Evaluacion de fecha de transaccion...			respfunc = 1;			return respfunc;				} // End Fun - Validar_Fecha_UUID				// New Func 20240112 by JMM		fun formato_fecha(fech) {			var strFech, tmpData;						strFech = fnDate("year", fech) & "/";			tmpData = fnDate("month", fech);			if(strlen(tmpData) == 1){				tmpData = "0" & tmpData;			}			strFech = strFech & tmpData & "/";			tmpData = fnDate("day", fech);			if(strlen(tmpData) == 1){				tmpData = "0" & tmpData;			}			strFech = strFech & tmpData;						return strFech;			} // end fun - formato_fecha		// New Func 20240401 by JMM		fun Validar_Monto_UUID() {			var respfunc, gapMonto, strTotal, vdiferencia;					respfunc = 0;									// { GAP Monto Gastos }			cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Monto Gastos'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPMonto");								ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return respfunc;			}			if (nXml(cuboQuery) > 0) {				gapMonto = getXmlAtt(cuboQuery,"r0","paramvalor");			} else {				frn.message("Hubo problemas para obtener los Parametros [GAP Monto Gastos] ...","Error","Aceptar");				return respfunc;			}							//Validar que monto del UUID correspondan al del documento 			strTotal = frn.get("c_monto");			vdiferencia = (strTotal-total_uuid);			if (vdiferencia < 0){				vdiferencia = vdiferencia *(-1); 			}						// Se Gestionara por PARAM {TBL : param_oper}			if ( vdiferencia > gapMonto /*0.1*/ ) {				frn.message("El Importe del XML (UUID) no corresponde al del Documento a Comprobar.","Error","Aceptar");				return respfunc;			}							respfunc = 1;			return respfunc;				} // End Fun - Validar_Monto_UUID		fun ObtenerFactura(){			var nCampos, uuid="";			//Regresara la funcion UUID cadena con UUID, rfc, fecha, total			// Added 20240119 by JMM			var NewProv;						limpiar_datos_uuid();						uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID","k_refer", 0,"0");			// Replaced with new function, 20240111 			//uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID_Extended","k_refer", 0,"0");						nCampos = strSplit(uuid,"|",-1);			if (nCampos > 1) {					str_uuid = strSplit(uuid,"|",0);		  //UUID					rfc_uuid = strSplit(uuid,"|",1);		  //rfc					fecha_uuid = strSplit(uuid,"|",2);	  //fecha					total_uuid = strSplit(uuid,"|",3);	  //monto de la factura										// Added 20240111 by JMM					nombre_uuid = strSplit(uuid,"|",5);	  //nombre					regimen_uuid = strSplit(uuid,"|",6);  //regimen					folio_uuid = strSplit(uuid,"|",7);	  //folio					serie_uuid = strSplit(uuid,"|",8);	  //serie										// Added 20240224 by JMM					impuesto_uuid = strSplit(uuid,"|",9); //impuesto									// Conditions Added 20240111  by JMM, Updated 20240208					if ( strlen(/*folio_uuid*/nombre_uuid) == 0 || strlen(rfc_uuid) == 0 || strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {											//frn.set("k_refer","");						frn.message("No se pudieron obtener todos los datos mandatorios del UUID.","Error","Aceptar");											} else {											frn.set("k_refer",str_uuid);						frn.set("k_rfc",rfc_uuid);												//Added by JMM 20240401						if ( frn.get("k_rfc_oper") &! rfc_uuid ) {							//frn.set("k_rfc","");							frn.set("k_clave","");							frn.message("El Proveedor del Documento [UUID] No corresponde con el del Documento a Comprobar ...","Error","Aceptar");							return;						}												if ( BuscarUUID(str_uuid) > 0 ) {							//frn.set("k_rfc","");							frn.set("k_clave","");							frn.message("Este Documento [UUID] ya ha sido Asociado previamente ...","Error","Aceptar");							return;						} 										frn.set("k_uuid_fecha",mid(fecha_uuid,0,10));						if ( Validar_Fecha_UUID() == 0 ) { 							//frn.set("k_rfc","");							frn.set("k_clave","");							return;						}												// Added by JMM 20240401						frn.set("k_uuid_monto", total_uuid);						if ( Validar_Monto_UUID() == 0 ) { 							//frn.set("k_rfc","");							frn.set("k_clave","");							return;						}												// Commented by JMM 20240401						/*						NewProv = "";						NewProv = BuscarProveedor();						if (strlen(NewProv) > 0 ) { // == 1							//BuscarProveedor(NewProv);							NewProvId = NewProv;							frn.set("k_clave",NewProvId);						} else {							NewProvId = "";						}						*/						BuscarProveedor();												if ( strlen(frn.get("k_clave")) > 0 && frn.get("k_clave") &! strFormat("ucase","No Existe ...") ) {														// Validations Moved UP by JMM 20240119 ( BuscarUUID, Validar_Fecha_UUID )																			frn.set("k_uuid_serie",serie_uuid);							frn.set("k_uuid_folio",folio_uuid);							frn.set("k_uuid_monto",total_uuid);							frn.set("k_uuid_fecha",mid(fecha_uuid,0,10));														// Added 20240224 by JMM							frn.set("k_uuid_impuesto",impuesto_uuid);														//Added 20240228 by JMM							frn.set("k_iva",impuesto_uuid);														//Added by JMM 20240402							//frn.rst("k_mov");							frn.setAtt("k_mov", "modify", "Y");							frn.setAtt("k_mov", "available", "Y");							frn.setPos("k_mov",0,"k_cuenta");														}					}			} else{				//frn.set("k_refer","");				frn.message("Faltan datos del UUID ...","Error","Aceptar");					}		}	// End Fun - Obtener Factura		//New Fuc 20240120 by JMM		fun ProcesarFactura() {					if ( strlen( frn.get("k_clave_oper") ) == 0 || strlen( frn.get("k_rfc_oper") ) == 0 ) {				frn.message("Debes seleccionar primero un Proveedor de Documento valido ...", "Error","Aceptar");				return;			}					ObtenerFactura();						// Commented by JMM 20240401			/*			if ( strlen(NewProvId) > 0 ) {				prov_data_upd(NewProvId);			}			*/						// Se elimina esta parte porque l ejecuta antes de abrir el dialogo ...			// /*			if ( strlen(NewProvId) > 0 ) {				BuscarProveedor();			}			// */					} // End Fun - ProcesarFactura 		//Function Added by JMM, 202040215 		fun Get_Cat(imodo) {            				var suc_id, dato_id;				var win_tit, field_key, field_col, cmdQuery;								sucursal_id = frn.get("k_sucn",-1,1);	            				if ( imodo <= 0 || imodo > 3 /*1*/ /*7*/ ) {					// No es opcion de CAT Valida ...					return;				}								win_tit = "";				field_key = "";				field_col = "";				cmdQuery = "";				/*				if (imodo == 1) {					win_tit = "CAT Vehiculos";					field_key = "clave";					field_col = "modelo";					cmdQuery = "select C1 as clave, C2 as descripci n from keplersc.kdiv";				}				*/								/*				if (imodo == 2) {					win_tit = "CAT Inventarios";					field_key = "clave";					field_col = "invent";										dato_id = "";					cmdQuery = "select C8 as campo from keplersc.kdiv where c1 = '" & frn.get("k_mov",-1,"modelo") & "'";					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comaltasigcrud.Get_Cat_kdiv_c8()");					//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\Get_Cat_Get_Cat_kdiv_c8()");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					dato_id = getXmlAtt(cuboQuery,"r0", "campo");					cmdQuery = "select d.C1 as clave, d.C2 as descripci n from keplersc.kddinv d where d.c7 = '" & dato_id & "'";				}				*/				       				if (imodo == 1) {					win_tit = "CAT Proveedores de Pago";					field_key = "clave";					field_col = "k_clave_pago";					cmdQuery = "select C2 as clave, C3 as nombre from keplersc.kdxd where pagador = 1 or c2 = '" & frn.get("k_clave") & "' order by C3";				}			         	         				if (imodo == 2) {					win_tit = "CAT Proveedores";					field_key = "clave";					field_col = "k_clave";					cmdQuery = "select C2 as clave, C3 as nombre from keplersc.kdxd order by C3";				}									if (imodo == 3) {					win_tit = "CAT Proveedores";					field_key = "clave";					field_col = "k_clave_oper";					cmdQuery = "select C2 as clave, C3 as nombre from keplersc.kdxd order by C3";				}				            if ( strlen(win_tit) > 0 && strlen(field_key) > 0 && strlen(field_col) > 0 && strlen(cmdQuery) > 0 /*&& strlen(objeto) > 0*/ ) {                                        					//frn.dialog("genlistasel", win_tit,cmdQuery, field_key, "k_mov",-1, field_col,"S");  * * *  USADO EN GRIDS					//frn.dialog("genlistasel","Cat logo de Proveedores",cmdQuery,"k_claveprov","k_clave","0","","N");  * * *  USADO EN CTRLS SIMPLES										frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");				}						} /*END Func Get_Cat()*/		//Function Added by JMM, 202040215 		fun BuscarProvPago(){			var xmlProd;											sucursal_id = frn.get("k_sucn",-1,1);			proveedor_pago_id = frn.get("k_clave_pago");			proveedor_pago_id = trim(proveedor_pago_id);					if (strlen(/*frn.get("k_clave_pago")*/ proveedor_pago_id ) == 0) {				frn.set("k_nombreprov_pago","");				return;			}							cmdQuery = "select c3 as k_nombreprov_pagos " &									"from keplersc.kdxd where c2 = '" & proveedor_pago_id & "' ";								cmdQuery = cmdQuery & "and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')";								rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscarProvPago()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				frn.set("k_nombreprov_pago","ERROR EN BUSQUEDA ...");				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.set("k_nombreprov_pago","NO EXISTE ...");				frn.setPos("k_clave_pago");				frn.message("El Proveedor de Pago No existe ...","Error","Aceptar");				return;				} 						frn.set("k_nombreprov_pago", getXmlAtt(cuboQuery,"r0", "k_nombreprov_pagos") );					} // End : Fun BuscarProvPago()								//Function Added by JMM, 202040329 		fun BuscarProvOper(){			var xmlProd, proveedor_oper_id;											sucursal_id = frn.get("k_sucn",-1,1);			proveedor_oper_id = frn.get("k_clave_oper");			proveedor_oper_id = trim(proveedor_oper_id);						LimpiaEncabezado(1); // Added by JMM 20240331					if ( strlen(/*frn.get("k_clave_pago")*/ proveedor_oper_id ) == 0) {				frn.set("k_nombreprov_oper","");				frn.set("k_rfc_oper","");				return;			}							cmdQuery = "select c3 as k_nombreprov_oper, keplersc.full_replace(c10,'-','') as rfc_oper " &									"from keplersc.kdxd where c2 = '" & proveedor_oper_id & "' ";								/*cmdQuery = cmdQuery & "and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')";*/								rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscarProvPago()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				frn.set("k_nombreprov_oper","ERROR EN BUSQUEDA ...");				frn.set("k_rfc_oper","");				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.set("k_nombreprov_oper","NO EXISTE ...");				frn.set("k_rfc_oper","");				frn.setPos("k_clave_oper");				frn.message("El Proveedor del Documento No existe ...","Error","Aceptar");				return;				} 						frn.set("k_nombreprov_oper", getXmlAtt(cuboQuery,"r0", "k_nombreprov_oper") );			frn.set("k_rfc_oper", getXmlAtt(cuboQuery,"r0", "rfc_oper"));					} // End : Fun BuscarProvOper()								// Added by JMM, 20240226		fun Plazo(){ //Calcula la fecha de pago, y las condiciones de pago en base al plazo			frn.set("k_vence",fnDate("addC",frn.get("k_fecha"),frn.get("k_plazo")));//Suma d as comerciales			var cond=frn.get("k_plazo") & " dias fecha factura"/*" d as fecha factura"*/;			if (frn.get("k_plazo")==0) cond="Pago de contado";				frn.set("k_cond",cond);  		}						// Added by JMM, 20240325		fun get_param_cta_x_comprobar() {			var paramCta;					paramCta = "";					// { Param Cta Gastos x Comprobar }			cmdQuery="SELECT (coalesce(valor,'')) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'Cuenta Gastos x Comprobar'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcontrarecibocrud.get_param_cta_x_comprobar()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GetParamCtaXComprobar");								ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return paramCta;			}			if (nXml(cuboQuery) > 0) {				paramCta = getXmlAtt(cuboQuery,"r0","paramvalor");			} else {				frn.message("Hubo problemas para obtener el Parametro [Cuenta Gastos x Comprobar] ...","Error","Aceptar");			}			return paramCta;					}				// Added by JMM 20240325		fun get_dscr_cta() {						var dscrCta = "";				         var cuenta = frn.get("k_mov", 0/*-1*/, "k_cuenta");          var xmlRequest, cmd, cubo , ok, mensajeError ;                  setXml(xmlRequest,"document","cuenta",cuenta);         setXml(xmlRequest,"document","anio",mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2));                     frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\requestCuenta");			cmd="select * from keplersc.caracteristicas_cuenta('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";			cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.buscar_datos()");							frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultadosCuenta");							ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				clear_row(1); //Added by JMM 20240325				return dscrCta;			}							var nivel_cuenta = getXmlAtt(cubo,"r0","nivel");			var descripcion_nivel = getXmlAtt(cubo,"r0","desc_nivel");			var tipo_cuenta = getXmlAtt(cubo,"r0","tipo");							if (descripcion_nivel &! "Menor"){				frn.message(/*"La Cuenta debe ser menor"*/"No es una Cuenta de Detalle","Error","Aceptar"); // UPD 20240229 by JMM				//frn.setX("", "k_mov", 0/*-1*/, "k_cuenta");				/*frn.setX("", "k_mov", 0, "k_cuentadesc");*/				clear_row(1); //Added by JMM 20240325				return dscrCta;         }           			if (tipo_cuenta &= "Cliente"){				frn.message("La Cuenta no puede ser de cliente.","Error","Aceptar");				//frn.setX("", "k_mov", 0/*-1*/, "k_cuenta");				/*frn.setX("", "k_mov", 0, "k_cuentadesc");*/				clear_row(1); //Added by JMM 20240325				return dscrCta;         }                			var tbla = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2);			cmd = "select c2 as desc_cuenta from " & tbla & " where c1='" & cuenta  &  "'";							var cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Cuenta()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				clear_row(1); //Added by JMM 20240325				return dscrCta;			}			/*var descr */ dscrCta = getXmlAtt(cuboResultados , "r0","desc_cuenta");               //frn.setX(cuenta, "k_mov", 0/*-1*/, "k_cuenta");         //frn.setX(/*descr*/ dscrCta , "k_mov", 0/*-1*/, "k_cuentadesc");                  return dscrCta;         		} // End : Fun 				// Commented by JMM 20240329		/*		// Added by JMM 20240226		fun Change_Mode() {			var paramCta, dscrCta; // Added by JMM 20240325					limpiar_datos_uuid();						if ( frn.get("chk_pc") == 1 ) { //frn.message("Check Encendido ...","Info !!!","Aceptar");								frn.setAtt("Buscar", "available", "N");				frn.setAtt("Buscar", "visible", "N");				frn.setAtt("k_refer", "available", "Y");				frn.setAtt("k_clave", "available", "Y");								// Added by JMM 20240325				frn.setAtt("k_mov", "modify", "N", "k_cuenta");				frn.setAtt("k_mov", "available", "N", "k_cuenta");				frn.setAtt("k_mov", "modify", "N", "k_abono");				frn.setAtt("k_mov", "available", "N", "k_abono");								// Added by JMM 20240325 				frn.rst("k_mov");				paramCta = get_param_cta_x_comprobar();					frn.setX(paramCta ,"k_mov",0,"k_cuenta");				if ( strlen(paramCta) > 0 ) {					dscrCta = get_dscr_cta();					frn.setX(dscrCta ,"k_mov",0,"k_cuentadesc");				}							} else { //frn.message("Check Apagado ...","Info !!!","Aceptar");								frn.setAtt("Buscar", "available", "Y");				frn.setAtt("Buscar", "visible", "Y");				frn.setAtt("k_refer", "available", "N");				frn.setAtt("k_clave", "available", "N");								// Added by JMM 20240325				frn.setAtt("k_mov", "modify", "Y", "k_cuenta");				frn.setAtt("k_mov", "available", "Y", "k_cuenta");				frn.setAtt("k_mov", "modify", "Y", "k_abono");				frn.setAtt("k_mov", "available", "Y", "k_abono");							}			return;			}		*/						// New Func 20240227 by JMM		fun ProvPago_Sec(referencia){			var respfunc;											sucursal_id = frn.get("k_sucn",-1,1);			respfunc = 0; //Default es sin Permiso 						frn.setAtt("k_clave_pago", "available", "N");														if (strlen(referencia) == 0) {				return;			}						cmdQuery = "select * from keplersc.param_opc_usr_sec where sucursal = '" & sucursal_id & "' " & 				"and upper(opcion) = upper('Proveedor Pago') and upper(usuario) = upper('" & referencia & "')";						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ProvPagoSec()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			/*			if ( nXml(cuboQuery) == 0 ) {				respfunc = 0;			}			*/			respfunc = nXml(cuboQuery);						if ( respfunc /*paramProvPago &= "P"*/ > 0 ) {					//Commented by JMM 20240328 				/*				if ( tip_ope &= "A" ) {						frn.setAtt("k_clave_pago", "available", "Y");				} else {					frn.setAtt("k_clave_pago", "available", "N"); 				}				*/						frn.setAtt("k_clave_pago", "available", "N"); //Added by JMM 20240328			} else {				frn.setAtt("k_clave_pago", "available", "N");			}						return respfunc;									} // End Fun - ProvPago_Sec 						//Function Added by JMM, 202040227  		fun CheckProvPago(){			var respfunc;											sucursal_id = frn.get("k_sucn",-1,1);			proveedor_pago_id = frn.get("k_clave_pago");			proveedor_pago_id = trim(proveedor_pago_id);						respfunc = 0; 					if (strlen(/*frn.get("k_clave_pago")*/ proveedor_pago_id ) == 0) {				frn.set("k_nombreprov_pago","");				return;			}							cmdQuery = "select c3 as k_nombreprov_pagos " &									"from keplersc.kdxd where c2 = '" & proveedor_pago_id & "' ";								cmdQuery = cmdQuery & "and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')";								rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscarProvPago()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				frn.set("k_nombreprov_pago","ERROR EN BUSQUEDA ...");				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.set("k_nombreprov_pago","NO EXISTE ...");				// Commented by JMM 20240227				//frn.setPos("k_clave_pago");				//frn.message("El Proveedor de Pago No existe ...","Error","Aceptar");				return;				} 						respfunc = 1;						// Commented by JMM 20240227			//frn.set("k_nombreprov_pago", getXmlAtt(cuboQuery,"r0", "k_nombreprov_pagos") );						return respfunc;					} // End : Fun BuscarProvPago()						//------------------------End Implementing UUID, by JMM 20240208-------------------------				//------------------------Implementing Convert Doc, by JMM 2024031-------------------------		// Added by JMM, 20240204		fun ObtenerCxP() {					if ( strlen( frn.get("k_clave_oper") ) == 0 || strlen( frn.get("k_rfc_oper") ) == 0 ) {				frn.message("Debes seleccionar primero un Proveedor de Documento valido ...", "Error","Aceptar");				return;			}						proveedor_oper_id = frn.get("k_clave_oper");				sucursal_id = frn.get("k_sucn",-1,1);						// UPD by JMM 20240303 , Including Prov Pago Selection			cmdQuery = "" &				"select " & 				"/* e.c5 gen, e.c6 gpo, e.c7 nat, e.c8 tip, e.c9 fol, */ " & 				"m.c5 origen " &				", w.c6 folio, w.c9 fecha " & // Added by JMM 20240331				"/*, w.uuid_serie, w.uuid_folio, w.uuid_fecha, w.uuid_total*/ " & // Commented by JMM 20240331				", w.c16 total " & // Added by JMM 20240331 				", abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) saldo " &				", (to_date(g.c12::text,'yyyy-mm-dd'))::text vencimiento " &   				", g.c4 uuid_o_ref , g.doc_refer_compl ref_compl/*added 20240514*//*, to_date(g.c12::text,'yyyy-mm-dd') vencimiento*/ " & 				"/* g.* */  /* e.* */ " & 				"/*line added 240303*/ , g.c3 prov_operacion, d.c3 prov_nombre " & 				", g.cve_prov_pago prov_pago, coalesce(dp.c3,'') prov_pago_nombre " & // Added by JMM 20240331				"from keplersc.kduxg g " &  				"inner join keplersc.kduxe e on g.c1 = e.c1 and g.c2 = e.c5 and g.c3 = e.c2 and g.c4 = e.c3 " & 				"/*and e.c5 = 'X' and e.c6 = 'A' and e.c7 = 55 and e.c8 = 1 -- Getting Specific Doc*/ " & 				"inner join keplersc.kdmm m on m.col_sucursal=e.c1 and m.c1 = e.c5 and m.c2 = e.c6 and m.c3 = e.c7 and m.c4 = e.c8 " & 				"inner join keplersc.kdm1 w on w.c1 = e.c1 and w.c2 = e.c5 and w.c3 = e.c6 and w.c4 = e.c7 and w.c5 = e.c8 and w.c6 = e.c9 " & 				"and w.c16 > 0 and upper(w.c43) <> 'C' " &				"/*line added 240303*/ inner join keplersc.kdxd d on d.c2 = g.c3 " & 				"inner join keplersc.kdxd dp on dp.c2 = g.cve_prov_pago "; // Added by JMM 20240331					// Select Conditions UPD by JMM 20240303 				// "where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and g.c3 = '" & proveedor_id & "' " &  				// "and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10 /*to check GAP in balance to show record*/ ";						// Commented by JMM 20240331 and Adapted below 			//cmdQuery = cmdQuery & "" & 			//	"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and ( g.cve_prov_pago = '" & proveedor_id & "' or ( g.c3 = '" & proveedor_id & "' and length(g.cve_prov_pago) = 0 ) ) " &  			//	"and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10 /*to check GAP in balance to show record*/ ";						//Condition Added by JMM 20240513			if ( tip_ope &= "A" ) {							cmdQuery = cmdQuery & "" & 					"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and g.c3 = '" & proveedor_oper_id & "' and w.st_x_comprobar = 'S' " & 					"/*and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10*/ /*to check GAP in balance to show record*/ " ; 					// Se comento la Linea de que solo muestre datos con Saldo porque ya pudieron estar saldados ...								} else {							if ( tip_ope &= "B" ) {								cmdQuery = cmdQuery & "" & 						"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and g.c3 = '" & proveedor_oper_id & "' and w.st_x_comprobar = 'X' " & 						"/*and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10*/ /*to check GAP in balance to show record*/ ";										} else {									cmdQuery = cmdQuery & "" & 						"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and g.c3 = '" & proveedor_oper_id & "' and ( w.st_x_comprobar = 'X' or w.st_x_comprobar = 'S' ) " & 						"/*and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10*/ /*to check GAP in balance to show record*/ ";										}							}									      // Condicion si solo muestra las C x P vencidas   			//cmdQuery = cmdQuery & " and g.c12 <= current_date /*to check if this condition will be used*/ "; 						// Commented by JMM 20240331 and Adapted below			//cmdQuery = cmdQuery & " order by g.c12 ";			cmdQuery = cmdQuery & " order by w.c9 desc, w.c6 desc";									//frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQuery_ObtenerCxP");						// Commented by JMM 20240331 and Adapted below  			//frn.dialog("genlistafiltrosel","C x P  del  Proveedor",cmdQuery,"uuid_o_ref"/*"folio"*/,"k_mov",-1,"k_factura"/*"k_folio"*/,"S");			frn.dialog("genlistasel","CxP por Comprobar del Proveedor",cmdQuery,"folio","k_folio","0","","N");						 		}						// New Func 20240115 by JMM		fun BuscarDoc(){			var xmlProd, respfunc;			var referencia;						if ( strlen( frn.get("k_clave_oper") ) == 0 || strlen( frn.get("k_rfc_oper") ) == 0 ) {				frn.message("Debes seleccionar primero un Proveedor de Documento valido ...", "Error","Aceptar");				return;			}						proveedor_oper_id = frn.get("k_clave_oper");						referencia = frn.get("k_folio");						sucursal_id = frn.get("k_sucn",-1,1);						LimpiaEncabezado(1);					respfunc = 1;														if (strlen(referencia/*str_uuid*/) == 0) {				respfunc = 0;				frn.message("No se tiene un Documento para validarse ...","Error","Aceptar");				return respfunc;			}						// Query updated at { C x P } validation, 20240201 			/*			cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &				"and c2 = 'X' and c3 = 'A' and c11 = '" & referencia & "'";	 			*/						cmdQuery = "" &				"select " & 				"/* e.c5 gen, e.c6 gpo, e.c7 nat, e.c8 tip, e.c9 fol, */ " & 				"w.c6 folio, w.c9 fecha, w.c17 plazo, w.c18 vence, " & // Added by JMM 20240331, 20240401				"m.c5 origen " &				"/*, w.uuid_serie, w.uuid_folio, w.uuid_fecha, w.uuid_total*/ " & // Commented by JMM 20240331				", w.c16 total " & // Added by JMM 20240331 				", w.c24 k_coment " & // Added by JMM 20240403 				", abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) saldo " &				", (to_date(g.c12::text,'yyyy-mm-dd'))::text vencimiento " &   				", g.c4  uuid_o_ref, g.doc_refer_compl ref_compl/*added 20240514*//*, to_date(g.c12::text,'yyyy-mm-dd') vencimiento*/ " & 				"/* g.* */  /* e.* */ " & 				"/*line added 240303*/ , g.c3 prov_operacion, d.c3 prov_nombre " & 				", g.cve_prov_pago prov_pago, coalesce(dp.c3,'') prov_pago_nombre " & // Added by JMM 20240331				"from keplersc.kduxg g " &  				"inner join keplersc.kduxe e on g.c1 = e.c1 and g.c2 = e.c5 and g.c3 = e.c2 and g.c4 = e.c3 " & 				"/*and e.c5 = 'X' and e.c6 = 'A' and e.c7 = 55 and e.c8 = 1 -- Getting Specific Doc*/ " & 				"inner join keplersc.kdmm m on m.c1 = e.c5 and m.c2 = e.c6 and m.c3 = e.c7 and m.c4 = e.c8 " & 				"inner join keplersc.kdm1 w on w.c1 = e.c1 and w.c2 = e.c5 and w.c3 = e.c6 and w.c4 = e.c7 and w.c5 = e.c8 and w.c6 = e.c9 " & 				"/*line added 240303*/ inner join keplersc.kdxd d on d.c2 = g.c3 " & 				"inner join keplersc.kdxd dp on dp.c2 = g.cve_prov_pago "; // Added by JMM 20240331				//Condition Added by JMM 20240513, Adapted by JMM 20240514			if ( tip_ope &= "A" ) {					cmdQuery = cmdQuery & "" & 					"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and g.c3 = '" & proveedor_oper_id & "' and w.st_x_comprobar = 'S' " & 					"and w.c6 = '" & referencia & "' " &  					"/*and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10*/ /*to check GAP in balance to show record*/ ";					// Se comento la Linea de que solo muestre datos con Saldo porque ya pudieron estar saldados ...								} else {								//Condition Added by JMM 20240514 					if ( tip_ope &= "B" ) {											cmdQuery = cmdQuery & "" & 							"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and g.c3 = '" & proveedor_oper_id & "' and w.st_x_comprobar = 'X' " & 							"and w.c6 = '" & referencia & "' " &  							"/*and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10*/ /*to check GAP in balance to show record*/ ";												} else {											cmdQuery = cmdQuery & "" & 							"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and g.c3 = '" & proveedor_oper_id & "' and ( w.st_x_comprobar = 'X' or w.st_x_comprobar = 'S' ) " & 							"and w.c6 = '" & referencia & "' " &  							"/*and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10*/ /*to check GAP in balance to show record*/ ";														}								}						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscaFactura()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				respfunc = 0;				return respfunc;				}						if ( nXml(cuboQuery) == 0 ) {				//Condition Added by JMM 20240514				if ( tip_ope &= "A" || tip_ope &= "C" ) {					frn.message("El Documento No es Elegible para la Comprobacion, No es del Proveedor o No Existe ...","Error","Aceptar");				} else {					frn.message("El Documento No es Elegible para Revertir la Comprobacion, No es del Proveedor o No Existe ...","Error","Aceptar");				}				respfunc = 0;				return respfunc;			}						frn.set("k_folio",getXmlAtt(cuboQuery,"r0","folio") );						//Condition Added by JMM 20240514			if ( tip_ope &= "A" ) {				frn.set("k_docto",getXmlAtt(cuboQuery,"r0","uuid_o_ref") );			} else {				frn.set("k_docto",getXmlAtt(cuboQuery,"r0","ref_compl"/*"uuid_o_ref"*/) );			}						frn.set("c_fecha",getXmlAtt(cuboQuery,"r0","fecha") );			frn.set("c_monto",getXmlAtt(cuboQuery,"r0","total") );			frn.set("k_clave_pago",getXmlAtt(cuboQuery,"r0","prov_pago") );			frn.set("k_nombreprov_pago",getXmlAtt(cuboQuery,"r0","prov_pago_nombre") );						// Added by JMM 20240401			frn.set("k_plazo",getXmlAtt(cuboQuery,"r0","plazo") );			frn.set("k_vence",getXmlAtt(cuboQuery,"r0","vence") );						// Added by JMM 20240403			frn.set("k_coment",getXmlAtt(cuboQuery,"r0","k_coment") );						respfunc = 1/*nXml(cuboQuery)*/;						//Condition Added by JMM 20240513			if ( tip_ope &= "A" ) {				frn.setAtt("Buscar", "visible", "Y");				frn.setAtt("Buscar", "available", "Y");			} else {				MostrarDatos(referencia/*nFolio*/);			}						return respfunc;									} // End Fun - BuscarDoc										//------------------------End Implementing Convert Doc, by JMM 2024031-------------------------				//------------------------TABLA POLIZA------------------------				fun select_cuenta(){						frn.setX("", "k_mov", -1, "k_cuenta");				frn.setX("", "k_mov", -1, "k_cuentadesc");				var tbla = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2);				var cmdSel = "select c1 as clave_cuenta, c2 as desc_cuenta from " & tbla ;            frn.dialog("genlistafiltrosel","Cuentas",cmdSel ,"clave_cuenta","k_mov","", "k_cuenta","N");     		}						//Added by JMM 20240325		fun clear_row(imodo) {			if (imodo != 1) {				frn.setX("", "k_mov", -1, "k_cuenta");			}			frn.setX("", "k_mov", -1, "k_cuentadesc");			frn.setX("", "k_mov", -1, "k_cuentasaldo");			frn.setX("", "k_mov", -1, "k_cargo");			frn.setX("", "k_mov", -1, "k_abono");			frn.setX("", "k_mov", -1, "k_inventario");			frn.setX("", "k_mov", -1, "k_afecta");			frn.setX("", "k_mov", -1, "k_ctopto"); /*Added by JMM 20240718*/		}						fun Cuenta() {            var cuenta = frn.get("k_mov", -1, "k_cuenta");             var xmlRequest, cmd, cubo , ok, mensajeError ;            setXml(xmlRequest,"document","cuenta",cuenta);            setXml(xmlRequest,"document","anio",mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2));                        frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\requestCuenta");				cmd="select * from keplersc.caracteristicas_cuenta('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultadosCuenta");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					clear_row(); //Added by JMM 20240325					return;				}								var nivel_cuenta = getXmlAtt(cubo,"r0","nivel");				var descripcion_nivel = getXmlAtt(cubo,"r0","desc_nivel");				var tipo_cuenta = getXmlAtt(cubo,"r0","tipo");								if (descripcion_nivel &! "Menor"){					frn.message(/*"La Cuenta debe ser menor"*/"No es una Cuenta de Detalle","Error","Aceptar"); // UPD 20240229 by JMM					//Commented by JMM 20240325					/*					frn.setX("", "k_mov", -1, "k_cuenta");					frn.setX("", "k_mov", -1, "k_cuentadesc");					*/					clear_row(); //Added by JMM 20240325					return ;            }           				if (tipo_cuenta &= "Cliente"){					frn.message("La Cuenta no puede ser de cliente.","Error","Aceptar");					//Commented by JMM 20240325					/*					frn.setX("", "k_mov", -1, "k_cuenta");					frn.setX("", "k_mov", -1, "k_cuentadesc");					*/					clear_row(); //Added by JMM 20240325					return ;            }                				var tbla = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2);				cmd = "select c2 as desc_cuenta from " & tbla & " where c1='" & cuenta  &  "'";								var cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Cuenta()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					clear_row(); //Added by JMM 20240325					return;				}				var descr = getXmlAtt(cuboResultados , "r0","desc_cuenta");                  frn.setX(cuenta, "k_mov", -1, "k_cuenta");            frn.setX(descr , "k_mov", -1, "k_cuentadesc");                        //Added by JMM 20240718            if ( strlen( frn.get("k_mov",-1,"k_cuenta") ) == 0 || strlen( frn.get("k_mov",-1,"k_cuentadesc") ) == 0 ) {					frn.message("Cuenta No Valida ...","Error","Aceptar");					clear_row();            } else {					Prspto(1);            }            		}					fun Cargo() {			//Commented by JMM 20240325			/*			if(frn.getJ("k_mov")>0){ //Trae informaci?n del rengl?n anterior(descripci?n, depto, proyecto), si el rengl?n actual no tiene especificado algo				var renAnterior=frn.getJ("k_mov")-1;				if(strlen(frn.get("k_mov",-1,"k_descr"))==0)frn.setX(frn.get("k_mov",renAnterior,"k_descr"),"k_mov",-1,"k_descr");			}			*/						//Added by JMM 20240325			if ( strlen( frn.get("k_mov",-1,"k_cuenta") ) == 0 || strlen( frn.get("k_mov",-1,"k_cuentadesc") ) == 0 ) {				frn.setX("","k_mov",-1,"k_cargo");				frn.message("Debes Registrar primero una Cuenta Valida ...","Error","Aceptar");			}						frn.setX("","k_mov",-1,"k_abono");			CalcTotal();						//Added by JMM 20240718			if ( strlen( frn.get("k_mov", -1, "k_ctopto") ) > 0 ) {				Prspto(1);			}		}					fun Abono() {			//Commented by JMM 20240325			/*			if(frn.getJ("k_mov")>0){ //Trae informaci?n del rengl?n anterior(descripci?n, depto, proyecto), si el rengl?n actual no tiene especificado algo				var renAnterior=frn.getJ("k_mov")-1;				if(strlen(frn.get("k_mov",-1,"k_descr"))==0)frn.setX(frn.get("k_mov",renAnterior,"k_descr"),"k_mov",-1,"k_descr");			}			*/							//Added by JMM 20240325			if ( strlen( frn.get("k_mov",-1,"k_cuenta") ) == 0 || strlen( frn.get("k_mov",-1,"k_cuentadesc") ) == 0 ) {				frn.setX("","k_mov",-1,"k_abono");				frn.message("Debes Registrar primero una Cuenta Valida ...","Error","Aceptar");			}						frn.setX("","k_mov",-1,"k_cargo");							//Commented by JMM 20240311			/*			frn.setX("","k_mov", -1, "k_afecta"); // Added by JMM 20240308			frn.setX("","k_mov", -1, "k_inventario"); // Added by JMM 20240308			*/							CalcTotal();		}							fun CalcTotal() { 				var C=0,A=0; 				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) { 					C=C+frn.get("k_mov",i,"k_cargo");					A=A+frn.get("k_mov",i,"k_abono");				}							var subt = C - A;								// Commented by JMM 20240228				/*				var subt_con_iva = 0;				var iva = subt * prc_iva/100;				if (iva &! "N" ){ 					subt_con_iva = subt  + iva;				}else{ 					subt_con_iva = subt ;					iva = 0;				}				var retencion_isr = subt * prc_retencion_isr/100;				var retencion_iva = subt * prc_retencion_iva/100;				var otras_retenciones = subt * prc_otras_retenciones/100;				var importe = subt_con_iva;				*/												// Added by JMM 20240228				var iva;				//Commented by JMM 20240329				/*				if ( frn.get("chk_pc") == 1 ) {					iva = 0;				} else {				*/					iva = frn.get("k_uuid_impuesto");				/* } */ //Commented by JMM 20240329												// Commented by JMM 20240228				/*				if (retencion_isr &! "N" ){ 					importe = importe  - retencion_isr ;				}else{ 					retencion_isr = 0;				}								if (retencion_iva &! "N" ){ 					importe = importe  - retencion_iva ;				}else{ 					retencion_iva = 0;				}				if (otras_retenciones &! "" ){ 					importe = importe  - otras_retenciones;				}else{ 					otras_retenciones= 0;				}								frn.set("k_subtotal", subt, "k_iva" ,iva, "k_subtotal_con_iva", subt_con_iva  );				frn.set("k_retencion_isr", retencion_isr  , "k_retencion_iva" ,retencion_iva , "k_otras_retenciones", otras_retenciones );				*/								// Added by JMM 20240228				frn.set("k_subtotal", subt, "k_iva", iva);				var importe = subt + iva;												frn.set("k_monto", importe);			}				fun Vence() {		/* MSS Se quita la validaci n para que permita fecha anteriores			var fcha = frn.get("k_vence");			var fcha_actual = sys.date();			var diferencia_dias = fnDate("difc",fcha ,fcha_actual );						if (diferencia_dias < 0 ){				frn.message("La fecha de pago no puede ser en el pasado", "Mensaje","&Aceptar");				frn.set("k_vence", fcha_actual );				return ;			}else{				frn.set("k_plazo", diferencia_dias );			}	*/		}						fun busca_inv(){						//Commented by JMM 20240311			/*					var cargo = trim(frn.get("k_mov",-1,"k_cargo"));			var abono = trim(frn.get("k_mov",-1,"k_abono"));			if ( strlen(cargo) == 0 || strlen(abono) > 0 ) { return; } 			*/						// Added by JMM 20240325			var cargo = trim(frn.get("k_mov",-1,"k_cargo"));			var abono = trim(frn.get("k_mov",-1,"k_abono"));			if ( strlen(cargo) == 0 && strlen(abono) == 0 ) { return; } 						// Added by JMM 20240325			var ctanum = trim(frn.get("k_mov",-1,"k_cuenta"));			var ctadscr = trim(frn.get("k_mov",-1,"k_cuentadesc"));			if ( strlen(ctanum) == 0 || strlen(ctadscr) == 0 ) { return; }						var cmdSel = "select c2 as inventario, c3 as clave_vehiculo, c5 as serie, c17 as marca, c4 as descripcion from keplersc.kdinf where c1='" & frn.get("k_sucn",-1,1) & "'";         frn.dialog("genlistafiltrosel","Inventarios",cmdSel ,"inventario","k_mov","", "k_inventario","N");     		}						// Added by JMM 20240718		fun busca_ctopto(){						var cargo = trim(frn.get("k_mov",-1,"k_cargo"));			var abono = trim(frn.get("k_mov",-1,"k_abono"));			if ( strlen(cargo) == 0 && strlen(abono) == 0 ) { return; } 						var ctanum = trim(frn.get("k_mov",-1,"k_cuenta"));			var ctadscr = trim(frn.get("k_mov",-1,"k_cuentadesc"));			if ( strlen(ctanum) == 0 || strlen(ctadscr) == 0 ) { return; }						var cmdSel = "select cve_concepto, descripcion from keplersc.kdcatconpres where sucursal = '" & frn.get("k_sucn",-1,1) & "'";         frn.dialog("genlistafiltrosel","Conceptos Presupuestos",cmdSel ,"cve_concepto","k_mov","", "k_ctopto","N");     		}						fun Inventario() {						//Commented by JMM 20240311 				/*				//Added by JMM 20240308				var cargo = trim(frn.get("k_mov",-1,"k_cargo"));				var abono = trim(frn.get("k_mov",-1,"k_abono"));				if ( strlen(cargo) == 0 || strlen(abono) > 0 ) { 					frn.setX("","k_mov", -1, "k_afecta");					frn.setX("","k_mov", -1, "k_inventario");					return; 				} 				*/												// Added by JMM 20240325				var ctanum = trim(frn.get("k_mov",-1,"k_cuenta"));				var ctadscr = trim(frn.get("k_mov",-1,"k_cuentadesc"));				if ( strlen(ctanum) == 0 || strlen(ctadscr) == 0 ) { 					frn.message("Debes Registrar primero una Cuenta Valida ...","Error","Aceptar");					frn.setX("", "k_mov", -1, "k_inventario");					frn.setX("","k_mov", -1, "k_afecta"); 					return; 				}								// Added by JMM 20240325				var cargo = trim(frn.get("k_mov",-1,"k_cargo"));				var abono = trim(frn.get("k_mov",-1,"k_abono"));				if ( strlen(cargo) == 0 && strlen(abono) == 0 ) { 					frn.message("Debes Registrar primero el monto del Cargo o Abono ...","Error","Aceptar");					frn.setX("", "k_mov", -1, "k_inventario");					frn.setX("","k_mov", -1, "k_afecta");					return; 				} 												//Added by JMM 20240308				if ( strlen(trim(frn.get("k_mov", -1, "k_inventario"))) == 0 ) {					frn.setX("", "k_mov", -1, "k_inventario");					frn.setX("","k_mov", -1, "k_afecta"); 					return;				}				var cmd, ok, mensajeError ;				cmd = "select c2 from keplersc.kdinf where c1='" & frn.get("k_sucn",-1,1) & "' and c2='" & frn.get("k_mov", -1, "k_inventario") & "'";								var cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Inventario()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					frn.setX("", "k_mov", -1, "k_inventario"); //Added by JMM 20240308					frn.setX("","k_mov", -1, "k_afecta"); //Added by JMM 20240308 					return;				}								if (nXml(cuboResultados ) < 1){					frn.message("Inventario no existe","Error","Aceptar");					frn.setX("", "k_mov", -1, "k_inventario");					frn.setX("","k_mov", -1, "k_afecta"); //Added by JMM 20240308					return;				}						} // End : Fun Inventario 						//New Added by JMM 20240308		fun Afecta() {			var valor_afecta = trim ( frn.get("k_mov", -1, "k_afecta") );			if ( strlen( trim ( frn.get("k_mov", -1, "k_inventario") ) ) == 0 ) { frn.setX("","k_mov", -1, "k_afecta"); }			if ( valor_afecta &! "U" && valor_afecta &! "A" ) { frn.setX("","k_mov", -1, "k_afecta"); }			return;		}						//New Added by JMM 20240718		fun Prspto(imodo) {					//Added by JMM 20240715				var irow/*, icol*/;								/*icol = frn.getI("k_mov");*/				irow = frn.getJ("k_mov");					var ctanum = trim(frn.get("k_mov",-1,"k_cuenta"));				var ctadscr = trim(frn.get("k_mov",-1,"k_cuentadesc"));				if ( strlen(ctanum) == 0 || strlen(ctadscr) == 0 ) { 					frn.message("Debes Registrar primero una Cuenta Valida ...","Error","Aceptar");					frn.setX("", "k_mov", -1, "k_ctopto");					return; 				}								var cargo = trim(frn.get("k_mov",-1,"k_cargo"));				var abono = trim(frn.get("k_mov",-1,"k_abono"));				if ( strlen(cargo) == 0 && strlen(abono) == 0 ) { 					if ( imodo != 1 ) {						frn.message("Debes Registrar primero el monto del Cargo o Abono ...","Error","Aceptar");					}					frn.setX("", "k_mov", -1, "k_ctopto");					return; 				} 								if ( strlen(trim(frn.get("k_mov", -1, "k_ctopto"))) == 0 ) {					frn.setX("", "k_mov", -1, "k_ctopto");					return;				}				var cmd, ok, mensajeError, cuboResultados ; //Para todos los Queries de la Funcion 												// Verifica CAT Cuentas para validar si la Cta maneja Presupuesto 								//Commented by JMM 20240715 ... Converted as Func				/*				var tablakdc1 = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;				var tablakdc2 = " keplersc.kdc2" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) & strSplit(frn.get("k_fecha"), "-", 1);				cmd = "select upper(c99) from  " & tablakdc1 & " where c1 = '" & frn.get("k_mov", -1, "k_cuenta") & "' and upper(c99) = 'S' ";								rstXml(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Presupuesto()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_CtaContPrsto");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					frn.setX("", "k_mov", -1, "k_ctopto"); 					return;				}								if (nXml(cuboResultados ) < 1){					if ( imodo != 1 ) {						frn.message("La Cuenta No Maneja Presupuesto","Error","Aceptar");					}					frn.setX("", "k_mov", -1, "k_ctopto");					return;				}				*/								//Added by JMM 20240715				var vflag;				vflag = "";								vflag = ManejaPresupuesto(irow, imodo);				if ( vflag == -0.0000001 ) {					return;				}												// Verifica CAT Conceptos Presupuesto para validar si existe  								cmd = "select descripcion from keplersc.kdcatconpres where sucursal = '" & frn.get("k_sucn",-1,1) & "' and cve_concepto = '" & frn.get("k_mov", -1, "k_ctopto") & "'";								rstXml(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Cat_Concept_Prsto()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_CatCptoPrsto");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					frn.setX("", "k_mov", -1, "k_ctopto");  					return;				}								if (nXml(cuboResultados ) < 1){					frn.message("Concepto del Presupuesto No existe","Error","Aceptar");					frn.setX("", "k_mov", -1, "k_ctopto");					return;				}											// Verifica TBL de Presupuestos para validar si cuenta con datos registrados 								//Moved by JMM 20240718				var vimp;				vimp = 0;								//Commented by JMM 20240715 ... Converted as Func				/*				var vanio = "20" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;				var vmes = strSplit(frn.get("k_fecha"), "-", 1);								cmd = "select importe from keplersc.kdpresupuestos where sucursal = '" & frn.get("k_sucn",-1,1) & "' and cve_concepto = '" & frn.get("k_mov", -1, "k_ctopto") & "'";								cmd = cmd & " and anio = '" & vanio & "' and mes = '" & vmes & "'";									rstXml(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Res_Prsto()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_Prsto");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					frn.setX("", "k_mov", -1, "k_ctopto");  					return;				}				var vimp;				vimp = 0;								if (nXml(cuboResultados ) < 1){					frn.message("No se ha Registrado el Presupuesto para el Concepto, dentro del periodo de la Operacion ...","Error","Aceptar");					frn.setX("", "k_mov", -1, "k_ctopto");					return;				}	else	{					vimp = getXmlAtt(cuboResultados , "r0","importe");					frn.message("Monto Presupuestado del Periodo ... " & vimp,"Info !!!","Aceptar");				}				*/								//Added by JMM 20240715				vimp = PrsptoXPeriodo(irow);				if ( vimp == -0.0000001 ) {					return;				}															// Validar TBLs para determinar monto ejercido en el periodo ...								var vejercido, vnvomonto;				vejercido = PrsptoXPeriodo_Ejercido(irow); 				vnvomonto = cargo + vejercido;				if ( vejercido != -0.0000001 ) {					/*frn.message("Monto Ejercido del Concepto en el Periodo ... " & vejercido,"Info !!!","Aceptar");*/					if ( strlen(cargo) > 0 ) {						if ( vnvomonto > vimp ) {							frn.message("No puedes exceder el Presupuesto para el Concepto ... " & frn.get("k_mov", -1, "k_ctopto") & "|" & " " & "|" & 								"Presupuesto : " &vimp  & "|" & " " & "|" & 								"Monto Ejercido : " & vejercido & "|" & 								"(+) Nuevo Cargo = " & cargo & "|" & "(=) Monto Nuevo = " & vnvomonto,"Error","Aceptar");							frn.setX("", "k_mov", -1, "k_ctopto");						}					}				}							} // End : Fun Prspto 								//New Added by JMM 20240718		fun ManejaPresupuesto(irow, imodo) {						var cmd, ok, mensajeError, cuboResultados ; //Para todos los Queries de la Funcion 				var vflag;				var regs; //Added by JMM 20240816				var vanio; //Added by JMM 20240820													// Validar TBLs para verificar si la CTA maneja presupuesto ...								// Added by JMM 20240820				sucursal_id = frn.get("k_sucn",-1,1); 				vanio = fnDate("year",frn.get("c_fecha"/*"k_fecha"*/));								vflag = -0.0000001;								var tablakdc1 = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;				var tablakdc2 = " keplersc.kdc2" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) & strSplit(frn.get("k_fecha"), "-", 1);				//Adapted by JMM 20240816 ... New TBL will be used for validating				//cmd = "select upper(c99) from  " & tablakdc1 & " where c1 = '" & frn.get("k_mov",irow/*-1*/, "k_cuenta") & "' and upper(c99) = 'S' ";				cmd = "select count(*) as regs from keplersc.cat_ctas_ppto ccp where '" & frn.get("k_mov",irow/*-1*/, "k_cuenta") & "' between ccp.rango_ini and ccp.rango_fin";								//Added by JMM 20240820					cmd = cmd & " and sucursal = '" & sucursal_id & "' and anio = '" & vanio & "'";								rstXml(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Presupuesto()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_CtaContPrsto");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					frn.setX("", "k_mov",irow/*-1*/, "k_ctopto"); 					return -0.0000001;				}								if (nXml(cuboResultados ) < 1){					if ( imodo != 1 && imodo != 2 ) {						frn.message("La Cuenta No Maneja Presupuesto","Error","Aceptar");					}					frn.setX("", "k_mov",irow/*-1*/, "k_ctopto");					if ( imodo != 2 ) {						return -0.0000001;					} else {						return 0;					}				} 				else { //Added by JMM 20240718 ... plus original code					//Added for Adapting by JMM 20240816 for new validation sch					regs = getXmlAtt(cuboResultados , "r0","regs");					if ( regs > 0 ) {						return 1; //Original before adapting					} else {						if ( imodo != 1 && imodo != 2 ) {							frn.message("La Cuenta No Maneja Presupuesto","Error","Aceptar");						}						frn.setX("", "k_mov",irow/*-1*/, "k_ctopto");						if ( imodo != 2 ) {							return -0.0000001;						} else {							return 0;						}					}				}								} // End : Fun ManejaPresupuesto						//New Added by JMM 20240718		fun PrsptoXPeriodo(irow, imodo) {					var cmd, ok, mensajeError, cuboResultados ; //Para todos los Queries de la Funcion 				var vimp;													// Validar TBLs para determinar monto ejercido en el periodo ...								vimp = -0.0000001;								var vanio = "20" & mid(strSplit(frn.get("c_fecha"/*"k_fecha"*/), "-", 0), 2,2) ;				var vmes = strSplit(frn.get("c_fecha"/*"k_fecha"*/), "-", 1);								cmd = "select importe from keplersc.kdpresupuestos where sucursal = '" & frn.get("k_sucn",-1,1) & "' and cve_concepto = '" & frn.get("k_mov",irow/*-1*/, "k_ctopto") & "'";								cmd = cmd & " and anio = '" & vanio & "' and mes = '" & vmes & "'";								rstXml(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Res_Prsto()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_Prsto");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					frn.setX("", "k_mov",irow/*-1*/, "k_ctopto");  					return -0.0000001;				}				if (nXml(cuboResultados ) < 1){					if ( imodo != 2 ) {						frn.message("No se ha Registrado el Presupuesto para el Concepto, dentro del periodo de la Operacion ...","Error","Aceptar");						frn.setX("", "k_mov",irow/*-1*/, "k_ctopto");						return -0.0000001;					} else {						return 0;					}				}	else	{					vimp = getXmlAtt(cuboResultados , "r0","importe");					/*frn.message("Monto Presupuestado del Periodo ... " & vimp,"Info !!!","Aceptar");*/					return vimp;				}								} // End : Fun PrsptoXPeriodo						//New Added by JMM 20240718		fun PrsptoXPeriodo_Ejercido(irow, imodo) {					var cmd, ok, mensajeError, cuboResultados ; //Para todos los Queries de la Funcion 				var vimp, vsuc;													// Validar TBLs para determinar monto ejercido en el periodo ...								vimp = -0.0000001;								vsuc = frn.get("k_sucn",-1,1); /*Added by JMM 20240716*/								var vanio = "20" & mid(strSplit(frn.get("c_fecha"/*"k_fecha"*/), "-", 0), 2,2) ;				var vmes = strSplit(frn.get("c_fecha"/*"k_fecha"*/), "-", 1);											cmd = "select sum(importe) importe from ( select * from ( ";				cmd =	cmd & "select coalesce( " &						"( " &						"select sum( case when upper(k6.c10) = 'C' then k6.c11 else case when upper(k6.c10) = 'A' then k6.c11 * -1 else 0 end end ) importe " &						"from keplersc.kdm6 k6 " &						"inner join keplersc.kdm1 k1 on k6.c1 = k1.c1 and k6.c2 = k1.c2 and k6.c3 = k1.c3 and k6.c4 = k1.c4 and k6.c5 = k1.c5 and k6.c6 = k1.c6 " &						"where k6.c1 = '" & vsuc & "' and k6.c2 = 'X' and k6.c3 = 'A' and k6.c4 = 12 and k6.c5 = 1 and k6.ctopto = '" & frn.get("k_mov",irow/*-1*/, "k_ctopto") & "' " & 						"and upper(k1.c43) <> 'C' and extract(year from k1.c9)::text = '" & vanio & "' and lpad(extract(month from k1.c9)::text,2,'0') = '" & vmes & "' " &						") " &  					", 0) as importe ";				cmd =	cmd & "union all ";				cmd =	cmd &	"select coalesce( " &						"( " &						"select sum( case when upper(kd.c10) = 'C' then kd.c11 else case when upper(kd.c10) = 'A' then kd.c11 * -1 else 0 end end ) importe " &						"from keplersc.kdmdocscompr kd " & 						"inner join keplersc.kdm1 k1 on kd.c1 = k1.c1 and kd.c2 = k1.c2 and kd.c3 = k1.c3 and kd.c4 = k1.c4 and kd.c5 = k1.c5 and kd.c6 = k1.c6 " & 						"where kd.c1 = '" & vsuc & "' and kd.c2 = 'X' and kd.c3 = 'A' and kd.c4 = 12 and kd.c5 = 1 and kd.ctopto = '" & frn.get("k_mov",irow/*-1*/, "k_ctopto") & "' " &						"and upper(k1.c43) <> 'C' and extract(year from k1.c9)::text = '" & vanio & "' and lpad(extract(month from k1.c9)::text,2,'0') = '" & vmes & "' " &						") " &					", 0) as importe ";				cmd =	cmd & ") rf ) t_sum ";								rstXml(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Prsto_Ejercido()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_PrstoEjercido");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					frn.setX("", "k_mov",irow/*-1*/, "k_ctopto");  					return -0.0000001;				}							if (nXml(cuboResultados ) < 1){					if ( imodo != 2 ) {						frn.message("No se pudo determinar el Presupuesto Ejercido para el Concepto ...","Error","Aceptar");						frn.setX("", "k_mov",irow/*-1*/, "k_ctopto");						return -0.0000001;					} else {						return -0.0000002;					}					}	else	{					vimp = getXmlAtt(cuboResultados , "r0","importe");					/*frn.message("Monto Ejercido del Concepto en el Periodo ... " & vimp,"Info !!!","Aceptar");*/					return vimp;				}							} // End : Fun PrsptoXPeriodo_Ejercido								//-----------------------------------------------				fun ConfiguraControlesOff() {							frn.setAtt("textFolio", "visible", "N");			frn.setAtt("k_folio", "available", "N");			frn.setAtt("k_folio", "visible", "N");			frn.setAtt("k_mov", "modify", "N");			frn.setAtt("k_mov", "available", "N"); //Added by JMM 20240306			frn.setAtt("k_clave", "available", "N");			frn.setAtt("k_refer", "available", "N");			frn.setAtt("k_vence", "available", "N");			frn.setAtt("k_plazo", "available", "N");			frn.setAtt("k_coment","modify", "N");			frn.setAtt("k_coment","available", "N");			frn.setAtt("Imprimir", "visible", "N");			frn.setAtt("Cancelar", "visible", "N");			frn.setAtt("Aceptar", "visible", "N");			frn.setAtt("buscar_datos", "visible", "N");						//Added by JMM 20240215			frn.setAtt("k_fecha", "available", "N");			frn.setAtt("Buscar", "visible", "N");			frn.setAtt("Buscar", "available", "N");						// Added by JMM 20240215 ; UPD by JMM 20240227			// if ( paramProvPago /*&= "P"*/ > 0 ) {				frn.setAtt("textProvPago", "visible", "Y");				frn.setAtt("k_clave_pago", "visible", "Y");				frn.setAtt("k_nombreprov_pago", "visible", "Y");			/*			} else {				frn.setAtt("textProvPago", "visible", "N");				frn.setAtt("k_clave_pago", "visible", "N");				frn.setAtt("k_nombreprov_pago", "visible", "N");							}			*/			frn.setAtt("k_clave_pago", "available", "N");			frn.setAtt("k_nombreprov_pago", "available", "N");			frn.set("chk_pc",0); // Added by JMM 20240229			 			// Commented by JMM 20240329 			/*			// Added by JMM 20240307			frn.setAtt("chk_pc", "visible", "N");  			frn.setAtt("chk_pc", "available", "N");			frn.setAtt("text_chk", "visible", "N"); 			*/						frn.setAtt("k_tipon", "available", "N"); // Added by JMM, 20240312						// Added by JMM 20240325 			frn.setAtt("k_mov", "modify", "Y", "k_cuenta");			frn.setAtt("k_mov", "available", "Y", "k_cuenta");			frn.setAtt("k_mov", "modify", "Y", "k_abono");			frn.setAtt("k_mov", "available", "Y", "k_abono");						// Added by JMM 20240812 			frn.setAtt("k_mov", "modify", "N", "k_ctopto");			frn.setAtt("k_mov", "available", "N", "k_ctopto");			frn.setAtt("k_mov", "visible", "Y", "k_ctopto");										}						fun ConfiguraControlesOpcion() {						ConfiguraControlesOff();			if(tip_ope &= "A"){ //Alta				frn.setAtt("k_clave", "available", "N"/*"Y"*/); // Put Disabled by JMM 20240207				frn.setAtt("k_refer", "available", "N"/*"Y"*/); // Put Disabled by JMM 20240207								// Commented by JMM 20240331				/*				frn.setAtt("k_mov", "modify", "Y");				frn.setAtt("k_mov", "available", "Y"); //Added by JMM 20240306				*/				//Added by JMM 20240402				frn.setAtt("k_mov", "modify", "N");				frn.setAtt("k_mov", "available", "N");								frn.setAtt("k_coment","modify", "N"/*"Y"*/); // Put Disabled by JMM 20240403				frn.setAtt("k_plazo", "available", "N"/*"Y"*/); // Put Disabled by JMM 20240206				frn.setAtt("k_coment","available", "Y");				frn.setAtt("k_fecha", "available", "N"/*"Y"*/);	//MSS Habilitar fecha // Put Disabled by JMM 20240206 				frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "Y");				frn.setAtt("Aceptar", "visible", "Y");										// Commented by JMM 20240331					/*						// Added by JMM 20240215				frn.setAtt("Buscar", "visible", "Y");				frn.setAtt("Buscar", "available", "Y");				*/				//Added by JMM 20240402				frn.setAtt("Buscar", "visible", "N");				frn.setAtt("Buscar", "available", "N");								// Commented by JMM 20240328				/*				// Added by JMM 20240215 ; UPD by JMM 20240227				if ( paramProvPago > 0 ) {									frn.setAtt("k_clave_pago", "available", "Y");				} else {					frn.setAtt("k_clave_pago", "available", "N");				}				*/				frn.setAtt("k_clave_pago", "available", "N"); // Added by JMM 20240328								// Commented by JMM 20240329				/*				// Added by JMM 20240307				frn.setAtt("chk_pc", "visible", "Y"); // Added by JMM 20240307 				frn.setAtt("chk_pc", "available", "Y"); // Added by JMM 20240307 				frn.setAtt("text_chk", "visible", "Y"); // Added by JMM 20240307				*/								frn.setAtt("k_tipon", "available", "N"); // Added by JMM, 20240312								// Added by JMM 20240329				frn.setAtt("textFolio", "visible", "Y");				frn.setAtt("k_folio", "available", "Y");				frn.setAtt("k_folio", "visible", "Y");										frn.setAtt("buscar_datos", "visible", "Y");								// Added by JMM 20240812 				frn.setAtt("k_mov", "modify", "Y", "k_ctopto");				frn.setAtt("k_mov", "available", "Y", "k_ctopto");				frn.setAtt("k_mov", "visible", "Y", "k_ctopto");							} else {				if(tip_ope &= "B"){ //Baja					frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");						frn.setAtt("Cancelar", "visible", "Y"); /*Added by JMM 20240513*/						frn.setAtt("Aceptar", "visible", "Y");						frn.setAtt("buscar_datos", "visible", "Y");											frn.setAtt("k_fecha", "available", "N"/*"Y"*/);	//MSS Habilitar fecha  // Put Disabled by JMM 20240206						// Added by JMM,20240215					frn.setAtt("Buscar", "visible", "N");					frn.setAtt("Buscar", "available", "N");										frn.setAtt("k_clave_pago", "available", "N"); // Added by JMM, 20240215 					frn.setAtt("k_mov", "available", "N"); //Added by JMM 20240306										// Commented by JMM 20240329					/*					// Added by JMM 20240307					frn.setAtt("chk_pc", "visible", "N"); // Added by JMM 20240307 					frn.setAtt("chk_pc", "available", "N"); // Added by JMM 20240307 					frn.setAtt("text_chk", "visible", "N"); // Added by JMM 20240307					*/										/*frn.setAtt("k_tipon", "available", "Y");*/ // Added by JMM 20240312, commented 20240513											//Added by JMM 20240402					frn.setAtt("k_mov", "modify", "N");					frn.setAtt("k_mov", "available", "N");									} else {					if(tip_ope &= "C"){ //Consulta						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");																		//Adapted by JMM ... La Impresion estara disponible desde la SCR del Contrarecibo Universal ... Se Consultara Esto ...						frn.setAtt("Imprimir", "visible", "Y");						/*frn.setAtt("Imprimir", "visible", "N");*/																		frn.setAtt("buscar_datos", "visible", "Y");						// Added by JMM,20240215						frn.setAtt("Buscar", "visible", "N");						frn.setAtt("Buscar", "available", "N");													frn.setAtt("k_clave_pago", "available", "N"); // Added by JMM, 20240215 						frn.setAtt("k_mov", "available", "N"); //Added by JMM 20240306												// Commented by JMM 20240329						/*						// Added by JMM 20240307						frn.setAtt("chk_pc", "visible", "N"); // Added by JMM 20240307 						frn.setAtt("chk_pc", "available", "N"); // Added by JMM 20240307 						frn.setAtt("text_chk", "visible", "N"); // Added by JMM 20240307						*/												/*frn.setAtt("k_tipon", "available", "Y");*/ // Added by JMM 20240312, commented 20240513											//Added by JMM 20240402						frn.setAtt("k_mov", "modify", "N");						frn.setAtt("k_mov", "available", "N");											} else {						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");						// Added by JMM,20240215						frn.setAtt("Buscar", "visible", "N");						frn.setAtt("Buscar", "available", "N");												frn.setAtt("k_clave_pago", "available", "N"); // Added by JMM, 20240215 						frn.setAtt("k_mov", "available", "N"); //Added by JMM 20240306												// Commented by JMM 20240329						/*						// Added by JMM 20240307						frn.setAtt("chk_pc", "visible", "N"); // Added by JMM 20240307 						frn.setAtt("chk_pc", "available", "N"); // Added by JMM 20240307 						frn.setAtt("text_chk", "visible", "N"); // Added by JMM 20240307						*/												frn.setAtt("k_tipon", "available", "N"); // Added by JMM, 20240312												//Added by JMM 20240402						frn.setAtt("k_mov", "modify", "N");						frn.setAtt("k_mov", "available", "N");											}					}			}		}				//---------------------------------------EJECUTA---------------------------------			fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			var resultado, mensaje, folio;							fecha = sys.date();			hora= sys.time();									// For Testing ... 20240215 ; UPD by JMM 20240227			if ( paramProvPago /*&= "P"*/ > 0 ) { 				/*				frn.message("Opcion No Disponible ... Estatus en Fase de Desarrollo.","Info !!!","Aceptar");				return;				*/			}											if (tip_ope &= "A") {							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;				ValidarDatos();				if(ok &! "1" || resVal == 0){					return;				}				continua = frn.message("Desea continuar con la Comprobacion del Documento ?","Atencion",2);				if (continua == 0){					return;				}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;											setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0") & ":" &				frn.lib("libGeneral.kpl","PadLeft",sys.time("seg",hora) ,2,"0"));  /*Added by JMM 20240429*/				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov") -1);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);								//setXml(xmlPantalla,"operacion","CONTR_REC_CONVERT"); /*Added by JMM 20240429 , Commented JMM 20240813*/				setXml(xmlPantalla,"operacion","CONTR_REC_COMPROBACION"); /*Adapted by JMM 20240813*/								//ajusta etiquetas con el standar de mov_prim_alta, las columnas en kdm1 tienen valores diferentes dependiendo el movimiento				// Commented by JMM 20240228				/*				setXml(xmlPantalla,"k_miepsret",frn.get("k_retencion_isr"));				setXml(xmlPantalla,"k_mivaret",frn.get("k_retencion_iva"));				setXml(xmlPantalla,"k_montoanticipo",frn.get("k_otras_retenciones"));				*/				// Added by JMM 20240228				setXml(xmlPantalla,"k_subtotal_con_iva",frn.get("k_monto"));												//Added 20240214				setXml(xmlPantalla,"uuid","serie",serie_uuid);				setXml(xmlPantalla,"uuid","folio",folio_uuid);				setXml(xmlPantalla,"uuid","total",total_uuid);				setXml(xmlPantalla,"uuid","fechatimbrado",fecha_uuid);				//Added 20240226				setXml(xmlPantalla,"uuid","impuesto",impuesto_uuid);									// Added by JMM 20240308				setXml(xmlPantalla,"ambiente","schema","CXP_CONTR_REC_CONVERT");												frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaContrareciboConvert");												// For Testing ... 20240208 				/*				frn.message("La Informacion se Procesara ...","Info !!!","Aceptar");				return;				*/								//cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cuboQuery);				cmdQuery="SELECT * FROM keplersc.doc_gastos_comprobar('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_contrarecibo_crud.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoContrareciboConvert");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					folio = frn.get("k_folio"); // Added by JMM 20240405					tip_ope = "C";					/*frn.set("k_folio", mensaje);*/ 					frn.set("operacion", "CONSULTA");					/*					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto", strTmp);					*/					strMsg = "El Folio Actualizado (Comprobado) para esta operacion fue : " & folio/*mensaje*/;					ConfiguraControlesOpcion(); 					frn.message(strMsg, "Mensaje", "Aceptar");					CambiaFolio();					LimpiaEncabezado();					/*folio = frn.get("k_folio");*/					MostrarDatos(folio);						//BuscarFolio();				} else {					frn.message(mensaje, "Error", "Aceptar");				}			} else {				if (tip_ope &= "B") {									//Commented by JMM 20240513					/*					// Added by JMM 20240402					frn.message("Opcion No Disponible ...", "Error", "Aceptar");					return ;					*/										if (estatus_doc &= "C"){						frn.message("No puedes dar de baja un folio cancelado.", "Error", "Aceptar");						return ;					}					continua = frn.message(" Desea continuar con la baja?","Atencion",2);					if (continua == 0){						return;					}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;													setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0") & ":" &					frn.lib("libGeneral.kpl","PadLeft",sys.time("seg",hora) ,2,"0"));  /*Added by JMM 20240805*/					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);					setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov"));					setXml(xmlPantalla,"operacion","baja");					setXml(xmlPantalla,"ambiente","uen",uen);										//setXml(xmlPantalla,"operacion","CONTR_REC_CONVERT_ROLLBACK"); /*Added by JMM 20240513 , Commented JMM 20240813*/					setXml(xmlPantalla,"operacion","CONTR_REC_REVERTIR_COMPROBACION"); /*Adapted by JMM 20240813*/										setXml(xmlPantalla,"ambiente","schema","CXP_CONTR_REC_CONVERT_ROLLBACK"); /*Added by JMM 20240513*/											frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaContrareciboConvertBaja");					// For Testing ... 20240213 					/*					frn.message("La Informacion se Procesara ...","Info !!!","Aceptar");					return;					*/									//cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					cmdQuery="SELECT * FROM keplersc.doc_gastos_comprobar_rollback('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					rstXml(cuboQuery);											cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_contrarecibo_crud_convert.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoContrareciboConvertBaja");											resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok) {						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}					if(resultado &= "1") {						/*						tip_ope = "C";						frn.set("operacion", "CONSULTA");						ConfiguraControlesOpcion();						BuscarFolio();						*/						folio = frn.get("k_folio"); // Added by JMM 20240405						tip_ope = "C";						frn.set("operacion", "CONSULTA");						strMsg = "El Folio Actualizado (Revertido) para esta operacion fue : " & folio/*mensaje*/;						ConfiguraControlesOpcion(); 						frn.message(strMsg, "Mensaje", "Aceptar");						CambiaFolio();						LimpiaEncabezado();						MostrarDatos(folio);											} else {						frn.message(mensaje, "Error", "Aceptar");					}				} else {					folio = frn.get("k_folio");					MostrarDatos(folio);				}	/*End Consulta*/ 			}						}				//Validacion Datos Generales y Partidas antes de Guardar.		//El resultado de cada validacion se guarda en la variable global resVal.		fun ValidarDatos() {			var totReg, strTotal=0,subTotal=0, iva=0, total=0, renglones, str;						// New 20240121 ... To Get of PARAMs 			var gapMonto, gapDias,vdiferencia; 						//Obtener variables			sucursal_id = frn.get("k_sucn",-1,1);			proveedor_id = frn.get("k_clave");			refer_id = frn.get("k_refer");						// Added by JMM 20240229			proveedor_pago_id = trim(frn.get("k_clave_pago"));									// Commented by JMM 20240329			/*			// Added by JMM 20240229, Esta condicion es para discriminar validaciones relacionadas con UUID si Chk por Comprobar esta Activado			if ( frn.get("chk_pc") != 1 ) {			*/							//Code Added by JMM 20240208 ... Related to Implementing UUID Transaction 							//Obtener PARAMs (GAPs) ... 20240112 ... NEW				cmdQuery="SELECT count(*) as totreg from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro in ('GAP Dias Fecha Gastos','GAP Monto Gastos')";				rstXml(cuboQuery);								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					resVal=0;					return;				}				totReg=getXmlAtt(cuboQuery,"r0","totreg");				if(totReg==0){					frn.message("Los Parametros [GAPs] Necesarios para la Operacion No Existen ...","Error","Aceptar");					resVal=0;					return;				} else {					if(totReg<2){						frn.message("Los Parametros [GAPs] Necesarios para la Operacion No estan Completos ...","Error","Aceptar");						resVal=0;						return;					} else {											// Obtener PARAMs 						// { GAP Dias Fecha Gastos }						cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Dias Fecha Gastos'";						rstXml(cuboQuery);										cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");											frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPDias");											ok=getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							resVal=0;							return;						}						if (nXml(cuboQuery) > 0) {							gapDias = getXmlAtt(cuboQuery,"r0","paramvalor");						} else {							frn.message("Hubo problemas para obtener los Parametros [GAP Dias Fecha Gastos] ...","Error","Aceptar");							resVal=0;							return;						}											// { GAP Monto Gastos }						cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Monto Gastos'";						rstXml(cuboQuery);										cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");											frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPMonto");											ok=getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							resVal=0;							return;						}						if (nXml(cuboQuery) > 0) {							gapMonto = getXmlAtt(cuboQuery,"r0","paramvalor");						} else {							frn.message("Hubo problemas para obtener los Parametros [GAP Monto Gastos] ...","Error","Aceptar");							resVal=0;							return;						}										}				}				//Validar Referencia ... Moved here 20240112 				if (refer_id &= ""){					frn.setPos("k_refer");					resVal=0;					frn.message("Es necesario seleccionar la Factura del Proveedor ...","Error","Aceptar");					return;				}										//Updated by JMM 20240208 				if ( strlen(/*folio_uuid*/nombre_uuid) == 0 || strlen(rfc_uuid) == 0 || strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {					frn.message("No se cuenta con todos los datos mandatorios del UUID.","Error","Aceptar");					resVal=0;					return;				}								//Validar Fecha Referencia ... 20240112 ... NEW				if ( Validar_Fecha_UUID() == 0 ) {						resVal = 0;					return;				}						// Commented by JMM 20240329			/*						} // End : if ( frn.get("chk_pc") == 1 ) {			else	{				// Else condition Addeb 20240229				// Validar Referencia ... Moved here 20240112 				if (refer_id &= ""){					frn.setPos("k_refer");					resVal=0;					frn.message("Debe Capturar la Referencias del Proveedor ..." & "|" & " " & "|" & 						"Esta debe ser lo suficiente descriptiva para ubicar la Operacion." & "|" & " " & "|" & 						"No debe ser una Factura, ya que es un Registro por Comprobar.","Error","Aceptar");					return;				}							}				*/																			//Validar Proveedor			// Added 20240112			if ( strlen(frn.get("k_clave")) == 0 || frn.get("k_clave") &= strFormat("ucase","No Existe ...") ) {				if ( strlen(frn.get("k_clave")) == 0 ) {					frn.message("No hay Proveedor Asociado a la Operacion ...","Error","Aceptar");				} else {					frn.message("El Proveedor No Existe ...","Error","Aceptar");				}				resVal=0;				return;			}						//End Code Added by JMM 20240208 ... Related to Implementing UUId Transaction 									//Validar Proveedor			cmdQuery="SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_id & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("El Proveedor No Existe.","Error","Aceptar");				resVal=0;				return;			}			//Validar Proveedor Pago			// Added 20240229			if ( strlen(frn.get("k_clave_pago")) == 0 || frn.get("k_nombreprov_pago") &= strFormat("ucase","No Existe ...") ) {				if ( strlen(frn.get("k_clave_pago")) == 0 ) {					frn.message("No hay Proveedor de Pago Asociado a la Operacion ...","Error","Aceptar");				} else {					frn.message("El Proveedor de Pago No Existe ...","Error","Aceptar");				}				resVal=0;				return;			}			//Validar Proveedor Pago			// Added 20240229			cmdQuery = "SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_pago_id & "'";			cmdQuery = cmdQuery & " and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')"; 			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("El Proveedor de Pago No Existe.","Error","Aceptar");				resVal=0;				return;			}			//Validar Referencia ... Moved Up 20240209			/*			if (refer_id &= ""){				frn.setPos("k_refer");				resVal=0;				frn.message("Es necesario seleccionar la factura del proveedor","Error","Aceptar");				return;			}			*/								//Validar kduxg			cmdQuery="SELECT count(*) as totreg from keplersc.kduxg where c1='" & sucursal_id  & "' and c2 ='" & gen_doc & "' and c3='" & proveedor_id & "' and c4='" & refer_id & "'";						//Added by JMM 20240718			cmdQuery = cmdQuery & " and (c6 <> 0 or c7 <> 0 )";						rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg > 0){				frn.message("La Referencia ya se encuentra registrada en cuentas por pagar para el mismo proveedor","Error","Aceptar");				resVal=0;				return;			}			//Validar rfc y monto total de factura correspondan a datos de UUID			/*strTotal = frn.get("k_monto");			if (strTotal &! total_uuid) {				frn.message("El importe total del Contrarecibo no corresponde al de la factura.","Error","Aceptar");				resVal=0;return;			}			if (frn.get("k_rfc") &! rfc_uuid) {				frn.message("El RFC del Contrarecibo no corresponnde al de la factura.","Error","Aceptar");				resVal=0;return;			}*/					//Validaciones POLIZA			if(frn.N("k_mov")-1==0){				frn.message("No es posible dar de alta una Poliza sin datos. Favor de verificar", "Error","&Aceptar");				resVal=0;return;			}						//commented by JMM 20240307			/*			if(RevCol("k_cuenta") == 1){						frn.message("Se ha generado el siguiente error: " & "No se especific  cuenta en la p liza" ,"Error","&Aceptar");						frn.setPos("k_mov",-1,"k_descr");resVal=0; return;			}			if(RevCol("k_cuentadesc") == 1){						frn.message("Se ha generado el siguiente error: " & "No se especific  descripci n en la p liza" ,"Error","&Aceptar");						frn.setPos("k_mov",-1,"k_descr");resVal=0;return;			}			*/									//Added by JMM 20240307 			var nreg = frn.N("k_mov")-1;//cuantos renglones hay			for(var i=0; i<nreg; i++){						var abono,cargo;								var ren_cta = trim(frn.get("k_mov",i,"k_cuenta"));				var ren_ctadscr = trim(frn.get("k_mov",i,"k_cuentadesc"));								var ren_inv = trim(frn.get("k_mov",i,"k_inventario"));				var ren_afecta = trim(frn.get("k_mov",i,"k_afecta"));								var ren_num = i + 1 ;								cargo = frn.get("k_mov",i,"k_cargo");				abono = frn.get("k_mov",i,"k_abono");								if (strlen(ren_cta) == 0){					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se ha especificado la Cuenta" ,"Error","&Aceptar");					frn.setPos("k_mov",i/*-1*/,"k_cuenta");					resVal=0;return;				}								if (strlen(ren_ctadscr) == 0){					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se ha especificado la Descripcion de la Cuenta" ,"Error","&Aceptar");					frn.setPos("k_mov",i/*-1*/,"k_cuenta");					resVal=0;return;				}								if ( strlen(cargo) > 0 && strlen(abono) > 0 ) {					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : La partida no puede ser de cargo y abono al mismo tiempo" ,"Error","&Aceptar");					frn.setPos("k_mov",i/*-1*/,"k_cargo");					resVal=0;return;				} 								if ( strlen(cargo) == 0 && strlen(abono) == 0 ) {					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se ha registrado el cargo o abono de la partida" ,"Error","&Aceptar");					frn.setPos("k_mov",i/*-1*/,"k_cargo");					resVal=0;return;				} 								if ( strlen(ren_inv) > 0 && strlen(ren_afecta) == 0 ) {					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se ha registrado la afectacion del inventario de la partida" ,"Error","&Aceptar");					frn.setPos("k_mov",i/*-1*/,"k_afecta");					resVal=0;return;				} 								if ( strlen(ren_afecta) > 0 && strlen(ren_inv) == 0 ) {					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se puede tener una afectacion sin numero de inventario en la partida" ,"Error","&Aceptar");					frn.setPos("k_mov",i/*-1*/,"k_inventario");					resVal=0;return;				} 												// Added by JMM 20240718 				var vflag = ManejaPresupuesto(i, 2); 				if ( vflag == -0.0000001 ) {					frn.setPos("k_mov",i,"k_ctopto"); 					resVal=0;return;				}				if ( vflag == 0 && strlen( frn.get("k_mov",i, "k_ctopto") ) > 0 ) { 					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : La Cuenta No Maneja Presupuesto" ,"Error","&Aceptar");					frn.setPos("k_mov",i,"k_ctopto"); 					resVal=0;return;				}				if ( vflag == 1 && strlen( frn.get("k_mov",i, "k_ctopto") ) == 0 ) { 					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : La Cuenta Maneja Presupuesto" ,"Error","&Aceptar");					frn.setPos("k_mov",i,"k_ctopto"); 					resVal=0;return;				}								// Added by JMM 20240718 				if ( vflag == 1 ) {									var vimp = PrsptoXPeriodo(i,2);					if ( vimp == -0.0000001 ) {						frn.setPos("k_mov",i,"k_ctopto");						resVal=0;return;					}					if ( vimp == 0 ) { 						frn.message("Se ha generado el siguiente error en la partida " & ren_num & "|"  						& " " & "|" & "No se ha Registrado el Presupuesto para el Concepto, dentro del periodo de la Operacion ..." ,"Error","&Aceptar");						frn.setPos("k_mov",i,"k_ctopto"); 						resVal=0;return;					}										var vejercido = PrsptoXPeriodo_Ejercido(i,2);					if ( vejercido == -0.0000001 ) {						frn.setPos("k_mov",i,"k_ctopto");						resVal=0;return;					}					if ( vejercido == -0.0000002 ) { 						frn.message("Se ha generado el siguiente error en la partida " & ren_num & "|"  						& " " & "|" & "No se pudo determinar el Presupuesto Ejercido para el Concepto ..." ,"Error","&Aceptar");						frn.setPos("k_mov",i,"k_ctopto"); 						resVal=0;return;					} else {						var vnvomonto;						vnvomonto = cargo + vejercido;						if ( strlen(cargo) > 0 ) {							if ( vnvomonto > vimp ) {								frn.message("Se ha generado el siguiente error en la partida " & ren_num & "|" & " " & "|" & 								"No puedes exceder el Presupuesto para el Concepto ... " & frn.get("k_mov", -1, "k_ctopto") & "|" & " " & "|" & 								"Presupuesto : " &vimp  & "|" & " " & "|" & 								"Monto Ejercido : " & vejercido & "|" & 								"(+) Nuevo Cargo = " & cargo & "|" & "(=) Monto Nuevo = " & vnvomonto,"Error","Aceptar");								frn.setPos("k_mov",i,"k_ctopto"); 								resVal=0;return;							}						}					}									} // End : Flag = 1 								} // End : For k_mov						// Added by JMM 20240306			subTotal=frn.get("k_subtotal");			if (subTotal <= 0){				resVal=0;				frn.message("El subtotal de la operacion no puede ser menor o igual a cero.","Error","Aceptar");				return;			}						// Conditions Added by JMM 20240208 ... Related to Implementing UUID Transaction						strTotal/*total*/=frn.get("k_monto");			if (strTotal/*total*/ <= 0){				resVal=0;				frn.message("El total de la operacion no puede ser cero.","Error","Aceptar");				return;			}							// Added by JMM 20240229, Esta condicion es para discriminar validaciones relacionadas con UUID si Chk por Comprobar esta Activado			// Commented by JMM 20240328			/*if ( frn.get("chk_pc") != 1 ) {*/						//Validar monto total del Contrarecibo correspondan al de la Factura o UUID				strTotal = frn.get("k_monto");				vdiferencia = (strTotal-total_uuid);				if (vdiferencia < 0){					vdiferencia = vdiferencia *(-1); 				}							// Adapted 20240112 ... Se Gestionara por PARAM {TBL : param_oper}				if ( vdiferencia > gapMonto /*0.1*/ ) {					resVal=0;					frn.message("El Importe Total del Contrarecibo No corresponde al de la Factura (XML) ...","Error","Aceptar");					return;				}								// End Conditions Added by JMM 20240208 ... Related to Implementing UUID Transaction													// Addded by JMM 20240402 				//Validar monto total del Contrarecibo correspondan al de la Factura o UUID				strTotal = frn.get("c_monto");				vdiferencia = (strTotal-total_uuid);				if (vdiferencia < 0){					vdiferencia = vdiferencia *(-1); 				}							// Adapted 20240112 ... Se Gestionara por PARAM {TBL : param_oper}				if ( vdiferencia > gapMonto /*0.1*/ ) {					resVal=0;					frn.message("El Importe Total del Contrarecibo No corresponde al del Documento (CxP) a Comprobar ...","Error","Aceptar");					return;				}				// End Validar Totalcontrarecibo vs DOC CxP							/* } */ // Commented by JMM 20240328																			} // End ValidarDatos()						fun RevCol(param1){				var nreg,abono,cargo,valCol,banCol;//definicion de variables				nreg = frn.N("k_mov")-1;//cuantos renglones hay				banCol = 0;				for(var i=0; i<nreg; i++){					abono = frn.get("k_mov",i,"k_cargo");					cargo = frn.get("k_mov",i,"k_abono");					if((cargo+abono) > 0){						valCol = frn.get("k_mov",i,param1);//valor de la columna (proyecto, concepto, departamento)						if(strlen(valCol) == 0){							banCol = 1;//se prende la bandera de que falta definir  proyecto, concepto o departamento en una partida 						}//fin if valor de la columna esta vacia					}//fin if la suma de cargo y abono es > a 0				}//fin for p/recorrer las partidas en el grid				return banCol;			}				//-----------------------BAJA,CONSULTA----------------------------			fun MostrarDatos(nFolio) {					var cmd,xmlRequest,xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError;			var selector; /*Added by JMM 20240514*/						sucursal_id = frn.get("k_sucn",-1,1);					// Addapted by JMM,	22401215			cmd = " select dm1.c10 as k_clave, dm1.c9 as c_fecha/*k_fecha*/, dm1.c11 as k_refer , dm1.c69 as k_hora , dm1.c18 as k_vence, dm1.c17 as k_plazo " &				", dm1.c24 as k_coment, dm1.c43 as estatus_doc , dm1.c197 as fecha_baja " ;						// Added by JMM 20240215 , UPD by JMM 20240328 			cmd = cmd & ", dm1.uuid_serie as k_uuid_serie, dm1.uuid_folio as k_uuid_folio, dm1.uuid_fecha as k_uuid_fecha, dm1.uuid_total as k_uuid_monto, dm1.uuid_impuesto as k_uuid_impuesto " &				", xd.c10 as k_rfc, xd.c3 as k_nombreprov, xd.c4 as k_calleprov, xd.c5 as k_coloniaprov, xd.c6 as k_poblacionprov, xd.c27 as k_cpprov ";						// Added by JMM, 20240306 			cmd = cmd & ", dm1.c14 as k_iva, dm1.c16 as k_monto, (dm1.c16 - coalesce(dm1.c14, 0)) as k_subtotal ";						// Added by JMM, 20240307 			cmd = cmd & ", dm1.cve_prov_pago as k_clave_pago ";						// Added by JMM, 20240405 			cmd = cmd & ", dm1.fecha_comprobacion as k_fecha, dm1.doc_refer_compl as k_docto ";						// Added by JMM, 20240514 			cmd = cmd & ", dm1.st_x_comprobar as st_compr ";					// Addapted by JMM,	20240215				cmd = cmd & " from keplersc.kdm1 dm1 inner join keplersc.kdxd xd on xd.c2 = dm1.c10 " &				"where dm1.c1='" & sucursal_id  & "' and dm1.c2='" & gen_doc  &"' and dm1.c3='" & nat_doc & "' and dm1.c4='" & gpo_doc & "' and dm1.c5='" & tip_doc & "' and dm1.c6='" & nFolio & "'";				//frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cuboResultados_Enc_Query"); // Added by JMM, 20240215 				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_Enc");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			// Condition Added by JMM, 20240215			if(nXml(cuboResultados) == 0){				frn.setPos("k_folio");				frn.message("El Documento No existe ...","Error","Aceptar");				return;				}			var xml_kdm1  = getXml(cuboResultados,"r0" );			//frn.setX(cuboResultados ); TODO, checar setX			frn.set("k_clave",getXmlAtt(xml_kdm1  ,"k_clave") );			frn.set("k_fecha",getXmlAtt(xml_kdm1 ,"k_fecha") );			frn.set("k_hora",getXmlAtt(xml_kdm1  ,"k_hora") );			frn.set("k_plazo",getXmlAtt(xml_kdm1  ,"k_plazo") );			frn.set("k_vence",getXmlAtt(xml_kdm1   ,"k_vence") );			frn.set("k_coment",getXmlAtt(xml_kdm1   ,"k_coment") );			//BuscarProveedor(); // Commented by JMM 20240215			frn.set("k_refer",getXmlAtt(xml_kdm1  ,"k_refer") );							// ----	Section Added by JMM 20240215 			frn.set("k_uuid_serie",getXmlAtt(xml_kdm1  ,"k_uuid_serie") );			frn.set("k_uuid_folio",getXmlAtt(xml_kdm1  ,"k_uuid_folio") );			frn.set("k_uuid_monto",getXmlAtt(xml_kdm1  ,"k_uuid_monto") );			frn.set("k_uuid_fecha",getXmlAtt(xml_kdm1  ,"k_uuid_fecha") );			frn.set("k_uuid_fecha",mid(frn.get("k_uuid_fecha"),0,10));			// Added by JMM 20240328 			frn.set("k_uuid_impuesto",getXmlAtt(xml_kdm1  ,"k_uuid_impuesto") );						frn.set("k_rfc",getXmlAtt(xml_kdm1  ,"k_rfc") );			frn.set("k_nombreprov",getXmlAtt(xml_kdm1  ,"k_nombreprov") );			frn.set("k_calleprov",getXmlAtt(xml_kdm1  ,"k_calleprov") );			frn.set("k_coloniaprov",getXmlAtt(xml_kdm1  ,"k_coloniaprov") );			frn.set("k_poblacionprov",getXmlAtt(xml_kdm1  ,"k_poblacionprov") );			frn.set("k_cpprov",getXmlAtt(xml_kdm1  ,"k_cpprov") );			// ----	End : Section Added by JMM 20240215 						//Added by JMM 20240306 			frn.set("k_iva",getXmlAtt(xml_kdm1,"k_iva") );			frn.set("k_monto",getXmlAtt(xml_kdm1,"k_monto") );			frn.set("k_subtotal",getXmlAtt(xml_kdm1,"k_subtotal") );						//Added by JMM 20240307 			frn.set("k_clave_pago",getXmlAtt(xml_kdm1,"k_clave_pago") );						//Added by JMM 20240307			var vProvPago = trim(frn.get("k_clave_pago"));			if ( strlen(trim(frn.get("k_clave"))) > 0 ) {				if ( strlen( vProvPago ) > 0 ) { BuscarProvPago(); }			}							//Added by JMM 20240405				frn.set("k_folio", nFolio );			frn.set("c_fecha", getXmlAtt(xml_kdm1 ,"c_fecha") );				frn.set("c_monto", getXmlAtt(xml_kdm1 ,"k_monto") );					frn.set("k_docto", getXmlAtt(xml_kdm1 ,"k_docto") );			frn.set("k_clave_oper", getXmlAtt(xml_kdm1 ,"k_clave") );			frn.set("k_rfc_oper", getXmlAtt(xml_kdm1 ,"k_rfc") );			frn.set("k_nombreprov_oper", getXmlAtt(xml_kdm1 ,"k_nombreprov") );							fecha_baja = getXmlAtt(xml_kdm1 ,"fecha_baja");						estatus_doc = getXmlAtt(xml_kdm1 , "estatus_doc");							//Added by JMM 20240514			selector = getXmlAtt(xml_kdm1 , "st_compr");						if (estatus_doc &= "C"){	// C=Cancelado				frn.message("El Contrarecibo se encuentra cancelado","Error","Aceptar");				frn.set("statusdoc", "CANCELADO");			}else{				if ( selector &= "X" ) {					frn.set("statusdoc", "Comprobado");				} else {					if ( selector &= "S" ) {						frn.set("statusdoc", "Por Comprobar");					} else {						frn.set("statusdoc", ""); /*original*/					}				}			}			rstXml(cmd);										//Condition Added by JMM 20240513 			if ( selector &= "X" ) {					//Adapted by JMM 20240308				cmd = "select c8,c9,c10,c11,c13 ,c12 ,ctopto from keplersc.kdmdocscompr where c1='" & sucursal_id & "' and c2='" & gen_doc &"' and c3='" & nat_doc & "'";				cmd = cmd & " and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";			} else {				cmd = "select c8,c9,c10,c11,c13 ,c12 ,ctopto from keplersc.kdm6 where c1='" & sucursal_id & "' and c2='" & gen_doc &"' and c3='" & nat_doc & "'";				cmd = cmd & " and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";			}						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_Det");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			totRen = nXml(cuboResultados);										for(contRen=0; contRen<totRen; contRen++){				frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c8"),"k_mov",contRen,"k_cuenta");				frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c9"),"k_mov",contRen,"k_cuentadesc");				var cargo_abono = getXmlAtt(cuboResultados, "r"&contRen ,"c10");				var monto = getXmlAtt(cuboResultados, "r"&contRen ,"c11");								if (cargo_abono &= "C"){					frn.setX(monto ,"k_mov",contRen,"k_cargo");				}else{					frn.setX(monto ,"k_mov",contRen,"k_abono");				}								frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c13"),"k_mov",contRen,"k_inventario");								frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c12"),"k_mov",contRen,"k_afecta"); // Added by JMM 20240308 								frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"ctopto"),"k_mov",contRen,"k_ctopto"); // Added by JMM 20240718						}						//Commented by JMM 20240306 ... Info se obtendra de la BD Directamente			/*			CalcTotal();			*/						ArmarRefDocto();													} //End MostrarDatos()								//-----------------REPORTE-----------							fun EjecReporte(){								var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var cuboResultados, xmlRequest,sqlXmlResultados,xmlCurDocto,xmlCurMovto,cmd,ok,mensaje;								kdb.kde("KDE");//Configuraci n del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();								kdb.readPage("datos","srv_contrarecibo_crudfto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los par metros finales de impresi n.(rep.page(...);)				rep.set("suc_desc", frn.get("k_sucn", -1, 0));				rep.set("docto",frn.get("k_docto"));				rep.set("fecha",frn.get("k_fecha"));				rep.set("rep_fecha",fechaImpresion);				rep.set("rep_hora",horaImpresion);				rep.set("k_clave",frn.get("k_clave"));				rep.set("k_nombreprov",frn.get("k_nombreprov"));				rep.set("k_calleprov",frn.get("k_calleprov"));				rep.set("k_coloniaprov",frn.get("k_coloniaprov"));				rep.set("k_poblacionprov",frn.get("k_poblacionprov"));				rep.set("k_cpprov",frn.get("k_cpprov"));				rep.set("k_rfc",frn.get("k_rfc"));				rep.set("referencia",frn.get("k_refer"));				rep.set("k_monto",frn.get("k_monto"));								//TODO				rep.set("cantidad_en_letra",strFormat("number",frn.get("k_monto"),0));				rep.exe("encabezado");				rep.exe("tit_reporte");				rep.exe("encabezadoColumnas");				rep.exe("linea_encabezados");				//Procesa poliza contable				var tablakdc1_alta = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;				var tablakdc2_alta = " keplersc.kdc2" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) & strSplit(frn.get("k_fecha"), "-", 1);				var tablakdc1_baja = " keplersc.kdc1" & mid(strSplit(fecha_baja, "-", 0), 2,2) ;				var tablakdc2_baja = " keplersc.kdc2" & mid(strSplit(fecha_baja, "-", 0), 2,2) & strSplit(fecha_baja, "-", 1);				var tipo = ""; var nPolAlta = "" ;				if (tablakdc2_baja &= tablakdc2_alta ){					tipo = "Misma_tabla";										cmd= " select c1 as num_pol from " & tablakdc2_alta & " where c14='" & sucursal_id  & "' and c15='" & gen_doc & "' and c16= '" & nat_doc & "'" ;					cmd = cmd & " and c17='" & gpo_doc & "' and c18='" & tip_doc & "' and c19='" & frn.get("k_folio")& "'";									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.GenerarReporte()");					frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");									ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}									nPolAlta =getXmlAtt(cuboResultados,"r0", "num_pol" );								}				imprime_poliza(tablakdc1_alta , tablakdc2_alta, "Alta", tipo, nPolAlta);								if (estatus_doc &= "C" && fecha_baja &! "1800-01-01" && fecha_baja &! "" ){					imprime_poliza(tablakdc1_baja , tablakdc2_baja, "Baja", tipo, nPolAlta);				}								rep.set("desc_notas",frn.get("k_coment"));				rep.exe("notastitulos");				rep.exe("extras");				rep.win();									}									fun imprime_poliza(tablakdc1 , tablakdc2, operacion, tipo, nPolAlta ){							var cmd, cuboResultados , ok;								//Procesa poliza contable				cmd= " select kc2.c1 as num_pol, kc2.c3 as cuenta, kc2.c4 as tipo_asiento, kc2.c5 as monto, kc1.c2 as desc_pol, kc2.c7 as refer, kc2.c8 as tipo_pol from " & tablakdc2 & " as kc2 " ;				cmd = cmd & " inner join " & tablakdc1 & " as kc1 on kc1.c1=kc2.c3 ";				cmd = cmd & " where kc2.c14='" & frn.get("k_sucn", -1, 1) & "' and kc2.c15='" & gen_doc & "' and kc2.c16= '" & nat_doc & "' and kc2.c17='" & gpo_doc & "' and kc2.c18='" & tip_doc & "' and kc2.c19='" & frn.get("k_folio")& "'";				if (operacion &= "Alta" && tipo &= "Misma_tabla"){					cmd = cmd & " and kc2.c1 = " & nPolAlta ; 				}				if (operacion &= "Baja" && tipo &= "Misma_tabla"){					cmd = cmd & " and kc2.c1 <> " & nPolAlta ; 				}  				//Added by JMM 20240325				cmd = cmd & " order by kc2.c1, kc2.c10 "; 				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.imprime_poliza()");				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var nRenPol= nXml(cuboResultados);				var tPoliza=getXmlAtt(cuboResultados,"r0", "tipo_pol" );				var nPoliza=getXmlAtt(cuboResultados,"r0", "num_pol" );								if (strlen(tPoliza)>0 && strlen(nPoliza)>0 ){						rep.set("tPol",tPoliza);						rep.set("nPol",nPoliza);						rep.exe("encabezadoPol");						var tAbonosPol=0, tCargosPol=0;						for(var i=0;i<nRenPol;i++){							if (getXmlAtt(cuboResultados,"r"&i, "tipo_asiento" )&= "A"){								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave2",cuenta );								rep.set("PolDescr2",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolHaber",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tAbonosPol=tAbonosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								pol_saldo_presupuesto(cuenta);								rep.set("PolSaldo2",saldo);								rep.set("PolPresupuesto2",presupuesto );								rep.exe("partPolA");							}else{								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave",cuenta );								rep.set("PolDescr",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolDebe",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tCargosPol=tCargosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								pol_saldo_presupuesto(cuenta);								rep.set("PolSaldo",saldo );								rep.set("PolPresupuesto",presupuesto );								rep.exe("partPolC");							}						}						rep.set("totCargo",tCargosPol);						rep.set("totAbono",tAbonosPol);						rep.exe("PolTotales");				}			}						fun pol_saldo_presupuesto(cuenta){						var cmd, cuboResultados , ok, mensajeError  ;								var mes = strSplit(frn.get("k_fecha"), "-", 1);				tabla = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2);								var col_cargos = 26 + mes;				var col_abonos = 62 + mes;				var col_presupuesto= 38 + mes;				 				cmd= " select c" & col_cargos & " as cargos ,c" & col_abonos & " as abonos ,c" & col_presupuesto & " as pres from " & tabla & " where c1='" & cuenta & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.pol_saldo_presupuesto()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				var cargos = getXmlAtt(cuboResultados,"r0", "cargos" );				var abonos = getXmlAtt(cuboResultados,"r0", "abonos" );				presupuesto = getXmlAtt(cuboResultados,"r0", "pres" );				saldo = cargos - abonos;			}									// Function Added by JMM, 20240215			fun CambiaFolio() {				frn.set("k_docto", "");								// Commented by JMM 20240331				/*				frn.set("k_fecha", "");				frn.set("k_hora", "");				*/								// Commented by JMM 20240131				/*				LimpiaDatosProv();				frn.set("k_clave", "");				*/								// Added by JMM 20240131				limpiar_datos_uuid();				//frn.set("k_refer", ""); // Added & Commented 20240131 by JMM								//Added by JMM 20240331				frn.set("c_fecha", "");				frn.set("c_monto", "");				//Added by JMM 20240401					frn.setAtt("Buscar", "visible", "N");				frn.setAtt("Buscar", "available", "N");				frn.setAtt("k_clave_pago", "available", "N");				frn.set("k_clave_pago","");				frn.set("k_nombreprov_pago","");								//Added by JMM 20240402				frn.set("k_plazo", "");				frn.set("k_vence", "");				frn.rst("k_mov");				frn.setAtt("k_mov", "modify", "N");				frn.setAtt("k_mov", "available", "N");				//Added by JMM 20240403				frn.set("k_coment", "");							}						fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;								if ( strlen( frn.get("k_clave_oper") ) == 0 || strlen( frn.get("k_rfc_oper") ) == 0 ) {					frn.set("k_folio", "");					frn.message("Debes seleccionar primero un Proveedor de Documento valido ...", "Error","Aceptar");					return;				}								CambiaFolio(); // Added by JMM, 20240215								setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcontrareciboconvert.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);			}									// fun commented by JMM 20240206			/*			fun plazo() {				var plazo = frn.get("k_plazo");				frn.set("k_vence", fnDate("add",frn.get("k_vence"), plazo)  );			}				*/						fun IniParams(){//Inicializa par metros de impresi n, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar P gina				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}			fun setRepPage() {//Establece los par metros finales de impresi n.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}							} // End of class Main	</script></pag>