"/><br/><tab/>			<txt>Ap Paterno:  </txt><tab n="2"/><sp/>			<inp id="ap_paterno_usuario" dim="70,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="capital" nc="50" tooltip="Apellido Paterno"/><br/><tab/>			<txt>Ap Materno: </txt><tab n="2"/><sp/>			<inp id="ap_materno_usuario" dim="70,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="capital" nc="50" tooltip="Apellido Materno"/><br/><tab/>			<txt>RFC: </txt><tab n="4"/><sp/>			<inp id="rfc_usuario" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="capital" nc="13" tooltip="RFC"/><tab n="6"/>			<txt>Tel&#233;fono:  </txt><tab n="2"/>			<inp id="tel_usuario" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="number" nc="10" fmt="5" tooltip="Tel&#233;fono"/><br/><tab/>			<txt>e-mail: </txt><tab n="3"/><sp/>			<inp id="correo_usuario" dim="70,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="capital" nc="60" tooltip="e-mail"/><br/><tab/>			<txt>Medio Preferido: </txt><sp n="2"/>			<inp id="medio_pref_usuario" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" OnF9="ObtenerMedPrefUsu()" OnChange="BuscarMedPrefUsu()" type="capital" nc="5" tooltip="Clave Medio Preferido de Contacto"/><sp/>			<inp id="k_desc_medio_pref_usuario" dim="23,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" available="Y" type="capital" tooltip="Medio Preferido de Contacto" modify="N"/>			<sp/><txt>Num. Medio Peferido:</txt>			<inp id="tel_mediopref_usuario" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="number" nc="10" fmt="5" tooltip="Tel&#233;fono Medio Preferido de Contacto"/>			<br/><br/><tab n="9"/>			<txt fnt=",b">Contacto Responsable de Mantenimiento</txt><tab n="2"/>			<txt fnt=",b">( Mismo: </txt>			<inp id="mismo" dim="2,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="capital" nc="1" OnChange="RepiteMismo()" tooltip="Mismo S/N"/>			<txt> )</txt>			<br/><tab/>			<txt>Nombre: </txt><tab n="3"/><sp/>			<inp id="nombre_autoriza" dim="70,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="capital" nc="90" tooltip="Nombre"/><br/><tab/>			<txt>Ap Paterno: </txt><tab n="2"/><sp/>			<inp id="ap_paterno_autoriza" dim="70,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="capital" nc="50" tooltip="Apellido Paterno"/><br/><tab/>			<txt>Ap Materno: </txt><tab n="2"/><sp/>			<inp id="ap_materno_autoriza" dim="70,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="capital" nc="50" tooltip="Apellido Materno"/><br/><tab/>			<txt>RFC: </txt><tab n="4"/><sp/>			<inp id="rfc_autoriza" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="capital" nc="13" tooltip="RFC"/><tab n="6"/>			<txt>Tel&#233;fono:  </txt><tab n="2"/>			<inp id="tel_autoriza" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="number" nc="10" fmt="5" tooltip="Tel&#233;fono"/><br/><tab/>			<txt>e-mail: </txt><tab n="3"/><sp/>			<inp id="correo_autoriza" dim="70,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="capital" nc="60" tooltip="e-mail"/><br/><tab/>			<txt>Medio Preferido: </txt><sp n="2"/>			<inp id="medio_pref_autoriza" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" OnF9="ObtenerMedPrefAut()" OnChange="BuscarMedPrefAut()" type="capital" nc="5" tooltip="Medio Preferido de Contacto"/><sp/>			<inp id="k_desc_medio_pref_autoriza" dim="23,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" available="Y" type="capital" tooltip="Medio Preferido de Contacto" modify="N"/>			<sp/><txt>Num. Medio Peferido:</txt>			<inp id="tel_mediopref_autoriza" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="number" nc="10" fmt="5" tooltip="Tel&#233;fono Medio Preferido de Contacto"/>			<br/><tab/>									<br/><inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/>            <tab n="11"/><bot id="btn_aceptar" dim="10,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="0" visible="Y" available="Y"/>			<tab n="2"/><bot id="btn_cancelar" dim="10,0" brdr="5" text="Cancelar" OnEnter="Cancelar()" default="0" visible="Y" available="Y"/>					</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP, accion,externo,serie, resVal,valkodawari,straccion,origen;			var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError,cmd;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();				Inicializa();	                ctlrs_off();				cargarDatos();				ctlrs_opcion();			}						fun Inicializa(){				frn.rst("grupo_crud");				accion = strFormat("ucase",frn.param(0));				externo	= frn.param(2);				origen = frn.param(4);				frn.set("input_crud", accion);				if (accion &= "NUEVO"){                    straccion = "Nuevo" ;                   }else if (accion &= "CONSULTAR"){                    straccion = "Consultar";                }else if (accion &= "MODIFICAR"){                    straccion = "Modificar";                }else if (accion &= "ELIMINAR"){                    straccion = "Eliminar";                }     				frn.setAtt("grupo_crud", "tit", straccion);				if (accion &= "MODIFICAR"){					frn.setAtt("input_kilometraje", "available", "N" );					//llamada externa(padre)					if (externo &= "s"){						serie =frP.get(frn.param(3));						if (serie &= ""){										frn.message("Debe especificar una serie","Error","Aceptar");							return;						}					}else {						serie = frn.param(1);					}				}					if (accion &= "ELIMINAR" || accion &= "CONSULTAR" ){					serie = frn.param(1);					}			         }						fun ctlrs_off(){				frn.setAtt("input_serie", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );				frn.setAtt("btn_cancelar", "visible", "N" );							}         fun ctlrs_opcion(){				if (accion &= "NUEVO"){                    frn.setPos("input_serie");					frn.setAtt("input_serie","available","Y");					frn.setAtt("input_serie", "modify", "Y" );				    frn.set("k_titulo","Catálogo de Series");                    frn.setAtt("grupo_crud", "available","Y");					frn.setAtt("grupo_crud", "modify","Y");					frn.setAtt("k_desc_marca", "modify","N");					frn.setAtt("k_desc_modelo", "modify","N");					frn.setAtt("k_nombre_contacto", "modify","N");					frn.setAtt("k_desc_concesionario", "modify","N");					frn.setAtt("k_desc_cond_unidad", "modify","N");					frn.setAtt("subcond_unidad", "modify","N");					frn.setAtt("k_desc_subcond_unidad", "modify","N");					frn.setAtt("k_desc_medio_pref_usuario", "modify","N");					frn.setAtt("k_desc_medio_pref_autoriza", "modify","N");						frn.setAtt("fec_expgarantia", "available","N");						frn.setAtt("aseg_garantext", "available","N");						frn.setAtt("poliza_garantext", "available","N");					frn.setAtt("fec_vigseguro", "available","N");						frn.setAtt("aseg_segvehicular", "available","N");						frn.setAtt("poliza_segvehicular", "available","N");					frn.setAtt("text_desc_veh", "visible","S");					frn.setAtt("desc_modelo", "visible","S");					obtieneKodawari();					if (valkodawari &= "S"){						frn.set("cod_planta_id","Código Katashiki:");						frn.setAtt("input_fec_dofu", "available","Y");						frn.setAtt("cond_unidad", "available","Y");						frn.setAtt("garantia_ext", "available","Y");						frn.setAtt("segvehicular", "available","Y");										} else{						frn.set("cod_planta_id","Código Planta:");						frn.setAtt("input_fec_dofu", "available","N");						frn.setAtt("cond_unidad", "available","N");						frn.setAtt("garantia_ext", "available","N");						frn.setAtt("segvehicular", "available","N");					}					}else { 					if (accion &= "MODIFICAR") {                        frn.setAtt("grupo_crud", "available","Y");						frn.setAtt("grupo_crud", "modify","Y");		                frn.setAtt("input_serie", "modify", "N" );						frn.setAtt("input_serie", "available", "Y" );						frn.setAtt("input_kilometraje", "modify","N");						frn.setAtt("k_desc_marca", "modify","N");						frn.setAtt("k_desc_modelo", "modify","N");						frn.setAtt("k_nombre_contacto", "modify","N");						frn.setAtt("k_desc_concesionario", "modify","N");						frn.setAtt("k_desc_cond_unidad", "modify","N");						if (frn.get("cond_unidad") ==2){							frn.setAtt("subcond_unidad", "available","Y");							frn.setAtt("subcond_unidad", "modify","Y");						} else {								frn.setAtt("subcond_unidad", "available","N");							frn.setAtt("subcond_unidad", "modify","N");						}						frn.setAtt("k_desc_subcond_unidad", "modify","N");						frn.setAtt("k_desc_medio_pref_usuario", "modify","N");						frn.setAtt("k_desc_medio_pref_autoriza", "modify","N");						if (frn.get("garantia_ext") &="S"){							frn.setAtt("fec_expgarantia", "available","Y");								frn.setAtt("aseg_garantext", "available","Y");								frn.setAtt("poliza_garantext", "available","Y");							frn.setAtt("fec_expgarantia", "modify","Y");								frn.setAtt("aseg_garantext", "modify","Y");								frn.setAtt("poliza_garantext", "modify","Y");						} else {							frn.setAtt("fec_expgarantia", "modify","N");								frn.setAtt("aseg_garantext", "modify","N");								frn.setAtt("poliza_garantext", "modify","N");						}						if (frn.get("segvehicular") &="S"){							frn.setAtt("fec_vigseguro", "available","Y");								frn.setAtt("aseg_segvehicular", "available","Y");								frn.setAtt("poliza_segvehicular", "available","Y");							frn.setAtt("fec_vigseguro", "modify","Y");								frn.setAtt("aseg_segvehicular", "modify","Y");								frn.setAtt("poliza_segvehicular", "modify","Y");						} else {							frn.setAtt("fec_vigseguro", "modify","N");								frn.setAtt("aseg_segvehicular", "modify","N");								frn.setAtt("poliza_segvehicular", "modify","N");						}						frn.setAtt("text_desc_veh", "visible","N");						frn.setAtt("desc_modelo", "visible","N");						obtieneKodawari();												if (valkodawari &= "S" && frn.get("input_marca") &= "TOY"){							frn.set("cod_planta_id","Código Katashiki:");														frn.setAtt("input_fec_dofu", "available","Y");							frn.setAtt("cond_unidad", "available","Y");							frn.setAtt("garantia_ext", "available","Y");							frn.setAtt("segvehicular", "available","Y");																		} else{							frn.set("cod_planta_id","Código Planta:");														frn.setAtt("input_fec_dofu", "available","N");							frn.setAtt("cond_unidad", "available","N");							frn.setAtt("garantia_ext", "available","N");							frn.setAtt("segvehicular", "available","N");													}	                    }else{						frn.setAtt("grupo_crud", "available","Y");						frn.setAtt("grupo_crud", "modify","N");                        frn.setAtt("btn_aceptar", "visible", "N" );						frn.setAtt("text_desc_veh", "visible","N");						frn.setAtt("desc_modelo", "visible","N");                    }									}				if (accion &! "CONSULTAR"){					frn.setAtt("btn_aceptar", "available", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );					frn.setAtt("btn_cancelar", "visible", "Y" );					frn.setAtt("btn_cancelar", "available", "Y" );				}            }							fun cargarDatos(){																		if (accion &! "NUEVO") {				    var campos = "ma.c1 as input_marca,ma.c2 as k_desc_marca,mo.c2 as input_modelo, mo.c3 as k_desc_modelo,s.c4 as input_serie,s.c5 as input_motor,s.c6 as input_transmision," &                                "s.c7 as input_eje_trasero,s.c8 as input_placas,s.c9 as input_contacto,s.c16 as k_nombre_contacto,s.c10 as input_color,s.c11 as input_anio,s.c12 as input_kilometraje," &                                "s.c13 as input_fecha_venta,co.c1 as input_concesionario,co.c2 as k_desc_concesionario,s.c15 as input_ult_visita,s.c17 as input_codigo_planta,s.c18 as input_version," &                                "s.c19 as input_fec_dofu,s.c20 as nombre_usuario,s.c21 as tel_usuario,s.c22 as nombre_autoriza,s.c23 as tel_autoriza,s.c24 as ap_paterno_usuario,s.c25 as ap_materno_usuario," &								"s.c26 as correo_usuario,s.c27 as ap_paterno_autoriza,s.c28 as ap_materno_autoriza,s.c29 as correo_autoriza,s.c30 as rfc_usuario,s.c31 as rfc_autoriza,s.c32 as medio_pref_usuario," &								"mpu.c2 as k_desc_medio_pref_usuario,s.c33 as tel_mediopref_usuario,s.c34 as medio_pref_autoriza,mpa.c2 as k_desc_medio_pref_autoriza,s.c35 as tel_mediopref_autoriza," &								"s.c36 as cond_unidad,cu.c2 as k_desc_cond_unidad,s.c37 as subcond_unidad,scu.c3 as k_desc_subcond_unidad,s.c38 as garantia_ext,s.c39 as fec_expgarantia," &								"s.c40 as segvehicular,s.c41 as fec_vigseguro,s.c42 as aseg_garantext,s.c43 as poliza_garantext,s.c44 as aseg_segvehicular,s.c45 as poliza_segvehicular";								cmd="select " & campos & 						" from keplersc.kdserie as s 						  left outer join keplersc.kdmarcas as ma on ma.c1=s.c2 						  left outer join keplersc.kdmodelos as mo on mo.c2=s.c3 						  left outer join keplersc.kdconc as co on co.c1=s.c14 						  left outer join keplersc.kdsercontpref as mpu on mpu.c1=s.c32						  left outer join keplersc.kdsercontpref as mpa on mpa.c1=s.c34						  left outer join keplersc.kdconduni as cu on cu.c1=s.c36						  left outer join keplersc.kdsubconduni as scu on scu.c1=s.c37 and scu.c2=s.c36						  where s.c4 ='" & serie & "'"; 					                    cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_series_crud.cargarDatos()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}						rstXml(xmlRequest);					xmlRequest=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboResultados,"r0");					frn.setX(xmlRequest);					var len_result = nXml(cuboResultados);									if (len_result == 0) {						frn.message("El No. serie no existe","Error","Aceptar");						return;					}                    /*	No veo donde esta validacion en k75 y me base en vin_crud 					var fecha_venta = "2001-01-01";        //Revisar esta validacion					if (frn.get("input_fecha_venta") &! fecha_venta){						frn.set("input_fecha_venta",fecha_venta);					}                    var ult_visita = "2001-01-01";					if (frn.get("input_ult_visita") &! ult_visita){						frn.set("input_ult_visita",ult_visita );					}					*/				}							}						fun validaDatoVacio(dato,msg){				if (frn.get(dato) &= ""){					resVal= 0;					frn.setPos(dato);					frn.message("El dato no puede estar vacío. Debe especificar " & msg","Error","Aceptar");					return;				}			}			fun ValidarDatos(){				validaDatoVacio("input_marca","una marca");				validaDatoVacio("input_modelo","un modelo");				validaDatoVacio("input_contacto","un contacto");				validaDatoVacio("input_color","el color");				validaDatoVacio("input_anio","el año");				if (strlen(frn.get("input_serie")) != 17){					resVal= 0;					frn.setPos("input_serie");					frn.message("La serie debe ser de 17 dígitos","Error","Aceptar");					return;				}				if (frn.get("input_fecha_venta") &= ""){					resVal= 0;					frn.setPos("input_fecha_venta");					frn.message("Debe ingresar la fecha de venta del vehículo","Error","Aceptar");					return;				}				if (origen &!"Bienvenida"){		//Si el llamado es por pantalla de bienvenida no valida Kodawri					validaKodawari();				}							}			fun obtieneKodawari(){				cmd = " select c9 as valkodawari from keplersc.kdconftaller";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_serie_crud.validakodawari()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				valkodawari = getXmlAtt(cubo,"r0","valkodawari");			}						fun validaKodawari(){				obtieneKodawari();                if (valkodawari &= "S" && frn.get("input_marca") &= "TOY"){					if (frn.get("input_codigo_planta") &= ""){						resVal= 0;						frn.setPos("input_codigo_planta");						frn.message("Debe ingresar el código Katashiki del vehículo","Error","Aceptar");						return;					}					if (frn.get("input_fec_dofu") &= ""){						resVal= 0;						frn.setPos("input_fec_dofu");						frn.message("Debe ingresar la fecha DOFU del vehiculo","Error","Aceptar");						return;					}					if (frn.get("cond_unidad") == 0){						resVal= 0;						frn.setPos("cond_unidad");						frn.message("Debe ingresar la condición del vehículo","Error","Aceptar");						return;					} else{ 						if (frn.get("cond_unidad") == 2 && frn.get("subcond_unidad") == 0) {							resVal= 0;							frn.setPos("subcond_unidad");							frn.message("Debe ingresar la sub-condición del vehículo","Error","Aceptar");							return;						}						}					if (frn.get("garantia_ext") &= ""){						resVal= 0;						frn.setPos("garantia_ext");						frn.message("Debe ingresar el estado de la Garantia extendida S/N","Error","Aceptar");						return;					}					if (frn.get("segvehicular") &= ""){						resVal= 0;						frn.setPos("segvehicular");						frn.message("Debe ingresar el estado del Seguro Vehicular S/N","Error","Aceptar");						return;					}				}					}			fun Cancelar(){				frn.exit();			}			fun Execute() {				resVal = 1;				ValidarDatos();				if(ok &! "1" || resVal == 0){					return;				}				var resultado_confirmacion = frn.message("¿Estas seguro?","Mensaje de Confirmacion", 2);									if (resultado_confirmacion &! 1)  {					return;				}													xmlRequest = getXml(frn.dataPag()); 				setXml(xmlRequest,"origen",origen);				frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmd="SELECT * FROM keplersc.cat_series_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";					cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"cat_series_crud.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");													var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;						}												if (accion &= "NUEVO" || accion &= "MODIFICAR") {									serie = frn.get("input_serie");										if (externo &= "n"){						var marca_nueva= frn.get("input_marca");						var modelo_nuevo= frn.get("input_modelo");						var color_nuevo= frn.get("input_color");						var anio_nuevo = frn.get("input_anio");						var placas_nuevo = frn.get("input_placas");						var contacto_nuevo = frn.get("input_contacto");										frP.setX(serie ,"results",-1,"serie"); 						frP.scriptElm("tabla","OnChange","serie");												frP.setX(marca_nueva,"results",-1,"marca"); 						frP.scriptElm("tabla","OnChange","marca");													frP.setX(modelo_nuevo,"results",-1,"modelo"); 						frP.scriptElm("tabla","OnChange","modelo");													frP.setX(color_nuevo,"results",-1,"color"); 						frP.scriptElm("tabla","OnChange","color");													frP.setX(anio_nuevo ,"results",-1,"año"); 						frP.scriptElm("tabla","OnChange","año");							frP.setX(placas_nuevo ,"results",-1,"placas"); 						frP.scriptElm("tabla","OnChange","placas");						frP.setX(contacto_nuevo ,"results",-1,"contacto"); 						frP.scriptElm("tabla","OnChange","contacto");							}else {																frP.set(frn.param(3),serie ); 						frP.scriptElm(frn.param(3),"OnChange");					}										var sms =  "";										if (accion &= "NUEVO"){						sms = "VIN registrado";					}else {						sms = "VIN modificado";					}											frn.message(sms ,"Mensaje","Aceptar");					frn.exit();										}								if (accion &= "ELIMINAR"){										frP.setX("","tabla",-1,"serie"); 					frP.scriptElm("tabla","OnChange","serie");										frP.setX("","tabla",-1,"marca"); 					frP.scriptElm("tabla","OnChange","marca");												frP.setX("","tabla",-1,"modelo"); 					frP.scriptElm("tabla","OnChange","modelo");												frP.setX("","tabla",-1,"color"); 					frP.scriptElm("tabla","OnChange","color");												frP.setX("","tabla",-1,"año"); 					frP.scriptElm("tabla","OnChange","año");											frn.message("VIN eliminado","Mensaje","Aceptar");					frn.exit();									}			}									fun llenar_cmb(cuboResultados, cmb){				var len_cubo = nXml(cuboResultados);				var pos_ini = frn.N(cmb);								for (var cont=0; cont<len_cubo ; cont++){					var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);				}				}			fun ValidaSerie(){				var suc_usuario,strTmp,cubo_serie,xmlRes;				suc_usuario = frn.lib("libKepler","UserInfo(1)");				if (strlen(frn.get("input_serie")) != 17){					frn.setPos("input_serie");					frn.message("La serie debe ser de 17 dígitos","Error","Aceptar");					return;				} else {					//Precarga datos de la serie					rstXml(xmlRequest);					setXml(xmlRequest,"document","serie",frn.get("input_serie"));					//setXml(xmlRequest,"document","clave_cliente",frn.get("clave_cliente"));					//setXml(xmlRequest,"document","inventario",frn.get("inventario"));					setXml(xmlRequest,"document","k_sucn","r1",suc_usuario);										limpia_datos();										frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");												cmd="select * from keplersc.cat_precarga_serie('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";					frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdpreserie");					rstXml(cubo);					cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_serie_crud.ValidaSerie()");										frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubopreserie");										ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					strTmp = getXmlAtt(cubo,"r0","cat_precarga_serie");					strTmp = delScpScn(strTmp);					setXmlStr(cubo_serie,strTmp);									frn.lib("libGeneral.kpl","FileSave",cubo_serie,"C:\Basura\cubo_serie");								xmlRes= getXmlX(cubo_serie,3,0);					frn.lib("libGeneral.kpl","FileSave",xmlRes,"C:\Basura\xmlRes");					frn.setX(xmlRes);				}			}			fun limpia_datos(){				frn.set("input_marca","");				frn.set("k_desc_marca","");				frn.set("desc_modelo","");				frn.set("input_anio","");				frn.set("input_color","");				frn.set("input_motor","");				frn.set("input_transmision","");				frn.set("input_fecha_venta","");				frn.set("input_concesionario","");				frn.set("k_desc_concesionario","");				frn.set("input_contacto","");				frn.set("k_nombre_contacto","");				frn.set("input_kilometraje","");				frn.set("input_placas","");				frn.set("input_version","");				frn.set("input_codigo_planta","");				frn.set("garantia_ext","");				frn.set("segvehicular","");			}					fun Validar_cliente(){				var clave_cli = frn.get("input_contacto");				cmd = "select c3 as nombre from keplersc.kdud where c2='" & clave_cli & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_series_crud.Validar_cliente()");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var len_result = nXml(cubo);								if (len_result == 0 && clave_cli &! "") {					frn.message("Contacto no existe","Error","Aceptar");                    frn.setPos("input_contacto");					frn.rst("input_contacto");					return;                 } else{				    frn.set("k_nombre_contacto",getXmlAtt(cubo,"r0","nombre"));	        				}					}			fun RepiteMismo(){				ValidaSoNMismo();				if (frn.get("mismo") &= "S"){					frn.set("nombre_autoriza",frn.get("nombre_usuario"));					frn.set("ap_paterno_autoriza",frn.get("ap_paterno_usuario"));					frn.set("ap_materno_autoriza",frn.get("ap_materno_usuario"));					frn.set("rfc_autoriza",frn.get("rfc_usuario"));					frn.set("tel_autoriza",frn.get("tel_usuario"));					frn.set("correo_autoriza",frn.get("correo_usuario"));					frn.set("medio_pref_autoriza",frn.get("medio_pref_usuario"));					frn.set("k_desc_medio_pref_autoriza",frn.get("k_desc_medio_pref_usuario"));					frn.set("tel_mediopref_autoriza",frn.get("tel_mediopref_usuario"));				} else {					frn.set("nombre_autoriza","");					frn.set("ap_paterno_autoriza","");					frn.set("ap_materno_autoriza","");					frn.set("rfc_autoriza","");					frn.set("tel_autoriza","");					frn.set("correo_autoriza","");					frn.set("medio_pref_autoriza","");					frn.set("k_desc_medio_pref_autoriza","");					frn.set("tel_mediopref_autoriza","");				}			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;							frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}			fun ObtenerMarca(){ 				cmdQuery = "select c1 as clave, c2 as marca from keplersc.kdmarcas";				ObtenerDato(cmdQuery,"input_marca","Marca");  			}			fun BuscarMarca(){				var marca_id;				marca_id=frn.get("input_marca");				cmdQuery = "select c2 as descripcion from keplersc.kdmarcas " &						"where c1='" & marca_id & "'";				BuscarDato(cmdQuery,"input_marca","k_desc_marca","La marca");				ctlrs_opcion();				}			fun ObtenerModelo(){				var marca_id;				marca_id=frn.get("input_marca"); 				if (marca_id &=""){					frn.setPos("input_marca");					frn.message("Debe seleccionar una marca","Error","Aceptar");					return;				}                   cmdQuery = "select c2 as clave, c3 as modelo from keplersc.kdmodelos " &									"where c1='" & marca_id & "'";			                frn.dialog("genlistafiltrosel","Modelos",cmdQuery,"clave","input_modelo","0","0","N","S");						   			}			fun BuscarModelo(){				var marca_id, modelo_id;				marca_id=frn.get("input_marca");				modelo_id=frn.get("input_modelo");				if (marca_id &=""){					frn.setPos("input_marca");					frn.message("Debe seleccionar una marca","Error","Aceptar");					return;				}					cmdQuery = "select c3 as descripcion from keplersc.kdmodelos " &						"where c1='" & marca_id & "' and c2='" & modelo_id & "'";				BuscarDato(cmdQuery,"input_modelo","k_desc_modelo","El modelo");				}			fun ObtenerAnio(){ 				cmdQuery = "select c2 as descripcion,c1 as clave from keplersc.kdanio";				ObtenerDato(cmdQuery,"input_anio","Año");  			}			fun BuscarAnio(){				var anio_id;				anio_id=frn.get("input_anio");				cmdQuery = "select c2 as descripcion from keplersc.kdanio " &						"where c1='" & anio_id & "'";				BuscarDato(cmdQuery,"input_anio","input_anio","El año");			}			fun ObtenerConcesionario(){ 				cmdQuery = "select c1 as clave, c2 as descripcion from keplersc.kdconc";				ObtenerDato(cmdQuery,"input_concesionario","Concesionario");  			}			fun BuscarConcesionario(){				var concesionario_id;				concesionario_id=frn.get("input_concesionario");				cmdQuery = "select c2 as descripcion from keplersc.kdconc " &						"where c1='" & concesionario_id & "'";				BuscarDato(cmdQuery,"input_concesionario","k_desc_concesionario","El concesionario");			}			fun ObtenerCondUnidad(){ 				cmdQuery = "select c1 as clave, c2 as descripcion from keplersc.kdconduni";				ObtenerDato(cmdQuery,"cond_unidad","Condición de Unidad");  			}			fun BuscarCondUnidad(){				var cond_unidad_id;				cond_unidad_id=frn.get("cond_unidad");				cmdQuery = "select c2 as descripcion from keplersc.kdconduni " &						"where c1='" & cond_unidad_id & "'";				BuscarDato(cmdQuery,"cond_unidad","k_desc_cond_unidad","La condición de unidad");				if (cond_unidad_id == 2){					frn.setAtt("subcond_unidad", "available","Y");					frn.setAtt("subcond_unidad", "modify","Y");				}				if (cond_unidad_id == 1){					frn.set("subcond_unidad",0);					frn.set("k_desc_subcond_unidad","");					frn.setAtt("subcond_unidad", "available","N");					frn.setAtt("subcond_unidad", "modify","N");				}			}			fun ObtenerSubCondUnidad(){ 				var conduni_id;				conduni_id=frn.get("cond_unidad"); 				if (conduni_id !=2){					frn.setPos("cond_unidad");					frn.message("Subcondición sólo para Condición Inactivos|Debe seleccionar la condición Inactivos","Error","Aceptar");					return;				}				cmdQuery = "select c1 as clave, c3 as descripcion from keplersc.kdsubconduni where c2='" &conduni_id & "'";				ObtenerDato(cmdQuery,"subcond_unidad","Sub-Condición de Unidad");  			}			fun BuscarSubCondUnidad(){				var subcond_unidad_id, conduni_id;				conduni_id=frn.get("cond_unidad");				subcond_unidad_id=frn.get("subcond_unidad");				if (conduni_id =="" || conduni_id ==0){					frn.setPos("cond_unidad");					frn.message("Debe seleccionar una condición de unidad","Error","Aceptar");					return;				}									cmdQuery = "select c3 as descripcion from keplersc.kdsubconduni " &						"where c1='" & subcond_unidad_id & "' and c2='" & conduni_id & "'";				BuscarDato(cmdQuery,"subcond_unidad","k_desc_subcond_unidad","La sub-condición de unidad");			}			fun ObtenerMedPrefUsu(){ 				cmdQuery = "select c1 as clave, c2 as descripcion from keplersc.kdsercontpref";				ObtenerDato(cmdQuery,"medio_pref_usuario","Medio Preferido de Contacto");  			}			fun BuscarMedPrefUsu(){				var medio_pref_usuario_id;				medio_pref_usuario_id=frn.get("medio_pref_usuario");				cmdQuery = "select c2 as descripcion from keplersc.kdsercontpref " &						"where c1='" & medio_pref_usuario_id & "'";				BuscarDato(cmdQuery,"medio_pref_usuario","k_desc_medio_pref_usuario","El medio preferido de contacto");			}			fun ObtenerMedPrefAut(){ 				cmdQuery = "select c1 as clave, c2 as descripcion from keplersc.kdsercontpref";				ObtenerDato(cmdQuery,"medio_pref_autoriza","Medio Preferido de Contacto"); 			}			fun BuscarMedPrefAut(){				var medio_pref_autoriza_id;				medio_pref_autoriza_id=frn.get("medio_pref_autoriza");				cmdQuery = "select c2 as descripcion from keplersc.kdsercontpref " &						"where c1='" & medio_pref_autoriza_id & "'";				BuscarDato(cmdQuery,"medio_pref_autoriza","k_desc_medio_pref_autoriza","El medio preferido de contacto");			}			fun ObtenerDato(cmdQuery,input,etiqueta){                    frn.dialog("genlistafiltrosel",etiqueta,cmdQuery,"clave",input,"0","0","N","S");						   			}			fun BuscarDato(cmdQuery,clave,desc,msg){				var cve_valor;				cve_valor=frn.get(clave);				//frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\query"&msg);										rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_serie_crud.BuscarDato"&msg&"()");				//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubo"&msg);				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if((nXml(cubo) == 0) && (cve_valor &! "")) {					frn.setPos(cve_valor);					frn.set(clave,"");					frn.message(msg & " no existe","Error","Aceptar");					resVal = 0;					return;                 } else{				    frn.set(desc,getXmlAtt(cubo,"r0","descripcion"));	    				}					}			fun SoN(campo) {                if (frn.get(campo) &= "S") {                    frn.set(campo,"N");                } else {                    frn.set(campo,"S");                }            }                fun ValidaSoN(campo){                if (frn.get(campo) &! "S" && frn.get(campo) &! "N"){                    frn.setPos(campo);                    frn.message("Sólo puede ser S o N","Error","&Aceptar");                    return;                }								if (frn.get(campo) &="S"){					if (campo &="garantia_ext"){						frn.setAtt("fec_expgarantia", "available","Y");							frn.setAtt("aseg_garantext", "available","Y");							frn.setAtt("poliza_garantext", "available","Y");						frn.setAtt("fec_expgarantia", "modify","Y");							frn.setAtt("aseg_garantext", "modify","Y");							frn.setAtt("poliza_garantext", "modify","Y");						}					if (campo &="segvehicular"){						frn.setAtt("fec_vigseguro", "available","Y");							frn.setAtt("aseg_segvehicular", "available","Y");							frn.setAtt("poliza_segvehicular", "available","Y");							frn.setAtt("fec_vigseguro", "modify","Y");							frn.setAtt("aseg_segvehicular", "modify","Y");							frn.setAtt("poliza_segvehicular", "modify","Y");						}				} else{					if (campo &="garantia_ext"){						frn.setAtt("fec_expgarantia", "available","N");							frn.setAtt("aseg_garantext", "available","N");							frn.setAtt("poliza_garantext", "available","N");						}					if (campo &="segvehicular"){						frn.setAtt("fec_vigseguro", "available","N");							frn.setAtt("aseg_segvehicular", "available","N");							frn.setAtt("poliza_segvehicular", "available","N");						}				}            }			fun ValidaSoNMismo(){                if (frn.get("mismo") &! "S" && frn.get("mismo") &! "N"){                    frn.setPos("mismo");                    frn.message("Sólo puede ser S o N","Error","&Aceptar");                    return;                }              }    	}	</script></pag>