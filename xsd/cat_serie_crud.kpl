<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">    <tab/><inp id="k_titulo" dim="65,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"				type="string" modify="N" available="N" fnt="Arial,22"/>	<br/>	<br/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grupo_crud" dim="115,72,7,11" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Nuevo" available="Y" modify="Y"><tab/>			<txt id="text_id">Serie:</txt><tab n="2"/><sp/>			<inp id="input_serie" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255"  type="capital" nc="17" clrBrdr="255,255,255" available="Y" tooltip="Serie" modify="Y" OnChange="ValidaSerie()"/>			<tab n="2"/><txt id="text_desc_veh" visible="S">Desc. Vehiculo:</txt><sp/>			<inp id="desc_modelo" dim="56,1" brdr="2,0" clr="64,64,64" bclr="255,255,255"  type="capital"  clrBrdr="255,255,255" available="Y" tooltip="Descripcion de Vehiculo" modify="N" visible="S"/><br/><tab/>			<txt id="text_id">Marca:</txt><tab/><sp/>			<inp id="input_marca" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  type="capital" nc="5" OnF9="ObtenerMarca()" OnChange="BuscarMarca()" available="Y" tooltip="Marca ( F9 b&#250;squeda )"/><sp/>			<inp id="k_desc_marca" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" clrBrdr="255,255,255" available="Y" modify="N"/>			<tab/><txt id="text_id">Modelo:</txt><tab n="3"/>			<inp id="input_modelo" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  type="capital" nc="10" available="Y" OnF9="ObtenerModelo()" OnChange="BuscarModelo()" tooltip="Modelo ( F9 b&#250;squeda )"/><sp/>			<inp id="k_desc_modelo" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" clrBrdr="255,255,255" available="Y" modify="N"/>			<br/><tab/>			<txt>Motor:</txt><tab n="3"/><sp/>			<inp id="input_motor" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  type="capital" nc="20" tooltip="Motor"/><tab n="5"/>			<txt>Transmisi&#243;n:</txt><tab/><sp/><tab/>			<inp id="input_transmision" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  type="capital" nc="20" tooltip="Transmisi&#243;n"/><br/><tab/>			<txt>Eje Trasero:</txt><tab n="2"/><sp/>			<inp id="input_eje_trasero" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  type="capital" nc="20" tooltip="Eje Trasero"/><tab n="5"/>					<txt>Placas:</txt><tab n="2"/><sp/><tab/>			<inp id="input_placas" dim="15,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  type="capital" nc="10" tooltip="Placas"/><br/><tab/>			<txt>Contacto:</txt><tab n="3"/><sp/>			<inp id="input_contacto" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="7" OnChange="Validar_cliente()"  clrBrdr="255,255,255" OnF9="Dialog(3,cat_cli_view,s,input_contacto)" OnF10="Dialog(3,cat_cli_crud,Nuevo,x,s,input_contacto)" OnF11="Dialog(3,cat_cli_crud,Modificar,x,s,input_contacto)" tooltip="Contacto ( F9 b&#250;squeda, F10 Nuevo, F11 Modificar )"/><sp/>			<inp id="k_nombre_contacto" dim="65,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" clrBrdr="255,255,255" available="Y" modify="N"/><br/><tab/>			<txt>Color:</txt><tab n="4"/><sp/>			<inp id="input_color" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="20" tooltip="Color"/><tab n="5"/>			<txt>A&#241;o:</txt><tab n="3"/><sp/><tab/>			<inp id="input_anio" clr="64,64,64" clrBrdr="255,255,255"  dim="10,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" modify="Y" available="Y" OnF9="ObtenerAnio()" OnChange="BuscarAnio()" type="capital" nc="4" tooltip="A&#241;o ( F9 b&#250;squeda )"/><br/><tab/>			<txt>Fecha de Venta:</txt><tab/><sp/>			<edt id="input_fecha_venta" dim="15,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" page="_ks_fecha,input_fecha_venta" OnF9="Dialog(3,_ks_fecha,input_fecha_venta)" modify="Y" available="Y" tooltip="Fecha de Venta"/><tab n="8"/>			<txt>Concesionario: </txt><tab/>			<inp id="input_concesionario" clr="64,64,64" clrBrdr="255,255,255"  dim="10,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" modify="Y" available="Y" OnF9="ObtenerConcesionario()" OnChange="BuscarConcesionario()" tooltip="Clave Concesionario" type="capital" nc="5"/><sp/>			<inp id="k_desc_concesionario" clr="64,64,64" clrBrdr="255,255,255"  dim="30,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" available="Y" tooltip="Concesionario" type="string" modify="N"/><br/><tab/>			<txt>&#218;ltima Visita:</txt><tab n="1"/><sp/>			<edt id="input_ult_visita" dim="15,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" page="_ks_fecha,input_ult_visita" OnF9="Dialog(3,_ks_fecha,input_ult_visita)" modify="Y" available="Y" tooltip="Fecha de Ultima Visita"/><tab n="8"/>			<txt>Ult. Kilometraje:  </txt>			<inp id="input_kilometraje" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" available="Y" type="number" tooltip="Ultimo Kilometraje"/><br/><tab/>			<inp id="cod_planta_id" dim="15,1"  type="string" modify="N" available="N"/>			<sp/>			<inp id="input_codigo_planta" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="capital" nc="15" tooltip="C&#243;digo Katashiki"/><tab n="5"/>			<txt>Version:</txt><tab n="2"/><sp/><tab/>			<inp id="input_version" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" available="Y" type="capital" nc="20" tooltip="Versi&#243;n"/><br/><tab/>			<txt>Fecha Dofu:</txt><tab n="2"/><sp/>			<edt id="input_fec_dofu" dim="15,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" page="_ks_fecha,input_fec_dofu" OnF9="Dialog(3,_ks_fecha,input_fec_dofu)" modify="Y" available="N" tooltip="Fecha Dofu"/><br/><tab/> 			<txt>Condici&#243;n Unidad:</txt><sp/>			<inp id="cond_unidad" dim="2,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="N" OnF9="ObtenerCondUnidad()" OnChange="BuscarCondUnidad()" type="number" tooltip="Clave Condici&#243;n de la Unidad" fmt="5" nc="1"/><sp/>			<inp id="k_desc_cond_unidad" dim="15,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" available="Y" type="capital" tooltip="Condici&#243;n de la Unidad" modify="N"/><tab n="5"/>			<txt>Sub-Condici&#243;n Unidad:   </txt>			<inp id="subcond_unidad" dim="2,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="N" available="Y" OnF9="ObtenerSubCondUnidad()" OnChange="BuscarSubCondUnidad()" type="number" tooltip="Clave Sub-Condici&#243;n de la Unidad" fmt="5" nc="1"/><sp/>			<inp id="k_desc_subcond_unidad" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" available="Y" type="capital" tooltip="Sub-Condici&#243;n de la Unidad" modify="N"/>			<br/><tab/>			<txt>Garant&#237;a Extendida:</txt><tab/>			<inp id="garantia_ext" dim="2,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" type="capital" nc="1" OnChange="ValidaSoN(garantia_ext)" tooltip="Garant&#237;a Extendida  S/N" available="N"/><tab n="10"/>			<txt>Expiraci&#243;n Garant&#237;a:</txt><tab n="2"/>			<edt id="fec_expgarantia" dim="15,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" page="_ks_fecha,fec_expgarantia" OnF9="Dialog(3,_ks_fecha,fec_expgarantia)" modify="N" available="N" toolti