<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<tab/><txt fnt=",22" clr="0,0,0">Alta Pedido</txt><br/>	<!-- dim="81,0" --> 	<tab/><hLine clr="0,0,0"/> 	<br/> <br/>		<!-- <grp dim="46,9,7,12" -->		<tab/>		<grp dim="48,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros"><txt>  Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>			<br/><br/>			<txt>  Tipo :        </txt>			<cmb id="k_tipon" dim="40,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="N" OnChange="CambiaTipo() "/>			<br/>		</grp>		<sp/>		<!-- dim="34,9,7,12" -->		<grp dim="36,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C"/><tab/> <br/>			<txt id="textFolio" visible="N">  Folio :  </txt>			<edt id="k_folio" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" visible="N" OnButton="ObtenerFolios()" OnF9="ObtenerFolios()" OnChange="BuscarFolio()"/> 			<sp n="2"/> <inp id="c_st" dim="20,1" bclr="240,240,240" clr="167,23,37" clrBrdr="255,255,255" type="string" fnt=",16b" modify="N" available="N" visible="Y"/> 			<br/>			<sp n="1"/>			<inp id="k_docto" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="C"/> <br/>			<txt>  Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N"/> 			<sp n="1"/> 			<txt>  Hora : </txt> 			<sp n="1"/> 			<edt id="k_hora" dim="15,1" type="string" nc="-1" bclr="240,240,240" modify="N" fmt="HH:MM:SS" available="N"/> 			<br/>		</grp>		<br/>		<br/>				<!-- dim="81,14,7,12" -->		<tab/>		<grp dim="85,6,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Referencia">							<br/>						<sp n="1"/> <txt clr="0,58,112">Referencia Sugerido : </txt> <tab/>			<edt id="k_refer" clr="64,64,64" clrBrdr="255,255,255"  dim="30,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="10" available = "Y" modify="Y" 						OnF9="ObtenerRef()" OnChange="MostrarRef()" OnButton="ObtenerRef()"/>					<sp n="5"/>				<inp id="k_fecref" dim="25,1" type="string" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="N" nc="-1"/> 					</grp>		<br/>		<br/>			<!-- dim="81,18,7,12" --> 		<tab/>		<grp dim="85,28,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Totales ">			<sp n="1"/> 			<!-- fnt="Arial,15" dim="114,6" -->			<tbl id="k_mov" dim="119,8" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" hk="z" OnChange="CalcTotal()" Reorder="N" modify="Y" insdel="N" nren="fijo">							<col id="c_reemplazo" name="Reemplazo"  type="capital" nc="18" modify="N" available="Y" visible="Y"/>											<col id="k_parte" name="Producto"  type="capital" nc="18" modify="N" available="Y"/>			   <col id="k_descr" name="Descripcion"  modify="N" nc="30"/>						<col id="k_q" name="Cantidad"  type="number" nd="-1" min="0" modify="N" OnF9="" OnMouseL="" 					OnChange="" OnActive="" OnF10="" visible="Y" available="Y"/>				<col id="k_unidad" name="U.M."  type="capital" OnChange="" OnF9="" OnMouseL="" modify="N" available="Y" visible="Y"/>				<col id="k_precio" name="Unitario"  type="number" nd="2" modify="N" available="Y" visible="Y"/>									<col id="k_monto" name="Importe"  type="number" nd="2" OnF9="" OnMouseL="" 					OnChange="" OnActive="" OnF10="" modify="N" available="Y" visible="Y"/>									<col id="c_stock" name="Stock"  type="number" nd="2" OnF9="" OnMouseL="" 					OnChange="" OnActive="" OnF10="" modify="N" available="N" visible="N"/>				<col id="c_especial" name="Especial"  type="number" nd="2" OnF9="" OnMouseL="" 					OnChange="" OnActive="" OnF10="" modify="N" available="N" visible="N"/>								</tbl>			<br/>						<sp n="1"/> <txt fnt=",16b">Importe : </txt>			<tab/><sp n="1"/> <inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="N"/>  						<br/>						<sp n="1"/> <txt clr="0,58,112">Comentarios:</txt>			<sp n="1"/> <inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="107,3" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="string" nc="300" bclr="255,255,255"/>			<br/>			<sp n="13"/> <inp id="k_coment2" clr="64,64,64" clrBrdr="255,255,255"  dim="107,1" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="string" bclr="255,255,255" nc="60"/>			<br/>			<sp n="13"/> <inp id="k_coment3" clr="64,64,64" clrBrdr="255,255,255"  dim="107,1" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="string" bclr="255,255,255" nc="60"/>		<br/>		<br/>						<tab n="31"/>		<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Ejecuta_Reporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>					<sp n="3"/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>					<sp n="3"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>										</grp>						</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable, asterisco ;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal;			var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd,uen;                  // Vart Reports			var cmd, xmlResQuery, strTmp;			var sucursal, fech_oper, tipo_auto, xmlPar;			var fech_original;										fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";				fileSavePath = "C:\Basura";				Inicializa();								ConfiguraControlesOpcion();			}			//Validacion Datos Generales y Partidas antes de Guardar.			//El resultado de cada validacion se guarda en la variable global resVal.			fun ValidarDatos(iModo) {				var totReg, subTotal=0, iva=0, total=0;				var no_part=0;				var folio, dato_num, dato_txt;								//Obtener variables				sucursal_id = frn.get("k_sucn",-1,1);				refer_id = frn.get("k_refer");								folio = frn.get("k_folio");								if (iModo != 1) {  // 20231003 									//Validar Referencia					cmdQuery = "select count(*) as totreg from keplersc.kdpedref " & 						 "where c1 = '" & sucursal_id &  "' and c2 = '" & refer_id &  "' and c4 = 10";												rstXml(cuboQuery);					/*					if (iModo != 1) {  // 20220814						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.ValidarDatos()");					} else { 						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.ValidarDatos_Baja()");					}					*/					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.ValidarDatos()");					ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error DB","Aceptar"); //TO DO Homologar mensaje en todo el proyecto, agregar DB						return;					}					totReg = getXmlAtt(cuboQuery,"r0","totreg");					if(totReg==0){						frn.message("La referencia no existe o no esta disponible ...","Error","Aceptar");						resVal=0;						return;					}																						} else {									// Nuevo Segmento Incluido por JMM, No es parte de K75 pero por Logica es Necesario y debe ser el 1ro debido al DOC.ST					if ( strFormat("ucase", frn.get("c_st")) &= "CANCELADO" ) {						frn.message("El Pedido esta con Estatus Cancelado ...","Error","Aceptar");						resVal=0;						return;							}										//Validar Existencia Documento					cmdQuery = "" & 						"select count(c6) totreg from keplersc.kdm1 where c1 = '" & sucursal_id & "' and c2 = '" & gen_doc & "' " & 						"and c3 = '" & nat_doc & "' and c4 = " & gpo_doc & " and c5 = " & tip_doc  & " and c6 = '" & folio & "'";												rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.ValidarDatos_Baja()");					ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error DB","Aceptar"); //TO DO Homologar mensaje en todo el proyecto, agregar DB						return;					}					totReg = getXmlAtt(cuboQuery,"r0","totreg");					if(totReg==0){						frn.message("El Pedido No existe ...","Error","Aceptar");						resVal=0;						return;					}												//Validar Datos del Documento y Transacciones Asociadas ...										cmdQuery = "" & 						"select k.c6 doc_fol, k.c43 doc_st, k.c11 doc_ref, coalesce(k2.k2_regs,0) doc_regs, coalesce(p.c4,-1) ped_st " & 						", coalesce(cm.cm_regs,0) cm_regs from keplersc.kdm1 k " &						"left join keplersc.kdpedref p on p.c1 = k.c1 and p.c2 = k.c11 " & 						"left join (select c1, c2, c3, c4, c5, c6, count(*) as k2_regs from keplersc.kdm2 " & 							"where c1 = '" & sucursal_id & "' and c2 = '" & gen_doc & "' and c3 = '" & nat_doc & "' and c4 = " & gpo_doc & " " &							"and c5 = " & tip_doc  & " group by c1, c2, c3, c4, c5, c6) k2 " &  							"on k2.c1 = k.c1 and k2.c2 = k.c2 and k2.c3 = k.c3 and k2.c4 = k.c4 and k2.c5 = k.c5 and k2.c6 = k.c6 " &						"left join (select c1, c2, c3, c4, c5, c6, count(*) as cm_regs from keplersc.kdpedrefcom " & 							"where c1 = '" & sucursal_id & "' and c2 = '" & gen_doc & "' and c3 = '" & nat_doc & "' and c4 = " & gpo_doc & " " & 							"and c5 = " & tip_doc  & " group by c1, c2, c3, c4, c5, c6) cm " &  							"on cm.c1 = k.c1 and cm.c2 = k.c2 and cm.c3 = k.c3 and cm.c4 = k.c4 and cm.c5 = k.c5 and cm.c6 = k.c6 " & 						"where k.c1 = '" & sucursal_id & "' and k.c2 = '" & gen_doc & "' and k.c3 = '" & nat_doc & "' and k.c4 = " & gpo_doc & " " &						"and k.c5 = " & tip_doc  & " and k.c6 = '" & folio & "'";								rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.ValidarDatos_Baja()");					ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error DB","Aceptar"); //TO DO Homologar mensaje en todo el proyecto, agregar DB						return;					}										// Valida si Query arrojo datos (no lo haria si no encontra el DOC) 					if (nXml(cuboQuery) > 0) { 											// Hara todas las Validaciones de ST y otros datos del DOC y las REFs Asociadas 												dato_num = getXmlAtt(cuboQuery,"r0", "ped_st");						if ( strlen(dato_num) > 0 ) {							if (dato_num < 0) {								frn.message("Referencia del Pedido Sugerido No Existe ...","Error","Aceptar");								resVal=0;								return;							}							if (dato_num == 0) {								frn.message("El Pedido Sugerido ya ha sido eliminado previamente ...","Error","Aceptar");								resVal=0;								return;							}							if (dato_num == 10) {								frn.message("El Pedido Sugerido esta como Editable, No se puede realizar esta opcion ...","Error","Aceptar");								resVal=0;								return;							}							if (dato_num != 20) {								frn.message("El Estatus del Pedido No es Valido, No se puede realizar esta opcion ...","Error","Aceptar");								resVal=0;								return;							}								}																		dato_num = getXmlAtt(cuboQuery,"r0", "doc_regs");						dato_txt = getXmlAtt(cuboQuery,"r0", "doc_st");						dato_txt = strFormat("ucase", dato_txt);						if(dato_num == 0){							frn.message("El Pedido No tiene Partidas o ha sido Cancelado ...","Error","Aceptar");							resVal=0;							return;						}						if(dato_txt &= "C"){							frn.message("El Pedido esta con Estatus Cancelado ...","Error","Aceptar");							resVal=0;							return;						}												dato_num = getXmlAtt(cuboQuery,"r0", "cm_regs");						if(dato_num > 0){							frn.message("El Pedido ya tiene Compras Asociadas ...","Error","Aceptar");							resVal=0;							return;						}																		} else {											frn.message("El Pedido No existe, o No se pudo verificar la Informacion ...","Error","Aceptar");						resVal=0;						return;										}												} // End Else iModo ... 													no_part = frn.N("k_mov");								/*				if (iModo != 1) {  // 20220814  					//Validar Cantidades					//for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {					for (var i=0,n=frn.N("k_mov");i<n;i++) { 						frn.setPos("k_mov",i,"k_q");						resVal=CalculaTotales(1);						if(resVal==0){							return;						}					}				} else { 				*/					if (frn.N("k_mov") == 0) {						frn.message("La operacion no tiene partidas.","Error","Aceptar");						resVal=0;						return;					}					else { CalculaTotales(); } // Added ... 20230903				/*}*/							//Validar Totales				//subTotal = frn.get("k_subtotal");				//iva  =frn.get("k_iva");				total = frn.get("k_monto");				if (total <= 0){					frn.message("El total de la operación no puede ser cero.","Error","Aceptar");					resVal = 0;					return;				}							} // End ValidarDatos()						/*			fun DetallaGRD() {				for (var i=0; i<frn.N("k_mov"); i++) {					if ( (strlen(frn.get("k_mov",i,"k_q")) == 0) || (frn.get("k_mov",i,"k_q") <= 0) ) {  						frn.setX("0","k_mov",i,"k_q"); 						frn.setX("0","k_mov",i,"k_precio"); 						frn.setX("0","k_mov",i,"k_monto"); 					} else {						frn.setX(frn.get("k_mov",i,"k_ic"),"k_mov",i,"k_precio"); 					}				}					}			*/						fun BuscarFolio() {				var folio;				folio = frn.get("k_folio");				//frn.lib("libGeneral.kpl","PadLeft", folio, 7, "0");				folio = PadLeft(folio, 7, "0");				ArmarRefDocto();				MostrarDOC(folio);				}			fun Cancela() {				CambiaSucursal();				Inicializa();				ConfiguraControlesOpcion();			}						fun ModoBuscar() {				tip_ope = "C";				frn.set("operacion", "CONSULTA");				LimpiaEncabezado();				ConfiguraControlesOpcion();			}					fun Ejecuta() {				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, no_partidas, prod_ui;				var resultado, mensaje, folio;								fecha = sys.date();				hora = sys.time();								if (tip_ope &= "A") { 								//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok					resVal = 1;					ValidarDatos();					if(ok &! "1" || resVal == 0){						return;					}					//Para Homologar los TAGs que envía el Grid (KMov) al XML que generará la Pantalla					//DetallaGRD();										// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;												setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",						frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 						frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")/*-1*//*commented 220726*/);					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);					setXml(xmlPantalla,"ambiente","uen",uen);					no_partidas=frn.N("k_mov");					for(var i =0;i<no_partidas;i++){						prod_ui = getXml(xmlPantalla,"k_mov","r" & i ,"k_parte");						setXml(xmlPantalla,"k_mov","r" & i,"k_partesel",prod_ui);					}					frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\XmlAltaPedido");					/*					// For Testing 					frn.message("El pedido se procesara ...", "Info", "Aceptar");					return;					*/					// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 								cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					rstXml(cuboQuery);					cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"refaltapedcrud.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_AltaPedido");										// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										//resultado = "1";					//mensaje = "0000009";										resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");																				if(resultado &= "1") {											frn.message(mensaje, "Folio Generado para esta operacion : ", "Aceptar");											ModoBuscar(); // 220721 ... added 												//tip_ope = "C"; -- 220721 ... commented & included en ModoBuscar();						frn.set("k_folio", mensaje); 						//frn.set("operacion", "CONSULTA"); -- 220721 ... commented & included en ModoBuscar();						/*						strTmp = frn.get("k_docto");								strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;						frn.set("k_docto", strTmp);						*/						// //ConfiguraCamposOpcion();											//strMsg = "El Folio utilizado para esta operación fue : " & mensaje;						//ConfiguraControlesOpcion(); // TO CHECK ... Esto No se ejecuta si se pone después del Message * * *  						//frn.message(strMsg, "Mensaje", "Aceptar");						//folio = frn.get("k_folio");						//MostrarDOC(folio);							BuscarFolio();					} else {						frn.message(mensaje, "Error", "Aceptar");					}				} /*End Alta*/ else {					if (tip_ope &= "B") {						/*Ini Baja*/																		// IMPORTANTE ... EL CODIGO DE ABAJO DEBE SER RECONSTRUIDO ... ESTE ES DE OTRA OPCION 												folio = frn.get("k_folio");												//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok						resVal = 1;						ValidarDatos(1);						if(ok &! "1" || resVal == 0){							return;						}																xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;						//Agregar usuario, fecha y hora de movimiento						strFecha = fnDate("year",fecha) & "-";						strTmp = fnDate("month",fecha);						if(strlen(strTmp) == 1){							strTmp = "0" & strTmp;						}						strFecha = strFecha & strTmp & "-";						strTmp = fnDate("day",fecha);						if(strlen(strTmp) == 1){							strTmp = "0" & strTmp;						}						strFecha = strFecha & strTmp;													setXml(xmlPantalla,"movimiento","usuario",usuario);						setXml(xmlPantalla,"movimiento","fecha",strFecha);						setXml(xmlPantalla,"movimiento","hora",							frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 							frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));						setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov"));						setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);						setXml(xmlPantalla,"ambiente","uen",uen);											no_partidas=frn.N("k_mov");						for(var i =0;i<no_partidas;i++){							prod_ui = getXml(xmlPantalla,"k_mov","r" & i ,"k_parte");							setXml(xmlPantalla,"k_mov","r" & i,"k_partesel",prod_ui);						}						frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\Xml_Pedido_Baja");																		// For Testing ... 						/*						frn.message("La Baja se Procesara ... [ En Desarrollo ]", "Info", "Aceptar");						return;						*/												// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 									cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						//kdb.rst(cuboQuery);						rstXml(cuboQuery);						cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"refaltapedcrud.Ejecuta_Baja");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_BajaPedido");											// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 											//resultado = "1";						//mensaje = folio /*"0000009"*/;											resultado = getXml(cuboQuery,"resultado");						mensaje = getXml(cuboQuery,"mensaje");										// /*																	if(resultado &= "1") {												frn.message(mensaje, "Folio Cancelado ...", "Aceptar");												ModoBuscar(); // 220721 ... added 													//tip_ope = "C"; -- 220721 ... commented & included en ModoBuscar();							//frn.set("k_folio", mensaje); 							frn.set("k_folio", folio);							//frn.set("operacion", "CONSULTA"); -- 220721 ... commented & included en ModoBuscar();							/*							strTmp = frn.get("k_docto");							strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;							frn.set("k_docto", strTmp);							*/							// //ConfiguraCamposOpcion();												//strMsg = "El Folio utilizado para esta operación fue : " & mensaje;							//ConfiguraControlesOpcion(); // TO CHECK ... Esto No se ejecuta si se pone después del Message * * *  							//frn.message(strMsg, "Mensaje", "Aceptar");							//folio = frn.get("k_folio");							//MostrarDOC(folio);								BuscarFolio();						} else {							frn.message(mensaje, "Error", "Aceptar");						}						// */												//frn.message("En Construcción, OPC {Baja}", "Info", "Aceptar");					} /*End Baja*/ else {						frn.message("Opcion No Desarrollada ...", "Info", "Aceptar");						return;						/*Ini Consulta*/						folio = frn.get("k_folio");						ModoBuscar(); // 220721 ... added						frn.set("k_folio", folio); // 220721 ... added						//MostrarDOC(folio); // 220722 ... commented 						/*						strTmp = frn.get("k_docto");						strTmp = strSplit(strTmp,"-",0) & "-" & folio;						frn.set("k_docto", strTmp);							*/						BuscarFolio();					}	/*End Consulta (for exception)*/ 				}							} // FIN ... Ejecuta()									fun Inicializa(){ //Inicializa los valores en Pantalla				// Our code 				// Revisa y Carga en Variables los Parámetros Recibidos en la corrida				if( frn.nParam() == 6 ){ //Se han mandado parámetros a la página					gen_doc = trim(frn.param(0));                nat_doc = trim(frn.param(1));                gpo_doc = trim(frn.param(2));               tip_doc = trim(frn.param(3));                tip_ope = trim(frn.param(4));               uen = trim(frn.param(5));               tip_ope_original = tip_ope; /*220726*/					if (uen &= "") {						// uen="XXX";						uen="REF";					}				} else {					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}				// Testing Code //				/*				gen_doc = "N"; 				nat_doc = "D"; 				gpo_doc = "21";				tip_doc = "1"; 				tip_ope = "A"; // "C" 				uen = "REF";            */            				if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					if(tip_ope &= "B"){ //Baja						frn.set("operacion","BAJA");					} else {						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} else {					      frn.message("Operación no válida ...", "Mensaje","&Aceptar");							//frn.open("anuncios",4);							frn.open("index",4);							return;									}					}				}													//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));							sucursal_id=frn.get("k_sucn",-1,1);										// Fill Combo Tipo (Con Query FTO Kepler) 				LlenaCmbTipo();								frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());									// Fill k_docto | referencia docto				ArmarRefDocto();							}						fun LlenaCmbTipo(){				cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm " &				"where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4 = '" & tip_doc & "' and col_sucursal='" & sucursal_id & "'";				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"fefaltapedcrud.Inicializa()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboTipoDocto");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error BD","Aceptar");					return;				}				frn.set("k_tipon",getXml(cuboQuery));			}							// Armado del Docto Referencia			fun ArmarRefDocto {				var cadena,tmpFolio, tmpGrupo, tmpTipo;				tmpFolio = frn.get("k_folio");				tip_doc=frn.get("k_tipon",-1,4);				// //tmpFolio = frn.lib("libGeneral.kpl","PadLeft",tmpFolio,"7","0");				tmpFolio = PadLeft(tmpFolio,"7","0");				tmpGrupo = PadLeft(gpo_doc,"2","0");				tmpTipo = PadLeft(tip_doc,"3","0");				//cadena = trim(gen_doc) & trim(nat_doc) & trim(gpo_doc) & trim(tip_doc) & "-" & tmpFolio;				cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;				frn.set("k_docto", cadena);			}						fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         }			fun ConfiguraControlesOff() {								frn.setAtt("textFolio", "visible", "N");				frn.setAtt("k_folio", "available", "N");				frn.setAtt("k_folio", "visible", "N");								frn.setAtt("k_fecha", "available", "N");				frn.setAtt("k_hora", "available", "N");				frn.setAtt("k_refer", "available", "N");				frn.setAtt("k_fecref", "available", "N");								frn.setAtt("k_coment", "available", "N");				frn.setAtt("k_coment2", "available", "N");				frn.setAtt("k_coment3", "available", "N");								//frn.setAtt("k_mov", "visible", "N", "c_reemplazo");								frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											}						fun ConfiguraControlesOpcion() {							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta					//frn.setAtt("k_fecha", "available", "Y");					//frn.setAtt("k_hora", "available", "Y");					frn.setAtt("k_refer", "available", "Y");								frn.setAtt("k_coment", "available", "Y");					frn.setAtt("k_coment2", "available", "Y");					frn.setAtt("k_coment3", "available", "Y");								frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");													} else {					if(tip_ope &= "B"){ //Baja										frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("Imprimir", "visible", "N");						frn.setAtt("Cancelar", "visible", "Y");						frn.setAtt("Aceptar", "visible", "Y");															} else {						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("Imprimir", "visible", "Y");						frn.setAtt("Cancelar", "visible", "N");						frn.setAtt("Aceptar", "visible", "N");						}				}			}						fun LimpiaDatosDoc {				frn.set("k_refer", "");				frn.set("k_fecref", "");				frn.set("k_mov", "");				frn.set("k_coment", "");				frn.set("k_coment2", "");				frn.set("k_coment3", "");			}						fun LimpiaTotalesDoc {				//frn.set("k_subtotal", "");				//frn.set("k_iva", "");				frn.set("k_monto", "");			}						fun LimpiaEncabezado {				frn.set("k_folio", "");				frn.set("k_docto", "");				frn.set("k_fecha", "");				frn.set("k_hora", "");				frn.set("c_st", "");			}						fun CambiaSucursal {				LimpiaDatosDoc();				LimpiaTotalesDoc();				LimpiaEncabezado();				LlenaCmbTipo();				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());					ArmarRefDocto();							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						}					}								}			}						fun CambiaTipo {				LimpiaDatosDoc();				LimpiaTotalesDoc();				LimpiaEncabezado();				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());					ArmarRefDocto();								if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						}					}								}			}			fun ObtenerRef() {							var win_tit, field_key, field_col, cmdQuery;				            proveedor_id = frn.get("k_clave");            sucursal_id = frn.get("k_sucn",-1,1);	                        win_tit = "Pedidos Sugeridos";				field_key = "referencia";				field_col = "k_refer";            cmdQuery = "select c2 as referencia, to_char(c3, 'dd/mm/yyyy') as fecha from keplersc.kdpedref " &                 "where c1 = '" & sucursal_id &  "' and c4 = 10";            cmdQuery = cmdQuery & " order by c2 desc ";                        	         frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");                     }         			fun ObtenerFolios() {			            sucursal_id = frn.get("k_sucn",-1,1);					if(tip_ope &= "B"){ 					cmdQuery = "" &						"select w.c6 as folio, to_char(w.c9, 'dd/mm/yyyy') as fecha from keplersc.kdm1 w " & 						"where upper(w.c43) <> 'C' and w.c1 = '" & sucursal_id & "' and w.c2 = '" & gen_doc & "' and w.c3 = '" & nat_doc & "' and w.c4 = " & gpo_doc & " and w.c5 = " & tip_doc  & " order by w.c6 desc";				} else {					cmdQuery = "" &						"select w.c6 as folio, to_char(w.c9, 'dd/mm/yyyy') as fecha from keplersc.kdm1 w " & 						"where w.c1 = '" & sucursal_id & "' and w.c2 = '" & gen_doc & "' and w.c3 = '" & nat_doc & "' and w.c4 = " & gpo_doc & " and w.c5 = " & tip_doc  & " order by w.c6 desc";				}						                                    frn.dialog("genlistasel","Relacion de Pedidos",cmdQuery,"folio","k_folio","0","","N");                     }                  fun MostrarRef() {					var refer;				var xmlGrd;				var sqlXmlRequest,xmlResProd,nRows,cont,prodSel,prodOri,prodUni,prodDesc,cuboResProd,cmd; //VCSS 27 Maro 2026																	sucursal_id = frn.get("k_sucn",-1,1);				refer = frn.get("k_refer");												//Reset campos				LimpiaDatosDoc();				LimpiaTotalesDoc();								frn.set("k_refer", refer);								CalculaTotales();								cmdQuery = "" &					"select h.c3 k_parte, i.c2 k_descr, h.c18 k_q, i.c19 k_unidad " & 					", coalesce(l.c14, 1) k_precio, ( h.c18 * coalesce(l.c14, 1) ) k_monto " & 					", (select * from keplersc.reemplazo_prod_text(h.c3)) as c_reemplazo " & 					"from keplersc.kdpedrefmov h " &					"left outer join keplersc.kdini i on i.c1 = h.c3 " &					"left outer join keplersc.kdinl l on l.c1 = h.c1 and l.c2 = h.c3 " &  					"where h.c1 = '" & sucursal_id & "'" & " and h.c2 = '" & refer & "'" & " and h.c18 > 0 order by h.c2, h.c3";									rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.mostrardatosgrid()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosgrid");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.message("Sin Registros por mostrar ...","Info","Aceptar");					frn.set("k_fecref", "Referencia Invalida");					frn.setPos("k_refer");					return;					}					//frn.set(cuboQuery);								rstXml(xmlGrd);				xmlGrd=frn.lib("libGeneral.kpl","CreaXmlDesdeTagRow",cuboQuery,"r","k_mov");				frn.lib("libGeneral.kpl","FileSave",xmlGrd, fileSavePath & "\mostrardatosgrid_parsed");				frn.setX(xmlGrd);				//VCSS 27 Marzo 2026, completar info de reemplazos				nRows=frn.N("k_mov");								for(cont=0; cont<nRows; cont++){					prodSel=frn.get("k_mov",cont,"k_parte");					prodDesc=frn.get("k_mov",cont,"k_descr"); 					if (prodDesc &! ""){						continue;					}					setXml(sqlXmlRequest,"document","producto",prodSel);					setXml(sqlXmlRequest,"document","ubicacion","");					setXml(sqlXmlRequest,"document","anio","");					setXml(sqlXmlRequest,"document","movimiento","usuario",frn.lib("libKepler","UserInfo"));					rstXml(cuboResProd);					cmd="select * from keplersc.invr_rep_estxprod_sec_prod_sel('" & getXmlStr(sqlXmlRequest,"EOF:13_10") & "')";					frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdResProdPedido");									cuboResProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepestprod.GenerarReporte()");										ok=getXmlAtt(cuboResProd,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResProd,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						if(memcmp(mensajeError,"P0001",5)==0){							frn.message("Error de logica","Error","Aceptar");						}else{							frn.message(mensajeError,"Error","Aceptar");						}						return;					}									frn.lib("libGeneral.kpl","FileSave",cuboResProd,"C:\Basura\cuboResProdPedido");					strTmp = getXmlAtt(cuboResProd,"r0","invr_rep_estxprod_sec_prod_sel");					setXmlStr(xmlResProd,strTmp);									prodOri=getXml(xmlResProd,"k_claveoriginal");					prodDesc=getXml(xmlResProd,"k_descproducto");					prodUni=getXml(xmlResProd,"k_unidad");										frn.setX(prodDesc,"k_mov",cont,"k_descr");					frn.setX(prodUni,"k_mov",cont,"k_unidad");				}													// Traer Fecha Referencia 				var dato_id;							dato_id = "";				cmdQuery = "select c3 as campo from keplersc.kdpedref where c1 = '" & sucursal_id & "'" & " and c2 = '" & refer & "'";								if(tip_ope &= "A"){ //Alta		         cmdQuery = cmdQuery & " and c4 = 10";				} 					rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.Valida_Ref()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\refaltapedcrud_Valida_Ref");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								dato_id = getXmlAtt(cuboQuery,"r0", "campo");								if ( strlen(dato_id) > 0 ) {					frn.set("k_fecref", dato_id);				} else {					frn.set("k_fecref", "Referencia Invalida");				}								CalculaTotales();									return;						   } // End MostrarRef()		   			fun MostrarDOC(nFolio) {							var xmlGrd, flagErr;												flagErr = 0;								sucursal_id = frn.get("k_sucn",-1,1);								LimpiaDatosDoc();				LimpiaTotalesDoc();				LimpiaEncabezado();								cmdQuery = "" & 					"select w.c6 as folio, w.c9 as fecha, w.c11 as refer, w.c24 as cmnt1, w.c25 as cmnt2, w.c26 as cmnt3, w.c41 as fechref, w.c69 as hora, w.c43 as st from keplersc.kdm1 w " & 					"where w.c1 = '" & sucursal_id & "' and w.c2 = '" & gen_doc & "' and w.c3 = '" & nat_doc & "' and w.c4 = " & gpo_doc & " and w.c5 = " & tip_doc  & " " &					"and w.c6 = '" & nFolio & "' order by w.c6 desc";				//frn.message(cmdQuery,"Info !","Aceptar");								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.upd()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosdocpedido");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					//frn.setAtt("Aceptar", "visible", "N");					//ConfiguraControlesOff();					if ( tip_ope &= "B" || tip_ope &= "C" ) { frn.set("k_folio", nFolio); }					frn.message("Sin Datos por mostrar ...","Info","Aceptar");					flagErr = 1;					ArmarRefDocto();					return;					//Cancela();					}	else {					if(tip_ope &! "C"){						frn.setAtt("Aceptar", "visible", "Y");					}				}				//frn.set(cuboQuery);								//if ( flagErr == 1 ) { Cancela(); }				ConfiguraControlesOpcion();								/*				frn.setX(getXmlAtt(cuboQuery,"r0", "folio"), "k_folio");				frn.setX(getXmlAtt(cuboQuery,"r0", "fecha"), "k_fecha");				frn.setX(getXmlAtt(cuboQuery,"r0", "refer"), "k_refer");				frn.setX(getXmlAtt(cuboQuery,"r0", "fechref"), "k_fecref");				frn.setX(getXmlAtt(cuboQuery,"r0", "hora"), "k_hora");				frn.setX(getXmlAtt(cuboQuery,"r0", "cmnt1"), "k_coment");				frn.setX(getXmlAtt(cuboQuery,"r0", "cmnt2"), "k_coment2");				frn.setX(getXmlAtt(cuboQuery,"r0", "cmnt3"), "k_coment3");				*/								frn.set("k_folio", getXmlAtt(cuboQuery,"r0", "folio"));				frn.set("k_fecha", getXmlAtt(cuboQuery,"r0", "fecha"));				frn.set("k_refer", getXmlAtt(cuboQuery,"r0", "refer"));				frn.set("k_fecref", getXmlAtt(cuboQuery,"r0", "fechref"));				frn.set("k_hora", getXmlAtt(cuboQuery,"r0", "hora"));				frn.set("k_coment", getXmlAtt(cuboQuery,"r0", "cmnt1"));				frn.set("k_coment2", getXmlAtt(cuboQuery,"r0", "cmnt2"));				frn.set("k_coment3", getXmlAtt(cuboQuery,"r0", "cmnt3"));								if ( getXmlAtt(cuboQuery,"r0", "st") &= "C" || getXmlAtt(cuboQuery,"r0", "st") &= "c" ) {					frn.set("c_st", "Cancelado");				} else {					frn.set("c_st", "");				}								ArmarRefDocto();								MostrarDOCDet(nFolio);						}			fun MostrarDOCDet(nFolio) {					var refer;				var xmlGrd;																	sucursal_id = frn.get("k_sucn",-1,1);								//Reset campos				frn.set("k_mov", "");				//frn.set("c_st", "");							CalculaTotales();								/*				cmdQuery = "" &					"select c8 k_parte, c10 k_descr, c9 k_q, c11 k_unidad " & 					", c12 k_precio, c13 k_monto " & 					"from keplersc.kdm2 " &					"where c1 = '" & sucursal_id & "' and c2 = '" & gen_doc & "' and c3 = '" & nat_doc & "' and c4 = " & gpo_doc & " and c5 = " & tip_doc  & " " &					"and c6 = '" & nFolio & "' order by c7";				*/								cmdQuery = "" &				"select x.c8 k_parte, x.c10 k_descr, x.c9 k_q, x.c11 k_unidad, x.c12 k_precio, x.c13 k_monto " &				", (select * from keplersc.reemplazo_prod_text(x.c8)) as c_reemplazo " & 				", k.c11 as c_especial, k.c17 as c_stock " & 				"from keplersc.kdm2 x " & 				"inner join keplersc.kdm1 m on m.c1 = x.c1 and m.c2 = x.c2 and m.c3 = x.c3 and m.c4 = x.c4 and m.c5 = x.c5 and m.c6 = x.c6 " & 				"left join keplersc.kdpedrefmov k on k.c1 = m.c1 and k.c2 = m.c11 and k.c3 = x.c8 " & 				"where x.c1 = '" & sucursal_id & "' and x.c2 = '" & gen_doc & "' and x.c3 = '" & nat_doc & "' and x.c4 = " & gpo_doc & " and x.c5 = " & tip_doc  & " " &				"and x.c6 = '" & nFolio & "' order by x.c7";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.mostrardatosgrid()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosdocgrid");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					//if(tip_ope &= "B"){ frn.set("c_st", "Cancelado"); } 					frn.set("c_st", "Cancelado");					frn.message("Sin Registros por mostrar ...","Info","Aceptar");					return;					}					//frn.set(cuboQuery);							rstXml(xmlGrd);				xmlGrd=frn.lib("libGeneral.kpl","CreaXmlDesdeTagRow",cuboQuery,"r","k_mov");				frn.lib("libGeneral.kpl","FileSave",xmlGrd, fileSavePath & "\mostrardatosdocgrid_parsed");				frn.setX(xmlGrd);												CalculaTotales();									return;						   } // End MostrarDOCDet()	   			fun CalculaTotales(iModo) {				var monto = 0, monto_acum = 0;				var cantValida = 1;				//Calcular totales				for (var i=0; i<frn.N("k_mov"); i++) {					 monto = frn.get("k_mov",i,"k_monto");					 monto_acum = monto_acum + monto;				}								//frn.set("k_subtotal",subTotal);				//frn.set("k_iva",iva);								frn.set("k_monto",monto_acum);								return cantValida;			}												// ZONA	CODIGO REPORTE(S) 						fun IniParams(){//Inicializa parámetros de impresión. Pueden ser cambiados por el usuario final mediante menú: Archivo -> Configurar Página				frn.set("param_paper","letter");	//Tamaño de papel predefinido:	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tamaño de papel personalizado	"size=21.59,27.94cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//Márgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0");	//Escala de impresión (1=100 por ciento)	"F=1,1"				frn.set("param_landscape","Y");	//Orientación	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"				frn.set("param_emp","L");	//Posición de "Razón social"(izq,der,cen)	@emp=L|R|C"			}						fun setRepPage() {//Establece los parámetros finales de impresión.				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Ejecuta_Reporte() {							if (  ( frn.N("k_mov") == 0 ) || ( strlen( trim(frn.get("k_folio")) ) == 0 )  ) {					frn.message("Sin Registros por mostrar ...","Info","Aceptar");					return;				}							// Commented 20221208 				//IniParams(); //Inicializa parámtros de impresión entre otros							//Code Added 20121208 				/*				//rstXml(xmlPar);				*/								/*				if ( tip_ope_original &= "C" && tip_ope &= "C" ) {					CambiaSucursal(3); 				}				*/									// fech_original = "2022-11-03"; // 4 Testing				// tip_ope_original = "A"; // 4 Testing								//...(cubos de datos e información necesaria)				sucursal = frn.get("k_sucn",-1,1);				/*				if ( tip_ope_original &= "A" && tip_ope &= "C" ) {					fech_oper = fech_original; // frn.get("k_fecha");				}				tipo_auto = "NUEVO";				*/								/*				// setXml(xmlPar,"document","sucursal_id",sucursal);				*/								/*				if ( tip_ope_original &= "A" && tip_ope &= "C" ) {					setXml(xmlPar,"document","fech_oper", fech_oper); 				}				setXml(xmlPar,"document","tipo_auto", tipo_auto);				*/								//code Added 20221208 by JMM				/*				if ( strlen(frn.get("k_fecha")) > 0 ) { 					setXml(xmlPar,"document","fech_I", frn.get("k_fecha"));				}				if ( strlen(frn.get("k_fecha_F")) > 0 ) { 					setXml(xmlPar,"document","fech_F", frn.get("k_fecha_F"));				}					*/								/*				//setXml(xmlPar,"document","folio",frn.get("k_folio"));				//setXml(xmlPar,"document","fecha",frn.get("k_fecha"));				*/								/*				frn.lib("libGeneral.kpl","FileSave",xmlPar, fileSavePath & "\refalatapedcrud_rpt_xmlPar");												cmd="select * from keplersc.autos_com_asig_rpt('"& getXmlStr(xmlPar,"EOF:13_10") &"')";				rstXml(xmlResQuery);				xmlResQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comaltasigcrudN_rpt.Ejecuta_Reporte()");				ok=getXmlAtt(xmlResQuery ,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlResQuery ,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						frn.lib("libGeneral.kpl","FileSave",xmlResQuery, fileSavePath & "\comaltasigcrudN_rpt_xmlResQuery");								*/								Reporte();						} /* END Func Ejecuta_Reporte() */						fun Reporte() {							// Our Vars				var compania, titrep;				var contProd, contDet, tmpStr ,xmlDet, xmlCurDocto;				//var folio;				var p_fecha, var_fecha;				var p_subtotal, p_utilidad, p_perce, p_costo, p_total, p_iva;				var gt_subtotal, gt_utilidad, gt_perce, gt_costo, gt_total, gt_iva;								//Obtener datos generales				kdb.kde("KDE");//Configuracion del servidor				kdb.exec();				compania = kdb.get("KDE","1");									// Se define el formato a usar y se liga a la variable del reporte "rep"	// Se define el formato a usar y se liga a la variable del reporte "rep"				rep.rst(); // 20121208				IniParams(); // 20121208				kdb.readPage("datFto","refaltapedcrudfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				//rep.rst(); // 20121208				setRepPage();//Establece los parámetros finales de impresión(rep.page(...);), pues pueden haber cambiado por el usuario 				//Da valor a los inputs del reporte(rep.set();), e indica la ejecución de "grupos de renglones de impresión" (rep.exe();)								/*				if ( tip_ope_original &= "A" && tip_ope &= "C" ) {					titrep = "Asignacion del Inventario - Autos Nuevos"; 					rep.set("suctx","suc.");					rep.set("leyendatx","Del dia " & fech_original);				} else {					titrep = "Unidades Asignadas sin dar de Entrada la Compra - Autos Nuevos";					rep.set("leyendatx","Sucursal " & sucursal);				}				*/								titrep = "Pedido de Refacciones";								//code Added 20221208				/*				if ( tip_ope_original &! "A" && tip_ope &= "C" ) {					if ( strlen(frn.get("k_fecha")) > 0 ) { 						rep.set("fechItx","Desde : ");						rep.set("fechI",frn.get("k_fecha"));					}					if ( strlen(frn.get("k_fecha_F")) > 0 ) { 						rep.set("fechFtx","Hasta : ");						rep.set("fechF",frn.get("k_fecha_F"));							}					}				*/												rep.set("fecha",sys.date());				rep.set("hora",sys.time());				rep.set("nombreempresa",compania);				rep.set("tituloreporte",titrep);								rep.set("suc",sucursal);				rep.set("foldoc",frn.get("k_folio"));				rep.set("fechdoc",frn.get("k_fecha"));								rep.set("leyendatx",frn.get("c_st"));								//contProd=nXml(xmlResQuery);				contProd=frn.N("k_mov");				rep.exe("encabezado");														for(var x=0; x<contProd; x++){									/*					rep.set("invent",getXmlAtt(xmlResQuery,"r"&x,"c_cveinv"));					rep.set("modelo",getXmlAtt(xmlResQuery,"r"&x,"c_cvemod"));					rep.set("anio",getXmlAtt(xmlResQuery,"r"&x,"c_anio"));					rep.set("descrip",getXmlAtt(xmlResQuery,"r"&x,"c_descrip"));					rep.set("serie",getXmlAtt(xmlResQuery,"r"&x,"c_serie"));					rep.set("color",getXmlAtt(xmlResQuery,"r"&x,"c_color"));					rep.set("vest",getXmlAtt(xmlResQuery,"r"&x,"c_vest"));					if ( tip_ope_original &= "A" && tip_ope &= "C" ) {						rep.set("suc",getXmlAtt(xmlResQuery,"r"&x,"c_suc"));					}					*/											rep.set("reemplazo",frn.get("k_mov",x,"c_reemplazo"));					rep.set("producto",frn.get("k_mov",x,"k_parte"));					rep.set("descrip",frn.get("k_mov",x,"k_descr"));					rep.set("cantidad",frn.get("k_mov",x,"k_q"));					rep.set("um",frn.get("k_mov",x,"k_unidad"));					rep.set("importe",frn.get("k_mov",x,"k_monto"));					rep.set("stock",frn.get("k_mov",x,"c_stock"));					rep.set("especial",frn.get("k_mov",x,"c_especial"));										rep.exe("detalle");				}						rep.set("c_subt",frn.get("k_monto"));				rep.set("c_iva",0);				rep.set("c_tot",frn.get("k_monto"));								rep.exe("total");										rep.set("c_cmnt1",frn.get("k_coment"));				rep.set("c_cmnt2",frn.get("k_coment2"));				rep.set("c_cmnt3",frn.get("k_coment3"));								rep.exe("coments");								//Modos de impresión 				rep.win(); //Muestra la vista previa de la impresión. A partir de la vista previa (Preprint) se decide si se imprime o no.				//rep.print("\\192.168.1.100\HPLaserJet"); //Envía el reporte directamente a una impresora, sin mostrar la vista previa.				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresión. No muestra la vista previa.				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardará el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html										} /* END Func Reporte() */									// END : ZONA	CODIGO REPORTE(S) 										} // End of class Main			</script></pag>