<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Tabla de Porcentajes"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">	<tab/><txt fnt=",22" clr="0,0,0">Tabla de Porcentajes</txt><tab/>	<br/>		<tab/><hLine clr="0,0,0"	dim="45,0,0,0"/>	<br/>	<br/><tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="45,25,10,17" brdr="0,5" tit="Tabla de Porcentajes" fnt="Arial,16">			<sp/><txt>Tipo de Comision:</txt>		<cmb id="tipo_comision" dim="25,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y" fnt="Arial,0" Null="N" OnChange="ResetDetalle()"/>	<tab/>		<img id="img_buscar" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="ObtenerTipoComision()"/>			<br/>		<sp/>				<tbl id="k_mov" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="85,20" modify="Y" Reorder="Y" available="Y" insdel="Y">			<col name="Inferior" id="limite_inferior"  type="number"  nc="5" visible="Y"/>			<col name="Superior" id="limite_superior"  type="number"  nc="5" visible="Y"/>			<col name="Prc" id="prc" type="number" visible="Y"/>			<col name="Prc1" id="prc_1" type="number"  nc="5" visible="Y"/>			<col name="Prc2" id="prc_2" type="number"  nc="5" visible="Y"/>			<col name="Prc3" id="prc_3" type="number"  nc="5" visible="Y"/>			<col name="Prc4" id="prc_4" type="number"  nc="5" visible="Y"/>			<col name="Notas Desc" id="notas_desc" type="number"  nc="5" visible="Y"/>			<col name="Gastos Adm" id="gastos_adm" type="number"  nc="5" visible="Y"/>				<col name="Seguro" id="seguro" type="number"  nc="5" visible="Y"/>			<col name="Accesorios" id="accesorios" type="number"  nc="5" visible="Y"/>			<col name="Garantia Ext" id="garantia_ext" type="number"  nc="5" visible="Y"/>			</tbl>		<br/><sp/>		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Guardar" hk="K" default="1" step="0"  OnEnter="Guardar()" fnt="Arial,16"/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, tipo_comision ;		var cmdQuery, cuboQuery, ok, mensajeError;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			rol_usuario = frn.config("user","role");									llena_combos();			ConfiguraUI();			Inicializa();		}            		fun llena_combos(){							//tipo comision			cmdQuery = "select '[' || c1 || '] ' || c2 as descripcion,c1 as clave from keplersc.kdtipocomis";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_porcentajes.llena_combos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}						llenar_cmb(cuboQuery ,"tipo_comision");				ResetDetalle();		}				fun ResetDetalle(){			frn.rst("k_mov");			tipo_comision = frn.get("tipo_comision", -1, 1);		}				fun ObtenerTipoComision(){			var xmlPantalla;			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			cmdQuery = "select c2 as  limite_inferior, c3 as limite_superior, c4 as prc, c5 as prc_1, c6 as prc_2, c7 as prc_3, c8 as prc_4 ";			cmdQuery  = cmdQuery  & " , c9 as notas_desc , c10 as gastos_adm, c11 as seguro, c12 accesorios, c13 as garantia_ext from keplersc.kdporcentajes  where c1='" & tipo_comision & "'";					rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_porcentajes.ObtenerTipoComision");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_mov",cuboQuery);					}				fun Guardar(){			var xmlPantalla,no_partidas,resultado,mensaje,adicionales;			//Validaciones			no_partidas=frn.N("k_mov")-1;			if (no_partidas==0) {				frn.message("Error, no se tiene registros de configuración","Error","Aceptar");				return;			}			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;						setXml(xmlPantalla ,"k_partidas","no_partidas",no_partidas);						frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaLineas");			cmdQuery="select * from keplersc.porcentajes_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						kdb.rst(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"carga_refacciones.Alta");			resultado= getXml(cuboQuery,"resultado");			mensaje= getXml(cuboQuery,"mensaje");							if(resultado &= "0"){				frn.message(mensaje,"Error","Aceptar");				return;			}			frn.message("Comision registrada","Mensaje","Aceptar");		}				fun ConfiguraUI(){			if (frn.nParam() == 0){				frn.message("Acción no permitida.","Error","&Aceptar");//				frn.open("redirect",2);				return;			}		}				fun Inicializa(){			frn.rst("gpo_2");						ObtenerTipoComision();		}								fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}			           					}				</script></pag>