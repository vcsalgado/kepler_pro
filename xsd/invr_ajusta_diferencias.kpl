<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Ajusta Diferencias"><grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,10" bclr="192,205,213" unfont="0"	OnF1="Dialog(1,invEntSalAyu)" clrBrdr="0,97,181" tit=""><br/>	<tab/><txt fnt=",22" clr="0,0,0">Ajusta Diferencias</txt><br/><tab/><hLine clr="0,0,0"/><br/><tab n="2"/>		<br/>		<tab/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="53,10,7,12" tit="Datos generales"  fnt="Arial,16"><tab/>		<txt clr="0,58,112" hk="S">Sucursal</txt><tab n="2"/>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="45,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="obtener_datos_sucursal()" available="Y"/><br/><tab/>	   <txt clr="0,58,112">Tipo docto</txt><tab n="1"/>		<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255"  dim="30,36" bclr="255,255,255" brdr="2,0" modify="N" fnt="Arial,16" Null="N" OnChange="TipoMov()" OnEnter="TipoMov()"/><br/>		<inp id="tipo_movto" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N" visible="N"/>		<br/><sp n="1"/> 		<tab n="4"/><inp id="statusdoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/>					<sp/><inp id="datcfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="3,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="1" modify="Y" available="Y" visible="N"/>	</grp><tab/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="26,12,7,12" tit="Documento" fnt="Arial,16">		<tab n="3"/><inp id="operacion" clr="64,64,64"  dim="18,1" brdr="0,1" fnt=",18bs" available="N" type="string"/><br/><tab n="2"/>	<txt id="foliotxt"  visible="N" hk="F" clr="0,58,112" fnt="Arial,16">Folio</txt><tab/>		<edt id="k_folio" clr="64,64,64" modify="N" tooltip=" F9 buscar folio "  OnChange="SeparaFolio()"  available="Y" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" visible="N" hk="F" type="text"  OnF9="ObtenerFolio()" OnButton="ObtenerFolio()"  nc="10"/>		<sp/><img id="k_buscar_folio" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="buscar_datos()" tooltip="Consultar documento" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>		<br/><tab n="2"/>	<inp id="k_docto" clr="64,64,64"  dim="18,1" brdr="0,1" fnt="Arial,16" available="N" link="k_tipon,5" type="string"/><br/>		<tab n="2"/><txt clr="0,58,112" fnt="Arial,16">Fecha</txt><tab n="1"/><edt id="k_fecha" dim="14,1" fmt="DD/MM/CCYY"  clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" modify="N"/>		<br/>		<tab n="2"/><txt>Hora:</txt><tab n="2"/>		<inp id="k_hora" dim="6,1" bclr="255,255,255" nc="-1" clr="64,64,64"  clrBrdr="255,255,255" type="time" brdr="2,0" modify="N"/>	</grp><br/><br/>	<tab/>		<br/>	<tab/>		<grp  bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="0" clrBrdr="0,58,112" dim="80,63,7,10" brdr="1,5"  fnt="Arial,16"><tab/><br/>		<br/>			<tab n="3"/>			<inp id="estatus_doc" clr="64,64,64"  dim="14,1" fnt="Arial,16s" available="N"/>						<tab n="19"/><txt fnt="Arial,16s" clr="0,58,112" bclr="255,255,255">IMPORTE</txt> 			<inp id="k_monto" clr="64,64,64"  dim="14,1" fnt="Arial,16s" type="number" nd="2" available="N"/>			<tab n="1"/>			<img id="calcula" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="calcula()" tooltip="calcula inventario" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		<br/>		<tab n="3"/>	<br/><tab n="2"/><txt fnt=",18">Refacciones capturadas (inventariadas)</txt><br/>			<tab n="2"/>			<tbl id="tabla" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="100,12"  hk="z" OnChange="" Reorder="Y" modify="N">			<col id="producto" name="Producto"  modify="N"/>			<col id="inv_teorico" name="Inv Teorico" modify="N" type="number" visible="Y" nd="2"/>			<col id="costo_teorico" name="Costo Teorico" modify="N" type="number" visible="Y" nd="6"/>			<col id="inv_fisico" name="Inv Fisico" modify="N" type="number" visible="Y" nd="2"/>			<col id="costo_fisico" name="Costo Fisico" modify="N" type="number" visible="Y" nd="6"/>			<col id="inv_dif" name="Inv Diferencia" modify="N" type="number" visible="Y" nd="2"/>			<col id="costo_dif" name="Costo Diferencia" modify="N" type="number" visible="Y" nd="6"/>			<col id="estatus" name="Estatus" type="string" modify="N" visible="Y"/><col id="ubica1" name="ubicacion A" type="string" modify="N" visible="Y"/><col id="ubica2" name="ubicacion B" type="string" modify="N" visible="Y"/><col id="ubica3" name="ubicacion C" type="string" modify="N" visible="Y"/>			</tbl>		<tab n="1"/>		<img id="Exportar" dim="25,25" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(tabla)" available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Generar Excel"/>				<br/><br/>				<tab n="2"/>			<txt fnt="Arial,18" clr="0,58,112" bclr="255,255,255">Refacciones sin Capturar</txt><br/>							<tab n="2"/>						<tbl id="refs_sin_capturar" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="100,8"  hk="z" OnChange="" Reorder="Y" insdel="N" modify="N">		<col id="producto" name="Producto"  modify="N"/>		<col id="ent_ctd" name="Entradas Cantidad" modify="N" type="number" visible="Y"/>		<col id="sal_ctd" name="Salidas Cantida" modify="N" type="number" visible="Y"/>		<col id="ent_monto" name="Entradas Monto" modify="N" type="number" visible="Y"/>		<col id="sal_monto" name="Salidas Monto" modify="N" type="number" visible="Y"/>		</tbl><tab/>		<img id="Exportar_sin" dim="25,25" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(refs_sin_capturar)" available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Generar Excel"/>		<br/>		<tab n="2"/>		<txt clr="230,74,26" fnt=",b">* Se podra realizar el movimiento de alta de ajuste hasta que esta lista este vacia. </txt>		<br/>	<br/>			<tab n="2"/>			<txt clr="0,58,112">Comentarios</txt>			<br/>	<br/>				<tab n="2"/><inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="90,3" bclr="255,255,255" brdr="2,0" available="N" fnt="Arial,16" nr="3,60" modify="Y" type="string" available="Y"/>						<br/><br/>	<br/><tab n="30"/>			<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="N"/><tab/>			<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/><tab/>	</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb, sys, rep;			var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, anio_contable,limite_credito ,usuario,suc_usuario, perfil_usuario,asterisco,calle_cli,colonia_cli,poblacion_cli,codigo_p_cli;			var especificaciones_doc, estatus_doc ;			var monto_total,uen;			var folio, sucursal_id , cmdQuery, entrada_salida,rol_usuario    ;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();				sys=new SYS;				rep=new REP;							suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								if(frn.param(0)&= "")				{					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}									tip_ope=trim(frn.param(0));				uen=trim(frn.param(1));								if (uen &= ""){					uen="XXX";				}				ctrls_off();				Inicializa();										}					fun Inicializa(){				kdb.kde("KDE");//								Configuraciï¿½n del servidor				kdb.exec();				anio_contable = kdb.get("KDE","14");			//MSS----------------------				usuario = frn.config("user","name");			//-------------------------						var cmd, cubo, ok,resValidacion,resMensaje ;											frn.set("k_vence",sys.date());								frn.set("k_hora",sys.time());										//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));							frn.set("k_fecha", sys.date());				frn.set("k_hora",sys.time());								frn.set("k_coment", "Ajuste de Refacciones");								obtener_datos_sucursal();				//if (tip_ope &= "A"){				//	refs_capturadas();				//}				//refs_sin_capturar();			}						fun obtener_datos_sucursal(){				if (tip_ope &= "A"){					refs_capturadas();				}				refs_sin_capturar();						}						fun refs_sin_capturar(){				var suc = frn.get("k_sucn", -1, 1);				var cmd = "select inl.c2 as producto, inl.c5 as ent_ctd, inl.c6 as sal_ctd, inl.c8 as ent_monto, inl.c9 as sal_monto ";				cmd = cmd & "from keplersc.kdinl inl where c1= '" & suc & "' " ;				cmd = cmd & "and (inl.c5-inl.c6<>0 or inl.c8-inl.c9<>0) " ;				cmd = cmd & "and c2 not in (select c2 from keplersc.kdifis ifis where ifis.c1= '" & suc  & "' and ifis.c2=inl.c2 and ifis.estatus='REGISTRADO') " ;								frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdFaltantes");								var cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_ajusta_diferencias.refs_sin_capturar()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");					var resultado=getXmlAtt(cuboResultados, "r0" ,"resultado");								if(resultado &= "0"){					var mensajeError = getXmlAtt(cuboResultados, "r0" ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.setX(cuboResultados, "refs_sin_capturar" );			}						fun	refs_capturadas(){				var xmlRequest, cmd, cuboResultados, ok ,mensajeError, suc ;				var resultado;								suc=frn.get("k_sucn", -1, 1);				frn.rst("tabla");							cmd = "select ifis.c2 as producto, cantidad_sis as inv_teorico, costo_invent_sis as costo_teorico, ifis.c6 as inv_fisico, costo_invent_real as costo_fisico, ifis.c9 as inv_dif, ifis.c10 as costo_dif, estatus,loc.c4 as ubica1, loc.c5 as ubica2, loc.c6 as ubica3  ";				cmd = cmd & "from keplersc.kdifis ifis left outer join keplersc.kdlocref loc on loc.c1=ifis.c1 and loc.c2=ifis.c2 where ifis.c1= '" & suc & "' and ifis.estatus='REGISTRADO'" ;								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_ajusta_diferencias.refs_capturadas()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboRefsCap");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}					frn.setX(cuboResultados, "tabla" );			}										fun calcula(){				var xmlRequest, cmd, cuboResultados, ok ,mensajeError, suc ;				var resultado;				suc=frn.get("k_sucn", -1, 1);								//Valida que no se tengan refacciones pendientes de registros o con error								cmd="select count(*) as total from keplersc.kdifis where c1='" & suc & "' and estatus <> 'REGISTRADO' ";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_ajusta_diferencias.calcula()");				resultado=getXmlAtt(cuboResultados, "r0" ,"total");				if(resultado > 0){					mensajeError = "Se tienen refacciones sin registro o con errores, revisar en la opción Cargar CSV o Capturar Inventario.";					frn.message(mensajeError,"Error","Aceptar");					return;				}				setXml(xmlRequest,"document","k_sucn", "r1",frn.get("k_sucn", -1, 1));				frn.rst("tabla");				frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestREFS");				cmd="select * from keplersc.invr_fisico_ajuste('" & getXmlStr(xmlRequest,"EOF:13_10") & "', ' ' )";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_ajusta_diferencias.calcula()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");				resultado=getXmlAtt(cuboResultados, "r0" ,"resultado");								if(resultado &= "0"){					mensajeError = getXmlAtt(cuboResultados, "r0" ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.setAtt("Aceptar", "visible", "N" );				if(resultado &= "1"){					var importe = getXmlAtt(cuboResultados, "r0" ,"mensaje");					frn.set("k_monto", importe);											cuboResultados= getXmlAtt(cuboResultados,"r0","adicionales");					cuboResultados= delScpScn(cuboResultados);					setXmlStr(cuboResultados,cuboResultados);									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\productos  ");								var totres = nXml(cuboResultados);									for (var cont=0; cont<=totres ; cont++){							frn.setX(getXml(cuboResultados, "r" & cont, "producto"), "tabla", cont , "producto");						frn.setX(getXml(cuboResultados, "r" & cont, "inv_teorico"), "tabla", cont , "inv_teorico");						frn.setX(getXml(cuboResultados, "r" & cont, "costo_teorico"), "tabla", cont , "costo_teorico");						frn.setX(getXml(cuboResultados, "r" & cont, "inv_fisico"), "tabla", cont , "inv_fisico");						frn.setX(getXml(cuboResultados, "r" & cont, "costo_fisico"), "tabla", cont , "costo_fisico");						frn.setX(getXml(cuboResultados, "r" & cont, "inv_dif"), "tabla", cont , "inv_dif");						frn.setX(getXml(cuboResultados, "r" & cont, "costo_dif"), "tabla", cont , "costo_dif");						frn.setX(getXml(cuboResultados, "r" & cont, "estatus"), "tabla", cont , "estatus");					}					if (importe==0){						frn.message("Inventario Calculado, no hay diferencis a ajustar","Atencion","Aceptar");						inserta_mov(importe);						frn.setAtt("Aceptar", "visible", "N" );										}else{						frn.message("Inventario Calculado","Atencion","Aceptar");						inserta_mov(importe);						frn.setAtt("Aceptar", "visible", "Y" );									}					}			}						fun inserta_mov(importe){				gen_doc="N"; 				nat_doc="D"; 				gpo_doc="05";				tip_doc="1";				combo_tipodoc();			}						fun combo_tipodoc(){							sucursal_id=frn.get("k_sucn",-1,1);									//Llenar combo tipo docto				var cmd = "select '[' || c4 || '] ' || c5 as c5,c1,c2,c3,c4 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and col_sucursal='" & sucursal_id & "'";								var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Inicializa()");								var ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_tipon",getXml(cubo));									tip_doc=1;				folio = "0000000";							especificaciones_doc =  gen_doc & nat_doc & gpo_doc & 0 & tip_doc & "-" & folio  ;								frn.set("k_docto",especificaciones_doc);									}									fun ctrls_off() {				frn.setAtt("foliotxt", "visible", "N" );				frn.setAtt("k_folio", "visible", "N" );				frn.setAtt("k_buscar_folio", "visible", "N" );				frn.setAtt("Aceptar", "visible", "N" );				frn.setAtt("Cancelar", "visible", "N" );				frn.setAtt("calcula", "visible", "N" );				frn.setAtt("k_coment","modify", "N");				if (tip_ope &= "A"){					botones_alta();				}else if(tip_ope &= "B"){					botones_baja();				}else{					botones_consulta();				}			}				fun botones_alta(){							frn.set("operacion","ALTA");				frn.setAtt("Aceptar", "visible", "N" );				frn.setAtt("Cancelar", "visible", "N" );				frn.setAtt("calcula", "visible", "Y" );				frn.setAtt("k_coment","modify", "Y");			}									fun botones_baja(){				frn.set("operacion","BAJA");				frn.setAtt("foliotxt", "visible", "Y" );				frn.setAtt("k_buscar_folio", "visible", "Y" );				frn.setAtt("k_folio", "visible", "Y" );				frn.setAtt("Aceptar", "visible", "Y" );				frn.setAtt("Cancelar", "visible", "N" );							}						fun botones_consulta(){				frn.set("operacion","CONSULTA");				frn.setAtt("foliotxt", "visible", "Y" );				frn.setAtt("k_buscar_folio", "visible", "Y" );				frn.setAtt("k_folio", "visible", "Y" );							}						fun BorraDatos() {				//frn.rst("estatus_doc");				//frn.rst("k_tipon");				//frn.rst("k_docto");				//frn.rst("k_coment");				//frn.rst("k_monto");				//frn.set("k_fecha", sys.date());				//frn.set("k_hora",sys.time());			}						fun Ejecuta(){				var tipo_ope,n_prods,n_movtos;				if (tip_ope &= "A"){					tipo_ope = "Alta";									}else{					tipo_ope = "Baja";				}								n_prods = frn.N("refs_sin_capturar");				n_prods = n_prods - 1;				if (n_prods > 0){					frn.message("Error hay " & n_prods & " productos sin capturar. ", "Mensaje", "Aceptar");					return;				}				n_movtos=frn.N("tabla");				n_movtos=n_movtos-1;				if (n_movtos < 1){					frn.message("No hay movimientos a procesar.", "Mensaje", "Aceptar");					return;				}												if (frn.get("estatus_doc") &= "CANCELADO" ){					frn.message("Error el documento ya esta cancelado", "Mensaje", "Aceptar");					return;				}						var continua = frn.message("¿Desea continuar dando de " & tipo_ope & " el ajuste?","Atención",2);				if (continua == 0){					return;				}				var xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;								var fecha = sys.date();								var strFecha = fnDate("year",fecha) & "-";				var strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								var hora = sys.time();				setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"operacion",tipo_ope );				setXml(xmlPantalla,"proceso","ifis"); 				//parametro se pasa evitar que pase por mov_sec_alta				setXml(xmlPantalla,"k_mov", "no_partidas",0); 					frn.lib("libGeneral.kpl","FileSave",xmlPantalla, "C:\Basura\XmlPantalla");							cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\cmdBajaInvFis");											var cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"venfactorden.Ejecuta");																	var resultado = getXml(cuboQuery,"resultado");				var mensaje = getXml(cuboQuery,"mensaje");				if(resultado &= "1") {									frn.set("k_folio", mensaje);											var strMsg ;					if (tip_ope &= "A"){						strTmp = frn.get("k_docto");						strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;						frn.set("k_docto", strTmp);						strMsg = "El Folio utilizado para esta operacion fue : " & mensaje;										}else{						strMsg = "Documento con Folio : " & mensaje & " dado de baja correctamente.";					}									tip_ope = "C";					frn.set("operacion", "CONSULTA");					ctrls_off(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");													} else {					frn.message(mensaje, "Error", "Aceptar");					frn.lib("libGeneral.kpl","FileSave",mensaje, "C:\Basura\mensaje");										return;				}					}						fun buscar_datos(){				var cmd,xmlRequest,xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError,   ;				sucursal_id = frn.get("k_sucn",-1,1);				var nFolio = frn.get("k_folio");				if (nFolio &= ""){					return ;				}				if (entrada_salida &= "Entrada" ){					gen_doc="N"; 					nat_doc="A"; 					gpo_doc="20";					tip_doc="1";									}else{					gen_doc="N"; 					nat_doc="D"; 					gpo_doc="05";					tip_doc="1";				}								combo_tipodoc();									cmd= " select  c9 as k_fecha,c69 as k_hora ,c16 as k_monto, c24 as k_coment, c43 as estatus_doc from keplersc.kdm1 " ;							cmd = cmd & " where c1='" & sucursal_id  & "' and c2='" & gen_doc  &"' and c3='" & nat_doc & "' and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_ajusta_diferencias.buscar_datos()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");									var ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				var xml_kdm1  = getXml(cuboResultados,"r0" );				frn.set("k_monto",getXmlAtt(xml_kdm1   ,"k_monto") );												var estatus = getXmlAtt(xml_kdm1   ,"estatus_doc");								if (estatus &= "C"){					frn.set("estatus_doc","CANCELADO");				}				frn.set("k_coment",getXmlAtt(xml_kdm1   ,"k_coment") );				if (tip_ope &= "C"){					frn.set("k_fecha",getXmlAtt(xml_kdm1 ,"k_fecha") );					frn.set("k_hora",getXmlAtt(xml_kdm1  ,"k_hora") );				}else{					frn.set("k_fecha",sys.date());					frn.set("k_hora",sys.time());					}									cmd= " select c8 as producto, c9 as inv_teorico, c10 as costo_teorico, c11 as inv_fisico, c12 as costo_fisico, c13 as inv_dif, c14 as costo_dif  " &						 " from keplersc.kdinvrdif where c1='" & sucursal_id  & "' and c2='" & gen_doc  &"' and c3='" & nat_doc & "' and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_ajusta_diferencias.buscar_datos()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");									ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.setX(cuboResultados, "tabla");				}												fun ObtenerFolio() {				sucursal_id = frn.get("k_sucn",-1,1);				cmdQuery = "select c6 || '-' || case when c3='A' then 'Entrada' else 'Salida' end as identificador, sum(c14) as monto  " &						" from keplersc.kdinvrdif where c1='" & sucursal_id & "' group by c2,c3,c4,c5,c6 order by c6 desc ";										frn.dialog("genlistafiltrosel","Folios de Ajustes",cmdQuery,"identificador","k_folio","0","","S");			}						fun SeparaFolio(){				BorraDatos();				var ident = frn.get("k_folio");				var fol = strSplit(ident ,"-",0); 				frn.set("k_folio", fol);				entrada_salida = strSplit(ident ,"-",1); 				frn.rst("tabla");			}						fun guardar_tabla(tabla){				var save = frn.saveFile("inv_dif","Todos los archivos,*.*","_C:","Para guardar archivo");				frn.dialog("guarda_tabla",tabla,save); 			}					/*			fun Valida_Tipo_Docto(){				var resValidacion, resMensaje, cubo, cmd, ok;							//Valida documento vigente				kdb.rst();				cmd= "select * from keplersc.verify_valid_document('" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & frn.get("k_tipon",-1,4) & ")"; //genero text, naturaleza text, grupo integer, tipo_movto integer				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"venfactdirecta.Valida_Tipo_Docto()");				resValidacion= getXml(cubo,"validacion","resultado");				resMensaje = getXml(cubo,"validacion","mensaje");				if(resMensaje &! ""){					frn.message(resMensaje, "Mensaje","&Aceptar");					frn.setPos("k_tipon");				}										}			*/			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaciï¿½n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaciï¿½n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para pï¿½ginas de operacion:Solo si se estï¿½ en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverï¿½ el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				//else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}					}	</script></pag>