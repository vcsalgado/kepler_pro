<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Configura Contact Center">
<grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="1,-1,7,11" bclr="192,205,213" unfont="0">
	<tab/><txt fnt=",22" clr="0,0,0">Configura Contact Center</txt><tab/>
	<br/>
	<tab/>
	<hLine clr="0,0,0"/>
	<br/><br/>
	<tab/>
	<grp id="gpo_1" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" 
		clrBrdr="0,58,112" dim="85,7,7,11" brdr="0,5" tit="Criterio de selecci&#243;n" fnt="Arial,16">
        <tab/><txt>Sucursal:</txt>
		<sp/>
		<cmb id="k_sucn" dim="35,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="Y"  OnChange="CambiaSucursal()" tooltip="Sucursal"/>
        <tab/>
        <img id="img_buscar" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="BuscarCC()"/>	
        <br/>
	</grp>
	<br/><br/><tab/>
	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 
		dim="85,10,7,11" brdr="0,5" tit="Detalle de Contact Center" fnt="Arial,16" available="N">
		<tab/><txt>% Asesor CC :</txt><tab/>
        <inp id="k_porcasesorcc" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" tooltip="Porcentaje Asesor Contact Center"/>
        <br/><tab n="25"/>
		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" default="0" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>

	</grp>
</grp>
<script>
	InstallDriver("KDB75");
	class Main {
		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;
		var tipoOper; //Variables relacionadas con parametros
		var clave, sucursal_id, esquema_id; 
		var cmdQuery, cuboQuery, ok, mensajeError,resVal;
		fun Main(){
			frn=new FRNT;
			kdb=new KDB;
			frP=new FRNTP;
			sys=new SYS;
			kdb.connect();
			
			suc_usuario = frn.lib("libKepler","UserInfo(1)");
			perfil_usuario = frn.lib("libKepler","UserInfo(2)");
			rol_usuario = frn.config("user","role");
			asterisco = "*";
			tipoOper = frn.param(0);
			clave = frn.param(1);
			llena_combos();
			ConfiguraUI();
			Inicializa();
		}
            
		fun llena_combos(){
			//Llenar combo sucursales
			var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";
			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){
				cmd = cmd & " where c1='" & suc_usuario & "'";
			}else {
				if (suc_usuario &! asterisco && suc_usuario &! "" ){
					cmd = cmd & " where c1='" & suc_usuario & "'";
				}
			}
				
			var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");		
			ok=getXmlAtt(cubo,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cubo,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
					
			frn.set("k_sucn",getXml(cubo));
					
		}

        fun CambiaSucursal(){
            ResetCC();
        }

		fun ResetCC(){
            frn.set("k_porcasesorcc", "");
        }

		fun BuscarCC(){
			var xmlProd, suc, esq, nuevo;
            suc = frn.get("k_sucn",-1,1);
                  
			cmdQuery = "select c2 as k_porcasesorcc " &
                    "from keplersc.kdconfigcc " &
                    "where c1=1 and c3 ='" & suc & "'";
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_contcent.BuscarCC");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}

            if(nXml(cuboQuery) == 0){
				frn.setPos("k_porcasesorcc");
				nuevo = frn.message("La configuracion de contact center no existe. Desea crearlo como nuevo?","Atencion",2);
				if (nuevo == 0){
                    
                    frn.setAtt("gpo_2", "available", "N");
					return;
                }else{
                    frn.setAtt("gpo_2", "available", "Y");   
				}
			}else {
            rstXml(xmlProd);
			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");
            ResetCC(); //Limpiar antes de cargar datos
            frn.setAtt("gpo_2", "available", "Y");
			frn.setX(xmlProd);
            }	
		}
		
        fun ValidarDatos(){
            var porc_asesorcc;
            //Validar Porcentaje de asesor CC
			porc_asesorcc = frn.get("k_porcasesorcc");
			if (porc_asesorcc &= ""){
				frn.setPos("k_porcasesorcc");
				resVal=0;
				frn.message("Es necesario indicar el % del Asesor Contact Center","Error","Aceptar");
				return;	
			}
        }

		fun Ejecuta(){
			var xmlPantalla,continua,resultado,mensaje,adicionales;
		    resVal = 1;
			ValidarDatos();
			if(ok &! "1" || resVal == 0){
				return;
			}

            continua = frn.message("Desea continuar?","Atencion",2);
			if (continua == 0){
				return;
			}

			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
			
			frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaCatEsquemas");
			cmdQuery="select * from keplersc.com_contcent_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";			
			kdb.rst(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_contcent_crud");
			resultado= getXml(cuboQuery,"resultado");
			mensaje= getXml(cuboQuery,"mensaje");
				
			if(resultado &= "0"){
				frn.message(mensaje,"Error","Aceptar");
				return;
			}
            //frn.setPos("k_sucn);
			frn.message("Configuracion Contact Center registrada","Mensaje","Aceptar");
            BuscarCC();
            frn.setAtt("gpo_2", "available", "N");
		}
		
		fun ConfiguraUI(){
			if (frn.nParam() == 0){
				frn.message("Accion no permitida.","Error","&Aceptar");
//				frn.open("redirect",2);
				return;
			}
		}		

		fun Inicializa(){
			ResetCC();
		}         
				
	}
	
		
	</script>
</pag>