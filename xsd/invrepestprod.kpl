<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Reporte de Estad&#237;stica por producto">	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<tab/><txt fnt=",22" clr="0,0,0">Estad&#237;stica de Productos</txt><br/>		<tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp dim="55,50,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="8" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle de Producto">			<sp/>			<grp dim="55,18,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,14" hSpace="0" clrBrdr="0,58,112" brdr="1,4" fnt="Arial,16" tit="Criterio de selecci&#243;n">				<sp/><txt>Sucursal:</txt><tab/><cmb id="cmb_sucursal" dim="41,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 					  Null="N" modify="Y" available="Y" OnChange="ObtenerLocalicacion()"/><br/><br/>				<sp/><txt>Producto:</txt>				<tab/><edt id="edt_prod" dim="25,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" fnt="Arial,16"					OnF9="ConsultaProductos()" OnChange="Execute(1)"/><br/>				<sp/><txt>Clave original:</txt>				<inp id="k_claveoriginal" dim="14,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="N" available="N"/>				<sp/><txt>Clave actual:</txt>				<inp id="k_claveactual" dim="14,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="N" available="N"/><br/><br/>				<sp/><txt>A&#241;o: </txt>				<tab n="2"/><inp id="inp_anio" dim="5,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="0" min="2020" fmt="5" max="2050"					OnChange="Execute(0)"/><br/><br/>				<sp/><txt>Localizaci&#243;n:</txt>				<inp id="k_loc1" dim="8,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" OnChange="Execute(2)" modify="N"/><tab/>				<inp id="k_loc2" dim="8,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="N" available="N"/><tab/>				<inp id="k_loc3" dim="8,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="N" available="N"/><br/><br/><br/><br/>				<sp/><bot id="bot_precios" dim="20,0" brdr="5" text="Tabla de Precios" default="0" OnChange="MostrarListaPrecios()"/>			</grp><tab/>			<grp dim="60,18,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,14" hSpace="0" clrBrdr="0,58,112" brdr="1,4" fnt="Arial,16" tit="Detalle estadistico del producto">				<sp/><inp id="k_descproducto" dim="55,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="N" available="N"/><br/>							<sp/><txt>Unidad:</txt><sp n="3"/><inp id="k_unidad" dim="5,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>				<tab n="2"/><sp/><txt>Clasificaci&#243;n: </txt><inp id="k_clasificacion" dim="5,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>				<sp n="1"/><txt>L&#237;nea:</txt><sp/><inp id="k_linea" dim="5,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/><br/>				<sp/><txt>Backorder:</txt>				<sp/><inp id="k_backorder" dim="10,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R"/>				<sp/><txt>Phase:</txt>				<sp/><inp id="k_phase" dim="10,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" just="L"/><br/>				<sp/><txt>MAD: </txt>				<inp id="k_mad" dim="10,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R"/>								<sp/><txt>MIP: </txt>				<inp id="k_mip" dim="10,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R"/>				<sp/><txt>M&#225;x. Fluc. Dem: </txt>				<inp id="k_mfd" dim="10,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R"/><br/><br/>				<sp/><txt>Precios sin IVA</txt><br/>				<tab/><sp/><txt>P&#250;blico:</txt>				<tab/><inp id="k_publi" dim="10,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R"/>				<tab/><txt>Interempresa:</txt>				<inp id="k_inter" dim="10,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R"/><br/>				<tab/><sp/><txt>Planta:</txt>				<tab/><inp id="k_prov" dim="10,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R"/>				<tab/><txt>Taller:</txt>				<tab n="3"/><inp id="k_tall" dim="10,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R"/><br/><br/>								<sp/><txt>&#218;ltima compra:</txt>				<tab/><inp id="k_ult_compra" dim="10,1" brdr="2,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="date" modify="N" available="N" fmt="DD/MM/YY" nc="-1"/>				<tab/><txt>Pen&#250;ltima compra:</txt>				<tab/><inp id="k_pen_compra" dim="10,1" brdr="2,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="date" modify="N" available="N" fmt="DD/MM/YY" nc="-1"/><br/>				<sp/><txt>&#218;ltima venta:</txt>				<tab/><inp id="k_ult_venta" dim="10,1" brdr="2,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="date" modify="N" available="N" fmt="DD/MM/YY" nc="-1"/>				<tab/><txt>Pen&#250;ltima venta:</txt>				<tab n="2"/><inp id="k_pen_venta" dim="10,1" brdr="2,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="date" modify="N" available="N" fmt="DD/MM/YY" nc="-1"/>			</grp><br/>			<sp/><grp dim="116,5,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,14" hSpace="0" clrBrdr="0,58,112" brdr="1,4" fnt="Arial,16" tit="Precios Planta"><br/>				<tab/><txt>Costo Distribuidor:</txt><sp/>				<inp id="k_costo_distribuidor_cat" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" just="R" nd="2" available="N" modify="N"/>				<tab n="2"/><txt>Precio Mayoreo: </txt>				<inp id="k_precio_mayoreo_cat" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" just="R" nd="2" available="N" modify="N"/>				<tab n="2"/><txt>Precio Publico: </txt>				<inp id="k_precio_publico_cat" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" just="R" nd="2" available="N" modify="N"/>							</grp><br/>			<sp/><grp dim="32,22,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,14" hSpace="0" clrBrdr="0,58,112" brdr="1,4" fnt="Arial,16" tit="Resumen anual">				<sp/><txt>Cantidad</txt><br/>				<tab/><sp/><txt>Entradas:</txt>				<tab/><inp id="k_cant_ent" dim="14,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R" nd="2"/><br/>				<tab/><sp/><txt>Salidas:</txt>				<tab n="2"/><inp id="k_cant_sal" dim="14,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R" nd="2"/><br/>				<tab/><sp/><txt>Existencias:</txt>				<inp id="k_existencias" dim="14,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R" nd="2" fnt=",0b"/><br/><br/>								<sp/><txt>Monto</txt><br/>				<tab/><sp/><txt>Entradas:</txt>				<tab/><inp id="k_monto_ent" dim="14,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R" nd="2"/><br/>				<tab/><sp/><txt>Salidas:</txt>				<tab n="2"/><inp id="k_monto_sal" dim="14,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R" nd="2"/><br/>				<tab/><sp/><txt>Valor:</txt>				<tab n="2"/><inp id="k_valor" dim="14,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R" nd="2" fnt=",0b"/><br/><br/>				<sp/><txt>Costo promedio:</txt>				<inp id="k_costo_promedio" dim="14,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R" nd="2"/><br/>				<sp/><txt>&#218;ltimo costo:</txt>				<tab/><inp id="k_ult_costo" dim="14,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" just="R" nd="2"/><br/>							</grp><sp/>			<grp dim="83,22,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,14" hSpace="0" clrBrdr="0,58,112" brdr="1,4" fnt="Arial,16" tit="Resumen mensual">				<sp/><tbl id="k_resmens" dim="80,15" brdr="1,1" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" nren="fijo" insdel="N" Reorder="N" modify="N" fixed="0">					<col id="k_mesnum" name="Mes" nc="12" available="N" visible="N"/>					<col id="k_mes" name="Mes" nc="12" available="Y" visible="Y"/>					<col id="k_entcant" name="Ent. Cantidad" nc="12" type="number" nd="2" available="Y" visible="Y"/>					<col id="k_entmonto" name="Ent. Monto" nc="12" type="number" nd="2" available="Y" visible="Y"/>					<col id="k_salcant" name="Sal. Cantidad" nc="12" type="number" nd="2" available="Y" visible="Y"/>					<col id="k_salmonto" name="Sal. Monto" nc="12" type="number" nd="2" available="Y" visible="Y"/>									</tbl><br/>						</grp><br/>					</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,rep,sys,suc_usuario,perfil_usuario ,asterisco ,rol_usuario  ;			var ultimoCriterio;			fun Main() {				frn=new FRNT;				frP = new FRNTP;				kdb=new KDB;				rep=new REP;				sys=new SYS;								kdb.connect();				//kdb.open("i,kdini,j,kdinm,k,kdink,l,kdinl,s,kdms,m,kdmm");				Inicializa();							}						fun Inicializa(){//Inicializa los valores en Pantalla y variables				var fecha;				ultimoCriterio = "";				fecha = sys.date();								frn.set("inp_anio",fnDate("year",fecha));								suc_usuario = frn.lib("libKepler","UserInfo(1)");								perfil_usuario = frn.config("user","role");				asterisco = "*";				rol_usuario = frn.config("user","role");				IniCombos();				ObtenerLocalicacion();				IniParams();//Inicializa parámtros de impresión entre otros			}									fun IniCombos(){				var cmd, cubo , xmlResQuery, ok, mensajeError, strTmp;						//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("cmb_sucursal",getXml(cubo));																			//Llenar combos de productos				kdb.search("datosI,i,1,7,&,i1");				kdb.exec();				frn.set("edt_prod",kdb.get("datosI","i1"));								var externo= frn.param(0);				if (externo &= "s"){					frn.set("cmb_sucursal",	frP.get("k_sucN",-1,0));					var producto = frP.get("k_mov",-1,"k_parte");					frn.set("edt_prod", producto);					Execute(1);					}				}			fun IniParams(){//Inicializa parámetros de impresión, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Página				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}			fun setRepPage() {//Establece los parámetros finales de impresión.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}						fun Execute(criterio) {				if(criterio==0){					criterio = ultimoCriterio; //1=Producto; 2=Ubicacion, 0=Sin criterio				}				if (ValidarInfo(criterio) == 0){					return;				}				ultimoCriterio = criterio;				GenerarReporte(criterio);				ObtenerLocalicacion();			}									fun GenerarReporte(criterio){				var sqlXmlRequest, cmd,ok,mensaje,resultado, sqlXmlUbicacion;				var cuboResProd,xmlResProd,cuboResMens,xmlGenerico;				var strTmp, mensajeError, strValEst;				var producto,productoOrigen;				cuboResProd="datDoc";				strTmp = frn.get("k_loc1");				IniciarValores();								setXml(sqlXmlRequest,"document","sucursal_id",frn.get("cmb_sucursal",-1,1));								if(criterio==1){					producto = frn.get("edt_prod",-1,0);				}				else{					//Validar la ubicacion y obtener el producto					setXml(sqlXmlUbicacion,"document","ubicacion",frn.get("k_loc1"));					cmd="select * from keplersc.prod_obtener_prod_ubi('" & getXmlStr(sqlXmlUbicacion,"EOF:13_10") & "')";					xmlGenerico = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepestprod.GenerarReporte()");					frn.lib("libGeneral.kpl","FileSave",xmlGenerico ,"C:\Basura\xmlGenerico");					ok=getXmlAtt(xmlGenerico,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(xmlGenerico,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						if(memcmp(mensajeError,"P0001",5)==0){							frn.message("Error de logica","Error","Aceptar");						}else{							frn.message(mensajeError,"Error","Aceptar");						}						return;					}					resultado = getXmlAtt(xmlGenerico,"r0","resultado");					mensaje =  getXmlAtt(xmlGenerico,"r0","mensaje");					if (resultado && "1"){						producto = getXmlAtt(xmlGenerico,"r0","mensaje");					}else{						frn.message(mensaje,"Error","Aceptar");						return;					}					frn.set("edt_prod",producto);				}				setXml(sqlXmlRequest,"document","producto",producto);				setXml(sqlXmlRequest,"document","ubicacion",frn.get("k_loc1"));				setXml(sqlXmlRequest,"document","anio",frn.get("inp_anio"));				setXml(sqlXmlRequest,"document","movimiento","usuario",frn.lib("libKepler","UserInfo"));								//Validar que se tiene estadistica del producto				/*								cmd="select count(*) as contReg from keplersc.kdinl where c1='" & frn.get("cmb_sucursal",-1,1) & "' and upper(c2)=upper('" & producto & "')";				cuboResProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepestprod.GenerarReporte()");				ok=getXmlAtt(cuboResProd,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					if(memcmp(mensajeError,"P0001",5)==0){						frn.message("Error de logica","Error","Aceptar");					}else{						frn.message(mensajeError,"Error","Aceptar");					}					return;				}else{					resultado=getXmlAtt(cuboResProd,"r0","contreg");					if (resultado &= "0"){						frn.message("El producto no tiene estadística.","Aviso","Aceptar");										}				}				*/								//Resumen producto				rstXml(cuboResProd);				cmd="select * from keplersc.invr_rep_estxprod_sec_prod_sel('" & getXmlStr(sqlXmlRequest,"EOF:13_10") & "')";				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdResProd");								cuboResProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepestprod.GenerarReporte()");									ok=getXmlAtt(cuboResProd,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					if(memcmp(mensajeError,"P0001",5)==0){						frn.message("Error de logica","Error","Aceptar");					}else{						frn.message(mensajeError,"Error","Aceptar");					}					return;				}								frn.lib("libGeneral.kpl","FileSave",cuboResProd,"C:\Basura\cuboResProd");				strTmp = getXmlAtt(cuboResProd,"r0","invr_rep_estxprod_sec_prod_sel");				setXmlStr(xmlResProd,strTmp);								frn.setX(xmlResProd);				//Verificacion de datos estadisticos				strValEst = "";				strValEst = getXml(xmlResProd,"k_existencias");				productoOrigen=getXml(xmlResProd,"k_claveoriginal");				//Fin Resumen de Producto				//Resumen mensual				setXml(sqlXmlRequest,"document","producto",productoOrigen);	frn.lib("libGeneral.kpl","FileSave",sqlXmlRequest,"C:\Basura\xmlSecRes");								cmd="select * from keplersc.invr_rep_estxprod_sec_resmens_sel('" & getXmlStr(sqlXmlRequest,"EOF:13_10") & "')";				cuboResMens = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepestprod.GenerarReporte()");								ok=getXmlAtt(cuboResMens,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResMens,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);										if(memcmp(mensajeError,"P0001",5)==0){						frn.message("Error de logica","Error","Aceptar");					}else{						frn.message(mensajeError,"Error","Aceptar");					}					return;				}								frn.set("k_resmens",cuboResMens);				//Fin Resumen Mensual												//Precios de producto				rstXml(xmlResProd);				rstXml(strTmp);				rstXml(sqlXmlRequest);				setXml(sqlXmlRequest,"document","sucursal_id",frn.get("cmb_sucursal",-1,1));				setXml(sqlXmlRequest,"document","producto",productoOrigen);				setXml(sqlXmlRequest,"document","precios_request","TALL,PUBLI,PROV,INTER");				setXml(sqlXmlRequest,"document","movimiento","usuario",frn.lib("libKepler","UserInfo"));												frn.lib("libGeneral.kpl","FileSave",sqlXmlRequest,"C:\Basura\sqlXmlRequestPrecios");				cmd="select * from keplersc.invr_calc_precios_sel('" & getXmlStr(sqlXmlRequest,"EOF:13_10") & "')";frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdSecRes");												cuboResProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepestprod.GenerarReporte()");				frn.lib("libGeneral.kpl","FileSave",cuboResProd,"D:\Basura\cuboPreciosProd");												ok=getXmlAtt(cuboResProd,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					if(memcmp(mensajeError,"P0001",5)==0){						frn.message("Error de logica","Error","Aceptar");					}else{						frn.message(mensajeError,"Error","Aceptar");					}					return;				}								strTmp = getXmlAtt(cuboResProd,"r0","invr_calc_precios_sel");				setXmlStr(xmlResProd,strTmp);				frn.setX(xmlResProd);				if (nXml(xmlResProd) > 0) {					mensajeError = getXml(xmlResProd,"errores");					if (mensajeError &! "N"){						frn.message(mensajeError,"Error","Aceptar");					}					}							//Fin Precios del Producto				//Precios planta				producto = frn.get("edt_prod",-1,0);				cmd="select c6 as k_costo_distribuidor_cat, c7 as k_precio_mayoreo_cat, c8 as k_precio_publico_cat from keplersc.kdtvr2 where c1 = '" & frn.get("edt_prod",-1,0) & "' " ;//frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdSecPlanta");					rstXml(cuboResProd);									cuboResProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepestprod.GenerarReporte()");				frn.lib("libGeneral.kpl","FileSave",cuboResProd,"C:\Basura\cuboPreciosPlanta");												ok=getXmlAtt(cuboResProd,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					if(memcmp(mensajeError,"P0001",5)==0){						frn.message("Error de logica","Error","Aceptar");					}else{						frn.message(mensajeError,"Error","Aceptar");					}					return;				}				strTmp=getXmlAtt(cuboResProd,"r0","k_costo_distribuidor_cat");				frn.set("k_costo_distribuidor_cat",strTmp);				strTmp=getXmlAtt(cuboResProd,"r0","k_precio_mayoreo_cat");				frn.set("k_precio_mayoreo_cat",strTmp);				strTmp=getXmlAtt(cuboResProd,"r0","k_precio_publico_cat");				frn.set("k_precio_publico_cat",strTmp);								//Mensaje de vaidaciones				//if (!strValEst){				//	frn.message("El producto no tiene estadística","Error","Aceptar");				//}			}						fun MostrarListaPrecios(){				var strTmp = frn.get("k_claveoriginal");				if(strTmp && ""){					frn.message("Debe ingresar el número de parte.","Error","Aceptar");					return;				}				frn.dialog("invreptablaprecios",frn.get("cmb_sucursal",-1,1),frn.get("cmb_sucursal",-1,0),				frn.get("k_claveoriginal"),frn.get("k_descproducto"));			}						fun IniciarValores(){				frn.set("k_claveoriginal","");				frn.set("k_claveactual","");				frn.set("k_loc2","");				frn.set("k_descproducto","");				frn.set("k_unidad","");				frn.set("k_clasificacion","");				frn.set("k_linea","");				frn.set("k_backorder","");				frn.set("k_mad","");				frn.set("k_mip","");				frn.set("k_mid","");				frn.set("k_publi","");				frn.set("k_inter","");				frn.set("k_prov","");				frn.set("k_tall","");				frn.set("k_ult_compra","");				frn.set("k_pen_compra","");				frn.set("k_ult_venta","");				frn.set("k_pen_venta","");				frn.set("k_cant_ent","0.00");				frn.set("k_cant_sal","0.00");				frn.set("k_existencias","");				frn.set("k_monto_ent","");				frn.set("k_monto_sal","");				frn.set("k_valor","");				frn.set("k_costo_promedio","");				frn.set("k_ult_costo","");				frn.set("k_resmens","");				frn.set("k_costo_distribuidor_cat","");				frn.set("k_precio_mayoreo_cat","");				frn.set("k_precio_publico_cat","");			}						fun ValidarInfo(criterio){				if(criterio==0){					frn.message("Debe ingresar la clave de un producto o ubicación.","Error");					return 0;				}				if (strlen(frn.get("inp_anio")) != 4){					frn.message("Error en formato de año(YYYY).","Error");					frn.setPos("inp_anio");					return 0;				}				return 1;			}						fun ObtenerLocalicacion(){				var xmlRequest,cmd,cuboResultados,ok,cmd,cubo, mensajeError ;				var sucursal,refaccion,loc1,loc2,loc3,xmlLoc;				sucursal = frn.get("cmb_sucursal",-1,1);				refaccion = frn.get("edt_prod");				xmlLoc=frn.lib("libGeneral.kpl","ObtenerLocalizacion",sucursal,refaccion);					frn.lib("libGeneral.kpl","FileSave",xmlLoc,"C:\Basura\cuboLocalizacion");								loc1=getXmlAtt(xmlLoc,"r0","c4");				loc2=getXmlAtt(xmlLoc,"r0","c5");				loc3=getXmlAtt(xmlLoc,"r0","c6");												frn.set("k_loc1",loc1);				frn.set("k_loc2",loc2);				frn.set("k_loc3",loc3);							}						fun ConsultaProductos(){				var cmdQuery,suc,producto;				suc = frn.get("cmb_sucursal",-1,1);				producto=frn.get("edt_prod",-1,0);				cmdQuery="";				frn.dialog("prodlistafiltrosel","Refacciones",cmdQuery,"clave_actual","edt_prod",0,"","N","N",suc,producto,"Clave");			}										}	</script></pag>