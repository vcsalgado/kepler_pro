<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Control de Citas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="232,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="110,64,10,10" brdr="0,5" tit="Control de Citas" fnt="Arial,16">				<sp/><txt id="txt_fecha_cita">Fecha:</txt>		<edt id="fecha_cita" dim="9,1"  fmt="DD/MM/CCYY" OnChange="borrar_datos()" page="_ks_fecha,fecha_cita" OnF9="Dialog(3,_ks_fecha,fecha_cita)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2"/>		<tab n="1"/>		<img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="buscar()" available="Y" clrBrdr="0,0,0"/>		<tab n="14"/>		<txt clr="0,58,112" hk="S">Sucursal</txt><sp/>		<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="40,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y" modify="Y"/>								<br/><br/>		<sp/>		<tbl id="tabla" bclr="236,240,243" clr="64,64,64" OnEnter="Exit" OnMouseD="Exit" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="108,35" modify="N" nren="fijo">		<col id="col_fecha" name="Fecha"/>		<col id="col_clave_operador" name="Clave" visible="S"/>		<col id="col_nombre_ope" name="Operador"/>		<col id="col_tipo_ope" name="Tipo"/>		<col id="h_07_00" name="07:00"/>		<col id="h_07_15" name="07:15"/>		<col id="h_07_30" name="07:30"/>		<col id="h_07_45" name="07:45"/>						<col id="h_08_00" name="08:00"/>		<col id="h_08_15" name="08:15"/>		<col id="h_08_30" name="08:30"/>		<col id="h_08_45" name="08:45"/>						<col id="h_09_00" name="09:00"/>		<col id="h_09_15" name="09:15"/>		<col id="h_09_30" name="09:30"/>		<col id="h_09_45" name="09:45"/>						<col id="h_10_00" name="10:00"/>		<col id="h_10_15" name="10:15"/>		<col id="h_10_30" name="10:30"/>		<col id="h_10_45" name="10:45"/>								<col id="h_11_00" name="11:00"/>		<col id="h_11_15" name="11:15"/>		<col id="h_11_30" name="11:30"/>		<col id="h_11_45" name="11:45"/>						<col id="h_12_00" name="12:00"/>		<col id="h_12_15" name="12:15"/>		<col id="h_12_30" name="12:30"/>		<col id="h_12_45" name="12:45"/>						<col id="h_13_00" name="13:00"/>		<col id="h_13_15" name="13:15"/>		<col id="h_13_30" name="13:30"/>		<col id="h_13_45" name="13:45"/>						<col id="h_14_00" name="14:00"/>		<col id="h_14_15" name="14:15"/>		<col id="h_14_30" name="14:30"/>		<col id="h_14_45" name="14:45"/>						<col id="h_15_00" name="15:00"/>		<col id="h_15_15" name="15:15"/>		<col id="h_15_30" name="15:30"/>		<col id="h_15_45" name="15:45"/>						<col id="h_16_00" name="16:00"/>		<col id="h_16_15" name="16:15"/>		<col id="h_16_30" name="16:30"/>		<col id="h_16_45" name="16:45"/>						<col id="h_17_00" name="17:00"/>		<col id="h_17_15" name="17:15"/>		<col id="h_17_30" name="17:30"/>		<col id="h_17_45" name="17:45"/>						<col id="h_18_00" name="18:00"/>		<col id="h_18_15" name="18:15"/>		<col id="h_18_30" name="18:30"/>		<col id="h_18_45" name="18:45"/>						<col id="h_19_00" name="19:00"/>		<col id="h_19_15" name="19:15"/>		<col id="h_19_30" name="19:30"/>		<col id="h_19_45" name="19:45"/>				<col id="h_20_00" name="20:00"/>		<col id="h_20_15" name="20:15"/>		<col id="h_20_30" name="20:30"/>		<col id="h_20_45" name="20:45"/>				</tbl> 		<tab n="7"/>		<br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var usuario , suc_usuario , rol_usuario,asterisco,param_1  ;			var frn,frP,kdb,sys,suc,fecha,hora , tipo_ope , hrs_cita , mins_cita,libre, algo_asignado; 			var registro, hrs_prog, cita_seleccionada, se_encontro_comida, horario_inicio, horario_fin ;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								usuario = frn.config("user","name");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				rol_usuario = frn.config("user","role");				asterisco = "*";								param_1 = frn.param(0);								fecha=frP.get("fecha_cita"); 				if (fecha &! ""){					frn.set("fecha_cita", fecha);				}else{					frn.set("fecha_cita", sys.date() );				}									Inicializa();								buscar();														}															fun Inicializa() {							var xmlRequest,cmd,ok,cuboResultados, mensajeError,cubo ;										//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));								frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));					}						fun borrar_datos(){							frn.rst("tabla");			}									fun buscar(){										var xmlRequest,cmd,ok,cuboResultados, mensajeError,cubo ;				suc = frn.get("k_sucN", -1, 1);				fecha = frn.get("fecha_cita");							setXml(xmlRequest,"document","k_sucN","r1", suc );				setXml(xmlRequest,"document","fecha",fecha );								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.tmkt_control_de_citas('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSql",cmd,"control_de_citas.Inicializa()");												frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubo");												ok=getXml(cubo,"resultado");				if(ok &= "0" ){					mensajeError = getXml(cubo,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								cmd= "select to_char(col_fecha,'DD/MM/YYYY') as col_fecha, col_clave_operador, col_nombre_ope, col_tipo_ope " &				", h_07_00, h_07_15, h_07_30, h_07_45, h_08_00, h_08_15, h_08_30, h_08_45" &				", h_09_00, h_09_15, h_09_30, h_09_45, h_10_00, h_10_15, h_10_30, h_10_45" &				", h_11_00, h_11_15, h_11_30, h_11_45, h_12_00, h_12_15, h_12_30, h_12_45" &				", h_13_00, h_13_15, h_13_30, h_13_45, h_14_00, h_14_15, h_14_30, h_14_45" &				", h_15_00, h_15_15, h_15_30, h_15_45, h_16_00, h_16_15, h_16_30, h_16_45" &				", h_17_00, h_17_15, h_17_30, h_17_45, h_18_00, h_18_15, h_18_30, h_18_45" &				", h_19_00, h_19_15, h_19_30, h_19_45, h_20_00, h_20_15, h_20_30, h_20_45" &				" from keplersc.control_de_citas where col_fecha='" & fecha & "' order by col_nombre_ope";							cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"control_de_citas.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("tabla",cuboResultados );											}																	fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}																				}	</script></pag>