<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Tabulacion"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>	<br/><tab n="1"/><txt clr="0,0,0" fnt="Arial,25">Cierra Abre / Puntos</txt><br/>	<tab/><hLine/>	<br/><br/>	<tab/>	<grp dim="100,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle de la orden">		<sp/><txt fnt=",b">Sucursal:</txt><sp/><inp id="k_sucursal" dim="5,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<sp/><inp id="k_sucnombre" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/><tab/><txt fnt=",b">Fecha:  </txt>		<inp id="k_fecha" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" modify="N" available="N" fmt="DD/MM/CCYY" nc="-1" fnt=",0"/><tab/><txt fnt=",b">Estatus:</txt>		<inp id="k_estatusdesc" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/><tab n="2"/>		<br/>		<sp/><txt  fnt="Arial,b">Tipo:</txt><sp/><inp id="k_tipo" clr="64,64,64"  dim="3,1" fnt="Arial,0" clrBrdr="255,255,255"   bclr="255,255,255" modify="N" visible="Y" type="string" brdr="2,0"/>		<sp/><inp id="k_tipodesc" dim="25,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" fnt=",0" modify="N" available="N"/>		<tab/><txt  fnt="Arial,b">Folio:</txt><sp/><inp id="k_folio" clr="64,64,64"  dim="18,1" fnt="Arial,0" clrBrdr="255,255,255"   bclr="255,255,255" brdr="2,0"  modify="N" visible="Y" type="string"/>		<tab/><txt fnt=",b">Cliente: </txt><sp/><inp id="k_cliente" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<sp/><inp id="k_nombre" dim="50,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<br/>		<sp/><txt fnt=",b">VIN: </txt><sp/><inp id="k_serie" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<tab/><txt fnt=",b"> Marca:</txt><sp/>	<inp id="k_marca" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<tab/><txt fnt=",b">Modelo:</txt><sp/><inp id="k_modelo" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<tab/><txt fnt=",b">A&#241;o:</txt><sp/><inp id="k_anio" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<tab/><txt fnt=",b">Placas:</txt><sp/><inp id="k_placa" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<tab/><txt fnt=",b">Bonete:</txt><sp/><inp id="k_bonete" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>	</grp>	<br/><br/>	<tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="100,25,10,10" brdr="0,5" tit="Detalle de Puntos" fnt="Arial,16">				<br/>			<sp/><tbl id="tabla_puntos" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="98,9"  hk="z" OnChange="" Reorder="N" modify="Y" available="Y">			<col id="numero_punto" name="Numero de Punto" modify="N"  type="capital"/>			<col id="tipo_punto" name="Tipo punto" visible="N" modify="N"/>			<col id="desc_tipo_punto" name="Tipo punto"  modify="N"/>			<col id="trabajo_a_realizar" name="Descripcion" modify="N" type="capital"/>			<col id="clave_operario" modify="N" name="Operario"/>			<col id="horas" name="Horas" modify="N"/>			<col id="tabulacion" name="Tabulacion"  OnF9="Seleccionar_Estatus()" OnChange="insert_Estatus()"/>								</tbl>		<br/><br/>		<tab n="28"/><bot id="bot_guardar" dim="14,0" brdr="5" text="Guardar Cambios" default="0" OnEnter="Guardar()"/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,usuario,suc_usuario,perfil_usuario,rol_usuario  ,asterisco,vin , externo, sucursal,folio_orden, tipo_orden, rep;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				rep=new REP;				kdb.connect();												suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");								rol_usuario = frn.config("user","role");				asterisco = "*";						sucursal = trim(frn.param(0));				tipo_orden= trim(frn.param(1));				folio_orden= trim(frn.param(2));				vin = trim(frn.param(3));									Inicializa();			}					fun Inicializa(){				var cmd, cubo, ok, mensajeError ;				var xmlOrden, xmlDatos;							xmlOrden= frn.lib("libOrdenes.kpl","ConsultaOrden",sucursal,tipo_orden,folio_orden);								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				xmlDatos = frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",xmlOrden,"r0");				frn.setX(xmlDatos);																//puntos				cmd = " select pun.c4 as numero_punto, pun.c6 as tipo_punto,cat.c2 as desc_tipo_punto ,pun.c8 as trabajo_a_realizar,";				cmd = cmd & "  pun.c9 as clave_operario, sum(hrs.c8) as horas ,pun.c22 as tabulacion from keplersc.kdpun as pun left outer join keplersc.kdhoras as hrs on hrs.c1=pun.c1";				cmd = cmd & "  and hrs.c2=pun.c2 and hrs.c3=pun.c3 and hrs.c4=pun.c4 left outer join keplersc.catpuntos as cat on cat.c1=pun.c6" ;				cmd = cmd & " where pun.c1='" & sucursal & "' and pun.c2='" & tipo_orden & "' and pun.c3='" & folio_orden & "'" ;				cmd = cmd & " and (pun.c7='T' or pun.c7='A') group by pun.c1, pun.c2, pun.c3, pun.c4, cat.c2  order by pun.c4 ";							rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcierraabrepuntos.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\puntos");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												frn.setX(cubo,"tabla_puntos");							}                 			fun Seleccionar_Estatus() {							var cmdQuery = "select c1 as clave,c2 as descripcion from keplersc.kdstatustabulacion";            frn.dialog("genlistasel","Tabulacion",cmdQuery,"clave","tabla_puntos", -1,"tabulacion","N");         }                      fun insert_Estatus(){						   var estatus = frn.get("tabla_puntos", -1, "tabulacion") ;			 				var cmd = "select c1 from keplersc.kdstatustabulacion where c1='" & estatus & "'";				var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcierraabrepuntos.insert_Estatus()");							var ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var len_result = nXml(cubo);								if (len_result == 0){					frn.message("La clave no se encuentra en el catalogo de estatus de tabulacion.","Error","Aceptar");					frn.setX("", "tabla_puntos", -1, "tabulacion");					return;				}			            frn.setX(getXmlAtt(cubo,"r0", "c1") , "tabla_puntos", -1, "tabulacion");         			}                                                                                 fun Guardar (){         				var cmd, cubo, ok, mensajeError,xmlRequest ;								xmlRequest = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				setXml(xmlRequest,"sucursal_id", sucursal );				setXml(xmlRequest, "folio_orden", folio_orden);				setXml(xmlRequest,"tipo_orden", tipo_orden);				setXml(xmlRequest ,"ctd_puntos",frn.N("tabla_puntos") - 1);										frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.ser_cierra_abre_puntos(' <document> " & getXmlStr(xmlRequest,"EOF:13_10") & " </document> ')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcierraabrepuntos.Guardar()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var resultado = getXmlAtt(cubo,"r0","resultado");							if(resultado &= "0"){					mensajeError = getXmlAtt(cubo,"r0","mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								if(resultado &= "1"){					var mensaje = getXmlAtt(cubo,"r0","mensaje");					frn.message(mensaje ,"Atencion","Aceptar");				}							}								//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------								fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}																																		}	</script></pag>