<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Catalogo TISAN">
<grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">
	<tab/><txt fnt=",22" clr="0,0,0">Catalogo TISAN	</txt><tab/>
	<br/>
	<tab/><hLine clr="0,0,0"/>
	<br/>

	<br/>
	<tab/>
	<grp id="grupo_crud" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 
		dim="25,9,10,20" brdr="0,5" tit="Nuevo" fnt="Arial,16">
		<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/>
		<br/>

		<tab/>
						
			<txt>Clave Tipo: </txt>
			<tab n="2"/><sp/>
			<inp id="k_clave_crud" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="5" available="Y" modify="Y"/>
		<sp/>
		<br/>

		<tab/>
						
			<txt>Descripcion Tipo: </txt>
			<tab/><sp/>
			<inp id="k_desc_tipo_crud" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="20" available="Y" modify="Y"/>
		<sp/>
		<br/>

		<br/>		<tab/>
		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Guardar" hk="K" default="0" step="0"  OnEnter="Execute()" fnt="Arial,16" visible="Y" available="Y"/>
		<tab/>
		<bot id="btn_aceptar" dim="10,10" brdr="5" text="Aceptar" hk="K" default="0" step="0"  OnEnter="salir()" fnt="Arial,16" available="N" visible="N"/>
	</grp>
</grp>
<script>
	InstallDriver("KDB75");
	class Main {
		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, asterisco  ;
		var cmdQuery, cuboQuery, ok, mensajeError, xml_cubo_cata, accion, externo, straccion, clave_sel, sucursal_id, resVal;
		var k_clave_crud, k_desc_tipo_crud, k_clave;
		fun Main(){
			frn=new FRNT;
			kdb=new KDB;
			frP=new FRNTP;
			sys=new SYS;
			kdb.connect();
			
			suc_usuario = frn.lib("libKepler","UserInfo(1)");
			perfil_usuario = frn.lib("libKepler","UserInfo(2)");
			rol_usuario = frn.config("user","role");
			asterisco = "*";
			accion = frn.param(0);
			k_clave = frn.param(1);
			
			ConfiguraUI();
			Inicializa();
			
		}

		fun vacia_campos(){
			frn.rst("k_clave_crud");
			frn.rst("k_desc_tipo_crud");

		}
            


		fun salir(){
			accion="NUEVO";
			vacia_campos();
			Inicializa();
			frn.exit();			
		}



		fun carga_datos(){


			cmdQuery = "select c1 as k_clave_crud, c2 as k_desc_tipo_crud from keplersc.kdtisan
				 where c1 = '"& k_clave &"'";
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_tisan_crud.IniCombos()");
			xml_cubo_cata=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");
			frn.lib("libGeneral.kpl","FileSave",cuboQuery,"C:\Basura\cubo");		
			frn.setX(xml_cubo_cata);

		}


		fun ValidarDatos(){


			if (frn.get("k_clave_crud") &= "") {						
				frn.setPos("k_clave_crud");
				resVal=0;
				frn.message("Debe especificar la clave TISAN, verificar","Error","Aceptar");
				return;
			}
			if (frn.get("k_desc_tipo_crud") &= "") {						
				frn.setPos("k_desc_tipo_crud");
				resVal=0;
				frn.message("Debe especificar descripcion TISAN, verificar","Error","Aceptar");
				return;
			}

		}

		fun Execute() {
			resVal = 1;
			ValidarDatos();
			if(resVal == 0){
				return;
			}
			
			var resultado_confirmacion = frn.message("Desea continuar?","Mensaje de Confirmacion", 2);
			if (resultado_confirmacion &! 1)  {
				return;
			}
			
			var xmlRequest = getXml(frn.dataPag());	
			frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");
					cmdQuery="SELECT * FROM keplersc.cat_crud_tisan('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";
			var cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_tisan.Execute()");	
			frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");					
			var resultado=getXml(cubo ,"resultado");
			
			if(resultado &= "0"){
				mensajeError = getXml(cubo ,"mensaje");
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			frP.script("Inicia_Forma()");
			if (accion &= "NUEVO" || accion &= "MODIFICAR") {	
				var sms =  "";
				if (accion &= "NUEVO"){
					sms = "Registro guardado";
				}else {
					sms = "Registro modificado";
				}
				accion="CONSULTAR";

				ctlrs_opcion();
				frn.message(sms ,"Mensaje","Aceptar");	


			}
			if (accion &= "ELIMINAR"){
				frn.message("Registro eliminado","Mensaje","Aceptar");
				frn.exit();			
			}
		}	
		
		fun ctlrs_opcion(){
			frn.set("input_crud", accion);
			frn.rst("grupo_crud");
			if (accion &= "NUEVO"){

				frn.setAtt("k_clave_crud", "available", "Y" );
				frn.setAtt("k_clave_crud", "modify", "Y" );

				frn.setAtt("k_desc_tipo_crud", "available", "Y" );
				frn.setAtt("k_desc_tipo_crud", "modify", "Y" );

			    frn.set("k_titulo","Nueva TISAN ");
				frn.setAtt("grupo_crud", "tit", "Nuevo" );
				frn.setAtt("k_btn_cons", "visible", "Y" );
				frn.setAtt("btn_aceptar", "available", "N" );
				frn.setAtt("btn_aceptar", "visible", "N" );
			
			}else { 

					if (accion &= "MODIFICAR") {
					carga_datos();

					frn.setAtt("k_clave_crud", "available", "N" );
					frn.setAtt("k_clave_crud", "modify", "N" );

					frn.setAtt("k_desc_tipo_crud", "available", "Y" );
					frn.setAtt("k_desc_tipo_crud", "modify", "Y" );

					frn.set("k_titulo","Modifica TISAN");

					frn.setAtt("grupo_crud", "tit", "Modifica" );
                    frn.setAtt("grupo_crud", "available","Y");
					frn.setAtt("k_btn_cons", "visible", "Y" );
					frn.setAtt("btn_aceptar", "available", "N" );
					frn.setAtt("btn_aceptar", "visible", "N" );
					
                   }else{

						carga_datos();

						frn.setAtt("k_clave_crud", "available", "N" );
						frn.setAtt("k_clave_crud", "modify", "N" );

						frn.setAtt("k_desc_tipo_crud", "available", "N" );
						frn.setAtt("k_desc_tipo_crud", "modify", "N" );

						frn.set("k_titulo","Colsulta TISAN");

						frn.setAtt("grupo_crud", "tit", "Colsulta" );
						frn.setAtt("btn_aceptar", "available", "Y" );
						frn.setAtt("btn_aceptar", "visible", "Y" );
						frn.setAtt("k_btn_cons", "available", "N" );
						frn.setAtt("k_btn_cons", "visible", "N" );


				   }
				
			}
			if (accion &! "CONSULTAR"){

				frn.setAtt("btn_aceptar", "available", "N" );
				frn.setAtt("btn_aceptar", "visible", "N" );
				frn.setAtt("k_btn_cons", "available", "Y" );
				frn.setAtt("k_btn_cons", "visible", "Y" );
			}
		}		

		
		fun ConfiguraUI(){
			if (frn.nParam() == 0){
				frn.message("Accion no permitida.","Error","&Aceptar");
//				frn.open("redirect",2);
				return;
			}
		}		

		fun Inicializa(){
	
			ctlrs_opcion();
			
		}						
           
				
	}
	
		
	</script>
</pag>