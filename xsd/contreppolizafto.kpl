<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns='www.kepler.com.mx/2003/KSchema' tit='Compras' scale="48">
<grp dim='1,-1,10,20' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">
	<grp dim="15,8,7,12"><sp/>
		<img id="img"  dim="14,80" brdr="0,1" img="logocliente.jpg"/>
	</grp>
	<grp dim="40,8,7,1">
		<inp id="titulo"  dim="90,1" brdr="0,1" type="string" fnt="Arial,24" modify="N"/>
		<br/>
		<txt fnt="Arial,18">Sucursal:</txt>
		<inp id="rep_suc"  just="L" dim="60,1" brdr="0,1" type="string" fnt="Arial,17" nc="20"/><br/>
	</grp>
	<br exe="encabezado"/>
	
	<sp/>
	<grp dim="65,5,7,14" brdr="2,5">
		<br/><br/>
		<tab n="12"/><txt fnt="Arial,20">POLIZA CONTABLE</txt>
	</grp>
	<tab n="2"/>
	<grp id="tipo" dim="20,5,7,2" brdr="2,5"><br/>
		<sp/><txt>Fecha:</txt>
			<tab n="2"/><inp id="rep_fecha" dim="20,1" brdr="0,1" type="date" fnt="Arial,15" fmt="DD/MM/CCYY" nc="-1"/><br/>
			<br/><br/>
		<sp/><txt>Hora:</txt>
			<tab n="2"/><inp id="rep_hora" dim="20,1" brdr="0,1" type="string" fnt="Arial,15"  nc="-1"/><br/><br/><br/>
		<sp/><txt>Pagina:</txt><tab n="2"/><inp id="k_pag" dim="4,1" type="number" just="L" mcr="k_pag"/>
		
	</grp>
	<br exe="encabezado"/>

	<br/>
	<tab n="26"/><txt>Pagina:</txt><tab/><inp id="k_pag" dim="4,1" type="number" just="L" mcr="k_pag"/><br exe="encabezadoPol1"/>
	<hLine g="2" dim="100,0"/><br  exe="encabezadoPol1"/><tab n="13"/>
<br/>
<sp/><txt fnt="Arial,18b">Poliza No.</txt>
<inp id="tPol"  dim="2,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15b"/><tab n="1"/>
<inp id="nPol"  dim="9,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15b"/><tab n="1"/> <inp id="fecha_pol"  dim="9,1" brdr="0,1" bclr="255,255,255" type="date" fnt="Arial,15b" fmt="DD/MM/CCYY" nc="-1"/>

<tab n="7"/><txt fnt="Arial,17b">Fecha del Movimiento:</txt> <sp/>
<inp id="fecha_mov"  dim="9,1" brdr="0,1" bclr="255,255,255" type="date" fnt="Arial,15b" fmt="DD/MM/CCYY" nc="-1"/>
<br  exe="encabezadoPol1"/>

<sp/><txt fnt="Arial,18b">Sucursal:</txt>
<inp id="suc_id"  dim="2,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15b"/><tab n="1"/>
<inp id="suc_desc"  dim="15,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15b"/><tab n="4"/>
<txt fnt="Arial,18b">Documento:</txt>
<inp id="doc"  dim="15,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15b"/><tab n="1"/>
<inp id="desc_mov"  dim="25,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15b"/>

 <br exe="encabezadoPol2"/><br exe="encabezadoPol2"/>

<sp/><txt fnt="Arial,15b">N&#250;mero</txt><tab n="3"/><txt>Cuenta</txt><tab n="4"/><txt>Descripci&#243;n</txt><tab n="7"/> <txt>Referencia</txt><tab n="5"/><txt>Debe</txt><tab n="4"/><sp/><txt>Haber</txt><br exe="encabezadoPol2"/><hLine dim="100,0" g="2"/><br  exe="encabezadoPol2"/>
<inp id="PolClave"  dim="10,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/>
<inp id="PolCuenta"  dim="20,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/>
<inp id="PolDescr"   dim="18,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/>
<inp id="PolRefer" dim="26,1" type="string" just="R" fnt="Arial,15" brdr="0,1"/><tab/>
<inp id="PolDebe"  dim="12,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15" nd="2"/><br exe="partPolC"/>
<inp id="PolClave2"  dim="10,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/>
<inp id="PolCuenta2"    dim="20,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/>
<inp id="PolDescr2"   dim="18,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/>
<inp id="PolRefer2" dim="26,1" type="string" just="R" fnt="Arial,15" brdr="0,1"/><tab/>
<inp id="espacio"  dim="12,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15" nd="2"/><sp/>
<inp id="PolHaber"  dim="12,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15" nd="2"/><br exe="partPolA"/>
<hLine dim="100,0" g="2"/><br exe="PolTotales"/><sp/><inp id="poliza_descuadrada" dim="18,1" type="string" just="R" fnt="Arial,15" brdr="0,1"/><tab n="10"/><sp/><tab n="6"/><txt>Sumas</txt><tab n="2"/><inp id="totCargo"  dim="12,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15b" nd="2"/>
<sp/><inp id="totAbono"  dim="12,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15b" nd="2"/><br exe="PolTotales"/><tab/><br exe="fin"/>
	
	</grp>
</pag>