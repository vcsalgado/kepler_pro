<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Pedidos Especiales"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="88,45,10,10" brdr="0,5" tit="Pedidos Especiales" fnt="Arial,16">				<tab n="1"/><txt clr="0,58,112">Serie:</txt>		<inp id="input_serie"  nc="8" dim="7,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  available="S"/>	<sp/>		<img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="buscar_datos()" available="Y" clrBrdr="0,0,0"/>		<br/>			<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" OnEnter="Exit" OnMouseD="Exit" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="82,22" modify="N" nren="fijo">		<col id="vin" name="Serie"/>		<col id="pedido" name="Pedido"/>		<col id="solicitud" name="Solicitud"/>		<col id="eta" name="ETA"/>		<col id="surtido" name="Surtido"/>		<col id="fecha" name="Fecha"/>		<col id="tipo_orden" name="Orden"/>		<col id="orden" name="Orden"/>		<col id="anticipo" name="Anticipo"/>		<col id="pieza" name="Pieza"/>		<col id="desc" name="Descripcion"/>		<col id="cantidad" name="Cantidad"/>		</tbl> 		<tab n="7"/>		<br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario ,sucursal ,serie ;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				sucursal = frP.get("k_sucN", -1, 1);					serie =  frP.get("vin");								if (sucursal &= ""){					sucursal = suc_usuario ;				}								frn.set("input_serie",serie);				buscar_datos();					}											fun buscar_datos() {							var xmlRequest, ok,cmd,cubo,mensajeError,strTmp,xmlRes,cubo_pedidos ;				setXml(xmlRequest,"document","sucursal_id",sucursal );				setXml(xmlRequest,"document","vin",frn.get("input_serie"));								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.pedidosespserie('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"pedidosserie.buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									//inserta regitros de puntos				rstXml(strTmp);				rstXml(xmlRes);				strTmp = getXmlAtt(cubo,"r0","pedidos");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_pedidos,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_pedidos,"C:\Basura\cubo_pedidos");				frn.setX(cubo_pedidos,"tabla");								}								}	</script></pag>