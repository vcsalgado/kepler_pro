<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Actualiza Estatus Campa&#241;as"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="75,43,10,10" brdr="0,5" tit="Actualiza Estatus Campa&#241;as" fnt="Arial,16">		<tab/>		<txt>Sucursal: </txt>					<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" tooltip="Sucursal" available="Y" modify="Y"/>		<tab/><br/><tab/><txt clr="0,58,112">Serie:</txt><tab/>		<inp id="input_serie" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  available="S" OnF9="obtenerSerie()" OnChange="LimpiaDatos()" tooltip="Seleccionar F9" modify="Y"/>	<sp/>		<img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="buscar_datos()" available="Y" clrBrdr="0,0,0" visible="Y"/><br/>		<br/>		<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" OnEnter="Exit" OnMouseD="Exit" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="70,13" modify="N" nren="fijo">			<col id="clave" name="Clave" OnActive="consulta_adicionales"/>			<col id="status" name="Status" OnActive="consulta_adicionales"/>			<col id="descr" name="Descripcion" OnActive="consulta_adicionales"/>			<col id="fecha" name="Fecha" OnActive="consulta_adicionales" type="date" nc="-1" fmt="DD/MM/CCYY"/>				</tbl><br/><tab/><txt>[Doble Click cambia Estatus]</txt><br/> 		<br/>		<tab/><txt clr="0,58,112">Campa&#241;a:  </txt>		<inp id="cve_campana" dim="10,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" brdr="2,0" available="N"/>		<tab/><txt clr="0,58,112">Estatus:   </txt>		<inp id="estatus" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" OnMouseD="CambiaEstatus()" modify="N" available="Y"/>		<txt>  Fecha realizacion:  </txt>		<edt id="fecha_realiza" dim="12,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_realiza" OnF9="Dialog(3,_ks_fecha,fecha_realiza)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" brdr="2,0"/>				<br/>		<tab/><txt clr="0,58,112">Otro Distribuidor:</txt><tab/>		<inp id="otro_distribuidor" dim="58,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  available="Y" modify="Y" type="capital"/><br/>		<br/>		<tab n="11"/>		<bot id="Aceptar" dim="12,0" brdr="5"  OnEnter="Alta()"  text="Aceptar" visible="Y"/>		</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,cmd,ok,cuboResultados,mensajeError,sucursal,serie, campana, llamadaPadre, resVal;			var usuario, rol_usuario, suc_usuario, asterisco;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";								sucursal = frn.param(0);				serie = frn.param(1);				campana = frn.param(2);				llamadaPadre = frn.param(3);				Inicializa();										}						fun Inicializa(){				var posicion;				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_sucn",getXml(cuboResultados));				if (llamadaPadre &="s"){					frn.set("k_sucn",descr_combo("k_sucn",1,sucursal));					frn.set("input_serie", serie);					frn.setAtt("buscar_datos", "visible", "N");					frn.setAtt("k_sucn", "modify", "N");					frn.setAtt("input_serie", "modify", "N");					buscar_datos();					posicion = ubica_campana(campana);					frn.setPos("tabla","ren:"& posicion);					consulta_adicionales();				} else{									frn.set("k_sucn",descr_combo("k_sucn",1,suc_usuario));					frn.setAtt("buscar_datos", "visible", "Y");					frn.setAtt("k_sucn", "modify", "Y");					frn.setAtt("input_serie", "modify", "Y");				}						}						fun obtenerSerie(){				sucursal=frn.get("k_sucn", -1, 1);				cmd= "select distinct c2 as serie 						from keplersc.kdsercampana						where c6='" & sucursal & "'" ;										frn.dialog("genlistafiltrosel","Series con Campañas",cmd,"serie","input_serie","0","0","S","N");								}					fun buscar_datos() {				LimpiaDatos();				var totresultados, contresultados;				sucursal = frn.get("k_sucn", -1, 1);					serie =  frn.get("input_serie");											cmd= "select cpna.c3,case when cpna.c4=0 then 'PENDIENTE' when cpna.c4=10 then 'REALIZADA' when cpna.c4=15 then 'OTRO DISTRIBUIDOR' end c4,cat.descripcion, cpna.c5, cpna.c7,cpna.c8, cat.notas, cat.comentarios_cliente, cat.url_boletines 						from keplersc.kdsercampana as cpna 						inner join keplersc.kdsercampanacat as cat on cat.clave_campana=cpna.c3						where cpna.c2='" & frn.get("input_serie") & "' and cpna.c6='" & sucursal & "'" ;				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmd");				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"campanas.buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								totresultados = nXml(cuboResultados);				if (totresultados > 0){					frn.rst("tabla");					for (contresultados=0; contresultados<totresultados ; contresultados++){						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"c3"),"tabla",contresultados,"clave");						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"c4"),"tabla",contresultados,"status");						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"descripcion"),"tabla",contresultados,"descr");						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"c5"),"tabla",contresultados,"fecha");							frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"c7"),"tabla",contresultados,"tipo");						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"c8"),"tabla",contresultados,"orden");						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"notas"),"tabla",contresultados,"notas");						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"comentarios_cliente"),"tabla",contresultados,"comentarios");						frn.setX( getXmlAtt(cuboResultados,"r"&contresultados,"url_boletines"),"tabla",contresultados,"url");					}										frn.set("cve_campana", frn.get("tabla",-1,"clave"));					frn.set("estatus", frn.get("tabla",-1,"status"));					frn.set("fecha_realiza",frn.get("tabla",-1,"fecha"));								} else{					frn.message("El no. de serie no existe","Atencion","Aceptar");					return;				}			}						fun consulta_adicionales(){				frn.set("cve_campana", frn.get("tabla",-1,"clave"));				frn.set("estatus", frn.get("tabla",-1,"status"));				frn.set("fecha_realiza",frn.get("tabla",-1,"fecha"));			}						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}						fun LimpiaDatos(){				frn.rst("tabla");				frn.set("cve_campana", "");				frn.set("estatus", "");				frn.set("fecha_realiza","");							}						fun CambiaSucursal(){				frn.set("input_serie", "");				LimpiaDatos();			}						fun ValidarDatos(){				if (frn.get("otro_distribuidor") &! ""){					if (frn.get("estatus") &! "OTRO DISTRIBUIDOR"){						resVal=0;						frn.message("Si especifica el dato Otro distribuidor, el estatus debe ser OTRO DISTRIBUIDOR|Verifique","Atencion","Aceptar");						return;					}				}				if (frn.get("fecha_realiza") &! ""){					if (frn.get("estatus") &! "REALIZADA"){						resVal=0;						frn.message("Si especifica la fecha de realizacion, el estatus debe ser REALIZADA|Verifique","Atencion","Aceptar");						return;					}				}				if (frn.get("estatus") &= "REALIZADA"){					if (frn.get("fecha_realiza") &= ""){						resVal=0;						frn.message("Si el estatus es REALIZADA, debe especificar la fecha de realizacion|Verifique","Atencion","Aceptar");						return;					}				}							}						fun Alta(){				var continua, xmlRequest = getXml(frn.dataPag());				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}									continua = frn.message("¿Desea continuar con la actualizacion?","Atención",2);				if (continua == 0){					return;				}												frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");					cmd="SELECT * FROM keplersc.actualiza_estatus_campanas('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"actualiza_estatus_campanas.Alta()");					frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");													var resultado=getXml(cuboResultados ,"resultado");								if(resultado &= "1"){					mensajeError = getXml(cuboResultados ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					buscar_datos();					if (llamadaPadre &="s"){						frP.script("buscar_datos()");					}					return;				}				if(resultado &= "0"){					mensajeError = getXml(cuboResultados ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}							}						fun ubica_campana(campana){				var posicion, valor_actual;				var len_tabla = frn.N("tabla");				for (var cont=0; cont<len_tabla ; cont++){					valor_actual= frn.get("tabla",cont,"clave");					if (valor_actual &=  campana){						posicion = cont;						break;											}				}				return posicion;			}						fun CambiaEstatus(){			/*				if (frn.get("estatus") &= "P"){					frn.set("estatus","PENDIENTE");				} else if (frn.get("estatus") &= "R"){					frn.set("estatus","REALIZADA");				} else if (frn.get("estatus") &= "O"){					frn.set("estatus","OTRO DISTRIBUIDOR");				} else {					frn.message("Solo se permite P-PENDIENTE, R-REALIZADA, O-OTRO DISTRIBUIDOR", "Atencion","Aceptar");				}			*/					if (frn.get("estatus") &= "PENDIENTE"){					frn.set("estatus","REALIZADA");				} else if (frn.get("estatus") &= "REALIZADA"){					frn.set("estatus","OTRO DISTRIBUIDOR");				} else if (frn.get("estatus") &= "OTRO DISTRIBUIDOR"){					frn.set("estatus","");				} else if (frn.get("estatus") &= ""){					frn.set("estatus","PENDIENTE");				}			}						}	</script></pag>