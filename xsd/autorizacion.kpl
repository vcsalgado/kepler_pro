<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>				<grp id="grupo_crud" dim="40,10,7,13" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" 			fntBrdr="Arial,18" available="Y" tit="Autorizacion "><br/><tab n="5"/><txt>  Password</txt><br/><tab n="3"/>			<inp id="k_password" dim="22,1" tooltip="Password de autorizacion" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" 			 type="password" available="Y" modify="Y" just="C" brdr="1,0"/>			<br/><br/><tab n="4"/><sp n="3"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/>            <inp id="k_usuario" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="50" 				clrBrdr="255,255,255" available="N" modify="N" visible="N"/>								</grp>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP,sys,accion,externo, clave_sel,sucursal_id,cve_color,resVal,straccion,concepto,titulo;            var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError;			var usuario, suc_usuario, rol_usuario, asterisco;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				usuario = frn.config("user","name");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				rol_usuario = frn.config("user","role");				asterisco = "*";                concepto=frn.param(0);                sucursal_id=frn.param(1);                titulo="Autorizacion " & strFormat("lcase",concepto);				kdb.connect();			    Inicializa();			}						fun Cancelar(){				frn.exit();			}						fun Inicializa(){                frn.set("k_password","");				frn.setAtt("grupo_crud", "tit", titulo);			}						fun Execute() {                if (strFormat("lcase",frn.get("k_password")) &= "onomatopeya"){                    frP.setX("1","k_mov",-1,"k_autoriza");                    RegBitacora();                    frn.message("Autorizacion exitosa|Se ha registrado en bitacora","Atencion","Aceptar");                    frn.exit();                } else {                    frn.setPos("k_password");                    frn.message("Password incorrecto");                    return;                }			}            fun RegBitacora(){                var fecha_movto,hora_movto,strBitacora,operacion,strValor;                var cmd ="",cubo,ok,mensaje,resultado;                //Registro del movimiento en bitacora                fecha_movto =  sys.date();                hora_movto = sys.time();                operacion = "AUT PRECIO";                strBitacora = "ORDEN: " & frP.get("k_orden") & " REFACC: " & frP.get("k_mov",-1,"k_parte");                setXml(xmlRequest,"usuario",usuario);							setXml(xmlRequest,"fecha",fecha_movto);				setXml(xmlRequest,"hora",hora_movto);				setXml(xmlRequest,"sucursal",sucursal_id);                setXml(xmlRequest,"genero"," ");							setXml(xmlRequest,"naturaleza"," ");				setXml(xmlRequest,"grupo",0);				setXml(xmlRequest,"tipo",0);                setXml(xmlRequest,"folio","REFACC");				setXml(xmlRequest,"tipo_movto",operacion);				setXml(xmlRequest,"detalle_movto",strBitacora);                frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\strValor");                cmd="SELECT * FROM keplersc.usr_kdusraccess_alta('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";                kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"autorizacion.RegBitacora()");								resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");								if(resultado &! "1"){					frn.message(mensaje, "Error","&Aceptar");				}                            }						}	</script></pag>