<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">
	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>
		
		<grp id="grupo_crud" dim="40,10,7,13" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" 
			fntBrdr="Arial,18" available="Y" tit="Autorizacion "><br/><tab n="5"/><txt>  Password</txt><br/><tab n="3"/>
			<inp id="k_password" dim="22,1" tooltip="Password de autorizacion" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" 
			 type="password" available="Y" modify="Y" just="C" brdr="1,0"/>

			<br/><br/><tab n="4"/><sp n="3"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/>
            <inp id="k_usuario" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="50" 
				clrBrdr="255,255,255" available="N" modify="N" visible="N"/>
						
		</grp>
	</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,kdb,frP,sys,sucursal_id,autConcepto,titulo;
			var strCtrlSet, strBitacora, strRenglon, strColumna, regBitacora, strOperacion, strFolio, strGen, strNat, strGpo, strTipo;
         var cmd,xmlRequest,ok,cubo,mensajeError;
			var usuario, suc_usuario, rol_usuario, asterisco;
			fun Main() {
				frn=new FRNT;
				frP=new FRNTP;
				kdb=new KDB;
				sys=new SYS;
				usuario = frn.config("user","name");
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				rol_usuario = frn.config("user","role");
				asterisco = "*";
				autConcepto=frn.param(0);			//Concepto de autorizacion que se mostrara en la ventana
				sucursal_id=frn.param(1);			//Clave de sucursal
				strCtrlSet=frn.param(2);			//Nombre del control que recibira un 1 de autorizado (password ok)
				strRenglon=frn.param(3);			//Numero del renglon de la tabla -1 si es el actual y 0 si no es tabla
				strColumna=frn.param(4);			//Nombre de la columna de la tabla que recibira un 1 de autorizado (password ok)
				regBitacora=frn.param(5);			//Indica si se registra en bitacora la autorizacion, S o N
				strBitacora=frn.param(6);			//String del movimiento que se guardara en la bitacora
				strOperacion=frn.param(7);			//Nombre del tipo de movto que se registrara en bitacora
				strFolio=frn.param(8);				//Folio o concepto que se registrara en bitacora, pe. PPTO, REFACC, CAMB_KM etc.
				strGen=frn.param(9);				//Genero del documento
				strNat=frn.param(10);				//Naturaleza del documento
				strGpo=frn.param(11);				//Grupo del documento
				strTipo=frn.param(12);				//Tipo del documento
					
				//Ejemplo con registro de bitacora
				//frn.dialog("autorizacion","Precio Menor",frn.get("k_sucn",-1,"c1"),"k_mov",-1,"k_autoriza","S","REG PRUEBA Orden: " & frn.get("k_orden") & " Refacc: "& frn.get("k_mov",-1,"k_parte"),"AUT PRECIO","REFACC");
				
				//Ejemplo sin registro de bitacora
				//frn.dialog("autorizacion","Precio Menor",frn.get("k_sucn",-1,"c1"),"k_mov",-1,"k_autoriza","N");

				titulo="Autorizacion " & strFormat("lcase",autConcepto);
				kdb.connect();
			    Inicializa();
			}
			
			fun Cancelar(){
				frn.exit();
			}			

			fun Inicializa(){
            frn.set("k_password","");
				frn.setAtt("grupo_crud", "tit", titulo);

			}
			
			fun Execute() {
				var clave_aut;
				clave_aut = ClaveAutorizacion();
				if (clave_aut &= strFormat("lcase",frn.get("k_password"))){
					if(strRenglon &= "0" ){
						frP.set(strCtrlSet,"1");
					} else {//	valor | ID_elemento | strRenglon (-1 actual)| strColumna
						frP.setX("1",strCtrlSet,-1,strColumna);									
					}
                    
					if (regBitacora &= "S"){
						RegBitacora();
						frn.message("Autorizacion exitosa|Se registro en bitacora","Atencion","Aceptar");
					} else {
							frn.message("Autorizacion exitosa|Se registrara en bitacora","Atencion","Aceptar");
					}	
               frn.exit();
				} else {
					if (clave_aut &=""){
						frn.message("Password no definido|Solicitelo a Sistemas","Atencion","Aceptar");
						return;
					} else {
						frn.setPos("k_password");
						frn.message("Password incorrecto");
						return;
					}	
            }
			}

			fun ClaveAutorizacion(){
				cmd = "select lower(coalesce(valor,'')) as valor from keplersc.param_oper
						where sucursal ='" & sucursal_id & "' and parametro='Clave autorizacion precio menor'";
				rstXml(cubo);
				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"autorizacion.ClaveAutorizacion()");
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				return getXmlAtt(cubo,"r0","valor");
			}

			fun RegBitacora(){
				var fecha_movto,hora_movto,operacion,strValor,mensaje,resultado;
                //Registro del movimiento en bitacora
                fecha_movto =  sys.date();
                hora_movto = sys.time();

                if (!strGen && strlen(strGen)==0){
                    strGen = " ";
                }
                if (!strNat && strlen(strNat)==0){
                    strNat = " ";
                }
                if (!strGpo && strlen(strGpo)==0){
                    strGpo = 0;
                }
                if (!strTipo && strlen(strTipo)==0){
                    strTipo = 0;
                }

                setXml(xmlRequest,"usuario",usuario);			
				setXml(xmlRequest,"fecha",fecha_movto);
				setXml(xmlRequest,"hora",hora_movto);
				setXml(xmlRequest,"sucursal",sucursal_id);
                setXml(xmlRequest,"genero",strGen);			
				setXml(xmlRequest,"naturaleza",strNat);
				setXml(xmlRequest,"grupo",strGpo);
				setXml(xmlRequest,"tipo",strTipo);
                setXml(xmlRequest,"folio",strFolio);
				setXml(xmlRequest,"tipo_movto",strOperacion);
				setXml(xmlRequest,"detalle_movto",strBitacora);
                frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\strValor");

                cmd="SELECT * FROM keplersc.usr_kdusraccess_alta('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";
                kdb.rst(cubo);
				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"autorizacion.RegBitacora()");				

				resultado= getXml(cubo,"resultado");
				mensaje= getXml(cubo,"mensaje");
			
				if(resultado &! "1"){
					frn.message(mensaje, "Error","&Aceptar");
				}
			}	
			
		}
	</script>
</pag>