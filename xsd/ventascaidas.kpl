<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><txt fnt=",23b">Refacciones - Ventas Caidas</txt><br/>	<!-- dim="81,0" --> 	<hLine dim="85,0"/> 	<br/> 	<br/> 		<!-- <grp dim="50,9,7,12" -->				<grp dim="59,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">			<!-- <br/> -->			<txt id="suctxt" visible="Y">  Sucursal : </txt>			<sp n="2"/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="60,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y" visible="Y"/>			<br/>						<!-- <br/> -->			<sp n="1"/>			<txt id="textorig" visible="Y">Origen : </txt> <sp n="4"/>			<cmb id="cmb_orig" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="CambiaOrigen()" visible="Y"/>			<br/>						<!-- <br/> -->			<sp n="1"/>			<txt id="textTipo" visible="N">Orden Tipo :  </txt>			<cmb id="k_tipon" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="CambiaTipo()" available="Y" modify="Y" visible="N"/>			<!-- <br/> -->			<sp n="3"/>			<txt id="textFolio" visible="N">Folio : </txt>			<sp n="1"/>			<edt id="k_folio" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" visible="N" OnButton="ObtenerFolios()" OnF9="ObtenerFolios()" OnChange="BuscarFolio()"/> 			<sp n="2"/>			<inp id="k_st" dim="2,1" brdr="2,0" bclr="255,255,255" clr="170,3,14" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="N" fnt=",0b"/> 			<br/>					</grp>		<sp/>		<!-- dim="30,8,7,12" -->		<grp dim="25,7,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="1"/>			<inp id="operacion" dim="34,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" available="N" modify="N" fnt=",18b" just="C"/><tab/> <br/>			<br/>			<txt>  Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N"/> 			<br/>		</grp>				<br/>		<br/> 				<!-- dim="81,18,7,12" --> 		<grp id="grid" dim="85,24,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,16" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Motivos validos : [P] Precio, [E] Existencia, [C] Venta otra Distribuidora  /  [F9] Catalogo Productos  /  CTRL + DEL Borrar Linea">			<sp n="1"/> 			<!-- fnt="Arial,15" dim="114,6" -->			<!-- OnCtrDel="Get_Data_Row()" -->			<tbl id="k_mov" dim="119,14" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" hk="z" OnMouseD="ToDel()" Reorder="N" modify="Y" insdel="Y" visible="Y">				<col id="borrar" name="Borrar" OnActive="Get_Data_Row()" type="capital" nc="1" modify="N" available="N" visible="N"/>				<col id="ctrlerr" name="ERR" OnActive="Get_Data_Row()" type="capital" nc="1" modify="N" available="N" visible="Y"/>				<col id="prod" name="Producto" OnActive="Get_Data_Row()" type="string" nc="18" modify="Y" available="Y" visible="Y" OnF9="Get_Cat(1)" OnChange="Get_Cat_Data(1, 1)"/>				<col id="dscr" name="Descripcion" OnActive="Get_Data_Row()" type="string" nc="30" OnChange="" OnF9="" OnMouseL="" modify="N" available="Y" visible="Y"/>				<col id="cant" name="Cantidad" OnActive="Get_Data_Row()" type="number" nd="2" modify="Y" available="Y" visible="Y" OnChange="Get_Cat_Data(0,1)"/> <!-- Get_Cat_Data(0,1) -->				<col id="pu" name="Precio" OnActive="Get_Data_Row()" type="number" nd="2" modify="Y" available="Y" visible="Y" OnChange="Get_Cat_Data(0,1)"/> <!-- Get_Cat_Data(0,1) -->				<col id="monto" name="Importe" OnActive="Get_Data_Row()" type="number" nd="2" modify="N" available="Y" visible="Y" OnChange="Get_Cat_Data(0,1)"/> <!-- Get_Cat_Data(0,1) --> 				<col id="motivo" name="Motivo" OnActive="Get_Data_Row()" type="capital" modify="Y" available="Y" visible="Y" OnChange="Get_Cat_Data(0,1)" nc="1"/> <!-- Get_Cat_Data(0,1) -->				<!--				<col id="serie" name="Serie" OnActive="Get_Data_Row()" type="string" nc="20" modify="Y" available="Y" visible="Y" OnChange="Get_Cat_Data(0,1)"/>				<col id="color" name="Color" OnActive="Get_Data_Row()" type="string" nc="10" modify="Y" available="Y" visible="Y" OnF9="Get_Cat(3)" OnChange="Get_Cat_Data(3, 1)"/>				<col id="vest" name="Vest" OnActive="Get_Data_Row()" type="string" nc="10" modify="Y" available="Y" visible="Y" OnF9="Get_Cat(4)" OnChange="Get_Cat_Data(4, 1)"/>				<col id="ref" name="Referencia" OnActive="Get_Data_Row()" type="string" nc="12" OnF9="" OnF10="" modify="Y" visible="Y" OnChange="Get_Cat_Data(0,1)"/>						<col id="suc" name="Sucursal" OnActive="Get_Data_Row()" type="string" nc="5" OnF9="Get_Cat(5)" OnChange="Get_Cat_Data(5, 1)" modify="Y" visible="Y"/>				<col id="fech" name="fech asig" OnActive="Get_Data_Row()" type="string" nc="10" modify="N" visible="N"/>				-->		   </tbl>			<br/>			<br/>			<sp/><txt clr="132,20,7">Mensaje : </txt> 			<inp id="k_err" dim="110,1" clr="132,20,7" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="-1"/>								</grp>		<br/>		<br/>				<sp n="15"/>		<img id="Imprimir" dim="45,45" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Reporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="N" clrBrdr="0,0,0" visible="N" modify="Y"/>					<sp n="25"/>		<img id="Cancelar" dim="45,45" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>					<sp n="10"/>		<img id="Aceptar" dim="45,45" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Crear registros &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>							</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal;			var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd;         var row_grid, err_data, err_empty, fech_original, view_adicionales;         var v_tipoorden, v_folio, dato_id, v_origen;										fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";				fileSavePath = "C:\Basura";								row_grid = 0;				err_empty = 0;				err_data = 0;								Inicializa();								ConfiguraControlesOpcion();							} /* END Func Main() */						fun ToDel() {							var irow, icol;							if (tip_ope &= "B") {					if ( strlen(frn.get("k_mov",-1,"modelo")) != 0 ) {						if ( strlen(frn.get("k_mov",-1,"borrar")) == 0 || frn.get("k_mov",-1,"borrar") &= "" ) {							frn.setX("X","k_mov",-1,"borrar");						} else {							frn.setX("","k_mov",-1,"borrar");						}					}							}									} /* END Func ToDel() */			fun Clean_Ctrls_Panel() {				frn.setX("", "k_err");				} /* END Func Clean_Ctrls_Panel() */									fun Get_Cat(imodo) {            				var suc_id, dato_id;				var win_tit, field_key, field_col, cmdQuery;            				if ( imodo <= 0 || imodo > 5 || tip_ope &! "A" ) {					// No es opcion de CAT Valida ...					return;				} 				win_tit = "";				field_key = "";				field_col = "";				cmdQuery = "";				if (imodo == 1) {						win_tit = "CAT Productos";						field_key = "clave";						field_col = "prod";						cmdQuery = "select C1 as clave, C2 as descripción from keplersc.kdini"; /* where c8 = 'N' */				}																							                      if ( strlen(win_tit) > 0 && strlen(field_key) > 0 && strlen(field_col) > 0 && strlen(cmdQuery) > 0 ) {                            					frn.dialog("genlistasel", win_tit,cmdQuery, field_key,"k_mov",-1, field_col,"S");				}							} /*END Func Get_Cat()*/		   fun Get_Cat_Data(imodo, icall, icalc) {						var suc_id, dato_id;				var field_ori,field_dest, tbl, field_dscr;				var field_add, dato_id_add;				var field_dest_2, dato_id_2;								if ( imodo < 0 || imodo > 1/*5*/  || ( tip_ope &! "A" && icall != 2 ) ) {					// No es opcion de CAT Valida ...					return;				}								if ( icalc == 1 ) { 					//CalculaTotales(); 				}				 				field_dscr = "";				field_ori = "";				field_dest = "";				tbl = "";				cmdQuery = "";								dato_id = "";										if (imodo == 1) {					field_dscr = "Producto";					field_ori = "prod";					field_dest = "dscr";					tbl = "kdini";					cmdQuery = "select C2 as " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'";										}				if ( tip_ope &= "A" ) {					if (imodo == 2) {						field_dscr = "Inventario";						field_ori = "invent";						field_dest = "anio";						tbl = "kddinv";						//cmdQuery = "select C3 as " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'"; 						cmdQuery = "select i.C3 as anio from keplersc.kddinv i inner join keplersc.kdiv k on k.c8 = i.c7 and k.c1 = '" & frn.get("k_mov",-1,"modelo") & "'" & 							" where i.c1 = '" & frn.get("k_mov",-1,field_ori) & "' and i.c7 = 'N'";					}				}											if (imodo == 3) {					field_dscr = "Color Exterior";					field_ori = "color";					field_dest = "color";					field_dest_2 = "descrip";					tbl = "kdice2";					if ( frn.get("k_mov",-1,"anio") &! "--" && trim(frn.get("k_mov",-1,"anio")) &! "" ) {						cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '" & frn.get("k_mov",-1,"modelo") & "' and c3 = '" & frn.get("k_mov",-1,field_ori) & "'";					} else {						cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '' and c3 = ''";					}				}											if (imodo == 4) {					field_dscr = "Color Vestidura";					field_ori = "vest";					field_dest = "vest";					field_dest_2 = "descrip";					tbl = "kdice3";					if ( frn.get("k_mov",-1,"anio") &! "--" && trim(frn.get("k_mov",-1,"anio")) &! "" ) {						cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '" & frn.get("k_mov",-1,"modelo") & "' and c3 = '" & frn.get("k_mov",-1,field_ori) & "'";					} else {						cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '' and c3 = ''";					}				}								if (imodo == 5) {					field_dscr = "Sucursal";					field_ori = "suc";					field_dest = "suc";					field_dest_2 = "descrip";					tbl = "kdms";					if ( frn.get("k_mov",-1,"anio") &! "--" && trim(frn.get("k_mov",-1,"anio")) &! "" ) {						cmdQuery = "select C1 as " & field_dest & ", c2 as " & field_dest_2 &" from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'";					} else {						cmdQuery = "select C1 as " & field_dest & ", c2 as " & field_dest_2 &" from keplersc." & tbl & " where c1 = 'none!@?'";					}				}								if (imodo == 0 && icall == 1) {					Eval_Data_Row(frn.getJ("k_mov"));				}								if (icall == 2 && tip_ope &! "A") {					frn.setX(frn.get("k_mov",-1,"fech"), "k_fecha_asig");				}											field_add = "";				/*				if (imodo == 1) { field_add = "k_descrip"; }				if (imodo == 3) { field_add = "k_color_ext"; }				if (imodo == 4) { field_add = "k_color_vest"; }					if (imodo == 5) { field_add = "k_suc"; }					*/											if ( strlen(field_dscr) > 0 && strlen(field_ori) > 0 && strlen(field_dest) > 0 && strlen(tbl) > 0 && strlen(cmdQuery) > 0 ) {					if ( strlen(frn.get("k_mov",-1,field_ori)) != 0 ) {						//dato_id = frn.get("k_mov",-1,field_ori);						//cmdQuery = "select C2 as descrip from keplersc.kdiv where c1 = '" & dato_id & "'";						rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comaltasigcrud.Get_Cat_" & tbl & "()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\Get_Cat_" & tbl);						ok=getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok){							dato_id = "--";							if (imodo == 1) {								dato_id = "[ERR] verificando " &  field_dscr & " ...";							}							frn.setX(dato_id,"k_mov",-1, field_dest);							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							dato_id_add = "";							if (imodo == 1) { dato_id_add = dato_id; }							if (imodo == 3 || imodo == 4 || imodo == 5) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							//if (imodo == 4) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							//if (imodo == 5) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							if ( strlen(field_add) != 0 ) { frn.setX(dato_id_add, field_add); }							return;						}						dato_id = "";						dato_id = getXmlAtt(cuboQuery,"r0", field_dest);					   if( strlen(dato_id) == 0 ){							//dato_id = "--";							dato_id = "";							if (imodo == 1 /*&& icall ==1*/) {								/*								if ( strlen(frn.get("k_mov",-1,"invent")) > 0 ) {									frn.setX(dato_id, "k_mov",-1, "invent");									frn.setX(dato_id, "k_mov",-1, "anio");								}								if ( strlen(frn.get("k_mov",-1,"color")) > 0 ) {									frn.setX(dato_id, "k_mov",-1, "color");									frn.setX("Color Exterior No Valido ...", "k_color_ext");								}								if ( strlen(frn.get("k_mov",-1,"vest")) > 0 ) {									frn.setX(dato_id, "k_mov",-1, "vest");									frn.setX("Color Vestidura No Valido ...", "k_color_vest");								}								if ( strlen(frn.get("k_mov",-1,"suc")) > 0 ) {									frn.setX(dato_id, "k_mov",-1, "suc");									frn.setX("Sucursal No Valido ...", "k_suc");								}								if ( strlen(frn.get("k_mov",-1,"serie")) > 0 ) {									frn.setX("", "k_mov",-1, "serie");								}								if ( strlen(frn.get("k_mov",-1,"ref")) > 0 ) {									frn.setX("", "k_mov",-1, "ref");								}								*/																// New Code 20230907								/*								frn.setX(dato_id, "k_mov",-1, "ctrlerr");								frn.setX(dato_id, "k_mov",-1, "cant");								frn.setX(dato_id, "k_mov",-1, "pu");								frn.setX(dato_id, "k_mov",-1, "monto");								frn.setX(dato_id, "k_mov",-1, "motivo");								*/																//frn.setX("", "k_mov",-1, "ctrlerr");								/*								frn.setX("", "k_marca");								frn.setX("", "k_clase");								frn.setX("", "k_tipo_auto");								frn.setX("", "k_fecha_asig");								*/								frn.setX("", "k_err");												dato_id = field_dscr & " No existe ...";							}							frn.setX(dato_id, "k_mov",-1, field_dest);										/*							dato_id_add = "";						   if (imodo == 1) { dato_id_add = dato_id; }							if (imodo == 3 || imodo == 4 || imodo == 5) { dato_id_add = field_dscr & " No Existe ..."; }							if ( strlen(field_add) != 0 ) { frn.setX(dato_id_add, field_add); }							*/														Eval_Data_Row(frn.getJ("k_mov"));									return;												} else {													frn.setX(dato_id,"k_mov",-1,field_dest);							if (imodo == 1 && icall == 1) {								dato_id_2 = ""; 								//frn.setX(dato_id_2, "k_mov",-1, "dscr");								frn.setX(dato_id_2, "k_mov",-1, "cant");								frn.setX(dato_id_2, "k_mov",-1, "pu");								frn.setX(dato_id_2, "k_mov",-1, "monto");								frn.setX(dato_id_2, "k_mov",-1, "motivo");								Clean_Ctrls_Panel();							}														// Fill Data Panel of OBJs Adds 							if (imodo == 3 || imodo == 4  || imodo == 5) {								dato_id_2 = "";								dato_id_2 = getXmlAtt(cuboQuery,"r0", field_dest_2); 							}							/*							if (imodo == 1) { dato_id_add = dato_id; }							if (imodo == 3 || imodo == 4 || imodo == 5) { dato_id_add = dato_id_2; }							if ( imodo == 1 || imodo == 3 || imodo == 4 || imodo == 5 ) { frn.setX(dato_id_add, field_add); }							*/							// Fill Other Data Panel of OBJs Adds related to field : modelo							/*							if (imodo == 1) { 								frn.setX(getXmlAtt(cuboQuery,"r0", "clase_descr"), "k_clase");								frn.setX(getXmlAtt(cuboQuery,"r0", "marca_descr"), "k_marca");								frn.setX(getXmlAtt(cuboQuery,"r0", "tipo_auto"), "k_tipo_auto");							}							*/														Eval_Data_Row(frn.getJ("k_mov"));												}					} else {											frn.setX(dato_id,"k_mov",-1,field_dest);							dato_id_add = dato_id;												if ( imodo == 1 ) {							/*							frn.setX(dato_id, "k_mov",-1, "ctrlerr");							frn.setX(dato_id, "k_mov",-1, "cant");							frn.setX(dato_id, "k_mov",-1, "pu");							frn.setX(dato_id, "k_mov",-1, "monto");							frn.setX(dato_id, "k_mov",-1, "motivo");							Clean_Ctrls_Panel();											*/							}												/*if ( imodo == 1 || imodo == 3 || imodo == 4 || imodo == 5 ) { frn.setX(dato_id_add, field_add); }*/																	Eval_Data_Row(frn.getJ("k_mov"));											}				}					} /*END Fun Get_Cat_Data()*/			fun Get_Data_Row() {								var irow, icol;				var rows, evalrow;								rows = frn.N("k_mov") - 1;								icol = frn.getI("k_mov");				irow = frn.getJ("k_mov");								if ( row_grid != frn.getJ("k_mov") /*rows - 1*/ ) {									//Eval_Data_Row(row_grid); // was commented										// code added 20230907										/*					if ( irow == rows ) {						return;					}					*/										evalrow = Eval_Data_Row(row_grid);					if ( evalrow >= 0 ) {						if ( row_grid != rows ) {							frn.setPos("k_mov",row_grid, icol); // -1						} else {							row_grid = frn.getJ("k_mov");						}						return;					}										row_grid = frn.getJ("k_mov"); // commented									if ( strlen(frn.get("k_mov",-1,"prod")) == 0 ) {						Clean_Ctrls_Panel();					} else { 						for (var i=0; i<=5; i++) {							if ( tip_ope &! "A" ) {								Get_Cat_Data(i,2);							} else {								Get_Cat_Data(i);							}						}						Eval_Data_Row(row_grid); // commented						//row_grid = frn.getJ("k_mov"); // New 											}						}								//frn.setX("REN " & irow + 1 & " , COL " & icol, "k_err");			   //frn.setPos("k_mov",-1, icol);								} /*END Func Get_Data_Row()*/			fun Eval_Data_Row(nRow, imodo) {				var ColIni, ColEnd, EvalCols, ErrText;				var FieldsListData, FieldListEmpty;				var monto, v_motivo;								if ( nRow == imodo && nRow != 0 ) { 					return -1; 				}								if ( tip_ope &! "A" ) { 					return; 				}								// New code 20231003 ...				if ( ( nRow == frn.N("k_mov") - 1 ) /*&& nRow != 0*/ ) {					frn.setX("", "k_err");					return;				}								ColEnd = 7; /*10*/				ColIni = 2;				EvalCols = ColEnd - ColIni + 1;				ErrText = "";							err_empty = 0;				err_data = 0;								FieldsListData = "";				FieldListEmpty = "";						// New code 20230907				if ( strlen(frn.get("k_mov", nRow, "prod")) != 0 ) {					monto = frn.get("k_mov", nRow, "cant") * frn.get("k_mov", nRow, "pu");					frn.setX(monto, "k_mov", nRow, "monto");				} else {					frn.setX("", "k_mov", nRow, "monto");				}								// Evaluando vacios ...				for (var i=ColIni; i<=ColEnd; i++) {					if ( strlen( frn.get("k_mov", nRow, Get_Column(i) )) == 0 ) { 						err_empty = err_empty + 1;						FieldListEmpty = FieldListEmpty & Get_Column_Dscr(i) & " | "; 					} 				}								// Evaluando datos ...				for (var i=ColIni; i<=ColEnd; i++) {									if ( strlen( frn.get("k_mov", nRow, Get_Column(i) )) != 0 ) { // New condition 20230907											if ( (i == 3 || i == 4 || i == 7) && frn.get("k_mov", nRow, Get_Column(i)) &= "--"  ) { err_data = err_data + 1; } 						if ( i == 3/*5*/ && frn.get("k_mov", nRow, Get_Column(i)) &= "Producto No existe ..."  ) { 							err_data = err_data + 1; 							//if ( i == 3) {								FieldsListData = FieldsListData & Get_Column_Dscr(2) & " | ";							//} else {							//	FieldsListData = FieldsListData & Get_Column_Dscr(i) & " | ";							//}						} 												if ( i == 4 && frn.get("k_mov", nRow, "cant") <= 0 ) {							err_data = err_data + 1;							FieldsListData = FieldsListData & Get_Column_Dscr(4) & " <= 0 | ";						}																		if ( i == 5 && frn.get("k_mov", nRow, "pu") <= 0 ) {							err_data = err_data + 1;							FieldsListData = FieldsListData & Get_Column_Dscr(5) & " <= 0 | ";						}														if ( i == 6 && frn.get("k_mov", nRow, "monto") <= 0 ) {							err_data = err_data + 1;							FieldsListData = FieldsListData & Get_Column_Dscr(6) & " <= 0 | ";						}											v_motivo = "";						v_motivo = frn.get("k_mov", nRow, "motivo");						v_motivo = strFormat("ucase",v_motivo);						if ( i == 7 /*&& v_motivo &! "P" && v_motivo &! "E" && v_motivo &! "C"*/ ) {							if ( /*i == 7 &&*/ v_motivo &! "P" && v_motivo &! "E" && v_motivo &! "C" ) {								err_data = err_data + 1;								FieldsListData = FieldsListData & Get_Column_Dscr(7) & " No Valido | ";							}						}												}									}				 								if ( err_data > 0 ) { ErrText = ErrText & "[No Validos] : " & FieldsListData; }					if ( err_empty > 0 /*&& err_empty < EvalCols*/ ) { ErrText = ErrText & "[Sin Registrar] : " & FieldListEmpty; }								//if ( err_empty == EvalCols && err_data == 0 ) { return; }				if ( strlen( ErrText ) == 0 ) { 					frn.setX("", "k_err");					frn.setX("", "k_mov", nRow, "ctrlerr");					return -1; 				}								frn.setX(ErrText, "k_err");				frn.setX("X", "k_mov", nRow, "ctrlerr");				return nRow;						} /*END Func Eval_Data_Row()*/			fun Get_Column(imodo) {				var colName;				switch(imodo) { 					case 2: colName = "prod";break; 					case 3: colName = "dscr";break;					case 4: colName = "cant";break;					case 5: colName = "pu";break;					case 6: colName = "monto";break;					case 7: colName = "motivo";break;					default: colName = "";break;				}				return colName;			} /*END Func Get_Column()*/			fun Get_Column_Dscr(imodo) {				var colName;				switch(imodo) { 					case 2: colName = "Producto";break; 					case 3: colName = "Descripcion";break;					case 4: colName = "Cantidad";break;					case 5: colName = "Precio";break;					case 6: colName = "Importe";break;					case 7: colName = "Motivo";break;					default: colName = "";break;				}				return colName;			} /*END Func Get_Column()*/			fun Cancela() {				CambiaSucursal();				Inicializa();				ConfiguraControlesOpcion();			} /* END Func Cancela() */									fun ModoBuscar(imodo, iview) {				tip_ope = "C";				frn.set("operacion", "CONSULTA");				if ( ( imodo == 1 || imodo == 2 ) && tip_ope_original &= "A" ) {					frn.set("k_fecha", fech_original);  				} else { 					LimpiaEncabezado();				}				ConfiguraControlesOpcion(imodo);				CambiaSucursal(imodo);			} /*END Func ModoBuscar()*/									fun Ejecuta() {				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg;				var resultado, mensaje, adicionales, folio;				var RowErr, iLim;								//fecha = sys.date();				//hora = sys.time();								resultado = "";				mensaje = "";				adicionales = "";				view_adicionales = "";								if (tip_ope &= "A") { 								// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ...										// * * * * * Validando Encabezados . . . 					//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok					resVal = 1;					ValidarDatos();					if(ok &! "1" || resVal == 0){						return;					}										// * * * * * Validando Grid . . . 					RowErr = -1;					iLim = frn.N("k_mov") - 1;					if ( iLim == 0 ) {						frn.message("No hay registros a procesar ...", "Info !!! ", "Aceptar");						return;							}					for (var i=0; i<=iLim ; i++) {						RowErr = Eval_Data_Row(i, iLim);						if ( RowErr != -1 ) { break; }					}					if ( RowErr != -1 ) {						frn.setPos("k_mov", RowErr, "ctrlerr");						frn.message("Se encontraron registros con errores.", "Info !!! ", "Aceptar");						return;					}										// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ...																						// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;										//Agregar usuario, fecha y hora de movimiento					/*					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;					*/										//setXml(xmlPantalla,"movimiento","usuario",usuario);					//setXml(xmlPantalla,"movimiento","fecha",strFecha);					//setXml(xmlPantalla,"movimiento","hora",					//	frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					//	frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					setXml(xmlPantalla,"k_mov","no_partidas", iLim);					//setXml(xmlPantalla,"ambiente","anio_contable",anio_contable											frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\XmltoPostgres_ventascaidas");										// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ...															// FOR TESTING 					/*					mensaje = "La Transaccion se Procesara ...";					frn.message(mensaje, "Info !!!", "Aceptar");					return;					*/															// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 								cmdQuery="SELECT * FROM keplersc.ventas_caidas('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					rstXml(cuboQuery);					cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"ventascaidas.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_ventascaidas");										// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 												 /*					resultado = "1";					mensaje = "Las partidas han sido registradas exitosamente ..." & "|" & "Testing Pipe separator";					//adicionales = "Testing Active Button ...";					 */										// /*					resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");					adicionales = getXml(cuboQuery,"adicionales");					// */																		if(resultado &= "1") {											frn.message("Resultado [" & resultado & "] ; " & mensaje, "Info !!! ", "Aceptar");												MostrarDatosGrd();												} else {						frn.message(mensaje, "Error", "Aceptar");					}				} /*End Alta*/ else {					if (tip_ope &= "B") {						/*Ini Baja*/												// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ...						RowErr = 0;						iLim = frn.N("k_mov") - 1;						if ( iLim == 0 ) {							frn.message("No hay registros a procesar ...", "Info !!! ", "Aceptar");							return;								}						for (var i=0; i<=iLim ; i++) {							if ( frn.get("k_mov",i,"borrar") &= "X" ) { RowErr = RowErr + 1; }						}						if ( RowErr == 0 ) {							frn.setPos("k_mov", RowErr, "modelo");							Get_Data_Row();							frn.message("No Se encontraron registros a procesar [Cancelar].", "Info !!! ", "Aceptar");							return;						}						// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ...				   				   						// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 												xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;											//Agregar usuario, fecha y hora de movimiento						/*						strFecha = fnDate("year",fecha) & "-";						strTmp = fnDate("month",fecha);						if(strlen(strTmp) == 1){							strTmp = "0" & strTmp;						}						strFecha = strFecha & strTmp & "-";						strTmp = fnDate("day",fecha);						if(strlen(strTmp) == 1){							strTmp = "0" & strTmp;						}						strFecha = strFecha & strTmp;						*/											//setXml(xmlPantalla,"movimiento","usuario",usuario);						//setXml(xmlPantalla,"movimiento","fecha",strFecha);						//setXml(xmlPantalla,"movimiento","hora",						//	frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 						//	frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));						setXml(xmlPantalla,"k_mov","no_partidas", iLim);						//setXml(xmlPantalla,"ambiente","anio_contable",anio_contable												frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\XmltoPostgres_OOB3");											// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 																// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 									cmdQuery="SELECT * FROM keplersc.autos_com_asig_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						//kdb.rst(cuboQuery);						rstXml(cuboQuery);						cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"autos_com_asig_crud.Ejecuta");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_OOB3");											// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 																/*						resultado = "2";						mensaje = "Las partidas han sido registradas exitosamente ..." & "|" & "Testing Pipe separator";						adicionales = "Testing Active Button ...";						*/																// /*						resultado = getXml(cuboQuery,"resultado");						mensaje = getXml(cuboQuery,"mensaje");						adicionales = getXml(cuboQuery,"adicionales");						// */																								//if(resultado &= "1") {						if(resultado &= "1" || resultado &= "2") {												if (resultado &= "1") {								frn.message("Resultado [" & resultado & "] ; " & mensaje, "Info !!! ", "Aceptar");							} else {								view_adicionales = adicionales;								frn.message("Resultado [" & resultado & "] ; " & mensaje & "|" & "Partidas No Canceladas : " & "|" & adicionales , "Info !!! ", "Aceptar");							}													if ( strlen(adicionales) > 0 ) {								ModoBuscar(2, 2);							} else {  								ModoBuscar(1, 1); // 220721 ... added 							}												} else {							frn.message(mensaje, "Error", "Aceptar");						}						// */											} /*End Baja*/ else {						return;					}	/*End Consulta (for exception)*/ 				}							} /* END Func Ejecuta() */									fun Inicializa(){ //Inicializa los valores en Pantalla				// Our code				var fech_init, strFecha, strTmp,fecha; 				// Revisa y Carga en Variables los Parámetros Recibidos en la corrida				//if( frn.nParam() == 5 ){ //Se han mandado parámetros a la página				if( frn.nParam() == 1 ){ //Se han mandado parámetros a la página					/*               gen_doc=trim(frn.param(0));                nat_doc=trim(frn.param(1));                gpo_doc=trim(frn.param(2));               tip_doc=trim(frn.param(3));                tip_ope=trim(frn.param(4));               paramProd=trim(frn.param(5));               */				   gen_doc="";                nat_doc="";                gpo_doc="";               tip_doc="";                paramProd="";				   tip_ope = trim(frn.param(0));               tip_ope_original = tip_ope;             } else {					frn.message("Operación no válida ...", "Mensaje","&Aceptar");					//frn.open("anuncios",4);					frn.open("index",4);					return;				}							//frn.message("Parameters : " & frn.nParam() & " ; tip_ope : " & tip_ope, "Info Parameters", "Aceptar");								// For Testing ...				//tip_ope = "A";				tip_ope_original = tip_ope;								if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					/*					if(tip_ope &= "B"){ //Baja						frn.set("operacion","BAJA");					} else {*/						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} else {					      frn.message("Operación no válida ...", "Mensaje","&Aceptar");							//frn.open("anuncios",4);							frn.open("index",4);							return;									}					/*}*/				}												LimpiaDatosDoc();								/*if(tip_ope &! "A"){*/					// Fill Combo Sucursal (Con Query de PostgreSQL)					cmdQuery = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdms";					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ventascaidas.IniCombos()");					frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\sucursal_combo");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.set("k_sucn",cuboQuery);										CambiaSucursal();															// Fill Combo Tipo (Con Query FTO Kepler) 					/*					cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm " &					"where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4 = '" & tip_doc & "'" ;					*/					rstXml(cuboQuery);					cmdQuery = "select '['||c1||'] '||c3 as c2, c1 from keplersc.kdmargen";					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Inicializa()");					//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboTipoDocto");							ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error BD","Aceptar");						return;					}					frn.set("k_tipon",getXml(cuboQuery));										// Fill Combo Origen (Manual)					frn.setX("Refacciones ","cmb_orig",0,0);					frn.setX("R","cmb_orig",0,1);					frn.setX("Servicio ","cmb_orig",1,0);					frn.setX("S","cmb_orig",1,1);							// End Our Code									frn.set("cmb_orig","Refacciones ");																/*} else {*/					row_grid = -1 /*0*/;					err_empty = 0;					err_data = 0;							/*}*/								// This code is to make tests ...				/*				fecha = sys.date();				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha)-1;				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;				*/				strFecha = sys.date();								fech_init = strFecha;				frn.set("k_fecha", fech_init);				fech_original = frn.get("k_fecha");								//frn.set("k_fecha", sys.date());				//frn.set("k_hora",sys.time());									CambiaOrigen();											} /* END Func Inicializa() */									//Validacion Datos Generales y Partidas antes de Guardar.			//El resultado de cada validacion se guarda en la variable global resVal.			fun ValidarDatos(iModo) {				var totReg/*, subTotal=0, iva=0, total=0*/;				//var no_part=0;								if ( frn.get("cmb_orig",-1,1) &= "S" ) {									//Obtener variables					sucursal_id = /*"02"*/ frn.get("k_sucn",-1,1);						v_tipoorden = frn.get("k_tipon",-1,1);					v_folio = frn.get("k_folio");					dato_id = "";					//Validar Referencia					cmdQuery = "select count(*) as totreg from keplersc.kdord " &					"where c1 = '" & sucursal_id & "' and c2 = '" & v_tipoorden & "'" & " and c3 = '" & v_folio & "'";									rstXml(cuboQuery);					if (iModo != 1) {  						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ventascaidas.ValidarDatos()");					} else { 						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ventascaidas.ValidarDatos_Baja()");					}					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error DB","Aceptar"); //TO DO Homologar mensaje en todo el proyecto, agregar DB						return;					}					totReg=getXmlAtt(cuboQuery,"r0","totreg");					if(totReg==0){						frn.message("La Orden No Existe ... (verifique el Numero asociado al Tipo de Orden)","Error","Aceptar");						resVal=0;						return;					}								}								// N.A. 4 This Option 				/*						no_part = frn.N("k_mov");				// 				//if (iModo != 1) {  // 20220814  				//	//Validar Cantidades				//	//for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {				//	for (var i=0,n=frn.N("k_mov");i<n;i++) { 				//		frn.setPos("k_mov",i,"k_q");				//		resVal=CalculaTotales(1);				//		if(resVal==0){				//			return;				//		}				//	}				//} else { 				// 					if (frn.N("k_mov") == 0) {						frn.message("La operacion no tiene partidas.","Error","Aceptar");						resVal=0;						return;					}					else { CalculaTotales(); } // Added ... 20230903				// }				*/												// N.A. 4 This Option 				/*				//Validar Totales				//subTotal = frn.get("k_subtotal");				//iva  =frn.get("k_iva");				total = frn.get("k_monto");				if (total <= 0){					frn.message("El total de la operación no puede ser cero.","Error","Aceptar");					resVal = 0;					return;				}				*/							} // End ValidarDatos()									fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         } /* END Func PadLeft() */			fun ConfiguraControlesOff() {								frn.setAtt("suctxt", "visible", "N");				frn.setAtt("k_sucn", "visible", "N");								frn.setAtt("textorig", "visible", "N");				frn.setAtt("cmb_orig", "visible", "N");								frn.setAtt("textTipo", "visible", "N");				frn.setAtt("textFolio", "visible", "N");				frn.setAtt("k_tipon", "visible", "N");				frn.setAtt("k_folio", "visible", "N");					frn.setAtt("k_st", "visible", "N");												frn.setAtt("grid", "tit", "Registro Items : ");								frn.setAtt("k_mov", "modify", "N");				frn.setAtt("k_mov", "insdel", "N");				//frn.setAtt("k_mov", "nren", "fijo");								//modify="Y" insdel="N" nren="fijo"			   frn.setAtt("k_fecha", "available", "N");								frn.setAtt("k_mov", "modify", "N", "borrar");				frn.setAtt("k_mov", "visible", "N", "borrar");				frn.setAtt("k_mov", "modify", "N", "ctrlerr");				frn.setAtt("k_mov", "visible", "N", "ctrlerr");					frn.setAtt("k_mov", "modify", "N", "prod");				frn.setAtt("k_mov", "visible", "Y", "prod");								frn.setAtt("k_mov", "modify", "N", "dscr");				frn.setAtt("k_mov", "visible", "Y", "dscr");					frn.setAtt("k_mov", "modify", "N", "cant");				frn.setAtt("k_mov", "visible", "Y", "cant");					frn.setAtt("k_mov", "modify", "N", "pu");				frn.setAtt("k_mov", "visible", "Y", "pu");											frn.setAtt("k_mov", "modify", "N", "monto");				frn.setAtt("k_mov", "visible", "Y", "monto");											frn.setAtt("k_mov", "modify", "N", "motivo");				frn.setAtt("k_mov", "visible", "Y", "motivo");																						frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											} /* END Func ConfiguraControlesOff() */									fun ConfiguraControlesOpcion(imodo) {				var text_grid;								text_grid = "Motivos validos : [P] Precio, [E] Existencia, [C] Venta otra Distribuidora  /  [F9] Catalogo Productos  /  CTRL + DEL Borrar Linea";							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta					frn.setAtt("suctxt", "visible", "Y");					frn.setAtt("k_sucn", "visible", "Y");					frn.setAtt("k_fecha", "available", "N");										frn.setAtt("grid", "tit", text_grid);				   // " [ F9 ] obtener valores de Catalogos ");				   				   frn.setAtt("textorig", "visible", "Y");				   frn.setAtt("cmb_orig", "visible", "Y");										frn.setAtt("k_mov", "modify", "Y");					frn.setAtt("k_mov", "insdel", "Y");					//frn.setAtt("k_mov", "nren", "");											frn.setAtt("k_mov", "modify", "N", "borrar");					frn.setAtt("k_mov", "visible", "N", "borrar");					frn.setAtt("k_mov", "available", "N", "borrar");					frn.setAtt("k_mov", "modify", "N", "ctrlerr");					frn.setAtt("k_mov", "visible", "Y", "ctrlerr");					frn.setAtt("k_mov", "available", "N", "ctrlerr");										frn.setAtt("k_mov", "modify", "Y", "prod");					frn.setAtt("k_mov", "visible", "Y", "prod");									frn.setAtt("k_mov", "modify", "N", "dscr");					frn.setAtt("k_mov", "visible", "Y", "dscr");						frn.setAtt("k_mov", "modify", "Y", "cant");					frn.setAtt("k_mov", "visible", "Y", "cant");						frn.setAtt("k_mov", "modify", "Y", "pu");					frn.setAtt("k_mov", "visible", "Y", "pu");												frn.setAtt("k_mov", "modify", "N", "monto");					frn.setAtt("k_mov", "visible", "Y", "monto");												frn.setAtt("k_mov", "modify", "Y", "motivo");					frn.setAtt("k_mov", "visible", "Y", "motivo");																				frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");													} else {									/*					if ( ( imodo == 1 || imodo == 2 ) && tip_ope_original &= "A" ) {						frn.setAtt("suctxt", "visible", "N");						frn.setAtt("k_sucn", "visible", "N");										} else {						frn.setAtt("suctxt", "visible", "Y");						frn.setAtt("k_sucn", "visible", "Y");					}					*/					/*					if ( imodo == 2 ) {						frn.setAtt("btn_view", "visible", "Y");					} else {						frn.setAtt("btn_view", "visible", "N");							}					*/					/*					if ( ( imodo == 1 || imodo == 2 ) && tip_ope_original &= "A" ) {						frn.set("k_fecha", fech_original);					} else {						frn.set("k_fecha", "");					}					frn.setAtt("k_fecha", "available", "N");					*/										if(tip_ope &= "B"){ //Baja											frn.setAtt("grid", "tit", text_grid);												frn.setAtt("k_mov", "modify", "N");						frn.setAtt("k_mov", "insdel", "N");						//frn.setAtt("k_mov", "nren", "fijo");										frn.setAtt("k_mov", "modify", "N", "borrar");						frn.setAtt("k_mov", "visible", "Y", "borrar");						frn.setAtt("k_mov", "modify", "N", "ctrlerr");						frn.setAtt("k_mov", "visible", "N", "ctrlerr");								frn.setAtt("k_mov", "modify", "N", "prod");						frn.setAtt("k_mov", "visible", "Y", "prod");										frn.setAtt("k_mov", "modify", "N", "dscr");						frn.setAtt("k_mov", "visible", "Y", "dscr");							frn.setAtt("k_mov", "modify", "N", "cant");						frn.setAtt("k_mov", "visible", "Y", "cant");							frn.setAtt("k_mov", "modify", "N", "pu");						frn.setAtt("k_mov", "visible", "Y", "pu");													frn.setAtt("k_mov", "modify", "N", "monto");						frn.setAtt("k_mov", "visible", "Y", "monto");													frn.setAtt("k_mov", "modify", "N", "motivo");						frn.setAtt("k_mov", "visible", "N", "motivo");																												frn.setAtt("Imprimir", "visible", "N");						frn.setAtt("Cancelar", "visible", "Y");						frn.setAtt("Aceptar", "visible", "Y");															} else {											/*						if ( tip_ope &= tip_ope_original && tip_ope &= "C" ) { //Consulta						   frn.setAtt("grid", "tit", "Asignaciones :  <  DblClic para poder modificar el Registro del Inventario  >");						} else {   							frn.setAtt("grid", "tit", "Asignaciones del dia : ");						}						*/												frn.setAtt("grid", "tit", text_grid);												/*						frn.setAtt("textorig", "visible", "Y");						frn.setAtt("cmb_orig", "visible", "Y");						*/												frn.setAtt("k_mov", "modify", "N");						frn.setAtt("k_mov", "insdel", "N");						//frn.setAtt("k_mov", "nren", "fijo");														frn.setAtt("k_mov", "modify", "N", "borrar");						frn.setAtt("k_mov", "visible", "N", "borrar");						frn.setAtt("k_mov", "modify", "N", "ctrlerr");						frn.setAtt("k_mov", "visible", "N", "ctrlerr");									frn.setAtt("k_mov", "modify", "N", "prod");						frn.setAtt("k_mov", "visible", "Y", "prod");										frn.setAtt("k_mov", "modify", "N", "dscr");						frn.setAtt("k_mov", "visible", "Y", "dscr");							frn.setAtt("k_mov", "modify", "N", "cant");						frn.setAtt("k_mov", "visible", "Y", "cant");							frn.setAtt("k_mov", "modify", "N", "pu");						frn.setAtt("k_mov", "visible", "Y", "pu");													frn.setAtt("k_mov", "modify", "N", "monto");						frn.setAtt("k_mov", "visible", "Y", "monto");													frn.setAtt("k_mov", "modify", "N", "modelo");						frn.setAtt("k_mov", "visible", "N", "modelo");													frn.setAtt("Imprimir", "visible", "N");						frn.setAtt("Cancelar", "visible", "N");						frn.setAtt("Aceptar", "visible", "N");						}				}			} /* END Func ConfiguraControlesOpcion() */			fun LimpiaDatosDoc {				// Limpia todos los objetos asociados a los detalles incluido el k_mov				frn.set("k_mov", "");			} /* END Func LimpiaDatosDoc() */						fun LimpiaTotalesDoc {				// Limpia todos los objetos totalizadores asociados a los detalles y encabezados incluido el k_mov				// N.A.  para este formulario ...			} /* END Func LimpiaTotalesDoc() */						fun LimpiaEncabezado {				// Limpia todos los objetos asociados al encabezado por lo regular predecesores al k_mov				frn.set("k_folio", "");				frn.setX("X", "k_st");				frn.set("k_fecha", "");			} /* END Func LimpiaEncabezado() */						fun CambiaSucursal(imodo) {				if (imodo != 1 && imodo != 2) {					LimpiaDatosDoc();					LimpiaEncabezado();					frn.set("k_fecha",sys.date());				}				//frn.set("k_hora",sys.time());					//ArmarRefDocto();				row_grid = -1;							if (tip_ope &! tip_ope_original && imodo != 1 && imodo != 2) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA - NUEVOS");					} else {						/*if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {*/							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						/*}*/					}				} 								if(tip_ope &! "A" || imodo == 1 || imodo == 2){					// Commented 20231006					/*					if (imodo != 1 && imodo != 2) {						frn.set("k_fecha","");					}					*/					MostrarDatosGrd(imodo);					//frn.setPos("k_mov", 0, "prod");					Get_Data_Row();				}							} /* END Func CambiaSucursal() */						fun CambiaTipo {				LimpiaDatosDoc();				//LimpiaTotalesDoc();				LimpiaEncabezado();				frn.set("k_fecha",sys.date());				//frn.set("k_hora",sys.time());					//ArmarRefDocto();								if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						}					}								}			}						fun CambiaOrigen() {							LimpiaDatosDoc();							if ( frn.get("cmb_orig",-1,1) &= "S" ) {									frn.setAtt("textTipo", "visible", "Y");					frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_tipon", "visible", "Y");					frn.setAtt("k_folio", "visible", "Y");					//frn.setAtt("k_st", "visible", "Y");					frn.setX("X", "k_st");									} else {									frn.setAtt("textTipo", "visible", "N");					frn.setAtt("textFolio", "visible", "N");					frn.setAtt("k_tipon", "visible", "N");					frn.setAtt("k_folio", "visible", "N");						//frn.setAtt("k_st", "visible", "N");												MostrarDatosGrd();									}							}									fun ObtenerFolios() {			            sucursal_id = /*"02"*/ frn.get("k_sucn",-1,1);	            cmdQuery = "" &						"select i.c3 as folio, i.c11 as cliente, i.c4 as fecha from keplersc.kdord i " & 						"where i.c1 = '" & sucursal_id & "' and i.c2 = '" & frn.get("k_tipon",-1,1)  & "' order by i.c3 desc";						                                    frn.dialog("genlistasel","Relacion de Ordenes",cmdQuery,"folio","k_folio","0","","N");                     }                  			fun BuscarFolio() {							LimpiaDatosDoc();							var folio, folio2;				folio = frn.get("k_folio");								folio2 = PadLeft(folio, 10, "0");				frn.set("k_folio", folio2);								frn.setX("X", "k_st");								//MostrarDOC(folio);									sucursal_id = /*"02"*/ frn.get("k_sucn",-1,1);					v_tipoorden = frn.get("k_tipon",-1,1);				v_folio = frn.get("k_folio");				dato_id = "";				cmdQuery = "select c1, c2, c3 from keplersc.kdord " &				"where c1 = '" & sucursal_id & "' and c2 = '" & v_tipoorden & "'" & " and c3 = '" & v_folio & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ser_ordenrpt_data_i_rpt");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "c3");				if ( strlen(dato_id) == 0 ) {					// Records Not found					frn.setX("X", "k_st");					frn.message("Orden No Existe ...","Info !!!","Aceptar");				} else {					// Record found 					frn.setX("", "k_st");				}								MostrarDatosGrd();							}								   fun MostrarDatosGrd(imodo) {		   				var xmlGrd;												sucursal_id = frn.get("k_sucn",-1,1);				v_tipoorden = frn.get("k_tipon",-1,1);				v_folio = frn.get("k_folio");				v_origen = frn.get("cmb_orig",-1,1);						LimpiaDatosDoc();												//if ( ( imodo == 1 || imodo == 2 ) && tip_ope_original &= "A"   ) {				if ( v_origen &= "S" ) {					cmdQuery = "select '' as ctrlerr, c4 as prod, c5 as dscr, c6 as cant, c7 as pu, c8 as monto, c9 as motivo " &						"from keplersc.kdvencaidas where c1 = '" & sucursal_id & "' and c2 = '" & frn.get("k_fecha") /*fech_original*/ & "' " & 						" and c10 = '" & v_origen & "' and c11 = '" & v_tipoorden & "' and c12 = '" & v_folio & "' order by c3 ";				} else {					cmdQuery = "select '' as ctrlerr, c4 as prod, c5 as dscr, c6 as cant, c7 as pu, c8 as monto, c9 as motivo " &						"from keplersc.kdvencaidas where c1 = '" & sucursal_id & "' and c2 = '" & frn.get("k_fecha") /*fech_original*/ & "' " & 						" and c10 = '" & v_origen & "' order by c3 ";						}				//} else {				//	cmdQuery = "select '' as borrar, c3 as modelo, c2 as invent, c15 as anio, c4 as descrip, c5 as serie, c10 as color, c11 as vest, c1 as suc, c24 as fech " &				//		"from keplersc.kdinf where c1 = '" & sucursal_id & "'" & " and c31 = 10 and upper(c21) = 'NUEVO' order by c24 desc, right(c2,length(c2)-5) asc, left(c2,4) desc ";				//}								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comaltasigcrud.mostrardatosgrid()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosgrid");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					//frn.message("Sin Registros por mostrar ...","Info","Aceptar");					//frn.setPos("k_sucn");					//frn.setPos("cmb_orig");					return;					}					//frn.set(cuboQuery);							rstXml(xmlGrd);				xmlGrd=frn.lib("libGeneral.kpl","CreaXmlDesdeTagRow",cuboQuery,"r","k_mov");				frn.lib("libGeneral.kpl","FileSave",xmlGrd, fileSavePath & "\mostrardatosgrid_parsed");				frn.setX(xmlGrd);								//frn.setPos("k_mov","ren:0");				frn.setPos("k_mov","ren:" & (frn.N("k_mov") - 1));										   } /* END Func MostrarDatosGrd() */		   		   /*			fun CalculaTotales(iModo) {				var monto = 0, monto_acum = 0;				var cantValida = 1;				//Calcular totales				for (var i=0; i<frn.N("k_mov"); i++) {					if ( strlen(frn.get("k_mov",i,"prod")) != 0 ) {						monto = frn.get("k_mov",i,"cant") * frn.get("k_mov",i,"pu");						//monto_acum = monto_acum + monto;						frn.setX(monto, "k_mov", i, "monto");					}				}								//frn.set("k_subtotal",subTotal);				//frn.set("k_iva",iva);								//frn.set("k_monto",monto_acum);								return cantValida;			}			*/					   									} // End of class Main			</script></pag>