<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Relaci&#243;n  de citas Kepler-CRM BP"><grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0"><tab n="2"/>    <inp id="inp_titulo" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/><br/>    <hLine clr="0,0,0"/><br/><br/>    <tab  n="2"/>    <grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="99,11,7,12" tit="Datos Generales"  fnt="Arial,16"><sp n="2"/>        <tab n="1"/><txt clr="0,58,112" hk="S">Sucursal:</txt>        <cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="82,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><sp/>        <br/><tab/>    </grp><sp/>    <grp bclr="236,240,243" id="buscadores" fntClrBrdr="236,240,243"  fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="35,11,7,12" tit=" " fnt="Arial,16" visible="Y">        <tab/><txt>Fecha Inicial:</txt><tab/>        <edt id="k_fechaini" dim="15,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213"            type="date" modify="Y" available="Y" fnt="Arial,16" OnF9="Dialog(3,_ks_fecha,k_fechaini)" page="_ks_fecha,k_fechaini" fmt="DD/MM/CCYY" nc="-1"/><tab/><br/>        <tab/><txt>Fecha Final:</txt><tab/>        <edt id="k_fechafin" dim="15,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213"            type="date" modify="Y" available="Y" fnt="Arial,16" OnF9="Dialog(3,_ks_fecha,k_fechafin)" page="_ks_fecha,k_fechafin" fmt="DD/MM/CCYY" nc="-1"/><sp/>        <br/><br/><br/>        <tab n="8"/>        <img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="buscar_datos()" available="Y" clrBrdr="0,0,0" visible="Y" tooltip="Buscar Citas"/>    </grp>    <br/><br/><tab n="2"/>    <grp id="grpDetalle" bclr="236,240,243" fntClrBrdr="236,240,243"  fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5" dim="135,60,7,10" tit="Detalles"  fnt="Arial,16" available="Y" modify="Y">        <br/><br/>        <tab n="2"/>		<sp n="2"/>		<tbl id="k_tabla" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="115,33"  hk="z" OnChange="" Reorder="N" modify="Y" available="Y">            <col id="fecha_cita" name="Fecha de Cita" visible="Y" nc="-1" modify="N" type="date" fmt="DD/MM/CCYY"/>            <col id="id_cita" name="ID CRM BP" type="string" visible="Y" modify="N" OnEnter="buscar_error_id_cita()"/>            <col id="folio_cita"  visible="Y" modify="N"   name="Folio Cita Kepler" type="folio" OnEnter="buscar_error_id_kepler()"/>            <col id="vin" modify="N" type="string" name="VIN" visible="Y"/>            <col id="cliente" name="Cliente"  modify="N" visible="Y" type="string"/><col id="estatus" name="Status" type="string" modify="N" visible="Y"/>        </tbl>            </grp>    </grp>    <script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco, externo ;			var cmdQuery, cuboQuery, ok, mensajeError, fileSavePath, continua, xmlRequest,cuboResultados,cmd;			var tipoOper; //Variables relacionadas con parametros			var consCfdi;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				usuario = frn.config("user","name");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				rol_usuario = frn.config("user","role");				asterisco = "*";                Inicializa();						}                    fun Inicializa(){                    kdb.kde("KDE");	                    kdb.exec();                                    var cubo, valor;                                            //Llenar combo sucursales                    cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";                    if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){                        cmd = cmd & " where c1='" & suc_usuario & "'";                    }else {                        if (suc_usuario &! asterisco && suc_usuario &! "" ){                            cmd = cmd & " where c1='" & suc_usuario & "'";                        }                    }                                        cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ser_citas_kepler_crmbp.Inicializa()");		                    ok=getXmlAtt(cubo,"ok");                    if(ok &! "" && !ok){                        mensajeError = getXmlAtt(cubo,"native3");                        mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);                        frn.message(mensajeError,"Error","Aceptar");                        return;                    }                    frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\sucursal");                                            frn.set("k_sucn",getXml(cubo));                    frn.set("k_sucn",descr_combo("k_sucn",1,suc_usuario));	                    						frn.set("k_fechaini",fnDate("add",sys.date(),-10));						frn.set("k_fechafin",sys.date());            }            fun descr_combo(combo,posicion,valor){                var descr, valor_actual;                var len_combo = frn.N(combo);                for (var cont=0; cont<len_combo ; cont++){                    valor_actual= frn.get(combo,cont,posicion);                    if (valor_actual &=  valor){                        descr = frn.get(combo,cont,0);                        return descr;                    }                }            }            fun buscar_datos(){                var xmlData, cmd, cubo, sucursal, fecini, fecfin;                                sucursal = frn.get("k_sucn", -1, 1);                fecini   = frn.get("k_fechaini");                fecfin   = frn.get("k_fechafin");                if (fecini &= "" || fecfin &= "") {                    frn.message("Debe seleccionar un rango de fechas.", "Aviso", "Aceptar");                    return;                }                xmlData = "<document>" &                        "<sucursal_id>" & sucursal & "</sucursal_id>" &                        "<fecha_ini>" & fecini & "</fecha_ini>" &                        "<fecha_fin>" & fecfin & "</fecha_fin>" &                        "</document>";                cmd = "select * from keplersc.ifz_rep_citas_relacion('" & xmlData & "')";                                cubo = frn.lib("libGeneral.kpl", "EjecutarSqlSel", cmd, "ser_citas_kepler_crmbp.buscar_datos()");                ok = getXmlAtt(cubo, "ok");                if (ok &! "" && !ok){                    mensajeError = getXmlAtt(cubo, "native3");                    mensajeError = frn.lib("libGeneral.kpl", "ErrorBD", mensajeError);                    frn.message(mensajeError, "Error", "Aceptar");                    return;                }                frn.lib("libGeneral.kpl", "FileSave", cubo, "C:\\Basura\\citas_relacion.xml");                frn.setX(getXml(cubo), "k_tabla");            }            fun buscar_error_id_cita(){                var id_cita, cmd, cubo, mensajesError;                var folio_cita_woID; // Added 261013 by JM2                id_cita = frn.get("k_tabla", -1, "id_cita");					 // Condition Adapted 261013 by JM2                if (id_cita &= "") {                    // frn.message("No se ha seleccionado un ID de cita.", "Aviso", "Aceptar");                    // return;                    folio_cita_woID = frn.get("k_tabla", -1, "folio_cita");                    cmd = "select * from keplersc.ifz_bp_logs_err_ty where mensaje like '%" & folio_cita_woID & "%'";                } else {						// UPD Code : 261013 						cmd = "select * from keplersc.ifz_bp_logs_err_ty where mensaje like '%" & id_cita & "%'";                }						 // Original 261013 commented by JM2                // cmd = "select * from keplersc.ifz_bp_logs_err_ty where mensaje like '[ERROR][CIT.ID:" & id_cita & "]%'";                cubo = frn.lib("libGeneral.kpl", "EjecutarSqlSel", cmd, "ser_citas_kepler_crmbp.buscar_error_id_cita()");                ok = getXmlAtt(cubo, "ok");                if (ok &! "" && !ok){                    mensajeError = getXmlAtt(cubo, "native3");                    mensajeError = frn.lib("libGeneral.kpl", "ErrorBD", mensajeError);                    frn.message(mensajeError, "Error", "Aceptar");                    return;                }                mensajesError = getXmlAtt(cubo,"r0","mensaje");                                frn.lib("libGeneral.kpl", "FileSave", mensajesError, "C:\\Basura\\citas_errores.xml");                if (mensajesError &= "") {                       frn.message("No se encontraron errores para el ID de cita seleccionado.", "Aviso", "Aceptar");                    return;                }                frn.message(mensajesError, "Errores encontrados", "Aceptar");			}            fun buscar_error_id_kepler(){                var id_kepler, cmd, cubo, mensajesError,sucursal;                sucursal = frn.get("k_sucn", -1, 1);                id_kepler = frn.get("k_tabla", -1, "folio_cita");                if (id_kepler &= "") {                    frn.message("No se ha seleccionado un ID de kepler.", "Aviso", "Aceptar");                    return;                }                cmd = "select * from keplersc.ifz_bp_logs_err_ty where mensaje like '[ERROR][IFZ BP][CIT:" & sucursal &"-" & id_kepler & "]%'";                cubo = frn.lib("libGeneral.kpl", "EjecutarSqlSel", cmd, "ser_citas_kepler_crmbp.buscar_error_id_kepler()");                ok = getXmlAtt(cubo, "ok");                if (ok &! "" && !ok){                    mensajeError = getXmlAtt(cubo, "native3");                    mensajeError = frn.lib("libGeneral.kpl", "ErrorBD", mensajeError);                    frn.message(mensajeError, "Error", "Aceptar");                    return;                }                mensajesError = getXmlAtt(cubo,"r0","mensaje");                                frn.lib("libGeneral.kpl", "FileSave", cmd, "C:\\Basura\\citas_errores.xml");                if (mensajesError &= "") {                       frn.message("No se encontraron errores para el ID de cita seleccionado.", "Aviso", "Aceptar");                    return;                }                frn.message(mensajesError, "Errores encontrados", "Aceptar");			}                                    }    </script></pag>