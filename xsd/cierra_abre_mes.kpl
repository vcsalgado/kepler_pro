			<inp id="k_oct" dim="3,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213"
				type="capital" tooltip="Doble click para cambiar" modify="N" OnMouseD="cierra_abre"/>		
	
			<br/>
			<tab/>
