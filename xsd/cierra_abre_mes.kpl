			<tab/>
			<inp id="k_nov" dim="3,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213"
				type="capital" tooltip="Doble click para cambiar" modify="N" OnMouseD="cierra_abre"/>	
			<tab n="2"/>
			<txt clr="0,58,112" hk="S">Diciembre</txt>

			<inp id="k_dic" dim="3,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213"
				type="capital" tooltip="Doble click para cambiar" modify="N" OnMouseD="cierra_abre"/>		

			<br/>
