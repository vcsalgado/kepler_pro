<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Cierra-Abre  Mes">
<grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0">
	<br/>
		<tab/><inp id="k_titulo" dim="50,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"
			type="string" modify="N" available="N" fnt="Arial,22"/>
	<br/><tab/><hLine clr="0,0,0"/>
		<br/><br/>
		<tab/>
		<grp dim="32,27,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Cierra-Abre Mes">		
			<sp/><tab n="1"/>
			<txt clr="0,58,112" hk="S">A&#241;o</txt>
			<cmb id="k_anio" clr="64,64,64" clrBrdr="192,205,213" dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 
			available="Y" OnChange="ResetResults"/>
			<tab n="6"/>

			<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>
			<br/>
			
			<br/>
			<tab/>
			<txt clr="0,58,112" hk="S">Enero</txt>
			<tab n="2"/>
