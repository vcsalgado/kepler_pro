			<tab/><sp/><txt>Colonia: </txt>
			<inp id="cliente_colonia" dim="30,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255"  modify="N" type="string" brdr="0,2"/>
			<sp/><txt>Poblaci&#243;n: </txt>
			<inp id="cliente_poblacion" dim="29,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="string"  brdr="0,2"/>
			<sp/><txt>Municipio: </txt>
			<inp id="cliente_municipio" dim="29,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/>
			<br/>
			<tab/><sp/><txt>Estado: </txt>
			<inp id="cliente_estado" dim="20,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/>
			<sp/><txt>Pais: </txt>
			<inp id="cliente_pais" dim="17,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="string" brdr="0,2"/>
			<sp n="1"/><txt>C.P.: </txt>
			<inp id="cliente_cp" dim="7,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/>
			<sp/><txt>Correo electronico: </txt>
			<inp id="cliente_correo" dim="40,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="string" brdr="0,2"/>
			<br/>
			<tab/><sp/><txt>RFC: </txt>
			<inp id="cliente_rfc" dim="22,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/><txt> Tel. casa: </txt>
			<inp id="cliente_tcasa" dim="17,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/>
			<sp/><txt>Tel. movil: </txt>
			<inp id="cliente_tmovil" dim="17,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" brdr="0,2"/>
			<sp n="2"/><txt>Tel. oficina: </txt>
			<inp id="cliente_toficina" dim="17,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/>
			<sp/><txt>Extension: </txt>
			<inp id="cliente_extension" dim="8,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/>
			<br/><br/>
			<tab/><txt fnt=",0bs">Preferencias del Cliente:</txt><br/>
			<tab/><sp/><txt>Medio preferido de contacto: </txt>
			<inp id="medio_preferido" dim="15,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnF9="ObtenerMedPref()" OnChange="BuscarMedPref()" type="capital" nc="5" tooltip="Clave Medio Preferido de Contacto"  brdr="0,2"/>
			<sp/>
			<inp id="desc_medio_preferido" dim="15,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="capital"  brdr="0,2"/>
			<tab n="2"/><txt>Num. preferido: </txt>
			<inp id="num_preferido" dim="25,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" type="string"  brdr="0,2"/>
			<br/>
			<tab/><sp/><txt>Tipo snack:  </txt>
			<edt id="tipo_snack" dim="12,1" brdr="0,2" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" tooltip="Tipo de snack preferido"/><sp/>
			<inp id="desc_snack" dim="40,1" brdr="0,2" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="40" tooltip="Descripcion de snack preferido"/>
			<tab/><txt>Tipo bebida: </txt>
			<edt id="tipo_bebida" dim="12,1" brdr="0,2" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" tooltip="Tipo de bebida preferida"/><sp/>
			<inp id="desc_bebida" dim="40,1" brdr="0,2" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="40" tooltip="Descripcion de bebida preferida"/><br/>
			<br/>
			<tab/><txt fnt=",bs">Datos del Vehiculo:</txt><br/>
			<tab/><sp/><txt>Serie:</txt>
			<inp id="serie" dim="20,1" OnChange="" tooltip="No. de serie" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string"  brdr="0,2" modify="N"/>
			<sp/><txt>Marca:</txt>
			<inp id="marca" dim="15,1" tooltip="Seleccionar F9"   modify="N" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>
			<sp/><txt>Modelo:</txt>
			<inp id="modelo" dim="74,1" tooltip="Seleccionar F9"   modify="N" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string"  brdr="0,2"/>
			<br/>
			<sp n="2"/><tab/><txt> A&#241;o:</txt>
			<inp id="anio" dim="8,1" nc="4" bclr="192,205,213" modify="N" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>
			<sp/><txt>Color:</txt>
			<inp id="color" dim="25,1" bclr="192,205,213" modify="N" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>
			<sp n="2"/><txt>Codigo:</txt>
			<inp id="codigo" dim="12,1" bclr="192,205,213" modify="N"  clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>
			
			<tab/><sp/><txt>Kms:</txt>
			<inp id="kms" dim="9,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><tab/><txt>Placas:</txt>
			<inp id="placas" dim="9,1" bclr="192,205,213" modify="N" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><tab/><txt>Concesionario: </txt>
			<inp id="concesionario" dim="15,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="string"  brdr="0,2"/>
			<br/><br/>
			<tab/><sp/><txt>Observaciones:</txt>
			<inp id="observaciones" clr="64,64,64" clrBrdr="255,255,255"  dim="116,1" bclr="255,255,255" brdr="0,2" fnt="Arial,16" nr="3,60" modify="Y" type="capital" available="Y"/><tab n="2"/>
			<br/><br/>
			<tab n="5"/><bot id="cancelar_cita" dim="20,0" brdr="5" OnEnter="Alta(cancelar)"  text="Cancelar Cita" default="0" visible="Y"/><tab n="22"/>
			<bot id="Aceptar" dim="20,0" brdr="5"  OnEnter="Alta()"  text="Guardar Cita" default="0" visible="Y"/>
		</grp>
		<br/>
		<tab n="4"/>
</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,kdb, sys, rep, frP;
			var tip_ope,suc_usuario,modulo_origen,folio_cit, perfil_usuario,asterisco,cli,vn,inv,rol_usuario;
			var hora_limite_semana,hora_limite_sabado,hora_limite_domingo ,usuario,folio_tmkt;
			var folio,kodawari,resVal;
			var xmlRequest ,cmd, cubo,ok ,mensajeError;
			
			fun Main() {
				frn=new FRNT;
				kdb=new KDB;
				kdb.connect();
				sys=new SYS;
				rep=new REP;
				frP=new FRNTP;
			   usuario = frn.config("user","name");
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				rol_usuario = frn.config("user","role");
				asterisco = "*";
			
				//PARAMETROS
				tip_ope=trim(frn.param(0));
				folio_tmkt=trim(frn.param(1));
				
				if( trim(frn.param(2)) &! "" ){	
					suc_usuario=trim(frn.param(2));
				}
				
				modulo_origen=trim(frn.param(3));
				folio_cit=trim(frn.param(4));
				
				ctrls_off();
				Inicializa();
				
			}
		
			fun ctrls_off() {
			
				frn.setAtt("cancelar_cita", "visible", "N" );
				frn.setAtt("Aceptar", "visible", "N" );
				frn.setAtt("Cita_txt", "visible", "N" );
				frn.setAtt("Cve_TMKT", "available", "N" );
				frn.setAtt("buscadores", "visible", "N" );
				frn.setAtt("folio_cita", "visible", "N" );
				frn.setAtt("buscar_datos", "visible", "N" );
				frn.setAtt("fecha_confirmacion", "modify", "N" );
				frn.setAtt("hora_confirmacion", "modify", "N" );
				frn.setAtt("txt_confirmo", "visible", "N" );
				frn.setAtt("fecha_conf", "visible", "N" );
				frn.setAtt("fecha_confirmacion", "visible", "N" );
				frn.setAtt("hora_conf", "visible", "N" );
				frn.setAtt("hora_confirmacion", "visible", "N" );
				frn.setAtt("confirmo", "visible", "N" );
				frn.setAtt("persona_confirmo", "visible", "N" );	
				frn.setAtt("vin_txt", "visible", "N" );
				frn.setAtt("vin", "visible", "N" );
				frn.setAtt("clave_cliente_txt", "visible", "N" );
				frn.setAtt("clave_cliente", "visible", "N" );
				
				frn.setAtt("txt_folio_cita", "visible", "N" );
				frn.setAtt("fol_cita", "visible", "N" );
								
				frn.setAtt("cliente_id", "modify", "N" );
				frn.setAtt("serie", "modify", "N" );
		
				if (tip_ope == 0){
					botones_alta();
				}else{
					botones_modificar();
				}
			
			}
			
					
			fun botones_alta(){
				frn.setAtt("Aceptar", "visible", "Y" );
				frn.setAtt("Cancelar", "visible", "Y" );
				frn.set("tit_text", "Alta Cita Evento de Bienvenida");
			}
			
			fun botones_modificar(){
			
				frn.setAtt("Aceptar", "visible", "Y" );
				frn.setAtt("cancelar_cita", "visible", "Y" );
				frn.setAtt("Cita_txt", "visible", "Y" );
				frn.setAtt("buscadores", "visible", "Y" );
				frn.setAtt("folio_cita", "visible", "Y" );
				frn.setAtt("fecha_conf", "visible", "Y" );
				frn.setAtt("fecha_confirmacion", "visible", "Y" );
				frn.setAtt("hora_conf", "visible", "Y" );
				frn.setAtt("hora_confirmacion", "visible", "Y" );
				frn.setAtt("confirmo", "visible", "Y" );
				frn.setAtt("persona_confirmo", "visible", "Y" );
				frn.setAtt("txt_confirmo", "visible", "Y" );
				frn.setAtt("Cve_TMKT", "available", "Y" );
				frn.setAtt("txt_folio_cita", "visible", "Y" );
				frn.setAtt("fol_cita", "visible", "Y" );
				
				if (modulo_origen &! "T"){
					frn.setAtt("buscar_datos", "visible", "Y" );
				}	
				frn.setAtt("vin_txt", "visible", "Y" );
				frn.setAtt("vin", "visible", "Y" );
				
				frn.setAtt("clave_cliente_txt", "visible", "Y" );
				frn.setAtt("clave_cliente", "visible", "Y" );
				
				//frn.setAtt("cliente_id", "modify", "Y" );
				//frn.setAtt("serie", "modify", "Y" );
				frn.set("tit_text", "Modificacion Cita Evento de Bienvenida");
			}
			
			fun bloquear_modificacion{
				frn.setAtt("Aceptar", "visible", "N" );
				frn.setAtt("cancelar_cita", "visible", "N" );
			}
		
			fun Inicializa(){
				kdb.kde("KDE");//		
				kdb.exec();
			
				//Llenar combo sucursales
				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";
				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){
					cmd = cmd & " where c1='" & suc_usuario & "'";
				}else {
					if (suc_usuario &! asterisco && suc_usuario &! "" ){
						cmd = cmd & " where c1='" & suc_usuario & "'";
					}
				}
				
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitabienvcrud.Inicializa()");
					
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
					
				frn.set("k_sucN",getXml(cubo));
				frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));
		
				//obtener cli,vin e inventario con folio_tmkt
				if ( folio_tmkt &! ""){
					cmd = "select tmk.c14 as vin ,tmk.c20 as clave_cliente, bv.c15 as inventario from keplersc.kdtmktser2 tmk " &
					 "inner join keplersc.kdctasbienvser bv on bv.c1=tmk.c1 and bv.c6=tmk.c14 " &
					 "where tmk.c1='" & frn.get("k_sucN" , -1, 1) & "' and tmk.c2='" & folio_tmkt & "'";			
					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitabienvcrud.inicializa()");
					//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubocita_encontrada");
					
					ok=getXmlAtt(cubo,"ok");
					if(ok &! "" && !ok){
						mensajeError = getXmlAtt(cubo,"native3");
						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
						frn.message(mensajeError,"Error","Aceptar");
						return;
					}
					vn = getXmlAtt(cubo , "r0", "vin");
					cli = getXmlAtt(cubo , "r0", "clave_cliente");
					inv = getXmlAtt(cubo , "r0", "inventario");
					frn.set("inventario",inv);
				}
			
				//Llenar combo cve_tmkt
				cmd = "select '['||c1||'] '||c2 as descripcion, c1 as clave from keplersc.kdsercattmkt";
				
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitabienvcrud.Inicializa()");
				
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
			
			   var cmd_tmkt = "Cve_TMKT";
			   
			   frn.setX("", cmd_tmkt , 0 ,0);
				llenar_cmb(cubo ,cmd_tmkt );
	
				frn.set("Cve_TMKT",descr_combo("Cve_TMKT",1,usuario ));	
				
				frn.set("fecha_captura",sys.date());
				frn.set("hora_captura_cita",sys.time());
							
				//Llenar tipo cita
				frn.set("tipo_cita" ,"Evento Bienvenida");

				//Llena combo atendio
				LlenaComboAtendio();
				SetAtendio();

				//Llenar Tipo snack y tipo bebida
				cmd = "select C2 as descripcion, c1 as clave from keplersc.kdsertiposnack";
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitabienvcrud.Inicializa()");
				
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
						   
				frn.setX("","tipo_snack",0,0);
				llenar_cmb(cubo ,"tipo_snack");

				//Llenar Tipo bebida
				cmd = "select C2 as descripcion, c1 as clave from keplersc.kdsertipobebida";
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitabienvcrud.Inicializa()");
				
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
						   
				frn.setX("","tipo_bebida",0,0);
				llenar_cmb(cubo ,"tipo_bebida");

				if (tip_ope == 0 ){								//Alta
					frn.set("fecha_cita",fnDate("add", sys.date(), "1"));
					frn.set("hora_cita","09:00");	
					bus_cli_vin("alta");
				}
				
				if (tip_ope == 1 && modulo_origen &= "T"){		//Modificar
					frn.set("folio_cita", folio_cit);
					buscar_datos();
				}
				
				//obtener kodawari
				cmd = "select c9 from keplersc.kdconftaller where c2='" & frn.get("k_sucN" , -1, 1) & "'";
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitabienvcrud.Inicializa()");
				//frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_kodawari  ");
			
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				kodawari = getXmlAtt(cubo,"r0" ,"c9");
				
			}

			fun LlenaComboAtendio(){
				frn.setX("Cliente","cmb_asistira",0,0);
				frn.setX("0","cmb_asistira",0,1);
				frn.setX("Otro","cmb_asistira",1,0);
				frn.setX("1","cmb_asistira",1,1);
			}

			fun SetAtendio(){
				var atendio, nombre;
				atendio = frn.get("cmb_asistira",-1,0);
				nombre=frn.get("cliente_nombre");
				frn.set("persona_evento",nombre);
				if(atendio &= "Cliente"){
					frn.setAtt("persona_evento","modify","N");
				}
				else{
					frn.setAtt("persona_evento","modify","Y");
				}
				if (frn.get("persona_evento") &="") {
					frn.setAtt("persona_evento","modify","Y");
				}
			}

			fun ObtenerMedPref(){ 
				cmd = "select c1 as clave, c2 as descripcion from keplersc.kdsercontpref";
				frn.dialog("genlistafiltrosel","Medio Preferido de Contacto",cmd,"clave","medio_preferido","0","0","N","S");
			}

			fun BuscarMedPref(){
				var medio_pref_id;
				medio_pref_id=frn.get("medio_preferido");
				cmd = "select c2 as descripcion from keplersc.kdsercontpref " &
						"where c1='" & medio_pref_id & "'";
				//frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\querymedpref");						
				rstXml(cubo);
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitabienvcrud.BuscarMedPref()");
				//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubomedpref");
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;	
				}
				if((nXml(cubo) == 0) && (medio_pref_id &! "")) {
					frn.setPos("medio_preferido");
					frn.set("medio_preferido","");
					frn.message("El medio preferido de contacto no existe","Error","Aceptar");
					resVal = 0;
					return;
                 } else{
				    frn.set("desc_medio_preferido",getXmlAtt(cubo,"r0","descripcion"));	    
				}		
			}

			fun ObtieneInventario(){
				cmd = "select ctEB.c15 as inventario " &
						"from keplersc.kdctasbienvser ctEB " &
						"where ctEB.c1='" & frn.get("k_sucN", -1, 1) & "' and ctEB.c2 ='" & frn.get("folio_cita") & "'";
				//frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\queryinv");						
				rstXml(cubo);
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitabienvcrud.ObtieneInventario()");
				//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboinv");
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;	
				}
				if((nXml(cubo) == 0)) {
					frn.setPos("folio_cita");
					frn.set("folio_cita","");
					frn.message("No existe el No. de cita","Error","Aceptar");
					resVal = 0;
					return;
                 } else{
				    frn.set("inventario",getXmlAtt(cubo,"r0","inventario"));	    
				}

			}

			fun buscar_datos(){
				var strTmp,cubo_cli_vin,cubo_cli,cubo_cita,xmlRes ,tot;
				ObtieneInventario();
				rstXml(xmlRequest);
				setXml(xmlRequest,"document","folio_cita", frn.get("folio_cita"));
				setXml(xmlRequest,"document","tipo_cita", frn.get("tipo_cita_bus"));
				setXml(xmlRequest,"document","vin",frn.get("vin"));
				setXml(xmlRequest,"document","clave_cliente",frn.get("clave_cliente"));
				setXml(xmlRequest,"document","inventario",frn.get("inventario"));
				setXml(xmlRequest,"document","sucursal_id",frn.get("k_sucN", -1, 1));
				
				borrar_datos();
				
				//frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");
						
				cmd="select * from keplersc.datos_citabienv_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";
				rstXml(cubo);
				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitabienvcrud.buscar_datos()");
				
				//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");
				
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}

				strTmp = getXmlAtt(cubo,"r0","datos_cita");
				strTmp = delScpScn(strTmp);
				setXmlStr(cubo_cita   ,strTmp);				
				//frn.lib("libGeneral.kpl","FileSave",cubo_cita,"C:\Basura\cubo_cita");
		
				xmlRes= getXmlX(cubo_cita,3,0);
				//frn.lib("libGeneral.kpl","FileSave",xmlRes,"C:\Basura\xmlRes");
				frn.setX(xmlRes);
									
				var tmkt_clave  = getXml(xmlRes, "cve_tmkt");
				frn.set("Cve_TMKT",descr_combo("Cve_TMKT",1,tmkt_clave));	
				//var tipo_cita = getXml(xmlRes, "tipo_cita");
				//frn.set("tipo_cita",descr_combo("tipo_cita",1,tipo_cita ));	
				//var vendedor = getXml(xmlRes, "vendedor");
				//frn.set("vendedor",descr_combo("vendedor",1,vendedor ));	
					
				var estatus_cita = getXml(xmlRes, "estatus_cita");
				
				if (estatus_cita == 30){
					frn.message("La cita fue reprogramada, imposible modificar","Error","Aceptar");
					bloquear_modificacion();
				}else if (estatus_cita == 40){
					frn.message("La cita fue cancelada, imposible modificar","Error","Aceptar");
					bloquear_modificacion();
				}else{
					botones_modificar();
				}

			}
			
			fun bus_cli_vin(origen){ 
			
				var strTmp,cubo_cli_vin,xmlRes ;
				var suc = frn.get("k_sucN", -1, 1);
			
				if (origen &! "alta"){
					vn = frn.get("serie");
					cli = frn.get("cliente_id");
					inv = frn.get("inventario");
				}
				
				borrar_datos_cli();
				borrar_datos_vin();
				
				if (cli &! "" || vn &! ""){
					if(origen &= "alta"){
						if (cli &! ""){
							setXml(xmlRequest,"document","clave_cliente",cli);
						}
						if (vn &! ""){
							setXml(xmlRequest,"document","vin",vn );
						}
					}
				 
					setXml(xmlRequest,"document","sucursal_id",suc);
					setXml(xmlRequest,"document","inventario",frn.get("inventario"));

					//frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");
				
					cmd="select * from keplersc.cli_vin_bienvsel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";
					rstXml(cubo);
					cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.bus_cli_vin()");
				
					//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");
				
					ok=getXmlAtt(cubo,"ok");
					if(ok &! "" && !ok){
						mensajeError = getXmlAtt(cubo,"native3");
						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
						frn.message(mensajeError,"Error","Aceptar");
						return;
					}
				
					strTmp = getXmlAtt(cubo,"r0","datos");
					strTmp = delScpScn(strTmp);
					setXmlStr(cubo_cli_vin,strTmp);				
					//frn.lib("libGeneral.kpl","FileSave",cubo_cli_vin,"C:\Basura\cubo_cli_vin ");
		
					xmlRes= getXmlX(cubo_cli_vin,3,0);
					frn.setX(xmlRes);	
					rstXml(strTmp);
					rstXml(xmlRes);
					
				}
			}
			
			
			fun validaciones_pre_ejecucion(){
			}
			
			fun Alta(param){
			
				var respuesta;
				if (param &= "cancelar"){
					tip_ope = 2;
					
					respuesta = frn.message("¿ Seguro quieres cancelar cita ?","Atencion",2);
					if (respuesta == 0){
						return;
					}
				}else{
					respuesta = frn.message("¿ Seguro quieres guardar la cita ?","Atencion",2);
					if (respuesta == 0){
						return;
					}
				}
				
				
				if (validaciones_pre_ejecucion() &= 1){
					return ;
				}
				rstXml(xmlRequest);
				xmlRequest = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
			
				setXml(xmlRequest ,"tipo_operacion",tip_ope);
				setXml(xmlRequest,"folio_tmkt",folio_tmkt);
				setXml(xmlRequest ,"usuario",usuario);
		
				frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequestCitaB");
				
				cmd="SELECT * FROM keplersc.cita_bienv_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";
				//kdb.rst(cubo);
				rstXml(cubo);
				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"srvcitabienvcrud.Alta");						
				//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");	
		
				var resultado=getXml(cubo ,"resultado");
				
				if(resultado &= "0"){
					mensajeError = getXml(cubo ,"mensaje");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				if(resultado &= "1"){
					var mensaje = getXml(cubo ,"mensaje");
					frn.message(mensaje ,"Atencion","Aceptar");
				}
				
				if (tip_ope == 2){
					bloquear_modificacion();
					return;
				}
				
				if (tip_ope == 0){
					var fol = getXml(cubo ,"adicionales");
					frn.set("tipo_cita_bus",frn.get("tipo_cita"));
					frn.set("folio_cita",fol);
					
					tip_ope = 1;
					
					buscar_datos();
					ctrls_off();
				}
				frP.script("Regresar()");		//de la pantalla que la llamo sertmktview
	
			}

				
