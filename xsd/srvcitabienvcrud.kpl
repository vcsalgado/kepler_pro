		<tab n="10"/>
		
	</grp><br/><br/>
	
		<tab/>
		<grp id="grpDetalle" dim="95,38,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5"  tit="Detalles"  fnt="Arial,16" available="Y" modify="Y">
			<tab/><txt fnt=",bs">Datos de la Cita:</txt><tab n="15"/><br/>
			<tab/><sp/><txt>Fecha:</txt>
			<edt id="fecha_cita" dim="12,1"  fmt="DD/MM/CCYY"  page="_ks_fecha,fecha_cita" OnF9="Dialog(3,_ks_fecha,fecha_cita)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2" tooltip="Fecha de la cita"/>
			<sp/><txt>Hora:</txt>
			<inp id="hora_cita" dim="6,1" bclr="255,255,255" nc="-1" clr="64,64,64" OnChange="posible_entrega()" clrBrdr="255,255,255" type="time" brdr="0,2" tooltip="Hora de la cita"/><txt>(00:00)</txt>
			<tab n="2"/><txt id="fecha_conf" visible="Y">Fecha de confirmacion:</txt>
			<edt id="fecha_confirmacion" dim="12,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_original" OnF9="Dialog(3,_ks_fecha,fecha_original)"  bclr="192,205,213" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2" modify="N" visible="Y"/>
			<sp/><txt id="hora_conf" visible="Y">Hora:</txt>
			<sp/><inp id="hora_confirmacion" dim="6,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2" modify="N" visible="Y"/>
			<sp/><txt id="confirmo" visible="Y">Confirmo:</txt>
			<inp id="persona_confirmo" dim="35,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2" modify="N" visible="Y"/>
			<br/>
			<tab/><sp/><txt>Persona asistira al evento:</txt>
			<sp/><cmb id="cmb_asistira" dim="15,1" brdr="0,2" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" modify="Y" OnChange="SetAtendio()"/>
			<sp/><inp id="persona_evento" dim="65,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="50" brdr="0,2" modify="Y" visible="Y"/><tab/><txt>Asistio al evento:</txt>
			<inp id="asistio_evento" dim="3,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="1" brdr="0,2" modify="N" visible="Y"/><br/>
			<br/>
			<tab/><txt fnt=",bs">Datos del Cliente:</txt><br/>
