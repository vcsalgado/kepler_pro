<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Orden Cerrada">	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	 		<grp dim="31,24,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Orden Cerrada">				<br/><tab/><txt>Sucursal:</txt><sp n="2"/> <tab n="2"/><cmb id="cmb_sucursal" dim="43,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y"/>			      <br/>  <br/>			      			      <tab/><txt>Orden:</txt><sp n="2"/><tab n="3"/><cmb id="tipo_orden" dim="26,36" brdr="2,1" OnChange="borrar_datos()" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y"/>			      			   														<sp/>			      <inp id="fol_orden" dim="11,1"  bclr="255,255,255" tooltip=" F9 buscar orden "  OnF9="ObtenerOrden()" OnChange="Formar_folio()" clr="64,64,64" nc="10" clrBrdr="255,255,255"  type="string" brdr="0,2"/>			      <tab/>			      			      <img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="buscar_orden()" available="Y" clrBrdr="0,0,0" visible="Y"/>			       			      <br/> 			      <tab/><txt>Nombre:</txt> <tab n="3"/><inp id="nombre" dim="42,1" bclr="255,255,255" OnF9="" OnChange="" clr="64,64,64"  clrBrdr="255,255,255"  type="string" brdr="0,2"/>			        			      <br/> <br/>			      			        					<tab/><txt>Marca:</txt>	<tab n="3"/><inp id="marca_clave" dim="11,1" bclr="255,255,255" modify="N" clr="64,64,64" clrBrdr="255,255,255"  type="string" brdr="0,2"/>			      			      <tab/>			      <inp id="marca_desc" dim="30,1" bclr="255,255,255" modify="N" clr="64,64,64" clrBrdr="255,255,255"  type="string" brdr="0,2"/>			      			      <br/>  			      <tab/><txt>Modelo:</txt>	<tab n="3"/><inp id="modelo_clave" dim="11,1" bclr="255,255,255" modify="N" clr="64,64,64" clrBrdr="255,255,255"  type="string" brdr="0,2"/>			      					<tab/>					<inp id="modelo_desc" dim="30,1" bclr="255,255,255" modify="N" clr="64,64,64" clrBrdr="255,255,255"  type="string" brdr="0,2"/>			      			      <br/>			      <tab/><txt>Anio:</txt>	<tab n="4"/><inp id="anio" dim="11,1" bclr="255,255,255" modify="N" clr="64,64,64" nc="6" clrBrdr="255,255,255"  type="string" brdr="0,2"/>			      <br/>			        			        			      <tab/><txt>Concesionario:</txt>	<tab/>			      <inp id="concesionario_clave" dim="6,1" bclr="255,255,255" modify="N" clr="64,64,64" clrBrdr="255,255,255"  type="string" brdr="0,2"/>			      			      <sp/>			      <inp id="concesionario_desc" dim="35,1" bclr="255,255,255" modify="N" clr="64,64,64"  clrBrdr="255,255,255"  type="string" brdr="0,2"/>					 <br/>	 <br/> 			       			      <tab n="8"/><bot id="bot_ejecutar" dim="15,0" brdr="5" text="Ejecutar" OnEnter="GenerarReporte()" default="0"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys,suc_usuario ,perfil_usuario,asterisco  ,rol_usuario ;			var clave_cli, nombre,correo, clave_marca ,fecha_recep, hora_recep,tel_1 ,tel_2, rfc ,kilometraje, kms_salida, placas;			var desc_marca ,clave_modelo,desc_modelo,anio,clave_conce,desc_conce;			var direccion , colonia, poblacion , flujo_admon   ; 			var bonete , recep , siniestro, comentarios;			var identificador , serie , motor ,transmision , eje_trasero,  fecha_venta, color;			var total_mano_obra,total_refs, total_tots, total_cargos_varios, subtotal_orden, iva_orden, total_orden;			var genero_fact, nat_fact ,gpo_fact, tipo_fact, folio_fact;							fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;								kdb.connect();				kdb.open("s,kdms,i,kdini,c,kdud");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";				Inicializa();							}						fun Inicializa(){//Inicializa los valores en Pantalla				IniCombos();				IniParams();//Inicializa parámtros de impresión entre otros				frn.set("ch_incluir","1");			}							fun borrar_datos(){							frn.rst("nombre");				frn.rst("marca_clave");				frn.rst("marca_desc");				frn.rst("modelo_clave");				frn.rst("modelo_desc");				frn.rst("anio");				frn.rst("concesionario_clave");				frn.rst("concesionario_desc");							}								fun IniCombos(){				var cmd, cuboQuery, xmlResQuery, ok, mensajeError, strTmp,cubo;				cuboQuery="datDoc";														//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("cmb_sucursal",getXml(cubo));																				//Llenar combo tipo orden				cmd = "select c1||'-'||c2 as descripcion, c1 as clave  from keplersc.kdcatcitasordenes";								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\query  ");								cuboQuery  = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_orden_cerrada.IniCombos()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery ,"C:\Basura\cubo_orden  ");								ok=getXmlAtt(cuboQuery ,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery ,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var cmd_tipo_orden = "tipo_orden";				llenar_cmb(cuboQuery ,cmd_tipo_orden );				frn.set(cmd_tipo_orden ,descr_combo(cmd_tipo_orden ,1,"T"));												}			fun ObtenerOrden(){								var cmdQuery = "select c1 as sucursal,c3 as folio, to_char(c4, 'dd/mm/yyyy') as fecha from keplersc.kdord" &					" where c1='" & frn.get("cmb_sucursal", -1, 1) & "'  and c2='" & frn.get("tipo_orden", -1, 1) & "' order by c4 desc" ;					frn.dialog("genlistafiltrosel","Ordenes de Servicio",cmdQuery,"folio","fol_orden","0","","S");			}																	fun Formar_folio(){							var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","folio_id",frn.get("fol_orden"));								borrar_datos();								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_orden_cerrada.Formar_folio()");				frn.lib("libGeneral.kpl","FileSave",cubofol,"C:\Basura\cuboFol");								var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");								frn.set("fol_orden", fol);							}						fun buscar_orden(){								var cmd, cubo, ok;				var suc = frn.get("cmb_sucursal", -1, 1);				var tipo_orden = frn.get("tipo_orden", -1, 1);				var fol_ord = frn.get("fol_orden");								cmd = "select ord.c10 as clave_cli, ord.c11 as nombre, ud.c11 as correo, mrc.c1 as clave_marca, mrc.c2 as desc_marca, " &				" mds.c2 as clave_modelo, mds.c3 as desc_modelo, ser.c11 as anio, cnc.c1 as clave_conce,cnc.c2 as desc_conce, " &				" ord.c4 as fecha_recep, ord.c5 as hora_recep,ord.c15 as tel_1, ord.c16 as tel_2, ord.c17 as rfc, ord.c20 as kilometraje , ord.c21 as placas,  " &				" ord.c12 || '  No. ' || ord.c56 || '  Int. ' ||  ord.c57 as direccion , ord.c13 as colonia, ord.c14 || ', ' || ord.c58 || ',  ' || ord.c59 || ', C.P. ' || ord.c18 as poblacion, " &				" ord.c7 as flujo_admon, ord.c19 as bonete, ord.c22 as recep, ord.c24 || '.  ' || ord.c25 || '.  ' || ord.c26 || '.  ' || ord.c27 as comentarios, ord.c55 as siniestro, " &				" ser.c1 as ident, ser.c4 as serie , ser.c5 as motor, ser.c6 as transmision, ser.c7 as eje_trasero, ser.c13 as fecha_venta, ser.c10 as color,  " &				" ord.c30 as total_mano_obra, ord.c31 as total_refs, ord.c32 as total_tots, ord.c33 as total_cargos_varios, " &				" ord.c40 as genero_fact, ord.c41 as nat_fact, ord.c42 as gpo_fact, ord.c43 as tipo_fact, ord.c44 as folio_fact, ord.kms_salida," &				" ord.c61 as subtotal_orden, ord.c62 as iva_orden, ord.c63 as total_orden" &				" from keplersc.kdord as ord inner join keplersc.kdud as ud on ord.c10=ud.c2 inner join keplersc.kdserie as ser on ord.c6=ser.c1 " &				" inner join keplersc.kdmarcas as mrc on ser.c2=mrc.c1 inner join keplersc.kdmodelos as mds   " &				" on ser.c2=mds.c1 and ser.c3= mds.c2 left outer join keplersc.kdconc as cnc on ser.c14=cnc.c1 " &				" where ord.c1='" & suc & "' and ord.c2='" & tipo_orden  & "' and ord.c3='" & fol_ord & "'";								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmd ");									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_orden_cerrada.buscar_orden()");											ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var len_result = nXml(cubo);								if (len_result == 0){					frn.message("Orden no encontrada","Error","Aceptar");					frn.rst("fol_orden");					frn.rst("nombre");					frn.rst("marca_clave");					frn.rst("marca_desc");						frn.rst("modelo_clave");					frn.rst("modelo_desc");										frn.rst("anio");						frn.rst("concesionario_clave");					frn.rst("concesionario_desc");									return;				}								clave_cli= getXmlAtt(cubo,"r0", "clave_cli");						nombre = getXmlAtt(cubo,"r0", "nombre");				frn.set("nombre", nombre );				clave_marca = getXmlAtt(cubo,"r0", "clave_marca");				frn.set("marca_clave", clave_marca );				desc_marca = getXmlAtt(cubo,"r0", "desc_marca");				frn.set("marca_desc", desc_marca );				clave_modelo = getXmlAtt(cubo,"r0", "clave_modelo");				frn.set("modelo_clave",clave_modelo );				desc_modelo = getXmlAtt(cubo,"r0", "desc_modelo");				frn.set("modelo_desc",desc_modelo );				anio = getXmlAtt(cubo,"r0", "anio");				frn.set("anio",anio );				clave_conce = getXmlAtt(cubo,"r0", "clave_conce");				frn.set("concesionario_clave",clave_conce );				desc_conce = getXmlAtt(cubo,"r0", "desc_conce");				frn.set("concesionario_desc",desc_conce );								fecha_recep= getXmlAtt(cubo,"r0", "fecha_recep");				hora_recep= getXmlAtt(cubo,"r0", "hora_recep");								correo= getXmlAtt(cubo,"r0", "correo");				tel_1= getXmlAtt(cubo,"r0", "tel_1");				tel_2= getXmlAtt(cubo,"r0", "tel_2");				rfc= getXmlAtt(cubo,"r0", "rfc");				kilometraje = getXmlAtt(cubo,"r0", "kilometraje");				kms_salida = getXmlAtt(cubo,"r0", "kms_salida");				placas = getXmlAtt(cubo,"r0", "placas");				direccion = getXmlAtt(cubo,"r0", "direccion");				colonia= getXmlAtt(cubo,"r0", "colonia");				poblacion= getXmlAtt(cubo,"r0", "poblacion");				flujo_admon  = getXmlAtt(cubo,"r0", "flujo_admon");								bonete = getXmlAtt(cubo,"r0", "bonete");				recep = getXmlAtt(cubo,"r0", "recep");				siniestro = getXmlAtt(cubo,"r0", "siniestro");				comentarios = getXmlAtt(cubo,"r0", "comentarios");								identificador = getXmlAtt(cubo,"r0", "ident");				serie = getXmlAtt(cubo,"r0", "serie");				motor = getXmlAtt(cubo,"r0", "motor");				transmision = getXmlAtt(cubo,"r0", "transmision");				eje_trasero = getXmlAtt(cubo,"r0", "eje_trasero");				fecha_venta= getXmlAtt(cubo,"r0", "fecha_venta");				color  = getXmlAtt(cubo,"r0", "color");					total_mano_obra = getXmlAtt(cubo,"r0", "total_mano_obra");				total_refs = getXmlAtt(cubo,"r0", "total_refs");				total_tots = getXmlAtt(cubo,"r0", "total_tots");				total_cargos_varios  = getXmlAtt(cubo,"r0", "total_cargos_varios");								//MSS: Obtener los datos de la tabla kdord que se generan al cerrar la orden				subtotal_orden  = getXmlAtt(cubo,"r0", "subtotal_orden"); 				iva_orden  = getXmlAtt(cubo,"r0", "iva_orden");				total_orden  = getXmlAtt(cubo,"r0", "total_orden");								genero_fact= getXmlAtt(cubo,"r0", "genero_fact");				nat_fact= getXmlAtt(cubo,"r0", "nat_fact");				gpo_fact= getXmlAtt(cubo,"r0", "gpo_fact");				tipo_fact= getXmlAtt(cubo,"r0", "tipo_fact");				folio_fact = getXmlAtt(cubo,"r0", "folio_fact");							}								fun GenerarReporte(){				var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var cubo, cmd,ok,mensajeError , xmlRequest, strTmp, totres  ;								var suc = frn.get("cmb_sucursal", -1, 1);				var tipo_orden = frn.get("tipo_orden", -1, 1);				var fol_ord = frn.get("fol_orden");												if (flujo_admon &= 0){					frn.message("Orden Abierta","","Aceptar");				}				if (flujo_admon &= 10){					frn.message("Orden Cerrada y Lista para Facturar","","Aceptar");				}				if (flujo_admon &= 20){					frn.message("Orden lista para imprimir vale de salida","","Aceptar");				}														kdb.kde("KDE");//Configuración del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();				//var incluir_salto_pagina= frn.get("salto_de_pagina");								kdb.readPage("datos","rep_orden_cerradafto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parámetros finales de impresión.(rep.page(...);)										rep.set("suc_desc",frn.get("cmb_sucursal", -1, 0));				rep.set("rep_fecha",fechaImpresion);				rep.set("rep_hora",horaImpresion);				rep.set("rep_orden", tipo_orden  & " - " & fol_ord  );				rep.exe("encabezado");								rep.set("fecha_recep",fecha_recep);				rep.set("hora_recep",hora_recep);												//busca cita 				var cmd_cita = " select c2,c12,c13 from keplersc.kdctasser where c1='" & suc & "' and c21='" & tipo_orden & "' and c22='" & fol_ord & "'";									var cubo_cita = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd_cita ,"rep_orden_cerrada.GenerarReporte()");						rep.set("folio_cita",getXmlAtt(cubo_cita ,"r0","c2") );				rep.set("fecha_cita",getXmlAtt(cubo_cita ,"r0","c12") );				rep.set("hora_cita",	getXmlAtt(cubo_cita ,"r0","c13") );								rep.set("ident",identificador  );				rep.set("marca_clave",clave_marca  );				rep.set("marca_desc",desc_marca   );				rep.set("modelo_clave",clave_modelo  );				rep.set("modelo_desc",desc_modelo  );				rep.set("serie",serie );				rep.set("motor",motor );				rep.set("transmision",transmision);				rep.set("eje_trasero",eje_trasero);				rep.set("placas",placas);				rep.set("color",color);				rep.set("anio",anio);				rep.set("kilometraje",kilometraje);				rep.set("kms_salida",kms_salida);				if (kms_salida>0){					rep.set("txt_kms_salida","Kms. Salida :");					rep.setAtt("txt_kms_salida","visible","Y");					rep.setAtt("det_km_sal","visible","Y");				}else{					rep.set("txt_kms_salida","");					rep.setAtt("txt_kms_salida","visible","N");					rep.setAtt("kms_salida","visible","N");				}								rep.set("fecha_venta",fecha_venta);				rep.set("clave_conce",clave_conce );				rep.set("desc_conce",desc_conce);								rep.set("clave_cli",clave_cli);				rep.set("nombre",nombre);				rep.set("direccion",direccion);				rep.set("colonia",colonia);				rep.set("poblacion",poblacion);				rep.set("tel_1",tel_1);				rep.set("tel_2",tel_2);				rep.set("rfc",rfc);				rep.set("correo",correo);						rep.set("recep",recep);				rep.set("bonete",bonete);				rep.set("siniestro",siniestro);										textos_largos(comentarios, "comentarios");																// checa si hay alguna otra orden abierta o lista para facturar de la serie 							var cmd_orden_comple = " select c2,c3,c7 from keplersc.kdord where c1='" & suc & "' and c6='" & identificador  & "' and c7<=10";									var cubo_orden_comple = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd_orden_comple ,"rep_orden_cerrada.GenerarReporte()");											var totordencomple = nXml(cubo_orden_comple );									var tipo_comple, fol_comple, admon_comple, mensaje_ord_comple ;				for (var contordencomple=0; contordencomple<totordencomple ; contordencomple++){															tipo_comple = getXmlAtt(cubo_orden_comple ,"r"&contordencomple,"c2");					fol_comple= getXmlAtt(cubo_orden_comple ,"r"&contordencomple,"c3") ; 										if ( tipo_orden  &! tipo_comple || fol_ord &! fol_comple  ){											admon_comple = getXmlAtt(cubo_orden_comple ,"r"&contordencomple,"c7") ; 											if( admon_comple &= 0){													mensaje_ord_comple = mensaje_ord_comple & " Orden complemento Abierta: " &  tipo_comple  & "-" & fol_comple & ".";												}else{													mensaje_ord_comple = mensaje_ord_comple & " Orden complemento Cerrada y lista para facturar: " &  tipo_comple  & "-" & fol_comple & ".";										}										}								}									rep.set("orden_complemento",mensaje_ord_comple  );														rep.exe("datos_orden");																cmd = " select pun.c4,pun.c8,pun.c9,pun.c15 || '.  ' || pun.c18 || '.  ' || pun.c19 as notas_cliente, case when pun.c6='S' then 'Servicio Autorizado' " &				" when pun.c6='F' then 'Falla Autorizada' when pun.c6='H' then 'Hojalateria Autorizada' " &				" when pun.c6= 'L' then 'Lavado sin cargo' when pun.c6= 'I' then 'Interna' when pun.c6='G' then 'Garantia' " &				" when pun.c6= 'R' then 'Reclamacion' when pun.c6='Q' then 'Previa' when pun.c6='P' then 'Presupuestar' when 'N' then 'No Autorizado' else '' end as autorizacion  " &				" , case when pun.c7= 'P' then 'Pendiente' when pun.c7= 'A' then 'Activo' when pun.c7='S' then 'Suspendido' when pun.c7='T' then 'Terminado' else '' end as estado  " &				" , case when pun.c20='C' then 'Cerrado' when pun.c20='A' then 'Abierto' ELSE '' END as refs_int  " &				" , case when pun.c22='C' then 'Cerrado' when pun.c22='A' then 'Abierto' ELSE '' END as tab" &				" , case when pun.c23='C' then 'Cerrado' when pun.c23='A' then 'Abierto' ELSE '' END as tots" &				" , case when pun.c24='C' then 'Cerrado' when pun.c24='A' then 'Abierto' ELSE '' END as cargs, ope.c3 as nombre_ope" &				" from keplersc.kdpun as pun left outer join keplersc.kdoper as ope on pun.c9=ope.c1 " &				" where pun.c1='" & suc & "' and pun.c2='" & tipo_orden  & "' and pun.c3='" & fol_ord & "' order by pun.c4 ";								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmd ");									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_orden_cerrada.GenerarReporte()");											ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");												var totpun = nXml(cubo);												for (var contpun=0; contpun<totpun ; contpun++){							var num_punto = getXmlAtt(cubo ,"r"&contpun,"c4");									rep.set("numero_de_punto",num_punto  );					rep.set("desc_punto",getXmlAtt(cubo ,"r"&contpun,"c8") );					rep.set("autorizacion",getXmlAtt(cubo ,"r"&contpun,"autorizacion") );					rep.set("estado",getXmlAtt(cubo ,"r"&contpun,"estado") );					rep.set("clave_operario",getXmlAtt(cubo ,"r"&contpun,"c9") );					rep.set("desc_operario",getXmlAtt(cubo ,"r"&contpun,"nombre_ope") );										textos_largos(getXmlAtt(cubo ,"r"&contpun,"notas_cliente"), "notas_cliente");										rep.set("refs_internas",getXmlAtt(cubo ,"r"&contpun,"refs_int") );					rep.set("tabulacion",getXmlAtt(cubo ,"r"&contpun,"tab") );					rep.set("tots",getXmlAtt(cubo ,"r"&contpun,"tots") );					rep.set("cargos_varios",getXmlAtt(cubo ,"r"&contpun,"cargs") );																			rep.exe("datos_por_punto");																			var cmd_tab = " select c6,c7,c8,c17 from keplersc.kdhoras where c1='" & suc & "' and c2='" & tipo_orden  & "' and c3='" & fol_ord & "' and c4='" & num_punto & "'";										var cubo_tab = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd_tab ,"rep_orden_cerrada.GenerarReporte()");												var tothoras = nXml(cubo_tab );															for (var conthrs=0; conthrs<tothoras ; conthrs++){											if (conthrs &= 0 ){							rep.set("tab_num_punto",num_punto);							rep.exe("tab_columnas");						}								rep.set("tab_clave",getXmlAtt(cubo_tab ,"r"&conthrs,"c6") );						rep.set("tab_desc",getXmlAtt(cubo_tab ,"r"&conthrs,"c7") );						rep.set("tab_ctd",getXmlAtt(cubo_tab ,"r"&conthrs,"c8") );						rep.set("tab_importe",getXmlAtt(cubo_tab ,"r"&conthrs,"c17") );						rep.exe("tab_por_punto");											}																					var cmd_refs = " select c5 || c6 ||  lpad(c7::text, 2, '0') || lpad(c8::text, 3, '0') || '-' || c9 as doc, c11, c12, c13, c14, c15, c16  from keplersc.kdref "& 					" where c1='" & suc & "' and c2='" & tipo_orden  & "' and c3='" & fol_ord & "' and c4='" & num_punto & "'";										var cubo_refs = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd_refs ,"rep_orden_cerrada.GenerarReporte()");												var totrefs = nXml(cubo_refs );															for (var contrefs =0; contrefs <totrefs ; contrefs ++){											if (contrefs &= 0 ){							rep.set("refs_num_punto",num_punto);							rep.exe("refs_columnas");						}								rep.set("refs_folio",getXmlAtt(cubo_refs ,"r"&contrefs ,"doc") );						rep.set("refs_clave",getXmlAtt(cubo_refs ,"r"&contrefs ,"c11") );						rep.set("refs_desc",getXmlAtt(cubo_refs ,"r"&contrefs ,"c12") );						rep.set("refs_ctd",getXmlAtt(cubo_refs ,"r"&contrefs ,"c13") );						rep.set("refs_unidad",getXmlAtt(cubo_refs ,"r"&contrefs ,"c14") );						rep.set("refs_unitario",getXmlAtt(cubo_refs ,"r"&contrefs ,"c15") );						rep.set("refs_importe",getXmlAtt(cubo_refs ,"r"&contrefs ,"c16") );												rep.exe("refs_por_punto");											}														var cmd_tots = " select c5 || c6 || lpad(c7::text, 2, '0') || lpad(c8::text, 3, '0') || '-' || c9 as doc, c10, c16  from keplersc.kdtot "& 					" where c1='" & suc & "' and c2='" & tipo_orden  & "' and c3='" & fol_ord & "' and c4='" & num_punto & "'";										var cubo_tots = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd_tots ,"rep_orden_cerrada.GenerarReporte()");												var tot_tots = nXml(cubo_tots);															for (var conttots =0; conttots <tot_tots ; conttots ++){											if (conttots &= 0 ){							rep.set("tots_num_punto",num_punto);							rep.exe("tots_columnas");						}								rep.set("tots_folio",getXmlAtt(cubo_tots ,"r"&conttots ,"doc") );						rep.set("tots_desc",getXmlAtt(cubo_tots ,"r"&conttots ,"c10") );						rep.set("tots_importe",getXmlAtt(cubo_tots ,"r"&conttots ,"c16") );												rep.exe("tots_por_punto");											}																					var cmd_cargs = " select c6,c7,c10 from keplersc.kdcar where c1='" & suc & "' and c2='" & tipo_orden  & "' and c3='" & fol_ord & "' and c4='" & num_punto & "'";										var cubo_cargs = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd_cargs ,"rep_orden_cerrada.GenerarReporte()");												var tot_cargs = nXml(cubo_cargs );															for (var contcargs=0; contcargs <tot_cargs ; contcargs ++){											if (contcargs &= 0 ){							rep.set("cargs_num_punto",num_punto);							rep.exe("cargs_columnas");						}								rep.set("cargs_clave",getXmlAtt(cubo_cargs ,"r"&contcargs ,"c6") );						rep.set("cargs_desc",getXmlAtt(cubo_cargs ,"r"&contcargs ,"c7") );						rep.set("cargs_importe",getXmlAtt(cubo_cargs ,"r"&contcargs ,"c10") );											rep.exe("cargs_por_punto");											}														}													rep.exe("titulo_totales_orden");						rep.set("mano_obra_totales", total_mano_obra );				rep.set("refacciones_totales", total_refs );				rep.set("tots_totales", total_tots );				rep.set("cargos_varios_totales", total_cargos_varios  );									var subtotal = total_mano_obra + total_refs + total_tots + total_cargos_varios ;									//rep.set("subtotal", subtotal);				rep.set("subtotal", subtotal_orden);		//MSS: Mostrar los datos de la tabla kdord que se generan al cerrar la orden				var iva = subtotal * 16 / 100 ;									//rep.set("iva", iva );				rep.set("iva", iva_orden );					//MSS: Mostrar los datos de la tabla kdord que se generan al cerrar la orden				var total = subtotal + iva;									//rep.set("total", total );				rep.set("total", total_orden );				//MSS: Mostrar los datos de la tabla kdord que se generan al cerrar la orden								rep.exe("detalle_totales_orden");												var cmd_fact = " select m1.c9 , m1.c2 || m1.c3 || lpad(m1.c4::text, 2, '0') || lpad(m1.c5::text, 3, '0') || '-' || m1.c6 as mov_fact,mm.c5 as desc_mov, " &				" m1.c10, m1.c32, m1.c33, m1.c34, m1.c35, m1.c22, m1.c51, m1.c52, m1.c53, m1.c54, m1.c13, m1.c14, m1.c16 " &				" from keplersc.kdm1 as m1 inner join keplersc.kdmm as mm on m1.c1=mm.col_sucursal and m1.c2=mm.c1 and m1.c3=mm.c2 and m1.c4=mm.c3 and m1.c5=mm.c4 " &				" where m1.c1='" & suc & "' and m1.c2='" & genero_fact& "' and m1.c3='" & nat_fact & "' and m1.c4='" & gpo_fact & "'" &				" and m1.c5='" & tipo_fact & "' and m1.c6='" & folio_fact  & "'";													frn.lib("libGeneral.kpl","FileSave",cmd_fact ,"C:\Basura\cmd_fact ");									var cubo_fact = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd_fact ,"rep_orden_cerrada.GenerarReporte()");									var tot_fact = nXml(cubo_fact );									if (tot_fact > 0){										rep.set("fecha_factura", getXmlAtt(cubo_fact ,"r0","c9") );					rep.set("folio_factura", getXmlAtt(cubo_fact ,"r0","mov_fact") );					rep.set("tipo_mov", getXmlAtt(cubo_fact ,"r0","desc_mov") );										var cli = getXmlAtt(cubo_fact ,"r0","c10");										rep.set("clavecliente",cli  );											rep.set("nombre_cli", getXmlAtt(cubo_fact ,"r0","c32") );					rep.set("calle_cli", getXmlAtt(cubo_fact ,"r0","c33") );					rep.set("colonia_cli", getXmlAtt(cubo_fact ,"r0","c34") );					rep.set("poblacion_cli", getXmlAtt(cubo_fact ,"r0","c35") );					rep.set("rfc_cli", getXmlAtt(cubo_fact ,"r0","c22") );															var mano_obra_fact = getXmlAtt(cubo_fact ,"r0","c51") ;					var refacciones_fact = getXmlAtt(cubo_fact ,"r0","c52");					var tots_fact = getXmlAtt(cubo_fact ,"r0","c53");					var cargos_varios_fact = getXmlAtt(cubo_fact ,"r0","c54");										rep.set("mano_obra_fact", mano_obra_fact  );					rep.set("refacciones_fact", refacciones_fact  );					rep.set("tots_fact", tots_fact  );					rep.set("cargos_varios_fact", cargos_varios_fact  );										var subtotal_fact = mano_obra_fact + refacciones_fact + tots_fact + cargos_varios_fact;										rep.set("subtotal_fact", subtotal_fact);					rep.set("descuento_fact", getXmlAtt(cubo_fact ,"r0","c13") );					rep.set("iva_fact", getXmlAtt(cubo_fact ,"r0","c14") );					rep.set("total_fact", getXmlAtt(cubo_fact ,"r0","c16") );															rep.exe("datos_factura");														}										rep.win();						}						fun textos_largos(texto,input){				var renglon1=0,renglon2=0,renglon3=0,renglon4=0,renglon5=0,renglon6=0;				var strObservaciones = texto;				var num_strObservaciones = strSplit(strObservaciones," ",-1);				var observaciones1 = "";				var observaciones2 = "";				var observaciones3 = "";				var observaciones4 = "";				var observaciones5 = "";				var observaciones6 = "";				for (var palabra=0; palabra<num_strObservaciones ;palabra++){				//MSS se corrige separacion de palabras, si trae numeros los omite y/o pasa al sig renglon				//inclui +strlen() en cada if					if ((strlen(observaciones1)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon1 == 0){						observaciones1 = observaciones1 & strSplit(strObservaciones," ", palabra) & " ";					}					else{						if ((strlen(observaciones2)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon2 == 0){							renglon1= 1;							observaciones2 = observaciones2 & strSplit(strObservaciones," ", palabra) & " ";						}						else{							if ((strlen(observaciones3)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon3 == 0){								renglon2= 1;								observaciones3 = observaciones3 & strSplit(strObservaciones," ", palabra) & " ";							}							else{								if ((strlen(observaciones4)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon4 == 0){									renglon3= 1;									observaciones4 = observaciones4 & strSplit(strObservaciones," ", palabra) & " ";								}								else{									if ((strlen(observaciones5)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon5 == 0){										renglon4= 1;										observaciones5 = observaciones5 & strSplit(strObservaciones," ", palabra) & " ";									}else{										if ((strlen(observaciones6)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon6 == 0){											renglon5= 1;											observaciones6 = observaciones6 & strSplit(strObservaciones," ", palabra) & " ";										}									}								}							}						}					}					}				rep.set(input & "1",observaciones1);				rep.set(input & "2",observaciones2);				rep.set(input & "3",observaciones3);				rep.set(input & "4",observaciones4);				rep.set(input & "5",observaciones5);				rep.set(input & "6",observaciones6);											}											//-------------------------------------------------extras------------------------------------------------						fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}												fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}			 				fun IniParams(){//Inicializa parï¿½metros de impresiï¿½n, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Pï¿½gina				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","N");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}						fun setRepPage() {//Establece los parï¿½metros finales de impresiï¿½n.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}																											}	</script></pag>