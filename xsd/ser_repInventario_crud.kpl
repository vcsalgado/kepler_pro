<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de Inventario">	<grp id="grpMain" brdr="0,0" clr="0,58,112" fnt="Arial,18b"  dim="1,-1,10,8" bclr="192,205,213" clrBrdr="0,97,181" OnF1="" tit="REPORTE DE INVENTARIO" unfont="0">	<br/><tab/><inp id="inp_titulo" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>	<br/><tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grpDatosGenerales" dim="50,15,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5"  tit="Reporte de Inventario"  fnt="Arial,16" available="Y" modify="Y">		<sp/><txt clr="0,58,112" hk="S">Sucursal</txt><tab/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y"/>					<br/><sp/><txt clr="0,58,112">Mostrar Unidades con una edad promedio entre:</txt><tab/>			<inp id="k_fechafactura_a" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255"  fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="string"/>			<txt clr="0,58,112"> y </txt>			<inp id="k_fechafactura_b" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255"  fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="string"/>						<br/>			<sp/><txt clr="0,58,112">Modelo Inicial:</txt><tab/>			<inp id="k_modelo_ini" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255"  fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="string"/>			<br/>			<sp/><txt clr="0,58,112">Modelo Final:</txt><tab/>			<inp id="k_modelo_fin" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255"  fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="string"/>			<br/>			<sp/><txt clr="0,58,112">&#191;Mostrar unidades pendientes por entregar?</txt><tab/>			<inp id="k_unidades_pendientes" clr="64,64,64" clrBrdr="255,255,255"  dim="3,1" bclr="255,255,255"  fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="string"/>						<tab n="1"/><img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Consulta()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y" default = "1"/>		</grp><sp/>		<tab n="18"/>	</grp>	<tools>		<tool OnMouseL="Ejecuta()" tooltip="Aceptar documento(Ctrl+T)" scut="Ctrl+T" img="_TL_Execute.png"/>	</tools>	<script>		InstallDriver("KDB75");		class Main {			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc,usuario,sucursal_id,suc_usuario,rol_usuario,asterisco, v_inventario,valorRetorno,v_IvaAuto,v_correo,v_uso_cfdi;			var frn,kdb,rep,frP,sys;			var uen;			var tip_ope;//Tipo de operación. "0" indica Alta; "1" indica consulta; "2" indica cancelación; "3" indica baja; "4" Indica modificación						var anio_contable;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("F,KDMM,G,KDM1,H,KDMARGEN,I KDORD,J KDPUN,K,KDSERIE,L KDMARCAS,M KDMODELOS,O,KDCONC,P,KDOPER,S,KDMS,T,KDHORAS,u KDREF,v KDTOT,W,KDCAR,X,KDORD,Y,KDREFSUSP,z KDSUSP");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				inicializa();			}						fun inicializa()			{//Da valor a los combos y prepara la página dependiendo del tipo de Operación a realizar				var resValidacion, 						resMensaje, 						cubo, 						cmd, 						ok,						mensajeError,						sucursal_id,						v_cliente,						v_tipoOperacion;				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				frn.set("k_fecha",sys.date());				if(frn.nParam()>0 ){					uen=trim(frn.param(0));									}				else				{					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaPedido.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",getXml(cubo));				frn.set("k_fechafactura_a","0");				frn.set("k_fechafactura_b","1999");				frn.set("k_modelo_fin","VAGFYL8");				frn.set("k_unidades_pendientes","S");			}						fun Ejecuta()			{				Consulta();			}												fun Consulta()			{				reporte();							}						fun reporte()			{				var cuboProd,ok,mensajeError,prodExiste,sucursal_id,cmd,xmlPantalla;										sucursal_id = frn.get("k_sucn",-1,1);					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantalla_ser_repinventario_crud");					cmd = "select * from keplersc.rep_refinventariodia_xml('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ser_reporteInventario_crud.Consultar()");					//frn.lib("libGeneral.kpl","FileSave",cuboProd,"C:\Basura\rep_refinventariodia_xml");					ok = getXmlAtt(cuboProd,"ok");					if(ok &! "" && !ok)					{						mensajeError = getXmlAtt(cuboProd,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						//return;					}					var strTmp,v_resultadoxml;					strTmp = getXmlAtt(cuboProd ,"r0","v_resultadoxml");					strTmp = delScpScn(strTmp);					setXmlStr(v_resultadoxml,strTmp);				frn.lib("libGeneral.kpl","FileSave",v_resultadoxml,"C:\Basura\cubo_datos_resultados");					//frn.message(getXml(v_resultadoxml,"total"),"Total regresado","Aceptar");									var prefix=frn.lib("libKepler","langPrefix");				kdb.kde("KDE");//				kdb.exec();								kdb.readPage("datos","ser_repInventario_crud_fto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos")); 				rep.rst(); 				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");								rep.set("titulo",frn.get("k_tipon"));				rep.exe("tit");				rep.set("rep_suc",frn.get("k_sucn",-1,0));					//rep.set("rep_docto","" & frn.get("k_folio"));				//rep.set("rep_refer",getXmlAtt(cuboProd,"r0","c2") &" " & frn.get("k_folio"));				rep.set("rep_fecha",frn.get("k_fecha"));				rep.exe("encabezado");				rep.set("rep_ver","INVENTARIO DISPONIBLE AL " & frn.get("k_fecha"));				rep.set("rep_separadorA","====================================================================================================================================================================");				rep.set("rep_separador", "------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------");				rep.set("rep_separadorA1","====================================================================================================================================================================");				rep.set("rep_separador1", "------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------");				rep.set("rep_separador2", "------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------");				rep.set("rep_tit0","INGRESO");				rep.set("rep_tit1","INVENTARIO");				rep.set("rep_tit2","MOD.");				rep.set("rep_tit3","N/U");				rep.set("rep_tit4","SERIE");				rep.set("rep_tit5","EXT /INT ");				rep.set("rep_tit6","COSTO");				rep.set("rep_tit7","EDAD");				rep.set("rep_tit8","APARTADO");				rep.set("rep_tit9","ASESOR");				rep.set("rep_tit10","PREVIA");				rep.set("rep_tit11","ACCESORIOS");				rep.exe("seccion_detalle");																var aux_renglon="",						valor_aux ="", 						contador_aux=12,						auxiliar_valor="",						total_modelo = 0;				//frn.message(nXml(v_resultadoxml),"Total registros","Aceptar");				total_modelo = getXml(v_resultadoxml,"total_modelo");				for(var renref=0; renref < nXml(v_resultadoxml);renref++)				{										for (var columna = 0; columna < total_modelo; columna++)					{						contador_aux = 12;						for(var renglon=0; renglon < 12; renglon++)						{							aux_renglon = "r_" & (renref+1) & "_" & (columna + 1);							auxiliar_valor = "v"&(renglon + 1);							valor_aux = "" & getXml(v_resultadoxml,aux_renglon,auxiliar_valor);						if(valor_aux &= "" )						{							contador_aux = contador_aux-1;						}						rep.set("rep_" & renglon & "_valor",valor_aux);															}						if (contador_aux > 0)						{							rep.exe("seccion_1");						}					}				}				rep.exe("seccion_totales");				rep.win(); 			}			fun PadRight(pText,pRelleno,pCaracterRelleno){				var pos_ini,Resultado,nReg;				Resultado;				pos_ini = pText;				nReg= strlen(pText);				for (var cont = nReg; cont < pRelleno; cont++){					Resultado = Resultado & pCaracterRelleno;				}				Resultado = pText & Resultado;   				return Resultado;			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaciï¿½n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se estï¿½ en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}			//frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\reporte_ser_sql");		/*	REPORTE DE ORDEN    CREADO: 16/DIC/2022  SALTIEL CRUZ*/		}				</script></pag>