 conductor"/>		<tab/><sp n="2"/>      <txt clr="0,58,112">Telefono oficina :</txt>				<inp id="invnot_ladatelefonooficinaconductor" clr="64,64,64"  dim="3,1" brdr="2,0" bclr="255,255,255" type="capital" nc="3" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Lada del telefono de oficina del conductor"/>		<sp/>		<inp id="invnot_telefonooficinaconductor" clr="64,64,64"  dim="10,1" brdr="2,0" bclr="255,255,255" type="capital" nc="10" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Telefono de oficina del conductor"/>		<tab/><sp n="2"/>       <txt clr="0,58,112">Telefono celular : </txt>				<inp id="invnot_ladatelefonocelularconductor" clr="64,64,64"  dim="3,1" brdr="2,0" bclr="255,255,255" type="capital" nc="3" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Lada del telefono celular del conductor"/>		<sp/>		<inp id="invnot_telefonocelularconductor" clr="64,64,64"  dim="10,1" brdr="2,0" bclr="255,255,255" type="capital" nc="10" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Telefono celular del conductor"/>		<br/><tab/>		<txt clr="0,58,112">Correo electronico : </txt>				<inp id="invnot_emailconductor" dim="42,1" type="string" nc="50" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="Correo electronico del conductor"/><txt>  Permite ser contactado :</txt>		<cmb id="invnot_permitecontactoconductor" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" OnChange="" modify="Y" available="Y" visible="Y" tooltip="El conductor desea ser contactado SI/NO"/>		<br/><tab/>		<txt clr="0,58,112" fnt=",b">Datos del Vendedor</txt>		<br/><tab/>		<txt clr="132,20,7">Tipo distribuidor : </txt>		<cmb id="invnot_tipodistribuidor" clr="64,64,64" clrBrdr="255,255,255"  dim="10,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" OnChange="" modify="Y" available="Y" visible="Y" tooltip="Tipo de distribuidor que emite la factura"/><txt>     RFC :</txt>				<inp id="invnot_rfcvendedor" dim="20,1" type="capital" nc="13" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="RFC del vendedor"/><txt>     Identificador vendedor :</txt>				<inp id="invnot_identificadorvendedor" dim="12,1" type="capital" nc="10" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="Identificador del Vendedor"/>		<br/><tab/>		<txt clr="132,20,7">Nombre : </txt><tab/><sp n="2"/>				<inp id="invnot_nombrevendedor" dim="40,1" type="capital" nc="30" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="Nombre del vendedor"/>        <txt clr="132,20,7">**Verificar separacion nombre y apellidos**</txt>		<br/><tab/>        <txt clr="132,20,7">Apellido paterno : </txt>				<inp id="invnot_apellidopaternovendedor" clr="64,64,64"  dim="25,1" brdr="2,0" bclr="255,255,255" type="capital" nc="30" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Apellido paterno del vendedor"/><tab/>        <txt clr="132,20,7">Apellido materno : </txt>				<inp id="invnot_apellidomaternovendedor" clr="64,64,64"  dim="25,1" brdr="2,0" bclr="255,255,255" type="capital" nc="30" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Apellido materno del vendedor"/>		<br/><tab/><hLine clr="0,0,0" dim="75,1"/>		<br/><tab/>		<txt clr="132,20,7">Tipo de pago :</txt>		<sp n="2"/>		<cmb id="invnot_tipopago" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" OnChange="" modify="Y" available="Y" visible="Y" tooltip="Tipo de distribuidor que emite la factura"/><tab n="3"/>        <txt clr="132,20,7">No. aut.  financiamiento : </txt>				<inp id="invnot_numeroautorizacionfinanciamiento" clr="64,64,64"  dim="21,1" brdr="2,0" bclr="255,255,255" type="capital" nc="15" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="No. autorizacion financiamiento"/>		<br/><tab/>        <txt clr="0,58,112">Tasa : </txt>		<tab n="2"/><sp n="2"/>				<inp id="invnot_tasa" clr="64,64,64"  dim="10,1" brdr="2,0" bclr="255,255,255" type="number" nc="9" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Tasa del credito"/><tab/>        <txt clr="0,58,112">Plazo : </txt><tab/><sp n="2"/>				<inp id="invnot_plazo" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="number" nc="9" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Plazo del credito"/>		<tab/><sp n="2"/>		<txt clr="132,20,7">Tipo  venta :</txt>		<cmb id="invnot_codigotipoventa" clr="64,64,64" clrBrdr="255,255,255"  dim="21,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" OnChange="" modify="Y" available="Y" visible="Y" tooltip="Tipo de venta"/>        <br/><tab/>		<txt clr="0,58,112">Codigo incentivo : </txt>				<inp id="invnot_codigoincentivo" dim="10,1" type="capital" nc="3" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="Codigo del Incentivo"/><tab/>		<txt clr="0,58,112">Codigo FAN :</txt>				<inp id="invnot_codigofan" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="capital" nc="11" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="C&#243;digo FAN asignado al cliente en caso de flotilla"/>		<tab/><sp n="2"/>		<txt>Tipo flotilla :</txt>		<cmb id="invnot_tipoflotilla" clr="64,64,64" clrBrdr="255,255,255"  dim="21,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" OnChange="" modify="Y" available="Y" visible="Y" tooltip="Tipo de flotilla"/>		<br/>		<grp dim="38,10,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">					<tab/>			<txt clr="132,20,7">Importe total venta : </txt><tab/>					<inp id="invnot_importeventatotal" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="number" nc="12" fmt="0" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Importe total de la operacion" nd="2"/>			<br/><tab/>			<txt clr="0,58,112">Enganche : </txt><tab n="3"/>					<inp id="invnot_enganche" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="number" nc="12" fmt="0" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Enganche" nd="2"/><tab n="4"/>			<br/><tab/>					<txt clr="132,20,7">Saldo pendiente : </txt><tab n="2"/>					<inp id="invnot_saldopendiente" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="number" nc="12" fmt="0" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Saldo pendiente de la operacion" nd="2"/><tab n="4"/>			<br/><tab/>			<txt clr="132,20,7">ISAN : </txt><tab n="4"/>					<inp id="invnot_isan" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="number" nc="12" fmt="0" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Importe del impuesto ISAN" nd="2"/>		</grp>		<grp dim="38,10,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">					<tab/><txt clr="132,20,7">Tipo de IVA :</txt><tab n="3"/>			<cmb id="invnot_tipoiva" clr="64,64,64" clrBrdr="255,255,255"  dim="12,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" OnChange="" modify="Y" available="Y" visible="Y" tooltip="Tipo de impuesto aplicado a la venta"/>			<br/><tab/>			<txt clr="132,20,7">Porcentaje IVA : </txt>			<tab n="2"/>					<inp id="invnot_porcentajeiva" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="number" nc="12" fmt="0" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Porcentaje de IVA"  nd="2"/>			<br/><tab/>			<txt clr="132,20,7">Importe IVA : </txt>			<tab n="3"/>					<inp id="invnot_importeiva" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="number" nc="9" fmt="0" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="ImporteIVA" nd="2"/>		</grp>		<br/><tab n="15"/>		<txt clr="132,20,7">Datos obligatorios en color &lt;Rojo&gt;</txt><tab/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>		<sp n="2"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		</grp>	</grp><script>InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco, externo ;		var cmdQuery, cuboQuery, ok, mensajeError, fileSavePath;		var tipoOper; //Variables relacionadas con parametros		var accion,straccion,resVal,suc_bus,genero,naturaleza,grupo,tipo,folio, id_docto;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			asterisco = "*";			fileSavePath = "C:\Basura";			ConfiguraUI();			Inicializa();		}					fun ConfiguraUI(){			var nparam;			tipoOper = strFormat("ucase",frn.param(0));			nparam = frn.nParam();			accion = strFormat("ucase",frn.param(1));			id_docto = strFormat("ucase",frn.param(2));			tipo = frn.param(3);			if (frn.nParam() == 0){				frn.message("Accion no permitida.","Error","&Aceptar");				frn.open("redirect",2);				return;			}			//Establecer titulo de la ventana			if (accion &= "ALTA"){				straccion = "Alta " ;            }else if (accion &= "CONSULTA"){				straccion = "Consulta ";         }     			if (tipoOper &= "INVOICENOTIFICATION"){				frn.set("inp_titulo",straccion & "Invoice Notification");											}					}						fun Inicializa(){			var cmd,cubo;							//Llenar combo sucursales			cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmd = cmd & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmd = cmd & " where c1='" & suc_usuario & "'";				}			}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ifz_sofiainvoicenotification.Inicializa()");					ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_sucn",getXml(cubo));			frn.set("k_sucn",descr_combo("k_sucn",1,suc_usuario));							//Llena combo tipo de cliente			frn.setX("ACT. EMPRESARIAL","invnot_tipocliente",0,0);			frn.setX("A","invnot_tipocliente",0,1);			frn.setX("PERSONA FISICA","invnot_tipocliente",1,0);			frn.setX("F","invnot_tipocliente",1,1);			frn.setX("GOBIERNO","invnot_tipocliente",2,0);			frn.setX("G","invnot_tipocliente",2,1);			frn.setX("PERSONA MORAL","invnot_tipocliente",3,0);			frn.setX("M","invnot_tipocliente",3,1);			frn.setX("ARRENDADORA","invnot_tipocliente",4,0);			frn.setX("R","invnot_tipocliente",4,1);			//Llena combo sexo			frn.setX("","invnot_sexo",0,0);			frn.setX("HOMBRE","invnot_sexo",1,0);			frn.setX("HOM","invnot_sexo",1,1);			frn.setX("MUJER","invnot_sexo",2,0);			frn.setX("MUJ","invnot_sexo",2,1);						//Llena combo desea ser contactado			frn.setX("","invnot_permitecontacto",0,0);			frn.setX("SI","invnot_permitecontacto",1,0);			frn.setX("SI","invnot_permitecontacto",1,1);			frn.setX("NO","invnot_permitecontacto",2,0);			frn.setX("NO","invnot_permitecontacto",2,1);			frn.setX("","invnot_permitecontactoconductor",0,0);			frn.setX("SI","invnot_permitecontactoconductor",1,0);			frn.setX("SI","invnot_permitecontactoconductor",1,1);			frn.setX("NO","invnot_permitecontactoconductor",2,0);			frn.setX("NO","invnot_permitecontactoconductor",2,1);					//Llena combo tipo distribuidor			frn.setX("MATRIZ","invnot_tipodistribuidor",0,0);			frn.setX("MATRIZ","invnot_tipodistribuidor",0,1);			frn.setX("SUCURSAL","invnot_tipodistribuidor",1,0);			frn.setX("SUCURSAL","invnot_tipodistribuidor",1,1);			//Llena combo tipo de pago			frn.setX("OTRO FINANCIAMIENTO (Flotillas)","invnot_tipopago",0,0);			frn.setX("B","invnot_tipopago",0,1);			frn.setX("SU AUTO","invnot_tipopago",1,0);			frn.setX("D","invnot_tipopago",1,1);			frn.setX("CONTADO (Flotillas)","invnot_tipopago",2,0);			frn.setX("E","invnot_tipopago",2,1);			frn.setX("ALLY TASA TRADICIONAL / CASH (Flotillas)","invnot_tipopago",3,0);			frn.setX("G","invnot_tipopago",3,1);			frn.setX("ALLY TASA SUBSIDIADA","invnot_tipopago",4,0);			frn.setX("U","invnot_tipopago",4,1);			//Llena combo tipo de iva			frn.setX("11 %","invnot_tipoiva",0,0);			frn.setX("4","invnot_tipoiva",0,1);			frn.setX("16 %","invnot_tipoiva",1,0);			frn.setX("5","invnot_tipoiva",1,1);			//Llena combo tipo de venta			frn.setX("CLIENTE FINAL","invnot_codigotipoventa",0,0);			frn.setX("010","invnot_codigotipoventa",0,1);			frn.setX("PERDIDA TOTAL","invnot_codigotipoventa",1,0);			frn.setX("060","invnot_codigotipoventa",1,1);			frn.setX("FLOTILLAS","invnot_codigotipoventa",2,0);			frn.setX("080","invnot_codigotipoventa",2,1);			frn.setX("DEMO SERVICIO","invnot_codigotipoventa",3,0);			frn.setX("100","invnot_codigotipoventa",3,1);			frn.setX("DEMO VENTA","invnot_codigotipoventa",4,0);			frn.setX("120","invnot_codigotipoventa",4,1);			//Llena combo desea ser contactado			frn.setX("","invnot_tipoflotilla",0,0);			frn.setX("PERSONA FISICA","invnot_tipoflotilla",1,0);			frn.setX("F","invnot_tipoflotilla",1,1);			frn.setX("GOBIERNO","invnot_tipoflotilla",2,0);			frn.setX("G","invnot_tipoflotilla",2,1);			frn.setX("INICIATIVA PRIVADA","invnot_tipoflotilla",2,0);			frn.setX("I","invnot_tipoflotilla",2,1);			frn.set("invnot_tipocliente", "");			frn.set("invnot_sexo", "");			frn.set("invnot_permitecontacto", "");			frn.set("invnot_permitecontactoconductor", "");			frn.set("invnot_tipodistribuidor", "");			frn.set("invnot_tipopago", "");			frn.set("invnot_tipoiva", "");			frn.set("invnot_codigotipoventa", "");			frn.set("invnot_tipoflotilla", "");			frn.set("invnot_dealerbac", "320134");			frn.set("invnot_secondarydealernumberid", "320134");			frn.set("invnot_dealerid", "19543");			genero = "U";			naturaleza = "D";			grupo = 6;						if (id_docto &! ""){				frn.set("invnot_identificadordocumento",id_docto);				Buscar();				}		}					fun IniCombos(ctrl_combo, query){			cmdQuery = query;			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ifz_sofiainvoicenotification.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set(ctrl_combo,cuboQuery);		}		fun SeparaFolio(){			var nCampos,nfolio;				//Separa el folio y tipo, vienen concatenados con ~			nCampos = strSplit(frn.get("strfolio"),"~",-1);			if (nCampos > 1) {				tipo = strSplit(frn.get("strfolio"),"~",0);				nfolio = strSplit(frn.get("strfolio"),"~",1);							}else{				nfolio = frn.get("strfolio");			}				folio = nfolio;			frn.set("invnot_identificadordocumento", folio);		}		fun ObtenerFolio() {			suc_bus = frn.get("k_sucn",-1,1);			LimpiarInf();			cmdQuery = "select c2 as gen, c3 as nat, c4 as gpo, c5 as tipo, c6 as folio, to_char(c9, 'DD/MM/YYYY') as fecha, c100 as inventario,concat(c5,'~',c6) as llave " &						"from keplersc.kdm1 " &						"where c1='" &suc_bus& "' and c2='" &genero& "' and c3='" &naturaleza& "' and c4 =" & grupo &						" order by c9 desc";			frn.dialog("genlistafiltrosel","Folios",cmdQuery,"llave","strfolio","0","0","N","N");			}		fun Buscar() {			var xmlTimbre,cmd,ok,cuboResultados, xmlProd,vfmov,vfreg,resultado,mensaje,codigoestado,estado;			suc_bus = frn.get("k_sucn", -1, 1);			folio = frn.get("invnot_identificadordocumento");						if (folio &=""){				frn.message("Debe seleccionar un folio","Error","Aceptar");				return;			} 			cmd = "Select k.c5 tipo, left(v.c9::varchar,10) invnot_fechafactura, '' invnot_cadenaoriginaltimbre, '' invnot_idsofia, 				case when (length(u.c10))=0 then 'XAXX010101000' else upper(u.c10) end as invnot_rfc, right(v.c11::varchar,6) invnot_idcliente, '' invnot_numeroidentificacion, 				case when length(u.c10)=12 then 'M' else 'F' end as invnot_tipocliente, u.c35 invnot_Nombre, u.c33 invnot_apellidopaterno, u.c34 invnot_apellidomaterno, u.c3 invnot_nombrecompleto,				'C.' invnot_titulo, '' invnot_fechanacimiento, u.c4 invnot_calle, u.c45 invnot_numeroexterior, 				u.c46 invnot_numerointerior, '' invnot_entrecalles, '' invnot_codigoasentamiento, u.c5 invnot_colonia, '' invnot_codigomunicipio, u.c47 invnot_municipio, u.c27 invnot_codigopostal,				case when upper(u.c48) ='AGUASCALIENTES' then '01'					when upper(u.c48) ='BAJA CALIFORNIA' then '02'					when upper(u.c48) ='BAJA CALIFORNIA SUR' then '03'					when upper(u.c48) ='CAMPECHE' then '04'					when upper(u.c48) in ('COAHUILA','COAHUILA DE ZARAGOZA') then '05'					when upper(u.c48) ='COLIMA' then '06'					when upper(u.c48) ='CHIAPAS' then '07'					when upper(u.c48) ='CHIHUAHUA' then '08'					when upper(u.c48) in ('CIUDAD DE MEXICO','DISTRITO FEDERAL') then '09'					when upper(u.c48) ='DURANGO' then '10'					when upper(u.c48) ='GUANAJUATO' then '11'					when upper(u.c48) ='GUERRERO' then '12'					when upper(u.c48) ='HIDALGO' then '13'					when upper(u.c48) ='JALISCO' then '14'					when upper(u.c48) in ('ESTADO DE MEXICO','MEXICO','EDO MEXICO') then '15'					when upper(u.c48) in ('MICHOACAN','MICHOACAN DE OCAMPO') then '16'					when upper(u.c48) ='MORELOS' then '17'					when upper(u.c48) ='NAYARIT' then '18'					when upper(u.c48) ='NUEVO LEON' then '19'					when upper(u.c48) ='OAXACA' then '20'					when upper(u.c48) ='PUEBLA' then '21'					when upper(u.c48) ='QUERETARO' then '22'					when upper(u.c48) ='QUINTANA ROO' then '23'					when upper(u.c48) ='SAN LUIS POTOSI' then '24'					when upper(u.c48) ='SINALOA' then '25'					when upper(u.c48) ='SONORA' then '26'					when upper(u.c48) ='TABASCO' then '27'					when upper(u.c48) ='TAMAULIPAS' then '28'					when upper(u.c48) ='TLAXCALA' then '29'					when upper(u.c48) in ('VERACRUZ','VERACRUZ DE IGNACIO DE LA LLAVE') then '30'					when upper(u.c48) ='YUCATAN' then '31'					when upper(u.c48) ='ZACATECAS' then '32'				else '22' end as invnot_codigoestado,				case when (length(u.c7))=10 then substring(u.c7,1,3) else '' end as invnot_ladatelefono, 				case when (length(u.c7))=10 then substring(u.c7,4,7) else u.c7 end as invnot_telefono, case when (length(u.c8))=10 then substring(u.c8,1,3) else '' end as invnot_ladatelefonooficina, 				case when (length(u.c8))=10 then substring(u.c8,4,7) else u.c8 end as invnot_telefonooficina, case when (length(u.c9))=10 then substring(u.c9,1,3) else '' end as invnot_ladatelefonocelular, 				case when (length(u.c9))=10 then substring(u.c9,3,7) else u.c9 end as invnot_telefonocelular, case when (length(u.c11))=0 then 'noproporciona@correoelectronico.com' else u.c11 end as invnot_email,				'' invnot_permitecontacto, '' invnot_nombreconductor, '' invnot_apellidopaternoconductor, '' invnot_apellidomaternoconductor, '' invnot_ladatelefonoconductor, '' invnot_telefonoconductor,				'' invnot_ladatelefonooficinaconductor, '' invnot_telefonooficinaconductor, '' invnot_ladatelefonocelularconductor, '' invnot_telefonocelularconductor, '' invnot_emailconductor, 				'' invnot_permitecontactoconductor, '' invnot_rfcvendedor, 'MATRIZ' invnot_tipodistribuidor, uv.c2 invnot_identificadorvendedor,								(select nombre from keplersc.separar_nombre(uv.c3)) as invnot_nombrevendedor,				(select ap_paterno from keplersc.separar_nombre(uv.c3)) as invnot_apellidopaternovendedor,				(select ap_materno from keplersc.separar_nombre(uv.c3)) as invnot_apellidomaternovendedor,				case when upper(v.c17) = 'SUBSI' then 'U' 				else					case when upper(v.c17) = 'CONTA' then 'E' 					else						case when upper(v.c17) = 'BBVA' then 'B' 						else							case when upper(v.c17) = 'LEAS' then 'G' 							else								case when upper(v.c17) = 'BAN' then 'B' 								else									'U'								end							end						end					end				end invnot_tipopago, '' invnot_tasa, '' invnot_plazo, v.contrato_gmac_ally invnot_numeroautorizacionfinanciamiento, v.c26 invnot_importeventatotal, k.c103 invnot_enganche,				(coalesce(v.c26,0) - coalesce(k.c103,0))  invnot_saldopendiente, '5' invnot_tipoiva, v.c24 invnot_isan, 0.16 invnot_porcentajeiva, v.c25 invnot_importeiva, '' invnot_codigoincentivo,				'010' invnot_codigotipoventa, i.c5 invnot_numeroserie, '' invnot_codigofan, '' invnot_tipoflotilla				from keplersc.kdventas v				inner join keplersc.kdm1 k on k.c1 = v.c1 and k.c2 = v.c4 and k.c3 = v.c5 and k.c4 = v.c6 and k.c5 = v.c7 and k.c6 = v.c8				inner join keplersc.kdmm m on m.c1 = v.c4 and m.c2 = v.c5 and m.c3 = v.c6 and m.c4 = v.c7				inner join keplersc.kdud u on u.c2 = v.c11				inner join keplersc.kduv uv on uv.c2 = v.c16				inner join keplersc.kdinf i on i.c2 = v.c2";			if (tipo &=""){				cmd = cmd & " where v.c1 = '" & suc_bus & "' and v.c4 = '"& genero &"' and v.c5 = '" & naturaleza & "' and v.c6 = " & grupo & " and v.c8 ='" & folio & "'";			} else{							cmd = cmd & " where v.c1 = '" & suc_bus & "' and v.c4 = '"& genero &"' and v.c5 = '" & naturaleza & "' and v.c6 = " & grupo & " and v.c7 = " & tipo & " and v.c8 ='" & folio & "'";			}			frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdBuscarsofiainvoicenot");			cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ifz_sofiainvoicenotification.Buscar()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboRessofiainvoicenot");								ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}									if(nXml(cuboResultados) == 0){				frn.setPos("invcan_numeronotacredito");				frn.message("El folio no existe","Error","Aceptar");				return;			}								rstXml(xmlProd);			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboResultados,"r0");			LimpiarInf();			frn.setX(xmlProd);			tipo = getXmlAtt(cuboResultados,"r0","tipo");			//Llenar combos			frn.set("invnot_tipocliente",descr_combo("invnot_tipocliente",1,getXml(xmlProd, "invnot_tipocliente")));			frn.set("invnot_sexo",descr_combo("invnot_sexo",1,getXml(xmlProd, "invnot_sexo")));			frn.set("invnot_tipodistribuidor",descr_combo("invnot_tipodistribuidor",1,getXml(xmlProd, "invnot_tipodistribuidor")));				frn.set("invnot_tipopago",descr_combo("invnot_tipopago",1,getXml(xmlProd, "invnot_tipopago")));			frn.set("invnot_tipoiva",descr_combo("invnot_tipoiva",1,getXml(xmlProd, "invnot_tipoiva")));			frn.set("invnot_codigotipoventa",descr_combo("invnot_codigotipoventa",1,getXml(xmlProd, "invnot_codigotipoventa")));			frn.set("invnot_tipoflotilla",descr_combo("invnot_tipoflotilla",1,getXml(xmlProd, "invnot_tipoflotilla")));			//Obtiene cadena timbre			setXml(xmlTimbre,"sucursal",frn.get("k_sucn",-1,1));			setXml(xmlTimbre,"genero",genero);			setXml(xmlTimbre,"naturaleza",naturaleza);			setXml(xmlTimbre,"grupo",grupo);			setXml(xmlTimbre,"tipo",tipo);			setXml(xmlTimbre,"folio",frn.get("invnot_identificadordocumento"));			setXml(xmlTimbre,"dato_consulta","selloCFD");			cmdQuery="SELECT * FROM keplersc.cfd_datos_timbrado('<document>" & getXmlStr(xmlTimbre,"EOF:13_10") & "</document>')";			frn.lib("libGeneral.kpl","FileSave",cmdQuery, fileSavePath & "\CmdResCadenatimbre");			rstXml(cuboResultados);								cuboResultados= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"ifz_sofiainvoicenotification.Buscar");							frn.lib("libGeneral.kpl","FileSave",cuboResultados, fileSavePath & "\XmlResCadenatimbre");								resultado = getXml(cuboResultados,"resultado");			mensaje = getXml(cuboResultados,"mensaje");						if(resultado &= "1") {				frn.set("invnot_cadenaoriginaltimbre",mensaje);			} else {				frn.message(mensaje, "Error", "Aceptar");				return;			}			//Obtiene codigo de estado		invnot_codigoestado			estado = getXmlAtt(cuboResultados,"r0","estado");			}		fun LimpiarInf(){			frn.set("invnot_fechafactura", "");			frn.set("invnot_cadenaoriginaltimbre", "");			frn.set("invnot_idsofia", "");			frn.set("invnot_rfc", "");			frn.set("invnot_idcliente", "");			frn.set("invnot_numeroidentificacion", "");			frn.set("invnot_tipocliente", "");			frn.set("invnot_codigoactividadeconomica", "");			frn.set("invnot_curp", "");			frn.set("invnot_nombre", "");			frn.set("invnot_apellidopaterno", "");			frn.set("invnot_apellidomaterno", "");			frn.set("invnot_nombrecompleto", "");			frn.set("invnot_titulo", "");			frn.set("invnot_sexo", "");			frn.set("invnot_fechanacimiento", "");			frn.set("invnot_calle", "");			frn.set("invnot_numeroexterior", "");			frn.set("invnot_numerointerior", "");			frn.set("invnot_entrecalles", "");			frn.set("invnot_codigoasentamiento", "");			frn.set("invnot_colonia", "");			frn.set("invnot_codigomunicipio", "");			frn.set("invnot_municipio", "");			frn.set("invnot_codigopostal", "");			frn.set("invnot_codigoestado", "");			frn.set("invnot_ladatelefono", "");			frn.set("invnot_telefono", "");			frn.set("invnot_ladatelefonooficina", "");			frn.set("invnot_telefonooficina", "");			frn.set("invnot_ladatelefonocelular", "");			frn.set("invnot_telefonocelular", "");			frn.set("invnot_email", "");			frn.set("invnot_permitecontacto", "");			frn.set("invnot_nombreconductor", "");			frn.set("invnot_apellidopaternoconductor", "");			frn.set("invnot_apellidomaternoconductor", "");			frn.set("invnot_ladatelefonoconductor", "");			frn.set("invnot_telefonoconductor", "");			frn.set("invnot_ladatelefonooficinaconductor", "");			frn.set("invnot_telefonooficinaconductor", "");			frn.set("invnot_ladatelefonocelularconductor", "");			frn.set("invnot_telefonocelularconductor", "");			frn.set("invnot_emailconductor", "");			frn.set("invnot_permitecontactoconductor", "");			frn.set("invnot_rfcvendedor", "");			frn.set("invnot_tipodistribuidor", "");			frn.set("invnot_identificadorvendedor", "");			frn.set("invnot_nombrevendedor", "");			frn.set("invnot_apellidopaternovendedor", "");			frn.set("invnot_apellidomaternovendedor", "");			frn.set("invnot_tipopago", "");			frn.set("invnot_tasa", "");			frn.set("invnot_plazo", "");			frn.set("invnot_numeroautorizacionfinanciamiento", "");			frn.set("invnot_importeventatotal", "");			frn.set("invnot_enganche", "");			frn.set("invnot_saldopendiente", "");			frn.set("invnot_tipoiva", "");			frn.set("invnot_isan", "");			frn.set("invnot_porcentajeiva", "");			frn.set("invnot_importeiva", "");			frn.set("invnot_codigoincentivo", "");			frn.set("invnot_codigotipoventa", "");			frn.set("invnot_numeroserie", "");			frn.set("invnot_codigofan", "");			frn.set("invnot_tipoflotilla", "");		}			fun BorraDatos(){			frn.set("invnot_identificadordocumento", "");			frn.set("invnot_fechafactura", "");			frn.set("invnot_cadenaoriginaltimbre", "");			frn.set("invnot_idsofia", "");			frn.set("invnot_rfc", "");			frn.set("invnot_idcliente", "");			frn.set("invnot_numeroidentificacion", "");			frn.set("invnot_tipocliente", "");			frn.set("invnot_codigoactividadeconomica", "");			frn.set("invnot_curp", "");			frn.set("invnot_nombre", "");			frn.set("invnot_apellidopaterno", "");			frn.set("invnot_apellidomaterno", "");			frn.set("invnot_nombrecompleto", "");			frn.set("invnot_titulo", "");			frn.set("invnot_sexo", "");			frn.set("invnot_fechanacimiento", "");			frn.set("invnot_calle", "");			frn.set("invnot_numeroexterior", "");			frn.set("invnot_numerointerior", "");			frn.set("invnot_entrecalles", "");			frn.set("invnot_codigoasentamiento", "");			frn.set("invnot_colonia", "");			frn.set("invnot_codigomunicipio", "");			frn.set("invnot_municipio", "");			frn.set("invnot_codigopostal", "");			frn.set("invnot_codigoestado", "");			frn.set("invnot_ladatelefono", "");			frn.set("invnot_telefono", "");			frn.set("invnot_ladatelefonooficina", "");			frn.set("invnot_telefonooficina", "");			frn.set("invnot_ladatelefonocelular", "");			frn.set("invnot_telefonocelular", "");			frn.set("invnot_email", "");			frn.set("invnot_permitecontacto", "");			frn.set("invnot_nombreconductor", "");			frn.set("invnot_apellidopaternoconductor", "");			frn.set("invnot_apellidomaternoconductor", "");			frn.set("invnot_ladatelefonoconductor", "");			frn.set("invnot_telefonoconductor", "");			frn.set("invnot_ladatelefonooficinaconductor", "");			frn.set("invnot_telefonooficinaconductor", "");			frn.set("invnot_ladatelefonocelularconductor", "");			frn.set("invnot_telefonocelularconductor", "");			frn.set("invnot_emailconductor", "");			frn.set("invnot_permitecontactoconductor", "");			frn.set("invnot_rfcvendedor", "");			frn.set("invnot_tipodistribuidor", "");			frn.set("invnot_identificadorvendedor", "");			frn.set("invnot_nombrevendedor", "");			frn.set("invnot_apellidopaternovendedor", "");			frn.set("invnot_apellidomaternovendedor", "");			frn.set("invnot_tipopago", "");			frn.set("invnot_tasa", "");			frn.set("invnot_plazo", "");			frn.set("invnot_numeroautorizacionfinanciamiento", "");			frn.set("invnot_importeventatotal", "");			frn.set("invnot_enganche", "");			frn.set("invnot_saldopendiente", "");			frn.set("invnot_tipoiva", "");			frn.set("invnot_isan", "");			frn.set("invnot_porcentajeiva", "");			frn.set("invnot_importeiva", "");			frn.set("invnot_codigoincentivo", "");			frn.set("invnot_codigotipoventa", "");			frn.set("invnot_numeroserie", "");			frn.set("invnot_codigofan", "");			frn.set("invnot_tipoflotilla", "");		}				fun Ejecuta(){			var xmlPantalla,resultado,mensaje,folio,continua;			var strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			fecha = sys.date();			hora= sys.time();			strFecha = fnDate("year",fecha) & "-";			strTmp = fnDate("month",fecha);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "-";			strTmp = fnDate("day",fecha);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp;			resVal = 1;			ValidarDatos();			if(resVal == 0){				return;			}			continua = frn.message("Desea continuar ?","Atencion",2);			if (continua == 0){				return;			}						xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			setXml(xmlPantalla,"invnot_identificadordocumento",mid(frn.get("invnot_identificadordocumento"),3,7));			setXml(xmlPantalla,"sucursal",frn.get("k_sucn",-1,1));			setXml(xmlPantalla,"genero",genero);			setXml(xmlPantalla,"naturaleza",naturaleza);			setXml(xmlPantalla,"grupo",grupo);			setXml(xmlPantalla,"tipo",tipo);			setXml(xmlPantalla,"folio",frn.get("invnot_identificadordocumento"));			setXml(xmlPantalla,"serie",frn.get("invnot_numeroserie"));			setXml(xmlPantalla,"fecha",fecha);			setXml(xmlPantalla,"movto_sofia","Invoice Notification");			setXml(xmlPantalla,"tip_ope",tipoOper);			setXml(xmlPantalla,"movimiento","usuario",usuario);			setXml(xmlPantalla,"movimiento","fecha",strFecha);			setXml(xmlPantalla,"movimiento","hora",			frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 			frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaifz_sofiainvoicenotification");			cmdQuery="SELECT * FROM keplersc.ifz_sofiainvoicenotification('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";			rstXml(cuboQuery);								cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"ifz_sofiainvoicenotification.Ejecuta");							frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadifz_sofiainvoicenotification");								resultado = getXml(cuboQuery,"resultado");			mensaje = getXml(cuboQuery,"mensaje");								ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(resultado &= "1") {				strMsg = "Se guardo correctamente la informacion para SOFIA";				frn.message(strMsg, "Mensaje", "Aceptar");				 frn.setAtt("bot_seleccionar", "visible", "N" );			} else {				frn.message(mensaje, "Error", "Aceptar");				return;			}			frn.exit();  		}        fun validaDatoVacio(dato,msg){			if (frn.get(dato) &= ""){				resVal= 0;				frn.setPos(dato);				frn.message("Debe especificar " & msg & "|El dato no puede estar vacio","Error","Aceptar");				return;			}		}		fun ValidarDatos(){			validaDatoVacio("invnot_dealerbac","Codigo BAC del distribuidor");			validaDatoVacio("invnot_secondarydealernumberid","Codigo secundario del distribuidor");			validaDatoVacio("invnot_dealerid","Identificador del distribuidor");			validaDatoVacio("invnot_identificadordocumento","Identificador del documento");			validaDatoVacio("invnot_fechafactura","Fecha de factura");			validaDatoVacio("invnot_cadenaoriginaltimbre","Cadena original del timbre");			validaDatoVacio("invnot_rfc","RFC");			validaDatoVacio("invnot_idcliente","Clave del cliente");			validaDatoVacio("invnot_tipocliente","Tipo de cliente");			validaDatoVacio("invnot_nombre","Nombre del cliente");			validaDatoVacio("invnot_apellidopaterno","Apellido paterno del cliente");			validaDatoVacio("invnot_apellidomaterno","Apellido materno del cliente");			validaDatoVacio("invnot_nombrecompleto","Nombre completo del cliente");			validaDatoVacio("invnot_titulo","Titulo");			validaDatoVacio("invnot_sexo","Sexo");			validaDatoVacio("invnot_calle","Calle");			validaDatoVacio("invnot_numeroexterior","Numero exterior");			validaDatoVacio("invnot_entrecalles","Entre Calles");			validaDatoVacio("invnot_colonia","Colonia");			validaDatoVacio("invnot_municipio","Municipio");			validaDatoVacio("invnot_email","Correo electronico");			validaDatoVacio("invnot_tipodistribuidor","Tipo distribuidor");			validaDatoVacio("invnot_nombrevendedor","Nombre del vendedor");			validaDatoVacio("invnot_apellidopaternovendedor","Apellido paterno del vendedor");			validaDatoVacio("invnot_apellidomaternovendedor","Apellido materno del vendedor");			validaDatoVacio("invnot_tipopago","Tipo de pago");			validaDatoVacio("invnot_numeroautorizacionfinanciamiento","No. aut.  financiamiento");			validaDatoVacio("invnot_importeventatotal","Importe total venta");			validaDatoVacio("invnot_saldopendiente","Saldo pendiente");			validaDatoVacio("invnot_tipoiva","Tipo de IVA");			validaDatoVacio("invnot_isan","ISAN");			validaDatoVacio("invnot_porcentajeiva","Porcentaje IVA");			validaDatoVacio("invnot_importeiva","Importe IVA");			validaDatoVacio("invnot_codigotipoventa","Tipo de venta");			validaDatoVacio("invnot_numeroserie","Numero de serie");			if (strlen(frn.get("invnot_numeroserie")) != 17){				resVal= 0;				frn.setPos("invnot_numeroserie");				frn.message("La serie debe ser de 17 digitos","Error","Aceptar");				return;			}			if (tipo &= "1" && frn.get("invnot_isan") <=0){				resVal= 0;				frn.setPos("invnot_isan");				frn.message("El importe del ISAN no puede ser 0","Error","Aceptar");				return;			}        }//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------		fun descr_combo(combo,posicion,valor){			var descr, valor_actual;			var len_combo = frn.N(combo);			for (var cont=0; cont<len_combo ; cont++){				valor_actual= frn.get(combo,cont,posicion);				if (valor_actual &=  valor){					descr = frn.get(combo,cont,0);					return descr;				}			}		}					fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO						1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana						2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)						3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			if(iModo==0)				page=pag;			else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.				if( frn.getAtt(par0,"modify",par1) &= "N" ) 					b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) 					b_valido=0;				if( frn.getAtt(par0,"visible",par1) &= "N" ) 					b_valido=0;			}			if(iModo==3)				frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>