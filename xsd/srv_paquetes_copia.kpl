<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/><tab/><txt fnt=",22" clr="0,0,0">Copia de Paquetes</txt>		<br/><tab/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grupo_crud" dim="60,22,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" available="Y" tit="Detalle de la Cuenta"><tab/>			<br/><tab/><txt>Marca Origen:</txt><tab/>			<inp id="k_marca_origen" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" OnF9="SelMarcaOrigen()" OnChange="ValidarMarcaOrigen()"/>			<br/><tab/><txt>Modelo Origen:</txt><tab/>			<inp id="k_modelo_origen" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital"  OnF9="SelModeloOrigen()" OnChange="ValidarModeloOrigen()" nc="10"/>			<br/><tab/><txt>Paquete Origen</txt><tab/>			<inp id="k_paquete_origen" dim="15,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="10" available="Y" modify="Y" fmt="5" max="9999" just="L"  OnF9="SelPaqueteOrigen()" OnChange="ValidarPaqueteOrigen()"/>			<br/><br/><tab/><txt>Modelo Inicial:</txt><tab/>			<inp id="k_modelo_inicial" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" fmt="5" min="0" max="9999" modify="Y" available="Y" nc="10" just="L" OnF9="SelModeloInicial()" OnChange="ValidarModeloInicial()"/>			<br/><tab/><txt>Modelo Final:</txt><tab/>			<inp id="k_modelo_final" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" fmt="5" min="0" max="9999" modify="Y" available="Y" nc="10" just="L" OnF9="SelModeloFinal()" OnChange="ValidarModeloFinal()"/>			<br/><tab/><br/><tab/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="0" visible="Y" available="Y"/><br/>		</grp>		<br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP,sys;			var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError;			var strVal,totReg;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				kdb.connect();				Inicializa();			}						fun SelMarcaOrigen(){				cmdQuery="select c1 as clave, c2 as descripcion from keplersc.kdmarcas order by c1";				frn.dialog("genlistafiltrosel","Marcas",cmdQuery,"clave","k_marca_origen","0","","S");							}						fun ValidarMarcaOrigen(){				frn.set("k_modelo_origen","");				frn.set("k_paquete_origen","");				frn.set("k_modelo_inicial","");				frn.set("k_modelo_final","");				cmdQuery="select count(*) as totreg from keplersc.kdmarcas where c1='" & frn.get("k_marca_origen") & "'";				rstXml(cuboResultados);				cuboResultados=frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_paquetes_copia.ValidarMarcaOrigen()");//frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\xmlcubomarcas");												ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				totReg=getXmlAtt(cuboResultados,"r0","totreg");				if(totReg==0){					frn.set("k_marca_origen","");					frn.setPos("k_marca_origen");					frn.message("La marca no existe.","Error","Aceptar");				}			}			fun SelModeloOrigen(){				cmdQuery="select c2 as clave, c3 as descripcion from keplersc.kdmodelos where c1='" & frn.get("k_marca_origen") & "' order by c1";				frn.dialog("genlistafiltrosel","Modelos",cmdQuery,"clave","k_modelo_origen","0","","S");							}						fun ValidarModeloOrigen(){				frn.set("k_paquete_origen","");				frn.set("k_modelo_inicial","");				frn.set("k_modelo_final","");				cmdQuery="select count(*) as totreg from keplersc.kdmodelos where c1='" & frn.get("k_marca_origen") & "' and c2='" & frn.get("k_modelo_origen") & "' " ;				rstXml(cuboResultados);				cuboResultados=frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_paquetes_copia.ValidarModeloOrigen()");//frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\xmlcubomarcas");												ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				totReg=getXmlAtt(cuboResultados,"r0","totreg");				if(totReg==0){					frn.set("k_modelo_origen","");					frn.setPos("k_modelo_origen");					frn.message("El modelo no existe.","Error","Aceptar");				}			}			fun SelPaqueteOrigen(){				cmdQuery="select c1 as clave, c2 as descripcion from keplersc.kdcatpaq order by c1";				frn.dialog("genlistafiltrosel","Paquetes",cmdQuery,"clave","k_paquete_origen","0","","S");							}						fun ValidarPaqueteOrigen(){				frn.set("k_modelo_inicial","");				frn.set("k_modelo_final","");				cmdQuery="select count(*) as totreg from keplersc.kdcatpaq where c1='" & frn.get("k_paquete_origen") & "' " ;				rstXml(cuboResultados);				cuboResultados=frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_paquetes_copia.ValidarPaqueteOrigen()");//frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\xmlcubomarcas");												ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				totReg=getXmlAtt(cuboResultados,"r0","totreg");				if(totReg==0){					frn.set("k_paquete_origen","");					frn.setPos("k_paquete_origen");					frn.message("El paquete no existe.","Error","Aceptar");				}			}						fun SelModeloInicial(){				cmdQuery="select c2 as clave, c3 as descripcion from keplersc.kdmodelos where c1='" & frn.get("k_marca_origen") & "' order by c1";				frn.dialog("genlistafiltrosel","Modelos",cmdQuery,"clave","k_modelo_inicial","0","","S");							}						fun ValidarModeloInicial(){				frn.set("k_modelo_final","");				cmdQuery="select count(*) as totreg from keplersc.kdmodelos where c1='" & frn.get("k_marca_origen") & "' and c2='" & frn.get("k_modelo_inicial") & "' " ;				rstXml(cuboResultados);				cuboResultados=frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_paquetes_copia.ValidarModeloInicial()");//frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\xmlcubomarcas");												ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				totReg=getXmlAtt(cuboResultados,"r0","totreg");				if(totReg==0){					frn.set("k_modelo_inicial","");					frn.setPos("k_modelo_inicial");					frn.message("El modelo no existe.","Error","Aceptar");				}			}						fun SelModeloFinal(){				cmdQuery="select c2 as clave, c3 as descripcion from keplersc.kdmodelos where c1='" & frn.get("k_marca_origen") & "' order by c1";				frn.dialog("genlistafiltrosel","Modelos",cmdQuery,"clave","k_modelo_final","0","","S");							}						fun ValidarModeloFinal(){				cmdQuery="select count(*) as totreg from keplersc.kdmodelos where c1='" & frn.get("k_marca_origen") & "' and c2='" & frn.get("k_modelo_final") & "' " ;				rstXml(cuboResultados);				cuboResultados=frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_paquetes_copia.ValidarModeloFinal()");//frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\xmlcubomarcas");												ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				totReg=getXmlAtt(cuboResultados,"r0","totreg");				if(totReg==0){					frn.set("k_modelo_final","");					frn.setPos("k_modelo_final");					frn.message("El modelo no existe.","Error","Aceptar");				}			}									fun Inicializa(){					ctlrs_opcion();			}									fun ctlrs_off(){				frn.setAtt("btn_aceptar","visible","N");			}							fun ctlrs_opcion(){				frn.setAtt("btn_aceptar","visible","Y");			}							fun Execute() {				var strValor;				//Validación de datos					strValor=frn.get("k_marca_origen");					if(strValor &= ""){					frn.setPos("k_marca_origen");					frn.message("No ha seleccionado la marca original","Error","Aceptar");					return;				}										strValor=frn.get("k_modelo_origen","");				if(strValor &= ""){					frn.setPos("k_modelo_origen");					frn.message("No ha seleccionado el modelo origen","Error","Aceptar");					return;				}				strValor=frn.get("k_paquete_origen","");				if(strValor &= ""){					frn.setPos("k_paquete_origen");					frn.message("No ha seleccionado el paquete origen","Error","Aceptar");					return;				}				strValor=frn.get("k_modelo_inicial","");				if(strValor &= ""){					frn.setPos("k_modelo_inicial");					frn.message("No ha seleccionado el modelo inicial","Error","Aceptar");					return;				}				strValor=frn.get("k_modelo_final","");				if(strValor &= ""){					frn.setPos("k_modelo_final");					frn.message("No ha seleccionado el modelo final","Error","Aceptar");					return;				}				var resultado_confirmacion = frn.message("¿Confirma la operación?","Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}								xmlRequest = getXml(frn.dataPag());								cmdQuery="SELECT * FROM keplersc.ser_paquetes_copia('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";						cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_paquetes_crud.Execute()");	//frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}											frn.message("Operación realizada correctamente","Mensaje","Aceptar");			}				}	</script></pag>