<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Control de Citas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="232,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="110,64,10,10" brdr="0,5" tit="Control de Citas" fnt="Arial,16">				<sp/><txt id="txt_fecha_cita">Fecha:</txt>		<edt id="fecha_cita" dim="9,1"  fmt="DD/MM/CCYY" OnChange="borrar_datos()" page="_ks_fecha,fecha_cita" OnF9="Dialog(3,_ks_fecha,fecha_cita)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2" available="Y"/>		<tab n="1"/>		<img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="buscar()" available="Y" clrBrdr="0,0,0"/>		<tab/>		<txt clr="0,58,112" hk="S">Sucursal</txt><sp/>		<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="68,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y" modify="Y"/><tab/><br/><txt>  Detalle:  </txt>		<inp id="inp_paquete" dim="90,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>								<br/><br/>		<sp/>		<tbl id="tabla" bclr="236,240,243" clr="64,64,64" OnMouseD="ValidarDisp()" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="108,32" modify="N" nren="fijo">		<col id="col_fecha" name="Fecha"/>		<col id="col_clave_operador" name="Clave" visible="S"/>		<col id="col_nombre_ope" name="Operador"/>		<col id="col_tipo_ope" name="Tipo"/>		<col id="h_07_00" name="07:00"/>		<col id="h_07_15" name="07:15"/>		<col id="h_07_30" name="07:30"/>		<col id="h_07_45" name="07:45"/>						<col id="h_08_00" name="08:00"/>		<col id="h_08_15" name="08:15"/>		<col id="h_08_30" name="08:30"/>		<col id="h_08_45" name="08:45"/>						<col id="h_09_00" name="09:00"/>		<col id="h_09_15" name="09:15"/>		<col id="h_09_30" name="09:30"/>		<col id="h_09_45" name="09:45"/>						<col id="h_10_00" name="10:00"/>		<col id="h_10_15" name="10:15"/>		<col id="h_10_30" name="10:30"/>		<col id="h_10_45" name="10:45"/>								<col id="h_11_00" name="11:00"/>		<col id="h_11_15" name="11:15"/>		<col id="h_11_30" name="11:30"/>		<col id="h_11_45" name="11:45"/>						<col id="h_12_00" name="12:00"/>		<col id="h_12_15" name="12:15"/>		<col id="h_12_30" name="12:30"/>		<col id="h_12_45" name="12:45"/>						<col id="h_13_00" name="13:00"/>		<col id="h_13_15" name="13:15"/>		<col id="h_13_30" name="13:30"/>		<col id="h_13_45" name="13:45"/>						<col id="h_14_00" name="14:00"/>		<col id="h_14_15" name="14:15"/>		<col id="h_14_30" name="14:30"/>		<col id="h_14_45" name="14:45"/>						<col id="h_15_00" name="15:00"/>		<col id="h_15_15" name="15:15"/>		<col id="h_15_30" name="15:30"/>		<col id="h_15_45" name="15:45"/>						<col id="h_16_00" name="16:00"/>		<col id="h_16_15" name="16:15"/>		<col id="h_16_30" name="16:30"/>		<col id="h_16_45" name="16:45"/>						<col id="h_17_00" name="17:00"/>		<col id="h_17_15" name="17:15"/>		<col id="h_17_30" name="17:30"/>		<col id="h_17_45" name="17:45"/>						<col id="h_18_00" name="18:00"/>		<col id="h_18_15" name="18:15"/>		<col id="h_18_30" name="18:30"/>		<col id="h_18_45" name="18:45"/>						<col id="h_19_00" name="19:00"/>		<col id="h_19_15" name="19:15"/>		<col id="h_19_30" name="19:30"/>		<col id="h_19_45" name="19:45"/>				<col id="h_20_00" name="20:00"/>		<col id="h_20_15" name="20:15"/>		<col id="h_20_30" name="20:30"/>		<col id="h_20_45" name="20:45"/>				</tbl> 		<tab/><br/>		<sp n="2"/>		<bot id="bot_aceptar" OnEnter="AsignarValores()" dim="7" brdr="5" text="Aceptar" visible="N"/><tab n="6"/>		<br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var usuario , suc_usuario , rol_usuario,asterisco,param_1;			var param_marca, param_modelo, param_paq, horas_paq,bloques_paq,curCol,curRen;			var frn,frP,kdb,sys,suc,fecha,hora , tipo_ope , hrs_cita , mins_cita,libre, algo_asignado,hora_recep; 			var registro, hrs_prog, cita_seleccionada, se_encontro_comida, horario_inicio, horario_fin ;//OnEnter="Exit" OnMouseD="Exit"			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								usuario = frn.config("user","name");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				rol_usuario = frn.config("user","role");				asterisco = "*";								param_1 = frn.param(0);				fecha= frn.param(0);				param_marca = frn.param(1);				param_modelo = frn.param(2);				param_paq = frn.param(3);				hora_recep = frn.param(4);								curCol=0;				curRen=0;								fecha=frP.get("fecha_cita"); 				if (fecha &! ""){					frn.set("fecha_cita", fecha);				}else{					frn.set("fecha_cita", sys.date() );				}				Inicializa();								buscar();								frn.setAtt("fecha_cita", "available","Y");				frn.setAtt("k_sucN", "available","Y");				frn.setAtt("bot_aceptar", "visible","N");									if (param_paq &! ""){//frn.message(param_paq ,"Mensaje","Aceptar");					frn.set("fecha_cita",fecha);					frn.setAtt("fecha_cita", "available", "N");					frn.setAtt("k_sucN", "available", "N");					frn.setAtt("bot_aceptar", "visible","Y");										ObtenerPaquete();				}							}			fun AsignarValores(){			//Pasa los valores seleccionados al formulario Padre				var clave_operador,nombre_operador,inicio,fin,columnaId,strVal;								clave_operador=frn.get("tabla",curRen,"col_clave_operador");				nombre_operador=frn.get("tabla",curRen,"col_nombre_ope");				if(clave_operador &="" || nombre_operador &= ""){					frn.message("No ha seleccionado un operador valido","Error","Aceptar");					return;				}								columnaId=ObtenerIdColumna(curCol);				inicio=mid(columnaId,2,2) & ":" &	mid(columnaId,5,2);								columnaId=ObtenerIdColumna(curCol+bloques_paq-1);				fin=mid(columnaId,2,2) & ":" &	mid(columnaId,5,2);				if(inicio &= "" || fin &= ""){					frn.message("No ha seleccionado un horario valido","Error","Aceptar");					return;				}				if(horas_paq &= ""){					frn.message("El paquete no es valido","Error","Aceptar");					return;				}												strVal=horas_paq & "|" & inicio & "|" & fin & "|" & clave_operador & "|" & nombre_operador;//frn.message(strVal,"Mensaje","Aceptar");								frP.script("ActualizarPunto(" & strVal & ")");				frn.exit();			}			fun ValidarDisp(){				var baseCol,baseRen,maxCol,dispo,columnaId,minCol,strValor;				maxCol=49; //Max 59, menos 2 rs				//Obtener la columna minima horas				minCol=4;				for (var cont=4; cont < maxCol; cont ++){					columnaId=ObtenerIdColumna(cont);					strValor=mid(columnaId,2,2) & ":" &	mid(columnaId,5,2);					if(hora_recep &= strValor){						minCol = cont;						break;					}				}				minCol = minCol + 1;												//Eliminar seleccion anterior				baseCol=curCol;				baseRen=curRen;//frn.message(curCol & "-" & curRen & "-" & maxCol & "-" & dispo & " IdCol" & columnaId);									if (baseCol + bloques_paq <= maxCol){					maxCol=baseCol+bloques_paq;				}//frn.message(baseCol & "-" & baseRen & "-" & maxCol & "-" & dispo & " IdCol" & columnaId);								if (baseCol > 0){					for (var cont=baseCol; cont <= maxCol; cont ++){						columnaId=ObtenerIdColumna(cont);											if(frn.get("tabla",baseRen, columnaId) &= "**"){							frn.setX("","tabla",baseRen, columnaId);						}					}									}				baseCol = frn.getI("tabla");				baseRen = frn.getJ("tabla");								curCol=frn.getI("tabla");				curRen=frn.getJ("tabla");								if(baseCol < minCol){					return;				}												if (baseCol + bloques_paq > maxCol){					return;				}else{					maxCol=baseCol+bloques_paq-1;				}								dispo="S";				for (var cont=baseCol; cont <= maxCol; cont ++){					columnaId=ObtenerIdColumna(cont);					if(frn.get("tabla",baseRen, columnaId) &! ""){						dispo="N";					}				}//frn.message(baseCol & "-" & baseRen & "-" & maxCol & "-" & dispo & "-" & minCol);								if (dispo&="S"){									for (var cont=baseCol; cont <= maxCol; cont ++){						columnaId=ObtenerIdColumna(cont);											frn.setX("**","tabla",baseRen, columnaId);					}				}		//frn.message(curCol & "-" & curRen & "-" & maxCol & "-" & dispo & " IdCol" & columnaId);				}						fun	ObtenerPaquete{				var xmlRequest,cmd,ok,cuboResultados, mensajeError,cubo;				var	desc, horas_tot, horas_paq, mins_paq;								if (param_paq &= ""){					return;				}				cmd = "select c5 as desc, c9 as horas from keplersc.kdspaq where c1='" & param_marca 					& "' and c2='" & param_modelo & "' and c4='" & param_paq & "' ";				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmd_paquete");												cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"control_de_citas.ObtenerPaquete()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubo_paquete");													ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								desc = getXmlAtt(cubo,"r0" ,"desc");				horas_tot= getXmlAtt(cubo,"r0" ,"horas");				horas_paq= getXmlAtt(cubo,"r0" ,"horas");				mins_paq=horas_tot*60; 				bloques_paq=mins_paq/15;				bloques_paq = math("ceil",bloques_paq);				frn.set("inp_paquete",param_paq & "-" & desc & "; Hrs:" & horas_tot & " (" & bloques_paq & ") bloques; recepcion: " & hora_recep);			}									fun Inicializa() {				var xmlRequest,cmd,ok,cuboResultados, mensajeError,cubo ;				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));								frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));					}						fun borrar_datos(){							frn.rst("tabla");			}									fun buscar(){										var xmlRequest,cmd,ok,cuboResultados, mensajeError,cubo ;				suc = frn.get("k_sucN", -1, 1);				fecha = frn.get("fecha_cita");							setXml(xmlRequest,"document","k_sucN","r1", suc );				setXml(xmlRequest,"document","fecha",fecha );				//				frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");				//				cmd="select * from keplersc.tmkt_control_de_citas('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";//				cubo= frn.lib("libGeneral.kpl","EjecutarSql",cmd,"control_de_citas.Inicializa()");								//				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubo");								//				ok=getXml(cubo,"resultado");//				if(ok &= "0" ){//					mensajeError = getXml(cubo,"mensaje");//					frn.message(mensajeError,"Error","Aceptar");//					return;//				}								cmd= "select to_char(col_fecha,'DD/MM/YYYY') as col_fecha, col_clave_operador, col_nombre_ope, col_tipo_ope " &				", h_07_00, h_07_15, h_07_30, h_07_45, h_08_00, h_08_15, h_08_30, h_08_45" &				", h_09_00, h_09_15, h_09_30, h_09_45, h_10_00, h_10_15, h_10_30, h_10_45" &				", h_11_00, h_11_15, h_11_30, h_11_45, h_12_00, h_12_15, h_12_30, h_12_45" &				", h_13_00, h_13_15, h_13_30, h_13_45, h_14_00, h_14_15, h_14_30, h_14_45" &				", h_15_00, h_15_15, h_15_30, h_15_45, h_16_00, h_16_15, h_16_30, h_16_45" &				", h_17_00, h_17_15, h_17_30, h_17_45, h_18_00, h_18_15, h_18_30, h_18_45" &				", h_19_00, h_19_15, h_19_30, h_19_45, h_20_00, h_20_15, h_20_30, h_20_45" &				" from keplersc.tmkt_panorama_de_taller('" & getXmlStr(xmlRequest,"EOF:13_10") & "')" & 				" where col_fecha='" & fecha & "' order by col_nombre_ope";				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdPanoramaTaller");								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"panorama_de_taller.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("tabla",cuboResultados ); 			}			fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}						fun ObtenerIdColumna(columna){				var valor;				if (columna == 4){					valor="h_07_00";				}else if (columna == 5){					valor="h_07_15";				}else if (columna == 6){					valor="h_07_30";				}else if (columna == 7){					valor="h_07_45";				}else if (columna == 8){					valor="h_08_00";				}else if (columna == 9){					valor="h_08_15";				}else if (columna == 10){					valor="h_08_30";				}else if (columna == 11){					valor="h_08_45";				}else if (columna == 12){					valor="h_09_00";				}else if (columna == 13){					valor="h_09_15";				}else if (columna == 14){					valor="h_09_30";				}else if (columna == 15){					valor="h_09_45";				}else if (columna == 16){					valor="h_10_00";				}else if (columna == 17){					valor="h_10_15";				}else if (columna == 18){					valor="h_10_30";				}else if (columna == 19){					valor="h_10_45";				}else if (columna == 20){					valor="h_11_00";				}else if (columna == 21){					valor="h_11_15";				}else if (columna == 22){					valor="h_11_30";				}else if (columna == 23){					valor="h_11_45";								}else if (columna == 24){					valor="h_12_00";				}else if (columna == 25){					valor="h_12_15";				}else if (columna == 26){					valor="h_12_30";				}else if (columna == 27){					valor="h_12_45";				}else if (columna == 28){					valor="h_13_00";				}else if (columna == 29){					valor="h_13_15";				}else if (columna == 30){					valor="h_13_30";				}else if (columna == 31){					valor="h_13_45";				}else if (columna == 32){					valor="h_14_00";				}else if (columna == 33){					valor="h_14_15";				}else if (columna == 34){					valor="h_14_30";				}else if (columna == 35){					valor="h_14_45";				}else if (columna == 36){					valor="h_15_00";				}else if (columna == 37){					valor="h_15_15";				}else if (columna == 38){					valor="h_15_30";								}else if (columna == 39){					valor="h_15_45";				}else if (columna == 40){					valor="h_16_00";				}else if (columna == 41){					valor="h_16_15";				}else if (columna == 42){					valor="h_16_30";				}else if (columna == 43){					valor="h_16_45";				}else if (columna == 44){					valor="h_17_00";				}else if (columna == 45){					valor="h_17_15";				}else if (columna == 46){					valor="h_17_30";				}else if (columna == 47){					valor="h_17_45";				}else if (columna == 48){					valor="h_18_00";				}else if (columna == 49){					valor="h_18_15";				}else if (columna == 50){					valor="h_18_30";				}else if (columna == 51){					valor="h_18_45";				}else if (columna == 52){					valor="h_19_00";				}else if (columna == 53){					valor="h_19_15";				}else if (columna == 54){					valor="h_19_30";								}else if (columna == 55){					valor="h_19_45";				}else if (columna == 56){					valor="h_20_00";				}else if (columna == 57){					valor="h_20_15";				}else if (columna == 58){					valor="h_20_30";								}else if (columna == 59){					valor="h_20_45";				}				return valor;			}							fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>