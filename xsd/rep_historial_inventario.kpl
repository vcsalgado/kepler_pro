<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Historial Inventario">	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<grp dim="31,15,7,12" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Historial Inventario">						<br/><tab/><txt>Sucursal:</txt><sp n="8"/><cmb id="cmb_sucursal" dim="40,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y"/>			      <br/>					<tab/><txt id="txt_inventario">Inventario: </txt> <sp n="7"/>			      <inp id="inventario" dim="20,1" bclr="255,255,255" clr="64,64,64"  OnF9="consulta_inventario()" OnChange="ins_inventario()" tooltip="F9 selecciona inventario" OnChange="identificador_inventario()" clrBrdr="255,255,255"  type="string" brdr="0,2"/>			      <br/>			      <tab/><txt id="txt_inventario_anterior">Inventario Anterior: </txt> 			      <inp id="inventario_anterior" dim="20,1" bclr="255,255,255" clr="64,64,64" modify="N" clrBrdr="255,255,255" available="Y" type="string" brdr="0,2"/>			      <br/>			      <tab/><txt id="txt_serie">Serie: </txt> <sp n="10"/>			      <inp id="serie" dim="20,1" bclr="255,255,255" clr="64,64,64" modify="N" OnChange="identificador_inventario()"  clrBrdr="255,255,255" available="Y" type="string" brdr="0,2"/>			       <br/> <br/> 			      <tab n="9"/><bot id="bot_ejecutar" dim="15,0" brdr="5" text="Ejecutar" OnEnter="GenerarReporte()" default="0"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys,suc_usuario ,perfil_usuario,asterisco, fileSavePath   ;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;								kdb.connect();				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				asterisco = "*";				fileSavePath = "C:\Basura";				Inicializa();							}						fun Inicializa(){//Inicializa los valores en Pantalla				IniCombos();				IniParams();//Inicializa parámtros de impresión entre otros				frn.set("ch_incluir","1");			}									fun IniCombos(){				var cmd, cuboQuery, xmlResQuery, ok, mensajeError, strTmp;				cuboQuery="datDoc";										//Llenar combo sucursales								cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (perfil_usuario &! "ADMINISTRADOR"  && perfil_usuario &! "ADMINISTRATOR" && "Administrador Kepler 8.0"){							cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_comisiones_coaches.IniCombos()");								ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("cmb_sucursal",getXml(cuboQuery));													}			fun consulta_inventario() {							var cmdQuery = "select c2 as inventario, c3 as clave,  c5 as serie , c4 as descripcion from keplersc.kdinf where c1= '" & frn.get("cmb_sucursal",-1,1) & "' ";				frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQuery");								frn.dialog("genlistafiltrosel","Inventario",cmdQuery,"inventario","inventario","0","","S");						}												fun ins_inventario(){										var xmlRequest,cmd,ok, cuboResultados, mensajeError;									var inv =  frn.get("inventario");					frn.rst("inventario");				frn.rst("inventario_anterior");				frn.rst("serie");												cmd = "select c2,c9,c5 from keplersc.kdinf where c1 = '" & frn.get("cmb_sucursal",-1,1) &  "' and c2='" & inv  & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_historial_inventario.ins_inventario()");							if(nXml(cuboResultados) &=0 ){				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message("Inventario no existe","","Aceptar");					return;				}									frn.set("inventario", getXmlAtt(cuboResultados , "r0", "c2") );				frn.set("inventario_anterior", getXmlAtt(cuboResultados , "r0", "c9") );				frn.set("serie", getXmlAtt(cuboResultados , "r0", "c5") );								}										fun GenerarReporte(){				var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var cubo, cmd,ok,mensajeError , xmlRequest, strTmp, totres  ;											kdb.kde("KDE");//Configuración del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();				//var incluir_salto_pagina= frn.get("salto_de_pagina");								kdb.readPage("datos","rep_historial_inventariofto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parámetros finales de impresión.(rep.page(...);)				rep.set("suc_desc",frn.get("cmb_sucursal",-1,0));				rep.set("rep_fecha",fechaImpresion);				rep.set("rep_hora",horaImpresion);				rep.set("inventario_rep",frn.get("inventario"));				rep.exe("encabezado");								setXml(xmlRequest,"document","sucursal_id",frn.get("cmb_sucursal",-1,1));				setXml(xmlRequest,"document","inventario",frn.get("inventario"));				setXml(xmlRequest,"document","serie",frn.get("serie"));											frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest_historial_inv");								cmd="select * from keplersc.rep_historial_inventario('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_historial_inventario.GenerarReporte()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									var cubo_datos_inv;				strTmp = getXmlAtt(cubo,"r0","datos_inv");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_datos_inv,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_datos_inv,"C:\Basura\cubo_datos_inv");								rep.set("vehiculo", getXml(cubo_datos_inv, "row","vehiculo"));				rep.set("vehiculo_desc", getXml(cubo_datos_inv, "row","vehiculo_desc"));				rep.set("serie", getXml(cubo_datos_inv, "row","serie"));				rep.set("motor", getXml(cubo_datos_inv, "row","motor"));				rep.set("transmision", getXml(cubo_datos_inv, "row","transmision"));				rep.set("inventario_anterior", getXml(cubo_datos_inv, "row","inventario_anterior"));				rep.set("color_exterior", getXml(cubo_datos_inv, "row","color_exterior"));				rep.set("color_exterior_desc", getXml(cubo_datos_inv, "row","color_exterior_desc"));				rep.set("clave_vehicular", getXml(cubo_datos_inv, "row","clave_vehicular"));				rep.set("vestiduras", getXml(cubo_datos_inv, "row","vestiduras"));				rep.set("vestiduras_desc", getXml(cubo_datos_inv, "row","vestiduras_desc"));				rep.set("anio_modelo", getXml(cubo_datos_inv, "row","anio_modelo"));				rep.set("eje_trasero", getXml(cubo_datos_inv, "row","eje_trasero"));				rep.set("rfv", getXml(cubo_datos_inv, "row","rfv"));				rep.set("marca", getXml(cubo_datos_inv, "row","marca"));				rep.set("marca_desc", getXml(cubo_datos_inv, "row","marca_desc"));				rep.set("clase", getXml(cubo_datos_inv, "row","clase"));				rep.set("clase_desc", getXml(cubo_datos_inv, "row","clase_desc"));				rep.set("tipo", getXml(cubo_datos_inv, "row","tipo"));				rep.set("pedimento", getXml(cubo_datos_inv, "row","pedimento"));				rep.set("fecha_pedimento", getXml(cubo_datos_inv, "row","fecha_pedimento"));				rep.set("lugar_pedimento", getXml(cubo_datos_inv, "row","lugar_pedimento"));				rep.exe("datos_inventario");							//DATOS FACTURAS_COMPRA				var cubo_datos_facturas_compra;				strTmp = getXmlAtt(cubo,"r0","datos_facturas_compra");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_datos_facturas_compra,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_datos_facturas_compra,"C:\Basura\cubo_datos_facturas_compra");							totres = nXml(cubo_datos_facturas_compra);								for (var contres=1; contres<=totres ; contres++){					if (contres &= 1){						rep.exe("titulo_facturas_compra");					}					rep.set( "folio_compra",getXml(cubo_datos_facturas_compra, "r" & contres , "folio_compra"));					rep.set( "tipo_mov_compra",getXml(cubo_datos_facturas_compra, "r" & contres , "tipo_mov_compra"));					rep.set( "fecha_factura_compra",getXml(cubo_datos_facturas_compra, "r" & contres , "fecha_factura_compra"));					rep.set( "numero_cdo",getXml(cubo_datos_facturas_compra, "r" & contres , "numero_cdo"));					rep.set( "clave_prov",getXml(cubo_datos_facturas_compra, "r" & contres , "clave_prov"));					rep.set( "nombre_prov",getXml(cubo_datos_facturas_compra, "r" & contres , "nombre_prov"));					rep.set( "calle_prov",getXml(cubo_datos_facturas_compra, "r" & contres , "calle_prov"));					rep.set( "colonia_prov",getXml(cubo_datos_facturas_compra, "r" & contres , "colonia_prov"));					rep.set( "poblacion_prov",getXml(cubo_datos_facturas_compra, "r" & contres , "poblacion_prov"));					rep.set( "rfc_prov",getXml(cubo_datos_facturas_compra, "r" & contres , "rfc_prov"));					rep.set( "costo_factura_compra",getXml(cubo_datos_facturas_compra, "r" & contres , "costo_factura_compra"));					rep.set( "iva_factura_compra",getXml(cubo_datos_facturas_compra, "r" & contres , "iva_factura_compra"));					rep.set( "hold_back",getXml(cubo_datos_facturas_compra, "r" & contres , "hold_back"));					rep.set( "importe_compra",getXml(cubo_datos_facturas_compra, "r" & contres , "importe_compra"));					rep.exe("datos_facturas_compra");													}												//DATOS PEDIDO				var cubo_datos_pedido;				strTmp = getXmlAtt(cubo,"r0","datos_pedido");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_datos_pedido,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_datos_pedido,"C:\Basura\cubo_datos_pedido");								totres = nXml(cubo_datos_pedido);								if (totres &= 1){					rep.exe("titulo_pedidos");				}					rep.set( "folio_pedido",getXml(cubo_datos_pedido, "row" , "folio_pedido"));				rep.set( "fecha_pedido",getXml(cubo_datos_pedido, "row" , "fecha_pedido"));				rep.set( "clave_vendedor",getXml(cubo_datos_pedido, "row" , "clave_vendedor"));				rep.set( "nombre_vendedor",getXml(cubo_datos_pedido, "row" , "nombre_vendedor"));				rep.set( "tipo_operacion",getXml(cubo_datos_pedido, "row" , "tipo_operacion"));				rep.set( "tipo_operacion_desc",getXml(cubo_datos_pedido, "row" , "tipo_operacion_desc"));							rep.set( "impresion",getXml(cubo_datos_pedido, "row" , "impresion"));				rep.set( "clave_cli",getXml(cubo_datos_pedido, "row" , "clave_cli"));				rep.set( "nombre_cli",getXml(cubo_datos_pedido, "row" , "nombre_cli"));						rep.set( "calle_cli",getXml(cubo_datos_pedido, "row" , "calle_cli"));							rep.set( "colonia_cli",getXml(cubo_datos_pedido, "row" , "colonia_cli"));						rep.set( "poblacion_cli",getXml(cubo_datos_pedido, "row" , "poblacion_cli"));						rep.set( "rfc_cli",getXml(cubo_datos_pedido, "row" , "rfc_cli"));				rep.set( "subsidio",getXml(cubo_datos_pedido, "row" , "subsidio"));				rep.set( "bonificacion",getXml(cubo_datos_pedido, "row" , "bonificacion"));				rep.set( "accesorios",getXml(cubo_datos_pedido, "row" , "accesorios"));				rep.set( "garantia_extendida",getXml(cubo_datos_pedido, "row" , "garantia_extendida"));				rep.set( "seguro",getXml(cubo_datos_pedido, "row" , "seguro"));						rep.exe("datos_pedido");																				//DATOS FACTURAS VENTA				var cubo_datos_facturas_venta;				strTmp = getXmlAtt(cubo,"r0","datos_facturas_venta");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_datos_facturas_venta,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_datos_facturas_venta,"C:\Basura\cubo_datos_facturas_venta");							totres = nXml(cubo_datos_facturas_venta);								for (var contres=1; contres<=totres ; contres++){					if (contres &= 1){						rep.exe("titulo_facturas_venta");					}					rep.set( "folio_factura",getXml(cubo_datos_facturas_venta, "r" & contres , "folio_factura"));					rep.set( "tipo_mov_factura",getXml(cubo_datos_facturas_venta, "r" & contres , "tipo_mov_factura"));					rep.set( "fecha_factura",getXml(cubo_datos_facturas_venta, "r" & contres , "fecha_factura"));					rep.set( "clave_cli_factura",getXml(cubo_datos_facturas_venta, "r" & contres , "clave_cli_factura"));					rep.set( "nombre_cli_factura",getXml(cubo_datos_facturas_venta, "r" & contres , "nombre_cli_factura"));					rep.set( "calle_cli_factura",getXml(cubo_datos_facturas_venta, "r" & contres , "calle_cli_factura"));					rep.set( "colonia_cli_factura",getXml(cubo_datos_facturas_venta, "r" & contres , "colonia_cli_factura"));					rep.set( "poblacion_cli_factura",getXml(cubo_datos_facturas_venta, "r" & contres , "poblacion_cli_factura"));					rep.set( "rfc_cli_factura",getXml(cubo_datos_facturas_venta, "r" & contres , "rfc_cli_factura"));					rep.set( "importe_factura",getXml(cubo_datos_facturas_venta, "r" & contres , "importe_factura"));					rep.set( "isan_factura",getXml(cubo_datos_facturas_venta, "r" & contres , "isan_factura"));					rep.set( "iva_factura",getXml(cubo_datos_facturas_venta, "r" & contres , "iva_factura"));					rep.set( "total",getXml(cubo_datos_facturas_venta, "r" & contres , "total"));					rep.exe("datos_facturas_venta");													}												//DATOS FACTURAS PVA				var cubo_datos_facturas_pva;				strTmp = getXmlAtt(cubo,"r0","datos_facturas_pva");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_datos_facturas_pva,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_datos_facturas_pva,"C:\Basura\cubo_datos_facturas_pva");							totres = nXml(cubo_datos_facturas_pva);								for (var contres=1; contres<=totres ; contres++){					if (contres &= 1){						rep.exe("titulo_facturas_pva");					}					rep.set( "folio_factura_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "folio_factura_pva"));					rep.set( "tipo_mov_factura_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "tipo_mov_factura_pva"));					rep.set( "fecha_factura_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "fecha_factura_pva"));					rep.set( "clave_cli_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "clave_cli_pva"));					rep.set( "nombre_cli_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "nombre_cli_pva"));					rep.set( "calle_cli_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "calle_cli_pva"));					rep.set( "colonia_cli_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "colonia_cli_pva"));					rep.set( "poblacion_cli_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "poblacion_cli_pva"));					rep.set( "rfc_cli_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "rfc_cli_pva"));					rep.set( "gastos_adm",getXml(cubo_datos_facturas_pva, "r" & contres , "gastos_adm"));					rep.set( "accesorios_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "accesorios_pva"));					rep.set( "garantia_extendida_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "garantia_extendida_pva"));					rep.set( "seguro_auto","0.00");					rep.set( "intereses_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "intereses_pva"));					rep.set( "cobranza_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "cobranza_pva"));					rep.set( "iva_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "iva_pva"));					rep.set( "total_pva",getXml(cubo_datos_facturas_pva, "r" & contres , "total_pva"));					rep.exe("datos_facturas_pva");													}												//DATOS NOTAS DESCUENTO				var cubo_datos_notas_descuento;				strTmp = getXmlAtt(cubo,"r0","datos_notas_descuento");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_datos_notas_descuento,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_datos_notas_descuento,"C:\Basura\cubo_datos_notas_descuento");							totres = nXml(cubo_datos_notas_descuento);								for (var contres=1; contres<=totres ; contres++){					if (contres &= 1){						rep.exe("titulo_notas_descuento");					}					rep.set( "folio_nota_desc",getXml(cubo_datos_notas_descuento, "r" & contres , "folio_nota_desc"));					rep.set( "fecha_nota_desc",getXml(cubo_datos_notas_descuento, "r" & contres , "fecha_nota_desc"));					rep.set( "clave_cli_nota_desc",getXml(cubo_datos_notas_descuento, "r" & contres , "clave_cli_nota_desc"));					rep.set( "nombre_cli_nota_desc",getXml(cubo_datos_notas_descuento, "r" & contres , "nombre_cli_nota_desc"));					rep.set( "calle_cli_nota_desc",getXml(cubo_datos_notas_descuento, "r" & contres , "calle_cli_nota_desc"));					rep.set( "colonia_cli_nota_desc",getXml(cubo_datos_notas_descuento, "r" & contres , "colonia_cli_nota_desc"));					rep.set( "poblacion_cli_pva",getXml(cubo_datos_notas_descuento, "r" & contres , "poblacion_cli_pva"));					rep.set( "poblacion_cli_nota_desc",getXml(cubo_datos_notas_descuento, "r" & contres , "poblacion_cli_nota_desc"));					rep.set( "rfc_cli_nota_desc",getXml(cubo_datos_notas_descuento, "r" & contres , "rfc_cli_nota_desc"));					rep.set( "subtotal_nota_desc",getXml(cubo_datos_notas_descuento, "r" & contres , "subtotal_nota_desc"));					rep.set( "iva_nota_desc",getXml(cubo_datos_notas_descuento, "r" & contres , "iva_nota_desc"));					rep.set( "total_nota_desc",getXml(cubo_datos_notas_descuento, "r" & contres , "total_nota_desc"));					rep.exe("datos_notas_descuento");									}												//DATOS NOTAS CREDITO				var cubo_datos_notas_credito;				strTmp = getXmlAtt(cubo,"r0","datos_notas_credito");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_datos_notas_credito,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_datos_notas_credito,"C:\Basura\cubo_datos_notas_credito");							totres = nXml(cubo_datos_notas_credito);								for (var contres=1; contres<=totres ; contres++){					if (contres &= 1){						rep.exe("titulo_notas_credito");					}					rep.set( "folio_nota_cred",getXml(cubo_datos_notas_credito, "r" & contres , "folio_nota_cred"));					rep.set( "fecha_nota_cred",getXml(cubo_datos_notas_credito, "r" & contres , "fecha_nota_cred"));					rep.set( "clave_cli_nota_cred",getXml(cubo_datos_notas_credito, "r" & contres , "clave_cli_nota_cred"));					rep.set( "nombre_cli_nota_cred",getXml(cubo_datos_notas_credito, "r" & contres , "nombre_cli_nota_cred"));					rep.set( "calle_cli_nota_cred",getXml(cubo_datos_notas_credito, "r" & contres , "calle_cli_nota_cred"));					rep.set( "colonia_cli_nota_cred",getXml(cubo_datos_notas_credito, "r" & contres , "colonia_cli_nota_cred"));					rep.set( "poblacion_cli_nota_cred",getXml(cubo_datos_notas_credito, "r" & contres , "poblacion_cli_nota_cred"));					rep.set( "rfc_cli_nota_cred",getXml(cubo_datos_notas_credito, "r" & contres , "rfc_cli_nota_cred"));					rep.set( "importe_nota_cred",getXml(cubo_datos_notas_credito, "r" & contres , "importe_nota_cred"));					rep.set( "isan_nota_cred",getXml(cubo_datos_notas_credito, "r" & contres , "isan_nota_cred"));					rep.set( "iva_nota_cred",getXml(cubo_datos_notas_credito, "r" & contres , "iva_nota_cred"));					rep.set( "total_nota_cred",getXml(cubo_datos_notas_credito, "r" & contres , "total_nota_cred"));					rep.exe("datos_notas_credito");									}																//DATOS VALES DE SALIDA				var cubo_datos_vales_salida;				strTmp = getXmlAtt(cubo,"r0","datos_vales_salida");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_datos_vales_salida,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_datos_vales_salida,"C:\Basura\cubo_datos_vales_salida");							totres = nXml(cubo_datos_vales_salida);								for (var contres=1; contres<=totres ; contres++){					if (contres &= 1){						rep.exe("titulo_vales_salida");					}					rep.set( "folio_vale_salida",getXml(cubo_datos_vales_salida, "r" & contres , "folio_vale_salida"));					rep.set( "tipo_mov_vale_salida",getXml(cubo_datos_vales_salida, "r" & contres , "tipo_mov_vale_salida"));					rep.set( "fecha_vale_salida",getXml(cubo_datos_vales_salida, "r" & contres , "fecha_vale_salida"));					rep.exe("datos_vales_salida");									}												//DATOS OPERACIONES A CREDITO				var cubo_datos_operaciones_credito;				strTmp = getXmlAtt(cubo,"r0","datos_operaciones_credito");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_datos_operaciones_credito,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_datos_operaciones_credito,"C:\Basura\cubo_datos_operaciones_credito");							totres = nXml(cubo_datos_operaciones_credito);								if (totres > 0){					rep.exe("titulo_operacion_credito");										var monto_financiamiento = getXml(cubo_datos_inv, "row","monto_financiamiento");					rep.set("monto_financiamiento", monto_financiamiento );					rep.set("interes_financiamiento", getXml(cubo_datos_inv, "row","interes_financiamiento"));					rep.set("plazo_financiamiento", getXml(cubo_datos_inv, "row","plazo_financiamiento"));					rep.set("cobranza_financiamiento", getXml(cubo_datos_inv, "row","cobranza_financiamiento"));					var aval = getXml(cubo_datos_inv, "row","nombre_aval");					rep.set("nombre_aval", aval );					rep.set("direccion_aval", getXml(cubo_datos_inv, "row","direccion_aval"));					rep.set("colonia_aval", getXml(cubo_datos_inv, "row","colonia_aval"));					rep.set("poblacion_aval", getXml(cubo_datos_inv, "row","poblacion_aval"));					rep.set("rfc_aval", getXml(cubo_datos_inv, "row","rfc_aval"));										if (monto_financiamiento > 0 || aval &! ""){						rep.exe("datos_operacion_credito");					}								}								for (var contres=1; contres<=totres ; contres++){									var cubo_movimientos_xe = getXml(cubo_datos_operaciones_credito, "r" & contres, "movimientos_xe_ven" );					var totmovs = nXml(cubo_movimientos_xe);					for (var contmovs=1; contmovs<=totmovs ; contmovs++){											if (contmovs &= 1){							rep.exe("columnas_credito");						}												rep.set( "folio_xe_ven",getXml(cubo_movimientos_xe , "r" & contmovs, "folio_xe_ven"));						rep.set( "tipo_xe_ven",getXml(cubo_movimientos_xe , "r" & contmovs, "tipo_xe_ven"));						rep.set( "fecha_expedicion_xe_ven",getXml(cubo_movimientos_xe , "r" & contmovs, "fecha_expedicion_xe_ven"));						rep.set( "fecha_vencimiento_xe_ven",getXml(cubo_movimientos_xe , "r" & contmovs, "fecha_vencimiento_xe_ven"));						rep.set( "cargo_xe_ven",getXml(cubo_movimientos_xe , "r" & contmovs, "cargo_xe_ven"));						rep.set( "abono_xe_ven",getXml(cubo_movimientos_xe , "r" & contmovs, "abono_xe_ven"));						rep.set( "saldo_xe_ven",getXml(cubo_movimientos_xe , "r" & contmovs, "saldo_xe_ven"));						rep.exe("linea_movimiento_credito");											}											rep.set( "cargos_totales_xe_ven",getXml(cubo_datos_operaciones_credito, "r" & contres , "cargos_totales_xe_ven"));					rep.set( "abonos_totales_xe_ven",getXml(cubo_datos_operaciones_credito, "r" & contres , "abonos_totales_xe_ven"));					rep.set( "saldo_total_xe_ven",getXml(cubo_datos_operaciones_credito, "r" & contres , "saldo_total_xe_ven"));					rep.set( "saldo_vencido_xe_ven",getXml(cubo_datos_operaciones_credito, "r" & contres , "saldo_vencido_xe_ven"));					rep.exe("totales_movimientos_credito");									}													//DATOS MOVIMIENTOS DEL INVENTARIO				var cubo_datos_movimimientos_inv;				strTmp = getXmlAtt(cubo,"r0","datos_movimimientos_inv");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_datos_movimimientos_inv,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_datos_movimimientos_inv,"C:\Basura\cubo_datos_movimimientos_inv");							totres = nXml(cubo_datos_movimimientos_inv);								for (var contres=1; contres<=totres ; contres++){					if (contres &= 1){						rep.exe("titulo_movimientos_inventario");						rep.exe("columnas_movimientos_inventario");					}					rep.set( "folio_mov_inv",getXml(cubo_datos_movimimientos_inv, "r" & contres , "folio_mov_inv"));					rep.set( "tipo_mov_inv",getXml(cubo_datos_movimimientos_inv, "r" & contres , "tipo_mov_inv"));					rep.set( "fecha_mov_inv",getXml(cubo_datos_movimimientos_inv, "r" & contres , "fecha_mov_inv"));					rep.set( "entrada_mov_inv",getXml(cubo_datos_movimimientos_inv, "r" & contres , "entrada_mov_inv"));					rep.set( "salida_mov_inv",getXml(cubo_datos_movimimientos_inv, "r" & contres , "salida_mov_inv"));					rep.exe("linea_movimientos_inventario");									}																	//DATOS CARGOS AL COSTO				var cubo_datos_cargos_costo;				strTmp = getXmlAtt(cubo,"r0","datos_cargos_costo");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_datos_cargos_costo,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_datos_cargos_costo,"C:\Basura\cubo_datos_cargos_costo");							totres = nXml(getXml(cubo_datos_cargos_costo,  "cargos_al_costo"));								for (var contres=1; contres<=totres ; contres++){					if (contres &= 1){						rep.exe("titulo_cargos_costo");						rep.exe("columnas_cargos_costo");					}					rep.set( "folio_cc",getXml(cubo_datos_cargos_costo,"cargos_al_costo", "r" & contres , "folio_cc"));					rep.set( "tipo_cc",getXml(cubo_datos_cargos_costo, "cargos_al_costo","r" & contres , "tipo_cc"));					rep.set( "fecha_cc",getXml(cubo_datos_cargos_costo, "cargos_al_costo","r" & contres , "fecha_cc"));					rep.set( "cargo_cc",getXml(cubo_datos_cargos_costo, "cargos_al_costo", "r" & contres , "cargo_cc"));					rep.set( "abono_cc",getXml(cubo_datos_cargos_costo, "cargos_al_costo", "r" & contres , "abono_cc"));					rep.set( "saldo_cc",getXml(cubo_datos_cargos_costo, "cargos_al_costo", "r" & contres , "saldo_cc"));					rep.set( "tipo_costo_cc",getXml(cubo_datos_cargos_costo, "cargos_al_costo", "r" & contres , "tipo_costo_cc"));					rep.exe("linea_cargos_costo");									}								rep.set( "cargos_totales_cc",getXml(cubo_datos_cargos_costo,  "cargos_totales_cc"));				rep.set( "abonos_totales_cc",getXml(cubo_datos_cargos_costo, "abonos_totales_cc"));				rep.set( "saldo_total_cc",getXml(cubo_datos_cargos_costo, "saldo_total_cc"));				rep.exe("totales_cargos_costo");								rep.win();						}														//-------------------------------------------------extras------------------------------------------------						fun IniParams(){//Inicializa parámetros de impresión, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Página				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}			fun setRepPage() {//Establece los parámetros finales de impresión.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}																											}	</script></pag>