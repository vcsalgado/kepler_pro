<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns='www.kepler.com.mx/2003/KSchema' tit="Reporte de balanza de comprobaci&#243;n">
<grp id="grpMain" brdr="0,0" clr="0,58,112" fnt="Arial,16" dim='1,-1,10,20'  bclr="192,205,213" unfont="0" OnF1="Dialog(1,conrepbalayu)" tit="Reportes contables" clrBrdr="0,97,181"><br/>
	<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="38,22,7,12" tit="Balanza de comprobacion"  fnt="Arial,16" clr="0,58,112"><br/>
		<tab n="2"/><txt>Nivel</txt><tab n="4"/><inp id="niv" clr="64,64,64" clrBrdr="255,255,255"  dim="3,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" min="1" max="9" nc="1" default="1" available="N" modify="N"/><br/><br/>
		<tab n="2"/><txt>Fecha incial</txt><tab n="2"/><edt id="fecha_ini" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnButton="Dialog(0,_ks_fecha,fecha_ini)" nc="11" OnChange="CambiaFecha()"/>
		<tab/><br/>
		<tab n="2"/><txt>Fecha final</txt><tab n="2"/><edt id="fecha_fin" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnButton="Dialog(0,_ks_fecha,fecha_fin)" nc="11"/>
		<tab/><br/><br/>
		<tab n="2"/><txt>Cuenta inicial</txt><tab/><edt id="cta_ini" clr="64,64,64" clrBrdr="255,255,255"  dim="22,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" OnF9="Dialog(1,concatcuebus,cta_ini)" page="concatcuebus,cta_ini" OnF10="Dialog(1,concatcuepag,cta_ini,,10010)" type="string"/>
		<tab/><br/>
		<tab n="2"/><txt>Cuenta final</txt><tab n="2"/><edt id="cta_fin" clr="64,64,64" clrBrdr="255,255,255"  dim="22,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" OnF9="Dialog(1,concatcuebus,cta_fin)" page="concatcuebus,cta_fin" OnF10="Dialog(1,concatcuepag,cta_fin,,10010)" type="string"/><br/><br/>
		<tab n="2"/><txt>Por grupos</txt><tab n="5"/>
		<chck id="xGrp" clr="64,64,64"  dim="3,16" bclr="255,255,255" brdr="2,0" YN="10" clrBrdr="255,255,255"/><br/><tab n="2"/><txt>Omitir grupos en ceros</txt><tab n="2"/>
		<chck id="xCer" clr="64,64,64"  dim="3,16" bclr="255,255,255" brdr="2,0" YN="10" clrBrdr="255,255,255"/><br/><br/>
		<tab n="7"/>
	</grp><br/><tab/><br/><tab n="15"/>
<img id="btnEjecutar" dim="60,60" brdr="0,1" bPx="1" tooltip="Ejecutar reporte" OnEnter="Reporte()" img="_60_ExecuteReport.png" available="Y"/><br/>
	<tab n="3"/>
</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,kdb,rep,sys,year;
			var DescGrupos;
			fun Main() {
				frn=new FRNT;
				kdb=new KDB;
				rep=new REP;
				sys=new SYS;
				kdb.connect();
				Inicializa();
			}	
		
			fun Inicializa(){//Inicializa los valores en Pantalla
				//Revisa si hay año definido por la session
				if(frn.config("temp","k_workDate")){
					year=mid(frn.config("temp","k_workYear"),2,2);
				}else {
					kdb.kde("yr");kdb.exec();
					year=kdb.get("yr",14);
				}
				kdb.open("c,kdc1" & year);
				frn.set("niv",frn.param(0));
				frn.set("fecha_ini",sys.date(year,sys.date("month"),1));
				frn.set("fecha_fin",sys.date(year,sys.date("month"),31));
				kdb.search("ctaini,c,1,7,&,c1");
				kdb.search("ctafin,c,1,8,&,c1");
				kdb.exec();
				frn.set("cta_ini",kdb.get("ctaini","c1"));
				frn.set("cta_fin",kdb.get("ctafin","c1"));
				//Se llena un Xml con los grupos default de cuentas, en el orden en que las entrega el stored procedure
				setXml(DescGrupos,"r0","Activo Circulante");
				setXml(DescGrupos,"r1","Activo Fijo");
				setXml(DescGrupos,"r2","Activo Diferido");
				setXml(DescGrupos,"r3","Pasivo Circulante");
				setXml(DescGrupos,"r4","Pasivo a Largo Plazo");
				setXml(DescGrupos,"r5","Capital Contable");
				setXml(DescGrupos,"r6","Ventas");
				setXml(DescGrupos,"r7","Costo de Ventas");
				setXml(DescGrupos,"r8","Gastos");
				setXml(DescGrupos,"r9","Gastos/Productos Financieros");
				setXml(DescGrupos,"r10","ISR y PTU");
				setXml(DescGrupos,"r11","Cuentas de Orden");
				IniParams();//Inicializa parámtros de impresión entre otros
			}
			fun IniParams(){//Inicializa parámetros de impresión, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Página
				frn.set("param_paper","letter");//	"paper=letter|legal|size"
				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"
				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"
				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"
				frn.set("param_landscape","N");//	"landscape=N|Y"
				frn.set("param_emp","L");//			"@emp=L|R|C"
			}
			
			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){
				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO
							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana
							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)
							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje
				*/
				var prefix=frn.lib("libKepler","langPrefix");
				var page=prefix&pag;
				var b_valido=1;
				if(iModo==0)page=pag;
				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.
					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;
				}
				else if(iModo==3)b_valido=0;
				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);
			}
			
			fun CambiaFecha(){
				var mes=fnDate("month",frn.get("fecha_ini"));
				var yr=fnDate("year",frn.get("fecha_ini"));
				frn.set("fecha_fin",yr & "/"& mes &"/31");
			}
			fun Reporte(){//Ejecuta el Reporte
				var SI=0,CA=0,AA=0,SF=0;	//Acumulado Total
				//Obtienen los valores de los campos en pantalla
				var nivel=frn.get("niv");			//Nivel
				var fIni=frn.get("fecha_ini");	//Fecha inicial
				var fFin=frn.get("fecha_fin");	//Fecha Final
				var cIni=frn.get("cta_ini",-1,0);//guarda la clave inicial de busqueda -1 nos entrega el renglon actual
				var cFin=frn.get("cta_fin",-1,0);//guarda la clave final de busqueda
				var Grupos=frn.get("xGrp");		//Divide las cuentas por tipos de cuenta(Ej: Activo, Pasivo,etc)
				
				//Se definen los parámetros para el stored procedure
				var cve="cve:'" & cIni & "'-'" & cFin & "'";
				var fec="fec:'" & fIni & "'-'" & fFin & "'";
				var srt="";
				if (Grupos==1)
					srt="srt:grp";
				else
					srt="srt:cve";
				var niv="niv:" & nivel;
				kdb.sp("k_cnt","modo:mov","dat:datCtas",srt,fec,cve,niv);//SP de movimientos de contabilidad
				//	niv:0,1...9	srt:0=fec|1=cve|2=grp  //Pendiente: 3=dpt/fec|4=dpt/cta|5=dpt/grp|6=pry/fec|7=xpry/cta|8=pry/grp
				
				// Se define el formato a usar y se imprime el encabezado
				kdb.readPage("pagFto","conRepBalFto");//se define el formato a usar
				kdb.exec();
				rep.source(kdb.get("pagFto")); 
				rep.rst(); 
				setRepPage();//Establece los parámetros finales de impresión.(rep.page(...);)
				rep.set("fecha",sys.date());rep.set("hora",sys.time());
				rep.set("rep_titulo","Balanza de Comprobación");
				rep.set("rep_titulo2","Balanza de Comprobación");
				rep.set("rep_feci",fIni);
				rep.set("rep_fecf",fFin);
				rep.set("rep_nivel",nivel);
				rep.exe("encabezado");
				var nGrps=kdb.N("datCtas");					//número de grupos de cuenta
				for (var iG=0;iG<nGrps;iG++){					//Recorre cada grupo. En caso de no especificar grupos, todoas las cuentas quedan en el renglon 0
					var SIGrp=0,CAGrp=0,AAGrp=0,SFGrp=0;	//Acumulado por Grupo
					if(Grupos==1){									//Imprime la leyenda de cada grupo de cuentas
						rep.set("rep_grupo",getXml(DescGrupos,"r" & iG));
						rep.exe("grupo");
					}
					var nCtas=kdb.N("datCtas","r"&iG);		//número de cuentas en el grupo 
					for (var iC=0;iC<nCtas;iC++){				//cada cuenta
						var si=kdb.get("datCtas","r" & iG,"r" & iC,"SI");// saldo inicial
						var sc=kdb.get("datCtas","r" & iG,"r" & iC,"SC");// suma de cargos
						var sa=kdb.get("datCtas","r" & iG,"r" & iC,"SA");// suma de abonos
						var sf=si+sc-sa;	//saldo final
						var sumaCta=si+sc+sa;
						if((frn.get("xCer")==0)||(frn.get("xCer")==1&&(sumaCta!=0 || si!=0 || sf!=0))){
						if(kdb.get("datCtas","r"&iG,"r"&iC,"niv")==1) {//	nivel de la cuenta (1,2,...8)
							SI+=si; CA+=sc; AA+=sa; SF+=sf;					//Acumula el total global
							SIGrp+=si; CAGrp+=sc; AAGrp+=sa; SFGrp+=sf;	//Acumula el total del grupo
						}
						rep.set("cta",kdb.get("datCtas","r" & iG,"r" & iC,"cta"));		//cuenta
						rep.set("desc",kdb.get("datCtas","r" & iG,"r" & iC,"dsc"));	//descripción
						rep.set("sldIniCta",si);		//saldo inicial
						rep.set("cgoCta",sc);			//cargo
						rep.set("abnCta",sa);			//	abono
						rep.set("sldFinCta",math("round",sf,2));		//saldo final
						//Si el saldo inicial o final son negativos, los pone en rojo.
						if (si<0) rep.setAtt("sldIniCta","clr","255,0,0"); else rep.setAtt("sldIniCta","clr","0,0,0");
						if (sf<0) rep.setAtt("sldFinCta","clr","255,0,0"); else rep.setAtt("sldFinCta","clr","0,0,0");
						rep.exe("cta");
						var nPol=kdb.N("datCtas","r" & iG,"r" & iC);		//número de partidas de pólizas
						for (var iP=0;iP<nPol;iP++) {							//se recorre cada partida
							if (kdb.get("datCtas","r" & iG,"r" & iC,"r" & iP,"abn")==0) {
								rep.set("fec",kdb.get("datCtas","r" & iG,"r" & iC,"r" & iP,"fec"));
								rep.set("tipo",kdb.get("datCtas","r" & iG,"r" & iC,"r" & iP,"tip"));
								rep.set("npol",kdb.get("datCtas","r" & iG,"r" & iC,"r" & iP,"pol"));
								rep.set("descPol",kdb.get("datCtas","r" & iG,"r" & iC,"r" & iP,"dsc"));
								rep.set("cgoPol",kdb.get("datCtas","r" & iG,"r" & iC,"r" & iP,"crg"));
								rep.exe("polC");
							} else {
								rep.set("fecA",kdb.get("datCtas","r" & iG,"r" & iC,"r" & iP,"fec"));
								rep.set("tipoA",kdb.get("datCtas","r" & iG,"r" & iC,"r" & iP,"tip"));
								rep.set("npolA",kdb.get("datCtas","r" & iG,"r" & iC,"r" & iP,"pol"));
								rep.set("descPolA",kdb.get("datCtas","r" & iG,"r" & iC,"r" & iP,"dsc"));
								rep.set("abnPol",kdb.get("datCtas","r" & iG,"r" & iC,"r" & iP,"abn"));
								rep.exe("polA");
							}
						}
					 }
					}
					if(Grupos==1){									//Imprime los totales por grupo 
						rep.set("sldIniGrp",SIGrp);
						rep.set("cgoGrp",CAGrp);
						rep.set("abnGrp",AAGrp);
						rep.set("sldFinGrp",math("round",SFGrp,2));
						rep.exe("grupoFin");
					}
				}
				//Si el saldo inicial o final son negativos, los pone en rojo.
				if (SI<-.009) rep.setAtt("sldIniAcum","clr","255,0,0"); else rep.setAtt("sldIniAcum","clr","0,52,100");
				if (SF<-.009) rep.setAtt("sldFinAcum","clr","255,0,0"); else rep.setAtt("sldFinAcum","clr","0,52,100");
				//rep.set("sldIniAcum",SI); rep.set("cgoAcum",CA); rep.set("abnAcum",AA); rep.set("sldFinAcum",math("round",SF,2));
				rep.set("sldIniAcum",math("round",SI,2)); rep.set("cgoAcum",math("round",CA,2)); rep.set("abnAcum",math("round",AA,2)); rep.set("sldFinAcum",math("round",SF,2)); //2018-08-15 Para evitar errores de punto flotante
				rep.exe("suma");//--------------------------- suma ----------------------------------------
				rep.win(); 
			}
			fun setRepPage() {//Establece los parámetros finales de impresión.
				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc
				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");
				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";
				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";
				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");
				var lndsp="landscape=" & frn.get("param_landscape");
				var emp="@emp=" & frn.get("param_emp");
				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);
			}
		}
		/*
		AUTOR				FECHA						CAMBIO
		---------------------------------------------
		Carlos JAM		27-05-2010				 A la variable "sf" se le aplica el math("round",variable,2)
														 A la variable "SF" se le aplica el math("round",variable,2)	
														 A la variable "SFGrp" se le aplica el math("round",variable,2)
		*/
	</script>
</pag>