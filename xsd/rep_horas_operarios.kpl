<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Horas p/Operario">	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<grp dim="27,20,7,12" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Horas p/Operario">						<br/><tab/><txt>Sucursal:</txt><sp n="2"/><cmb id="cmb_sucursal" dim="43,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y"/>			      <br/>  <br/>			      			      			      <tab/><txt clr="0,58,112" id="fecha_inicial_txt" fnt="Arial,16" visible="Y">Fecha Inicial:</txt><tab/>					<edt id="fecha_inicial" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16"  type="date" 					 page="_ks_fecha,fecha_inicial" OnF9="Dialog(3,_ks_fecha,fecha_inicial)" visible="Y"/><tab n="1"/> 										<txt clr="0,58,112" id="fecha_final_txt"  fnt="Arial,16" visible="Y">Fecha Final:</txt><tab/>					<edt id="fecha_final" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16"  type="date" 					page="_ks_fecha,fecha_final" OnF9="Dialog(3,_ks_fecha,fecha_final)" visible="Y"/>										<br/>  <br/>									 <tab/><txt>Operario Inicial:</txt>	<tab/>			      <inp id="operario_inicial" dim="11,1" bclr="255,255,255" OnF9="ObtenerOperario(operario_inicial)" OnChange="MostrarOperario(operario_inicial)" clr="64,64,64" nc="6" clrBrdr="255,255,255"  type="string" brdr="0,2"/>			        <tab/>			        					<txt>Operario Final:</txt>	<tab/>			      <inp id="operario_final" dim="11,1" bclr="255,255,255" OnF9="ObtenerOperario(operario_final)" OnChange="MostrarOperario(operario_final)" clr="64,64,64" nc="6" clrBrdr="255,255,255"  type="string" brdr="0,2"/>			       <br/>  <br/>			       					 <tab/><txt>Imprime una pagina por Operario:</txt>	<sp n="2"/>			      <inp id="salto_de_pagina" dim="2,1" bclr="255,255,255" clr="64,64,64" nc="1" OnMouseD="cambiar_s_n()" clrBrdr="255,255,255" modify="N" available="Y" type="string" brdr="0,2"/>			       <br/>  <br/>			       			      <tab n="7"/><bot id="bot_ejecutar" dim="15,0" brdr="5" text="Ejecutar" OnEnter="GenerarReporte()" default="0"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys,suc_usuario ,perfil_usuario,asterisco  ;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;								kdb.connect();				kdb.open("s,kdms,i,kdini,c,kdud");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				asterisco = "*";				Inicializa();							}						fun Inicializa(){//Inicializa los valores en Pantalla				IniCombos();				IniParams();//Inicializa parámtros de impresión entre otros				frn.set("ch_incluir","1");			}									fun IniCombos(){				var cmd, cuboQuery, xmlResQuery, ok, mensajeError, strTmp;				cuboQuery="datDoc";										//Llenar combo sucursales								cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (perfil_usuario &! "ADMINISTRADOR"  && perfil_usuario &! "ADMINISTRATOR" && "Administrador Kepler 8.0"){							cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_comisiones_coaches.IniCombos()");								ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("cmb_sucursal",getXml(cuboQuery));										frn.set("salto_de_pagina", "S");																							cmd = "select c1 from keplersc.kdoper order by c1 ";				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_horas_operarios.IniCombos()");												var len_opes = nXml(cuboQuery );								frn.set("operario_inicial", getXmlAtt(cuboQuery ,"r0","c1"));						frn.set("operario_final", getXmlAtt(cuboQuery ,"r" & len_opes - 1 ,"c1"));								frn.set("fecha_inicial", sys.date());				frn.set("fecha_final", sys.date());												kdb.exec();																	}			fun ObtenerOperario(campo_pegar){					var cmdQuery = "select c1 as clave, c2 as tipo, c3 as nombre, c12 as estatus from keplersc.kdoper ";					frn.dialog("genlistafiltrosel","Operarios",cmdQuery,"clave",campo_pegar ,"0","","S");			}									fun MostrarOperario(campo_pegar){							var xmlRequest,cmd,ok, cuboResultados, mensajeError,totOrd,contOrd;					 				var ope = frn.get(campo_pegar);								cmd = "select c1 from keplersc.kdoper where c1 ='" & ope &  "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_horas_operarios.MostrarOperario()");							if (nXml(cuboResultados ) == 0){					frn.message("Operario no existe","Error","Aceptar");					frn.set(campo_pegar, "");					return;				}				}									fun cambiar_s_n (){							if (frn.get("salto_de_pagina") &= "S"){									frn.set("salto_de_pagina", "N");				}else{									frn.set("salto_de_pagina", "S");								}										}															fun GenerarReporte(){				var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var cuboResultados, xmlRequest,sqlXmlResultados,xmlCurDocto,xmlCurMovto,cmd,ok,mensaje;				var contordenes, totordenes ;				var fecha_orden , folio_orden, nombre_cli, mano_de_obra, refacciones, tots, cargos_varios, subtotal, iva, total, dias, asesor, flujo_srv;								kdb.kde("KDE");//Configuración del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();				var incluir_salto_pagina= frn.get("salto_de_pagina");								kdb.readPage("datos","rep_horas_operariosfto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parámetros finales de impresión.(rep.page(...);)				rep.set("suc_desc",frn.get("cmb_sucursal",-1,0));				rep.set("rep_fecha",fechaImpresion);				rep.set("rep_hora",horaImpresion);				rep.set("fecha_1",frn.get("fecha_inicial"));				rep.set("fecha_2",frn.get("fecha_final"));				rep.exe("encabezado");								setXml(xmlRequest,"document","sucursal_id",frn.get("cmb_sucursal",-1,1));				setXml(xmlRequest,"document","fecha_inicial",frn.get("fecha_inicial"));				setXml(xmlRequest,"document","fecha_final",frn.get("fecha_final"));				setXml(xmlRequest,"document","operario_inicial",frn.get("operario_inicial"));				setXml(xmlRequest,"document","operario_final",frn.get("operario_final"));								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestHorasOperarios");								cmd="select * from keplersc.rep_horas_operarios('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_horas_operarios.GenerarReporte()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultadoscoaches");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								cuboResultados= getXmlAtt(cuboResultados,"r0","rep_horas_operarios");				cuboResultados= delScpScn(cuboResultados);				setXmlStr(cuboResultados,cuboResultados);								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultadosopeshorasXML");								var totres = nXml(cuboResultados);								for (var contres=0; contres<=totres ; contres++){						var cubo_horas =  getXml(cuboResultados, "r" & contres , "horas");										var tot_horas = nXml(cubo_horas);										if ( getXml(cubo_horas , "r1" , "orden") &! ""){						rep.set("nombre_operario", getXml(cuboResultados, "r" & contres , "operario"));						rep.exe("operario");					}										for (var conthoras=1; conthoras<=tot_horas  ; conthoras++){											rep.set("orden", getXml(cubo_horas , "r" & conthoras, "orden"));						rep.set("punto", getXml(cubo_horas , "r" & conthoras, "punto"));						rep.set("cliente", getXml(cubo_horas , "r" & conthoras, "cliente"));						rep.set("vehiculo", getXml(cubo_horas , "r" & conthoras, "vehiculo"));						rep.set("placas", getXml(cubo_horas , "r" & conthoras, "placas"));						rep.set("horas", getXml(cubo_horas , "r" & conthoras, "horas"));						rep.exe("datos");											}										var horas_totales =  getXml(cuboResultados, "r" & contres , "totales");										if (horas_totales > 0){						rep.set( "horas_total",horas_totales );						rep.exe("horas_totales");												if (frn.get("salto_de_pagina")  &= "S" ){											rep.newPag();												rep.set("suc_desc",frn.get("cmb_sucursal",-1,0));						rep.set("rep_fecha",fechaImpresion);						rep.set("rep_hora",horaImpresion);						rep.set("fecha_1",frn.get("fecha_inicial"));						rep.set("fecha_2",frn.get("fecha_final"));						rep.exe("encabezado");																}											}																		}													rep.win();						}														//-------------------------------------------------extras------------------------------------------------						fun IniParams(){//Inicializa parámetros de impresión, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Página				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}			fun setRepPage() {//Establece los parámetros finales de impresión.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}																											}	</script></pag>