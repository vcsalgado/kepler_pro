		// New Func 20240229 by JMM
		fun ProvPago_Sec(referencia){
			var respfunc;				
				
			sucursal_id = frn.get("k_sucn",-1,1);
			respfunc = 0; //Default es sin Permiso 
			
			frn.setAtt("k_clave_pago", "available", "N");
											
			if (strlen(referencia) == 0) {
				return;
			}
			
			cmdQuery = "select * from keplersc.param_opc_usr_sec where sucursal = '" & sucursal_id & "' " & 
				"and upper(opcion) = upper('Proveedor Pago') and upper(usuario) = upper('" & referencia & "')";
			
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ProvPagoSec()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;	
			}
			/*
			if ( nXml(cuboQuery) == 0 ) {
				respfunc = 0;
			}
			*/
			respfunc = nXml(cuboQuery);
			
			if ( respfunc /*paramProvPago &= "P"*/ > 0 ) {
				if ( tip_ope /*&= "A"*/ == 0 ) {				
					frn.setAtt("k_clave_pago", "available", "Y");
				} else {
					frn.setAtt("k_clave_pago", "available", "N");
				}
			} else {
				frn.setAtt("k_clave_pago", "available", "N");
			}
			
			return respfunc;
							
		} // End Fun - ProvPago_Sec 
		
		
