		// New Func 20240125 by JMM
		fun BuscarUUID(referencia){
			var xmlProd, respfunc;		
				
			sucursal_id = frn.get("k_sucn",-1,1);
			respfunc = 1;
			
			tip_doc = frn.get("k_tipon",-1,4); // Added 20240126
											
			if (strlen(str_uuid) == 0) {
				frn.message("No se tiene una Referencia [UUID] para validarse ...","Error","Aceptar");
				return;
			}
			
			/*
			cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &
				"and c2 = '" & gen_doc & "' and c3 = '" & nat_doc & "' and c4 = " & gpo_doc & " and c5 = " & tip_doc & " and c11 = '" & referencia & "'";
			*/
			
			// Query updated at { C x P } validation, 20240201 
			cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &
				"and c2 = 'X' and c3 = 'A' and c11 = '" & referencia & "' and c43 <> 'C'";	 
				
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comopecompras.BuscaFactura()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;	
			}
			/*
			if ( nXml(cuboQuery) == 0 ) {
				respfunc = 0;
			}
			*/
			respfunc = nXml(cuboQuery);
			
			return respfunc;
							
		} // End Fun - BuscarUUID
		

		// New Func 20240125 by JMM
		fun Validar_Fecha_UUID() {
			var fech_hoy, fech_ini, fech_limit, strFecha, strTmp, fech_lim_ini, fech_lim_fin, fech_buff;
			var aj_dias, respfunc, gapDias,superUsuario,mensajeAdv,mensajeProceso;
		
			respfunc = 0;

			//VCSS 03/07/2024 Obtener usuario con nivel para poder hacer operaciones sin validaciones
			cmdQuery="SELECT count(*) as superusuario from keplersc.param_opc_usr_sec where sucursal = '" & sucursal_id & "' and opcion = 'Operaciones Sin Validacion GAP' and usuario='" & usuario & "'";
			rstXml(cuboQuery);				
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");
					
			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlSuperUsuario");
					
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return respfunc;
			}
			superUsuario = getXmlAtt(cuboQuery,"r0","superusuario");

			// { GAP Dias Fecha Gastos }
			cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Dias Fecha Gastos'";
			rstXml(cuboQuery);				
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");
					
			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPDias");
					
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return respfunc;
			}
			if (nXml(cuboQuery) > 0) {
				gapDias = getXmlAtt(cuboQuery,"r0","paramvalor");
			} else {
				frn.message("Hubo problemas para obtener los Parametros [GAP Dias Fecha Gastos] ...","Error","Aceptar");
				return respfunc;
			}
				
			fech_hoy = sys.date();
	
			strFecha = fnDate("year", fech_hoy) & "/" /*"-"*/;
			strTmp = fnDate("month", fech_hoy);
			if(strlen(strTmp) == 1){
				strTmp = "0" & strTmp;
			}
			strFecha = strFecha & strTmp & "/" /*"-"*/ & "01";
					
			fech_ini = strFecha;
			
		
			//fech_hoy = "2024/12/05";  // For testing calc fech 
			strTmp = fnDate("month", fech_hoy);
			if ( strTmp == 12 ) {
				strFecha = fnDate("year", fech_hoy) & "/12/31";
				
				fech_limit = strFecha;
				
			} else {
				strFecha = fnDate("year", fech_hoy) & "/";
				strTmp = fnDate("month", fech_hoy) + 1;
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp & "/" & "01";
				
				fech_limit = fnDate("add",strFecha,-1);
				
			} 
			
			//fech_limit = fnDate("add",fech_limit,gapDias);  // Not Apply 
			fech_limit = formato_fecha(fech_limit);
			
			
			if ( gapDias > 0 ) { 
				aj_dias = (gapDias /*+ 1*/) * (-1); 
			} else {
				aj_dias = gapDias /*- 1*/;
			}
			if ( gapDias == 0 ) {
				fech_buff = fech_hoy;
			} else {
				fech_buff = fnDate("add", fech_hoy, aj_dias);
			}
			strTmp = fnDate("month", fech_buff);
			if ( strTmp == 12 ) {
				strFecha = fnDate("year", fech_buff) & "/12/31";
				
				fech_lim_fin = strFecha;
				
			} else {
				strFecha = fnDate("year", fech_buff) & "/";
				strTmp = fnDate("month", fech_buff) + 1;
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp & "/" & "01";
				
				fech_lim_fin = fnDate("add",strFecha,-1);
				
			} 
					
			fech_lim_fin = formato_fecha(fech_lim_fin);		
					
			strFecha = fnDate("year", fech_lim_fin) & "/";
			strTmp = fnDate("month", fech_lim_fin);
			if(strlen(strTmp) == 1){
				strTmp = "0" & strTmp;
			}
			strFecha = strFecha & strTmp & "/" /*"-"*/ & "01";
			
			fech_lim_ini = strFecha;
			fech_lim_ini = formato_fecha(fech_lim_ini);
			
			
			if ( strlen( frn.get("k_uuid_fecha") ) == 0 ) {
				frn.message("No hay Fecha UUID de Referencia para validar ...","Error","Aceptar");
				return respfunc;
			} 
			
			strFecha = frn.get("k_uuid_fecha");
			strFecha = formato_fecha(strFecha);
			
			//VCSS	INI Validaciones para usuarios normales (no superUsuario)
			if (superUsuario != "1"){
				if ( fnDate("cmp", strFecha, fech_hoy) > 0 /*strFecha > fech_hoy*/ ) {
					mensajeError="La Fecha del UUID, es mayor al dia de hoy ..." & "|" & " " & "|" & " " & strFecha;
					mensajeAdv=mensajeAdv & "; " & mensajeError;
					frn.message(mensajeError ,"Error","Aceptar");
					return respfunc;
				} 
			
				if ( fnDate("cmp", strFecha, fech_limit) > 0 /*strFecha > fech_limit*/ ) {
					mensajeError = "La Fecha del UUID, fuera de Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;
					mensajeAdv=mensajeAdv & "; " & mensajeError;
					frn.message(mensajeError ,"Error","Aceptar");
					return respfunc;
				} 
			
				if ( fnDate("cmp", strFecha, fech_ini) < 0 /*strFecha < fech_ini*/ ) {
					if ( fnDate("cmp", strFecha, fech_lim_ini) < 0 /*strFecha < fech_lim_ini*/ ) {
						mensajeError = "La Fecha del UUID, es menor al Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;
						mensajeAdv=mensajeAdv & "; " & mensajeError;
						frn.message(mensajeError ,"Error","Aceptar");
						return respfunc;
					} else {
						if ( fnDate("cmp", strFecha, fech_lim_fin) > 0 /*strFecha > fech_lim_fin*/ ) {
						mensajeError = "La Fecha del UUID, fuera del Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;
						mensajeAdv=mensajeAdv & "; " & mensajeError;
						frn.message(mensajeError ,"Error","Aceptar");
						return respfunc;
						}
					}
				}
			} 

			//VCSS 17/06/2024 INI Evaluacion de fecha de transaccion, las transacciones que se realizan dentro de los primeros 
			//dias del mes dentro del gap y la fecha del xml es del mes anterior o anteriores, 
			//se registran el día último del mes del xml
			var fechaMovto,fechaXml,fechaRefer,mesesDif; 
			fechaXml= frn.get("k_uuid_fecha");
			fechaXml= formato_fecha(fechaXml);
							
			var diaMovto=fnDate("day", fech_hoy);
			var mesMovto=fnDate("month",fechaXml);

			//Calcular dierencia en meses del mes actual y del xml	
			strTmp=fnDate("month",fechaXml);
			if(strlen(strTmp) == 1){
				strTmp = "0" & strTmp;
			}							
			fechaXml=fnDate("year",fechaXml) & "/" & strTmp & "/" & "01";
			
			strTmp=fnDate("month",fech_hoy);
			if(strlen(strTmp) == 1){
				strTmp = "0" & strTmp;
			}				
			fech_hoy=fnDate("year",fech_hoy) & "/" & strTmp & "/" & "01";

			//Validar si xml es del mismo mes
			if (fnDate("cmp",fechaXml,fech_hoy) == 0){ //Mismo mes
				mesesDif=0;
			}else{
				fech_hoy=fnDate("add",fech_hoy,-1);
				fech_hoy= formato_fecha(fech_hoy);
				strTmp=fnDate("month",fech_hoy);
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}				
				fech_hoy=fnDate("year",fech_hoy) & "/" & strTmp & "/" & "01";
								
				if (fnDate("cmp",fechaXml,fech_hoy) == 0){
					mesesDif=1;
				}else{
					mesesDif=2;
				}
			}
				
			fechaMovto= frn.get("k_uuid_fecha");
			if(mesesDif==2 && superUsuario==0){
				mensajeError = "La Fecha del UUID, " & fechaMovto & " está fuera del Periodo Vigente.";
				frn.message(mensajeError ,"Error","Aceptar");
				return respfunc;
			}

			if (mesesDif != 0){
				fechaMovto= frn.get("k_uuid_fecha");
				strTmp=fnDate("month",fechaMovto);
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}							
				fechaMovto=fnDate("year",fechaMovto) & "/" & strTmp & "/" & "31";
				fechaMovto=formato_fecha(fechaMovto);
				frn.set("k_fecha",fechaMovto);
				frn.message("Los movimientos de meses anteriores se registrarán al último día del mismo mes.","Mensaje","Aceptar");
			}
			//VCSS 17/06/2024 FIN Evaluacion de fecha de transaccion...

			respfunc = 1;
			return respfunc;
		
		} // End Fun - Validar_Fecha_UUID


		// New Func 20240125 by JMM
		fun formato_fecha(fech) {
			var strFech, tmpData;
			
			strFech = fnDate("year", fech) & "/";
			tmpData = fnDate("month", fech);
			if(strlen(tmpData) == 1){
				tmpData = "0" & tmpData;
			}
			strFech = strFech & tmpData & "/";
			tmpData = fnDate("day", fech);
			if(strlen(tmpData) == 1){
				tmpData = "0" & tmpData;
			}
			strFech = strFech & tmpData;
			
			return strFech;
	
		} // end fun - formato_fecha		
		

		//New Fuc 20240125 by JMM	(replacing original below)
		fun ObtenerFactura(){
			var nCampos, uuid="";
			//Regresara la funcion UUID cadena con UUID, rfc, fecha, total
			// Added 20240119 by JMM
			var NewProv;
			
			limpiar_datos_uuid();
			
			uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID","k_refer", 0,"0");
			// Replaced with new function, 20240111 
			//uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID_Extended","k_refer", 0,"0");
			
			nCampos = strSplit(uuid,"|",-1);
			if (nCampos > 1) {
					str_uuid = strSplit(uuid,"|",0);		  //UUID
					rfc_uuid = strSplit(uuid,"|",1);		  //rfc
					fecha_uuid = strSplit(uuid,"|",2);	  //fecha
					total_uuid = strSplit(uuid,"|",3);	  //monto de la factura
					
					// Added 20240111 by JMM
					nombre_uuid = strSplit(uuid,"|",5);	  //nombre
					regimen_uuid = strSplit(uuid,"|",6);  //regimen
					folio_uuid = strSplit(uuid,"|",7);	  //folio
					serie_uuid = strSplit(uuid,"|",8);	  //serie
				
					// Added 20240301 by JMM
					impuesto_uuid = strSplit(uuid,"|",9); //impuesto
					
					//Added by JMM 20240617
					retisr_uuid = strSplit(uuid,"|",10); //retencion isr
					retiva_uuid = strSplit(uuid,"|",11); //retencion iva
				
					// Conditions Added 20240111  by JMM
					if ( strlen(/*folio_uuid*/nombre_uuid) == 0 || strlen(rfc_uuid) == 0 || strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {
					
						//frn.set("k_refer","");
						frn.message("No se pudieron obtener todos los datos mandatorios del UUID.","Error","Aceptar");
						
					} else {
					
						frn.set("k_refer",str_uuid);
						frn.set("k_rfc",rfc_uuid);
						
						if ( BuscarUUID(str_uuid) > 0 ) {
							//frn.set("k_rfc","");
							frn.set("k_clave","");
							frn.message("Este Documento [UUID] ya ha sido Asociado previamente ...","Error","Aceptar");
							return;
						} 
							
						frn.set("k_uuid_fecha",mid(fecha_uuid,0,10));
						if ( Validar_Fecha_UUID() == 0 ) { 
							//frn.set("k_rfc","");
							frn.set("k_clave","");
							return;
						}
						
						NewProv = "";
						NewProv = BuscarProveedor();
						if (strlen(NewProv) > 0/*== 1*/) {
							//BuscarProveedor(NewProv);
							NewProvId = NewProv;
							frn.set("k_clave",NewProvId);
						} else {
							NewProvId = "";
						}
						
						if ( strlen(frn.get("k_clave")) > 0 && frn.get("k_clave") &! strFormat("ucase","No Existe ...") ) {
							
							// Validations Moved UP by JMM 20240119 ( BuscarUUID, Validar_Fecha_UUID )
												
							frn.set("k_uuid_serie",serie_uuid);
							frn.set("k_uuid_folio",folio_uuid);
							frn.set("k_uuid_monto",total_uuid);
							frn.set("k_uuid_fecha",mid(fecha_uuid,0,10));
							
							// Added 20240301 by JMM
							frn.set("k_uuid_impuesto",impuesto_uuid);
							
							//Added 20240301 by JMM
							frn.set("k_iva",impuesto_uuid);
							
							// Added 20240617 by JMM
							frn.set("k_uuid_retisr",retisr_uuid);
							frn.set("k_uuid_retiva",retiva_uuid);
							
							// Added 20240619 by JMM
							var sumrets = retisr_uuid + retiva_uuid;
							frn.set("k_sumrets",sumrets);
			
						}
					}
			} else{
				//frn.set("k_refer","");
				frn.message("Faltan datos del UUID ...","Error","Aceptar");		
			}
		}	// End Fun - Obtener Factura


		//New Fuc 20240125 by JMM
		fun ProcesarFactura() {
		
			ObtenerFactura();
			
			if ( strlen(NewProvId) > 0 ) {
				prov_data_upd(NewProvId);
			}
			
			// Se elimina esta parte porque l ejecuta antes de abrir el dialogo ...
			// /*
			if ( strlen(NewProvId) > 0 ) {
				BuscarProveedor();
			}
			// */
			
		} // End Fun - ProcesarFactura
					
		
		// Added by JMM, 20240201
		fun BuscarDOCUUID(referencia){
			var xmlProd, respfunc;		
				
			sucursal_id = frn.get("k_sucn",-1,1);
			respfunc = 1;
			
			tip_doc = frn.get("k_tipon",-1,4); // Added 20240126
			
			// Added 20240201
			frn.set("k_uuid_serie","");
			frn.set("k_uuid_folio","");
			frn.set("k_uuid_monto","");
			frn.set("k_uuid_fecha","");
			//Added by JMM, 20240301
			frn.set("k_uuid_impuesto","");
			frn.set("k_clave_pago", "");
			frn.set("k_nombreprov_pago", "");
			//Added by JMM 20240617
			frn.set("k_uuid_retisr","");	
			frn.set("k_uuid_retiva","");
											
			if (strlen(/*str_uuid*/referencia) == 0) {
				//frn.message("No se tiene una Referencia [DOC] para la Info UUID ...","Error","Aceptar"); // Commented 20240201
				return;
			}
			
			// UPD 20240301 by JMM, Adding Impuesto & ProvPago
			cmdQuery = "select /*c11 as referencia*/ uuid_serie, uuid_folio, uuid_fecha, uuid_total, uuid_impuesto, cve_prov_pago " &
				", uuid_retisr, uuid_retiva /*Added by JMM 20240617*/" & 
				"from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &
				"and c2 = '" & gen_doc & "' and c3 = '" & nat_doc & "' and c4 = " & gpo_doc & " and c5 = " & tip_doc & " and /*c11*/c6 = '" & referencia & "'";
			
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comopecompras.BuscaFactura()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;	
			}
			///*
			if ( nXml(cuboQuery) == 0 ) {
				respfunc = 0;
			} else {
				frn.set( "k_uuid_serie", getXmlAtt(cuboQuery,"r0", "uuid_serie") );
				frn.set( "k_uuid_folio", getXmlAtt(cuboQuery,"r0", "uuid_folio") );
				frn.set( "k_uuid_monto", getXmlAtt(cuboQuery,"r0", "uuid_total") );
				frn.set( "k_uuid_fecha", mid( getXmlAtt(cuboQuery,"r0", "uuid_fecha") ,0,10)  );
				// Added 20240301
				frn.set( "k_uuid_impuesto", getXmlAtt(cuboQuery,"r0", "uuid_impuesto") );
				frn.set( "k_clave_pago", getXmlAtt(cuboQuery,"r0", "cve_prov_pago") );
				// Added 20240617
				frn.set( "k_uuid_retisr", getXmlAtt(cuboQuery,"r0", "uuid_retisr") );
				frn.set( "k_uuid_retiva", getXmlAtt(cuboQuery,"r0", "uuid_retiva") );
			}
			//*/
			respfunc = nXml(cuboQuery); 
			
			// Added by JMM 20240301
			var vProvPago = trim(frn.get("k_clave_pago"));
			if ( strlen(trim(frn.get("k_clave"))) > 0 ) {
				if ( strlen( vProvPago ) > 0 ) { BuscarProvPago(); }
			}
			
			//return respfunc; // commenmted 20240201
			return;
							
		} // End Fun - BuscarDOCUUID
		
		
		// Added by JMM, 20240328
		fun GetTotalesDOC(referencia){
			var xmlProd, respfunc;
				
			sucursal_id = frn.get("k_sucn",-1,1);
			respfunc = 1;
			
			tip_doc = frn.get("k_tipon",-1,4); // Added 20240126
			
			frn.set("subt","");
			frn.set("k_iva","");			
			frn.set("k_monto","");
			frn.set("k_sumrets",""); //Added by JMM 202240619
			
											
			if (strlen(/*str_uuid*/referencia) == 0) {
				//frn.message("No se tiene una Referencia [DOC] para la Info UUID ...","Error","Aceptar"); // Commented 20240201
				return;
			}
			
			cmdQuery = "select c16 as tot, c14 as iva, ( c16 - coalesce(c14,0) ) as sub " &
				"/*Added by JMM 20240619*/ ,c15 as retisr, c23 as retiva " & 
				"from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &
				"and c2 = '" & gen_doc & "' and c3 = '" & nat_doc & "' and c4 = " & gpo_doc & " and c5 = " & tip_doc & " and /*c11*/c6 = '" & referencia & "'";
			
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comopecompras.BuscaFactura()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;	
			}
			///*
			if ( nXml(cuboQuery) == 0 ) {
				respfunc = 0;
			} else {
			
				//Added by JMM 202240619
				var vretisr = getXmlAtt(cuboQuery,"r0", "retisr");
				var vretiva = getXmlAtt(cuboQuery,"r0", "retiva");
				var sumrets = vretisr + vretiva;
				frn.set( "k_sumrets", sumrets );
			
				//Adapted by JMM 202240619
				/*
				frn.set( "subt", getXmlAtt(cuboQuery,"r0", "sub") );
				frn.set( "k_iva", getXmlAtt(cuboQuery,"r0", "iva") );
				frn.set( "k_monto", getXmlAtt(cuboQuery,"r0", "tot") );
				*/
				var iva = getXmlAtt(cuboQuery,"r0", "iva");
				var tot = getXmlAtt(cuboQuery,"r0", "tot");
				frn.set( "k_iva", iva );
				frn.set( "k_monto", tot );
				var vsubt = tot - iva + sumrets;
				frn.set( "subt", vsubt );
				
			}
			//*/
			respfunc = nXml(cuboQuery); 
						
			//return respfunc; // commenmted 20240201
			return;
							
		} // End Fun - GetTotalesDOC
		
		
