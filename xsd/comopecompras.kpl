			fun ConfiguraCamposOpcion(){
				var strValAtr;
				ConfiguraControlesOff();
				//HAbilita segun tipo de operacion
				strValAtr = "Y";
				switch(tip_ope){
					case 0: //Alta
						frn.setAtt("grpDatosGenerales","available",strValAtr);
						frn.setAtt("grpDatosGenerales","modify",strValAtr);
						frn.setAtt("grDocumentos","available",strValAtr);
						frn.setAtt("grDocumentos","modify",strValAtr);
						frn.setAtt("grpDetalle","available",strValAtr);
						frn.setAtt("grpDetalle","modify",strValAtr);
						frn.setAtt("grpProveedor","available",strValAtr);
						frn.setAtt("grpProveedor","modify",strValAtr);
						frn.setAtt("grpPartidas","available",strValAtr);
						frn.setAtt("grpPartidas","modify",strValAtr);
						frn.setAtt("Aceptar","available",strValAtr);
						frn.setAtt("Aceptar","visible",strValAtr);	
						frn.setAtt("Cancelar","available",strValAtr);
						frn.setAtt("Cancelar","visible",strValAtr);		
						
						frn.setAtt("k_fecha","modify",strValAtr);	
						frn.setAtt("k_fecha","available","N"/*strValAtr*/); // 20240124
						
						frn.setAtt("k_refer","available","N"); // 20240124 
						frn.setAtt("k_clave", "available", "N"); // 20240124

						frn.setAtt("k_fecRef","modify",strValAtr);	
						frn.setAtt("k_fecRef","available",strValAtr);

						frn.setAtt("k_plazo","modify","N"/*strValAtr*/);	
						frn.setAtt("k_plazo","available","N"/*strValAtr*/);

						frn.setAtt("k_cond","modify","N"/*strValAtr*/);	
						frn.setAtt("k_cond","available","N"/*strValAtr*/);	
						
						frn.setAtt("k_coment","modify",strValAtr);
						frn.setAtt("k_coment","available",strValAtr);						
						
						frn.setAtt("k_mov","modify",strValAtr,"k_parte");
						frn.setAtt("k_mov","available",strValAtr,"k_parte");
						frn.setAtt("k_mov","modify",strValAtr,"k_unidad");
						frn.setAtt("k_mov","available",strValAtr,"k_unidad");
						frn.setAtt("k_mov","modify",strValAtr,"k_precio");
						frn.setAtt("k_mov","available",strValAtr,"k_precio");
						frn.setAtt("k_mov","modify",strValAtr,"k_monto");						
						frn.setAtt("k_mov","available",strValAtr,"k_monto");
						
						frn.setAtt("buscar_folio", "available", "N"); // 20240301
						frn.setAtt("buscar_folio", "visible", "N"); // 20240301
						
						// Added by JMM 20240301
						frn.setAtt("Buscar", "visible", "Y");
						frn.setAtt("Buscar", "available", "Y");
						// Added by JMM 20240301
						if ( paramProvPago /*&= "P"*/ > 0 ) {				
							frn.setAtt("k_clave_pago", "available", "Y");
						} else {
							frn.setAtt("k_clave_pago", "available", "N");
						}
				
						break;
					case 1: //Consulta
						frn.setAtt("grpDatosGenerales","available",strValAtr);
						frn.setAtt("grpProveedor","available",strValAtr);
						frn.setAtt("grpProveedor","modify",strValAtr);
						frn.setAtt("k_folio","modify",strValAtr);	
						frn.setAtt("k_folio","visible",strValAtr);					
						frn.setAtt("foliotxt","visible",strValAtr);					
						frn.setAtt("Imprimir","available",strValAtr);
						frn.setAtt("Imprimir","visible",strValAtr);
						
						frn.setAtt("buscar_folio", "available", "Y"); // 20240301
						frn.setAtt("buscar_folio", "visible", "Y"); // 20240301
						
						frn.setAtt("Buscar","available","N");	// 20240301
						frn.setAtt("Buscar","visible","N");	// 20240301
						
						frn.setAtt("k_clave_pago", "available", "N"); // Added by JMM, 20240301 
						
						break;
					case 2:
						//Baja
						frn.setAtt("grpDatosGenerales","available",strValAtr);
						frn.setAtt("grpProveedor","available",strValAtr);
						frn.setAtt("grpProveedor","modify",strValAtr);
						frn.setAtt("k_folio","modify",strValAtr);	
						frn.setAtt("k_folio","visible",strValAtr);					
						frn.setAtt("foliotxt","visible",strValAtr);					
						frn.setAtt("buscar","visible",strValAtr);
						frn.setAtt("Aceptar","available",strValAtr);
						frn.setAtt("Aceptar","visible",strValAtr);	
						frn.setAtt("Cancelar","available",strValAtr);
						frn.setAtt("Cancelar","visible",strValAtr);	
						
						frn.setAtt("buscar_folio", "available", "Y"); // 20240301
						frn.setAtt("buscar_folio", "visible", "Y"); // 20240301
						
						frn.setAtt("Buscar","available","N");	// 20240301
						frn.setAtt("Buscar","visible","N");	// 20240301
						
						frn.setAtt("k_clave_pago", "available", "N"); // Added by JMM, 20240301 
							
						break;
					default:
				}
			}
			
			fun BorraDatos(){ //Limpia todos los campos para generar un nuevo documento. 
				frn.set("k_folio","","statusDoc","","k_clave","","k_refer","","k_fecRef",""); 
				frn.rst("k_mov");
				frn.rst("k_poliza");				
				Clave(1);
				
				// Added by JMM 20240119
				limpiar_datos_uuid();	
				//Added by JMM, 20240229
				frn.set("k_clave_pago", "");
				frn.set("k_nombreprov_pago", "");				
				
				// Added by JMM 20240301
				paramProvPago = ProvPago_Sec(usuario);
				
				// Added by JMM 20240619
				frn.set("subt","");
				frn.set("k_iva","");	
				frn.set("k_sumrets","");		
				frn.set("k_monto","");
				
				if ( tip_ope>0 ) frn.setPos("k_folio");				
			}
			
			fun addDocto(Descripcion,Gen,Nat,Gru,bTipo_Especifico,bSoloAutorizado,NatPrv,GruPrv,Gru2Prv){
				var renglon=frn.N("grpDoc");
				frn.setX(trim(Descripcion),"grpDoc",renglon,0);
				frn.setX(trim(Gen),"grpDoc",renglon,1);
				frn.setX(trim(Nat),"grpDoc",renglon,2);
				frn.setX(trim(Gru),"grpDoc",renglon,3);
				frn.setX(trim(bTipo_Especifico),"grpDoc",renglon,4);
				frn.setX(trim(bSoloAutorizado),"grpDoc",renglon,5);
				frn.setX(trim(NatPrv),"grpDoc",renglon,6);
				frn.setX(trim(GruPrv),"grpDoc",renglon,7);
				frn.setX(trim(Gru2Prv),"grpDoc",renglon,8);
			}
			
		
			fun Clave(iModo){//Actualiza los datos del cliente o Proveedor
				if(iModo==0){
					var cmd="datos,u,1,0,'" & frn.get("k_clave") & "',&,u1...u50,v3";kdb.rel("v2=u12"); kdb.search(cmd); 
					kdb.exec(); 
					if(kdb.ok("datos")==0){
						if(strlen(trim(frn.get("k_clave")))>0)	frn.message("La clave "&frn.get("k_clave")&" no se encontró","Error","&Aceptar");
						frn.setPos("k_clave");//La clave no existe
					}
				}else{kdb.rst("datos");}//Borra la info anterior
				frn.set("k_clave",kdb.get("datos","u2"),"k_rfc",kdb.get("datos","u10"),"k_plazo",kdb.get("datos","u16"));
				frn.set("k_nombreprov",kdb.get("datos","u3"));
				frn.set("k_calleprov",kdb.get("datos","u4"));
				frn.set("k_coloniaprov",kdb.get("datos","u5"));
				frn.set("k_poblacionprov",kdb.get("datos","u6"));
				frn.set("k_cpprov",kdb.get("datos","u27"));
				
				validar_uuid = kdb.get("datos","u29");
				if (validar_uuid &="N"){
					//frn.set() k_ref, Buscar
					frn.setAtt("k_refer","visible","Y");
					frn.setAtt("k_refer","modify","Y");
					frn.setAtt("k_refer","available","Y");					
					frn.setAtt("Buscar","modify","N");
					frn.setAtt("Buscar","available","N");	
				}else{
					frn.setAtt("k_refer","visible","Y");
					frn.setAtt("k_refer","modify","N");
					frn.setAtt("k_refer","available","N");					
					frn.setAtt("Buscar","modify","Y");
					frn.setAtt("Buscar","available","Y");
				}				
				
 
				//frn.setM("k_datCve",kdb.get("datos","u3"),kdb.get("datos","u4"),kdb.get("datos","u5"),kdb.get("datos","u6"),kdb.get("datos","u27"));
				frn.setM("k_coment",kdb.get("datos","u24"),kdb.get("datos","u25"),kdb.get("datos","u26"));
				
				Plazo();
				CalcTotal();//para que aplique descuentos, etc.
			}
			
			fun Plazo(){ //Calcula la fecha de pago, y las condiciones de pago en base al plazo
				frn.set("k_vence",fnDate("addC",frn.get("k_fecha"),frn.get("k_plazo")));//Suma dï¿½as comerciales
				var cond=frn.get("k_plazo") & " días fecha factura";
				if (frn.get("k_plazo")==0) cond="Pago de contado";
				frn.set("k_cond",cond);  
			}
			
			fun Fecha(){//Verifica que la fecha del documento sea correcta. Ademas trae monedas y paridades de esa fecha. 
				var cubo, cmd, resValidacion, resMensaje, fecha;
				var validDate=frn.lib("libKepler","ValidOpDate",frn.get("k_fecha"));
				
				
				frn.set("k_moneda","PESOS");
				frn.set("k_paridad",1);
				
				kdb.rst();
				frn.rst("results");
				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));

				if (tip_ope == 0 ){
					cmd= "select * from keplersc.verify_year('" & fecha & "')";
					cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Fecha()");									;
					
					resValidacion= getXml(cubo,"validacion","resultado");
					resMensaje = getXml(cubo,"validacion","mensaje");
					if(resMensaje &! ""){
						frn.message(resMensaje, "Mensaje","&Aceptar");
					}
						
					if(resValidacion &= "0"){
						frn.setPos("k_fecha");
						return;
					}					
				}
				//Plazo(); // Commented by JMM 20240131
			}
			
			
			fun CalcTotal(){ //Calcula los importes parciales y el total
			
				//Added & Commented by JMM 20240328 
				if (tip_ope >/*==*/ 0 ) { return; }
				
				//Commented by JMM 20240328
				//var bConsulta=((tip_ope>=1)&&(tip_ope<=3))?1:0;//Se esta consultando el documento. Solo recalcular subtotales
				
				var T=0,IVA=0; //SUBTOTAL, IVA x partida
				// Added by JMM 20240301
				var subTotal=0, total=0; 
				// Added by JMM 20240619 
				var retisr=0, retiva=0, sumrets=0;
			
				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {
					if ( (frn.get("k_mov",i,"k_precio")==0)&&(frn.get("k_mov",i,"k_monto")>0) ){//Se requiere calcular el precio en base al importe
						var prc=frn.get("k_mov",i,"k_monto")/frn.get("k_mov",i,"k_q");
						frn.setX(prc,"k_mov",i,"k_precio"); 
					}
					var imp=frn.get("k_mov",i,"k_q")*frn.get("k_mov",i,"k_precio");//importe de partida
					if (frn.get("k_mov",i,"k_parte") &! ""){
						frn.setX(imp,"k_mov",i,"k_monto");
					}
					
					T=T+ math("round",imp,2);
					
					//Commented by JMM 20240328 
					/*
					//Impuesto por producto
					if (frn.get("k_tipon",-1,6)==99)//Iva por producto
						if (frn.get("k_mov",i,"k_iva")<0){
								T=T-math("round",imp,2);
								imp=frn.get("k_mov",i,"k_q")*frn.get("k_mov",i,"k_precio");//importe de partida
							  imp=imp/(1+((-1)*(frn.get("k_mov",i,"k_iva")/100)));//desglosar el IVA
							  
								T=T+ math("round",imp,2);
								IVA=IVA+imp*(-1)*(frn.get("k_mov",i,"k_iva")/100);
							
						}else {
							
							IVA=IVA+imp*frn.get("k_mov",i,"k_iva")/100;
						}	
					*/
									
				}
				frn.set("subt",T); // Aqui se asigna el SubTotal, Note by JMM 20240301

				//Commented by JMM 20240328
				/*if(bConsulta)return;*/
				
				// Commented by JMM 20240301
				/*
				if (frn.get("k_tipon",-1,6)==99){
					frn.set("k_iva",IVA*0.16);//Al tener iva por producto;
				}
				else{
					frn.set("k_iva",(frn.get("subt"))*frn.get("k_tipon",-1,6)/100);
				}
				*/
				

				// Added by JMM 20240619
				retisr = frn.get("k_uuid_retisr");
				retiva = frn.get("k_uuid_retiva");
				sumrets = retisr + retiva;
				
				// Added by JMM 20240301
				subTotal = T;
				IVA = frn.get("k_uuid_impuesto");
				if ( subTotal == 0 ) {
					total = 0;
				} else {
					total = subTotal + IVA - sumrets; // Adapted by JMM 20240619
				}

				
				// Commented by JMM 20240301
				/*
				frn.set("k_ivaRet",frn.get("subt")*frn.get("k_tipo",-1,8)/100);
				frn.set("k_monto",frn.get("subt")+frn.get("k_iva")-frn.get("k_ivaRet"));
				*/
				
				// Added by JMM 20240301
				/*frn.set("k_subtotal",subTotal);*/
				frn.set("k_iva",IVA);			
				frn.set("k_monto",total);
				frn.set("k_sumrets",sumrets); // Added by JMM 20240619

			}
			
			
			
			fun Producto() {//Llena el renglon actual con la informaciï¿½n del producto
				var cmd, cuboProd, ok, mensajeError, prodExiste ,xmlProducto, xmlReqEst, xmlEstadistica, prodBuscar;
				var cuboCosto, costo,valorRetorno, prod_original;
			
				prodBuscar = frn.get("k_mov",-1,"k_parte"); //
				valorRetorno = frn.get("k_mov",-1,"k_parte");
				
				frn.setX("","k_mov",-1,"k_parte");
				frn.setX("","k_mov",-1,"k_descr");
				frn.setX("","k_mov",-1,"k_q");
				frn.setX("","k_mov",-1,"k_unidad");
				frn.setX("","k_mov",-1,"k_precio");
				frn.setX("","k_mov",-1,"k_monto");
			
				cmd="select * from keplersc.prod_obtener_original('" & valorRetorno & "')";

				cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Producto()");

				ok=getXmlAtt(cuboProd,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboProd,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}				
				
				prod_original = getXmlAtt(cuboProd,"r0","prod_obtener_original");

				if (prod_original &= "0"){
					mensajeError="El producto " & valorRetorno & " no existe como original.";
					frn.message(mensajeError,"Error","&Aceptar");
					return;
				}

				//Obtener detalle de producto
				rstXml(cuboProd);
				
				cmd = "select c1,c2,c19,c11 from keplersc.kdini where c1 = '" & prod_original &  "'"; 
				cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.ValidaArticulo()");
	//frn.lib("libGeneral.kpl","FileSave",cuboProd,"C:\Basura\cuboProd");
				ok=getXmlAtt(cuboProd,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboProd,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				//frn.setX(getXmlAtt(cuboProd,"r0","c1"),"k_mov",-1,"k_parte");					
				//frn.setX(getXmlAtt(cuboProd,"r0","c2"),"k_mov",-1,"k_descr");	
				

				//Obtener el costo promedio para aplicar como precio
				rstXml(xmlReqEst);
				setXml(xmlReqEst,"document","sucursal",frn.get("k_sucn",-1,1));
				setXml(xmlReqEst,"document","clave_producto",prod_original);
				cmd="select * from keplersc.invr_obtener_costo_promedio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";
				rstXml(cuboCosto);
				cuboCosto =  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Producto()");
				frn.lib("libGeneral.kpl","FileSave",cuboCosto,"C:\Basura\cuboCosto");				
				ok=getXmlAtt(cuboCosto,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboProd,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				costo = getXmlAtt(cuboCosto,"r0","costo_prom_total");
				if (costo == 0){
					costo = getXmlAtt(cuboCosto,"r0","ultimo_costo");
				}
	
				frn.setX(prodBuscar,"k_mov",-1,"k_parte");
				frn.setX(getXmlAtt(cuboProd,"r0","c2"),"k_mov",-1,"k_descr");
				frn.setX(getXmlAtt(cuboProd,"r0","c19"),"k_mov",-1,"k_unidad");
				frn.setX(1,"k_mov",-1,"k_q");
				frn.setX(costo,"k_mov",-1,"k_precio");	
				frn.setX(prod_original,"k_mov",-1,"k_partesel");			

				//No se duplique el articulo
				refacc_duplicada();

				CalcTotal();
			}
			
			//Valida refacciones duplicadas
			fun refacc_duplicada(){	
				var renglon_id, renglones, articulo;
				renglones = frn.N("k_mov")-1;
				renglon_id = frn.getIdJ("k_mov");
				articulo = frn.get("k_mov",-1,"k_parte");
				for (var i=0; i<renglones; i++) {
					if (renglon_id != i){
						if ( (frn.get("k_mov",i,"k_parte") &= articulo)) { 
							frn.setX("","k_mov",-1,"k_parte");
							frn.setX("","k_mov",-1,"k_q");
							frn.setX("","k_mov",-1,"k_unidad");
							frn.setX("","k_mov",-1,"k_precio");
							frn.setX("","k_mov",-1,"k_monto");
							frn.setX("","k_mov",-1,"k_descr");
							frn.setX("","k_mov",-1,"k_partesel");
							frn.message("Verifique, esta intentado dar de alta la misma refaccion: "& articulo,"Error","Aceptar");
							return;
						}
					}	
				}
			}
			fun Cantidad(checa_cero){ //Si checa_cero=1, solo despliega la ventana de control auxiliar si la cantidad es 0
				var bAux=(frn.get("k_tipon",-1,10) && frn.get("k_mov",-1,"k_recAux"));
				if (checa_cero==1){
					var Qiguales=1;
					if(bAux){
						var S=0; for(var i=0,n=frn.N("k_mov",-1,"k_recAuxReal");i<n;i++) S+=frn.get("k_mov",-1,"k_recAuxReal","r" & i,"k_q");
						if(S!=frn.get("k_mov",-1,"k_q"))Qiguales=0;
					}
					if(Qiguales && frn.get("k_mov",-1,"k_q")>0)return;
				}
				if (bAux){
					frn.setPos("k_mov",-1,"k_q");
					Dialog(3,(frn.get("k_tipon",-1,2) &= "D")?"doc_aux":"doc_auxE","k_mov",frn.get("k_mov",-1,"k_bSer"),frn.get("k_mov",-1,"k_iLot"),frn.get("k_mov",-1,"k_bPed"),frn.get("k_mov",-1,"k_bUbi"),frn.get("k_mov",-1,"k_iTMC"),frn.get("k_pedimento"));
				}else{
					var bNoRojo=frn.get("k_tipon",-1,9),inv=frn.get("k_mov",-1,"k_inv"),q=frn.get("k_mov",-1,"k_q"),iNat=frn.get("k_mov",-1,"k_iNat");
					if (bNoRojo&&inv<q&&iNat&!"N"&&iNat&!"V"){
						frn.message("No se permite movimiento en rojo", "Error","&Aceptar");
						frn.setX(inv,"k_mov",-1,"k_q");
					}
				}
				CalcTotal();
			}

			fun ValidaPartidas(){
				var producto,resultado,cmd,bValido,cuboProd,ok,mensajeError,prod_original,;
				
				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {
					resultado = 1;
					producto = frn.get("k_mov",i,"k_parte");
					cmd="select * from keplersc.prod_obtener_original('" & producto & "')";
					cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Producto()");

					ok=getXmlAtt(cuboProd,"ok");
					if(ok &! "" && !ok){
						mensajeError = getXmlAtt(cuboProd,"native3");
						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
						frn.message(mensajeError,"Error","Aceptar");
						resultado = 0;
					}				
				
					prod_original = getXmlAtt(cuboProd,"r0","prod_obtener_original");

					if (prod_original &= "0"){
						mensajeError="El producto " & producto & " no existe.";
						frn.message(mensajeError,"Error","&Aceptar");
						resultado = 0;
					}					
				}
				CalcTotal();
				return resultado;
			}
			

			
