			fun Monto(){//Cambia el precio de la partida en base al monto especificado(importe de partida)
				var prc=frn.get("k_mov",-1,"k_monto")/frn.get("k_mov",-1,"k_n");
				frn.setX(prc,"k_mov",-1,"k_precio"); 
				CalcTotal();
			}
			
			fun Formar_folio(){
			
				var xmlReqEst, cubofol, cmd, ok, mensajeError ;
				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));
				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));
				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));
				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));
				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));
				setXml(xmlReqEst,"document","uen",uen);
				
				BorraDatos(); // Added by JMM 20240131
				
				cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";
				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");
				frn.lib("libGeneral.kpl","FileSave",cubofol,"C:\Basura\cuboFol");				
				var resultado =getXmlAtt(cubofol,"r0", "resultado");
				if(resultado &= "0"){
					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				var fol = getXmlAtt(cubofol,"r0", "mensaje");
				
				frn.set("k_folio", fol);
			}
			
			fun Folio(){ //Consulta el documento especificado en el campo k_folio
				var xmlDetalle,tmpStr,no_partidas;
				var cmd,ok, clave_prod,cubo,cuboProd,prod_original;
				kdb.sp("k_getDoc","datDoc",frn.get("k_sucn",-1,1),frn.get("k_tipon",-1,1),frn.get("k_tipon",-1,2),frn.get("k_tipon",-1,3),frn.get("k_tipon",-1,4),frn.get("k_folio")); 
				kdb.exec();
				xmlDetalle = kdb.get("datDoc");

				//Agregar el tag k_q, el cual debe ser igual a k_q, esto es porque postgresql maneja minusculas
				no_partidas=nXml(xmlDetalle,"k_mov");
				for(var i =0;i<no_partidas;i++){
					setXml(xmlDetalle,"k_mov","r"&i,"k_q", getXml(xmlDetalle,"k_mov","r"&i,"k_Q"));

					//Obtiene el prod_original de kdm2
					cmd = "select c8,c28 from keplersc.kdm2 where c1='" & frn.get("k_sucn",-1,1) & "' and c2= '" & frn.get("k_tipon",-1,1) & "' and c3= '" & 
						frn.get("k_tipon",-1,2) & "' and c4='" & frn.get("k_tipon",-1,3) & "' and c5= '" & frn.get("k_tipon",-1,4) & "' and c6 =upper('" & frn.get("k_folio") & "')" &
						" and c8='" & getXml(xmlDetalle,"k_mov","r"&i,"k_parte") & "'";	
					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Buscar_folio()");
					ok=getXmlAtt(cubo,"ok");
					if(ok &! "" && !ok){
						mensajeError = getXmlAtt(cubo,"native3");
						frn.message(mensajeError,"Error","Aceptar");
						return;
					}
					var lenght_xml = nXml(cubo); 
					if(lenght_xml != 0 ){
						prod_original=getXmlAtt(cubo,"r0","c28");
						
						if(prod_original &="0" || prod_original &=""){	
							clave_prod = getXml(xmlDetalle,"k_mov","r"&i,"k_parte");
							cmd="select * from keplersc.prod_obtener_original('" & clave_prod & "')";
							cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Buscar_folio()");
							prod_original = getXmlAtt(cuboProd,"r0","prod_obtener_original");
						}
						setXml(xmlDetalle,"k_mov","r"&i,"k_partesel",prod_original);
					}
					frn.rst(cubo);
					frn.rst(cuboProd);
				
				}

				frn.lib("libGeneral.kpl","FileSave",xmlDetalle,"C:\Basura\xmlConsCompra");							
				frn.setX(xmlDetalle); //Llenar grid de partes				
				frn.set("k_nombreprov",getXml(xmlDetalle,"k_nombre"));
				frn.set("k_calleprov",getXml(xmlDetalle,"k_calle"));
				frn.set("k_coloniaprov",getXml(xmlDetalle,"k_colonia"));
				frn.set("k_poblacionprov",getXml(xmlDetalle,"k_poblacion"));
				frn.set("k_cpprov",getXml(xmlDetalle,"k_163"));
				
				//Test Code ... No Funciona 
				//frn.set("k_uuid_folio",getXml(xmlDetalle,"uuid_folio"));
				BuscarDOCUUID( trim( frn.get("k_folio") ) );
				
				//Added by JMM 20240328 
				GetTotalesDOC( trim( frn.get("k_folio") ) );

				var status=kdb.get("datDoc","err");
				if (status==1001) frn.set("statusDoc","Documento referenciado");
				else if (status==1002){ BorraDatos();frn.set("statusDoc","Documento no encontrado");}
				else if (status==1003) frn.set("statusDoc","Documento cancelado");
				else frn.set("statusDoc","");
				
				// Commented by JMM 20240328 ... Replaced by Fun GetTotalesDoc
				//CalcFolio();
			}

			fun CalcFolio(){//Se ejecuta despues de consultar documento en disco (consulta,documento previo,etc), para manipulaciones adicionales en pantalla
				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {//Se recalcula el precio con mayor precisiï¿½n (decimales)
					var prc=frn.get("k_mov",i,"k_monto")/frn.get("k_mov",i,"k_q");
					frn.setX(prc,"k_mov",i,"k_precio");
				}
				CalcTotal();//Recalcula Totales
			}

			fun Ejecuta(){
				if(tip_ope==0){Alta();}
				else if(tip_ope==1){Consulta();}
				else if(tip_ope==2){Baja();}
			}
			
			
			fun Alta(){//Genera el documento en base a los datos en pantalla.
				var resultado, mensaje, adicionales, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd, vdiferencia;
				var partidasValidas = 0;
				var no_partidas, ok, mensajeError, prod_ui, prod_original,cuboProd,vdiferencia;
				//var ok, mensajeError; // 20240125 commented
				//Validar fecha
				kdb.rst();
				frn.rst("results");				
				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));
				cmd= "select * from keplersc.verify_year('" & fecha & "')";
				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Alta()");								
				resultado= getXml(cubo,"validacion","resultado");
				mensaje = getXml(cubo,"validacion","mensaje");
				if(mensaje &! ""){
					frn.message(mensaje,"Error al generar el documento","Aceptar");
					return; // Added 20240125 ... Necesario en base a la logica de los mensajes 
				}
					
				if(resultado &= "0"){
					//frn.setPos("k_fecha"); // 20240125
					return;
				}
				
				// Commented 20200128 by JMM (code replaced below)
				/*
				//Validar clave del proveedor
				if(strlen(trim(frn.get("k_clave")))==0){ 
					frn.message("Es necesario especificar la clave del Proveedor","Error","&Aceptar");
					//frn.setPos("k_clave"); // 20240115
					return;	
				}
				*/
				
				// Commented 20240128 by JMM (code replaced below)
				/*
				//Validar Factura o guia
				if(strlen(trim(frn.get("k_refer")))==""){ 
					frn.message("Es necesario especificar la factura o guía","Error","&Aceptar");
					//frn.setPos("k_refer"); // 20240125
					return;	
				}
				*/
				
				// Commented 20240128 by JMM (code replaced below)
				/*
				if(validar_uuid &= "S"){
					//Validar rfc y monto total de factura correspondan a datos de UUID
               //Sin diferencia                    
               //strTotal = frn.get("k_monto");
               //if (strTotal-total_uuid !=0) {
               //   frn.message("El importe total de la compra no corresponde al de la factura.","Error","Aceptar");
					//	frn.setPos("k_monto");return;
               //}
               
               strTotal = frn.get("k_monto");
               vdiferencia = (strTotal-total_uuid);
               if (vdiferencia < 0){
						vdiferencia = vdiferencia *(-1); 
               }
               if (vdiferencia > 0.1) {
						frn.message("El importe total de la compra no corresponde al de la factura.","Error","Aceptar");
                  return;
               }
					if (frn.get("k_rfc") &! rfc_uuid) {
						frn.message("El RFC de la compra no corresponde al de la factura.","Error","Aceptar");
						frn.setPos("Buscar");return;
					}
				}
				*/
				
			
			// Added JMM 20240301
			proveedor_pago_id = trim(frn.get("k_clave_pago"));
			
			// Section code Added by JMM 20240128 (replacing options)
				
			var gapMonto, gapDias; 
			var totReg;
			
			//Obtener variables
			sucursal_id = frn.get("k_sucn",-1,1);
			proveedor_id = frn.get("k_clave");
			refer_id = frn.get("k_refer");
				
			//Obtener PARAMs (GAPs) ... 20240128 ... NEW
			cmdQuery="SELECT count(*) as totreg from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro in ('GAP Dias Fecha Gastos','GAP Monto Gastos')";
			rstXml(cuboQuery);				
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comopecomprascrud.ValidarDatos()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				//resVal=0;  // 20240128 
				return;
			}
			totReg=getXmlAtt(cuboQuery,"r0","totreg");
			if(totReg==0){
				frn.message("Los Parametros [GAPs] Necesarios para la Operacion No Existen ...","Error","Aceptar");
				//resVal=0;  // 20240118
				return;
			} else {
				if(totReg<2){
					frn.message("Los Parametros [GAPs] Necesarios para la Operacion No estan Completos ...","Error","Aceptar");
					//resVal=0;  // 20240128
					return;
				} else {
				
					// Obtener PARAMs 
					// { GAP Dias Fecha Gastos }
					cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Dias Fecha Gastos'";
					rstXml(cuboQuery);				
					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comopecomprascrud.ValidarDatos()");
					
					frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPDias");
					
					ok=getXmlAtt(cuboQuery,"ok");
					if(ok &! "" && !ok){
						mensajeError = getXmlAtt(cuboQuery,"native3");
						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
						frn.message(mensajeError,"Error","Aceptar");
						//resVal=0;  // 20240128
						return;
					}
					if (nXml(cuboQuery) > 0) {
						gapDias = getXmlAtt(cuboQuery,"r0","paramvalor");
					} else {
						frn.message("Hubo problemas para obtener los Parametros [GAP Dias Fecha Gastos] ...","Error","Aceptar");
						//resVal=0;  // 20240128
						return;
					}
					
					// { GAP Monto Gastos }
					cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Monto Gastos'";
					rstXml(cuboQuery);				
					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comopecomprascrud.ValidarDatos()");
					
					frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPMonto");
					
					ok=getXmlAtt(cuboQuery,"ok");
					if(ok &! "" && !ok){
						mensajeError = getXmlAtt(cuboQuery,"native3");
						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
						frn.message(mensajeError,"Error","Aceptar");
						//resVal=0;  // 20240128
						return;
					}
					if (nXml(cuboQuery) > 0) {
						gapMonto = getXmlAtt(cuboQuery,"r0","paramvalor");
					} else {
						frn.message("Hubo problemas para obtener los Parametros [GAP Monto Gastos] ...","Error","Aceptar");
						//resVal=0;  // 20240128
						return;
					}
					
				}
			}


			//Validar Referencia ... Moved here 20240128 
			if (refer_id &= ""){
				frn.setPos("k_refer");
				//resVal=0;  // 20240128
				frn.message("Es necesario seleccionar la Factura del Proveedor ...","Error","Aceptar");
				return;
			}
			
			
			if ( strlen(/*folio_uuid*/nombre_uuid) == 0 || strlen(rfc_uuid) == 0 || strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {
				frn.message("No se cuenta con todos los datos mandatorios del UUID.","Error","Aceptar");
				return;
			}

				
			//Validar Fecha Referencia ... 20240128 ... NEW
			if ( Validar_Fecha_UUID() == 0 ) {	
				//resVal = 0;  // 20240128
				return;
			}
			
			
			//Validar Proveedor
			
			// Added 20240128
			if ( strlen(frn.get("k_clave")) == 0 || frn.get("k_clave") &= strFormat("ucase","No Existe ...") ) {
				if ( strlen(frn.get("k_clave")) == 0 ) {
					frn.message("No hay Proveedor Asociado a la Operacion ...","Error","Aceptar");
				} else {
					frn.message("El Proveedor No Existe ...","Error","Aceptar");
				}
				//resVal=0;  //20240128
				return;
			}
			
			cmdQuery="SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_id & "'";
			rstXml(cuboQuery);				
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comopecomprascrud.ValidarDatos()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			totReg=getXmlAtt(cuboQuery,"r0","totreg");
			if(totReg==0){
				frn.message("El Proveedor No Existe ...","Error","Aceptar");
				//resVal=0;  // 20240128
				return;
			}


			//Validar Proveedor Pago
			
			// Added 20240301
			if ( strlen(frn.get("k_clave_pago")) == 0 || frn.get("k_nombreprov_pago") &= strFormat("ucase","No Existe ...") ) {
				if ( strlen(frn.get("k_clave_pago")) == 0 ) {
					frn.message("No hay Proveedor de Pago Asociado a la Operacion ...","Error","Aceptar");
				} else {
					frn.message("El Proveedor de Pago No Existe ...","Error","Aceptar");
				}
				//resVal=0;  // 20240301
				return;
			}

			cmdQuery = "SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_pago_id & "'";
			cmdQuery = cmdQuery & " and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')"; 
			rstXml(cuboQuery);				
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comopecomprascrud.ValidarDatos()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			totReg=getXmlAtt(cuboQuery,"r0","totreg");
			if(totReg==0){
				frn.message("El Proveedor de Pago No Existe.","Error","Aceptar");
				//resVal=0;  // 20240301
				return;
			}


			//Validar rfc y monto total de factura correspondan a datos de UUID
			strTotal = frn.get("k_monto");
			vdiferencia = (strTotal-total_uuid);
			if (vdiferencia < 0){
				vdiferencia = vdiferencia *(-1); 
			}
			
			// Adapted 20240128 ... Se Gestionara por PARAM {TBL : param_oper}
			if ( vdiferencia > gapMonto /*0.1*/ ) {
				//resVal=0;  // 20240128
				frn.message("El importe total de la compra no corresponde al de la factura.","Error","Aceptar");
				return;
			}
		
			
			if (frn.get("k_rfc") &! rfc_uuid) {
				//resVal=0; // 20240128
				frn.message("El RFC de la compra no corresponde al de la factura.","Error","Aceptar");
				return;
			}
				
			// End Section code Added by JMM 20240128
				
				
				//Validar productos
				for(var i =0;i<frn.N("k_mov");i++){
					if(frn.get("k_mov",i,"k_parte")&!"" || frn.get("k_mov",i,"k_q")&!""){
						if(frn.get("k_mov",i,"k_q")<=0 || strlen(frn.get("k_mov",i,"k_q"))==0){
							frn.message("Se ha generado el siguiente error: producto con cantidad 0","Error al generar el documento","Aceptar");
							frn.setPos("k_mov","ren:"&i);
							return;
						}
						if(frn.get("k_mov",i,"k_parte")&=""){
							frn.message("Se ha generado el siguiente error: clave de producto vacia","Error al generar el documento","Aceptar");
							frn.setPos("k_mov","ren:"&i);
							return;
						}
						if(frn.get("k_mov",i,"k_unidad")&=""){
							frn.message("Se ha generado el siguiente error: unidad de producto vacia","Error al generar el documento","Aceptar");
							frn.setPos("k_mov","ren:"&i);
							return;
						}
						if(frn.get("k_mov",i,"k_precio")&="" || frn.get("k_mov",i,"k_precio")&="0"){
							frn.message("Se ha generado el siguiente error: precio de producto cero","Error al generar el documento","Aceptar");
							frn.setPos("k_mov","ren:"&i);
							return;
						}	
					}
				}
							

				partidasValidas = ValidaPartidas(); //LA funcion despliega mensaje de error en su caso
				if(partidasValidas==0){
					return;
				}
				
				if( frn.get("k_monto") <= 0 ){
					frn.message("No se puede dar de alta el documento ya que el importe es cero","Error","&Aceptar");return;
				}
				
				
				//Fin de validaciones
				
				fecha = sys.date();
				hora= sys.time();
				//cubo = "dat";
				kdb.rst();
				frn.rst("results");
				frn.rst(xmlPantalla);
				strFecha = fnDate("year",fecha) & "-";
				strTmp = fnDate("month",fecha);
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp & "-";
				strTmp = fnDate("day",fecha);
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp;
				
				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
				//Recrear k_parte para pieza original y reemplazos
				no_partidas=frn.N("k_mov")-1;
				//Agregar usuario, fechay hora de movimiento

				setXml(xmlPantalla,"movimiento","usuario",frn.lib("libKepler","UserInfo"));
				setXml(xmlPantalla,"movimiento","fecha",strFecha);
				setXml(xmlPantalla,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));
				setXml(xmlPantalla,"k_mov","no_partidas",no_partidas);
				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);
				setXml(xmlPantalla,"ambiente","uen",uen);
				
				no_partidas=frn.N("k_mov") -1;
				for(var i =0;i<no_partidas;i++){
					prod_ui = getXml(xmlPantalla,"k_mov","r" & i ,"k_parte");
					prod_original = getXml(xmlPantalla,"k_mov","r" & i ,"k_partesel");

					setXml(xmlPantalla,"k_mov","r" & i,"k_parte",prod_original);
					setXml(xmlPantalla,"k_mov","r" & i,"k_partesel",prod_ui);
				}
												
				//Added 20240128
				setXml(xmlPantalla,"uuid","serie",serie_uuid);
				setXml(xmlPantalla,"uuid","folio",folio_uuid);
				setXml(xmlPantalla,"uuid","total",total_uuid);
				setXml(xmlPantalla,"uuid","fechatimbrado",fecha_uuid);
				//Added 20240301
				setXml(xmlPantalla,"uuid","impuesto",impuesto_uuid);
				//Added 20240617
				setXml(xmlPantalla,"uuid","retisr",retisr_uuid);
				setXml(xmlPantalla,"uuid","retiva",retiva_uuid);
				
				//Added by JMM 20240618
				setXml(xmlPantalla,"k_miepsret",frn.get("k_uuid_retisr"));
				setXml(xmlPantalla,"k_mivaret",frn.get("k_uuid_retiva"));
				/*setXml(xmlPantalla,"k_montoanticipo",frn.get("k_otras_retenciones"));*/ // N.A. for these options
				
				// Added by JMM 20240701
				setXml(xmlPantalla,"ambiente","schema","CXP_CM_RETENCIONES");
				
									
				//frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantalla_comopecompras");
				
				
				//Agregar el tag k_q, el cual debe ser igual a k_q, esto es porque postgresql maneja minusculas
				no_partidas=frn.N("k_mov");
				for(var i =0;i<no_partidas;i++){
					setXml(xmlPantalla,"k_mov","r"&i,"k_q",frn.get("k_mov",i,"k_q"));
				}
				
				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXml_comopecompras");
				
				
				// For Testing ... 20240128 
				/*
				frn.message("La Informacion se Procesara ...","Info !!!","Aceptar");
				return;
				*/
		
				
				cmd="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";
				kdb.rst(cubo);
				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"comopecompras.Alta");
				//frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlResultadoCompra");				
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}


				resultado= getXml(cubo,"resultado");
				mensaje= getXml(cubo,"mensaje");
				adicionales=getXml(cubo,"adicionales");
				
				if(resultado &= "1"){
					frn.set("k_folio",mensaje); 
					frn.set("operacion","CONSULTA");
					strTmp = frn.get("k_docto");
					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;
					frn.set("k_docto",strTmp);
					ConfiguraCamposOpcion();
					Folio();
					//Deshabilita_campos();					
					mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;
					frn.message(mensaje, "Mensaje","&Aceptar");
					if (strlen(trim(adicionales ))!=0){
						frn.message(adicionales,"Mensaje","&Aceptar");
					}
					reporte();
					frn.set("operacion","ALTA");
					ConfiguraCamposOpcion();
					BorraDatos();
					frn.setPos("k_sucn");
				}else{
					frn.message(mensaje, "Error","&Aceptar");
				}
			
			}
			
			fun Consulta(){//Imprime el reporte del documento especificado 
				if(strlen(trim(frn.get("k_folio")))==0){ 
					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");
					frn.setPos("k_folio");
					return;	
				}
				reporte();
				frn.setPos("k_folio");
			}
			
			fun Baja(){ //Borra totalmente el docuemtno especificado. (No deja huella del documento)
		
				var resultado, mensaje, adicionales, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd;
				var partidasValidas = 0;
				var no_partidas, prod_ui, prod_original;
				//var ok, mensajeError; // 20240125 commented
		
		
				fecha = sys.date();
				hora= sys.time();
				//cubo = "dat";
				kdb.rst();
				frn.rst("results");
				frn.rst(xmlPantalla);
				strFecha = fnDate("year",fecha) & "-";
				strTmp = fnDate("month",fecha);
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp & "-";
				strTmp = fnDate("day",fecha);
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp;
				
				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
				//Agregar usuario, fechay hora de movimiento

				setXml(xmlPantalla,"movimiento","usuario",frn.lib("libKepler","UserInfo"));
				setXml(xmlPantalla,"movimiento","fecha",strFecha);
				setXml(xmlPantalla,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));
				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);
				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);
				setXml(xmlPantalla,"ambiente","uen",uen);
				
				//Agregar el tag k_q, el cual debe ser igual a k_q, esto es porque postgresql maneja minusculas
				no_partidas=frn.N("k_mov") -1;
				
				for(var i =0;i<no_partidas;i++){
					prod_ui = getXml(xmlPantalla,"k_mov","r" & i ,"k_parte");
					prod_original = getXml(xmlPantalla,"k_mov","r" & i ,"k_partesel");

					setXml(xmlPantalla,"k_mov","r" & i,"k_parte",prod_original);
					setXml(xmlPantalla,"k_mov","r" & i,"k_partesel",prod_ui);
				}
				
				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlCompra");
				cmd="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";
				kdb.rst(cubo);
				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"comopecompras.Baja");
				//frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlResultadoCompra");				
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}


				resultado= getXml(cubo,"resultado");
				mensaje= getXml(cubo,"mensaje");
				adicionales=getXml(cubo,"adicionales");
				
				if(resultado &= "1"){
					frn.set("k_folio",mensaje); 
					strTmp = frn.get("k_docto");
					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;
					frn.set("k_docto",strTmp);
					Folio();
					//Deshabilita_campos();					
					mensaje = "Documento con Folio: " & mensaje & " cancelado correctamente."; 
					frn.message(mensaje, "Mensaje","&Aceptar");
					if (strlen(trim(adicionales ))!=0){
						frn.message(adicionales,"Mensaje","&Aceptar");
					}
					ConfiguraCamposOpcion();
					BorraDatos();
					frn.setPos("k_sucn");
				}else{
					frn.message(mensaje, "Error","&Aceptar");
				}
			
			
			}
			
			
			// START : Section Added by JMM 20240708 ... To set Report Params 
			
			fun IniParams(){//Inicializa parámetros de impresión. Pueden ser cambiados por el usuario final mediante menú: Archivo -> Configurar Página
				frn.set("param_paper","letter");	//Tamaño de papel predefinido:	"paper=letter|legal|size"
				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tamaño de papel personalizado	"size=21.59,27.94cm"
				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//Márgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"
				frn.set("param_Fx","1.0");	//Escala de impresión (1=100 por ciento)	"F=1,1"
				frn.set("param_landscape","Y"/*Y*/);	//Orientación	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"
				frn.set("param_emp","L");	//Posición de "Razón social"(izq,der,cen)	@emp=L|R|C"
			}
			
			fun setRepPage() {//Establece los parámetros finales de impresión.
				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";
				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";
				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");
				var lndsp="landscape=" & frn.get("param_landscape");
				var emp="@emp=" & frn.get("param_emp");
				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);
			}
			
			// END : Section Added by JMM 20240708 ... To set Report Params 
			
				
			fun reporte(){
				// Se define el formato a usar
				var prefix=frn.lib("libKepler","langPrefix");
				//var pageFto="\#092"&"k80_xsddesarrollo"&"\#092"&prefix&"comopecomprasfto"; //"\k80_xsddesarrollo\" & prefix & "comopecomprasfto"; //prefix&"comopecomprasfto";
				//kdb.readPage("datos", pageFto);//se define el formato a usar
				
				rep.rst(); // Added by JMM 20240708
				IniParams(); // Added by JMM 20240708
				kdb.readPage("datos","comopecomprasfto");//se define el formato a usar
				kdb.exec();
				rep.source(kdb.get("datos")); 
				// rep.rst(); // Commented Added by JMM 20240708
				setRepPage(); // Added by JMM 20240708
				
				// Commented Added by JMM 20240708
				/*
				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste
				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");
				*/
				
				rep.set("titulo",frn.get("k_tipon"));
				
				// Added by JMM 20240709
				if ( strFormat("lcase", frn.get("statusDoc")) &= "documento cancelado" ) {
					rep.set("titulost",frn.get("statusDoc"));  
				}
				
				rep.exe("tit");	
				//rep.set("rep_suc_id",frn.get("k_sucn",-1,1));
				rep.set("rep_suc",frn.get("k_sucn"));
				//rep.set("rep_alm",frn.get("k_almN")); //No se manejan almacenes, solo 1 por defecto
				rep.set("rep_docto",frn.get("k_docto"));
				rep.set("rep_moneda",frn.get("k_moneda"));
				rep.set("rep_fecha",frn.get("k_fecha"));
				rep.set("rep_folio",frn.get("k_folio"));
				rep.set("rep_cliente",frn.get("k_clave"));
				rep.set("rep_clientedir1",frn.getM("k_datCve",0));
				rep.set("rep_clientedir2",frn.getM("k_datCve",1));
				rep.set("rep_clientedir3",frn.getM("k_datCve",2));
				rep.set("rep_clientedir4",frn.getM("k_datCve",3));
				rep.set("rep_rfc",frn.get("k_rfc"));
				rep.set("rep_condiciones",frn.get("k_cond"));
				rep.set("rep_leyenda",frn.get("leyenda"));
				rep.set("rep_fechaen",frn.get("k_vence"));
				rep.set("rep_refer",frn.get("k_refer"));
				rep.exe("encabezado");
				rep.exe("partidas");
				for(var i=0,n=frn.N("k_mov")-1;i<n;i++){
					rep.set("rep_cantidad",frn.get("k_mov",i,"k_q"));
					rep.set("rep_unidad",frn.get("k_mov",i,"k_unidad"));
					rep.set("rep_clave",frn.get("k_mov",i,"k_parte"));
					rep.set("rep_producto",frn.get("k_mov",i,"k_descr"));
					rep.set("rep_precio",frn.get("k_mov",i,"k_precio"));
					rep.set("rep_importe",frn.get("k_mov",i,"k_monto"));				
					rep.exe("partida");
				}
				rep.exe("lineaFinal");rep.exe("vacio");
				rep.set("rep_TotalLetras","***" & strFormat("number",frn.get("k_monto"),0,frn.get("k_moneda")) & " " & frn.get("k_moneda",-1,2));
				rep.exe("partida2");
				rep.exe("vacio");
				rep.set("rep_comentario1",frn.getM("k_coment",0));
				rep.set("rep_comentario2",frn.getM("k_coment",1));
				rep.set("rep_comentario3",frn.getM("k_coment",2));
				rep.set("rep_subtotal",frn.get("subt"));
				rep.set("rep_iva",frn.get("k_iva"));
				rep.set("rep_retenciones",frn.get("k_sumrets"));
				rep.set("rep_total",frn.get("k_monto"));
				rep.exe("fin");
				
				
				//impresion de la poliza
				var nRenPol=kdb.NR("datDoc","k_poliza");
				var tPoliza=kdb.get("datDoc","k_poliza","tpoliza");
				var nPoliza=kdb.get("datDoc","k_poliza","npoliza");
			   
				if (strlen(tPoliza)>0 && strlen(nPoliza)>0 ){
						rep.set("tPol",tPoliza);
						rep.set("nPol",nPoliza);
						rep.exe("encabezadoPol");
						var tAbonosPol=0, tCargosPol=0;
						for(var i=0;i<nRenPol;i++){
							if (kdb.get("datDoc","k_poliza","r"&i,"k_cargo")==0){
								rep.set("PolClave2",kdb.get("datDoc","k_poliza","r"&i,"k_cuenta"));
								rep.set("PolDescr2",kdb.get("datDoc","k_poliza","r"&i,"k_ctaDescr"));
								rep.set("PolHaber",kdb.get("datDoc","k_poliza","r"&i,"k_abono"));
								tAbonosPol=tAbonosPol+kdb.get("datDoc","k_poliza","r"&i,"k_abono");
								rep.exe("partPolA");
							}else{
								rep.set("PolClave",kdb.get("datDoc","k_poliza","r"&i,"k_cuenta"));
								rep.set("PolDescr",kdb.get("datDoc","k_poliza","r"&i,"k_ctaDescr"));
								rep.set("PolDebe",kdb.get("datDoc","k_poliza","r"&i,"k_cargo"));
								tCargosPol=tCargosPol+kdb.get("datDoc","k_poliza","r"&i,"k_cargo");
								rep.exe("partPolC");
							}
						}
						rep.set("totCargo",tCargosPol);
						rep.set("totAbono",tAbonosPol);
						rep.exe("PolTotales");
				}
				
				rep.win(); 
			}

	
			fun ObtenerFolio(){
				// var cmdQuery; // 20240125 commented
				cmdQuery="select c6 as folio, substring(cast(c9 as VARCHAR),1,10) as fecha, c10 as cliente, c32 as nombre,c11 as factura, c16 as monto, c43 as status " & 
					"from keplersc.kdm1 where c1='" & 
					frn.get("k_sucn",-1,1) & "' and c2='" & gen_doc & "' and c3='" & nat_doc & "' and c4=" & gpo_doc 
					& " and c5=" & frn.get("k_tipon",-1,4);
					
					if (tip_ope == 2 ){
						cmdQuery = cmdQuery & " and c43 <> 'C' ";
					}
					
					cmdQuery = cmdQuery & " order by c9 desc" & ", c6 desc /*Added by JMM 20240702*/";
					
				frn.dialog("genlistafiltrosel","Movimiento a taller",cmdQuery,"folio","k_folio","0","0","N","N");					
			}
					
		
		
