		// Included by JMM, 20240125
		fun BuscarProveedor(/*imodo*/){
			var xmlProd;			
			// Added 20240119
			var NewProv, ST_FUN, continua, resultado, mensaje, xmlAlta;
			// Added by JMM 20240229 
			var vProvPago;
			
			sucursal_id = frn.get("k_sucn",-1,1);
			
			// UPD 20240111
			//proveedor_id = frn.get("k_clave");
			proveedor_id = frn.get("k_rfc");
			
			LimpiaDatosProv();
			// 20240111 ... Los Ejecuta en : LimpiaDatosProv()
			/*
			LimpiaDatosDoc();
			LimpiaTotalesDoc();
			*/
			
			//Added 20240131
			frn.set("k_rfc", proveedor_id);	
				
			if (strlen(frn.get("k_rfc"/*"k_clave"*/)) == 0) {
				return;
			}
			
			// Commented 20240111 
			/*
			if (strlen(frn.get("k_refer")) > 0) {
				refer_id = frn.get("k_refer");
			} else {
				frn.set("k_fecha_exp", "");
			}
			*/
				
			cmdQuery = "select c2 as k_clave, /*c10 as k_rfc,*/ c3 as k_nombreprov, c4 as k_calleprov, c5 as k_coloniaprov, c6 as k_poblacionprov, c27 as k_cpprov, c16 as k_plazo " &				
					"from keplersc.kdxd where keplersc.full_replace(c10,'-','') /*c2*/='" & proveedor_id & "'" ;
			//and c1 ='" & sucursal_id & "' ... TO DO : NO VIENE DATO DE LA SUCURSAL A NIVEL DEL PROVEEDOR AUNQUE ESTA EL CAMPO ...
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comopecompras.BuscaProveedor()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;	
			}
			if(nXml(cuboQuery) == 0){
			
				// Addapted 20240111
				//frn.setPos("k_clave");
				frn.set("k_clave","No Existe ...");  
			
				if (/*imodo == 1*/ strlen(NewProvId) > 0 ) { 
				
					frn.message("El proveedor no existe","Error","Aceptar");
					return;
					
				} else {
				
					frn.message("El Proveedor No existe ..." & "|" & " " & 
					"|" & " " & "Nombre : " & nombre_uuid &
					"|" & " " & "R.F.C. : " & rfc_uuid & 
					"|" & " " & "Fecha Docto. Seleccionado : " & fecha_uuid & 
					"|" & " " & "Total Docto. Seleccionado : " & total_uuid & 
					"|" & " " & "|" & " " & 
					"Puede crearse Automaticamente, se recomienda complementar los Datos.", "Info !!!","Aceptar");

					continua = frn.message("¿Continuar con el Alta del Proveedor?","Atencion !!!",2);
					if (continua == 0){
				
						return;
					
					}	else {
				
						setXml(xmlAlta,"sucursal",sucursal_id);
						setXml(xmlAlta,"nombre",nombre_uuid);
						setXml(xmlAlta,"rfc",rfc_uuid);
					
						frn.lib("libGeneral.kpl","FileSave",xmlAlta,fileSavePath & "\XmlAltaProv_To_Send");
					
						cmdQuery="SELECT * FROM keplersc.uuid_tools_alta_proveedor('<document>" & getXmlStr(xmlAlta,"EOF:13_10") & "</document>')";
						rstXml(cuboQuery);
					
						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"comopecompras.Alta_Proveedor");				
						frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlAltaProv_Result");
					
						resultado = getXml(cuboQuery,"resultado");
						mensaje = getXml(cuboQuery,"mensaje");
					
						ok = getXmlAtt(cuboQuery,"ok");
						if(ok &! "" && !ok) {
							mensajeError = getXmlAtt(cuboQuery,"native3");
							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
							frn.message(mensajeError,"Error","Aceptar");
							return;	
						}

						if(resultado &= "1") {
							NewProv = mensaje;
							//frn.dialog("cat_crud_proveedores","Modificar"/*accion*/, NewProv/*param1*/,"UUID" /*param2*/);
							//prov_data_upd(NewProv);
							return NewProv/*1*/;
						}
					
					} // End ... If ( continua )
				
				} // End ... If ( imodo )
				
			}
			
			//Plazo();	
			rstXml(xmlProd);
			frn.lib("libGeneral.kpl","FileSave",cuboQuery/*xmlAlta*/,fileSavePath & "\XmlAltaProv_To_Get");
			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");
			frn.setX(xmlProd);
			
			// Added by JMM 20240301 
			vProvPago = trim(frn.get("k_clave_pago"));
			if ( strlen(trim(frn.get("k_clave"))) > 0 ) {
				if ( strlen( vProvPago ) == 0 ) {
					frn.set("k_clave_pago", frn.get("k_clave"));
					BuscarProvPago();
				} else {
					if ( CheckProvPago() == 0 ) {
						frn.set("k_clave_pago", frn.get("k_clave"));
						BuscarProvPago();	
					}
				}
			}
			
			Plazo(); // Moved 20240131	
		}		
		
			
