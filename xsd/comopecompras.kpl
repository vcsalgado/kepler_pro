	<script>
		InstallDriver("KDB75");
		class Main {
			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc,usuario, suc_usuario,rol_usuario,asterisco;
			var frn,kdb,rep,frP,sys;
			var tip_ope;//Tipo de operaciï¿½n. "0" indica Alta; "1" indica consulta; "2" indica cancelaciï¿½n; "3" indica baja; "4" Indica modificaciï¿½n
			var uen;
			var anio_contable;
			
			//Variables validacion factura
			var	str_uuid, fecha_uuid, rfc_uuid, total_uuid, strTotal, validar_uuid;	
			
			//Added 20240125
			var nombre_uuid, regimen_uuid, folio_uuid, serie_uuid, NewProvId; 
			var sucursal_id, proveedor_id, refer_id;
			var cmdQuery, cuboQuery, ok, mensajeError;
			var fileSavePath;
			//Added by JMM 20240229
			var paramProvPago, proveedor_pago_id;
			var impuesto_uuid;
			//Added by JMM 20240617
			var retisr_uuid, retiva_uuid;
			
			
			/* PARAMETROS de la página indicados desde Tree, o desde frn.Dialog
			param(0) = Género
			param(1) = Naturaleza
			param(2) = Grupo
			param(3) = Tipo
			param(4) = Fija Documento. Si "1", no permite seleccionar otro tipo de documento. Si "0" los combos de grupo  y tipo de documento se habilitan.
			param(5) = Tipo de operaciï¿½nn. "0" indica Alta; "1" indica consulta; "2" indica cancelaciï¿½n; "3" indica baja; "4" Indica modificaciï¿½n
			*/
			
			fun Main() {
				frn=new FRNT;
				kdb=new KDB;
				rep=new REP;
				frP=new FRNTP;
				sys=new SYS;
				kdb.connect();
				kdb.open("c,kdm1,i,kdini,q,kdiq,m,kdmm,s,kdms,u,kdxd,v,kdxv,p,kdip,e,kdxe,f,kdxf,w,kdc2");
				ConfiguraControlesOff();
				usuario = frn.config("user","name");
				rol_usuario = frn.config("user","role");
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				asterisco = "*";
				fileSavePath = "C:\Basura"; // Added 202240125
				inicializa();
			}
			
			fun inicializa(){//Da valor a los combos y prepara la pï¿½gina dependiendo del tipo de Operaciï¿½n a realizar
				var resValidacion, resMensaje, cubo, cmd, ok,mensajeError;
				kdb.kde("KDE");//								Configuracion del servidor
				kdb.exec();
				anio_contable = kdb.get("KDE","14");
				frn.set("k_fecha",sys.date());
				
				paramProvPago = 0; // Added by JMM 20240301
				
				if( frn.nParam()>0 ){//Se han mandado parametros a la pagina
					gen_doc=trim(frn.param(0)); 
					nat_doc=trim(frn.param(1)); 
					gpo_doc=trim(frn.param(2));
					tip_doc=trim(frn.param(3)); 
					fija_doc=trim(frn.param(4));
					tip_ope=trim(frn.param(5));
					uen=trim(frn.param(6));
					if(uen&="") {
						uen="XXX";
					}
				}
				else
				{
					frn.message("Esta accion no esta permitida.","Estimado Usuario","&Aceptar");
					frn.open("redirect",2);
					return;
				}
			
				ConfiguraCamposOpcion();

				//Llena lista de grupo de documentos
				addDocto("Compra Directa",gen_doc,nat_doc,gpo_doc,0,0,"A",30,35);					
				
				//Llenar combo sucursales
				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";
				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){
					cmd = cmd & " where c1='" & suc_usuario & "'";
				}else {
					if (suc_usuario &! asterisco && suc_usuario &! "" ){
						cmd = cmd & " where c1='" & suc_usuario & "'";
					}
				}
			
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Inicializa()");
				
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				frn.set("k_sucn",getXml(cubo));	
				sucursal_id = frn.get("k_sucn",-1,1);	
				
				// Added by JMM 20240301 ... Check Security PARAM for User to use PROV PAGO
				paramProvPago = ProvPago_Sec(usuario);
				
								
				cmd = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;
				
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Inicializa()");
				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTipoDocto");		
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}

				frn.set("k_tipon",getXml(cubo));				
				
				Fecha();//Indica fecha correcta, y trae monedas y paridades de esa fecha. 
				if (strlen(tip_doc)>0) frn.setPos("k_tipon",-1,4,"internal:Y","val:" & tip_doc);//Posiciona el combo de Tipo de documento al especificado como parï¿½metro
				
				LlenaCmbMoneda();
//				setGrupoDoctos();
				
				if(tip_ope==0){//Alta
					frn.set("operacion","ALTA");
				}
				else if(tip_ope==1){//Consulta
					frn.set("operacion","CONSULTA");
				}
				else if(tip_ope==2){//Baja
					frn.set("operacion","BAJA");
				}	
				else { // Completed by JMM 20240301 , out of STD 
					frn.message("Operación no válida ...", "Mensaje","&Aceptar");
					frn.open("index",4);
					return;	
				}
				
				
				
				BorraDatos();
				frn.setPos("k_sucn");
			}
			
			fun LlenaCmbMoneda(){
				frn.setX("PESOS","k_moneda",0,0);
			} 
			//Consulta productos
			fun ConsultaProductos(){
				var suc = frn.get("k_sucn",-1,1);
				var producto=frn.get("k_mov", -1, "k_parte");
				cmdQuery="";
				frn.dialog("prodlistafiltrosel","Refacciones",cmdQuery,"clave_actual","k_mov",-1,"k_parte","N","N",suc,producto,"Clave");
			}
			
			fun Valida_Tipo_Docto(){
				var resValidacion, resMensaje, cubo, cmd, ok, tip_doc;			
				//Valida documento vigente
				tip_doc=frn.get("k_tipon",-1,4);
				kdb.rst();
				
				cmd= "select * from keplersc.verify_valid_document('" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & tip_doc & ")"; //genero text, naturaleza text, grupo integer, tipo_movto integer
				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Valida_Tipo_Docto()");				
				resValidacion= getXml(cubo,"validacion","resultado");
				resMensaje = getXml(cubo,"validacion","mensaje");
				if(resMensaje &! ""){
					frn.message(resMensaje, "Mensaje","&Aceptar");
					frn.setPos("k_tipon");
				}
				
				BorraDatos();					
			}
			
