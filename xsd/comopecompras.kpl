<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Compra">	<grp id="grpMain" brdr="0,0" clr="0,58,112" fnt="Arial,18b"  dim="1,-1,10,8" bclr="192,205,213" clrBrdr="0,97,181" OnF1="Dialog(1,comopecompayu)" tit="Compras" unfont="0">		<tab/><txt clr="0,0,0" fnt=",22">Compras</txt><br/><tab/><hLine clr="0,0,0"/><br/><tab n="2"/>		<br/><br/>		<tab/>		<grp id="grpDatosGenerales" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="50,10,7,12" tit="Datos generales"  fnt="Arial,16" available="Y" modify="Y">		<sp/><txt clr="0,58,112" hk="S">Sucursal</txt><tab n="2"/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" 				brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y"	OnChange="CambiaSucursal()"/>			<br/>			<sp/>	<txt clr="0,58,112">Grupo docto</txt><tab/>			<cmb id="grpDoc" clr="64,64,64" clrBrdr="255,255,255"   dim="25,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="0)" available="N" modify="Y"/>			<br/>			<sp/><txt clr="0,58,112">Tipo docto</txt><tab n="2"/>			<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255"  dim="25,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="Valida_Tipo_Docto()" available="Y"/><br/>		</grp><sp/>		<grp id="grpDocumentos" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="39,12,7,12" tit="Documento"  fnt="Arial,16" available="Y">			<tab n="2"/><inp id="operacion" clr="64,64,64"  dim="18,1" brdr="0,1" fnt=",18b" available="N" type="string"/><br/><tab/>			<txt id="foliotxt"  visible="Y" hk="F" clr="0,58,112">Folio</txt><tab n="2"/>			<edt id="k_folio" clr="64,64,64" clrBrdr="255,255,255"  dim="18,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" visible="Y" hk="F" 				OnChange="Formar_folio()" OnF9="ObtenerFolio()" OnMouseL="ObtenerFolio()" modify="Y" type="string" nc="10" tooltip="Folio del movimiento ( F9 b&#250;squeda )"/>			<tab n="1"/>			<img id="buscar" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Folio()" available="Y" clrBrdr="0,0,0" visible="Y"/>			<br/><tab/>			<inp id="k_docto" clr="64,64,64"  dim="18,1" brdr="0,1" fnt="Arial,16" available="N" link="k_tipon,5" type="string"/><br/>			<tab/><txt clr="0,58,112">Fecha</txt><tab/>			<edt id="k_fecha" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" OnButton="Dialog(0,_ks_fecha,k_fecha)" OnF9="Dialog(0,_ks_fecha,k_fecha)" modify="N" available="N"/>			<br/><tab/>			<inp id="statusDoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/><br/><tab n="2"/>			<inp id="k_baseFolio" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" brdr="2,0" bclr="255,255,255" type="string" available="N" visible="N" modify="N"/>		</grp><br/><br/>		<tab/>		<grp id="grpDetalle" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5" dim="90,16,7,10" tit="Detalle"  fnt="Arial,16" available="N" modify="Y">			<grp id="grpProveedor" dim="128,12,7,12" brdr="0,5" hSpace="4" available="Y" modify="Y"><txt>  Proveedor</txt><tab/>				<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnButton="Dialog(3,cxpcatprobus,k_clave)" OnF9="Dialog(3,cxpcatprobus,k_clave)" OnF10="Dialog(3,cxpcatpropag,k_clave,,11110)" OnChange="Clave()" 					type="capital" nc="7" tooltip="Proveedor ( F9 b&#250;squeda; F10 cat&#225;logo )" modify="Y" hk="C"/>				<tab n="8"/>				<txt>Datos del proveedor</txt><br/>				<txt>  RFC</txt><tab n="3"/>				<inp id="k_rfc" clr="64,64,64"  dim="18,1" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>				<tab n="8"/>				<inp id="k_nombreprov" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y" bclr="255,255,255"/>				<br/>				<tab n="18"/>				<inp id="k_calleprov" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y" bclr="255,255,255"/>				<br/>				<tab n="18"/>				<inp id="k_coloniaprov" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y" bclr="255,255,255"/>				<br/>								<tab/><cmb id="k_moneda" clr="64,64,64" clrBrdr="255,255,255"  dim="5,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					default="PESOS" Null="N" modify="N" visible="N"/>				<tab/><inp id="k_paridad" clr="64,64,64"  dim="5,1" brdr="0,1" fnt="Arial,16" type="number" 					link="k_moneda" modify="N" available="Y" nd="4" visible="N"/>												<tab n="14"/>				<inp id="k_poblacionprov" clr="64,64,64" clrBrdr="255,255,255"  dim="50,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y" bclr="255,255,255"/>				<tab n="1"/><inp id="k_cpprov" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y" bclr="255,255,255"/>				<br/>				<sp/><txt> Factura o Gu&#237;a</txt><tab/>				<inp id="k_refer" clr="64,64,64" clrBrdr="255,255,255"  dim="80,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "N" modify="N" visible="Y"/>					<sp n="2"/>				<bot id="Buscar" dim="10" brdr="5" OnEnter="ObtenerFactura()" tooltip="Busca UUID de la factura del proveedor" available="Y" visible="Y" modify="Y"/>																				</grp>					</grp>			<br/><br/>		<tab/>		<grp id="grpPartidas" dim="90,28,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" fnt=",0" available="N" modify="Y"><tab/>			<tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="122,10"  hk="z" OnChange="CalcTotal()" Reorder="N" modify="Y">				<col id="k_parte" name="Art&#237;culo"  type="capital" nc="18" 					OnF9="ConsultaProductos()" 					OnF5="Dialog(3,invrepestprod,s)"					OnF10="Dialog(3,cat_prod_crud,Nuevo,x,s)" OnF11="Dialog(3,cat_prod_crud,Modificar,x,s)" 					OnMouseL="ConsultaProductos()" 					OnChange="Producto()" modify="N" available="Y"/>				<col id="k_descr" name="Descripci&#243;n"  modify="N"/>						<col id="k_q" name="Cantidad"  type="number" nd="-1" min="0" OnF9="Cantidad()" OnMouseL="Cantidad()" 					OnChange="Cantidad()" OnActive="Cantidad(1)" OnF10="Dialog(3,doc_coment,k_mov)"/>				<col id="k_unidad" name="Unidad"  type="capital" OnChange="Unidad()" OnF9="Dialog(3,doc_unidades,k_mov)" OnMouseL="Dialog(3,doc_unidades,k_mov)" modify="N" available="Y"/>				<col id="k_precio" name="Precio lista"  type="number" nd="6" modify="N" available="Y"/>				<col id="k_monto" name="Importe"  type="number" nd="6" min="0" OnChange="Monto()" modify="N" available="Y"/>				<col id="k_partesel" name="Ref. Original" type="capital" nc="18" modify="N"/>			</tbl><br/>			<grp dim="70,30,7,12" fnt="Arial,16" hSpace="4"><tab/>				<txt clr="0,58,112">Plazo</txt><tab n="5"/>				<inp id="k_plazo" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nd="0" min="0" OnChange="Plazo()" modify="N" available="N"/><tab/>				<br/><tab/>				<inp id="leyenda" clr="64,64,64"  dim="17,1" brdr="0,1" bclr="255,255,255" type="string" nc="17" fnt="Arial,16" available="N"/><tab/>				<edt id="k_vence" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnButton="Dialog(0,_ks_fecha,k_vence)" OnF9="Dialog(0,_ks_fecha,k_vence)" modify="N"/>				<br/>				<tab/><txt clr="0,58,112">Condiciones</txt><tab n="3"/>				<inp id="k_cond" clr="64,64,64" clrBrdr="255,255,255"  dim="39,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="33" modify="N" available="N"/>				<br/>				<tab/><txt clr="0,58,112">Comentarios:</txt><br/><tab n="2"/>				<inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="60,3" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nr="3,60" modify="N" available="Y"/>			</grp><tab n="6"/>			<grp dim="40,14,7,12" fnt="Arial,16" hSpace="4">				<txt>Subtotal</txt><tab n="2"/>				<inp id="subt" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/>				<br/>				<txt>IVA</txt><tab n="3"/>				<inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/><br/><txt fnt=",16b">IMPORTE</txt><tab/>				<inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="N"/><br/>				<br/><br/>				<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Consulta()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>				<tab n="5"/>				<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="N" clrBrdr="0,0,0" visible="N"/>				<tab/>				<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="N" clrBrdr="0,0,0" visible="N" modify="Y"/>			</grp><br/><br/><br/><br/>		</grp>	</grp>	<tools>		<tool OnMouseL="Ejecuta()" tooltip="Aceptar documento(Ctrl+T)" scut="Ctrl+T" img="_TL_Execute.png"/>	</tools>	<script>		InstallDriver("KDB75");		class Main {			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc,usuario, suc_usuario,rol_usuario,asterisco,sucursal_id;			var frn,kdb,rep,frP,sys;			var tip_ope;//Tipo de operaciï¿½n. "0" indica Alta; "1" indica consulta; "2" indica cancelaciï¿½n; "3" indica baja; "4" Indica modificaciï¿½n			var uen;			var anio_contable;			//Variables validacion factura			var	str_uuid, fecha_uuid, rfc_uuid, total_uuid, strTotal, validar_uuid;				/* PARAMETROS de la página indicados desde Tree, o desde frn.Dialog			param(0) = Género			param(1) = Naturaleza			param(2) = Grupo			param(3) = Tipo			param(4) = Fija Documento. Si "1", no permite seleccionar otro tipo de documento. Si "0" los combos de grupo  y tipo de documento se habilitan.			param(5) = Tipo de operaciï¿½nn. "0" indica Alta; "1" indica consulta; "2" indica cancelaciï¿½n; "3" indica baja; "4" Indica modificaciï¿½n			*/						fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("s,kdms,u,kdxd");				ConfiguraControlesOff();				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				inicializa();			}						fun inicializa(){//Da valor a los combos y prepara la pï¿½gina dependiendo del tipo de Operaciï¿½n a realizar				var resValidacion, resMensaje, cubo, cmd, ok,mensajeError;				kdb.kde("KDE");//								Configuraciï¿½n del servidor				kdb.exec();				anio_contable = kdb.get("KDE","14");				frn.set("k_fecha",sys.date());												if( frn.nParam()>0 ){//Se han mandado parï¿½metros a la pï¿½gina					gen_doc=trim(frn.param(0)); 					nat_doc=trim(frn.param(1)); 					gpo_doc=trim(frn.param(2));					tip_doc=trim(frn.param(3)); 					fija_doc=trim(frn.param(4));					tip_ope=trim(frn.param(5));					uen=trim(frn.param(6));					if(uen&="") {						uen="XXX";					}				}				else				{					frn.message("Esta accion no esta permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}				ConfiguraCamposOpcion();				//Llena lista de grupo de documentos				addDocto("Compra Directa",gen_doc,nat_doc,gpo_doc,0,0,"A",30,35);													//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_sucn",getXml(cubo));									LlenaCmbTipo();				tip_doc  = frn.get("k_tipon", -1, 4); 														Fecha();//Indica fecha correcta, y trae monedas y paridades de esa fecha. 				if (strlen(tip_doc)>0) frn.setPos("k_tipon",-1,4,"internal:Y","val:" & tip_doc);//Posiciona el combo de Tipo de documento al especificado como parï¿½metro								LlenaCmbMoneda();//				setGrupoDoctos();								if(tip_ope==0){//Alta					frn.set("operacion","ALTA");				}				else if(tip_ope==1){//Consulta					frn.set("operacion","CONSULTA");				}				else if(tip_ope==2){//Baja					frn.set("operacion","BAJA");				}								BorraDatos();				frn.setPos("k_sucn");			}						fun LlenaCmbMoneda(){				frn.setX("PESOS","k_moneda",0,0);			} 			//Consulta productos			fun ConsultaProductos(){				var cmdQuery,suc,producto;				suc = frn.get("k_sucn",-1,1);				producto=frn.get("k_mov", -1, "k_parte");				cmdQuery="";				frn.dialog("prodlistafiltrosel","Refacciones",cmdQuery,"clave_actual","k_mov",-1,"k_parte","N","N",suc,producto,"Clave");			}						fun LlenaCmbTipo(){							sucursal_id=frn.get("k_sucn",-1,1);														var cmd = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and col_sucursal='" & sucursal_id & "'" ;								var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTipoDocto");						var ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_tipon",getXml(cubo));				}									fun CambiaSucursal() {				LlenaCmbTipo();					Valida_Tipo_Docto();							}												fun Valida_Tipo_Docto(){				var resValidacion, resMensaje, cubo, cmd, ok, tip_doc;							//Valida documento vigente				tip_doc=frn.get("k_tipon",-1,4);				kdb.rst();								cmd= "select * from keplersc.verify_valid_document('" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & tip_doc & ")"; //genero text, naturaleza text, grupo integer, tipo_movto integer				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Valida_Tipo_Docto()");								resValidacion= getXml(cubo,"validacion","resultado");				resMensaje = getXml(cubo,"validacion","mensaje");				if(resMensaje &! ""){					frn.message(resMensaje, "Mensaje","&Aceptar");					frn.setPos("k_tipon");				}								BorraDatos();								}						fun ConfiguraControlesOff()			{				var strValAtr;				strValAtr = "N";				//Deshabilita todos los campos y botones				frn.setAtt("grpDatosGenerales","available",strValAtr);				frn.setAtt("grDocumentos","available",strValAtr);								frn.setAtt("grpDoc","available","N");//				frn.setAtt("k_tipon","available","N");								frn.setAtt("grpDetalle","available",strValAtr);				frn.setAtt("grpProveedor","available",strValAtr);				frn.setAtt("grpPartidas","available",strValAtr);				frn.setAtt("Aceptar","available",strValAtr);				frn.setAtt("Aceptar","visible",strValAtr);				frn.setAtt("Imprimir","available",strValAtr);				frn.setAtt("Imprimir","visible",strValAtr);					frn.setAtt("Cancelar","available",strValAtr);				frn.setAtt("Cancelar","visible",strValAtr);									frn.setAtt("foliotxt","visible",strValAtr);									frn.setAtt("k_folio","modify",strValAtr);					frn.setAtt("k_folio","visible",strValAtr);											frn.setAtt("k_fecha","modify",strValAtr);					frn.setAtt("k_fecha","available",strValAtr);				frn.setAtt("k_refer","modify",strValAtr);					frn.setAtt("k_refer","available",strValAtr);				frn.setAtt("k_fecRef","modify",strValAtr);					frn.setAtt("k_fecRef","available",strValAtr);				frn.setAtt("k_plazo","modify",strValAtr);					frn.setAtt("k_plazo","available",strValAtr);				frn.setAtt("k_cond","modify",strValAtr);					frn.setAtt("k_cond","available",strValAtr);								frn.setAtt("k_coment","modify",strValAtr);				frn.setAtt("k_coment","available",strValAtr);								frn.setAtt("k_mov","modify",strValAtr,"k_parte");				frn.setAtt("k_mov","modify",strValAtr,"k_unidad");				frn.setAtt("k_mov","modify",strValAtr,"k_precio");				frn.setAtt("k_mov","modify",strValAtr,"k_monto");								frn.setAtt("buscar","visible",strValAtr);			}						fun ConfiguraCamposOpcion(){				var strValAtr;				ConfiguraControlesOff();				//HAbilita segun tipo de operacion				strValAtr = "Y";				switch(tip_ope){					case 0: //Alta						frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpDatosGenerales","modify",strValAtr);						frn.setAtt("grDocumentos","available",strValAtr);						frn.setAtt("grDocumentos","modify",strValAtr);						frn.setAtt("grpDetalle","available",strValAtr);						frn.setAtt("grpDetalle","modify",strValAtr);						frn.setAtt("grpProveedor","available",strValAtr);						frn.setAtt("grpProveedor","modify",strValAtr);						frn.setAtt("grpPartidas","available",strValAtr);						frn.setAtt("grpPartidas","modify",strValAtr);						frn.setAtt("Aceptar","available",strValAtr);						frn.setAtt("Aceptar","visible",strValAtr);							frn.setAtt("Cancelar","available",strValAtr);						frn.setAtt("Cancelar","visible",strValAtr);														frn.setAtt("k_fecha","modify",strValAtr);							frn.setAtt("k_fecha","available",strValAtr);						frn.setAtt("k_fecRef","modify",strValAtr);							frn.setAtt("k_fecRef","available",strValAtr);						frn.setAtt("k_plazo","modify",strValAtr);							frn.setAtt("k_plazo","available",strValAtr);						frn.setAtt("k_cond","modify",strValAtr);							frn.setAtt("k_cond","available",strValAtr);													frn.setAtt("k_coment","modify",strValAtr);						frn.setAtt("k_coment","available",strValAtr);																		frn.setAtt("k_mov","modify",strValAtr,"k_parte");						frn.setAtt("k_mov","available",strValAtr,"k_parte");						frn.setAtt("k_mov","modify",strValAtr,"k_unidad");						frn.setAtt("k_mov","available",strValAtr,"k_unidad");						frn.setAtt("k_mov","modify",strValAtr,"k_precio");						frn.setAtt("k_mov","available",strValAtr,"k_precio");						frn.setAtt("k_mov","modify",strValAtr,"k_monto");												frn.setAtt("k_mov","available",strValAtr,"k_monto");						break;					case 1: //Consulta						frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpProveedor","available",strValAtr);						frn.setAtt("grpProveedor","modify",strValAtr);						frn.setAtt("k_folio","modify",strValAtr);							frn.setAtt("k_folio","visible",strValAtr);											frn.setAtt("foliotxt","visible",strValAtr);											frn.setAtt("Imprimir","available",strValAtr);						frn.setAtt("Imprimir","visible",strValAtr);						frn.setAtt("buscar","visible",strValAtr);							frn.setAtt("k_coment","available",strValAtr);						break;					case 2:						//Baja						frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpProveedor","available",strValAtr);						frn.setAtt("grpProveedor","modify",strValAtr);						frn.setAtt("k_folio","modify",strValAtr);							frn.setAtt("k_folio","visible",strValAtr);											frn.setAtt("foliotxt","visible",strValAtr);											frn.setAtt("buscar","visible",strValAtr);						frn.setAtt("Aceptar","available",strValAtr);						frn.setAtt("Aceptar","visible",strValAtr);							frn.setAtt("Cancelar","available",strValAtr);						frn.setAtt("Cancelar","visible",strValAtr);							frn.setAtt("k_coment","available",strValAtr);							break;					default:				}			}						fun BorraDatos(){ //Limpia todos los campos para generar un nuevo documento. 				frn.set("k_folio","","statusDoc","","k_clave","","k_refer","","k_fecRef",""); 				frn.rst("k_mov");frn.rst("k_poliza");								Clave(1);				if(tip_ope>0) frn.setPos("k_folio");							}						fun addDocto(Descripcion,Gen,Nat,Gru,bTipo_Especifico,bSoloAutorizado,NatPrv,GruPrv,Gru2Prv){				var renglon=frn.N("grpDoc");				frn.setX(trim(Descripcion),"grpDoc",renglon,0);				frn.setX(trim(Gen),"grpDoc",renglon,1);				frn.setX(trim(Nat),"grpDoc",renglon,2);				frn.setX(trim(Gru),"grpDoc",renglon,3);				frn.setX(trim(bTipo_Especifico),"grpDoc",renglon,4);				frn.setX(trim(bSoloAutorizado),"grpDoc",renglon,5);				frn.setX(trim(NatPrv),"grpDoc",renglon,6);				frn.setX(trim(GruPrv),"grpDoc",renglon,7);				frn.setX(trim(Gru2Prv),"grpDoc",renglon,8);			}								fun Clave(iModo){//Actualiza los datos del cliente o Proveedor				if(iModo==0){					var cmd="datos,u,1,0,'" & frn.get("k_clave") & "',&,u1...u50,v3";kdb.rel("v2=u12"); kdb.search(cmd); 					kdb.exec(); 					if(kdb.ok("datos")==0){						if(strlen(trim(frn.get("k_clave")))>0)	frn.message("La clave "&frn.get("k_clave")&" no se encontró","Error","&Aceptar");						frn.setPos("k_clave");//La clave no existe					}				}else{kdb.rst("datos");}//Borra la info anterior				frn.set("k_clave",kdb.get("datos","u2"),"k_rfc",kdb.get("datos","u10"),"k_plazo",kdb.get("datos","u16"));				frn.set("k_nombreprov",kdb.get("datos","u3"));				frn.set("k_calleprov",kdb.get("datos","u4"));				frn.set("k_coloniaprov",kdb.get("datos","u5"));				frn.set("k_poblacionprov",kdb.get("datos","u6"));				frn.set("k_cpprov",kdb.get("datos","u27"));								validar_uuid = kdb.get("datos","u29");				if (validar_uuid &="N"){					//frn.set() k_ref, Buscar					frn.setAtt("k_refer","visible","Y");					frn.setAtt("k_refer","modify","Y");					frn.setAtt("k_refer","available","Y");										frn.setAtt("Buscar","modify","N");					frn.setAtt("Buscar","available","N");					}else{					frn.setAtt("k_refer","visible","Y");					frn.setAtt("k_refer","modify","N");					frn.setAtt("k_refer","available","N");										frn.setAtt("Buscar","modify","Y");					frn.setAtt("Buscar","available","Y");				}								 				//frn.setM("k_datCve",kdb.get("datos","u3"),kdb.get("datos","u4"),kdb.get("datos","u5"),kdb.get("datos","u6"),kdb.get("datos","u27"));				frn.setM("k_coment",kdb.get("datos","u24"),kdb.get("datos","u25"),kdb.get("datos","u26"));								Plazo();				CalcTotal();//para que aplique descuentos, etc.			}						fun Plazo(){ //Calcula la fecha de pago, y las condiciones de pago en base al plazo				frn.set("k_vence",fnDate("addC",frn.get("k_fecha"),frn.get("k_plazo")));//Suma dï¿½as comerciales				var cond=frn.get("k_plazo") & " días fecha factura";				if (frn.get("k_plazo")==0) cond="Pago de contado";				frn.set("k_cond",cond);  			}						fun Fecha(){//Verifica que la fecha del documento sea correcta. Ademï¿½s trae monedas y paridades de esa fecha. 				var cubo, cmd, resValidacion, resMensaje, fecha;				var validDate=frn.lib("libKepler","ValidOpDate",frn.get("k_fecha"));												frn.set("k_moneda","PESOS");				frn.set("k_paridad",1);								kdb.rst();				frn.rst("results");				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				if (tip_ope == 0 ){					cmd= "select * from keplersc.verify_year('" & fecha & "')";					cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Fecha()");									;										resValidacion= getXml(cubo,"validacion","resultado");					resMensaje = getXml(cubo,"validacion","mensaje");					if(resMensaje &! ""){						frn.message(resMensaje, "Mensaje","&Aceptar");					}											if(resValidacion &= "0"){						frn.setPos("k_fecha");						return;					}									}				Plazo();			}									fun CalcTotal(){ //Calcula los importes parciales y el total				var bConsulta=((tip_ope>=1)&&(tip_ope<=3))?1:0;//Se estï¿½ consultando el documento. Solo recalcular subtotales				var T=0,IVA=0; //SUBTOTAL, IVA x partida				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {					if ( (frn.get("k_mov",i,"k_precio")==0)&&(frn.get("k_mov",i,"k_monto")>0) ){//Se requiere calcular el precio en base al importe						var prc=frn.get("k_mov",i,"k_monto")/frn.get("k_mov",i,"k_q");						frn.setX(prc,"k_mov",i,"k_precio"); 					}					var imp=frn.get("k_mov",i,"k_q")*frn.get("k_mov",i,"k_precio");//importe de partida					if (frn.get("k_mov",i,"k_parte") &! ""){						frn.setX(imp,"k_mov",i,"k_monto");					}					T=T+ math("round",imp,2);					//Impuesto por producto					if (frn.get("k_tipon",-1,6)==99)//Iva por producto						if (frn.get("k_mov",i,"k_iva")<0){								T=T-math("round",imp,2);								imp=frn.get("k_mov",i,"k_q")*frn.get("k_mov",i,"k_precio");//importe de partida							  imp=imp/(1+((-1)*(frn.get("k_mov",i,"k_iva")/100)));//desglosar el IVA							  								T=T+ math("round",imp,2);								IVA=IVA+imp*(-1)*(frn.get("k_mov",i,"k_iva")/100);													}else {														IVA=IVA+imp*frn.get("k_mov",i,"k_iva")/100;						}								}				frn.set("subt",T); 				if(bConsulta)return;				if (frn.get("k_tipon",-1,6)==99){					frn.set("k_iva",IVA*0.16);//Al tener iva por producto;				}				else{					frn.set("k_iva",(frn.get("subt"))*frn.get("k_tipon",-1,6)/100);				}								frn.set("k_ivaRet",frn.get("subt")*frn.get("k_tipo",-1,8)/100);				frn.set("k_monto",frn.get("subt")+frn.get("k_iva")-frn.get("k_ivaRet"));			}												fun Producto() {//Llena el renglon actual con la informaciï¿½n del producto				var cmd, cuboProd, ok, mensajeError, prodExiste ,xmlProducto, xmlReqEst, xmlEstadistica, prodBuscar;				var cuboCosto, costo,valorRetorno, prod_original;							prodBuscar = frn.get("k_mov",-1,"k_parte"); //				valorRetorno = frn.get("k_mov",-1,"k_parte");								frn.setX("","k_mov",-1,"k_parte");				frn.setX("","k_mov",-1,"k_descr");				frn.setX("","k_mov",-1,"k_q");				frn.setX("","k_mov",-1,"k_unidad");				frn.setX("","k_mov",-1,"k_precio");				frn.setX("","k_mov",-1,"k_monto");							cmd="select * from keplersc.prod_obtener_original('" & valorRetorno & "')";				cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Producto()");				ok=getXmlAtt(cuboProd,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												prod_original = getXmlAtt(cuboProd,"r0","prod_obtener_original");				if (prod_original &= "0"){					mensajeError="El producto " & valorRetorno & " no existe como original.";					frn.message(mensajeError,"Error","&Aceptar");					return;				}				//Obtener detalle de producto				rstXml(cuboProd);								cmd = "select c1,c2,c19,c11 from keplersc.kdini where c1 = '" & prod_original &  "'"; 				cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.ValidaArticulo()");	//frn.lib("libGeneral.kpl","FileSave",cuboProd,"C:\Basura\cuboProd");				ok=getXmlAtt(cuboProd,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				//frn.setX(getXmlAtt(cuboProd,"r0","c1"),"k_mov",-1,"k_parte");									//frn.setX(getXmlAtt(cuboProd,"r0","c2"),"k_mov",-1,"k_descr");									//Obtener el costo promedio para aplicar como precio				rstXml(xmlReqEst);				setXml(xmlReqEst,"document","sucursal",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","clave_producto",prod_original);				cmd="select * from keplersc.invr_obtener_costo_promedio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				rstXml(cuboCosto);				cuboCosto =  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Producto()");				frn.lib("libGeneral.kpl","FileSave",cuboCosto,"C:\Basura\cuboCosto");								ok=getXmlAtt(cuboCosto,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				costo = getXmlAtt(cuboCosto,"r0","costo_prom_total");				if (costo == 0){					costo = getXmlAtt(cuboCosto,"r0","ultimo_costo");				}					frn.setX(prodBuscar,"k_mov",-1,"k_parte");				frn.setX(getXmlAtt(cuboProd,"r0","c2"),"k_mov",-1,"k_descr");				frn.setX(getXmlAtt(cuboProd,"r0","c19"),"k_mov",-1,"k_unidad");				frn.setX(1,"k_mov",-1,"k_q");				frn.setX(costo,"k_mov",-1,"k_precio");					frn.setX(prod_original,"k_mov",-1,"k_partesel");							//No se duplique el articulo				refacc_duplicada();				CalcTotal();			}						//Valida refacciones duplicadas			fun refacc_duplicada(){					var renglon_id, renglones, articulo;				renglones = frn.N("k_mov")-1;				renglon_id = frn.getIdJ("k_mov");				articulo = frn.get("k_mov",-1,"k_parte");				for (var i=0; i<renglones; i++) {					if (renglon_id != i){						if ( (frn.get("k_mov",i,"k_parte") &= articulo)) { 							frn.setX("","k_mov",-1,"k_parte");							frn.setX("","k_mov",-1,"k_q");							frn.setX("","k_mov",-1,"k_unidad");							frn.setX("","k_mov",-1,"k_precio");							frn.setX("","k_mov",-1,"k_monto");							frn.setX("","k_mov",-1,"k_descr");							frn.setX("","k_mov",-1,"k_partesel");							frn.message("Verifique, esta intentado dar de alta la misma refaccion: "& articulo,"Error","Aceptar");							return;						}					}					}			}			fun Cantidad(checa_cero){ //Si checa_cero=1, solo despliega la ventana de control auxiliar si la cantidad es 0				var bAux=(frn.get("k_tipon",-1,10) && frn.get("k_mov",-1,"k_recAux"));				if (checa_cero==1){					var Qiguales=1;					if(bAux){						var S=0; for(var i=0,n=frn.N("k_mov",-1,"k_recAuxReal");i<n;i++) S+=frn.get("k_mov",-1,"k_recAuxReal","r" & i,"k_q");						if(S!=frn.get("k_mov",-1,"k_q"))Qiguales=0;					}					if(Qiguales && frn.get("k_mov",-1,"k_q")>0)return;				}				if (bAux){					frn.setPos("k_mov",-1,"k_q");					Dialog(3,(frn.get("k_tipon",-1,2) &= "D")?"doc_aux":"doc_auxE","k_mov",frn.get("k_mov",-1,"k_bSer"),frn.get("k_mov",-1,"k_iLot"),frn.get("k_mov",-1,"k_bPed"),frn.get("k_mov",-1,"k_bUbi"),frn.get("k_mov",-1,"k_iTMC"),frn.get("k_pedimento"));				}else{					var bNoRojo=frn.get("k_tipon",-1,9),inv=frn.get("k_mov",-1,"k_inv"),q=frn.get("k_mov",-1,"k_q"),iNat=frn.get("k_mov",-1,"k_iNat");					if (bNoRojo&&inv<q&&iNat&!"N"&&iNat&!"V"){						frn.message("No se permite movimiento en rojo", "Error","&Aceptar");						frn.setX(inv,"k_mov",-1,"k_q");					}				}				CalcTotal();			}			fun ValidaPartidas(){				var producto,resultado,cmd,bValido,cuboProd,ok,mensajeError,prod_original,;								for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {					resultado = 1;					producto = frn.get("k_mov",i,"k_parte");					cmd="select * from keplersc.prod_obtener_original('" & producto & "')";					cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Producto()");					ok=getXmlAtt(cuboProd,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboProd,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						resultado = 0;					}													prod_original = getXmlAtt(cuboProd,"r0","prod_obtener_original");					if (prod_original &= "0"){						mensajeError="El producto " & producto & " no existe.";						frn.message(mensajeError,"Error","&Aceptar");						resultado = 0;					}									}				CalcTotal();				return resultado;			}									fun Unidad(){				//Verifica que la unidad seleccionada del producto sea vï¿½lida. Realiza la conversiï¿½n entre unidades.			}			fun Monto(){//Cambia el precio de la partida en base al monto especificado(importe de partida)				var prc=frn.get("k_mov",-1,"k_monto")/frn.get("k_mov",-1,"k_n");				frn.setX(prc,"k_mov",-1,"k_precio"); 				CalcTotal();			}						fun Formar_folio(){							var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				frn.lib("libGeneral.kpl","FileSave",cubofol,"C:\Basura\cuboFol");								var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");								frn.set("k_folio", fol);			}						fun Folio(){ //Consulta el documento especificado en el campo k_folio				var xmlDetalle,tmpStr,no_partidas;				var cmd,ok, clave_prod,cubo,cuboProd,prod_original;				kdb.sp("k_getDoc","datDoc",frn.get("k_sucn",-1,1),frn.get("k_tipon",-1,1),frn.get("k_tipon",-1,2),frn.get("k_tipon",-1,3),frn.get("k_tipon",-1,4),frn.get("k_folio")); 				kdb.exec();				xmlDetalle = kdb.get("datDoc");								//Agregar el tag k_q, el cual debe ser igual a k_Q, esto es porque postgresql maneja minusculas				no_partidas=nXml(xmlDetalle,"k_mov");				for(var i =0;i<no_partidas;i++){					setXml(xmlDetalle,"k_mov","r"&i,"k_q", getXml(xmlDetalle,"k_mov","r"&i,"k_Q"));					//Obtiene el prod_original de kdm2					cmd = "select c8,c28 from keplersc.kdm2 where c1='" & frn.get("k_sucn",-1,1) & "' and c2= '" & frn.get("k_tipon",-1,1) & "' and c3= '" & 						frn.get("k_tipon",-1,2) & "' and c4='" & frn.get("k_tipon",-1,3) & "' and c5= '" & frn.get("k_tipon",-1,4) & "' and c6 =upper('" & frn.get("k_folio") & "')" &						" and c8='" & getXml(xmlDetalle,"k_mov","r"&i,"k_parte") & "'";						cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Buscar_folio()");					ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					var lenght_xml = nXml(cubo); 					if(lenght_xml != 0 ){						prod_original=getXmlAtt(cubo,"r0","c28");												if(prod_original &="0" || prod_original &=""){								clave_prod = getXml(xmlDetalle,"k_mov","r"&i,"k_parte");							cmd="select * from keplersc.prod_obtener_original('" & clave_prod & "')";							cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Buscar_folio()");							prod_original = getXmlAtt(cuboProd,"r0","prod_obtener_original");						}						setXml(xmlDetalle,"k_mov","r"&i,"k_partesel",prod_original);					}					frn.rst(cubo);					frn.rst(cuboProd);								}frn.lib("libGeneral.kpl","FileSave",xmlDetalle,"C:\Basura\xmlConsCompra");											frn.setX(xmlDetalle); //Llenar grid de partes											frn.set("k_nombreprov",getXml(xmlDetalle,"k_nombre"));				frn.set("k_calleprov",getXml(xmlDetalle,"k_calle"));				frn.set("k_coloniaprov",getXml(xmlDetalle,"k_colonia"));				frn.set("k_poblacionprov",getXml(xmlDetalle,"k_poblacion"));				frn.set("k_cpprov",getXml(xmlDetalle,"k_163"));				var status=kdb.get("datDoc","err");				if (status==1001) frn.set("statusDoc","Documento referenciado");				else if (status==1002){ BorraDatos();frn.set("statusDoc","Documento no encontrado");}				else if (status==1003) frn.set("statusDoc","Documento cancelado");				else frn.set("statusDoc","");				CalcFolio();			}			fun CalcFolio(){//Se ejecuta despues de consultar documento en disco (consulta,documento previo,etc), para manipulaciones adicionales en pantalla				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {//Se recalcula el precio con mayor precisiï¿½n (decimales)					var prc=frn.get("k_mov",i,"k_monto")/frn.get("k_mov",i,"k_q");					frn.setX(prc,"k_mov",i,"k_precio");				}				CalcTotal();//Recalcula Totales			}			fun Ejecuta(){				if(tip_ope==0){Alta();}				else if(tip_ope==1){Consulta();}				else if(tip_ope==2){Baja();}			}									fun Alta(){//Genera el documento en base a los datos en pantalla.				var resultado, mensaje, adicionales, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd;				var partidasValidas, no_partidas, ok, mensajeError, prod_ui, prod_original,cuboProd,vdiferencia;				//Validar fecha				kdb.rst();				frn.rst("results");								fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				cmd= "select * from keplersc.verify_year('" & fecha & "')";				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Alta()");												resultado= getXml(cubo,"validacion","resultado");				mensaje = getXml(cubo,"validacion","mensaje");				if(mensaje &! ""){					frn.message(mensaje,"Error al generar el documento","Aceptar");				}				if(resultado &= "0"){					frn.setPos("k_fecha");					return;				}								//Validar clave del proveedor				if(strlen(trim(frn.get("k_clave")))==0){ 					frn.message("Es necesario especificar la clave del Proveedor","Error","&Aceptar");					frn.setPos("k_clave");return;					}							//Validar Factura o guia				if(strlen(trim(frn.get("k_refer")))==""){ 					frn.message("Es necesario especificar la factura o guía","Error","&Aceptar");					frn.setPos("k_refer");return;					}										if(validar_uuid &= "S"){					//Validar rfc y monto total de factura correspondan a datos de UUID					strTotal = frn.get("k_monto");					vdiferencia = (strTotal-total_uuid);											if (vdiferencia < 0){								vdiferencia = vdiferencia *(-1); 					}					if (vdiferencia > 0.1) {								frn.message("El importe total de la compra no corresponde al de la factura.","Error","Aceptar");						return;					}					if (frn.get("k_rfc") &! rfc_uuid) {						frn.message("El RFC de la compra no corresponde al de la factura.","Error","Aceptar");						frn.setPos("Buscar");return;					}				}							//Validar productos				for(var i =0;i<frn.N("k_mov");i++){					if(frn.get("k_mov",i,"k_parte")&!"" || frn.get("k_mov",i,"k_q")&!""){						if(frn.get("k_mov",i,"k_q")<=0 || strlen(frn.get("k_mov",i,"k_q"))==0){							frn.message("Se ha generado el siguiente error: producto con cantidad 0","Error al generar el documento","Aceptar");							frn.setPos("k_mov","ren:"&i);							return;						}						if(frn.get("k_mov",i,"k_parte")&=""){							frn.message("Se ha generado el siguiente error: clave de producto vacia","Error al generar el documento","Aceptar");							frn.setPos("k_mov","ren:"&i);							return;						}						if(frn.get("k_mov",i,"k_unidad")&=""){							frn.message("Se ha generado el siguiente error: unidad de producto vacia","Error al generar el documento","Aceptar");							frn.setPos("k_mov","ren:"&i);							return;						}						if(frn.get("k_mov",i,"k_precio")&="" || frn.get("k_mov",i,"k_precio")&="0"){							frn.message("Se ha generado el siguiente error: precio de producto cero","Error al generar el documento","Aceptar");							frn.setPos("k_mov","ren:"&i);							return;						}						}				}						partidasValidas = ValidaPartidas(); //LA funcion despliega mensaje de error en su caso				if(partidasValidas==0){					return;				}								if( frn.get("k_monto") <= 0 ){					frn.message("No se puede dar de alta el documento ya que el importe es cero","Error","&Aceptar");return;				}												//Fin de validaciones				fecha = sys.date();				hora= sys.time();				//cubo = "dat";				kdb.rst();				frn.rst("results");				frn.rst(xmlPantalla);				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;								//Recrear k_parte para pieza original y reemplazos				no_partidas=frn.N("k_mov")-1;											//Agregar usuario, fechay hora de movimiento				setXml(xmlPantalla,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));				setXml(xmlPantalla,"k_mov","no_partidas",no_partidas);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				no_partidas=frn.N("k_mov") -1;				for(var i =0;i<no_partidas;i++){					prod_ui = getXml(xmlPantalla,"k_mov","r" & i ,"k_parte");					prod_original = getXml(xmlPantalla,"k_mov","r" & i ,"k_partesel");					setXml(xmlPantalla,"k_mov","r" & i,"k_parte",prod_original);					setXml(xmlPantalla,"k_mov","r" & i,"k_partesel",prod_ui);				}							frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlCompraAlta");				cmd="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"comopecompras.Alta");//frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlResultadoCompra");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");				adicionales=getXml(cubo,"adicionales");								if(resultado &= "1"){					frn.set("k_folio",mensaje); 					frn.set("operacion","CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);					ConfiguraCamposOpcion();					Folio();					//Deshabilita_campos();										mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;					frn.message(mensaje, "Mensaje","&Aceptar");					if (strlen(trim(adicionales ))!=0){						frn.message(adicionales,"Mensaje","&Aceptar");					}					reporte();					frn.set("operacion","ALTA");					ConfiguraCamposOpcion();					BorraDatos();					frn.setPos("k_sucn");				}else{					frn.message(mensaje, "Error","&Aceptar");				}						}						fun Consulta(){//Imprime el reporte del documento especificado 				if(strlen(trim(frn.get("k_folio")))==0){ 					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");					frn.setPos("k_folio");					return;					}				reporte();				frn.setPos("k_folio");			}						fun Baja(){ //Borra totalmente el docuemtno especificado. (No deja huella del documento)									var resultado, mensaje, adicionales, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd;				var partidasValidas = 0;				var no_partidas, prod_ui, prod_original;				var ok, mensajeError;								fecha = sys.date();				hora= sys.time();				//cubo = "dat";				kdb.rst();				frn.rst("results");				frn.rst(xmlPantalla);				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				setXml(xmlPantalla,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);								no_partidas=frn.N("k_mov") -1;				for(var i =0;i<no_partidas;i++){					prod_ui = getXml(xmlPantalla,"k_mov","r" & i ,"k_parte");					prod_original = getXml(xmlPantalla,"k_mov","r" & i ,"k_partesel");					setXml(xmlPantalla,"k_mov","r" & i,"k_parte",prod_original);					setXml(xmlPantalla,"k_mov","r" & i,"k_partesel",prod_ui);				}				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlCompraBaja");				cmd="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"comopecompras.Baja");//frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlResultadoCompra");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");				adicionales=getXml(cubo,"adicionales");								if(resultado &= "1"){					frn.set("k_folio",mensaje); 					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);					Folio();					//Deshabilita_campos();										mensaje = "Documento con Folio: " & mensaje & " cancelado correctamente."; 					frn.message(mensaje, "Mensaje","&Aceptar");					if (strlen(trim(adicionales ))!=0){						frn.message(adicionales,"Mensaje","&Aceptar");					}					ConfiguraCamposOpcion();					BorraDatos();					frn.setPos("k_sucn");				}else{					frn.message(mensaje, "Error","&Aceptar");				}									}							fun reporte(){				var cmd, cuboResultados , ok,mensajeError;				// Se define el formato a usar				var prefix=frn.lib("libKepler","langPrefix");				//var pageFto="\#092"&"k80_xsddesarrollo"&"\#092"&prefix&"comopecomprasfto"; //"\k80_xsddesarrollo\" & prefix & "comopecomprasfto"; //prefix&"comopecomprasfto";				//kdb.readPage("datos", pageFto);//se define el formato a usar								kdb.readPage("datos","comopecomprasfto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos")); 				rep.rst(); 				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				rep.set("titulo",frn.get("k_tipon"));				rep.exe("tit");					//rep.set("rep_suc_id",frn.get("k_sucn",-1,1));				rep.set("rep_suc",frn.get("k_sucn"));				//rep.set("rep_alm",frn.get("k_almN")); //No se manejan almacenes, solo 1 por defecto				rep.set("rep_docto",frn.get("k_docto"));				rep.set("rep_moneda",frn.get("k_moneda"));				rep.set("rep_fecha",frn.get("k_fecha"));				rep.set("rep_folio",frn.get("k_folio"));				rep.set("rep_cliente",frn.get("k_clave"));				rep.set("rep_clientedir1",frn.get("k_nombreprov"));				rep.set("rep_clientedir2",frn.get("k_calleprov"));				rep.set("rep_clientedir3",frn.get("k_coloniaprov"));				rep.set("rep_clientedir4",frn.getM("k_poblacionprov"));				rep.set("rep_rfc",frn.get("k_rfc"));				rep.set("rep_condiciones",frn.get("k_cond"));				rep.set("rep_leyenda",frn.get("leyenda"));				rep.set("rep_fechaen",frn.get("k_vence"));				rep.set("rep_refer",frn.get("k_refer"));				rep.exe("encabezado");				rep.exe("partidas");				for(var i=0,n=frn.N("k_mov")-1;i<n;i++){					rep.set("rep_cantidad",frn.get("k_mov",i,"k_q"));					rep.set("rep_unidad",frn.get("k_mov",i,"k_unidad"));					rep.set("rep_clave",frn.get("k_mov",i,"k_parte"));					rep.set("rep_producto",frn.get("k_mov",i,"k_descr"));					rep.set("rep_precio",frn.get("k_mov",i,"k_precio"));					rep.set("rep_importe",frn.get("k_mov",i,"k_monto"));									rep.exe("partida");				}				rep.exe("lineaFinal");rep.exe("vacio");				rep.set("rep_TotalLetras","***" & strFormat("number",frn.get("k_monto"),0,frn.get("k_moneda")) & " " & frn.get("k_moneda",-1,2));				rep.exe("partida2");				rep.exe("vacio");				rep.set("rep_comentario1",frn.getM("k_coment",0));				rep.set("rep_comentario2",frn.getM("k_coment",1));				rep.set("rep_comentario3",frn.getM("k_coment",2));				rep.set("rep_subtotal",frn.get("subt"));				rep.set("rep_iva",frn.get("k_iva"));				rep.set("rep_total",frn.get("k_monto"));				rep.exe("fin");								//Procesa poliza contable				var tablakdc1_alta = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;				var tablakdc2_alta = " keplersc.kdc2" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) & strSplit(frn.get("k_fecha"), "-", 1);				//var tablakdc1_baja = " keplersc.kdc1" & mid(strSplit(fecha_baja, "-", 0), 2,2) ;				//var tablakdc2_baja = " keplersc.kdc2" & mid(strSplit(fecha_baja, "-", 0), 2,2) & strSplit(fecha_baja, "-", 1);				var tipo = ""; var nPolAlta = "" ;				sucursal_id=frn.get("k_sucn",-1,1);						//if (tablakdc2_baja &= tablakdc2_alta ){					tipo = "Misma_tabla";										cmd= " select c1 as num_pol from " & tablakdc2_alta & " where c14='" & sucursal_id  & "' and c15='" & gen_doc & "' and c16= '" & nat_doc & "'" ;					cmd = cmd & " and c17='" & gpo_doc & "' and c18='" & tip_doc & "' and c19='" & frn.get("k_folio")& "'";									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Reporte()");					frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");									ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}									nPolAlta =getXmlAtt(cuboResultados,"r0", "num_pol" );								//}				imprime_poliza(tablakdc1_alta , tablakdc2_alta, "Alta", tipo, nPolAlta);								rep.win(); 			}						fun imprime_poliza(tablakdc1 , tablakdc2, operacion, tipo, nPolAlta ){							var cmd, cuboResultados , ok,mensajeError;								//Procesa poliza contable				cmd= " select kc2.c1 as num_pol, kc2.c3 as cuenta, kc2.c4 as tipo_asiento, kc2.c5 as monto, kc1.c2 as desc_pol, kc2.c7 as refer, kc2.c8 as tipo_pol from " & tablakdc2 & " as kc2 " ;				cmd = cmd & " inner join " & tablakdc1 & " as kc1 on kc1.c1=kc2.c3 ";				cmd = cmd & " where kc2.c14='" & frn.get("k_sucn", -1, 1) & "' and kc2.c15='" & gen_doc & "' and kc2.c16= '" & nat_doc & "' and kc2.c17='" & gpo_doc & "' and kc2.c18='" & tip_doc & "' and kc2.c19='" & frn.get("k_folio")& "'";				if (operacion &= "Alta" && tipo &= "Misma_tabla"){					cmd = cmd & " and kc2.c1 = " & nPolAlta ; 				}				if (operacion &= "Baja" && tipo &= "Misma_tabla"){					cmd = cmd & " and kc2.c1 <> " & nPolAlta ; 				}												//Added by JMM 20240314				cmd = cmd & " order by kc2.c1, kc2.c10 "; 				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.imprime_poliza()");				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var nRenPol= nXml(cuboResultados);				var tPoliza=getXmlAtt(cuboResultados,"r0", "tipo_pol" );				var nPoliza=getXmlAtt(cuboResultados,"r0", "num_pol" );								if (strlen(tPoliza)>0 && strlen(nPoliza)>0 ){						rep.set("tPol",tPoliza);						rep.set("nPol",nPoliza);						rep.exe("encabezadoPol");						var tAbonosPol=0, tCargosPol=0;						for(var i=0;i<nRenPol;i++){							if (getXmlAtt(cuboResultados,"r"&i, "tipo_asiento" )&= "A"){								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave2",cuenta );								rep.set("PolDescr2",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolHaber",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tAbonosPol=tAbonosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								//pol_saldo_presupuesto(cuenta);								//rep.set("PolSaldo2",saldo);								//rep.set("PolPresupuesto2",presupuesto );								rep.exe("partPolA");							}else{								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave",cuenta );								rep.set("PolDescr",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolDebe",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tCargosPol=tCargosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								//pol_saldo_presupuesto(cuenta);								//rep.set("PolSaldo",saldo );								//rep.set("PolPresupuesto",presupuesto );								rep.exe("partPolC");							}						}						rep.set("totCargo",tCargosPol);						rep.set("totAbono",tAbonosPol);						rep.exe("PolTotales");				}			}					fun ObtenerFolio(){				var cmdQuery;				cmdQuery="select c6 as folio, to_char(c9, 'dd/mm/yyyy') as fecha, c10 as cliente, c32 as nombre,c11 as factura, c16 as monto, c43 as status " & 					"from keplersc.kdm1 where c1='" & 					frn.get("k_sucn",-1,1) & "' and c2='" & gen_doc & "' and c3='" & nat_doc & "' and c4=" & gpo_doc 					& " and c5=" & frn.get("k_tipon",-1,4);						if (tip_ope == 2 ){						cmdQuery = cmdQuery & " and c43 <> 'C' ";					}										cmdQuery = cmdQuery & " order by c9 desc";					frn.dialog("genlistafiltrosel","Movimiento a taller",cmdQuery,"folio","k_folio","0","0","N","N");								}									fun ObtenerFactura(){				var nCampos, uuid="";				//Regresara la funcion UUID cadena con UUID, rfc, fecha, total				uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID","k_refer", 0,"0");				nCampos = strSplit(uuid,"|",-1);				if (nCampos > 1) {						str_uuid = strSplit(uuid,"|",0);		//UUID						rfc_uuid = strSplit(uuid,"|",1);		//rfc						fecha_uuid = strSplit(uuid,"|",2);		//fecha						total_uuid = strSplit(uuid,"|",3);		//monto de la factura											frn.set("k_refer",str_uuid);				} else{					frn.set("k_refer","");					frn.message("Faltan datos del UUID","Error","Aceptar");						}							}									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaciï¿½n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaciï¿½n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para pï¿½ginas de operacion:Solo si se estï¿½ en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverï¿½ el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}				}				</script></pag>