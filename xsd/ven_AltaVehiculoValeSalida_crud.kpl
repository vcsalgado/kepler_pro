<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Alta de Vale">	<grp id="grpMain" brdr="0,0" clr="0,58,112" fnt="Arial,18b"  dim="1,-1,10,8" bclr="192,205,213" clrBrdr="0,97,181" OnF1="Dialog(1,altapedido_crud)" tit="Alta de Vale" unfont="0">	<br/>	<tab/><inp id="inp_titulo" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>	<br/><tab/><hLine clr="0,0,0"/>	<br/><br/>	<tab/>		<grp id="grpDatosGenerales" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="50,10,7,12" tit="Datos generales"  fnt="Arial,16" available="Y" modify="Y">		<sp/><txt clr="0,58,112" hk="S">Sucursal</txt><tab/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" 				brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y" OnChange="CambiaSucursal()"/>			<br/>						<sp/><txt clr="0,58,112">Grupo docto</txt>			<cmb id="grpDoc" clr="64,64,64" clrBrdr="255,255,255"   dim="25,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="0)" available="N" modify="Y"/>			<br/>			<sp/><txt clr="0,58,112">Tipo docto</txt><tab/>			<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255"  dim="25,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="Valida_Tipo_Docto()" available="Y"/><br/>		</grp><sp/>		<grp id="grpDocumentos" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="30,10,7,12" tit="Documento"  fnt="Arial,16" available="Y" modify="Y">			<tab n="2"/><inp id="operacion" clr="64,64,64"  dim="18,1" brdr="0,1" fnt=",18b" available="N" type="string"/><br/><tab/>			<txt id="foliotxt"  visible="N" hk="F" clr="0,58,112">Folio</txt><tab n="2"/>			<edt id="k_folio" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" visible="Y" hk="F" type="string" nc="10"								OnF9="ObtenerFolio()" 				OnChange = "ConsultarFolio()"				modify="Y"/><br/><tab/>			<inp id="k_docto" clr="64,64,64"  dim="18,1" brdr="0,1" fnt="Arial,16" available="N" link="k_tipon,5" type="string"/><br/>			<tab/><txt clr="0,58,112">Fecha</txt><tab/>			<edt id="k_fecha" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" OnButton="Dialog(0,_ks_fecha,k_fecha)" OnF9="Dialog(0,_ks_fecha,k_fecha)" modify="N" available="N"/><txt clr="255,0,34" fnt=",18b"> *</txt><br/><tab/>			<inp id="statusDoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/><br/><tab n="2"/>					</grp><br/><tab/><txt fnt=",16" clr="251,4,21">Nota: los vales de salida que se emiten entre los d&#237;as 1 y 6 del mes se procesan al &#250;ltimo d&#237;a del mes anterior. </txt><br/><br/><br/>		<tab/>		<grp id="grpDetalle" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5" dim="81,24,7,12" tit="Detalle"  fnt="Arial,16" available="Y" modify="Y">			<grp id="grpInventario" dim="200,24,7,12" hSpace="4" available="Y" modify="Y">				<tab n="2"/><txt>Inventario</txt><tab n="4"/>				<inp id="k_inventario" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="10" available = "N" tooltip="Inventario ..." modify="Y" 				OnF9="BusquedaInventario()"				OnChange="MostrarInventario()"/>				<tab n="2"/><txt>Tipo Auto </txt>				<cmb id="k_tipo_auto" clr="64,64,64" clrBrdr="255,255,255" dim="10,5" bclr="255,255,255" brdr="4,0" fnt="Arial,16" Null="N" available="N" modify="Y"/><tab/><txt>[D]emo, [N]uevo o [U]sado.</txt>				<br/>								<tab n="2"/><txt>Vendedor</txt><tab n="4"/>				<cmb id="k_vendedor" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="N"/>								<br/>				<tab n="2"/><txt>Coach</txt><tab n="4"/>				<cmb id="k_coach" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="N"/>				<br/>				<tab n="2"/><txt>Asesor CC</txt><tab n="3"/>				<cmb id="k_asesor_cc" clr="64,64,64" clrBrdr="255,255,255"  dim="15,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="N"/>				<br/>				<tab n="2"/><txt>Vendido a:</txt><tab n="3"/>				<inp id="k_clave_cliente" clr="64,64,64" clrBrdr="255,255,255"  dim="80,1" bclr="236,240,243" fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="string"/>				<br/><tab n="8"/> <grp id="grpDatosClientes" bclr="255,255,255" fntClrBrdr="240,220,200" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="81,5,7,12" fnt="Arial,16" available="Y" modify="Y">								<inp id="k_nombre_cliente" clr="64,64,64" clrBrdr="255,255,255" dim="80,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N"/>				<br/>				<inp id="k_calle_numero" clr="64,64,64" clrBrdr="255,255,255"  dim="80,1" bclr="255,255,255"  fnt="Arial,16" nr="3,60" modify="Y" available="N" type="string"/>				<br/>				<inp id="k_colonia" clr="64,64,64" clrBrdr="255,255,255"  dim="80,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N"/>				<br/>								</grp><sp/>				<br/>								<tab n="4"/><txt>Importe:</txt><tab n="2"/>				<txt>$</txt>				<inp id="k_monto" clr="64,64,64" dim="18,1" visible="Y" fnt="Arial,16" type="number" nc="16" modify="N" available="N" nd="2" just="R"/>				<br/>							<tab n="29"/>		<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Consulta()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="N" clrBrdr="0,0,0" visible="N" modify="Y"/>		<tab/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/><tab/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><tab/>										</grp>																		<br/>									</grp>						<br/><br/><tab/>			<br/><br/><tab n="1"/>	</grp>	<tools>		<tool OnMouseL="Ejecuta()" tooltip="Aceptar documento(Ctrl+T)" scut="Ctrl+T" img="_TL_Execute.png"/>	</tools>	<script>		InstallDriver("KDB75");		class Main {			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc,usuario,sucursal_id,suc_usuario,rol_usuario,asterisco, v_inventario,valorRetorno,v_IvaAuto,v_correo,v_uso_cfdi;			var frn,kdb,rep,frP,sys;			var tip_ope;//Tipo de operación. "0" indica Alta; "1" indica consulta; "2" indica cancelación; "3" indica baja; "4" Indica modificación			var uen;			var anio_contable;			var v_A98;			/* PARáMETROS de la página indicados desde Tree, o desde frn.Dialog			param(0) = Género			param(1) = Naturaleza			param(2) = Grupo			param(3) = Tipo			param(4) = Fija Documento. Si "1", no permite seleccionar otro tipo de documento. Si "0" los combos de grupo  y tipo de documento se habilitan.			param(5) = Tipo de operación. "0" indica Alta; "1" indica consulta; "2" indica cancelación; "3" indica baja; "4" Indica modificación			*/						fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("c,kdm1,i,kdini,q,kdiq,m,kdmm,s,kdms,u,kdxd,v,kdxv,p,kdip,e,kdxe,f,kdxf,w,kdc2");				ConfiguraControlesOff();				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				inicializa();			}					fun ConsultarFolio() 			{				var xmlRequest,				 cmd,				 ok, 				 cuboResultados,				 mensajeError;				 				cmd = "select c100,c110,c9,c12,c10,c32,c33,c34,c35,c16 from keplersc.kdm1 where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc&  "' and c3 = '" & nat_doc&  "' and c4 = '" & gpo_doc&  "' and c5 = '" & tip_doc&  "' and c6 = '" & frn.get("k_folio") & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_altavehiculovalesalida.consultarFolio()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				frn.set("k_inventario",getXmlAtt(cuboResultados,"r0","c100"));				frn.set("k_tipo_auto",getXmlAtt(cuboResultados,"r0","c110"));				frn.set("k_vendedor",getXmlAtt(cuboResultados,"r0","c12"));				frn.set("k_asesor_cc","SA");				frn.set("k_clave_cliente",getXmlAtt(cuboResultados,"r0","c10"));				frn.set("k_nombre_cliente",getXmlAtt(cuboResultados,"r0","c32"));				frn.set("k_calle_numero",getXmlAtt(cuboResultados,"r0","c33"));				frn.set("k_colonia",getXmlAtt(cuboResultados,"r0","c34") &" "& getXmlAtt(cuboResultados,"r0","c35"));				frn.set("k_monto",getXmlAtt(cuboResultados,"r0","c16"));				if(tip_ope==3)				{					//Validar	que	el vale	de salida no este dado de baja					cmd = "select count(*) as total from keplersc.kdcomismov where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc&  "' and c3 = '" & nat_doc&  "' and c4 = '" & gpo_doc&  "' and c5 = '" & tip_doc&  "' and c6 = '" & frn.get("k_folio") & "' and c10='1' ";					rstXml(cuboResultados);					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_altavehiculovalesalida.validarBaja()");					ok = getXmlAtt(cuboResultados ,"ok");					if(ok &! "" && !ok)					{						mensajeError = getXmlAtt(cuboResultados ,"native3");						frn.message(mensajeError,"Criterios no encontrados en baja.","Aceptar");						return;					}					var total= getXmlAtt(cuboResultados,"r0","total");						if(total&="1"){						frn.message("El vale de salida ya está dado de baja.");						frn.setAtt("Aceptar","available","N");						frn.setAtt("Aceptar","visible","N");												}else{						frn.setAtt("Aceptar","available","Y");						frn.setAtt("Aceptar","visible","Y");						}							}							}						//			fun ObtenerFolio() 			{				  var cmdQuery ="",v_tipo_n;					v_tipo_n = frn.get("k_tipon",-1,4);					sucursal_id = frn.get("k_sucn",-1,1);					cmdQuery = "select c5 as tipo,c6 as folio,to_char(c9, 'dd/mm/yyyy') as fecha,c100 as inventario,c16 as importe  from keplersc.kdm1  where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc&  "' and c3 = '" & nat_doc&  "' and c4 = '" & gpo_doc&  "' and c5 = '" & tip_doc&  "' ";					cmdQuery = cmdQuery & " order by c6 desc, c9 desc ";					frn.dialog("genlistasel","Baja Vale de Salida.",cmdQuery,"folio","k_folio","0","","N");			}						//INVENT								fun MostrarInventario() //INV_FACTURA_LINK			{				var xmlRequest,					 cmd,					 ok, 					 cuboResultados,					 mensajeError,					 totOrd,					 contOrd;					 					 sucursal_id = frn.get("k_sucn",-1,1);					 v_inventario = frn.get("k_inventario");					 				cmd = "select c21 from keplersc.kdinf where c1 = '" & sucursal_id &  "' and c2 = '" & v_inventario & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.MostrarInventrio()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				var v_nuevo_usado= getXmlAtt(cuboResultados,"r0","c21");				frn.set("k_tipo_auto",mid(v_nuevo_usado,0,1));												//*******************************************Obtener KDPEDIDO				cmd = "select (select '['||c2||'] '||c3 from keplersc.kduv where c1 = p.c1 and c2 = p.c10) as c10,p.c9,p.c14,(select '['||c1||'] '||c2 from keplersc.KDCATCOACH where c1 = p.c42) as c42, (select k.c3 from keplersc.kdud k where k.c2 = p.c9) as c3,(select k.c4 from keplersc.kdud k where k.c2 = p.c9) as c4,(select k.c5 from keplersc.kdud k where k.c2 = p.c9) as c5  from keplersc.kdpedido p where p.c1 ='" & sucursal_id &  "' and p.c2 = '" & v_inventario & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.MostrarInventrio()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}								frn.set("k_vendedor",getXmlAtt(cuboResultados,"r0","c10"));				frn.set("k_clave_cliente",getXmlAtt(cuboResultados,"r0","c9"));				frn.set("k_monto",getXmlAtt(cuboResultados,"r0","c14"));				frn.set("k_coach",getXmlAtt(cuboResultados,"r0","c42"));				frn.set("k_nombre_cliente",getXmlAtt(cuboResultados,"r0","c3"));								frn.set("k_calle_numero",getXmlAtt(cuboResultados,"r0","c4"));								frn.set("k_colonia",getXmlAtt(cuboResultados,"r0","c5"));				}					fun BusquedaInventario()			{				var cmdQuery ="";					sucursal_id = frn.get("k_sucn",-1,1);					cmdQuery = "select c2 as inventario, c3 as Clave,c4 as Descripcion, c5 as Serie from keplersc.kdinf where c1 = '" & sucursal_id &  "' and c32 = 50 ";						cmdQuery = cmdQuery & " order by c2 asc ";						frn.dialog("genlistasel","Alta Pedido / Inventario ",cmdQuery,"inventario","k_inventario","0","","N");            			}					fun inicializa(){//Da valor a los combos y prepara la página dependiendo del tipo de Operación a realizar				var resValidacion,resMensaje,cubo,cmd,ok,mensajeError,sucursal_id,v_cliente,v_tipoOperacion;				var fechaMovto, diaMovto;				kdb.kde("KDE");//								Configuración del servidor				kdb.exec();				anio_contable = kdb.get("KDE","14");								fechaMovto=sys.date();				diaMovto=fnDate("day", fechaMovto);				if(diaMovto <= 6){					diaMovto=diaMovto - diaMovto - diaMovto; //El *-1 no funciona, para este efecto se hace una resta doble					fechaMovto=fnDate("add",fechaMovto,diaMovto);					diaMovto=fnDate("dayweek", fechaMovto);					/*					if(diaMovto==0){						fechaMovto=fnDate("add",fechaMovto,-1);					}					*/				} 				frn.set("k_fecha",fechaMovto);//				frn.set("k_fecha",sys.date());												if(frn.nParam()>0 ){//Se han mandado parámetros a la página					gen_doc=trim(frn.param(0)); 					nat_doc=trim(frn.param(1)); 					gpo_doc=trim(frn.param(2));					tip_doc=trim(frn.param(3)); 					fija_doc=trim(frn.param(4));					tip_ope=trim(frn.param(5));					uen=trim(frn.param(6));				}				else				{					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}				ConfiguraCamposOpcion();				if(tip_ope==0)				{//Baja					v_tipoOperacion = "Alta de Vale";				}				if(tip_ope==3)				{//Baja					v_tipoOperacion = "Baja de Vale";									}				if(tip_ope==1)				{//Baja					v_tipoOperacion = "Consulta Vale";				}				frn.set("inp_titulo",v_tipoOperacion);				addDocto(v_tipoOperacion,gen_doc,nat_doc,gpo_doc,0,0,"A",30,35);												//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));							//Llena combo tipo				LlenaCmbTipo();										Fecha();//Indica fecha correcta, y trae monedas y paridades de esa fecha. 				if (strlen(tip_doc)>0) frn.setPos("k_tipon",-1,4,"internal:Y","val:" & tip_doc);//Posiciona el combo de Tipo de documento al especificado como parï¿½metro								//LlenaCmbMoneda();				//Llenar Vendedor k_vendedor	k_tipo_operacion k_coach					LlenaCmbVendedores();												frn.setX("D", "k_tipo_auto",0,0);				frn.setX("N", "k_tipo_auto",1,0);				frn.setX("U", "k_tipo_auto",2,0);				frn.setX("SA", "k_asesor_cc",0,0);				//				//Llenar k_coach				cmd = "select '['||c1||'] '||c2 as c3, c2,c1  from keplersc.KDCATCOACH";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaPedido.Coach()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_coach",getXml(cubo));								if(tip_ope==0){//Alta					frn.set("operacion","ALTA");				}				else if(tip_ope==1){//Consulta					frn.set("operacion","CONSULTA");				}				else if(tip_ope==2){//Cancelaciï¿½n					frn.set("operacion","CANCELACIÓN");				}					else if(tip_ope==3){//Baja					frn.set("operacion","BAJA");				}					else if(tip_ope==4){//Modificaciï¿½n					frn.set("operacion","MODIFICACIÓN");				}				v_A98 = "S";				BorraDatos();			}									fun LlenaCmbTipo(){				var cubo,cmd,ok,mensajeError;				sucursal_id=frn.get("k_sucn",-1,1);									cmd = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and col_sucursal='" & sucursal_id & "'";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Inicializa()");				//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTipoDocto");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_tipon",getXml(cubo));				}							fun LlenaCmbVendedores(){				var cubo,cmd,ok,mensajeError;				sucursal_id = frn.get("k_sucn",-1,1);				cmd = "select '['||c2||'] '||c3 as c1, c3,c2 from keplersc.kduv where c1 = '" & sucursal_id &  "'";									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaPedido.Vendedor()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_vendedor",getXml(cubo));			}						fun CambiaSucursal(){				sucursal_id = frn.get("k_sucn",-1,1);				LlenaCmbTipo();				LlenaCmbVendedores();				Valida_Tipo_Docto();			}						fun LlenaCmbMoneda(){				frn.setX("PESOS","k_moneda",0,0);			} 						fun Valida_Tipo_Docto(){				var resValidacion, resMensaje, cubo, cmd, ok, tip_doc;							//Valida documento vigente				tip_doc=frn.get("k_tipon",-1,4);				kdb.rst();								cmd= "select * from keplersc.verify_valid_document('" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & tip_doc & ")"; //genero text, naturaleza text, grupo integer, tipo_movto integer				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Valida_Tipo_Docto()");								resValidacion= getXml(cubo,"validacion","resultado");				resMensaje = getXml(cubo,"validacion","mensaje");				if(resMensaje &! ""){					frn.message(resMensaje, "Mensaje","&Aceptar");					frn.setPos("k_tipon");				}								}						fun ConfiguraControlesOff()			{				var strValAtr;				strValAtr = "N";				//Deshabilita todos los campos y botones				frn.setAtt("grpDatosGenerales","available",strValAtr);				frn.setAtt("grDocumentos","available",strValAtr);								frn.setAtt("grpDoc","available","N");				//frn.setAtt("grpDetalle","available",strValAtr);				//frn.setAtt("grpInventario","available",strValAtr);												frn.setAtt("k_inventario","available",strValAtr);				frn.setAtt("k_tipo_auto","available",strValAtr);				frn.setAtt("k_vendedor","available",strValAtr);				frn.setAtt("k_coach","available",strValAtr);				frn.setAtt("k_asesor_cc","available",strValAtr);												frn.setAtt("grpconceptosextras","available",strValAtr);				frn.setAtt("grpComentarios","available",strValAtr);				frn.setAtt("Aceptar","available",strValAtr);				frn.setAtt("Aceptar","visible",strValAtr);				frn.setAtt("Imprimir","available",strValAtr);				frn.setAtt("Imprimir","visible",strValAtr);					frn.setAtt("Cancelar","available",strValAtr);				frn.setAtt("Cancelar","visible",strValAtr);									frn.setAtt("k_folio","modify",strValAtr);					frn.setAtt("k_folio","visible",strValAtr);										frn.setAtt("k_fecha","modify",strValAtr);					frn.setAtt("k_fecha","available",strValAtr);					}						fun ConfiguraCamposOpcion(){				var strValAtr;				ConfiguraControlesOff();				//HAbilita segun tipo de operacion				strValAtr = "Y";				switch(tip_ope){					case 0: //Alta						frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpDatosGenerales","modify",strValAtr);						frn.setAtt("grDocumentos","available",strValAtr);						frn.setAtt("grDocumentos","modify",strValAtr);						//frn.setAtt("grpDetalle","available",strValAtr);						//frn.setAtt("grpDetalle","modify",strValAtr);						//frn.setAtt("grpInventario","available",strValAtr);						//frn.setAtt("grpInventario","modify",strValAtr);										frn.setAtt("k_inventario","available",strValAtr);						frn.setAtt("k_tipo_auto","available",strValAtr);						frn.setAtt("k_vendedor","available",strValAtr);						frn.setAtt("k_coach","available",strValAtr);						frn.setAtt("k_asesor_cc","available",strValAtr);										frn.setAtt("grpconceptosextras","available",strValAtr);						frn.setAtt("grpconceptosextras","modify",strValAtr);						frn.setAtt("grpComentarios","available",strValAtr);						frn.setAtt("grpComentarios","modify",strValAtr);						frn.setAtt("Aceptar","available",strValAtr);						frn.setAtt("Aceptar","visible",strValAtr);							frn.setAtt("Cancelar","available",strValAtr);						frn.setAtt("Cancelar","visible",strValAtr);														break;					case 1: //Consulta												frn.setAtt("grpDatosGenerales","available",strValAtr);						//frn.setAtt("grpDocumentos","available",strValAtr);						//frn.setAtt("grpDocumentos","modify",strValAtr);						frn.setAtt("k_folio","modify",strValAtr);							frn.setAtt("k_folio","visible",strValAtr);												frn.setAtt("Imprimir","available",strValAtr);						frn.setAtt("Imprimir","visible",strValAtr);													break;					case 2: // modificar										break;					case 3: // BAJA						frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpDatosGenerales","modify",strValAtr);						frn.setAtt("grDocumentos","available",strValAtr);						frn.setAtt("grDocumentos","modify",strValAtr);						//frn.setAtt("grpDetalle","available","N");						//frn.setAtt("grpDetalle","modify","N");						frn.setAtt("grpProveedor","available","N");						frn.setAtt("grpProveedor","modify","N");												frn.setAtt("Aceptar","available",strValAtr);						frn.setAtt("Aceptar","visible",strValAtr);							frn.setAtt("Cancelar","available",strValAtr);						frn.setAtt("Cancelar","visible",strValAtr);						frn.setAtt("k_folio","modify",strValAtr);							frn.setAtt("k_folio","visible",strValAtr);																	break;					case 4: 						break;					default:				}											}									fun BorraDatos(){ //Limpia todos los campos para generar un nuevo documento. 				frn.set("k_folio","","statusDoc","","k_clave","","k_refer","","k_fecref",""); 				frn.rst("k_mov");frn.rst("k_poliza");								Clave(1);				if(tip_ope>0) frn.setPos("k_folio");							}						fun addDocto(Descripcion,Gen,Nat,Gru,bTipo_Especifico,bSoloAutorizado,NatPrv,GruPrv,Gru2Prv){				var renglon=frn.N("grpDoc");				frn.setX(trim(Descripcion),"grpDoc",renglon,0);				frn.setX(trim(Gen),"grpDoc",renglon,1);				frn.setX(trim(Nat),"grpDoc",renglon,2);				frn.setX(trim(Gru),"grpDoc",renglon,3);				frn.setX(trim(bTipo_Especifico),"grpDoc",renglon,4);				frn.setX(trim(bSoloAutorizado),"grpDoc",renglon,5);				frn.setX(trim(NatPrv),"grpDoc",renglon,6);				frn.setX(trim(GruPrv),"grpDoc",renglon,7);				frn.setX(trim(Gru2Prv),"grpDoc",renglon,8);			}								fun Clave(iModo){//Actualiza los datos del cliente o Proveedor 				if(iModo==0){					var cmd="datos,u,1,0,'" & frn.get("k_clave") & "',&,u1...u50,v3";kdb.rel("v2=u12"); kdb.search(cmd); 					kdb.exec(); 					if(kdb.ok("datos")==0){						if(strlen(trim(frn.get("k_clave")))>0)	frn.message("La clave "&frn.get("k_clave")&" no se encontró","Error","&Aceptar");						frn.setPos("k_clave");//La clave no existe					}				}else{kdb.rst("datos");}//Borra la info anterior				frn.set("k_clave",kdb.get("datos","u2"),"k_rfc",kdb.get("datos","u10"),"k_plazo",kdb.get("datos","u16"));				frn.set("k_nombreprov",kdb.get("datos","u3"));				frn.set("k_calleprov",kdb.get("datos","u4"));				frn.set("k_coloniaprov",kdb.get("datos","u5"));				frn.set("k_poblacionprov",kdb.get("datos","u6"));				frn.set("k_cpprov",kdb.get("datos","u27"));								//frn.setM("k_datCve",kdb.get("datos","u3"),kdb.get("datos","u4"),kdb.get("datos","u5"),kdb.get("datos","u6"),kdb.get("datos","u27"));				frn.setM("k_coment",kdb.get("datos","u24"),kdb.get("datos","u25"),kdb.get("datos","u26"));											}											fun Fecha(){//Verifica que la fecha del documento sea correcta. Ademï¿½s trae monedas y paridades de esa fecha. 				var cubo, cmd, resValidacion, resMensaje, fecha;				var validDate=frn.lib("libKepler","ValidOpDate",frn.get("k_fecha"));												frn.set("k_moneda","PESOS");				frn.set("k_paridad",0);								kdb.rst();				frn.rst("results");				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				if (tip_ope == 0 ){					cmd= "select * from keplersc.verify_year('" & fecha & "')";					cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Fecha()");									;										resValidacion= getXml(cubo,"validacion","resultado");					resMensaje = getXml(cubo,"validacion","mensaje");					if(resMensaje &! ""){						frn.message(resMensaje, "Mensaje","&Aceptar");					}											if(resValidacion &= "0"){						frn.setPos("k_fecha");						return;					}									}				//Plazo();			}														fun CalcFolio(){//Se ejecuta después de consultar documento en disco (consulta,documento previo,etc), para manipulaciones adicionales en pantalla				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {//Se recalcula el precio con mayor precisión (decimales)					var prc=frn.get("k_mov",i,"k_monto")/frn.get("k_mov",i,"k_Q");					frn.setX(prc,"k_mov",i,"k_precio");				}							}			fun Ejecuta(){				if(tip_ope==0){Alta();}				else if(tip_ope==1){Consulta();}				else if(tip_ope==2){Cancela();}				else if(tip_ope==3){Baja();}				else if(tip_ope==4){Modifica();}			}									fun Alta()			{				var resultado, mensaje, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd,				v_usocfdi,v_email,cubocliente;				var partidasValidas = 0;				kdb.rst();				frn.rst("results");								//seccion informacion adicional				cmd = "select c53,c11 from keplersc.kdud where c2 ='" & frn.get("k_clave_cliente") & "'";									//frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cuboAltaValeResult");				cubocliente = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaVale.ConsultarDatosCliente()");									v_usocfdi = getXmlAtt(cubocliente,"r0","c53");				v_email= getXmlAtt(cubocliente,"r0","c11");				//								if( frn.get("k_monto") <= 0 )				{					frn.message("Monto cero ó negativo","Error","&Aceptar");return;				}				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				cmd= "select * from keplersc.verify_year('" & fecha & "')";				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"CREW_PEDIDO.Alta()");				resultado= getXml(cubo,"validacion","resultado");				mensaje = getXml(cubo,"validacion","mensaje");				if(mensaje &! "")				{					frn.message(mensaje,"Error al generar el documento","Aceptar");				}									if(resultado &= "0")				{					frn.setPos("k_fecha");					return;				}												fecha = sys.date();				hora= sys.time();				//cubo = "dat";				kdb.rst();				frn.rst("results");				frn.rst(xmlPantalla);				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;				if (frn.get("k_cuenta") &="" ) 				{					frn.set("k_cuenta","000000");				}				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;								setXml(xmlPantalla,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));								setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"k_clave",frn.get("k_clave_cliente"));				setXml(xmlPantalla,"k_vendedor",frn.get("k_vendedor" , -1, 2));				setXml(xmlPantalla,"k_refer",frn.get("k_inventario"));				setXml(xmlPantalla,"k_natdocto",nat_doc);				setXml(xmlPantalla,"k_gpodocto",35); //definido para Alta				setXml(xmlPantalla,"k_tipodocto",tip_doc); 				setXml(xmlPantalla,"k_fecref",strFecha);				setXml(xmlPantalla,"operacion",frn.get("operacion"));				setXml(xmlPantalla,"k_ivadesglosado","N");				setXml(xmlPantalla,"k_nombreimprfact",frn.get("k_nombre_cliente"));				setXml(xmlPantalla,"k_claveinv",frn.get("k_inventario"));				setXml(xmlPantalla,"k_tipopagos","0");				setXml(xmlPantalla,"k_tipoauto",frn.get("k_tipo_auto", -1, 0));				setXml(xmlPantalla,"k_pedimento","");				setXml(xmlPantalla,"k_status_validacion","1");				setXml(xmlPantalla,"k_f_pago","r1","0");				setXml(xmlPantalla,"k_mov","no_partidas",0);				setXml(xmlPantalla,"k_foliodocto","VXX0000000");				setXml(xmlPantalla,"k_clavedepto","SA");				setXml(xmlPantalla,"k_cfdi",v_usocfdi);				setXml(xmlPantalla,"k_correo",v_email);								frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\verify_invalta");				cmd="SELECT * FROM keplersc.verify_invalta('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"altavevehículofactura.verify_invalta");				resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");				if(resultado &= "0")				{					frn.message(mensaje, "Error","&Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlAltaVehiculoValeSalida");				cmd = "SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"comopecompras.Alta");								resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");								if(resultado &= "1")				{					tip_ope = 1;					frn.set("k_folio",mensaje); 					frn.set("operacion","CONSULTA");										strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);					ConfiguraCamposOpcion();										mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;					frn.message(mensaje, "Mensaje","&Aceptar");				}else{					frn.message(mensaje, "Error","&Aceptar");				}			}						fun Consulta(){//Imprime el reporte del documento especificado 				if(strlen(trim(frn.get("k_folio")))==0){ 					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");					frn.setPos("k_folio");return;					}				reporte();				frn.setPos("k_folio");			}						fun Cancela() {				frn.message("Funciï¿½n no implementada...","Error","&Aceptar");			}						fun Baja()			{ 				var folio_baja,cubo,xmlPantalla,cuboResultados,cmd,ok,					mensajeError,resultado,mensaje,fecha, hora, strFecha, strTmp ;				frn.rst(xmlPantalla);				fecha = sys.date();				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								folio_baja = frn.get("k_folio");								xmlPantalla = getXml(frn.dataPag());				setXml(xmlPantalla,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));								setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"k_clave",frn.get("k_clave_cliente"));				setXml(xmlPantalla,"k_vendedor",frn.get("k_vendedor" , -1, 2));				setXml(xmlPantalla,"k_refer",frn.get("k_inventario"));				setXml(xmlPantalla,"k_natdocto",nat_doc);				setXml(xmlPantalla,"k_gpodocto",gpo_doc); //definido para Baja				setXml(xmlPantalla,"k_tipodocto",tip_doc); 				setXml(xmlPantalla,"k_fecref",strFecha);				setXml(xmlPantalla,"operacion",frn.get("operacion"));				setXml(xmlPantalla,"k_ivadesglosado","N");				setXml(xmlPantalla,"k_nombreimprfact",frn.get("k_c30"));				setXml(xmlPantalla,"k_claveinv",frn.get("k_inventario"));				setXml(xmlPantalla,"k_tipopagos","0");				setXml(xmlPantalla,"k_tipoauto",frn.get("k_tipo_auto", -1, 0));								setXml(xmlPantalla,"k_pedimento","");				setXml(xmlPantalla,"k_status_validacion","1");				setXml(xmlPantalla,"k_f_pago","r1","0");				setXml(xmlPantalla,"k_mov","no_partidas",0);								setXml(xmlPantalla,"k_folio",folio_baja);				setXml(xmlPantalla,"k_rol_usuario",rol_usuario);				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\cuboResultadosValepedidoBaja");								cmd="SELECT * FROM keplersc.verify_invbaja('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"altavevehículofactura.verify_invalta");				resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");				if(resultado &= "0")				{					frn.message(mensaje, "Error","&Aceptar");					return;				}												cmd="SELECT * FROM keplersc.cat_valepedido_baja_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"AltaPedido.Baja()");//frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboBajaVale");								resultado = getXml(cuboResultados,"resultado");				mensaje = getXml(cuboResultados,"mensaje");				if(resultado &= "0")				{					frn.message(mensaje, "Error","&Aceptar");					return;				}else{//					frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlAltaVehiculoValeSalida");//					cmd = "SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";//					kdb.rst(cubo);//					cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"comopecompras.Baja");															frn.message("Folio " & folio_baja & " se dió de baja.","Información","Aceptar");											}			}							fun Modifica(){				frn.message("Funciï¿½n no implementada...","Error","&Aceptar");			}			fun reporte()			{				//se obtiene la información a utilizar										sucursal_id = frn.get("k_sucn",-1,1);									v_inventario = frn.get("k_inventario");					var cmd ="",cuboProd,cuboProdB,ok,mensajeError,prodExiste;										cmd = "select k.c1,k.c39, k.c100, k.c9,k.c110,k.c12,k.c10,k.c32,k.c33,k.c34,k.c16, (select c7 from keplersc.kdud  where c2 = k.c10) as c7, k.c99, (select v.c3 from keplersc.kduv v where v.c1 = k.c1 and v.c2 = k.c12) as  c3 from keplersc.kdm1 k where k.c1 ='"&sucursal_id&"' and k.c2 = '" & gen_doc & "' and k.c3 = '" & nat_doc & "' and k.c4=" & gpo_doc & " and k.c5 = " & tip_doc & " and k.c6 = '" & frn.get("k_folio") & "'";										frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cuboAltaValeResult");					cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaVale.ConsultarReporte()");										ok=getXmlAtt(cuboProd,"ok");					if(ok &! "" && !ok)					{						mensajeError = getXmlAtt(cuboProd,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										/*prodExiste = getXmlAtt(cuboProd,"r0","c1");					if (prodExiste <= "0")					{						frn.message("El producto no existe.","Error","&Aceptar");						return;					}*/										cmd = "select c3,c4,c5,c6,c15,c10,c34,c11,c35 from keplersc.KDINF c where c.c1 = '" & sucursal_id  & "' and c.c2 = '" & v_inventario  & "'";					cuboProdB = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaValeSalida.ConsultareportesB()");										ok=getXmlAtt(cuboProdB,"ok");					if(ok &! "" && !ok)					{						mensajeError = getXmlAtt(cuboProdB,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					/*prodExiste = getXmlAtt(cuboProdB,"r0","c3");										if (prodExiste <= "0")					{						frn.message("El producto no existe.","Error","&Aceptar");						return;					}*/								var prefix=frn.lib("libKepler","langPrefix");								kdb.readPage("datos","ven_AltaVehiculoValeSalida_crud_fto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos")); 				rep.rst(); 				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");								rep.set("titulo",frn.get("k_tipon"));				rep.exe("tit");								rep.set("rep_suc",frn.get("k_sucn",-1,0));					rep.set("rep_docto","NA13001-" & frn.get("k_folio"));				rep.set("rep_refer",frn.get("k_folio"));				rep.set("rep_fecha",frn.get("k_fecha"));				rep.exe("encabezado");								rep.set("rep_ver","Version 7");				rep.set("rep_separadorA","====================================================================================================================================================================");				rep.set("rep_separador", "------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------");				rep.set("rep_separadorA1","====================================================================================================================================================================");				rep.set("rep_separador1", "------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------");				rep.set("rep_separador2", "------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------");				rep.set("rep_tit0","AUTORIZACIÓN PARA PAGO DE COMISIÓN");				rep.set("rep_tit1","DATOS DE LA UNIDAD");												rep.set("rep_nombrecliente",getXmlAtt(cuboProd,"r0","c32"));				rep.set("rep_telefono",getXmlAtt(cuboProd,"r0","c7"));				rep.set("rep_noFact","");				rep.set("rep_FechaFact","    /    /    ");				rep.set("rep_novale",frn.get("k_folio"));				rep.set("rep_vendedor",getXmlAtt(cuboProd,"r0","c12") & " "& getXmlAtt(cuboProd,"r0","c3"));								rep.set("rep_inventario","INVENTARIO: " & frn.get("k_inventario") & "   VEHÍCULO: "&getXmlAtt(cuboProdB,"r0","c3") & "   " & getXmlAtt(cuboProdB,"r0","c4"));								rep.set("rep_serie","            SERIE: " & getXmlAtt(cuboProdB,"r0","c5") & "   MOTOR: " & getXmlAtt(cuboProdB,"r0","c6") & "	 MODELO: " & getXmlAtt(cuboProdB,"r0","c15"));				rep.set("rep_exterior","    EXTERIOR: " & getXmlAtt(cuboProdB,"r0","c10") & " " & getXmlAtt(cuboProdB,"r0","c34") & "	 INTERIOR: " & getXmlAtt(cuboProdB,"r0","c11") &" "& getXmlAtt(cuboProdB,"r0","c35"));												rep.set("rep_1","_________________________");				rep.set("rep_1A","_________________________");				rep.set("rep_2","AUTORIZA PAGO");				rep.set("rep_2A","VERIFICÓ EXPEDIENTE");				rep.set("rep_3","Nombre y Firma");				rep.set("rep_3A","Nombre y Firma");				rep.set("rep_4","Gerente General");				rep.set("rep_4A","Encargado de Facturación ");								rep.set("rep_5","_______________________");				rep.set("rep_6","Nombre y Firma Vendedor");				rep.set("rep_7","" & getXmlAtt(cuboProd,"r0","c3"));								rep.exe("seccion_detalle");				rep.exe("seccion_detalle_tres");				rep.win(); 			}					fun Documentos(tipo) {//Tipo: 1)Permite consultar documentos; 2) Permite referenciar documentos previos; 3) Permite referenciar partidas previas				//var pag_dialogo="doc_part_prv";				switch(tipo){					case 1:						frn.dialog("doc_consulta","k_folio",frn.get("grpDoc",-1,1));						break;					case 2:						break;					case 3:						break;				}			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaciï¿½n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se estï¿½ en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}			//--Actualización, el Folio_operacion estaba reemplazandose con cero. 23/Dic/2022  Saltiel Cruz		// v1.0		}				</script></pag>