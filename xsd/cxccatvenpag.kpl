<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" dim="0,0,10,10" tit="Cat&#225;logo de vendedores">	<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="-1,-1,10,20" clrBrdr="0,97,181"  bclr="192,205,213" unfont="0" tit="Cat&#225;logo de vendedores" OnPgUp="PgUp" OnPgDn="PgDn" OnCtrPgUp="CtrPgUp" OnCtrPgDn="CtrPgDn" OnF1="Dialog(1,cxccatvenayu)" OnCtrIni="CtrIni" OnCtrEnd="CtrEnd" OnCtrDel="CtrDel" OnEnter="Exit"><br/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="45,14,7,12"  tit="Datos del vendedor" fnt="Arial,16"><tab/>			<txt hk="C" fnt="Arial,16">Clave del vendedor</txt><tab n="2"/>				<edt id="clave" clr="64,64,64" clrBrdr="255,255,255"  dim="12,1" type="capital" bclr="255,255,200" brdr="2,0" OnF9="Dialog(1,cxccatvenbus,clave)" OnButton="Dialog(1,cxccatvenbus,clave)" OnChange="Busca" nc="5" hk="C"/><br/><tab/>			<txt>Nombre del vendedor</txt><tab/>				<inp id="nombre" clr="64,64,64" clrBrdr="255,255,255"  dim="35,1" type="string" bclr="255,255,255" brdr="2,0" OnChange="Cambio(3,nombre)" nc="30"/><br/><br/><tab/>			<txt fnt="Arial,16">Comisi&#243;n s/venta</txt><tab n="2"/>				<inp id="sventa" clr="64,64,64" clrBrdr="255,255,255"  dim="8,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(4,sventa)" nc="7" type="number" nd="-1"/><txt> %</txt><br/><tab/><txt fnt="Arial,16">Comisi&#243;n s/cobro</txt><tab n="2"/>				<inp id="scobro" clr="64,64,64" clrBrdr="255,255,255"  dim="8,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(6,scobro)" nc="7" type="number" nd="-1"/><txt> %</txt><br/><tab/><txt fnt="Arial,16">Comisi&#243;n s/utilidad</txt><tab n="2"/>				<inp id="sutilidad" clr="64,64,64" clrBrdr="255,255,255"  dim="8,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(5,sutilidad)" nc="7" type="number" nd="-1"/><txt> %</txt><br/>		</grp><br/>	</grp>	<tools>		<tool name="endleft" OnMouseL="CtrIni()" img="_TL_First.png"/>		<tool name="left" OnMouseL="PgUp()" img="_TL_Previous.png"/>		<tool name="right" OnMouseL="PgDn()" img="_TL_Next.png"/>		<tool name="endright" OnMouseL="CtrEnd()" img="_TL_Last.png"/>	</tools>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys;			/* PARÁMETROS (Tienen sentido cuando la opción se ha ejecutado como diálogo.)			param(0) = Nombre del campo (o tabla) al que se devolverá la clave o descripción en la pantalla padre			param(1) = (Opcional) Nombre de la columna al que se devolverá la clave en la pantalla padre(Se debe especificar el grid en el parametro anterior)			param(2) = (Opcional) Bandera binaria de control. Es un string que indica ciertos parámetros de funcionamiento de la opción							Los caracteres se toman de izquierda a derecha y tienen el siguiente significado:							Bit 1= Si toma valor de 1, se devuelve la clave. Si toma valor de 0, se devuelve la descripción. Por default se toma valor de 1.							Bit 2= Si toma valor de 1, permite modificar el catálogo. Si toma valor de 0, no permite modificación. Por default se toma valor de 1.							Bit 3= Si toma valor de 1, permite insertar/borrar registros. Si toma valor de 0, no permite insertar/borrar. Por default se toma valor de 1.							Bit 4= Si toma valor de 1, permite cambiar de registro. Si toma valor de 0, no permite cambiar de registro. Por default se toma valor de 1.							Bit 5= Si toma valor de 1, regresa un cubo de memoria con campos principales de TODOS los registros(para guardar la info en un combo). Si toma valor de 0, solo regresa la clave o descripción. Por default se toma valor de 1.			param(3) = (Opcional) Función de la pantalla padre a ejecutar antes de regresarle el control.										Valor de retorno = clave o descripción del producto			*/			var bit1,bit2,bit3,bit4,bit5;//Banderas de comportamiento (Ver descripción arriba)			var tabla_base;//Tabla base del catalogo (Se abre con el alias "a")			var camposDeseados;//Campos de la tabla que se requieren(Ej: a1...a4)			fun Main() {				//Recibe como parametros el combo del almacen(strDlg0), y el combo de la sucursal(strDlg1)				frn=new FRNT; 				frP=new FRNTP; 				kdb=new KDB;				sys=new SYS;				bit1=1;bit2=1;bit3=1;bit4=1;bit5=1;//Inicializa las banderas con los valores default.				var bCtrl=trim(frn.param(2));				if (strlen(bCtrl)>0){ //Se especificó una bandera de control.					bit1=mid(bCtrl,0,1);bit2=mid(bCtrl,1,1);bit3=mid(bCtrl,2,1);					bit4=mid(bCtrl,3,1);bit5=mid(bCtrl,4,1);				}				if (strlen(trim(frn.param(1)))>0){ bit5=0;}//Si se especifica una columna, no se devolverán todos los registros, solo el actual				kdb.connect();				tabla_base="kduv";//Vendedores				camposDeseados="a2...a7,s2";//Ver el comando kdb.rel de abajo para entender s2				kdb.open("a," & tabla_base);				kdb.open("d,kdud,w,kdlogmov");//Catalogo de clientes				kdb.rel("s1=a1");//Relaciona las tablas de sucursal con almacen mediante el campo1. (Cuando el campo 1 de almacen cambie, todo el registro de sucursal cambia)				var valor_inicial=(bit1==1)? frP.get(frn.param(0),-1,0): frP.get(frn.param(0),-1,1);				if (strlen(trim(frn.param(1)))>0){ valor_inicial=frP.get(frn.param(0),-1,frn.param(1)); }//Se devolverá el valor a una tabla 				frn.set("clave",valor_inicial);//Se llena la clave si es ventana de diálogo.				Bus(1);				if(bit2==0)deshabilita_campos();			}			fun camposLlave() {var llave=frn.get("clave"); 				if (bit4==0){ setmfy("clave"); } //Desactiva los campos de la llave para que no pueda cambiarse de registro				return llave;}//Campos que forman la llave. Puede ser una llave combinada			fun setData() {				set("clave","a2"); set("nombre","a3"); set("sventa","a4"); set("sutilidad","a5"); set("sproducto","a7"); set("scobro","a6");			}			fun verifica_borrar(){//Esta función valida si el registro actual se puede borrar. Ej. Un producto NO se puede borrar si hay facturas con ese produccto.				var cve=camposLlave();				var cmd="tmp,d,3,1," & cve & ",&,d1,d2,d12";				kdb.search(cmd); kdb.exec(); 				var valor=kdb.get("tmp","d12");				if(valor &=cve)				{Error("Existe al menos un cliente este vendedor, NO es posible borrarlo");return 0;}				else{return frn.message("Está a punto de borrar el grupo " & frn.get("nombre") & ". ¿Desea Continuar?","Precaución",1);}//Regresa 1 si se puede borrar. 0 si no.			}			fun deshabilita_campos(){//Deshabilita todos los campos que no sean parte de la llave. Pone invisibles los botones				setmfy("sutilidad"); setmfy("sproducto"); setmfy("scobro"); setmfy("nombre"); 			}			fun Exit(){ //Tiene sentido cuando la opción se ha ejecutado como diálogo. Actualiza los campos de la ventana padre				if (strlen(trim(frn.param(0)))>0){ //Solo si se especificó un campo a devolver los datos 					if(bit5==1){//Se regresará un cubo de memoria con todos los registros (para llenar un combo o una lista)						var cmd="dat1,a,1,&,a2,a3";//Por default se ordena por clave, y el campo visible es la clave(bit1=1)						if(bit1==0) cmd="dat1,a,2,&,a3,a2";//Se ordena por descripción, y el campo visible es la descripción						kdb.table(cmd);kdb.exec();						frP.set(frn.param(0),kdb.get("dat1"));//Se llenan los combos					}					var valor_retorno=frn.get("clave");//Por default se devuelve la clave(bit1=1)					if( bit1==0 ){						valor_retorno=frn.get("nombre");//Se devuelve la descripcion					}					if (strlen(trim(frn.param(1)))>0){ //Se devolverá el valor a una tabla 						frP.setX(valor_retorno,trim(frn.param(0)),-1,trim(frn.param(1))); 						frP.scriptElm(frn.param(0),"OnChange",frn.param(1));					}					else{ //se devolverá el valor a un campo						frP.set(frn.param(0),valor_retorno); 						frP.scriptElm(frn.param(0),"OnChange");					}				}				if (strlen(trim(frn.param(3)))>0){ //Se ejecutará la función indicada en la ventana padre.					frP.script(frn.param(3));				}				frn.exit();			}					//Funciones Auxiliares Para Catálogos(Genericas). 			//Necesitan las variable globales tabla_base y camposDeseados. 			//tabla_base especifíca el nombre de la tabla del catálogo que se está editando			//camposDeseados indica los campos que se modificaran de la tabla. Ej a1...a70			//Ademas de una funcion camposLlave que devuleva los campos que forman la clave			//Una funcion setData que establece en pantalla los valores de la base de datos. (Cubo de información: "datos")			//Una funcion verifica_borrar() que regresa 1 si se puede borrar el registro, 0 si no se debe borrar.			fun set(objeto,campo) { frn.set(objeto,kdb.get("datos",campo));}//Establece el valor de un campo de la BD al objeto indicado			fun Busca() {if(bit4==1) Bus(0);}			fun PgUp() { if(bit4==1) Bus(6);}			fun PgDn() { if(bit4==1) Bus(5);}			fun CtrIni() { if(bit4==1) Bus(7);}			fun CtrEnd() { if(bit4==1) Bus(8);}			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}						fun Error(string){frn.messageBar(string,1); frn.sound(1);}//Establece un mensaje de error en la barra de estado. Y emite un sonido de alerta.			fun Bus(relacional) { //1:>=	2:<=		3:>	 4:<		 5:Siguiente		6:Anterior		7:Primero		8:Ultimo				frn.messageBar("");				var cmd="datos,a,1," & relacional & "," & camposLlave() & ",&," & camposDeseados;				kdb.search(cmd); kdb.exec(); setData();			}			fun Cambio(numero_campo,objeto,desplazamiento) { //Realiza un cambio de valor en la BD					var cmd=tabla_base & ",1," & camposLlave() & ",&," & numero_campo & ",'" & frn.get(objeto,-1,desplazamiento)&"'"; 					//Agrega el LOG					kdb.write("logmov,w,1,'"&strFormat("ucase",frn.config("user","name"))&"','"&sys.date()&"','"&sys.time()&"','"&frn.FileName()&"',&,1,'"&strFormat("ucase",frn.config("user","name"))&"',2,'"&sys.date()&"',3,'"&sys.time()&"',4,'"&frn.FileName()&"',5,'"&numero_campo&"',6,'"&frn.get(objeto,-1,desplazamiento)&"',7,'"&frn.getPrv(objeto,-1,desplazamiento)&"',8,'"&tabla_base&"',9,'"&camposLlave()&"'");					kdb.update(cmd); 			}			fun CtrDel() {//Borra el registro actual y devuelve el siguiente				if(bit3==1){					if ( verifica_borrar()==1 ){//Solo borrará el registro si la funcion verifica_borrar devuelve 1. Cada catálogo define su validacion para borrar.						var cmd="datos,a,1," & camposLlave() & ",&," & camposDeseados;						//Agrega LOG						kdb.write("logmov,w,1,'"&strFormat("ucase",frn.config("user","name"))&"','"&sys.date()&"','"&sys.time()&"','"&frn.FileName()&"',&,1,'"&strFormat("ucase",frn.config("user","name"))&"',2,'"&sys.date()&"',3,'"&sys.time()&"',4,'"&frn.FileName()&"',5,BORR,6,'"&camposLlave()&"',8,'"&tabla_base&"'");						kdb.del(cmd); kdb.exec(); 						if(bit4==1)setData();else frn.exit();//Si no se puede posicionar en otro registro, se sale de la opción después de borrar.					}				}			}			fun setmfy(campo,valor){//Modifica el atrbuto modify de cierto objeto(0=no permite modificacion. 1=Permite modificacion)				var atrib=(valor==1)?"Y":"N";				frn.setAtt(campo,"modify",atrib);			}			fun setvbl(campo,valor){//Modifica el atrbuto visible de cierto objeto(0=no lo muestra. 1=si lo muestra)				var atrib=(valor==1)?"Y":"N";				frn.setAtt(campo,"visible",atrib);			}		}		/*		AUTOR							FECHA						CAMBIO		------------------------------------------------------------------------------------------------------------------------------------		EFDA							28/oct/2011					Se abre la tabla kdlogmov con alias w																		Se define la variable sys y su instanciacion de la clase SYS																		Se modifica la funcion Cambio p/escribir a la tabla kdlogmov																		Se modifica la funcion CtrDel p/escribir a la tabla kdlogmov		*/	</script></pag>