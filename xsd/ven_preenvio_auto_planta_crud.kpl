<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="P&#243;lizas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,10" bclr="192,205,213" unfont="0">	<tab/><inp id="inp_titulo" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>	<br/><br/><tab/>	<hLine clr="0,0,0"/>	<br/><br/>	<tab/>		<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="100,57,10,9" brdr="0,5" fnt="Arial,16" tit="Modelo | Inventario | VIN"><tab/>			<txt>Sucursal:</txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" bclr="255,255,255" 				brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y"/>			<sp/><txt>                           Tipo docto:</txt>			<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255"  dim="30,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="Valida_Tipo_Docto()" available="Y"/>			<br/><tab/>			<txt>Inventario:</txt>			<inp id="k_inventario" clr="64,64,64" clrBrdr="255,255,255"  dim="8,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="10" available = "Y" tooltip="Inventario ..." modify="Y" 				OnF9="BusquedaInventario()"				OnChange="MostrarInventario()"/>			<tab/>			<txt> Gen:</txt>			<inp id="c_gen" dim="3,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="1"/>			<txt>  Nat:</txt>			<inp id="c_nat" dim="3,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="1"/>			<txt> Gpo:</txt>			<inp id="c_gpo" dim="3,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nc="2" max="99" modify="N" available="N"/>			<txt> Tpo:</txt>			<inp id="c_tip" dim="3,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nc="2" modify="N" available="N"/>			<txt> Folio:</txt>			<inp id="c_folio" dim="9,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="10" modify="N" available="N"/>					<txt>       Docto. Envio:</txt>			<inp id="k_docto" clr="64,64,64"  dim="14,1" brdr="0,1" fnt="Arial,16" available="N" link="k_tipon,5" type="string"/>			<txt> Fecha:</txt>			<edt id="k_fecha" dim="10,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" OnButton="Dialog(0,_ks_fecha,k_fecha)" OnF9="Dialog(0,_ks_fecha,k_fecha)" modify="N" available="Y"/>			<br/>			<hLine clr="0,0,0"/>			<br/>			<tab/>			<txt>Tipo de Compra</txt>			<cmb id="k_tipo_compra" dim="20,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" OnChange="ActivaDesactiva()" available="Y"/>			<sp/>			<txt> Arrendador</txt>			<cmb id="k_arrendador" dim="25,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" available="Y"/>			<br/>			<grp dim="76,30,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,14" hSpace="0" clrBrdr="0,58,112" brdr="1,4" fnt="Arial,16" tit="Conductor">				<sp/>				<grp dim="106,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,14" hSpace="0" clrBrdr="0,58,112" brdr="1,4" fnt="Arial,16" tit="Persona F&#237;sica">					<tab/>					<txt>Nombre                                                                              Apellido</txt>					<br/><tab/>					<inp id="k_nombre" clr="64,64,64"  dim="50,1" brdr="2,0" bclr="255,255,255" type="capital" nc="35" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Nombre"/>					<sp/>					<inp id="k_apellido" clr="64,64,64"  dim="50,1" brdr="2,0" bclr="255,255,255" type="capital" nc="35" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Apellidos"/>					<br/><tab/>					<txt>Inicial del segundo nombre  Titulo               Sufijo              Telefono Casa</txt>					<br/><tab/>					<inp id="k_inicial_seg_nombre" clr="64,64,64"  dim="22,1" brdr="2,0" bclr="255,255,255" type="capital" nc="1" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Inicial"/>					<sp/>					<cmb id="k_titulo" dim="12,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" available="Y"/>					<sp/>					<cmb id="k_sufijo" dim="12,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" available="Y"/>					<sp/>					<inp id="k_tel_casa" clr="64,64,64"  dim="25,1" brdr="2,0" bclr="255,255,255" type="capital" nc="20" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Telefono de Casa"/>				<sp/>				</grp>				<br/><sp/>				<grp dim="106,5,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,14" hSpace="0" clrBrdr="0,58,112" brdr="1,4" fnt="Arial,16" tit="Persona Moral">					<tab/>					<txt>Organizaci&#243;n</txt>					<br/><tab/>					<inp id="k_organizacion" clr="64,64,64"  dim="50,1" brdr="2,0" bclr="255,255,255" type="capital" nc="35" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="N" modify="Y" tooltip="Nombre de la Organizacion"/>				</grp>				<br/><tab/>				<txt>Direccion o Apartado Postal                                                     Direccion 2</txt>				<br/><tab/>				<inp id="k_direccion1" clr="64,64,64"  dim="52,1" brdr="2,0" bclr="255,255,255" type="capital" nc="45" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Direccion"/>				<sp/>				<inp id="k_direccion2" clr="64,64,64"  dim="52,1" brdr="2,0" bclr="255,255,255" type="capital" nc="45" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Complemento Direccion"/>				<br/><tab/>				<txt>Ciudad                                                      Estado                                                                                       C.P.</txt>				<br/><tab/>				<inp id="k_ciudad" clr="64,64,64"  dim="35,1" brdr="2,0" bclr="255,255,255" type="capital" nc="28" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Ciudad"/>				<sp/>				<cmb id="k_estado" dim="55,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" available="Y"/>				<sp/>				<inp id="k_cp" clr="64,64,64"  dim="8,1" brdr="2,0" bclr="255,255,255" type="capital" nc="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Codigo Postal"/>				<br/><tab/>				<txt>Telefono del Trabajo                 Propietario(RFC)          Clave Cliente</txt>				<br/><tab/>				<inp id="k_tel_trabajo" clr="64,64,64"  dim="25,1" brdr="2,0" bclr="255,255,255" type="capital" nc="20" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Telefono de Trabajo"/>				<sp/>				<inp id="k_rfc" clr="64,64,64"  dim="18,1" brdr="2,0" bclr="255,255,255" type="capital" nc="13" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="RFC Propietario"/>				<sp/>				<inp id="k_clave" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="capital" nc="20" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Clave del Cliente"/>				<br/><tab/>				<txt>Propietario Metodo de Contacto</txt>				<br/><tab/>				<cmb id="k_metodo_cont" dim="26,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" available="Y"/>				<sp/>				<chck id="k_declino" dim="2,12" brdr="1,2" clr="10,40,100" bclr="255,255,255" YN="10" hk="C" tooltip="Cliente declina" available="Y"/>				<txt> Cliente declin&#243; el uso de sus datos personales</txt>				<br/><tab/>				<txt>Correo Electr&#243;nico</txt>				<br/><tab/>				<inp id="k_email" clr="64,64,64"  dim="78,1" brdr="2,0" bclr="255,255,255" type="capital" nc="70" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Correo Electronico"/>				<br/>			</grp>			<sp/>			<grp dim="22,26,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,14" hSpace="0" clrBrdr="0,58,112" brdr="1,4" fnt="Arial,16" tit="INFORMACION DE VENTAS">				<sp/>				<txt>Vendedor</txt>				<br/><sp/>				<cmb id="k_vendedor" clr="64,64,64" clrBrdr="255,255,255"  dim="30,36" bclr="255,255,255" 					brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y"/>				<br/><br/><sp/>				<txt>Gerente F &amp; I</txt>				<br/><sp/>				<cmb id="k_gerente" dim="30,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" available="Y"/>				<br/><br/><sp/>				<txt>Fecha Venta</txt>				<br/><sp/>				<edt id="k_fecha_venta" dim="12,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213"					type="date" modify="Y" available="Y" fnt="Arial,16" OnF9="Dialog(3,_ks_fecha,k_fecha_venta)" page="_ks_fecha,k_fecha_venta" fmt="DD/MM/CCYY" nc="-1"/>				<br/><br/><sp/>				<txt>Tipo Auto </txt>				<br/><sp/>				<cmb id="k_tipo_auto" dim="4,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N"/>				<sp/>				<txt>[N]uevo.</txt>				<br/><br/><sp/>				<txt>Kilometraje</txt>				<br/><sp/>				<inp id="k_kilometraje" clr="64,64,64"  dim="18,1" brdr="2,0" bclr="255,255,255" type="capital" nc="18" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Kilometraje"/>				<txt>km</txt>				<br/><br/><sp/>				<txt>No. de Factura</txt>				<br/><sp/>				<inp id="k_factura" clr="64,64,64"  dim="18,1" brdr="2,0" bclr="255,255,255" type="capital" nc="18" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="N" modify="Y" tooltip="Folio Factura"/>				<br/><br/><sp/>				<txt>Importe</txt>				<br/><sp/>				<txt>$</txt>				<inp id="k_monto" clr="64,64,64"  dim="17,1" brdr="2,0" bclr="255,255,255" type="capital" nc="18" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="N" modify="Y" tooltip="Importe Total"/>			</grp>			<br/>			<grp id="gpo_4" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,0,0" dim="99,6,10,9" brdr="0,0" fnt="Arial,16">				<sp n="82"/>				<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>				<sp n="2"/>				<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Enviar a Planta" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>				<br/>			</grp>		</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;			var cmd,strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna; 			var sucursal_id, v_inventario, k_titulo_pantalla, resVal;			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc;			var cuboConsPrincipal;			var tip_ope;//Tipo de operación. "0" indica Alta; "1" indica consulta;			var mostrarRegistros, offset;			var operacion, uen;			var anio_contable;						fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								Inicializa();			}									fun Inicializa(){			   var v_tipoOperacion,cubo,ok,mensajeError;			   var fechaMovto;			   anio_contable = mid(fnDate("year",sys.date()),2,2);			   fechaMovto = sys.date();				frn.set("k_fecha",fechaMovto);							   if(frn.nParam()>0 ){//Se han mandado parámetros a la página					gen_doc=trim(frn.param(0)); 					nat_doc=trim(frn.param(1)); 					gpo_doc=trim(frn.param(2));					tip_doc=trim(frn.param(3)); 					fija_doc=trim(frn.param(4));					tip_ope=trim(frn.param(5));					uen=trim(frn.param(6));				}				else				{					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}								if(tip_ope==0)				{//Alta					v_tipoOperacion = "Alta Envio a Planta";					operacion = "ALTA";					frn.setAtt("Aceptar","available", "Y");				}				if(tip_ope==1)				{//Consulta					v_tipoOperacion = "Consulta Envio a Planta";					operacion = "CONSULTA";					frn.setAtt("Aceptar","available", "N");				}				frn.set("inp_titulo",v_tipoOperacion);								//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";								if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}						cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"PreenvioPlanta.Inicia_Forma()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				frn.set("k_sucn",getXml(cubo));				sucursal_id = frn.get("k_sucn",-1,1);								//Llenar Tipo Operacion				cmd = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where  col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_tipon",getXml(cubo));					Fecha();//Indica fecha correcta, y trae monedas y paridades de esa fecha. 				if (strlen(tip_doc)>0) frn.setPos("k_tipon",-1,4,"internal:Y","val:" & tip_doc);//Posiciona el combo de Tipo de documento al especificado como parï¿½metro				mostrarRegistros = "N";				Inicia_Forma();				ActivaDesactiva();				mostrarRegistros = "S";				BorraDatos();			}				fun Inicia_Forma(){				var ok,mensajeError, cubo, cmdQueryanio, cmdQuerymes;				frn.setAtt("gpo_2","tit","Modelo | Inventario | VIN");								//Lenar combo Tipo Compra				frn.setX("Seleccionar","k_tipo_compra",0,0);				frn.setX("000","k_tipo_compra",0,1);								frn.setX("1-Compra Persona Fisica","k_tipo_compra",1,0);				frn.setX("01","k_tipo_compra",1,1);								frn.setX("2-Venta a minorista TMS SPP","k_tipo_compra",2,0);				frn.setX("02","k_tipo_compra",2,1);								frn.setX("3-Compra Persona Moral","k_tipo_compra",3,0);				frn.setX("03","k_tipo_compra",3,1);								frn.setX("4-Arrendamiento Persona Moral","k_tipo_compra",4,0);				frn.setX("04","k_tipo_compra",4,1);				frn.setX("5-Arrendamiento","k_tipo_compra",5,0);				frn.setX("05","k_tipo_compra",5,1);								frn.setX("6-Demo","k_tipo_compra",6,0);				frn.setX("06","k_tipo_compra",6,1);								frn.setX("7-Venta Especial","k_tipo_compra",7,0);				frn.setX("07","k_tipo_compra",7,1);								//Lenar combo Arrendador				cmd = "select 'Seleccionar' as nombre_arrendadora,'000' as clave_arrendadora union";				cmd = cmd & " select upper(nombre_arrendadora) as nombre_arrendadora, upper(clave_arrendadora) as clave_arrendadora from keplersc.cat_arrendadoras ";				cmd = cmd & " where sucursal='" & sucursal_id & "'";				cmd = cmd & " order by clave_arrendadora ";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"PreenvioPlanta.Inicia_Forma()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_arrendador",getXml(cubo));								//Lenar combo Vendedor				cmd = "select '000'||' - '||'Seleccionar' as c3,'000' as c2 union";				cmd = cmd & " select upper(c2)||' - '||upper(c3) as c3, upper(c2) as c2 from keplersc.kduv ";				cmd = cmd & " where c1='" & sucursal_id & "'";				cmd = cmd & " and c6='S'";				cmd = cmd & " order by c3 asc";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"PreenvioPlanta.Inicia_Forma()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				frn.set("k_vendedor",getXml(cubo));								//Lenar combo Gerente				cmd = "select '000'||' - '||'Seleccionar' as c2,'000' as c1 union";				cmd = cmd & " select upper(c1)||' - '||upper(c2) as c2, upper(c1) as c1 from keplersc.kdcatcoach ";				cmd = cmd & " where c5='" & sucursal_id & "'";				cmd = cmd & " and c4='A'";				cmd = cmd & " order by c2 asc";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"PreenvioPlanta.Inicia_Forma()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				frn.set("k_gerente",getXml(cubo));								//Lenar combo Tipo auto				frn.setX("N","k_tipo_auto",0,0);				frn.setX("N","k_tipo_auto",0,1);								//Lenar combo Titulo				frn.setX("Seleccionar","k_titulo",0,0);				frn.setX("000","k_titulo",0,1);								frn.setX("Mr","k_titulo",1,0);				frn.setX("Mr","k_titulo",1,1);								frn.setX("Sr","k_titulo",2,0);				frn.setX("Sr","k_titulo",2,1);								frn.setX("DNP","k_titulo",3,0);				frn.setX("DNP","k_titulo",3,1);								frn.setX("Sra","k_titulo",4,0);				frn.setX("Sra","k_titulo",4,1);												//Lenar combo Sufijo				frn.setX("Seleccionar","k_sufijo",0,0);				frn.setX("000","k_sufijo",0,1);								frn.setX("Jr","k_sufijo",1,0);				frn.setX("Jr","k_sufijo",1,1);								frn.setX("Sr","k_sufijo",2,0);				frn.setX("Sr","k_sufijo",2,1);								frn.setX("DDS","k_sufijo",3,0);				frn.setX("DDS","k_sufijo",3,1);								frn.setX("DMD","k_sufijo",4,0);				frn.setX("DMD","k_sufijo",4,1);								frn.setX("DVM","k_sufijo",5,0);				frn.setX("DVM","k_sufijo",5,1);								frn.setX("ESQ","k_sufijo",6,0);				frn.setX("ESQ","k_sufijo",6,1);								frn.setX("JD","k_sufijo",7,0);				frn.setX("JD","k_sufijo",7,1);								frn.setX("MD","k_sufijo",8,0);				frn.setX("MD","k_sufijo",8,1);								frn.setX("PHD","k_sufijo",9,0);				frn.setX("PHD","k_sufijo",9,1);								frn.setX("I","k_sufijo",10,0);				frn.setX("I","k_sufijo",10,1);								frn.setX("II","k_sufijo",11,0);				frn.setX("II","k_sufijo",11,1);								frn.setX("III","k_sufijo",12,0);				frn.setX("III","k_sufijo",12,1);								frn.setX("IV","k_sufijo",13,0);				frn.setX("IV","k_sufijo",13,1);								frn.setX("V","k_sufijo",14,0);				frn.setX("V","k_sufijo",14,1);								frn.setX("VI","k_sufijo",15,0);				frn.setX("VI","k_sufijo",15,1);								frn.setX("VII","k_sufijo",16,0);				frn.setX("VII","k_sufijo",16,1);								frn.setX("VIII","k_sufijo",17,0);				frn.setX("VIII","k_sufijo",17,1);								frn.setX("IX","k_sufijo",18,0);				frn.setX("IX","k_sufijo",18,1);								frn.setX("X","k_sufijo",19,0);				frn.setX("X","k_sufijo",19,1);				//Lenar combo Estado				frn.setX("Seleccionar","k_estado",0,0);				frn.setX("000","k_estado",0,1);								frn.setX("AGUASCALIENTES","k_estado",1,0);				frn.setX("AGS","k_estado",1,1);				frn.setX("BAJA CALIFORNIA","k_estado",2,0);				frn.setX("BCN","k_estado",2,1);				frn.setX("BAJA CALIFORNIA SUR","k_estado",3,0);				frn.setX("BCS","k_estado",3,1);				frn.setX("CAMPECHE","k_estado",4,0);				frn.setX("CMP","k_estado",4,1);				frn.setX("COAHUILA DE ZARAGOZA","k_estado",5,0);				frn.setX("CAH","k_estado",5,1);				frn.setX("COLIMA","k_estado",6,0);				frn.setX("COL","k_estado",6,1);				frn.setX("CHIAPAS","k_estado",7,0);				frn.setX("CHP","k_estado",7,1);				frn.setX("CHIHUAHUA","k_estado",8,0);				frn.setX("CHI","k_estado",8,1);				frn.setX("CIUDAD DE MEXICO","k_estado",9,0);				frn.setX("DF","k_estado",9,1);				frn.setX("DURANGO","k_estado",10,0);				frn.setX("DGO","k_estado",10,1);				frn.setX("GUANAJUATO","k_estado",11,0);				frn.setX("GTO","k_estado",11,1);				frn.setX("GUERRERO","k_estado",12,0);				frn.setX("GRO","k_estado",12,1);				frn.setX("HIDALGO","k_estado",13,0);				frn.setX("HGO","k_estado",13,1);				frn.setX("JALISCO","k_estado",14,0);				frn.setX("JAL","k_estado",14,1);				frn.setX("MEXICO","k_estado",15,0);				frn.setX("EDM","k_estado",15,1);				frn.setX("MICHOACAN DE OCAMPO","k_estado",16,0);				frn.setX("MCH","k_estado",16,1);				frn.setX("MORELOS","k_estado",17,0);				frn.setX("MOR","k_estado",17,1);				frn.setX("NAYARIT","k_estado",18,0);				frn.setX("NYT","k_estado",18,1);				frn.setX("NUEVO LEON","k_estado",19,0);				frn.setX("NL","k_estado",19,1);				frn.setX("OAXACA","k_estado",20,0);				frn.setX("OAX","k_estado",20,1);				frn.setX("PUEBLA","k_estado",21,0);				frn.setX("PUE","k_estado",21,1);				frn.setX("QUERETARO","k_estado",22,0);				frn.setX("QRO","k_estado",22,1);				frn.setX("QUINTANA ROO","k_estado",23,0);				frn.setX("QNR","k_estado",23,1);				frn.setX("SAN LUIS POTOSI","k_estado",24,0);				frn.setX("SLP","k_estado",24,1);				frn.setX("SINALOA","k_estado",25,0);				frn.setX("SIN","k_estado",25,1);				frn.setX("SONORA","k_estado",26,0);				frn.setX("SON","k_estado",26,1);				frn.setX("TABASCO","k_estado",27,0);				frn.setX("TAB","k_estado",27,1);				frn.setX("TAMAULIPAS","k_estado",28,0);				frn.setX("TPS","k_estado",28,1);				frn.setX("TLAXCALA","k_estado",29,0);				frn.setX("TLX","k_estado",29,1);				frn.setX("VERACRUZ DE IGNACIO DE LA LLAVE","k_estado",30,0);				frn.setX("VER","k_estado",30,1);				frn.setX("YUCATAN","k_estado",31,0);				frn.setX("YUC","k_estado",31,1);				frn.setX("ZACATECAS","k_estado",32,0);				frn.setX("ZCS","k_estado",32,1);								//Lenar combo Metodo de Contacto				frn.setX("Seleccionar","k_metodo_cont",0,0);				frn.setX("000","k_metodo_cont",0,1);								frn.setX("Home Email","k_metodo_cont",1,0);				frn.setX("Home Email","k_metodo_cont",1,1);								frn.setX("Day Phone","k_metodo_cont",2,0);				frn.setX("Day Phone","k_metodo_cont",2,1);								frn.setX("Evening Phone","k_metodo_cont",3,0);				frn.setX("Evening Phone","k_metodo_cont",3,1);								frn.setX("Cell Phone","k_metodo_cont",4,0);				frn.setX("Cell Phone","k_metodo_cont",4,1);								frn.setX("Work Fax","k_metodo_cont",5,0);				frn.setX("Work Fax","k_metodo_cont",5,1);								frn.setX("Home Fax","k_metodo_cont",6,0);				frn.setX("Home Fax","k_metodo_cont",6,1);								frn.setX("Pager","k_metodo_cont",7,0);				frn.setX("Pager","k_metodo_cont",7,1);								frn.setX("Work Email","k_metodo_cont",8,0);				frn.setX("Work Email","k_metodo_cont",8,1);								frn.setX("US Mail","k_metodo_cont",9,0);				frn.setX("US Mail","k_metodo_cont",9,1);								frn.setX("Other","k_metodo_cont",10,0);				frn.setX("Other","k_metodo_cont",10,1);								frn.setX("N/A","k_metodo_cont",11,0);				frn.setX("N/A","k_metodo_cont",11,1);			}						fun Fecha(){//Verifica que la fecha del documento sea correcta. Ademï¿½s trae monedas y paridades de esa fecha. 				var cubo, cmd, resValidacion, resMensaje, fecha;				var validDate=frn.lib("libKepler","ValidOpDate",frn.get("k_fecha"));								frn.set("k_moneda","PESOS");				frn.set("k_paridad",0);								kdb.rst();				frn.rst("results");				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));			}						fun Valida_Tipo_Docto(){				var resValidacion, resMensaje, cubo, cmd, ok, tip_doc;							//Valida documento vigente				tip_doc=frn.get("k_tipon",-1,4);				kdb.rst();								cmd= "select * from keplersc.verify_valid_document('" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & tip_doc & ")"; //genero text, naturaleza text, grupo integer, tipo_movto integer				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Valida_Tipo_Docto()");								resValidacion= getXml(cubo,"validacion","resultado");				resMensaje = getXml(cubo,"validacion","mensaje");				if(resMensaje &! ""){					frn.message(resMensaje, "Mensaje","&Aceptar");					frn.setPos("k_tipon");				}								}						fun BorraDatos(){ //Limpia todos los campos para generar un nuevo envio. 				var cubo, ok, mensajeError;				frn.setAtt("gpo_2","tit","Modelo | Inventario | VIN");				frn.set("c_gen","","c_nat","","c_gpo","","c_tip","","c_folio",""); 				frn.set("k_inventario","","k_tipo_compra","Seleccionar","k_arrendador","Seleccionar");				frn.set("k_nombre","","k_apellido","","k_inicial_seg_nombre","","k_titulo","Seleccionar","k_sufijo","Seleccionar","k_tel_casa","");				frn.set("k_organizacion","");				frn.set("k_direccion1","","k_direccion2","","k_ciudad","","k_estado","Seleccionar","k_cp",""); 				frn.set("k_tel_trabajo","","k_rfc","","k_clave","","k_metodo_cont","Seleccionar");				frn.set("k_email","","k_declino",0);				frn.set("k_vendedor","Seleccionar","k_gerente","Seleccionar","k_fecha_venta","","k_tipo_auto","N");				frn.set("k_kilometraje","","k_kilometraje","","k_factura","","k_monto","");				frn.set("k_refer","","k_fecref","","k_nombre_cliente","");								//Llenar Tipo Operacion				cmd = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where  col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_tipon",getXml(cubo));								Clave(1);			}						fun Clave(iModo){//Actualiza los datos del cliente o Proveedor 				if(iModo==0){					cmd="datos,u,1,0,'" & frn.get("k_clave") & "',&,u1...u50,v3";kdb.rel("v2=u12"); kdb.search(cmd); 					kdb.exec(); 					if(kdb.ok("datos")==0){						if(strlen(trim(frn.get("k_clave")))>0)	frn.message("La clave "&frn.get("k_clave")&" no se encontró","Error","&Aceptar");						frn.setPos("k_clave");//La clave no existe					}				}else{kdb.rst("datos");}//Borra la info anterior				frn.set("k_clave",kdb.get("datos","u2"),"k_rfc",kdb.get("datos","u10"),"k_plazo",kdb.get("datos","u16"));				frn.set("k_nombreprov",kdb.get("datos","u3"));				frn.set("k_calleprov",kdb.get("datos","u4"));				frn.set("k_coloniaprov",kdb.get("datos","u5"));				frn.set("k_poblacionprov",kdb.get("datos","u6"));				frn.set("k_cpprov",kdb.get("datos","u27"));				frn.setM("k_coment",kdb.get("datos","u24"),kdb.get("datos","u25"),kdb.get("datos","u26"));											}						fun ActivaDesactivaConsulta()			{				frn.setAtt("k_fecha","available", "N");				frn.setAtt("k_tipo_compra","available", "N");				frn.setAtt("k_arrendador","available", "N");				frn.setAtt("k_nombre","available", "N");				frn.setAtt("k_apellido","available", "N");				frn.setAtt("k_inicial_seg_nombre","available", "N");				frn.setAtt("k_titulo","available", "N");				frn.setAtt("k_sufijo","available", "N");				frn.setAtt("k_tel_casa","available", "N");				frn.setAtt("k_organizacion","available", "N");				frn.setAtt("k_direccion1","available", "N");				frn.setAtt("k_direccion2","available", "N");				frn.setAtt("k_ciudad","available", "N");				frn.setAtt("k_estado","available", "N");				frn.setAtt("k_cp","available", "N");				frn.setAtt("k_tel_trabajo","available", "N");				frn.setAtt("k_rfc","available", "N");				frn.setAtt("k_clave","available", "N");				frn.setAtt("k_metodo_cont","available", "N");				frn.setAtt("k_declino","available", "N");				frn.setAtt("k_email","available", "N");				frn.setAtt("k_vendedor","available", "N");				frn.setAtt("k_gerente","available", "N");				frn.setAtt("k_fecha_venta","available", "N");				frn.setAtt("k_kilometraje","available", "N");				frn.setAtt("k_factura","available", "N");				frn.setAtt("k_monto","available", "N");			}						fun ActivaDesactiva()			{				frn.setAtt("k_fecha","available", "Y");				frn.setAtt("k_tipo_compra","available", "Y");				frn.setAtt("k_arrendador","available", "Y");				if (frn.get("k_tipo_compra") &= "3-Compra Persona Moral"					|| frn.get("k_tipo_compra") &= "4-Arrendamiento Persona Moral"					|| frn.get("k_tipo_compra") &= "6-Demo")				{					frn.setAtt("k_nombre","available", "N");					frn.setAtt("k_apellido","available", "N");					frn.setAtt("k_inicial_seg_nombre","available", "N");					frn.setAtt("k_titulo","available", "N");					frn.setAtt("k_sufijo","available", "N");					frn.setAtt("k_tel_casa","available", "N");					frn.setAtt("k_organizacion","available", "Y");				}				else				{					frn.setAtt("k_nombre","available", "Y");					frn.setAtt("k_apellido","available", "Y");					frn.setAtt("k_inicial_seg_nombre","available", "Y");					frn.setAtt("k_titulo","available", "Y");					frn.setAtt("k_sufijo","available", "Y");					frn.setAtt("k_tel_casa","available", "Y");					frn.setAtt("k_organizacion","available", "N");				}				frn.setAtt("k_direccion1","available", "Y");				frn.setAtt("k_direccion2","available", "Y");				frn.setAtt("k_ciudad","available", "Y");				frn.setAtt("k_estado","available", "Y");				frn.setAtt("k_cp","available", "Y");				frn.setAtt("k_tel_trabajo","available", "Y");				frn.setAtt("k_rfc","available", "Y");				frn.setAtt("k_clave","available", "Y");				frn.setAtt("k_metodo_cont","available", "Y");				frn.setAtt("k_declino","available", "Y");				frn.setAtt("k_email","available", "Y");				frn.setAtt("k_vendedor","available", "Y");				frn.setAtt("k_gerente","available", "Y");				frn.setAtt("k_fecha_venta","available", "Y");				frn.setAtt("k_kilometraje","available", "Y");			}					fun BusquedaInventario()			{				var cmdQuery ="";				sucursal_id = frn.get("k_sucn",-1,1);				if(tip_ope==0){					cmdQuery = "select inf.c2 as inventario, inf.c3 as Clave, inf.c4 as Descripcion, inf.c5 as Serie, m1.c2 as gen, m1.c3 as nat, m1.c4 as gpo, m1.c5 as tipo, m1.c6 as folio, TO_CHAR(m1.c9, 'DD/MM/YYYY') as Fecha from keplersc.kdinf inf 					inner join keplersc.kdm1 m1 on inf.c1=m1.c1 and inf.c2=m1.c100 					and m1.c1 = '" & sucursal_id &  "' and m1.c2 = 'U' and m1.c3 = 'D' and m1.c4 = '6' 					where inf.c1 = '" & sucursal_id &  "' and inf.c32 = 60 and inf.c21 = 'NUEVO' and m1.c43 <> 'C' and m1.c9 >='2026-01-01'					and m1.c100 not in (select m2.c100 from keplersc.kdm1 m2 where m2.c100 = m1.c100 and m2.c1 = '" & sucursal_id &  "' and m2.c2 = 'N' and m2.c3 = 'A' and m2.c4 = 15	and m2.c5 = 1)					and m1.c6 not in (select m3.c39 from keplersc.kdm1 m3 where  m3.c1=m1.c1 and m3.c2=m1.c2 and m3.c36='D' and m3.c37=6 and m3.c38=m1.c5 and m3.c39=m1.c6)";					cmdQuery = cmdQuery & " order by inf.c2 asc ";										frn.lib("libGeneral.kpl","FileSave",cmdQuery ,"C:\Basura\cmdBusquedaInventario");										frn.dialog("genlistafiltrosel","Inventario ",cmdQuery,"inventario","k_inventario","0","","N"); 				} 				else if(tip_ope==1){					cmdQuery = "select inf.c2 as inventario, inf.c3 as Clave, inf.c4 as Descripcion, inf.c5 as Serie, m1.c2 as gen, m1.c3 as nat, m1.c4 as gpo, m1.c5 as tipo, m1.c6 as folio, TO_CHAR(m1.c9, 'DD/MM/YYYY') as Fecha from keplersc.kdinf inf 					inner join keplersc.kdm1 m1 on inf.c1=m1.c1 and inf.c2=m1.c100 					and m1.c1 = '" & sucursal_id &  "' and m1.gen_aux = 'U' and m1.nat_aux = 'D' and m1.gpo_aux = '6' 					where inf.c1 = '" & sucursal_id &  "' and inf.c32 = 60 and inf.c21 = 'NUEVO' and m1.c43 <> 'C' and m1.c9 >='2026-01-01'					and m1.c100 in (select m2.c100 from keplersc.kdm1 m2 where m2.c100 = m1.c100 and m2.c1 = '" & sucursal_id &  "' and m2.c2 = 'N' and m2.c3 = 'A' and m2.c4 = 15	and m2.c5 = 1)					and m1.c6 not in (select m3.c39 from keplersc.kdm1 m3 where  m3.c1=m1.c1 and m3.c2=m1.c2 and m3.c36='D' and m3.c37=6 and m3.c38=m1.c5 and m3.c39=m1.c6)";					cmdQuery = cmdQuery & " order by inf.c2 asc ";										frn.lib("libGeneral.kpl","FileSave",cmdQuery ,"C:\Basura\cmdBusquedaInventario");										frn.dialog("genlistafiltrosel","Inventario ",cmdQuery,"inventario","k_inventario","0","","N");				} else {					frn.message("Opción Incorrecta (Alta o Consulta)","Error","Aceptar");					return;				}																         			}						fun MostrarInventario()			{				if(tip_ope==0){MostrarInventarioAlta();}				else if(tip_ope==1){MostrarInventarioConsulta();}			}						fun MostrarInventarioConsulta()			{				var cuboResultados, ok, mensajeError, totReg, cuboConsPrincipal;				var modelo, inventario, vin, strTmp;				var v_gen, v_nat, v_gpo, v_tip, v_folio, v_gen_aux, v_nat_aux, v_gpo_aux, v_tip_aux, v_folio_aux;								sucursal_id = frn.get("k_sucn",-1,1);				v_inventario = frn.get("k_inventario");								BorraDatos();				//*******************************************Valida exista el Inventario				frn.set("k_inventario",v_inventario);				if (v_inventario &! ""){					cmd = "select count(*) as totreg from keplersc.kdm1 m1 where m1.c1 = '" & sucursal_id &  "' and m1.c100 = '" & v_inventario & "' and m1.c2 = 'U' and m1.c3 = 'D' and m1.c4 = '6' and m1.c6 not in (select m3.c39 from keplersc.kdm1 m3 where m3.c1=m1.c1 and m3.c2=m1.c2 and m3.c36='D' and m3.c37=6 and m3.c38=m1.c5 and m3.c39=m1.c6)";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"validaInventario.MostrarInventrio()");					ok = getXmlAtt(cuboResultados ,"ok");					if(ok &! "" && !ok)					{						mensajeError = getXmlAtt(cuboResultados ,"native3");						frn.message(mensajeError,"Criterios no encontrados","Aceptar");						return;					}					totReg= getXmlAtt(cuboResultados,"r0","totreg");					if(totReg < 1)					{						frn.message("El Inventario no existe para movimiento de Envío a Planta Suc:" & sucursal_id & "Inv:" & v_inventario,"Error","Aceptar");						return;					}				}				//*******************************************Obtener KDM1 (VENTA)								cmd = "select m1.c2 as c2, m1.c3 as c3, m1.c4 as c4, m1.c5 as c5, m1.c6 as c6, m1.c10 as c10 from keplersc.kdm1 m1 where m1.c1 = '" & sucursal_id &  "' and m1.c100 = '" & v_inventario & "' and m1.c2 = 'U' and m1.c3 = 'D' and m1.c4 = '6' and m1.c6 not in (select m3.c39 from keplersc.kdm1 m3 where m3.c1=m1.c1 and m3.c2=m1.c2 and m3.c36='D' and m3.c37=6 and m3.c38=m1.c5 and m3.c39=m1.c6)";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"kdm1.MostrarInventrio()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}						frn.set("c_gen",getXmlAtt(cuboResultados,"r0","c2"));				frn.set("c_nat",getXmlAtt(cuboResultados,"r0","c3"));				frn.set("c_gpo",getXmlAtt(cuboResultados,"r0","c4"));				frn.set("c_tip",getXmlAtt(cuboResultados,"r0","c5"));				frn.set("c_folio",getXmlAtt(cuboResultados,"r0","c6"));				frn.set("k_clave",getXmlAtt(cuboResultados,"r0","c10"));								v_gen = gen_doc;				v_nat = nat_doc;				v_gpo = gpo_doc;				v_tip = tip_doc;				v_gen_aux = frn.get("c_gen");				v_nat_aux = frn.get("c_nat");				v_gpo_aux = frn.get("c_gpo");				v_tip_aux = frn.get("c_tip");				v_folio_aux = frn.get("c_folio");								//*******************************************Obtener Documento de ENVIO				cmd = "select m1.c6 as c6 from keplersc.kdm1 m1 where m1.c1 = '" & sucursal_id & "' ";				cmd = cmd & " and m1.gen_aux='" & v_gen_aux & "' ";				cmd = cmd & " and m1.nat_aux='" & v_nat_aux & "' ";				cmd = cmd & " and m1.gpo_aux=" & v_gpo_aux;				cmd = cmd & " and m1.tip_aux=" & v_tip_aux ;				cmd = cmd & " and m1.folio_aux='" & v_folio_aux & "' ";				cmd = cmd & " and m1.c2='" & v_gen & "' ";				cmd = cmd & " and m1.c3='" & v_nat & "' ";				cmd = cmd & " and m1.c4=" & v_gpo ;				cmd = cmd & " and m1.c5=" & v_tip ;				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"kdm1.MostrarInventrio()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				v_folio = getXmlAtt(cuboResultados,"r0","c6");				strTmp = frn.get("k_docto");				strTmp = strSplit(strTmp,"-",0) & "-" & v_folio;				frn.set("k_docto",strTmp);								//*******************************************Obtener DATOS DEL PREENVIO				cmd = " select";				cmd = cmd & " fecha as fecha, sale_subcategory_string as sale_subcategory_string,";				cmd = cmd & " sf_company_name as sf_company_name,";				cmd = cmd & " cbp_given_name as cbp_given_name, cbp_family_name as cbp_family_name,";				cmd = cmd & " cbp_middle_name as cbp_middle_name, cbp_salutation as cbp_salutation, cbp_name_suffix as cbp_name_suffix,";				cmd = cmd & " cbp_phones_complete_number1 as cbp_phones_complete_number1,";				cmd = cmd & " cbp_company_name as cbp_company_name,";				cmd = cmd & " cbp_ra_line_one as cbp_ra_line_one, cbp_ra_line_two as cbp_ra_line_two,";				cmd = cmd & " cbp_ra_city_name as cbp_ra_city_name,";				cmd = cmd & " cbp_ra_state_or_province_country_subdivision_id as cbp_ra_state_or_province_country_subdivision_id,";				cmd = cmd & " cbp_ra_postcode as cbp_ra_postcode, cbp_phones_complete_number2 as cbp_phones_complete_number2,";				cmd = cmd & " cbp_customer_legal_id as cbp_customer_legal_id, cbp_contact_method_type_code as cbp_contact_method_type_code,";				cmd = cmd & " cbp_preferred_privacy_indicator as cbp_preferred_privacy_indicator, cbp_emails_uriid as cbp_emails_uriid,";				cmd = cmd & " sales_person_party_id as sales_person_party_id, sales_manager_party_id as sales_manager_party_id,";				cmd = cmd & " sales_date as sales_date, vehicle_delivery_distance_measure as vehicle_delivery_distance_measure,";				cmd = cmd & " invoice_number as invoice_number, sf_whole_sale_value_amount as sf_whole_sale_value_amount,";				cmd = cmd & " vehicle_vehicle_stock_string as vehicle_vehicle_stock_string,"; 				cmd = cmd & " vehicle_vehicle_id as vehicle_vehicle_id, kdinf.c4 as vehicle_modelo";				cmd = cmd & " from keplersc.ifz_ddoa_rdr_preenvio";				cmd = cmd & " join keplersc.kdinf on";				cmd = cmd & " keplersc.kdinf.c1 = keplersc.ifz_ddoa_rdr_preenvio.sucursal";				cmd = cmd & " and keplersc.kdinf.c2 = keplersc.ifz_ddoa_rdr_preenvio.vehicle_vehicle_stock_string";				cmd = cmd & " where";				cmd = cmd & "	keplersc.ifz_ddoa_rdr_preenvio.sucursal = '" & sucursal_id & "'";				cmd = cmd & "	and keplersc.ifz_ddoa_rdr_preenvio.genero = '" & frn.get("c_gen") & "'";				cmd = cmd & "	and keplersc.ifz_ddoa_rdr_preenvio.naturaleza = '" & frn.get("c_nat") & "'";				cmd = cmd & "	and keplersc.ifz_ddoa_rdr_preenvio.grupo = " & frn.get("c_gpo");				cmd = cmd & "	and keplersc.ifz_ddoa_rdr_preenvio.tipo = " & frn.get("c_tip");				cmd = cmd & "	and keplersc.ifz_ddoa_rdr_preenvio.folio = '" & frn.get("c_folio") & "'";				cuboConsPrincipal = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"QueryPreenvio.MostrarInventrio()");				frn.lib("libGeneral.kpl","FileSave",cuboConsPrincipal,"C:\Basura\preenvioRDRconsulta");				ok = getXmlAtt(cuboConsPrincipal ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboConsPrincipal ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				modelo = getXmlAtt(cuboConsPrincipal,"r0","vehicle_modelo");				inventario = getXmlAtt(cuboConsPrincipal,"r0","vehicle_vehicle_stock_string");				vin = getXmlAtt(cuboConsPrincipal,"r0","vehicle_vehicle_id");				frn.setAtt("gpo_2","tit",modelo & " | " & inventario & " | " & vin);								//Ubica en combo: Tipo de compra				ubica_clave_combo("k_tipo_compra","000");				ubica_clave_combo("k_tipo_compra",getXmlAtt(cuboConsPrincipal,"r0","sale_subcategory_string"));								frn.set("k_fecha",getXmlAtt(cuboConsPrincipal,"r0","fecha"));								//Ubica en combo: Arrendador				frn.set("k_arrendador",getXmlAtt(cuboConsPrincipal,"r0","sf_company_name")); //Ubica en combo: Arrendador								//DATOS DE COMPRADOR				if (frn.get("k_tipo_compra") &= "3-Compra Persona Moral" //Persona Moral					|| frn.get("k_tipo_compra") &= "4-Arrendamiento Persona Moral"					|| frn.get("k_tipo_compra") &= "6-Demo")				{					frn.set("k_organizacion",getXmlAtt(cuboConsPrincipal,"r0","cbp_company_name"));				}				else //Persona Fisica				{					frn.set("k_nombre",getXmlAtt(cuboConsPrincipal,"r0","cbp_given_name"));					frn.set("k_apellido",getXmlAtt(cuboConsPrincipal,"r0","cbp_family_name"));					frn.set("k_inicial_seg_nombre",getXmlAtt(cuboConsPrincipal,"r0","cbp_middle_name"));					ubica_clave_combo("k_titulo","000");					ubica_clave_combo("k_titulo",getXmlAtt(cuboConsPrincipal,"r0","cbp_salutation")); //Ubica en combo: Titulo					ubica_clave_combo("k_sufijo","000");					ubica_clave_combo("k_sufijo",getXmlAtt(cuboConsPrincipal,"r0","cbp_name_suffix")); //Ubica en combo: Sufijo					frn.set("k_tel_casa",getXmlAtt(cuboConsPrincipal,"r0","cbp_phones_complete_number1"));				}								//DATOS COMUNES				frn.set("k_direccion1",getXmlAtt(cuboConsPrincipal,"r0","cbp_ra_line_one"));				frn.set("k_direccion2",getXmlAtt(cuboConsPrincipal,"r0","cbp_ra_line_two"));				frn.set("k_ciudad",getXmlAtt(cuboConsPrincipal,"r0","cbp_ra_city_name"));				ubica_clave_combo("k_estado",getXmlAtt(cuboConsPrincipal,"r0","cbp_ra_state_or_province_country_subdivision_id")); //Ubica en combo: Estado				frn.set("k_cp",getXmlAtt(cuboConsPrincipal,"r0","cbp_ra_postcode"));				frn.set("k_tel_trabajo",getXmlAtt(cuboConsPrincipal,"r0","cbp_phones_complete_number2"));				frn.set("k_rfc",getXmlAtt(cuboConsPrincipal,"r0","cbp_customer_legal_id"));				frn.set("k_clave",getXmlAtt(cuboConsPrincipal,"r0","clave_cliente"));				ubica_clave_combo("k_metodo_cont","000");				ubica_clave_combo("k_metodo_cont",getXmlAtt(cuboConsPrincipal,"r0","cbp_contact_method_type_code")); //Ubica en combo: Propietario Metodo de Contacto				frn.set("k_email",getXmlAtt(cuboConsPrincipal,"r0","cbp_emails_uriid"));				if(getXmlAtt(cuboConsPrincipal,"r0","cbp_preferred_privacy_indicator") &= "false"){					frn.set("k_declino",1);				} else {					frn.set("k_declino",0);				}				//DATOS DE INFORMACION DE VENTAS					ubica_clave_combo("k_vendedor","000");				ubica_clave_combo("k_vendedor",getXmlAtt(cuboConsPrincipal,"r0","sales_person_party_id")); //Ubica en combo: Vendedor				ubica_clave_combo("k_gerente","000");				ubica_clave_combo("k_gerente",getXmlAtt(cuboConsPrincipal,"r0","sales_manager_party_id")); //Ubica en combo: Gerente F & I				frn.set("k_fecha_venta",getXmlAtt(cuboConsPrincipal,"r0","sales_date"));				frn.set("k_kilometraje",getXmlAtt(cuboConsPrincipal,"r0","vehicle_delivery_distance_measure"));				frn.set("k_factura",getXmlAtt(cuboConsPrincipal,"r0","invoice_number"));				frn.set("k_monto",getXmlAtt(cuboConsPrincipal,"r0","sf_whole_sale_value_amount"));			}						fun MostrarInventarioAlta()			{				var xmlRequest,					 cmd,					 ok, 					 cuboResultados,					 mensajeError,					 modelo,					 inventario,					 vin;					 					 sucursal_id = frn.get("k_sucn",-1,1);					 v_inventario = frn.get("k_inventario");								BorraDatos();				//*******************************************Valida exista el Inventario				frn.set("k_inventario",v_inventario);				if (v_inventario &! ""){					cmd = "select count(*) as totreg from keplersc.kdm1 m1 where m1.c1 = '" & sucursal_id &  "' and m1.c100 = '" & v_inventario & "' and m1.c2 = 'U' and m1.c3 = 'D' and m1.c4 = '6' and m1.c6 not in (select m3.c39 from keplersc.kdm1 m3 where m3.c1=m1.c1 and m3.c2=m1.c2 and m3.c36='D' and m3.c37=6 and m3.c38=m1.c5 and m3.c39=m1.c6)";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"validaInventario.MostrarInventrio()");					ok = getXmlAtt(cuboResultados ,"ok");					if(ok &! "" && !ok)					{						mensajeError = getXmlAtt(cuboResultados ,"native3");						frn.message(mensajeError,"Criterios no encontrados","Aceptar");						return;					}					var totReg= getXmlAtt(cuboResultados,"r0","totreg");					if(totReg < 1)					{						frn.message("El Inventario no existe para movimiento de Venta Suc:" & sucursal_id & "Inv:" & v_inventario,"Error","Aceptar");						return;					}				}				//*******************************************Obtener KDM1 (VENTA)								cmd = "select m1.c2 as c2, m1.c3 as c3, m1.c4 as c4, m1.c5 as c5, m1.c6 as c6 from keplersc.kdm1 m1 where m1.c1 = '" & sucursal_id &  "' and m1.c100 = '" & v_inventario & "' and m1.c2 = 'U' and m1.c3 = 'D' and m1.c4 = '6' and m1.c6 not in (select m3.c39 from keplersc.kdm1 m3 where m3.c1=m1.c1 and m3.c2=m1.c2 and m3.c36='D' and m3.c37=6 and m3.c38=m1.c5 and m3.c39=m1.c6)";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"kdm1.MostrarInventrio()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}						frn.set("c_gen",getXmlAtt(cuboResultados,"r0","c2"));				frn.set("c_nat",getXmlAtt(cuboResultados,"r0","c3"));				frn.set("c_gpo",getXmlAtt(cuboResultados,"r0","c4"));				frn.set("c_tip",getXmlAtt(cuboResultados,"r0","c5"));				frn.set("c_folio",getXmlAtt(cuboResultados,"r0","c6"));								//*******************************************Obtener DATOS DE ENVIO				cmd = " select";				cmd = cmd & "	keplersc.kdms.c5 as dealer_id,";				cmd = cmd & "	keplersc.kdventas.c8 as invoice_number,";				cmd = cmd & "	keplersc.kdventas.c9 as sales_date,";				cmd = cmd & "	case";				cmd = cmd & "		when (keplersc.kdinf.c32 = 60";				cmd = cmd & "		or keplersc.kdinf.c32 = 70) then 'B'";				cmd = cmd & "		else 'P'";				cmd = cmd & "	end as sale_category_string,";				cmd = cmd & "	case";				cmd = cmd & "		when (keplersc.kdinf.c17 = 'CONTA') then case";				cmd = cmd & "			when (length(keplersc.kdud.c10) = 12) then '03'";				cmd = cmd & "			else '01'";				cmd = cmd & "		end";				cmd = cmd & "		else case";				cmd = cmd & "			when (length(keplersc.kdud.c10) = 12) then '04'";				cmd = cmd & "			else '05'";				cmd = cmd & "		end";				cmd = cmd & "	end as sale_subcategory_string,";				cmd = cmd & "	keplersc.kdventas.c16 as sales_person_party_id,";				cmd = cmd & "	keplersc.kdventas.c13 as sales_manager_party_id,";				cmd = cmd & "	'MXN' as currency_id,";				cmd = cmd & "	'CoBuyerParty' as CoBuyerParty,";				cmd = cmd & "	keplersc.kdud.c10 as cbp_customer_legal_id,";				cmd = cmd & "	case";				cmd = cmd & "		when (length(keplersc.kdud.c10) = 12) then ''";				cmd = cmd & "		else keplersc.kdud.c35";				cmd = cmd & "	end as cbp_given_name,";				cmd = cmd & "	SUBSTRING(keplersc.kdud.c33 from 1 for 1) as cbp_middle_name,";				cmd = cmd & "	keplersc.kdud.c33 || ' ' || keplersc.kdud.c34 as cbp_family_name,";				cmd = cmd & "	'' as cbp_salutation,";				cmd = cmd & "	'' as cbp_name_suffix,";				cmd = cmd & "	case";				cmd = cmd & "		when (length(keplersc.kdud.c10) = 12) then keplersc.kdud.c3";				cmd = cmd & "		else ''";				cmd = cmd & "	end as cbp_company_name,";				cmd = cmd & "	keplersc.kdud.c35 || ' ' || keplersc.kdud.c33 || ' ' || keplersc.kdud.c34 as cbp_person_name,";				cmd = cmd & "	'ResidenceAddress' as ResidenceAddress,";				cmd = cmd & "	keplersc.kdud.c4 || ' ' || keplersc.kdud.c45 || ' ' || keplersc.kdud.c46 as cbp_ra_line_one,";				cmd = cmd & "	SUBSTRING(keplersc.kdud.c5 || ' ' || keplersc.kdud.c6 from 1 for 45) as cbp_ra_line_two,";				cmd = cmd & "	keplersc.kdud.c47 as cbp_ra_city_name,";				cmd = cmd & "	'MX' as cbp_ra_country_id,";				cmd = cmd & "	keplersc.kdud.c27 as cbp_ra_postcode,";				cmd = cmd & "	keplersc.kdud.c48 as cbp_ra_state_or_province_country_subdivision_id,";				cmd = cmd & "	'Phones' as Phones,";				cmd = cmd & "	'telephone' as cbp_phones_channel_code1,";				cmd = cmd & "	keplersc.kdud.c9 as cbp_phones_complete_number1,";				cmd = cmd & "	'Home' as cbp_phones_use_code1,";				cmd = cmd & "	'telephone' as cbp_phones_channel_code2,";				cmd = cmd & "	keplersc.kdud.c7 as cbp_phones_complete_number2,";				cmd = cmd & "	'Work' as cbp_phones_use_code2,";				cmd = cmd & "	'Emails' as Emails,";				cmd = cmd & "	keplersc.kdud.c11 as cbp_emails_uriid,";				cmd = cmd & "	'email' as cbp_emails_channel_code,";				cmd = cmd & "	'Home Email' as cbp_contact_method_type_code,";				cmd = cmd & "	'es-MX' as cbp_preferred_language_code,";				cmd = cmd & "	'true' as cbp_preferred_privacy_indicator,";				cmd = cmd & "	'SoldFinance' as SoldFinance,";				cmd = cmd & "	case";				cmd = cmd & "		when (keplersc.kdventas.c17 in ('TOY', 'TFSDI', 'FT')) then 'PD'";				cmd = cmd & "		else 'CD'";				cmd = cmd & "	end as sf_finance_type_string,";				cmd = cmd & "	TO_CHAR(keplersc.kdventas.c9, 'YYYY-MM-DD') as sf_credit_application_date,";				cmd = cmd & "	keplersc.kdventas.c26 as sf_gross_amount,";				cmd = cmd & "	case";				cmd = cmd & "		when (keplersc.kdventas.c10 = 0) then (keplersc.kdventas.c26 - keplersc.kdventas.c25) - keplersc.kdventas.c24";				cmd = cmd & "		else ((keplersc.kdventas.c26 - keplersc.kdventas.c25) - keplersc.kdventas.c24) * -1";				cmd = cmd & "	end as sf_purchase_price_amount,";				cmd = cmd & "	case";				cmd = cmd & "		when (keplersc.kdventas.c10 = 0) then keplersc.kdventas.c26";				cmd = cmd & "		else keplersc.kdventas.c26 * -1";				cmd = cmd & "	end as sf_whole_sale_value_amount,";				cmd = cmd & "	case";				cmd = cmd & "		when (keplersc.kdventas.c17 in ('TOY', 'TFSDI', 'FT')) then 'TOYOTA FINANCIAL SERVICES'";				cmd = cmd & "		else ''";				cmd = cmd & "	end as sf_company_name,";				cmd = cmd & "	'' as sf_line_one,";				cmd = cmd & "	'' as sf_city_name,";				cmd = cmd & "	'' as sf_country_id,";				cmd = cmd & "	'' as sf_postcode,";				cmd = cmd & "	'' as sf_state_or_province_country_subdivision_id,";				cmd = cmd & "	'Vehicle' as Vehicle,";				cmd = cmd & "	keplersc.kdinf.c3 as vehicle_model,";				cmd = cmd & "	keplersc.kdinf.c15 as vehicle_model_year,";				cmd = cmd & "	keplersc.kdmarca.c2 as vehicle_make_string,";				cmd = cmd & "	case";				cmd = cmd & "		when (keplersc.kdinf.c21 = 'NUEVO') then 'New'";				cmd = cmd & "		else 'Used'";				cmd = cmd & "	end as vehicle_sale_class_code,";				cmd = cmd & "	keplersc.kdinf.c5 as vehicle_vehicle_id,";				cmd = cmd & "	'kilometer' as vehicle_unit_code,";				cmd = cmd & "	8 as vehicle_delivery_distance_measure,";				cmd = cmd & "	keplersc.kdinf.c2 as vehicle_vehicle_stock_string,";				cmd = cmd & "	keplersc.kdinf.c4 as vehicle_modelo,";				cmd = cmd & "	keplersc.kdud.c2 as clave_cliente,";				cmd = cmd & "	keplersc.kdud.c3 as nombre_cliente,";				cmd = cmd & "	'DealerCostPrice' as DealerCostPrice,";				cmd = cmd & "	'Reconditioning Cost' as vehicle_dcp_price_code1,";				cmd = cmd & "	coalesce((select sum(case when (keplersc.kdsunicosto.c2 = 'U' and keplersc.kdsunicosto.c3 = 'D' or keplersc.kdsunicosto.c2 = 'X' and keplersc.kdsunicosto.c3 = 'A') then keplersc.kdsunicosto.c10 when (keplersc.kdsunicosto.c2 = 'U' and keplersc.kdsunicosto.c3 = 'A' or keplersc.kdsunicosto.c2 = 'X' and keplersc.kdsunicosto.c3 = 'D') then keplersc.kdsunicosto.c10 * -1 else 0 end) as sum_1 ";				cmd = cmd & " from keplersc.kdsunicosto ";				cmd = cmd & " where keplersc.kdsunicosto.c7 = keplersc.kdventas.c1 and keplersc.kdsunicosto.c8 = keplersc.kdventas.c2 and keplersc.kdsunicosto.c9 = 'U' group by keplersc.kdsunicosto.c8), 0) as vehicle_dcp_charge_amount1,";				cmd = cmd & "	'Total Vehicle Cost' as vehicle_dcp_price_code2,";				cmd = cmd & "	coalesce(coalesce((select sum(case when (keplersc.kdsunicosto.c2 = 'U' and keplersc.kdsunicosto.c3 = 'D' or keplersc.kdsunicosto.c2 = 'X' and keplersc.kdsunicosto.c3 = 'A') then keplersc.kdsunicosto.c10 when (keplersc.kdsunicosto.c2 = 'U' and keplersc.kdsunicosto.c3 = 'A' or keplersc.kdsunicosto.c2 = 'X' and keplersc.kdsunicosto.c3 = 'D') then keplersc.kdsunicosto.c10 * -1 else 0 end) as sum_1 ";				cmd = cmd & " from keplersc.kdsunicosto ";				cmd = cmd & " where keplersc.kdsunicosto.c7 = keplersc.kdventas.c1 and keplersc.kdsunicosto.c8 = keplersc.kdventas.c2 and keplersc.kdsunicosto.c9 = 'U' group by keplersc.kdsunicosto.c8), 0) + keplersc.kdventas.c29, 0) as vehicle_dcp_charge_amount2";				cmd = cmd & " from";				cmd = cmd & "	keplersc.kdventas";				cmd = cmd & " join keplersc.kdms on";				cmd = cmd & "	keplersc.kdms.c1 = keplersc.kdventas.c1";				cmd = cmd & " join keplersc.kdinf on";				cmd = cmd & "	keplersc.kdinf.c1 = keplersc.kdventas.c1";				cmd = cmd & "	and keplersc.kdinf.c2 = keplersc.kdventas.c2";				cmd = cmd & " join keplersc.kdud on";				cmd = cmd & "	keplersc.kdud.c2 = keplersc.kdventas.c11";				cmd = cmd & " join keplersc.kdmarca on";				cmd = cmd & "	keplersc.kdmarca.c1 = keplersc.kdinf.c17";				cmd = cmd & " where";				cmd = cmd & "	keplersc.kdventas.c1 = '" & sucursal_id & "'";				cmd = cmd & "	and keplersc.kdventas.c4 = '" & frn.get("c_gen") & "'";				cmd = cmd & "	and keplersc.kdventas.c5 = '" & frn.get("c_nat") & "'";				cmd = cmd & "	and keplersc.kdventas.c6 = " & frn.get("c_gpo");				cmd = cmd & "	and keplersc.kdventas.c7 = " & frn.get("c_tip");				cmd = cmd & "	and keplersc.kdventas.c8 = '" & frn.get("c_folio") & "'";				cuboConsPrincipal = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"QueryPreenvio.MostrarInventrio()");				frn.lib("libGeneral.kpl","FileSave",cuboConsPrincipal,"C:\Basura\preenvioRDR");				ok = getXmlAtt(cuboConsPrincipal ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboConsPrincipal ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				modelo = getXmlAtt(cuboConsPrincipal,"r0","vehicle_modelo");				inventario = getXmlAtt(cuboConsPrincipal,"r0","vehicle_vehicle_stock_string");				vin = getXmlAtt(cuboConsPrincipal,"r0","vehicle_vehicle_id");				frn.setAtt("gpo_2","tit",modelo & " | " & inventario & " | " & vin);								//Ubica en combo: Tipo de compra				ubica_clave_combo("k_tipo_compra","000");				ubica_clave_combo("k_tipo_compra",getXmlAtt(cuboConsPrincipal,"r0","sale_subcategory_string"));								//Ubica en combo: Arrendador				frn.set("k_arrendador",getXmlAtt(cuboConsPrincipal,"r0","sf_company_name")); //Ubica en combo: Arrendador								//DATOS DE COMPRADOR				if (frn.get("k_tipo_compra") &= "3-Compra Persona Moral" //Persona Moral					|| frn.get("k_tipo_compra") &= "4-Arrendamiento Persona Moral"					|| frn.get("k_tipo_compra") &= "6-Demo")				{					frn.set("k_organizacion",getXmlAtt(cuboConsPrincipal,"r0","cbp_company_name"));				}				else //Persona Fisica				{					frn.set("k_nombre",getXmlAtt(cuboConsPrincipal,"r0","cbp_given_name"));					frn.set("k_apellido",getXmlAtt(cuboConsPrincipal,"r0","cbp_family_name"));					frn.set("k_inicial_seg_nombre",getXmlAtt(cuboConsPrincipal,"r0","cbp_middle_name"));					ubica_clave_combo("k_titulo","000");					ubica_clave_combo("k_titulo",getXmlAtt(cuboConsPrincipal,"r0","cbp_salutation")); //Ubica en combo: Titulo					ubica_clave_combo("k_sufijo","000");					ubica_clave_combo("k_sufijo",getXmlAtt(cuboConsPrincipal,"r0","cbp_name_suffix")); //Ubica en combo: Sufijo					frn.set("k_tel_casa",getXmlAtt(cuboConsPrincipal,"r0","cbp_phones_complete_number1"));				}								//DATOS COMUNES				frn.set("k_direccion1",getXmlAtt(cuboConsPrincipal,"r0","cbp_ra_line_one"));				frn.set("k_direccion2",getXmlAtt(cuboConsPrincipal,"r0","cbp_ra_line_two"));				frn.set("k_ciudad",getXmlAtt(cuboConsPrincipal,"r0","cbp_ra_city_name")); 				frn.set("k_estado",getXmlAtt(cuboConsPrincipal,"r0","cbp_ra_state_or_province_country_subdivision_id")); //Ubica en combo: Estado				frn.set("k_cp",getXmlAtt(cuboConsPrincipal,"r0","cbp_ra_postcode"));				frn.set("k_tel_trabajo",getXmlAtt(cuboConsPrincipal,"r0","cbp_phones_complete_number2"));				frn.set("k_rfc",getXmlAtt(cuboConsPrincipal,"r0","cbp_customer_legal_id"));				frn.set("k_clave",getXmlAtt(cuboConsPrincipal,"r0","clave_cliente"));				ubica_clave_combo("k_metodo_cont","000");				ubica_clave_combo("k_metodo_cont",getXmlAtt(cuboConsPrincipal,"r0","cbp_contact_method_type_code")); //Ubica en combo: Propietario Metodo de Contacto				frn.set("k_email",getXmlAtt(cuboConsPrincipal,"r0","cbp_emails_uriid"));																//DATOS DE INFORMACION DE VENTAS					ubica_clave_combo("k_vendedor","000");				ubica_clave_combo("k_vendedor",getXmlAtt(cuboConsPrincipal,"r0","sales_person_party_id")); //Ubica en combo: Vendedor				ubica_clave_combo("k_gerente","000");				ubica_clave_combo("k_gerente",getXmlAtt(cuboConsPrincipal,"r0","sales_manager_party_id")); //Ubica en combo: Gerente F & I				frn.set("k_fecha_venta",getXmlAtt(cuboConsPrincipal,"r0","sales_date"));				frn.set("k_kilometraje",getXmlAtt(cuboConsPrincipal,"r0","vehicle_delivery_distance_measure"));				frn.set("k_factura",getXmlAtt(cuboConsPrincipal,"r0","invoice_number"));				frn.set("k_monto",getXmlAtt(cuboConsPrincipal,"r0","sf_whole_sale_value_amount"));								frn.set("k_nombre_cliente",getXmlAtt(cuboConsPrincipal,"r0","nombre_cliente"));				ActivaDesactiva();			}						fun Ejecuta(){				if(tip_ope==0){Alta();}				else if(tip_ope==1){Consulta();}			}						fun Consulta(){				frn.message("CONSULTA...","Error","Aceptar");				return;			}						fun Alta(){				var cuboResultados, ok, mensaje, xmlPantalla, cubo, resultado, continua;				var totReg, strFecha, fecha, strTmp, hora, v_usocfdi;				kdb.rst();				frn.rst("results");				if( frn.get("k_inventario") &= "" )				{					frn.message("Debe ingresar un inventario","Error","&Aceptar");					return;				}								resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}							//*******************************************Obtener KDM1 (VALIDA QUE NO SE HAYA ENVIADO ANTERIORMENTE)				cmd = "select COUNT(*) as totreg from keplersc.kdm1 m1 where m1.c1 = '" & sucursal_id &  "' and m1.c100 = '" & v_inventario & "' and m1.c2 = 'N' and m1.c3 = 'A' and m1.c4 = 15 and m1.c5 = 1";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"kdm1ValNoEnviado.MostrarInventrio()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensaje = getXmlAtt(cuboResultados ,"native3");					frn.message(mensaje,"Criterios no encontrados","Aceptar");					return;				}				totReg= getXmlAtt(cuboResultados,"r0","totreg");				if(totReg > 0)				{					frn.message("El folio de la venta ya fue enviado a planta anteriormente","Error","Aceptar");					return;				}								continua = frn.message("Desea continuar ?","Atencion",2);				if (continua == 0){					return;				}							uen = "VEN";				fecha = sys.date();				hora= sys.time();								kdb.rst();				frn.rst("results");				frn.rst(xmlPantalla);				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				setXml(xmlPantalla,"k_refer",frn.get("k_inventario"));				setXml(xmlPantalla,"k_natdocto",nat_doc);				setXml(xmlPantalla,"k_gpodocto",35); //definido para Alta				setXml(xmlPantalla,"k_tipodocto",tip_doc); 				setXml(xmlPantalla,"k_fecref",strFecha);				setXml(xmlPantalla,"k_ivadesglosado","N");				setXml(xmlPantalla,"k_nombreimprfact",frn.get("k_nombre_cliente"));				setXml(xmlPantalla,"k_claveinv",frn.get("k_inventario"));				setXml(xmlPantalla,"k_tipopagos","0");				setXml(xmlPantalla,"k_tipoauto",frn.get("k_tipo_auto", -1, 0));				setXml(xmlPantalla,"k_pedimento","");				setXml(xmlPantalla,"k_f_pago","r1","0");				setXml(xmlPantalla,"k_status_validacion","1");				setXml(xmlPantalla,"k_f_pago","r1","0");				setXml(xmlPantalla,"k_mov","no_partidas",0);				setXml(xmlPantalla,"k_foliodocto","VXX0000000");				setXml(xmlPantalla,"k_clavedepto","SA");				setXml(xmlPantalla,"k_cfdi",v_usocfdi);				setXml(xmlPantalla,"k_correo",frn.get("k_email"));				setXml(xmlPantalla,"operacion",operacion);							setXml(xmlPantalla,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"ambiente","interfaz_planta","DDOA_RDR");				setXml(xmlPantalla,"k_vendedor",frn.get("k_vendedor" , -1, 2));				setXml(xmlPantalla,"DatosConsulta","-----------------------------------------------------------------------------------------------------------");				setXml(xmlPantalla,"method","RetailDeliveryReporting");				setXml(xmlPantalla,"dealer_id",getXmlAtt(cuboConsPrincipal,"r0","dealer_id"));				setXml(xmlPantalla,"invoice_number",getXmlAtt(cuboConsPrincipal,"r0","invoice_number"));				setXml(xmlPantalla,"sales_date",frn.get("k_fecha_venta")); //Viene de Pantalla				setXml(xmlPantalla,"sale_category_string",getXmlAtt(cuboConsPrincipal,"r0","sale_category_string"));				//setXml(xmlPantalla,"sale_subcategory_string",getXmlAtt(cuboConsPrincipal,"r0","sale_subcategory_string"));				setXml(xmlPantalla,"sale_subcategory_string",clave_combo("k_tipo_compra",frn.get("k_tipo_compra"))); //Viene de Pantalla								//setXml(xmlPantalla,"sales_person_party_id",frn.get("k_vendedor" , -1, 2)); //Viene de Pantalla				setXml(xmlPantalla,"sales_person_party_id",clave_combo("k_vendedor",frn.get("k_vendedor"))); //Viene de Pantalla								//setXml(xmlPantalla,"sales_manager_party_id",getXmlAtt(cuboConsPrincipal,"r0","sales_manager_party_id")); //Viene de Pantalla				setXml(xmlPantalla,"sales_manager_party_id",clave_combo("k_gerente",frn.get("k_gerente"))); //Viene de Pantalla								setXml(xmlPantalla,"currency_id",getXmlAtt(cuboConsPrincipal,"r0","currency_id"));				setXml(xmlPantalla,"CoBuyerParty",getXmlAtt(cuboConsPrincipal,"r0","CoBuyerParty"));				setXml(xmlPantalla,"cbp_customer_legal_id",frn.get("k_rfc")); //Viene de Pantalla				setXml(xmlPantalla,"cbp_given_name",frn.get("k_nombre")); //Viene de Pantalla				setXml(xmlPantalla,"cbp_middle_name",frn.get("k_inicial_seg_nombre")); //Viene de Pantalla				setXml(xmlPantalla,"cbp_family_name",frn.get("k_apellido")); //Viene de Pantalla				if(clave_combo("k_titulo",frn.get("k_titulo")) &= "000"){  //Viene de Pantalla					setXml(xmlPantalla,"cbp_salutation","");				} else {					setXml(xmlPantalla,"cbp_salutation",frn.get("k_titulo"));				}				if(clave_combo("k_sufijo",frn.get("k_sufijo")) &= "000"){  //Viene de Pantalla					setXml(xmlPantalla,"cbp_name_suffix","");				} else {					setXml(xmlPantalla,"cbp_name_suffix",frn.get("k_sufijo"));				}				setXml(xmlPantalla,"cbp_company_name",frn.get("k_organizacion")); //Viene de Pantalla				setXml(xmlPantalla,"cbp_person_name",getXmlAtt(cuboConsPrincipal,"r0","cbp_person_name"));				setXml(xmlPantalla,"ResidenceAddress",getXmlAtt(cuboConsPrincipal,"r0","ResidenceAddress"));				setXml(xmlPantalla,"cbp_ra_line_one",frn.get("k_direccion1")); //Viene de Pantalla				setXml(xmlPantalla,"cbp_ra_line_two",frn.get("k_direccion2")); //Viene de Pantalla				setXml(xmlPantalla,"cbp_ra_city_name",frn.get("k_ciudad")); //Viene de Pantalla				setXml(xmlPantalla,"cbp_ra_country_id",getXmlAtt(cuboConsPrincipal,"r0","cbp_ra_country_id"));				setXml(xmlPantalla,"cbp_ra_postcode",frn.get("k_cp")); //Viene de Pantalla				setXml(xmlPantalla,"cbp_ra_state_or_province_country_subdivision_id",clave_combo("k_estado",frn.get("k_estado"))); //Viene de Pantalla				setXml(xmlPantalla,"Phones",getXmlAtt(cuboConsPrincipal,"r0","Phones"));				setXml(xmlPantalla,"cbp_phones_channel_code1",getXmlAtt(cuboConsPrincipal,"r0","cbp_phones_channel_code1"));				setXml(xmlPantalla,"cbp_phones_complete_number1",frn.get("k_tel_casa")); //Viene de Pantalla				setXml(xmlPantalla,"cbp_phones_use_code1",getXmlAtt(cuboConsPrincipal,"r0","cbp_phones_use_code1"));				setXml(xmlPantalla,"cbp_phones_channel_code2",getXmlAtt(cuboConsPrincipal,"r0","cbp_phones_channel_code2"));				setXml(xmlPantalla,"cbp_phones_complete_number2",frn.get("k_tel_trabajo")); //Viene de Pantalla				setXml(xmlPantalla,"cbp_phones_use_code2",getXmlAtt(cuboConsPrincipal,"r0","cbp_phones_use_code2"));				setXml(xmlPantalla,"Emails",getXmlAtt(cuboConsPrincipal,"r0","Emails"));				setXml(xmlPantalla,"cbp_emails_uriid",frn.get("k_email")); //Viene de Pantalla				setXml(xmlPantalla,"cbp_emails_channel_code",getXmlAtt(cuboConsPrincipal,"r0","cbp_emails_channel_code"));				setXml(xmlPantalla,"cbp_contact_method_type_code",clave_combo("k_metodo_cont",frn.get("k_metodo_cont"))); //Viene de Pantalla				setXml(xmlPantalla,"cbp_preferred_language_code",getXmlAtt(cuboConsPrincipal,"r0","cbp_preferred_language_code"));				if(frn.get("k_declino") == 0){ //Viene de Pantalla					setXml(xmlPantalla,"cbp_preferred_privacy_indicator","true");				} else {				setXml(xmlPantalla,"cbp_preferred_privacy_indicator","false");				}				setXml(xmlPantalla,"SoldFinance",getXmlAtt(cuboConsPrincipal,"r0","SoldFinance"));				setXml(xmlPantalla,"sf_finance_type_string",getXmlAtt(cuboConsPrincipal,"r0","sf_finance_type_string"));				setXml(xmlPantalla,"sf_credit_application_date",getXmlAtt(cuboConsPrincipal,"r0","sf_credit_application_date"));				setXml(xmlPantalla,"sf_gross_amount",getXmlAtt(cuboConsPrincipal,"r0","sf_gross_amount"));				setXml(xmlPantalla,"sf_purchase_price_amount",getXmlAtt(cuboConsPrincipal,"r0","sf_purchase_price_amount"));				setXml(xmlPantalla,"sf_whole_sale_value_amount",getXmlAtt(cuboConsPrincipal,"r0","sf_whole_sale_value_amount"));				if(clave_combo("k_arrendador",frn.get("k_arrendador")) &= "000"){  //Viene de Pantalla					setXml(xmlPantalla,"sf_company_name","");				} else {					setXml(xmlPantalla,"sf_company_name",frn.get("k_arrendador"));				}				setXml(xmlPantalla,"sf_line_one",getXmlAtt(cuboConsPrincipal,"r0","sf_line_one"));				setXml(xmlPantalla,"sf_city_name",getXmlAtt(cuboConsPrincipal,"r0","sf_city_name"));				setXml(xmlPantalla,"sf_country_id",getXmlAtt(cuboConsPrincipal,"r0","sf_country_id"));				setXml(xmlPantalla,"sf_postcode",getXmlAtt(cuboConsPrincipal,"r0","sf_postcode"));				setXml(xmlPantalla,"sf_state_or_province_country_subdivision_id",getXmlAtt(cuboConsPrincipal,"r0","sf_state_or_province_country_subdivision_id"));				setXml(xmlPantalla,"Vehicle",getXmlAtt(cuboConsPrincipal,"r0","Vehicle"));				setXml(xmlPantalla,"vehicle_model",getXmlAtt(cuboConsPrincipal,"r0","vehicle_model"));				setXml(xmlPantalla,"vehicle_model_year",getXmlAtt(cuboConsPrincipal,"r0","vehicle_model_year"));				setXml(xmlPantalla,"vehicle_make_string",getXmlAtt(cuboConsPrincipal,"r0","vehicle_make_string"));				setXml(xmlPantalla,"vehicle_sale_class_code",getXmlAtt(cuboConsPrincipal,"r0","vehicle_sale_class_code"));				setXml(xmlPantalla,"vehicle_vehicle_id",getXmlAtt(cuboConsPrincipal,"r0","vehicle_vehicle_id"));				setXml(xmlPantalla,"vehicle_unit_code",getXmlAtt(cuboConsPrincipal,"r0","vehicle_unit_code"));				setXml(xmlPantalla,"vehicle_delivery_distance_measure",frn.get("k_kilometraje")); //Viene de Pantalla				setXml(xmlPantalla,"vehicle_vehicle_stock_string",frn.get("k_inventario")); //Viene de Pantalla				setXml(xmlPantalla,"vehicle_modelo",getXmlAtt(cuboConsPrincipal,"r0","vehicle_modelo"));				setXml(xmlPantalla,"clave_cliente",frn.get("k_clave")); //Viene de Pantalla				setXml(xmlPantalla,"nombre_cliente",getXmlAtt(cuboConsPrincipal,"r0","nombre_cliente"));				setXml(xmlPantalla,"DealerCostPrice",getXmlAtt(cuboConsPrincipal,"r0","DealerCostPrice"));				setXml(xmlPantalla,"vehicle_dcp_price_code1",getXmlAtt(cuboConsPrincipal,"r0","vehicle_dcp_price_code1"));				setXml(xmlPantalla,"vehicle_dcp_charge_amount1",getXmlAtt(cuboConsPrincipal,"r0","vehicle_dcp_charge_amount1"));				setXml(xmlPantalla,"vehicle_dcp_price_code2",getXmlAtt(cuboConsPrincipal,"r0","vehicle_dcp_price_code2"));				setXml(xmlPantalla,"vehicle_dcp_charge_amount2",getXmlAtt(cuboConsPrincipal,"r0","vehicle_dcp_charge_amount2"));								frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlPreenvioAutoPlanta");				/*				cmd = "SELECT * FROM keplersc.ifz_ddoa_rdr_preenv('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>','')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"venPreenvioPlantaCrud.Ejecuta()");								resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");								if(resultado &= "1")				{					frn.message("Inserto en ifz_ddoa_rdr_preenv","Error","Aceptar");					return;				}else{					frn.message(mensaje, "Error","&Aceptar");				}				*/				/*				frn.message("AQUI VOY","Error","Aceptar");				return;				*/								cmd = "SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"comopecompras.Alta");								resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");								if(resultado &= "1")				{					tip_ope = 1;					frn.set("k_folio",mensaje); 					frn.set("operacion","CONSULTA");										strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);					//ConfiguraCamposOpcion();										mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;					frn.message(mensaje, "Mensaje","&Aceptar");				}else{					frn.message(mensaje, "Error","&Aceptar");				}			}						fun ValidarDatos(){				validaDatoVacioCombo("k_tipo_compra",frn.get("k_tipo_compra"),"Tipo de Compra");				if (resVal == 0){					return;				}				if (frn.get("k_tipo_compra") &= "3-Compra Persona Moral" //Persona Moral					|| frn.get("k_tipo_compra") &= "4-Arrendamiento Persona Moral"					|| frn.get("k_tipo_compra") &= "6-Demo")				{					validaDatoVacio("k_organizacion","Persona Moral - Organización");				}				else //Persona Fisica				{					validaDatoVacio("k_nombre","Persona Fisica - Nombre");					validaDatoVacio("k_apellido","Persona Fisica - Apellido");					validaDatoVacio("k_inicial_seg_nombre","Persona Fisica - Inicial del segundo nombre");					validaDatoVacioCombo("k_titulo",frn.get("k_titulo"),"Persona Fisica - Titulo");					validaDatoVacioCombo("k_sufijo",frn.get("k_sufijo"),"Persona Fisica - Sufijo");				}								validaDatoVacioCombo("k_estado",frn.get("k_estado"),"Estado");				validaDatoVacioCombo("k_metodo_cont",frn.get("k_metodo_cont"),"Propietario Metodo de Contacto");				validaDatoVacioCombo("k_vendedor",frn.get("k_vendedor"),"Vendedor");				validaDatoVacioCombo("k_gerente",frn.get("k_gerente"),"Gerente F & I");				validaDatoVacio("k_kilometraje","Kilometraje");			}						fun validaDatoVacio(dato,msg){				if (frn.get(dato) &= ""){					resVal= 0;					frn.setPos(dato);					frn.message("Debe especificar " & msg & "|El dato no puede estar vacio","Error","Aceptar");					return;				}			}						fun validaDatoVacioCombo(dato,valor,msg){				//frn.get("k_vendedor" , -1, 2)				if (clave_combo(dato,valor) &= "000"){					resVal= 0;					frn.setPos(dato);					frn.message("Debe especificar " & msg & "|El dato no puede estar sin seleccionar","Error","Aceptar");					return;				}			}//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------GAD fl4r30n					fun clave_combo(combo,valor){				var clave, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,0);					if (valor_actual &=  valor){						clave = frn.get(combo,cont,1);						return clave;					}				}			}												fun ubica_clave_combo(combo,valor){				var cont,ren;				//frn.message(combo & "-" &valor,"Mensaje","Aceptar");				for(cont=0; cont<frn.N(combo); cont++){					if(frn.get(combo,cont,1) &= valor){						ren="ren:" & cont;						frn.setPos(combo,"ren:"&cont);						break;					}				}											}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>