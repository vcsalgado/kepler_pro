<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Masivo Contable"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">	<tab/><txt fnt=",22" clr="0,0,0">Consulta de Autorizaciones de Cierre</txt><tab/>	<br/>		<tab/><hLine clr="0,0,0"/>	<br/>	<br/><tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="45,25,10,17" brdr="0,5" tit="Cierres Autorizados" fnt="Arial,16">					<sp/><txt clr="0,58,112" hk="S">Sucursal:</txt>		<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="23,36" bclr="255,255,255" brdr="2,0" OnChange="ResetDetalle()" fnt="Arial,16" Null="N" hk="S" available="Y"/>		<sp n="2"/><txt>A&#241;o:</txt>		<cmb id="k_anio" clr="64,64,64" clrBrdr="192,205,213" dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" OnChange="ResetDetalle()" available="Y"/>		<sp/><tab/><txt>Mes:</txt>		<cmb id="k_mes" clr="64,64,64" clrBrdr="192,205,213" dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" available="Y"/>								<sp/><tab n="2"/>		<img id="img_buscar" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png"  OnEnter="ObtenerDatos()"/>			<br/>		<sp/>				<tbl id="k_mov" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="88,20" modify="Y" Reorder="Y" available="Y" insdel="Y">			<col name="Sucursal" id="sucursal"  modify="N" visible="Y"/>			<col name="Tipo" id="tipo"  modify="N" visible="Y"/>			<col name="Orden" id="orden"   visible="Y"/>			<col name="Fecha" id="fecha" visible="Y"/>			<col name="Usuario" id="usuario"   visible="Y"/>			<col name="Comentarios" id="comentarios" visible="Y"/>		</tbl>		<br/><sp/>		<img id="Exportar" dim="30,30" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(k_mov)" available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Exportar a csv"/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, asterisco  ;		var cmdQuery, cuboQuery, ok, mensajeError;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			rol_usuario = frn.config("user","role");			asterisco = "*";						llena_combos();			ConfiguraUI();			Inicializa();		}            		fun llena_combos(){							//Llenar combo sucursales			cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}			}							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery ,"cat_crud_vendedores.Inicializa()");								ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}							frn.set("k_sucN",getXml(cuboQuery));			cmdQuery="SELECT concat('20',substring(table_name,5,2)) as anio FROM INFORMATION_SCHEMA.TABLES 				WHERE  table_schema='keplersc' and table_type='BASE TABLE' and TABLE_NAME LIKE 'kdc22%'				group by anio				order by anio desc";			cuboQuery= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_consulta_autorizacion.llena_combos()");			frn.set("k_anio",getXml(cuboQuery));							//llenar cmb_meses			frn.setX("01","k_mes",0,0);			frn.setX("02","k_mes",1,0);			frn.setX("03","k_mes",2,0);			frn.setX("04","k_mes",3,0);				frn.setX("05","k_mes",4,0);			frn.setX("06","k_mes",5,0);			frn.setX("07","k_mes",6,0);			frn.setX("08","k_mes",7,0);				frn.setX("09","k_mes",8,0);			frn.setX("10","k_mes",9,0);			frn.setX("11","k_mes",10,0);			frn.setX("12","k_mes",11,0);				var mes=fnDate("month",sys.date());				//			frn.set("k_mes",mes);				//			ResetDetalle();		}				fun ResetDetalle(){			frn.rst("k_mov");		}				fun ObtenerDatos(){			var xmlPantalla;			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla; 			cmdQuery = "select c1 as sucursal, c2 as tipo, c3 as orden, (substring(c5::text,1,10) || ' '||  c6)::timestamp as fecha, ";			cmdQuery = cmdQuery & "c7 as usuario, trim(c8|| ' ' || c9 || ' ' ||c10) as comentario  ";			cmdQuery = cmdQuery & "from keplersc.kdscierrecalidad ";			cmdQuery = cmdQuery & "where c1='" & frn.get("k_sucN", -1 , 1) & "' and extract(year from c5)='" & frn.get("k_anio",-1,0) & "'::int "  ;			cmdQuery = cmdQuery & "and extract(month from c5)='" & frn.get("k_mes",-1,0) & "'::int order by c7,c5,c6 "  ;									rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"consulta_autorizacion_cierre.ObtenerDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_mov",cuboQuery);					}						fun ConfiguraUI(){		}				fun Inicializa(){					}				fun guardar_tabla(tabla){			var save = frn.saveFile("autorizaciones_" & frn.get("k_sucN", -1 , 1) & "_" & frn.get("k_anio",-1,0) & frn.get("k_mes",-1,0)  ,"Todos los archivos,*.csv","_C:","Para guardar archivo");			frn.dialog("guarda_tabla",tabla,save); 		}							}				</script></pag>