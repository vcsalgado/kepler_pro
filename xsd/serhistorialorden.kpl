<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="ORDENES TALLER"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="50,74,10,10" brdr="0,5" tit="ORDENES TALLER" fnt="Arial,16">		<tab n="1"/><txt clr="0,58,112">Serie:</txt>		<inp id="input_serie"  nc="8" dim="7,1" brdr="2,0" clr="64,64,64" OnF9="bus_serie()" bclr="255,255,255" clrBrdr="255,255,255"/>		<tab/><txt clr="0,58,112">Sucursal</txt>		<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="21,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N"   available="S"/>		<br/><tab n="1"/>		<txt clr="0,58,112" hk="S">Fecha Inicial:</txt>		<edt id="fecha_inicial" dim="10,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" page="_ks_fecha,fecha_inicial" OnF9="Dialog(3,_ks_fecha,fecha_inicial)"/><tab n="1"/>		<txt clr="0,58,112" hk="S">Fecha Final:</txt>		<edt id="fecha_final" dim="10,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" page="_ks_fecha,fecha_final" OnF9="Dialog(3,_ks_fecha,fecha_final)"/><tab n="1"/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		<br/>			<tab/><tbl id="tabla" dim="47,15" bclr="236,240,243" clr="64,64,64" OnEnter="detalles" OnMouseD="detalles" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" modify="N" nren="fijo">		<col id="folio_orden" name="Folio"/>		<col id="tipo_orden" name="Tipo"/>		<col id="flujo_admon" name="Flujo Admon"/>		<col id="flujo_servicio" name="Flujo Servicio"/>		<col id="estatus_orden" name="Estatus"/>		<col id="fecha_orden" name="Fecha"/>		<col id="hora_orden" name="Hora"/>		<col id="kilometraje" name="Kilometraje"/>		<col id="ocr" name="OCR"/>		</tbl>			<br/>		<tab/><txt fnt=",bs">PUNTOS:</txt><br/>		<tab/><tbl id="tabla_puntos" dim="47,11" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" modify="N" nren="fijo">		<col id="tipo_punto" name="Punto"/>		<col id="desc_punto" visible="N" name="Punto"/>		<col id="tipo_operario" name="Tipo Ope"/>		<col id="desc_operario" visible="N" name="Tipo Ope"/>		<col id="clave_paquete" name="Paquete"/>		<col id="clave_campana" name="Campa&#241;a"/>		<col id="trabajo_a_realizar" name="Descripcion"/>		<col id="horas"  type="number" name="Horas"/>		<col id="status" name="Status"/>		</tbl> 				<br/>		<tab/><txt fnt=",bs">SINTOMAS:</txt><br/>		<tab/><tbl id="tabla_sintomas" dim="47,11" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" modify="N" nren="fijo">			<col id="tipo_sintoma" name="Tipo de Sintoma"/>			<col id="clave_sintoma"  name="Clave"/>			<col id="desc_sintoma"   name="Descripcion"/>			<col id="cmnts_sintoma"  name="Comentarios"/>			<col id="punto_sintoma"   name="Punto"/>		</tbl>				</grp>				<grp bclr="236,240,243" fntClrBrdr="255,206,0" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="38,70,10,10" brdr="0,5" tit=" " fnt="Arial,16">					<br/><br/>			<sp/><txt fnt=",bs">ORDEN DETALLES:</txt><br/>			<br/>			<sp/><txt>Recepcionista: </txt>			<inp id="recepcionista" dim="14,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2" modify="N" available="N"/><br/>			<sp/>			<txt>Folio Cita: </txt>			<inp id="folio_cita" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/>			<br/><sp/>			<txt>Cve de TMKT:</txt>			<inp id="cve_tmkt" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/>			<br/><sp/>			<txt>&#191;El cliente desea ser contactado?:</txt>			<inp id="cli_desea_ser_contactado" dim="4,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/>			<br/>			<sp/>			<txt>Contacto</txt>			<inp id="contacto" dim="15,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/>			<br/>			<sp/><txt fnt=",bs">Datos del Cliente:</txt><br/>			<sp/><txt>Clave del Cliente: </txt>			<inp id="cliente_id" dim="10,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/><br/>			<sp/><txt>Nombre: </txt>			<inp id="cliente_nombre" dim="30,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<br/><sp/><txt>Calle: </txt>			<inp id="cliente_calle" dim="30,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><br/>			<sp/><txt>No. Ext.: </txt>			<inp id="cliente_ext" dim="4,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="N" brdr="0,2" nd="0" fmt="5"/>			<sp/><txt>No. Int.: </txt>			<inp id="cliente_int" dim="5,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/><br/>			<sp/><txt>Colonia: </txt>			<inp id="cliente_colonia" dim="30,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<br/><sp/><txt>Poblaci&#243;n: </txt>			<inp id="cliente_poblacion" dim="29,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string"  brdr="0,2"/>			<br/><sp/><txt>Municipio: </txt>			<inp id="cliente_municipio" dim="29,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/>			<br/><sp/><txt>Estado: </txt>			<inp id="cliente_estado" dim="20,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/><tab/>			<br/><sp/><txt>Pais: </txt>			<inp id="cliente_pais" dim="10,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<sp n="1"/><txt>C.P.: </txt>			<inp id="cliente_cp" dim="5,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/><br/>			<sp/><txt>Correo electronico: </txt>			<inp id="cliente_correo" dim="23,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><br/>			<sp/><txt>Tel. casa: </txt>			<inp id="cliente_tcasa" dim="17,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/>			<br/><sp/><txt>Tel. oficina: </txt>			<inp id="cliente_toficina" dim="17,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/>			<sp/><txt>ext: </txt>			<inp id="cliente_extension" dim="8,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/>			<br/><sp/><txt>Tel. movil: </txt>			<inp id="cliente_tmovil" dim="17,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/>			<br/><sp/><txt>RFC: </txt>			<inp id="cliente_rfc" dim="17,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/><br/>							<sp/><txt fnt=",bs">Datos del Vehiculo:</txt><br/>			<sp/><txt>Marca: </txt>			<inp id="marca" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<sp/><txt>Modelo: </txt>			<inp id="modelo" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string"  brdr="0,2"/><br/>			<sp/><txt>A&#241;o: </txt>			<inp id="anio" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/>			<sp/><txt>Kilometraje: </txt>			<inp id="kms" dim="11,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/><br/>			<sp/><txt>Serie: </txt>			<inp id="serie" dim="14,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string"  brdr="0,2"/>			<sp/><txt>Placas:</txt>			<inp id="placas" dim="8,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<br/>			<sp/><txt>Siniestro: </txt>			<inp id="siniestro" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/>			<sp/><txt>Bonete: </txt>			<inp id="bonete" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/><br/>							<sp/><txt fnt=",bs">Promesa de Entrega:</txt><br/>			<sp/><txt>Fecha: </txt>			<inp id="fecha_entrega" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/>			<sp/><txt>Hora: </txt>			<inp id="hora_entrega" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" brdr="0,2"/><br/>						<sp/><txt fnt=",bs">Observaciones:</txt><br/> 			<sp/><inp id="observaciones" dim="35,5" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>					</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario ,asterisco, rol_usuario;			var serie_ext, sucursal_ext,suc_seleccionada ;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("s,KDMS");								serie_ext = frn.param(0);				sucursal_ext = frn.param(1);								rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";								ctrls_off();				Inicializa();										}										fun ctrls_off() {				frn.setAtt("k_sucN","available", "N");			}						fun Inicializa(){								var cmd,cubo,ok,mensajeError ;				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"serhistorialorden.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));												if (serie_ext &! ""){					frn.set("input_serie", serie_ext);					frn.set("k_sucN",descr_combo("k_sucN",1,sucursal_ext));									Buscar();				}else{					frn.setAtt("k_sucN","available", "S");					}			}						fun Buscar() {							var xmlRequest,cmd,ok,cuboResultados, totOrd , contOrd, ref_clave, ref_desc;						var serie= frn.get("input_serie");				var fecha_inicial = frn.get("fecha_inicial");				var fecha_final = frn.get("fecha_final");				suc_seleccionada= frn.get("k_sucN", -1, 1);				//formar query sql				cmd= "select ord.c2,ord.c3,ord.c7,ord.c8,est.c2 as estatus,ord.c4,ord.c5,ord.c20 from keplersc.kdord as ord inner join keplersc.kdcatestatusorden as est on est.c1=ord.c8" ;				cmd= cmd & " where ord.c6 like upper('%" & serie & "%') and ord.c1='" & suc_seleccionada & "'";				if (fecha_inicial &! ""){					cmd = cmd & " and ord.c4 >= '" & fecha_inicial & "'";				}				if (fecha_final &! ""){					cmd = cmd & " and ord.c4 <= '" & fecha_final & "'";				}				cmd = cmd & " order by ord.c4 desc";									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_prod_view.Buscar()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								totOrd = nXml(cuboResultados);							frn.rst("tabla");				for (contOrd=0; contOrd<totOrd ; contOrd++){								frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c2"),"tabla",contOrd,"tipo_orden");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c3"),"tabla",contOrd,"folio_orden");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c7"),"tabla",contOrd,"flujo_admon");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c8"),"tabla",contOrd,"flujo_servicio");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"estatus"),"tabla",contOrd,"estatus_orden");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c4"),"tabla",contOrd,"fecha_orden");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c5"),"tabla",contOrd,"hora_orden");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c20"),"tabla",contOrd,"kilometraje");					//frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c"),"tabla",contOrd,"ocr");								}						}			fun borrar_datos(){				frn.rst("recepcionista");				frn.rst("folio_cita");				frn.rst("clave_tmkt");				frn.rst("volver_a_contactar");				frn.rst("contacto");				frn.rst("cliente_id");				frn.rst("cliente_nombre");				frn.rst("cliente_calle");				frn.rst("cliente_ext");				frn.rst("cliente_int");				frn.rst("cliente_colonia");				frn.rst("cliente_poblacion");				frn.rst("cliente_municipio");				frn.rst("cliente_estado");				frn.rst("cliente_pais");				frn.rst("cliente_cp");				frn.rst("cliente_correo");				frn.rst("cliente_tcasa");				frn.rst("cliente_toficina");				frn.rst("cliente_tmovil");				frn.rst("marca");				frn.rst("modelo");				frn.rst("anio");				frn.rst("kilometraje");				frn.rst("serie");				frn.rst("placas");				frn.rst("siniestro");				frn.rst("bonete");				frn.rst("fecha_entrega");				frn.rst("hora_entrega");				frn.rst("comentarios");			}						fun detalles(){							borrar_datos();							var xmlRequest,cmd,ok,cubo,mensajeError;				var suc = frn.get("k_sucN", -1, 1);							var orden_seleccionada = frn.get("tabla", -1, "folio_orden");				var tipo_orden_seleccionada = frn.get("tabla", -1, "tipo_orden");						setXml(xmlRequest,"document","folio_orden",orden_seleccionada );				setXml(xmlRequest,"document","tipo_orden", tipo_orden_seleccionada );				setXml(xmlRequest,"document","sucursal_id",suc);						frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.datos_orden_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"serhistorialorden.buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								insertar_registros(cubo, "orden");						}						fun insertar_registros(cubo, tipo){							var strTmp,cubo_cli_vin,cubo_orden,cubo_pun, cubo_sin ,xmlRes,cmd,ok ,mensajeError ; 											strTmp = getXmlAtt(cubo,"r0","datos_cli_vin");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_cli_vin,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_cli_vin,"C:\Basura\cubo_cli_vin");						xmlRes= getXmlX(cubo_cli_vin,3,0);				frn.setX(xmlRes);					rstXml(strTmp);				rstXml(xmlRes);											strTmp = getXmlAtt(cubo,"r0","datos_orden");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_orden   ,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_orden   ,"C:\Basura\cubo_res   ");						xmlRes= getXmlX(cubo_orden ,3,0);				frn.lib("libGeneral.kpl","FileSave",xmlRes,"C:\Basura\xmlRes ");				frn.setX(xmlRes);										//inserta regitros de puntos				rstXml(strTmp);				rstXml(xmlRes);				strTmp = getXmlAtt(cubo,"r0","datos_puntos");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_pun,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_pun,"C:\Basura\cubo_pun   ");				frn.setX(cubo_pun,"tabla_puntos");  										//inserta regitros de sintomas				rstXml(strTmp);				rstXml(xmlRes);				strTmp = getXmlAtt(cubo,"r0","datos_sintomas");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_sin ,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_sin ,"C:\Basura\cubo_sin   ");				frn.setX(cubo_sin ,"tabla_sintomas");						}						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}									fun bus_serie(){				var cmdQuery = "select s.c1 as identificador ,s.c4 as serie ,s.c2 as marca ,s.c3 as modelo,s.c10 as color,s.c11 as anio ,s.c8 as placas,s.c9 as contacto from keplersc.kdserie as s "             frn.dialog("genlistafiltrosel","Catalogo de Series",cmdQuery,"identificador","input_serie","","N");			}		}	</script></pag>