<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" dim="0,0,10,10" tit="Cat&#225;logo de cuentas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,15,12" bclr="192,205,213" unfont="0"><tab/><txt clr="0,0,0" fnt=",22">Cat&#225;logo de Cuentas</txt>	<br/>	<tab n="1"/>	<hLine clr="0,0,0"/>	<br/><br/>	<tab/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="42,8,7,12"  tit="Datos de cuentas" fnt="Arial,16" unfont="0"><tab/>			<txt hk="N" fnt="Arial,16" clr="0,58,112" bclr="255,255,255">N&#250;mero de cuenta</txt><tab/>				<edt id="numero" clr="64,64,64" clrBrdr="255,255,255"  dim="25,1" type="capital" bclr="255,255,200" brdr="2,0" OnChange="Busca" OnF9="Dialog(1,concatcuebus,numero)" OnButton="Dialog(1,concatcuebus,numero)" hk="n" nc="20" fnt="Arial,0"/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Descripci&#243;n</txt><tab n="3"/>				<inp id="descripcion" clr="64,64,64" clrBrdr="255,255,255"  dim="37,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(2,descripcion)" nc="35" type="string"/><br/><tab/>				<chck id="ietu" clr="64,64,64"  dim="3,16" brdr="2,1" bclr="255,255,255" OnChange="Cambio(100,ietu)" YN="10" visible="N" modify="N" available="N"/>		</grp><br/><br/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="42,9,7,12"  tit="Configuraci&#243;n de cuenta" fnt="Arial,16" unfont="0"><tab/><txt>Codigo Agruprado SAT</txt><tab/>				<inp id="ctaS" clr="64,64,64" clrBrdr="255,255,255" OnChange="ValidaCtaSat()" dim="30,1" bclr="255,255,255" brdr="2,0" nc="35" type="string"/><img id="img" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnMouseL="Dialog(1,busqueda,ctaS,,kdfecesatcta)"/><br/><tab/><txt>Descripci&#243;n </txt><tab n="4"/><inp id="descS" dim="34,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"/><br/><tab/><txt>Naturaleza de la Cuenta</txt><tab/><cmb id="natCta" dim="14,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" OnChange="GuardaAgrup()" clrBrdr="255,255,255"/><br/>		</grp><br/><br/>	</grp>	<tools>		<tool name="endleft" OnMouseL="CtrIni()" img="_TL_First.png"/>		<tool name="left" OnMouseL="PgUp()" img="_TL_Previous.png"/>		<tool name="right" OnMouseL="PgDn()" img="_TL_Next.png"/>		<tool name="endright" OnMouseL="CtrEnd()" img="_TL_Last.png"/>	</tools>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys;			var usuario;			/* PARÁMETROS (Tienen sentido cuando la opción se ha ejecutado como diálogo.)			param(0) = Nombre del campo (o tabla) al que se devolverá la clave o descripción en la pantalla padre			param(1) = (Opcional) Nombre de la columna al que se devolverá la clave en la pantalla padre(Se debe especificar el grid en el parametro anterior)			param(2) = (Opcional) Bandera binaria de control. Es un string que indica ciertos parámetros de funcionamiento de la opción							Los caracteres se toman de izquierda a derecha y tienen el siguiente significado:							Bit 1= Si toma valor de 1, se devuelve la clave. Si toma valor de 0, se devuelve la descripción. Por default se toma valor de 1.							Bit 2= Si toma valor de 1, permite modificar el catálogo. Si toma valor de 0, no permite modificación. Por default se toma valor de 1.							Bit 3= Si toma valor de 1, permite insertar/borrar registros. Si toma valor de 0, no permite insertar/borrar. Por default se toma valor de 1.							Bit 4= Si toma valor de 1, permite cambiar de registro. Si toma valor de 0, no permite cambiar de registro. Por default se toma valor de 1.							Bit 5= Si toma valor de 1, regresa un cubo de memoria con campos principales de TODOS los registros(para guardar la info en un combo). Si toma valor de 0, solo regresa la clave o descripción. Por default se toma valor de 1.			param(3) = (Opcional) Función de la pantalla padre a ejecutar antes de regresarle el control.										Valor de retorno = clave o descripción del producto			*/			var bit1,bit2,bit3,bit4,bit5;//Banderas de comportamiento (Ver descripción arriba)			var tabla_base;//Tabla base del catálogo (Se abre con el alias "a")			var camposDeseados;//Campos de la tabla que se requieren(Ej: a1...a4)			var year; //saca el año a trabajar						fun Main() { 				frn=new FRNT; 				frP=new FRNTP; 				kdb=new KDB;				sys=new SYS;				bit1=1;bit2=1;bit3=1;bit4=1;bit5=1;//Inicializa las banderas con los valores default.				var bCtrl=trim(frn.param(2));				if (strlen(bCtrl)>0){ //Se especificó una bandera de control.					bit1=mid(bCtrl,0,1);bit2=mid(bCtrl,1,1);bit3=mid(bCtrl,2,1);					bit4=mid(bCtrl,3,1);bit5=mid(bCtrl,4,1);				}				if (strlen(trim(frn.param(1)))>0){ bit5=0;}//Si se especifica una columna, no se devolverán todos los registros, solo el actual				kdb.connect();				year	= frn.lib("libKepler","AnioTrabajo");				tabla_base = "kdc1&"&year;//Cuentas				camposDeseados="a1...a2,a27...a38,a63...a74,a100";				kdb.open("a," & tabla_base);				kdb.open("w,kdlogmov");				kdb.open("c,kdfecesatcta,f,kdfececta");				kdb.sp("security","dat");kdb.exec();				usuario=kdb.get("dat","user");				var valor_inicial=(bit1==1)? frP.get(frn.param(0),-1,0): frP.get(frn.param(0),-1,1);				if (strlen(trim(frn.param(1)))>0){ valor_inicial=frP.get(frn.param(0),-1,frn.param(1)); }//Se devolverá el valor a una tabla 				frn.set("numero",frP.get(frn.param(0),-1,1));//Se llena la clave si es ventana de diálogo. Se utiliza el desplazamiento "1", pues la columna 0 es la descripcion y la columna 1, la clave. 				frn.setX("","natCta",0,0);				frn.setX("D","natCta",1,0);				frn.setX("A","natCta",2,0);				Bus(1);				if(bit2==0)deshabilita_campos();			}			fun camposLlave(){	var llave=frn.get("numero");if (bit4==0){ setmfy("numero"); } //Desactiva los campos de la llave para que no pueda cambiarse de registro				return llave;}//Campos que forman la llave. Puede ser una llave combinada			fun setData() { //Funcion que llena los campos en pantalla con la información de la base de datos				set("numero","a1"); set("descripcion","a2");				set("ietu","a100");				setAgru();			}						fun deshabilita_campos(){//Deshabilita todos los campos que no sean parte de la llave.				setmfy("descripcion");setmfy("ietu");			}			fun verifica_borrar(){//Esta función valida si el registro actual se puede borrar. Ej. Una cuenta no se puede borrar si tiene polizas asignadas.				var cve=camposLlave();				var suma2,suma3,suma4,suma;				suma=0;suma2=0;suma3=0;suma4=0;				var cmd="datos,a,1,1,'" & camposLlave() & "',&," & camposDeseados;				kdb.search(cmd); kdb.exec(); setData();				for(var i=27; i<39; i++){//suma los abonos del mes de kdc1					suma=kdb.get("datos","a" & i);					suma2=suma+suma2;				}				for(var i=63; i<75; i++){//suma los cargos del mes de kdc1					suma3=kdb.get("datos","a" & i);					suma4=suma3+suma4;				}				if(suma2!=0 || suma4!=0){					Error("Esta cuenta tiene polizas, NO es posible borrarla");					return 0;				}				else{					return frn.message("Está a punto de borrar la cuenta. " & frn.get("nombre") & "¿Desea Continuar?","Precaución",1);				}//Regresa 1 si se puede borrar. 0 si no.			}						fun ValidaCtaSat { // Se valida que sea una cuenta válida del SAT 				kdb.rst("datosCtaS");				var ctaS= frn.get("ctaS");				if (ctaS &! ""){					var cmd = "datosCtaS,c,1,0,'" & frn.get("ctaS") & "',&,c2";					kdb.search(cmd); 					kdb.exec();							if(kdb.ok("datosCtaS") == 1){						frn.set("descS",kdb.get("datosCtaS","c2"));					}else{						frn.message("Cuenta SAT no Válida","Atención","&Aceptar");						setAgru();					}				}			}						fun setAgru(){				var cmd="datos2,f,1,'" & frn.get("numero") & "',&,f2,f3";				kdb.table(cmd);				kdb.exec();				frn.set("ctaS",kdb.get("datos2","r0","f2"));				kdb.search("desc,c,1,0,'"&frn.get("ctaS")&"',&,c2");				kdb.exec();				frn.set("descS",kdb.get("desc","c2"));				if(kdb.get("datos2","r0","f3")&="D"){					frn.setPos("natCta","ren:1");				}else if(kdb.get("datos2","r0","f3")&="A"){					frn.setPos("natCta","ren:2");				}else{					frn.setPos("natCta","ren:");				}				frn.setPos("numero");			}						fun GuardaAgrup(){				if(frn.get("ctaS")&=""){					frn.message("No se puede dejar vacío el código agrupador");					frn.setPos("natCta","ren:");					frn.setPos("ctaS");					return;				}				var cmd="datos2,f,1,'" & frn.get("numero") & "',&,f2,f3";				kdb.table(cmd);				kdb.exec();				if(kdb.get("datos2","r0","f2")&!""){					frn.message("Esta cuenta ya cuenta con código agrupador.","Atención","&Aceptar");					setAgru();				}else{					kdb.update("kdfececta,1,"&frn.get("numero")&","&frn.get("ctaS")&",&,3,"&frn.get("natCta")&"");				}			}						fun Exit() { //Tiene sentido cuando la pagina se ejecuta como dialogo, pues regresa el registro actual.				//kdb.table("dat1,a,1,&,a1,a2");				//kdb.exec();				//frP.set(frn.param(0),kdb.get("dat1"));//Se llena el combo				//frP.set(frn.param(1),kdb.get("dat1"));//Se llena el combo				//frP.set(frn.param(0),frn.get(numero));//Se posiciona en el registro correcto				kdb.table("dat1,a,1,&,a1,a2");				kdb.exec();				frP.set(frn.param(0),kdb.get("dat1"));//Se llena el combo				frP.set(frn.param(0),frn.get("numero"));//Se posiciona en el registro correcto				if (strlen(trim(frP.get(frn.param(0))))>0){ //Solo si se especificó un campo a devolver los datos 					if(bit5==1){//Se regresará un cubo de memoria con todos los registros (para llenar un combo o una lista)						var cmd="dat1,a,1,&,a1,a2";//Por default se ordena por clave, y el campo visible es la clave(bit1=1)						if(bit1==0) cmd="dat1,a,2,&,a2,a1";//Se ordena por descripción, y el campo visible es la descripción						kdb.table(cmd);kdb.exec();						frP.set(frn.param(0),kdb.get("dat1"));//Se llenan los combos					}					var valor_retorno=frn.get("numero");//Por default se devuelve la clave(bit1=1)					if( bit1==0 ){						valor_retorno=frn.get("descripcion");//Se devuelve la descripcion					}					if (strlen(trim(frn.param(1)))>0){ //Se devolverá el valor a una tabla 						frP.setX(valor_retorno,trim(frn.param(0)),-1,trim(frn.param(1))); 						frP.scriptElm(frn.param(0),"OnChange",frn.param(1));					}					else{ //se devolverá el valor a un campo						frP.set(frn.param(0),valor_retorno); 						frP.scriptElm(frn.param(0),"OnChange");					}				}				if (strlen(trim(frn.param(3)))>0){ //Se ejecutará la función indicada en la ventana padre.					frP.script(frn.param(3));				}				frn.exit();			}			//Funciones Auxiliares Para Catálogos(Genericas). 			//Necesitan las variable globales tabla_base y camposDeseados. 			//tabla_base especifíca el nombre de la tabla del catálogo que se está editando			//camposDeseados indica los campos que se modificaran de la tabla. Ej a1...a70			//Ademas de una funcion camposLlave que devuleva los campos que forman la clave			//Una funcion setData que establece en pantalla los valores de la base de datos. (Cubo de información: "datos")			//Una funcion verifica_borrar() que regresa 1 si se puede borrar el registro, 0 si no se debe borrar.			fun set(objeto,campo) {frn.set(objeto,kdb.get("datos",campo));}//Establece el valor de un campo de la BD al objeto indicado			fun Busca() { if(bit4==1) Bus(0);}			fun PgUp() { if(bit4==1) Bus(6);}			fun PgDn() { if(bit4==1) Bus(5);}			fun CtrIni() { if(bit4==1) Bus(7);}			fun CtrEnd() { if(bit4==1) Bus(8);}			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}						fun Error(string){frn.messageBar(string,1); frn.sound(1);}//Establece un mensaje de error en la barra de estado. Y emite un sonido de alerta.						fun Bus(relacional) { //1:>=	2:<=		3:>	 4:<		 5:Siguiente		6:Anterior		7:Primero		8:Ultimo				frn.messageBar("");				var cmd="datos,a,1," & relacional & "," & camposLlave() & ",&," & camposDeseados;				kdb.search(cmd); kdb.exec(); setData();			}						fun Cambio(numero_campo,objeto,desplazamiento) { //Realiza un cambio de valor en la BD					var cmd=tabla_base & ",1," & camposLlave() & ",&," & numero_campo & ",'" & frn.get(objeto,-1,desplazamiento) & "'"; 					//Agrega el LOG					kdb.write("logmov,w,1,'"&strFormat("ucase",frn.config("user","name"))&"','"&sys.date()&"','"&sys.time()&"','"&frn.FileName()&"',&,1,'"&strFormat("ucase",frn.config("user","name"))&"',2,'"&sys.date()&"',3,'"&sys.time()&"',4,'"&frn.FileName()&"',5,'"&numero_campo&"',6,'"&frn.get(objeto,-1,desplazamiento)&"',7,'"&frn.getPrv(objeto,-1,desplazamiento)&"',8,'"&tabla_base&"',9,'"&camposLlave()&"'");					kdb.update(cmd); 			}						fun CtrDel() {//Borra el registro actual y devuelve el siguiente				if (verifica_borrar()==1){//Solo borrará el registro si la funcion verifica_borrar devuelve 1. Cada catálogo define su validacion para borrar.					var cmd="datos,a,1," & camposLlave() & ",&," & camposDeseados;					//Agrega LOG						kdb.write("logmov,w,1,'"&strFormat("ucase",frn.config("user","name"))&"','"&sys.date()&"','"&sys.time()&"','"&frn.FileName()&"',&,1,'"&strFormat("ucase",frn.config("user","name"))&"',2,'"&sys.date()&"',3,'"&sys.time()&"',4,'"&frn.FileName()&"',5,BORR,6,'"&camposLlave()&"',8,'"&tabla_base&"'");					kdb.del(cmd); 					if(frn.get("ctaS")&!"")						kdb.del("datos2,f,1,"&frn.get("numero")&","&frn.get("ctaS")&"");					kdb.exec(); setData();				}			}			fun setmfy(campo,valor){//Modifica el atrbuto modify de cierto objeto(0=no permite modificacion. 1=Permite modificacion)				var atrib=(valor==1)?"Y":"N";				frn.setAtt(campo,"modify",atrib);			}		}		/*		AUTOR						FECHA						CAMBIO		--------------------------------------------------		Carlos JAM			2010-01-07					-Se agrega la validación p/que se tome el año de la sesión actual dentro de la fun Main:																year	= frn.lib("libKepler","AnioTrabajo"); tabla_base = "kdc1&"&year;//Cuentas		EFDA					28/oct/2011					Se abre la tabla kdlogmov con alias w																		Se define la variable sys y su instanciacion de la clase SYS																		Se modifica la funcion Cambio p/escribir a la tabla kdlogmov																		Se modifica la funcion CtrDel p/escribir a la tabla kdlogmov		Juan Cristobobal	21/Mayo/2014				-Se	establece	como	invisible	el checkbox de afecta	IETU, debido	a	que	el impuesto																fue derogado en 31/12/13		Evani Moreno		18-02-20						Se agrega funcion GuardaAgrup para guardar el codigo agrupador de la cuenta		*/	</script></pag>