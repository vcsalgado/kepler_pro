<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Selecci&#243;n de registros" roles="">	<grp id="grpPrincipal" brdr="0,0" clr="0,58,112" fnt="Arial,16" clrBrdr="0,97,181" bclr="192,205,213" unfont="0" dim="1,1,5,5" 		tit="Consulta de registros">		<br/>		<tab/><inp id="inp_titulo" dim="115,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213" 			type="string" modify="N" available="N" fnt="Arial,22"/>					<br/><br/>				<tab n="1"/>			<inp id="inp_filtros" dim="25,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213" 			type="string" modify="N" available="N" fnt="Arial,18"/>			<cmb id="k_filtros" clr="64,64,64" clrBrdr="255,255,255"  						dim="32,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  						Null="N" available="Y" tooltip="Selecciona columna base de b&#250;squeda"/>			<tab n="1"/> 			<inp id="k_busqueda" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital"  just="C" tooltip="texto a buscar"/> 			<tab n="1"/> <img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_Registros()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			<br/><br/>			<tab n="2"/>						<tbl clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" brdr="1,0" id="results" dim="115,18" 			modify="N" nren="fijo" Reorder="Y">			<col name="C1" id="c1"/>		</tbl>		<br/><br/>		<tab/><img bPx="Y" id="bot" dim="40,40" available="Y" img="_60_DocNew.png" OnEnter="Execute()" tooltip="Seleccionar" hk="t"/>	</grp>		<script>		InstallDriver("KDB75");		class Main {/*OnChange="posicionabusqueda()" OnEnter="posicionabusqueda()"*/			var frn,kdb,sys,cuboXml,frP;			var strTitulo, strQuery,mostrarRegs , strColValor, strCtrlSet, strMostrarLlave, 				strRenglon,				strColumna; 			var regTotales,ultimoValorEncontrado, contGlobalResults;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				kdb.connect();				//Asignacion de parametros a varaiables				strTitulo=trim(frn.param(0)); //Titulo de los datos a presentar				strQuery=trim(frn.param(1)); //Consulta a ejecutar				strColValor=trim(frn.param(2)); //Columna con el valor de retorno				strCtrlSet=trim(frn.param(3)); //Control que recibira el valor en la forma que llama esta funcion				//parámetros de columan, campo 				strRenglon=trim(frn.param(4));//renglon				strColumna=trim(frn.param(5));//columna 				strMostrarLlave=trim(frn.param(6));//Inidica (S)i se muestra o (N)o la columna con el valor llave				mostrarRegs=frn.param(7); //Indica si al cargar el formulario se muestran o no los registros				//frn.lib("libGeneral.kpl","FileSave",strRenglon,"C:\Basura\procesosRenglon");				//frn.lib("libGeneral.kpl","FileSave",strColumna,"C:\Basura\procesosColumna");				Encabezados();				Inicia_Forma();				contGlobalResults = 0;				ultimoValorEncontrado = -1;				mostrarRegs = "S";			}						fun Inicia_Forma(){				//Etiquetas 				frn.set("inp_mensaje","No se encontraron registros...");				frn.set("inp_titulo",strTitulo);				frn.set("inp_filtros","Filtro:");				//Obtencion de registros				Buscar_Registros();			}						fun Buscar_Registros(){				/*var cmd, mensajeError,ok,nReg;				kdb.rst();				frn.rst("results");				cmd = delScpScn(strQuery);								cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"genlistasel.buscar_registros()");				*/				var cmd, mensajeError,ok,nReg;				var tabla,expSelect,expWhere,expOrder;				var colCriterio, criterio;				kdb.rst();				frn.rst("results");							colCriterio=frn.get("k_filtros",-1,0);				criterio=frn.get("k_busqueda");								expSelect = "select * from (" & strQuery & ") as resultado " ;								if (colCriterio &! "" && criterio &! ""){					expWhere = frn.get("k_filtros",-1,0);					expWhere = " where " & expWhere & "::text like '%" & frn.get("k_busqueda") & "%' ";					expOrder = " order by " & frn.get("k_filtros",-1,0);				}				if(mostrarRegs &= "N")				{					expWhere = " where 1=0 ";				}				expSelect = expSelect & expWhere & expOrder;				//frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\cuboResultados");				cuboXml = frn.lib("libGeneral.kpl","EjecutarSqlSel",expSelect,"genlistaCatalogoview.buscarregistros()");								ok=getXmlAtt(cuboXml,"ok");								if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}								Encabezados();				frn.set("results",cuboXml);				nReg=nXml(cuboXml);				regTotales = nReg;				if(nReg>0){				  frn.set("inp_mensaje","");									}				frn.rst("k_filtros");				llenar_filtro_busqueda(cuboXml,"k_filtros");							}						fun StrReplace(strCadena,strSource,strTarget){				var cont, strResultado, strCur;				for(cont=0; cont<strlen(strCadena); cont++){					strCur=mid(strCadena,cont,1);					if(strCur&=strSource){						strCur=strTarget;					}					strResultado = strResultado & strCur;				}				return strResultado;			}						fun Encabezados(){				var colIds, totReg;				frn.rst("results");								totReg=nXml(cuboXml);				colIds=getXmlAtt(cuboXml,"k_ColName");				if(colIds &! ""){					frn.setX(colIds,"results","k_ColName");					frn.setX(getXmlAtt(cuboXml,"k_ColType"),"results","k_ColType");					frn.setX(getXmlAtt(cuboXml,"k_ColNd"),"results","k_ColNd");					frn.setAtt("llave","visible","N");				}							}						fun llenar_filtro_busqueda(cuboResultados, cmb)			{					var valor;				var encabezados = getXmlAtt(cuboXml,"k_ColName");				var len_cubo = 1000;				var pos_ini = frn.N(cmb)+1;				frn.setX("", cmb, 0,0);				for (var cont=0; cont<len_cubo ; cont++)				{										valor = strSplit(encabezados,",",cont);										if(valor &! ""){						frn.setX(valor, cmb, cont+pos_ini,0);					}					else{						cont = len_cubo;					}				}			}						fun posicionabusqueda()			{				if(frn.get("k_filtros") &! "")				{					if(frn.get("k_busqueda") &! ""){				var colseleccionada = "col:" & frn.get("k_filtros");				var dato;				var valorBuscado;												for(var contResults = contGlobalResults; contResults < regTotales; contResults++)					{						frn.setPos("results","internal:N","ren:" & contResults,colseleccionada);					dato = frn.get("results",contResults,frn.get("k_filtros"));					valorBuscado = strSplit(dato,frn.get("k_busqueda"),-1);					if(valorBuscado > 1)					{						frn.setPos("results","internal:N","ren:" & contResults,colseleccionada);												ultimoValorEncontrado = contResults;			//valor 3									contResults = regTotales;			//inicializo variable para terminar el ciclo											}else					{												frn.setPos("results","internal:N","ren:" & ultimoValorEncontrado,colseleccionada);											}					contGlobalResults = contGlobalResults + 1 ;					if(contGlobalResults == regTotales)					{						contGlobalResults = 0;												if(ultimoValorEncontrado>0)						{							posicionabusqueda();						}											}				}					}				}			}						fun Execute(){				var valorSel, renSel,mensaje;				valorSel = "";				mensaje="Opcion Normal";				renSel = frn.getJ("results");				if(renSel > -1){					valorSel = frn.get("results",renSel,strColValor);				}				//frP.set(strCtrlSet,valorSel);								if(strRenglon &= "0" )				{					frP.set(strCtrlSet,valorSel);					frP.scriptElm(strCtrlSet,"OnChange");				}				else				{//	valor | ID_elemento | strRenglon (o puede ser -1 actual)| strColumna					frP.setX(valorSel,strCtrlSet,-1,strColumna);														frP.scriptElm(strCtrlSet,"OnChange",strColumna);				}								frn.exit();			}		}				</script></pag>