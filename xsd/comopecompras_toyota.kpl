<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Compra">	<grp id="grpMain" brdr="0,0" clr="0,58,112" fnt="Arial,18b"  dim="1,-1,10,8" bclr="192,205,213" clrBrdr="0,97,181" OnF1="Dialog(1,comopecompayu)" tit="Compras" unfont="0">		<sp n="2"/>		<txt clr="0,0,0" fnt=",22">Compras</txt><br/>		<sp n="2"/> <hLine clr="0,0,0"/><br/>		<br/>		<sp n="2"/>		<grp id="grpDatosGenerales" dim="70,12,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,17" hSpace="4" clrBrdr="0,58,112" brdr="0,5" tit="Datos generales"  fnt="Arial,16" available="Y" modify="Y">			<sp n="2"/>			<txt clr="0,58,112" hk="S">Sucursal :</txt>			<sp n="4"/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="54,36" bclr="255,255,255" 				brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y"/>			<br/>			<sp n="2"/> <txt clr="0,58,112">Docto. Embarque:</txt>			<sp n="3"/>			<cmb id="k_refer" clr="64,64,64" clrBrdr="255,255,255" OnF9="Dialog(3,cxpcatprobus,k_refer)" dim="54,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="Carga_Info_Embarque()" available="Y"/>			<br/>			<cmb id="grpDoc" clr="64,64,64" clrBrdr="255,255,255"  dim="54,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="0)" available="N" visible="N"/>			<br/>			<!-- <sp n="2"/> <txt id="textProvPago" clr="6,31,255" hk="P" visible="Y">Proveedor de Pago :</txt>			<sp n="2"/>			<edt id="k_clave_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 				OnButton="Get_Cat(1)" OnF9="Get_Cat(1)" OnChange="BuscarProvPago()" 				type="capital" nc="7" tooltip="Proveedor de Pago" modify="Y" hk="C" available="Y" visible="Y"/> 			<br/>			<sp n="15"/>			<inp id="k_nombreprov_pago" clr="6,31,255" clrBrdr="255,255,255"  dim="54,1" fnt="Arial,16" type="capital" modify="N" available="N" nc="50" visible="Y"/> -->						</grp>				<sp/>				<grp id="grpDocumentos" dim="31,12,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,17" hSpace="4" clrBrdr="0,58,112" brdr="0,5" tit="Documento"  fnt="Arial,16" available="Y">			<tab/><inp id="operacion" clr="64,64,64"  dim="28,1" brdr="0,1" fnt=",18b" available="N" type="string"/><br/>			<tab/>			<txt id="foliotxt"  visible="N" hk="F" clr="0,58,112">Folio</txt><tab n="2"/>			<!-- page="doc_consulta,k_folio" -->			<edt id="k_folio" clr="64,64,64" clrBrdr="255,255,255"  dim="18,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" visible="N" hk="F" 				OnChange="Formar_folio()" OnF9="ObtenerFolio()" OnButton="ObtenerFolio()" modify="N" type="string" nc="10"/><br/><tab/>			<inp id="k_docto" clr="64,64,64"  dim="28,1" brdr="0,1" fnt="Arial,16" available="N" link="k_tipon,5" type="string"/><br/>			<tab/><txt clr="0,58,112">Fecha</txt><tab/>			<edt id="k_fecha" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" OnButton="Dialog(0,_ks_fecha,k_fecha)" OnF9="Dialog(0,_ks_fecha,k_fecha)" modify="Y" available="N"/>			<tab n="3"/>			<img id="buscar_folio" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Folio()" available="N" clrBrdr="0,0,0" visible="N"/>			<br/><tab/>			<sp n="3"/> 			<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255"  dim="54,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="Valida_Tipo_Docto()" available="Y" visible="N"/>						<inp id="statusDoc" clr="64,64,64"  dim="28,1" brdr="0,1" fnt=",16b" available="N"/><br/>			<tab/>			<inp id="k_baseFolio" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" brdr="2,0" bclr="255,255,255" type="string" available="N" visible="N" modify="N"/>		</grp><br/> <br/>				<sp n="2"/>		<grp id="grpDetalle" dim="102,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Proveedor" available="Y" modify="Y">				<sp n="1"/> <txt clr="0,58,112">Proveedor : </txt><tab/>			<edt id="k_nombre_prov" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 				type="string" nc="7" modify="Y" hk="C" available="N"/>			<sp n="1"/> <txt clr="0,58,112">RFC : </txt><sp n="2"/>			<inp id="k_rfc" clr="64,64,64"  dim="25,1" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>			<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 				type="string" nc="7" modify="N" hk="C" available="N" visible="N"/>						<tab/><cmb id="k_moneda" clr="64,64,64" clrBrdr="255,255,255"  dim="5,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 				default="PESOS" Null="N" modify="N" visible="N"/>			<tab/><inp id="k_paridad" clr="64,64,64"  dim="5,1" brdr="0,1" fnt="Arial,16" type="number" 				link="k_moneda" modify="N" available="Y" nd="4" visible="N"/>										<br/>		</grp>			<br/><br/>				<sp n="2"/>		<grp id="grpPartidas" dim="95,25,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="236,240,243" fntBrdr="Arial,17" hSpace="4" fnt=",0" available="Y" tit="Registro de Items" modify="Y">			<br/>			<sp n="1"/> 			<tbl id="k_mov" dim="120,10" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" hk="z" OnChange="CalcTotal()" Reorder="N">				<col id="k_parte" name="Art&#237;culo"  type="capital" nc="18" available="Y" OnF9="ConsultaProductos()" modify="N"/>				<col id="k_descr" name="Descripci&#243;n" modify="N"/>						<col id="k_qo" name="Cant Ordenada"  type="number" nd="-1" min="0" modify="N"/>				<col id="k_qb" name="Cant Backorder"  type="number" nd="-1" min="0" modify="N"/>				<col id="k_q" name="Cant Recibida"  type="number" nd="-1" min="0" modify="N"/>				<col id="k_unidad" name="Unidad"  type="capital" OnChange="Unidad()" OnF9="Dialog(3,doc_unidades,k_mov)" OnMouseL="Dialog(3,doc_unidades,k_mov)" available="Y" modify="N"/>				<col id="k_precio" name="Precio lista"  type="number" nd="6" available="Y" modify="N"/>				<col id="k_monto" name="Importe"  type="number" nd="6" min="0" OnChange="Monto()" available="Y" modify="N"/>						<col id="k_partesel" name="Ref. Original" type="capital" nc="18" modify="N"/>				<col id="k_parteseldesc" name="Ref. Original Desc." type="capital" nc="18" modify="N"/>			</tbl>			<br/>			<sp/>			<grp dim="75,15,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<txt clr="0,58,112">Comentarios:</txt>				<sp n="2"/>				<inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="60,3" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="string"/>			</grp>			<sp n="2"/>			<grp dim="36,15,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<txt>Subtotal </txt> <sp n="8"/>				<inp id="subt" clr="64,64,64" dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/>				<br/>				<txt>IVA </txt> <sp n="12"/>				<inp id="k_iva" clr="64,64,64" dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/>				<br/>				<txt fnt=",16b">IMPORTE </txt> <sp n="7"/>				<inp id="k_monto" clr="64,64,64" dim="15,1" fnt=",16b" type="number" nd="2" modify="N" available="N"/>				<br/>			</grp>						</grp>								<!-- Esta seccion se saco del Grupo del Grid para crear un Gpo Contiguo -->				<grp dim="7,15,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="">				<br/>				<br/>		<sp n="2"/> 		<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Consulta()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="N" clrBrdr="0,0,0" visible="N" modify="Y"/>					<br/>		<br/>		<sp n="2"/> 		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>		<br/>		<br/>		<sp n="2"/> 		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		</grp>					</grp>	<script>		InstallDriver("KDB75");		class Main {			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc,usuario, suc_usuario,rol_usuario,asterisco;			var frn,kdb,rep,frP,sys;			var tip_ope;			var uen;			var anio_contable;						//Variables validacion factura			var	str_uuid, fecha_uuid, rfc_uuid, total_uuid, strTotal, validar_uuid;				var nombre_uuid, regimen_uuid, folio_uuid, serie_uuid, NewProvId; 			var sucursal_id, proveedor_id, refer_id;			var cmdQuery, cuboQuery, ok, mensajeError;			var fileSavePath;			var paramProvPago, proveedor_pago_id;			var impuesto_uuid;			var retisr_uuid, retiva_uuid;									/* PARAMETROS de la p?gina indicados desde Tree, o desde frn.Dialog			param(0) = G?nero			param(1) = Naturaleza			param(2) = Grupo			param(3) = Tipo			param(4) = Fija Documento. Si "1", no permite seleccionar otro tipo de documento. Si "0" los combos de grupo  y tipo de documento se habilitan.			param(5) = Tipo de operaci?nn. "0" indica Alta; "1" indica consulta; "2" indica cancelaci?n; "3" indica baja; "4" Indica modificaci?n			*/						fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("c,kdm1,i,kdini,q,kdiq,m,kdmm,s,kdms,u,kdxd,v,kdxv,p,kdip,e,kdxe,f,kdxf,w,kdc2");				ConfiguraControlesOff();				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				fileSavePath = "C:\Basura";				inicializa();			}						fun inicializa(){//Da valor a los combos y prepara la p?gina dependiendo del tipo de Operaci?n a realizar				var resValidacion, resMensaje, cubo, cmd, ok,mensajeError;				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				frn.set("k_fecha",sys.date());								if( frn.nParam()>0 ){//Se han mandado parametros a la pagina					gen_doc=trim(frn.param(0)); 					nat_doc=trim(frn.param(1)); 					gpo_doc=trim(frn.param(2));					tip_doc=trim(frn.param(3)); 					fija_doc=trim(frn.param(4));					tip_ope=trim(frn.param(5));					uen=trim(frn.param(6));					if(uen&="") {						uen="XXX";					}				}				else				{					frn.message("Esta accion no esta permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}					//Llena lista de grupo de documentos				addDocto("Compra Directa",gen_doc,nat_doc,gpo_doc,0,0,"A",30,35);																			//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras_toyota.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}													frn.set("k_sucn",getXml(cubo));					sucursal_id = frn.get("k_sucn",-1,1);				cmd = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTipoDocto");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_tipon",getXml(cubo));				if (strlen(tip_doc)>0) frn.setPos("k_tipon",-1,4,"internal:Y","val:" & tip_doc);//Posiciona el combo de Tipo de documento al especificado como par?metro												if(tip_ope==0){//Alta					frn.set("operacion","ALTA");				}				else if(tip_ope==1){//Consulta					frn.set("operacion","CONSULTA");					frn.setAtt("Aceptar","available","N");					frn.setAtt("Aceptar","visible","N");				}				else if(tip_ope==2){//Baja					frn.set("operacion","BAJA");				}					else { 					frn.message("Operaci?n no v?lida ...", "Mensaje","&Aceptar");					frn.open("index",4);					return;					}					ConfiguraCamposOpcion();				BorraDatos();												cmd = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTipoDocto");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_tipon",getXml(cubo));												Fecha();//Indica fecha correcta, y trae monedas y paridades de esa fecha. 				if (strlen(tip_doc)>0) frn.setPos("k_tipon",-1,4,"internal:Y","val:" & tip_doc);//Posiciona el combo de Tipo de documento al especificado como par?metro				if(tip_ope == 0){ //Alta					cmd = "select documento_id from keplersc.ifz_parts_shipper_embarque where procesado = 'N' order by ship_date desc"; 					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras_toyota_toyota.Inicializa()");									ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										frn.lib("libGeneral.kpl","FileSave", cubo,"C:\Basura\embarque");					frn.set("k_refer", getXml(cubo));									}																Carga_Info_Embarque();							Cargar_Datos_proveedor();				Formar_folio();												frn.setPos("k_sucn");			}			fun Carga_Info_Embarque(){				var res, articulos, cubo, cmd, embarque, n_adicionales, tmpStr;				var totRef, cont;								embarque=frn.get("k_refer");				kdb.rst();				cmd = "select * from keplersc.ifz_carga_piezas_embarque('"& embarque & "','" & sucursal_id & "')";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras_toyota.Carga_Info_Embarque()");				frn.lib("libGeneral.kpl","FileSave", cmd,"C:\Basura\cmdRequestEmbarque");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								tmpStr=getXmlAtt(cubo,"r0","piezas");				rstXml(articulos);				tmpStr=delScpScn(tmpStr);				setXmlStr(articulos,tmpStr);				frn.lib("libGeneral.kpl","FileSave", articulos,"C:\Basura\cuboembarque");				frn.setX(articulos,"k_mov");								totRef=frn.N("k_mov");				for (cont=0; cont<totRef; cont++){					if(frn.get("k_mov",cont,"k_descr") &= "No se encuentra la refaccion"){						frn.setX(frn.get("k_mov",cont,"k_parteseldesc"),"k_mov",cont,"k_descr");					}				}								Calc_totales();			}			 			fun Cargar_Datos_proveedor(){				var cmd, cubo, ok, mensajeError, nombre_prov, rfc_prov;												cmd="SELECT * from keplersc.kdxd where c2 = 'D100000'";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras_toyota.Cargar_Datos_proveedor()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				nombre_prov = getXmlAtt(cubo,"r0","c3");				rfc_prov = getXmlAtt(cubo,"r0","c10");				frn.set("k_clave", "D100000");				frn.set("k_nombre_prov", nombre_prov);				frn.set("k_rfc", rfc_prov);							}			fun Calc_totales(){				var subtotal, iva, total;				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {					subtotal = subtotal + frn.get("k_mov",i,"k_monto");				}								frn.set("subt", subtotal);								iva = subtotal * 0.16;				frn.set("k_iva", iva);												total = subtotal + iva;				frn.set("k_monto", total);			}			fun Ejecuta(){				if(tip_ope==0){Alta();}				if(tip_ope==1){Consulta();}				else if(tip_ope==2){Baja();}			}								fun BorraDatos(){ //Limpia todos los campos para generar un nuevo documento. 				frn.set("k_folio","","statusDoc","","k_refer","","k_fecRef",""); 				frn.rst("k_mov");				frn.rst("k_poliza");													frn.set("subt","");				frn.set("k_iva","");					frn.set("k_sumrets","");						frn.set("k_monto","");								if ( tip_ope>0 ) frn.setPos("k_folio");							}			fun Formar_folio(){							var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);												cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				frn.lib("libGeneral.kpl","FileSave",cubofol,"C:\Basura\cuboFol");								var resultado = getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");								frn.set("k_folio", fol);			}									fun ObtenerFolio(){				cmdQuery="select c6 as folio, substring(cast(c9 as VARCHAR),1,10) as fecha, c10 as cliente, c32 as nombre,c11 as factura, c16 as monto, c43 as status " & 					"from keplersc.kdm1 where c1='" & 					frn.get("k_sucn",-1,1) & "' and c2='" & gen_doc & "' and c3='" & nat_doc & "' and c4=" & gpo_doc 					& " and c5=" & frn.get("k_tipon",-1,4);										if (tip_ope == 2 ){						cmdQuery = cmdQuery & " and c43 <> 'C' ";					}										cmdQuery = cmdQuery & " order by c9 desc" & ", c6 desc /*Added by JMM 20240702*/";									frn.dialog("genlistafiltrosel","Movimiento a taller",cmdQuery,"folio","k_folio","0","0","N","N");								}			fun Fecha(){				var cubo, cmd, resValidacion, resMensaje, fecha;				var validDate=frn.lib("libKepler","ValidOpDate",frn.get("k_fecha"));												frn.set("k_moneda","PESOS");				frn.set("k_paridad",1);								kdb.rst();				frn.rst("results");				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				if (tip_ope == 0 ){					cmd= "select * from keplersc.verify_year('" & fecha & "')";					cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Fecha()");									;										resValidacion= getXml(cubo,"validacion","resultado");					resMensaje = getXml(cubo,"validacion","mensaje");					if(resMensaje &! ""){						frn.message(resMensaje, "Mensaje","&Aceptar");					}											if(resValidacion &= "0"){						frn.setPos("k_fecha");						return;					}									}			}			fun Alta(){//Genera el documento en base a los datos en pantalla.				var resultado, mensaje, adicionales, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd, vdiferencia, query_prov;				var partidasValidas = 0;				var no_partidas, ok, mensajeError, prod_ui, prod_original,cuboProd,vdiferencia;				kdb.rst();				frn.rst("results");								fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				cmd= "select * from keplersc.verify_year('" & fecha & "')";				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Alta()");												resultado= getXml(cubo,"validacion","resultado");				mensaje = getXml(cubo,"validacion","mensaje");				if(mensaje &! ""){					frn.message(mensaje,"Error al generar el documento","Aceptar");					return;				}									if(resultado &= "0"){					return;				}									var gapMonto, gapDias; 				var totReg;								//Obtener variables				sucursal_id = frn.get("k_sucn",-1,1);				proveedor_id = frn.get("k_clave");				refer_id = frn.get("k_refer");													//Validar productos				for(var i =0;i<frn.N("k_mov");i++){					if(frn.get("k_mov",i,"k_parte")&!"" || frn.get("k_mov",i,"k_q")&!""){						/*						if(frn.get("k_mov",i,"k_q")<=0 || strlen(frn.get("k_mov",i,"k_q"))==0){							frn.message("Se ha generado el siguiente error: producto con cantidad 0","Error al generar el documento","Aceptar");							frn.setPos("k_mov","ren:"&i);							return;						}						*/						if(frn.get("k_mov",i,"k_parte")&=""){							frn.message("Se ha generado el siguiente error: clave de producto vacia","Error al generar el documento","Aceptar");							frn.setPos("k_mov","ren:"&i);							return;						}						/*						if(frn.get("k_mov",i,"k_precio")&="" || frn.get("k_mov",i,"k_precio")&="0"){							frn.message("Se ha generado el siguiente error: precio de producto cero","Error al generar el documento","Aceptar");							frn.setPos("k_mov","ren:"&i);							return;						}						*/							if(frn.get("k_mov",i,"k_descr")&="" || frn.get("k_mov",i,"k_descr")&="No se encuentra la refaccion"){							frn.message("Se ha generado el siguiente error: El producto debe estar registrado, por favor notificarlo para su revision.","Aceptar");							frn.setPos("k_mov","ren:"&i);							return;						}					}				}													if( frn.get("k_monto") <= 0 ){					frn.message("No se puede dar de alta el documento ya que el importe es cero","Error","&Aceptar");return;				}												//Fin de validaciones								fecha = sys.date();				hora= sys.time();				//cubo = "dat";				kdb.rst();				frn.rst("results");				frn.rst(xmlPantalla);				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Recrear k_parte para pieza original y reemplazos				no_partidas=frn.N("k_mov")-1;				//Agregar usuario, fechay hora de movimiento				setXml(xmlPantalla,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));				setXml(xmlPantalla,"k_mov","no_partidas",no_partidas);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"k_refer",frn.get("k_refer"));												no_partidas=frn.N("k_mov") -1;				for(var i =0;i<no_partidas;i++){					prod_ui = getXml(xmlPantalla,"k_mov","r" & i ,"k_parte");					prod_original = getXml(xmlPantalla,"k_mov","r" & i ,"k_partesel");					setXml(xmlPantalla,"k_mov","r" & i,"k_parte",prod_original);					setXml(xmlPantalla,"k_mov","r" & i,"k_partesel",prod_ui);				}								cmd="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"comopecompras.Alta");				//frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlResultadoCompra");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");				adicionales=getXml(cubo,"adicionales");								if(resultado &= "1"){					frn.set("k_folio",mensaje); 					frn.set("operacion","CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);					Folio();								mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;					frn.message(mensaje, "Mensaje","&Aceptar");					query_prov = "update keplersc.ifz_parts_shipper_embarque set procesado = 'S' where documento_id = '" & frn.get("k_refer") & "';";					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",query_prov,"comopecompras_toyota.Alta()");	                resultado = getXml(cuboQuery,"resultado");					frn.lib("libGeneral.kpl","FileSave",resultado,"C:\Basura\resultado_update");					ConfiguraControlesOff();					if (strlen(trim(adicionales ))!=0){						frn.message(adicionales,"Mensaje","&Aceptar");					}					frn.set("operacion","CONSULTA");					reporte();					ConfiguraCamposOpcion();										frn.setPos("k_sucn");				}else{					frn.message(mensaje, "Error","&Aceptar");				}						}			fun Folio(){ //Consulta el documento especificado en el campo k_folio				var xmlDetalle,tmpStr,no_partidas;				var cmd,ok, clave_prod,cubo,cuboProd,prod_original;				kdb.sp("k_getDoc","datDoc",frn.get("k_sucn",-1,1),frn.get("k_tipon",-1,1),frn.get("k_tipon",-1,2),frn.get("k_tipon",-1,3),frn.get("k_tipon",-1,4),frn.get("k_folio")); 				kdb.exec();				xmlDetalle = kdb.get("datDoc");				no_partidas=nXml(xmlDetalle,"k_mov");				for(var i =0;i<no_partidas;i++){					setXml(xmlDetalle,"k_mov","r"&i,"k_qr", getXml(xmlDetalle,"k_mov","r"&i,"k_Q"));					//Obtiene el prod_original de kdm2					cmd = "select c8,c28 from keplersc.kdm2 where c1='" & frn.get("k_sucn",-1,1) & "' and c2= '" & frn.get("k_tipon",-1,1) & "' and c3= '" & 						frn.get("k_tipon",-1,2) & "' and c4='" & frn.get("k_tipon",-1,3) & "' and c5= '" & frn.get("k_tipon",-1,4) & "' and c6 =upper('" & frn.get("k_folio") & "')" &						" and c8='" & getXml(xmlDetalle,"k_mov","r"&i,"k_parte") & "'";						cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Buscar_folio()");					ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					var lenght_xml = nXml(cubo); 					if(lenght_xml != 0 ){						prod_original=getXmlAtt(cubo,"r0","c28");												if(prod_original &="0" || prod_original &=""){								clave_prod = getXml(xmlDetalle,"k_mov","r"&i,"k_parte");							cmd="select * from keplersc.prod_obtener_original('" & clave_prod & "')";							cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Buscar_folio()");							prod_original = getXmlAtt(cuboProd,"r0","prod_obtener_original");						}						setXml(xmlDetalle,"k_mov","r"&i,"k_partesel",prod_original);					}					frn.rst(cubo);					frn.rst(cuboProd);								}											frn.setX(xmlDetalle); //Llenar grid de partes						frn.lib("libGeneral.kpl","FileSave",xmlDetalle,"C:\Basura\xmlConsCompra");							frn.set("k_nombreprov",getXml(xmlDetalle,"k_nombre"));				frn.set("k_calleprov",getXml(xmlDetalle,"k_calle"));				frn.set("k_coloniaprov",getXml(xmlDetalle,"k_colonia"));				frn.set("k_poblacionprov",getXml(xmlDetalle,"k_poblacion"));				frn.lib("libGeneral.kpl","FileSave",getXml(xmlDetalle,"k_refer"),"C:\Basura\refer");									cmd = "select documento_id from keplersc.ifz_parts_shipper_embarque where documento_id = '"&getXml(xmlDetalle,"k_refer")&"'"; 				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras_toyota_toyota.Inicializa()");				frn.lib("libGeneral.kpl","FileSave", cubo,"C:\Basura\embarque");				frn.set("k_refer", getXml(cubo));								var status=kdb.get("datDoc","err");				if (status==1001) frn.set("statusDoc","Documento referenciado");				else if (status==1002){ BorraDatos();frn.set("statusDoc","Documento no encontrado");}				else if (status==1003) frn.set("statusDoc","Documento cancelado");				else frn.set("statusDoc","");			}			fun ConsultaProductos(){				var suc,producto;				suc = frn.get("k_sucn",-1,1);				producto=frn.get("k_mov", -1, "k_parte");				cmdQuery="";										frn.dialog("prodlistafiltrosel","Refacciones",cmdQuery,"clave_actual","k_mov",-1,"k_parte","N","N",suc,producto,"Clave");			}			fun Consulta(){//Imprime el reporte del documento especificado 				if(strlen(trim(frn.get("k_folio")))==0){ 					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");					frn.setPos("k_folio");					return;					}				reporte();				frn.setPos("k_folio");			}						fun Baja(){ //Borra totalmente el docuemtno especificado. (No deja huella del documento)						var resultado, mensaje, adicionales, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd,query_prov;				var partidasValidas = 0;				var no_partidas, prod_ui, prod_original;				//var ok, mensajeError; 								fecha = sys.date();				hora= sys.time();				//cubo = "dat";				kdb.rst();				frn.rst("results");				frn.rst(xmlPantalla);				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								xmlPantalla = getXml(frn.dataPag()); 				//Agregar usuario, fechay hora de movimiento				setXml(xmlPantalla,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);								setXml(xmlPantalla,"k_refer", frn.get("k_refer"));								//Agregar el tag k_q, el cual debe ser igual a k_q, esto es porque postgresql maneja minusculas				no_partidas=frn.N("k_mov") -1;								for(var i =0;i<no_partidas;i++){					prod_ui = getXml(xmlPantalla,"k_mov","r" & i ,"k_parte");					prod_original = getXml(xmlPantalla,"k_mov","r" & i ,"k_partesel");					setXml(xmlPantalla,"k_mov","r" & i,"k_parte",prod_original);					setXml(xmlPantalla,"k_mov","r" & i,"k_partesel",prod_ui);				}								frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlCompra");				cmd="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"comopecompras.Baja");				//frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlResultadoCompra");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");				adicionales=getXml(cubo,"adicionales");								if(resultado &= "1"){					frn.set("k_folio",mensaje); 					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);					Folio();					//Deshabilita_campos();										mensaje = "Documento con Folio: " & mensaje & " cancelado correctamente."; 					frn.message(mensaje, "Mensaje","&Aceptar");					if (strlen(trim(adicionales ))!=0){						frn.message(adicionales,"Mensaje","&Aceptar");					}					ConfiguraCamposOpcion();					BorraDatos();					frn.setPos("k_sucn");					query_prov = "update keplersc.ifz_parts_shipper_embarque set procesado = 'N' where documento_id = '" & frn.get("k_refer") & "';";					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",query_prov,"comopecompras_toyota.Alta()");	                resultado = getXml(cuboQuery,"resultado");				}else{					frn.message(mensaje, "Error","&Aceptar");				}									}						fun ConfiguraCamposOpcion(){				var strValAtr;				ConfiguraControlesOff();				//HAbilita segun tipo de operacion				strValAtr = "Y";				switch(tip_ope){					case 0: //Alta						frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpDatosGenerales","modify",strValAtr);						frn.setAtt("grDocumentos","available",strValAtr);						frn.setAtt("grDocumentos","modify",strValAtr);						frn.setAtt("grpDetalle","available",strValAtr);						frn.setAtt("grpDetalle","modify",strValAtr);						frn.setAtt("grpProveedor","available",strValAtr);						frn.setAtt("grpProveedor","modify",strValAtr);						frn.setAtt("grpPartidas","available",strValAtr);						frn.setAtt("grpPartidas","modify",strValAtr);						frn.setAtt("Aceptar","available",strValAtr);						frn.setAtt("Aceptar","visible",strValAtr);							frn.setAtt("Cancelar","available",strValAtr);						frn.setAtt("Cancelar","visible",strValAtr);														frn.setAtt("k_fecha","modify",strValAtr);							frn.setAtt("k_fecha","available","N"/*strValAtr*/);												frn.setAtt("k_refer","available","N"); 						frn.setAtt("k_clave", "available", "N");						frn.setAtt("k_fecRef","modify",strValAtr);							frn.setAtt("k_fecRef","available",strValAtr);						frn.setAtt("k_plazo","modify","N"/*strValAtr*/);							frn.setAtt("k_plazo","available","N"/*strValAtr*/);						frn.setAtt("k_cond","modify","N"/*strValAtr*/);							frn.setAtt("k_cond","available","N"/*strValAtr*/);													frn.setAtt("k_coment","modify",strValAtr);						frn.setAtt("k_coment","available",strValAtr);																		//frn.setAtt("k_mov","modify",strValAtr,"k_parte");						frn.setAtt("k_mov","available",strValAtr,"k_parte");						//frn.setAtt("k_mov","modify",strValAtr,"k_unidad");						frn.setAtt("k_mov","available",strValAtr,"k_unidad");						//frn.setAtt("k_mov","modify",strValAtr,"k_precio");						frn.setAtt("k_mov","available",strValAtr,"k_precio");						//frn.setAtt("k_mov","modify",strValAtr,"k_monto");												frn.setAtt("k_mov","available",strValAtr,"k_monto");						frn.setAtt("k_refer","available","Y");												frn.setAtt("buscar_folio", "available", "N"); 						frn.setAtt("buscar_folio", "visible", "N"); 												frn.setAtt("Buscar", "visible", "Y");						frn.setAtt("Buscar", "available", "Y");						if ( paramProvPago /*&= "P"*/ > 0 ) {											frn.setAtt("k_clave_pago", "available", "Y");						} else {							frn.setAtt("k_clave_pago", "available", "N");						}										break;					case 1: //Consulta						frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpProveedor","available",strValAtr);						frn.setAtt("grpProveedor","modify",strValAtr);						frn.setAtt("k_folio","modify",strValAtr);							frn.setAtt("k_folio","visible",strValAtr);											frn.setAtt("foliotxt","visible",strValAtr);											frn.setAtt("Imprimir","available",strValAtr);						frn.setAtt("Imprimir","visible",strValAtr);												frn.setAtt("buscar_folio", "available", "Y"); 						frn.setAtt("buscar_folio", "visible", "Y"); 												frn.setAtt("Buscar","available","N");							frn.setAtt("Buscar","visible","N");													frn.setAtt("k_clave_pago", "available", "N"); 						frn.setAtt("k_refer","available","N");												break;					case 2:						//Baja						frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpProveedor","available",strValAtr);						frn.setAtt("grpProveedor","modify",strValAtr);						frn.setAtt("k_folio","modify",strValAtr);							frn.setAtt("k_folio","visible",strValAtr);											frn.setAtt("foliotxt","visible",strValAtr);											frn.setAtt("buscar","visible",strValAtr);						frn.setAtt("Aceptar","available",strValAtr);						frn.setAtt("Aceptar","visible",strValAtr);							frn.setAtt("Cancelar","available",strValAtr);						frn.setAtt("Cancelar","visible",strValAtr);													frn.setAtt("buscar_folio", "available", "Y"); 						frn.setAtt("buscar_folio", "visible", "Y"); 												frn.setAtt("Buscar","available","N");							frn.setAtt("Buscar","visible","N");													frn.setAtt("k_clave_pago", "available", "N"); // Added by JMM, 20240301 													frn.setAtt("k_refer","available","N");						break;					default:				}			}			fun addDocto(Descripcion,Gen,Nat,Gru,bTipo_Especifico,bSoloAutorizado,NatPrv,GruPrv,Gru2Prv){				var renglon=frn.N("grpDoc");				frn.setX(trim(Descripcion),"grpDoc",renglon,0);				frn.setX(trim(Gen),"grpDoc",renglon,1);				frn.setX(trim(Nat),"grpDoc",renglon,2);				frn.setX(trim(Gru),"grpDoc",renglon,3);				frn.setX(trim(bTipo_Especifico),"grpDoc",renglon,4);				frn.setX(trim(bSoloAutorizado),"grpDoc",renglon,5);				frn.setX(trim(NatPrv),"grpDoc",renglon,6);				frn.setX(trim(GruPrv),"grpDoc",renglon,7);				frn.setX(trim(Gru2Prv),"grpDoc",renglon,8);			}									fun ConfiguraControlesOff()			{				var strValAtr;				strValAtr = "N";				//Deshabilita todos los campos y botones				frn.setAtt("grpDatosGenerales","available",strValAtr);				frn.setAtt("grDocumentos","available",strValAtr);								frn.setAtt("grpDoc","available","N");								frn.setAtt("grpDetalle","available",strValAtr);				frn.setAtt("grpProveedor","available",strValAtr);				frn.setAtt("grpPartidas","available",strValAtr);				frn.setAtt("Aceptar","available",strValAtr);				frn.setAtt("Aceptar","visible",strValAtr);				frn.setAtt("Cancelar","available",strValAtr);				frn.setAtt("Cancelar","visible",strValAtr);									frn.setAtt("foliotxt","visible",strValAtr);									frn.setAtt("k_folio","modify",strValAtr);					frn.setAtt("k_folio","visible",strValAtr);											frn.setAtt("k_fecha","modify",strValAtr);					frn.setAtt("k_refer","available","N"); 								frn.setAtt("k_clave", "available", "N");				frn.setAtt("k_fecRef","modify",strValAtr);					frn.setAtt("k_fecRef","available",strValAtr);				frn.setAtt("k_plazo","modify",strValAtr);					frn.setAtt("k_plazo","available",strValAtr);				frn.setAtt("k_cond","modify",strValAtr);					frn.setAtt("k_cond","available",strValAtr);								frn.setAtt("k_coment","modify",strValAtr);				frn.setAtt("k_coment","available",strValAtr);								frn.setAtt("k_mov","modify",strValAtr,"k_parte");				frn.setAtt("k_mov","modify",strValAtr,"k_unidad");				frn.setAtt("k_mov","modify",strValAtr,"k_precio");				frn.setAtt("k_mov","modify",strValAtr,"k_monto");												frn.setAtt("buscar_folio","visible","N"/*strValAtr*/);  								frn.setAtt("k_fecha", "available", "N");				frn.setAtt("Buscar", "visible", "N");				frn.setAtt("Buscar", "available", "N");								frn.setAtt("textProvPago", "visible", "Y");				frn.setAtt("k_clave_pago", "visible", "Y");				frn.setAtt("k_nombreprov_pago", "visible", "Y");				frn.setAtt("k_clave_pago", "available", "N");				frn.setAtt("k_nombreprov_pago", "available", "N");							}				fun reporte(){				var prefix=frn.lib("libKepler","langPrefix");				rep.rst();				IniParams();				kdb.readPage("datos","comopecomprasfto");				kdb.exec();				rep.source(kdb.get("datos")); 								//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");												rep.set("titulo",frn.get("k_tipon"));								if ( strFormat("lcase", frn.get("statusDoc")) &= "documento cancelado" ) {					rep.set("titulost",frn.get("statusDoc"));  				}								rep.exe("tit");					rep.set("rep_suc",frn.get("k_sucn"));				//rep.set("rep_alm",frn.get("k_almN")); //No se manejan almacenes, solo 1 por defecto				rep.set("rep_docto",frn.get("k_docto"));				rep.set("rep_moneda",frn.get("k_moneda"));				rep.set("rep_fecha",frn.get("k_fecha"));				rep.set("rep_folio",frn.get("k_folio"));				rep.set("rep_cliente",frn.get("k_clave"));				rep.set("rep_clientedir1",frn.getM("k_datCve",0));				rep.set("rep_clientedir2",frn.getM("k_datCve",1));				rep.set("rep_clientedir3",frn.getM("k_datCve",2));				rep.set("rep_clientedir4",frn.getM("k_datCve",3));				rep.set("rep_rfc",frn.get("k_rfc"));				rep.set("rep_condiciones",frn.get("k_cond"));				rep.set("rep_leyenda",frn.get("leyenda"));				rep.set("rep_fechaen",frn.get("k_vence"));				rep.set("rep_refer",frn.get("k_refer"));				rep.exe("encabezado");				rep.exe("partidas");				for(var i=0,n=frn.N("k_mov")-1;i<n;i++){					rep.set("rep_cantidad",frn.get("k_mov",i,"k_q"));					rep.set("rep_unidad",frn.get("k_mov",i,"k_unidad"));					rep.set("rep_clave",frn.get("k_mov",i,"k_parte"));					rep.set("rep_producto",frn.get("k_mov",i,"k_descr"));					rep.set("rep_precio",frn.get("k_mov",i,"k_precio"));					rep.set("rep_importe",frn.get("k_mov",i,"k_monto"));									rep.exe("partida");				}				rep.exe("lineaFinal");rep.exe("vacio");				rep.set("rep_TotalLetras","***" & strFormat("number",frn.get("k_monto"),0,frn.get("k_moneda")) & " " & frn.get("k_moneda",-1,2));				rep.exe("partida2");				rep.exe("vacio");				rep.set("rep_comentario1",frn.getM("k_coment",0));				rep.set("rep_comentario2",frn.getM("k_coment",1));				rep.set("rep_comentario3",frn.getM("k_coment",2));				rep.set("rep_subtotal",frn.get("subt"));				rep.set("rep_iva",frn.get("k_iva"));				rep.set("rep_retenciones",frn.get("k_sumrets"));				rep.set("rep_total",frn.get("k_monto"));				rep.exe("fin");												//impresion de la poliza				var nRenPol=kdb.NR("datDoc","k_poliza");				var tPoliza=kdb.get("datDoc","k_poliza","tpoliza");				var nPoliza=kdb.get("datDoc","k_poliza","npoliza");			   				if (strlen(tPoliza)>0 && strlen(nPoliza)>0 ){						rep.set("tPol",tPoliza);						rep.set("nPol",nPoliza);						rep.exe("encabezadoPol");						var tAbonosPol=0, tCargosPol=0;						for(var i=0;i<nRenPol;i++){							if (kdb.get("datDoc","k_poliza","r"&i,"k_cargo")==0){								rep.set("PolClave2",kdb.get("datDoc","k_poliza","r"&i,"k_cuenta"));								rep.set("PolDescr2",kdb.get("datDoc","k_poliza","r"&i,"k_ctaDescr"));								rep.set("PolHaber",kdb.get("datDoc","k_poliza","r"&i,"k_abono"));								tAbonosPol=tAbonosPol+kdb.get("datDoc","k_poliza","r"&i,"k_abono");								rep.exe("partPolA");							}else{								rep.set("PolClave",kdb.get("datDoc","k_poliza","r"&i,"k_cuenta"));								rep.set("PolDescr",kdb.get("datDoc","k_poliza","r"&i,"k_ctaDescr"));								rep.set("PolDebe",kdb.get("datDoc","k_poliza","r"&i,"k_cargo"));								tCargosPol=tCargosPol+kdb.get("datDoc","k_poliza","r"&i,"k_cargo");								rep.exe("partPolC");							}						}						rep.set("totCargo",tCargosPol);						rep.set("totAbono",tAbonosPol);						rep.exe("PolTotales");				}								rep.win(); 			}						fun IniParams(){				frn.set("param_paper","letter");					frn.set("param_sizeX","21.59","param_sizeY","27.94");				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");					frn.set("param_Fx","1.0");				frn.set("param_landscape","Y"/*Y*/);					frn.set("param_emp","L");				}			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}			}	</script></pag>