<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Anuncios">
<grp id="usuario" brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>
	<grp dim="67,12,10,12"><sp/><br/><br/><br/><br/>
		<grp dim="20,9,1,12">
			<img id="logoCliente"  dim="200,100" brdr="0,0" img="ClientLogo.png" available="N" bPx="1" visible="N"/>
		</grp>
		<tab n="2"/>
		<grp dim="42,9,10,12" hSpace="4"><br/><br/><br/>
			<inp id="lblUser" clr="64,64,64"  dim="42,1" brdr="0,1" type="string" modify="N" available="N" just="R" fnt="Arial,25"/>
		</grp><br/>
	</grp><sp/>
	<grp dim="26,15,1,12">
		<img id="Logo"  dim="256,193" brdr="0,0" img="_Announcements.png" available="N" OnEnter="Pagina()" bPx="1"/>
	</grp>
	<inp id="pagina" clr="64,64,64"  dim="1,1" available="N" modify="N" visible="N" OnEnter="Pagina()"/>
	<br/><tab/>
	<grp id="principal"  dim="95,31,7,12" brdr="0,5" fnt="Arial,16" clr="64,64,64" bclr="236,240,243" clrBrdr="0,58,112 " 
		fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" tit="Bienvenido!- Martes 27 de septiembre de 2022"><tab n="25"/>
	</grp><br/>
</grp>

<script>
	InstallDriver("KDB75");
	class Main {
		var frn,sys,kdb;
		var usuario,tipoAdm,rol_usuario;
      fun Main() { 
			frn=new FRNT; 
			sys=new SYS;
			kdb=new KDB;
			kdb.connect();
			frn.setAtt("usuario","tit","");
			frn.setAtt("anuncios","tit","");
			//Actualiza la pantalla de mensajes
			//Obtiene el usuario
			kdb.sp("security","dat");
			kdb.exec();
			usuario=kdb.get("dat","user");
			tipoAdm=kdb.get("dat","tipo");
			rol_usuario = frn.config("user","role");
			
			frn.set("lblUser",kdb.get("dat","name"));	
			frn.setAtt("principal","tit","Bienvenido!- " & strFormat("date",sys.date(),0,"dayweek") );
			
			//Valida usuario administrador
			if(rol_usuario &= "ADMINISTRADOR" || rol_usuario &= "ADMINISTRATOR"){
				//frn.message("Tiene privilegios de Administrador, no divulgue su password","Mensaje",1);
			}		
		}
		
		
		fun Pagina(){
			sys.shell(frn.get("pagina"));
		}
		
   }

</script>
</pag>