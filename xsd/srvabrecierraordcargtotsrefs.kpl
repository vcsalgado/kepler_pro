<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit=""><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/>	<tab/>	<br/><tab n="1"/>	<inp id="inp_titulo" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>	<br/>	<tab/><hLine clr="0,0,0"/> 		<br/><br/>	<tab/>		<grp dim="110,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle de la orden">			<sp/><txt fnt=",b">Sucursal:</txt><sp/><inp id="k_sucursal" dim="5,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<sp/><inp id="k_sucnombre" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/><tab/><txt fnt=",b">Fecha:  </txt>			<inp id="k_fecha" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" modify="N" available="N" fmt="DD/MM/CCYY" nc="-1" fnt=",0"/><tab/><txt fnt=",b">Estatus:</txt>			<inp id="k_estatusdesc" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/><tab n="2"/>			<br/>			<sp/><txt  fnt="Arial,b">Tipo:</txt><sp/><inp id="k_tipo" clr="64,64,64"  dim="3,1" fnt="Arial,0" clrBrdr="255,255,255"   bclr="255,255,255" modify="N" visible="Y" type="string" brdr="2,0"/>			<sp/><inp id="k_tipodesc" dim="25,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" fnt=",0" modify="N" available="N"/>			<tab/><txt  fnt="Arial,b">Folio:</txt><sp/><inp id="k_folio" clr="64,64,64"  dim="18,1" fnt="Arial,0" clrBrdr="255,255,255"   bclr="255,255,255" brdr="2,0"  modify="N" visible="Y" type="string"/>			<tab/><txt fnt=",b">Cliente: </txt><sp/><inp id="k_cliente" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<sp/><inp id="k_nombre" dim="50,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<br/>			<sp/><txt fnt=",b">VIN: </txt><sp/><inp id="k_serie" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b"> Marca:</txt><sp/>	<inp id="k_marca" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b">Modelo:</txt><sp/><inp id="k_modelo" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b">A&#241;o:</txt><sp/><inp id="k_anio" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b">Placas:</txt><sp/><inp id="k_placa" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b">Bonete:</txt><sp/><inp id="k_bonete" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		</grp>		<br/><br/>	<tab/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="110,20,10,10" brdr="0,5" tit="Detalle de Puntos" fnt="Arial,16">			<br/>		<sp/>		<tbl id="tabla_puntos" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="98,9"  hk="z" Reorder="N" modify="N" available="Y" insdel="N" OnMouseL="PreCargaCargos()" OnChange="CalculaTotales()">			<col id="k_punto" name="Punto" modify="N" visible= "Y" type="capital" OnActive="PreCargaCargos()"/>			<col id="k_clave_operario" name="Operario" OnF9="" modify="N" visible= "Y" OnActive="PreCargaCargos()"/>			<col id="k_descripcion" name="Descripcion" modify="N" visible= "Y" type="capital" OnActive="PreCargaCargos()"/>			<col id="k_tipo_punto" name="Tipo Punto" modify="N" visible= "Y" type="capital" OnActive="PreCargaCargos()"/>			<col id="k_desc_tipo" name="Desc. Tipo Punto" modify="N" visible= "Y" type="capital" OnActive="PreCargaCargos()"/>			<col id="k_status_punto" name="Status Punto" modify="N" visible= "Y" type="capital" OnActive="PreCargaCargos()"/>			<col id="k_status_tots" name="Status TOTs" OnF9="" modify="N" visible= "N" type="capital" OnActive="PreCargaCargos()"/>			<col id="k_status_cargos" name="Status Cargos" OnF9="" modify="N" visible= "N" type="capital" OnActive="PreCargaCargos()"/>			<col id="k_status_refs" name="Status Refs" OnF9="" modify="N" visible= "N" type="capital" OnActive="PreCargaCargos()"/>			<col id="k_flujo_admon" name="Flujo Admon" OnF9="" modify="N" visible= "Y" OnActive="PreCargaCargos()"/>		</tbl>		<br/><br/>	</grp>		<br/><br/><br/>	<tab n="10"/>		<bot id="CerrarOrden" dim="15,1" OnEnter="AdmonOrden()" tooltip="Cerrar Orden" available="N" visible="Y" brdr="5,0" text="Cierra Orden"/>		<tab n="2"/>		<bot id="AbrirOrden" dim="15,1" OnEnter="AdmonOrden()" tooltip="Abrir Orden" available="N" visible="Y" brdr="5,0" text="Abre Orden"/>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var perfil_usuario,asterisco,vin , externo, sucursal_id,num_orden, tipo_orden, punto, statusOrden;			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			var tipopunto, status, cerradovarios, marca, modelo; 			// Variables de control			var cmdQuery, cuboQuery, ok, mensajeError, fileSavePath;			var flujoadmon, resVal;													// Variables de parametros			var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, tip_opc, paramProd;							fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				rep=new REP;				kdb.connect();				anio_contable = kdb.get("KDE","14");								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");								rol_usuario = frn.config("user","role");				asterisco = "*";				fileSavePath = "C:\Basura";				sucursal_id =trim(frn.param(0));				tipo_orden=trim(frn.param(1));				num_orden=trim(frn.param(2));				tip_ope=trim(frn.param(3));	//CARGOS o	TOTS				tip_opc=trim(frn.param(4));	//A-abrir	C-cerrar				Inicializa();			}										fun Inicializa(){				var cmd, cubo, strTitulo;				var xmlOrden, xmlDatos;				resVal = 1;				//Establecer titulo de la ventana				strTitulo= "Orden de ";				if (tip_opc&="C"){					strTitulo= "Cierra "& strTitulo;				}else if (tip_opc&="A"){					strTitulo= "Abre "& strTitulo;				}				if (tip_ope &= "CARGOS"){										frn.set("inp_titulo",strTitulo & "Cargos Varios");					}else if (tip_ope &= "TOTS"){					frn.set("inp_titulo",strTitulo & "TOTs");					}else if (tip_ope &= "REFS"){					frn.set("inp_titulo",strTitulo & "REFACCIONES");					}							xmlOrden= frn.lib("libOrdenes.kpl","ConsultaOrden",sucursal_id,tipo_orden,num_orden);								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				xmlDatos = frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",xmlOrden,"r0");				frn.setX(xmlDatos);																cmd = " select c1 from keplersc.kdoper where c20='" & usuario & "'";									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvabrecierraordcargtotsrefs.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo, fileSavePath & "\perfil_usuario");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				cargapuntos();//puntos				vin = getXmlAtt(cubo,"r0","serie");				flujoadmon = frn.get("tabla_puntos",-1,"k_flujo_admon");				ConfiguraControlesOpcion();							}			fun cargapuntos(){				var cmd, cubo;				cmd = "select pun.c4 as k_punto,pun.c9 as k_clave_operario,pun.c8 k_descripcion, " &					"pun.c6 as k_tipo_punto, cat.c2 as k_desc_tipo, " &					"pun.c7 as k_status_punto,pun.c23 as k_status_tots,pun.c24 as k_status_cargos, pun.c20 as k_status_refs, ord.c7 as k_flujo_admon " &					"from keplersc.kdord ord " &					"inner join keplersc.kdpun pun on pun.c1=ord.c1 and pun.c2=ord.c2 and pun.c3=ord.c3 " &					"inner join keplersc.kdmargen marg on marg.c1= pun.c2 " &					"left outer join keplersc.catpuntos as cat on cat.c1=pun.c6 " & 					"where ord.c1='" & sucursal_id & "' and ord.c2='" & tipo_orden & "' and ord.c3='" & num_orden & "'" &					"order by pun.c4"; 				rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvabrecierraordcargtotsrefs.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo, fileSavePath & "\puntos");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												frn.setX(cubo,"tabla_puntos");			}			fun ValidaStatus(){				var xmlProd, col;				resVal=1;				if (tip_ope &= "TOTS"){					col = "c23";				} else if (tip_ope &= "CARGOS"){					col = "c24";				}else if (tip_ope &= "REFS"){					col = "c20";				}								cmdQuery = "select distinct " & col & " as status from keplersc.kdpun " &						"where c1='" & sucursal_id & "' and c2='" & tipo_orden & "' and c3='" & num_orden & "'";					rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvabrecierraordcargtotsrefs.ValidaStatus()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery , fileSavePath & "\cuboQuery ");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}								statusOrden = getXmlAtt(cuboQuery,"r0", "status");								if (tip_opc &="C"){					if (statusOrden &= "C"){						resVal=0;							frn.message("No es posible cerrar la órden porque se encuentra cerrada","Error","Aceptar");					}				} else if (tip_opc &="A"){					if (statusOrden &= "A"){						resVal=0;							frn.message("No es posible abrir la órden porque se encuentra abierta","Error","Aceptar");					}				}				if(resVal==0){					return;				}			}		fun ConfiguraControlesOpcion() {						ConfiguraControlesOff();			if (flujoadmon &= "0"){				if (tip_opc &= "C"){					frn.setAtt("CerrarOrden", "available", "Y");				} else if (tip_opc &= "A"){						frn.setAtt("AbrirOrden", "available", "Y");				}				}else{				frn.setAtt("CerrarOrden", "available", "N");				frn.setAtt("AbrirOrden", "available", "N");			}			if (tip_ope&="TOTS"){				frn.setAtt("tabla_puntos","visible","Y", "k_status_tots");					} else if (tip_ope&="CARGOS"){				frn.setAtt("tabla_puntos","visible","Y","k_status_cargos");			} else if (tip_ope&="REFS"){				frn.setAtt("tabla_puntos","visible","Y","k_status_refs");			}									}		fun ConfiguraControlesOff(){					frn.setAtt("CerrarOrden", "available", "N");			frn.setAtt("AbrirOrden", "available", "N");			frn.setAtt("tabla_puntos","visible","N", "k_status_tots");				frn.setAtt("tabla_puntos","visible","N","k_status_cargos");				frn.setAtt("tabla_puntos","visible","N","k_status_refs");				}		fun AdmonOrden() {			var xmlDatos, strmsgopc, strMsg, continua;			var resultado, mensaje, folio;						ValidaStatus();				if(ok &! "1" || resVal == 0){				return;			}				continua = frn.message("¿Desea continuar?","Atención",2);			if (continua == 0){				return;			}			setXml(xmlDatos,"document","k_sucursal",sucursal_id);			setXml(xmlDatos,"document","k_tipo",tipo_orden);			setXml(xmlDatos,"document","k_folio",num_orden);			setXml(xmlDatos,"document","k_tipo_ope",tip_ope);			setXml(xmlDatos,"document","k_tipo_opc",tip_opc);								cmdQuery="select * from keplersc.ser_cierra_abre_ord_cargos_tots_refs('"& getXmlStr(xmlDatos,"EOF:13_10") &"')";			frn.lib("libGeneral.kpl","FileSave",xmlDatos, fileSavePath & "\cierrabrecargostotsrefsSql");			rstXml(cuboQuery);    //xml general con todos los datos			cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvabrecierraordcargtotsrefs.CerrarOrden()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cierrabrecargostotsrefsSql");						resultado = getXml(cuboQuery,"resultado");			mensaje = getXml(cuboQuery,"mensaje");						ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			if(resultado &= "1") {				if (tip_opc &= "C"){					strmsgopc = "Cerrada";					frn.setAtt("CerrarOrden", "available", "N");				} else{					strmsgopc = "Abierta";					frn.setAtt("AbrirOrden", "available", "N");				}				strMsg = "Orden " & strmsgopc & mensaje;				cargapuntos();				ConfiguraControlesOpcion();  				frn.message(strMsg, "Mensaje", "Aceptar");			} 			else {				frn.message(mensaje, "Error", "Aceptar");			}		}						} 	</script></pag>