					<inp id="k_rfc" clr="64,64,64"  dim="18,1" fnt="Arial,16" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" type="string" nc="16" modify="N" available="N"/>
					<br/>
					<tab/>
					<txt>Datos del cliente :</txt>
					<br/>
