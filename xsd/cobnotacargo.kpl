					<inp id="k_datcve" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="70,5" fnt="Arial,16" type="string" modify="N" available="N" nc="300"/>
				</grp>
			</grp>	
			<br/>
	
		</grp>
		<br/><br/>
	<tab/>	
	<grp  bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="0" clrBrdr="0,58,112" dim="95,35,7,10" brdr="1,5"  fnt="Arial,16"><tab/><br/>
	<tab n="1"/>	<tbl id="k_mov" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="130,7"  hk="z" OnChange="" Reorder="N" modify="Y" available="Y">
		<col id="k_parte" name="Producto" OnF9="select_cargo()" OnChange="insert_cargo()" type="capital"/>
		<col id="k_descr" name="Descripci&#243;n" modify="N"/>
		<col id="k_q" name="Cantidad"  type="number"  modify="N" nd="-1" min="0"/>
		<col id="k_unidad" name="Unidad" modify="N" type="capital"/>
		<col id="k_precio" name="Precio Unitario"  type="number"  modify="N" nd="2" visible="Y"/>
		<col id="k_monto" name="Importe"  type="number" nd="2" min="0" OnChange="Monto()"/>
	</tbl><br/>
	
		<grp dim="70,8,7,10" fnt="Arial,16" hSpace="4"><tab n="1"/><txt clr="0,58,112">Plazo</txt><tab n="5"/>
				<inp id="k_plazo" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nd="0" nc="4" min="0" OnChange="Plazo()"  available="Y" modify="Y"/>
				<br/><tab n="1"/><txt clr="0,58,112" fnt="Arial,16">Fecha de Pago</txt><tab n="2"/>
				<edt id="k_vence" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" page="_ks_fecha,k_vence" OnF9="Dialog(3,_ks_fecha,k_vence)" available="N" modify="N"/><br/>
			
				<tab n="1"/><txt clr="0,58,112">Condiciones</txt><tab n="3"/>
				<inp id="k_cond" clr="64,64,64" clrBrdr="255,255,255"  dim="39,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="33" modify="N"/>
				<br/>
			
		</grp><tab n="5"/>
		<grp dim="40,8,7,10" fnt="Arial,16" hSpace="4">
				<txt>Subtotal</txt><tab n="2"/>
				<inp id="subt" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" available="N"/>
				<br/>
				<txt>IVA</txt><tab n="3"/>
				<inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="6" modify="N" available="N"/><br/><txt fnt=",16b">IMPORTE</txt><tab/>
				<inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="N"/>
		</grp>		
		<br/>
		<grp dim="70,15,7,10" fnt="Arial,16" hSpace="4"><tab/>
				<txt clr="0,58,112">Metodo de Pago</txt><tab n="2"/>
				<inp id="k_m_pago" clr="64,64,64" clrBrdr="255,255,255" nc="3" dim="10,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="text"   available="N" modify="N"/>
				<br/>
				<tab/><txt clr="0,58,112">Forma de Pago</txt><tab n="2"/>	
				<cmb id="k_f_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="20,40" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N"  modify="Y"/>		
				<br/>
				<tab/><txt clr="0,58,112">Cuenta</txt><tab n="4"/>
				<inp id="k_cuenta" clr="64,64,64" clrBrdr="255,255,255" nc="50" dim="40,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="text"  modify="Y" available="Y"/>
				<br/>
				<tab/><txt clr="0,58,112">Uso del CFDI</txt><tab n="3"/>
				<inp id="k_cfdi" clr="64,64,64"  dim="60,1" fnt="Arial,16" nc="4" type="text"   modify="N" clrBrdr="255,255,255" brdr="2,0" bclr="255,255,255"/>
				<br/>
				<tab/><txt clr="0,58,112">Correo Electronico</txt><tab/>
				<inp id="k_correo" clr="64,64,64"  dim="60,1" fnt="Arial,16" type="string" modify="N" clrBrdr="255,255,255"  brdr="2,0" bclr="255,255,255"/>
			
		</grp>
		
		<tab/>
		<grp dim="70,15,7,10" fnt="Arial,16" hSpace="4">
			<txt clr="0,58,112">Comentarios</txt>
			<br/>
			<inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="60,3" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" type="string" available="Y"/>
			<br/><tab n="13"/>
			<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/><tab/>
			<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Alta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><tab/>
		</grp>
	
	</grp>
		



</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,kdb, sys, rep;
			var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, anio_contable,limite_credito ,usuario,suc_usuario, perfil_usuario,asterisco,calle_cli,colonia_cli,poblacion_cli,codigo_p_cli;
			var especificaciones_doc, estatus_doc ;
			var monto_total,uen;
			var folio, sucursal_id , cmdQuery  ;
			fun Main() {
				frn=new FRNT;
				kdb=new KDB;
				kdb.connect();
				sys=new SYS;
				rep=new REP;
			
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				perfil_usuario = frn.lib("libKepler","UserInfo(2)");
				asterisco = "*";
				
				if(frn.param(0)&= "")
				{
					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");
					frn.open("redirect",2);
					return;
				}
					
				gen_doc=trim(frn.param(0)); 
				nat_doc=trim(frn.param(1)); 
				gpo_doc=trim(frn.param(2));
				tip_doc=trim(frn.param(3));
				tip_ope=trim(frn.param(4));
				uen=trim(frn.param(5));
				
				if (uen &= ""){
					uen="XXX";
				}
				ctrls_off();
				Inicializa();
							
			}

		
			fun Inicializa(){
				kdb.kde("KDE");//								Configuraciï¿½n del servidor
				kdb.exec();
				anio_contable = kdb.get("KDE","14");
			//MSS----------------------
				usuario = frn.config("user","name");
			//-------------------------
		
				var cmd, cubo, ok,resValidacion,resMensaje ;

							
				frn.set("k_vence",sys.date());				
				frn.set("k_hora",sys.time());	
			
				//Llenar combo sucursales
				
				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";	
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Inicializa()");
				
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					var mensajeError = getXmlAtt(cubo,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				frn.set("k_sucn",getXml(cubo));
				//Llenar combo tipo docto
				cmd = "select '[' || c4 || '] ' || c5 as c5,c1,c2,c3,c4 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;				
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Inicializa()");				
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					var mensajeError = getXmlAtt(cubo,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				frn.set("k_tipon",getXml(cubo));					
				tip_doc=1;
				folio = "0000000";
			
				especificaciones_doc =  gen_doc & nat_doc & gpo_doc & 0 & tip_doc & "-" & folio  ;				
				frn.set("k_docto",especificaciones_doc);				
				//Llenar combo tipo de precio
				cmd = "select c2,c1 from keplersc.kdicatprecio";				
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Inicializa()");				
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					var mensajeError = getXmlAtt(cubo,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				frn.set("datcfdi","N");		//Pantalla validacion CFDI
				
				//Llenar combo forma de pago
				cmd = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdf3fp";				
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Inicializa()");				
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					var mensajeError = getXmlAtt(cubo,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}				
				frn.set("k_f_pago",getXml(cubo));	
				if (tip_ope &= "A"){
					fecha_config();
				}
			}
			
			
			fun ctrls_off() {

				frn.setAtt("foliotxt", "visible", "N" );
				frn.setAtt("k_folio", "visible", "N" );
				frn.setAtt("k_buscar_folio", "visible", "N" );
				frn.setAtt("Aceptar", "visible", "N" );
				frn.setAtt("Cancelar", "visible", "N" );
				frn.setAtt("k_mov", "modify", "N" );
				frn.setAtt("k_clave","modify", "N");
				frn.setAtt("k_rfc","modify", "N");
				
				frn.setAtt("k_plazo","modify", "N");
				frn.setAtt("k_f_pago","modify", "N");
				frn.setAtt("k_cuenta","modify", "N");		
			
				var cond="Pago de contado";
				frn.set("k_cond",cond);
					
				frn.setAtt("k_coment","modify", "N");

				
				if (tip_ope &= "A"){
					botones_alta();
				}else{
					botones_consulta();
				}
				Plazo();			
			}
	
			fun botones_alta(){
			
					frn.set("operacion","ALTA");
					frn.setAtt("Aceptar", "visible", "Y" );
					frn.setAtt("Cancelar", "visible", "Y" );
					frn.setAtt("k_mov", "modify", "Y" );
					frn.setAtt("k_clave","modify", "Y");
					
					frn.setAtt("k_plazo","modify", "Y");
					frn.setAtt("k_f_pago","modify", "Y");
					frn.setAtt("k_cuenta","modify", "Y");		
	
					frn.setAtt("k_coment","modify", "Y");
					
			}
			
			fun botones_consulta(){
			
				frn.set("operacion","CONSULTA");
				frn.setAtt("foliotxt", "visible", "Y" );
				frn.setAtt("k_buscar_folio", "visible", "Y" );
				frn.setAtt("k_folio", "visible", "Y" );				
			}	
		
			
		
		
			fun BorraDatos() {
				frn.rst("k_clave");
				frn.rst("k_mov");
			
				frn.rst("k_monto");
				frn.rst("k_datcve");
				frn.rst("k_coment");
				frn.rst("k_rfc");
				frn.set("datcfdi","N");		//Pantalla validacion CFDI

				frn.rst("k_vence");
				frn.rst("subt");
				frn.rst("k_iva");
				frn.rst("k_monto");
				frn.set("k_plazo", 0);
				frn.set("k_correo");
				frn.set("k_m_pago", "PUE");
				frn.rst("k_cfdi");
				frn.rst("k_cuenta");		
				frn.set("k_f_pago", "[01] EFECTIVO");				
			
			}
			

		
			//-----------------------------------CLIENTE---------------------------------
			fun Datos_cliente(){			
				var clave_cli = frn.get("k_clave");
				var cmd,ok,cubo;
				
				
				cmd = "select c3,c4,c5,c6,c10,c11,c15,c27,c52,c53 from keplersc.kdud where c2='" & clave_cli & "'";
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Datos_cliente()");			
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					var mensajeError = getXmlAtt(cubo,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");				
				var len_result = nXml(cubo);				
				if (len_result == 0){
					frn.message("Cliente no existe","Error","Aceptar");
					frn.rst("k_clave");
					frn.rst("k_datcve");
					frn.rst("k_rfc");
					frn.rst("k_correo");					
					frn.set("k_m_pago","PUE");
					frn.rst("k_cfdi");
					return;
				}
				
				limite_credito = getXmlAtt(cubo,"r0", "c15");				
				var nombre = getXmlAtt(cubo,"r0", "c3");
				calle_cli= getXmlAtt(cubo,"r0", "c4");
				colonia_cli= getXmlAtt(cubo,"r0", "c5");
				poblacion_cli= getXmlAtt(cubo,"r0", "c6");
				var rfc = getXmlAtt(cubo,"r0", "c10");
				var correo = getXmlAtt(cubo,"r0", "c11");
				codigo_p_cli = getXmlAtt(cubo,"r0", "c27");
				var m_pago= getXmlAtt(cubo,"r0", "c52");			
				
				if (m_pago &= "PPD"){
					frn.set("k_f_pago","[99] POR DEFINIR");
				};
				
				var uso_cfdi= getXmlAtt(cubo,"r0", "c53");
				
				frn.setM("k_datcve",nombre ,calle_cli,colonia_cli,poblacion_cli,codigo_p_cli);
				frn.set("k_rfc", rfc );
				frn.set("k_correo", correo);
				frn.set("k_m_pago", m_pago);
				frn.set("k_cfdi", uso_cfdi);
			
			}
			
			//------------------------------------------GRID-----------------------------------
			
			fun select_cargo(){
		
				frn.setX("", "k_mov", -1, "k_parte");
				frn.setX("", "k_mov", -1, "k_descr");
				frn.setX("", "k_mov", -1, "k_q");
				frn.setX("", "k_mov", -1, "k_unidad");
					
				var cmdSel = "select c1 as clave_cargo, c3 as descripcion, c2 as clave_sat  from keplersc.kdncargocat" ;
            frn.dialog("genlistasel","Catalogo de Cargos",cmdSel ,"clave_cargo","k_mov","", "k_parte","N");
     
			}
			
		
			fun insert_cargo() {

            var clave_cargo  = frn.get("k_mov", -1, "k_parte");
         
				var cmd = "select c3,c4 from keplersc.kdncargocat where c1='" & clave_cargo & "'";
				var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cobnotacargo.insert_cargo()");			
				var ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					var mensajeError = getXmlAtt(cubo,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");				
				var len_result = nXml(cubo);				
				if (len_result == 0){
					frn.message("El producto no se encuentra en el catalogo de cargos","Error","Aceptar");
					frn.setX("", "k_mov", -1, "k_parte");
					frn.setX("", "k_mov", -1, "k_descr");
					frn.setX("", "k_mov", -1, "k_q");
					frn.setX("", "k_mov", -1, "k_unidad");
					
					return;
				}
			
            frn.setX(getXmlAtt(cubo,"r0", "c3") , "k_mov", -1, "k_descr");
            frn.setX(1, "k_mov", -1, "k_q");
            frn.setX(getXmlAtt(cubo,"r0", "c4"), "k_mov", -1, "k_unidad");
			}

		
			fun Monto(){
			
				var monto= frn.get("k_mov", -1, "k_monto");
				frn.setX(1, "k_mov", -1, "k_q");
				var cantidad= frn.get("k_mov", -1, "k_q");
				var precio;
				
				if (cantidad != 0){
					precio=  monto/cantidad;
				}				
				frn.setX(precio,"k_mov",-1,"k_precio");				
				CalcTotalImporte();
			}
			
			
			
			fun CalcTotalImporte(){
			
				monto_total = 0;
		
				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {
					monto_total  += frn.get("k_mov", i, "k_monto");
				}
				
				frn.set("subt", monto_total);
				var importe_iva = monto_total * 0.16;
				frn.set("k_iva", importe_iva );
				monto_total += importe_iva ;
				frn.set("k_monto",monto_total);		
			}
		

			//-------------------------------------------ALTA----------------------------------
			fun Alta(){			
			
				var xmlRequest;
				
				var resultado, mensaje, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd, continua;
				var partidasValidas = 0;
				
				var resultado_validaciones = Validaciones_pre_ejecucion();
				
				if (resultado_validaciones == 0 ){
					return;
				}
				
				//Pantalla validacion CFDI
				if (frn.get("datcfdi") &= "N"){
					frn.dialog("icfdreview",frn.get("k_sucn",-1,1),frn.get("k_clave"),"Alta","cmb",frn.get("k_f_pago",-1,1),frn.get("k_cuenta"),frn.get("k_m_pago"), "inp", frn.get("k_cfdi"));
					return;
				}	

				continua = frn.message("¿Desea continuar con la alta de la factura?","Atención",2);
				if (continua == 0){
					frn.set("datcfdi","N");	//Pantalla validacion CFDI
					return;
				}
	
				xmlRequest = frn.dataPag();
	
				fecha = sys.date();
				hora= sys.time();
				//cubo = "dat";
				kdb.rst();
				frn.rst("results");
				frn.rst(xmlRequest );
				strFecha = fnDate("year",fecha) & "-";
				strTmp = fnDate("month",fecha);
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp & "-";
				strTmp = fnDate("day",fecha);
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp;
				
				xmlRequest = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
				//Agregar usuario, fechay hora de movimiento
				setXml(xmlRequest ,"movimiento","usuario",frn.lib("libKepler","UserInfo"));
				setXml(xmlRequest ,"movimiento","fecha",strFecha);
				setXml(xmlRequest ,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));
				setXml(xmlRequest ,"k_mov","no_partidas",frn.N("k_mov")-1);
				setXml(xmlRequest ,"ambiente","anio_contable",anio_contable);
				setXml(xmlRequest,"ambiente","uen",uen);

				frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");
				
				cmd="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";
				kdb.rst(cubo);
				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"venfactdirecta.Alta");				

				resultado= getXml(cubo,"resultado");
				mensaje= getXml(cubo,"mensaje");
				
				if(resultado &= "1"){
					tip_ope = "C";
					ctrls_off();	
					frn.set("k_folio",mensaje); 
					
					strTmp = frn.get("k_docto");
					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;
					frn.set("k_docto",strTmp);
					//ConfiguraCamposOpcion();
					//Deshabilita_campos();					
					mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;
					frn.message(mensaje, "Mensaje","&Aceptar");
				}else{
					frn.message(mensaje, "Error","&Aceptar");
					frn.set("datcfdi","N");	//Pantalla validacion CFDI

				}	
			}
		
		
		   fun Validaciones_pre_ejecucion(){
		   
				var resultado, mensaje, cubo,fecha, hora, cmd;
							
				var num_partes = frn.N("k_mov")-1;
				if (frn.get("k_plazo")!=0){  
					if (limite_credito < monto_total){
						frn.message("El Cliente sobrepasa su limite de credito","Error","Aceptar");
						return 0;

					}
				}
				
				//Validar fecha
				kdb.rst();
				frn.rst("results");				
				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));
				cmd= "select * from keplersc.verify_year('" & fecha & "')";
				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"venfactdirecta.Validaciones_pre_ejecucion()");			
				resultado= getXml(cubo,"validacion","resultado");
				mensaje = getXml(cubo,"validacion","mensaje");
				if(mensaje &! ""){
					frn.message(mensaje,"Error al generar el documento","Aceptar");
				}
					
				if(resultado &= "0"){
					frn.setPos("k_fecha");
					return 0;
				}		
				
				//Validar clave del Cliente
				if(strlen(trim(frn.get("k_clave")))==0){ 
					frn.message("Es necesario especificar la clave del Cliente","Error","&Aceptar");
					frn.setPos("k_clave");return 0;	
				}				
				
				if(calle_cli &= ""){ 
					frn.message("Es necesario especificar la calle del Cliente","Error","&Aceptar");
					return 0;
				}
				
				if(colonia_cli&= ""){ 
					frn.message("Es necesario especificar la colonia del Cliente","Error","&Aceptar");
					return 0;
				}
				
				if(poblacion_cli&= ""){ 
					frn.message("Es necesario especificar la poblacion del Cliente","Error","&Aceptar");
					return 0;
				}
				
				
				if(codigo_p_cli&= ""){ 
					frn.message("Es necesario especificar el codigo postal del Cliente","Error","&Aceptar");
					return 0;
				}
				
			
				var str = frn.get("k_rfc");

//				var valida_rfc = frn.lib("libGeneral.kpl","valida_rfc",str);
//				if (valida_rfc==0){
//					frn.message("RFC"& str & " NO valido","error","aceptar");
//					return 0;
//				}

				//Validar productos
				for(var i =0;i<frn.N("k_mov");i++){
					if(frn.get("k_mov",i,"k_parte")&!"" || frn.get("k_mov",i,"k_q")&!""){
						if(frn.get("k_mov",i,"k_q")<=0 || strlen(frn.get("k_mov",i,"k_q"))==0){
							frn.message("Se ha generado el siguiente error: producto con cantidad 0","Error al generar el documento","Aceptar");
							frn.setPos("k_mov","ren:"&i);
							return 0;
						}
						if(frn.get("k_mov",i,"k_parte")&=""){
							frn.message("Se ha generado el siguiente error: clave de producto vacia","Error al generar el documento","Aceptar");
							frn.setPos("k_mov","ren:"&i);
							return 0;
						}
						if(frn.get("k_mov",i,"k_unidad")&=""){
							frn.message("Se ha generado el siguiente error: unidad de producto vacia","Error al generar el documento","Aceptar");
							frn.setPos("k_mov","ren:"&i);
							return 0;
						}
						if(frn.get("k_mov",i,"k_precio")&="" || frn.get("k_mov",i,"k_precio")&="0"){
							frn.message("Se ha generado el siguiente error: precio de producto cero","Error al generar el documento","Aceptar");
							frn.setPos("k_mov","ren:"&i);
							return 0;
						}	
					}
				}							
				if( frn.get("k_monto") <= 0 ){
					frn.message("No se puede dar de alta el documento ya que el importe es cero","Error","&Aceptar");return 0;
				}				
				return 1;
			}
			
			

			//------------------------------------------------------CONSULTA----------------------------------------
			
			
			fun ObtenerFolio() {

				sucursal_id = frn.get("k_sucn",-1,1);
				cmdQuery = "select c6 as folio, substring(cast(c9 as VARCHAR),1,10) as fecha, c10 as cve_cliente, " &
						" c16 as monto, c43 estatus " &
						"from keplersc.kdm1 " &
						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc & " order by c6 desc ";
				frn.dialog("genlistafiltrosel","Documentos",cmdQuery,"folio","k_folio","0","","S");
			
			}
			
			
			
			fun Formar_folio(){
				var xmlReqEst, cubofol, cmd, ok, mensajeError ;
				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));
				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));
				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));
				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));
				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));
				setXml(xmlReqEst,"document","uen",uen);
				
				cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";
				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");
				var resultado =getXmlAtt(cubofol,"r0", "resultado");
				if(resultado &= "0"){
					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				var fol = getXmlAtt(cubofol,"r0", "mensaje");
				frn.set("k_folio", fol);
			}
			
			
			
			fun Buscar_folio() {
			
				BorraDatos();			 
				var cmd, cubo,ok, xmlRequest;
				var mensaje = "Folio no encontrado" ;				
				var suc_id =  frn.get("k_sucn",-1,1);
				folio = frn.get("k_folio");				
				TipoMov();
		
				cmd = "select c8,c9,c10,c11,c12,c13 from keplersc.kdm2 where c1='" & suc_id & "' and c2= '" & gen_doc & "' and c3= '" & nat_doc & "' and c4='" & gpo_doc & "' and c5= '" & tip_doc & "' and c6 =upper('" & folio & "')";
		
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Buscar_folio()");
				
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					var mensajeError = getXmlAtt(cubo,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");
				
				var lenght_xml = nXml(cubo); 
				
				if(lenght_xml != 0 ){
				
					for (var i=0;i<lenght_xml;i++) {
			
						var clave_prod =getXmlAtt(cubo,"r"&i,"c8");
						var descripcion =getXmlAtt(cubo,"r"&i,"c10");
						var cantidad=getXmlAtt(cubo,"r"&i,"c9");
						var unidad =getXmlAtt(cubo,"r"&i,"c11");
						var precio_unitario =getXmlAtt(cubo,"r"&i,"c12");
						var importe_partida=getXmlAtt(cubo,"r"&i,"c13");
					
						frn.setX(clave_prod ,"k_mov",i,"k_parte");
						frn.setX(descripcion ,"k_mov",i,"k_descr");
						frn.setX(cantidad,"k_mov",i,"k_q");
						frn.setX(unidad ,"k_mov",i,"k_unidad");
						frn.setX(precio_unitario ,"k_mov",i,"k_precio");
						frn.setX(importe_partida,"k_mov",i,"k_monto");
				
					}
					
					var campos ="'['||kfp.c1||'] '||kfp.c2 as forma_pago,k1.c9,k1.c10,k1.c11,k1.c12,k1.c14,k1.c16,k1.c17,k1.c18,k1.c22,k1.c24,k1.c30,k1.c32,k1.c33,k1.c34,k1.c35,k1.c133,k1.c161,k1.c162,k1.c163,k1.c164,k1.c165,k1.c43 "
																																																		
					cmd = "select " & campos & " from keplersc.kdm1 as k1 inner join keplersc.kdf3fp as kfp on k1.c160=kfp.c1 where k1.c1='" & suc_id & "' and k1.c2= '" & gen_doc & "' and k1.c3= '" & nat_doc & "' and k1.c4='" & gpo_doc & "' and k1.c5= '" & tip_doc & "' and k1.c6=upper('" & folio & "')";

					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Buscar_folio()");
				
					ok=getXmlAtt(cubo,"ok");
					if(ok &! "" && !ok){
						var mensajeError = getXmlAtt(cubo,"native3");
						frn.message(mensajeError,"Error","Aceptar");
						return;
					}
				
					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");
				
					lenght_xml = nXml(cubo); 
					
					if(lenght_xml != 0 ){
					
						frn.set("k_fecha",getXmlAtt(cubo,"r"&0,"c9"));						
						frn.set("k_clave",getXmlAtt(cubo,"r"&0,"c10"));
									
						frn.set("k_rfc",getXmlAtt(cubo,"r"&0,"c22"));

						frn.set("k_plazo",getXmlAtt(cubo,"r"&0,"c17"));
						frn.set("k_vence",getXmlAtt(cubo,"r"&0,"c18"));
						frn.set("k_cond",getXmlAtt(cubo,"r"&0,"c30"));
						
						var IVA = getXmlAtt(cubo,"r"&0,"c14");						
						var MONTO = getXmlAtt(cubo,"r"&0,"c16");						
						frn.set("k_iva",IVA );
						frn.set("subt",MONTO - IVA);						
						frn.set("k_monto",MONTO );						
						frn.set("k_coment",getXmlAtt(cubo,"r"&0,"c24"));					
						
						var nombre = getXmlAtt(cubo,"r"&0,"c32");
						var calle= getXmlAtt(cubo,"r"&0,"c33");
						var colonia= getXmlAtt(cubo,"r"&0,"c34");
						var poblacion= getXmlAtt(cubo,"r"&0,"c35");
						var codigo_p= getXmlAtt(cubo,"r"&0,"c163");
								
						frn.setM("k_datcve",nombre ,calle,colonia,poblacion,codigo_p);
	
						frn.set("k_correo", getXmlAtt(cubo,"r"&0,"c165"));
						frn.set("k_m_pago", getXmlAtt(cubo,"r"&0,"c162"));
						frn.set("k_cfdi", getXmlAtt(cubo,"r"&0,"c164"));
						frn.set("k_cuenta", getXmlAtt(cubo,"r"&0,"c161"));
						frn.set("k_f_pago",getXmlAtt(cubo,"r"&0,"forma_pago"));
						
						estatus_doc = getXmlAtt(cubo,"r"&0,"c161");
						
						if (estatus_doc &= "C"){	// C=Cancelado
							frn.message("El Documento se encuentra cancelado","Error","Aceptar");
							frn.set("statusdoc", "CANCELADO");
						}else{
							frn.set("statusdoc", "");
						}
						
				
					}else {
					
						frn.message(mensaje ,"Error","Aceptar");
					}
					
				}else  {
					frn.message(mensaje ,"Error","Aceptar");
				
				}
			}
			
			//----------------------------------------------------EXTRAS---------------------------------------------------------------
			
			fun TipoMov(){
				tip_doc=frn.get("k_tipon",-1,4);		
				especificaciones_doc = gen_doc & nat_doc & gpo_doc & 0 & tip_doc & "-" & folio ;
				frn.set("k_docto",especificaciones_doc );
				
				if (tip_ope &= "A"){
					Valida_Tipo_Docto();
				}
				ctrls_off();
			}
				
			fun fecha_config(){
				//validar k_fecha
				//se basa en k75 SUB CFD_FOLIO
				
				var cmd, cubo, ok;
				sucursal_id=frn.get("k_sucn",-1,1);
				cmd = "select C4 from keplersc.kdcfdconfig where c1='" & sucursal_id & "'";	
				
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.fecha_config()");
			
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					var mensajeError = getXmlAtt(cubo,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				var fec = getXmlAtt(cubo,"r0", "c4");
			
				if (fec  &= "1"){
					frn.set("k_fecha",sys.date(sys.date("year"),sys.date("month")-1,31));
				}else{
					frn.set("k_fecha",sys.date());
				}
				Fecha();
			
			}
			
			fun Fecha(){//Verifica que la fecha del documento sea correcta. 
				var cubo, cmd, resValidacion, resMensaje, fecha;
				var validDate=frn.lib("libKepler","ValidOpDate",frn.get("k_fecha"));
				
				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));
				
				Plazo();

				if (tip_ope &= "A" ){

					cmd= "select * from keplersc.verify_year('" & fecha & "')";
					cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"venfactdirecta.Fecha()");
					resValidacion= getXml(cubo,"validacion","resultado");
					resMensaje = getXml(cubo,"validacion","mensaje");
					if(resMensaje &! ""){
						frn.message(resMensaje, "Mensaje","&Aceptar");
					}
						
					if(resValidacion &= "0"){
						frn.setPos("k_fecha");
						return;
					}					
				}
			}
			
			
			fun Plazo(){ //Calcula la fecha de pago, y las condiciones de pago en base al plazo
				valida_plazo();
				var f = frn.get("k_fecha");
				frn.set("k_vence",fnDate("addC",frn.get("k_fecha"),frn.get("k_plazo")));//Suma dï¿½as comerciales
				var cond=frn.get("k_plazo") & " dias fecha factura";
				if (frn.get("k_plazo")==0) cond="Pago de contado";
				frn.set("k_cond",cond);
				
			}
			
			fun valida_plazo(){
				var cliente = frn.get("k_clave");
				var cmd = "select case  when c16='' then '0' else c16 end plazo from keplersc.kdud where c2 = '"& cliente &"'";
				var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.kpl.valida_plazo()");
				var plazo_cliente = getXmlAtt(cubo,"r0","plazo");
				var plazo_formulario = frn.get("k_plazo");
				if (plazo_formulario > plazo_cliente){
					frn.message("El plazo ingresado "& plazo_formulario & " no puede ser mayor al del catalogo de clientes " & plazo_cliente,"error","aceptar");
					frn.setPos("k_plazo");
					frn.set("k_plazo","0");
				}
				
			}
		
			fun Valida_Tipo_Docto(){
				var resValidacion, resMensaje, cubo, cmd, ok;			
				//Valida documento vigente
				kdb.rst();
				cmd= "select * from keplersc.verify_valid_document('" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & frn.get("k_tipon",-1,4) & ")"; //genero text, naturaleza text, grupo integer, tipo_movto integer
				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"venfactdirecta.Valida_Tipo_Docto()");
				resValidacion= getXml(cubo,"validacion","resultado");
				resMensaje = getXml(cubo,"validacion","mensaje");
				if(resMensaje &! ""){
					frn.message(resMensaje, "Mensaje","&Aceptar");
					frn.setPos("k_tipon");
				}
							
			}
			
			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){
				/*iModo: 0)No hace mayor validaciï¿½n. Siempre despliega la ventana. NO CONCATENA PREFIJO
							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaciï¿½n. Siempre despliega la ventana
							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)
							3)Modo especial para pï¿½ginas de operacion:Solo si se estï¿½ en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje
				*/
				var prefix=frn.lib("libKepler","langPrefix");
				var page=prefix&pag;
				var b_valido=1;
				if(iModo==0)page=pag;
				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverï¿½ el resultado.
					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;
				}
				//else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;
				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);
			}			
		}
	</script>
</pag>