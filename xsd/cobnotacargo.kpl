<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,10" bclr="192,205,213" unfont="0"	OnF1="Dialog(1,invEntSalAyu)" clrBrdr="0,97,181" tit=""><br/>
	
<tab/><txt fnt=",22" clr="0,0,0">Nota de Cargo</txt><br/><tab/><hLine clr="0,0,0"/><br/><tab n="2"/>
		<br/>
		<tab/>
	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="50,11,7,12" tit="Datos generales"  fnt="Arial,16"><tab/>
