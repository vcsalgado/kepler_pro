	   <txt clr="0,58,112">Tipo docto</txt><tab n="1"/>
		<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255"  dim="30,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="TipoMov()" OnEnter="TipoMov()"/><br/>
		<inp id="tipo_movto" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N" visible="N"/>
		<br/><sp n="1"/> 
		<tab n="4"/><inp id="statusdoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/>					<sp/><inp id="datcfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="3,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="1" modify="Y" available="Y" visible="N"/>

		
	
	</grp><tab/>
	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="44,12,7,12" tit="Documento" fnt="Arial,16">
		<tab n="3"/><inp id="operacion" clr="64,64,64"  dim="18,1" brdr="0,1" fnt=",18bs" available="N" type="string"/><br/><tab/>
		<txt id="foliotxt"  visible="N" hk="F" clr="0,58,112" fnt="Arial,16">Folio</txt><tab/>
		<edt id="k_folio" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" visible="N" hk="F" type="text"  OnChange="Formar_folio()"  OnF9="ObtenerFolio()" OnButton="ObtenerFolio()"  nc="10"/><br/><tab/>
		<inp id="k_docto" clr="64,64,64"  dim="18,1" brdr="0,1" fnt="Arial,16" available="N" link="k_tipon,5" type="string"/><br/><tab/><txt clr="0,58,112" fnt="Arial,16">Fecha</txt><tab/>
		<edt id="k_fecha" dim="14,1" fmt="DD/MM/CCYY"  clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" modify="N"/><br/><tab/> 
