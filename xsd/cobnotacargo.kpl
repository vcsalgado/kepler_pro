		<inp id="statusdoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/>
	
	</grp><br/><br/>
	<tab/>
		<grp id="grpDetalle" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5" dim="95,16,7,10" tit="Detalle"  fnt="Arial,16" available="Y" modify="Y">
			<grp dim="130,12,7,12" brdr="0,0" hSpace="4"><tab/>
				<grp dim="39,11,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">
					<sp/><txt clr="0,58,112" hk="P">Cliente :</txt><tab n="4"/>
					<inp id="k_clave" clr="64,64,64" clrBrdr="255,255,255" OnChange="Datos_cliente()" tooltip="Seleccionar F9,Nuevo F10,Modificar F11"   OnF9="Dialog(3,cat_cli_view,s,k_clave)" OnF10="Dialog(3,cat_cli_crud,Nuevo,x,s,k_clave)" OnF11="Dialog(3,cat_cli_crud,Modificar,x,s,k_clave)" dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="10" available = "Y" modify="Y"/>
					<br/>
				
				</grp><tab/>
