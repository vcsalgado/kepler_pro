<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,12" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><txt fnt=",23" clr="0,0,0">Alta Compra Vehiculo Usado</txt><br/>	<!-- dim="81,0" --> 	<hLine dim="88,0"/> 	<br/> <br/>		<!-- <grp dim="46,9,7,12" -->		<grp dim="50,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,17" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">			<txt>  Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>			<br/>			<!-- <br/> -->			<txt>  Tipo :        </txt>			<cmb id="k_tipon" dim="52,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo() "/>			<br/>			<txt>  Fecha : </txt> <sp n="3"/> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N"/> 						<sp n="7"/>			<inp id="k_st" dim="25,1" bclr="240,240,240" clr="251,18,34" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="N" fnt=",16b" just="C"/>						<sp n="1"/> 		</grp>				<!-- <sp/> -->				<!-- dim="34,9,7,12" -->		<grp dim="38,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,17" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle Documento">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="Y" fnt=",18b" just="C"/><tab/> <br/>			<txt id="textFolio" visible="N">  Folio :  </txt>			<!-- OnButton="ObtenerFolios_DEVs()" -->			<!-- OnF9="ObtenerFolios_DEVs()" -->			<!-- OnChange="BuscarFolio()" -->			<!-- OnF9="Get_Cat(1)" -->			<!-- OnButton="Get_Cat(1)" -->			<!-- OnChange="Formar_folio()" -->			<edt id="k_folio" dim="33,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" visible="N" OnF9="ObtenerFolio()" OnButton="ObtenerFolio()" OnChange="Formar_folio()"/> <br/>			<sp n="1"/>			<inp id="k_docto" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="Y" fnt=",16b" just="C"/> 				<sp n="3"/>			<!-- Folio() -->			<!-- id="buscar" -->			<img id="BuscarFol" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="BuscarFolio()" available="N" clrBrdr="0,0,0" visible="N"/>			<br/>				<!-- <txt>  Fecha : </txt> <sp n="1"/> -->			<!-- <edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="Y"/>  -->			<!-- <sp n="1"/> -->					<!-- <txt>  Hora : </txt> --> 			<!-- <sp n="1"/> -->			<!-- <edt id="k_hora" dim="15,1" type="time" nc="-1" bclr="240,240,240" modify="Y" fmt="HH:MM:SS" available="Y"/> -->						<!-- <br/> -->		</grp>				<!-- <br/> -->		<br/>				<!-- dim="81,14,7,12" -->		<!-- tit="Datos Proveedor" -->		<!-- dim="84,20,7,12" -->		<grp dim="88,33,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,17" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<!-- <br/> --> 			<txt id="textFolio_ref" visible="Y">  Folio Compra :  </txt>			<edt id="k_folio_ref" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" visible="Y" OnButton="Get_Cat(4)" OnF9="Get_Cat(4)" OnChange="BuscarFolioRef()"/> 			<br/>						<sp n="1"/> <txt>Inventario : </txt> <sp n="1"/>			<!-- OnChange="Valida_Invent(1)" -->			<inp id="k_claveinv" dim="12,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" visible="Y" nc="10" OnF9="Get_Cat(2)" OnChange="Get_Cat_Data(2,2)" OnF10="Open_Kdinf()" bclr="255,255,255"/>			<sp n="3"/> <txt clr="32,32,32" fnt=",b">[F10] Editar Datos de la Unidad (Inventario Valido) </txt>			<!-- <sp n="18"/> --> 			<sp n="7"/> <txt>Serie : </txt> 			<sp n="1"/> <inp id="k_serievehiculo" dim="25,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" OnChange="Valida_Serie(1)" OnF10="" nc="20"/> 			<br/>			   <sp n="1"/> <txt>Kilometraje :</txt> 		   <!--<sp n="1"/>--> <inp id="k_kilometraje" dim="20,1" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="Y" available="N" visible="Y" OnChange="Eval_Data_Row()" nc="10" fmt="5" bclr="255,255,255"/>		   		   <!--			<sp n="2"/> <txt>Referencia : </txt>  			<sp n="3"/> <inp id="k_refer" dim="12,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="N" OnF10="" nc="10"/>			-->						<sp n="48"/> <txt>Traspaso S/N : </txt>  			<sp n="1"/> <inp id="k_tipopagos" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" visible="Y" OnChange="Valida_Trsp(1)" nc="1" bclr="255,255,255"/> 			<br/>						<!-- type="capital" -->			<sp n="1"/> <txt>Coach : </txt>			<sp n="4"/> <edt id="k_vendedor" dim="20,1" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" type="string" modify="Y" available="N" OnF9="Get_Cat(5)" OnButton="Get_Cat(5)" OnChange="Get_Cat_Data(5,2)" nc="10"/>			<sp n="10"/> <txt>Asesor : </txt>			<sp n="3"/> <edt id="k_proyecto" dim="18,1" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" type="string" modify="Y" available="N" OnF9="Get_Cat(6)" OnButton="Get_Cat(6)" OnChange="Get_Cat_Data(6,2)" nc="10"/>			<sp n="9"/> <txt>Valuador : </txt>			<sp n="5"/> <edt id="k_subctabanco" dim="18,1" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" type="string" modify="Y" available="N" OnF9="Get_Cat(7)" OnButton="Get_Cat(7)" OnChange="Get_Cat_Data(7,2)" OnChange="Eval_Data_Row()" nc="10"/>						<!-- <br/> -->			<br/>						<grp dim="125,20,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,17" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Proveedor">							<sp n="1"/> <txt fnt=",b">Selecciona UUID / Referencia : </txt>  				<sp n="1"/> <inp id="k_refer" dim="80,1" bclr="255,255,255" brdr="2,0" clrBrdr="255,255,255" type="string" modify="Y" available="N" visible="Y" OnF10="" nc="60"/>					<sp n="2"/>				<!-- OnEnter="ObtenerFactura()" -->				<bot id="Buscar" dim="10" brdr="5" OnEnter="ProcesarFactura()" tooltip="Busca UUID de la factura del proveedor" available="N" visible="N"/>								<br/>								<grp dim="52,17,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">							<!-- <sp n="1"/> <txt clr="0,58,112">Proveedor : </txt><tab/> -->						<!-- OnButton="ObtenerProveedores()" -->				<!-- OnF9="ObtenerProveedores()" -->				<!-- OnChange="BuscarProveedor(0)" -->				<sp n="1"/> <txt clr="0,58,112" hk="P">Proveedor : </txt><tab/>				<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnButton="Get_Cat(3)" OnF9="Get_Cat(3)" OnF10="" OnChange="Get_Cat_Data(3,2)" 					type="capital" nc="7" tooltip="Proveedor ( F9 b&#250;squeda; )" modify="Y" hk="C" available="N"/> 				<sp n="5"/> <inp id="c_dias" clr="64,64,64"  dim="4,1" fnt="Arial,16" type="string" nc="4" modify="N" available="N" visible="N"/>							<br/>							<sp n="1"/> <txt>RFC : </txt> <sp n="5"/>				<inp id="k_rfc" clr="64,64,64"  dim="18,1" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>							<!--				<sp n="9"/> <txt>C.P. : </txt> <sp n="1"/>				<inp id="k_cp" clr="64,64,64"  dim="7,1" fnt="Arial,16" type="string" nc="5" modify="N" available="N"/>				-->							<sp n="3"/> <inp id="c_forzar" clr="64,64,64"  dim="3,1" fnt="Arial,16" type="string" nc="1" modify="N" available="N" visible="N"/>							<br/>								<sp n="1"/> <txt clr="0,58,112" fnt=",b">Datos UUID : </txt><sp n="5"/>				<br/>								<sp n="1"/> <txt clr="0,58,112">Serie : </txt><sp n="1"/>				<inp id="k_uuid_serie" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="20,1" fnt="Arial,16" type="string" nc="30" modify="N" available="N"/>				<br/>				<sp n="1"/> <txt clr="0,58,112">Folio : </txt><sp n="1"/>				<inp id="k_uuid_folio" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="30,1" fnt="Arial,16" type="string" nc="30" modify="N" available="N"/>				<br/>								<sp n="1"/> <txt clr="0,58,112">Total : </txt> <sp n="1"/> 				<inp id="k_uuid_monto" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="17,1" fnt="Arial,16" type="string" nc="18" modify="N" available="N"/>								<sp n="1"/> <txt clr="0,58,112">Impuesto : </txt> <!-- <sp n="1"/> -->				<inp id="k_uuid_impuesto" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="15,1" fnt="Arial,16" type="string" nc="18" modify="N" available="N"/>								<br/>								<sp n="1"/> <txt clr="0,58,112">Ret. IVA : </txt> <!-- <sp n="1"/> -->				<inp id="k_uuid_retiva" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="15,1" fnt="Arial,15" type="string" nc="18" modify="N" available="N"/>				<sp n="2"/> <txt clr="0,58,112">Ret. ISR : </txt> <!-- <sp n="1"/> -->				<inp id="k_uuid_retisr" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="15,1" fnt="Arial,15" type="string" nc="18" modify="N" available="N"/>								<br/>								<!-- dim="20,1" -->				<sp n="1"/> <txt clr="0,58,112">Fecha : </txt> <!-- <sp n="1"/> -->				<inp id="k_uuid_fecha" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="25,1" fnt="Arial,16" type="string" nc="30" modify="N" available="N"/>									</grp>							<sp n="1"/>							<grp dim="71,11,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="1,5" fnt="Arial,16">							<sp n="1"/> <txt fnt=",b">Datos del proveedor : </txt>				<br/>							<sp n="1"/>				<inp id="k_nombreprov" clr="64,64,64" clrBrdr="255,255,255"  dim="69,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_calleprov" clr="64,64,64" clrBrdr="255,255,255"  dim="69,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_coloniaprov" clr="64,64,64" clrBrdr="255,255,255"  dim="69,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_poblacionprov" clr="64,64,64" clrBrdr="255,255,255"  dim="54,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>							<!-- <sp n="9"/> <txt>C.P. : </txt> --> 				<sp n="1"/> <inp id="k_cp" clr="64,64,64"  dim="14,1" fnt="Arial,16" type="string" nc="5" modify="N" available="N"/>							<br/>				<br/>							<sp n="1"/> <txt clr="0,58,112">Plazo :</txt><sp n="1"/>				<inp id="k_plazo" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nd="0" min="0" OnChange="Plazo()" modify="Y" available="N" visible="Y"/>				<sp n="1"/> 				<inp id="k_cond" clr="64,64,64" clrBrdr="255,255,255"  dim="28,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="33" modify="N" available="N" visible="Y"/>				<sp n="2"/> <txt clr="0,58,112">Vencimiento :</txt><sp n="1"/>				<edt id="k_vence" clr="64,64,64"  dim="13,1" brdr="2,0" bclr="255,255,255" type="date" nc="-1" fnt="Arial,0" available="N" fmt="DD/MM/CCYY" page="_ks_fecha,k_vence" OnF9="Dialog(3,_ks_fecha,k_vence)" clrBrdr="255,255,255" visible="Y"/><tab/>					<br/>					</grp> 						</grp>						<br/>						<br/>							<sp n="1"/> <txt>Producto </txt>	<sp n="17"/> <txt>Descripcion </txt> <sp n="69"/> <txt> Importe</txt> 			<br/>				<sp n="1"/> <inp id="c_modelo" dim="18,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>			<sp n="7"/> <inp id="c_descrip" clr="64,64,64" clrBrdr="255,255,255"  dim="65,1" fnt="Arial,16" type="string" modify="Y" available="N" OnChange="" OnF10="" nc="60" visible="Y"/>						<!-- clr="64,64,64"			bclr="255,255,255" 			clrBrdr="255,255,255" -->			<sp n="7"/> <inp id="k_importe" clr="64,64,64" dim="15,1" type="number" modify="Y" available="N" OnChange="CalculaTotales(1)" OnF10="" nc="20" nd="2" just="R"/>						<br/>					</grp>				<!-- <br/> -->		<br/>				<!-- dim="81,18,7,12" --> 		<!-- tit="Totales " -->		<grp dim="88,17,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">			<!-- <br/> -->			<!--			<sp n="1"/> <txt>Plazo : </txt> 			<sp n="5"/> <inp id="k_plazo" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nd="0" min="0" OnChange="Plazo(1)" modify="Y" available="Y" nc="2"/>			<sp n="1"/> <txt>Fecha Pago : </txt> 			<edt id="k_vence" clr="64,64,64"  dim="15,1" brdr="2,0" bclr="255,255,255" type="date" nc="-1" fnt="Arial,0" available="N" fmt="DD/MM/CCYY" page="_ks_fecha,k_vence" OnF9="Dialog(3,_ks_fecha,k_vence)" clrBrdr="255,255,255"/>			-->						<sp n="88"/> <txt>Subtotal : </txt>			<sp n="1"/> <inp id="subt" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/>						<br/>			<!--			<sp n="1"/> <txt clr="0,58,112">Condiciones : </txt>			<sp n="1"/> <inp id="k_cond" clr="64,64,64" clrBrdr="255,255,255"  dim="39,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="33" modify="N" available="N"/>			-->						<!-- clr="64,64,64" -->			<!-- bclr="255,255,255" -->			<sp n="92"/> <txt>IVA : </txt><sp n="1"/> <inp id="k_iva" dim="15,1" clr="64,64,64" fnt="Arial,16" type="number" nd="2" modify="Y" available="N" OnChange="CalculaTotales(1)"/>			<sp n="2"/> <txt>(</txt> <inp id="k_porciva" dim="5,1" bclr="240,240,240" clrBrdr="255,255,255" type="string" modify="N" available="N"/><txt>%)</txt>									<br/>						<!-- <sp n="1"/> <txt clr="0,58,112">Comentarios:</txt> -->					<!-- <sp n="67"/> --> 			<!-- <txt>Holdback : </txt> -->					<sp n="82"/>			<txt fnt=",16" clr="108,34,38">Retenciones ( - ) </txt> <sp n="1"/>			<!-- clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" -->			<inp id="k_sumrets" clr="64,64,64" dim="15,1" fnt=",16" type="number" nd="2" modify="N" available="N"/>			<br/>						<sp n="90"/> 			<!-- Importe : -->			<txt fnt=",16b">Total : </txt>			<sp n="1"/> 			<!-- <inp id="k_montoext4" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="Y" available="Y" OnChange="CalculaTotales(1)"/> --> 			<inp id="k_monto" clr="64,64,64"  dim="15,1" fnt=",16b" type="number" nd="2" modify="N" available="N" clrBrdr="255,255,255"/>  						<br/>			<sp n="1"/> <txt clr="0,58,112">Comentarios:</txt>			<br/> 						<sp n="1"/> <inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="90,1" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="N" type="string" nc="60" bclr="255,255,255"/>			<!-- <sp n="9"/> -->			<!-- <sp n="1"/> --> 				   <br/>		   <sp n="1"/> <inp id="k_coment2" clr="64,64,64" clrBrdr="255,255,255"  dim="90,1" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="N" type="string" nc="60" bclr="255,255,255"/>		   <br/>		   <sp n="1"/> <inp id="k_coment3" clr="64,64,64" clrBrdr="255,255,255"  dim="90,1" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="N" type="string" nc="60" bclr="255,255,255"/>			<br/>			<sp n="1"/> <txt clr="132,20,7">Mensaje :</txt>			<sp n="1"/> <inp id="k_err" dim="113,1" clr="132,20,7" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="140" fnt="Arial,16"/>					   		</grp>				<br/>		<br/>						<sp n="15"/>		<!-- Reporte() -->		<img id="Imprimir" dim="35,35" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Ejecuta_Reporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>					<sp n="25"/>		<img id="Cancelar" dim="35,35" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Cancelar / Limpiar" available="Y" clrBrdr="0,0,0" visible="Y"/>					<sp n="10"/>		<img id="Aceptar" dim="35,35" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>							</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal;			var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, uen;                  var row_grid, err_data, err_empty;         			// Vart Reports			var cmd, xmlResQuery, strTmp;			var sucursal, fech_oper, tipo_auto, xmlPar;   						//Vars Operating UUID SCH ... Added by JMM 20240508 			var str_uuid, fecha_uuid, rfc_uuid, total_uuid;			var nombre_uuid, regimen_uuid, folio_uuid, serie_uuid, NewProvId;			var impuesto_uuid;			/*var paramProvPago, proveedor_pago_id;*/ // N.A. for this option 			//Added by JMM 20240627			var retisr_uuid, retiva_uuid;			      										fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";				fileSavePath = "C:\Basura";				Inicializa();								ConfiguraControlesOpcion();			}			fun Formar_folio(){							var xmlReqEst, cubofol, cmd, ok, mensajeError ;								LimpiaEncabezado(); // Added 221201								limpiar_datos_uuid(); // Added by JMM 20240627				LimpiaTotalesDoc(); // Added by JMM 20240627												setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd = "select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comvhcuscrud.Formar_folio()");				var resultado = getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);							} // FIN ... Formar_folio()									fun ObtenerFolio(){							/*				var cmdQuery;				cmdQuery="select c6 as folio, c9 as fecha, c10 as cliente, c32 as nombre,c11 as factura, c16 as monto " & 					"from keplersc.kdm1 where c1='" & 					frn.get("k_sucn",-1,1) & "' and c2='" & gen_doc & "' and c3='" & nat_doc & "' and c4=" & gpo_doc 					& " and c5=" & frn.get("k_tipon",-1,4);				frn.dialog("genlistafiltrosel","Movimiento a taller",cmdQuery,"folio","k_folio","0","0","N","N");						*/								var suc_id, dato_id;				var win_tit, field_key, field_col, cmdQuery;					//if (imodo == 1) {					if (tip_ope &= "CB") {						win_tit = "Bajas - Compras Autos Usados";						field_key = "folio_baja";						field_col = "k_folio";						cmdQuery = "select tdm1.c10 as cve_proveedor, txd.c3 as nomb_proveedor, tdm1.c6 as folio_baja, tdm1.c9 as fecha " &							", tdm1.c11 as ref_inventario from keplersc.kdm1 as tdm1 " & 							"inner join keplersc.kdxd as txd on txd.c2 = tdm1.c10 " & 							"where tdm1.c2 = 'X' and tdm1.c3 = 'D' and tdm1.c4 = 7 and tdm1.c5 = " & frn.get("k_tipon",-1,4) & " and tdm1.c1 = '" & frn.get("k_sucn",-1,1) & "' " & 							"order by tdm1.c6 desc";						//cmdQuery = cmdQuery & " order by clave_proveedor, folio_compra";					} else { 						if (tip_ope &= "B") {							win_tit = "Compras Autos Usados";							field_key = "folio_compra";							field_col = "k_folio_ref";											cmdQuery = "select tdm1.c10 as cve_proveedor, txd.c3 as nomb_proveedor, tdm1.c6 as folio_compra, tdm1.c9 as fecha " &							", tdm1.c11 as ref_inventario from keplersc.kdm1 as tdm1 " & 							"inner join keplersc.kdxd as txd on txd.c2 = tdm1.c10 " & 							"inner join keplersc.kdinf as inf on inf.c1 = tdm1.c1 and inf.c2 = tdm1.c100 " &							"where tdm1.c2 = 'X' and tdm1.c3 = 'A' and tdm1.c4 = 7 and tdm1.c5 = " & frn.get("k_tipon",-1,4) & " and tdm1.c1 = '" & frn.get("k_sucn",-1,1) & "' " & 							"and inf.c31 = 20 " &							"order by tdm1.c6 desc";										} else { 							win_tit = "Compras Autos Usados";							field_key = "folio_compra";							field_col = "k_folio";							cmdQuery = "select tdm1.c10 as cve_proveedor, txd.c3 as nomb_proveedor, tdm1.c6 as folio_compra, tdm1.c9 as fecha " &								", tdm1.c11 as ref_inventario from keplersc.kdm1 as tdm1 " & 								"inner join keplersc.kdxd as txd on txd.c2 = tdm1.c10 " & 								"where tdm1.c2 = 'X' and tdm1.c3 = 'A' and tdm1.c4 = 7 and tdm1.c5 = " & frn.get("k_tipon",-1,4) & " and tdm1.c1 = '" & frn.get("k_sucn",-1,1) & "' " & 								"order by tdm1.c6 desc";							//cmdQuery = cmdQuery & " order by clave_proveedor, folio_compra";						}			      }				//}								if ( strlen(win_tit) > 0 && strlen(field_key) > 0 && strlen(field_col) > 0 && strlen(cmdQuery) > 0 /*&& strlen(objeto) > 0*/ ) {									//frn.dialog("genlistasel", win_tit,cmdQuery, field_key, "k_mov",-1, field_col,"S");  * * *  USADO EN GRIDS					//frn.dialog("genlistasel","Catálogo de Proveedores",cmdQuery,"k_claveprov","k_clave","0","","N");  * * *  USADO EN CTRLS SIMPLES										//frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");					frn.dialog("genlistafiltrosel", win_tit, cmdQuery, field_key, field_col, "0", "0", "N", "N");									}																				} // FIN ... ObtenerFolio()			fun Open_Kdinf() {							//TO TEST OPEN tbl_kdinf_upd.kpl				if (tip_ope &= "A") {					if ( strlen(frn.get("k_claveinv")) != 0 ) {						var val_param;						val_param = frn.get("k_claveinv");						frn.dialog("tbl_kdinf_updU", val_param, "C","Eval_Data_Row()");						frn.script(Eval_Data_Row());					}				}			}						fun BuscarFolio() {				var folio;				folio = frn.get("k_folio");				//frn.lib("libGeneral.kpl","PadLeft", folio, 7, "0");				//folio = PadLeft(folio, 7, "0"); 221120 				ArmarRefDocto();				Mostrar_DOC(folio);				}			fun BuscarFolioRef() {				var folio;				folio = frn.get("k_folio_ref");				//frn.lib("libGeneral.kpl","PadLeft", folio, 7, "0");				//folio = PadLeft(folio, 7, "0"); 221120				//ArmarRefDocto();				frn.set("k_folio_ref", folio); 				Mostrar_DOC(folio);				}			fun Cancela() {				CambiaSucursal();				Inicializa();				ConfiguraControlesOpcion();			}						fun ModoBuscar() {				if (tip_ope &= "B") {					tip_ope = "CB";					frn.set("operacion", "CONSULTA - BAJAS");				} else {					tip_ope = "C";					frn.set("operacion", "CONSULTA");						}				LimpiaEncabezado();				ConfiguraControlesOpcion();			}					fun Ejecuta() {				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg;				var resultado, mensaje, folio;								fecha = sys.date();				hora = sys.time();								if (tip_ope &= "A") { 								//Eval_Data_Row();					Get_Data_Row();												if ( strlen(trim(frn.get("k_err"))) > 0 || strlen(trim(frn.get("k_err_d"))) > 0 ) {						frn.message("Existen Errores en los Datos, No se podra Procesar la Compra [Autos Usados] ... ", "Alto !!! ", "Aceptar");						return;					}											// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;												setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",						frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 						frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					//setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")/*-1*//*commented 220726*/);					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);					setXml(xmlPantalla,"ambiente","uen",uen/*"AUT"*/);													//Added 20240529					setXml(xmlPantalla,"uuid","serie",serie_uuid);					setXml(xmlPantalla,"uuid","folio",folio_uuid);					setXml(xmlPantalla,"uuid","total",total_uuid);					setXml(xmlPantalla,"uuid","fechatimbrado",fecha_uuid);					setXml(xmlPantalla,"uuid","impuesto",impuesto_uuid);					//Added 20240704					setXml(xmlPantalla,"uuid","retisr",retisr_uuid);					setXml(xmlPantalla,"uuid","retiva",retiva_uuid);										//Added by JMM 20240627					setXml(xmlPantalla,"k_miepsret",frn.get("k_uuid_retisr"));					setXml(xmlPantalla,"k_mivaret",frn.get("k_uuid_retiva"));					/*setXml(xmlPantalla,"k_montoanticipo",frn.get("k_otras_retenciones"));*/ // N.A. for these options										// Added by JMM 20240704					setXml(xmlPantalla,"ambiente","schema","CXP_CM_RETENCIONES");													frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\Xml_ComVhcUsd_Alta");					// For Testing ...					/*					frn.message("La INFO se enviara a PostgreSQL ...","Info !!!","Aceptar");					return;					*/										// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 								cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					rstXml(cuboQuery);					cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"comvhcusdcrud.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\comvhcusd_alta_xmlResultado_gotten_of_docdis");										// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										// resultado = "1";					// mensaje = "0000116";										resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");																				if(resultado &= "1") {											frn.message(mensaje, "Folio Generado Compra : ", "Aceptar");											ModoBuscar(); // 220721 ... added 												frn.set("k_folio", mensaje); 								strTmp = frn.get("k_docto");						strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;						frn.set("k_docto", strTmp);								BuscarFolio();					} else {						frn.message(mensaje, "Error", "Aceptar");					}				} /*End Alta*/ else {					if (tip_ope &= "B") {						/*Ini Baja*/												Get_Data_Row();													if ( strlen(trim(frn.get("k_err"))) > 0 || strlen(trim(frn.get("k_err_d"))) > 0 ) {							frn.message("Existen Errores en los Datos, No se podra Procesar la Baja de la Compra [Autos Usados] ... ", "Alto !!! ", "Aceptar");							return;						}												// N.A. No se elimina un DOC, se Genera otro con Contramovimientos, se Genera un nuevo Folio ... 						//folio = frn.get("k_folio");												xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;						//Agregar usuario, fecha y hora de movimiento						strFecha = fnDate("year",fecha) & "-";						strTmp = fnDate("month",fecha);						if(strlen(strTmp) == 1){							strTmp = "0" & strTmp;						}						strFecha = strFecha & strTmp & "-";						strTmp = fnDate("day",fecha);						if(strlen(strTmp) == 1){							strTmp = "0" & strTmp;						}						strFecha = strFecha & strTmp;													setXml(xmlPantalla,"movimiento","usuario",usuario);						setXml(xmlPantalla,"movimiento","fecha",strFecha);						setXml(xmlPantalla,"movimiento","hora",							frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 							frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));						//setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")/*-1*//*commented 220726*/);						setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);						setXml(xmlPantalla,"ambiente","uen",uen/*"AUT"*/);												setXml(xmlPantalla,"k_natdocto","A");						setXml(xmlPantalla,"k_gpodocto",gpo_doc);						setXml(xmlPantalla,"k_tipodocto",frn.get("k_tipon",-1,4));						setXml(xmlPantalla,"k_foliodocto",frn.get("k_folio_ref"));																		// START : EXTRA CODE - THIS PART TO CHECK WITH VICSA ... 												//Added 20240704						setXml(xmlPantalla,"uuid","serie",frn.get("k_uuid_serie"));						setXml(xmlPantalla,"uuid","folio",frn.get("k_uuid_folio"));						setXml(xmlPantalla,"uuid","total",frn.get("k_uuid_monto"));						setXml(xmlPantalla,"uuid","fechatimbrado",frn.get("k_uuid_fecha"));						setXml(xmlPantalla,"uuid","impuesto",frn.get("k_uuid_impuesto"));						setXml(xmlPantalla,"uuid","retisr",frn.get("k_uuid_retisr"));						setXml(xmlPantalla,"uuid","retiva",frn.get("k_uuid_retiva"));											//Added by JMM 20240704						setXml(xmlPantalla,"k_miepsret",frn.get("k_uuid_retisr"));						setXml(xmlPantalla,"k_mivaret",frn.get("k_uuid_retiva"));						/*setXml(xmlPantalla,"k_montoanticipo",frn.get("k_otras_retenciones"));*/ // N.A. for these options											// Added by JMM 20240704						setXml(xmlPantalla,"ambiente","schema","CXP_CM_RETENCIONES");											// END : EXTRA CODE - THIS PART TO CHECK WITH VICSA ...																	frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\Xml_ComVhcUsdcrud_Baja");												/*						frn.message("La opcion BAJA Compra se Procesara ...","Info !!!","Aceptar");						return; 						*/						// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 									cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						//kdb.rst(cuboQuery);						rstXml(cuboQuery);						cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"comvhcusdcrud.Ejecuta_Baja");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\comvhcusdcrud_baja_xmlResultado_gotten_of_docdis");											// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 											//resultado = "1";						//mensaje = folio /*"0000009"*/;											resultado = getXml(cuboQuery,"resultado");						mensaje = getXml(cuboQuery,"mensaje");										// /*																	if(resultado &= "1") {												frn.message(mensaje, "Folio Generado Baja Compra : ", "Aceptar");												ModoBuscar(); // 220721 ... added 													frn.set("k_folio", mensaje); 							strTmp = frn.get("k_docto");							strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;							frn.set("k_docto", strTmp);								BuscarFolio();						} else {							frn.message(mensaje, "Error", "Aceptar");						}						// */												//frn.message("En Construcción, OPC {Baja}", "Info", "Aceptar");					} /*End Baja*/ else {						/*Ini Consulta*/						folio = frn.get("k_folio");						ModoBuscar(); // 220721 ... added						frn.set("k_folio", folio); // 220721 ... added						//MostrarDEV(folio); // 220722 ... commented 						strTmp = frn.get("k_docto");						strTmp = strSplit(strTmp,"-",0) & "-" & folio;						frn.set("k_docto", strTmp);							BuscarFolio();					}	/*End Consulta (for exception)*/ 				}							} // FIN ... Ejecuta()									fun Inicializa(){ //Inicializa los valores en Pantalla			var tmpval;				// Our code 				// Revisa y Carga en Variables los Parámetros Recibidos en la corrida				if( frn.nParam() == 6 ){ //Se han mandado parámetros a la página                    gen_doc=trim(frn.param(0));                     nat_doc=trim(frn.param(1));                     gpo_doc=trim(frn.param(2));                    tip_doc=trim(frn.param(3));                     tip_ope=trim(frn.param(4));                    uen=trim(frn.param(5));                    tip_ope_original=tip_ope; /*220726*/            } else {               frn.message("Operación no válida ...", "Mensaje","&Aceptar");               //frn.open("anuncios",4);               //frn.open("index",4);			      return;            }                                    //frn.message("Valor var.uen : " & uen, "Mensaje","&Aceptar");            				if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					if(tip_ope &= "B"){ //Baja						frn.set("operacion","BAJA");					} else {						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} else {							if(tip_ope &= "CB"){ //Consulta								frn.set("operacion","CONSULTA - BAJAS");							} else {											frn.message("Operación no válida ...", "Mensaje","&Aceptar");								//frn.open("anuncios",4);								frn.open("index",4);								return;							}									}					}				}								// Fill Combo Sucursal (Con Query de PostgreSQL)				cmdQuery = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdms";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comvhcusdcrud.IniCombos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",cuboQuery);					sucursal_id = frn.get("k_sucn",-1,1);											// Fill Combo Tipo (Con Query FTO Kepler) 				cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;				//cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & "X" & "' and c2='" & "A" & "' and c3='" & "6" & "'" ;				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comvhcusdcrud.Inicializa()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\comvhcusdcrud_cuboTipoDocto");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error BD","Aceptar");					return;				}				frn.set("k_tipon",getXml(cuboQuery));								frn.set("k_fecha",sys.date());								tip_doc = frn.get("k_tipon",-1,4); // 221005					// Commented by JMM 20240508 				/*					frn.set("k_porciva", frn.get("k_tipon",-1,6)); // 221005				*/								// Fill k_docto | referencia docto				ArmarRefDocto();								LimpiaDatosProv();								if(tip_ope &= "A"){ frn.set("k_tipopagos","N"); } // Added 20221206							}						// Armado del Docto Referencia			fun ArmarRefDocto {				var cadena,tmpFolio, tmpGrupo, tmpTipo;				tmpFolio = frn.get("k_folio");				// //tmpFolio = frn.lib("libGeneral.kpl","PadLeft",tmpFolio,"7","0");				tmpFolio = PadLeft(tmpFolio,"7","0");				tmpGrupo = PadLeft(gpo_doc,"2","0");				tmpTipo = PadLeft(tip_doc,"3","0");				//cadena = trim(gen_doc) & trim(nat_doc) & trim(gpo_doc) & trim(tip_doc) & "-" & tmpFolio;				cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;				frn.set("k_docto", cadena);			}						fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         }			fun ConfiguraControlesOff() {								frn.setAtt("textFolio", "visible", "N");				frn.setAtt("k_folio", "available", "N");				frn.setAtt("k_folio", "visible", "N");								frn.setAtt("textFolio_ref", "visible", "N");				frn.setAtt("k_folio_ref", "available", "N");				frn.setAtt("k_folio_ref", "visible", "N");									frn.setAtt("k_fecha", "available", "N");				//frn.setAtt("k_hora", "available", "N");								frn.set("k_st", "");				frn.setAtt("k_st", "visible", "N");						frn.setAtt("BuscarFol"/*"buscar"*/, "available", "N"); // UPD by JMM 20240508				frn.setAtt("BuscarFol"/*"buscar"*/, "visible", "N"); // UPD by JMM 20240508								//Added by JMM 20240508				frn.setAtt("Buscar", "visible", "N");			   frn.setAtt("Buscar", "available", "N");								   frn.setAtt("k_claveinv", "available", "N");				frn.setAtt("k_tipopagos", "available", "N");				frn.setAtt("k_refer", "available", "N");				frn.setAtt("k_kilometraje", "available", "N");				frn.setAtt("k_serievehiculo", "available", "N");								frn.setAtt("k_vendedor", "available", "N");				frn.setAtt("k_proyecto", "available", "N");				frn.setAtt("k_subctabanco", "available", "N");								frn.setAtt("k_clave", "available", "N");				frn.setAtt("c_modelo", "available", "N");				frn.setAtt("c_descrip", "available", "N");								frn.setAtt("k_importe", "available", "N");				frn.setAtt("subt", "available", "N");				frn.setAtt("k_plazo", "available", "N");				frn.setAtt("k_iva", "available", "N");				frn.setAtt("k_porciva", "available", "N");				frn.setAtt("k_vence", "available", "N");				frn.setAtt("k_montoext4", "available", "N");				frn.setAtt("k_cond", "available", "N");				frn.setAtt("k_monto", "available", "N");				frn.setAtt("k_coment", "available", "N");				frn.setAtt("k_coment2", "available", "N");				frn.setAtt("k_coment3", "available", "N");								frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											}						fun ConfiguraControlesOpcion() {							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta					/*frn.setAtt("k_fecha", "available", "Y");*/  // Commented by JMM 20240508					//frn.setAtt("k_hora", "available", "Y");						   frn.setAtt("k_claveinv", "available", "Y");					frn.setAtt("k_tipopagos", "available", "Y");					frn.setAtt("k_kilometraje", "available", "Y");								frn.setAtt("k_vendedor", "available", "Y");					frn.setAtt("k_proyecto", "available", "Y");					frn.setAtt("k_subctabanco", "available", "Y");										/*frn.setAtt("k_clave", "available", "Y");*/  // Commented by JMM 20240508					/*frn.setAtt("k_importe", "available", "Y");*/  // Commented by JMM 20240508					//frn.setAtt("k_vence", "available", "Y");	// To Check ?					//frn.setAtt("k_montoext4", "available", "Y");					/*frn.setAtt("k_plazo", "available", "Y");*/  // Commented by JMM 20240508						frn.setAtt("k_coment", "available", "Y");					frn.setAtt("k_coment2", "available", "Y");					frn.setAtt("k_coment3", "available", "Y");											//Added by JMM 20240508					frn.setAtt("Buscar", "visible", "Y");					frn.setAtt("Buscar", "available", "Y");										frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");													} else {									if(tip_ope &= "B"){ //Baja										/*frn.setAtt("k_fecha", "available", "Y");*/  // Commented by JMM 20240508 										// frn.setAtt("textFolio", "visible", "Y");						// frn.setAtt("k_folio", "available", "Y");						// frn.setAtt("k_folio", "visible", "Y");						frn.setAtt("textFolio_ref", "visible", "Y");						frn.setAtt("k_folio_ref", "available", "Y");						frn.setAtt("k_folio_ref", "visible", "Y");												//Added by JMM 20240508						frn.setAtt("Buscar", "visible", "N");						frn.setAtt("Buscar", "available", "N");																frn.setAtt("Imprimir", "visible", "N");						frn.setAtt("Cancelar", "visible", "Y");						frn.setAtt("Aceptar", "visible", "Y");															} else {											if(tip_ope &= "CB"){ //Consulta Baja 											frn.setAtt("BuscarFol"/*"buscar"*/, "available", "Y"); // UPD by JMM 20240508							frn.setAtt("BuscarFol"/*"buscar"*/, "visible", "Y"); // UPD by JMM 20240508													frn.setAtt("textFolio", "visible", "Y");							frn.setAtt("k_folio", "available", "Y");							frn.setAtt("k_folio", "visible", "Y");															frn.setAtt("textFolio_ref", "visible", "Y");							frn.setAtt("k_folio_ref", "available", "N");							frn.setAtt("k_folio_ref", "visible", "Y");														//Added by JMM 20240508							frn.setAtt("Buscar", "visible", "N");							frn.setAtt("Buscar", "available", "N");															frn.setAtt("Imprimir", "visible", "Y"); 							frn.setAtt("Cancelar", "visible", "N"); 							frn.setAtt("Aceptar", "visible", "N");									} else { //Consulta Alta										frn.setAtt("BuscarFol"/*"buscar"*/, "available", "Y"); // UPD by JMM 20240508							frn.setAtt("BuscarFol"/*"buscar"*/, "visible", "Y"); // UPD by JMM 20240508													frn.setAtt("textFolio", "visible", "Y");							frn.setAtt("k_folio", "available", "Y");							frn.setAtt("k_folio", "visible", "Y");														//Added by JMM 20240508							frn.setAtt("Buscar", "visible", "N");							frn.setAtt("Buscar", "available", "N");													frn.setAtt("Imprimir", "visible", "Y");							if(tip_ope_original &= "A"){								frn.setAtt("Cancelar", "visible", "Y");							} else {								frn.setAtt("Cancelar", "visible", "N");							}							frn.setAtt("Aceptar", "visible", "N");														}											}									}			}						fun LimpiaDatosProv {				frn.set("k_rfc", "");				frn.set("k_cp", "");				frn.set("c_forzar", "");				frn.set("k_nombreprov", "");				frn.set("k_calleprov", "");				frn.set("k_coloniaprov", "");				frn.set("k_poblacionprov", "");				LimpiaDatosDoc();				/*LimpiaTotalesDoc();*/ // Commented by JMM 20240509			}						fun LimpiaDatosDoc {				frn.set("k_plazo", "");				frn.set("k_vence", "");				frn.set("k_cond", "");				frn.set("k_coment", "");				frn.set("k_coment2", "");				frn.set("k_coment3", "");			}						fun LimpiaTotalesDoc {				frn.set("k_importe", "");				frn.set("subt", "");				frn.set("k_iva", "");								frn.set("k_porciva", ""); // Added by JMM 20240508								frn.set("k_montoext4", "");				frn.set("k_monto", "");								frn.set("k_sumrets",""); // Added by JMM 20240627			}						fun LimpiaEncabezado {				if(tip_ope &= "A"){ 					frn.set("k_folio", "");					frn.set("k_docto", "");				}				frn.set("k_fecha", "");								frn.set("k_st", "");				frn.setAtt("k_st", "visible", "N");								frn.set("k_claveinv", "");				frn.set("k_tipopagos", "");				frn.set("k_refer", "");				frn.set("k_kilometraje", "");				frn.set("k_serievehiculo", "");				frn.set("c_modelo", "");				frn.set("c_descrip", "");								frn.set("k_vendedor", "");				frn.set("k_proyecto", "");				frn.set("k_subctabanco", "");								LimpiaDatosProv();				frn.set("k_clave", "");								frn.set("k_err", "");			}						fun CambiaSucursal {							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						}					}								}								LimpiaEncabezado();								frn.set("k_fecha",sys.date());									tip_doc = frn.get("k_tipon",-1,4); // 221005								//frn.message("tip_doc : " & tip_doc ,"Info", "Aceptar");												// Commented by JMM 20240508				/*frn.set("k_porciva", frn.get("k_tipon",-1,6));*/ // 221005								// Implemented 221114				if(tip_ope &= "A"){					// Commented by JMM 20240508					/*					if ( frn.get("k_porciva") > 0 ) {						frn.setAtt("k_iva", "available", "N");					} else {						frn.setAtt("k_iva", "available", "Y");					}					*/					frn.set("k_tipopagos","N"); // Added 20221206				} else {					frn.setAtt("k_iva", "available", "N");				}										ArmarRefDocto();									limpiar_datos_uuid();	// Added by JMM 20240508									} // END -	Fun - CambiaSucursal 						fun CambiaTipo {							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						}					}								}						LimpiaEncabezado();								frn.set("k_fecha",sys.date());									tip_doc = frn.get("k_tipon",-1,4); // 221005								// Commented by JMM 20240523				/*frn.set("k_porciva", frn.get("k_tipon",-1,6));*/ // 221005				// Implemented 221114				if(tip_ope &= "A"){					// Commented by JMM 20240523					/*					if ( frn.get("k_porciva") > 0 ) {						frn.setAtt("k_iva", "available", "N");					} else {						frn.setAtt("k_iva", "available", "Y");					}					*/					frn.set("k_tipopagos","N"); // Added 20221206				} else {					frn.setAtt("k_iva", "available", "N");				}												ArmarRefDocto();									limpiar_datos_uuid();	// Added by JMM 20240523										} // END -	Fun - CambiaTipo 						fun Valida_Trsp(imodo) {				var dato_id, err_msg;							err_msg = "";							dato_id = trim(frn.get("k_tipopagos"));				dato_id = strFormat("ucase", dato_id);				if ( strlen(dato_id) > 0 && dato_id &! "S" && dato_id &! "N") {					if ( imodo == 1 ) {						frn.message("Valor de campo Traspaso No valido, solo puede ser N/S : " & dato_id,"Error","Aceptar");						frn.setX("-", "k_tipopagos");						Eval_Data_Row();						return;					} else {						err_msg = "Traspaso";						return err_msg;					}					}	else	{					frn.setX(dato_id, "k_tipopagos");					if ( strlen(dato_id) == 0 ) {						if ( imodo == 1 ) {							frn.message("Valor de campo Traspaso vacio, solo puede ser N/S ...","Error","Aceptar");							Eval_Data_Row();							return;						} else {							err_msg = "Traspaso";							return err_msg;								}					} else {						if ( imodo == 1 ) { 							Eval_Data_Row(); 						} else {							err_msg = "";							return err_msg;						}					}				}										} // END -	Fun - Valida_Trsp			fun Valida_Invent(imodo) {				var dato_id, err_msg;							err_msg = "";							dato_id = "";				//cmdQuery = "select C8 as campo from keplersc.kdiv where c1 = '" & frn.get("k_mov",-1,"modelo") & "'";				if (tip_ope &= "A") { 					cmdQuery = "select c2 invent, c3 modelo, c4 descrip, c5 serie from keplersc.kdinf where c1 = '" & frn.get("k_sucn",-1,1) & "' and c2 = '" & frn.get("k_claveinv") & "'" & " and c21 = '" & "USADO" & "' and c31 = 10";				} else {					cmdQuery = "select c2 invent, c3 modelo, c4 descrip, c5 serie from keplersc.kdinf where c1 = '" & frn.get("k_sucn",-1,1) & "' and c2 = '" & frn.get("k_claveinv") & "'" & " and c21 = '" & "USADO" & "'";				}				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comvchusdcrud.Valida_Invent()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\comvchusdcrud_Valida_Invent");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "invent");								if ( strlen(dato_id) == 0 ) {					if ( strlen(trim(frn.get("k_claveinv"))) > 0 ) {						// frn.setX("--", "k_kilometraje");						frn.setX("--", "c_modelo");						frn.setX("--", "c_descrip");									frn.setX("--", "k_serievehiculo");					} else {						// frn.setX("", "k_kilometraje");						frn.setX("", "c_modelo");						frn.setX("", "c_descrip");							frn.setX("", "k_serievehiculo");									}					if ( imodo == 1 ) {						if ( strlen(trim(frn.get("k_claveinv"))) > 0 ) {							frn.message("El Inventario que registraste No es Valido ... ","Error","Aceptar");						} else {							frn.message("El Inventario No puede ser vacio ... ","Error","Aceptar");						}						Eval_Data_Row();						return;					} else {						if ( strlen(frn.get("k_claveinv")) > 0 ) {							err_msg = frn.get("k_claveinv");						} else {							err_msg = "Error";						}						return err_msg;					}				} else {					// frn.setX(getXmlAtt(cuboQuery,"r0", "invent"), "k_kilometraje");					frn.setX(getXmlAtt(cuboQuery,"r0", "modelo"), "c_modelo");					frn.setX(getXmlAtt(cuboQuery,"r0", "descrip"), "c_descrip");					frn.setX(getXmlAtt(cuboQuery,"r0", "serie"), "k_serievehiculo");					if ( imodo == 1 ) { 						Eval_Data_Row(); 					} else {						err_msg = "";						return err_msg;							}				}							}	// END -	Fun - Valida_Invent			fun Valida_Folio(imodo) {				var dato_id, err_msg;							err_msg = "";				dato_id = "";							if (tip_ope &= "B") {					cmdQuery = "select tdm1.c10 as cve_proveedor, txd.c3 as nomb_proveedor, tdm1.c6 as folio_compra, tdm1.c9 as fecha " &						", tdm1.c11 as ref_inventario from keplersc.kdm1 as tdm1 " & 						"inner join keplersc.kdxd as txd on txd.c2 = tdm1.c10 " & 						"inner join keplersc.kdinf as inf on inf.c1 = tdm1.c1 and inf.c2 = tdm1.c100 " &						"where tdm1.c2 = 'X' and tdm1.c3 = 'A' and tdm1.c4 = 7 and tdm1.c5 = " & frn.get("k_tipon",-1,4) & " and tdm1.c1 = '" & frn.get("k_sucn",-1,1) & "' " & 						"and inf.c31 = 20 and tdm1.c6 = '" & frn.get("k_folio_ref") & "'";					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comvhcusdcrud.Valida_Folio()");					//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\comvhcusdcrud.Valida_Folio_qr1");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					dato_id = getXmlAtt(cuboQuery,"r0", "folio_compra");									if ( strlen(dato_id) > 0 ) {											dato_id = "";												cmdQuery = "select t.c6 as folio_rel from keplersc.kdvalntcr as t " & 							"where t.c2 = 'X' and t.c7 = 'A' and t.c8 = 7 and t.c9 = " & frn.get("k_tipon",-1,4) & " and t.c1 = '" & frn.get("k_sucn",-1,1) & "' " & 							"and t.c10 = '" & frn.get("k_folio_ref") & "'";						rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comvhcusdcrud.Valida_Folio()");						//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\comvhcusdcrud.Valida_Folio_qr2");						ok=getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;						}						dato_id = getXmlAtt(cuboQuery,"r0", "folio_rel");											if ( strlen(dato_id) > 0 ) {											if ( imodo == 1 ) {								frn.message("El Folio de la Compra NO es Valido ... " & "|" & "Esta Asociado al Documento : " & dato_id,"Error","Aceptar");								Eval_Data_Row();								return;							} else {								err_msg = dato_id;								return err_msg;							}												} else {							if ( imodo == 1 ) { 								Eval_Data_Row(); 							} else {								err_msg = "";								return err_msg;									}						}											} else {											if ( imodo == 1 ) {							frn.message("El Folio de la Compra NO es Valido ... ","Error","Aceptar");							Eval_Data_Row();							return;						} else {							err_msg = "Error";							return err_msg;						}											}				}							}	// END -	Fun - Valida_Folio 			fun Valida_Serie(imodo) {				var dato_id, err_msg;							err_msg = "";							dato_id = "";				//cmdQuery = "select C8 as campo from keplersc.kdiv where c1 = '" & frn.get("k_mov",-1,"modelo") & "'";				cmdQuery = "select max(c2) max_invent from keplersc.kdinf where c1=' " & frn.get("k_sucn",-1,1) & "' and c5 = '" & frn.get("k_serievehiculo") & "' and c2 <> '" & frn.get("k_claveinv") & "' and ( c31 = 10 or ( c31 > 0 and c32 < 60 ) )"; // and c31 = 10{commented 20230214} c31 <> 0				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comvhcusdcrud.Valida_Serie()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\comvhcusdcrud_Valida_Serie");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "max_invent");								if ( strlen(dato_id) > 0 ) {					if ( imodo == 1 ) {						frn.message("La Serie asignada a este Inventario, esta asignada a otro Numero de Inventario : " & dato_id,"Error","Aceptar");						//frn.setX("--", "k_serievehiculo");							Eval_Data_Row();						return;					} else {						err_msg = dato_id;						return err_msg;					}				} else {					if ( imodo == 1 ) { 						if ( strlen( trim(frn.get("k_serievehiculo")) ) == 0 ) {							frn.message("Este Inventario No cuenta con Numero de Serie ... ","Error","Aceptar");						}						Eval_Data_Row(); 					}				}							}	// END -	Fun - Valida_Serie 						fun Valida_Prov(imodo) {				var dato_id, err_msg;							err_msg = "";							dato_id = "";				cmdQuery = "select c10 as k_rfc, c3 as k_nombreprov, c4 as k_calleprov, c5 as k_coloniaprov, c6 as k_poblacionprov, c16 as c_dias, c27 as k_cp, coalesce(c28,'') as c_forzar " &									"from keplersc.kdxd where c2 = '" & frn.get("k_clave") & "'" ;				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comvchusdcrud.Valida_Prov()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\comvchusdcrud_Valida_Prov");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "k_nombreprov");								if ( strlen(dato_id) == 0 ) {					if ( strlen(trim(frn.get("k_clave"))) > 0 ) {						frn.setX("--", "k_rfc");						frn.setX("--", "k_cp");						frn.setX("", "c_forzar");						frn.setX("--", "k_nombreprov");						frn.setX("--", "k_calleprov");						frn.setX("--", "k_coloniaprov");						frn.setX("--", "k_poblacionprov");						frn.setX("", "c_dias");							frn.set("k_vence", "");							} else {						frn.setX("", "k_rfc");						frn.setX("", "k_cp");						frn.setX("", "c_forzar");						frn.setX("", "k_nombreprov");						frn.setX("", "k_calleprov");						frn.setX("", "k_coloniaprov");						frn.setX("", "k_poblacionprov");						frn.setX("", "c_dias");						frn.set("k_vence", "");								}					if ( imodo == 1 ) {						if ( strlen(trim(frn.get("k_clave"))) > 0 ) {							frn.message("El Proveedor que registraste No es Valido ... ","Error","Aceptar");						} else {							frn.message("El Proveedor No puede ser vacio ... ","Error","Aceptar");						}						Eval_Data_Row();						return;					} else {						if ( strlen(frn.get("k_clave")) > 0 ) {							err_msg = frn.get("k_clave");						} else {							err_msg = "Error";						}						return err_msg;					}				} else {					frn.setX(getXmlAtt(cuboQuery,"r0", "k_nombreprov"), "k_nombreprov");					frn.setX(getXmlAtt(cuboQuery,"r0", "k_calleprov"), "k_calleprov");					frn.setX(getXmlAtt(cuboQuery,"r0", "k_coloniaprov"), "k_coloniaprov");					frn.setX(getXmlAtt(cuboQuery,"r0", "k_poblacionprov"), "k_poblacionprov");						frn.setX(getXmlAtt(cuboQuery,"r0", "c_dias"), "c_dias");					if (tip_ope &= "A") {						if ( imodo == 1 ) { 							frn.setX(getXmlAtt(cuboQuery,"r0", "c_dias"), "k_plazo");						}						frn.set("k_vence",fnDate("addC",sys.date(),frn.get("c_dias")));//Suma días comerciales						/*frn.setX(getXmlAtt(cuboQuery,"r0", "k_rfc"), "k_rfc");*/ //Commented by JMM 20240523						frn.setX(getXmlAtt(cuboQuery,"r0", "k_cp"), "k_cp");						frn.setX(getXmlAtt(cuboQuery,"r0", "c_forzar"), "c_forzar");						Plazo();					}					if ( imodo == 1 ) { 						Eval_Data_Row(); 					} else {						err_msg = "";						return err_msg;							}				}							}	// END -	Fun - Valida_Prov									fun Get_Cat(imodo) {            				var suc_id, dato_id;				var win_tit, field_key, field_col, cmdQuery;            				if ( imodo <= 0 || imodo > 7 /*|| tip_ope &! "A"*/ ) {					// No es opcion de CAT Valida ...					return;				}								win_tit = "";				field_key = "";				field_col = "";				cmdQuery = "";				if (imodo == 1) {					if (tip_ope &= "CB") {						win_tit = "Bajas - Compras Autos Usados";						field_key = "folio_baja";						field_col = "k_folio";						cmdQuery = "select tdm1.c10 as cve_proveedor, txd.c3 as nomb_proveedor, tdm1.c6 as folio_baja, tdm1.c9 as fecha " &							", tdm1.c11 as ref_inventario from keplersc.kdm1 as tdm1 " & 							"inner join keplersc.kdxd as txd on txd.c2 = tdm1.c10 " & 							"where tdm1.c2 = 'X' and tdm1.c3 = 'D' and tdm1.c4 = 7 and tdm1.c5 = " & frn.get("k_tipon",-1,4) & " and tdm1.c1 = '" & frn.get("k_sucn",-1,1) & "' " & 							"order by tdm1.c6 desc";						//cmdQuery = cmdQuery & " order by clave_proveedor, folio_compra";					} else { 						if (tip_ope &= "B") {							win_tit = "Compras Autos Usados";							field_key = "folio_compra";							field_col = "k_folio_ref";											cmdQuery = "select tdm1.c10 as cve_proveedor, txd.c3 as nomb_proveedor, tdm1.c6 as folio_compra, tdm1.c9 as fecha " &							", tdm1.c11 as ref_inventario from keplersc.kdm1 as tdm1 " & 							"inner join keplersc.kdxd as txd on txd.c2 = tdm1.c10 " & 							"inner join keplersc.kdinf as inf on inf.c1 = tdm1.c1 and inf.c2 = tdm1.c100 " &							"where tdm1.c2 = 'X' and tdm1.c3 = 'A' and tdm1.c4 = 7 and tdm1.c5 = " & frn.get("k_tipon",-1,4) & " and tdm1.c1 = '" & frn.get("k_sucn",-1,1) & "' " & 							"and inf.c31 = 20 " &							"order by tdm1.c6 desc";										} else { 							win_tit = "Compras Autos Usados";							field_key = "folio_compra";							field_col = "k_folio";							cmdQuery = "select tdm1.c10 as cve_proveedor, txd.c3 as nomb_proveedor, tdm1.c6 as folio_compra, tdm1.c9 as fecha " &								", tdm1.c11 as ref_inventario from keplersc.kdm1 as tdm1 " & 								"inner join keplersc.kdxd as txd on txd.c2 = tdm1.c10 " & 								"where tdm1.c2 = 'X' and tdm1.c3 = 'A' and tdm1.c4 = 7 and tdm1.c5 = " & frn.get("k_tipon",-1,4) & " and tdm1.c1 = '" & frn.get("k_sucn",-1,1) & "' " & 								"order by tdm1.c6 desc";							//cmdQuery = cmdQuery & " order by clave_proveedor, folio_compra";						}			      }				}													if (imodo == 2) {					win_tit = "Inventarios Disponibles - Usados";					field_key = "invent";					field_col = "k_claveinv";					cmdQuery = "select c2 invent, c3 modelo, c4 descrip from keplersc.kdinf where c1 = '" & frn.get("k_sucn",-1,1) & "' and c21 = '" & "USADO" & "' and c31 = 10 " &						"Order by right(c2,length(c2)-5) asc, left(c2,4) desc";				}									if (imodo == 3) {					win_tit = "CAT Proveedores";					field_key = "k_claveprov";					field_col = "k_clave";					cmdQuery = "select c2 as k_claveprov, c3 as nombre from keplersc.kdxd ";				}								if (imodo == 4) {					win_tit = "Compras Autos Usados";					field_key = "folio_compra";					field_col = "k_folio_ref";					cmdQuery = "select tdm1.c10 as cve_proveedor, txd.c3 as nomb_proveedor, tdm1.c6 as folio_compra, tdm1.c9 as fecha " &						", tdm1.c11 as ref_inventario from keplersc.kdm1 as tdm1 " & 						"inner join keplersc.kdxd as txd on txd.c2 = tdm1.c10 " & 						"inner join keplersc.kdinf as inf on inf.c1 = tdm1.c1 and inf.c2 = tdm1.c100 " &						"where tdm1.c2 = 'X' and tdm1.c3 = 'A' and tdm1.c4 = 7 and tdm1.c5 = " & frn.get("k_tipon",-1,4) & " and tdm1.c1 = '" & frn.get("k_sucn",-1,1) & "' " & 						"and inf.c31 = 20 " & 						"order by tdm1.c9 desc, tdm1.c6 desc";				}													if (imodo == 5) {					win_tit = "Catalogo de Coaches";					field_key = "clave";					field_col = "k_vendedor";					cmdQuery = "select c1 clave, c2 nombre from keplersc.kdcatcoach Order by c1, c2";				}									if (imodo == 6) {					win_tit = "Catalogo de Asesores";					field_key = "clave";					field_col = "k_proyecto";					cmdQuery = "select c2 clave, c3 nombre from keplersc.kduv Order by c2, c3";				}								if (imodo == 7) {					win_tit = "Catalogo de Valuadores";					field_key = "clave";					field_col = "k_subctabanco";					cmdQuery = "select c1 clave, c2 nombre from keplersc.kdcatval Order by c1, c2";				}								  								                      if ( strlen(win_tit) > 0 && strlen(field_key) > 0 && strlen(field_col) > 0 && strlen(cmdQuery) > 0 /*&& strlen(objeto) > 0*/ ) {                                        					//frn.dialog("genlistasel", win_tit,cmdQuery, field_key, "k_mov",-1, field_col,"S");  * * *  USADO EN GRIDS					//frn.dialog("genlistasel","Catálogo de Proveedores",cmdQuery,"k_claveprov","k_clave","0","","N");  * * *  USADO EN CTRLS SIMPLES										frn.lib("libGeneral.kpl","FileSave",cmdQuery, fileSavePath & "\comvshusdcrud_genlist");										frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");				}							} /*END Func Get_Cat()*/		   fun Get_Cat_Data(imodo, icall) {						var suc_id, dato_id;				var field_ori,field_dest, tbl, field_dscr;				var field_add, dato_id_add;				var field_dest_2, dato_id_2;								if ( imodo < 0 || imodo > 7  /*|| ( tip_ope &! "A" && icall != 2 )*/ ) {					// No es opcion de CAT Valida ...					return;				}				 				field_dscr = "";				field_ori = "";				field_dest = "";				tbl = "";				cmdQuery = "";								dato_id = "";								/*						if (imodo == 1) {					field_dscr = "Modelo";					field_ori = "modelo";					field_dest = "descrip";					tbl = "kdiv";					//cmdQuery = "select C2 as " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'";					cmdQuery = "select k.c1 as cve, k.c2 as " & field_dest & ", k.c4 as clase, tcl.c2 as clase_descr, k.c5 as marca, tmr.c2 as marca_descr, " & 						"k.c6 as codISAN, tis.c2 as codISAN_descr, k.c8 as tipo_auto from keplersc.kdiv k " & 						"left join keplersc.kdic tcl on k.c4 = tcl.c1 " & 						"left join keplersc.kdmarca tmr on k.c5 = tmr.c1 " &  						"left join keplersc.kdtisan tis on k.c6 = tis.c1 " & 						"where k.c1 = '" & frn.get("k_mov",-1,"modelo") & "'";				}				*/								if ( tip_ope &= "A" ) {					if (imodo == 2) {						field_dscr = "Inventario";						field_ori = "k_claveinv";						field_dest = "k_claveinv" /*"k_refer" ... UPD 20240508 by JMM*/; // "k_kilometraje"; 						tbl = "kdinf";						cmdQuery = "select c2 " & field_dest & ", c3 modelo, c4 descrip from keplersc." & tbl & " where c1 = '" & frn.get("k_sucn",-1,1) & "' and c2 = '" & frn.get("k_claveinv") & "'" & " and c21 = '" & "USADO" & "' and c31 = 10";					}				}													if ( tip_ope &= "A" ) {					if (imodo == 3) {						field_dscr = "Proveedor";						field_ori = "k_clave";						field_dest = "k_nombreprov";						tbl = "kdxd";						cmdQuery = "select c3 " & field_dest & " from keplersc." & tbl & " where c2 = '" & frn.get("k_clave") & "'";					}				}									if ( tip_ope &= "A" ) {					if (imodo == 5) {						field_dscr = "Coach";						field_ori = "k_vendedor";						field_dest = "k_vendedor";						tbl = "kdcatcoach";						cmdQuery = "select c1 " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get(field_ori) & "'";					}				}				if ( tip_ope &= "A" ) {					if (imodo == 6) {						field_dscr = "Asesor";						field_ori = "k_proyecto";						field_dest = "k_proyecto";						tbl = "kduv";						cmdQuery = "select c2 " & field_dest & " from keplersc." & tbl & " where c2 = '" & frn.get(field_ori) & "'";					}				}											if ( tip_ope &= "A" ) {					if (imodo == 7) {						field_dscr = "Valuador";						field_ori = "k_subctabanco";						field_dest = "k_subctabanco";						tbl = "kdcatval";						cmdQuery = "select c1 " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get(field_ori) & "'";					}				}												if (imodo == 0 && icall == 1) {					Eval_Data_Row();				}								field_add = "";				//if (imodo == 1) { field_add = "c_descrip"; }				//if (imodo == 3) { field_add = "k_color_ext"; }				//if (imodo == 4) { field_add = "k_color_vest"; }					//if (imodo == 5) { field_add = "k_suc"; }					//if (imodo == 6) { field_add = "k_clase"; }				//if (imodo == 7) { field_add = "k_marca"; }											if ( strlen(field_dscr) > 0 && strlen(field_ori) > 0 && strlen(field_dest) > 0 && strlen(tbl) > 0 && strlen(cmdQuery) > 0 ) {					//if ( strlen(frn.get("k_mov",-1,field_ori)) != 0 ) {						//dato_id = frn.get("k_mov",-1,field_ori);						//cmdQuery = "select C2 as descrip from keplersc.kdiv where c1 = '" & dato_id & "'";						rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comvshusdcrud.Get_Cat_" & tbl & "()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\comvshusdcrud_Get_Cat_" & tbl);						ok=getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok){							dato_id = "--";							if (imodo == 1) {								dato_id = "[ERR] verificando " &  field_dscr & " ...";							}							frn.setX(dato_id,"k_mov",-1, field_dest);							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							dato_id_add = "";							if (imodo == 1) { dato_id_add = dato_id; }							if (imodo == 3 || imodo == 4 || imodo == 5) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							//if (imodo == 4) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							//if (imodo == 5) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							if ( strlen(field_add) != 0 ) { frn.setX(dato_id_add, field_add); }							return;						}						dato_id = "";						dato_id = getXmlAtt(cuboQuery,"r0", field_dest);					   if( strlen(dato_id) == 0 ){					   							// Code Adapted for this option							frn.setX(trim(frn.get(field_ori)), field_ori);							if (imodo == 5 || imodo == 6) {								dato_id = "--";							} else {								if ( strlen(frn.get(field_ori)) > 0 ) {									dato_id = "--";								} else {									dato_id = "";								}							}																					//dato_id = "--";							if (imodo == 1 /*&& icall ==1*/) {								/*								frn.setX("", "k_marca");								frn.setX("", "k_clase");								frn.setX("", "k_tipo_auto");								*/								dato_id = field_dscr & " No existe ...";							}																					if (imodo == 5 || imodo == 6 || imodo == 7) { // code upd 221129								frn.set(field_dest, dato_id);							} else {								frn.setX(dato_id, field_dest);							}																if (imodo == 2) { Valida_Invent(1); }														if (imodo == 3) { Valida_Prov(1); }										if (icall == 2 ) { Eval_Data_Row(); }									return;												} else {													frn.setX(dato_id, field_dest);														if (imodo == 2) { Valida_Invent(1); }														if (imodo == 3) { Valida_Prov(1); }														if (icall == 2) { Eval_Data_Row(); }														return;												}				}					} /*END Fun Get_Cat_Data()*/			fun Get_Data_Row() {				for (var i=0; i<=7; i++) {					Get_Cat_Data(i);				}								//Condition Added & commented by JMM 20240509				//if ( tip_ope &= "A" ) {					Eval_Data_Row(); //Sentence Original Before UUID SCH  				//}										} /*END Func Get_Data_Row()*/			fun Eval_Data_Row(/*nRow,*/ imodo) {				var ColIni, ColEnd, EvalCols, ErrText, ErrTextData;				var FieldsList, FieldListData, FlagErr;								ErrText = "";				ErrTextData = "";							err_empty = 0;				err_data = 0;								FieldsList = "";				FieldListData = "";								// Evaluando vacios ...								//EvalCols = strlen( frn.get("c_descrip") );				frn.setX(trim(frn.get("k_claveinv")), "k_claveinv");				frn.setX(trim(frn.get("k_tipopagos")), "k_tipopagos");				frn.setX(trim(frn.get("k_refer")), "k_refer"); // Un-Commented by JMM 20240508				frn.setX(trim(frn.get("k_kilometraje")), "k_kilometraje");				frn.setX(trim(frn.get("k_clave")), "k_clave");				frn.setX(trim(frn.get("subt")), "subt");								frn.setX(trim(frn.get("k_vendedor")), "k_vendedor");				frn.setX(trim(frn.get("k_proyecto")), "k_proyecto");				frn.setX(trim(frn.get("k_subctabanco")), "k_subctabanco");									if ( strlen( frn.get("k_claveinv") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "c_Invent | "; 				}				if ( strlen( frn.get("k_sucn") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "Suc | "; 				}				if ( strlen( frn.get("k_tipopagos") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "Traspaso | "; 				}												if ( strlen( frn.get("k_kilometraje"/*"k_refer"*/) ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "Kilometraje | " /*"c_Factura | "*/; // UPD by JMM 20240508				}								//Added by JMM 20240508				if ( strlen( frn.get("k_refer") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "Factura | "; 				}								if ( strlen( frn.get("k_clave") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "Cve_Prov | "; 				}								if (tip_ope &= "A") { // Added 221123					if ( strlen( frn.get("c_modelo") ) == 0 ) { 						err_empty = err_empty + 1; 						FieldsList = FieldsList & "Modelo | "; 					}				}								if (tip_ope &= "A") { // Added 221123					if ( strlen( frn.get("k_serievehiculo") ) == 0 ) { 						err_empty = err_empty + 1; 						FieldsList = FieldsList & "Serie | "; 					}				}								if ( strlen( frn.get("k_vendedor") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "Coach | "; 				}				if ( strlen( frn.get("k_proyecto") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "Asesor | "; 				}						EvalCols = strlen(FieldsList) - 1;				if ( err_empty > 0 ) { FieldsList = mid(FieldsList, 0, EvalCols); } 												// Evaluando datos ...								if (tip_ope &= "B") {					FlagErr = "";					FlagErr = Valida_Folio();					if ( strlen( FlagErr ) > 0 ) { 						err_data = err_data + 1;						if (FlagErr &= "Error") {							FieldListData = FieldListData & "Folio Compra | "; 						} else {							FieldListData = FieldListData & "Folio Compra en [" & FlagErr &  "] | ";						}					}					}								FlagErr = "";				FlagErr = Valida_Invent();				if ( strlen( FlagErr ) > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "Invent [" & FlagErr &  "] | ";				} 								if ( strlen( FlagErr ) == 0 ) {					FlagErr = "";					FlagErr = Valida_Serie();					if ( strlen( FlagErr )  > 0 ) { 						err_data = err_data + 1;						FieldListData = FieldListData & "Invent.Serie [" & FlagErr &  "] | ";					}				}											FlagErr = "";				FlagErr = Valida_Trsp();				if ( strlen( FlagErr ) > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "Traspaso | ";				} 								FlagErr = "";				FlagErr = Valida_Prov();				if ( strlen( FlagErr ) > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "Proveedor | ";				} 								FlagErr = "";				// Si entra al IF validara longitud del RFC y CP 				if (  ( strlen( frn.get("k_rfc") ) > 0 && frn.get("k_rfc") &! "--" ) && ( strlen( frn.get("c_forzar") ) == 0 || frn.get("c_forzar") &! "N" )  ) {										// Commented by JMM 20240508					/*					if ( strlen( frn.get("k_rfc") ) < 12 || strlen( frn.get("k_rfc") ) > 15 ) { //> 15 {13}						err_data = err_data + 1;						FieldListData = FieldListData & "RFC | ";					}					*/					/*					if ( strlen( frn.get("k_cp") ) != 5 ) {						err_data = err_data + 1;						FieldListData = FieldListData & "C.P. | ";					}							*/						}								if ( tip_ope &= "A" ) { /*Condition Added by JMM 20240509*/					FlagErr = "";					FlagErr = CalculaTotales();					if ( strlen( FlagErr ) > 0 ) { 						err_data = err_data + 1;						FieldListData = FieldListData & FlagErr /*"Total = 0 | "*/;					}				}											FlagErr = "";				if ( frn.get("c_dias") < frn.get("k_plazo") ) {					FlagErr = "Plazo > Lim. Credito | ";				}				if ( strlen( FlagErr ) > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & FlagErr;				}										if ( frn.get("k_vendedor") &= "--" ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "Coach | ";				} 				if ( frn.get("k_proyecto") &= "--" ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "Asesor | ";				} 				if ( frn.get("k_subctabanco") &= "--" ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "Valuador | ";				} 													if ( frn.get("k_sucn") &= "--" ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "Suc | ";				} 												//Added by JMM 20240508 				if ( frn.get("k_rfc") &! rfc_uuid && tip_ope &= "A" /*condition added 20240509*/ ) {					/*					resVal=0;					frn.message("El RFC del Proveedor No corresponde al de la Factura.","Error","Aceptar");					return;					*/					err_data = err_data + 1;					FieldListData = FieldListData & "RFC Prov <> RFC UUID | ";				}								//Added by JMM 20240618				if ( tip_ope &= "A" ) {					if ( strlen(/*folio_uuid*/nombre_uuid) == 0 || strlen(rfc_uuid) == 0 || strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {						err_data = err_data + 1;						FieldListData = FieldListData & "Datos XML Incompletos | ";					}				}																if ( err_data > 0 ) { ErrTextData = "| " & FieldListData; }					if ( err_empty > 0 ) { ErrText = "| " & FieldsList; }								//frn.setX(ErrText, "k_err");				//frn.setX(ErrTextData, "k_err_d");								frn.setX(ErrText & ErrTextData, "k_err");								if ( strlen( ErrText ) == 0 && strlen( ErrTextData ) == 0 ) {					return -1;				}								return 1;							} /*END Func Eval_Data_Row()*/		// -----------------------------  START : SECTION CODE ADDED BY JMM FOR UUID IMPLEMENTING 20240508 TO 202405XX  ------------------------------		fun ProcesarFactura() {						ObtenerFactura();							if ( strlen(NewProvId) > 0 ) {					prov_data_upd(NewProvId);				}							// Se elimina esta parte porque lo ejecuta antes de abrir el dialogo ...				// /*					if ( strlen(NewProvId) > 0 ) {							BuscarProveedor();					}				// */					} // End Fun - ProcesarFactura 		fun ObtenerFactura(){			var nCampos, uuid="";			//Regresara la funcion UUID cadena con UUID, rfc, fecha, total			//Added 20240119 by JMM			var NewProv;			//Added by JMM 20240508			var importe;						limpiar_datos_uuid();						uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID","k_refer", 0,"0");			// Replaced with new function, 20240111 			//uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID_Extended","k_refer", 0,"0");						nCampos = strSplit(uuid,"|",-1);			if (nCampos > 1) {					str_uuid = strSplit(uuid,"|",0);		  //UUID					rfc_uuid = strSplit(uuid,"|",1);		  //rfc					fecha_uuid = strSplit(uuid,"|",2);	  //fecha					total_uuid = strSplit(uuid,"|",3);	  //monto de la factura										// Added 20240111 by JMM					nombre_uuid = strSplit(uuid,"|",5);	  //nombre					regimen_uuid = strSplit(uuid,"|",6);  //regimen					folio_uuid = strSplit(uuid,"|",7);	  //folio					serie_uuid = strSplit(uuid,"|",8);	  //serie										//Added by JMM 20240627					retisr_uuid = strSplit(uuid,"|",10); //retencion isr					retiva_uuid = strSplit(uuid,"|",11); //retencion iva										// Added 20240224 by JMM					impuesto_uuid = strSplit(uuid,"|",9); //impuesto									// Conditions Added 20240111  by JMM					if ( strlen(/*folio_uuid*/nombre_uuid) == 0 || strlen(rfc_uuid) == 0 || strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {											//frn.set("k_refer","");						frn.message("No se pudieron obtener todos los datos mandatorios del UUID.","Error","Aceptar");												Eval_Data_Row(); //Added 20240508 by JMM											} else {											frn.set("k_refer",str_uuid);						frn.set("k_rfc",rfc_uuid);												if ( BuscarUUID(str_uuid) > 0 ) {							//frn.set("k_rfc","");							frn.set("k_clave","");							Eval_Data_Row(); //Added 20240508 by JMM							frn.message("Este Documento [UUID] ya ha sido Asociado previamente ...","Error","Aceptar");							return;						} 													frn.set("k_uuid_fecha",mid(fecha_uuid,0,10));						if ( Validar_Fecha_UUID() == 0 ) { 							//frn.set("k_rfc","");							frn.set("k_clave","");							Eval_Data_Row(); //Added 20240508 by JMM							return;						}												NewProv = "";						NewProv = BuscarProveedor();						if (strlen(NewProv) > 0/*== 1*/) {							//BuscarProveedor(NewProv);							NewProvId = NewProv;							frn.set("k_clave",NewProvId);						} else {							NewProvId = "";						}												if ( strlen(frn.get("k_clave")) > 0 && frn.get("k_clave") &! strFormat("ucase","No Existe ...") ) {														// Validations Moved UP by JMM 20240119 ( BuscarUUID, Validar_Fecha_UUID )																			frn.set("k_uuid_serie",serie_uuid);							frn.set("k_uuid_folio",folio_uuid);							frn.set("k_uuid_monto",total_uuid);							frn.set("k_uuid_fecha",mid(fecha_uuid,0,10));														// Added 20240229 by JMM							frn.set("k_uuid_impuesto",impuesto_uuid);														//Added 20240229 by JMM							frn.set("k_iva",impuesto_uuid);														// Added 20240627 by JMM							frn.set("k_uuid_retisr",retisr_uuid);							frn.set("k_uuid_retiva",retiva_uuid);														// Added 20240627 by JMM							var sumrets = retisr_uuid + retiva_uuid;							frn.set("k_sumrets",sumrets);														//Added 20240508 by JMM							importe = 0;							importe = total_uuid - impuesto_uuid + sumrets; //Adapted by JMM 20240627							frn.set("k_importe", importe);							CalculaTotales(); 												}												Eval_Data_Row(); //Added 20240508 by JMM											}			} else{				//frn.set("k_refer","");				frn.message("Faltan datos del UUID ...","Error","Aceptar");									Eval_Data_Row(); //Added 20240508 by JMM			}		}	// End Fun - Obtener Factura		fun limpiar_datos_uuid() {			frn.set("k_clave","");			frn.set("k_rfc","");			frn.set("k_refer","");						frn.set("k_uuid_serie","");			frn.set("k_uuid_folio","");			frn.set("k_uuid_monto","");			frn.set("k_uuid_fecha","");						// Added 20240120			NewProvId = "";			LimpiaDatosProv();						//Added 20240229			frn.set("k_uuid_impuesto","");						//Added 20240627			frn.set("k_uuid_retisr","");				frn.set("k_uuid_retiva","");						//Added 20240328 			str_uuid = "";				rfc_uuid = "";				fecha_uuid = ""; 			total_uuid = "";								nombre_uuid = "";			regimen_uuid = "";			folio_uuid = "";			serie_uuid = "";			impuesto_uuid = "";						//Added by JMM 20240627			retisr_uuid = "";			retiva_uuid = "";						LimpiaTotalesDoc(); //Added by JMM 20240509						// Commented by JMM 20240508 N.A.			/*			//Added 20240229			if ( paramProvPago > 0 ) { //&= "P"				if ( tip_ope &= "A" ) {						frn.setAtt("k_clave_pago", "available", "Y");				} else {					frn.setAtt("k_clave_pago", "available", "N");				}				if ( CheckProvPago() == 0 ) {					frn.set("k_clave_pago","");					frn.set("k_nombreprov_pago","");				}			} else {				frn.setAtt("k_clave_pago", "available", "N");				frn.set("k_clave_pago","");				frn.set("k_nombreprov_pago","");			}			*/					} // End : fun limpiar_datos_uuid()		fun BuscarUUID(referencia){			var xmlProd, respfunc;											sucursal_id = frn.get("k_sucn",-1,1);			respfunc = 1;														if (strlen(str_uuid) == 0) {				frn.message("No se tiene una Referencia [UUID] para validarse ...","Error","Aceptar");				return;			}						/*			cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &				"and c2 = '" & gen_doc & "' and c3 = '" & nat_doc & "' and c4 = " & gpo_doc & " and c5 = " & tip_doc & " and c11 = '" & referencia & "'";			*/						// Query updated at { C x P } validation, 20240201 			cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &				"and c2 = 'X' and c3 = 'A' and c11 = '" & referencia & "'";	 							// Query updated at { C x P } validation, 20240530 			cmdQuery = cmdQuery & " and c43 <> 'C' ";						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.BuscaFactura()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			/*			if ( nXml(cuboQuery) == 0 ) {				respfunc = 0;			}			*/			respfunc = nXml(cuboQuery);						return respfunc;									} // End Fun - BuscarUUID						// New Func 20240112 by JMM		fun Validar_Fecha_UUID() {			var fech_hoy, fech_ini, fech_limit, strFecha, strTmp, fech_lim_ini, fech_lim_fin, fech_buff;			var aj_dias, respfunc, gapDias,superUsuario,mensajeAdv,mensajeProceso;					respfunc = 0;			//VCSS 03/07/2024 Obtener usuario con nivel para poder hacer operaciones sin validaciones			cmdQuery="SELECT count(*) as superusuario from keplersc.param_opc_usr_sec where sucursal = '" & sucursal_id & "' and opcion = 'Operaciones Sin Validacion GAP' and usuario='" & usuario & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlSuperUsuario");								ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return respfunc;			}			superUsuario = getXmlAtt(cuboQuery,"r0","superusuario");			// { GAP Dias Fecha Gastos }			cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Dias Fecha Gastos'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPDias");								ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return respfunc;			}			if (nXml(cuboQuery) > 0) {				gapDias = getXmlAtt(cuboQuery,"r0","paramvalor");			} else {				frn.message("Hubo problemas para obtener los Parametros [GAP Dias Fecha Gastos] ...","Error","Aceptar");				return respfunc;			}							fech_hoy = sys.date();				strFecha = fnDate("year", fech_hoy) & "/" /*"-"*/;			strTmp = fnDate("month", fech_hoy);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "/" /*"-"*/ & "01";								fech_ini = strFecha;								//fech_hoy = "2024/12/05";  // For testing calc fech 			strTmp = fnDate("month", fech_hoy);			if ( strTmp == 12 ) {				strFecha = fnDate("year", fech_hoy) & "/12/31";								fech_limit = strFecha;							} else {				strFecha = fnDate("year", fech_hoy) & "/";				strTmp = fnDate("month", fech_hoy) + 1;				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "/" & "01";								fech_limit = fnDate("add",strFecha,-1);							} 						//fech_limit = fnDate("add",fech_limit,gapDias);  // Not Apply 			fech_limit = formato_fecha(fech_limit);									if ( gapDias > 0 ) { 				aj_dias = (gapDias /*+ 1*/) * (-1); 			} else {				aj_dias = gapDias /*- 1*/;			}			if ( gapDias == 0 ) {				fech_buff = fech_hoy;			} else {				fech_buff = fnDate("add", fech_hoy, aj_dias);			}			strTmp = fnDate("month", fech_buff);			if ( strTmp == 12 ) {				strFecha = fnDate("year", fech_buff) & "/12/31";								fech_lim_fin = strFecha;							} else {				strFecha = fnDate("year", fech_buff) & "/";				strTmp = fnDate("month", fech_buff) + 1;				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "/" & "01";								fech_lim_fin = fnDate("add",strFecha,-1);							} 								fech_lim_fin = formato_fecha(fech_lim_fin);										strFecha = fnDate("year", fech_lim_fin) & "/";			strTmp = fnDate("month", fech_lim_fin);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "/" /*"-"*/ & "01";						fech_lim_ini = strFecha;			fech_lim_ini = formato_fecha(fech_lim_ini);									if ( strlen( frn.get("k_uuid_fecha") ) == 0 ) {				frn.message("No hay Fecha UUID de Referencia para validar ...","Error","Aceptar");				return respfunc;			} 						strFecha = frn.get("k_uuid_fecha");			strFecha = formato_fecha(strFecha);						//VCSS	INI Validaciones para usuarios normales (no superUsuario)			if (superUsuario != "1"){				if ( fnDate("cmp", strFecha, fech_hoy) > 0 /*strFecha > fech_hoy*/ ) {					mensajeError="La Fecha del UUID, es mayor al dia de hoy ..." & "|" & " " & "|" & " " & strFecha;					mensajeAdv=mensajeAdv & "; " & mensajeError;					frn.message(mensajeError ,"Error","Aceptar");					return respfunc;				} 							if ( fnDate("cmp", strFecha, fech_limit) > 0 /*strFecha > fech_limit*/ ) {					mensajeError = "La Fecha del UUID, fuera de Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;					mensajeAdv=mensajeAdv & "; " & mensajeError;					frn.message(mensajeError ,"Error","Aceptar");					return respfunc;				} 							if ( fnDate("cmp", strFecha, fech_ini) < 0 /*strFecha < fech_ini*/ ) {					if ( fnDate("cmp", strFecha, fech_lim_ini) < 0 /*strFecha < fech_lim_ini*/ ) {						mensajeError = "La Fecha del UUID, es menor al Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;						mensajeAdv=mensajeAdv & "; " & mensajeError;						frn.message(mensajeError ,"Error","Aceptar");						return respfunc;					} else {						if ( fnDate("cmp", strFecha, fech_lim_fin) > 0 /*strFecha > fech_lim_fin*/ ) {						mensajeError = "La Fecha del UUID, fuera del Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;						mensajeAdv=mensajeAdv & "; " & mensajeError;						frn.message(mensajeError ,"Error","Aceptar");						return respfunc;						}					}				}			} 			//VCSS 17/06/2024 INI Evaluacion de fecha de transaccion, las transacciones que se realizan dentro de los primeros 			//dias del mes dentro del gap y la fecha del xml es del mes anterior o anteriores, 			//se registran el día último del mes del xml			var fechaMovto,fechaXml,fechaRefer,mesesDif; 			fechaXml= frn.get("k_uuid_fecha");			fechaXml= formato_fecha(fechaXml);										var diaMovto=fnDate("day", fech_hoy);			var mesMovto=fnDate("month",fechaXml);			//Calcular dierencia en meses del mes actual y del xml				strTmp=fnDate("month",fechaXml);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}										fechaXml=fnDate("year",fechaXml) & "/" & strTmp & "/" & "01";						strTmp=fnDate("month",fech_hoy);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}							fech_hoy=fnDate("year",fech_hoy) & "/" & strTmp & "/" & "01";			//Validar si xml es del mismo mes			if (fnDate("cmp",fechaXml,fech_hoy) == 0){ //Mismo mes				mesesDif=0;			}else{				fech_hoy=fnDate("add",fech_hoy,-1);				fech_hoy= formato_fecha(fech_hoy);				strTmp=fnDate("month",fech_hoy);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}								fech_hoy=fnDate("year",fech_hoy) & "/" & strTmp & "/" & "01";												if (fnDate("cmp",fechaXml,fech_hoy) == 0){					mesesDif=1;				}else{					mesesDif=2;				}			}							fechaMovto= frn.get("k_uuid_fecha");			if(mesesDif==2 && superUsuario==0){				mensajeError = "La Fecha del UUID, " & fechaMovto & " está fuera del Periodo Vigente.";				frn.message(mensajeError ,"Error","Aceptar");				return respfunc;			}			if (mesesDif != 0){				fechaMovto= frn.get("k_uuid_fecha");				strTmp=fnDate("month",fechaMovto);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}											fechaMovto=fnDate("year",fechaMovto) & "/" & strTmp & "/" & "31";				fechaMovto=formato_fecha(fechaMovto);				frn.set("k_fecha",fechaMovto);				frn.message("Los movimientos de meses anteriores se registrarán al último día del mismo mes.","Mensaje","Aceptar");			}			//VCSS 17/06/2024 FIN Evaluacion de fecha de transaccion...			respfunc = 1;			return respfunc;				} // End Fun - Validar_Fecha_UUID				fun formato_fecha(fech) {			var strFech, tmpData;						strFech = fnDate("year", fech) & "/";			tmpData = fnDate("month", fech);			if(strlen(tmpData) == 1){				tmpData = "0" & tmpData;			}			strFech = strFech & tmpData & "/";			tmpData = fnDate("day", fech);			if(strlen(tmpData) == 1){				tmpData = "0" & tmpData;			}			strFech = strFech & tmpData;						return strFech;			} // end fun - formato_fecha		fun BuscarProveedor(/*imodo*/){			var xmlProd;						// Added 20240119			var NewProv, ST_FUN, continua, resultado, mensaje, xmlAlta;			// Added by JMM 20240229 			var vProvPago;							sucursal_id = frn.get("k_sucn",-1,1);						// UPD 20240111			//proveedor_id = frn.get("k_clave");			proveedor_id = frn.get("k_rfc");						LimpiaDatosProv();			// 20240111 ... Los Ejecuta en : LimpiaDatosProv()			/*			LimpiaDatosDoc();			LimpiaTotalesDoc();			*/			//Added 20240131			frn.set("k_rfc", proveedor_id);						if (strlen(frn.get("k_rfc"/*"k_clave"*/)) == 0) {				return;			}						// Commented 20240111 			/*			if (strlen(frn.get("k_refer")) > 0) {				refer_id = frn.get("k_refer");			} else {				frn.set("k_fecha_exp", "");			}			*/							cmdQuery = "select c2 as k_clave, /*c10 as k_rfc,*/ c3 as k_nombreprov, c4 as k_calleprov, c5 as k_coloniaprov, c6 as k_poblacionprov, c27 as k_cpprov, c16 as k_plazo " &									"from keplersc.kdxd where keplersc.full_replace(c10,'-','') /*c2*/='" & proveedor_id & "'" ;			//and c1 ='" & sucursal_id & "' ... TO DO : NO VIENE DATO DE LA SUCURSAL A NIVEL DEL PROVEEDOR AUNQUE ESTA EL CAMPO ...			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.BuscaProveedor()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){							// Addapted 20240111				//frn.setPos("k_clave");				frn.set("k_clave","No Existe ...");  							if (/*imodo == 1*/ strlen(NewProvId) > 0 ) { 									frn.message("El proveedor no existe","Error","Aceptar");					return;									} else {									frn.message("El Proveedor No existe ..." & "|" & " " & 					"|" & " " & "Nombre : " & nombre_uuid &					"|" & " " & "R.F.C. : " & rfc_uuid & 					"|" & " " & "Fecha Docto. Seleccionado : " & fecha_uuid & 					"|" & " " & "Total Docto. Seleccionado : " & total_uuid & 					"|" & " " & "|" & " " & 					"Puede crearse Automaticamente, se recomienda complementar los Datos.", "Info !!!","Aceptar");					continua = frn.message("¿Continuar con el Alta del Proveedor?","Atencion !!!",2);					if (continua == 0){										return;										}	else {										setXml(xmlAlta,"sucursal",sucursal_id);						setXml(xmlAlta,"nombre",nombre_uuid);						setXml(xmlAlta,"rfc",rfc_uuid);											frn.lib("libGeneral.kpl","FileSave",xmlAlta,fileSavePath & "\XmlAltaProv_To_Send");											cmdQuery="SELECT * FROM keplersc.uuid_tools_alta_proveedor('<document>" & getXmlStr(xmlAlta,"EOF:13_10") & "</document>')";						rstXml(cuboQuery);											cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvtalltotscrud.Alta_Proveedor");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlAltaProv_Result");											resultado = getXml(cuboQuery,"resultado");						mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok) {							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;							}						if(resultado &= "1") {							NewProv = mensaje;							//frn.dialog("cat_crud_proveedores","Modificar"/*accion*/, NewProv/*param1*/,"UUID" /*param2*/);							//prov_data_upd(NewProv);							return NewProv/*1*/;						} else {							// Added 20240130 (else section)							frn.set("k_clave","");							frn.message(mensaje,"Error","Aceptar");							return;						}										} // End ... If ( continua )								} // End ... If ( imodo )							}						//Plazo();				rstXml(xmlProd);			frn.lib("libGeneral.kpl","FileSave",cuboQuery/*xmlAlta*/,fileSavePath & "\XmlAltaProv_To_Get");			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");			frn.setX(xmlProd);						// Commented by JMM 20240508 N.A.			/*			// Added by JMM 20240229 			vProvPago = trim(frn.get("k_clave_pago"));			if ( strlen(trim(frn.get("k_clave"))) > 0 ) {				if ( strlen( vProvPago ) == 0 ) {					frn.set("k_clave_pago", frn.get("k_clave"));					BuscarProvPago();				} else {					if ( CheckProvPago() == 0 ) {						frn.set("k_clave_pago", frn.get("k_clave"));						BuscarProvPago();						}				}			}			*/						Plazo(); // Moved 20240131				} // End : BuscarProveedor() 						// New Func 20240120 by JMM		fun prov_data_upd(Prov){			frn.dialog("cat_crud_proveedores","Modificar"/*accion*/, Prov/*IdProv*/,"UUID" /*param2 UUIDCtrl*/,"BuscarProveedor()"/*paramRutina*/);		}						// -----------------------------  END : SECTION CODE ADDED BY JMM FOR UUID IMPLEMENTING 20240508 TO 202405XX  ------------------------------                fun Mostrar_DOC(nFolio) {				var folio, refer, xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle, cuboDOC;				var tmpStr, tmpXml, contDet, xmlCurDet, xmlDetConv;				var flagfun;				var fech_buff;				// Guarda Datos para Busqueda 				sucursal_id = frn.get("k_sucn",-1,1);								folio = nFolio;										//Added 20230109				fech_buff = frn.get("k_fecha");													// Added 20221206											frn.set("k_st","");				frn.setAtt("k_st", "visible", "N");															// Limpia Pantalla				//ModoBuscar(); -- Commented -> verificar si aqui debe ir o No 									setXml(xmlRequest,"document","sucursal_id",sucursal_id);				setXml(xmlRequest,"document","genero", gen_doc);				if (tip_ope &= "B") {					setXml(xmlRequest,"document","naturaleza", "A");				} else {					setXml(xmlRequest,"document","naturaleza", nat_doc);				}				setXml(xmlRequest,"document","grupo", gpo_doc);				setXml(xmlRequest,"document","tipo", tip_doc);				setXml(xmlRequest,"document","folio", folio);				if (tip_ope &= "B") {					setXml(xmlRequest,"document","estatus", "20");				}						//Se incluye un validacion para considerar en la seleccion del registro el Estatus segun la Operacion ... 				/*				if (tip_ope &= "CB") {				} else {					if (tip_ope &= "B") {							cmdQuery = "select tdm1.c10 as cve_proveedor, txd.c3 as nomb_proveedor, tdm1.c6 as folio_compra, tdm1.c9 as fecha " &							", tdm1.c11 as ref_inventario from keplersc.kdm1 as tdm1 " & 							"inner join keplersc.kdxd as txd on txd.c2 = tdm1.c10 " & 							"inner join keplersc.kdinf as inf on inf.c1 = tdm1.c1 and inf.c2 = tdm1.c100 " &							"where tdm1.c2 = 'X' and tdm1.c3 = 'A' and tdm1.c4 = 7 and tdm1.c5 = " & frn.get("k_tipon",-1,4) & " and tdm1.c1 = '" & frn.get("k_sucn",-1,1) & "' " & 							"and inf.c31 = 20";					} else {										}				}				*/					// /*				cmdQuery = "select * from keplersc.autos_com_nvo_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				frn.lib("libGeneral.kpl","FileSave",xmlRequest, fileSavePath & "\ComVhcUsdcrud_xml_RequestFromK80ToPostgreSql_buscar");								rstXml(cuboDOC);				cuboDOC = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ComVhcUsdcrud.MostrarDOC()");				frn.lib("libGeneral.kpl","FileSave",cuboDOC, fileSavePath & "\ComVhcUsdcrud_xml_GottenOfPostgreSql_buscar");								ok = getXmlAtt(cuboDOC,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboDOC,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}									LimpiaEncabezado();										//Datos de encabezado				tmpStr=getXmlAtt(cuboDOC,"r0","autos_com_nvo_sel");				rstXml(xmlEncabezado);				tmpStr=delScpScn(tmpStr);				setXmlStr(xmlEncabezado,tmpStr);				tmpXml = getXml(xmlEncabezado,"row");				frn.lib("libGeneral.kpl","FileSave",tmpXml , fileSavePath & "\ComVhcUsdcrud_xml_Converted_Enc_buscar");								frn.setX(tmpXml);				if(nXml(tmpXml) == 0){					frn.message("El Registro de la Compra : " & folio & ", No se encontró ...","Error","Aceptar");					//LimpiaEncabezado(); 					return;								}														// Added 221206				if (tip_ope &= "C") {					flagfun = Es_Cancelado();					if ( flagfun == 1 ) {						frn.set("k_st","CANCELADO");						frn.setAtt("k_st", "visible", "Y");					}				}										// Added 230109				if (tip_ope &= "B") {					frn.set("k_fecha",fech_buff);				}														//Added by JMM 202240627				var vretisr = frn.get("k_uuid_retisr");				var vretiva = frn.get("k_uuid_retiva");				var sumrets = vretisr + vretiva;				frn.set( "k_sumrets", sumrets );				var iva = frn.get( "k_iva");				var tot = frn.get( "k_monto");				var vsubt = tot - iva + sumrets;				frn.set( "subt", vsubt );							frn.set( "k_importe", vsubt ); // Obj added for this option 								//Commented and Adapted by JMM 20240627				/*				//Added by JMM 20240509				var total, subtotal, iva, porc_iva;				total = frn.get("k_monto");				iva = frn.get("k_iva");				subtotal = total - iva;				*/				var porc_iva;				if ( vsubt/*subtotal*/ > 0 ) {					porc_iva = (iva * 100) / vsubt/*subtotal*/;				} else {					porc_iva = 0;				}				frn.set("k_porciva", porc_iva);										//Eval_Data_Row();				Get_Data_Row();												return;									   } //End MostrarDOC()			fun Es_Cancelado() {				var dato_id, err_msg;							err_msg = "";				dato_id = "";							cmdQuery = "select tdm1.c6 as folio_baja from keplersc.kdm1 as tdm1 " & 						"where tdm1.c2 = 'X' and tdm1.c3 = 'D' and tdm1.c4 = 7 and tdm1.c5 = " & frn.get("k_tipon",-1,4) & " and tdm1.c1 = '" & frn.get("k_sucn",-1,1) & "' " & 						"and tdm1.c36 = 'A' and tdm1.c37 = 7 and tdm1.c38 = " & frn.get("k_tipon",-1,4) & " and tdm1.c39 = '" & frn.get("k_folio") & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comvhcnvocrud.Es_Cancelado()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\comvhcnvocrud.Es_Cancelado");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "folio_baja");								if ( strlen(dato_id) > 0 ) {					return 1;				} else { 					return 0;				}				} //End Es_Cancelado()		   		   //Calcula la fecha de pago, y las condiciones de pago en base al plazo		   fun Plazo(imodo){ 				frn.set("k_vence", fnDate("addC",frn.get("k_fecha"), frn.get("k_plazo"))); //Suma días comerciales				var cond = frn.get("k_plazo") & " días fecha factura";				if (frn.get("k_plazo") == 0) cond = "Pago de contado";				frn.set("k_cond",cond);  				if (imodo == 1) {					Eval_Data_Row();				}			}			  			fun CalculaTotales(imodo) {				var subtotal = 0, iva = 0, /*holdback = 0,*/ total = 0;				var st_ok;				var porc_iva, tot_uuid, strTotal, vdiferencia, gapMonto; // Added by JMM 20240508				// Added by JMM 20240627 				var retisr=0, retiva=0, sumrets=0;				st_ok = "X";								subtotal = frn.get("k_importe");								// commented by JMM 20240508				/*				if ( frn.get("k_porciva") > 0 ) {					iva = subtotal * (frn.get("k_porciva")/100);				} else {					iva = frn.get("k_iva");				}				*/								frn.set("subt",subtotal);								// Added by JMM 20240627				retisr = frn.get("k_uuid_retisr");				retiva = frn.get("k_uuid_retiva");				sumrets = retisr + retiva;							// Added by JMM 20240228				iva = frn.get("k_uuid_impuesto");				tot_uuid = frn.get("k_uuid_monto");							if ( subtotal > 0 ) {					porc_iva = (iva * 100) / subtotal;					total = subtotal + iva - sumrets; // Adapted by JMM 20240627				} else {					porc_iva = 0;					total = 0; // Adapted by JMM 20240627					}									/*total = subtotal + iva;*/ // Moved here by JMM 20240508, commented by JMM 20240627								// Added by JMM 20240228				frn.set("k_iva",iva);				frn.set("k_porciva",porc_iva);								// Commented by JMM 20240508				/*frn.set("k_iva",iva);*/								frn.set("k_monto",total);								frn.set("k_sumrets",sumrets); // Added by JMM 20240627								if ( total > 0 && subtotal > 0 ) { 					// { GAP Monto Gastos }					cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Monto Gastos'";					rstXml(cuboQuery);									cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidarDatos()");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPMonto");										ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						/*						resVal=0;						return;						*/					}					if (nXml(cuboQuery) > 0) {						gapMonto = getXmlAtt(cuboQuery,"r0","paramvalor");					} else {						frn.message("Hubo problemas para obtener los Parametros [GAP Monto Gastos] ...","Aviso !!!"/*"Error"*/,"Aceptar");						/*						resVal=0;						return;						*/						gapMonto = 0;					}									strTotal = frn.get("k_monto");					vdiferencia = (strTotal-tot_uuid/*total_uuid*/);					if (vdiferencia < 0){						vdiferencia = vdiferencia *(-1); 					}										if ( vdiferencia > gapMonto /*0.1*/ ) {						/*						resVal=0;						frn.message("El importe total del TOT no corresponde al de la factura.","Error","Aceptar");						return;						*/						st_ok = "Total <> Total UUID | ";					} else {						st_ok = "";					} 									} else {					if ( subtotal == 0 ) { st_ok = "Importe = 0 | "; } 					if ( total == 0 ) { st_ok = "Total = 0 | "; } 				}								if ( imodo == 1 ) { 					Eval_Data_Row();					return; 				} else { 					return st_ok;				}						}			// ZONA	CODIGO REPORTE(S) 						fun IniParams(){//Inicializa parámetros de impresión. Pueden ser cambiados por el usuario final mediante menú: Archivo -> Configurar Página				frn.set("param_paper","letter");	//Tamaño de papel predefinido:	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tamaño de papel personalizado	"size=21.59,27.94cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//Márgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0");	//Escala de impresión (1=100 por ciento)	"F=1,1"				frn.set("param_landscape","N");	//Orientación	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"				frn.set("param_emp","L");	//Posición de "Razón social"(izq,der,cen)	@emp=L|R|C"			}						fun setRepPage() {//Establece los parámetros finales de impresión.				var paper="paper=" & frn.get("param_paper");				var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,"landscape=N"/*lndsp*/,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Ejecuta_Reporte() {							 // Commment 20121201				//IniParams(); //Inicializa parámtros de impresión entre otros						sucursal = frn.get("k_sucn",-1,1);				tipo_auto = "USADO"; // "NUEVO" / "USADO"						if ( frn.get("k_monto") > 0 ) { Reporte(); }						} /* END Func Ejecuta_Reporte() */						fun Reporte() {							// Our Vars				var compania, titrep;				var contProd, contDet, tmpStr ,xmlDet, xmlCurDocto;								//var folio;				var p_fecha, var_fecha;				var p_subtotal, p_utilidad, p_perce, p_costo, p_total, p_iva;				var gt_subtotal, gt_utilidad, gt_perce, gt_costo, gt_total, gt_iva;								//vars datos				var v_cvevhc, v_ped, v_fech, v_lugar, dato_id;								//Obtener datos generales				kdb.kde("KDE");//Configuracion del servidor				kdb.exec();				compania = kdb.get("KDE","1");									// Se define el formato a usar y se liga a la variable del reporte "rep"				rep.rst(); // 20121201				IniParams(); // 20121201				kdb.readPage("datFto","comvhccrudfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				//rep.rst(); // Commment 20121201				setRepPage();//Establece los parámetros finales de impresión(rep.page(...);), pues pueden haber cambiado por el usuario 				//Da valor a los inputs del reporte(rep.set();), e indica la ejecución de "grupos de renglones de impresión" (rep.exe();)								if ( ( tip_ope_original &= "A" && tip_ope &= "C" ) || tip_ope_original &= "C" ) {					titrep = "Alta de Factura de Compra - Auto Usado"; 					rep.set("c_foliotx","Folio Compra : ");				} else {					titrep = "Baja de Factura de Compra - Auto Usado";					rep.set("c_foliotx","Folio Baja : ");					rep.set("c_folioreftx","Folio Compra : ");					rep.set("c_folioref",frn.get("k_folio_ref"));				}								// Added 20221206 				if ( frn.get("k_tipopagos") &= "S" ) { rep.set("c_anexotx","Traspaso"); }								rep.set("fecha",sys.date());				rep.set("hora",sys.time());				rep.set("nombreempresa",compania);				rep.set("tituloreporte",titrep);								rep.set("titulost",frn.get("k_st")); // Added by JMM 20240708						rep.exe("encabezado");							dato_id = "";				cmdQuery = "select c2 invent, c13 cvevch, c26 ped, c27 fech, c28 lugar from keplersc.kdinf where c1 = '" & frn.get("k_sucn",-1,1) & "' and c2 = '" & frn.get("k_claveinv") & "'" & " and c21 = '" & tipo_auto & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comvchnvocrud.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\comvchnvocrud_data_rpt");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "invent");				if ( strlen(dato_id) == 0 ) {				} else {					v_cvevhc = getXmlAtt(cuboQuery,"r0", "cvevch");					v_ped = getXmlAtt(cuboQuery,"r0", "ped");					v_fech = getXmlAtt(cuboQuery,"r0", "fech");					v_lugar = getXmlAtt(cuboQuery,"r0", "lugar");				}								rep.set("c_cvevhc",v_cvevhc);				rep.set("c_ped",v_ped);				rep.set("c_ped_fech",v_fech);				rep.set("c_ped_lugar",v_lugar);								rep.set("c_folio",frn.get("k_folio"));								rep.set("c_invent",frn.get("k_claveinv"));				rep.set("c_serie",frn.get("k_serievehiculo"));								rep.set("c_fact",frn.get("k_kilometraje"));				rep.set("c_fact_fech",frn.get("k_fecha"));								rep.set("c_prov_cve",frn.get("k_clave"));				rep.set("c_prov_name",frn.get("k_nombreprov"));				rep.set("c_prov_calle",frn.get("k_calleprov"));				rep.set("c_prov_col",frn.get("k_coloniaprov"));				rep.set("c_prov_pob",frn.get("k_poblacionprov"));				rep.set("c_prov_rfc",frn.get("k_rfc"));								rep.set("c_prod",frn.get("c_modelo"));				rep.set("c_prod_name",frn.get("c_descrip"));				rep.set("c_importe",frn.get("k_importe"));						rep.exe("detalle");								rep.set("c_subt",frn.get("subt"));				rep.set("c_iva",frn.get("k_iva"));				rep.set("c_ret",frn.get("k_sumrets")); /*Added by JMM 20240708*/				rep.set("c_tot",frn.get("k_monto"));								rep.exe("total");								rep.set("c_cmnt1",frn.get("k_coment"));				rep.set("c_cmnt2",frn.get("k_coment2"));				rep.set("c_cmnt3",frn.get("k_coment3"));									rep.exe("coments");								//Modos de impresión 				rep.win(); //Muestra la vista previa de la impresión. A partir de la vista previa (Preprint) se decide si se imprime o no.				//rep.print("\\192.168.1.100\HPLaserJet"); //Envía el reporte directamente a una impresora, sin mostrar la vista previa.				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresión. No muestra la vista previa.				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardará el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html										} /* END Func Reporte() */									// END : ZONA	CODIGO REPORTE(S)										} // End of class Main			</script></pag>