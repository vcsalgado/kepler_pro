<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="0,0,10,10" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<tab/><txt clr="0,0,0" fnt="Arial,25" id="textTmkt">Atender Llamada</txt><br/>		<tab/><hLine dim="81,1,0,0" clr="0,0,0"/>		<br/><br/>		<tab/><txt>Sucursal: </txt>		<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="35,36" bclr="255,255,255" 			brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y" OnChange="borrar()" tooltip="Sucursal"/>		<!--			<tab n="2"/><sp n="2"/><bot id="bot_nuevo_cli" dim="15,0" brdr="5" text="Nuevo Cliente" OnEnter="nuevo_cliente()"/>			<sp/><bot id="bot_nueva_serie" dim="15,0" brdr="5" text="Nueva Serie" OnEnter="nueva_serie()"/>		-->		<br/><br/><tab/>			<br/>		<tab/>							<grp id="grp_criterio" dim="71,6,10,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Clientes"><br/>				<sp n="3"/>			<ratio id="Rd_cli" dim="2,16" clr="64,64,64" bclr="255,255,255" default="1" OnChange = "borrar()"/>			<txt clr="0,58,112">Cliente:</txt>			<inp id="input_cli" dim="15,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" OnChange = "ActivaRd(C)" clrBrdr="255,255,255" 			tooltip="Criterio de busqueda, Nuevo F10, Modificar F11" OnF10="edicion_cliente(Nuevo)" OnF11="edicion_cliente(Modificar)"/>			<sp n="3"/>			<ratio id="Rd_serie" dim="2,16" clr="64,64,64" bclr="255,255,255" OnChange = "borrar()"/>			<txt clr="0,58,112">Serie:</txt>			<inp id="input_serie" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="17" OnChange = "ActivaRd(S)" clrBrdr="255,255,255" 			tooltip="Criterio de busqueda, Nuevo F10, Modificar F11" OnF10="edicion_vin(Nuevo)" OnF11="edicion_vin(Modificar)"/>			<sp n="3"/>			<ratio id="Rd_placa" dim="2,16" clr="64,64,64" bclr="255,255,255" OnChange = "borrar()"/>			<txt clr="0,58,112">Placa:</txt>			<inp id="input_placas" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="10" OnChange = "ActivaRd(P)" clrBrdr="255,255,255" tooltip="Criterio de busqueda"/>		</grp>		<grp id="grp_buscar" dim="10,6,10,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit=" "><br/>							<sp n="3"/>				<img id="img_buscar_clientes" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0"  modify="Y"/><br/>		</grp><br/>		<tab/>		<grp id="grp_clientes" dim="81,42,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">					<sp n="3"/>			<tbl id="tbl_clientes" dim="110,13" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" 				clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" insdel="N" modify="N" Reorder="N"				OnEnter="sel_series()" OnMouseD="sel_series()">								<col id="clave" name="Clave"/>				<col id="nombre" name="Nombre"/>				<col id="telefono" name="Telefono"/>				<col id="movil" name="Movil"/>				<col id="mail" name="Correo Electronico"/>							</tbl>			<br/>							<br/>					<sp n="3"/>			<tbl id="tbl_series" dim="110,13" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" 				clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" insdel="N" modify="N" Reorder="N"				OnEnter="atender_llamada()" OnMouseD="atender_llamada()">								<col id="serie" name="Serie"/>				<col id="marca" name="Marca"/>				<col id="modelo" name="Modelo"/>				<col id="placas" name="Placas"/>				<col id="anio" name="Anio"/>				<col id="kilometraje" type ="number"  name="Kilometraje"/>				<col id="cliente" type ="capital"  name="Cliente" visible="S"/>				<col id="nombre" type ="capital"  name="Nombre" visible="S"/>							</tbl>				<br/><br/>			<sp n="3"/><bot id="bot_contacto" dim="20,0" brdr="5" text="Atender Llamada" OnEnter="atender_llamada()"/>					</grp>				</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,sys;			var usuario,suc_usuario,rol_usuario,asterisco;			var resMensaje, cubo, cmd, ok,mensajeError,xmlRequest,cuboResultados;			var selOperacion,RdCriterioCli,RdCriterioSerie,RdCriterioPlaca;			fun Main() {				frn=new FRNT;				kdb=new KDB;				sys=new SYS;				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";								Inicializa();			}									fun Inicializa(){				//Llena combo de sucursales				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmktview.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_sucN",getXml(cubo));				}						fun borrar(){					RdCriterioCli = frn.get("Rd_cli");					RdCriterioSerie = frn.get("Rd_serie");					RdCriterioPlaca = frn.get("Rd_placa");						frn.rst("tbl_clientes");					frn.rst("tbl_series");					if (RdCriterioCli &= "1") {							frn.set("input_serie","");						frn.set("input_placas","");					}					if (RdCriterioSerie &= "1") {							frn.set("input_cli","");						frn.set("input_placas","");					}					if (RdCriterioPlaca &= "1") {							frn.set("input_serie","");						frn.set("input_cli","");					}			}                     							fun ActivaRd(Rd){				if (Rd &= "C"){					frn.set("Rd_cli","1");				}				if (Rd &= "S"){					frn.set("Rd_serie","1");				}				if (Rd &= "P"){					frn.set("Rd_placa","1");				}				borrar();				CtrlColCriterio();			}			fun CtrlColCriterio(){				if (RdCriterioCli &= "1") {				//Busca por cliente					frn.setAtt("tbl_series", "visible", "N", "cliente");					frn.setAtt("tbl_series", "visible", "N", "nombre");				}				if (RdCriterioSerie &= "1") {				//Busca por serie					frn.setAtt("tbl_series", "visible", "S", "cliente");					frn.setAtt("tbl_series", "visible", "S", "nombre");				}				if (RdCriterioPlaca &= "1") {				//Busca por placa					frn.setAtt("tbl_series", "visible", "S", "cliente");					frn.setAtt("tbl_series", "visible", "S", "nombre");				}			}						fun Buscar() {				var criterio;				RdCriterioCli = frn.get("Rd_cli");				RdCriterioSerie = frn.get("Rd_serie");				RdCriterioPlaca = frn.get("Rd_placa");				if (RdCriterioCli &= "0" && RdCriterioSerie &= "0" && RdCriterioPlaca &= "0"){					frn.message("Debes seleccionar un criterio de busqueda","Error","Aceptar");					return;				}				if (RdCriterioCli &= "1") {				//Busca por cliente					criterio = frn.get("input_cli");										cmd= "select c2 as clave, c3 as nombre, c7 as telefono, c9 as movil, c11 as mail from keplersc.kdud where (c2 like upper('%" & criterio & "%') or c3 like upper('%" & criterio & "%'))";					cmd = cmd & " or (c35 like upper('%" & criterio & "%') or c33 like upper('%" & criterio & "%')) ";					cmd = cmd & " or (c34 like upper('%" & criterio & "%') or c30 like upper('%" & criterio & "%')) ";										cmd = cmd & " and c1='" & frn.get("k_sucN", -1, 1) & "'";									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_reactivo.Buscar()");											frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}										if (nXml(cuboResultados) == 0){						frn.message("Sin Resultados","Error","Aceptar");					} else {						frn.set("tbl_clientes",cuboResultados );					}				}				if (RdCriterioSerie &= "1") {				//Busca por serie					criterio = frn.get("input_serie");										cmd= "select ser.c1 as serie, ser.c2 as marca, ser.c3 as modelo, ser.c8 as placas, ser.c11 as anio, ser.c12 as kilometraje, ser.c9 as cliente, cte.c3 as nombre" &  						" from keplersc.kdserie ser" &						" inner join keplersc.kdud cte on cte.c1='" & frn.get("k_sucN", -1, 1) & "' and cte.c2 = ser.c9" &						" where ser.c4 like '%" & criterio & "%'";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_reactivo.Buscar()");											frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}										if (nXml(cuboResultados) == 0){						frn.message("Sin Resultados","Error","Aceptar");					} else {						frn.set("tbl_series",cuboResultados );											}				}				if (RdCriterioPlaca &= "1") {				//Busca por placa					criterio = frn.get("input_placas");										cmd= "select ser.c1 as serie, ser.c2 as marca, ser.c3 as modelo, ser.c8 as placas, ser.c11 as anio, ser.c12 as kilometraje, ser.c9 as cliente, cte.c3 as nombre" &  						" from keplersc.kdserie ser" &						" inner join keplersc.kdud cte on cte.c1='" & frn.get("k_sucN", -1, 1) & "' and cte.c2 = ser.c9" &						" where ser.c8 like '%" & criterio & "%'";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_reactivo.Buscar()");											frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}															if (nXml(cuboResultados) == 0){						frn.message("Sin Resultados","Error","Aceptar");					} else {						frn.set("tbl_series",cuboResultados );											}				}								}				fun sel_series(){				var criterio;				criterio = frn.get("tbl_clientes", -1, "clave" );								if (criterio &= ""){					return; 				}								cmd= "select c1 as serie, c2 as marca, c3 as modelo, c8 as placas, c11 as anio, c12 as kilometraje from keplersc.kdserie where c9='" & criterio & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_reactivo.Buscar()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("tbl_series",cuboResultados );							}						fun atender_llamada(){				var cli_sel,serie_sel,mensaje,tot,respuesta,suc,resultado;				if (RdCriterioCli &= "1") {			//Para cliente					cli_sel = frn.get("tbl_clientes", -1, "clave" );					serie_sel = frn.get("tbl_series", -1, "serie" );									if (cli_sel &= ""){						frn.message("Debes seleccionar un cliente.","Error","Aceptar");						return;					}										mensaje = "¿ Se creara un contacto de atender llamada para el cliente: " & cli_sel ;					if (serie_sel &= ""){						cmd= "select c1 from keplersc.kdserie where c9='" & cli_sel & "'";						cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_reactivo.atender_llamada()");						tot = nXml(cubo);							if (tot > 0){							frn.message("El cliente seleccionado tiene series, debes seleccionar una.","Error","Aceptar");							return;						}					}else{								mensaje = mensaje & " y la serie: " & serie_sel ;					}					mensaje = mensaje & " ¿ seguro quieres continuar ?";									respuesta = frn.message(mensaje ,"Atencion",2);					if (respuesta == 0){						return;					}										suc = frn.get("k_sucN", -1, 1);									setXml(xmlRequest ,"k_sucn", "r1", suc  );					setXml(xmlRequest ,"usuario",usuario);					setXml(xmlRequest ,"serie", serie_sel );					setXml(xmlRequest ,"cliente", cli_sel );					setXml(xmlRequest ,"nombre_cli", frn.get("tbl_clientes", -1, "nombre") );				}				if (RdCriterioSerie &= "1" || RdCriterioPlaca &= "1") {		//Para serie y placas						cli_sel = frn.get("tbl_series", -1, "cliente" );					serie_sel = frn.get("tbl_series", -1, "serie" );									if (serie_sel &= ""){						frn.message("Debes seleccionar una serie.","Error","Aceptar");						return;					}										mensaje = "¿ Se creara un contacto de atender llamada para el cliente: " & cli_sel & " y la serie: " & serie_sel & "  ¿ seguro quieres continuar ?";														respuesta = frn.message(mensaje ,"Atencion",2);					if (respuesta == 0){						return;					}										suc = frn.get("k_sucN", -1, 1);									setXml(xmlRequest ,"k_sucn", "r1", suc  );					setXml(xmlRequest ,"usuario",usuario);					setXml(xmlRequest ,"serie", serie_sel );					setXml(xmlRequest ,"cliente", cli_sel );					setXml(xmlRequest ,"nombre_cli", frn.get("tbl_series", -1, "nombre") );				}																					var query= "select c2 from keplersc.kdtmktser2 where c1='" & frn.get("k_sucN", -1, 1) & "' and c20 ='" & cli_sel  & "' and c7=50 and c8=0 and c9=0 ";				var msg = "el cliente " & cli_sel;								if (serie_sel &! ""){					query = query & " and c14='" & serie_sel & "'";					msg = msg & " y la serie " & serie_sel ; 				}				var cb = frn.lib("libGeneral.kpl","EjecutarSqlSel",query,"tmkt_reactivo.atender_llamada()");									frn.lib("libGeneral.kpl","FileSave",cb,"C:\Basura\cb ");								var tot_cb = nXml(cb);								if (tot_cb > 0){					frn.message("Ya existe un contacto de antender llamada pendiente para " &  msg &  ", busquelo en Atender Contacto","Error","Aceptar");					return;				}													frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest");								cmd="SELECT * FROM keplersc.tmkt_registrar_llamada('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"tmkt_reactivo.atender_llamada");										frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");							resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var folio_llamada = getXml(cubo ,"adicionales");								var parametros="S," & suc &","&folio_llamada & ",Llamada" ; //Accion de Seguimiento				frn.configSet("temp","parametros",parametros);				frn.open("sertmkt",4);					}						fun nuevo_cliente(tipo_edicion){							frn.dialog("cat_cli_crud",tipo_edicion,"x","s","input_cli");				borrar();			}						fun nueva_serie(tipo_edicion){							frn.dialog("cat_serie_crud",tipo_edicion,"x","s","input_serie");				borrar();			}			fun edicion_cliente(tipo_edicion){				var strCliente = frn.get("input_cli");				if (tipo_edicion &= "Modificar" && strCliente &= ""){					frn.message("Debe especificar un cliente para modificar","Error","Aceptar");					return ; 				}				frn.dialog("cat_cli_crud",tipo_edicion,"x","s","input_cli");				borrar();			}									fun edicion_vin(tipo_edicion){						var strSerie = frn.get("input_serie");				if (tipo_edicion &= "Modificar" && strSerie &= ""){					frn.message("Debe especificar una serie para modificar","Error","Aceptar");					return ; 				}				frn.dialog("cat_serie_crud",tipo_edicion,"x","s","input_serie");				borrar();			}									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}									}	</script></pag>