<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,20" bclr="192,205,213" unfont="0"	 tit="Detalle de Comisiones" clrBrdr="0,97,181">		<br/><tab/><txt fnt=",22" clr="0,0,0">Comisiones de Vendedores</txt>		<br/>		<tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>				<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="40,13,7,12" tit="Criterio" fnt="Arial,16" unfont="0">					<br/>						<sp/><txt>Sucursal: </txt><cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="45,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y" modify="Y"/>			<br/>							<br/>							<sp/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">A&#241;o</txt><sp/>			<inp id="anio" clr="64,64,64" clrBrdr="255,255,255"  dim="6,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nc="2" min="20" available="Y" modify="Y" just="R" fmt="5" nd="0" max="35"/>			<tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Mes</txt>			<sp/>			<inp id="mes" clr="64,64,64" clrBrdr="255,255,255"  dim="6,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nc="2" min="1" max="12" available="Y" modify="Y" OnChange="CambiaMes()" tooltip="Mes de trabajo(Si desea trabajar en otro mes, cambiar la fecha)"/><br/><br/>			<sp/>			<bot id="btnGenerar" dim="15,0" brdr="5" text="Generar" hk="G" OnEnter="Generar()"/><tab n="3"/>			<bot id="btnRepMen" dim="16,0" brdr="5" text="Rep. Mensual" OnEnter="RepMensual" visible="N"/>			<bot id="btnRepQuin" dim="15,0" brdr="5" text="Rep. Quincenal" OnEnter="RepQuincenal" visible="N"/>			<br/>		</grp>			</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,sys;			var cmdQuery, cuboQuery, ok, mensajeError;			var usuario, rol_usuario, suc_usuario, anio_contable, anio,mes, fileSavePath, asterisco ;						fun Main() {				frn=new FRNT;				kdb=new KDB;				sys=new SYS;				kdb.connect();								anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				fileSavePath = "C:\Basura";				inicializa();							}						fun inicializa(){				kdb.date("SrvDate");	//Fecha del servidor				kdb.kde("KDE");//Configuracion del servidor				kdb.exec();							mes=fnDate("month",kdb.get("SrvDate"));				anio=fnDate("year",kdb.get("SrvDate"));				anio=mid(anio,2);				frn.set("anio",anio);				frn.set("mes",mes);											//Llenar combo sucursales				var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));								}									fun Generar() {				var xmlRequest,sucursal_id;				sucursal_id=frn.get("k_sucn",-1,1);				anio=frn.get("anio");				mes=frn.get("mes");				setXml(xmlRequest,"document","k_sucn",sucursal_id);				setXml(xmlRequest,"document","anio",anio);				setXml(xmlRequest,"document","mes",mes);								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlComVendedoresGenerar");				cmdQuery="select * from keplersc.com_ventas_generar('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cuboQuery=frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"com_vendedores_generar().Generar()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.message("Comisiones generadas","Mensaje","&Aceptar");			}		}	</script></pag>