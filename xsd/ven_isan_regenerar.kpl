<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte Auxiliar">	<grp dim="1,-1,10,20" brdr="0,0" bclr="192,205,213" clr="0,58,112" fnt="Arial,16" unfont="0" OnF1="Ventana(rep_Hlp)">	<tab n="1"/>	<txt fnt=",22" clr="0,0,0">Regeneraci&#243;n ISAN</txt><br/><tab/>	<hLine dim="0,1" clr="0,0,0"/> 	<br/> 	<br/><tab n="1"/>		<grp dim="40,22,10,5" bclr="255,255,255" tit="Criterio de proceso" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">			<tab/><txt>Sucursal: </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="25,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/>			<br/>			<grp dim="30,10,10,5" bclr="255,255,255" tit="" brdr="0,0" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">        				<tab/><txt>Fecha inicial</txt><tab n="2"/>				<edt id="fecha_ini" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnButton="Dialog(0,_ks_fecha,fecha_ini)" nc="11" OnChange="AjustaFechaFin(I)"/>				<br/><tab/><txt>Fecha final</txt><tab n="2"/>				<edt id="fecha_fin" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnButton="Dialog(0,_ks_fecha,fecha_fin)" nc="11" OnChange="AjustaFechaFin(F)"/>			</grp>			<tab/>							<grp dim="10,10,10,5" bclr="255,255,255" tit="" brdr="0,0" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">										<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()"  available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			</grp>		</grp>			</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys, year;			var cubo, ok, cmd, mensajeError, xmlRequest;					var	suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;				kdb.connect();				kdb.open("i,kdini");								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";								Inicializa();			}				fun AjustaFechaFin(origen){				var fecha_ini, fecha_fin, dif, mes_fin, mes_ini, anio_ini, anio_fin;				fecha_ini = frn.get("fecha_ini");				fecha_fin=frn.get("fecha_fin");				mes_ini = mid(fecha_ini,5,2);				mes_fin = mid(fecha_fin,5,2);				anio_ini = mid(fecha_ini,2,2);				anio_fin = mid(fecha_fin,2,2);												dif=fnDate("dif",fecha_fin,fecha_ini);				if (origen&="I"){						frn.set("fecha_fin",sys.date(anio_ini,mes_ini,31));				}else{					if (dif < 0){						frn.set("fecha_fin",sys.date(anio_ini,mes_ini,31));										}						}			}						fun valida(){			}			fun Inicializa(){//Inicializa los valores en Pantalla				if(frn.config("temp","k_workDate")){					year=mid(frn.config("temp","k_workYear"),2,2);				}else {					kdb.kde("yr");kdb.exec();					year=kdb.get("yr",14);				}					frn.set("fecha_ini",sys.date(year,sys.date("month"),1));				frn.set("fecha_fin",sys.date(year,sys.date("month"),31));                				IniCombos();			}									fun IniCombos(){									//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));										}						fun Ejecuta(){//Prepara datos del reporte 				var sucursal_id, fecha_ini, fecha_fin, resultado, mensaje; 				valida();				if (frn.message("¿Ejecutar proceso de regeneración de ISAN?","Confirmación",2)==0){					return;				}				sucursal_id = frn.get("k_sucn",-1,1);				fecha_ini = frn.get("fecha_ini");				fecha_fin = frn.get("fecha_fin");				setXml(xmlRequest,"document","sucursal_id",sucursal_id);				setXml(xmlRequest,"document","fecha_ini",fecha_ini);				setXml(xmlRequest,"document","fecha_fin",fecha_fin);				frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestISANReg");												cmd="select * from keplersc.autos_regenera_isan('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_isan_regenerar.Ejecuta()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\xmlResultISANReg");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				resultado= getXmlAtt(cubo,"r0","resultado");				mensaje= getXmlAtt(cubo,"r0","mensaje");				frn.message(mensaje);			}		}	}	</script></pag>