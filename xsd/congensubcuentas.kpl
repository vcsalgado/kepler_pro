<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">
	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>

<tab/><txt fnt=",22" clr="0,0,0">Genera Subcuentas</txt>
	<br/>
	<br/>
		<hLine clr="0,0,0"/>
		<br/><br/>
		<tab/>
		<grp id="grupo_crud" dim="80,16,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit=" " available="Y"><tab/>
			<br/><br/><tab n="2"/><txt>Cuenta contable inicial :</txt>
			<inp id="cuenta_ini" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="10" available="Y" OnChange="" tooltip="Cuenta contable inicial"/>
			<br/><sp/><tab n="2"/>
			<txt>Cuenta contable final :</txt><sp/>
			<inp id="cuenta_fin" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="30" clrBrdr="255,255,255" tooltip="Cuenta contable final"/>
			<br/><sp/><tab n="2"/>
			<txt>A&#241;o (AA) :</txt><tab n="3"/><sp n="2"/>
			<inp id="anio" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" tooltip="A&#241;o contable"/><br/><sp/><tab/>
			<br/>
            <tab n="11"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/><br/><br/><tab/>
		
		
			
		</grp><br/><br/>
	</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,kdb,frP,sys,clave_sel,sucursal_id,cve_color,resVal,straccion;
         var cmdQuery,parametros,ok,cuboResultados,cubo,mensajeError;
			fun Main() {
				frn=new FRNT;
				frP=new FRNTP;
				kdb=new KDB;
				kdb.connect();
				sys=new SYS;
			   Inicializa();
				ConfiguraControles();
			}
			
			fun Inicializa(){
				frn.rst("grupo_crud");
					
			}
			
			fun ConfiguraControles(){
				var stranio; 
				stranio= mid(fnDate("year",sys.date()),2,2);
				frn.set("anio",stranio);
				frn.set("cuenta_ini","700");
				frn.set("cuenta_fin","799");
				
			}	
						
			fun ValidarDatos(){
				if (frn.get("cuenta_ini") &= "") {						
					frn.setPos("cuenta_ini");
					resVal=0;
					frn.message("Debe especificar una cuenta contable inicial, verificar","Error","Aceptar");
				}
				if (frn.get("cuenta_fin") &= "") {						
					frn.setPos("cuenta_fin");
					resVal=0;
					frn.message("Debe especificar una cuenta contable final, verificar","Error","Aceptar");
				}
				
				if (frn.get("anio") &= "") {						
					frn.setPos("anio");
					resVal=0;
					frn.message("Debe especificar el año contable, verificar","Error","Aceptar");
				}
			}

			fun Execute() {
				var resultado,confirmacion;
				resVal = 1;
				ValidarDatos();
				if(resVal == 0){
					return;
				}
				
				confirmacion = frn.message("¿Desea generar subcuentas?","Mensaje", 2);
				if (confirmacion &! 1)  {
					return;
				}
				
				//xmlPantalla = getXml(frn.dataPag());	
				parametros = "'" & frn.get("cuenta_ini") & "','" & frn.get("cuenta_fin") & "','" & frn.get("anio") & "'";
				
				frn.lib("libGeneral.kpl","FileSave",parametros,"C:\Basura\xmlPantalla");
		
				//cmdQuery="select * from keplersc.cont_genera_subcuentas('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";
				cmdQuery="select * from keplersc.cont_genera_subcuentas(" & parametros & ")";
				frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\cmdQuery");
				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"congensubcuentas.Execute()");	
				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");					
				resultado=getXml(cubo ,"resultado");
				
				if(resultado &= "0"){
					mensajeError = getXml(cubo ,"mensaje");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				if(resultado &= "1") {
					ConfiguraControles(); 
					frn.message("Subcuentas generadas", "Mensaje", "Aceptar");
				}	
			}		
			
		}
	</script>
</pag>