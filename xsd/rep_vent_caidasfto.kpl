<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de Ventas Caidas" scale="48">
	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,16" unfont="0">
		<br exe="encabezado"/>
		<hLine dim="90,0" g="2" type="1"/>
		<br exe="encabezado"/>
		<grp dim="10,7,7,12">
			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>
		</grp>
		<tab n="1"/>
		<grp dim="62,7,7,12" brdr="0,0">
			<br/>
			<inp id="k_empresa" fnt=",20b" dim="80,1" clr="0,58,112" type="string" available = "N"/>
			<br/>
			<inp id="k_sucursal" fnt=",16b" dim="40,1" clr="0,58,112" type="string" available = "N"/>
			<br/>
			<txt fnt=",16b" clr="0,58,112">Reporte de Ventas Caidas</txt>

			<br/>
			<txt fnt=",16b" clr="0,58,112">Fecha Inicial:</txt>
			<inp id="k_fecha_ini" fnt=",16b" dim="15,1" clr="0,58,112" type="string" available = "N"/>
			<txt fnt=",16b" clr="0,58,112">Fecha Final:</txt>
			<inp id="k_fecha_fin" fnt=",16b" dim="15,1" clr="0,58,112" type="string" available = "N"/>

			<br/>	

		</grp>
		<tab n="1"/>
		<grp dim="20,5,7,12">
			<br/>
			<txt>P&#225;g:</txt><tab/><inp id="k_pag" dim="4,1" type="number" just="L" mcr="k_pag"/>
			<br/>
			<txt>Fecha:</txt><tab/><inp id="k_fecha_imp" dim="10,1" type="date" just="L" fmt="DD-MM-CCYY"/>
			<br/>
			<txt>Hora:</txt><sp/><tab n="1"/><inp id="K_hora_imp" dim="5,1" type="time" just="L"/>
		</grp>
		<br exe="encabezado"/>
		<br exe="encabezado"/>
		<hLine dim="90,0" g="2" type="1"/>
		<br exe="encabezado"/>
		<hLine dim="90,0" g="2" type="1"/>
		<br exe="encabezado"/>
		<txt fnt=",-1b">PARTE</txt>
		<tab n="3"/><txt fnt=",-1b">DESCRIPCION </txt>
		<tab n="4"/><txt fnt=",-1b">CANTIDAD</txt>
		<tab/>
		<txt fnt=",-1b">UNITARIO   </txt>
		<txt fnt=",-1b">IMPORTE</txt>
		<tab n="2"/><txt fnt=",-1b">ORIGEN</txt>
		<tab n="3"/><txt fnt=",-1b">MOTIVO</txt>
		<tab/><txt fnt=",-1b">FECHA</txt>
		<br exe="encabezado"/>
		<hLine dim="90,0" g="2" type="1"/>
		<br exe="encabezado"/>
		<hLine dim="90,0" g="2" type="1"/>
		<br exe="encabezado"/>
		<inp id="k_parte" dim="10,1" type="string"/>
		<tab n="2"/><inp id="k_descrip" dim="22,1" type="string"/>
		<tab/>
		<inp id="k_cantidad" dim="2,1" type="string"/>
		<tab/>
		<inp id="k_unitario" dim="8,1" type="string"/>
		<inp id="k_importe" dim="10,1" type="string"/>
		<inp id="k_origen" dim="14,1" type="string"/>
		<inp id="k_motivo" dim="7,1" type="string"/>
		<inp id="k_fecha" dim="10,1" type="string"/>
		
		<br exe="detalle"/>

		<br exe="salto"/>

		<tab n="14"/><txt fnt=",-1bi">Resumen</txt><tab/>
		<br exe="total"/>
		
		<tab n="11"/>
		<txt fnt=",-1bi">Refaccionaria</txt><tab/>
		<txt fnt=",-1bi">Servicio</txt><tab/>
		<br exe="total"/>

		<tab n="7"/>
		<txt fnt=",-1bi">Por Precio:</txt><tab n="2"/>
		<inp id="k_sum_precio_ref" dim="10,1" type="number" brdr="1,0" fnt=",0b"/> 
		<tab/>
		<inp id="k_sum_precio_serv" dim="10,1" type="number" brdr="1,0" fnt=",0b"/>

<br exe="total"/>
		<tab n="7"/>
		<txt fnt=",-1bi">Por Existencia:</txt><tab/>
		<inp id="k_sum_exis_ref" dim="10,1" type="number" brdr="1,0" fnt=",0b"/>
		<tab/>
		<inp id="k_sum_exis_serv" dim="10,1" type="number" brdr="1,0" fnt=",0b"/>

<br exe="total"/>
		<tab n="7"/>
		<txt fnt=",-1bi">Por Distribuidora:</txt><tab/>
		<inp id="k_sum_dist_ref" dim="10,1" type="number" brdr="1,0" fnt=",0b"/>
		<tab/>
		<inp id="k_sum_dist_serv" dim="10,1" type="number" brdr="1,0" fnt=",0b"/>
	
		<br exe="total"/>
		<tab n="7"/>
		<txt fnt=",-1bi">Totales:</txt><tab n="3"/>
		<inp id="k_total_imp_ref" dim="10,1" type="number" brdr="1,0" fnt=",0b"/>
		<tab/>
		<inp id="k_total_imp_serv" dim="10,1" type="number" brdr="1,0" fnt=",0b"/>
	
		<br exe="total"/>

		<tab n="7"/><txt fnt=",-1bi">Total Registros:</txt><tab/><inp id="input3" dim="10,1" type="number" brdr="1,0" fnt=",0b"/>
		<br exe="total"/>
	</grp>
</pag>