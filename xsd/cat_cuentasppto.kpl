<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Configuracion de Cuentas de Presupuesto"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,15,12" bclr="192,205,213" unfont="0">	<tab/><br/><tab/><txt clr="0,0,0" fnt=",22">Configuracion de Cuentas de Presupuesto</txt>	<br/>	<tab n="1"/>	<hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="43,42,10,10" brdr="0,5" tit="Rango de Cuentas" fnt="Arial,16">		<tab/>		<txt>Sucursal:</txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="38,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" 			available="Y" OnChange="ResetResults()"/><tab/><txt>    A&#241;o:</txt>		<cmb id="k_anio" clr="64,64,64" clrBrdr="255,255,255" dim="6,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 			available="Y" OnChange="ResetResults()"/>        <tab n="1"/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_Registros()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		    		<br/>						<br/>		<tab n="1"/>		<tbl clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" brdr="1,0" id="results" dim="58,18" 			modify="Y" Reorder="Y">			<col id="rango_ini" name="Rango Inicial" type="capital" OnF9="consulta_cuentas(1)" OnChange="Desc_CtaIni()"/>            <col id="desc_cuenta_ini" name="Descripcion" type="capital"/>			<col id="rango_fin" name="Rango Final" type="capital" OnF9="consulta_cuentas(2)" OnChange="Desc_CtaFin"/>            <col id="desc_cuenta_fin" name="Descripcion" type="capital"/>		</tbl>		<tab n="1"/>		<br/>		<tab n="2"/>		<br/><tab n="18"/><sp n="3"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar Presupuesto &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		<br/>	</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,usuario,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;			var accion, tipoOper, cmd, cubo, ok,mensajeError,resVal; 			var regTotales,ultimoValorEncontrado, contGlobalResults; //variables del llenado de la tabla			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				//Constantes				usuario = frn.config("user","name");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";				Inicializa();			}			fun ResetResults(){				frn.rst("results");			}								fun Desc_CtaIni(){				var cuenta,anio,desc_cta;				anio=mid(frn.get("k_anio"),2,2);				cuenta=frn.get("results",-1,"rango_ini");									if (cuenta &=""){					frn.message("No ha especificado el rango de cuentas","Mensaje","&Aceptar");					return;				}				cmd = "select c2 as descripcion from keplersc.kdc1" & anio &" where c1='" & cuenta & "'";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_cuentasppto.ConsultaDesc_Cta()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;				}	            	frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\xmlConsCta");				frn.setX(getXmlAtt(cubo,"r0","descripcion"),"results",-1,"desc_cuenta_ini");					}						fun Desc_CtaFin(){				var cuenta,anio,desc_cta;				anio=mid(frn.get("k_anio"),2,2);				cuenta=frn.get("results",-1,"rango_fin");									if (cuenta &=""){					frn.message("No ha especificado el rango de cuentas","Mensaje","&Aceptar");					return;				}				cmd = "select c2 as descripcion from keplersc.kdc1" & anio &" where c1='" & cuenta & "'";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_cuentasppto.ConsultaDesc_Cta()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;				}	            	frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\xmlConsCta");				frn.setX(getXmlAtt(cubo,"r0","descripcion"),"results",-1,"desc_cuenta_fin");					}			fun consulta_cuentas(tipo){				var rango,anio;				anio=mid(frn.get("k_anio"),2,2);				cmd = "select c1 as cuenta, c2 as descripcion from keplersc.kdc1" & anio &" order by c1 ";				if (tipo == 1){								rango="rango_ini";				} else if (tipo == 2){								rango="rango_fin";				}				frn.dialog("genlistafiltrosel","Cuentas",cmd,"cuenta","results",-1,rango,"N","N","N");				}			fun Inicializa(){						frn.rst("gpo_2");				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";								if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR" && rol_usuario &! "Administrador Kepler 8.0" && rol_usuario &! ""){											cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",getXml(cubo));									cmd="SELECT concat('20',substring(table_name,5,2)) as anio FROM INFORMATION_SCHEMA.TABLES 					WHERE  table_schema='keplersc' and table_type='BASE TABLE' and TABLE_NAME LIKE 'kdc22%'					group by anio					order by anio desc";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_cuentasppto.Inicia_Forma()");				frn.set("k_anio",getXml(cubo));							}			fun Buscar_Registros(){				var tabla, nReg;				kdb.rst();				frn.rst("results");                tabla="kdc1"&mid(frn.get("k_anio",-1,0),2,2);				                cmd = "select cp.rango_ini,k1.c2 as desc_cuenta_ini,cp.rango_fin,k2.c2 as desc_cuenta_fin from keplersc.cat_ctas_ppto cp                        left join keplersc."& tabla & " k1 on cp.rango_ini=k1.c1                        left join keplersc."& tabla & " k2 on cp.rango_fin =k2.c1                        where cp.sucursal='" & frn.get("k_sucn",-1,1) & "' and cp.anio='" & frn.get("k_anio",-1,0) & "'                         order by cp.rango_ini";				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_cuentasppto.buscar_registros()");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;				}	                frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\xmlBuscarReg");				frn.set("results",cuboXml);				nReg=nXml(cuboXml);				regTotales = nReg;				if(nReg==0){				  frn.message("No existen registros","Atencion","Aceptar");									}							}			fun ValidarDatos(){				var rango_ini,rango_fin,nReg;				nReg=frn.N("results");				for (var i=0;i<nReg-1;i++) {					rango_ini = frn.get("results",i,"rango_ini");					rango_fin = frn.get("results",i,"rango_fin");					if (rango_ini &= ""){						resVal=0;						frn.setPos("results",i,"rango_ini");						frn.message("El rango inicial no puede estar en blanco","Error","Aceptar");						return;					}					if (rango_fin &= ""){						resVal=0;						frn.setPos("results",i,"rango_fin");						frn.message("El rango final no puede estar en blanco","Error","Aceptar");						return;					}				}			}						fun Ejecuta() {				var xmlPantalla, strMsg, continua;				var resultado, mensaje, folio;				resVal = 1;				ValidarDatos();				if(ok &! "1" || resVal == 0){					return;				}				continua = frn.message("¿Desea continuar?","Atención",2);				if (continua == 0){					return;				}								xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;                setXml(xmlPantalla,"operacion","REGISTRO");							setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"results","no_partidas",frn.N("results"));													frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"c:\basura\XmlPantallaCuentasPpto");				cmd="SELECT * FROM keplersc.configuractasppto('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				rstXml(cuboXml);					cuboXml= frn.lib("libGeneral.kpl","EjecutarSql",cmd,"presupuesto.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboXml, "c:\basura\XmlResultadoCuentasPpto");									resultado = getXml(cuboXml,"resultado");				mensaje = getXml(cuboXml,"mensaje");									ok = getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboXml,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					strMsg = "Configuracion registrada " & mensaje;					frn.setAtt("aceptar","visible","N");					frn.message(strMsg, "Mensaje", "Aceptar");					return;				} else {					frn.message(mensaje, "Error", "Aceptar");					return;				}			}										fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>