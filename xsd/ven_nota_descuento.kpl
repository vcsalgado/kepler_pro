<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Nota Descuento">	<grp id="grpMain" brdr="0,0" clr="0,58,112" fnt="Arial,18b" id="k_titulo_inicial" dim="1,-1,10,8" bclr="192,205,213" clrBrdr="0,97,181" tit="Nota Descuento" unfont="0">		<br/>	<tab/><inp id="k_titulo_inicial" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>	<br/><tab/><hLine clr="0,0,0"/>	<br/><br/>	<tab/>		<grp id="grpDatosGenerales" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="50,10,7,12" tit="Datos generales"  fnt="Arial,16" available="Y" modify="Y">		<sp/><txt clr="0,58,112" hk="S">Sucursal</txt><tab/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" 				brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y" OnChange="CambiaSucursal()"/>			<br/>							<br/>			<sp/><txt clr="0,58,112">Tipo docto</txt><tab/>			<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255" dim="35,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="Valida_Tipo_Docto()" available="Y"/><br/>		</grp><sp/>		<grp id="grpDocumentos" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="25,10,7,12" tit="Documento"  fnt="Arial,16" available="Y" modify="Y">			<tab n="2"/><inp id="operacion" clr="64,64,64"  dim="18,1" brdr="0,1" fnt=",18b" available="N" type="string"/><br/><tab/>			<txt id="foliotxt"  visible="N" hk="F" clr="0,58,112">Folio</txt><tab n="2"/>			<edt id="k_folio" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" visible="N" hk="F" type="string" nc="10"				OnF9="ObtenerFolio()" OnButton="ObtenerFolio()" OnChange = "Formar_folio()"	modify="N" available="Y"/>				<sp n="1"/>							<img id="buscar_folio" dim="20,20"  brdr="0,1" bPx="Y" img="_20_Find.png" OnEnter="ConsultarFolio()" clrBrdr="0,0,0" visible="N" modify="N" available="Y"/>				<br/><tab/>			<inp id="k_docto" clr="64,64,64"  dim="25,1" brdr="0,1" fnt="Arial,16" available="N" link="k_tipon,5" type="string"/><br/>			<tab/><txt clr="0,58,112">Fecha</txt><tab/>			<edt id="k_fecha" dim="15,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" OnButton="Dialog(0,_ks_fecha,k_fecha)" OnF9="Dialog(0,_ks_fecha,k_fecha)" modify="N" available="Y"/><br/><tab/>			<inp id="statusDoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/><br/><tab n="2"/>					</grp><br/><br/><br/>		<tab/>		<grp id="grpDetalle" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5" dim="76,38,7,12" tit="Detalle"  fnt="Arial,16" available="Y" modify="Y">			<grp id="grpInventario" dim="165,40,7,12" hSpace="4" available="Y" modify="Y">								<sp/>				<txt>Factura</txt><sp n="1"/>					<inp id="k_foliodocto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="10" available = "Y" tooltip="F9 Facturas" modify="Y" 				OnF9="BusquedaFactura()"  OnChange="Formar_folio_factura()"/><sp n="1"/>					<img id="busca_factura" dim="20,20"  brdr="0,1" bPx="Y" img="_20_Find.png" OnEnter="MostrarFactura()" clrBrdr="0,0,0"  available="Y" visible="Y"/>								<br/><sp/>				<txt>Inventario</txt>				<inp id="k_inventario" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="10" available = "Y" tooltip="Inventario ..." modify="N" 				OnChange="MostrarInventario()"/>				<tab n="1"/><txt>Producto:</txt>				<inp id="k_producto" clr="64,64,64" dim="18,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>																						<txt>Descripci&#243;n: </txt><tab n="1"/>				<inp id="k_desc_inv" clr="64,64,64"  dim="40,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>	<br/>							<sp/><txt>Cliente</txt><sp n="2"/>				<inp id="k_clave" clr="64,64,64" clrBrdr="255,255,255" tooltip="Modificar F11" dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="10" available = "Y" modify="N" 					OnChange="MostrarCliente()" OnF11 = "Dialog(3,cat_cli_crud,Modificar,x,s,k_clave)"/> <tab/>				<br/><sp/>				<grp id="grpDatosClientes" bclr="255,255,255" fntClrBrdr="240,220,200" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="106,7,7,12" fnt="Arial,16" available="Y" modify="Y">								<inp id="k_rfccli" clr="64,64,64" clrBrdr="255,255,255" dim="15,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N" type="string"/>				<tab/><inp id="k_nombreimprfact" clr="64,64,64" clrBrdr="255,255,255"  dim="80,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N" type="string"/>				<br/>				<inp id="k_nombrecli" clr="64,64,64" clrBrdr="255,255,255"  dim="60,1" bclr="255,255,255"  fnt="Arial,16" nr="3,60" modify="Y" available="N" type="string"/>								<inp id="k_callecli" clr="64,64,64" clrBrdr="255,255,255"  dim="50,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N"/>				<br/>				<inp id="k_coloniacli" clr="64,64,64" clrBrdr="255,255,255"  dim="50,1" bclr="255,255,255"  fnt="Arial,16" nr="3,60" modify="Y" available="N"/>								<inp id="k_poblacioncli" clr="64,64,64" clrBrdr="255,255,255"  dim="50,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N"/>				<inp id="k_cpcli" clr="64,64,64" clrBrdr="255,255,255"  dim="8,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N"/>				<br/>				</grp><sp/>				<br/>										<tab n="23"/><txt>Subtotal : </txt>				<inp id="k_subtotal" clr="64,64,64" dim="18,1" visible="Y" fnt="Arial,16" type="number" nc="16" modify="N" available="N" nd="2" just="R"/>				<br/>				<tab n="24"/><sp/><txt>IVA :</txt>				<inp id="k_iva" clr="64,64,64" dim="18,1" visible="Y" fnt="Arial,16" type="number" nc="16" modify="N" available="N" nd="6" just="R"/>				<br/>				<tab n="24"/><txt> Total :</txt>				<inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"   bclr="255,255,255" dim="18,1" visible="Y" fnt="Arial,16" type="number" OnChange="monto()" nc="16" modify="Y" available="Y" nd="2" just="R"/>				<br/>				<br/>				<tab n="1"/> <txt>Forma de Pago: </txt> 				<cmb id="k_f_pago" dim="25,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y"/>				<tab n="1"/>				<txt>Cuenta:</txt>				<inp id="k_cuenta" clr="64,64,64" dim="30,1" visible="Y" fnt="Arial,16" type="string"  modify="Y" available="Y" bclr="246,246,246"/>											<br/>								<tab n="1"/><txt id="txt_metodo_pago" visible="Y">Metodo de pago :</txt>				<inp id="k_m_pago" clr="64,64,64" dim="10,1" fnt="Arial,16" type="string" nc="16" modify="N"/>				<tab n="1"/><txt id="txt_uso_cfdi" visible="Y">Uso del CFDI:</txt>				<inp id="k_cfdi" clr="64,64,64" dim="10,1"  fnt="Arial,16" type="string" nc="16" modify="N"/>								<tab n="1"/><txt id="txt_correo" visible="Y">Correo:</txt>				<inp id="k_correo" clr="64,64,64" dim="48,1" fnt="Arial,16" type="string"  modify="N"/>							<br/>								<tab n="1"/><txt clr="0,58,112">Comentarios:</txt><br/><tab n="2"/>				<inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="60,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y"  type="capital"/>				<br/><tab n="2"/><inp id="k_coment2" clr="64,64,64" clrBrdr="255,255,255"  dim="60,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y"  type="capital"/>				<br/><tab n="2"/><inp id="k_coment3" clr="64,64,64" clrBrdr="255,255,255"  dim="60,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y"  type="capital"/>						<br/>		<tab n="30"/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/><tab/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><tab/>						</grp>		</grp>	</grp>	<tools>		<tool OnMouseL="Ejecuta()" tooltip="Aceptar documento(Ctrl+T)" scut="Ctrl+T" img="_TL_Execute.png"/>	</tools>	<script>		InstallDriver("KDB75");		class Main {			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc,usuario,sucursal_id,suc_usuario,rol_usuario,asterisco, v_inventario,valorRetorno,v_IvaAuto,v_correo,v_uso_cfdi;			var frn,kdb,rep,frP,sys;			var tip_ope;//Tipo de operación. "0" indica Alta; "1" indica consulta;			var uen,v_KDM1_iva,v_KDM1_importe, v_KDM1_subtotal, fileSavePath;			var anio_contable;			var nat_doc_anex, gpo_doc_anex;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("c,kdm1,i,kdini,q,kdiq,m,kdmm,s,kdms,u,kdxd,v,kdxv,p,kdip,e,kdxe,f,kdxf,w,kdc2");				ConfiguraControlesOff();				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				fileSavePath = "C:\Basura";				asterisco = "*";				inicializa();										}							//------------------------------------------------CONFIGURACIONES---------------------------					fun inicializa(){//Da valor a los combos y prepara la página dependiendo del tipo de Operación a realizar				var resValidacion, 						resMensaje, 						cubo, 						cmd, 						ok,						mensajeError,						sucursal_id,						v_cliente,						v_tipoOperacion;				kdb.kde("KDE");//												kdb.exec();				anio_contable = kdb.get("KDE","14");				frn.set("k_fecha",sys.date());												if(frn.nParam()>0 ){//Se han mandado parámetros a la página					gen_doc=trim(frn.param(0)); 					nat_doc=trim(frn.param(1)); 					gpo_doc=trim(frn.param(2));					tip_doc=trim(frn.param(3)); 					fija_doc=trim(frn.param(4));					tip_ope=trim(frn.param(5));					uen=trim(frn.param(6));				}				else				{					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}				ConfiguraCamposOpcion();				if(tip_ope==0)				{					v_tipoOperacion = "Alta Nota de Descuento";				}								if(tip_ope==1)				{					v_tipoOperacion = "Consulta Nota de Descuento";				}				frn.set("k_titulo_inicial",v_tipoOperacion);											//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_nota_descuento.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));							//Llena combo tipo				LlenaCmbTipo();								// Fill Combo forma de pago(Con Query de PostgreSQL)				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3fp";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd ,"ven_nota_descuento.Inicializa()");				ok=getXmlAtt(cubo ,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo ,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_f_pago",cubo );																Fecha();//Indica fecha correcta, y trae monedas y paridades de esa fecha. 				if (strlen(tip_doc)>0) frn.setPos("k_tipon",-1,4,"internal:Y","val:" & tip_doc);//Posiciona el combo de Tipo de documento al especificado como parï¿½metro								//				if(tip_ope==0){//Alta					frn.set("operacion","ALTA");				}				else if(tip_ope==1){//Consulta					frn.set("operacion","CONSULTA");				}							BorraDatos();												nat_doc_anex = "D";				gpo_doc_anex = 6;			}						fun LlenaCmbTipo(){				var cubo,cmd,ok,mensajeError;				sucursal_id=frn.get("k_sucn",-1,1);											cmd = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and col_sucursal='" & sucursal_id & "'";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_nota_descuento.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTipoDocto");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_tipon",getXml(cubo));			}						fun CambiaSucursal(){				sucursal_id = frn.get("k_sucn",-1,1);				LlenaCmbTipo();				Valida_Tipo_Docto();						}						fun ConfiguraControlesOff()			{				var strValAtr;				strValAtr = "N";				//Deshabilita todos los campos y botones				frn.setAtt("grpDatosGenerales","available",strValAtr);				frn.setAtt("grDocumentos","available",strValAtr);								frn.setAtt("grpDetalle","available",strValAtr);				frn.setAtt("grpInventario","available",strValAtr);				frn.setAtt("grpconceptosextras","available",strValAtr);				frn.setAtt("grpComentarios","available",strValAtr);				frn.setAtt("Aceptar","available",strValAtr);				frn.setAtt("Aceptar","visible",strValAtr);					frn.setAtt("Cancelar","available",strValAtr);				frn.setAtt("Cancelar","visible",strValAtr);					frn.setAtt("foliotxt","visible",strValAtr);								frn.setAtt("k_folio","modify",strValAtr);					frn.setAtt("k_folio","visible",strValAtr);				frn.setAtt("buscar_folio","modify",strValAtr);					frn.setAtt("buscar_folio","visible",strValAtr);									frn.setAtt("k_coment","modify",strValAtr);				frn.setAtt("k_coment","available",strValAtr);				frn.setAtt("k_coment2","modify",strValAtr);				frn.setAtt("k_coment2","available",strValAtr);					frn.setAtt("busca_factura","visible",strValAtr);				frn.setAtt("k_foliodocto","modify",strValAtr);								frn.setAtt("k_monto","modify",strValAtr);								frn.setAtt("k_coment3","modify",strValAtr);				frn.setAtt("k_coment3","available",strValAtr);				frn.setAtt("k_rfccli","available",strValAtr);				frn.setAtt("k_nombrecli","available",strValAtr);				frn.setAtt("k_callecli","available",strValAtr);				frn.setAtt("k_coloniacli","available",strValAtr);				frn.setAtt("k_poblacioncli","available",strValAtr);				frn.setAtt("k_cpcli","available",strValAtr);					frn.set("k_f_pago",descr_combo("k_f_pago",1, "99"));								}						fun ConfiguraCamposOpcion(){				var strValAtr;				ConfiguraControlesOff();				//HAbilita segun tipo de operacion				strValAtr = "Y";				switch(tip_ope){					case 0: //Alta						frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpDatosGenerales","modify",strValAtr);						frn.setAtt("grDocumentos","available",strValAtr);						frn.setAtt("grDocumentos","modify",strValAtr);						frn.setAtt("grpDetalle","available",strValAtr);						frn.setAtt("grpDetalle","modify",strValAtr);						frn.setAtt("grpInventario","available",strValAtr);						frn.setAtt("grpInventario","modify",strValAtr);						frn.setAtt("grpconceptosextras","available",strValAtr);						frn.setAtt("grpconceptosextras","modify",strValAtr);						frn.setAtt("grpComentarios","available",strValAtr);						frn.setAtt("grpComentarios","modify",strValAtr);						frn.setAtt("k_monto","modify",strValAtr);							frn.setAtt("Aceptar","available",strValAtr);						frn.setAtt("Aceptar","visible",strValAtr);							frn.setAtt("Cancelar","available",strValAtr);						frn.setAtt("Cancelar","visible",strValAtr);								frn.setAtt("k_cuenta","available",strValAtr);						frn.setAtt("k_cuenta","visible",strValAtr);								frn.setAtt("k_coment","modify",strValAtr);						frn.setAtt("k_coment","available",strValAtr);						frn.setAtt("k_coment2","modify",strValAtr);						frn.setAtt("k_coment2","available",strValAtr);						frn.setAtt("k_coment3","modify",strValAtr);						frn.setAtt("k_coment3","available",strValAtr);												frn.setAtt("busca_factura","visible",strValAtr);						frn.setAtt("k_foliodocto","modify",strValAtr);																		break;					case 1: //Consulta												frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("k_folio","modify",strValAtr);							frn.setAtt("k_folio","visible",strValAtr);												frn.setAtt("k_folio","available",strValAtr);						frn.setAtt("foliotxt","visible",strValAtr);										frn.setAtt("buscar_folio","modify",strValAtr);							frn.setAtt("buscar_folio","visible",strValAtr);																break;					default:				}											}									fun BorraDatos(){ //Limpia todos los campos para generar un nuevo documento. 				frn.set("k_folio","","statusDoc","","k_clave","");								if(tip_ope>0) frn.setPos("k_folio");					frn.set("k_f_pago",descr_combo("k_f_pago",1, "99"));					frn.rst("k_clave");				frn.rst("k_rfccli");				frn.rst("k_nombreimprfact");				frn.rst("k_nombrecli");				frn.rst("k_callecli");				frn.rst("k_coloniacli");				frn.rst("k_poblacioncli");				frn.rst("k_cpcli");				frn.rst("k_m_pago");					frn.rst("k_cfdi");				frn.rst("k_cuenta");						frn.rst("k_correo");				frn.rst("k_foliodocto");				frn.rst("k_inventario");				frn.rst("k_producto");					frn.rst("k_desc_inv");								frn.rst("k_subtotal");						frn.rst("k_iva");						frn.rst("k_monto");			}														//-------------------------------------------------MOSTRAR DATOS-------------------------------------------------												fun BusquedaFactura()			{				  				sucursal_id = frn.get("k_sucn",-1,1);				var cmdQuery = "select c6 as folio, to_char(c9, 'dd/mm/yyyy') as fecha,c10 as cliente,c11 as referencia, c16 as monto from keplersc.kdm1  where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc&  "' and c3 = '" & nat_doc_anex &  "' and c4 = '" & gpo_doc_anex  &  "' and c5 = '" & frn.get("k_tipon",-1,4) &  "' ";				cmdQuery = cmdQuery & " order by c9 desc, c6 desc ";				frn.dialog("genlistafiltrosel","Documentos",cmdQuery,"folio","k_foliodocto","0","","S");					          			}									fun Formar_folio_factura(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_foliodocto"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",nat_doc_anex );				setXml(xmlReqEst,"document","k_tipon","r3",gpo_doc_anex  );				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								BorraDatos();								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_nota_descuento.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_foliodocto", fol);		}									fun MostrarFactura()			{								var xmlRequest,cmd,ok, cuboResultados, mensajeError;				 				cmd = "select c10,c100 from keplersc.kdm1 where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc &"' and c3 = '" & nat_doc_anex &  "' and c4 = '" & gpo_doc_anex &  "' and c5 = '" & frn.get("k_tipon",-1,4) &  "' and c6 = '" & frn.get("k_foliodocto") & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_nota_descuento.ConsultarFolio()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}									frn.set("k_inventario",getXmlAtt(cuboResultados,"r0","c100"));								MostrarInventario();									frn.set("k_clave",getXmlAtt(cuboResultados,"r0","c10"));						MostrarCliente();										}			fun MostrarCliente()			{				var xmlRequest, cmd, ok,cuboResultados,mensajeError, v_cliente;			   v_correo = ""; v_uso_cfdi="";  v_cliente= frn.get("k_clave" , -1, 1);			   				cmd = "select c30,c3,c4,c5,c6,c10,c11,c16,c52,c53,c27 from keplersc.kdud where c2 = '" & v_cliente & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_nota_descuento.MostrarCliente()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				frn.set("k_nombreimprfact",getXmlAtt(cuboResultados,"r0","c30"));				frn.set("k_nombrecli",getXmlAtt(cuboResultados,"r0","c3"));				frn.set("k_callecli",getXmlAtt(cuboResultados,"r0","c4"));				frn.set("k_coloniacli",getXmlAtt(cuboResultados,"r0","c5"));				frn.set("k_poblacioncli",getXmlAtt(cuboResultados,"r0","c6"));				frn.set("k_rfccli",getXmlAtt(cuboResultados,"r0","c10"));				frn.set("k_cpcli",getXmlAtt(cuboResultados,"r0","c27"));				v_correo = getXmlAtt(cuboResultados,"r0","c11");				v_uso_cfdi = getXmlAtt(cuboResultados,"r0","c53");				frn.set("k_m_pago",getXmlAtt(cuboResultados,"r0","c52"));				frn.set("k_cfdi",v_uso_cfdi );				frn.set("k_correo",v_correo );			}			//INVENT								fun MostrarInventario() 			{				var xmlRequest,cmd,ok, cuboResultados, mensajeError,totOrd,contOrd;					 				sucursal_id = frn.get("k_sucn",-1,1);				v_inventario = frn.get("k_inventario");									 				cmd = "select c3,c4 from keplersc.kdinf where c1 ='" & sucursal_id &  "' and c2 ='" & v_inventario & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_nota_descuento.MostrarInventario()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}							frn.set("k_producto",getXmlAtt(cuboResultados,"r0","c3"));				frn.set("k_desc_inv",getXmlAtt(cuboResultados,"r0","c4"));						}												fun monto(){							var subtotal = frn.get("k_monto")/(1+16/100);				frn.set("k_iva",frn.get("k_monto") - subtotal );				frn.set("k_subtotal" ,subtotal );						}										//------------------------------------------------------------------ALTA---------------------------------------------						fun Ejecuta(){				if(tip_ope==0){Alta();}				else if(tip_ope==1){Consulta();}			}									fun Alta()			{				var resultado, mensaje , mensajeError , cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd,ok ;				var partidasValidas = 0;				kdb.rst();				frn.rst("results");								if( frn.get("k_monto") <= 0 )				{					frn.message("Monto cero ó negativo","Error","&Aceptar");return;				}				fecha = sys.date();				hora= sys.time();				//cubo = "dat";				kdb.rst();				frn.rst("results");								strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								 //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				xmlPantalla = getXml(frn.dataPag()); 				setXml(xmlPantalla,"k_natdocto",nat_doc_anex );				setXml(xmlPantalla,"k_gpodocto",gpo_doc_anex );				setXml(xmlPantalla,"k_tipodocto",frn.get("k_tipon",-1,4));				setXml(xmlPantalla,"k_foliodocto",frn.get("k_foliodocto"));				setXml(xmlPantalla,"k_refer",frn.get("k_foliodocto"));								setXml(xmlPantalla ,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlPantalla ,"movimiento","fecha",strFecha);				setXml(xmlPantalla ,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"k_claveinv",frn.get("k_inventario"));				setXml(xmlPantalla,"k_cond","Contado");																	frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantalla");				cmd ="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cubo);				rstXml(cubo);									cubo= frn.lib("libGeneral.kpl","EjecutarSql",cmd ,"ven_nota_descuento.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cubo, fileSavePath & "\XmlResultado");									resultado = getXml(cubo,"resultado");				mensaje = getXml(cubo,"mensaje");									ok = getXmlAtt(cubo,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}										if(resultado &= "1")				{					tip_ope = 1;					frn.set("k_folio",mensaje); 					frn.set("operacion","CONSULTA");										strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);					ConfiguraCamposOpcion();										mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;					frn.message(mensaje, "Mensaje","&Aceptar");				}else{					frn.message(mensaje, "Error","&Aceptar");				}			}										//--------------------------------------------------CONSULTA-------------------------------------------------------------					fun ConsultarFolio()			{				var xmlRequest,cmd,ok, cuboResultados, mensajeError;						 				cmd = "select * from keplersc.kdm1 where c1 = '" & frn.get("k_sucn",-1,1) &  "' and c2 = '" & gen_doc &"' and c3 = '" & nat_doc &  "' and c4 = '" & gpo_doc &  "' and c5 = '" & tip_doc &  "' and c6 = '" & frn.get("k_folio") & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_nota_descuento.ConsultarFolio()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				frn.set("k_fecha",getXmlAtt(cuboResultados,"r0","c9"));								frn.set("k_foliodocto",getXmlAtt(cuboResultados,"r0","c39"));								frn.set("k_inventario",getXmlAtt(cuboResultados,"r0","c100"));								MostrarInventario();									frn.set("k_clave",getXmlAtt(cuboResultados,"r0","c10"));						MostrarCliente();				v_KDM1_iva = getXmlAtt(cuboResultados,"r0","c14");				v_KDM1_importe = getXmlAtt(cuboResultados,"r0","c16");				v_KDM1_subtotal = v_KDM1_importe - v_KDM1_iva ;								frn.set("k_monto",v_KDM1_importe);							frn.set("k_subtotal",v_KDM1_subtotal);				frn.set("k_iva",v_KDM1_iva);				frn.set("k_f_pago",descr_combo("k_f_pago",1, getXmlAtt(cuboResultados,"r0","c160") ) );					frn.set("k_m_pago",getXmlAtt(cuboResultados,"r0","c162"));				frn.set("k_cfdi",getXmlAtt(cuboResultados,"r0","c164"));				frn.set("k_correo",getXmlAtt(cuboResultados,"r0","c165"));								frn.set("k_coment",getXmlAtt(cuboResultados,"r0","c24"));				frn.set("k_coment2",getXmlAtt(cuboResultados,"r0","c25"));				frn.set("k_coment3",getXmlAtt(cuboResultados,"r0","c26"));								}								fun ObtenerFolio()			{					BorraDatos();				   var cmdQuery ="",v_tipo_n;					v_tipo_n = frn.get("k_tipon",-1,4);					sucursal_id = frn.get("k_sucn",-1,1);					cmdQuery = "select c1 as tip, c6 as folio, to_char(c9, 'dd/mm/yyyy') as fecha,c11 as referencia, c16 as monto from keplersc.kdm1  where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc&  "' and c3 = '" & nat_doc&  "' and c4 = '" & gpo_doc&  "' and c5 = '" & v_tipo_n &  "' ";					cmdQuery = cmdQuery & " order by c6 desc ";					frn.dialog("genlistasel","Documentos",cmdQuery,"folio","k_folio","0","","N");			}												fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								BorraDatos();				frn.lib("libGeneral.kpl","FileSave",xmlReqEst,fileSavePath & "\xmlReqEst");							cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_nota_descuento.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);		}							fun Consulta(){//Imprime el reporte del documento especificado 				if(strlen(trim(frn.get("k_folio")))==0){ 					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");					frn.setPos("k_folio");return;					}				//reporte();				frn.setPos("k_folio");			}												//-------------------------------------------EXTRAS----------------------------------------------------						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}													fun Valida_Tipo_Docto(){				var resValidacion, resMensaje, cubo, cmd, ok, tip_doc;							//Valida documento vigente				tip_doc=frn.get("k_tipon",-1,4);				kdb.rst();								cmd= "select * from keplersc.verify_valid_document('" & frn.get("k_sucn",-1,1) & "','" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & tip_doc & ")"; //suc text, genero text, naturaleza text, grupo integer, tipo_movto integer				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"ven_nota_descuento.Valida_Tipo_Docto()");								resValidacion= getXml(cubo,"validacion","resultado");				resMensaje = getXml(cubo,"validacion","mensaje");				if(resMensaje &! ""){					frn.message(resMensaje, "Mensaje","&Aceptar");					frn.setPos("k_tipon");				}									BorraDatos();							}												fun Fecha(){//Verifica que la fecha del documento sea correcta. Ademï¿½s trae monedas y paridades de esa fecha. 				var cubo, cmd, resValidacion, resMensaje, fecha;				var validDate=frn.lib("libKepler","ValidOpDate",frn.get("k_fecha"));								kdb.rst();				frn.rst("results");				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				if (tip_ope == 0 ){					cmd= "select * from keplersc.verify_year('" & fecha & "')";					cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"ven_nota_descuento.Fecha()");									;										resValidacion= getXml(cubo,"validacion","resultado");					resMensaje = getXml(cubo,"validacion","mensaje");					if(resMensaje &! ""){						frn.message(resMensaje, "Mensaje","&Aceptar");					}											if(resValidacion &= "0"){						frn.setPos("k_fecha");						return;					}									}			}													fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaciï¿½n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se estï¿½ en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}			}				</script></pag>