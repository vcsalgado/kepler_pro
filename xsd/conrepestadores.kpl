<?xml version="1.0" encoding="UTF-8"?><pag xmlns='www.kepler.com.mx/2003/KSchema' tit="Estado de resultados">	<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim='1,-1,10,20' bclr="192,205,213" unfont="0" OnF1="Dialog(1,conrepedoayu)" tit="Estados financieros" clrBrdr="0,97,181">		<br/>		<tab/><txt clr="0,0,0" fnt="Arial,25">Estado de Resultados</txt><br/>		<tab/><hLine clr="0,0,0" dim="-1,0"/>		<br/><br/>		<tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" dim="32,10,7,12" tit="Criterio de impresi&#243;n"  fnt="Arial,16">			<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" dim="28,9,7,12"  fnt="Arial,16"><tab/>				<txt>A&#241;o:</txt><tab/>				<cmb id="k_anio" clr="64,64,64" clrBrdr="255,255,255"  dim="10,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					available="Y" Null="N" modify="Y"/>				<br/><tab/>				<txt fnt="Arial,16" clr="0,58,112">Mes:</txt><tab/>				<cmb id="k_mes" clr="64,64,64" clrBrdr="192,205,213"  					dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" available="Y"/>								<tab/><br/>				<tab/>				<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Detalle de anexos</txt><tab/><chck id="dt" clr="64,64,64"  dim="3,16" bclr="255,255,255" brdr="2,0" YN="10" clrBrdr="255,255,255"/><br/><tab/><txt fnt="Arial,15"  bclr="255,255,255">Omitir cuentas en cero</txt><chck id="cc" dim="3,16" clr="64,64,64" bclr="255,255,255" brdr="2,0" YN="10" clrBrdr="255,255,255"/>				<tab/>						<br/>			</grp>			<tab/>			<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="0" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" dim="10,9,7,12" fnt="Arial,16">					<br/><br/><br/><br/>				<tab/>				<img id="k_ejecuta" dim="40,40" brdr="0,1" bPx="1" img="_60_ExecuteReport.png" OnEnter="Reporte()" tooltip="Ejecutar(Ctrl+T)" available="Y" default="1"/>							</grp>				</grp>	</grp>	<tools>		<tool name="ejecuta" OnMouseL="Reporte()" tooltip="Ejecutar(Ctrl+T)" scut="Ctrl+T" img="_TL_Execute.png"/>	</tools><script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys;			var year,salIni,salFin,descMes,anno;			var nivel,long,totmes,totAcum,totMesVta,totAcumVta;			var nocta,nomcta,sIni;			var fIni,fFin,cIni,cFin,comparar;			var cEne,cFeb,cMar,cAbr,cMay,cJun,cJul,cAgo,cSep,cOct,cNov,cDic;			var aEne,aFeb,aMar,aAbr,aMay,aJun,aJul,aAgo,aSep,aOct,aNov,aDic;			var rIni,rFin,montoMes,mesA,w,rvIni,rvFin;			var utilBrutaMes,utilBrutaAcum,utilOperMes,utilOperAcum,utilNetaMes,utilNetaAcum;			var totalMesPFinanPres,totalAcumPFinanPres;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;				kdb.connect();				//Revisa si hay año definido por la session				if(frn.config("temp","k_workDate")){					year=mid(frn.config("temp","k_workYear"),2,2);				}else {					kdb.kde("yr");kdb.exec();					year=kdb.get("yr",14);				}				kdb.open("c,kdc1" & year);				anno=year;				Inicializa();				IniParams();//Inicializa parámtros de impresión entre otros			}							fun IniParams(){//Inicializa parámetros de impresión, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Página				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","N");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}						fun Inicializa(){//Inicializa los valores en Pantalla				var nMes,cont,anioFin;				//Combo de anio, el anio viene en year desde main				anioFin="20"&year;				for(cont=2020; cont<=anioFin; cont++){					frn.setX(cont,"k_anio",cont-2020,0);				}				frn.set("k_anio",anioFin);								for(cont=1; cont<=12; cont++){					nMes=cont;					if (strlen(nMes)==1){						nMes="0" & nMes;					}					frn.setX(nMes,"k_mes",cont-1,0);				}				nMes=fnDate("month",sys.date());								if (strlen(nMes)==1){					nMes="0" & nMes;				}				frn.set("k_mes",nMes);			}						fun Reporte(){//Ejecuta el Reporte				var anioRep;				anioRep=frn.get("k_anio",-1,0);				// Se define el formato a usar y se imprime el encabezado				kdb.readPage("datos","conrepestadoresfto");//se define el formato a usar				kdb.kde("KDE");//										Configuración del servidor				kdb.exec();				rep.source(kdb.get("datos")); 				rep.rst(); 				setRepPage();//Establece los parámetros finales de impresión.(rep.page(...);)				rep.set("fecha",sys.date());rep.set("hora",sys.time());				ObtenMes();				rep.set("numMes","Estado de Resultados del mes de "&descMes&" del "&anioRep);				rep.set("empresa",kdb.get("KDE",1));				rep.exe("encabezadoP");				//Genera el reporte para las cuentas solicitadas				Imprime();								rep.win(); 			}						fun ObtenMes(){				if (frn.get("k_mes",-1,0)&="01") { descMes="Enero"; }				if (frn.get("k_mes",-1,0)&="02") { descMes="Febrero"; }				if (frn.get("k_mes",-1,0)&="03") { descMes="Marzo"; }				if (frn.get("k_mes",-1,0)&="04") { descMes="Abril"; }				if (frn.get("k_mes",-1,0)&="05") { descMes="Mayo"; }				if (frn.get("k_mes",-1,0)&="06") { descMes="Junio"; }				if (frn.get("k_mes",-1,0)&="07") { descMes="Julio"; }				if (frn.get("k_mes",-1,0)&="08") { descMes="Agosto"; }				if (frn.get("k_mes",-1,0)&="09") { descMes="Septiembre"; }				if (frn.get("k_mes",-1,0)&="10") { descMes="Octubre"; }				if (frn.get("k_mes",-1,0)&="11") { descMes="Noviembre"; }				if (frn.get("k_mes",-1,0)&="12") { descMes="Diciembre"; }			}						fun Imprime(){				var anioRep;				anioRep=frn.get("k_anio",-1,0);				mesA=frn.get("k_mes",-1,0);				kdb.sp("k_cnt","modo:niveles","dat:cuentas","cve:'001'-'999'","niv:2","stat:1","ao:"&anioRep);				kdb.iov("GET,CUENTAS,a1...a24,$,datos");kdb.exec();				ObtenTotalVta();				var nCtas=kdb.N("cuentas");				for (w=1;w<=5;w++){					ObtenClasificacionCuentas();					totmes=0;totAcum=0;					for (var i=0;i<nCtas;i++){						nocta=kdb.get("cuentas","r" & i,"cta");						nomcta=kdb.get("cuentas","r" & i,"dsc");						long=strlen(rIni); comparar=mid(nocta,0,long);						if (strcmp(comparar,rIni)>=0 && strcmp(comparar,rFin)<=0){							//Obtiene el saldo Inicial 							sIni=kdb.get("cuentas","r" & i,"c14");												//Obtienen el total de cargos y abonos							cEne=kdb.get("cuentas","r" & i,"c27"); 							cFeb=kdb.get("cuentas","r" & i,"c28"); 							cMar=kdb.get("cuentas","r" & i,"c29"); 							cAbr=kdb.get("cuentas","r" & i,"c30"); 							cMay=kdb.get("cuentas","r" & i,"c31"); 							cJun=kdb.get("cuentas","r" & i,"c32"); 							cJul=kdb.get("cuentas","r" & i,"c33"); 							cAgo=kdb.get("cuentas","r" & i,"c34"); 							cSep=kdb.get("cuentas","r" & i,"c35"); 							cOct=kdb.get("cuentas","r" & i,"c36"); 							cNov=kdb.get("cuentas","r" & i,"c37"); 							cDic=kdb.get("cuentas","r" & i,"c38"); 												aEne=kdb.get("cuentas","r" & i,"c63");							aFeb=kdb.get("cuentas","r" & i,"c64");							aMar=kdb.get("cuentas","r" & i,"c65");							aAbr=kdb.get("cuentas","r" & i,"c66");							aMay=kdb.get("cuentas","r" & i,"c67");							aJun=kdb.get("cuentas","r" & i,"c68");							aJul=kdb.get("cuentas","r" & i,"c69");							aAgo=kdb.get("cuentas","r" & i,"c70");							aSep=kdb.get("cuentas","r" & i,"c71");							aOct=kdb.get("cuentas","r" & i,"c72");							aNov=kdb.get("cuentas","r" & i,"c73");							aDic=kdb.get("cuentas","r" & i,"c74");												//ObtenNivel();							nivel=kdb.get("cuentas","r" & i,"niv");							ObtenAcumulado();							ObtenMontoMes();													//Si la cuenta es de ventas, invierte el signo							if (w==1) {								montoMes=montoMes*(-1);								salFin=salFin*(-1);							}													//Define los colores en negro							rep.setAtt("montoMes3P","clr","0,0,0");							rep.setAtt("montoMesP","clr","0,0,0");							rep.setAtt("montoAcum3P","clr","0,0,0"); 							rep.setAtt("montoAcumP","clr","0,0,0");									if (frn.get("dt")==1 && nivel>1){								if (montoMes<0) { rep.setAtt("montoMes3P","clr","255,0,0"); } 								if (salFin<0) { rep.setAtt("montoAcum3P","clr","255,0,0"); } 								if (salFin!=0 || frn.get("cc")!=1){									rep.set("descripcion3P",nomcta);									rep.set("montoMes3P",montoMes);									rep.set("montoAcum3P",salFin);									rep.set("porMes3P",(montoMes/totMesVta)*100);									rep.set("porAcum3P",(salFin/totAcumVta)*100);									rep.exe("detalle3");								}							}													if (nivel==1){							if (montoMes<0) { rep.setAtt("montoMesP","clr","255,0,0"); } 							if (salFin<0) { rep.setAtt("montoAcumP","clr","255,0,0"); } 							if (salFin!=0 || frn.get("cc")!=1){								rep.set("descripcionP",nomcta);								rep.set("montoMesP",montoMes);								rep.set("montoAcumP",salFin);								rep.set("porMesP",(montoMes/totMesVta)*100);								rep.set("porAcumP",(salFin/totAcumVta)*100);								rep.exe("detalle2");								totmes=totmes+montoMes;								totAcum=totAcum+salFin;							}													}											}					}				ImprimeTotales();				rep.exe("vacio");				}			}						fun ImprimeTotales(){								rep.setAtt("totalMesVtaP","clr","0,51,204");				rep.setAtt("totalAcumVtaP","clr","0,51,204");				rep.setAtt("totalMesCtoP","clr","0,51,204"); 				rep.setAtt("totalAcumCtoP","clr","0,51,204");					rep.setAtt("totalMesGtoP","clr","0,51,204"); 				rep.setAtt("totalAcumGtoP","clr","0,51,204");					rep.setAtt("totalMesPFinanP","clr","0,51,204"); 				rep.setAtt("totalAcumPFinanP","clr","0,51,204");					rep.setAtt("totalMesImpP","clr","0,51,204"); 				rep.setAtt("totalAcumImpP","clr","0,51,204");					if (w==1) {					if (totmes<0) { rep.setAtt("totalMesVtaP","clr","255,0,0"); } 					if (totAcum<0) { rep.setAtt("totalMesAcumP","clr","255,0,0"); } 					rep.set("porTotMesP",(totmes/totMesVta)*100);					rep.set("porTotAcumP",(totAcum/totAcumVta)*100);					rep.set("totalMesVtaP",totmes); rep.set("totalAcumVtaP",totAcum);rep.exe("totalventas"); 					utilBrutaMes=totmes; utilBrutaAcum=totAcum;				}				if (w==2) {					//Imprime totales de costo					if (totmes<0) { rep.setAtt("totalMesCtoP","clr","255,0,0"); } 					if (totAcum<0) { rep.setAtt("totalMesCtoP","clr","255,0,0"); } 					rep.set("porTotCtoMesP",(totmes/totMesVta)*100);					rep.set("porTotCtoAcumP",(totAcum/totAcumVta)*100);					rep.set("totalMesCtoP",totmes); rep.set("totalAcumCtoP",totAcum);rep.exe("totalcosto"); 					//Imprime Totales de utilidad bruta					utilBrutaMes=utilBrutaMes-totmes; utilBrutaAcum=utilBrutaAcum-totAcum;					rep.set("porTotMesUBP",(utilBrutaMes/totMesVta)*100);					rep.set("porTotAcumUBP",(utilBrutaAcum/totAcumVta)*100);					rep.set("totalMesUBP",utilBrutaMes); rep.set("totalAcumUBP",utilBrutaAcum);rep.exe("utilidadbruta"); 				}				if (w==3) {					if (totmes<0) { rep.setAtt("totalMesGtoP","clr","255,0,0"); } 					if (totAcum<0) { rep.setAtt("totalMesGtoP","clr","255,0,0"); } 					rep.set("porTotGtoMesP",(totmes/totMesVta)*100);					rep.set("porTotGtoAcumP",(totAcum/totAcumVta)*100);					rep.set("totalMesGtoP",totmes); rep.set("totalAcumGtoP",totAcum);rep.exe("totalgastos"); 					//Imprime Totales de utilidad operativa					utilOperMes=utilBrutaMes-totmes; utilOperAcum=utilBrutaAcum-totAcum;					rep.set("porTotMesUOP",(utilOperMes/totMesVta)*100);					rep.set("porTotAcumUOP",(utilOperAcum/totAcumVta)*100);					rep.set("totalMesUOP",utilOperMes); rep.set("totalAcumUOP",utilOperAcum);rep.exe("utilidadoperativa"); 				}				if (w==4) {					if (totmes<0) { rep.setAtt("totalMesPFinanP","clr","255,0,0"); } 					if (totAcum<0) { rep.setAtt("totalMesPFinanP","clr","255,0,0"); } 					rep.set("porTotPFMesP",(totmes/totMesVta)*100);					rep.set("porTotPFAcumP",(totAcum/totAcumVta)*100);					rep.set("totalMesPFinanP",totmes); rep.set("totalAcumPFinanP",totAcum);rep.exe("totalprodfinan"); 					totalMesPFinanPres=totmes;totalAcumPFinanPres=totAcum;				}				if (w==5) {					if (totmes<0) { rep.setAtt("totalMesImpP","clr","255,0,0"); } 					if (totAcum<0) { rep.setAtt("totalMesImpP","clr","255,0,0"); } 					rep.set("porTotImpMesP",(totmes/totMesVta)*100);					rep.set("porTotImpAcumP",(totAcum/totAcumVta)*100);					rep.set("totalMesImpP",totmes); rep.set("totalAcumImpP",totAcum);rep.exe("totalimpuestos"); 					//Imprime Totales de utilidad neta					utilNetaMes=utilOperMes-totalMesPFinanPres-totmes; 					utilNetaAcum=utilOperAcum-totalAcumPFinanPres-totAcum;					rep.set("porTotMesUNP",(utilNetaMes/totMesVta)*100);					rep.set("porTotAcumUNP",(utilNetaAcum/totAcumVta)*100);					rep.set("totalMesUNP",utilNetaMes); rep.set("totalAcumUNP",utilNetaAcum);rep.exe("utilidadneta"); 				}			}						fun ObtenMontoMes(){				if (mesA&="01") { montoMes=cEne-aEne; }				if (mesA&="02") { montoMes=cFeb-aFeb; }				if (mesA&="03") { montoMes=cMar-aMar; }				if (mesA&="04") { montoMes=cAbr-aAbr; }				if (mesA&="05") { montoMes=cMay-aMay; }				if (mesA&="06") { montoMes=cJun-aJun; }				if (mesA&="07") { montoMes=cJul-aJul; }				if (mesA&="08") { montoMes=cAgo-aAgo; }				if (mesA&="09") { montoMes=cSep-aSep; }				if (mesA&="10") { montoMes=cOct-aOct; }				if (mesA&="11") { montoMes=cNov-aNov; }				if (mesA&="12") { montoMes=cDic-aDic; }			}						fun ObtenClasificacionCuentas(){			   //kdb.iov("GET,cuentas,a1...a24,$,datos");kdb.exec();				if (w==1) {					rIni=kdb.get("datos","a13");rFin=kdb.get("datos","a14"); 					rvIni=kdb.get("datos","a13");rvFin=kdb.get("datos","a14");					rep.exe("ventas");				}				if (w==2) {rIni=kdb.get("datos","a15");rFin=kdb.get("datos","a16"); rep.exe("costo");}				if (w==3) {rIni=kdb.get("datos","a17");rFin=kdb.get("datos","a18"); rep.exe("gastos");}				if (w==4) {rIni=kdb.get("datos","a19");rFin=kdb.get("datos","a20"); rep.exe("prodfinan");}				if (w==5) {rIni=kdb.get("datos","a21");rFin=kdb.get("datos","a22"); rep.exe("impuestos");}				if (w==6) {rIni=kdb.get("datos","a23");rFin=kdb.get("datos","a24");}			}						fun ObtenTotalVta(){				totMesVta=0;totAcumVta=0;				var nCtas=kdb.N("cuentas");				//kdb.iov("GET,cuentas,a1...a24,$,datos");kdb.exec();				rIni=kdb.get("datos","a13");rFin=kdb.get("datos","a14"); 				for (var i=0;i<nCtas;i++){					nocta=kdb.get("cuentas","r" & i,"cta");					nomcta=kdb.get("cuentas","r" & i,"dsc");					long=strlen(rIni); comparar=mid(nocta,0,long);					if (strcmp(comparar,rIni)>=0 && strcmp(rFin,comparar)>=0){						//Obtiene el saldo Inicial 						sIni=kdb.get("cuentas","r" & i,"c14");											//Obtienen el total de cargos y abonos						cEne=kdb.get("cuentas","r" & i,"c27"); 						cFeb=kdb.get("cuentas","r" & i,"c28"); 						cMar=kdb.get("cuentas","r" & i,"c29"); 						cAbr=kdb.get("cuentas","r" & i,"c30"); 						cMay=kdb.get("cuentas","r" & i,"c31"); 						cJun=kdb.get("cuentas","r" & i,"c32"); 						cJul=kdb.get("cuentas","r" & i,"c33"); 						cAgo=kdb.get("cuentas","r" & i,"c34"); 						cSep=kdb.get("cuentas","r" & i,"c35"); 						cOct=kdb.get("cuentas","r" & i,"c36"); 						cNov=kdb.get("cuentas","r" & i,"c37"); 						cDic=kdb.get("cuentas","r" & i,"c38"); 										aEne=kdb.get("cuentas","r" & i,"c63");						aFeb=kdb.get("cuentas","r" & i,"c64");						aMar=kdb.get("cuentas","r" & i,"c65");						aAbr=kdb.get("cuentas","r" & i,"c66");						aMay=kdb.get("cuentas","r" & i,"c67");						aJun=kdb.get("cuentas","r" & i,"c68");						aJul=kdb.get("cuentas","r" & i,"c69");						aAgo=kdb.get("cuentas","r" & i,"c70");						aSep=kdb.get("cuentas","r" & i,"c71");						aOct=kdb.get("cuentas","r" & i,"c72");						aNov=kdb.get("cuentas","r" & i,"c73");						aDic=kdb.get("cuentas","r" & i,"c74");										//ObtenNivel();						nivel=kdb.get("cuentas","r" & i,"niv");						ObtenAcumulado();						ObtenMontoMes();												//Si la cuenta es de ventas, invierte el signo						if (w==1) {							montoMes=montoMes*(-1);							salFin=salFin*(-1);						}												if (nivel==1){							totMesVta=totMesVta+montoMes;							totAcumVta=totAcumVta+salFin;						}					}					}				totMesVta=totMesVta*(-1);				totAcumVta=totAcumVta*(-1);			}						fun ObtenNivel(){				nivel=1;				long=strlen(nocta);				for (var j=0;j<long;j++){				  var car=mid(nocta,j,1);				  if (strcmp(car,mid(" -",1,1))==0){						nivel=nivel+1;				  }				}			}						fun ObtenAcumulado(){				if (mesA&="01") { salFin=sIni+(cEne-aEne); }				if (mesA&="02") { salFin=sIni+((cEne+cFeb)-(aEne+aFeb)); }				if (mesA&="03") { salFin=sIni+((cEne+cFeb+cMar)-(aEne+aFeb+aMar)); }				if (mesA&="04") { salFin=sIni+((cEne+cFeb+cMar+cAbr)-(aEne+aFeb+aMar+aAbr)); }				if (mesA&="05") { salFin=sIni+((cEne+cFeb+cMar+cAbr+cMay)-(aEne+aFeb+aMar+aAbr+aMay)); }				if (mesA&="06") { salFin=sIni+((cEne+cFeb+cMar+cAbr+cMay+cJun)-(aEne+aFeb+aMar+aAbr+aMay+aJun)); }				if (mesA&="07") { salFin=sIni+((cEne+cFeb+cMar+cAbr+cMay+cJun+cJul)-(aEne+aFeb+aMar+aAbr+aMay+aJun+aJul)); }				if (mesA&="08") { salFin=sIni+((cEne+cFeb+cMar+cAbr+cMay+cJun+cJul+cAgo)-(aEne+aFeb+aMar+aAbr+aMay+aJun+aJul+aAgo)); }				if (mesA&="09") { salFin=sIni+((cEne+cFeb+cMar+cAbr+cMay+cJun+cJul+cAgo+cSep)-(aEne+aFeb+aMar+aAbr+aMay+aJun+aJul+aAgo+aSep)); }				if (mesA&="10") { salFin=sIni+((cEne+cFeb+cMar+cAbr+cMay+cJun+cJul+cAgo+cSep+cOct)-(aEne+aFeb+aMar+aAbr+aMay+aJun+aJul+aAgo+aSep+aOct)); }				if (mesA&="11") { salFin=sIni+((cEne+cFeb+cMar+cAbr+cMay+cJun+cJul+cAgo+cSep+cOct+cNov)-(aEne+aFeb+aMar+aAbr+aMay+aJun+aJul+aAgo+aSep+aOct+aNov)); }				if (mesA&="12") { salFin=sIni+((cEne+cFeb+cMar+cAbr+cMay+cJun+cJul+cAgo+cSep+cOct+cNov+cDic)-(aEne+aFeb+aMar+aAbr+aMay+aJun+aJul+aAgo+aSep+aOct+aNov+aDic)); }			}					fun setRepPage() {//Establece los parámetros finales de impresión.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}		}					/*Autor									Fecha							Cambio			---------------------------------------------------------------			Diana Barreto						13-04-2010						En el formato se cambio el nombre de la variable TotMesUNP por TotAcumUNP ya que estaba incorrecto			Veronica Catalán					2018-04-26						-Se agrega opción de omitir cuentas en cero.			*/	</script></pag>