<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Tipos de Ordenes"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">	<tab/><txt fnt=",22" clr="0,0,0">  TIPOS DE ORDENES</txt><tab/>	<br/>		<tab/><hLine clr="0,0,0"	dim="45,0,0,0"/>	<br/>	<br/><tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="45,25,10,17" brdr="0,5" tit="Tipos de Ordenes" fnt="Arial,16">					<sp/><txt clr="0,58,112" hk="S">Sucursal:</txt>		<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="23,36" bclr="255,255,255" brdr="2,0" OnChange="ResetDetalle()" fnt="Arial,16" Null="N" hk="S" available="Y"/>		<sp n="2"/><txt>Tipo Orden:</txt>		<cmb id="cmb_tipo_orden" dim="25,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y" fnt="Arial,0" Null="N" OnChange="ResetDetalle()"/>	<tab/>		<img id="img_buscar" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="ObtenerOrdenes()"/>			<br/>		<sp/>				<tbl id="k_mov" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="88,20" modify="Y" Reorder="Y" available="Y" insdel="Y">			<col name="Tipo Orden" id="tipo_orden" nc="1" modify="N" visible="Y"/>			<col name="Tipo Trabajo" id="tipo_trabajo" nc="1" visible="Y"/>			<col name="Descripcion" id="descripcion" visible="Y"/>			<col name="Costo p/Hora" id="costo_hora"  type="number" nd="2" visible="Y"/>			<col name="Margen Refs y M.Internos" id="m_refacciones_y_m_i"  type="number" visible="Y"/>			<col name="Margen TOTs" id="m_tots"  type="number" visible="Y"/>				<col name="Margen Cargos Varios" id="m_cargos_varios"  type="number" visible="Y"/>				<col name="Factor de conversion" id="factor_conversion"  type="number" visible="Y"/>			<col name="Folio actual" id="folio_actual"  type="number" modify="N" visible="Y"/>				<col name="Margen Refs y M.Externos" id="m_refacciones_y_m_e"  type="number" visible="Y"/>				<col name="IVA" id="iva"  type="number" visible="Y"/>				<col name="Imprimir Vale Salida" id="imp_vale_salida" nc="1" type="text" visible="Y"/>				<col name="Preferencia" id="preferencia"  type="number" visible="Y"/>				<col name="Grupo de Folio" id="grupo_folio" nc="1" type="text" visible="Y"/>				<col name="Horas/diagnostico" id="horas_diagnostico"  type="number" visible="Y"/>				<col name="Cargos_varios/diagnostico" id="cargos_varios_diagnostico"  type="number" visible="Y"/>				</tbl>		<br/><sp/>		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Guardar" hk="K" default="0" step="0"  OnEnter="Guardar()" fnt="Arial,16"/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, asterisco  ;		var cmdQuery, cuboQuery, ok, mensajeError;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			rol_usuario = frn.config("user","role");			asterisco = "*";									ConfiguraUI();			Inicializa();		}            		fun llena_combos(){					//Llenar combo sucursales			cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}			}							cmdQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery ,"cat_crud_vendedores.Inicializa()");								ok=getXmlAtt(cmdQuery ,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cmdQuery ,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}							frn.set("k_sucN",getXml(cmdQuery ));			frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));																//tipos de Ordenes cmdQuery = "select '['||c1||'] '||c2 as descripcion, c1 as clave from keplersc.kdcatcitasordenes ";			cmdQuery = "select '['||c1||'] '||c2 as descripcion, c1 as clave from keplersc.kdcatcitasordenes ";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_tipos_ordenes.llena_combos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}								var cmd_tipo_orden = "cmb_tipo_orden";			llenar_cmb(cuboQuery ,cmd_tipo_orden );			frn.set(cmd_tipo_orden ,descr_combo(cmd_tipo_orden ,1,"T"));			ResetDetalle();		}				fun ResetDetalle(){			frn.rst("k_mov");		}				fun ObtenerOrdenes(){			var xmlPantalla;			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			cmdQuery = "select c1 as  tipo_orden, c2 as tipo_trabajo, c3 as descripcion, c4 as costo_hora, c5 as m_refacciones_y_m_i, c6 as m_tots, c7 as m_cargos_varios, ";			cmdQuery = cmdQuery & " c8 as factor_conversion, c9 as folio_actual, c10 as m_refacciones_y_m_e, c11 as iva,  c12 as imp_vale_salida, c13 as preferencia , ";			cmdQuery = cmdQuery & " c14 as grupo_folio, c15 as horas_diagnostico, c16 as cargos_varios_diagnostico from keplersc.kdmargen ";			cmdQuery = cmdQuery & " where c1='" & frn.get("cmb_tipo_orden" , -1, 1) & "'";							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_tipos_ordenes.ObtenerOrdenes()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_mov",cuboQuery);					}				fun Guardar(){			var xmlPantalla,resultado,mensaje,adicionales;						xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;											frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaLineas");			cmdQuery="select * from keplersc.tipos_ordenes_editar('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						kdb.rst(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_crud_vendedores.Alta");			resultado= getXml(cuboQuery,"resultado");			mensaje= getXml(cuboQuery,"mensaje");							if(resultado &= "0"){				frn.message(mensaje,"Error","Aceptar");				return;			}			frn.message("Registros modificados","Mensaje","Aceptar");		}				fun ConfiguraUI(){			if (frn.nParam() == 0){				frn.message("Acción no permitida.","Error","&Aceptar");//				frn.open("redirect",2);				return;			}		}				fun Inicializa(){				llena_combos();			ObtenerOrdenes();		}		  		fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}												fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}			           					}				</script></pag>