<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Ordenes Taller"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/><txt clr="0,0,0" fnt="Arial,25">Iniciar/Terminar Trabajo</txt><br/>	<tab/><hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp dim="110,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle de la orden">			<sp/><txt fnt=",b">Sucursal:</txt><sp/><inp id="k_sucursal" dim="5,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<sp/><inp id="k_sucnombre" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/><tab/><txt fnt=",b">Fecha:  </txt>			<inp id="k_fecha" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" modify="N" available="N" fmt="DD/MM/CCYY" nc="-1" fnt=",0"/><tab/><txt fnt=",b">Estatus:</txt>			<inp id="k_estatusdesc" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/><tab n="2"/>			<br/>			<sp/><txt  fnt="Arial,b">Tipo:</txt><sp/><inp id="k_tipo" clr="64,64,64"  dim="3,1" fnt="Arial,0" clrBrdr="255,255,255"   bclr="255,255,255" modify="N" visible="Y" type="string" brdr="2,0"/>			<sp/><inp id="k_tipodesc" dim="25,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" fnt=",0" modify="N" available="N"/>			<tab/><txt  fnt="Arial,b">Folio:</txt><sp/><inp id="k_folio" clr="64,64,64"  dim="18,1" fnt="Arial,0" clrBrdr="255,255,255"   bclr="255,255,255" brdr="2,0"  modify="N" visible="Y" type="string"/>			<tab/><txt fnt=",b">Cliente: </txt><sp/><inp id="k_cliente" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<sp/><inp id="k_nombre" dim="50,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<br/>			<sp/><txt fnt=",b">VIN: </txt><sp/><inp id="k_serie" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b"> Marca:</txt><sp/>	<inp id="k_marca" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b">Modelo:</txt><sp/><inp id="k_modelo" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b">A&#241;o:</txt><sp/><inp id="k_anio" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b">Placas:</txt><sp/><inp id="k_placa" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b">Bonete:</txt><sp/><inp id="k_bonete" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>	</grp>	<br/><br/>		<tab/>		<grp dim="110,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Opciones">			<grp dim="25,50,10,10" bclr="236,240,243" fntClrBrdr="255,206,0" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112"  brdr="0,5" fnt="Arial,16">			<br/>			<tab n="1"/><bot id="bot_iniciar_trabajo" dim="14,0" brdr="5" text="Iniciar Trabajo" default="0" OnEnter="Edicion(srv_iniciar_trabajo)"/>		</grp>				<tab n="1"/>		<grp dim="30,50,10,10" bclr="236,240,243" fntClrBrdr="255,206,0" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">			<sp/><br/>			<tab n="1"/><bot id="bot_terminar_trabajo" dim="16,0" brdr="5" text="Terminar Trabajo" default="0" OnEnter="Edicion(srv_terminar_trabajo)"/><br/>		</grp>					<br/>	</grp>	<br/><br/>			<tab/>	<grp dim="110,16,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle de puntos">		<sp/>		<tbl id="tabla_puntos" dim="155,9"  bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  hk="z" OnChange="" Reorder="N" modify="Y" available="Y">			<col id="desc_punto" name="Tipo de Punto" modify="N"  type="capital"/>			<col id="desc_operario" name="Tipo de Operario"/>			<col id="clave_paquete" name="Paquete"  modify="N"/>			<col id="trabajo_a_realizar" name="Descripcion" modify="Y" type="capital"/>			<col id="clave_campana" name="Campa&#241;a" modify="Y" type="capital"/>			<col id="horas" name="Horas" type="number" visible="Y"/>			<col id="costo_punto" name="Costo"  modify="N" type="number"/>			<col id="status" name="Estatus"  modify="N"/>		</tbl>	</grp>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario  ,asterisco, externo, sucursal,folio_orden, tipo_orden , vin;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("s,KDMS");								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								sucursal =trim(frn.param(0));				tipo_orden=trim(frn.param(1));				folio_orden=trim(frn.param(2));				vin =trim(frn.param(3));													Inicializa();			}												fun Inicializa(){				var cmd, cubo,ok,mensajeError ;				var xmlOrden, xmlDatos;							xmlOrden= frn.lib("libOrdenes.kpl","ConsultaOrden",sucursal,tipo_orden,folio_orden);								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				xmlDatos = frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",xmlOrden,"r0");				frn.lib("libGeneral.kpl","FileSave",xmlOrden,"C:\Basura\xmlOrden");					frn.lib("libGeneral.kpl","FileSave",xmlDatos,"C:\Basura\xmlDatos");							frn.setX(xmlDatos);				//actualiza descripción tipo de órden											cmd = " select c3 as descripcion from keplersc.kdmargen where c1='" & tipo_orden & "'";									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvregistrocalidad.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}                frn.set("k_tipodesc",getXmlAtt(cubo,"r0","descripcion"));								cmd = " select cat.c2 desc_punto,oper.c2 as desc_operario , pun.c5 as clave_paquete, ";				cmd = cmd & "pun.c8 as trabajo_a_realizar, pun.c50 as clave_campana, pun.c40 as horas, paq.c10 as costo_punto, pun.c7 as status ";				cmd = cmd & "from keplersc.kdord as ord left outer join keplersc.kdpun as pun on pun.c1=ord.c1 and pun.c2=ord.c2 ";				cmd = cmd & " and pun.c3=ord.c3 left outer join keplersc.kdserie as ser on ser.c1=ord.c6 ";				cmd = cmd & " left outer join keplersc.kdspaq as paq on paq.c1=ser.c2 and paq.c2=ser.c3 and paq.c4=pun.c5 ";				cmd = cmd & " left outer join keplersc.catpuntos as cat on cat.c1=pun.c6 left outer join keplersc.kdtoper as oper on oper.c1=pun.c37 ";				cmd = cmd & " where ord.c1='" & sucursal & "' and ord.c2='" & tipo_orden & "' and ord.c3='" & folio_orden & "' order by pun.c4 ";							rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"administracionordenes.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\puntos");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												frn.setX(cubo,"tabla_puntos");				}											fun Edicion(opcion){							frn.dialog(opcion,sucursal,folio_orden, tipo_orden, vin);							}		//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------								fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}																}	</script></pag>