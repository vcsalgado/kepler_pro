<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Cargar Horas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="79,67,10,10" brdr="0,5" tit="Cargar Horas" fnt="Arial,16">			<tab/><tbl id="tabla_puntos" bclr="236,240,243" clr="64,64,64" OnEnter="detalles" OnMouseD="detalles" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="73,8" modify="N" nren="fijo">		<col id="numero_punto" name="Numero de Punto"/>		<col id="tipo_punto" name="Tipo de Punto" visible="N"/>		<col id="desc_tipo_punto" name="Tipo de Punto"/>		<col id="descripcion" name="Descripcion"/>		<col id="paquete" name="Paquete"  visible="N"/>		</tbl> 		<tab n="8"/>			<br/>		<br/>	<tab n="1"/><sp/>				<txt fnt=",bs">EDITAR PUNTO NUMERO:</txt><sp/><inp id="num_punto" dim="3,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="string" brdr="0,2"/><br/>			<tab n="1"/>			<grp bclr="236,240,243" fntClrBrdr="255,206,0" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="23,15,10,10" brdr="0,5" fnt="Arial,16">				<sp/><txt fnt=",bs">Problema:</txt><br/> 				<sp/><inp id="problema" dim="20,3" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" brdr="2,0"/><br/>				<sp/><txt fnt=",bs">Causa:</txt><br/> 				<sp/><inp id="causa" dim="20,3" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" brdr="2,0"/><br/>				<sp/><txt fnt=",bs">Correccion:</txt><br/> 				<sp/><inp id="correccion" dim="20,3" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" brdr="2,0"/><br/>						<br/>				</grp>						<grp bclr="236,240,243" fntClrBrdr="255,206,0" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="27,23,10,10" brdr="0,5" fnt="Arial,16">				<br/>	<br/>								<sp/><txt>Operario:</txt>				<inp id="operario" dim="7,1" bclr="192,205,213" clr="64,64,64" modify="N" OnF9="Seleccionar_operario()" clrBrdr="255,255,255" type="string" brdr="0,2"/>				<sp/><txt>Tipo:</txt>				<inp id="desc_tipo_ope" dim="17,1" bclr="192,205,213" clr="64,64,64" modify="N"  clrBrdr="255,255,255" type="string" brdr="0,2"/>				<inp id="tipo_ope" dim="7,1" bclr="192,205,213" clr="64,64,64" modify="N" visible="N" clrBrdr="255,255,255" type="string" brdr="0,2"/>				<br/>				<br/>								<sp/><txt>Codigo Falla:</txt>				<inp id="codigo_falla" dim="3,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" brdr="2,0"/>								<sp/><txt>Queja del Cliente:</txt>				<inp id="queja_cliente" dim="3,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" brdr="2,0"/><br/>								<br/>				<sp/><txt fnt=",bs">Notas al Cliente:</txt><br/> 				<sp/><inp id="notas_cliente" dim="26,6" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" brdr="2,0"/>				<br/> 											</grp>															<grp bclr="236,240,243" fntClrBrdr="255,206,0" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="24,23,10,10" brdr="0,5" fnt="Arial,16">												<tab n="1"/><txt  fnt="Arial,16,b">RESUMEN DE LA ORDEN:</txt>					<br/>				<br/>	<tab n="1"/><txt  fnt="Arial,16,b">Mano de Obra:</txt>	<sp/>					<inp id="mano_obra"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N" nd="2" clrBrdr="255,255,255"/>						<br/>	<tab n="1"/><txt  fnt="Arial,16,b">Refacciones:</txt>	<sp n="2"/>				<inp id="refacciones"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N"  nd="2" clrBrdr="255,255,255"/>						<br/>	<tab n="1"/><txt  fnt="Arial,16,b">TOTs:</txt>	<sp n="7"/>				<inp id="tots"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N" nd="2" clrBrdr="255,255,255"/>						<br/>	<tab n="1"/><txt  fnt="Arial,16,b">Cargos Varios:</txt>	<sp/>				<inp id="cargos_varios"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N"  nd="2" clrBrdr="255,255,255"/>						<br/>								<br/>	<tab n="1"/><txt  fnt="Arial,16,b">Subtotal:</txt>	<sp n="5"/>				<inp id="subtotal"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N"  nd="2" clrBrdr="255,255,255"/>										<br/>	<tab n="1"/><txt  fnt="Arial,16,b">IVA:</txt>	<sp n="8"/>				<inp id="iva"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N"  nd="2" clrBrdr="255,255,255"/>										<br/>	<tab n="1"/><txt  fnt="Arial,16,b">Importe:</txt>	<sp n="5"/>				<inp id="importe"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255"  nd="2" available="N"  clrBrdr="255,255,255"/>							</grp>												<br/>				<tab/><txt fnt=",bs">Horas: </txt><tab n="2"/><chck id="chk_flatrate" dim="3,16" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" YN="10" modify="N" available="N" OnChange="ResetHoras()"/><txt> Usar Flat Rate </txt>				<br/>				<tab/><tbl id="tabla_horas" bclr="236,240,243" clr="64,64,64"  clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="73,11" modify="Y">				<col id="clave_horas"  name="Clave" type="capital"/>				<col id="descripcion_horas"  modify="N" name="Descripcion"/>				<col id="horas" type="number" nd="6" name="Horas"/>				</tbl>				<br/><tab/>				<tbl id="tmp_horas" bclr="236,240,243" clr="64,64,64"  clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="30,5" Reorder="N" modify="Y" insdel="Y" visible="N">				<col id="tmp_clave_horas"  name="Clave" type="capital"/>				<col id="tmp_descripcion_horas"  modify="N" name="Descripcion"/>				<col id="tmp_horas" type="number" nd="6" name="Horas"/>				</tbl>								<tab n="10"/><bot id="bot_guardar" dim="10,0" brdr="5" text="Guardar" default="0" OnEnter="Guardar()"/>											</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,sucursal,suc_usuario,folio_orden, tipo_orden, vin, marca, modelo;			var oper_lavado, horas_lavado, clave_lavado; // VCSS 2 sep 2025 horas lavado			var serie; //VCSS labor operation			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");						sucursal = trim(frn.param(0));				tipo_orden= trim(frn.param(1));				folio_orden= trim(frn.param(2));				vin = trim(frn.param(3));					Inicializa();							}						fun	ResetHoras(){				frn.rst("tabla_horas");			}							fun Inicializa() {							var xmlRequest,cmd,ok,cuboResultados, totresultados , contresultados;				var rol_usuario = frn.config("user","role");					frn.set("chk_flatrate","0");				frn.setAtt("chk_flatrate", "modify", "N");				frn.setAtt("chk_flatrate", "available", "N");				if (rol_usuario &= "ADMINISTRADOR"){					frn.setAtt("chk_flatrate", "modify", "Y");					frn.setAtt("chk_flatrate", "available", "Y");				}								cmd= "select pun.c4 as numero_punto,pun.c6 as tipo_punto,catpun.c2 as desc_tipo_punto,pun.c8 as descripcion" ;				cmd  = cmd & "  ,pun.c5 as paquete from keplersc.kdpun as pun  ";				cmd  = cmd & " left outer join keplersc.catpuntos as catpun on catpun.c1=pun.c6 ";				cmd  = cmd & " where pun.c1='" & sucursal & "' and pun.c2='" &  tipo_orden  & "' and pun.c3='" & folio_orden & "' ";				cmd  = cmd & " and pun.c9 <> '' and (pun.c7='A' or pun.c7='T') and pun.c22 <> 'C'  order by pun.c4";							cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cargar_horas.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cuboResultados-");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.setX(cuboResultados,"tabla_puntos");								cmd= "select c2, c3, c4 from keplersc.kdserie where c1='" & vin & "'" ;				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cargar_horas.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								marca = getXmlAtt(cuboResultados,"r0","c2");				modelo = getXmlAtt(cuboResultados,"r0","c3");				serie = getXmlAtt(cuboResultados,"r0","c4"); //VCSS labor operation								//VCSS 2 sep 2025, horas lavado				cmd= "select valor from keplersc.param_oper where sucursal='00' and parametro='Horas lavado' " ;				rstXml(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cargar_horas.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboHoras");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								horas_lavado = getXmlAtt(cuboResultados,"r0","valor");								cmd= "select valor from keplersc.param_oper where sucursal='00' and parametro='Clave operacion punto lavado' " ;				rstXml(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cargar_horas.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboClave");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								clave_lavado = getXmlAtt(cuboResultados,"r0","valor");								resumen_orden();				//MSS 24092025 Validar la Operacion de Puntos de lavado				cmd= "select valor from keplersc.param_oper where sucursal='00' and parametro='Operacion punto lavado' " ;				rstXml(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cargar_horas.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboOper");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								oper_lavado = getXmlAtt(cuboResultados,"r0","valor");					if (oper_lavado &="S"){					if (strlen(clave_lavado)==0){						frn.message("Falta el parametro: Clave operacion punto lavado","Error","Aceptar");						return;					}					}											}						fun resumen_orden(){								var xmlRequest, cmd, cubo, ok, mensajeError ;				setXml(xmlRequest,"sucursal_id", sucursal );				setXml(xmlRequest,"tipo_orden", tipo_orden);				setXml(xmlRequest, "folio_orden", folio_orden);											frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestcerrarorden");				cmd="select * from keplersc.ser_calculos_montos_orden(' <document> " & getXmlStr(xmlRequest,"EOF:13_10") & " </document> ')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcerrarorden.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultadoscerrarorden");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								var cubo_datos;				var strTmp = getXmlAtt(cubo,"r0","ser_calculos_montos_orden");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_datos,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_datos,"C:\Basura\cubo_datos_cerrar_orden");								frn.set("mano_obra", getXml(cubo_datos,"importe_total_horas"));				frn.set("refacciones", getXml(cubo_datos,"importe_total_refs"));				frn.set("tots", getXml(cubo_datos,"importe_total_tots"));				frn.set("cargos_varios", getXml(cubo_datos,"importe_total_car"));				frn.set("subtotal", getXml(cubo_datos,"subtotal"));				frn.set("iva", getXml(cubo_datos,"iva_total"));				frn.set("importe", getXml(cubo_datos,"importe_total"));						}						fun detalles() {							borrar_datos();								var xmlRequest,cmd,ok,cuboResultados;					var num_pnt = frn.get("tabla_puntos", -1, "numero_punto");								if (num_pnt &= ""){					return ;				}								define_catalogos();								frn.set("num_punto",num_pnt );								frn.setAtt("tabla_horas", "modify", "Y");								cmd= "select pun.c9,pun.c10,pun.c11,pun.c12,pun.c13,pun.c14,pun.c15,ope.c2,ope.c1 from keplersc.kdpun as pun left outer join keplersc.kdtoper as ope on ope.c1=pun.c37 ";				cmd  = cmd & " where pun.c1='" & sucursal & "' and pun.c2='" &  tipo_orden  & "' and pun.c3='" & folio_orden & "' and pun.c4=" & num_pnt ;								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cargar_horas.detalles()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("operario",getXmlAtt(cuboResultados,"r0","c9"));				frn.set("tipo_ope",getXmlAtt(cuboResultados,"r0","c1"));				frn.set("desc_tipo_ope",getXmlAtt(cuboResultados,"r0","c2"));				frn.set("codigo_falla",getXmlAtt(cuboResultados,"r0","c10"));				frn.set("queja_cliente",getXmlAtt(cuboResultados,"r0","c11"));				frn.set("problema",getXmlAtt(cuboResultados,"r0","c12"));				frn.set("causa",getXmlAtt(cuboResultados,"r0","c13"));				frn.set("correccion",getXmlAtt(cuboResultados,"r0","c14"));				frn.set("notas_cliente",getXmlAtt(cuboResultados,"r0","c15"));												cmd= "select c6 as clave_horas,c7 as descripcion_horas,c8 as horas from keplersc.kdhoras ";				cmd = cmd & " where c1='" & sucursal & "' and c2='" &  tipo_orden & "' and c3='" & folio_orden & "' and c4=" & num_pnt ;							cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cargar_horas.detalles()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.setX(cuboResultados,"tabla_horas");				frn.setAtt("tabla_horas", "modify", "Y","horas");								//MSS 24092025 A los puntos de lavado con operacion LV se les asigna de forma automatica las horas				var tipo_pnt = frn.get("tabla_puntos", -1, "tipo_punto");				var horas_tab = frn.get("tabla_horas", -1, "horas");				var clave_tab  = frn.get("tabla_horas", -1, "clave_horas");									if (oper_lavado &="S" && tipo_pnt &= "L"){					if (clave_lavado &= clave_tab){						if (horas_lavado &! "" && horas_lavado &! horas_tab){							frn.message("Se ajustaron las hora del punto Lavado de: " & horas_tab & " a quedar en : " & horas_lavado & "|Guarde los cambios", "Atencion", "Aceptar");							frn.setX(horas_lavado, "tabla_horas", -1, "horas");						}					}				}								}						fun borrar_datos(){				frn.rst("num_punto");				frn.rst("problema");				frn.rst("causa");				frn.rst("correccion");				frn.rst("operario");				frn.rst("codigo_falla");				frn.rst("queja_cliente");				frn.rst("notas_cliente");				frn.rst("tabla_horas");			}									fun Seleccionar_operario() {							var cmdQuery = "select c1 as clave,c3 as descripcion from keplersc.kdoper where c2='" & frn.get("tipo_ope") & "'";            frn.dialog("genlistasel","Operarios",cmdQuery,"clave","operario", "","N");         }                  fun define_catalogos(){         				var tipo_pnt = frn.get("tabla_puntos", -1, "tipo_punto");         				if (tipo_pnt &= "S"){					frn.setAtt("tabla_horas", "OnF9", "Seleccionar_horas_punto_s()", "clave_horas");					frn.setAtt("tabla_horas", "OnF10", "" , "clave_horas");					frn.setAtt("tabla_horas", "OnF11", "" , "clave_horas");					frn.setAtt("tabla_horas", "OnChange", "insert_registro_paq()", "clave_horas");					frn.setAtt("tabla_horas", "tooltip", "Seleccionar F9", "clave_horas");				}else{					frn.setAtt("tabla_horas", "modify", "Y");					frn.setAtt("tabla_horas", "OnF9", "Tabulacion_crud(Seleccionar)" , "clave_horas");					frn.setAtt("tabla_horas", "OnF10", "Tabulacion_crud(Nuevo)", "clave_horas");					frn.setAtt("tabla_horas", "OnF11", "Tabulacion_crud(Modificar)", "clave_horas");					frn.setAtt("tabla_horas", "OnChange", "insert_registro_tab()", "clave_horas");					frn.setAtt("tabla_horas", "tooltip", "Seleccionar F9, Nuevo F10, Modificar F11", "clave_horas");				}							}									fun Tabulacion_crud(accion) {							if (accion &= "Seleccionar" ) {					frn.dialog("cat_tab_view","s","clave_horas",marca,modelo,frn.get("chk_flatrate"),serie);//VCSS labor operation				}								if (accion &= "Nuevo" ) {					frn.dialog("cat_tab_crud", accion, "x",marca,modelo, "s");				}								if (accion &= "Modificar" ) {					frn.dialog("cat_tab_crud",accion, frn.get("tabla_horas", -1, "clave_horas") , marca, modelo, "s");				}						}									fun insert_registro_tab(){			  var clave_tab  = frn.get("tabla_horas", -1, "clave_horas");				var cmd; //VCSS labor operation				//frn.message(frn.get("chk_flatrate"),"Mensaje","Aceptar");								if (frn.get("chk_flatrate") &= "0"){					cmd = "select c4,c5 from keplersc.kdtab where c1='" & marca & "' and c2='"  & modelo &  "' and c3='"  & clave_tab  &  "'";				}else{					cmd= "select clave_operacion as c3, descripcion_operacion as c4, tiempo_asignado as c5 from keplersc.laboroperation where id_grupo_vehiculo='" & mid(serie, 0, 3) &  "' and id_vehiculo='" & mid(serie, 3, 5) & "'";					}								var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cargar_horas.insert_registro_tab()");							var ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var len_result = nXml(cubo);								if (len_result == 0){					frn.message("La clave no se encuentra en el catalogo de tabulacion para el modelo: " & cmd ,"Error","Aceptar");					frn.setX("", "tabla_horas", -1, "clave_horas");					frn.setX("", "tabla_horas", -1, "descripcion_horas");					frn.setX("", "tabla_horas", -1, "horas");					return;				}			            frn.setX(getXmlAtt(cubo,"r0", "c4") , "tabla_horas", -1, "descripcion_horas");            frn.setX(getXmlAtt(cubo,"r0", "c5"), "tabla_horas", -1, "horas");				//VCSS 2 Sep 2025, a los puntos de lavado con operacion LV se les asigna de forma automatica las horas 				//y no se permite modificarlas sin importar su operacion								var tipo_pnt = frn.get("tabla_puntos", -1, "tipo_punto");				frn.setAtt("tabla_horas", "modify", "Y","horas");									if (oper_lavado &="S" && tipo_pnt &= "L"){					//MSS 25092025 Valida que solo tenga un registro de horas para punto de Lavado					frn.setAtt("tabla_horas", "modify", "N","horas");					var ctd_reg = frn.N("tabla_horas");			  					if (ctd_reg > 2){						frn.message("Sólo puede cargar una clave para el punto de Lavado","Error","Aceptar");						frn.setAtt("tabla_horas", "modify", "N");						frn.setX("", "tabla_horas", -1, "clave_horas");						frn.setX("", "tabla_horas", -1, "descripcion_horas");						frn.setX("", "tabla_horas", -1, "horas");						return;			  					}					if (clave_lavado &= clave_tab){						if (horas_lavado &! ""){							frn.setX(horas_lavado, "tabla_horas", -1, "horas");						}					}else {		//MSS 25092025 Valida que la clave de lavado solo sea la del parametro						frn.setX("", "tabla_horas", -1, "clave_horas");						frn.setX("", "tabla_horas", -1, "descripcion_horas");						frn.setX("", "tabla_horas", -1, "horas");						frn.message("Sólo puede cargar la clave: " & clave_lavado ,"Error","Aceptar");						return;						}				}				ValidaDuplicado();			//MSS 25092025 Valida que nos se duplique la clave de horas			}         			fun Seleccionar_horas_punto_s() {						var paq = frn.get("tabla_puntos", -1, "paquete");								var cmdQuery = "select c4 as clave, c5 as descripcion, c9 as horas from keplersc.kdspaq where c1='" & marca & "' and c2='" & modelo & "' and c4='" & paq & "'";								frn.dialog("genlistasel","Paquetes",cmdQuery,"clave","tabla_horas", -1, "clave_horas","N");	         }                				fun insert_registro_paq(){							  var ctd_paq = frn.N("tabla_horas");			  			  if (ctd_paq > 2){			 					frn.setAtt("tabla_horas", "modify", "N");					frn.setX("", "tabla_horas", -1, "clave_horas");					frn.setX("", "tabla_horas", -1, "descripcion_horas");					frn.setX("", "tabla_horas", -1, "horas");					return;			  			  }							  var clave_paq  = frn.get("tabla_horas", -1, "clave_horas");			  var paq_punto = frn.get("tabla_puntos", -1, "paquete");			  				if (clave_paq  &! paq_punto ){					frn.message("La clave debe corresponder al paquete que tiene el punto S","Error","Aceptar");					frn.setX("", "tabla_horas", -1, "clave_horas");					frn.setX("", "tabla_horas", -1, "descripcion_horas");					frn.setX("", "tabla_horas", -1, "horas");					return;				}         				var cmd = "select c5, c9 from keplersc.kdspaq where c1='" & marca & "' and c2='"  & modelo &  "' and c4='"  & clave_paq  &  "'";				var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cargar_horas.insert_registro_paq()");							var ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var len_result = nXml(cubo);								if (len_result == 0){					frn.message("La clave no se encuentra en el catalogo de paquetes para el modelo","Error","Aceptar");					frn.setX("", "tabla_horas", -1, "clave_horas");					frn.setX("", "tabla_horas", -1, "descripcion_horas");					frn.setX("", "tabla_horas", -1, "horas");					return;				}			            frn.setX(getXmlAtt(cubo,"r0", "c5") , "tabla_horas", -1, "descripcion_horas");            frn.setX(getXmlAtt(cubo,"r0", "c9"), "tabla_horas", -1, "horas");							}						fun Guardar(){						var cmd, cubo, ok, mensajeError,xmlRequest ;				//MSS 25092025 Depuracion del grid				Depurar_grid();				xmlRequest = getXml(frn.dataPag()); //Obtener el xml de la pantalla;							setXml(xmlRequest,"sucursal_id", sucursal );				setXml(xmlRequest, "tipo_orden", tipo_orden);				setXml(xmlRequest,"folio_orden", folio_orden);				setXml(xmlRequest,"numero_punto", frn.get("tabla_puntos", -1, "numero_punto"));				setXml(xmlRequest,"tipo_punto", frn.get("tabla_puntos", -1, "tipo_punto"));				setXml(xmlRequest,"paquete", frn.get("tabla_puntos", -1, "paquete"));				setXml(xmlRequest,"descripcion_paquete", frn.get("tabla_puntos", -1, "descripcion"));				setXml(xmlRequest,"marca", marca);				setXml(xmlRequest,"modelo", modelo);				setXml(xmlRequest,"pnt_seleccionado", frn.get("num_punto"));				setXml(xmlRequest ,"ctd_horas",frn.N("tabla_horas") - 1);							frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.ser_cargar_horas(' <document> " & getXmlStr(xmlRequest,"EOF:13_10") & " </document> ')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cargar_horas.Guardar()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var resultado = getXmlAtt(cubo,"r0","resultado");							if(resultado &= "0"){					mensajeError = getXmlAtt(cubo,"r0","mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								if(resultado &= "1"){					var mensaje = getXmlAtt(cubo,"r0","mensaje");					frn.message(mensaje ,"Atencion","Aceptar");				}								resumen_orden();							}						fun ValidaDuplicado(){				var renglon_id, renglones, cvehrs;										renglones = frn.N("tabla_horas")-1;				renglon_id = frn.getIdJ("tabla_horas");				cvehrs = frn.get("tabla_horas",-1,"clave_horas");							for (var i=0; i<renglones; i++) {					if (renglon_id != i){						if (frn.get("tabla_horas",i,"clave_horas") &= cvehrs) {  							frn.message("Verifique, esta intentado dar de alta la misma clave de horas","Error","Aceptar");														return;						}					}					}				}									fun Depurar_grid(){				//MSS 25092025 Depurar tabla_horas y dejar solo registros con datos				frn.rst("tmp_horas");				var j=0;				for (var i=0,n=frn.N("tabla_horas")-1;i<n;i++) {					if (frn.get("tabla_horas", i, "clave_horas") &! "" && frn.get("tabla_horas", i, "horas") != 0){						frn.setX(frn.get("tabla_horas", i, "clave_horas") ,"tmp_horas", j, "tmp_clave_horas");						frn.setX(frn.get("tabla_horas", i, "descripcion_horas") ,"tmp_horas", j, "tmp_descripcion_horas");						frn.setX(frn.get("tabla_horas", i, "horas") ,"tmp_horas", j, "tmp_horas");						j=j+1;					}				}								frn.rst("tabla_horas");				for (var i=0,n=frn.N("tmp_horas")-1;i<n;i++) {					frn.setX(frn.get("tmp_horas", i, "tmp_clave_horas") ,"tabla_horas", i, "clave_horas");					frn.setX(frn.get("tmp_horas", i, "tmp_descripcion_horas") ,"tabla_horas", i, "descripcion_horas");					frn.setX(frn.get("tmp_horas", i, "tmp_horas") ,"tabla_horas", i, "horas");				}							}					}	</script></pag>