<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Reporte de movimientos por producto">	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<tab/><txt fnt=",22" clr="0,0,0">Movimientos por producto</txt><br/>		<tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp dim="40,20,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="8" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Criterio de selecci&#243;n">			<tab/><txt>Sucursal:</txt><sp n="2"/><cmb id="cmb_sucursal" dim="50,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y"/><tab/><br/><br/>			<tab/><txt>Fecha inicial: </txt>			<edt id="edt_fecha_ini" dim="14,1" brdr="0,5" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" fmt="DD/MM/CCYY" fnt="Arial,16" page="_ks_fecha,edt_fecha_ini"/>			<tab n="2"/><txt>Fecha final: </txt>			<edt id="edt_fecha_fin" dim="14,1" brdr="0,5" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" fmt="DD/MM/CCYY" fnt="Arial,16" page="_ks_fecha,edt_fecha_fin"/><br/><br/>			<tab/><txt>Producto inicial:</txt><sp/>			<edt id="edt_prod_ini" dim="20,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" fnt="Arial,15"				page="invcatprdbus,edt_prod_ini" OnF9="Dialog(1,invcatprdbus,edt_prod_ini)"/>			<tab/><txt>Producto final:</txt><sp/>			<edt id="edt_prod_fin" dim="20,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" fnt="Arial,15"				page="invcatprdbus,edt_prod_fin" OnF9="Dialog(1,invcatprdbus,edt_prod_fin)"/><br/><br/>			<tab/><txt>Excluir productos sin movimiento </txt>			<chck id="ch_excluir" dim="3,16" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><br/>						<tab n="1"/><bot id="bot_ejecutar" dim="20,0" brdr="5" text="Ejecutar" OnEnter="Execute()" default="1"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;								kdb.connect();				kdb.open("i,kdini,j,kdinm,k,kdink,l,kdinl,s,kdms,m,kdmm");				Inicializa();							}						fun Inicializa(){//Inicializa los valores en Pantalla				frn.set("edt_fecha_ini",sys.date(sys.date("year"),sys.date("month"),1));				frn.set("edt_fecha_fin",sys.date(sys.date("year"),sys.date("month"),31));				IniCombos();				IniParams();//Inicializa parámtros de impresión entre otros				ValFecha();				frn.set("ch_excluir","1");			}									fun IniCombos(){				var cmd, cuboQuery, xmlResQuery, ok, mensajeError, strTmp;				cuboQuery="datDoc";							//Llenar combo de Sucursales								cmd = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdms";				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepestprod.IniCombos()");								ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("cmb_sucursal",cuboQuery);												//Llenar combos de productos				kdb.search("datosI,i,1,7,&,i1");				kdb.search("datosF,i,1,8,&,i1");				kdb.exec();				frn.set("edt_prod_ini",kdb.get("datosI","i1"));				frn.set("edt_prod_fin",kdb.get("datosF","i1"));					//frn.lib("libGeneral.kpl","FileSave",kdb.get("datalm"),"D:\Basura\datalm");											}			fun IniParams(){//Inicializa parámetros de impresión, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Página				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}			fun setRepPage() {//Establece los parámetros finales de impresión.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}						fun ValFecha(){				if(frn.get("edt_fecha_ini")&="")					frn.set("edt_fecha_ini",sys.date(sys.date("year"),sys.date("month"),1));				if(frn.get("edt_fecha_fin")&="")					frn.set("edt_fecha_fin",sys.date(sys.date("year"),sys.date("month"),31));			}												fun Execute() {				if (ValidarInfo() == 0){					return;				};				GenerarReporte();								//var val=frn.get("input");				//frn.message("Valor proporcionado:" & val,"Notificación","Aceptar");			}						fun GenerarReporte(){				var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var cuboSaldos,cuboMovtos, cuboIdxMovtos;				var sqlXmlSaldos,sqlXmlMovtos,cmd,ok,mensaje;				var clave_prod, desc_prod, cantidad_ini, monto_ini, cantidad_fin, monto_fin;				var totMovtos, totSaldos, contMovtos, contSaldos, lastProd, curProd, posIni, posFin;				var totProdEnt, totProdSal, totProdMonto, totRepMonto, cantidadFinProd, montoFinProd;				var movtoEnt, movtoSal, movtoMonto;				var excluir_cero;								kdb.kde("KDE");//Configuración del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();				excluir_cero= frn.get("ch_excluir");								//Obtener saldos totales //				setXml(sqlXmlSaldos,"document","sucursal_id",frn.get("cmb_sucursal",-1,1));				setXml(sqlXmlSaldos,"document","producto_ini",frn.get("edt_prod_ini",-1,0));				setXml(sqlXmlSaldos,"document","producto_fin",frn.get("edt_prod_fin",-1,0));				setXml(sqlXmlSaldos,"document","fecha_ini",frn.get("edt_fecha_ini"));				setXml(sqlXmlSaldos,"document","fecha_fin",frn.get("edt_fecha_fin"));				setXml(sqlXmlSaldos,"document","excluir_ceros",frn.get("ch_excluir"));				setXml(sqlXmlSaldos,"document","movimiento","usuario",frn.lib("libKepler","UserInfo"));				frn.lib("libGeneral.kpl","FileSave",sqlXmlSaldos,"D:\Basura\sqlXmlSaldos");								cmd="select * from keplersc.invr_res_saldos_prod_sel('" & getXmlStr(sqlXmlSaldos,"EOF:13_10") & "')";				cuboSaldos = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepmovprod.GenerarReporte()");				//frn.lib("libGeneral.kpl","FileSave",cuboSaldos ,"D:\Basura\cuboSaldos");								ok=getXmlAtt(cuboSaldos,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboSaldos,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				totSaldos = nXml(cuboSaldos);								//Obtener detalle de movimientos				cmd="select * from keplersc.invr_det_movtos_prod_sel('" & getXmlStr(sqlXmlSaldos,"EOF:13_10") & "')";				cuboMovtos = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepmovprod.GenerarReporte()");								ok=getXmlAtt(cuboMovtos,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboMovtos,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				totMovtos = nXml(cuboMovtos);								//Generar cubo de indices de movimientos				if (totMovtos > 0){					lastProd = getXmlAtt(cuboMovtos,"r0","clave_producto");					posIni = 0;					for (contMovtos=0; contMovtos<totMovtos; contMovtos++){						curProd = getXmlAtt(cuboMovtos,"r"&contMovtos,"clave_producto");						if((curProd &! lastProd) || contMovtos==totMovtos-1){							if(contMovtos==totMovtos-1){								posFin = contMovtos;							}else{								posFin = contMovtos-1;							}														setXmlAtt(cuboIdxMovtos,"IdxMovtos",lastProd,"clave_producto",lastProd);							setXmlAtt(cuboIdxMovtos,"IdxMovtos",lastProd,"posIni",posIni);							setXmlAtt(cuboIdxMovtos,"IdxMovtos",lastProd,"posFin",posFin);							posIni = contMovtos;							lastProd=curProd;						}					}								}												//frn.lib("libGeneral.kpl","FileSave",cuboSaldos,"D:\Basura\cuboSaldos");				frn.lib("libGeneral.kpl","FileSave",cuboMovtos,"D:\Basura\cuboMovtos");				frn.lib("libGeneral.kpl","FileSave",cuboIdxMovtos,"D:\Basura\cuboIdxMovtos");								kdb.readPage("datos","invrepmovprodfto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parámetros finales de impresión.(rep.page(...);)				rep.set("k_empresa",compania);				rep.set("k_sucursal",frn.get("cmb_sucursal",-1,0)); 				rep.set("k_fecha_ini",frn.get("edt_fecha_ini"));				rep.set("k_fecha_fin",frn.get("edt_fecha_fin"));				rep.set("k_fecha_imp",fechaImpresion);				rep.set("K_hora_imp",horaImpresion);				rep.exe("encabezado");								//Iniciar totales				totRepMonto = 0;				for (contSaldos=0; contSaldos<totSaldos; contSaldos++){					//Iniciar totales producto					totProdEnt=0; totProdSal=0; totProdMonto=0; cantidadFinProd=0; montoFinProd=0;									clave_prod = getXmlAtt(cuboSaldos,"r"&contSaldos,"clave_prod");					desc_prod = getXmlAtt(cuboSaldos,"r"&contSaldos,"desc_prod");					cantidad_ini = getXmlAtt(cuboSaldos,"r"&contSaldos,"cantidad_ini");					monto_ini = getXmlAtt(cuboSaldos,"r"&contSaldos,"monto_ini");					cantidad_fin = getXmlAtt(cuboSaldos,"r"&contSaldos,"cantidad_fin");					monto_fin = getXmlAtt(cuboSaldos,"r"&contSaldos,"monto_fini");					rep.set("k_clave_producto",clave_prod);					rep.set("k_producto_descripcion",desc_prod);					rep.set("k_inventario_inicial",strFormat("nfmt",cantidad_ini,2));					rep.set("k_monto_inicial",strFormat("nfmt",monto_ini,2));					rep.exe("seccion_inicial");					//Obtener posiciones ini y fin indice					posIni = getXmlAtt(cuboIdxMovtos,"IdxMovtos",clave_prod,"posIni");					posFin = getXmlAtt(cuboIdxMovtos,"IdxMovtos",clave_prod,"posFin");					for(contMovtos=posIni; contMovtos<=posFin; contMovtos++){						movtoEnt = getXmlAtt(cuboMovtos,"r"&contMovtos,"entradas");						movtoSal= getXmlAtt(cuboMovtos,"r"&contMovtos,"salidas");						movtoMonto = getXmlAtt(cuboMovtos,"r"&contMovtos,"monto");						if(movtoEnt!=0 || movtoSal!=0 || movtoMonto!=0){													rep.set("k_fecha",getXmlAtt(cuboMovtos,"r"&contMovtos,"fecha") );							rep.set("k_documento",getXmlAtt(cuboMovtos,"r"&contMovtos,"documento") );							rep.set("k_descripcion",getXmlAtt(cuboMovtos,"r"&contMovtos,"descripcion") );							rep.set("k_entradas",strFormat("nfmt",movtoEnt,2));							rep.set("k_salidas",strFormat("nfmt",movtoSal,2));							rep.set("k_unidad",getXmlAtt(cuboMovtos,"r"&contMovtos,"unidad") );							rep.set("k_tipo",getXmlAtt(cuboMovtos,"r"&contMovtos,"tipo") );							rep.set("k_monto",strFormat("nfmt",movtoMonto,2));							rep.exe("seccion_detalle");							totProdEnt = totProdEnt + movtoEnt; 							totProdSal = totProdSal + movtoSal;							if(movtoEnt > 0){								totProdMonto = totProdMonto + movtoMonto;							}else{								totProdMonto = totProdMonto - movtoMonto;							}												}					}					rep.set("k_total_prod_entradas",strFormat("nfmt",totProdEnt,2));					rep.set("k_total_prod_salidas",strFormat("nfmt",totProdSal,2));					rep.set("k_total_prod_monto",strFormat("nfmt",totProdMonto,2) );					rep.exe("seccion_total_prod");					cantidadFinProd = cantidad_ini + totProdEnt - totProdSal;					montoFinProd = monto_ini + totProdMonto;					rep.set("k_inventario_final",strFormat("nfmt",cantidadFinProd,2) );					rep.set("k_monto_final",strFormat("nfmt",montoFinProd,2));					rep.exe("seccion_final_prod");										totRepMonto = totRepMonto + montoFinProd;									}				rep.set("k_monto_reporte",strFormat("nfmt",totRepMonto,2));				rep.exe("seccion_total_reporte");				rep.win();			}						fun ValidarInfo(){				var fecha_ini, fecha_fin;				//Validacion de fechas				ValFecha();				fecha_ini = frn.get("edt_fecha_ini");				fecha_fin = frn.get("edt_fecha_fin");								if (fnDate("dif",fecha_fin,fecha_ini ) < 0) {					frn.message("La fecha de inicio no puede ser mayor a la final.","Error","Aceptar");					return 0;				}				return 1;			}											}	</script></pag>