		fun busca_inv(){
			
			//Commented by JMM 20240311
			/*		
			var cargo = trim(frn.get("k_mov",-1,"k_cargo"));
			var abono = trim(frn.get("k_mov",-1,"k_abono"));
			if ( strlen(cargo) == 0 || strlen(abono) > 0 ) { return; } 
			*/
			
			// Added by JMM 20240325
			var cargo = trim(frn.get("k_mov",-1,"k_cargo"));
			var abono = trim(frn.get("k_mov",-1,"k_abono"));
			if ( strlen(cargo) == 0 && strlen(abono) == 0 ) { return; } 
			
			// Added by JMM 20240325
			var ctanum = trim(frn.get("k_mov",-1,"k_cuenta"));
			var ctadscr = trim(frn.get("k_mov",-1,"k_cuentadesc"));
			if ( strlen(ctanum) == 0 || strlen(ctadscr) == 0 ) { return; }
			
			var cmdSel = "select c2 as inventario, c3 as clave_vehiculo, c5 as serie, c17 as marca, c4 as descripcion from keplersc.kdinf where c1='" & frn.get("k_sucn",-1,1) & "'";
         frn.dialog("genlistafiltrosel","Inventarios",cmdSel ,"inventario","k_mov","", "k_inventario","N");
     
		}
		
		fun Inventario() {
		
				//Commented by JMM 20240311 
				/*
				//Added by JMM 20240308
				var cargo = trim(frn.get("k_mov",-1,"k_cargo"));
				var abono = trim(frn.get("k_mov",-1,"k_abono"));
				if ( strlen(cargo) == 0 || strlen(abono) > 0 ) { 
					frn.setX("","k_mov", -1, "k_afecta");
					frn.setX("","k_mov", -1, "k_inventario");
					return; 
				} 
				*/
				
				
				// Added by JMM 20240325
				var ctanum = trim(frn.get("k_mov",-1,"k_cuenta"));
				var ctadscr = trim(frn.get("k_mov",-1,"k_cuentadesc"));
				if ( strlen(ctanum) == 0 || strlen(ctadscr) == 0 ) { 
					frn.message("Debes Registrar primero una Cuenta Valida ...","Error","Aceptar");
					frn.setX("", "k_mov", -1, "k_inventario");
					frn.setX("","k_mov", -1, "k_afecta"); 
					return; 
				}
				
				// Added by JMM 20240325
				var cargo = trim(frn.get("k_mov",-1,"k_cargo"));
				var abono = trim(frn.get("k_mov",-1,"k_abono"));
				if ( strlen(cargo) == 0 && strlen(abono) == 0 ) { 
					frn.message("Debes Registrar primero el monto del Cargo o Abono ...","Error","Aceptar");
					frn.setX("", "k_mov", -1, "k_inventario");
					frn.setX("","k_mov", -1, "k_afecta");
					return; 
				} 
				
				
				//Added by JMM 20240308
				if ( strlen(trim(frn.get("k_mov", -1, "k_inventario"))) == 0 ) {
					frn.setX("", "k_mov", -1, "k_inventario");
					frn.setX("","k_mov", -1, "k_afecta"); 
					return;
				}

				var cmd, ok, mensajeError ;
				cmd = "select c2 from keplersc.kdinf where c1='" & frn.get("k_sucn",-1,1) & "' and c2='" & frn.get("k_mov", -1, "k_inventario") & "'";
				
				var cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Inventario()");
				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");
				
				ok=getXmlAtt(cuboResultados,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboResultados,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					frn.setX("", "k_mov", -1, "k_inventario"); //Added by JMM 20240308
					frn.setX("","k_mov", -1, "k_afecta"); //Added by JMM 20240308 
					return;
				}
				
				if (nXml(cuboResultados ) < 1){
					frn.message("Inventario no existe","Error","Aceptar");
					frn.setX("", "k_mov", -1, "k_inventario");
					frn.setX("","k_mov", -1, "k_afecta"); //Added by JMM 20240308
					return;
				}
				
		} // End : Fun Inventario 
		
		
		//New Added by JMM 20240308
		fun Afecta() {
			var valor_afecta = trim ( frn.get("k_mov", -1, "k_afecta") );
			if ( strlen( trim ( frn.get("k_mov", -1, "k_inventario") ) ) == 0 ) { frn.setX("","k_mov", -1, "k_afecta"); }
			if ( valor_afecta &! "U" && valor_afecta &! "A" ) { frn.setX("","k_mov", -1, "k_afecta"); }
			return;
		}
		
		
