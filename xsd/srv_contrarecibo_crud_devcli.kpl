			frn.set("k_clave_pago",getXmlAtt(xml_kdm1,"k_clave_pago") );
			*/
			
			/*
			//Added by JMM 20240307
			var vProvPago = trim(frn.get("k_clave_pago"));
			if ( strlen(trim(frn.get("k_clave"))) > 0 ) {
				if ( strlen( vProvPago ) > 0 ) { BuscarProvPago(); }
			}
			*/
				
			fecha_baja = getXmlAtt(xml_kdm1  ,"fecha_baja");
			
			estatus_doc = getXmlAtt(xml_kdm1  ,"estatus_doc");	
			
			if (estatus_doc &= "C"){	// C=Cancelado
				frn.message("La Devolucion se encuentra cancelada ...","Error","Aceptar");
				frn.set("statusdoc", "CANCELADO");
			}else{
				frn.set("statusdoc", "");
			}

			CalcTotal();
						
		} // End : MostrarDatosDEV()
		
		
		//-----------------REPORTE-----------
		
		
			fun EjecReporte(){
				
				var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;
				var cuboResultados, xmlRequest,sqlXmlResultados,xmlCurDocto,xmlCurMovto,cmd,ok,mensaje;
				
				kdb.kde("KDE");//Configuraciï¿½n del servidor
				kdb.exec();
				compania = kdb.get("KDE","1");
				usuario = kdb.get("KDE","14");
				strValor = sys.date();	
				fechaImpresion = sys.date();
				horaImpresion = sys.time();

				
				kdb.readPage("datos","srv_contrarecibo_crudfto");//se define el formato a usar
				kdb.exec();
				rep.source(kdb.get("datos"));
				rep.rst(); 
				setRepPage();//Establece los parï¿½metros finales de impresiï¿½n.(rep.page(...);)

				rep.set("suc_desc", frn.get("k_sucn", -1, 0));
				rep.set("docto",frn.get("k_docto"));
				rep.set("fecha",frn.get("k_fecha"));
				rep.set("rep_fecha",fechaImpresion);
				rep.set("rep_hora",horaImpresion);
				rep.set("k_clave",frn.get("k_clave"));
				rep.set("k_nombreprov",frn.get("k_nombreprov"));
				rep.set("k_calleprov",frn.get("k_calleprov"));
				rep.set("k_coloniaprov",frn.get("k_coloniaprov"));
				rep.set("k_poblacionprov",frn.get("k_poblacionprov"));
				rep.set("k_cpprov",frn.get("k_cpprov"));
				rep.set("k_rfc",frn.get("k_rfc"));
				rep.set("referencia",frn.get("k_refer"));
				rep.set("k_monto",frn.get("k_monto"));
				
				//TODO
				rep.set("cantidad_en_letra",strFormat("number",frn.get("k_monto"),0));
				rep.exe("encabezado");
				rep.exe("tit_reporte");
				rep.exe("encabezadoColumnas");
				rep.exe("linea_encabezados");

				//Procesa poliza contable
				var tablakdc1_alta = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;
				var tablakdc2_alta = " keplersc.kdc2" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) & strSplit(frn.get("k_fecha"), "-", 1);
				var tablakdc1_baja = " keplersc.kdc1" & mid(strSplit(fecha_baja, "-", 0), 2,2) ;
				var tablakdc2_baja = " keplersc.kdc2" & mid(strSplit(fecha_baja, "-", 0), 2,2) & strSplit(fecha_baja, "-", 1);
				var tipo = ""; var nPolAlta = "" ;
				if (tablakdc2_baja &= tablakdc2_alta ){
					tipo = "Misma_tabla";
					
					cmd= " select c1 as num_pol from " & tablakdc2_alta & " where c14='" & sucursal_id  & "' and c15='" & gen_doc & "' and c16= '" & nat_doc & "'" ;
					cmd = cmd & " and c17='" & gpo_doc & "' and c18='" & tip_doc & "' and c19='" & frn.get("k_folio")& "'";
				
					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.GenerarReporte()");
					frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");
				
					ok=getXmlAtt(cuboResultados,"ok");
					if(ok &! "" && !ok){
						mensajeError = getXmlAtt(cuboResultados,"native3");
						frn.message(mensajeError,"Error","Aceptar");
						return;
					}
				
					nPolAlta =getXmlAtt(cuboResultados,"r0", "num_pol" );
				
				}
				imprime_poliza(tablakdc1_alta , tablakdc2_alta, "Alta", tipo, nPolAlta);
				
				if (estatus_doc &= "C" && fecha_baja &! "1800-01-01" && fecha_baja &! "" ){
					imprime_poliza(tablakdc1_baja , tablakdc2_baja, "Baja", tipo, nPolAlta);
				}	
			
				rep.set("desc_notas",frn.get("k_coment"));
				rep.exe("notastitulos");
				rep.exe("extras");
				rep.win();
				
		
			}
			
			
			fun imprime_poliza(tablakdc1 , tablakdc2, operacion, tipo, nPolAlta ){
			
				var cmd, cuboResultados , ok;
				
				//Procesa poliza contable
				cmd= " select kc2.c1 as num_pol, kc2.c3 as cuenta, kc2.c4 as tipo_asiento, kc2.c5 as monto, kc1.c2 as desc_pol, kc2.c7 as refer, kc2.c8 as tipo_pol from " & tablakdc2 & " as kc2 " ;
				cmd = cmd & " inner join " & tablakdc1 & " as kc1 on kc1.c1=kc2.c3 ";
				cmd = cmd & " where kc2.c14='" & frn.get("k_sucn", -1, 1) & "' and kc2.c15='" & gen_doc & "' and kc2.c16= '" & nat_doc & "' and kc2.c17='" & gpo_doc & "' and kc2.c18='" & tip_doc & "' and kc2.c19='" & frn.get("k_folio")& "'";
				if (operacion &= "Alta" && tipo &= "Misma_tabla"){
					cmd = cmd & " and kc2.c1 = " & nPolAlta ; 
				}
				if (operacion &= "Baja" && tipo &= "Misma_tabla"){
					cmd = cmd & " and kc2.c1 <> " & nPolAlta ; 
				}
 
 
				//Added by JMM 20240325
				cmd = cmd & " order by kc2.c1, kc2.c10 ";
 
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.imprime_poliza()");
				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");
				
				ok=getXmlAtt(cuboResultados,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboResultados,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				var nRenPol= nXml(cuboResultados);
				var tPoliza=getXmlAtt(cuboResultados,"r0", "tipo_pol" );
				var nPoliza=getXmlAtt(cuboResultados,"r0", "num_pol" );
				
				if (strlen(tPoliza)>0 && strlen(nPoliza)>0 ){
						rep.set("tPol",tPoliza);
						rep.set("nPol",nPoliza);
						rep.exe("encabezadoPol");
						var tAbonosPol=0, tCargosPol=0;
						for(var i=0;i<nRenPol;i++){
							if (getXmlAtt(cuboResultados,"r"&i, "tipo_asiento" )&= "A"){
								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );
								rep.set("PolClave2",cuenta );
								rep.set("PolDescr2",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));
								rep.set("PolHaber",getXmlAtt(cuboResultados,"r"&i, "monto" ));
								tAbonosPol=tAbonosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );
								pol_saldo_presupuesto(cuenta);
								rep.set("PolSaldo2",saldo);
								rep.set("PolPresupuesto2",presupuesto );
								rep.exe("partPolA");
							}else{
								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );
								rep.set("PolClave",cuenta );
								rep.set("PolDescr",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));
								rep.set("PolDebe",getXmlAtt(cuboResultados,"r"&i, "monto" ));
								tCargosPol=tCargosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );
								pol_saldo_presupuesto(cuenta);
								rep.set("PolSaldo",saldo );
								rep.set("PolPresupuesto",presupuesto );
								rep.exe("partPolC");
							}
						}
						rep.set("totCargo",tCargosPol);
						rep.set("totAbono",tAbonosPol);
						rep.exe("PolTotales");
				}

			}
			
			fun pol_saldo_presupuesto(cuenta){
		
				var cmd, cuboResultados , ok, mensajeError  ;
				
				var mes = strSplit(frn.get("k_fecha"), "-", 1);
				tabla = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2);
				
				var col_cargos = 26 + mes;
				var col_abonos = 62 + mes;
				var col_presupuesto= 38 + mes;
				 
				cmd= " select c" & col_cargos & " as cargos ,c" & col_abonos & " as abonos ,c" & col_presupuesto & " as pres from " & tabla & " where c1='" & cuenta & "'";

				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.pol_saldo_presupuesto()");
				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");
				
				ok=getXmlAtt(cuboResultados,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboResultados,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}

				var cargos = getXmlAtt(cuboResultados,"r0", "cargos" );
				var abonos = getXmlAtt(cuboResultados,"r0", "abonos" );
				presupuesto = getXmlAtt(cuboResultados,"r0", "pres" );
				saldo = cargos - abonos;

			}
			
			
			// Function Added by JMM, 20240215
			fun CambiaFolio() {
				frn.set("k_docto", "");
				frn.set("k_fecha", "");
				frn.set("k_hora", "");
				// Commented by JMM 20240131
				/*
				LimpiaDatosProv();
				frn.set("k_clave", "");
				*/
				// Added by JMM 20240131
				limpiar_datos_uuid();
				//frn.set("k_refer", ""); // Added & Commented 20240131 by JMM
				
				//Addeb by JMM 20240424
				LimpiaEncabezado(1);
			}
			
			fun Formar_folio(){
				var xmlReqEst, cubofol, cmd, ok, mensajeError ;
				
				CambiaFolio(); // Added by JMM, 20240215
				
				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));
				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));
				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));
				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));
				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));
				setXml(xmlReqEst,"document","uen",uen);
				
				cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";
				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");
				var resultado =getXmlAtt(cubofol,"r0", "resultado");
				if(resultado &= "0"){
					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				var fol = getXmlAtt(cubofol,"r0", "mensaje");
				frn.set("k_folio", fol);
			}
			
			
