		// Added by JMM, 20240226
		fun Change_Mode() {
			var paramCta, dscrCta; // Added by JMM 20240325
			var paramProv, rfcProv; // Added by JMM 20240422
			var paramDocDev; // Added by JMM 20240422
			var paramST; // Added by JMM 20240423
			
			paramST = 0;
			
			limpiar_datos_uuid();
			
			if ( frn.get("chk_dev") == 1 ) { //frn.message("Check Encendido ...","Info !!!","Aceptar");
				
				//Commented by JMM 20240422
				/*
				frn.setAtt("Buscar", "available", "N");
				frn.setAtt("Buscar", "visible", "N");
				frn.setAtt("k_refer", "available", "Y");
				frn.setAtt("k_clave", "available", "Y");
				*/
				
				// Added by JMM 20240325
				frn.setAtt("k_mov", "modify", "N", "k_cuenta");
				frn.setAtt("k_mov", "available", "N", "k_cuenta");
				frn.setAtt("k_mov", "modify", "N", "k_abono");
				frn.setAtt("k_mov", "available", "N", "k_abono");
				
				// Added by JMM 20240325 
				frn.rst("k_mov");
				paramCta = get_param_cta_x_comprobar();	
				frn.setX(paramCta ,"k_mov",0/*-1*/,"k_cuenta");
				if ( strlen(paramCta) > 0 ) {
					dscrCta = get_dscr_cta();
					frn.setX(dscrCta ,"k_mov",0/*-1*/,"k_cuentadesc");
				} else {
					/*frn.message("La Cuenta Contable para esta Operacion No esta Registrado en el Parametro [Cuenta Gastos Devolucion Clientes] ...","Error","Aceptar");*/
					paramST = paramST + 1;
				}
				
				// Added by JMM 20240422 
				paramProv = get_param_proveedor();	
				frn.set("k_clave", paramProv);
				if ( strlen(paramProv) > 0 ) {
					BuscarProveedor_NoXML();
				} else {
					/*frn.message("El Proveedor para esta Operacion No esta Registrado en el Parametro [Devolucion Clientes Proveedor] ...","Error","Aceptar");*/
					paramST = paramST + 1;
				}				
				
				// Added by JMM 20240422 
				paramDocDev = get_param_docdev();	
				if ( strlen(paramDocDev) > 0 ) {
					var g_gen = "", g_nat = "", g_gpo = "", g_tip = "";
					//Parsear Parametro Obtenido 
					/*frn.set("c_folio", paramDocDev);*/ // Provisional ...
					g_gen = strSplit(paramDocDev,"|",0);  // param.Genero
					g_nat = strSplit(paramDocDev,"|",1);  // param.Naturaleza
					g_gpo = strSplit(paramDocDev,"|",2);  // param.Grupo
					g_tip = strSplit(paramDocDev,"|",3);  // param.Tipo
					frn.set("c_gen", g_gen);
					frn.set("c_nat", g_nat);
					frn.set("c_gpo", g_gpo);
					frn.set("c_tip", g_tip);
					if ( strlen(g_gen) == 0 || strlen(g_nat) == 0 || strlen(g_gpo) == 0 || strlen(g_tip) == 0 ) {
						frn.message("Los Atributos del Documento Referenciado para esta Operacion No estan Registrados Correctamente en el Parametro [Devolucion Clientes Documento] ...","Error","Aceptar");
					}
				} else {
					/*frn.message("Los Atributos del Documento Referenciado para esta Operacion No estan Registrado en el Parametro [Devolucion Clientes Documento] ...","Error","Aceptar");*/
					paramST = paramST + 1;
				}
				
				// Si todos los PARAMs estan OK se habilita el campo de Folio para la seleccion del Documento Referenciado
				frn.setAtt("c_folio", "available", "N"); // Default
				if ( paramST == 0 ) {
					frn.setAtt("c_folio", "available", "Y");
				}
				
			}
			//Commented by JMM 20240422
			/* else { //frn.message("Check Apagado ...","Info !!!","Aceptar");
				
				frn.setAtt("Buscar", "available", "Y");
				frn.setAtt("Buscar", "visible", "Y");
				frn.setAtt("k_refer", "available", "N");
				frn.setAtt("k_clave", "available", "N");
				
				// Added by JMM 20240325
				frn.setAtt("k_mov", "modify", "Y", "k_cuenta");
				frn.setAtt("k_mov", "available", "Y", "k_cuenta");
				frn.setAtt("k_mov", "modify", "Y", "k_abono");
				frn.setAtt("k_mov", "available", "Y", "k_abono");
				
			}*/
			return;	
		}
		
		
		// New Func 20240423 by JMM
		fun ObtenerFolioDEV() {
			var p_gen = "", p_nat = "", p_gpo = "", p_tip = "";
			
			p_gen = frn.get("c_gen");  // param.Genero
			p_nat = frn.get("c_nat");  // param.Naturaleza
			p_gpo = frn.get("c_gpo");  // param.Grupo
			p_tip = frn.get("c_tip");  // param.Tipo

			sucursal_id = frn.get("k_sucn",-1,1);

			cmdQuery = "select w.c6 as folio, substring(cast(w.c9 as VARCHAR),1,10) as fecha, w.c10 as cve_cliente " &
						", u.c3 as nombre " & 
						", w.c11 as factura, w.c16 as monto, w.c43 estatus " &
						"from keplersc.kdm1 w " &
						"inner join keplersc.kdud u on w.c1 = u.c1 and w.c10 = u.c2 " & 
						"where w.c1='" & sucursal_id & "' and w.c2='" & p_gen & "' and w.c3='" & p_nat & "' and w.c4=" & p_gpo & " and w.c5=" & p_tip;
						
			if ( tip_ope &= "A" ) {
				cmdQuery = cmdQuery & " and st_x_comprobar = 'O'"; 
			} else {
				cmdQuery = cmdQuery & " and st_x_comprobar = 'P'";  
			}
						
			cmdQuery = cmdQuery & " order by w.c9 desc, w.c6 desc"; 
						
			frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryfoliodev");
				
			frn.dialog("genlistafiltrosel","Folios de Transfers",cmdQuery,"folio","c_folio","0","","S");
			
		} // End : fun ObtenerFolioDEV
		
		
		// New Func 20240423 by JMM
		fun Formar_FolioDEV(){
			
				var xmlReqEst, cubofol, cmd, ok, mensajeError ;
				setXml(xmlReqEst,"document","folio_id",frn.get("c_folio"));
				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("c_gen"));
				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("c_nat"));
				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("c_gpo"));
				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("c_tip"));
				setXml(xmlReqEst,"document","uen",uen);
				
				cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";
				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_FolioDEV()");
				var resultado =getXmlAtt(cubofol,"r0", "resultado");
				if(resultado &= "0"){
					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				var fol = getXmlAtt(cubofol,"r0", "mensaje");
				frn.set("c_folio", fol);
				
				borrar_datos(1);
				/*LimpiaEncabezado(1);*/ // Commented by JMM 20240423
				LimpiaDatosProv(); // Added by JMM 20240423
				
		} // End : Formar_FolioDEV()
		
		
		fun BuscarFolioDEV() {
			var folio;
			
			if (strlen( trim( frn.get("c_folio") ) ) == 0) {
				frn.message("Selecciona o Registra el Folio de la Devolucion ...","Error","Aceptar");
				return;
			}
			
			folio = frn.get("c_folio");
			folio = PadLeft(folio, 7, "0");
			/*ArmarRefDocto();*/ // Commented by JMM 20240423
			borrar_datos(1);
			LimpiaDatosProv(); // Added by JMM 20240423
			MostrarDatosDEV(folio);		
		}
		
		
		// New Func 20240227 by JMM
		fun ProvPago_Sec(referencia){
			var respfunc;				
				
			sucursal_id = frn.get("k_sucn",-1,1);
			respfunc = 0; //Default es sin Permiso 
			
			frn.setAtt("k_clave_pago", "available", "N");
											
			if (strlen(referencia) == 0) {
				return;
			}
			
			//Added by JMM 20240422 ... Esta funcion No aplica para esta opcion 
			return;
			
			cmdQuery = "select * from keplersc.param_opc_usr_sec where sucursal = '" & sucursal_id & "' " & 
				"and upper(opcion) = upper('Proveedor Pago') and upper(usuario) = upper('" & referencia & "')";
			
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ProvPagoSec()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;	
			}
			/*
			if ( nXml(cuboQuery) == 0 ) {
				respfunc = 0;
			}
			*/
			respfunc = nXml(cuboQuery);
			
			if ( respfunc /*paramProvPago &= "P"*/ > 0 ) {	
				if ( tip_ope &= "A" ) {	
					frn.setAtt("k_clave_pago", "available", "Y");
				} else {
					frn.setAtt("k_clave_pago", "available", "N");
				}			
			} else {
				frn.setAtt("k_clave_pago", "available", "N");
			}
			
			return respfunc;
							
		} // End Fun - ProvPago_Sec 
		
		
		//Function Added by JMM, 202040227  
		fun CheckProvPago(){
			var respfunc;				
				
			sucursal_id = frn.get("k_sucn",-1,1);
			proveedor_pago_id = frn.get("k_clave_pago");
			proveedor_pago_id = trim(proveedor_pago_id);
			
			respfunc = 0; 
		
			if (strlen(/*frn.get("k_clave_pago")*/ proveedor_pago_id ) == 0) {
				frn.set("k_nombreprov_pago","");
				return;
			}
				
			cmdQuery = "select c3 as k_nombreprov_pagos " &				
					"from keplersc.kdxd where c2 = '" & proveedor_pago_id & "' ";
					
			cmdQuery = cmdQuery & "and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')";
					
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscarProvPago()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				frn.set("k_nombreprov_pago","ERROR EN BUSQUEDA ...");
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;	
			}
			if(nXml(cuboQuery) == 0){
				frn.set("k_nombreprov_pago","NO EXISTE ...");
				// Commented by JMM 20240227
				//frn.setPos("k_clave_pago");
				//frn.message("El Proveedor de Pago No existe ...","Error","Aceptar");
				return;	
			} 
			
			respfunc = 1;
			
			// Commented by JMM 20240227
			//frn.set("k_nombreprov_pago", getXmlAtt(cuboQuery,"r0", "k_nombreprov_pagos") );
			
			return respfunc;
			
		} // End : Fun BuscarProvPago()
		
		
