			frn.set("k_iva",getXmlAtt(xml_kdm1,"k_iva") );
			frn.set("k_subtotal",getXmlAtt(xml_kdm1,"k_subtotal") );
			frn.set("k_monto",getXmlAtt(xml_kdm1,"k_monto") );
			*/
			
			frn.setX( getXmlAtt(xml_kdm1,"k_monto") , "k_mov" , 0 , "k_cargo" );
				
