		fun CambiaSucursal(imodo) {
			sucursal_id = frn.get("k_sucn",-1,1);
			
			// Added by JMM 20240227 ... Check Security PARAM for User to use PROV PAGO
			paramProvPago = ProvPago_Sec(usuario);
			
			LimpiaEncabezado();
			frn.set("k_fecha",sys.date());
			frn.set("k_hora",sys.time());	
			ArmarRefDocto();	
			
			limpiar_datos_uuid(); // Added by JMM 20240208
			
			// Added by JMM 20240422
			if ( imodo != 1 ) { 
				ConfiguraControlesOpcion(); 
			}
		}
		
		fun LimpiaEncabezado(imodo) {
			if ( imodo != 1 ) {
				frn.set("k_folio", "");
			}
			frn.set("k_docto", "");
			frn.set("k_fecha", "");
			frn.set("k_hora", "");
			LimpiaDatosProv();
			frn.set("k_clave", "");
			
			//Added by JMM, 20240215
			frn.set("k_clave_pago", "");
			frn.set("k_nombreprov_pago", "");
			
			frn.set("c_nombreprov", ""); //Added by JMM 20240423
			
			borrar_datos(); //Added by JMM 20240424 
		}
		
		fun borrar_datos(imodo){
			if ( frn.get("chk_dev") != 1 ) { //Condition Added by JMM 20240325
				frn.rst("k_mov");
			}
			
			if ( imodo != 1 ) { //Condition Added by JMM 20240423
				frn.set("c_folio", "");
			}
			
			if(tip_ope &= "C"){ //Condition Added by JMM 20240423
				frn.rst("k_mov");
				frn.set("c_folio", "");
				frn.set("k_plazo", "");
				frn.set("k_vence", "");
				//Added by JMM 20240424
				frn.set("c_gen", "");
				frn.set("c_nat", "");
				frn.set("c_gpo", "");
				frn.set("c_tip", "");
				frn.set("c_ref", "");
			}
			
			frn.set("c_ref", "");
			frn.setX("" , "k_mov" , 0 , "k_cargo");
			frn.set("k_refer", "");
			
			frn.set("totalCargos", 0);
			frn.set("totalAbonos", 0);
			//frn.set("k_vence", sys.date()); //Commented by JMM, 20240208
			
			//Commented by JMM 20240423
			/*
			frn.set("k_plazo", 0);
			frn.set("k_vence", ""); //Added by JMM, 20240208
			*/
			
			frn.rst("k_coment");
			
			frn.set("k_subtotal", 0);
			frn.set("k_iva", 0);
			
			// Commented by JMM 20240228
			/*
			frn.set("k_subtotal_con_iva", 0);
			frn.set("k_retencion_isr", 0);
			frn.set("k_retencion_iva", 0);
			frn.set("k_otras_retenciones", 0);
			*/
			
			frn.set("k_monto", 0);
		}
		
		fun BuscarFolio() {
			var folio;
			folio = frn.get("k_folio");
			folio = PadLeft(folio, 7, "0");
			ArmarRefDocto();
			borrar_datos();
			MostrarDatos(folio);		
		}

		fun Cancela() {
			CambiaSucursal(1);
			borrar_datos();
			Inicializa();
			ConfiguraControlesOpcion();
		}

		fun ObtenerFolio() {

			sucursal_id = frn.get("k_sucn",-1,1);

			LimpiaEncabezado(); //Added by JMM 20240215

			//UPD by JMM 20240307
			cmdQuery = "select c6 as folio, substring(cast(c9 as VARCHAR),1,10) as fecha, c10 as cve_proveedor, " &
						"c11 as factura, c16 as monto, c43 estatus " &
						"from keplersc.kdm1 " &
						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc & "";
			
			// Added by JMM, 20240423 
			cmdQuery = cmdQuery & " and st_x_comprobar = 'D' ";
			
			cmdQuery = cmdQuery & " order by c9 desc, c6 desc ";
	
						
			frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryfoliomov");
				
			frn.dialog("genlistafiltrosel","Folios de Contrarecibos",cmdQuery,"folio","k_folio","0","","S");
			
		}
		

		fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 
			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    
			1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 
			2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 
			3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 
			*/
			var prefix=frn.lib("libKepler","langPrefix");
			var page=prefix&pag;
			var b_valido=1;
			// var tip_ope; 
			var tip_oper;
			if(iModo==0)
				page=pag; 
			else if(iModo==2&&(strlen(par0)>0)){
				//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       
				if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;
				if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 
				if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;
			}
			else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;
				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     
		}	
		
