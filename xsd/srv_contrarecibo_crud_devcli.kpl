						} else {
							// Added 20240130 (else section)
							frn.set("k_clave","");
							frn.message(mensaje,"Error","Aceptar");
							return;
						}
					
					} // End ... If ( continua )
				
				} // End ... If ( imodo )
				*/
			}
			
