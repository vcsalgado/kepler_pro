		//Function Added by JMM, 202040215 
		fun BuscarProvPago(){
			var xmlProd;				
				
			sucursal_id = frn.get("k_sucn",-1,1);
			proveedor_pago_id = frn.get("k_clave_pago");
			proveedor_pago_id = trim(proveedor_pago_id);
		
			if (strlen(/*frn.get("k_clave_pago")*/ proveedor_pago_id ) == 0) {
				frn.set("k_nombreprov_pago","");
				return;
			}
				
			cmdQuery = "select c3 as k_nombreprov_pagos " &				
					"from keplersc.kdxd where c2 = '" & proveedor_pago_id & "' ";
					
			cmdQuery = cmdQuery & "and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')";
					
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscarProvPago()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				frn.set("k_nombreprov_pago","ERROR EN BUSQUEDA ...");
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;	
			}
			if(nXml(cuboQuery) == 0){
				frn.set("k_nombreprov_pago","NO EXISTE ...");
				frn.setPos("k_clave_pago");
				frn.message("El Proveedor de Pago No existe ...","Error","Aceptar");
				return;	
			} 
			
			frn.set("k_nombreprov_pago", getXmlAtt(cuboQuery,"r0", "k_nombreprov_pagos") );
			
		} // End : Fun BuscarProvPago()
		
		
		// Added by JMM, 20240226
		fun Plazo(){ //Calcula la fecha de pago, y las condiciones de pago en base al plazo
			frn.set("k_vence",fnDate("addC",frn.get("k_fecha"),frn.get("k_plazo")));//Suma días comerciales
			var cond=frn.get("k_plazo") & " dias fecha factura"/*" días fecha factura"*/;
			if (frn.get("k_plazo")==0) cond="Pago de contado";
				frn.set("k_cond",cond);  
		}
		
		
		// Added by JMM, 20240325
		fun get_param_cta_x_comprobar() {
			var paramCta;
		
			sucursal_id = frn.get("k_sucn",-1,1);
		
			paramCta = "";
		
			// { Param Cta Gastos x Comprobar }
			cmdQuery="SELECT (coalesce(valor,'')) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'Cuenta Gastos Devolucion Clientes'";
			rstXml(cuboQuery);				
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcontrarecibocrud.get_param_cta_x_comprobar()");
					
			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GetParamCtaXComprobar");
					
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return paramCta;
			}
			if (nXml(cuboQuery) > 0) {
				paramCta = getXmlAtt(cuboQuery,"r0","paramvalor");
				paramCta = trim(paramCta);
				if ( strlen(paramCta) == 0 ) {
					frn.message("La Cuenta Contable para esta Operacion No esta Registrado en el Parametro [Cuenta Gastos Devolucion Clientes] ...","Error","Aceptar");
				}
			} else {
				frn.message("Hubo problemas para obtener el Parametro [Cuenta Gastos Devolucion Clientes] ...","Error","Aceptar");
			}
			return paramCta;
			
		}
	
	
		// Added by JMM 20240325
		fun get_dscr_cta() {
			
			var dscrCta = "";
				
         var cuenta = frn.get("k_mov", 0/*-1*/, "k_cuenta");
 
         var xmlRequest, cmd, cubo , ok, mensajeError ;
         
         setXml(xmlRequest,"document","cuenta",cuenta);
         setXml(xmlRequest,"document","anio",mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2));
            
         frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\requestCuenta");

			cmd="select * from keplersc.caracteristicas_cuenta('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";
			cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.buscar_datos()");
				
			frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultadosCuenta");
				
			ok=getXmlAtt(cubo,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cubo,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				clear_row(1); //Added by JMM 20240325
				return dscrCta;
			}
				
			var nivel_cuenta = getXmlAtt(cubo,"r0","nivel");
			var descripcion_nivel = getXmlAtt(cubo,"r0","desc_nivel");
			var tipo_cuenta = getXmlAtt(cubo,"r0","tipo");
				
			if (descripcion_nivel &! "Menor"){
				frn.message(/*"La Cuenta debe ser menor"*/"No es una Cuenta de Detalle","Error","Aceptar"); // UPD 20240229 by JMM
				//frn.setX("", "k_mov", 0/*-1*/, "k_cuenta");
				/*frn.setX("", "k_mov", 0, "k_cuentadesc");*/
				clear_row(1); //Added by JMM 20240325
				return dscrCta;
         }
           
			if (tipo_cuenta &= "Cliente"){
				frn.message("La Cuenta no puede ser de cliente.","Error","Aceptar");
				//frn.setX("", "k_mov", 0/*-1*/, "k_cuenta");
				/*frn.setX("", "k_mov", 0, "k_cuentadesc");*/
				clear_row(1); //Added by JMM 20240325
				return dscrCta;
         }
            
    
			var tbla = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2);
			cmd = "select c2 as desc_cuenta from " & tbla & " where c1='" & cuenta  &  "'";
				
			var cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Cuenta()");
			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");
				
			ok=getXmlAtt(cuboResultados,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboResultados,"native3");
				frn.message(mensajeError,"Error","Aceptar");
				clear_row(1); //Added by JMM 20240325
				return dscrCta;
			}

			/*var descr */ dscrCta = getXmlAtt(cuboResultados , "r0","desc_cuenta");
      
         //frn.setX(cuenta, "k_mov", 0/*-1*/, "k_cuenta");
         //frn.setX(/*descr*/ dscrCta , "k_mov", 0/*-1*/, "k_cuentadesc");
         
         return dscrCta;
         
		} // End : Fun 
	
	
