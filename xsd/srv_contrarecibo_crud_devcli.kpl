		fun CalcTotal() { 
				var C=0,A=0; 
				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) { 
					C=C+frn.get("k_mov",i,"k_cargo");
					A=A+frn.get("k_mov",i,"k_abono");
				}
			
				var subt = C - A;
				
				// Commented by JMM 20240228
				/*
				var subt_con_iva = 0;
				var iva = subt * prc_iva/100;
				if (iva &! "N" ){ 
					subt_con_iva = subt  + iva;
				}else{ 
					subt_con_iva = subt ;
					iva = 0;
				}
				var retencion_isr = subt * prc_retencion_isr/100;
				var retencion_iva = subt * prc_retencion_iva/100;
				var otras_retenciones = subt * prc_otras_retenciones/100;
				var importe = subt_con_iva;
				*/
				
				// Added by JMM 20240228
				var iva;
				if ( frn.get("chk_dev") == 1 ) {
					iva = 0;
				} else {
					iva = frn.get("k_uuid_impuesto");
				}
				
				// Commented by JMM 20240228
				/*
				if (retencion_isr &! "N" ){ 
					importe = importe  - retencion_isr ;
				}else{ 
					retencion_isr = 0;
				}
				
				if (retencion_iva &! "N" ){ 
					importe = importe  - retencion_iva ;
				}else{ 
					retencion_iva = 0;
				}

				if (otras_retenciones &! "" ){ 
					importe = importe  - otras_retenciones;
				}else{ 
					otras_retenciones= 0;
				}
				
				frn.set("k_subtotal", subt, "k_iva" ,iva, "k_subtotal_con_iva", subt_con_iva  );
				frn.set("k_retencion_isr", retencion_isr  , "k_retencion_iva" ,retencion_iva , "k_otras_retenciones", otras_retenciones );
				*/
				
				// Added by JMM 20240228
				frn.set("k_subtotal", subt, "k_iva", iva);
				var importe = subt + iva;
								
				frn.set("k_monto", importe);
	
		}
		
