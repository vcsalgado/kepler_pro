	<script>
		InstallDriver("KDB75");
		
		class Main {
			var frn,kdb, sys, rep, frP;
			var usuario, rol_usuario, suc_usuario, anio_contable;
			// Variables de control
			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal, tabla, estatus_doc ;
			var fileSavePath;
			//Variables validacion factura
			var	str_uuid, fecha_uuid, rfc_uuid, total_uuid;					
			//Variables de parametros
         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd;
			var editable; //Se controla si la poliza se puede editar, cancelar o dar de baja	
			//Porcentajes kdmm
			var prc_retencion_isr,prc_iva ,prc_retencion_iva, prc_otras_retenciones, afecta_costo_inv  ;
			//cont
			var presupuesto , saldo, fecha_baja ;
			var uen,asterisco;
			
			//Added by JMM, 20240208
			var nombre_uuid, regimen_uuid, folio_uuid, serie_uuid, NewProvId;
			//Added by JMM, 20240215
			var paramProvPago, proveedor_pago_id;
			//Added by JMM, 20240224
			var impuesto_uuid;
			
		fun Main() {
			frn=new FRNT;
			kdb=new KDB;
			rep=new REP;
			frP=new FRNTP;
			sys=new SYS;
			kdb.connect();
			kdb.kde("KDE");
			kdb.exec();
			anio_contable = kdb.get("KDE","14");
			usuario = frn.config("user","name");
			rol_usuario = frn.config("user","role");
			suc_usuario = frn.lib("libKepler","UserInfo(1)");
			asterisco = "*";
			fileSavePath = "C:\Basura";
			Inicializa();
			ConfiguraControlesOpcion();				
		
		}
			
		fun Inicializa(){ //Inicializa los valores en Pantalla
		
			paramProvPago = 0; // Added by JMM 20240227
			
			// Revisa parametros recibidos
			if( frn.nParam() == 7 ){  // Adapted by JMM, 20240215; Backed out by JMM 20240227
			/*if( frn.nParam() >= 7 && frn.nParam() <= 8){*/  // Updated by JMM 20240215; Commented by JMM 20240227
                gen_doc=trim(frn.param(0)); 
                nat_doc=trim(frn.param(1)); 
                gpo_doc=trim(frn.param(2));
                tip_doc=trim(frn.param(3)); 
                tip_ope=trim(frn.param(4));
                paramProd=trim(frn.param(5));
                //Commented & adapted by JMM, 20240227 
                /*
                // Added by JMM 20240215 
                if ( frn.nParam() == 8 ) {
						paramProvPago=trim(frn.param(7));
					 } else {
						paramProvPago="";
					 }
					 */
			} else {
				frn.message("Operación no válida ...", "Mensaje","&Aceptar");
				frn.open("redirect",2);
				return;
			}
            
			if(tip_ope &= "A"){ //Alta
				frn.set("operacion","ALTA");
			} else {
				if(tip_ope &= "B"){ //Baja
					frn.set("operacion","BAJA");
					//Added by JMM 20240422 ... Se debe Ajustar a Nuevo Esquema
					frn.message("Operacion No Disponible, Requiere Actualizacion al Nvo Esquema de Gastos ...", "Mensaje","&Aceptar");
					/*frn.open("index",4);*/
					frn.open("redirect",2);
					return;	
				} else {
					if(tip_ope &= "C"){ //Consulta
						frn.set("operacion","CONSULTA");
					} else {
						frn.message("Operación no válida ...", "Mensaje","&Aceptar");
						frn.open("index",4);
						return;			
					}
				}
			}
			
			uen=trim(frn.param(6));
			if (uen &= ""){
				uen="XXX";
			}
				
			// Fill Combo Sucursal (Con Query de PostgreSQL)
			cmdQuery = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdms";
			
			//Added by JMM 20241031 
			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){
				cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";
			}else {
				if (suc_usuario &! asterisco && suc_usuario &! "" ){
					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";
				}
			}
			
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.IniCombos()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			frn.set("k_sucn",cuboQuery);	
			sucursal_id = frn.get("k_sucn",-1,1);
			
			// Added by JMM 20240227 ... Check Security PARAM for User to use PROV PAGO
			paramProvPago = ProvPago_Sec(usuario);
			
				
			// Fill Combo Tipo (Con Query FTO Kepler) 
			//Commented by JMM 20240423
			/*
			if(tip_ope &= "A"){ */
				cmdQuery = "select /*c5*/'Contrarecibo Universal' as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and  c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;
				cmdQuery = cmdQuery & " and c4='" & tip_doc & "'"; //Condition used by JMM 20240312 as temporary until define DOCs or DOC Type 
			/*} else {
				cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;
			}*/
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.Inicializa()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error BD","Aceptar");
				return;
			}
			frn.set("k_tipon",getXml(cuboQuery));
			
			frn.set("k_fecha",sys.date());
			frn.set("k_hora",sys.time());	
			//frn.set("k_vence",sys.date()); // Commented by JMM, 20240208 
				
			// Fill k_docto | referencia docto
			ArmarRefDocto();
		
			configuraciones_kdmm();
		}
			
		
		// Armado del Docto Referencia
		fun ArmarRefDocto {
			var cadena = frn.get("k_tipon", -1, 5);
			var fol = frn.get("k_folio");
			if (tip_ope &! "A" && fol &! ""){
				cadena = strSplit(cadena,"-",0) & "-" & fol;
			}		
			frn.set("k_docto", cadena);
		}
			
		fun PadLeft(pText,pRelleno,pCaracterRelleno) {
			var Resultado;
			var pos_ini = pText;
			var nReg = strlen(pText);
			for (var cont = nReg; cont < pRelleno; cont++) {
				Resultado = pCaracterRelleno & Resultado;
			}
			Resultado = Resultado & pText;                
			return Resultado;
		}
		
		fun CambiaTipo() {
		
			tip_doc  = frn.get("k_tipon", -1, 4);
			configuraciones_kdmm();
			borrar_datos();
			LimpiaEncabezado();
		
			
			//TODO, borrar todos los datos
			frn.set("k_fecha",sys.date());
			frn.set("k_hora",sys.time());	
			ArmarRefDocto();	
			
			limpiar_datos_uuid(); // Added by JMM 20240215
			
			ConfiguraControlesOpcion(); // Added by JMM 20240422			
		}
		
