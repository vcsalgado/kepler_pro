			p_tip = frn.get("c_tip");  // param.Tipo
			
			sucursal_id = frn.get("k_sucn",-1,1);
		
			cmd = " select dm1.c10 as k_clave, dm1.c9 as k_fecha, dm1.c11 as k_refer, dm1.c18 as k_vence, dm1.c17 as k_plazo " &
				", dm1.c24 as k_coment, dm1.c43 as estatus_doc , dm1.c197 as fecha_baja " ;
			
