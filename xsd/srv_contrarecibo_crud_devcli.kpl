		//---------------------------------------EJECUTA---------------------------------
	
		fun Ejecuta() {
			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;
			var resultado, mensaje, folio;
				
			fecha = sys.date();
			hora= sys.time();
			
			
			// For Testing ... 20240215 ; UPD by JMM 20240227
			if ( paramProvPago /*&= "P"*/ > 0 ) { 
				/*
				frn.message("Opcion No Disponible ... Estatus en Fase de Desarrollo.","Info !!!","Aceptar");
				return;
				*/
			}
				
				
			if (tip_ope &= "A") {			
				//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok
				resVal = 1;
				ValidarDatos();
				if(ok &! "1" || resVal == 0){
					return;
				}
				continua = frn.message("¿Desea continuar con la alta?","Atención",2);
				if (continua == 0){
					return;
				}	
				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
				//Agregar usuario, fechay hora de movimiento
				strFecha = fnDate("year",fecha) & "-";
				strTmp = fnDate("month",fecha);
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp & "-";
				strTmp = fnDate("day",fecha);
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp;
							
				setXml(xmlPantalla,"movimiento","usuario",usuario);
				setXml(xmlPantalla,"movimiento","fecha",strFecha);
				setXml(xmlPantalla,"movimiento","hora",
				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 
				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));
				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov") -1);
				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);
				setXml(xmlPantalla,"ambiente","uen",uen);
				
				//ajusta etiquetas con el standar de mov_prim_alta, las columnas en kdm1 tienen valores diferentes dependiendo el movimiento
				// Commented by JMM 20240228
				/*
				setXml(xmlPantalla,"k_miepsret",frn.get("k_retencion_isr"));
				setXml(xmlPantalla,"k_mivaret",frn.get("k_retencion_iva"));
				setXml(xmlPantalla,"k_montoanticipo",frn.get("k_otras_retenciones"));
				*/
				// Added by JMM 20240228
				setXml(xmlPantalla,"k_subtotal_con_iva",frn.get("k_monto"));
				
				//Commented by JMM 20240422 
				/*
				//Added 20240214
				setXml(xmlPantalla,"uuid","serie",serie_uuid);
				setXml(xmlPantalla,"uuid","folio",folio_uuid);
				setXml(xmlPantalla,"uuid","total",total_uuid);
				setXml(xmlPantalla,"uuid","fechatimbrado",fecha_uuid);
				//Added 20240226
				setXml(xmlPantalla,"uuid","impuesto",impuesto_uuid);
				*/
				
				// Added by JMM 20240308
				setXml(xmlPantalla,"ambiente","schema","CXP_CONTR_REC_DEVCLI");
				
				
				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudcontrareciboDevCli");
				
				
				// For Testing ... 20240422 
				/*
				frn.message("La Informacion se Procesara ...","Info !!!","Aceptar");
				return;
				*/
				

				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";
				//kdb.rst(cuboQuery);
				rstXml(cuboQuery);
					
				cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_contrarecibo_crud.Ejecuta");				
				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudContrareciboDevCli");
					
				resultado = getXml(cuboQuery,"resultado");
				mensaje = getXml(cuboQuery,"mensaje");
					
				ok = getXmlAtt(cuboQuery,"ok");
				if(ok &! "" && !ok) {
					mensajeError = getXmlAtt(cuboQuery,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;	
				}

				if(resultado &= "1") {
				
					LimpiaEncabezado(); //Added by JMM 20240423
					borrar_datos(); //Added by JMM 20240423
					
					tip_ope = "C";
					frn.set("k_folio", mensaje); 
					frn.set("operacion", "CONSULTA");
					//Commented by JMM 20240423
					/*
					strTmp = frn.get("k_docto");
					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;
					frn.set("k_docto", strTmp);
					*/
					strMsg = "El Folio utilizado para esta operación fue : " & mensaje;
					ConfiguraControlesOpcion(); 
					frn.message(strMsg, "Mensaje", "Aceptar");
					folio = frn.get("k_folio");
					MostrarDatos(folio);	
					//BuscarFolio();
					
				} else {
					frn.message(mensaje, "Error", "Aceptar");
				}

			} else {
				if (tip_ope &= "B") {
				
					//Added by JMM 20240813 
					frn.message("Opcion No Disponible en esta pantalla {KPL} ...", "Info", "Aceptar");
					return ;
				
					if (estatus_doc &= "C"){
						frn.message("No puedes dar de baja un folio cancelado.", "Error", "Aceptar");
						return ;
					}
					continua = frn.message("¿Desea continuar con la baja?","Atención",2);
					if (continua == 0){
						return;
					}
					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
					//Agregar usuario, fechay hora de movimiento
					strFecha = fnDate("year",fecha) & "-";
					strTmp = fnDate("month",fecha);
					if(strlen(strTmp) == 1){
						strTmp = "0" & strTmp;
					}
					strFecha = strFecha & strTmp & "-";
					strTmp = fnDate("day",fecha);
					if(strlen(strTmp) == 1){
						strTmp = "0" & strTmp;
					}
					strFecha = strFecha & strTmp;
								
					setXml(xmlPantalla,"movimiento","usuario",usuario);
					setXml(xmlPantalla,"movimiento","fecha",strFecha);
					setXml(xmlPantalla,"movimiento","hora",
					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 
					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));
					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);
					setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov"));
					setXml(xmlPantalla,"operacion","baja");
					setXml(xmlPantalla,"ambiente","uen",uen);
					
						
					frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudcontrarecibo");

					cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";
					//kdb.rst(cuboQuery);
					rstXml(cuboQuery);
						
					cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_contrarecibo_crud.Ejecuta");				
					frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudContrarecibo");
						
					resultado = getXml(cuboQuery,"resultado");
					mensaje = getXml(cuboQuery,"mensaje");
						
					ok = getXmlAtt(cuboQuery,"ok");
					if(ok &! "" && !ok) {
						mensajeError = getXmlAtt(cuboQuery,"native3");
						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
						frn.message(mensajeError,"Error","Aceptar");
						return;	
					}

					if(resultado &= "1") {
						tip_ope = "C";
						frn.set("operacion", "CONSULTA");
						ConfiguraControlesOpcion();
						BuscarFolio();
					} else {
						frn.message(mensaje, "Error", "Aceptar");
					}

				} else {
					folio = frn.get("k_folio");
					MostrarDatos(folio);
				}	/*End Consulta*/ 
			}
				
		}
		
		//Validacion Datos Generales y Partidas antes de Guardar.
		//El resultado de cada validacion se guarda en la variable global resVal.
		fun ValidarDatos() {
			var totReg, strTotal=0,subTotal=0, iva=0, total=0, renglones, str;
			var gapMonto, gapDias,vdiferencia; // New 20240121 ... To Get of PARAMs
			var g_gen = "", g_nat = "", g_gpo = "", g_tip = "", foliodev = "", refdev = ""; // New 20240121 ... To Get of PARAMs 
			
			//Obtener variables
			sucursal_id = frn.get("k_sucn",-1,1);
			proveedor_id = frn.get("k_clave");
			refer_id = frn.get("k_refer");
			
			// Added by JMM 20240229
			proveedor_pago_id = trim(frn.get("k_clave_pago"));
			
			// Added by JMM 20240424
			g_gen = frn.get("c_gen"); // param.Genero
			g_nat = frn.get("c_nat"); // param.Naturaleza
			g_gpo = frn.get("c_gpo");  // param.Grupo
			g_tip = frn.get("c_tip");  // param.Tipo
			foliodev = trim(frn.get("c_folio"));
			refdev = frn.get("c_ref");
			
			// Added by JMM 20240229, Esta condicion es para discriminar validaciones relacionadas con UUID si Chk por Comprobar esta Activado
			if ( frn.get("chk_dev") != 1 ) {
			
			
				//Code Added by JMM 20240208 ... Related to Implementing UUID Transaction 
			
				//Obtener PARAMs (GAPs) ... 20240112 ... NEW
				cmdQuery="SELECT count(*) as totreg from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro in ('GAP Dias Fecha Gastos','GAP Monto Gastos')";
				rstXml(cuboQuery);				
				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");
				ok=getXmlAtt(cuboQuery,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboQuery,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					resVal=0;
					return;
				}
				totReg=getXmlAtt(cuboQuery,"r0","totreg");
				if(totReg==0){
					frn.message("Los Parametros [GAPs] Necesarios para la Operacion No Existen ...","Error","Aceptar");
					resVal=0;
					return;
				} else {
					if(totReg<2){
						frn.message("Los Parametros [GAPs] Necesarios para la Operacion No estan Completos ...","Error","Aceptar");
						resVal=0;
						return;
					} else {
					
						// Obtener PARAMs 
						// { GAP Dias Fecha Gastos }
						cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Dias Fecha Gastos'";
						rstXml(cuboQuery);				
						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");
					
						frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPDias");
					
						ok=getXmlAtt(cuboQuery,"ok");
						if(ok &! "" && !ok){
							mensajeError = getXmlAtt(cuboQuery,"native3");
							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
							frn.message(mensajeError,"Error","Aceptar");
							resVal=0;
							return;
						}
						if (nXml(cuboQuery) > 0) {
							gapDias = getXmlAtt(cuboQuery,"r0","paramvalor");
						} else {
							frn.message("Hubo problemas para obtener los Parametros [GAP Dias Fecha Gastos] ...","Error","Aceptar");
							resVal=0;
							return;
						}
					
						// { GAP Monto Gastos }
						cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Monto Gastos'";
						rstXml(cuboQuery);				
						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");
					
						frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPMonto");
					
						ok=getXmlAtt(cuboQuery,"ok");
						if(ok &! "" && !ok){
							mensajeError = getXmlAtt(cuboQuery,"native3");
							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
							frn.message(mensajeError,"Error","Aceptar");
							resVal=0;
							return;
						}
						if (nXml(cuboQuery) > 0) {
							gapMonto = getXmlAtt(cuboQuery,"r0","paramvalor");
						} else {
							frn.message("Hubo problemas para obtener los Parametros [GAP Monto Gastos] ...","Error","Aceptar");
							resVal=0;
							return;
						}
					
					}
				}


				//Validar Referencia ... Moved here 20240112 
				if (refer_id &= ""){
					frn.setPos("k_refer");
					resVal=0;
					frn.message("Es necesario seleccionar la Factura del Proveedor ...","Error","Aceptar");
					return;
				}
			
			
				//Updated by JMM 20240208 
				if ( strlen(/*folio_uuid*/nombre_uuid) == 0 || strlen(rfc_uuid) == 0 || strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {
					frn.message("No se cuenta con todos los datos mandatorios del UUID.","Error","Aceptar");
					resVal=0;
					return;
				}

				
				//Validar Fecha Referencia ... 20240112 ... NEW
				if ( Validar_Fecha_UUID() == 0 ) {	
					resVal = 0;
					return;
				}
						
			} // End : if ( frn.get("chk_dev") == 1 ) {
			else	{
			
				// Else condition Addeb 20240229
				// Validar Referencia ... Moved here 20240112 
				if (refer_id &= ""){
					frn.setPos("c_folio"/*"k_refer"*/);
					resVal=0;
					frn.message("Debe Seleccionar el Documento Referencia ..." & "|" & " " & "|" & 
						"Asociado a la Devolucion que desea Programar para Pago.","Error","Aceptar");
					return;
				}
				
				if ( strlen(g_gen) == 0 || strlen(g_nat) == 0 || strlen(g_gpo) == 0 || strlen(g_tip) == 0 ) {
					resVal=0;
					frn.message("Los Atributos del Documento Referenciado para esta Operacion No pueden ser vacios, esto puede ocurrir si no estan Registrados correctamente en el Parametro [Devolucion Clientes Documento] ...","Error","Aceptar");
					return;
				}
				
				if ( strlen(foliodev) == 0 ){
					frn.setPos("c_folio");
					resVal=0;
					frn.message("Es necesario seleccionar la Devolucion del Cliente ...","Error","Aceptar");
					return;
				}
				
				if ( strlen(refdev) == 0 ){
					resVal=0;
					frn.message("La Referencia Complementaria de la Devolucion del Cliente No puede ser vacia ...","Error","Aceptar");
					return;
				}
					
			}	// End : If ... Chk-Object 
					
							
			//Validar Proveedor
			// Added 20240112
			if ( strlen(frn.get("k_clave")) == 0 || frn.get("k_clave") &= strFormat("ucase","No Existe ...") ) {
				resVal=0;
				if ( strlen(frn.get("k_clave")) == 0 ) {
					frn.message("No hay Proveedor Asociado a la Operacion ...","Error","Aceptar");
				} else {
					frn.message("El Proveedor No Existe o No tiene los Atributos correctos para esta Operacion ...","Error","Aceptar");
				}
				return;
			}
			
			//End Code Added by JMM 20240208 ... Related to Implementing UUId Transaction 
			
			
			//Validar Proveedor
			//UPD by JMM 20240424 
			cmdQuery="SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_id & "' and pagdev = 1 ";
			rstXml(cuboQuery);				
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			totReg=getXmlAtt(cuboQuery,"r0","totreg");
			if(totReg==0){
				frn.message("El Proveedor No Existe o No tiene los Atributos correctos para esta Operacion ...","Error","Aceptar");
				resVal=0;
				return;
			}


			//Validar Proveedor Pago
			// Added 20240229
			if ( strlen(frn.get("k_clave_pago")) == 0 || frn.get("k_nombreprov_pago") &= strFormat("ucase","No Existe ...") ) {
				if ( strlen(frn.get("k_clave_pago")) == 0 ) {
					frn.message("No hay Proveedor de Pago Asociado a la Operacion ...","Error","Aceptar");
				} else {
					frn.message("El Proveedor de Pago No Existe ...","Error","Aceptar");
				}
				resVal=0;
				return;
			}


			//Validar Proveedor Pago
			// Added 20240229
			cmdQuery = "SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_pago_id & "'";
			cmdQuery = cmdQuery & " and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')"; 
			rstXml(cuboQuery);				
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			totReg=getXmlAtt(cuboQuery,"r0","totreg");
			if(totReg==0){
				frn.message("El Proveedor de Pago No Existe.","Error","Aceptar");
				resVal=0;
				return;
			}


			//Validar Referencia ... Moved Up 20240209
			/*
			if (refer_id &= ""){
				frn.setPos("k_refer");
				resVal=0;
				frn.message("Es necesario seleccionar la factura del proveedor","Error","Aceptar");
				return;
			}
			*/
			

			/*
			//Validar kduxg
			var char_amp = "%";
			// Replaced by JMM 20240424 
			//cmdQuery = "SELECT count(*) as totreg from keplersc.kduxg where c1='" & sucursal_id  & "' and c2 ='" & gen_doc & "' and c3='" & proveedor_id & "' and ( c4='" & refer_id & "'";
			cmdQuery = "SELECT count(*) as totreg from keplersc.kduxg where c1='" & sucursal_id  & "' and c2 ='" & gen_doc & "' and c3='" & proveedor_id & "' ";
			cmdQuery = cmdQuery & " and doc_refer_compl like '" & char_amp & foliodev & char_amp & "' "; // Addded by JMM 20240424 
			//frn.lib("libGeneral.kpl","FileSave",cmdQuery, fileSavePath & "\cmdQuery_ValidarKduxg");
			rstXml(cuboQuery);				
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			totReg=getXmlAtt(cuboQuery,"r0","totreg");
			if(totReg > 0){
				frn.message("La Referencia de la Devolucion ya se encuentra Registrada en cuentas por pagar para el mismo Proveedor","Error","Aceptar");
				resVal=0;
				return;
			}
			
			//Validar kdm1 
			// Replaced by JMM 20240424 
			cmdQuery = "SELECT count(*) as totreg from keplersc.kdm1 where c1='" & sucursal_id  & "' and gen_aux = '" & g_gen & "' and nat_aux = '" & g_nat & "' ";
			cmdQuery = cmdQuery & " and gpo_aux = " & g_gpo & " and tip_aux = " & g_tip & " and folio_aux = '" & foliodev & "'"; // Addded by JMM 20240424 
			//frn.lib("libGeneral.kpl","FileSave",cmdQuery, fileSavePath & "\cmdQuery_ValidarKduxg");
			rstXml(cuboQuery);				
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			totReg=getXmlAtt(cuboQuery,"r0","totreg");
			if(totReg > 0){
				frn.message("La Devolucion ya fue Procesada como Contrarecibo (Cuenta x Pagar) ...","Error","Aceptar");
				resVal=0;
				return;
			}
			*/
			
			
			//Validar rfc y monto total de factura correspondan a datos de UUID
			/*strTotal = frn.get("k_monto");
			if (strTotal &! total_uuid) {
				frn.message("El importe total del Contrarecibo no corresponde al de la factura.","Error","Aceptar");
				resVal=0;return;
			}
			if (frn.get("k_rfc") &! rfc_uuid) {
				frn.message("El RFC del Contrarecibo no corresponnde al de la factura.","Error","Aceptar");
				resVal=0;return;
			}*/
		
			//Validaciones POLIZA
			if(frn.N("k_mov")-1==0){
				frn.message("No es posible dar de alta una Poliza sin datos. Favor de verificar", "Error","&Aceptar");
				resVal=0;return;
			}
			
			//commented by JMM 20240307
			/*
			if(RevCol("k_cuenta") == 1){
						frn.message("Se ha generado el siguiente error: " & "No se especificó cuenta en la póliza" ,"Error","&Aceptar");
						frn.setPos("k_mov",-1,"k_descr");resVal=0; return;
			}
			if(RevCol("k_cuentadesc") == 1){
						frn.message("Se ha generado el siguiente error: " & "No se especificó descripción en la póliza" ,"Error","&Aceptar");
						frn.setPos("k_mov",-1,"k_descr");resVal=0;return;
			}
			*/			
			
			//Added by JMM 20240307 
			var nreg = frn.N("k_mov")-1;//cuantos renglones hay
			for(var i=0; i<nreg; i++){
		
				var abono,cargo;
				
				var ren_cta = trim(frn.get("k_mov",i,"k_cuenta"));
				var ren_ctadscr = trim(frn.get("k_mov",i,"k_cuentadesc"));
				
				var ren_inv = trim(frn.get("k_mov",i,"k_inventario"));
				var ren_afecta = trim(frn.get("k_mov",i,"k_afecta"));
				
				var ren_num = i + 1 ;
				
				cargo = frn.get("k_mov",i,"k_cargo");
				abono = frn.get("k_mov",i,"k_abono");
				
				if (strlen(ren_cta) == 0){
					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se ha especificado la Cuenta" ,"Error","&Aceptar");
					frn.setPos("k_mov",i/*-1*/,"k_cuenta");
					resVal=0;return;
				}
				
				if (strlen(ren_ctadscr) == 0){
					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se ha especificado la Descripcion de la Cuenta" ,"Error","&Aceptar");
					frn.setPos("k_mov",i/*-1*/,"k_cuenta");
					resVal=0;return;
				}
				
				if ( strlen(cargo) > 0 && strlen(abono) > 0 ) {
					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : La partida no puede ser de cargo y abono al mismo tiempo" ,"Error","&Aceptar");
					frn.setPos("k_mov",i/*-1*/,"k_cargo");
					resVal=0;return;
				} 
				
				if ( strlen(cargo) == 0 && strlen(abono) == 0 ) {
					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se ha registrado el cargo o abono de la partida" ,"Error","&Aceptar");
					frn.setPos("k_mov",i/*-1*/,"k_cargo");
					resVal=0;return;
				} 
				
				if ( strlen(ren_inv) > 0 && strlen(ren_afecta) == 0 ) {
					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se ha registrado la afectacion del inventario de la partida" ,"Error","&Aceptar");
					frn.setPos("k_mov",i/*-1*/,"k_afecta");
					resVal=0;return;
				} 
				
				if ( strlen(ren_afecta) > 0 && strlen(ren_inv) == 0 ) {
					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se puede tener una afectacion sin numero de inventario en la partida" ,"Error","&Aceptar");
					frn.setPos("k_mov",i/*-1*/,"k_inventario");
					resVal=0;return;
				} 
					
			} // End : For k_mov
			
			// Added by JMM 20240306
			subTotal=frn.get("k_subtotal");
			if (subTotal <= 0){
				resVal=0;
				frn.message("El subtotal de la operación no puede ser menor o igual a cero.","Error","Aceptar");
				return;
			}
			
			// Conditions Added by JMM 20240208 ... Related to Implementing UUID Transaction
			
			strTotal/*total*/=frn.get("k_monto");
			if (strTotal/*total*/ <= 0){
				resVal=0;
				frn.message("El total de la operación no puede ser menor o igual a cero.","Error","Aceptar");
				return;
			}
		
		
			// Added by JMM 20240229, Esta condicion es para discriminar validaciones relacionadas con UUID si Chk por Comprobar esta Activado
			if ( frn.get("chk_dev") != 1 ) {
		
				//Validar rfc y monto total de factura correspondan a datos de UUID
				strTotal = frn.get("k_monto");
				vdiferencia = (strTotal-total_uuid);
				if (vdiferencia < 0){
					vdiferencia = vdiferencia *(-1); 
				}
			
				// Adapted 20240112 ... Se Gestionara por PARAM {TBL : param_oper}
				if ( vdiferencia > gapMonto /*0.1*/ ) {
					resVal=0;
					frn.message("El importe total del contrarecibo no corresponde al de la factura.","Error","Aceptar");
					return;
				}
				
				// End Conditions Added by JMM 20240208 ... Related to Implementing UUID Transaction	
				
			}
		
			
					
							
		} // End ValidarDatos()
		
		
		fun RevCol(param1){
				var nreg,abono,cargo,valCol,banCol;//definicion de variables
				nreg = frn.N("k_mov")-1;//cuantos renglones hay
				banCol = 0;
				for(var i=0; i<nreg; i++){
					abono = frn.get("k_mov",i,"k_cargo");
					cargo = frn.get("k_mov",i,"k_abono");
					if((cargo+abono) > 0){
						valCol = frn.get("k_mov",i,param1);//valor de la columna (proyecto, concepto, departamento)
						if(strlen(valCol) == 0){
							banCol = 1;//se prende la bandera de que falta definir  proyecto, concepto o departamento en una partida 
						}//fin if valor de la columna esta vacia
					}//fin if la suma de cargo y abono es > a 0
				}//fin for p/recorrer las partidas en el grid
				return banCol;
			}
			
	//-----------------------BAJA,CONSULTA----------------------------	
	
		fun MostrarDatos(nFolio) {
		
			var cmd,xmlRequest,xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError;
			
			sucursal_id = frn.get("k_sucn",-1,1);
		
			// Addapted by JMM,	22401215
			cmd = " select dm1.c10 as k_clave, dm1.c9 as k_fecha, dm1.c11 as k_refer , dm1.c69 as k_hora , dm1.c18 as k_vence, dm1.c17 as k_plazo " &
				", dm1.c24 as k_coment, dm1.c43 as estatus_doc , dm1.c197 as fecha_baja " ;
			
			// Added by JMM, 20240215 , UPD by JMM 20240328 
			cmd = cmd & ", dm1.uuid_serie as k_uuid_serie, dm1.uuid_folio as k_uuid_folio, dm1.uuid_fecha as k_uuid_fecha, dm1.uuid_total as k_uuid_monto, dm1.uuid_impuesto as k_uuid_impuesto " &
				", xd.c10 as k_rfc, xd.c3 as k_nombreprov, xd.c4 as k_calleprov, xd.c5 as k_coloniaprov, xd.c6 as k_poblacionprov, xd.c27 as k_cpprov ";
			
			// Added by JMM, 20240306 
			cmd = cmd & ", dm1.c14 as k_iva, dm1.c16 as k_monto, (dm1.c16 - coalesce(dm1.c14, 0)) as k_subtotal ";
			
			// Added by JMM, 20240307 
			cmd = cmd & ", dm1.cve_prov_pago as k_clave_pago ";
			
			// Added by JMM, 20240423 
			cmd = cmd & ", dm1.gen_aux as c_gen, dm1.nat_aux as c_nat, dm1.gpo_aux as c_gpo, dm1.tip_aux as c_tip, dm1.folio_aux as c_folio, dm1.doc_refer_compl as c_ref ";
			cmd = cmd & ",  xp.c3 as c_nombreprov  ";
		
			// Addapted by JMM,	22401215	
			cmd = cmd & " from keplersc.kdm1 dm1 " & 
				"inner join keplersc.kdud xd on xd.c2 = dm1.doc_refer_compl " &
				"inner join keplersc.kdxd xp on xp.c2 = dm1.c10 " &
				"where dm1.c1='" & sucursal_id  & "' and dm1.c2='" & gen_doc  &"' and dm1.c3='" & nat_doc & "' and dm1.c4='" & gpo_doc & "' and dm1.c5='" & tip_doc & "' and dm1.c6='" & nFolio & "'";
	
			// Added by JMM, 20240423 
			cmd = cmd & " and dm1.st_x_comprobar = 'D' ";
	
			//frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cuboResultados_Enc_Query"); // Added by JMM, 20240215 
	
			cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.MostrarDatos()");
			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_Enc");
				
			ok=getXmlAtt(cuboResultados,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboResultados,"native3");
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}

			// Condition Added by JMM, 20240215
			if(nXml(cuboResultados) == 0){
				frn.setPos("k_folio");
				frn.message("El Documento No existe, o No corresponde a una Devolucion ...","Error","Aceptar");
				return;	
			}

			var xml_kdm1  = getXml(cuboResultados,"r0" );

			//frn.setX(cuboResultados ); TODO, checar setX
			frn.set("k_clave",getXmlAtt(xml_kdm1  ,"k_clave") );
			frn.set("k_fecha",getXmlAtt(xml_kdm1 ,"k_fecha") );
			frn.set("k_hora",getXmlAtt(xml_kdm1  ,"k_hora") );
			frn.set("k_plazo",getXmlAtt(xml_kdm1  ,"k_plazo") );
			frn.set("k_vence",getXmlAtt(xml_kdm1   ,"k_vence") );
			frn.set("k_coment",getXmlAtt(xml_kdm1   ,"k_coment") );
			//BuscarProveedor(); // Commented by JMM 20240215
			frn.set("k_refer",getXmlAtt(xml_kdm1  ,"k_refer") );	
			
			/*
			// ----	Section Added by JMM 20240215 
			frn.set("k_uuid_serie",getXmlAtt(xml_kdm1  ,"k_uuid_serie") );
			frn.set("k_uuid_folio",getXmlAtt(xml_kdm1  ,"k_uuid_folio") );
			frn.set("k_uuid_monto",getXmlAtt(xml_kdm1  ,"k_uuid_monto") );
			frn.set("k_uuid_fecha",getXmlAtt(xml_kdm1  ,"k_uuid_fecha") );
			frn.set("k_uuid_fecha",mid(frn.get("k_uuid_fecha"),0,10));
			// Added by JMM 20240328 
			frn.set("k_uuid_impuesto",getXmlAtt(xml_kdm1  ,"k_uuid_impuesto") );
			*/
			
			// ----	Section Added by JMM 20240423 
			frn.set("c_gen",getXmlAtt(xml_kdm1  ,"c_gen") );
			frn.set("c_nat",getXmlAtt(xml_kdm1  ,"c_nat") );
			frn.set("c_gpo",getXmlAtt(xml_kdm1  ,"c_gpo") );
			frn.set("c_tip",getXmlAtt(xml_kdm1  ,"c_tip") );
			frn.set("c_folio",getXmlAtt(xml_kdm1  ,"c_folio") );
			frn.set("c_ref",getXmlAtt(xml_kdm1  ,"c_ref") );
			frn.set("c_nombreprov",getXmlAtt(xml_kdm1  ,"c_nombreprov") );
					
			frn.set("k_rfc",getXmlAtt(xml_kdm1  ,"k_rfc") );
			frn.set("k_nombreprov",getXmlAtt(xml_kdm1  ,"k_nombreprov") );
			frn.set("k_calleprov",getXmlAtt(xml_kdm1  ,"k_calleprov") );
			frn.set("k_coloniaprov",getXmlAtt(xml_kdm1  ,"k_coloniaprov") );
			frn.set("k_poblacionprov",getXmlAtt(xml_kdm1  ,"k_poblacionprov") );
			frn.set("k_cpprov",getXmlAtt(xml_kdm1  ,"k_cpprov") );
			// ----	End : Section Added by JMM 20240215 
			
			//Added by JMM 20240306 
			frn.set("k_iva",getXmlAtt(xml_kdm1,"k_iva") );
			frn.set("k_monto",getXmlAtt(xml_kdm1,"k_monto") );
			frn.set("k_subtotal",getXmlAtt(xml_kdm1,"k_subtotal") );
			
			//Added by JMM 20240307 
			frn.set("k_clave_pago",getXmlAtt(xml_kdm1,"k_clave_pago") );
			
			//Added by JMM 20240307
			var vProvPago = trim(frn.get("k_clave_pago"));
			if ( strlen(trim(frn.get("k_clave"))) > 0 ) {
				if ( strlen( vProvPago ) > 0 ) { BuscarProvPago(); }
			}
				
			fecha_baja = getXmlAtt(xml_kdm1  ,"fecha_baja");
			
			estatus_doc = getXmlAtt(xml_kdm1  ,"estatus_doc");	
			
			if (estatus_doc &= "C"){	// C=Cancelado
				frn.message("El Contrarecibo se encuentra cancelado","Error","Aceptar");
				frn.set("statusdoc", "CANCELADO");
			}else{
				frn.set("statusdoc", "");
			}

			rstXml(cmd);
				
			//Adapted by JMM 20240308
			cmd = "select c8,c9,c10,c11,c13 ,c12 from keplersc.kdm6 where c1='" & sucursal_id & "' and c2='" & gen_doc &"' and c3='" & nat_doc & "'";
			cmd = cmd & " and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";
			
			cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.MostrarDatos()");
			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_Det");
				
			ok=getXmlAtt(cuboResultados,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboResultados,"native3");
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}

			totRen = nXml(cuboResultados);	
						
			for(contRen=0; contRen<totRen; contRen++){

				frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c8"),"k_mov",contRen,"k_cuenta");
				frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c9"),"k_mov",contRen,"k_cuentadesc");
				var cargo_abono = getXmlAtt(cuboResultados, "r"&contRen ,"c10");
				var monto = getXmlAtt(cuboResultados, "r"&contRen ,"c11");
				
				if (cargo_abono &= "C"){
					frn.setX(monto ,"k_mov",contRen,"k_cargo");
				}else{
					frn.setX(monto ,"k_mov",contRen,"k_abono");
				}
				
				frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c13"),"k_mov",contRen,"k_inventario");
				
				frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c12"),"k_mov",contRen,"k_afecta"); // Added by JMM 20240308 
			
			}
			
			//Commented by JMM 20240306 ... Info se obtendra de la BD Directamente
			//	CalcTotal();
			
			ArmarRefDocto();
								
		} //End MostrarDatos()

		
		fun MostrarDatosDEV(nFolio) {
		
