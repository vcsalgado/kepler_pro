		// New Func 20240115 by JMM
		fun BuscarUUID(referencia){
			var xmlProd, respfunc;				
				
			sucursal_id = frn.get("k_sucn",-1,1);
			respfunc = 1;
											
			if (strlen(str_uuid) == 0) {
				frn.message("No se tiene una Referencia [UUID] para validarse ...","Error","Aceptar");
				return;
			}
			
			/*
			cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &
				"and c2 = '" & gen_doc & "' and c3 = '" & nat_doc & "' and c4 = " & gpo_doc & " and c5 = " & tip_doc & " and c11 = '" & referencia & "'";
			*/
			
			// Query updated at { C x P } validation, 20240201 
			cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &
				"and c2 = 'X' and c3 = 'A' and c11 = '" & referencia & "'";	 
			
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscaFactura()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;	
			}
			/*
			if ( nXml(cuboQuery) == 0 ) {
				respfunc = 0;
			}
			*/
			respfunc = nXml(cuboQuery);
			
			return respfunc;
							
		} // End Fun - BuscarUUID
		

		// New Func 20240112 by JMM
		fun Validar_Fecha_UUID() {
			var fech_hoy, fech_ini, fech_limit, strFecha, strTmp, fech_lim_ini, fech_lim_fin, fech_buff;
			var aj_dias, respfunc, gapDias;
		
			respfunc = 0;
		
			// { GAP Dias Fecha Gastos }
			cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Dias Fecha Gastos'";
			rstXml(cuboQuery);				
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");
					
			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPDias");
					
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return respfunc;
			}
			if (nXml(cuboQuery) > 0) {
				gapDias = getXmlAtt(cuboQuery,"r0","paramvalor");
			} else {
				frn.message("Hubo problemas para obtener los Parametros [GAP Dias Fecha Gastos] ...","Error","Aceptar");
				return respfunc;
			}
				
			fech_hoy = sys.date();
	
			strFecha = fnDate("year", fech_hoy) & "/" /*"-"*/;
			strTmp = fnDate("month", fech_hoy);
			if(strlen(strTmp) == 1){
				strTmp = "0" & strTmp;
			}
			strFecha = strFecha & strTmp & "/" /*"-"*/ & "01";
					
			fech_ini = strFecha;
			
		
			//fech_hoy = "2024/12/05";  // For testing calc fech 
			strTmp = fnDate("month", fech_hoy);
			if ( strTmp == 12 ) {
				strFecha = fnDate("year", fech_hoy) & "/12/31";
				
				fech_limit = strFecha;
				
			} else {
				strFecha = fnDate("year", fech_hoy) & "/";
				strTmp = fnDate("month", fech_hoy) + 1;
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp & "/" & "01";
				
				fech_limit = fnDate("add",strFecha,-1);
				
			} 
			
			//fech_limit = fnDate("add",fech_limit,gapDias);  // Not Apply 
			fech_limit = formato_fecha(fech_limit);
			
			
			if ( gapDias > 0 ) { 
				aj_dias = (gapDias /*+ 1*/) * (-1); 
			} else {
				aj_dias = gapDias /*- 1*/;
			}
			if ( gapDias == 0 ) {
				fech_buff = fech_hoy;
			} else {
				fech_buff = fnDate("add", fech_hoy, aj_dias);
			}
			strTmp = fnDate("month", fech_buff);
			if ( strTmp == 12 ) {
				strFecha = fnDate("year", fech_buff) & "/12/31";
				
				fech_lim_fin = strFecha;
				
			} else {
				strFecha = fnDate("year", fech_buff) & "/";
				strTmp = fnDate("month", fech_buff) + 1;
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp & "/" & "01";
				
				fech_lim_fin = fnDate("add",strFecha,-1);
				
			} 
					
			fech_lim_fin = formato_fecha(fech_lim_fin);		
					
			strFecha = fnDate("year", fech_lim_fin) & "/";
			strTmp = fnDate("month", fech_lim_fin);
			if(strlen(strTmp) == 1){
				strTmp = "0" & strTmp;
			}
			strFecha = strFecha & strTmp & "/" /*"-"*/ & "01";
			
			fech_lim_ini = strFecha;
			fech_lim_ini = formato_fecha(fech_lim_ini);
			
			
			if ( strlen( frn.get("k_uuid_fecha") ) == 0 ) {
				frn.message("No hay Fecha UUID de Referencia para validar ...","Error","Aceptar");
				return respfunc;
			} 
			
			strFecha = frn.get("k_uuid_fecha");
			strFecha = formato_fecha(strFecha);
							
			if ( fnDate("cmp", strFecha, fech_hoy) > 0 /*strFecha > fech_hoy*/ ) {
				frn.message("La Fecha del UUID, es mayor al dia de hoy ..." & "|" & " " & 
					"|" & " " & strFecha ,"Error","Aceptar");
				return respfunc;
			} 
			
			if ( fnDate("cmp", strFecha, fech_limit) > 0 /*strFecha > fech_limit*/ ) {
				frn.message("La Fecha del UUID, fuera de Periodo Vigente ..." & "|" & " " & 
					"|" & " " & strFecha ,"Error","Aceptar");
				return respfunc;
			} 
			
			if ( fnDate("cmp", strFecha, fech_ini) < 0 /*strFecha < fech_ini*/ ) {
				if ( fnDate("cmp", strFecha, fech_lim_ini) < 0 /*strFecha < fech_lim_ini*/ ) {
					frn.message("La Fecha del UUID, es menor al Periodo Vigente ..." & "|" & " " & 
					"|" & " " & strFecha ,"Error","Aceptar");
					return respfunc;
				} else {
					if ( fnDate("cmp", strFecha, fech_lim_fin) > 0 /*strFecha > fech_lim_fin*/ ) {
						frn.message("La Fecha del UUID, fuera del Periodo Vigente ..." & "|" & " " & 
					"|" & " " & strFecha ,"Error","Aceptar");
						return respfunc;
					}
				}
			} 
			
			respfunc = 1;
			return respfunc;
		
		} // End Fun - Validar_Fecha_UUID

		// New Func 20240112 by JMM
		fun formato_fecha(fech) {
			var strFech, tmpData;
			
			strFech = fnDate("year", fech) & "/";
			tmpData = fnDate("month", fech);
			if(strlen(tmpData) == 1){
				tmpData = "0" & tmpData;
			}
			strFech = strFech & tmpData & "/";
			tmpData = fnDate("day", fech);
			if(strlen(tmpData) == 1){
				tmpData = "0" & tmpData;
			}
			strFech = strFech & tmpData;
			
			return strFech;
	
		} // end fun - formato_fecha


		fun ObtenerFactura(){
			var nCampos, uuid="";
			//Regresara la funcion UUID cadena con UUID, rfc, fecha, total
			// Added 20240119 by JMM
			var NewProv;
			
			limpiar_datos_uuid();
			
			uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID","k_refer", 0,"0");
			// Replaced with new function, 20240111 
			//uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID_Extended","k_refer", 0,"0");
			
			nCampos = strSplit(uuid,"|",-1);
			if (nCampos > 1) {
					str_uuid = strSplit(uuid,"|",0);		  //UUID
					rfc_uuid = strSplit(uuid,"|",1);		  //rfc
					fecha_uuid = strSplit(uuid,"|",2);	  //fecha
					total_uuid = strSplit(uuid,"|",3);	  //monto de la factura
					
					// Added 20240111 by JMM
					nombre_uuid = strSplit(uuid,"|",5);	  //nombre
					regimen_uuid = strSplit(uuid,"|",6);  //regimen
					folio_uuid = strSplit(uuid,"|",7);	  //folio
					serie_uuid = strSplit(uuid,"|",8);	  //serie
					
					// Added 20240224 by JMM
					impuesto_uuid = strSplit(uuid,"|",9); //impuesto
				
					// Conditions Added 20240111  by JMM, Updated 20240208
					if ( strlen(/*folio_uuid*/nombre_uuid) == 0 || strlen(rfc_uuid) == 0 || strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {
					
						//frn.set("k_refer","");
						frn.message("No se pudieron obtener todos los datos mandatorios del UUID.","Error","Aceptar");
						
					} else {
					
						frn.set("k_refer",str_uuid);
						frn.set("k_rfc",rfc_uuid);
						
						if ( BuscarUUID(str_uuid) > 0 ) {
							//frn.set("k_rfc","");
							frn.set("k_clave","");
							frn.message("Este Documento [UUID] ya ha sido Asociado previamente ...","Error","Aceptar");
							return;
						} 
				
						frn.set("k_uuid_fecha",mid(fecha_uuid,0,10));
						if ( Validar_Fecha_UUID() == 0 ) { 
							//frn.set("k_rfc","");
							frn.set("k_clave","");
							return;
						}
						
						NewProv = "";
						NewProv = BuscarProveedor();
						if (strlen(NewProv) > 0/*== 1*/) {
							//BuscarProveedor(NewProv);
							NewProvId = NewProv;
							frn.set("k_clave",NewProvId);
						} else {
							NewProvId = "";
						}
						
						if ( strlen(frn.get("k_clave")) > 0 && frn.get("k_clave") &! strFormat("ucase","No Existe ...") ) {
							
							// Validations Moved UP by JMM 20240119 ( BuscarUUID, Validar_Fecha_UUID )
												
							frn.set("k_uuid_serie",serie_uuid);
							frn.set("k_uuid_folio",folio_uuid);
							frn.set("k_uuid_monto",total_uuid);
							frn.set("k_uuid_fecha",mid(fecha_uuid,0,10));
							
							// Added 20240224 by JMM
							frn.set("k_uuid_impuesto",impuesto_uuid);
							
							//Added 20240228 by JMM
							frn.set("k_iva",impuesto_uuid);
								
						}
					}
			} else{
				//frn.set("k_refer","");
				frn.message("Faltan datos del UUID ...","Error","Aceptar");		
			}
		}	// End Fun - Obtener Factura


		//New Fuc 20240120 by JMM
		fun ProcesarFactura() {
		
			ObtenerFactura();
			
			if ( strlen(NewProvId) > 0 ) {
				prov_data_upd(NewProvId);
			}
			
			// Se elimina esta parte porque l ejecuta antes de abrir el dialogo ...
			// /*
			if ( strlen(NewProvId) > 0 ) {
				BuscarProveedor();
			}
			// */
			
		} // End Fun - ProcesarFactura 


