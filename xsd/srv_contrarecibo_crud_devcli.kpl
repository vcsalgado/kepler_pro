			*/
			frn.set("k_nombreprov",getXmlAtt(xml_kdm1  ,"k_nombreprov") );
			frn.set("k_calleprov",getXmlAtt(xml_kdm1  ,"k_calleprov") );
			frn.set("k_coloniaprov",getXmlAtt(xml_kdm1  ,"k_coloniaprov") );
			frn.set("k_poblacionprov",getXmlAtt(xml_kdm1  ,"k_poblacionprov") );
			frn.set("k_cpprov",getXmlAtt(xml_kdm1  ,"k_cpprov") );
			// ----	End : Section Added by JMM 20240215 
			
