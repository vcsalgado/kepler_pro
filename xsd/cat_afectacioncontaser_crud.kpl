<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Afectacic&#243;n Contable"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">	<tab/><txt fnt=",22" clr="0,0,0">Afectaci&#243;n Contable</txt><tab/>	<br/>	<tab/>	<hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" 		clrBrdr="0,58,112" dim="36,4,10,17" brdr="0,5" tit="Criterio de selecci&#243;n" fnt="Arial,16">		<sp/><txt>Sucursal:</txt>        <cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="35,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><tab n="2"/><txt>A&#241;o:</txt>		<inp id="k_anio" dim="7,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y" fnt="Arial,0" 			type="capital" nc="2" available="Y" tooltip="A&#241;o"/><sp/>     		<tab/>		<img id="img_buscar" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="ObtenerCuentas()"/>			</grp>	<br/><br/><tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="36,17,10,17" brdr="0,5" tit="Detalle de Cuentas" fnt="Arial,16">		<sp/>		<tbl id="k_mov" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="70,14" modify="Y" Reorder="Y" nren="fijo" available="Y">			<col name="Tipo" id="k_tipo" modify="N" type="capital" nc="5" visible="Y"/>			<col name="Descripci&#243;n" id="k_descripcion" modify="N" type="capital" nc="15" visible="Y"/>			<col name="Ventas M. Obra" id="k_vtasmo" modify="Y" type="capital" nc="16" visible="Y"/>			<col name="Ventas Refacciones" id="k_vtasrefacc" modify="Y" type="capital" nc="16" visible="Y"/>			<col name="Ventas TOTs" id="k_vtastots" modify="Y" type="capital" nc="16" visible="Y"/>			<col name="Ventas Varios" id="k_vtasvarios" modify="Y" type="capital" nc="16" visible="Y"/>			<col name="Costo M. Obra" id="k_costomo" modify="Y" type="capital" nc="16" visible="Y"/>			<col name="Costo Refacciones" id="k_costorefacc" modify="Y" type="capital" nc="16" visible="Y"/>			<col name="Costo TOTs" id="k_costotots" modify="Y" type="capital" nc="16" visible="Y"/>			<col name="Costo Varios" id="k_costovarios" modify="Y" type="capital" nc="16" visible="Y"/>			<col name="Puente M. Obra" id="k_ptemo" modify="Y" type="capital" nc="16" visible="Y"/>			<col name="Invent. Refacc." id="k_invrefacc" modify="Y" type="capital" nc="16" visible="Y"/>			<col name="Puente TOTs" id="k_ptetots" modify="Y" type="capital" nc="16" visible="Y"/>			<col name="Puente Varios" id="k_ptevarios" modify="Y" type="capital" nc="16" visible="Y"/>			                </tbl>		<br/><sp/>		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Guardar" hk="K" default="0" step="0"  OnEnter="Guardar()" fnt="Arial,16"/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;		var tipoOper,consPlantilla, accion; //Variables relacionadas con parametros (colsulta , eliminar, baja)		var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna, clave, modelo, clave_2,resVal ; 		var cmdQuery, cuboQuery, ok, mensajeError;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();			suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			rol_usuario = frn.config("user","role");			asterisco = "*";						tipoOper = frn.param(0);			clave = frn.param(1);			ConfiguraUI();			Inicializa();		}							fun ResetDetalle(){			frn.rst("k_mov");		}				fun ObtenerCuentas(){			var xmlPantalla,no_partidas;			var tmpStr, contDet, xmlCurDet, xmlDetConv,xmlDetalle;;			ResetDetalle();						if (frn.get("k_anio")==""){                frn.setPos("k_anio");                frn.message("Falta especificar el anio, verifique");                return;            }			xmlPantalla = getXml(frn.dataPag());			frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaAfectaContSer");						cmdQuery = "select * from keplersc.ser_afectacioncontaser_sel('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_afectacioncontaser_crud.ObtenerCuentas");			frn.lib("libGeneral.kpl","FileSave",cuboQuery,"C:\Basura\xmlPrecioXmodelo_sel");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			//Datos Detalle			rstXml(xmlDetConv);			tmpStr=getXmlAtt(cuboQuery,"r0","detpartidas");			rstXml(xmlDetalle);			tmpStr=delScpScn(tmpStr);			setXmlStr(xmlDetalle,tmpStr);			contDet=nXml(xmlDetalle);			for(var y=0; y< contDet; y++){				rstXml(xmlCurDet);				xmlCurDet= getXmlX(xmlDetalle,3,y);										setXml(xmlDetConv,"k_mov","r"&y,xmlCurDet);			}			frn.setX(xmlDetConv);			no_partidas=frn.N("k_mov")-1;				if (no_partidas==0) {				frn.message("No se encontraron registros","Mensaje","Aceptar");				return;			}		}				fun Guardar(){			var xmlPantalla,no_partidas,resultado,mensaje,adicionales;			//Validaciones			no_partidas=frn.N("k_mov");       			if (no_partidas==0) {				frn.message("Error, no se tiene registros ","Error","Aceptar");				return;			}			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;						setXml(xmlPantalla ,"k_partidas","no_partidas",no_partidas);						frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaAfectaContSer");			cmdQuery="select * from keplersc.ser_afectacionconta_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						kdb.rst(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_afectacioncontaser_crud.Alta");			resultado= getXml(cuboQuery,"resultado");			mensaje= getXml(cuboQuery,"mensaje");							if(resultado &= "0"){				frn.message(mensaje,"Error","Aceptar");				return;			}			ObtenerCuentas();			frn.message("Cuentas actualizadas","Mensaje","Aceptar");		}				fun ConfiguraUI(){			if (frn.nParam() == 0){				frn.message("Accion no permitida.","Error","&Aceptar");//				frn.open("redirect",2);				return;			}		}				fun Inicializa(){			frn.rst("gpo_2");						//Llenar combo sucursales			var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmd = cmd & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmd = cmd & " where c1='" & suc_usuario & "'";				}			}							var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");					ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}								frn.set("k_sucn",getXml(cubo));									}								}		</script></pag>