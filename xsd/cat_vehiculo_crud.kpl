);				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if((nXml(cubo) == 0) && (codsat_id &! "")) {					frn.setPos("k_codsat");					frn.message("El código SAT no existe","Error","Aceptar");					resVal = 0;					return;                 }		            }            fun NoU() {                if (frn.get("k_nou") &= "N") {                    frn.set("k_nou","U");                } else {                    frn.set("k_nou","N");                }            }                fun ValidaNoU(){                if (frn.get("k_nou") &! "N" && frn.get("k_nou") &! "U"){                    frn.setPos("k_nou");                    frn.message("Sólo puede ser N o U","Error","&Aceptar");                    return;                }              }			fun SoN(campo) {                if (frn.get(campo) &= "S") {                    frn.set(campo,"N");                } else {                    frn.set(campo,"S");                }            }                fun ValidaSoN(campo){                if (frn.get(campo) &! "S" && frn.get(campo) &! "N"){                    frn.setPos(campo);                    frn.message("Sólo puede ser S o N","Error","&Aceptar");                    return;                }              }    			fun EjecutaPaquetes() {					if (accion &! "NUEVO"){							if ( strlen(frn.get("k_clave")) != 0 ) {						frn.dialog("cat_vehiculopaquetes_crud",accion, clave_sel,"n");											}				}			}		}	</script></pag>