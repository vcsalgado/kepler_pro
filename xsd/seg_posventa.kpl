<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,15" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<tab/><txt fnt=",22" clr="0,0,0">Operaciones programadas para seguimiento Post-Venta</txt><br/>		<tab/><hLine dim="81,1,0,0" clr="0,0,0"/>		<br/><br/>		<tab/><txt fnt=",18b">Sucursal: </txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="35,36" bclr="255,255,255" 			brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y" OnChange="borrar()"/>		<br/><br/><tab/>			<br/>		<tab/>							<grp id="grpContactos" dim="81,29,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Operaciones Programadas Para Seguimiento Posventa">										<br/>					<tab/><txt clr="0,58,112">Orden</txt>			<inp id="inp_orden" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" nc="10"  modify="Y" available="Y"/>			<sp/>			<txt clr="0,58,112">Cliente</txt>			<inp id="inp_cliente" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"   modify="Y" available="Y"/>			<sp/>			<txt>Fecha prog ini:</txt>			<edt id="fecha_prog_ini" dim="12,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_prog_ini" OnF9="Dialog(3,_ks_fecha,fecha_prog_ini)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2" OnChange="LimpiaCriterio(otro)"/>		 			<sp/>			<txt>Fecha prog fin:</txt>			<edt id="fecha_prog_fin" dim="12,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_prog_fin" OnF9="Dialog(3,_ks_fecha,fecha_prog_fin)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2" OnChange="LimpiaCriterio(otro)"/>						<sp n="3"/>			<img id="img_buscar_asignados" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_Registros()" available="Y" clrBrdr="0,0,0"  modify="Y"/><br/>			<br/>			<sp/>			<tab/><tbl id="tbl_programados" dim="110,13" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" 				clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" insdel="N" modify="N" Reorder="N"				OnEnter="AtenderContacto()" OnMouseD="AtenderContacto()">							<col id="fecha_prog" name="Fecha" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="hora" name="Hora" type="string"/>				<col id="tipo_ord" name="Tipo" type="string" nc="10"/>				<col id="folio_orden" name="Orden" type="string" nc="10"/>				<col id="vin" name="Vin" type="string"/>				<col id="cliente" name="Cliente" type="string" nc="20"/>				<col id="nombre_cli" name="Nombre" type="string"/>															</tbl>			<br/>				<tab/>				<sp/><bot id="bot_contacto" dim="18,0" brdr="5" text="Atender" OnEnter="AtenderContacto()"/>			<tab n="29"/>			<img id="Exportar" dim="30,30" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(tbl_programados)" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y" tooltip="Guardar tabla"/>						</grp>		<br/><br/>		<tab/>										</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,sys;			var usuario,suc_usuario,rol_usuario,asterisco;			var resMensaje, cubo, cmd, ok,mensajeError;			var selOperacion;			fun Main() {				frn=new FRNT;				kdb=new KDB;				sys=new SYS;				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";								Inicializa();			}									fun Inicializa(){				//Llena combo de sucursales				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmktview.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_sucn",getXml(cubo));						Buscar_Registros();						}			fun borrar(){				frn.rst("tbl_programados");			}                     							fun Buscar_Registros(){								frn.rst("tbl_programados");				cmd="";						//En busqueda por serie mostrar el asesor tmkt en columna de serie, sólo cambiar etiqueta				cmd="select prog.c4 as fecha_prog, prog.c5 as hora,  ord.c2 as tipo_ord, prog.c3 as folio_orden, ord.c6 as vin, ord.c10 as cliente, ord.c11 as nombre_cli";				cmd = cmd & " from keplersc.kdencprog as prog inner join keplersc.kdord as ord on prog.c1=ord.c1 and prog.c2=ord.c2 and prog.c3=ord.c3 ";				cmd = cmd & "where prog.c1='" & frn.get("k_sucn",-1,1) & "' and prog.c6=10 ";								var orden_sel =  frn.get("inp_orden"); 				if (orden_sel &! ""){					cmd = cmd & " and prog.c3='" & orden_sel & "'";				}								var cliente_sel =  frn.get("inp_cliente"); 				if (cliente_sel &! ""){					cmd = cmd & " and ord.c10='" & cliente_sel & "'";				}									var fecha_prog_ini = frn.get("fecha_prog_ini");				if (fecha_prog_ini &! ""){					cmd = cmd & " and prog.c4>='" & fecha_prog_ini & "'";				}										var fecha_prog_fin = frn.get("fecha_prog_fin");					if (fecha_prog_fin &! ""){					cmd = cmd & " and prog.c4<='" & fecha_prog_fin & "'";				}				cmd = cmd & " order by prog.c4, prog.c5 desc ";				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmd_queryBUSCAR");				var cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmkt.buscar_registros()");								ok=getXmlAtt(cuboXml,"ok");												if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}											frn.set("tbl_programados",cuboXml);													}											fun AtenderContacto(){							var sucursal= frn.get("k_sucn",-1,1);				var tipo= frn.get("tbl_programados",-1,"tipo_ord");				var folio= frn.get("tbl_programados",-1,"folio_orden");				var vin= frn.get("tbl_programados",-1,"vin");				var cliente= frn.get("tbl_programados",-1,"cliente");				var nombre= frn.get("tbl_programados",-1,"nombre_cli");							frn.dialog("srv_cuest_pre","CUESTPSFU", sucursal,tipo,folio, vin, cliente, nombre);							}						fun guardar_tabla(tabla){				var save = frn.saveFile("tabla","Todos los archivos,*.*","_C:","Para guardar archivo");				frn.dialog("guarda_tabla",tabla,save); 			}														fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}											}	</script></pag>