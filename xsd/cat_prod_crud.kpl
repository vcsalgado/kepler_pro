<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<grp id="grupo_crud" dim="50,55,20,10" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16"><tab/>			<txt id="text_id">Clave:</txt><tab n="2"/>			<inp id="input_clave" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  available="N"/><br/><tab/>			<txt>Descripcion:</txt><tab/>			<inp id="input_desc" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<br/>			<tab/><txt>LOCALIZACION:</txt><br/><tab/>			<txt>1:</txt><tab n="2"/>			<inp id="input_loc1" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt>2:</txt><tab n="2"/>			<inp id="input_loc2" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt>3:</txt><tab n="2"/>			<inp id="input_loc3" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<br/>						<tab/><txt>Clasificacion:</txt><tab/>			<cmb id="input_clas" clr="64,64,64" clrBrdr="255,255,255"  dim="10,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N"  available="Y"/><br/>						<tab/><txt>Linea:</txt><tab n="2"/>			<inp id="input_linea" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt>Precio1:</txt><tab/>			<inp id="input_precio1" dim="10,1" brdr="2,0" type="number" nd="2" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt>Precio2:</txt><tab/>			<inp id="input_precio2" dim="10,1" brdr="2,0" type="number" nd="2" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>					<txt>Precio3:</txt><tab/>			<inp id="input_precio3" dim="10,1" brdr="2,0" type="number" nd="2" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt>Precio4:</txt><tab/>			<inp id="input_precio4" dim="10,1" brdr="2,0" type="number" nd="2"  clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>						<txt>Conversion:</txt><tab/>			<inp id="input_conversion" dim="10,1" brdr="2,0" type="number" nd="2"  clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt>Unidad:</txt><tab/>			<cmb id="input_unidad" clr="64,64,64" clrBrdr="255,255,255"  dim="10,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N"  available="Y"/><br/>						<tab/><txt>Clave Sat:</txt><tab/>			<inp id="input_claveSAT" dim="10,1"  brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt id="text_agrupador" visible="Y">Agrupador:</txt><tab/>			<inp id="input_agrupador" dim="10,1" brdr="2,0" clr="64,64,64" nc="5" bclr="255,255,255" clrBrdr="255,255,255" visible="Y"/><br/>						<br/>			<tab/><txt>NIVELES DE EXISTENCIA:</txt><br/><tab/>			<txt>Minimo:</txt><tab/>			<inp id="input_minimo" dim="10,1" type="number" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt>Maximo:</txt><tab/>			<inp id="input_maximo" dim="10,1" type="number" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>						<bot id="btn_aceptar" dim="5,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/><br/>						<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>							</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP,externo,accion ;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();				ctlrs_off();				llenar_ctlrs_default();				//config_ctrls_perfil();								}						fun ctlrs_off(){							frn.setAtt("text_agrupador", "visible", "N" );					frn.setAtt("input_agrupador", "visible", "N" );					frn.setAtt("input_clave", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );				}							fun llenar_ctlrs_default(){							frn.rst("grupo_crud");							accion = frn.param(0);									externo = frn.param(2);							var xmlRequest,cmd,ok, cuboResultados;									var clave_ref = frn.param(1);							frn.set("input_crud", accion);							frn.setAtt("grupo_crud", "tit", accion );												//llenar combo unidad				cmd = "select c1||'-'||c2 as descripcion ,c1 as clave from keplersc.kdinu" ;				cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_prod_crud.llenar_ctlrs_default()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}									var unidad = "input_unidad";									frn.setX("", unidad,0,0);				frn.setX("", unidad, 0, 1);									llenar_cmb(cuboResultados,unidad);												//llenar combo clasificacion				cmd = "select c1||'-'||c2 as descripcion ,c1 as clave from keplersc.kdif" ;				cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_prod_crud.llenar_ctlrs_default()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}										var combo = "input_clas";									frn.setX("", combo ,0,0);				frn.setX("", combo , 0, 1);									llenar_cmb(cuboResultados,combo);																					if (accion &= "Modificar"){									//llamada externa(padre)					if (externo &= "s"){											clave_ref =frP.get("k_mov",-1,"k_parte");												if (clave_ref  &= ""){													clave_ref =frP.get("k_parte");														if (clave_ref  &= ""){														frn.message("selecciona una parte para modificar","Error","Aceptar");								return;							}						}											}else {											clave_ref  = frn.param(1);					}				}												if (accion &! "Nuevo") {									if (accion &! "Modificar"){											clave_ref  = frn.param(1);										}																			var campos = "r.c2,r.c4,r.c5,r.c6,c.c1||'-'||c.c2 as clas,r.c9,r.c11,r.c12,r.c13,r.c14,r.c16,u.c1||'-'||u.c2 as unidad,r.c21,r.c22,r.c32,r.c33";								cmd="select " & campos & " from keplersc.kdini as r left outer join keplersc.kdinu as u on r.c19=u.c1 left outer join keplersc.kdif as c on r.c8 = c.c1 where r.c1 ='" & clave_ref  & "'"; 									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_prod_crud.llenar_ctlrs_default()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}										frn.setAtt("text_agrupador", "visible", "Y" );						frn.setAtt("input_agrupador", "visible", "Y" );					frn.set("input_clave", clave_ref );					frn.setAtt("input_clave", "available", "N" );						frn.set("input_desc",getXmlAtt(cuboResultados,"r"&0,"c2"));					frn.set("input_loc1",getXmlAtt(cuboResultados,"r"&0,"c4"));					frn.set("input_loc2",getXmlAtt(cuboResultados,"r"&0,"c5"));					frn.set("input_loc3",getXmlAtt(cuboResultados,"r"&0,"c6"));					frn.set("input_clas",getXmlAtt(cuboResultados,"r"&0,"clas"));										frn.set("input_linea",getXmlAtt(cuboResultados,"r"&0,"c9"));							frn.set("input_precio1",getXmlAtt(cuboResultados,"r"&0,"c11"));					frn.set("input_precio2",getXmlAtt(cuboResultados,"r"&0,"c12"));					frn.set("input_precio3",getXmlAtt(cuboResultados,"r"&0,"c13"));					frn.set("input_precio4",getXmlAtt(cuboResultados,"r"&0,"c14"));										frn.set("input_conversion",getXmlAtt(cuboResultados,"r"&0,"c16"));					frn.set("input_unidad",getXmlAtt(cuboResultados,"r"&0,"unidad"));					frn.set("input_minimo",getXmlAtt(cuboResultados,"r"&0,"c21"));					frn.set("input_maximo",getXmlAtt(cuboResultados,"r"&0,"c22"));										frn.set("input_agrupador",getXmlAtt(cuboResultados,"r"&0,"c32"));										frn.set("input_claveSAT",getXmlAtt(cuboResultados,"r"&0,"c33"));																		} else {					frn.setAtt("input_clave", "available", "Y" );														}								if (accion &! "Consultar"){					frn.setAtt("btn_aceptar", "available", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );				}							}								fun config_ctrls_perfil(){						//cadena_perfiles = frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados")						//split(cadena_perfiles, 						}									fun Execute() {						var xmlRequest,cmd,cuboResultados,ok,cmd,cubo, mensajeError ;								var resultado_confirmacion = frn.message("¿Estas seguro?","Mensaje de Confirmacion","Aceptar");									if (resultado_confirmacion &! 1)  {					return;				}													xmlRequest = getXml(frn.dataPag()); 							frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmd="SELECT * FROM keplersc.prod_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";					cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"cat_prod_crud.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");													var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;						}																		if (accion &= "Nuevo" || accion &= "Modificar") {									var nueva_clave = frn.get("input_clave");					var nueva_desc = frn.get("input_desc");									if (externo &= "n"){										frP.setX(nueva_clave,"tabla",-1,"ref_clave"); 						frP.scriptElm("tabla","OnChange","ref_clave");										frP.setX(nueva_desc ,"tabla",-1,"ref_desc"); 						frP.scriptElm("tabla","OnChange","ref_desc");													}else {											var nueva_unidad = frn.get("input_unidad",-1,1);						var nuevo_precio= frn.get("input_precio1");												frP.setX(nueva_clave,"k_mov",-1,"k_parte"); 						frP.scriptElm("k_mov","OnChange","k_parte");											frP.setX(nueva_desc ,"k_mov",-1,"k_descr"); 						frP.scriptElm("k_mov","OnChange","k_descr");									frP.setX(nueva_unidad ,"k_mov",-1,"k_unidad"); 						frP.scriptElm("k_mov","OnChange","k_unidad");												//cuando la llama invrcapturainvent.kpl						frP.setX(nueva_desc ,"k_parte_desc");						frP.set("k_unidad",frn.get("input_unidad",-1,0)); 														}										var sms =  "";										if (accion &= "Nuevo"){						sms = "Parte registrada";					}else {						sms = "Parte modificada";					}											frn.message(sms ,"Mensaje","Aceptar");					frn.exit();										}								if (accion &= "Eliminar"){										frP.setX("","tabla",-1,"ref_clave"); 					frP.scriptElm("tabla","OnChange","ref_clave");									frP.setX("","tabla",-1,"ref_desc"); 					frP.scriptElm("tabla","OnChange","ref_desc");								frn.message("Parte eliminada","Mensaje","Aceptar");					frn.exit();									}										}									fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}								}	</script></pag>