<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="P&#243;lizas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,10" bclr="192,205,213" unfont="0">	<tab/><inp id="k_titulo" dim="30,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"			type="string" modify="N" available="N" fnt="Arial,22"/>	<br/><br/><tab/>	<hLine clr="0,0,0"/>	<br/><br/>	<tab/>		<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="82,60,10,9" brdr="0,5" tit="Modificacion de polizas" fnt="Arial,16">			<tab/>			<inp id="suc" dim="7,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 				type="string" modify="N" available="N" fnt="Arial,0"/>			<tab/>			<cmb id="k_suc" clr="64,64,64" clrBrdr="192,205,213"  				dim="30,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" available="Y"/>			<sp/>							<tab n="1"/>			<inp id="modo_descuadradas" dim="12,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 				type="string" modify="N" available="N" fnt="Arial,0"/>										<chck id="descuadrada" dim="2,12" brdr="3,2" clr="10,40,100" 				bclr="255,255,255" YN="10" hk="C" tooltip="Solo descuadrada"/>			<br/>			<tab/>			<hLine clr="0,0,0"/>			<br/>			<grp id="gpo_3" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,0,0" dim="72,15,10,9" brdr="0,0" fnt="Arial,16">			 <br/>			<tab/>			<inp id="modo_poliza" dim="7,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 				type="string" modify="N" available="N" fnt="Arial,0"/>			<ratio id="R1" default="1" dim="2,16" clr="255,0,0" bclr="255,255,255"				hk="u" tooltip="Opcion 1" modify="Y" available="Y"				visible="Y" OnChange="activaCampos()"/>			<tab/>				<inp id="anio" dim="5,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,0"/>			<cmb id="k_anio" clr="64,64,64" clrBrdr="192,205,213"  				dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" available="Y"/>			<sp/>			<tab/>				<inp id="mes" dim="5,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,0"/>			<sp/>			<cmb id="k_mes" clr="64,64,64" clrBrdr="192,205,213"  				dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" available="Y"/>						<tab/>			<inp id="tipo" dim="5,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,0"/>			<tab/>			<cmb id="k_tipo" clr="64,64,64" clrBrdr="192,205,213"  					dim="4,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" available="Y"/>			<sp/>				<inp id="k_descrip_tipo" dim="21,1" brdr="0,0" bclr="192,205,213" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,0"/>						<br/>			<tab/>				<inp id="rango_ini" dim="13,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,0"/>			<sp/>				<inp id="k_rango_ini" dim="4,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="Y" fnt="Arial,16"  nc="5"/>			<sp/>				<inp id="rango_fin" dim="13,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,0"/>			<sp/>				<inp id="k_rango_fin" dim="4,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="Y" fnt="Arial,16" nc="5"/>		     <tab/>				<inp id="referencia" dim="8,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,0"/>			<sp/>				<inp id="k_refer" dim="20,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="Y" fnt="Arial,16" nc="60"/>            <br/>			<tab/>			<hLine clr="0,0,0"/>			<br/>			<tab/>			<inp id="modo_movimiento" dim="7,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 				type="string" modify="N" available="N" fnt="Arial,0"/>			<ratio id="R2" dim="2,16" clr="255,0,0" bclr="255,255,255"				hk="u" tooltip="Opcion 1" modify="Y" available="Y"				visible="Y"  OnChange="activaCampos()"/>			<br/>			<tab/>				<inp id="folio" dim="5,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,0"/>			<sp/>				<inp id="k_folio" dim="12,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="N" fnt="Arial,16" nc="12"/>            <tab/>				<inp id="fecha" dim="10,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,0"/>				<edt id="k_fecha" dim="10,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213"					type="date" modify="Y" available="N" fnt="Arial,16" OnF9="Dialog(3,_ks_fecha,k_fecha)" page="_ks_fecha,k_fecha" fmt="DD/MM/CCYY" nc="-1"/>						<tab/>				<inp id="fecha_fin" dim="10,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,0"/>				<edt id="k_fecha_fin" dim="10,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213"					type="date" modify="Y" available="N" fnt="Arial,16" OnF9="Dialog(3,_ks_fecha,k_fecha_fin)" page="_ks_fecha,k_fecha_fin" fmt="DD/MM/CCYY" nc="-1"/>			<sp/>			<br/>			<tab/>			<inp id="genero" dim="5,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,0"/>			<inp id="k_genero" dim="2,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="N" fnt="Arial,16"  nc="1"/>			 <sp/>			<inp id="naturaleza" dim="7,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,0"/>			<inp id="k_naturaleza" dim="2,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="capital" modify="Y" available="N" fnt="Arial,16"  nc="1"/>			 <sp/>			<inp id="grupo" dim="5,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,0"/>			<inp id="k_grupo" dim="2,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="number" modify="Y" available="N" fnt="Arial,16"  nc="2" nd="0" max="99"/>			 <sp/>			<inp id="tipo_2" dim="4,1" brdr="0,0" bclr="236,240,243" clrBrdr="192,205,213" 					type="string" modify="N" available="N" fnt="Arial,0"/>			<inp id="k_tipo_2" dim="2,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 					type="number" modify="Y" available="N" fnt="Arial,16" nc="1" nd="0" max="99"/>            <br/>			</grp>			<grp id="gpo_4" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,0,0" dim="72,15,10,9" brdr="0,0" fnt="Arial,16">				<br/>				<br/>				<br/>				<tab n="1"/>				<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"   default="0" img="_60_DocNew.png" OnEnter="cargarPolizas()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			</grp>			<br/>            <tab n="1"/>					<tbl id="tabla" clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" brdr="1,0" id="results" dim="74,18" 			modify="N" nren="fijo" Reorder="Y">			<col name="No. Poliza" id="t_n_poliza" type="text" nc="5" visible="Y"/>			<col name="Tipo" id="t_tipo" type="text" nc="2" visible="Y"/>			<col name="Fecha" id="t_fecha" type="date" nc="-1" fmt="DD/MM/CCYY" visible="Y"/>			<col name="Folio" id="t_folio" type="text" nc="10" visible="Y"/>			<col name="Referencia" id="t_referencia" type="string" nc="-1" visible="Y"/>			<col name="Cargos" id="t_cargos" type="number" nc="-1" visible="Y" nd="2"/>			<col name="Abonos" id="t_abonos" type="number" nc="-1" visible="Y" nd="2"/>			<col name="Diferencia" id="t_diferencia" type="number" nc="-1" visible="Y" nd="2"/>			<col id="sucursal" name="sucursal" type="string" visible="Y"/>			<col id="genero" name="Gen" type="string" visible="Y"/>			<col id="naturaleza" name="Nat" type="string" visible="Y"/>			<col id="grupo" name="Gpo" type="string" visible="Y"/>			<col id="tipo" name="Tipo" type="string" visible="Y"/>					</tbl>				<br/>		<tab/>		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Seleccionar" hk="K" default="2" step="0"  OnEnter="abrir_poliza()" fnt="Arial,16"/> 		</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;			var tipoOper,consPlantilla; //Variables relacionadas con parametros (colsulta , eliminar, baja)			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna; 			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								ConfiguraUI();								Inicializa();						}		fun activaCampos(){			var radio = frn.get("R1");			if (radio &= "1"){				frn.setAtt("k_suc","available","Y");				frn.setAtt("k_mes","available","Y");				frn.setAtt("k_anio","available","Y");				frn.setAtt("k_rango_ini","available","Y");				frn.setAtt("k_rango_fin","available","Y");				frn.setAtt("k_tipo","available","Y");				frn.setAtt("k_refer","available","Y");				frn.setAtt("k_folio","available","N");				frn.setAtt("k_fecha","available","N");   				frn.setAtt("k_fecha_fin","available","N");				frn.setAtt("k_genero","available","N");				frn.setAtt("k_naturaleza","available","N");				frn.setAtt("k_grupo","available","N");				frn.setAtt("k_tipo_2","available","N");								frn.setAtt("k_suc","bclr","255,255,255");				frn.setAtt("k_mes","bclr","255,255,255");				frn.setAtt("k_anio","bclr","255,255,255");                frn.setAtt("k_rango_ini","bclr","255,255,255");				frn.setAtt("k_rango_fin","bclr","255,255,255");				frn.setAtt("k_tipo","bclr","255,255,255");                frn.setAtt("k_refer","bclr","255,255,255");				frn.setAtt("k_folio","bclr","236,240,243");				frn.setAtt("k_fecha","bclr","236,240,243");				frn.setAtt("k_fecha_fin","bclr","236,240,243");				frn.setAtt("k_genero","bclr","236,240,243");				frn.setAtt("k_naturaleza","bclr","236,240,243");				frn.setAtt("k_grupo","bclr","236,240,243");				frn.setAtt("k_tipo_2","bclr","236,240,243");				frn.setPos("k_suc");			}else if(radio &= ""){				frn.setAtt("k_suc","available","Y");				frn.setAtt("k_mes","available","N");				frn.setAtt("k_anio","available","N");				frn.setAtt("k_rango_ini","available","N");				frn.setAtt("k_rango_fin","available","N");				frn.setAtt("k_tipo","available","N");				frn.setAtt("k_refer","available","N");				frn.setAtt("k_folio","available","Y");				frn.setAtt("k_fecha","available","Y");  				frn.setAtt("k_fecha_fin","available","Y");  				frn.setAtt("k_genero","available","Y");				frn.setAtt("k_naturaleza","available","Y");				frn.setAtt("k_grupo","available","Y");				frn.setAtt("k_tipo_2","available","Y");				 				frn.setAtt("k_suc","bclr","255,255,255");				frn.setAtt("k_mes","bclr","236,240,243");				frn.setAtt("k_anio","bclr","236,240,243");                frn.setAtt("k_rango_ini","bclr","236,240,243");				frn.setAtt("k_rango_fin","bclr","236,240,243");				frn.setAtt("k_tipo","bclr","236,240,243");				frn.setAtt("k_refer","bclr","236,240,243");				frn.setAtt("k_folio","bclr","255,255,255");				frn.setAtt("k_fecha","bclr","255,255,255");				frn.setAtt("k_fecha_fin","bclr","255,255,255");                				frn.setAtt("k_genero","bclr","255,255,255");				frn.setAtt("k_naturaleza","bclr","255,255,255");				frn.setAtt("k_grupo","bclr","255,255,255");				frn.setAtt("k_tipo_2","bclr","255,255,255");				frn.setPos("k_folio");			}						}		fun cargarPolizas(){			var queryTablas, cubo_lista_tablas, ok, mensajeError, mes, anio, tipo, k_tipo, k_tipo_2, k_rango_fin, k_rango_ini, k_tabla, k_refer, k_folio, k_genero, k_naturaleza, k_grupo;			queryTablas = "SELECT table_schema, table_name FROM INFORMATION_SCHEMA.TABLES 								WHERE TABLE_NAME LIKE 'kdc22%'								order by table_name";				cubo_lista_tablas= frn.lib("libGeneral.kpl","EjecutarSqlSel",queryTablas,"conpolizasView.cargarpolizas()");				ok=getXmlAtt(cubo_lista_tablas,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}	//			frn.lib("libGeneral.kpl","FileSave",cubo_lista_tablas,"C:\Basura\cubo_lista_tablas");			var k_suc = frn.get("k_suc",-1,1);			var k_fecha = frn.get("k_fecha");			var k_fecha_fin = frn.get("k_fecha_fin");			k_rango_ini = frn.get("k_rango_ini");			k_rango_fin = frn.get("k_rango_fin");			k_folio = frn.get("k_folio");			k_genero = frn.get("k_genero");			k_naturaleza = frn.get("k_naturaleza");					k_grupo = frn.get("k_grupo");			k_tipo_2 = frn.get("k_tipo_2");			var radio = frn.get("R1");			if (radio &= "1"){				anio =mid(frn.get("k_anio"),2,2);				mes = frn.get("k_mes");				k_tipo = frn.get("k_tipo");				if (k_tipo &=""){					k_tipo = "%%";				}								k_tabla= "keplersc.kdc2"& anio & mes;				if (k_rango_ini &= ""){					k_rango_ini = "0";				}				if (k_rango_fin &=""){					k_rango_fin = "(select count(*) from " &k_tabla &")";				}				k_refer = frn.get("k_refer");				if (k_refer &=""){					k_refer = "%%";				}				else{					k_refer = "%" & k_refer & "%";				}				k_fecha = ">(SELECT TO_TIMESTAMP('2000-01-01 05:00:01','YYYY-MM-DD HH:MI:SS'))";				k_folio = "%%";				k_genero = "%%";				k_naturaleza = "%%";				k_grupo = ">" & "0";				k_tipo_2 = ">" & "0";			}else{				anio =mid(k_fecha_fin,2,2);				mes = mid(k_fecha_fin,5,2);				k_tipo = "%%";				k_tabla= "keplersc.kdc2"& anio & mes;				k_rango_ini = "0";				k_rango_fin = "(select count(*) from " &k_tabla &")";				k_refer = "%%";				if (k_fecha &="" || k_fecha_fin &=""){					k_fecha = ">(SELECT TO_TIMESTAMP('2000-01-01 05:00:01','YYYY-MM-DD HH:MI:SS'))";				}				else{					k_fecha = ">=" & "(SELECT TO_TIMESTAMP('"& k_fecha &"','YYYY-MM-DD HH:MI:SS')) AND c2 <= " & "(SELECT TO_TIMESTAMP('"& k_fecha_fin &"','YYYY-MM-DD HH:MI:SS'))";				}				if (k_folio &=""){					k_folio = "%%";				}				else{					k_folio = "%" & k_folio & "%";				}				if (k_genero &=""){					k_genero = "%%";				}				else{					k_genero = "%" & k_genero & "%";				}				if (k_naturaleza &=""){					k_naturaleza = "%%";				}					else{					k_naturaleza = "%" & k_naturaleza & "%";				}				if (k_grupo &= "0"){					k_grupo = ">" & "0";				}else{					k_grupo = "=" & k_grupo;				}				if (k_tipo_2 &= "0"){					k_tipo_2 = ">" & "0";				}else{					k_tipo_2 = "=" & k_tipo_2;				}			}/*			var cmdQuery ="select n_poliza as t_n_poliza, tipo_l as t_tipo, fecha as t_fecha,folio as t_folio , referencia as t_referencia, 					coalesce (sum(cargo_total),0) as t_cargos, coalesce (sum(abono_total),0) as t_abonos,					coalesce (sum(sel.cargo_total)-sum(sel.abono_total),0) as t_diferencia,genero,naturaleza,grupo,tipo					from(select c1 as n_poliza, c8 as tipo_l,c2 as fecha,c7 as referencia, c14 as suc,					c15 as genero, c16 as naturaleza, c17 as grupo, c18 as tipo,c19 as folio, c4 as cargo_abono,					case when c4 ='A' then sum(c5) end abono_total, 					case when c4 ='C' then sum(c5) end cargo_total from "					& k_tabla &					" where c1 between  '"&k_rango_ini&"' and "& k_rango_fin &" 					and c14 = '"& k_suc & "' and c8 like'" & k_tipo &   "' and c19 like '"&k_folio&"' and c7 like '"&k_refer&"' and c2 "&k_fecha&" 					and c15 like '"&k_genero&"' and c16 like '"&k_naturaleza&"' and c17 "&k_grupo&" and c18 "&k_tipo_2&"					group  by c1, c4, c8, c14, c15 , c16, c17, c18,c19 , c2, c7					order by c1) as sel					group by n_poliza, tipo_l, fecha, referencia,folio,genero,naturaleza,grupo,tipo";*/			var cmdQuery ="select n_poliza as t_n_poliza, tipo_l as t_tipo, fecha as t_fecha,folio as t_folio , referencia as t_referencia, 					coalesce (sum(cargo_total),0) as t_cargos, coalesce (sum(abono_total),0) as t_abonos,					coalesce (coalesce(sum(sel.cargo_total),0)-coalesce(sum(sel.abono_total),0),0) as t_diferencia,sucursal,genero,naturaleza,grupo,tipo					from(select c1 as n_poliza, c8 as tipo_l,c2 as fecha,c7 as referencia, c14 as sucursal,					c15 as genero, c16 as naturaleza, c17 as grupo, c18 as tipo,c19 as folio, c4 as cargo_abono,					case when c4 ='A' then sum(c5) end abono_total, 					case when c4 ='C' then sum(c5) end cargo_total from "					& k_tabla &					" where c1 between  '" & k_rango_ini & "' and "& k_rango_fin "' ";					if (k_suc &! "TODAS"){						cmdQuery = cmdQuery & " and c14 = '"& k_suc & "'";					}					cmdQuery = cmdQuery & " and c8 like'" & k_tipo &   "' and c19 like '"&k_folio&"' and c7 like '"&k_refer&"' and c2 " & k_fecha & " and c15 like '" & k_genero & "' and c16 like '" & k_naturaleza & "' and c17 " & k_grupo & " and c18 " & k_tipo_2 & "group  by c1, c4, c8, c14, c15 , c16, c17, c18,c19 , c2, c7					order by c1) as sel					group by n_poliza, tipo_l, fecha, referencia,folio,sucursal,genero,naturaleza,grupo,tipo";									frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\cmdPolizas");																								var solo_descuadradas = frn.get("descuadrada");				if (solo_descuadradas &= "1"){											cmdQuery = cmdQuery & " having (coalesce(sum(sel.cargo_total),0)-coalesce(sum(sel.abono_total),0)) <> 0 ";									}																//			frn.message(k_tabla,"Error","Aceptar");			var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conpolizasView.cargarPolizas()");			var consultaXml=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cubo,"r0");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\consultaXml");			frn.setX(cubo,"tabla");			obtenerTipoDesc();		}	        fun obtenerTipoDesc(){            var tipo =mid(frn.get("k_tipo",-1,1),1,1);            var cmd = "select c5 as k_descrip                 from keplersc.kdmm                where col_sucursal='" & frn.get("k_suc",-1,1) & "' and c1 = 'N' and c2 = 'A' and c3 = 21 and c4=" & tipo";                 cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"conpolizasview.obtenerTipoDesc()");            var descripcion = getXmlAtt(cuboXml,"r0","k_descrip");            frn.set("k_descrip_tipo",descripcion);			        }			         fun ObtenerTipo(){			var ok, mensajeError, cubo;            var cmdQuery = "select distinct c18 as tipo_letra, concat('0',c4) as k_tipo, c5 as k_descrip					from keplersc.kdmm					where c1 = 'N' and c2 = 'A' and c3 = 21";			cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conpolizasView.ObtenerTipo()");								ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}										frn.setX("", "k_tipo",0,0);			frn.setX("", "k_tipo",0,1);			frn.setX("", "k_tipo",0,2);			llenar_cmb(getXml(cubo),"k_tipo");			//cargarPolizas();         }			fun abrir_poliza(){			var cmd ="",v_strTmp,v_anio, v_mes,cuboProd,ok,mensajeError,V_RESULT;					v_strTmp = frn.get("tabla",-1,"t_fecha");					v_mes = fnDate("month",v_strTmp);					v_anio = fnDate("year",v_strTmp);															cmd = "select c"& (v_mes + 9) &" as estado from keplersc.kdym  where c1 = '" & v_anio & "'";frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdDetPoliza");															cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ModificacionPoliza.ConsultarPoliza()");										ok=getXmlAtt(cuboProd,"ok");					if(ok &! "" && !ok)					{						mensajeError = getXmlAtt(cuboProd,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					V_RESULT = getXmlAtt(cuboProd,"r0","estado");					if (V_RESULT &= "C")					{						if (tipoOper &! "CONSULTA"){							frn.message("La poliza seleccionada no se puede modificar, el mes se encuentra cerrado.","Aviso","&Aceptar");							return;						}					}					if (V_RESULT &= "A")					{					}					if (V_RESULT &! "A" && 						 V_RESULT &! "C" )					{						frn.message("El mes no se encuentra configurado en KDYM.","Error","&Aceptar");						return;					}									var gen,nat,gpo,tipo,sucursal_id,anio,mes,tipo_poliza,folio,tipo_movto,param;				gen=frn.get("tabla",-1,"genero");				nat=frn.get("tabla",-1,"naturaleza");				gpo=frn.get("tabla",-1,"grupo");				tipo=frn.get("tabla",-1,"tipo");									sucursal_id = frn.get("tabla",-1,"sucursal");								v_strTmp = frn.get("tabla",-1,"t_fecha");				mes= fnDate("month",v_strTmp);				anio = fnDate("year",v_strTmp);//frn.message(anio,"Anio","Aceptar");				anio =mid(anio,2,2);								//				anio =mid(frn.get("k_anio"),2,2);	//				mes=frn.get("k_mes");				tipo_poliza=frn.get("tabla",-1,"t_tipo");				folio=frn.get("tabla",-1,"t_n_poliza");				if (tipoOper&="CONSULTA"){					tipo_movto = "C";				}else if(tipoOper&="MODIFICAR"){					tipo_movto = "M";								}else if(tipoOper&="BAJA"){					if(gen !="N" || nat!="A" || gpo!="21"){						frn.message("No se puede eliminar la poliza para el tipo de movimiento","Mensaje","&Aceptar");						return;					}					tipo_movto = "B";				}								param=gen & "," & nat &  "," & gpo & "," & tipo & "," & tipo_movto & "," & sucursal_id & "," & anio & "," & mes & "," & tipo_poliza & "," & folio;				frn.dialog("conpolizapag.kpl",gen,nat,gpo,tipo,tipo_movto,sucursal_id,anio,mes,tipo_poliza,folio);			}						fun ConfiguraUI(){				consPlantilla="CONSULTA"; //AQUI DEFINE LA CONSTANTE PARA COMPARAR EN PARAMETROS				if (frn.nParam() == 0){					frn.message("Accion no permitida.","Error","&Aceptar");					frn.open("redirect",2);					return;				}				tipoOper = frn.param(0);				//Establecer titulo de la ventana				if (tipoOper &= "CONSULTA"){					frn.setAtt("gpo_2","tit","Consulta de polizas");					frn.set("k_titulo","Consulta de Polizas");				}else if(tipoOper&="MODIFICAR"){										frn.setAtt("gpo_2","tit","Modificacion de polizas");					frn.set("k_titulo","Modificacion de Polizas");								}else if(tipoOper &= "BAJA"){					frn.setAtt("gpo_2","tit","Baja de polizas");					frn.set("k_titulo","Baja de Polizas");								}				else{					frn.message("Accion no permitida.","Error","&Aceptar");					frn.open("redirect",2);					return;				}			}								fun Inicializa(){				frn.rst("gpo_2");				Inicia_Forma();				//cargarPolizas();				ObtenerTipo();				obtenerTipoDesc();				activaCampos();				}				fun Inicia_Forma(){				var cmd,ok,mensajeError, cubo, cmdQueryanio, cmdQuerymes;				//Etiquetas 				frn.set("modo","Modo");				frn.set("modo_descuadradas","Solo descuadradas");				frn.set("modo_poliza","Poliza");				frn.set("modo_movimiento","Movimiento");				frn.set("suc","Sucursal");				frn.set("mes","Mes");				frn.set("anio","Anio");				frn.set("rango_ini","Del No. de Poliza");				frn.set("rango_fin","Al No. de Poliza");				frn.set("tipo","Tipo");				frn.set("folio","Folio");				frn.set("fecha","Fecha Inicial");				frn.set("fecha_fin","Fecha Final");            frn.set("referencia","Referencia");				frn.set("genero","Genero");				frn.set("naturaleza","Naturaleza");				frn.set("grupo","Grupo");				frn.set("tipo_2","Tipo");											//Llenar combo sucursales				//cmd = "select '[00] TODAS' as c2, 'TODAS' as c1 union  select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms order by c2";				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";								if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}										cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"conpolizasView.Inicia_Forma()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				frn.set("k_suc",getXml(cubo));				cmdQueryanio="SELECT concat('20',substring(table_name,5,2)) as anio FROM INFORMATION_SCHEMA.TABLES 								WHERE table_schema='keplersc' and table_type='BASE TABLE' and TABLE_NAME LIKE 'kdc22%' or TABLE_NAME LIKE 'kdc219%' 								group by anio								order by anio desc";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQueryanio,"conpolizasView.Inicia_Forma()");				frn.set("k_anio",getXml(cubo));				cmdQuerymes = "select substring(table_name,7,2) as mes from information_schema.tables								where table_schema='keplersc' and table_type='BASE TABLE' and table_name  like 'kdc22%'  and substring(table_name,7,2) != ''								group  by mes";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuerymes,"conpolizasView.Inicia_Forma()");				frn.set("k_mes",getXml(cubo));			}									fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var tipo_letra= getXmlAtt(cuboResultados,"r"&cont,"tipo_letra");					var tipo= getXmlAtt(cuboResultados,"r"&cont,"k_tipo");					var desc= getXmlAtt(cuboResultados,"r"&cont,"k_descrip");					frn.setX(tipo_letra, cmb, cont+pos_ini ,0);					frn.setX(tipo, cmb, cont+pos_ini ,1);					frn.setX(desc, cmb, cont+pos_ini ,2);								}				}											//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------GAD fl4r30n									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>