<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Carga Refacciones"><grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><tab/><txt fnt=",22" clr="0,0,0">Descarga de Refacciones</txt><br/><tab/>	<hLine dim="0,1" clr="0,0,0"/> 	<br/> <br/>	<tab n="1"/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="54,12,7,12" tit="Datos generales"  fnt="Arial,16"><tab/>		<txt clr="0,58,112" hk="S">Sucursal</txt><tab n="2"/>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" modify="N" available="Y"/><br/><tab/>	   <txt clr="0,58,112">Tipo docto</txt><tab n="1"/>		<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255"  dim="35,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="TipoMov()" OnEnter="TipoMov()"/><br/><tab/>		<inp id="tipo_movto" clr="64,64,64"  dim="40,1" brdr="0,1" fnt=",16b" modify="N" visible="N" type="string"/><br/>	</grp><sp/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="40,12,7,12" tit="Documento" fnt="Arial,16">		<tab n="3"/><inp id="operacion" clr="64,64,64"  dim="18,1" brdr="0,1" fnt=",18bs" available="N" type="string"/><br/><tab/>				<inp id="foliotxt"  clr="0,58,112"  dim="13,1" brdr="0,1" fnt="Arial,16" available="N" type="string"/>		<edt id="k_folio" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0"	fnt="Arial,16" visible="Y" hk="F"   			tooltip="Folio del movimiento de Carga"   nc="10" OnF9="ObtenerFolio()"  OnChange="Formar_folio()"/><br/><tab/>					<inp id="k_docto" clr="64,64,64"  dim="20,1" brdr="0,1" fnt="Arial,16" available="N" link="k_tipon,5" type="string"/><br/><tab/><txt clr="0,58,112" fnt="Arial,16">Fecha</txt><tab/>		<edt id="k_fecha" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" modify="N" available="Y"/><br/><tab/> 		<img id="k_buscar_folio" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_folio()" 			tooltip="Consultar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		<inp id="statusDoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/>	</grp><br/><br/>					<tab n="1"/>	<grp id="grpDetalle" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5" dim="68,18,7,10" tit="Orden"  fnt="Arial,16" available="Y" modify="Y"><br/>		<tab/><txt id="Orden_txt" clr="0,58,112" visible="Y">Orden</txt><tab/>		<sp/>		<cmb id="k_tipo_orden" clr="64,64,64" clrBrdr="255,255,255" OnChange="BorraDatos()" dim="20,40" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N" visible="Y" available="Y" modify="N"/>		<sp/>		<inp id="k_orden" clr="64,64,64"  dim="20,1" fnt="Arial,16"   OnChange="Orden()"  clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" modify="N" type="capital"/>		<tab n="1"/>		<inp id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="8,1" fnt="Arial,16" type="string" modify="N" available="N"/><sp/>		<inp id="k_nombre" clr="64,64,64" clrBrdr="255,255,255"  dim="33,1" fnt="Arial,16" type="string" modify="N" available="N"/>		<br/>	<br/>						<tab n="1"/><tbl id="tabla_puntos" dim="91,6" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" modify="N" nren="fijo">		<col id="tipo_punto" name="Tipo Punto"/>		<col id="clave_paquete" name="Paquete" visible="N"/>		<col id="clave_campana" name="Campana" visible="N"/>		<col id="trabajo_a_realizar" name="Descripcion"/>		<col id="operario" name="Operario"/>		<col id="estatus" name="Estatus"/>		</tbl> 						</grp>		<sp/>				<grp bclr="236,240,243" fntClrBrdr="236,240,243" id="resumen_ord" unfont="0" fntBrdr="Arial,18"  tit="Resumen de la Orden" clrBrdr="0,58,112" dim="26,18,10,10" brdr="0,5" fnt="Arial,16">			<br/>										<tab n="1"/><txt  fnt="Arial,16,b">Mano de Obra:</txt>	<sp/>					<inp id="mano_obra"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N" nd="2" clrBrdr="255,255,255"/>						<br/>	<tab n="1"/><txt  fnt="Arial,16,b">Refacciones:</txt>	<sp n="2"/>				<inp id="refacciones"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N"  nd="2" clrBrdr="255,255,255"/>						<br/>	<tab n="1"/><txt  fnt="Arial,16,b">TOTs:</txt>	<sp n="7"/>				<inp id="tots"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N" nd="2" clrBrdr="255,255,255"/>						<br/>	<tab n="1"/><txt  fnt="Arial,16,b">Cargos Varios:</txt>	<sp/>				<inp id="cargos_varios"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N"  nd="2" clrBrdr="255,255,255"/>													<br/>	<tab n="1"/><txt  fnt="Arial,16,b">Subtotal:</txt>	<sp n="5"/>				<inp id="subtotal"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N"  nd="2" clrBrdr="255,255,255"/>										<br/>	<tab n="1"/><txt  fnt="Arial,16,b">IVA:</txt>	<sp n="8"/>				<inp id="iva"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255" available="N"  nd="2" clrBrdr="255,255,255"/>										<br/>	<tab n="1"/><txt  fnt="Arial,16,b">Importe:</txt>	<sp n="5"/>				<inp id="importe"  dim="10,1" brdr="2,0" clr="64,64,64" type="number" bclr="255,255,255"  nd="2" available="N"  clrBrdr="255,255,255"/>											</grp>							<br/><br/>	<tab n="1"/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="0" clrBrdr="0,58,112" tit="Refacciones" dim="95,32,7,12" brdr="0,5"  fnt="Arial,16"><tab n="4"/><br/><tab/>				<br/>		<br/>			<tab n="1"/>		<tbl id="k_mov" modify="N" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="130,10"  hk="z" OnChange="" Reorder="N">			<col id="k_parte" name="Art&#237;culo" type="capital" nc="18" modify="N"/>			<col id="k_descr" name="Descripci&#243;n" modify="N"/>			<col id="k_q" name="Cantidad"  type="number" nd="-1" OnChange="Cantidad()"/>			<col id="k_unidad" name="Unidad" modify="N" type="capital"/>			<col id="k_precio" name="Precio"  type="number" OnChange="Cantidad()" nd="2" visible="Y"/>			<col id="k_monto" name="Importe"  type="number" nd="2" min="0" OnChange="Monto()"/>			<col id="k_control" name="Punto"   modify="N" type="number" nd="-1" min="0" OnChange=""/>		</tbl><br/><br/>				<br/>		<grp dim="80,4,7,12" brdr="0,5">			<tab n="2"/><txt clr="0,58,112">Comentarios</txt>			<tab/><inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="70,3" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="N" type="string" available="Y"/>		</grp>		<tab n="8"/>				<grp dim="80,5,7,12" brdr="0,5">			<tab n="1"/><txt>Subtotal</txt><tab n="2"/>			<inp id="subt" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" available="N"/>			<br/>			<tab n="1"/><txt>IVA</txt><tab n="3"/>			<inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="6" modify="N" available="N"/>			<br/>			<tab n="1"/><txt fnt=",16b">IMPORTE</txt><tab/>			<inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="N"/>		</grp>		<br/><br/>		<tab n="37"/>		<grp dim="16,4,7,12" brdr="0,5">			<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/><tab/>			<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Alta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><tab/>			</grp>	</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb, sys, rep;			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc, tip_ope, anio_contable;			var usuario,suc_usuario, rol_usuario,asterisco,refer_orden,nuevo_folio, folio_alta_carga, titulo_pantalla_folios    ;			var especificaciones_doc ;			var monto_total,uen;			var folio;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();				sys=new SYS;				rep=new REP;				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				if(frn.param(0)&= "")				{					frn.message("Esta acci�n no est� permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}				gen_doc=trim(frn.param(0)); 				nat_doc=trim(frn.param(1)); 				gpo_doc=trim(frn.param(2));				tip_doc=1;				fija_doc=trim(frn.param(4));				tip_ope=trim(frn.param(5));				uen=trim(frn.param(6));				if (uen &= ""){					uen="XXX";				}							define_controles();				Inicializa();					}			fun define_controles(){							frn.setAtt("tabla_puntos", "visible", "N", "clave_paquete" );				frn.setAtt("tabla_puntos", "visible", "N", "clave_campana" );					frn.setAtt("Aceptar", "visible" , "N");				frn.setAtt("Cancelar", "visible" , "N");								if (tip_ope &= 0){					frn.set("operacion", "ALTA");					frn.set("foliotxt", "Folio Carga");					nat_doc = "D";					gpo_doc = "7";					titulo_pantalla_folios = "Carga de refacciones";					frn.setAtt("Aceptar", "visible" , "Y");					frn.setAtt("Cancelar", "visible" , "Y");									}								if (tip_ope &= 1){					frn.set("operacion", "CONSULTA");					frn.set("foliotxt", "Folio Descarga");					nat_doc = "A";					gpo_doc = "12";					titulo_pantalla_folios = "Descarga de refacciones";				}			}						fun Inicializa(){				kdb.kde("KDE");//Configuracion del servidor				kdb.exec();				anio_contable = kdb.get("KDE","14");				var cmd, cubo, ok,resValidacion,resMensaje ;				//Valida usuario administrador				kdb.rst();				frn.rst("results");				frn.set("k_hora",sys.time());							//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";								if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR" && rol_usuario &! "Administrador Kepler 8.0" && rol_usuario &! ""){											cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",getXml(cubo));					rstXml(cubo);				cmd = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='A' and c3=12" ;				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Inicializa()");//				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTipoDocto");						ok=getXmlAtt(cubo ,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo ,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error BD","Aceptar");					return;				}				frn.set("k_tipon",getXml(cubo ));				frn.set("k_docto",frn.get("k_tipon",-1,5));								//Llenar combo tipo de precio				cmd = "select c2,c1 from keplersc.kdicatprecio";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);										frn.message(mensajeError,"Error","Aceptar");					return;				}																						LlenarTipoOrden();						}						fun LlenarTipoOrden(){				var cmd,cubo, ok, tip_mov ;				//Llenar combo tipo orden				tip_doc=frn.get("k_tipon",-1,4);				if (tip_doc &= "1"){					cmd = "select '['||c1||'] '||c3 as descripcion, c1 as clave  from keplersc.kdmargen where c1 not in ('C','G')";								}else{					cmd = "select '['||c1||'] '||c3 as descripcion, c1 as clave  from keplersc.kdmargen where c1 in ('C','G')";				}				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);										frn.message(mensajeError,"Error","Aceptar");					return;				}			   var cmd_tipo_orden = "k_tipo_orden";				frn.rst("k_tipo_orden");				llenar_cmb(cubo ,cmd_tipo_orden);							}											fun BorraDatos() {				frn.rst("k_mov");				frn.rst("k_monto");				frn.rst("k_coment");				frn.rst("subt");				frn.rst("k_iva");				frn.rst("k_monto");				//frn.set("k_tipo_orden", "");				frn.set("k_orden", "");							frn.rst("tabla_puntos");				frn.rst("resumen_ord");				frn.rst("mano_obra");				frn.rst("refacciones");				frn.rst("tots");				frn.rst("cargos_varios");				frn.rst("subtotal");				frn.rst("iva");				frn.rst("importe");				frn.rst("k_clave");				frn.rst("k_nombre");					}												fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",nat_doc );				setXml(xmlReqEst,"document","k_tipon","r3", gpo_doc );				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								frn.lib("libGeneral.kpl","FileSave",xmlReqEst,"C:\Basura\xmlReqEstFol");										cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);			}									fun ObtenerFolio(){				BorraDatos();				var cmdQuery;				cmdQuery="select c6 as folio, c9 as fecha, c121 as tipo_orden, c122 as orden "; 								if (nat_doc &= "A"){					cmdQuery = cmdQuery & " , c39 as folio_carga ";				}								cmdQuery = cmdQuery & " , c10 as cliente, c32 as nombre from keplersc.kdm1 where c1='" & 					frn.get("k_sucn",-1,1) & "' and c2='U'  and c3= '" & nat_doc & "' and c4= " & gpo_doc & " and c5='" &  frn.get("k_tipon",-1,4)  & "' and c43<>'C' order by c9 desc, c6 desc ";				frn.dialog("genlistafiltrosel",titulo_pantalla_folios ,cmdQuery,"folio","k_folio","0","","S");									}						fun Buscar_folio() {				BorraDatos();				var cmd, cubo,ok, xmlRequest;				var mensaje = "Folio no encontrado" ;				var suc_id =  frn.get("k_sucn",-1,1);				folio = frn.get("k_folio");				BorraDatos();				LlenarTipoOrden();								cmd = "select c8,c9,c10,c11,c12,c13,c27 from keplersc.kdm2 where c1='" & suc_id & 					"' and c2= 'U' and c3='" & nat_doc  & "' and c4=" & gpo_doc  & " and c5=" & frn.get("k_tipon",-1,4) & " and c6 ='" & folio & "'";									frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdXmlmov_taller");				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"descarga_refacciones.Buscar_folio()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");				var lenght_xml = nXml(cubo); 				if(lenght_xml != 0 ){					for (var i=0;i<lenght_xml;i++) {						var clave_prod =getXmlAtt(cubo,"r"&i,"c8");						var descripcion =getXmlAtt(cubo,"r"&i,"c10");						var cantidad=getXmlAtt(cubo,"r"&i,"c9");						var unidad =getXmlAtt(cubo,"r"&i,"c11");						var precio_unitario =getXmlAtt(cubo,"r"&i,"c12");						var importe_partida=getXmlAtt(cubo,"r"&i,"c13");						var punto=getXmlAtt(cubo,"r"&i,"c27");											frn.setX(clave_prod ,"k_mov",i,"k_parte");						frn.setX(descripcion ,"k_mov",i,"k_descr");						frn.setX(cantidad,"k_mov",i,"k_q");						frn.setX(unidad ,"k_mov",i,"k_unidad");						frn.setX(precio_unitario ,"k_mov",i,"k_precio");						frn.setX(importe_partida,"k_mov",i,"k_monto");						frn.setX(punto,"k_mov",i,"k_control");					}					var campos =" k1.c9,k1.c10,k1.c12,k1.c14,k1.c16,k1.c24,k1.c32,k1.c161,k1.c122,'['||mar.c1||'] '||mar.c3 as tipo_orden, k1.c43 "					cmd = " select " & campos & " from keplersc.kdm1 as k1 inner join keplersc.kdmargen as mar on k1.c121=mar.c1" 					cmd = cmd & " where k1.c1='" & suc_id & "' and k1.c2= 'U' and k1.c3='" & nat_doc & "' and k1.c4=" & gpo_doc  & " and k1.c5=" & frn.get("k_tipon",-1,4) & " and k1.c6=upper('" & folio & "')  ";					frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdXmlmov_taller_2");					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"descarga_refacciones.Buscar_folio()");					ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}										var status_doc = getXmlAtt(cubo,"r"&0,"c43");										if (status_doc &= "C"){						BorraDatos();						frn.message(mensaje ,"Error","Aceptar");						return ;					}					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");					lenght_xml = nXml(cubo); 					if(lenght_xml != 0 ){						//frn.set("k_fecha",getXmlAtt(cubo,"r"&0,"c9"));						frn.set("k_fecha",sys.date());						frn.set("k_clave",getXmlAtt(cubo,"r"&0,"c10"));						frn.set("k_tipo_orden",getXmlAtt(cubo,"r"&0,"tipo_orden"));											frn.set("k_orden",getXmlAtt(cubo,"r"&0,"c122"));						var IVA = getXmlAtt(cubo,"r"&0,"c14");						var MONTO = getXmlAtt(cubo,"r"&0,"c16");						frn.set("subt",MONTO - IVA);						frn.set("k_iva",IVA );						frn.set("k_monto",MONTO );						frn.set("k_coment",getXmlAtt(cubo,"r"&0,"c24"));						frn.set("k_nombre",getXmlAtt(cubo,"r"&0,"c32"));							obtener_puntos();						resumen_orden();					}else {											frn.message(mensaje ,"Error","Aceptar");					}									}else  {									frn.message(mensaje ,"Error","Aceptar");				}			}							fun obtener_puntos(){					var cmd= "select c6 as tipo_punto, c5 as clave_paquete, c50 as clave_campana , c8 as trabajo_a_realizar, c9 as operario,  c7 as estatus  ";			cmd = cmd &	"  from keplersc.kdpun where c1='" & frn.get("k_sucn",-1,1) & "' and c2='" & frn.get("k_tipo_orden", -1, 1) & "' and c3='" & frn.get("k_orden") & "' order by c4";											frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmd ");							var cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"descarga_refacciones.Buscar_folio()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\ordenSelXml");			var ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				var mensajeError = getXmlAtt(cuboResultados,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}						frn.setAtt("tabla_puntos", "visible", "N", "clave_paquete" );			frn.setAtt("tabla_puntos", "visible", "N", "clave_campana" );				var lenght_xml = nXml(cuboResultados );			for (var i=0;i<lenght_xml;i++) {				if ( getXmlAtt(cuboResultados,"r"&i,"clave_campana") &! ""){					frn.setAtt("tabla_puntos", "visible", "Y", "clave_campana" );				}				if ( getXmlAtt(cuboResultados,"r"&i,"clave_paquete") &! ""){					frn.setAtt("tabla_puntos", "visible", "Y", "clave_paquete" );				}			}						frn.setX(cuboResultados,"tabla_puntos");								}								fun Alta(){						var xmlRequest;				var resultado, mensaje, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd;				var partidasValidas = 0;				var orden;				nuevo_folio = "";				var resultado_validaciones = Validaciones_pre_ejecucion();				if (resultado_validaciones == 0 ){					return;				}								xmlRequest = frn.dataPag();					fecha = sys.date();				hora= sys.time();				//cubo = "dat";				kdb.rst();				frn.rst("results");				frn.rst(xmlRequest );				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								xmlRequest = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento y datos adicionales				orden = frn.get("k_orden");				orden = frn.lib("libGeneral.kpl","PadLeft",orden,10,"0");				orden = mid(orden,2,8);							setXml(xmlRequest ,"k_refer",frn.get("k_tipo_orden",-1,1) & " " & orden);				setXml(xmlRequest,"k_natdocto",nat_doc );				setXml(xmlRequest,"k_gpodocto",gpo_doc  );				setXml(xmlRequest,"k_tipodocto",frn.get("k_tipon",-1,4));				setXml(xmlRequest,"k_foliodocto",frn.get("k_folio"));				setXml(xmlRequest ,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlRequest ,"movimiento","fecha",strFecha);				setXml(xmlRequest ,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));				setXml(xmlRequest ,"k_mov","no_partidas",frn.N("k_mov")-1);				setXml(xmlRequest ,"ambiente","anio_contable",anio_contable);				setXml(xmlRequest,"ambiente","uen",uen);						frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");								cmd="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"carga_refacciones.Alta");								resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");								if(resultado &= "1"){					tip_ope = 1;					define_controles();					frn.set("k_folio",mensaje); 										strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);					//ConfiguraCamposOpcion();					//Deshabilita_campos();							nuevo_folio = mensaje;								mensaje = "El Folio utilizado para esta operacion fue: " & nuevo_folio;					frn.message(mensaje, "Mensaje","&Aceptar");				}else{					nuevo_folio = "";					frn.message(mensaje, "Error","&Aceptar");					return;				}								if (nuevo_folio &! ""){					Baja_Refacciones();				}								resumen_orden();			}												fun Validaciones_pre_ejecucion(){				var cubo, cmd,ok;				var suc = frn.get("k_sucn", -1, 1);								folio_alta_carga = frn.get("k_folio");								if (folio_alta_carga &= ""){					frn.message("Debe seleccionar un Folio de Carga","Error","Aceptar");					return 0;				}				for(var i =0;i<frn.N("k_mov");i++){									var num_punto = frn.get("k_mov",i,"k_control");										if (num_punto &= ""){						return 1;					}						cmd = "select c6,c7,c20 from keplersc.kdpun where c1='" & suc & "' and  c2='" & frn.get("k_tipo_orden", -1, 1) & "' and c3='" & frn.get("k_orden") & "' and c4=" &  num_punto ;					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"descarga_refacciones.Validaciones_pre_ejecucion()");									ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}									frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");										var tipo_punto =getXmlAtt(cubo,"r0","c6");					var status_punto =getXmlAtt(cubo,"r0","c7");					var cerrado_en_refacciones =getXmlAtt(cubo,"r0","c20");															if (cerrado_en_refacciones &= "C"){						frn.message("No se pueden eliminar REFACCIONES a un punto que esta cerrado por REFACCIONES","Error","Aceptar");						return 0;					}										if (tipo_punto &= "P" || tipo_punto &= "L"){						frn.message("No se pueden eliminar REFACCIONES a puntos por presupuestar o sin cargo al cliente","Error","Aceptar");						return 0;					}										if (status_punto &= "N" || status_punto &= "P" || status_punto &= "S"){						frn.message("No pueden eliminar REFACCIONES a puntos No autorizados , Suspendidos o Pendientes","Error","Aceptar");						return 0;					}													}						}											fun Baja_Refacciones(){				var xmlRequest,cmd,cubo,ok;				var suc = frn.get("k_sucn", -1, 1);								//Cancela el movimiento de carga 				cmd = "update keplersc.kdm1 set c43='C' where c1='" & suc & "' and  c2='U' and c3='D' and c4=7 and c5=" & frn.get("k_tipon",-1,4) & " and c6='" & folio_alta_carga  & "'";				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultadosrefs");				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"descarga_refacciones.Baja_Refacciones()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												for(var i =0;i<frn.N("k_mov");i++){									var num_punto = frn.get("k_mov",i,"k_control");										if (num_punto &= ""){						return ;					}					cmd = "delete from keplersc.kdref where c1='" & suc & "' and  c2='" & frn.get("k_tipo_orden", -1, 1) & "' and c3='" & frn.get("k_orden") & "' and c4=" &  num_punto & " and c9= '" & folio_alta_carga & "'";					cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"descarga_refacciones.Baja_Refacciones()");									ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}								}										}															fun resumen_orden(){								var xmlRequest, cmd, cubo, ok, mensajeError ;				setXml(xmlRequest,"sucursal_id", frn.get("k_sucn",-1,1));				setXml(xmlRequest,"tipo_orden", frn.get("k_tipo_orden",-1,1));				setXml(xmlRequest, "folio_orden", frn.get("k_orden"));											frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestcerrarorden");				cmd="select * from keplersc.ser_calculos_montos_orden(' <document> " & getXmlStr(xmlRequest,"EOF:13_10") & " </document> ')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcerrarorden.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultadoscerrarorden");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								var cubo_datos;				var strTmp = getXmlAtt(cubo,"r0","ser_calculos_montos_orden");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_datos,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_datos,"C:\Basura\cubo_datos_cerrar_orden");								frn.set("mano_obra", getXml(cubo_datos,"importe_total_horas"));				frn.set("refacciones", getXml(cubo_datos,"importe_total_refs"));				frn.set("tots", getXml(cubo_datos,"importe_total_tots"));				frn.set("cargos_varios", getXml(cubo_datos,"importe_total_car"));				frn.set("subtotal", getXml(cubo_datos,"subtotal"));				frn.set("iva", getXml(cubo_datos,"iva_total"));				frn.set("importe", getXml(cubo_datos,"importe_total"));						}						//extras--------------------------------------------------------------------------------------------------------------------------------					fun TipoMov(){						frn.rst("k_folio");				frn.rst("k_fecha");				frn.set("k_docto",frn.get("k_tipon",-1,5));				tip_ope = frn.get("k_tipon",-1,4);				tip_doc== frn.get("k_tipon",-1,4);				BorraDatos();				LlenarTipoOrden();				if (tip_ope == 0){					Valida_Tipo_Docto();				}			}									fun llenar_cmb(cuboResultados, cmb){				var len_cubo = nXml(cuboResultados);				var pos_ini = frn.N(cmb);				for (var cont=0; cont<len_cubo ; cont++){					var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");					frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);				}				}						fun Valida_Tipo_Docto(){				var resValidacion, resMensaje, cubo, cmd, ok;							//Valida documento vigente				kdb.rst();				cmd= "select * from keplersc.verify_valid_document('" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & frn.get("k_tipon",-1,4) & ")"; //genero text, naturaleza text, grupo integer, tipo_movto integer				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"carga_refacciones.Valida_Tipo_Docto()");				resValidacion= getXml(cubo,"validacion","resultado");				resMensaje = getXml(cubo,"validacion","mensaje");				if(resMensaje &! ""){					frn.message(resMensaje, "Mensaje","&Aceptar");					frn.setPos("k_tipon");				}										}									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci�n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci�n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p�ginas de operacion:Solo si se est� en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver� el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>