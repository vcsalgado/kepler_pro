<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Comisiones Coaches">	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<grp dim="27,15,7,12" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Comisiones Coaches">						<br/><tab/><txt>Sucursal:</txt><sp n="2"/><cmb id="cmb_sucursal" dim="40,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y"/>			      <br/>			     <tab/> <txt>Coach:</txt><sp n="4"/><cmb id="cmb_coach" dim="40,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y"/>			       <br/>			      <tab/><txt id="txt_mes">Mes:</txt>					<sp n="5"/><cmb id="cmb_mes" dim="8,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y"/>					 <tab n="2"/>									<txt id="txt_anio">A&#241;o:</txt>	<sp n="5"/>			      <inp id="anio" dim="8,1" bclr="255,255,255" clr="64,64,64" nc="4" clrBrdr="255,255,255"  type="string" brdr="0,2"/>			        <br/> <br/>			      <tab n="7"/><bot id="bot_ejecutar" dim="15,0" brdr="5" text="Ejecutar" OnEnter="GenerarReporte()" default="1"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys,suc_usuario ,perfil_usuario,asterisco  ;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;								kdb.connect();				kdb.open("s,kdms,i,kdini,c,kdud");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				asterisco = "*";				Inicializa();							}						fun Inicializa(){//Inicializa los valores en Pantalla				IniCombos();				IniParams();//Inicializa parámtros de impresión entre otros				frn.set("ch_incluir","1");			}									fun IniCombos(){				var cmd, cuboQuery, xmlResQuery, ok, mensajeError, strTmp;				cuboQuery="datDoc";										//Llenar combo sucursales								cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (perfil_usuario &! "ADMINISTRADOR"  && perfil_usuario &! "ADMINISTRATOR" && "Administrador Kepler 8.0"){							cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_comisiones_coaches.IniCombos()");								ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("cmb_sucursal",getXml(cuboQuery));								//Llenar combo coaches								cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdcatcoach where c5='" & frn.get("cmb_sucursal",-1,1) & "'";								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\xmlRequestcoaches");				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_comisiones_coaches.IniCombos()");								ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("cmb_coach",getXml(cuboQuery));																			frn.setX("01","cmb_mes",0,0);				frn.setX("02","cmb_mes",1,0);					frn.setX("03","cmb_mes",2,0);					frn.setX("04","cmb_mes",3,0);				frn.setX("05","cmb_mes",4,0);					frn.setX("06","cmb_mes",5,0);					frn.setX("07","cmb_mes",6,0);				frn.setX("08","cmb_mes",7,0);					frn.setX("09","cmb_mes",8,0);					frn.setX("10","cmb_mes",9,0);				frn.setX("11","cmb_mes",10,0);					frn.setX("12","cmb_mes",11,0);								frn.set("anio", sys.date() );						kdb.exec();																	}								fun GenerarReporte(){				var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var cuboResultados, xmlRequest,sqlXmlResultados,xmlCurDocto,xmlCurMovto,cmd,ok,mensaje;				var contordenes, totordenes ;				var fecha_orden , folio_orden, nombre_cli, mano_de_obra, refacciones, tots, cargos_varios, subtotal, iva, total, dias, asesor, flujo_srv;								kdb.kde("KDE");//Configuración del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();				var incluir_salto_pagina= frn.get("salto_de_pagina");								kdb.readPage("datos","rep_comisiones_coachesfto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parámetros finales de impresión.(rep.page(...);)				rep.set("suc_desc",frn.get("cmb_sucursal",-1,0));				rep.set("rep_fecha",fechaImpresion);				rep.set("rep_hora",horaImpresion);				rep.set("coach",	frn.get("cmb_coach",-1,0));												setXml(xmlRequest,"document","sucursal_id",frn.get("cmb_sucursal",-1,1));				setXml(xmlRequest,"document","mes",frn.get("cmb_mes",-1,0));				setXml(xmlRequest,"document","anio",frn.get("anio"));				setXml(xmlRequest,"document","coach",frn.get("cmb_coach",-1,1));								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestcoaches");								cmd="select * from keplersc.rep_comisiones_coaches('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"rep_comisiones_coaches.GenerarReporte()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultadoscoaches");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								cuboResultados= getXmlAtt(cuboResultados,"r0","rep_comisiones_coaches");				cuboResultados= delScpScn(cuboResultados);				setXmlStr(cuboResultados,cuboResultados);								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultadoscoachesXML");									rep.set("fecha_1",getXml(cuboResultados, "fecha_inicial"));				rep.set("fecha_2",getXml(cuboResultados, "fecha_final"));				rep.exe("encabezado");								rep.set("utilidad_bruta_nuevos_sin_pva",getXml(cuboResultados, "utilidad_bruta_autos_nuevos_sin_pva"));				rep.set("utilidad_bruta_seminuevos_sin_pva",getXml(cuboResultados, "utilidad_bruta_autos_seminuevos_sin_pva"));				rep.exe("utilidad_bruta");												var cubo_objetivos = getXml(cuboResultados, "resultados");								frn.lib("libGeneral.kpl","FileSave",cubo_objetivos ,"C:\Basura\cubo_objetivos ");								var totres = nXml(cubo_objetivos);								for (var contres=0; contres<totres ; contres++){								rep.set("desc", getXml(cubo_objetivos, "r" & contres , "desc"));					rep.set("objetivo",getXml(cubo_objetivos, "r" & contres , "objetivo"));					rep.set("real",getXml(cubo_objetivos, "r" & contres , "real"));					rep.set("porcentaje",getXml(cubo_objetivos, "r" & contres , "porcentaje"));					rep.set("bono",getXml(cubo_objetivos, "r" & contres , "bono"));					rep.set("descuento",getXml(cubo_objetivos, "r" & contres , "descuento"));					rep.set("comision",getXml(cubo_objetivos, "r" & contres , "comision"));					rep.exe("datos");								}									rep.set("bonos_total",getXml(cuboResultados, "totales" ,  "total_bonos"));				rep.set("comision_total",getXml(cuboResultados,"totales",  "total_comisiones"));				rep.exe("comision_totales");								rep.win();						}														//-------------------------------------------------extras------------------------------------------------						fun IniParams(){//Inicializa parámetros de impresión, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Página				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}			fun setRepPage() {//Establece los parámetros finales de impresión.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}																											}	</script></pag>