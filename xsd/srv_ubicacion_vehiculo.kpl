<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles=""><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>				<grp id="grpDetalle" bclr="236,240,243" fntClrBrdr="236,240,243"  fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5" dim="30,15,10,10" tit="Ubicaci&#243;n Veh&#237;culo"  fnt="Arial,16" available="Y" modify="Y">		<br/>		<br/>		<tab n="1"/><txt  fnt="Arial,16,b">Identificador:</txt>		<tab n="1"/>				<inp id="vin" dim="12,1" bclr="255,255,255" clr="64,64,64" nc="10"  modify="N" clrBrdr="255,255,255"  type="string" brdr="0,2"/>	<br/><br/>				<tab n="1"/><txt  fnt="Arial,16,b">Ubicaci&#243;n F&#237;sica:</txt>	<sp/>				<inp id="ubicacion" dim="4,1" bclr="255,255,255" clr="64,64,64" nc="1"  modify="N" clrBrdr="255,255,255" OnF9="ubicacion_cat()" type="string" brdr="0,2"/>	<br/>				<br/><br/>			<tab n="3"/><bot id="bot_guardar" dim="10,0" brdr="5" text="Guardar" default="0" OnEnter="guardar()"/>		</grp>					<br/>										</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario ,asterisco, externo, sucursal,identificador ;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("s,KDMS");								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								identificador =trim(frn.param(4));													Inicializa();			}						fun Inicializa(){							var cmd, cubo, ok, mensajeError ;								/*cmd = " select c1 from keplersc.kdoper where c1='" & perfil_usuario & "'";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_ubicacion_vehiculo.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\perfil_usuario");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								if (nXml(cubo) &= "0"){					frn.message("No tienes permisos para acceder a esta opcion","Error","Aceptar");					frn.timer(0,1,"salir()");				}*/								frn.set("vin", identificador );								cmd = " select c11 from keplersc.kdvehqueue where c1='" & identificador & "'";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_ubicacion_vehiculo.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\ubicacion");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("ubicacion", getXmlAtt(cubo,"r0" ,"c11"));						}						fun guardar(){							var cmd, cubo, ok, mensajeError,xmlRequest ;							setXml(xmlRequest,"sucursal_id", sucursal );				setXml(xmlRequest, "vin", identificador );				setXml(xmlRequest,"ubicacion", frn.get("ubicacion"));								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.ubicacion_vehiculo(' <document> " & getXmlStr(xmlRequest,"EOF:13_10") & " </document> ')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_ubicacion_vehiculo.guardar()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var resultado = getXmlAtt(cubo,"r0","resultado");							if(resultado &= "0"){					mensajeError = getXmlAtt(cubo,"r0","mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								if(resultado &= "1"){					var mensaje = getXmlAtt(cubo,"r0","mensaje");					frn.message(mensaje ,"Atencion","Aceptar");					salir();				}												}									fun salir (){							frn.exit();			}										fun ubicacion_cat() {			 				var cmdQuery = "select c1 as identificador,c2 as descripcion from keplersc.kdcatubicacionvehiculo";	                frn.dialog("genlistasel","Ubicaciones",cmdQuery,"identificador","ubicacion","","N");                 }							}	</script></pag>