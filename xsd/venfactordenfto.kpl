<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de " scale="48">	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,16" unfont="0">		<br/>		<tab/><img id="img" dim="10,40" brdr="0,1" img="logocliente.jpg"/>		<tab/>		<txt fnt=",25b" clr="0,58,112">Factura Orden </txt>		<br exe="encabezado"/>		<tab/><hLine dim="35,0"/>		<br exe="encabezado"/>		<tab/>		<br exe="encabezado"/><tab/><txt fnt=",b">Fecha:</txt><sp/>		<inp id="fecha" dim="8,1" type="date" fmt="DD-MM-CCYY" nc="-1" just="R"/>		<inp id="hora" dim="5,1" type="time" nc="-1"/>		<br exe="encabezado"/>		<tab n="2"/>		<br exe="encabezado"/><tab/>		<txt fnt=",b">R.F.C: </txt>		<tab n="2"/>		<inp id="rfc" dim="25,1" type="string"/>		<br exe="detalle"/><tab/>		<txt fnt=",b">Nombre:   </txt><tab/>		<inp id="nombre" dim="25,1" type="string"/>		<br exe="detalle"/><tab/><txt fnt=",b">Direcci&#243;n :</txt><tab/>		<inp id="calle" dim="25,1" type="string"/>		<br exe="detalle"/>		<br exe="detalle"/><tab/><txt fnt=",b">Orden Servicio:  </txt><tab/>		<inp id="num_orden" dim="15,1" type="string"/>		<br exe="detalle"/><tab/>		<txt fnt=",b">Serie y Folio:  </txt><tab/>		<inp id="folio" dim="15,1" type="string"/>		<br exe="detalle"/><tab/>		<txt fnt=",b">Importe Total: </txt><tab/>		<inp id="importe_total" dim="20,1" type="string"/>		<br exe="detalle"/><tab/><txt fnt=",b">Forma Pago:  </txt><tab/>		<inp id="forma_pago" dim="20,1" type="string"/>		<br exe="detalle"/>		<tab n="3"/><txt fnt=",b">VIN:  </txt><tab/>		<inp id="vin" dim="20,1" type="string"/>		<br exe="detalle"/>		<br exe="detalle"/><tab/><txt>Puedes obtener tu factura electr&#243;nica a trav&#233;s </txt>		<br exe="detalle"/><tab/><txt>de nuestro portal:</txt>		<br exe="detalle"/>		<br exe="detalle"/>		<tab n="2"/><img id="img" dim="20,140" brdr="0,1" img="qr_prolecsa_facturacion.jpg"/>		<br exe="detalle"/>					<tab n="2"/>			<txt fnt=",21s"> https://factura.prolecsa.mx</txt>		<br exe="detalle"/>		<br exe="detalle"/><tab/>			<txt fnt=",-1b">NOTA : </txt>		<br exe="detalle"/>		<tab n="2"/><txt fnt=",0">Recuerda que puedes generar tu factura durante </txt>		<br exe="detalle"/>		<tab n="2"/><txt fnt=",0">el mes en curso.</txt>		<br exe="detalle"/>		<br exe="detalle"/><tab/>			<txt fnt=",b">Cajera:</txt>		<inp id="cajera" dim="25,1" type="string"/>		<br exe="detalle"/>		<br exe="linea"/>		<br exe="total"/>	</grp></pag>