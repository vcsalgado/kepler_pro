<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Ventana auxiliar">	<grp dim="1,-1,10,10" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<grp dim="30,7,7,12" dim="48,6,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 			brdr="0,0" fnt="Arial,16" tit="Ventana auxiliar"><txt clr="0,0,0" fnt=",18b">Cerrar ventana para continuar...</txt><br/><br/><tab n="4"/>			<bot id="btmContinuar" dim="15,0" brdr="5" tooltip="Clic para continuar" text="Aceptar" default="1" OnEnter="Salir()"/>		</grp>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys;			var sucursal_id,anio,mes,tipo_poliza,folio_ini,folio_fin,salto_pagina;						fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;				kdb.connect();				Inicializa();				if(sucursal_id &! "" ){					Reporte();				}			}							fun Salir(){				frn.exit();			}						fun Inicializa(){				//Obtiene valores desde parametros.				sucursal_id=frn.param(0);				anio=frn.param(1);				mes=frn.param(2);				tipo_poliza=frn.param(3);				folio_ini=frn.param(4);				folio_fin=frn.param(5);				salto_pagina=frn.param(6);				IniParams();//Inicializa parámtros de impresión entre otros			}						fun IniParams(){//Inicializa parámetros de impresión. Pueden ser cambiados por el usuario final mediante menú: Archivo -> Configurar Página				frn.set("param_paper","custom");	//Tamaño de papel predefinido:	"paper=letter|legal|size"				frn.set("param_sizeX","25.59","param_sizeY","27.94");	//Tamaño de papel personalizado	"size=21.59,27.94cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//Márgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0");	//Escala de impresión (1=100 por ciento)	"F=1,1"				frn.set("param_landscape","N");	//Orientación	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"				frn.set("param_emp","L");	//Posición de "Razón social"(izq,der,cen)	@emp=L|R|C"			}			fun setRepPage() {//Establece los parámetros finales de impresión.				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}									fun Reporte(){//Ejecuta el Reporte				var compania,sucursal_desc,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var cuboResultados, cuboDoctos, cuboMovtos;				var xmlRequest,sqlXmlResultados,xmlCurDocto,xmlCurMovto,cmd,ok,mensaje;				var contpol, totpolizas ;				var poliza,fecha_pol,fecha_mov,suc_desc,doc,desc_mov,polizas,numpolizas,cont;				var cuenta,desc_cuenta,descripcion,refer,cargo_abono,monto;								kdb.kde("KDE");//Configuración del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();								//Obtener saldos totales //				setXml(xmlRequest,"document","sucursal_id",sucursal_id);				setXml(xmlRequest,"document","anio",anio);				setXml(xmlRequest,"document","mes",mes);				setXml(xmlRequest,"document","tipo_poliza",tipo_poliza);				setXml(xmlRequest,"document","poliza_inicial",folio_ini);				setXml(xmlRequest,"document","poliza_final",folio_fin);				setXml(xmlRequest,"document","movimiento","usuario",frn.lib("libKepler","UserInfo"));				cmd="select * from keplersc.cont_rep_poliza('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdXml");												cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"contreppoliza.GenerarReporte()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								kdb.readPage("datos","contreppolizafto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parámetros finales de impresión.(rep.page(...);)								cuboResultados = getXmlAtt(cuboResultados,"r0","cont_rep_poliza");				cuboResultados = delScpScn(cuboResultados);								var xml_nivel_1;				setXmlStr(xml_nivel_1,cuboResultados);				frn.lib("libGeneral.kpl","FileSave",xml_nivel_1,"C:\Basura\xmlcubo");				sucursal_desc=getXml(xml_nivel_1,"document","r0","suc_desc");				rep.set("titulo",compania);				rep.set("rep_suc",sucursal_desc);								rep.set("rep_fecha",fechaImpresion);				rep.set("rep_hora",horaImpresion);				rep.exe("encabezado");																var xml_nivel_2;				xml_nivel_2=getXml(xml_nivel_1, "document");								totpolizas = nXml(xml_nivel_2);								for (contpol=0; contpol<totpolizas ;contpol++){									tipo_poliza = getXml(xml_nivel_2,"r"&contpol, "tipo_poliza");					poliza= getXml(xml_nivel_2,"r"&contpol, "poliza");					fecha_pol= getXml(xml_nivel_2,"r"&contpol, "fecha_pol");					fecha_mov= getXml(xml_nivel_2,"r"&contpol, "fecha_mov");					sucursal_id= getXml(xml_nivel_2,"r"&contpol, "sucursal_id");					suc_desc= getXml(xml_nivel_2,"r"&contpol, "suc_desc");					doc= getXml(xml_nivel_2,"r"&contpol, "doc");					desc_mov= getXml(xml_nivel_2,"r"&contpol, "desc_mov");										if(salto_pagina && "1"){						rep.newPag();						rep.set("titulo",compania);						rep.set("rep_suc",sucursal_desc);										rep.set("rep_fecha",fechaImpresion);						rep.set("rep_hora",horaImpresion);						rep.exe("encabezado");					}										rep.set("tPol",tipo_poliza );					rep.set("nPol",poliza);					rep.set("fecha_pol",fecha_pol);					rep.set("fecha_mov",fecha_mov);					rep.exe("encabezadoPol1");										rep.set("suc_id",sucursal_id);					rep.set("suc_desc",suc_desc);						rep.set("doc",doc);					rep.set("desc_mov",desc_mov);					rep.exe("encabezadoPol2");									polizas = getXml(xml_nivel_2,"r"&contpol, "polizas");						numpolizas = nXml(polizas);										var totcargo = 0;					var totabono = 0;										for (cont=0; cont<numpolizas ;cont++){												cuenta = getXml(polizas ,"r"&cont, "cuenta");						desc_cuenta= getXml(polizas ,"r"&cont, "desc_cuenta");						descripcion= getXml(polizas ,"r"&cont, "descripcion");						refer= getXml(polizas ,"r"&cont, "refer");						cargo_abono= getXml(polizas ,"r"&cont, "cargo_abono");						monto= getXml(polizas ,"r"&cont, "monto");												if (cargo_abono &= "C"){													rep.set("PolClave",cuenta );							rep.set("PolCuenta",desc_cuenta);							rep.set("PolDescr",descripcion);							rep.set("PolRefer",refer);							rep.set("PolDebe",monto);							rep.exe("partPolC");														totcargo = totcargo + monto;																			}else {													rep.set("PolClave2",cuenta );							rep.set("PolCuenta2",desc_cuenta);							rep.set("PolDescr2",descripcion);							rep.set("PolRefer2",refer);							rep.set("PolHaber",monto);							rep.exe("partPolA");														totabono = totabono + monto;								}					}																rep.set("totCargo",totcargo);					rep.set("totAbono",totabono );										if (totcargo != totabono) {											rep.set("poliza_descuadrada","*** POLIZA DESCUADRADA ***");					}					rep.exe("PolTotales");					rep.exe("fin");				}				rep.win();			}		}	</script></pag>