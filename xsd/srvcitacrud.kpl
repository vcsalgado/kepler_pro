="N" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<sp/><txt>No.Ext.:</txt>			<inp id="cliente_ext" dim="4,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N"  brdr="0,2" nd="0" fmt="5"/>			<sp/><txt>No.Int.:</txt>			<inp id="cliente_int" dim="3,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/><br/>			<sp n="2"/><txt>Colonia: </txt>			<inp id="cliente_colonia" dim="30,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255"  modify="N" type="string" brdr="0,2"/>			<sp/><txt>Poblaci&#243;n: </txt>			<inp id="cliente_poblacion" dim="29,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="string"  brdr="0,2"/>			<sp/><txt>Municipio: </txt>			<inp id="cliente_municipio" dim="29,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/>			<br/><sp n="2"/><txt>Estado: </txt>			<inp id="cliente_estado" dim="20,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/>			<sp/><txt>Pais: </txt>			<inp id="cliente_pais" dim="17,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="string" brdr="0,2"/>			<sp n="1"/><txt>C.P.: </txt>			<inp id="cliente_cp" dim="7,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/>			<sp/><txt>Correo electronico: </txt>			<inp id="cliente_correo" dim="40,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="string" brdr="0,2"/>			<br/>			<sp n="2"/><txt>Tel. casa: </txt>			<inp id="cliente_tcasa" dim="17,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/>			<sp/><txt>Tel. movil: </txt>			<inp id="cliente_tmovil" dim="17,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" brdr="0,2"/>			<sp/><txt>RFC: </txt>			<inp id="cliente_rfc" dim="17,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/>			<sp/><txt>Tel. oficina: </txt>			<inp id="cliente_toficina" dim="17,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/>			<sp/><txt>Extension: </txt>			<inp id="cliente_extension" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"  brdr="0,2"/>			<br/>				<sp n="2"/><txt fnt=",bs">Datos del Vehiculo:</txt><br/>			<sp n="2"/><txt>Serie:</txt>			<inp id="serie" dim="21,1" OnChange="bus_cli_vin(serie)" tooltip="Seleccionar F9,Nuevo F10,Modificar F11"  OnF9="obtenerSerie(serie)" OnF10="edicion_vin(Nuevo)" OnF11="edicion_vin(Modificar)" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital"  brdr="0,2" modify="Y"/>			<sp/><txt>Marca:</txt>			<inp id="marca" dim="8,1" tooltip="Seleccionar F9"   modify="N" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<sp/><txt>Modelo:</txt>			<inp id="modelo" dim="9,1" tooltip="Seleccionar F9"   modify="N" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string"  brdr="0,2"/>			<sp/><txt>Kms:</txt>			<inp id="kms" dim="9,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<sp/><txt>A&#241;o:</txt>			<inp id="anio" dim="4,1" nc="4" bclr="192,205,213" modify="N" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<sp/><txt>Color:</txt>			<inp id="color" dim="12,1" bclr="192,205,213" modify="N" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<sp/><txt>Placas:</txt>			<inp id="placas" dim="9,1" bclr="192,205,213" modify="N" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<sp/><txt>Cod:</txt>			<inp id="codigo" dim="10,1" bclr="192,205,213" modify="N"  clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<br/>						</grp>			</grp>		</grp>		<br/>				<tab n="2"/><grp  bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="0" clrBrdr="0,58,95" dim="135,35,7,12" brdr="0,5"  fnt="Arial,16"><tab/>		<txt fnt=",bs">Puntos:</txt>		<br/>		<sp n="2"/>		<tbl id="tabla_puntos" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="130,9"  hk="z" OnChange="" Reorder="N" modify="Y" available="Y">		<col id="tipo_punto" name="Tipo de Punto" visible="N" OnChange="calc_importe()" OnF9="tipo_punto()" OnF10="Dialog(3,detalles_paquete)"  OnF11="Dialog(3,detalles_ref)" nc="1" modify="N" type="capital"/>		<col id="desc_punto" name="Tipo de Punto" OnF9="ObtenerTipoPunto()" OnF10="Dialog(3,detalles_paquete)"  OnF11="Dialog(3,detalles_ref)" modify="Y" type="capital" OnChange="valTipo_punto()"/>		<col id="tipo_operario" OnF9="Dialog(3,tipo_operario)"  visible="N" OnChange="borra_operarios(-1)" modify="N" OnF10="Dialog(3,detalles_paquete)" OnF11="Dialog(3,detalles_ref)"  name="Tipo de Operario"/>		<col id="desc_operario" OnF9="ObtenerTipoOperario()"		modify="Y" OnF10="Dialog(3,detalles_paquete)" OnF11="Dialog(3,detalles_ref)" type="capital" name="Tipo de Operario" OnChange="valTipo_operario()"/>		<col id="clave_paquete" OnF9="catalogo_paquetes()" OnF10="Dialog(3,detalles_paquete)" OnChange="ValPaquete()" OnF11="Dialog(3,detalles_ref)"  name="Paquete"  modify="Y" visible="Y" type="capital"/>		<col id="trabajo_a_realizar" name="Descripcion" OnF10="Dialog(3,detalles_paquete)"  OnF11="Dialog(3,detalles_ref)"  modify="Y" type="capital"/>		<col id="clave_campana" OnF9="catalogo_campanas()" OnF10="Dialog(3,detalles_paquete)" OnF11="Dialog(3,detalles_ref)" OnChange="campanas()" name="Campa&#241;a"  modify="N" visible="N"/>		<col id="horas" name="Horas" OnChange="" OnF10="Dialog(3,detalles_paquete)" OnF11="Dialog(3,detalles_ref)" type="number" visible="Y"/>		<col id="precio_punto" name="Precio"  OnF10="Dialog(3,detalles_paquete)"  OnF11="Dialog(3,detalles_ref)" modify="N" type="number" visible="Y"/>		<col id="clave_operario" OnChange="Ope_insert()"  visible="N"  modify="N" OnF10="Dialog(3,detalles_paquete)" OnF11="Dialog(3,detalles_ref)"  name="Operario"/>		<col id="clave_operario_desc" OnF9="Operadores()" OnChange="ValOperario()" modify="Y" OnF10="Dialog(3,detalles_paquete)" OnF11="Dialog(3,detalles_ref)" type="capital" name="Operario"/>		<col id="horario_inicio"  OnF10="Dialog(3,detalles_paquete)" OnF11="Dialog(3,detalles_ref)" type="time"  name="Inicio"/>		<col id="horario_fin"   OnF10="Dialog(3,detalles_paquete)" OnF11="Dialog(3,detalles_ref)"  type="time" name="  Fin"/>	</tbl>	<br/>		<sp n="2"/><grp dim="72,30,7,12" fnt="Arial,16" hSpace="4">					<sp/><txt fnt=",bs">Sintomas:</txt>			<br/>			<tbl id="tabla_sintomas" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="72,8"  hk="z" OnChange="" Reorder="N" modify="Y" available="Y">			<col id="tipo_sintoma" name="Tipo de Sintoma" OnF9="ObtenerTipoSintoma()" modify="Y"  OnChange="valTipo_sintomas()" type="capital" OnActive="consulta_comentarios()"/>			<col id="clave_sintoma"  modify="Y" OnF9="ObtenerCveSintoma()" OnChange="valCve_sintomas()" name="Clave" type="capital" OnActive="consulta_comentarios()"/>			<col id="desc_sintoma"  modify="N"  name="Descripcion" OnActive="consulta_comentarios()"/>			<col id="punto_sintoma"   name="Punto" type="number"  nc="2" modify="Y" OnActive="consulta_comentarios()"/>			<col id="cmnts_sintoma"  name="Comentarios" modify="N" type="capital" OnActive="consulta_comentarios()"/>			<col id="partida_sintoma"   name="Partida" type="number" visible="N" modify="N" OnActive="consulta_comentarios()"/>			</tbl>			<br/>			<txt>Comentarios Punto:</txt><sp/>			<inp id="puntorel_sintoma"  dim="3,1" fnt="Arial,16" visible="S" available="N" type="string"/>			<txt>Sintoma:</txt><sp/>			<inp id="rel_sintoma"  dim="35,1" fnt="Arial,16" visible="S" available="N" type="string"/>			<br/>			<inp id="comentarios_sintomas" dim="67,2" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="300"/>			<sp/><img id="img" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_60_DocNew.png" OnEnter="acepta_comentario()" tooltip="Aceptar comentario"/>			<br/>			<sp/><bot id="limpiar_pantalla" dim="15,0" brdr="5" OnEnter="borrar_datos()"  text="Limpiar Pantalla" default="0"/>			<tab n="1"/><bot id="cancelar_cita" dim="20,0" brdr="5" OnEnter="Alta(cancelar)"  text="CANCELAR CITA" default="0" visible="Y"/>				</grp>				<tab n="1"/>		<grp dim="55,30,7,12" fnt="Arial,16" hSpace="4">				<sp/><txt>Subtotal</txt><tab n="3"/>				<inp id="subt" clr="64,64,64"  dim="12,1" fnt="Arial,16" type="number" nd="2" available="N"/>				<br/>				<sp/><txt>IVA</txt><tab n="3"/>				<inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/>				<tab n="1"/><txt clr="0,58,112">Fecha Sugerida de Entrega:</txt>				<br/>				<sp/><txt fnt=",16b">IMPORTE</txt><tab/>				<inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="192,205,213" brdr="0,2" type="number" nd="2" modify="N"/>				<tab n="1"/>							<edt id="posible_fecha_entrega" dim="12,1"  fmt="DD/MM/CCYY" modify="N" page="_ks_fecha,posible_fecha_entrega" OnF9="Dialog(3,_ks_fecha,posible_fecha_entrega)"  bclr="192,205,213" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2"/>				<sp/><inp id="posible_hora_entrega" clr="64,64,64" clrBrdr="255,255,255" nc="5" dim="10,1" bclr="192,205,213" brdr="0,2" fnt="Arial,16" type="text" modify="N" available="Y"/>				<br/>				<txt clr="0,58,112">Observaciones</txt><br/>				<inp id="observaciones" clr="64,64,64" clrBrdr="255,255,255"  dim="60,3" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" type="capital" available="Y"/>								<br/>							<tab n="4"/><bot id="bot_control_citas" dim="18,0" brdr="5" text="Control de Citas" default="0" OnEnter="control_de_citas()" clr="0,0,0"/>			<sp/><bot id="bot_horarios" dim="14,0" OnEnter="MostrarHorarios()" brdr="5" text="Horarios Disp" default="0" OnChange="" clr="0,0,0"/>										<br/>			<tab n="1"/><bot id="bot_historial" dim="14,0" brdr="5" text="Historial" default="0" OnEnter="MostrarHistOrdenes()" clr="0,0,0"/>			<tab n="1"/>	<bot id="bot_campanas" dim="16,0" brdr="5" text="Campa&#241;as" OnEnter="MostrarCampanas()" default="0" clr="0,0,0" fnt="," bclr="237,238,239"/>			<tab n="1"/><bot id="bot_recomendaciones" dim="17,0" brdr="5" text="Recomendaciones" default="0" OnEnter="MostrarRecomendaciones()" clr="0,0,0" fnt=","/><br/><br/><tab n="11"/>			<bot id="Aceptar" dim="20,0" brdr="5"  OnEnter="Alta()"  text="GUARDAR CITA" default="0" visible="Y"/><sp/>		<br/>			</grp>	</grp><br/><br/></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb, sys, rep, frP;			var tip_ope,suc_usuario,modulo_origen,folio_cit, no_show, perfil_usuario,asterisco,cli,vn,rol_usuario;			var hora_limite_semana,hora_limite_sabado,hora_limite_domingo ,usuario,folio_tmkt,horas_P,horas_H,horas_G,horas_I,horas_L,horas_Q,horas_F,horas_R  ;			var folio , num_recomendaciones , num_campanas, kodawari,historial_consultado ,campanas_consultado ,recomendaciones_consultado, costo_por_mano , iva, msg_activo, cons_ifz, cons_BP;			var esquema_recepcion;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();				sys=new SYS;				rep=new REP;				frP=new FRNTP;			   usuario = frn.config("user","name");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				rol_usuario = frn.config("user","role");				asterisco = "*";				msg_activo = 0;				//PARAMETROS				tip_ope=trim(frn.param(0));				folio_tmkt=trim(frn.param(1));								if( trim(frn.param(2)) &! "" ){						suc_usuario=trim(frn.param(2));				}								modulo_origen=trim(frn.param(3));				folio_cit=trim(frn.param(4));				no_show =trim(frn.param(5));								cons_ifz = "0";					//MSS 04022026 Ifz campanas				cons_BP = "0";						//MSS 04022026 Ifz campanas				historial_consultado = "0";				campanas_consultado = "0";				recomendaciones_consultado = "0";				num_recomendaciones = 0;				num_campanas = 0;						ctrls_off();				Inicializa();							}					fun ctrls_off() {							frn.setAtt("cancelar_cita", "visible", "N" );				frn.setAtt("Aceptar", "visible", "N" );				frn.setAtt("Cita_txt", "visible", "N" );				frn.setAtt("Cve_TMKT", "available", "N" );				frn.setAtt("buscadores", "visible", "N" );				frn.setAtt("folio_cita", "visible", "N" );				frn.setAtt("buscar_datos", "visible", "N" );				frn.setAtt("fecha_confirmacion", "modify", "N" );				frn.setAtt("hora_confirmacion", "modify", "N" );				frn.setAtt("txt_confirmo", "visible", "N" );				frn.setAtt("fecha_conf", "visible", "N" );				frn.setAtt("fecha_confirmacion", "visible", "N" );				frn.setAtt("hora_conf", "visible", "N" );				frn.setAtt("hora_confirmacion", "visible", "N" );				frn.setAtt("confirmo", "visible", "N" );				frn.setAtt("persona_confirmo", "visible", "N" );					frn.setAtt("vin_txt", "visible", "N" );				frn.setAtt("vin", "visible", "N" );				frn.setAtt("placas_bus_txt", "visible", "N" );				frn.setAtt("placas_bus", "visible", "N" );				frn.setAtt("clave_cliente_txt", "visible", "N" );				frn.setAtt("clave_cliente", "visible", "N" );								frn.setAtt("txt_folio_cita", "visible", "N" );				frn.setAtt("fol_cita", "visible", "N" );				botones_colores();														frn.setAtt("cliente_id", "modify", "N" );				frn.setAtt("serie", "modify", "N" );						if (tip_ope == 0){					botones_alta();				}else{					botones_modificar();				}						}						fun botones_colores(){				//MSS 05112025 Ajustes conf botones Campanas-Ifz				frn.setAtt("bot_campanas", "bclr", "237,238,239");				frn.setAtt("bot_campanas", "clr", "0,0,0" );				frn.setAtt("bot_campanas", "fnt",",");				frn.setAtt("bot_recomendaciones", "clr", "0,0,0" );				frn.setAtt("bot_recomendaciones", "fnt",",");				frn.setAtt("bot_historial", "clr", "0,0,0" );				frn.setAtt("bot_horarios", "clr", "0,0,0" );			}						fun botones_alta(){				frn.setAtt("Aceptar", "visible", "Y" );				frn.setAtt("Cancelar", "visible", "Y" );				frn.set("tit_text", " Alta Cita");				frn.setAtt("bot_recoleccion","visible","N");			}						fun botones_modificar(){							frn.setAtt("Aceptar", "visible", "Y" );				frn.setAtt("cancelar_cita", "visible", "Y" );				frn.setAtt("Cita_txt", "visible", "Y" );				frn.setAtt("buscadores", "visible", "Y" );				frn.setAtt("folio_cita", "visible", "Y" );				frn.setAtt("fecha_conf", "visible", "Y" );				frn.setAtt("fecha_confirmacion", "visible", "Y" );				frn.setAtt("hora_conf", "visible", "Y" );				frn.setAtt("hora_confirmacion", "visible", "Y" );				frn.setAtt("confirmo", "visible", "Y" );				frn.setAtt("persona_confirmo", "visible", "Y" );				frn.setAtt("txt_confirmo", "visible", "Y" );				frn.setAtt("Cve_TMKT", "available", "Y" );				frn.setAtt("txt_folio_cita", "visible", "Y" );				frn.setAtt("fol_cita", "visible", "Y" );								if (modulo_origen &! "T"){					frn.setAtt("buscar_datos", "visible", "Y" );				}					frn.setAtt("vin_txt", "visible", "Y" );				frn.setAtt("vin", "visible", "Y" );				frn.setAtt("placas_bus_txt", "visible", "Y" );				frn.setAtt("placas_bus", "visible", "Y" );				frn.setAtt("clave_cliente_txt", "visible", "Y" );				frn.setAtt("clave_cliente", "visible", "Y" );								frn.setAtt("cliente_id", "modify", "Y" );				frn.setAtt("serie", "modify", "Y" );				frn.set("tit_text", " Modificacion Cita");				if (frn.get("cmb_tipo_servicio",-1,1) &= "R"){						frn.setAtt("bot_recoleccion","visible","Y");				} else{					frn.setAtt("bot_recoleccion","visible","N");				}			}						fun bloquear_modificacion{				frn.setAtt("Aceptar", "visible", "N" );				frn.setAtt("cancelar_cita", "visible", "N" );			}					fun Inicializa(){				kdb.kde("KDE");//						kdb.exec();							var cmd, cubo, ok,mensajeError,valor ;							//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));				frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));						//obtener cli y vin con folio_tmkt				if ( folio_tmkt &! ""){					cmd = "select c14 as vin ,c20 as clave_cliente from keplersc.kdtmktser2 where c1='" & frn.get("k_sucN" , -1, 1) & "' and c2='" & folio_tmkt & "'";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.bus_cli_vin()");					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubocita_encontrada");										ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					vn = getXmlAtt(cubo , "r0", "vin");					cli = getXmlAtt(cubo , "r0", "clave_cliente");				}							//Llenar combo cve_tmkt				cmd = "select '['||c1||'] '||c2 as descripcion, c1 as clave from keplersc.kdsercattmkt";					      				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						   var cmd_tmkt = "Cve_TMKT";			   			   frn.setX("", cmd_tmkt , 0 ,0);				llenar_cmb(cubo ,cmd_tmkt );					frn.set("Cve_TMKT",descr_combo("Cve_TMKT",1,usuario ));									//Llenar combo recepcionista				cmd = "select '['||c1||'] '||c2 as descripcion, c1 as clave from keplersc.kdrecep";								if  (tip_ope == 0){					cmd = cmd & " where c11='S' ";				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						   var cmd_recepcionista = "recepcionista";			   			   frn.setX("", cmd_recepcionista , 0 ,0);				llenar_cmb(cubo ,cmd_recepcionista );				frn.set("fecha_captura",sys.date());				frn.set("hora_captura_cita",sys.time());									//Llenar combo tipo cita				cmd = "select c1||' - '||c2 as descripcion, c1 as clave  from keplersc.kdcatcitasordenes";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						   var cmd_tipo_cita = "tipo_cita";				llenar_cmb(cubo ,cmd_tipo_cita );				frn.set(cmd_tipo_cita ,descr_combo(cmd_tipo_cita ,1,"T"));											//Llenar combo tipo_cita_bus				cmd = "select c1 from keplersc.kdcatcitasordenes";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}					frn.set("tipo_cita_bus",cubo);				frn.set("tipo_cita_bus","T");								//Llenar combo tipo de servicio				frn.setX("","cmb_tipo_servicio",0,0);				frn.setX("","cmb_tipo_servicio",0,1);				frn.setX("RECOLECCION","cmb_tipo_servicio",1,0);				frn.setX("R","cmb_tipo_servicio",1,1);				frn.setX("SERVICIO DOMICILIO","cmb_tipo_servicio",2,0);				frn.setX("D","cmb_tipo_servicio",2,1);				frn.setX("MANTENIMIENTO EXPRESS","cmb_tipo_servicio",3,0);				frn.setX("E","cmb_tipo_servicio",3,1);								//Llenar combo ubicacion de servicio				cmd = "select '['||clave||'] '||descripcion as descripcion, clave " &					"from keplersc.kdsercatubica ubi " &					"inner join keplersc.kdcfdconfig cfd on cfd.c7=ubi.concesionario and cfd.c1='" & frn.get("k_sucN",-1,1) &					"' order by ubi.clave";						cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.setX("","cmb_ubica_servicio", 0 ,0);				llenar_cmb(cubo,"cmb_ubica_servicio");				//horas				cmd = "select c26,c27,c28,c29,c11,c30,c10,c31,c32,c33,c34 from keplersc.kdserconfctas"; //where c=sucursal				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_hrs   ");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								//horas por tipo de punto				horas_P = getXmlAtt(cubo,"r0" ,"c26");				horas_H = getXmlAtt(cubo,"r0" ,"c27");				horas_G = getXmlAtt(cubo,"r0" ,"c28");				horas_I = getXmlAtt(cubo,"r0" ,"c29");				horas_L = getXmlAtt(cubo,"r0" ,"c11");				horas_Q = getXmlAtt(cubo,"r0" ,"c30");				horas_F = getXmlAtt(cubo,"r0" ,"c10");								horas_R = getXmlAtt(cubo,"r0" ,"c34");								//horas limites 				hora_limite_semana = getXmlAtt(cubo,"r0" ,"c31");				hora_limite_sabado = getXmlAtt(cubo,"r0" ,"c32");				hora_limite_domingo = getXmlAtt(cubo,"r0" ,"c33");				if (tip_ope == 0 ){					frn.set("fecha_cita",fnDate("add", sys.date(), "1"));					frn.set("hora_cita","09:00");					Llena_cmbpromocion();					bus_cli_vin("alta");				}								cambio_cita();								if (tip_ope == 1 && modulo_origen &= "T"){					frn.set("folio_cita", folio_cit);					buscar_datos();				}				if (tip_ope == 0 && modulo_origen &= "T" && folio_cit &! "" && no_show &= "si"){					frn.set("folio_cita", folio_cit);					buscar_datos();					frn.rst("fecha_cita");					frn.rst("hora_cita");					frn.rst("fecha_entrega");					frn.rst("hora_entrega");					frn.rst("fecha_confirmacion");					frn.rst("hora_confirmacion");				}							//obtener kodawari				cmd = "select c9 from keplersc.kdconftaller where c2='" & frn.get("k_sucN" , -1, 1) & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_kodawari  ");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								kodawari = getXmlAtt(cubo,"r0" ,"c9");				if (tip_ope == 1){					if (frn.get("cmb_tipo_servicio",-1,1) &= "R"){							frn.setAtt("bot_recoleccion","visible","Y");					} else{						frn.setAtt("bot_recoleccion","visible","N");					}				}								//Obtener esquema de recepcion				cmd = "select count(*) as valor from keplersc.param_oper where sucursal ='00' and parametro='esquema horas recepcion'";				rstXml(cubo);				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				valor=getXmlAtt(cubo,"r0","valor");				if(valor!=0){					cmd = "select valor from keplersc.param_oper where sucursal ='00' and parametro='esquema horas recepcion'";					rstXml(cubo);					cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.inicializa()");					ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					valor=getXmlAtt(cubo,"r0","valor");				}else{ //Utilziar default					valor=15;				} 				esquema_recepcion=valor;			}						fun buscar_datos(){							var xmlRequest,cmd,ok,cubo,mensajeError,strTmp,cubo_cli_vin, cubo_cli ,cubo_cita, cubo_pun, cubo_sin ,xmlRes ,tot;								setXml(xmlRequest,"document","folio_cita", frn.get("folio_cita"));				setXml(xmlRequest,"document","tipo_cita", frn.get("tipo_cita_bus"));				setXml(xmlRequest,"document","vin",frn.get("vin"));				setXml(xmlRequest,"document","placas",frn.get("placas_bus"));				setXml(xmlRequest,"document","clave_cliente",frn.get("clave_cliente"));				setXml(xmlRequest,"document","sucursal_id",frn.get("k_sucN", -1, 1));								borrar_datos();								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.datos_cita_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								//inserta regitros				strTmp = getXmlAtt(cubo,"r0","datos_cli_vin");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_cli_vin,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_cli_vin,"C:\Basura\cubo_cli_vin ");						xmlRes= getXmlX(cubo_cli_vin,3,0);				frn.setX(xmlRes);					rstXml(strTmp);				rstXml(xmlRes);								strTmp = getXmlAtt(cubo,"r0","datos_cita");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_cita   ,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_cita   ,"C:\Basura\cubo_cita   ");						xmlRes= getXmlX(cubo_cita,3,0);				frn.lib("libGeneral.kpl","FileSave",xmlRes,"C:\Basura\xmlRes ");				frn.setX(xmlRes);									var tmkt_clave  = getXml(xmlRes, "cve_tmkt");				frn.set("Cve_TMKT",descr_combo("Cve_TMKT",1,tmkt_clave));					var tipo_cita = getXml(xmlRes, "tipo_cita");				frn.set("tipo_cita",descr_combo("tipo_cita",1,tipo_cita ));					var recepcionista = getXml(xmlRes, "recepcionista");				frn.set("recepcionista",descr_combo("recepcionista",1,recepcionista ));					var tipo_servicio = getXml(xmlRes, "cmb_tipo_servicio");				frn.set("cmb_tipo_servicio",descr_combo("cmb_tipo_servicio",1,tipo_servicio));				var ubica_servicio = getXml(xmlRes, "cmb_ubica_servicio");				frn.set("cmb_ubica_servicio",descr_combo("cmb_ubica_servicio",1,ubica_servicio));				if (frn.get("cmb_tipo_servicio",-1,1) &= "R"){						frn.setAtt("bot_recoleccion","visible","Y");				} else{					frn.setAtt("bot_recoleccion","visible","N");				}				var promocion = getXml(xmlRes, "cmb_promocion");				frn.set("promocion",promocion);								var estatus_cita = getXml(xmlRes, "estatus_cita");				if (estatus_cita == 20){					cons_ifz = "1";					//MSS 04022026 Ifz campanas -No solicitar consulta de Ifz a BP					frn.message("La cita ya esta concretada a una orden, imposible modificar","Error","Aceptar");					bloquear_modificacion();				}else if (estatus_cita == 30){					cons_ifz = "1";					//MSS 04022026 Ifz campanas -No solicitar consulta de Ifz a BP					frn.message("La cita fue reprogramada, imposible modificar","Error","Aceptar");					bloquear_modificacion();				}else if (estatus_cita == 40){					cons_ifz = "1";					//MSS 04022026 Ifz campanas -No solicitar consulta de Ifz a BP					frn.message("La cita fue cancelada, imposible modificar","Error","Aceptar");					bloquear_modificacion();				}else if (estatus_cita != 50){					cons_ifz = "0";					//MSS 04022026 Ifz campanas -Solicitar consulta de Ifz a BP					botones_modificar();				}												cambio_cita();				//inserta regitros de puntos				rstXml(strTmp);				rstXml(xmlRes);				strTmp = getXmlAtt(cubo,"r0","datos_puntos");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_pun,strTmp);				frn.lib("libGeneral.kpl","FileSave",cubo_pun,"C:\Basura\cubo_pun  ");				frn.setX(cubo_pun, "tabla_puntos");													//inserta regitros de sintomas				rstXml(strTmp);				rstXml(xmlRes);				strTmp = getXmlAtt(cubo,"r0","datos_sintomas");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_sin ,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_sin ,"C:\Basura\cubo_sin   ");				frn.setX(cubo_sin ,"tabla_sintomas");									calc_importe();				//MSS 04112025 Interfaz campanas				if (InterfazCampanas() &= "S"){					verifica_ifz_bp_campanas_vin();				}else{						verifica_campanas_recomen();					}							carga_comentarios(cubo_sin);				frn.set("cmb_promocion",descr_combo("cmb_promocion",1,frn.get("promocion")));			}			fun carga_comentarios(cubo){				var comentario,renglones,ncubo,pto_sin,par_sin,cubo_pto,cubo_par,xmlRow;				renglones = frn.N("tabla_sintomas");				ncubo= nXml(cubo);				for (var i=0; i<renglones; i++) {					pto_sin = frn.get("tabla_sintomas",i,"punto_sintoma");					par_sin = frn.get("tabla_sintomas",i,"partida_sintoma");					for(var j=0;j<ncubo;j++){						xmlRow = getXmlX(cubo,3,j);						cubo_pto = getXml(xmlRow,"punto_sintoma");						cubo_par = getXml(xmlRow,"partida_sintoma");						comentario=getXml(xmlRow,"cmnts_sintoma");						if (cubo_pto &= pto_sin && cubo_par &= par_sin){							frn.setX(comentario,"tabla_sintomas",i,"cmnts_sintoma");						}					}				}			}			fun consulta_comentarios(){				frn.set("comentarios_sintomas",frn.get("tabla_sintomas",-1,"cmnts_sintoma"));				frn.set("puntorel_sintoma",frn.get("tabla_sintomas",-1,"punto_sintoma"));				frn.set("rel_sintoma",frn.get("tabla_sintomas",-1,"desc_sintoma"));			}			fun acepta_comentario(){				if (frn.get("puntorel_sintoma") &="" || frn.get("rel_sintoma")&=""){					frn.message("Falta especificar el punto y/o la descripcion del sintoma","Atencion","Aceptar");					return;				} else{					frn.setX(frn.get("comentarios_sintomas"),"tabla_sintomas",-1,"cmnts_sintoma");				}				}									fun cambio_cita(){				borrar_tablas();								var t_cita = frn.get("tipo_cita", -1, 1);								frn.setAtt("tabla_puntos", "visible", "Y" , "clave_paquete" );				frn.setAtt("tabla_puntos", "visible", "Y" , "horas" );				frn.setAtt("tabla_puntos", "visible", "Y" , "precio_punto" );					frn.setAtt("tabla_puntos", "visible", "Y" , "clave_campana" );				frn.setAtt("tabla_puntos", "modify", "Y" , "trabajo_a_realizar" );				if (t_cita &= "C" || t_cita &= "D" || t_cita &= "E" || t_cita &= "G" || t_cita &= "H" || t_cita &= "R" || t_cita &= "I" || t_cita &= "P" || t_cita &= "M"){ //MSS 14112025 Considerar mismo procedimiento de las ordenes G a las M					frn.setAtt("tabla_puntos", "visible", "N" , "clave_paquete" );				}				if (t_cita &= "C"){		//MSS 14112025 Agregar manejo de campanas para ordenes de garantia G o M					frn.setAtt("tabla_puntos", "visible", "N" , "horas" );					frn.setAtt("tabla_puntos", "visible", "N" , "precio_punto" );				}else{					if (t_cita &= "G" || t_cita &= "M"){						frn.setAtt("tabla_puntos", "visible", "Y" , "clave_campana" );					}else{						frn.setAtt("tabla_puntos", "visible", "N" , "clave_campana" ); 					}				}				//obtener costo por mano de obra para cita				var cmd = "select c4 as costo_por_mano, c11 as iva from keplersc.kdmargen where c1='" & t_cita  & "'";				var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_resultados   ");							var ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									costo_por_mano = getXmlAtt(cubo,"r0","costo_por_mano");				iva = 1+(getXmlAtt(cubo,"r0","iva")/100);							}													fun horas_puntos(i){							var tipo_punto =  frn.get("tabla_puntos", i, "tipo_punto" );				var hrs = frn.get("tabla_puntos",-1,"horas");								if (hrs &= "" || hrs <= 0 ){									if (tipo_punto &= "P" ){							frn.setX(horas_P ,"tabla_puntos", i , "horas");					}					if (tipo_punto &= "H" ){							frn.setX(horas_H ,"tabla_puntos", i , "horas");					}					if (tipo_punto &= "G" ){							frn.setX(horas_G ,"tabla_puntos", i , "horas");					}					if (tipo_punto &= "I" ){							frn.setX(horas_I ,"tabla_puntos", i , "horas");					}					if (tipo_punto &= "L" ){							frn.setX(horas_L ,"tabla_puntos", i , "horas");					}					if (tipo_punto &= "Q" ){							frn.setX(horas_Q ,"tabla_puntos", i , "horas");					}					if (tipo_punto &= "F" ){							frn.setX(horas_F ,"tabla_puntos", i , "horas");					}					if (tipo_punto &= "R" ){							frn.setX(horas_R ,"tabla_puntos", i , "horas");					}									}						}			fun calc_importe(origen)	{							var cmd,cubo,ok, mensajeError;				var importe_final = 0;					for (var i=0,n=frn.N("tabla_puntos")-1;i<n;i++) {										var tipo_punto = frn.get("tabla_puntos",i,"tipo_punto");										if (tipo_punto &! "S" && tipo_punto &! "" ){										//un punto diferente a S no puede tener un paquete						if (frn.get("tabla_puntos",i,"clave_paquete") &! ""){							frn.setX("","tabla_puntos", i, "clave_paquete");							frn.setX("","tabla_puntos", i, "trabajo_a_realizar");							frn.setX("","tabla_puntos", i, "horas");							frn.setX("","tabla_puntos", i, "precio_punto");						}											horas_puntos(i);													if ( frn.get("tipo_cita", -1, 1) &= "C" || frn.get("tipo_cita", -1, 1) &= "G" || frn.get("tipo_cita", -1, 1) &= "M") {				//MSS 14112025 Considerar mismo procedimiento de las ordenes G a las M							frn.setX(0,"tabla_puntos", i, "precio_punto");							}else{													if (tipo_punto &! "L"){								var precio_punto = 0;								precio_punto = (costo_por_mano * frn.get("tabla_puntos",i,"horas")) * iva;									frn.setX(precio_punto ,"tabla_puntos", i, "precio_punto");							}else{								frn.setX("LAVADO","tabla_puntos", i, "trabajo_a_realizar");								frn.setX(0,"tabla_puntos", i, "precio_punto");							}												}																																	}else{											horas_puntos(i);												if (origen &= "paquete"){													var xmlRequest;													setXml(xmlRequest,"document","marca",frn.get("marca"));							setXml(xmlRequest,"document","modelo ",frn.get("modelo"));							setXml(xmlRequest,"document","paquete",frn.get("tabla_puntos",i,"clave_paquete"));							setXml(xmlRequest,"document","sucursal_id",frn.get("k_sucN", -1, 1));								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");											cmd="select * from keplersc.detalles_paquete('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";							cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.calc_importe()");												frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");											ok=getXmlAtt(cubo,"ok");							if(ok &! "" && !ok){								mensajeError = getXmlAtt(cubo,"native3");								mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);								frn.message(mensajeError,"Error","Aceptar");								return;							}											var cubo_refacciones= getXmlAtt(cubo,"r0" ,"refacciones");													frn.lib("libGeneral.kpl","FileSave",cubo_refacciones,"C:\Basura\cubo_refacciones");							setXmlStr(cubo_refacciones,cubo_refacciones);							var totresults = nXml(cubo_refacciones);											for (var contresults=0; contresults<totresults ;contresults++){												var clave_ref = getXml(cubo_refacciones,"r"&contresults, "clave_ref");								var ctd = getXml(cubo_refacciones,"r"&contresults, "cantidad");								var tot_disponible = getXml(cubo_refacciones,"r"&contresults, "disponibilidad");													if (tot_disponible < ctd ){									frn.message("Refaccion: " & clave_ref & ", No hay suficientes piezas." ,"Error","Aceptar");															}															}							}											}											importe_final = importe_final + frn.get("tabla_puntos",i,"precio_punto");								}							//precios traen iva inculido								frn.set("k_monto",importe_final);				var subtotal = importe_final/iva;				frn.set("subt", subtotal);				var iva_total = importe_final - subtotal;				frn.set("k_iva",iva_total);							posible_entrega();								}					fun borra_operarios(renglon){							frn.setX("","tabla_puntos", renglon, "clave_operario");				frn.setX("","tabla_puntos", renglon, "clave_operario_desc");					frn.setX("","tabla_puntos", renglon, "horario_inicio");					frn.setX("","tabla_puntos", renglon, "horario_fin");												}						fun posible_entrega(origen){									//domigo=0 , sabado=6				var fechaJul=fnDate("julian",frn.get("fecha_cita"));				var semTot=fechaJul/7;				var semInt=math("int",fechaJul/7);				var semDec=semTot-semInt;				var diasExc=math("round",semDec*7,0);								var hrs_necesarias =0;				Llena_cmbpromocion();				for (var i=0,n=frn.N("tabla_puntos")-1;i<n;i++) {					var hrs_por_punto = frn.get("tabla_puntos",i,"horas");					if (hrs_por_punto > 0 ){						hrs_necesarias = hrs_necesarias + hrs_por_punto ;					}				}								var hrs_cita = strSplit(frn.get("hora_cita"),":", 0);				var mins_cita = "." & strSplit(frn.get("hora_cita"),":", 1);				hrs_necesarias = hrs_necesarias + hrs_cita ;				var limite_horas = hora_limite_semana ;				var dias_agregar = 0;							//si es sabado solo se trabaja hasta las 14				if (diasExc == 6){					limite_horas = hora_limite_sabado;				}				//si es domingo no se trabaja 				if (diasExc == 0){					limite_horas = hora_limite_domingo;				}								var unidad_mins = mins_cita * 100 / 60;				hrs_necesarias = hrs_necesarias  + unidad_mins ;								while ( hrs_necesarias > limite_horas ){					hrs_necesarias  = hrs_necesarias - limite_horas ;					hrs_necesarias = 9 + hrs_necesarias;					dias_agregar= dias_agregar + 1;															if (limite_horas &= hora_limite_domingo){						limite_horas = hora_limite_semana ;					}										if (limite_horas &= hora_limite_sabado){						limite_horas = hora_limite_domingo;					}										if ( (diasExc + dias_agregar) == 6 ){						limite_horas = hora_limite_sabado;					}				}							var hrs = strSplit(hrs_necesarias ,".", 0);				unidad_mins =  "." & strSplit(hrs_necesarias ,".", 1);								if (unidad_mins &= ".")	{					unidad_mins = 0;				}							var mins_convertidos  = unidad_mins * .60;							if (mins_convertidos == 0)	{					mins_convertidos = "0" & "0";				}else{					mins_convertidos = strSplit(mins_convertidos ,".", 1);				}				if (strlen(mins_convertidos) == 1 ){					mins_convertidos = mins_convertidos & 0;				}							frn.set("posible_fecha_entrega",fnDate("add", frn.get("fecha_cita"), dias_agregar));				frn.set("posible_hora_entrega", hrs & ":" & mins_convertidos );							}						fun bus_cli_vin(origen){ 							var cmd, cubo, ok, xmlRequest,mensajeError,strTmp,cubo_cli_vin,xmlRes,kms_cta;				var suc = frn.get("k_sucN", -1, 1);							if (origen &! "alta"){					vn = frn.get("serie");					cli = frn.get("cliente_id");					kms_cta  = frn.get("kms");				}								borrar_datos_cli();				borrar_datos_vin();								if (cli &! "" || vn &! ""){					if(origen &= "alta"){						if (cli &! ""){							setXml(xmlRequest,"document","clave_cliente",cli);						}						if (vn &! ""){							setXml(xmlRequest,"document","vin",vn );						}					}else{						if (origen &= "cliente"){							if ( cli &! ""){								setXml(xmlRequest,"document","clave_cliente",cli);								setXml(xmlRequest,"document","vin",vn );							}else{								return ; 							}						}						if (origen &= "serie"){							if (vn &! ""){								setXml(xmlRequest,"document","vin",vn );							}else{								return ; 							}						}					}				 					setXml(xmlRequest,"document","sucursal_id",suc);					frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");									cmd="select * from keplersc.cli_vin_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";					cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.bus_cli_vin()");									frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");									ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}									strTmp = getXmlAtt(cubo,"r0","datos");					strTmp = delScpScn(strTmp);					setXmlStr(cubo_cli_vin,strTmp);									frn.lib("libGeneral.kpl","FileSave",cubo_cli_vin,"C:\Basura\cubo_cli_vin ");							xmlRes= getXmlX(cubo_cli_vin,3,0);					frn.setX(xmlRes);						rstXml(strTmp);					rstXml(xmlRes);					if (origen &! "alta" && vn &= frn.get("serie")){						frn.set("kms",kms_cta);					}					//MSS 04112025 Interfaz campanas					if (InterfazCampanas() &= "S"){						verifica_ifz_bp_campanas_vin();					}else{							verifica_campanas_recomen();						}										Valserievscliente();					}			}			fun Valserievscliente(){				var xmlRequest,cmd,ok,cubo,mensajeError;				if (frn.get("serie") &! "" && frn.get("cliente_id") &!""){					cmd="select count(*) as totReg from keplersc.kdserie " & 						"where c4 = '" & frn.get("serie") & "' and c9='" & frn.get("cliente_id") & "'"; 					cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.Valserievscliente()");					//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");					ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					if (getXmlAtt(cubo,"r0","totReg") &= "0") {						frn.message("El no. de serie no pertenece al cliente. Edite la serie con F11 para modificar","Atencion","Aceptar");						return;					}												}			}									fun verifica_campanas_recomen(){				var cmd, ok,cubo,tot,mensajeError ;				var suc = frn.get("k_sucN", -1, 1);				var VN = frn.get("serie");				if (VN &! ""){					cmd = "select c3 as clave_campana from keplersc.kdsercampana where c2='" & VN & "' and c6='" &  suc & "' and c4=" & 0;					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.verifica_campanas_recomen()");								ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}									frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_campanas");					num_campanas = nXml(cubo);					if (num_campanas != 0){						//MSS 06112025 Solo muestre una vez el mensaje y el color del boton completo						if (msg_activo == 0){							frn.message("El vehiculo tiene campañas por realizar","Anuncio","Aceptar");							msg_activo = 1;						}						frn.setAtt("bot_campanas", "bclr", "89,164,40");						frn.setAtt("bot_campanas", "clr", "255,255,255");						frn.setAtt("bot_campanas", "fnt",",b");					}									//verifica si hay recomendaciones para la unidad					cmd= "select c3 from keplersc.kdpunres where c1='" & suc & "' and c25='" &  VN  & "' and c5<> " & 30 ;					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.verifica_campanas_recomen()");								ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_recomendaciones");					num_recomendaciones = nXml(cubo);					if (num_recomendaciones &! 0){						frn.message("La Serie tiene recomendaciones","Anuncio","Aceptar");						frn.setAtt("bot_recomendaciones", "clr", "120,210,59" );						frn.setAtt("bot_recomendaciones", "fnt",",b");					}								}			}			fun validaciones_pre_ejecucion(){				var xmlRequest,cmd,cubo,ok,mensajeError,promo_sel;				//TODO, mejorar proceso, parte grafica en horarios_disponibles.kpl				/*var suc = frn.get("k_sucN",-1,1);								setXml(xmlRequest,"document","sucursal_id",suc);				setXml(xmlRequest,"document","fecha_cita",frn.get("fecha_cita"));				setXml(xmlRequest,"document","tipo_operacion",tip_ope);				setXml(xmlRequest,"document","folio_cita",frn.get("folio_cita"));								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.tiempos_operarios('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.validaciones_pre_ejecucion()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return 1;				}								var horas_libres = getXmlAtt(cubo,"r0" ,"tiempos_ope");				setXmlStr(horas_libres ,horas_libres);				var tot_oper = nXml(horas_libres);				var hrs_totales_sel = 0;								for (var contope=0; contope<tot_oper ;contope++){									var oper = getXml(horas_libres ,"r"&contope, "oper");					var hrs = getXml(horas_libres ,"r"&contope, "hrs_libres");					var horas_sel = 0;								for (var i=0,n=frn.N("tabla_puntos")-1;i<n;i++){						var oper_sel = frn.get("tabla_puntos",i,"tipo_operario");						if (oper_sel &= oper ){							horas_sel = horas_sel + frn.get("tabla_puntos",i,"horas");						}					}					if (horas_sel > hrs){						mensajeError = "operario " & oper & " no hay suficientes horas libres";						frn.message(mensajeError ,"Error","Aceptar");						return 1;					}										hrs_totales_sel = hrs_totales_sel + horas_sel; 				}								var totales = getXmlAtt(cubo,"r0" ,"totales");				setXmlStr(totales ,totales );								if (hrs_totales_sel > getXml(totales , "total_hrs_libres")){					mensajeError = "No hay suficientes horas libres";					frn.message(mensajeError ,"Error","Aceptar");					return 1;				}*/								promo_sel=frn.get("cmb_promocion",-1,1);				if (promo_sel &!""){					cmd ="select count(*) as totReg " &						"from keplersc.kdsercatpromo " &						"where clave ='" & promo_sel & "' and fecha_inicial <='" & frn.get("fecha_cita") & "' and fecha_final >= '" & frn.get("fecha_cita") &	"'";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.validaciones_pre_ejecucion()");					ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					if (getXmlAtt(cubo,"r0","totreg")&=0){						frn.message("La promocion seleccionada no esta vigente","Error","Aceptar");						return 1;					}				}				if ( frn.get("serie") &! "" && tip_ope != 2 ){									if (kodawari &= "S" ){										if (historial_consultado &= "0" ){							frn.message("Tiene que consultar el historial de la unidad por lo menos una vez","Error","Aceptar");							return 1;						}					}									if (campanas_consultado &= "0" && num_campanas > 0 ){						frn.message("Tiene que consultar las Campañas pendientes de la unidad","Error","Aceptar");						return 1;					}										if (recomendaciones_consultado &= "0" && num_recomendaciones > 0 ){						frn.message("Tiene que consultar las Recomendaciones pendientes de la unidad","Error","Aceptar");						return 1;					}									}								var fecha_entrega = frn.get("fecha_entrega");				var hora_entrega = frn.get("hora_entrega");				var fecha_sugerida_entrega = frn.get("posible_fecha_entrega");				var hora_sugerida_entrega = frn.get("posible_hora_entrega");								var compara_fechas = fnDate("cmp",fecha_entrega ,fecha_sugerida_entrega );					var respuesta ;				if (compara_fechas &= -1){					respuesta = frn.message("La fecha de entrega es menor a la fecha sugerida de entrega, ¿ Seguro quieres continuar ?","Atencion",2);					if (respuesta == 0){						return 1;					}				}								if (compara_fechas &= 0){										var hrs_1 = strSplit(hora_entrega ,":", 0);						var mins_1 = strSplit(hora_entrega ,":", 1);												var hrs_2 = strSplit(hora_sugerida_entrega ,":", 0);						var mins_2 = strSplit(hora_sugerida_entrega ,":", 1);																		if (hrs_1 < hrs_2){							respuesta = frn.message("La fecha de entrega es menor a la fecha sugerida de entrega, ¿ Seguro quieres continuar ?","Atencion",2);							if (respuesta == 0){								return 1;							}						}												if (hrs_1 == hrs_2){													if (mins_1 < mins_2 ){								respuesta = frn.message("La fecha de entrega es menor a la fecha sugerida de entrega, ¿ Seguro quieres continuar ?","Atencion",2);								if (respuesta == 0){									return 1;								}							}											}				}									}						fun Alta(param){							var respuesta;				if (param &= "cancelar"){					tip_ope = 2;										respuesta = frn.message("¿ Seguro quieres cancelar cita ?","Atencion",2);					if (respuesta == 0){						return;					}				}else{					respuesta = frn.message("¿ Seguro quieres guardar la cita ?","Atencion",2);					if (respuesta == 0){						return;					}				}												if (validaciones_pre_ejecucion() &= 1){					return ;				}								actualiza_control_citas();								var xmlRequest ,cmd, cubo,ok ,mensajeError ;						xmlRequest = getXml(frn.dataPag()); //Obtener el xml de la pantalla;							setXml(xmlRequest ,"ctd_puntos",frn.N("tabla_puntos") - 1);				setXml(xmlRequest ,"ctd_sintomas",frn.N("tabla_sintomas") - 1);				setXml(xmlRequest ,"tipo_operacion",tip_ope);				setXml(xmlRequest,"folio_tmkt",folio_tmkt);				setXml(xmlRequest,"no_show",no_show );				setXml(xmlRequest ,"usuario",usuario);						frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequestalta");								cmd="SELECT * FROM keplersc.cita_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"srvcitacrud.Alta");										frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");							var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								if(resultado &= "1"){					var mensaje = getXml(cubo ,"mensaje");					frn.message(mensaje ,"Atencion","Aceptar");				}								if (tip_ope == 2){					bloquear_modificacion();				}								if (tip_ope == 0){					var fol = getXml(cubo ,"adicionales");					frn.set("tipo_cita_bus",descr_combo("tipo_cita_bus",1, frn.get("tipo_cita", -1, 1)));					frn.set("folio_cita",fol);										tip_ope = 1;										buscar_datos();					ctrls_off();				}				frP.script("Regresar()");		//de la pantalla que la llamo sertmktview														}						fun actualiza_control_citas(){					var xmlRequest,cmd,ok, mensajeError,cubo,suc,fecha  ;				suc = frn.get("k_sucN", -1, 1);				fecha = frn.get("fecha_cita");							setXml(xmlRequest,"document","k_sucN","r1", suc );				setXml(xmlRequest,"document","fecha",fecha );								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestcitas");								cmd="select * from keplersc.tmkt_control_de_citas('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSql",cmd,"control_de_citas.Inicializa()");												frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubo");												ok=getXml(cubo,"resultado");				if(ok &= "0" ){					mensajeError = getXml(cubo,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}						}													fun borrar_datos(){						frn.rst("fecha_cita");				frn.rst("hora_cita");				frn.rst("fecha_entrega");				frn.rst("hora_entrega");				frn.rst("fecha_confirmacion");				frn.rst("hora_confirmacion");				frn.rst("persona_confirmo");				frn.rst("fol_cita");				frn.set("tipo_cita",descr_combo("tipo_cita",1,"T"));								if (tip_ope == 1 && modulo_origen &! "T"){									frn.rst("folio_cita");					frn.rst("clave_cliente");					frn.rst("vin");					frn.rst("placas_bus");					borrar_datos_cli();					borrar_datos_vin();				}								botones_colores();					borrar_tablas();				frn.rst("subt");				frn.rst("k_iva");				frn.rst("k_monto");				frn.rst("posible_hora_entrega");				frn.rst("posible_fecha_entrega");				frn.rst("observaciones");					}						fun borrar_tablas(){				frn.rst("tabla_puntos");				frn.rst("tabla_sintomas");			}									fun borrar_datos_cli(){							frn.rst("cliente_id");				frn.rst("cliente_nombre");				frn.rst("cliente_calle");				frn.rst("cliente_ext");				frn.rst("cliente_int");				frn.rst("cliente_colonia");				frn.rst("cliente_poblacion");				frn.rst("cliente_municipio");				frn.rst("cliente_estado");				frn.rst("cliente_pais");				frn.rst("cliente_cp");				frn.rst("cliente_correo");				frn.rst("cliente_tcasa");				frn.rst("cliente_toficina");				frn.rst("cliente_tmovil");				frn.rst("cliente_rfc");				frn.rst("cliente_extension");					}						fun borrar_datos_vin(){							frn.rst("marca");				frn.rst("modelo");				frn.rst("anio");				frn.rst("color");				frn.rst("kms");				frn.rst("serie");				frn.rst("placas");				frn.rst("codigo");						}			fun MostrarHistOrdenes(){				var serie=frn.get("vin");				frn.dialog("serhistorialorden",serie,frn.get("k_sucN",-1,1));				historial_consultado = "1";			}						fun MostrarRecomendaciones(){				frn.dialog("recomendaciones");				recomendaciones_consultado = "1";			}			fun MostrarCampanas(){				frn.dialog("campanas","s");				campanas_consultado = "1";			}						fun control_de_citas(){//				if (esquema_recepcion == 15){					frn.dialog("control_de_citas");//				}else{//					frn.dialog("control_de_citas_20");//				}						}								fun catalogo_paquetes(){							var tipo_punto = frn.get("tabla_puntos",-1,"tipo_punto");								if (tipo_punto &! "S"){					frn.message("Selecciona un punto S para poder abrir el catalogo de paquetes","Error","Aceptar");					return;				}								var marca = frn.get("marca");				var modelo = frn.get("modelo");								if (marca &= "" || modelo &= ""){					frn.message("Selecciona Marca y Modelo para abrir el Catalogo de paquetes","Error","Aceptar");					return;				}							frn.dialog("cat_paquetes",marca ,modelo );			}						fun MostrarHorarios(){				if (esquema_recepcion == 15){					frn.dialog("horarios_disp_recep",tip_ope);				}else{					frn.dialog("horarios_disp_recep_20",tip_ope);				}			}									fun tipo_punto(){							frn.dialog("tipo_punto",frn.get("tipo_cita" , -1, 1));						}			fun edicion_cliente(tipo_edicion){				var cmdQuery, sucursal_id, cliente_id;				sucursal_id=frn.get("k_sucN", -1, 1);				cliente_id = frn.get("cliente_id");				if (tipo_edicion &= "Seleccionar" ){					if (modulo_origen &= "T" && cliente_id &! ""){						frn.message("No puedes seleccionar otro cliente, debes usar el actual","Error","Aceptar");						return ; 					}					frn.set("serie","");					cmdQuery = "select ud.c2 as cve_cte,ud.c3 as nombre " &						"from keplersc.kdud ud " &						"order by ud.c2"; 					frn.dialog("genlistafiltrosel","Clientes",cmdQuery,"cve_cte","cliente_id","0","0","S","N");					return;				}						if (tipo_edicion &= "Nuevo" &&  modulo_origen &= "T" && cliente_id &! ""){					frn.message("No puedes crear un cliente nuevo, debes usar el actual","Error","Aceptar");					return ; 				}				if (cliente_id &= "" && tipo_edicion &= "Modificar"){					frn.message("Debe especificar un cliente para modificar","Error","Aceptar");					return ; 				}				frn.dialog("cat_cli_crud",tipo_edicion,"x","s","cliente_id");			}				fun edicion_vin(tipo_edicion){					var strSerie = frn.get("serie");				if (tipo_edicion &= "Modificar" && strSerie &= ""){					frn.message("Debe especificar una serie para modificar","Error","Aceptar");					return ; 				}				frn.dialog("cat_serie_crud",tipo_edicion,"x","s","serie");			}							fun catalogo_campanas(){							var tipo_punto = frn.get("tabla_puntos",-1,"tipo_punto");								if (tipo_punto &! "G"){					frn.message("Selecciona un punto G para poder abrir el catalogo de campañas","Error","Aceptar");					return;				}								var serie= frn.get("serie");				if (serie &= ""){					frn.message("Selecciona una serie para abrir el Catalogo de campañas","Error","Aceptar");					return;				}				//MSS 06112025 Cambie el catalogo de kdcat_campana por kdsercampanacat y sus respectivas columnas				var cmdQuery = "select camp.c3 as clave, cat.descripcion as descripcion, cat.clave_campana || '|' || cat.descripcion as clave_desc" ;				cmdQuery =  cmdQuery  & " from keplersc.kdsercampana as camp inner join keplersc.kdsercampanacat as cat on cat.clave_campana=camp.c3 where camp.c2='" & serie & "' and camp.c4=0";				            frn.dialog("genlistafiltrosel","Campañas Pendientes",cmdQuery,"clave_desc","tabla_puntos", "-1","clave_campana","S","S");										}						fun campanas(){						  var calve_desc = frn.get("tabla_puntos", -1, "clave_campana");			  			   var cuenta = strSplit(calve_desc ,"|",0);            var descr = strSplit(calve_desc ,"|",1);                        frn.setX(cuenta, "tabla_puntos", -1, "clave_campana");            frn.setX(descr , "tabla_puntos", -1, "trabajo_a_realizar");            						}						fun ListaCitas(){				var cmdQuery;				borrar_datos();				cmdQuery = "select ct.c37 as t,ct.c2 as cita,to_char(ct.c12,'DD/MM/YYYY') as fecha,ct.c3 as asesor,ct.c6 as vin_ult_8,ct.c8 as modelo,ct.c4 as cve_cte,ud.c3 as nombre,						ct.c5 as placas,case when ct.c20=0 then 'PENDIENTE' when ct.c20=10 then 'CONFIRMADA' when ct.c20=20 then 'CONCRETADA' 						when ct.c20=30 then 'REPROG' when ct.c20=40 then 'CANCELADA' else '' end as estatus,concat(ct.c37,'~',ct.c2) as tcita						from keplersc.kdctasser ct						inner join keplersc.kdud as ud on ud.c2=ct.c4						where ct.c1 ='" & frn.get("k_sucN", -1, 1) & "' order by ct.c2 desc"; 				frn.dialog("genlistafiltrosel","Citas",cmdQuery,"tcita","folio_cita","0","0","S","N");										}											fun Operadores(){										var tipo_operario = frn.get("tabla_puntos",-1,"tipo_operario");				if (tipo_operario &= ""){					frn.message("Selecciona tipo de operario antes.","Error","Aceptar");					return;				}											var cmdQuery = "select c1 as clave, c2 as tipo, c3 as nombre , c1 || '|' || c3 as clave_desc " &				" from keplersc.kdoper where c2='" & tipo_operario & "' and c12='S' ";								frn.dialog("genlistafiltrosel","Operadores",cmdQuery,"clave_desc","tabla_puntos", "","clave_operario","N");            			}									fun Ope_insert(){							var clave_operario = frn.get("tabla_puntos", -1, "clave_operario");			  				var clave= strSplit(clave_operario ,"|",0);				var descr = strSplit(clave_operario ,"|",1);           				frn.setX(clave, "tabla_puntos", -1, "clave_operario");				frn.setX(descr , "tabla_puntos", -1, "clave_operario_desc");            						}			fun obtenerSerie(tipo){						var cmdQuery, sucursal_id;				sucursal_id=frn.get("k_sucN", -1, 1);				frn.set("folio_cita","");							if (tipo&="serie") {					cmdQuery = "select s.c4 as serie,s.c2 as marca,s.c3 as modelo,s.c10 as color,s.c8 as placas,s.c9 as cve_cte,cli.c3 as nombre						from keplersc.kdserie as s						inner join keplersc.kdud as cli on cli.c2=s.c9";						frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\cmdserie");					frn.dialog("genlistafiltrosel","Catalogo de Series",cmdQuery,"serie","serie","0","0","S","N");				}				}						fun OrdenTipo(){				var tord,nCampos,nfolio;					//Separa el tipo y folio cita, vienen concatenados con ~				nCampos = strSplit(frn.get("folio_cita"),"~",-1);				if (nCampos > 1) {					tord = strSplit(frn.get("folio_cita"),"~",0);					nfolio = strSplit(frn.get("folio_cita"),"~",1);					frn.set("tipo_cita_bus",tord);					frn.set("folio_cita",nfolio);				}				Formar_folio();			}			fun ValidaRecoleccion(){				if (frn.get("cmb_tipo_servicio",-1,1) &= "R"){					frn.dialog("srvrecoleccion.kpl");					frn.setAtt("bot_recoleccion","visible","Y");				} else {					frn.setAtt("bot_recoleccion","visible","N");					frn.set("calle_recoleccion","");					frn.set("num_ext_recoleccion","");					frn.set("num_int_recoleccion","");					frn.set("colonia_recoleccion","");					frn.set("poblacion_recoleccion","");					frn.set("municipio_recoleccion","");					frn.set("estado_recoleccion","");					frn.set("cp_recoleccion","");					frn.set("contacto_recoleccion","");					frn.set("fecha_recoleccion","");					frn.set("horario_recoleccion",);					frn.set("regresa_domicilio","");					frn.set("observaciones_recoleccion","");				}			}			fun Llena_cmbpromocion(){				var cmd, cubo, ok,mensajeError; 				if (frn.get("fecha_cita") &=""){					frn.message("Es necesario capturar la fecha de la cita","Error","Aceptar");					return;				}				cmd = "select '['||clave||'] '||descripcion as descripcion, clave " &					"from keplersc.kdsercatpromo " &					"where fecha_inicial <='" & frn.get("fecha_cita") & "' and fecha_final >= '" & frn.get("fecha_cita") &					"' order by fecha_inicial";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Llena_cmbpromocion()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.rst("cmb_promocion");				frn.setX("","cmb_promocion", 0 ,0);				llenar_cmb(cubo,"cmb_promocion");			}			fun ObtenerTipoPunto(){					//MSS 16042025 Obtiene catalogo				var cmd;												cmd= "select pun.c2 as punto, cat.c2 as descripcion from keplersc.kdtipoordentipopuntos as pun " & 					"inner join keplersc.catpuntos as cat on cat.c1= pun.c2 " &					"where pun.c1='" & frn.get("tipo_cita", -1, 1) & "'";					frn.dialog("genlistafiltrosel","Puntos",cmd,"punto","tabla_puntos",-1,"desc_punto","S","S");					   			}				fun valTipo_punto(){					//MSS 16042025 Valida dato capturado				var cubo,cmd,ok,mensajeError,len_result;								cmd="select punto,descr from (" &					"select pun.c2 as punto, cat.c2 as descr from keplersc.kdtipoordentipopuntos as pun " & 					"inner join keplersc.catpuntos as cat on cat.c1= pun.c2 " &					"where pun.c1='" & frn.get("tipo_cita", -1, 1) & "') puntos " &					"where punto='" & frn.get("tabla_puntos", -1, "desc_punto") & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"valTipo_punto.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								len_result = nXml(cubo);								if (len_result == 0){					frn.message("El tipo de punto " & frn.get("tabla_puntos", -1, "desc_punto")  & " para el tipo de orden " & frn.get("tipo_cita", -1, 1) & " no existe. Verifique...","Error","Aceptar");					frn.setPos("tabla_puntos", -1, "desc_punto");					frn.setX("", "tabla_puntos", -1, "desc_punto");					frn.setX("", "tabla_puntos", -1, "tipo_punto");					return;				} else {					frn.setX(getXmlAtt(cubo,"r0", "punto"), "tabla_puntos", -1, "tipo_punto");					frn.setX(getXmlAtt(cubo,"r0", "descr"), "tabla_puntos", -1, "desc_punto");				}				calc_importe();			}			fun ObtenerTipoOperario(){				//MSS 16042025 Obtiene catalogo				var cmd,tipo_punto;				tipo_punto= frn.get("tabla_puntos" , -1, "tipo_punto");								cmd= "select cat.c1 clave,cat.c2 tipo from keplersc.kdpuntop as top inner join keplersc.kdtoper as cat on cat.c1=top.c2 where top.c1='" & tipo_punto & "'";					frn.dialog("genlistafiltrosel","Tipo Operario",cmd,"clave","tabla_puntos",-1,"desc_operario","S","S");					   			}			fun valTipo_operario(){					//MSS 16042025 Valida dato capturado				var cubo,cmd,ok,mensajeError,len_result,tipo_punto,tipo_oper;				tipo_oper=frn.get("tabla_puntos" , -1, "desc_operario");				tipo_punto= frn.get("tabla_puntos" , -1, "tipo_punto");				cmd="select tipo,descr from (" & 					"select cat.c1 tipo,cat.c2 descr from keplersc.kdpuntop as top inner join keplersc.kdtoper as cat on cat.c1=top.c2 where top.c1='" & tipo_punto & "') tp " &					"where tipo = '" & tipo_oper & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"valTipo_operario.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								len_result = nXml(cubo);								if (len_result == 0){					frn.message("El tipo de operario no existe. Verifique...","Error","Aceptar");					frn.setPos("tabla_puntos", -1, "desc_operario");					frn.setX("", "tabla_puntos", -1, "desc_operario");					frn.setX("", "tabla_puntos", -1, "tipo_operario");					return;				} else {					frn.setX(getXmlAtt(cubo,"r0", "tipo"), "tabla_puntos", -1, "tipo_operario");					frn.setX(getXmlAtt(cubo,"r0", "descr"), "tabla_puntos", -1, "desc_operario");				}						}			fun ObtenerCatPaquetes(){				//MSS 16042025 Obtiene catalogo			var cmd,marca,modelo;				marca = frn.get("marca");				modelo = frn.get("modelo");				cmd="select c4 clave,c5 descripcion,c9 horas,c10 precio from keplersc.kdspaq where c1='" & marca & "' and c2='" & modelo & "'";				frn.dialog("genlistafiltrosel","Catalogo Paquetes",cmd,"clave","tabla_puntos",-1,"clave_paquete","S","S");				}			fun ValPaquete(){						//MSS 16042025 Valida datos capturado				var cubo,cmd,ok,mensajeError,len_result,marca,modelo,paquete,tipo_punto;				marca = frn.get("marca");				modelo = frn.get("modelo");				paquete= frn.get("tabla_puntos" , -1, "clave_paquete");				tipo_punto = frn.get("tabla_puntos",-1,"tipo_punto");				if (paquete &! ""){					if (tipo_punto &! "S"){						frn.setX(getXmlAtt(""), "tabla_puntos", -1, "clave_paquete");						frn.setPos("tabla_puntos", -1, "clave_paquete");						frn.message("Selecciona un punto S para paquetes","Error","Aceptar");						return;					}														if (marca &= "" || modelo &= ""){						frn.setX(getXmlAtt(""), "tabla_puntos", -1, "clave_paquete");						frn.setPos("tabla_puntos", -1, "clave_paquete");						frn.message("Selecciona Marca y Modelo para validar el paquete","Error","Aceptar");						return;					}										cmd="select clave,descr,horas,precio from (" & 						"select c4 clave,c5 descr,c9 horas,c10 precio from keplersc.kdspaq where c1='" & marca & "' and c2='" & modelo & "') pq " &						"where clave = '" & paquete & "'";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ValPaquete.Inicializa()");										frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");										ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");									len_result = nXml(cubo);									if (len_result == 0){						frn.message("El paquete no existe. Verifique...","Error","Aceptar");						frn.setPos("tabla_puntos", -1, "clave_paquete");						frn.setX("", "tabla_puntos", -1, "clave_paquete");						frn.setX("", "tabla_puntos", -1, "trabajo_a_realizar");						frn.setX("", "tabla_puntos", -1, "horas");						frn.setX("", "tabla_puntos", -1, "precio_punto");						return;					} else {						frn.setX(getXmlAtt(cubo,"r0", "clave"), "tabla_puntos", -1, "clave_paquete");						frn.setX(getXmlAtt(cubo,"r0", "descr"), "tabla_puntos", -1, "trabajo_a_realizar");						frn.setX(getXmlAtt(cubo,"r0", "horas"), "tabla_puntos", -1, "horas");						frn.setX(getXmlAtt(cubo,"r0", "precio"), "tabla_puntos", -1, "precio_punto");					}					calc_importe(paquete);				}			}						fun ValOperario(){						//MSS 17042025 Obtiene catalogo				var cubo,cmd,ok,mensajeError,len_result,tipo_operario,cve_operario_desc;				tipo_operario = frn.get("tabla_puntos",-1,"tipo_operario");				cve_operario_desc = frn.get("tabla_puntos", -1, "clave_operario_desc");				if (cve_operario_desc &! ""){					cmd="select clave,nombre from (" & 						"select c1 as clave, c2 as tipo, c3 as nombre , c1 || '|' || c3 as clave_desc " &						" from keplersc.kdoper where c2='" & tipo_operario & "' and c12='S') tp " &						"where clave = '" & cve_operario_desc & "'";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"valTipo_operario.Inicializa()");										frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");										ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");									len_result = nXml(cubo);									if (len_result == 0){						frn.message("El operario no existe. Verifique...","Error","Aceptar");						frn.setPos("tabla_puntos", -1, "clave_operario_desc");						frn.setX("", "tabla_puntos", -1, "clave_operario_desc");						frn.setX("", "tabla_puntos", -1, "clave_operario");						return;					} else {						frn.setX(getXmlAtt(cubo,"r0", "clave"), "tabla_puntos", -1, "clave_operario");						frn.setX(getXmlAtt(cubo,"r0", "nombre"), "tabla_puntos", -1, "clave_operario_desc");					}				}				}			fun ObtenerTipoSintoma(){				//MSS 17042025 Obtiene catalogo				var cmd;												cmd= "select c1 clave,c2 tipo from keplersc.kdtipsin";									frn.dialog("genlistafiltrosel","Tipos de Sintomas",cmd,"clave","tabla_sintomas",-1,"tipo_sintoma","S","S");					   			}				fun valTipo_sintomas(){					//MSS 17042025 Valida dato capturado				var cubo,cmd,ok,mensajeError,len_result,tipo_sintoma;				tipo_sintoma=frn.get("tabla_sintomas", -1, "tipo_sintoma");				if (tipo_sintoma &! ""){					cmd="select clave,tipo from (" &						"select c1 clave,c2 tipo from keplersc.kdtipsin) sint " &						"where clave='" & tipo_sintoma & "'";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"valTipo_punto.Inicializa()");										frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");										ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");									len_result = nXml(cubo);									if (len_result == 0){						frn.message("El tipo de sintoma no existe. Verifique...","Error","Aceptar");						frn.setPos("tabla_sintomas", -1, "tipo_sintoma");						frn.setX("", "tabla_sintomas", -1, "tipo_sintoma");						return;					} else {						frn.setX(getXmlAtt(cubo,"r0", "clave"), "tabla_sintomas", -1, "tipo_sintoma");					}				}			}			fun ObtenerCveSintoma(){				//MSS 17042025 Obtiene catalogo				var cmd,tipo_sintoma;				tipo_sintoma=frn.get("tabla_sintomas", -1, "tipo_sintoma");;												cmd= "select c2 clave,c3 descripcion from keplersc.kdvaltipsin where c1='" & tipo_sintoma & "'";				frn.dialog("genlistafiltrosel","Sintomas",cmd,"clave","tabla_sintomas",-1,"clave_sintoma","S","S");					   			}				fun valCve_sintomas(){					//MSS 17042025 Valida dato capturado				var cubo,cmd,ok,mensajeError,len_result,tipo_sintoma,clave_sintoma;				tipo_sintoma=frn.get("tabla_sintomas", -1, "tipo_sintoma");				clave_sintoma=frn.get("tabla_sintomas", -1, "clave_sintoma");				if (clave_sintoma &! ""){					cmd="select clave,descripcion from (" &						"select c2 clave,c3 descripcion from keplersc.kdvaltipsin where c1='" & tipo_sintoma & "') sint " &						"where clave='" & clave_sintoma & "'";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"valTipo_punto.Inicializa()");										frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");										ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");									len_result = nXml(cubo);									if (len_result == 0){						frn.message("El sintoma no existe. Verifique...","Error","Aceptar");						frn.setPos("tabla_sintomas", -1, "clave_sintoma");						frn.setX("", "tabla_sintomas", -1, "clave_sintoma");						frn.setX("", "tabla_sintomas", -1, "desc_sintoma");						return;					} else {						frn.setX(getXmlAtt(cubo,"r0", "descripcion"), "tabla_sintomas", -1, "desc_sintoma");					}				}			}						fun verifica_ifz_bp_campanas_vin(){					//MSS 06112025 Campanas-Ifz				var cmd, ok, cubo, mensajeError, VN, bp_campanas;				VN = frn.get("serie");				verifica_campanas_recomen();				//verifica ifz				if (cons_ifz &= "0" && VN &! "") {					cmd = "select upper(clave_campana) as clave_campana from keplersc.ifz_bp_campanas_vin where serie='" & VN & "' and fecha_solicitud >= current_date-1 order by fecha_solicitud desc limit 1";									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.verifica_ifz_actualiza_campanas()");								ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}									frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\ifz_campanas");					bp_campanas = nXml(cubo);					if (bp_campanas > 0){						//verificar si esta pendiente la solicitud de consulta a Bp						if (getXmlAtt(cubo,"r0","clave_campana") &= "PENDIENTE") {							//solicitar consulta a Bp							SolicitaConsultaBp(VN);						}					} else{		//si no hay registro de solicitud de consulta						//solicitar consulta a Bp						SolicitaConsultaBp(VN);					}				}			}			fun SolicitaConsultaBp(VN){						//MSS 06112025 Campanas-Ifz				var cmd, ok,cubo,mensajeError, resultado, mensaje,sucursal_id;				sucursal_id=frn.get("k_sucN", -1, 1);				if (cons_BP &= "0") {						cmd ="select * from keplersc.notif_registrar_movto_campanas('" & VN & "." & sucursal_id & "')";						rstXml(cubo);											cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"srvcitacrud.SolicitaConsultaBp");										//frn.lib("libGeneral.kpl","FileSave",cubo,"c:\basura\XmlResultadoConsBp");											resultado = getXml(cubo,"resultado");						mensaje = getXml(cubo,"mensaje");											ok = getXmlAtt(cubo,"ok");						if(ok &! "" && !ok) {							mensajeError = getXmlAtt(cubo,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;							}						if(resultado &= "1") {							frn.setAtt("bot_campanas", "bclr", "244,230,26");							frn.setAtt("bot_campanas", "clr", "0,0,0");							frn.setAtt("bot_campanas", "fnt",",b");							cons_BP = "1";						} else {											frn.message("No se concreto la consulta a Bp de las campañas|" &mensaje, "Error", "Aceptar");						}				}			}					fun InterfazCampanas(){								//MSS 06112025 Campanas-Ifz				var cuboQuery,cmdQuery,ok,mensajeError,ifz_campanas,sucursal_id;				sucursal_id=frn.get("k_sucN",-1,1);					cmdQuery = "select valor from keplersc.param_oper where sucursal='" & sucursal_id & "' and parametro='interfaz_campanas'";				frn.lib("libGeneral.kpl","FileSave",cmdQuery,"c:\basura\cmdselparamoper");				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcitacrud.InterfazCampanas()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				ifz_campanas = getXmlAtt(cuboQuery,"r0", "valor");				return ifz_campanas;			}						//--------------------------------------------------- funciones importadas----------------------------------------------------------------------						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}												fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}									fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}									fun Formar_folio(){							var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("folio_cita"));								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				frn.lib("libGeneral.kpl","FileSave",cubofol,"C:\Basura\cuboFol");								var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");								frn.set("folio_cita", fol);							}			}	</script></pag>