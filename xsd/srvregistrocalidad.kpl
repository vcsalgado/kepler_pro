<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit=""><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0">	<tab n="1"/>	<inp id="inp_titulo" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/><br/>	<br/>	<tab/><hLine clr="0,0,0"/>		<br/><br/>	<tab/>		<grp dim="105,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle de la orden">			<sp/><txt fnt=",b">Sucursal:</txt><sp/><inp id="k_sucursal" dim="5,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<sp/><inp id="k_sucnombre" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/><tab/><txt fnt=",b">Fecha:  </txt>			<inp id="k_fecha" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" modify="N" available="N" fmt="DD/MM/CCYY" nc="-1" fnt=",0"/><tab/><txt fnt=",b">Estatus:</txt>			<inp id="k_estatusdesc" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/><tab n="2"/>			<br/>			<sp/><txt  fnt="Arial,b">Tipo:</txt><sp/><inp id="k_tipo" clr="64,64,64"  dim="3,1" fnt="Arial,0" clrBrdr="255,255,255"   bclr="255,255,255" modify="N" visible="Y" type="string" brdr="2,0"/>			<sp/><inp id="k_tipodesc" dim="25,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" fnt=",0" modify="N" available="N"/>			<tab/><txt  fnt="Arial,b">Folio:</txt><sp/><inp id="k_folio" clr="64,64,64"  dim="18,1" fnt="Arial,0" clrBrdr="255,255,255"   bclr="255,255,255" brdr="2,0"  modify="N" visible="Y" type="string"/>			<tab/><txt fnt=",b">Cliente: </txt><sp/><inp id="k_cliente" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<sp/><inp id="k_nombre" dim="53,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<br/>			<sp/><txt fnt=",b">VIN: </txt><sp/><inp id="k_serie" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<sp/><txt fnt=",b"> Marca:</txt><sp/>	<inp id="k_marca" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<sp/><txt fnt=",b">Modelo:</txt><sp/><inp id="k_modelo" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<sp/><txt fnt=",b">Color:</txt><sp/><inp id="k_color" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>            <sp/><txt fnt=",b">A&#241;o:</txt><sp/><inp id="k_anio" dim="8,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<sp/><txt fnt=",b">Placas:</txt><sp/><inp id="k_placa" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<sp/><txt fnt=",b">Bonete:</txt><sp/><inp id="k_bonete" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		</grp>		<br/><br/>	<tab/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="105,23,10,10" brdr="0,5" tit="Detalle de Puntos" fnt="Arial,16">				<sp/>		<tbl id="tabla_puntos" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="103,7"  hk="z" Reorder="N" modify="N" available="Y" insdel="N" OnMouseL="" OnChange="" nren="fijo">			<col id="k_punto" name="Punto" modify="N" visible= "Y" type="capital" OnActive="PreCargaCalidad()"/>         <col id="k_descripcion" name="Descripci&#243;n" modify="N" visible= "Y" type="capital" OnActive="PreCargaCalidad()"/>         <col id="k_status_punto" name="Status Punto" modify="N" visible= "Y" type="capital" OnActive="PreCargaCalidad()"/>			<col id="k_clave_operario" name="Cve T&#233;c." OnF9="" modify="N" visible= "Y" OnActive="PreCargaCalidad()"/>         <col id="k_nombre_operario" name="T&#233;cnico" OnF9="" modify="N" visible= "Y" OnActive="PreCargaCalidad()"/>         <col id="k_status_operario" name="Status T&#233;c." OnF9="" modify="N" visible= "Y" type="capital" OnActive="PreCargaCalidad()"/>			<col id="k_resultados" name="Resultados" modify="N" visible= "N" type="capital" OnActive="PreCargaCalidad()"/>			<col id="k_recomendTec" name="Recomendaciones" modify="N" visible="N" type="capital" OnActive="PreCargaCalidad()"/>		</tbl>				<br/><sp/><txt>Resultados Tecnico:</txt>		<tab n="14"/><txt>Recomendaciones Tecnico:</txt>		<br/>		<sp/><inp id="resultados_punto" dim="50,2" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="N" available="Y" type="capital" nc="300" OnChange="rel_coment_pto()" tooltip="Resultados"/>		<sp/><tab/>		<inp id="recomendaciones_punto" dim="50,2" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="N" available="Y" type="capital" nc="300" OnChange="rel_coment_pto()" tooltip="Recomendaciones"/>	</grp>		<br/><br/>	<tab/>	<grp id="k_infcalidad" dim="105,28,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Tiempos e Informacion para el Registro de Calidad">        <grp dim="45,19,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<sp n="1"/> 				<txt>Tiempo Glogal :   </txt>				<inp id="k_tglobal" clr="64,64,64" clrBrdr="255,255,255"  dim="10,1" fnt=",16" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="N"/> 				<sp n="1"/><txt>minutos</txt>				<br/>				<sp n="1"/> 				<txt>Tiempo Efectivo : </txt>				<inp id="k_tefectivo" clr="64,64,64" clrBrdr="255,255,255"  dim="10,1" fnt=",16" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="N"/> 				<sp n="1"/><txt>minutos</txt>				<sp n="1"/><inp id="k_punto_rel" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" fnt=",16" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="N" visible="N"/> 				<br/>            <sp n="1"/><txt>&#191;El trabajo fue revisado por el</txt>            <inp id="etiqueta_revisado" dim="9,1"  type="string" modify="N" available="N"/>            <chck id="k_revisado" dim="3,16" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" OnChange="" available="N"/>            <br/>				<sp n="1"/><txt>&#191;El trabajo fue revisado por el Asesor T&#233;cnico?</txt><sp n="1"/>            <chck id="k_rev_asestec" dim="3,16" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" available="N"/>            <br/>            <sp n="1"/><txt>&#191;El servicio fue concluido o en caso de falla &#233;sta fue reparada?</txt><sp n="1"/>            <chck id="k_reparado" dim="3,16" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" available="N"/>            <br/>            <sp n="1"/><txt>&#191;Este trabajo requiri&#243; elaboraci&#243;n de reporte t&#233;cnico?</txt><sp n="1"/>            <chck id="k_reportec" dim="3,16" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" available="N"/>            <br/>            <sp n="1"/><txt>&#191;Este trabajo aplic&#243; a garant&#237;a?</txt><sp n="1"/>            <chck id="k_garantia" dim="3,16" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" OnChange="Garantia()" available="N"/>            <br/>            <sp n="1"/><txt>* Indique la orden de garant&#237;a :</txt><sp n="1"/>            <cmb id="k_tipo_orden_garantia" clr="64,64,64" clrBrdr="255,255,255"  dim="10,1" fnt=",16" bclr="255,255,255" brdr="2,0" type="capital" modify="N" available="N" tooltip="Tipo de Orden de Garant&#237;a"/>             <sp n="1"/>            <inp id="k_num_orden_garantia" clr="64,64,64" clrBrdr="255,255,255"  dim="10,1" fnt=",16" bclr="255,255,255" brdr="2,0" type="capital" modify="N" available="N"                 tooltip="N&#250;mero de &#243;rden ( F9 b&#250;squeda )" OnF9="ObtenerNumOrden()" OnChange="BuscarOrden()"/>         </grp>         <grp dim="60,19,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">            <sp n="1"/><txt>Comentarios:</txt><sp n="4"/>            <inp id="k_comentarios" clr="64,64,64" clrBrdr="255,255,255"  dim="46,2" fnt=",16" bclr="255,255,255" brdr="2,0" type="capital" nc="300" modify="Y" available="N"/>             <br/>            <sp n="1"/><txt>Observaciones:</txt><sp n="3"/>            <inp id="k_observaciones" clr="64,64,64" clrBrdr="255,255,255"  dim="46,3" fnt=",16" bclr="255,255,255" brdr="2,0" type="capital" nc="300" modify="Y" available="N"/>             <br/>            <sp n="1"/><txt>Recomendaciones:</txt>            <inp id="k_recomendaciones" clr="64,64,64" clrBrdr="255,255,255"  dim="46,3" fnt=",16" bclr="255,255,255" brdr="2,0" type="capital" nc="300" modify="Y" available="N"/>             <br/>		</grp>        <br/>		<tab n="22"/>		<inp id="inp_text_btn" dim="30,1" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",16" just="R"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Registro de Calidad de un Punto" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>	</grp>				</grp>	<script>		InstallDriver("KDB75");		class Main {			var perfil_usuario,asterisco,vin , externo, sucursal_id,num_orden, tipo_orden;			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			var tipopunto, status, cerradovarios, marca, modelo; 			// Variables de control			var cmdQuery, cuboQuery, ok, mensajeError, fileSavePath;			var flujoadmon,punto, tiporden, numorden, resVal;													// Variables de parametros			var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd;							fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				rep=new REP;				kdb.connect();				anio_contable = kdb.get("KDE","14");								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");								rol_usuario = frn.config("user","role");				asterisco = "*";				fileSavePath = "C:\Basura";				sucursal_id =trim(frn.param(0));				tipo_orden=trim(frn.param(1));				num_orden=trim(frn.param(2));					tip_ope=trim(frn.param(3));						Inicializa();            ConfiguraControlesOpcion();			}									fun Inicializa(){				var cmd, cubo, strTitulo, strTextbtn;				var xmlOrden, xmlDatos,strvin;				resVal = 1;					//Establecer titulo de la ventana				strTitulo = "Registro de Calidad";				strTextbtn ="Registro de Calidad de un Punto-->";				if (tip_ope &= "B"){					strTitulo = "Baja "& strTitulo;					strTextbtn = "Baja del " & strTextbtn;				}else if (tip_ope &= "A"){					strTitulo= "Alta "& strTitulo;					strTextbtn = "Alta del " & strTextbtn;				}				frn.set("inp_titulo",strTitulo);				frn.set("inp_text_btn",strTextbtn);							xmlOrden= frn.lib("libOrdenes.kpl","ConsultaOrden",sucursal_id,tipo_orden,num_orden);								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				xmlDatos = frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",xmlOrden,"r0");				frn.setX(xmlDatos);                //actualiza color								strvin = frn.get("k_serie");								cmd = " select c10 as color from keplersc.kdserie where c1='" & strvin & "'";									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvregistrocalidad.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}                frn.set("k_color",getXmlAtt(cubo,"r0","color"));				//puntos				cmd = "select pun.c4 as k_punto, pun.c8 k_descripcion,case when pun.c7='A' then 'ACTIVO' when pun.c7='S' then 'SUSPENDIDO' when pun.c7='T' then 'TERMINADO' else pun.c7 end k_status_punto,pun.c9 as k_clave_operario, " &                        "case when op.c3 is null then 'NO SE ENCUENTRA EL TECNICO' else op.c3 end k_nombre_operario, case when op.c12 <> 'S' then 'INACTIVO' else 'ACTIVO' end k_status_operario, res.c11 as k_resultados, res.c33 as k_recomendTec " &                        "from keplersc.kdord ord " &                        "inner join keplersc.kdpun pun on pun.c1=ord.c1 and pun.c2=ord.c2 and pun.c3=ord.c3 " &                        "left join keplersc.kdoper op on op.c1=pun.c9 " &                        "left join keplersc.kdpunres res on res.c1=pun.c1 and res.c2=pun.c2 and res.c3=pun.c3 and res.c4=pun.c4 " &                        "where ord.c1='" & sucursal_id & "' and ord.c2='" & tipo_orden & "' and ord.c3='" & num_orden & "' " &                        "order by pun.c4";				rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvregistrocalidad.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo, fileSavePath & "\puntos");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												frn.setX(cubo,"tabla_puntos");								vin = getXmlAtt(cubo,"r0","serie");				flujoadmon = frn.get("tabla_puntos",-1,"k_flujo_admon");            //Fill Combo Tipo de Orden Garantia				cmd = "select '['||c1||'] '||c3 as c2, c1  from keplersc.kdmargen where c1='G'" ;				IniCombos("k_tipo_orden_garantia",cmd);				frn.set("k_tipo_orden_garantia", "");								if (frn.get("k_tipo") &= "G"){					frn.set("etiqueta_revisado","MDT?");				} else{					frn.set("etiqueta_revisado","Jefe de Taller?");				}			}			fun IniCombos(ctrl_combo, query){					cmdQuery = query;				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvregistrocalidad.IniCombos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set(ctrl_combo,cuboQuery);			}				fun ObtenerNumOrden() {				var tiporden_g, serie;							sucursal_id = frn.get("k_sucursal");				tiporden_g = frn.get("k_tipo_orden_garantia",-1,1);				serie = frn.get("k_serie");				if (tiporden_g &= ""){					frn.message("Debe seleccionar tipo de orden de garantia| Es obligatorio","Error","Aceptar");					return;				}					frn.set("k_num_orden_garantia","");				cmdQuery = "select C3 as orden, C4 as fecha " &							"from keplersc.kdord " & 							"where c1 = '" & sucursal_id & "' and c6='" & serie & "' and c2= '" & tiporden & "'";				frn.dialog("genlistasel","Ordenes Garantia",cmdQuery,"orden","k_num_orden_garantia","","","S");							}			fun BuscarOrden(){				var tiporden_g, serie,num_orden_g,totReg;							sucursal_id = frn.get("k_sucursal");				tiporden_g = frn.get("k_tipo_orden_garantia",-1,1);				num_orden_g = frn.get("k_num_orden_garantia");				serie = frn.get("k_serie");				//Validar orden				cmdQuery="SELECT count(*) as totreg " & 							"from keplersc.kdord " & 							"where c1 = '" & sucursal_id & "' and c6='" & serie & "' and c2= '" & tiporden_g & "' and c3= '" & num_orden_g & "'";				rstXml(cuboQuery);								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvregistrocalidad.BuscarOrden()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				totReg=getXmlAtt(cuboQuery,"r0","totreg");				if(totReg==0){					frn.message("La orden de garantia no existe, verifique por favor","Error","Aceptar");					resVal=0;					return;				}			}			fun PreCargaCalidad(){                var xmlDatos, statuspunto, descpunto,tit_punto;				LimpiaPunto();				//precargas informacion de calidad kdpunres para suc, tipo_orden, num_orden,punto				sucursal_id = frn.get("k_sucursal");		//Se lo puse para que grabe por punto				tiporden = frn.get("k_tipo");				numorden  = frn.get("k_folio");				punto = frn.get("tabla_puntos",-1,"k_punto");				descpunto = frn.get("tabla_puntos",-1,"k_descripcion");				frn.set("k_punto_rel",punto);				statuspunto = frn.get("tabla_puntos",-1,"k_status_punto");				tit_punto = "Tiempos e Informacion para el Registro de Calidad   "&"Punto: "& punto & " " & descpunto;				frn.setAtt("k_infcalidad", "tit", tit_punto);                if (statuspunto &="P"){                    frn.message("Solo se puede iniciar un trabajo de un punto que ya fue asignado|Verifique en control","Error","Aceptar");                }                else{					cmdQuery= "select res.c10 as k_tglobal,res.c19 as k_tefectivo,case when res.c12='S' then 1 else 0 end k_revisado,case when res.c13='S' then 1 else 0 end k_reparado, " &							"case when res.c21='S' then 1 else 0 end k_reportec,case when res.c32='S' then 1 else 0 end k_rev_asestec,case when res.c22='S' then 1 else 0 end k_garantia, " &							"'['||res.c2||'] '||mar.c3 as k_tipo_orden_garantia,res.c24 as k_num_orden_garantia,res.c14 as k_comentarios,res.c15||' '||res.c26||' '||res.c27||' '||res.c28 as k_observaciones, " &							"res.c16||' '||res.c29||' '||res.c30||' '||res.c31 as k_recomendaciones, res.c33 as k_recomendTec " &							"from keplersc.kdpunres res " &							"inner join keplersc.kdmargen mar on mar.c1=res.c2 " &							"where res.c1='" & sucursal_id& "' and res.c2='" & tiporden & "' and res.c3='" & numorden &							"' and res.c4 = '" & punto & "'";					//frn.message(cmdQuery,"","Aceptar");					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvregistrocalidad.PreCargaCalidad()");					frn.lib("libGeneral.kpl","FileSave",cuboQuery,fileSavePath &"\preregistrocalidad");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}						xmlDatos = frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");					frn.setX(xmlDatos);					frn.set("resultados_punto",frn.get("tabla_puntos",-1,"k_resultados"));					frn.set("recomendaciones_punto",frn.get("tabla_puntos",-1,"k_recomendTec"));										}				ConfiguraControlesOpcion();			}					        			fun LimpiaPunto(){                frn.set("k_tglobal","");                frn.set("k_tefectivo","");                frn.set("k_revisado","");                frn.set("k_rev_asestec","");                frn.set("k_reparado","");                frn.set("k_reportec","");                frn.set("k_garantia","");                frn.set("k_tipo_orden_garantia","");                frn.set("k_num_orden_garantia","");                frn.set("k_comentarios","");                frn.set("k_observaciones","");                frn.set("k_recomendaciones","");			}			fun ConfiguraControlesOpcion() {							ConfiguraControlesOff();				var statuspunto;				statuspunto = frn.get("tabla_puntos",-1,"k_status_punto");				if(tip_ope &= "A"){ //Alta registro					if (statuspunto &="P"){						frn.setAtt("k_revisado", "available", "N");						frn.setAtt("k_rev_asestec", "available", "N");						frn.setAtt("k_reparado", "available", "N");						frn.setAtt("k_reportec", "available", "N");						frn.setAtt("k_garantia", "available", "N");						frn.setAtt("k_tipo_orden_garantia", "available", "N");						frn.setAtt("k_num_orden_garantia", "available", "N");						frn.setAtt("k_comentarios", "modify", "N");						frn.setAtt("k_observaciones", "modify", "N");						frn.setAtt("k_recomendaciones", "modify", "N");						frn.setAtt("k_comentarios", "available", "Y");						frn.setAtt("k_observaciones", "available", "Y");						frn.setAtt("k_recomendaciones", "available", "Y");					}else{						frn.setAtt("k_revisado", "available", "Y");						frn.setAtt("k_rev_asestec", "available", "Y");						frn.setAtt("k_reparado", "available", "Y");						frn.setAtt("k_reportec", "available", "Y");						frn.setAtt("k_garantia", "available", "Y");						frn.setAtt("k_tipo_orden_garantia", "available", "Y");						frn.setAtt("k_num_orden_garantia", "available", "Y");						frn.setAtt("k_comentarios", "available", "Y");						frn.setAtt("k_observaciones", "available", "Y");						frn.setAtt("k_recomendaciones", "available", "Y");						frn.setAtt("k_comentarios", "modify", "Y");						frn.setAtt("k_observaciones", "modify", "Y");						frn.setAtt("k_recomendaciones", "modify", "Y");						frn.setAtt("Aceptar", "visible", "Y");							frn.setAtt("text_btn", "visible", "Y");					}				}else if (tip_ope &= "C") {					frn.setAtt("tabla_puntos","available","N");					frn.setAtt("k_revisado", "available", "N");					frn.setAtt("k_rev_asestec", "available", "N");					frn.setAtt("k_reparado", "available", "N");					frn.setAtt("k_reportec", "available", "N");					frn.setAtt("k_garantia", "available", "N");					frn.setAtt("k_tipo_orden_garantia", "available", "N");					frn.setAtt("k_num_orden_garantia", "available", "N");					frn.setAtt("k_comentarios", "available", "Y");					frn.setAtt("k_observaciones", "available", "Y");					frn.setAtt("k_recomendaciones", "available", "Y");					frn.setAtt("k_comentarios", "modify", "N");					frn.setAtt("k_observaciones", "modify", "N");					frn.setAtt("k_recomendaciones", "modify", "N");    					frn.setAtt("Aceptar", "visible", "N");					frn.setAtt("text_btn", "visible", "N");				}else if (tip_ope &= "B") {						frn.setAtt("k_revisado", "available", "N");					frn.setAtt("k_rev_asestec", "available", "N");					frn.setAtt("k_reparado", "available", "N");					frn.setAtt("k_reportec", "available", "N");					frn.setAtt("k_garantia", "available", "N");					frn.setAtt("k_tipo_orden_garantia", "available", "N");					frn.setAtt("k_num_orden_garantia", "available", "N");					frn.setAtt("k_comentarios", "available", "Y");					frn.setAtt("k_observaciones", "available", "Y");					frn.setAtt("k_recomendaciones", "available", "Y");					frn.setAtt("k_comentarios", "modify", "N");					frn.setAtt("k_observaciones", "modify", "N");					frn.setAtt("k_recomendaciones", "modify", "N");					frn.setAtt("Aceptar", "visible", "Y");						frn.setAtt("text_btn", "visible", "Y");				}			}			fun ConfiguraControlesOff(){				frn.setAtt("k_revisado", "available", "N");				frn.setAtt("k_rev_asestec", "available", "N");				frn.setAtt("k_reparado", "available", "N");				frn.setAtt("k_reportec", "available", "N");				frn.setAtt("k_garantia", "available", "N");				frn.setAtt("k_tipo_orden_garantia", "available", "N");				frn.setAtt("k_num_orden_garantia", "available", "N");				frn.setAtt("k_comentarios", "available", "N");				frn.setAtt("k_observaciones", "available", "N");				frn.setAtt("k_recomendaciones", "available", "N");    				frn.setAtt("Aceptar", "visible", "N");				frn.setAtt("text_btn", "visible", "N");			}			//Validacion Datos Generales antes de Guardar.			fun ValidarDatos() {				var strComent, strObs,strRecom,totReg,strPuntoRel;				//Obtener variables				strPuntoRel = frn.get("k_punto_rel");								strComent = frn.get("k_comentarios");				strObs = frn.get("k_observaciones");				strRecom = frn.get("k_recomendaciones");				if (tip_ope&="A"){					//Validar seleccion un punto					if (strPuntoRel &= 0){						frn.message("Debe seleccionar un punto","Error","Aceptar");						resVal=0;						return;					}					//Validar orden de garant?a					if (frn.get("k_garantia") &="1"){						BuscarOrden();					}						//Validar Comentarios, Observaciones y Recomendaciones 					if (strComent &= ""){						frn.message("El campo de COMENTARIOS es un dato obligatorio","Error","Aceptar");						resVal=0;						return;					}					if (strObs &= ""){						frn.message("El campo de OBSERVACIONES es un dato obligatorio","Error","Aceptar");						resVal=0;						return;					}					if (strRecom &= ""){						frn.message("El campo de RECOMENDACIONES es un dato obligatorio","Error","Aceptar");						resVal=0;						return;					}						}else if (tip_ope &="B"){							//Validar seleccion un punto					if (strPuntoRel &= 0){						frn.message("Debe seleccionar un punto","Error","Aceptar");						resVal=0;						return;					}					punto = frn.get("tabla_puntos",-1,"k_punto");									cmdQuery = "select count(*) as totReg from keplersc.kdpunres " &						"where c1='" & sucursal_id & "' and c2='" & tipo_orden & "' and c3='" & num_orden & "' and c4='" & punto & "'";											rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcargosvarios.ValidarDatos()");					frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\totRegBaja");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}					totReg = getXmlAtt(cuboQuery,"r0","totreg");										if (totReg == 0){						frn.message("No tiene Registro de Calidad|Imposible dar de baja","Error","Aceptar");						resVal=0;						return;					}					if (frn.get("tabla_puntos",-1,"k_status_punto") &= "P"){						frn.message("S?lo se pueden dar de baja registros de Calidad|para trabajos que se encuentran ASIGNADOS|Verifique en control.","Error","Aceptar");						resVal=0;						return;					}					validaTrabajoIniciado();				}			} 			fun validaTrabajoIniciado(){				var estatusRes;				punto = frn.get("tabla_puntos",-1,"k_punto");				cmdQuery = "select c5 as estatusRes from keplersc.kdpunres " &						"where c1='" & sucursal_id & "' and c2='" & tipo_orden & "' and c3='" & num_orden & "' and c4='" & punto & "'";										rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcargosvarios.validaTrabajoIniciado()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\validaestatusRes");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				estatusRes = getXmlAtt(cuboQuery,"r0","estatusRes");				if (estatusRes &= "10"){					frn.message("No puede dar de baja un registro de Calidad|para un trabajo que no ha sido terminado por el t?cnico|Verifique que el t?cnico haya dado por terminado el trabajo.","Error","Aceptar");					resVal=0;					return;				}				if (estatusRes &= "20"){					frn.message("No se puede dar de baja un registro de Calidad|que no ha sido previamente registrado","Error","Aceptar");					resVal=0;					return;				}			}				fun Ejecuta() {				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;				var resultado, mensaje, folio;				var desc_ope,revisado,revasesTec,reparado,reportec,garantia;					fecha = sys.date();				hora= sys.time();									if (tip_ope &= "A") {								//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok					resVal = 1;					desc_ope ="ALTA";					ValidarDatos();					if(ok &! "1" || resVal == 0){						return;					}					continua = frn.message("?Desea continuar con el Registro de Calidad?","Atenci?n",2);					if (continua == 0){						return;					}									xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;					revisado = frn.get("k_revisado");					revasesTec = frn.get("k_rev_asestec");					reparado = frn.get("k_reparado");					reportec = frn.get("k_reportec");					garantia = frn.get("k_garantia");					if (revisado &="1"){						revisado = "S";					}else{						revisado = "N";					}					if (revasesTec &="1"){						revasesTec = "S";					}else{						revasesTec = "N";					}					if (reparado &="1"){						reparado = "S";					}else{						reparado = "N";					}					if (reportec &="1"){						reportec = "S";					}else{						reportec = "N";					}					if (garantia &="1"){						garantia = "S";					}else{						garantia = "N";					}					setXml(xmlPantalla,"k_revisado",revisado);					setXml(xmlPantalla,"k_revasesTec",revasesTec);					setXml(xmlPantalla,"k_reparado",reparado);					setXml(xmlPantalla,"k_reportec",reportec);					setXml(xmlPantalla,"k_garantia",garantia);					setXml(xmlPantalla,"clave_operario",frn.get("k_mov",-1,"k_clave_operario"));									setXml(xmlPantalla,"operacion",desc_ope);								setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);											frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCalidad");					cmdQuery="SELECT * FROM keplersc.ser_registro_calidad('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					rstXml(cuboQuery);						cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvregistrocalidad.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCalidad");											resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok) {						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}					if(resultado &= "1") {						//tip_ope = "C";			//Se lo quite para que grabe por punto						strMsg = "Alta de Calidad Registrada " & mensaje;						frn.setX("TRABAJO TERMINADO","tabla_puntos", -1,"k_resultados");						ConfiguraControlesOpcion();  						frn.message(strMsg, "Mensaje", "Aceptar");						return;					} else {						frn.message(mensaje, "Error", "Aceptar");						return;					}				}else if (tip_ope &= "B"){					//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok					resVal = 1;					desc_ope ="BAJA";					ValidarDatos();					if(ok &! "1" || resVal == 0){						return;					}					continua = frn.message("?Desea continuar con la Baja del Registro de Calidad?","Atenci?n",2);					if (continua == 0){						return;					}						xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;					setXml(xmlPantalla,"operacion",desc_ope);								setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));						frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCalidadBaja");					cmdQuery="SELECT * FROM keplersc.ser_registro_calidad('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					rstXml(cuboQuery);						cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvregistrocalidad.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCalidad");											resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok) {						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}					if(resultado &= "1") {						//tip_ope = "C";			//Se lo quite para que grabe por punto						strMsg = "Baja de Calidad Realizada" & mensaje;						PreCargaCalidad();						frn.message(strMsg, "Mensaje", "Aceptar");						return;					} else {						frn.message(mensaje, "Error", "Aceptar");						return;					}						}				} 										fun Salir(){				frn.exit(1);			}						fun Garantia(){				if (frn.get("k_garantia") &="1"){					frn.setAtt("k_tipo_orden_garantia", "available", "Y");					frn.setAtt("k_tipo_orden_garantia", "modify", "Y");					frn.setAtt("k_num_orden_garantia", "available", "Y");					frn.setAtt("k_num_orden_garantia", "modify", "Y");				}else{					frn.setAtt("k_tipo_orden_garantia", "available", "N");					frn.setAtt("k_num_orden_garantia", "available", "N");					frn.set("k_tipo_orden_garantia","");					frn.set("k_num_orden_garantia","");				}			}						fun carga_comentarios(cubo){				var comentario,renglones,ncubo,punto,cubo_pto,cubo_par,xmlRow;				renglones = frn.N("tabla_puntos");				ncubo= nXml(cubo);				for (var i=0; i<renglones; i++) {					punto = frn.get("tabla_puntos",i,"k_punto");					for(var j=0;j<ncubo;j++){						xmlRow = getXmlX(cubo,3,j);						cubo_pto = getXmlAtt(cubo,"r"&j,"k_punto");						comentario= getXmlAtt(cubo,"r"&j,"k_resultados");						if (cubo_pto &= punto){							frn.setX(comentario,"tabla_puntos",i,"k_resultados");						}					}				}			}			//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------								fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}				}	</script></pag>