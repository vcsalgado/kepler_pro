<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo"><grp dim="40,20,15,15" 	  brdr="0,0" 	  clr="0,58,112" 	  bclr="192,205,213" 	  fnt="Arial,16" 	  unfont="0" id="Principal"><br/>			<tab/>			<grp bclr="236,240,243" 			fntClrBrdr="236,240,243"			fntBrdr="Arial,18" 			hSpace="4" 			clrBrdr="0,58,112" 			brdr="0,5" 			dim="40,55,9,9" 			tit="Registro de Veh&#237;culo"			fnt="Arial,16">				<tab n="1"/>				<inp id="k_accion" dim="50,1" clr="0,0,0"  type="string" modify="N" available="N" fnt="Arial,22"/>				<br/>				<tab n="1"/>				<hLine clr="0,0,0"/>				<br/><br/>							<tab n="4"/><txt> Sucursal :</txt><tab n="1"/>				<inp id="k_suc" dim="5,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="N" available="N"/>				<br/>				<tab n="4"/><txt>Inventario :</txt><tab n="1"/>				<inp id="k_inventario" dim="10,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="N" available="N"/>				<br/>				<tab n="3"/><txt>   Consecutivo : </txt><tab/>				<inp id="k_consecutivo" dim="8,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="number" modify="N" available="N"/>				<br/>								<tab n="2"/><txt>     Clave Vehicular : </txt><tab n="1"/>				<inp id="k_clave_vehicular" dim="20,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="capital" modify="Y" available="Y"/>				<br/>				<tab n="2"/><txt>   Tipo de Veh&#237;culo : </txt><tab n="1"/>				<inp id="k_tipo_vehiculo" dim="25,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="capital" modify="Y" available="Y"/>				<br/>				<tab n="3"/><txt>   A&#241;o Modelo : </txt><tab n="1"/>				<inp id="k_anio_modelo" dim="8,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="Y"/>				<br/>				<tab n="5"/><txt>  VIN : </txt><tab n="1"/>				<inp id="k_vin" dim="25,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="capital" modify="Y" available="Y"/>				<br/>				<tab n="5"/><txt>  NIV : </txt><tab n="1"/>				<inp id="k_niv" dim="30,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="capital" modify="Y" available="Y"/>				<br/>				<tab n="1"/><txt>   Monto de adquisici&#243;n : </txt><tab n="1"/>				<inp id="k_monto_adq" dim="15,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="number" nd="2" modify="Y" available="Y"/>				<br/>				<tab n="1"/><txt>  Monto de Enajenaci&#243;n : </txt><tab n="1"/>				<inp id="k_monto_ena" dim="15,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="number" nd="2" modify="Y" available="Y"/>				<br/>				<tab n="2"/><txt>   N&#250;mero de motor : </txt><tab n="1"/>				<inp id="k_num_motor" dim="18,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="capital" modify="Y" available="Y"/>				<br/>				<tab n="4"/>				<txt>     Origen :</txt><tab/>				<cmb id="k_origen" dim="16,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y"/>				<br/>				<tab/><txt> N&#250;mero de Importaci&#243;n : </txt><tab n="1"/>				<inp id="k_num_importacion" dim="35,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="capital" modify="Y" available="Y"/>				<br/>				<tab n="1"/><txt>   Fecha de Importaci&#243;n : </txt><tab n="1"/>								<edt id="k_fecha_importacion" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" 				type="date" OnChange="Fecha()" OnButton="Dialog(0,_ks_fecha,k_fecha_importacion)" OnF9="Dialog(0,_ks_fecha,k_fecha_importacion)" modify="Y" available="Y"/><tab/>				<br/>				<tab n="4"/><txt>   Aduana : </txt><tab n="1"/>				<inp id="k_aduana" dim="30,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="capital" modify="Y" available="Y"/>				<br/>				<tab n="4"/><txt>     Marca : </txt><tab n="1"/>				<inp id="k_marca" dim="25,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="capital" modify="Y" available="Y"/>				<br/>				<tab n="2"/><txt>   Valor (Libro Azul) : </txt><tab n="1"/>				<inp id="k_valor_libro_azul" dim="15,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="number" nd="2" modify="Y" available="Y"/>				<br/>				<tab n="9"/><br/><tab n="9"/><bot id="btn_aceptar_A100" dim="9,0" brdr="5" text="Aceptar" OnEnter="Execute(0)" default="0" visible="Y" available="Y"/>				<br/>			<br/>			</grp></grp>	<script>		InstallDriver("KDB75");		class Main {						var sys,frn,kdb,frP,externo,accion,suc_usuario,perfil_usuario,sucursal_id ,v_inventario,tip_ope,cmd,cuboResultados,ok,mensajeError,v_consecutivo ;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();				sys=new SYS;				ctlrs_off();				sucursal_id = trim(frn.param(0)); 				v_inventario = trim(frn.param(1)); 				v_consecutivo = trim(frn.param(2));				accion = trim(frn.param(3));				tip_ope =0;				llenar_ctlrs_default();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				Inicializa();							}						fun Inicializa()			{				if(accion &= "NUEVO"){					cmd = "select c3+1 as c3 from keplersc.kdtomas where c1 = '" & sucursal_id & "' and c2 ='" & v_inventario & "' order by c3 desc limit 1";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.Mostrarseminuevo()");					ok = getXmlAtt(cuboResultados ,"ok");					frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultadosConsuta");					if(getXmlAtt(cuboResultados,"r0","c3")&="")						{						   mensajeError = getXmlAtt(cuboResultados ,"native3");												frn.set("k_suc",frP.get("k_sucn",-1,1));							frn.set("k_inventario", frP.get("k_inventario"));							frn.set("k_consecutivo","1");							return;						}					else if(getXmlAtt(cuboResultados,"r0","c3")&!"")						{															cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.Mostrarseminuevo()");							frn.set("k_suc",frP.get("k_sucn",-1,1));							frn.set("k_inventario", frP.get("k_inventario"));							frn.set("k_consecutivo",getXmlAtt(cuboResultados,"r0","c3"));							frn.setAtt("k_consecutivo","modify","N");													}								}				else if(accion &="EDITAR"){					cmd = "select c1,c2,c3,c4,c5,c6,c7,c8,c9,c10,c11,c12,c13,c14,c16,c17 from keplersc.kdtomas where c1 = '" & sucursal_id & "' and c2 ='" & v_inventario & "' and c3 ='" &v_consecutivo& "' order by c3 desc";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.Mostrarseminuevo()");					frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultadosConsuta");										frn.set("k_suc",getXmlAtt(cuboResultados,"r0","c1"));					frn.set("k_inventario",getXmlAtt(cuboResultados,"r0","c2"));					frn.set("k_consecutivo",getXmlAtt(cuboResultados,"r0","c3"));					frn.set("k_clave_vehicular",getXmlAtt(cuboResultados,"r0","c4"));					frn.set("k_tipo_vehiculo",getXmlAtt(cuboResultados,"r0","c5"));					frn.set("k_anio_modelo",getXmlAtt(cuboResultados,"r0","c6"));					frn.set("k_vin",getXmlAtt(cuboResultados,"r0","c7"));					frn.set("k_niv",getXmlAtt(cuboResultados,"r0","c8"));					frn.set("k_monto_adq",getXmlAtt(cuboResultados,"r0","c9"));					frn.set("k_monto_ena",getXmlAtt(cuboResultados,"r0","c10"));					frn.set("k_num_motor",getXmlAtt(cuboResultados,"r0","c11"));					frn.set("k_num_importacion",getXmlAtt(cuboResultados,"r0","c12"));					frn.set("k_fecha_importacion",getXmlAtt(cuboResultados,"r0","c13"));					frn.set("k_aduana",getXmlAtt(cuboResultados,"r0","c14"));					frn.set("k_marca",getXmlAtt(cuboResultados,"r0","c16"));						frn.set("k_valor_libro_azul",getXmlAtt(cuboResultados,"r0","c17"));					frn.set("k_consecutivo",getXmlAtt(cuboResultados,"r0","c3"));					frn.set("k_accion",accion);					frn.set("k_fecha_importacion",sys.date());					frn.setX("k_suc","sucursal_id");					frn.setX(v_inventario,"k_inventario");					frn.setAtt("k_suc","modify","N");					frn.setAtt("k_inventario","modify","N");					frn.setAtt("k_consecutivo","modify","N");					frn.setAtt("k_fecha_importacion","modify","Y");						frn.setAtt("k_fecha_importacion","available","Y");					frn.setX("Nacional","k_origen",0,0);					frn.setX("N","k_origen",0,1);					frn.setX("Importado","k_origen",1,0);					frn.setX("I","k_origen",1,1);					}				else if(accion &="ELIMINAR"){					cmd = "select c1,c2,c3,c4,c5,c6,c7,c8,c9,c10,c11,c12,c13,c14,c16,c17 from keplersc.kdtomas where c1 = '" & sucursal_id & "' and c2 ='" & v_inventario & "' and c3 ='" &v_consecutivo& "' order by c3 desc";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.Mostrarseminuevo()");					frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultadosConsuta");										frn.set("k_suc",getXmlAtt(cuboResultados,"r0","c1"));					frn.set("k_inventario",getXmlAtt(cuboResultados,"r0","c2"));					frn.set("k_consecutivo",getXmlAtt(cuboResultados,"r0","c3"));					frn.set("k_clave_vehicular",getXmlAtt(cuboResultados,"r0","c4"));					frn.set("k_tipo_vehiculo",getXmlAtt(cuboResultados,"r0","c5"));					frn.set("k_anio_modelo",getXmlAtt(cuboResultados,"r0","c6"));					frn.set("k_vin",getXmlAtt(cuboResultados,"r0","c7"));					frn.set("k_niv",getXmlAtt(cuboResultados,"r0","c8"));					frn.set("k_monto_adq",getXmlAtt(cuboResultados,"r0","c9"));					frn.set("k_monto_ena",getXmlAtt(cuboResultados,"r0","c10"));					frn.set("k_num_motor",getXmlAtt(cuboResultados,"r0","c11"));					frn.set("k_num_importacion",getXmlAtt(cuboResultados,"r0","c12"));					frn.set("k_fecha_importacion",getXmlAtt(cuboResultados,"r0","c13"));					frn.set("k_aduana",getXmlAtt(cuboResultados,"r0","c14"));					frn.set("k_marca",getXmlAtt(cuboResultados,"r0","c16"));						frn.set("k_valor_libro_azul",getXmlAtt(cuboResultados,"r0","c17"));					frn.set("k_consecutivo",getXmlAtt(cuboResultados,"r0","c3"));					frn.set("k_accion",accion);					frn.set("k_fecha_importacion",sys.date());					frn.setX("k_suc","sucursal_id");					frn.setX(v_inventario,"k_inventario");					frn.setAtt("k_suc","modify","N");					frn.setAtt("k_inventario","modify","N");					frn.setAtt("k_consecutivo","modify","N");					frn.setAtt("k_fecha_importacion","modify","Y");						frn.setAtt("k_fecha_importacion","available","Y");					frn.setX("Nacional","k_origen",0,0);					frn.setX("N","k_origen",0,1);					frn.setX("Importado","k_origen",1,0);					frn.setX("I","k_origen",1,1);					}			}									fun ctlrs_off()			{								frn.setAtt("btn_cancelar", "visible", "Y" );				//frn.setAtt("btn_cancelar", "visible", "Y" );				frn.setAtt("btn_aceptar", "visible", "Y" );			}			fun llenar_ctlrs_default()			{				frn.rst("principal");				accion = frn.param(3);				var xmlRequest,					 cmd,					 ok, 					 cuboResultados,					 mensajeError;								frn.setAtt("principal", "tit", accion );								cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_InvPedSug.llenar_ctlrs_default()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				//frn.set("k_sucN",getXml(cuboResultados));							}						fun Validaciones(psOpcion)			{				var 				v_clave_vehicular,				v_Tipo_vehiculo,				v_anio_modelo,				v_vin,				v_niv,				v_monto_adq,				v_monto_ena,				v_num_motor,				v_num_importacion,				v_fecha_importacion,				v_aduana,				v_marca,					v_valor_libro_azul,				v_origen;								v_origen=frn.get("k_origen",-1,1);				v_consecutivo = frn.get("k_consecutivo");				if(v_consecutivo &= ""){					frn.message("El valor del consecutivo está vacío.", "ADVERTENCIA","&Aceptar");					return 0;				}				v_clave_vehicular = frn.get("k_clave_vehicular");				if(v_clave_vehicular &= ""){					frn.message("El valor de la Clave Vehicular está vacío.", "ADVERTENCIA","&Aceptar");					return 0;				}				v_Tipo_vehiculo= frn.get("k_tipo_vehiculo");				if(v_Tipo_vehiculo &= ""){					frn.message("El valor del Tipo Vehículo está vacío.", "ADVERTENCIA","&Aceptar");					return 0;				}				v_anio_modelo= frn.get("k_anio_modelo");				if(v_anio_modelo &= ""){					frn.message("El valor del año de modelo está vacío.", "ADVERTENCIA","&Aceptar");					return 0;				}				v_vin= frn.get("k_vin");				if(v_vin &= ""){					frn.message("El valor VIN está vacío.", "ADVERTENCIA","&Aceptar");					return 0;				}				v_niv= frn.get("k_niv");				if(v_niv &= ""){					frn.message("El valor NIV está vacío.", "ADVERTENCIA","&Aceptar");					return 0;				}				v_monto_adq= frn.get("k_monto_adq");				if(v_monto_adq < 1){					frn.message("El valor del Monto de Adquisición está vacío.", "ADVERTENCIA","&Aceptar");					return 0;				}				v_monto_ena= frn.get("k_monto_ena");				if(v_monto_ena < 1){					frn.message("El valor del Monto de Enajenación está vacío.", "ADVERTENCIA","&Aceptar");					return 0;				}				v_num_motor= frn.get("k_num_motor");				if(v_num_motor &= ""){					frn.message("El valor del Número del motor está vacío.", "ADVERTENCIA","&Aceptar");					return 0;				}				if (v_origen &= "I"){					v_num_importacion= frn.get("k_num_importacion");					if(v_num_importacion &= ""){						frn.message("El valor del Número de importación está vacío.", "ADVERTENCIA","&Aceptar");						return 0;					}					v_fecha_importacion= frn.get("k_fecha_importacion");					if(v_fecha_importacion &= ""){						frn.message("El valor de la Fecha de importación está vacío.", "ADVERTENCIA","&Aceptar");						return 0;					}					v_aduana= frn.get("k_aduana");					if(v_aduana &= ""){						frn.message("El valor Aduana está vacío.", "ADVERTENCIA","&Aceptar");						return 0;					}									}else{					frn.set("","k_aduana");					frn.set("","");				}				v_marca= frn.get("k_marca");				if(v_marca &= ""){					frn.message("El valor de Marca está vacío.", "ADVERTENCIA","&Aceptar");					return 0;				}				v_valor_libro_azul= frn.get("k_valor_libro_azul");				if(v_valor_libro_azul < 1){					frn.message("El valor en Libro Azul está vacío.", "ADVERTENCIA","&Aceptar");					return 0;				}									return 1;			}//end fun Validaciones									fun Execute(pIOpcion)			{				var xmlRequest,						cmd,						ok, 						cuboResultados,						mensajeError,												strTmp,						xmlPantalla,						cubo,						resultado,						mensaje,						tip_ope,						mensaje;														if(pIOpcion == 0) // GUARDAR				{									if(Validaciones()<=0)					{						return;					}										xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;										kdb.rst(cuboResultados);										cuboResultados  = getXml(frn.dataPag()); //Obtener el xml de la pantalla;										frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\sqlXmlResultado_KDTOMAS");					cmd = "SELECT * FROM keplersc.cat_autosaltapedidoseminuevo_crud('<document>" & getXmlStr(cuboResultados,"EOF:13_10") & "</document>')";					kdb.rst(cuboResultados);					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"cat_autosaltapedidoseminuevo.Execute");									ok = getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok)					{											mensajeError = getXmlAtt(cuboResultados,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										resultado= getXml(cuboResultados,"resultado");					mensaje= getXml(cuboResultados,"mensaje");										if(resultado &= "1")					{						frn.message(mensaje, "Proceso terminado.","&Aceptar");					}else{						frn.message(mensaje, "Error","&Aceptar");					}					frP.script("busca_tomas()");					//frP.busca_tomas();					frn.exit();				}	//end opcion 0			}//end fun Execute			fun Fecha(){//Verifica que la fecha del documento sea correcta. Ademï¿½s trae monedas y paridades de esa fecha. 				var cubo, cmd, resValidacion, resMensaje, fecha;				var validDate=frn.lib("libKepler","ValidOpDate",frn.get("k_fecha_importacion"));				kdb.rst();				frn.rst("results");				fecha = fnDate("day", frn.get("k_fecha_importacion")) & "/" & fnDate("month", frn.get("k_fecha_importacion")) & "/" & fnDate("year", frn.get("k_fecha_importacion"));				if (tip_ope == 0 ){					cmd= "select * from keplersc.verify_year('" & fecha & "')";					cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"AltaPedido_Seminuevo_view.Fecha()");									;										resValidacion= getXml(cubo,"validacion","resultado");					resMensaje = getXml(cubo,"validacion","mensaje");					if(resMensaje &! ""){						frn.message(resMensaje, "Mensaje","&Aceptar");					}											if(resValidacion &= "0"){						frn.setPos("k_fecha_importacion");						return;					}									}				//Plazo();			}		}	</script></pag>