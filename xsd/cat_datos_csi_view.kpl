<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Administraci&#243;n de Datos CSI"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab n="2"/>	<txt fnt=",22" clr="0,0,0">Administraci&#243;n de Datos CSI</txt><tab/>        <br/><tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>        <grp  bclr="236,240,243" fntClrBrdr="236,240,243"  unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="82,50,10,10" brdr="0,5" tit="Datos CSI" fnt="Arial,16">			<tab n="1"/><txt clr="0,58,112" hk="S">Sucursal</txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="25,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/>             <tab n="2"/><txt>  A&#241;o: </txt>            <inp id="k_anio" dim="8,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="2" modify="Y" available="Y" fnt="Arial,0" tooltip="A&#241;o"/>            <tab/><txt> Mes: </txt>            <inp id="k_mes" dim="8,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="2" modify="Y" available="Y" fnt="Arial,0" tooltip="Mes"/>            <tab/>            <img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><br/>                    <tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" OnEnter="Exit" OnMouseD="Exit" dim="76,22" modify="N" nren="fijo">				<col id="anio" name="A&#241;o"/>				<col id="mes" name="Mes"/>                <col id="csi_servicio" name="SSI Planta Servicio"/>				<col id="csi_ventas" name="CSI Planta Ventas"/>            </tbl>  <br/>            <tab n="7"/>            <bot id="k_btn_nvo" dim="10,10" brdr="5" text="Nuevo" hk="K" default="0" step="0"  OnEnter="abrir_curd(Nuevo)" fnt="Arial,16b" visible="Y"/>             <bot id="k_btn_mod" dim="10,10" brdr="5" text="Modificar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Modificar)" fnt="Arial,16b" visible="Y"/>             <bot id="k_btn_elimnr" dim="10,10" brdr="5" text="Eliminar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Eliminar)" fnt="Arial,16b" visible="N"/>             <bot id="k_btn_cons" dim="10,10" brdr="5" text="Consultar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Consultar)" fnt="Arial,16b" visible="N"/> <br/>				</grp>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,asterisco ,externo,rol_usuario  ;	      var cmdQuery, cuboQuery, ok, mensajeError,suc,anio,mes,s_csi,v_csi;	        			fun Main(){				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				kdb.connect();					suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								ctrls_off();								Inicializa();			}						fun ctrls_off(){				frn.setAtt("k_btn_nvo", "visible", "N");				frn.setAtt("k_btn_mod", "visible", "N");				frn.setAtt("k_btn_elimnr", "visible", "N");				frn.setAtt("k_btn_cons", "visible", "N");						}            fun llena_combos(){            					//Llenar combo sucursales					var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";					if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){						cmd = cmd & " where c1='" & suc_usuario & "'";					}else {						if (suc_usuario &! asterisco && suc_usuario &! "" ){							cmd = cmd & " where c1='" & suc_usuario & "'";						}						}									var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");							ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}											frn.set("k_sucn",getXml(cubo));  										    }		    			fun Inicializa(){				externo = frn.param(0);				if (externo &! "s"){					frn.setAtt("k_btn_nvo", "visible", "Y");					frn.setAtt("k_btn_mod", "visible", "Y");					frn.setAtt("k_btn_elimnr", "visible", "N");					frn.setAtt("k_btn_cons", "visible", "N");				}            llena_combos();        			}						fun Buscar() {				var xmlRequest,cmd,ok,cuboResultados,tot,cont;				suc = frn.get("k_sucn",-1,1);	                anio = frn.get("k_anio");                mes = frn.get("k_mes");				cmd = "select anio,mes,sum(val_s) as scsi, sum(val_v) as vcsi " & 				"from (select c2 as anio,c3 as mes, c5 as val_s,0 as val_v from keplersc.kdscsi where c1='" & suc &"' " &				"union " &				"select c2 as anio,c3 as mes,0 as val_s,c5 as val_v from keplersc.kdvcsi where c1='" & suc &"') as datos";				if (anio &! ""){					cmd = "select anio,mes,sum(val_s) as scsi, sum(val_v) as vcsi " & 						"from (select c2 as anio,c3 as mes, c5 as val_s,0 as val_v from keplersc.kdscsi where c1='" & suc & "' and c2='" & anio & "' " & 						"union " &						"select c2 as anio,c3 as mes,0 as val_s,c5 as val_v from keplersc.kdvcsi where c1='" & suc & "' and c2='" & anio & "') as datos";                }                if  (anio &= "" && mes &! ""){	                cmd = "select anio,mes,sum(val_s) as scsi, sum(val_v) as vcsi " & 					"from (select c2 as anio,c3 as mes, c5 as val_s,0 as val_v from keplersc.kdscsi where c1='" & suc & "' and c3=lpad('" & mes & "',2,'0') " &					"union " &					"select c2 as anio,c3 as mes,0 as val_s,c5 as val_v from keplersc.kdvcsi where c1='" & suc & "' and c3=lpad('" & mes & "',2,'0')) as datos";                }				if  (anio &! "" && mes &! ""){	                cmd = "select anio,mes,sum(val_s) as scsi, sum(val_v) as vcsi " & 					"from (select c2 as anio,c3 as mes, c5 as val_s,0 as val_v from keplersc.kdscsi where c1='" & suc & "' and c2='" & anio & "' and c3=lpad('" & mes & "',2,'0') " &					"union " &					"select c2 as anio,c3 as mes,0 as val_s,c5 as val_v from keplersc.kdvcsi where c1='" & suc & "' and c2='" & anio & "' and c3=lpad('" & mes & "',2,'0')) as datos";                }                				cmd = cmd & " group by anio,mes order by anio,mes";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_datos_csi_view.Buscar()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								tot = nXml(cuboResultados);							frn.rst("tabla");				for (cont=0; cont<tot; cont++){					frn.setX(getXmlAtt(cuboResultados,"r"&cont,"anio"),"tabla",cont,"anio");					frn.setX(getXmlAtt(cuboResultados,"r"&cont,"mes"),"tabla",cont,"mes");                    frn.setX(getXmlAtt(cuboResultados,"r"&cont,"scsi"),"tabla",cont,"csi_servicio");                    frn.setX(getXmlAtt(cuboResultados,"r"&cont,"vcsi"),"tabla",cont,"csi_ventas");				}				}									fun abrir_curd(accion){				suc = frn.get("k_sucn",-1,1);					if (accion &! "Nuevo"){					var param = frn.get("tabla", -1, "anio");                    mes =frn.get("tabla", -1, "mes");                    s_csi=frn.get("tabla", -1, "csi_servicio");                    v_csi=frn.get("tabla", -1, "csi_ventas");					if (param &= ""){						frn.message("No has seleccionado un registro","Error","Aceptar");					}else{						frn.dialog("cat_crud_datos_csi",accion, param, "n",suc,mes,s_csi,v_csi);					}				}else {					frn.dialog("cat_crud_datos_csi", accion, "x", "n",suc,mes,s_csi,v_csi);				}			}					}	</script></pag>