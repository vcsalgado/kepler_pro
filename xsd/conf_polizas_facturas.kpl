<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	    <tab/><txt fnt=",22" clr="0,0,0">Configuracion de polizas para facturas</txt><br/>	    <tab/><hLine clr="0,0,0"/> 	    <br/> <br/><tab/>		<grp dim="120,6,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Factura XML"><tab/><txt>Tipo factura:  </txt><tab/>			<cmb id="k_tipon" dim="52,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiarTipo()"/>			<br/>			<sp n="1"/><tab/>			<bot id="Buscar" dim="12,0" brdr="5" OnEnter="ObtenerFactura()" tooltip="Busca UUID de la factura" available="Y" visible="Y" text="Seleccionar"/><tab/>						<inp id="k_refer" clr="64,64,64" clrBrdr="255,255,255"  dim="65,1" bclr="255,255,255" brdr="2,0" nc="40" fnt="Arial,16" type="capital"  modify="Y" 				 tooltip="Factura" available="N"/>				</grp>			<br/><br/>	      <tab/>			<grp dim="120,54,7,12" bclr="236,240,243" brdr="0,5" 			clrBrdr="0,58,112" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" fnt=",0" tit="Configuracion">			<grp dim="80,15,7,12"><tab/>				<txt clr="0,58,112">Impuestos encontrados en  Xml:</txt><br/>				<tab/>				<tbl id="k_impuestos" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" 					bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="75,10"  hk="z"  Reorder="N" modify="N" available="Y"					OnMouseD="AgregarCuenta()">										<col id="id_concepto" name="Clave"  type="string"  visible="Y"/> 					<col id="desc_concepto" name="Descripcion"  type="string"  visible="Y"/> 					<col id="monto" name="Importe" nd="2" type="number" modify="N" visible="Y"/>				</tbl>						</grp>			<tab n="1"/>			<grp dim="80,15,7,12">				<br/> <txt fnt=",16b">Importe xml :</txt><tab/>             <inp id="k_uuid_monto" clr="64,64,64"  dim="15,1" fnt=",16b" type="number" nd="2" modify="N" available="Y" clrBrdr="255,255,255"/>				<br/><br/>				<txt>Id Tipo: </txt><tab n="2"/>				<inp id="k_clave" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="15" available="Y" modify="Y"/>				<br/><br/>				<txt>Descripcion: </txt><tab/>				<inp id="k_descripcion" dim="50,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="50" available="Y" modify="Y"/>							</grp>         <br/>         <tab/>         <grp dim="160,38,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<ratio id="rb_provision" dim="2,16" clr="64,64,64" bclr="255,255,255"/>				<txt clr="0,58,112" fnt=",b">Provision:</txt><tab n="4"/><txt>[Doble click cambia valores C/A o S/N]</txt><br/>				<tbl id="k_provision" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" 				bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="160,10"  hk="z"  Reorder="N" available="Y">						<col id="id_concepto" name="Concepto"  type="string"  visible="Y" modify="N"/> 					<col id="cve_cuenta" name="Cuenta" type="capital" visible="Y" OnF9="selecciona_cuenta(k_provision)" OnChange="cuenta(k_provision)"/> 			      <col id="desc_cuenta" name="Nombre Cuenta" type="capital" visible="Y"/> 			      <col id="tipo_asiento" name="Asiento" type="capital" visible="Y" modify="N" OnMouseD="sel_generico(k_provision,tipo_asiento,C,A)" OnChange="ValidaValor(k_provision,tipo_asiento,C,A)"/>			      <col id="complemento" name="Complemento" type="capital" visible="Y" OnMouseD="sel_complemento(k_provision)" modify="N"/>               <col id="cuenta_gpo" name="Modificable" tooltip="Se puede cambiar la cuenta excepto el nivel mayor" type="capital" visible="Y" modify="N" OnMouseD="sel_generico(k_provision,cuenta_gpo,S,N)" OnChange="ValidaValor(k_provision,cuenta_gpo,S,N)"/>               <col id="cuenta_divisible" name="Prorrateo" tooltip="El importe del concepto se puede dividir en diferentes cuentas." type="capital" visible="Y" modify="N" OnMouseD="sel_generico(k_provision,cuenta_divisible,S,N)" OnChange="ValidaValor(k_provision,cuenta_divisible,S,N)"/>               <col id="campo_cuenta_plantilla" name="Cta. Plant." tooltip="Campo en platilla con la cuenta a aplicar" type="capital" visible="Y" modify="N" OnMouseD="selecciona_campo_plantilla(k_provision)" OnF9="selecciona_campo_plantilla(k_provision)"/>               <col id="descripcion_partida" name="Desc. Partida" tooltip="Descripcion de la partida en la poliza" type="capital" visible="Y" modify="N" OnMouseD="selecciona_desc_cta(k_provision)" OnF9="selecciona_desc_cta(k_provision)"/>					<col id="costo_inventario" name="Costo Inv." tooltip="Afecta al inventario" type="capital" visible="Y" modify="N" OnMouseD="sel_generico(k_provision,costo_inventario,S,N)" OnChange="ValidaValor(k_provision,costo_inventario,S,N)"/>               <col id="monto_cargo" name="Cargo" nd="2" type="number" modify="N"/>               <col id="monto_abono" name="Abono" type="number" nd="2" modify="N"/>				</tbl>				<br/><txt>Total Cargos : </txt>                <inp id="total_cargos_prov" clr="64,64,64"  dim="15,1" nd="2" fnt="Arial,16" type="number"  modify="N" available="Y"/>				<tab/><txt>Total Abonos:</txt> 				<inp id="total_abonos_prov" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="Y" OnChange="CalculaTotales(1)"/>				<tab/>				<inp id="inp_mensaje_provision" dim="60,1" clr="198,57,85" clrBrdr="255,255,255" type="string" visible="N"/>				<br/><br/>				<ratio id="rb_pago" dim="2,16" clr="64,64,64" bclr="255,255,255"/><tab/>				<txt clr="0,58,112" fnt=",b">Pago:</txt><tab n="5"/><txt>[Doble click cambia valores C/A o S/N]</txt><br/>				<tbl id="k_pago" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" 					bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="160,10"  hk="z"  Reorder="N" available="Y">					<col id="id_concepto" name="Concepto"  type="string"  visible="Y" modify="N"/> 					<col id="cve_cuenta" name="Cuenta" type="capital" visible="Y" OnF9="selecciona_cuenta(k_pago)" OnChange="cuenta(k_pago)"/> 			      <col id="desc_cuenta" name="Nombre Cuenta" type="capital" visible="Y"/> 			      <col id="tipo_asiento" name="Asiento" type="capital" visible="Y" modify="N" OnMouseD="sel_generico(k_pago,tipo_asiento,C,A)" OnChange="ValidaValor(k_pago,tipo_asiento,C,A)"/>			      <col id="complemento" name="Complemento" type="capital" visible="Y" OnMouseD="sel_complemento(k_pago)" modify="N"/>               <col id="cuenta_gpo" name="Modificable" type="capital" visible="Y" modify="N" OnMouseD="sel_generico(k_pago,cuenta_gpo,S,N)" OnChange="ValidaValor(k_pago,cuenta_gpo,S,N)"/>			                     <col id="cuenta_divisible" name="Prorrateo" tooltip="El importe del concepto se puede dividir en diferentes cuentas." type="capital" visible="Y" modify="N" OnMouseD="sel_generico(k_pago,cuenta_divisible,S,N)" OnChange="ValidaValor(k_pago,cuenta_divisible,S,N)"/>               <col id="campo_cuenta_plantilla" name="Cta. Plant." tooltip="Campo en platilla con la cuenta a aplicar" type="capital" visible="Y" modify="N" OnMouseD="selecciona_campo_plantilla(k_pago)" OnF9="selecciona_campo_plantilla(k_pago)"/>               <col id="descripcion_partida" name="Desc. partida" tooltip="Descripcion de la cuenta en la poliza" type="capital" visible="Y" modify="N" OnMouseD="selecciona_desc_cta(k_pago)" OnF9="selecciona_desc_cta(k_pago)"/>					<col id="costo_inventario" name="Costo Inv." tooltip="Afecta al inventario" type="capital" visible="Y" modify="N" OnMouseD="sel_generico(k_pago,costo_inventario,S,N)" OnChange="ValidaValor(k_pago,costo_inventario,S,N)"/>               <col id="monto_cargo" name="Cargo" nd="2" type="number" modify="N"/>               <col id="monto_abono" name="Abono" type="number" nd="2" modify="N"/>				</tbl>				<br/><txt>Total Cargos : </txt>                <inp id="total_cargos_pago" clr="64,64,64"  dim="15,1" nd="2" fnt="Arial,16" type="number"  modify="N" available="Y"/>				<tab/><txt>Total Abonos:</txt> 				<inp id="total_abonos_pago" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="Y" OnChange="CalculaTotales(1)"/>				<tab n="2"/><inp id="inp_mensaje_pago" dim="60,1" clr="198,57,85" clrBrdr="255,255,255" type="string" visible="N"/>				            </grp>    		</grp><br/>		<tab/>			<grp dim="120,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">						<grp dim="70,15,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">							<sp n="1"/><tab/>			</grp>			<tab/>			<grp dim="80,13,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16"><tab n="18"/>				<img id="Cancelar" dim="35,35" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="borrar_datos()" tooltip="Cancelar / Limpiar" available="Y" clrBrdr="0,0,0" visible="N"/>				<sp n="3"/>				<img id="Aceptar" dim="35,35" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			</grp>						<br/>											   		</grp>			<br/>		<br/>							</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario,asterisco,anio_contable;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, cliente_id , refer_id, resVal;						var  saldo, cargos_factura, abonos_factura, cargos_iva_factura, abonos_iva_factura;			var fecha_baja, estatus_doc,gendocto,natdocto,gpodocto,tipdocto,tabla,len_result;						var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, uen;                  var row_grid, err_data, err_empty;			// Vart Reports			var cmd, xmlResQuery, strTmp;			var sucursal, fech_oper, tipo_auto, xmlPar;						//Variables validacion factura			var str_uuid, fecha_uuid, total_uuid, impuesto_uuid, folio_uuid;			var retisr_uuid, retiva_uuid;			var trasiva_uuid, trasieps_uuid, totalimptosret_uuid, totalimptostras_uuid, subtotal_uuid,impuestosLocalRet_uuid,impuestosLocalTras_uuid; 											fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = mid(fnDate("year",sys.date()),2);				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";				suc_usuario = frn.lib("libKepler","UserInfo(1)");								fileSavePath = "C:\Basura";				Inicializa();								ConfiguraControlesOpcion();			}			fun selecciona_desc_cta(tabla_ui){				cmdQuery="select * from(select '' as valor union " &					"select 'NOMBRE CUENTA' as valor union " & 					"select 'INVENTARIO' as valor union " &					"select 'SERIE' as valor union " &					"select 'PROVEEDOR' as valor union " &					"select 'SERIE/PROVEEDOR' as valor " &										") as sub1 order by valor ";								frn.dialog("genlistafiltrosel","Descripcion cuenta partida",cmdQuery ,"valor",tabla_ui,"", "descripcion_partida","N");			}					//Carga el modelo de factura seleccionado			fun CambiarTipo(){				var id_tipo_factura, conceptos, strValor, concepto, monto, ;				var renCurr, renDet, cont, cargosCuenta, abonosCuenta, tipoAsiento;				var renConcepto, totalConceptos, montoConcepto, impuestoConcepto, impuestoTabla;								frn.setAtt("k_clave","available","N");				frn.setAtt("k_descripcion","available","N");				frn.setAtt("k_clave","modify","N");				frn.setAtt("k_descripcion","modify","N");												id_tipo_factura=frn.get("k_tipon",-1,1);				if (id_tipo_factura &= "SINDEF"){ return; }				limpiar_datos_uuid();				if (id_tipo_factura &= "NUEVO"){					frn.setAtt("k_clave","available","Y");					frn.setAtt("k_descripcion","available","Y");					frn.setAtt("k_clave","modify","Y");					frn.setAtt("k_descripcion","modify","Y");					return; 				}								//conf_polizas_facturas_mst				cmdQuery="select id_tipo_factura, descripcion_factura, tipo_poliza, descripcion_poliza, referencia_poliza, conceptos_origen " & 					"from keplersc.conf_polizas_facturas_mst " & 					"where id_tipo_factura='" & id_tipo_factura & "' ";									frn.lib("libGeneral.kpl","FileSave",cmdQuery ,"C:\Basura\cmdConceptosTipo");				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conf_polizas_facturas.ObtenerFactura()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery ,"C:\Basura\cuboConceptosTipo");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								strValor=getXmlAtt(cuboQuery,"r0","id_tipo_factura");				frn.set("k_clave",strValor);				strValor=getXmlAtt(cuboQuery,"r0","descripcion_factura");				frn.set("k_descripcion",strValor);								conceptos=getXmlAtt(cuboQuery,"r0","conceptos_origen");				var len_cadena = strSplit(conceptos,"|", -1);													for (var z=0,w=len_cadena;z<w;z++){					strValor=strSplit(conceptos,"|", z);					concepto=strSplit(strValor,"=", 0);					monto=strSplit(strValor,"=", 1);					frn.setX(concepto,"k_impuestos",z,"id_concepto");					frn.setX(monto,"k_impuestos",z,"monto");				}								//Conf_polizas_facturas_det	PROV				cmdQuery="select det.id_concepto, coalesce(det.cuenta,'NO EXISTE') as cve_cuenta, dc.c2 as desc_cuenta, det.tipo_asiento, det.complemento_cuenta as complemento, " & 					"det.cuenta_grupo as cuenta_gpo, det.cuenta_divisible, det.campo_cuenta_plantilla, det.descripcion_partida as descripcion_partida, det.costo_inventario, 0 as monto_cargo, 0 as monto_abono " & 					"from keplersc.conf_polizas_facturas_det det left outer join keplersc.kdc125 dc on dc.c1=det.cuenta " & 					"where id_tipo_factura='" & id_tipo_factura & "' and tipo_movto='PROV' ";									frn.lib("libGeneral.kpl","FileSave",cmdQuery ,"C:\Basura\cmdFactDet");				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conf_polizas_facturas.ObtenerFactura()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery ,"C:\Basura\cuboFactDet");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.setX(cuboQuery,"k_provision");				renDet=frn.N("k_provision");				for (renCurr=0; renCurr < renDet; renCurr++){					cargosCuenta=frn.get("k_provision",renCurr,"monto_cargo");					abonosCuenta=frn.get("k_provision",renCurr,"monto_abono");					tipoAsiento=frn.get("k_provision",renCurr,"tipo_asiento");					impuestoTabla= frn.get("k_provision",renCurr,"id_concepto");					totalConceptos = frn.N("k_impuestos");					for (renConcepto=0; renConcepto<totalConceptos ; renConcepto++){						impuestoConcepto= frn.get("k_impuestos",renConcepto,"id_concepto");						montoConcepto=frn.get("k_impuestos",renConcepto,"monto"); 						if (impuestoConcepto &= impuestoTabla){							frn.setX(0,"k_provision",renCurr,"monto_cargo");							frn.setX(0,"k_provision",renCurr,"monto_abono");							if (tipoAsiento &= "C"){								frn.setX(montoConcepto,"k_provision",renCurr,"monto_cargo");														}else{								frn.setX(montoConcepto,"k_provision",renCurr,"monto_abono");							}							break;						}					}				}				CalculaTotales("k_provision","total_cargos_prov","total_abonos_prov");				//Conf_polizas_facturas_det	PAGO				cmdQuery="select det.id_concepto, coalesce(det.cuenta,'NO EXISTE') as cve_cuenta, dc.c2 as desc_cuenta, det.tipo_asiento, det.complemento_cuenta as complemento, " & 					"det.cuenta_grupo as cuenta_gpo, det.cuenta_divisible, det.campo_cuenta_plantilla, det.descripcion_partida as descripcion_partida, det.costo_inventario, 0 as monto_cargo, 0 as monto_abono " & 					"from keplersc.conf_polizas_facturas_det det left outer join keplersc.kdc125 dc on dc.c1=det.cuenta " & 					"where id_tipo_factura='" & id_tipo_factura & "' and tipo_movto='PAGO' ";									frn.lib("libGeneral.kpl","FileSave",cmdQuery ,"C:\Basura\cmdFactDetPago");				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conf_polizas_facturas.ObtenerFactura()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery ,"C:\Basura\cuboFactDetPAgo");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.setX(cuboQuery,"k_pago");				renDet=frn.N("k_pago");				for (renCurr=0; renCurr < renDet; renCurr++){					cargosCuenta=frn.get("k_pago",renCurr,"monto_cargo");					abonosCuenta=frn.get("k_pago",renCurr,"monto_abono");					tipoAsiento=frn.get("k_pago",renCurr,"tipo_asiento");					impuestoTabla= frn.get("k_pago",renCurr,"id_concepto");					totalConceptos = frn.N("k_impuestos");					for (renConcepto=0; renConcepto<totalConceptos ; renConcepto++){						impuestoConcepto= frn.get("k_impuestos",renConcepto,"id_concepto");						montoConcepto=frn.get("k_impuestos",renConcepto,"monto"); 						if (impuestoConcepto &= impuestoTabla){							frn.setX(0,"k_pago",renCurr,"monto_cargo");							frn.setX(0,"k_pago",renCurr,"monto_abono");							if (tipoAsiento &= "C"){								frn.setX(montoConcepto,"k_pago",renCurr,"monto_cargo");														}else{								frn.setX(montoConcepto,"k_pago",renCurr,"monto_abono");							}							break;						}					}				}				CalculaTotales("k_pago","total_cargos_pago","total_abonos_pago");			}			fun AgregarCuenta(){				var ren;				if(frn.get("rb_provision") == 1){					ren = frn.N("k_provision");					ren=ren-1;					frn.setX(frn.get("k_impuestos",-1,"id_concepto"),"k_provision",ren,"id_concepto");					frn.setX("0","k_provision",ren,"monto_cargo");					frn.setX("0","k_provision",ren,"monto_abono");					frn.setX("N","k_provision",ren,"cuenta_gpo");				}								if(frn.get("rb_pago") == 1){					ren = frn.N("k_pago");					ren=ren-1;					frn.setX(frn.get("k_impuestos",-1,"id_concepto"),"k_pago",ren,"id_concepto");					frn.setX("0","k_pago",ren,"monto_cargo");					frn.setX("0","k_pago",ren,"monto_abono");					frn.setX("N","k_pago",ren,"cuenta_gpo");									}			}			fun ValidarPolizas(){				var renConceptos, renProv, renPagos, cargosCuenta, abonosCuenta, totalCargos, totalAbonos, renCurr, errores, mensajeErr;				var faltanCuentas, currCuenta, renCont, conceptoImptos, conceptoCtas;				errores=0;				mensajeErr = "";				faltanCuentas = 0;				frn.setAtt("inp_mensaje_provision","visible","N");				frn.setAtt("inp_mensaje_pago","visible","N");												renProv = frn.N("k_provision");								totalCargos=0;				totalAbonos=0;				for (renCurr=0; renCurr < renProv; renCurr++){					cargosCuenta=frn.get("k_provision",renCurr,"monto_cargo");					abonosCuenta=frn.get("k_provision",renCurr,"monto_abono");					totalCargos=totalCargos + cargosCuenta;					totalAbonos=totalAbonos + abonosCuenta;					currCuenta = frn.get("k_provision",renCurr,"cve_cuenta");					if ((cargosCuenta !=0 || abonosCuenta !=0) && currCuenta==""){						faltanCuentas=1;						errores=1;					}				}								if (faltanCuentas == 1){					mensajeErr = mensajeErr & "Conceptos sin cuentas. ";				}								if (totalCargos != totalAbonos){					mensajeErr = mensajeErr & "Poliza descuadrada. ";					errores = 1;				}				if (totalCargos == 0 && totalAbonos ==0){					mensajeErr = mensajeErr & "Conceptos sin cuentas. ";					errores = 1;				}/*								for(renCont=0; renCont<frn.N("k_impuestos"); renCont++){					conceptoImptos=frn.get("k_impuestos",renCont,"id_concepto");					faltanCuentas=1;					for (renCurr=0; renCurr < renProv; renCurr++){						conceptoCtas=frn.get("k_provision",renCurr,"id_concepto");						if (conceptoImptos &= conceptoCtas){							faltanCuentas=0;							break;						}					}						if (faltanCuentas==1){						break;					}				}				if (faltanCuentas==1){					errores=1;					mensajeErr = mensajeErr & "Conceptos sin asignar. ";									}*/				if (errores==1){					frn.setAtt("inp_mensaje_provision","visible","Y");					frn.set("inp_mensaje_provision",mensajeErr);				}								// Valida seccion de pagos				renPagos = frn.N("k_pago");				mensajeErr = "";				totalCargos=0;				totalAbonos=0;				faltanCuentas = 0;				for (renCurr=0; renCurr < renPagos; renCurr++){					cargosCuenta=frn.get("k_pago",renCurr,"monto_cargo");					abonosCuenta=frn.get("k_pago",renCurr,"monto_abono");					totalCargos=totalCargos + cargosCuenta;					totalAbonos=totalAbonos + abonosCuenta;					currCuenta = frn.get("k_pago",renCurr,"cve_cuenta");					if ((cargosCuenta !=0 || abonosCuenta !=0) && currCuenta==""){						faltanCuentas=1;						errores=1;					}				}								if (faltanCuentas == 1){					mensajeErr = mensajeErr & "Conceptos sin cuentas. ";				}								if (totalCargos != totalAbonos){					mensajeErr = mensajeErr & "Poliza descuadrada. ";					errores = 1;				}				if (totalCargos == 0 && totalAbonos ==0){					mensajeErr = mensajeErr & "Conceptos sin cuentas. ";					errores = 1;				}/*								for(renCont=0; renCont<frn.N("k_impuestos"); renCont++){					conceptoImptos=frn.get("k_impuestos",renCont,"id_concepto");					faltanCuentas=1;					for (renCurr=0; renCurr < renProv; renCurr++){						conceptoCtas=frn.get("k_pago",renCurr,"id_concepto");						if (conceptoImptos &= conceptoCtas){							faltanCuentas=0;							break;						}					}						if (faltanCuentas==1){						break;					}				}				if (faltanCuentas==1){					errores=1;					mensajeErr = mensajeErr & "Conceptos sin asignar. ";									}*/				if (errores==1){					frn.setAtt("inp_mensaje_pago","visible","Y");					frn.set("inp_mensaje_pago",mensajeErr);				}								return errores;			}						fun Inicializa(){				var tmpval;				LlenaCmbTipo();				CambiarTipo();			}						fun LlenaCmbTipo(){				var totReg;				cmdQuery = "select descripcion_factura,id_tipo_factura from keplersc.conf_polizas_facturas_mst where id_tipo_factura <> 'SINDEF' order by id_tipo_factura" ;				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conf_polizas_facturas.Inicializa()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboTipoDocto");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error BD","Aceptar");					return;				}				frn.set("k_tipon",getXml(cuboQuery));				totReg = frn.N("k_tipon");				frn.setX("NUEVO","k_tipon",totReg,0);				frn.setX("NUEVO","k_tipon",totReg,1);			}						fun ObtenerFactura(){				var nCampos, uuid="";				var ctd_mov,j,id_concepto,desc_concepto;							limpiar_datos_uuid();							uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID","k_refer", 0,"0");				nCampos = strSplit(uuid,"|",-1);				if (nCampos > 1) {					str_uuid = strSplit(uuid,"|",0);		  //UUID					fecha_uuid = strSplit(uuid,"|",2);	  //fecha					total_uuid = strSplit(uuid,"|",3);	  //monto de la factura										impuesto_uuid = strSplit(uuid,"|",12); //impuesto total										totalimptostras_uuid= strSplit(uuid,"|",9); //impuesto trasladado total						retisr_uuid = strSplit(uuid,"|",10); //retencion isr					retiva_uuid = strSplit(uuid,"|",11); //retencion iva										trasiva_uuid = strSplit(uuid,"|",12); //trasladado iva					trasieps_uuid = strSplit(uuid,"|",13); //trasladado ieps										totalimptosret_uuid = strSplit(uuid,"|",14); //trasladado iva					impuestosLocalRet_uuid= strSplit(uuid,"|",15); //Local Retenido					impuestosLocalTras_uuid= strSplit(uuid,"|",16); //Local trasladdo										subtotal_uuid= strSplit(uuid,"|",17); //subtotal factur									if (strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {						frn.set("k_refer","");						frn.message("No se pudieron obtener todos los datos mandatorios del UUID.","Error","Aceptar");											} else {											frn.set("k_refer",str_uuid);												frn.set("k_uuid_monto",total_uuid);						frn.set("k_uuid_impuesto",impuesto_uuid);						frn.set("k_iva",impuesto_uuid);														cmdQuery="select id_concepto, descripcion from keplersc.conf_polizas_facturas_conceptos";													frn.lib("libGeneral.kpl","FileSave",cmdQuery ,"C:\Basura\cuboqueryconceptos");						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conf_polizas_facturas.ObtenerFactura()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery ,"C:\Basura\cuboConceptos");										ok=getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cuboQuery,"native3");							frn.message(mensajeError,"Error","Aceptar");							return;						}								ctd_mov = nXml(cuboQuery);						j=0;						for (var i=0,n=ctd_mov ;i<n;i++) {							id_concepto =getXmlAtt(cuboQuery, "r"&i","id_concepto");							desc_concepto =getXmlAtt(cuboQuery, "r"&i,"descripcion");							frn.setX("N","k_provision", j, "cuenta_gpo");							frn.setX("N","k_pago", j, "cuenta_gpo");							if (id_concepto &="subtotal"){								if (subtotal_uuid > 0){									frn.setX(id_concepto,"k_impuestos", j, "id_concepto");									frn.setX(desc_concepto,"k_impuestos", j, "desc_concepto");									frn.setX(subtotal_uuid,"k_impuestos", j, "monto");									frn.setX(id_concepto,"k_provision", j, "id_concepto");									frn.setX(id_concepto,"k_pago", j, "id_concepto");									frn.setX(0,"k_provision", j, "monto_cargo");									frn.setX(0,"k_provision", j, "monto_abono");									frn.setX(0,"k_pago", j, "monto_cargo");									frn.setX(0,"k_pago", j, "monto_abono");									j=j+1;								}							}							if (id_concepto &="iva_ret"){								if (retiva_uuid > 0){									frn.setX(id_concepto,"k_impuestos", j, "id_concepto");									frn.setX(desc_concepto,"k_impuestos", j, "desc_concepto");									frn.setX(retiva_uuid,"k_impuestos", j, "monto");									frn.setX(id_concepto,"k_provision", j, "id_concepto");									frn.setX(id_concepto,"k_pago", j, "id_concepto");									frn.setX(0,"k_provision", j, "monto_cargo");									frn.setX(0,"k_provision", j, "monto_abono");									frn.setX(0,"k_pago", j, "monto_cargo");									frn.setX(0,"k_pago", j, "monto_abono");									j=j+1;								}							}							if (id_concepto &="isr_ret"){								if (retisr_uuid > 0){									frn.setX(id_concepto,"k_impuestos", j, "id_concepto");									frn.setX(desc_concepto,"k_impuestos", j, "desc_concepto");									frn.setX(retisr_uuid,"k_impuestos", j, "monto");									frn.setX(id_concepto,"k_provision", j, "id_concepto");									frn.setX(id_concepto,"k_pago", j, "id_concepto");									frn.setX(0,"k_provision", j, "monto_cargo");									frn.setX(0,"k_provision", j, "monto_abono");									frn.setX(0,"k_pago", j, "monto_cargo");									frn.setX(0,"k_pago", j, "monto_abono");									j=j+1;								}							}							if (id_concepto &="iva_tras"){								if (trasiva_uuid > 0){									frn.setX(id_concepto,"k_impuestos", j, "id_concepto");									frn.setX(desc_concepto,"k_impuestos", j, "desc_concepto");									frn.setX(trasiva_uuid,"k_impuestos", j, "monto");									frn.setX(id_concepto,"k_provision", j, "id_concepto");									frn.setX(id_concepto,"k_pago", j, "id_concepto");																		frn.setX(0,"k_provision", j, "monto_cargo");									frn.setX(0,"k_provision", j, "monto_abono");									frn.setX(0,"k_pago", j, "monto_cargo");									frn.setX(0,"k_pago", j, "monto_abono");									j=j+1;								}							}							if (id_concepto &="ieps_tras"){								if (trasieps_uuid > 0){									frn.setX(id_concepto,"k_impuestos", j, "id_concepto");									frn.setX(desc_concepto,"k_impuestos", j, "desc_concepto");									frn.setX(trasieps_uuid,"k_impuestos", j, "monto");									frn.setX(id_concepto,"k_provision", j, "id_concepto");									frn.setX(id_concepto,"k_pago", j, "id_concepto");																		frn.setX(0,"k_provision", j, "monto_cargo");									frn.setX(0,"k_provision", j, "monto_abono");									frn.setX(0,"k_pago", j, "monto_cargo");									frn.setX(0,"k_pago", j, "monto_abono");									j=j+1;								}							}							if (id_concepto &="impto_ced"){								if (impuestosLocalRet_uuid > 0){									frn.setX(id_concepto,"k_impuestos", j, "id_concepto");									frn.setX(desc_concepto,"k_impuestos", j, "desc_concepto");									frn.setX(impuestosLocalRet_uuid,"k_impuestos", j, "monto");									frn.setX(id_concepto,"k_provision", j, "id_concepto");									frn.setX(id_concepto,"k_pago", j, "id_concepto");																		frn.setX(0,"k_provision", j, "monto_cargo");									frn.setX(0,"k_provision", j, "monto_abono");									frn.setX(0,"k_pago", j, "monto_cargo");									frn.setX(0,"k_pago", j, "monto_abono");									j=j+1;								}							}							if (id_concepto &="impto_cedT"){								if (impuestosLocalTras_uuid > 0){									frn.setX(id_concepto,"k_impuestos", j, "id_concepto");									frn.setX(desc_concepto,"k_impuestos", j, "desc_concepto");									frn.setX(impuestosLocalTras_uuid,"k_impuestos", j, "monto");									frn.setX(id_concepto,"k_provision", j, "id_concepto");									frn.setX(id_concepto,"k_pago", j, "id_concepto");																		frn.setX(0,"k_provision", j, "monto_cargo");									frn.setX(0,"k_provision", j, "monto_abono");									frn.setX(0,"k_pago", j, "monto_cargo");									frn.setX(0,"k_pago", j, "monto_abono");									j=j+1;								}															}							if (id_concepto &="total"){								if (total_uuid > 0){									frn.setX(id_concepto,"k_impuestos", j, "id_concepto");									frn.setX(desc_concepto,"k_impuestos", j, "desc_concepto");									frn.setX(total_uuid,"k_impuestos", j, "monto");									frn.setX(id_concepto,"k_provision", j, "id_concepto");									frn.setX(id_concepto,"k_pago", j, "id_concepto");																		frn.setX(0,"k_provision", j, "monto_cargo");									frn.setX(0,"k_provision", j, "monto_abono");									frn.setX(0,"k_pago", j, "monto_cargo");									frn.setX(0,"k_pago", j, "monto_abono");									j=j+1;								}							}																						// ok frn.set("k_uuid_subtotal",subtotal_uuid);							// ok frn.set("k_uuid_iva_trasladado",trasiva_uuid);									// ok frn.set("k_uuid_ieps_trasladado",trasieps_uuid);							frn.set("k_uuid_total_trasladado",totalimptostras_uuid);							// ok frn.set("k_uuid_retiva",retiva_uuid);							// ok frn.set("k_uuid_retisr",retisr_uuid);							frn.set("k_uuid_total_retenciones",totalimptosret_uuid);							frn.set("k_uuid_impto_adicional_A",impuestosLocalTras_uuid);							// ok frn.set("k_uuid_impto_adicional_B",impuestosLocalRet_uuid);						} 							var sumtras = trasiva_uuid + trasieps_uuid + impuestosLocalTras_uuid;							frn.set("k_sumtras",sumtras);															var sumrets = retisr_uuid + retiva_uuid+impuestosLocalRet_uuid;							frn.set("k_sumrets",sumrets);													}			} else{				//frn.set("k_refer","");				frn.message("Faltan datos del UUID ...","Error","Aceptar");					}		}				fun selecciona_campo_plantilla(tabla_ui){			cmdQuery="select * from(select '' as valor union " &				"select 'c19-Cuenta del Cargo' as valor union " & 				"select 'c20-Cuenta del Abono' as valor union " &				"select 'c21-Cuenta del IVA' as valor union " &				"select 'c22-Cuenta del ISR' as valor) as sub1 order by valor ";							frn.dialog("genlistafiltrosel","Cuentas Plantilla",cmdQuery ,"valor",tabla_ui,"", "campo_cuenta_plantilla","N");					}				fun selecciona_cuenta(tabla_ui){			tabla = " keplersc.kdc1" & anio_contable;			cmdQuery = "select c1 as clave_cuenta, c2 as desc_cuenta from " & tabla;			frn.dialog("genlistafiltrosel","Cuentas",cmdQuery ,"clave_cuenta",tabla_ui,"", "cve_cuenta","N");		}						fun cuenta(tabla_ui){			tabla = " keplersc.kdc1" & anio_contable;			cmdQuery = "select c2 as desc_cuenta from " & tabla & " where c1='" & frn.get(tabla_ui, -1, "cve_cuenta") & "'";			frn.lib("libGeneral.kpl","FileSave",cmdQuery ,"C:\Basura\cuboquerycuentas");			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conf_polizas_facturas.cuenta()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery ,"C:\Basura\cuboConceptos");							ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			len_result = nXml(cuboQuery);							if (len_result == 0){				frn.message("La cuenta no existe. Verifique...","Error","Aceptar");				frn.setPos(tabla_ui, -1, "cve_cuenta");				frn.setX("", tabla_ui, -1, "cve_cuenta");				frn.setX("", tabla_ui, -1, "desc_cuenta");				return;			} else {				frn.setX(getXmlAtt(cuboQuery,"r0", "desc_cuenta"),tabla_ui, -1, "desc_cuenta");			}				}				fun limpiar_datos_uuid(){			frn.set("k_uuid_monto","");			frn.set("k_clave","");			frn.set("k_descripcion","");				frn.rst("k_impuestos");			frn.rst("k_provision");			frn.rst("k_pago");			frn.set("k_monto","");			frn.set("total_cargos_prov","");			frn.set("total_abonos_prov","");			frn.set("total_cargos_pago","");			frn.set("total_abonos_pago","");		}				fun sel_generico(tabla,campo,val1,val2){			if (frn.get(tabla,-1,campo) &= val1){				frn.setX(val2,tabla,-1,campo);			} else {				frn.setX(val1,tabla,-1,campo);         }			if (val1 &= "C" && val2 &= "A"){				importe(tabla,frn.get(tabla,-1,campo));			}      }		fun sel_complemento(tabla){			if (frn.get(tabla,-1,"complemento") &= ""){				frn.setX("PROVEEDOR",tabla,-1,"complemento");			} else if (frn.get(tabla,-1,"complemento") &= "PROVEEDOR"){				frn.setX("CLIENTE",tabla,-1,"complemento");			} else if (frn.get(tabla,-1,"complemento") &= "CLIENTE"){				frn.setX("INVENTARIO",tabla,-1,"complemento");			} else {				frn.setX("",tabla,-1,"complemento");			}      }                  fun importe(tabla, tipo_asiento){			var concepto_impto, concepto_tabla, campo_tot_cargo, campo_tot_abono;			if (tipo_asiento &= "C"){				for (var cont=0; cont<frn.N("k_impuestos"); cont++){					concepto_impto = frn.get("k_impuestos",cont,"id_concepto");					concepto_tabla = frn.get(tabla,-1,"id_concepto");					if (concepto_impto &= concepto_tabla){						frn.setX(0,tabla,-1,"monto_cargo");						frn.setX(0,tabla,-1,"monto_abono");						frn.setX(frn.get("k_impuestos",cont,"monto"),tabla,-1,"monto_cargo");					}				}			} else {				for (var cont=0; cont<frn.N("k_impuestos"); cont++){					concepto_impto = frn.get("k_impuestos",cont,"id_concepto");					concepto_tabla = frn.get(tabla,-1,"id_concepto");					if (concepto_impto &= concepto_tabla){						frn.setX("",tabla,-1,"monto_cargo");						frn.setX("",tabla,-1,"monto_abono");						frn.setX(frn.get("k_impuestos",cont,"monto"),tabla,-1,"monto_abono");					}				}			}			if (tabla &= "k_provision"){				campo_tot_cargo ="total_cargos_prov";				campo_tot_abono ="total_abonos_prov";			}			if (tabla &= "k_pago"){				campo_tot_cargo ="total_cargos_pago";				campo_tot_abono ="total_abonos_pago";			}			CalculaTotales(tabla,campo_tot_cargo,campo_tot_abono);	      }            fun ValidaValor(tabla,campo,val1,val2){			if (frn.get(tabla,-1,campo) &! val1 && frn.get(tabla,-1,campo) &! val2){				frn.setPos(tabla,-1,campo);				frn.message("Sólo puede ser " & val1 & " o " & val2,"Error","&Aceptar");				return;			} 		}				fun CalculaTotales(tabla,campo_cargo,campo_abono) {			var totcargos=0, totabonos=0, renglones;				//Calcular totales				renglones = frn.N(tabla);				for (var i=0; i<renglones; i++) {					totcargos = totcargos + frn.get(tabla,i,"monto_cargo");					totabonos = totabonos + frn.get(tabla,i,"monto_abono");				}				frn.set(campo_cargo,totcargos);				frn.set(campo_abono,totabonos);							}			fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			var resultado, mensaje;							fecha = sys.date();			hora= sys.time();						if(frn.get("k_clave") &= ""){				frn.message("No se ha inngresado la clave del modelo de la factura");				return;			}						if(frn.get("k_descripcion") &= ""){				frn.message("No se ha ingresado la descripcion del modelo de la factura");				return;			}									resultado=ValidarPolizas();			if (resultado == 1){				frn.message("Error en la configuracion","Error","Aceptar");				return;			}			continua = frn.message(" Desea continuar con la alta?","Atencion",2);			if (continua == 0){				return;			}								xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			//Agregar usuario, fechay hora de movimiento			strFecha = fnDate("year",fecha) & "-";			strTmp = fnDate("month",fecha);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "-";			strTmp = fnDate("day",fecha);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp;									setXml(xmlPantalla,"movimiento","usuario",usuario);			setXml(xmlPantalla,"movimiento","fecha",strFecha);			setXml(xmlPantalla,"movimiento","hora",			frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 			frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));			setXml(xmlPantalla,"k_impuestos","no_partidas_impuesto",frn.N("k_impuestos") -1);			setXml(xmlPantalla,"k_provision","no_partidas_provision",frn.N("k_provision") -1);			setXml(xmlPantalla,"k_pago","no_partidas_pago",frn.N("k_pago") -1);						setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);			setXml(xmlPantalla,"ambiente","uen",uen);						frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaConfPolizas");			cmdQuery="SELECT * FROM keplersc.cat_confpolizasfacturas_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";			rstXml(cuboQuery);								cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"conf_polizas.Ejecuta");							frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlConfPolizas");								resultado = getXml(cuboQuery,"resultado");			mensaje = getXml(cuboQuery,"mensaje");								ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(resultado &= "1") {				strMsg = "Modelo de factura registrado ";				frn.message(strMsg, "Mensaje", "Aceptar");			} else {				frn.message(mensaje, "Error", "Aceptar");			}		}     					//--------------------------------------------------- HASTA AQUI FUNCIONES QUE SE UTIILIZAN------------------------------------------------					fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         }												fun ConfiguraControlesOff() {			}						fun ConfiguraControlesOpcion() {				ConfiguraControlesOff();			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    				1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 				2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 				3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				// var tip_ope; 				var tip_oper;				if(iModo==0)					page=pag; 				else if(iModo==2&&(strlen(par0)>0)){					//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     			}													} // End of class Main			</script></pag>