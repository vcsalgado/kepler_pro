<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Demo"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0">	<br/>	<tab/><inp id="inp_titulo" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>	<br/><tab/><hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp dim="80,39,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">        <tab n="1"/><txt clr="0,58,112" hk="S">Sucursal:</txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><sp/><br/>				<br/><tab/>		<txt clr="132,20,7">Numero de serie : </txt><tab n="2"/>				<inp id="demo_vin" clr="64,64,64"  dim="25,1" brdr="2,0" bclr="255,255,255" type="capital" nc="17" fnt="Arial,0" OnF9="ObtenerSerie()" OnChange="LimpiarInf()" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Numero de serie de la unidad"/><tab/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y" tooltip="Buscar"/>        <br/><tab/>		<txt clr="132,20,7">Numero consecutivo : </txt><tab/>				<inp id="demo_consec" dim="12,1" type="number" nc="4" fmt="5" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="N" visible="Y" tooltip="Numero consecutivo de registro por unidad"/><tab/>		      <txt clr="132,20,7">Codigo BAC del distribuidor :</txt><tab/>		<inp id="demo_idcliente" dim="12,1"  type="number" nc="9" fmt="5" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" available="N" modify="Y" tooltip="Codigo BAC del distribuidor"/><sp/>		<br/><tab/>		<txt clr="132,20,7">Estatus  unidad  :</txt><tab n="2"/>		<cmb id="demo_estatus" clr="64,64,64" clrBrdr="255,255,255"  dim="12,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital"  OnChange="" modify="Y" available="Y" visible="Y" tooltip="Estatus de la unidad Demo"/><tab/>        <txt clr="0,58,112">Numero transaccion : </txt><tab n="2"/>				<inp id="demo_notransaccion" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="number" nc="9" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Numero de transaccion que registra GM"/>		        <br/><tab/>		<txt clr="0,58,112">Numero operacion : </txt><tab/>				<inp id="demo_idoperacion" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="number" nc="9" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Numero de operacion asignado por GM"/><tab/>		<txt clr="0,58,112">Origen de la operacion :  </txt><tab/>				<inp id="demo_origenope" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="string" nc="15" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Origen de la operacion"/>		<br/><tab/>		<txt clr="0,58,112">Evento : </txt><tab n="3"/>				<inp id="demo_evento" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="string" nc="15" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Estatus de la peticion"/><tab/>		<txt clr="0,58,112">Identificador  resultado : </txt><tab/>				<inp id="demo_resultado" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="string" nc="15" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Identificador del resultado"/>		<br/><tab/>		<txt clr="0,58,112">Descripci&#243;n resultado :</txt><tab/>				<inp id="demo_resdescrip" clr="64,64,64"  dim="58,5" brdr="2,0" bclr="255,255,255" type="capital" nc="1000" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Cadena original del timbre"/>		<br/><tab/>        <txt clr="0,58,112">Valor de la unidad : </txt><tab/>				<inp id="demo_valorunidad" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="number" nc="9" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Numero de transaccion que registra GM"/><tab/>        <txt clr="0,58,112">Porcentanje de IVA : </txt><tab n="2"/>				<inp id="demo_ivaaplicable" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="number" nc="9" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Porcentanje de IVA aplicable a la unidad demo"/>				<br/><tab/>		<txt>Fecha actualizacion :</txt><tab/>		<edt id="demo_fechact" dim="10,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="" page="_ks_fecha,demo_fechact" OnF9="Dialog(3,_ks_fecha,demo_fechact)" modify="N" available="Y" tooltip="Fecha de actualizacion"/><tab/>		<txt>Hora actualizacion :</txt>		<inp id="demo_horaact" dim="8,1" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" OnChange="" modify="N" available="Y" tooltip="Hora de actualizacion" nc="-1"/><tab/><txt>Identificador usuario : </txt>				<inp id="demo_cveusu" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="capital" nc="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Identificador de usuario"/>		<br/>      <br/>			<tab n="15"/>		<txt clr="132,20,7">Datos obligatorios en color &lt;Rojo&gt;</txt>			<tab/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>		<sp n="2"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>				</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco, externo ;		var cmdQuery, cuboQuery, ok, mensajeError, fileSavePath;		var tipoOper; //Variables relacionadas con parametros		var accion,straccion,resVal,suc_bus,genero,naturaleza,grupo,tipo,num_serie,id_serie,opc_estatus;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			asterisco = "*";			fileSavePath = "C:\Basura";			ConfiguraUI();			Inicializa();		}					fun ConfiguraUI(){			var nparam;			tipoOper = strFormat("ucase",frn.param(0));			nparam = frn.nParam();			accion = strFormat("ucase",frn.param(1));			id_serie = strFormat("ucase",frn.param(2));			opc_estatus = frn.param(3);			if (frn.nParam() == 0){				frn.message("Accion no permitida.","Error","&Aceptar");				frn.open("redirect",2);				return;			}			//Establecer titulo de la ventana			if (accion &= "ALTA"){				straccion = "Alta " ;            }else if (accion &= "CONSULTA"){				straccion = "Consulta ";         }     			if (tipoOper &= "DEMO"){				frn.set("inp_titulo",straccion & "Demo");											}					}						fun Inicializa(){			var cmd,cubo;							//Llenar combo sucursales			cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmd = cmd & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmd = cmd & " where c1='" & suc_usuario & "'";				}			}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ifz_sofiademo.Inicializa()");					ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_sucn",getXml(cubo));			frn.set("k_sucn",descr_combo("k_sucn",1,suc_usuario));							//Llena combo Estatus			frn.setX("Demo In Ventas","demo_estatus",0,0);			frn.setX("PDVIN","demo_estatus",0,1);			frn.setX("Demo In Servicio","demo_estatus",1,0);			frn.setX("PDSIN","demo_estatus",1,1);			frn.setX("Demo Out","demo_estatus",2,0);			frn.setX("PDOUT","demo_estatus",2,1);								frn.set("demo_estatus", "");			frn.set("demo_idcliente", "320134");			if (id_serie &! ""){			//Se envia la serie desde otra pantalla				frn.set("demo_vin",id_serie);				Buscar();				}		}					fun IniCombos(ctrl_combo, query){			cmdQuery = query;			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ifz_sofiademo.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set(ctrl_combo,cuboQuery);		}		fun ObtenerSerie() {			suc_bus = frn.get("k_sucn",-1,1);			num_serie = frn.get("demo_vin");			LimpiarInf();			cmdQuery = "select c5 as serie, c4 as descripcion from keplersc.kdinf where c1='" & suc_bus &"' and c22='1'/*Registrado como Demo*/ and c31 <> 0/*No este cancelado*/";						frn.dialog("genlistafiltrosel","Series",cmdQuery,"serie","demo_vin","0","0","N","N");			}		fun Buscar() {			var xmlRequest,cmd,ok,cuboResultados, xmlProd,vfmov,vfreg;			suc_bus = frn.get("k_sucn", -1, 1);			num_serie = frn.get("demo_vin");			if (num_serie &=""){				frn.message("Debe seleccionar un No. de serie","Error","Aceptar");				return;			} 						ValidaSerie();			//Asigna consecutivo por serie			cmd ="select coalesce(max(demo_consec),0) as demo_Consec, current_date as demo_fechact, to_char(current_timestamp, 'HH24:MI:SS') as demo_horaact,				'DEMO' as demo_origenope, 'PENDIENTE' as demo_evento				from keplersc.ifz_sofia_notif				where serie='" & num_serie &"' and sucursal ='" & suc_bus &"' and movto_sofia ='Demo' and demo_vin= '" & num_serie &"'";							frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRequestconscserie");								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ifz_sofiademo.Buscar()");			ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}									rstXml(xmlProd);			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboResultados,"r0");			LimpiarInf();			frn.setX(xmlProd);			//Asigna consecutivo por movto Demo			if (frn.get("demo_consec") &=0){				cmd ="select coalesce(max(demo_consec),0)+1 as demo_consec, current_date as demo_fechact, to_char(current_timestamp, 'HH24:MI:SS') as demo_horaact,					'DEMO' as demo_origenope, 'PENDIENTE' as demo_evento					from keplersc.ifz_sofia_notif					where movto_sofia ='Demo'";									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ifz_sofiademo.Buscar()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultadosconsecmovto");				ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						frn.set("demo_consec",getXmlAtt(cuboResultados,"r0","demo_consec"));				frn.set("demo_fechact",getXmlAtt(cuboResultados,"r0","demo_fechact"));				frn.set("demo_horaact",getXmlAtt(cuboResultados,"r0","demo_horaact"));				frn.set("demo_origenope",getXmlAtt(cuboResultados,"r0","demo_origenope"));				frn.set("demo_evento",getXmlAtt(cuboResultados,"r0","demo_evento"));			}			//Llenar combos			frn.set("demo_estatus",descr_combo("demo_estatus",1,opc_estatus));		}		fun LimpiarInf(){			frn.set("demo_consec", "");			frn.set("demo_estatus", "");			frn.set("demo_notransaccion", "");			frn.set("demo_idoperacion", "");			frn.set("demo_origenope", "");			frn.set("demo_evento", "");			frn.set("demo_resultado", "");			frn.set("demo_resdescrip", "");			frn.set("demo_fechact", "");			frn.set("demo_horaact", "");			frn.set("demo_cveusu", "");			frn.set("demo_valorunidad", "");			frn.set("demo_ivaaplicable", "");		}			fun BorraDatos(){			frn.set("demo_vin", "");			frn.set("demo_consec", "");			frn.set("demo_estatus", "");			frn.set("demo_notransaccion", "");			frn.set("demo_idoperacion", "");			frn.set("demo_origenope", "");			frn.set("demo_evento", "");			frn.set("demo_resultado", "");			frn.set("demo_resdescrip", "");			frn.set("demo_fechact", "");			frn.set("demo_horaact", "");			frn.set("demo_cveusu", "");			frn.set("demo_valorunidad", "");			frn.set("demo_ivaaplicable", "");		}				fun Ejecuta(){			var xmlPantalla,resultado,mensaje,folio,continua;			var strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			fecha = sys.date();			hora= sys.time();			strFecha = fnDate("year",fecha) & "-";			strTmp = fnDate("month",fecha);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "-";			strTmp = fnDate("day",fecha);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp;			resVal = 1;			ValidarDatos();						if(resVal == 0){				return;			}			continua = frn.message("Desea continuar ?","Atencion",2);			if (continua == 0){				return;			}						xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			setXml(xmlPantalla,"sucursal",frn.get("k_sucn",-1,1));			setXml(xmlPantalla,"genero","X");			setXml(xmlPantalla,"naturaleza","X");			setXml(xmlPantalla,"grupo",1);			setXml(xmlPantalla,"tipo",1);			setXml(xmlPantalla,"folio",1);			setXml(xmlPantalla,"serie",frn.get("demo_vin"));			setXml(xmlPantalla,"fecha",fecha);			setXml(xmlPantalla,"movto_sofia","Demo");			setXml(xmlPantalla,"tip_ope",tipoOper);			setXml(xmlPantalla,"movimiento","usuario",usuario);			setXml(xmlPantalla,"movimiento","fecha",strFecha);			setXml(xmlPantalla,"movimiento","hora",			frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 			frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaifz_sofiademo");			cmdQuery="SELECT * FROM keplersc.ifz_sofiademo('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";			rstXml(cuboQuery);								cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"ifz_sofiademo.Ejecuta");							frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadifz_sofiademo");								resultado = getXml(cuboQuery,"resultado");			mensaje = getXml(cuboQuery,"mensaje");								ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(resultado &= "1") {				strMsg = "Se guardo correctamente la informacion para SOFIA";				frn.message(strMsg, "Mensaje", "Aceptar");				 frn.setAtt("bot_seleccionar", "visible", "N" );			} else {				frn.message(mensaje, "Error", "Aceptar");				return;			}				}        fun validaDatoVacio(dato,msg){			if (frn.get(dato) &= ""){				resVal= 0;				frn.setPos(dato);				frn.message("Debe especificar " & msg & "|El dato no puede estar vacio","Error","Aceptar");				return;			}		}		fun ValidarDatos(){			validaDatoVacio("demo_vin","Numero de serie");			validaDatoVacio("demo_consec","Numero consecutivo");			validaDatoVacio("demo_idcliente","Codigo BAC del distribuidor");			validaDatoVacio("demo_estatus","Estatus de la unidad");						if (strlen(frn.get("demo_vin")) != 17){				resVal= 0;				frn.setPos("demo_vin");				frn.message("La serie debe ser de 17 digitos","Error","Aceptar");				return;			}			ValidaSerie();        }		fun ValidaSerie(){			var xmlRequest,cmd,ok,cuboResultados;			suc_bus = frn.get("k_sucn", -1, 1);			num_serie = frn.get("demo_vin");			cmd= "select c5 from keplersc.kdinf where c1='" & suc_bus &"' and c5='" & num_serie &"' and c22='1'/*Registrado como Demo*/ and c31 <> 0/*No este cancelado*/";			frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRequestkdinf");								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ifz_sofiademo.Buscar()");			ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			if(nXml(cuboResultados) == 0){				resVal=0;				frn.setPos("demo_vin");				frn.message("El No. de serie no esta registrado como Demo","Error","Aceptar");				return;			}		}//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------		fun descr_combo(combo,posicion,valor){			var descr, valor_actual;			var len_combo = frn.N(combo);			for (var cont=0; cont<len_combo ; cont++){				valor_actual= frn.get(combo,cont,posicion);				if (valor_actual &=  valor){					descr = frn.get(combo,cont,0);					return descr;				}			}		}					fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO						1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana						2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)						3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			if(iModo==0)				page=pag;			else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.				if( frn.getAtt(par0,"modify",par1) &= "N" ) 					b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) 					b_valido=0;				if( frn.getAtt(par0,"visible",par1) &= "N" ) 					b_valido=0;			}			if(iModo==3)				frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>