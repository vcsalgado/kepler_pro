<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de " scale="48">	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,16" unfont="0">		<br exe="encabezado"/>		<!-- <hLine dim="90,0" g="2" type="1"/> en portrait cabe bien dim = 90 -->		<hLine dim="120,0" g="2" type="1"/>		<br exe="encabezado"/>				<grp dim="15,5,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>				<grp dim="90,6,7,12">			<br/>			<inp id="nombreempresa" dim="120,1" fnt="20b,20b" type="string" modify="N" just="C" bclr="249,249,249"/>			<br/>			<inp id="titulorpt" dim="120,1" type="string" fnt=",19b" modify="N" just="C"/>			<br/>			<sp n="38"/>			<txt fnt=",16b">Del : </txt>			<sp n="2"/>			<inp id="fechaini" dim="12,1" type="date" fnt=",16b" fmt="DD/MM/CCYY" modify="N" just="L" nc="-1"/>			<sp n="5"/>			<txt fnt=",16b">Al : </txt>			<sp n="2"/>			<inp id="fechafin" dim="12,1" type="date" fnt=",16b" fmt="DD/MM/CCYY" modify="N" just="L" nc="-1"/>			<br exe="encabezado"/>		</grp>				<tab n="1"/>				<grp dim="15,5,7,12">			<tab n="2"/><txt>P&#225;g:</txt>			<sp/> <inp id="k_pag" dim="5,1" type="number" mcr="k_pag"/><br/><br/>			<inp id="fecha" dim="10,1" type="date" fmt="DD-MM-CCYY"/>			<sp/> <inp id="hora" dim="5,1" type="time"/>		</grp>		<br exe="encabezado"/>		<br exe="encabezado"/>				<hLine dim="120,0" g="2" type="1"/>			<br exe="encabezado"/>			<txt fnt=",b"> Fecha </txt> <sp n="3"/>			<txt fnt=",b"> Referencia</txt> <sp n="2"/>			<txt fnt=",b"> suc</txt> <sp n="1"/>			<txt fnt=",b"> Documento </txt> <sp n="22"/>			<txt fnt=",0b"> Descripcion </txt> <sp n="28"/>			<txt fnt=",b"> Debe </txt> <sp n="7"/> 			<txt fnt=",b"> Haber </txt> <sp n="7"/>			<txt fnt=",b"> Saldo </txt> 			<br exe="encabezado"/>		<hLine dim="120,0" g="2" type="1"/> 		<br exe="encabezado"/>		<!-- <br exe="encabezado"/>  -->						<br exe="gp_suc"/>		<txt fnt=",16b" clr="20,0,96">Sucursal : </txt>		<inp id="suc" dim="3,1" bclr="255,255,255" clrBrdr="255,255,255" type="string" modify="N" fnt=",0b" clr="20,0,96"/>		<sp n="1"/>  		<inp id="descsuc" dim="50,1" bclr="255,255,255" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" clr="20,0,96"/>		<sp n="15"/>		<txt>-------------------------------------------------------------------------------------------------------------</txt>		<br exe="gp_suc"/>		<br exe="gp_suc"/>		<inp id="c_fecha_det" dim="7,1" type="date" modify="N" fmt="CCYY/MM/DD" nc="-1" fnt=",15"/> <sp n="1"/>		<inp id="c_referencia" dim="10,1" type="string" modify="N" fnt=",15"/> <sp n="1"/>		<inp id="c_sucursal" dim="2,1" type="string" modify="N" fnt=",15"/> <sp n="1"/>		<inp id="c_folio" dim="12,1" type="string"  modify="N" just="L" nc="-1" fnt=",15"/><sp/> 		<inp id="c_descrdoc" dim="16,1" type="string" modify="N" fnt=",15"/> <sp n="1"/>		<inp id="c_descrpol" dim="28,1" type="string" modify="N" fnt=",15"/> <sp n="2"/>		<inp id="c_cargo" dim="11,1" type="number" modify="N" just="R" nd="2" fnt=",15"/> <sp n="1"/>		<inp id="c_abono" dim="11,1" type="string" modify="N" just="R" fnt=",15"/> <sp n="1"/>		<inp id="c_saldo" dim="11,1" type="number" modify="N" just="R" nd="2" fnt=",15"/> 		<br exe="detalle_c"/>				<inp id="a_fecha_det" dim="7,1" type="date" modify="N" fmt="CCYY/MM/DD" nc="-1" fnt=",15"/> <sp n="1"/>		<inp id="a_referencia" dim="10,1" type="string" modify="N" fnt=",15"/> <sp n="1"/>		<inp id="a_sucursal" dim="2,1" type="string" modify="N" fnt=",15"/> <sp n="1"/>		<inp id="a_folio" dim="12,1" type="string"  modify="N" just="L" nc="-1" fnt=",15"/><sp/> 		<inp id="a_descrdoc" dim="16,1" type="string" modify="N" fnt=",15"/> <sp n="1"/>		<inp id="a_descrpol" dim="28,1" type="string" modify="N" fnt=",15"/> <sp n="2"/>		<inp id="a_cargo" dim="11,1" type="string" modify="N" just="R" fnt=",15"/> <sp n="1"/>		<inp id="a_abono" dim="11,1" type="number" modify="N" just="R" nd="2" fnt=",15"/> <sp n="1"/>		<inp id="a_saldo" dim="11,1" type="number" modify="N" just="R" nd="2" fnt=",15"/> 		<br exe="detalle_a"/>					<!-- INI -- Totales x Sucursal -->		<br exe="totalsucursal"/> 		<hLine dim="120,0" g="1" type="1"/> 		<br exe="totalsucursal"/> 		<txt fnt=",16b" clr="20,0,96">Total Sucursal :</txt>		<sp n="1"/>		<inp id="tpdescsuc" dim="50,1" type="string" fnt=",16b" clr="20,0,96"/>		<sp n="21"/>		<inp id="tptotsuccargo" dim="11,1" type="number" fnt=",16b" clr="20,0,96" nd="2"/> <sp n="1"/>		<inp id="tptotsucabono" dim="11,1" type="number" fnt=",16b" clr="20,0,96" nd="2"/> <sp n="1"/>		<inp id="tptotsucsaldo" dim="11,1" type="number" fnt=",16b" clr="20,0,96" nd="2"/> 		<br exe="totalsucursal"/> 		<hLine dim="120,0" g="1" type="1"/>		<br exe="totalsucursal"/>		<!-- END -- Totales x Sucursal -->				<!-- INI -- Totales x Gran Total -->		<br exe="total"/>		<hLine dim="120,0" g="2" type="1"/> 		<br exe="total"/> 		<txt fnt=",17b" clr="20,0,96">Gran Total del rango de fechas consultado : </txt>		<sp n="50"/>		<inp id="gttotcargo" dim="12,1" type="number" clr="20,0,96" fnt=",17b" nd="2"/>		<inp id="gttotabono" dim="12,1" type="number" clr="20,0,96" fnt=",17b" nd="2"/>  		<inp id="gttotsaldo" dim="12,1" type="number" clr="20,0,96" fnt=",17b" nd="2"/> 		<br exe="total"/> 		<hLine dim="120,0" g="2" type="1"/> 		<br exe="total"/>		<!-- END -- Totales x Gran Total -->			</grp></pag>