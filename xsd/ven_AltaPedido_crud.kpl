<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Pedido">	<grp id="grpMain" brdr="0,0" clr="0,58,112" fnt="Arial,18b"  dim="1,-1,10,8" bclr="192,205,213" clrBrdr="0,97,181" OnF1="Dialog(1,altapedido_crud)" tit="Alta de Pedido" unfont="0">		<br/>	<tab/><inp id="inp_titulo" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>	<br/><tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grpDatosGenerales" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="50,10,7,12" tit="Datos generales"  fnt="Arial,16" available="Y" modify="Y">		<sp/><txt clr="0,58,112" hk="S">Sucursal</txt><tab/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" 				brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y" OnChange="CambiaSucursal()"/>			<br/>						<sp/><txt clr="0,58,112">Grupo docto</txt>			<cmb id="grpDoc" clr="64,64,64" clrBrdr="255,255,255"   dim="25,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="0)" available="N" modify="Y"/>			<br/>			<sp/><txt clr="0,58,112">Tipo docto</txt><tab/>			<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255"  dim="25,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="Valida_Tipo_Docto()" available="Y"/><br/>		</grp><sp/>		<grp id="grpDocumentos" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="30,10,7,12" tit="Documento"  fnt="Arial,16" available="Y" modify="Y">			<tab n="2"/><inp id="operacion" clr="64,64,64"  dim="18,1" brdr="0,1" fnt=",18b" available="N" type="string"/><br/><tab/>			<txt id="foliotxt"  visible="N" hk="F" clr="0,58,112">Folio</txt><tab n="2"/>			<edt id="k_folio" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" visible="Y" hk="F" type="capital" nc="10"								OnF9="ObtenerFolio()" OnButton="ObtenerFolio()" 				OnChange = "ConsultarFolio()"				modify="Y"/>			<br/><tab/>			<inp id="k_docto" clr="64,64,64"  dim="25,1" brdr="0,1" fnt="Arial,16" available="N" link="k_tipon,5" type="string"/><br/>			<tab/><txt clr="0,58,112">Fecha</txt><tab/>			<edt id="k_fecha" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" OnButton="Dialog(0,_ks_fecha,k_fecha)" OnF9="Dialog(0,_ks_fecha,k_fecha)" modify="N" available="N"/><br/><tab/>			<inp id="statusDoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/><br/><tab n="2"/>					</grp><br/><br/><br/>		<tab/>		<grp id="grpDetalle" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5" 			dim="81,26,7,15" tit="Detalle"  fnt="Arial,16" available="N" modify="N">			<grp id="grpInventario" dim="200,30,7,15" hSpace="4" available="N" modify="Y">				<tab n="2"/><txt>Inventario</txt><tab n="4"/>				<inp id="k_inventario" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="10" available = "Y" tooltip="Inventario ..." modify="Y" 				OnF9="BusquedaInventario()"				OnChange="MostrarInventario()"				OnF11 ="ModificarInventario()"/>				<tab n="4"/><txt>(F11) Editar Datos Unidad)</txt><br/>				<tab n="2"/><txt>No-Serie:</txt><tab n="4"/>				<inp id="k_serie_inv" clr="64,64,64" dim="18,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>				<tab/><txt>Descripci&#243;n: </txt><tab/>				<inp id="k_desc_inv" clr="64,64,64"  dim="50,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>				<tab n="5"/>				<br/><br/>				<tab n="2"/><txt>&#191;Es Flotilla? </txt><tab n="3"/>				<cmb id="k_flotilla" clr="64,64,64" clrBrdr="255,255,255" dim="10,5" bclr="255,255,255" brdr="4,0" fnt="Arial,16" Null="N" available="Y" modify="Y"/><tab/><txt>Si / No (S/N)</txt>				<br/>				<tab n="2"/><txt>Vendedor</txt><tab n="4"/>				<cmb id="k_vendedor" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y"/>								<br/>				<tab n="2"/><txt>Tipo de Operaci&#243;n</txt><tab/>				<cmb id="k_tipo_operacion" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y"/>								<tab n="2"/>				<txt>Fin Financiamiento</txt><tab n="1"/>				<edt id="k_fecha_financiamiento" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" 					OnChange="Fecha()" 					OnButton="Dialog(0,_ks_fecha,k_fecha_financiamiento)" 					OnF9="Dialog(0,_ks_fecha,k_fecha_financiamiento)" modify="Y" available="Y"/>				<br/>				<tab n="2"/><txt>Coach</txt><tab n="4"/>				<cmb id="k_coach" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y"/>				<br/>				<br/>				<tab n="2"/><txt>Cliente</txt><tab n="4"/>								<inp id="k_cliente" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="10" available = "Y" tooltip="Inventario ..." modify="Y" 					OnChange="MostrarCliente()"					OnF9 = "ConsultarCliente()"					OnF10 = "Dialog(3,cat_cli_crud,Modificar,x,s,k_cliente)"/>							<inp id="k_nombre_impresion" clr="64,64,64" clrBrdr="255,255,255"  dim="75,1" bclr="236,240,243" fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="string"/>				<br/><tab n="8"/> 				<grp id="grpDatosClientes" bclr="255,255,255" fntClrBrdr="240,220,200" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="81,7,7,15" fnt="Arial,16" available="Y" modify="Y">				<inp id="k_c10" clr="64,64,64" clrBrdr="255,255,255" dim="15,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N"/>				<br/>				<inp id="k_c30" clr="64,64,64" clrBrdr="255,255,255"  dim="80,1" bclr="255,255,255"  fnt="Arial,16" nr="3,60" modify="Y" available="N" type="string"/>				<br/>				<inp id="k_c4" clr="64,64,64" clrBrdr="255,255,255"  dim="80,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N"/>				<br/>				<inp id="k_c5" clr="64,64,64" clrBrdr="255,255,255"  dim="80,1" bclr="255,255,255"  fnt="Arial,16" nr="3,60" modify="Y" available="N"/>				<br/>				<inp id="k_c6" clr="64,64,64" clrBrdr="255,255,255"  dim="80,1" bclr="255,255,255" fnt="Arial,16" nr="3,60" modify="Y" available="N"/>				<br/>								</grp><br/><tab n="8"/><sp/>				<inp id="k_valor_retorno" clr="64,64,64" clrBrdr="255,255,255" dim="10,1" bclr="236,240,243" fnt="Arial,16" nr="3,60" modify="Y" available="Y" visible="N" OnChange="ValidarKDF3PS()" type="string"/>				<inp id="k_valor_unidad" clr="64,64,64" clrBrdr="255,255,255" dim="10,1" bclr="236,240,243" fnt="Arial,16" nr="3,60" modify="Y" available="Y" visible="N" OnChange="ValidarKDF3UNI()"/>				<br/>				<tab n="2"/>				<txt>Comentarios</txt>				<tab n="3"/><inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="90,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="N" available="Y" type="capital"/>				<tab n="2"/>			</grp>		</grp>			<br/><br/>		<tab/>		<grp id="grpTomas" tit="Tomas de autos" dim="70,9,7,12" bclr="236,240,243" 			brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" fnt=",0" available="Y" modify="Y">			<tab/>			<tbl clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" brdr="1,0" id="results" dim="95,5" 				modify="N" nren="fijo" Reorder="Y" fnt="Arial,16" clrHead="0,58,112" bclrHead="236,240,243">				<col id="c3" name="Consecutivo" type="number"/>				<col id="c4" name="Clave Vehicular" type="string"/>				<col id="c5" name="Tipo Veh&#237;culo" type="string"/>				<col id="c6" name="Anio Modelo" type="string"/>				<col id="c7" name="VIN" type="string"/>			</tbl>		</grp>		<grp id="grpAccTomas" tit="     " dim="11,10,7,12" bclr="236,240,243" 			brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" fnt=",0" available="Y" modify="Y">			<sp/>			<bot id="btn_nuevo_toma" dim="9,0" brdr="2,0" text="Nuevo" OnEnter="crud_tomas(NUEVO)" default="0" visible="N" available="N" fnt=",16"/>			<br/><sp/>			<bot id="btn_edita_toma" dim="9,0" brdr="2,0" text="Editar" OnEnter="crud_tomas(EDITAR)" default="0" visible="N" available="N" fnt=",16"/>			<br/><sp/>			<bot id="btn_elimina_toma" dim="9,0" brdr="2,0" text="Elimina" OnEnter="crud_tomas(ELIMINAR)" default="0" visible="N" available="N" fnt=",16"/>		</grp>							<br/><br/>		<tab/>		<grp id="grpconceptosextras" tit="Conceptos Extras" dim="81,13,7,12" bclr="236,240,243" brdr="0,5" 			clrBrdr="0,58,112" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" fnt=",0" available="N" modify="N"><tab/>				<tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" 				bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="65,3"  hk="z" 					OnChange = "RecalculaConceptoExtra(1)"					OnEnter = "RecalculaConceptoExtra(1)" Reorder="N" modify="Y">										<col id="c4" name="Clave SAT"  type="string" modify="Y" available="Y"					OnF9="ConsultarKDF3PS()"					OnF10="AgregarKDF3PS" 					OnF11="ModificarKDF3PS"					OnChange="ValidarValorKDF3PS()"/>					<col id="c5" name="Descripci&#243;n" type="string" modify="Y" available="Y"/>					<col id="c6" name="Unidad"  type="string" 						OnF9="ConsultarKDF3UNI()"						OnChange="ValidarValorKDF3UNI()"/>					<col id="c7" name="Ctd"  type="number" nd="2" min="0" modify="Y" available="Y" OnEnter = "RecalculaConceptoExtra(1)" OnChange="RecalculaConceptoExtra(1)"/>					<col id="c8" name="Unitario"  type="number" nd="2" min="0" modify="Y" available="Y" OnEnter = "RecalculaConceptoExtra(1)" OnChange="RecalculaConceptoExtra(2)"/>					<col id="c9" name="Importe"  type="number" nd="2" min="0" modify="Y" available="Y" OnEnter = "RecalculaConceptoExtra(1)" OnChange="RecalculaConceptoExtra(3)"/>					</tbl>				<tab n="4"/>				<grp dim="35,8,7,12" fnt="Arial,16" hSpace="4">				<txt>ISAN</txt><tab n="3"/>				<inp id="subt" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/>				<br/>				<txt>IVA</txt><tab n="3"/>				<inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="6" modify="N" available="N"/>				<br/>				<txt fnt=",16b">IMPORTE</txt><tab/>				<inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="Y" available="Y"				OnChange = "CalcularMonto()"/><br/><br/><tab n="3"/>				<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Consulta()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="N" clrBrdr="0,0,0" visible="N" modify="Y"/>				<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/><sp/>				<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><tab/>							</grp><br/>				</grp>		<br/><tab n="2"/>				</grp>	<tools>		<tool OnMouseL="Ejecuta()" tooltip="Aceptar documento(Ctrl+T)" scut="Ctrl+T" img="_TL_Execute.png"/>	</tools>	<script>		InstallDriver("KDB75");		class Main {			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc,usuario,sucursal_id,suc_usuario,rol_usuario,asterisco, v_inventario,valorRetorno,v_IvaAuto,v_correo,v_uso_cfdi;			var frn,kdb,rep,frP,sys;			var uen;			var tip_ope;//Tipo de operación. "0" indica Alta; "1" indica consulta; "2" indica cancelación; "3" indica baja; "4" Indica modificación						var anio_contable;			var param, param2, param3, accion;			/* PARáMETROS de la página indicados desde Tree, o desde frn.Dialog			param(0) = Género			param(1) = Naturaleza			param(2) = Grupo			param(3) = Tipo			param(4) = Fija Documento. Si "1", no permite seleccionar otro tipo de documento. Si "0" los combos de grupo  y tipo de documento se habilitan.			param(5) = Tipo de operación. "0" indica Alta; "1" indica consulta; "2" indica cancelación; "3" indica baja; "4" Indica modificación			*/						fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("c,kdm1,i,kdini,q,kdiq,m,kdmm,s,kdms,u,kdxd,v,kdxv,p,kdip,e,kdxe,f,kdxf,w,kdc2");				ConfiguraControlesOff();				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				inicializa();			}			fun busca_tomas(){				frn.setAtt("btn_edita_toma","available","N");				frn.setAtt("btn_edita_toma","visible","N");				frn.setAtt("btn_elimina_toma","available","N");				frn.setAtt("btn_elimina_toma","visible","N");								sucursal_id = frn.get("k_sucn",-1,1);				var clave = frn.get("k_inventario");				var strQuery = "select c3, c4,c5,c6,c7					from keplersc.kdtomas where c1='" & sucursal_id &"' and "  & " c2='"& clave &"' order by c3";					var cmd = "select * from (" & strQuery & ") as resultado " ;				var cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"gencatalogoview.buscar_registros()");				frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\cuboPrueba");				frn.set("results",cuboXml);				if (frn.get("results", -1, "c3") &! ""){					frn.setAtt("btn_edita_toma","available","Y");					frn.setAtt("btn_edita_toma","visible","Y");					frn.setAtt("btn_elimina_toma","available","Y");					frn.setAtt("btn_elimina_toma","visible","Y");				}								if (tip_ope &= "0"){					frn.setAtt("btn_nuevo_toma","available","Y");					frn.setAtt("btn_nuevo_toma","visible","Y");				}else{					frn.setAtt("btn_nuevo_toma","available","N");					frn.setAtt("btn_nuevo_toma","visible","N");								}			}			fun crud_tomas(accion){				if (v_inventario &= "")				{					frn.message("Seleccione registro de Inventario ...", "Mensaje","&Aceptar");					return;				}				if (accion &= "NUEVO"){					param = frn.get("k_sucn", -1 , 1);					param2 = frn.get("k_inventario");				}else if (accion &= "EDITAR"){					param = frn.get("k_sucn", -1 , 1);					param2 = frn.get("k_inventario");					param3 = frn.get("results", -1, "c3");				}else if (accion &= "ELIMINAR"){					param = frn.get("k_sucn", -1 , 1);					param2 = frn.get("k_inventario");					param3 = frn.get("results", -1, "c3");				}				frn.dialog("ven_AltaPedido_Seminuevo_view.kpl", param, param2,param3,accion);			}			fun ModificarInventario()			{				if (frn.get("k_inventario") &! "")				{					var val_param,tipo_auto;					val_param = frn.get("k_inventario");					tipo_auto = mid(val_param,7,1);					if(tipo_auto&="N")					{						//Nuevo						frn.dialog("tbl_kdinf_upd", val_param, "A","MostrarInventario()");											}else{						//Usado						frn.dialog("tbl_kdinf_updU", val_param, "A","MostrarInventario()");					}				}								}			fun RecalculaConceptoExtra(Opcion)			{				var v_ctd, v_unitario,v_importe;					for (var i=0,n=frn.N("k_mov")-1;i<n;i++) 					{						v_ctd = frn.get("k_mov",i,"c7");						v_unitario = frn.get("k_mov",i,"c8");						v_importe = (v_ctd * v_unitario); // frn.get("k_mov",i,"c9");						frn.setX(v_ctd,"k_mov",i,"c7");						frn.setX(v_unitario,"k_mov",i,"c8");						frn.setX(v_importe,"k_mov",i,"c9");											v_ctd =0;						v_unitario=0;						v_importe =0;					}							}			fun CalcularMonto()			{				var v_iva, v_costo, resultado, mensaje, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd, adicionales;					 				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				setXml(xmlPantalla,"k_b7012",frn.get("k_monto"));				setXml(xmlPantalla,"k_b7013",16);//se calcula dentro de la función al momento de procesarse 				setXml(xmlPantalla,"k_b7014",frn.get("k_monto"));				setXml(xmlPantalla,"k_b7015",1);								frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlAltaPedidos_Sumas_inv");				cmd="SELECT * FROM keplersc.invlib_sumas_inv('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"comopecompras.Alta");								resultado= getXml(cubo,"resultado");				mensaje = getXml(cubo,"mensaje"); // v_B7010				adicionales = getXml(cubo,"adicionales"); // v_B7011				if(resultado &= "1")				{					frn.set("subt",mensaje);					frn.set("k_iva",adicionales );					v_costo = frn.get("k_monto");					v_iva = (v_costo - (v_costo /1.16));					//frn.set("k_iva",v_iva);				}				else{					frn.message(mensaje, "Error","&Aceptar");				}								}				 			fun MostrarCliente()			{				var xmlRequest,					 cmd,					 ok, 					 cuboResultados,					 mensajeError, 					 v_cliente;					 v_correo = "";					 v_uso_cfdi="";					 v_cliente= frn.get("k_cliente" , -1, 1);					 cmd = "select c30,c4,c5,c6,c10,c11,c53 from keplersc.kdud where c2 = '" & v_cliente & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.MostrarCliente()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				frn.set("k_nombre_impresion",getXmlAtt(cuboResultados,"r0","c30"));				frn.set("k_c30",getXmlAtt(cuboResultados,"r0","c30"));				frn.set("k_c4",getXmlAtt(cuboResultados,"r0","c4"));				frn.set("k_c5",getXmlAtt(cuboResultados,"r0","c5"));				frn.set("k_c6",getXmlAtt(cuboResultados,"r0","c6"));				frn.set("k_c10",getXmlAtt(cuboResultados,"r0","c10"));				v_correo = getXmlAtt(cuboResultados,"r0","c11");				v_uso_cfdi = getXmlAtt(cuboResultados,"r0","c53");			}								fun MostrarInventario()			{				var xmlRequest, cmd, ok, cuboResultados, mensajeError, totOrd, contOrd;				var estado_compra, estado_venta;				sucursal_id = frn.get("k_sucn",-1,1);				v_inventario = frn.get("k_inventario");				//cmdQuery = "select c2 as inventario, c3 as Clave,c4 as Descripcion, c5 as Serie from keplersc.kdinf where c1 = '" & sucursal_id &  "' and c31 = 20 and c32 = 0 ";            					 				cmd = "select c2,c3,c4,c5,C20,c31,c32 from keplersc.kdinf where c1 = '" & sucursal_id &  "' and c2 = '" & v_inventario & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_altapedido.MostrarInventrio()");	//frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\XmlInventario");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Criterios no encontrados","Aceptar");					return;				}				//var a= getXmlAtt(cuboResultados,"r0","c2");				var b= getXmlAtt(cuboResultados,"r0","c3");				var c= getXmlAtt(cuboResultados,"r0","c4");				v_IvaAuto = getXmlAtt(cuboResultados,"r0","c20");				estado_compra = getXmlAtt(cuboResultados,"r0","c31");				estado_venta = getXmlAtt(cuboResultados,"r0","c32");				if (tip_ope &= "0"){					if(estado_compra &= "0"){						frn.message("Inventario Cancelado","Error","Aceptar");						frn.set("k_inventario","");						return;					}					if(estado_compra &= "10"){						frn.message("La factura no está registrada.","Error","Aceptar");						frn.set("k_inventario","");						return;					}					if(estado_venta &! "0"){						frn.message("El inventario ya está vendido.","Error","Aceptar");						frn.set("k_inventario","");						return;					}								}				if (tip_ope &= "3"){					if(estado_venta > 10){						frn.message("El inventario ya está vendido.","Error","Aceptar");						frn.setAtt("Aceptar","available","N");						frn.setAtt("Aceptar","visible","N");						return;					}					}															frn.set("k_serie_inv",b);				frn.set("k_desc_inv",c);				frn.set("k_monto",0);				frn.set("k_iva",0);				frn.set("subt",0);				//********************************************Obtener información de KDPEDIDOEXTRAS				cmd = " select c4,c5,c6,c7,c8,c9 from keplersc.KDPEDIDOEXTRAS where c1 = '" & sucursal_id &  "' and c2 = '" & v_inventario & "'";									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_Altapedido_seminuevo_extras_view.PedidosExtras()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\PedidosExtra");						totOrd = nXml(cuboResultados);				frn.rst("k_mov");				for (contOrd=0; contOrd<totOrd ; contOrd++){								frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c4"),"k_mov",contOrd,"c4");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c5"),"k_mov",contOrd,"c5");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c6"),"k_mov",contOrd,"c6");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c7"),"k_mov",contOrd,"c7");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c8"),"k_mov",contOrd,"c8");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c9"),"k_mov",contOrd,"c9");									}					busca_tomas();			}						fun BusquedaInventario()			{				var cmdQuery ="";					sucursal_id = frn.get("k_sucn",-1,1);					cmdQuery = "select c2 as inventario, c3 as Clave,c4 as Descripcion, c5 as Serie from keplersc.kdinf where c1 = '" & sucursal_id &  "' and c31 = 20 and c32 = 0 ";            						cmdQuery = cmdQuery & " order by c2 asc ";						frn.dialog("genlistafiltrosel","Alta Pedido / Inventario ",cmdQuery,"inventario","k_inventario","0","","N","S");            			}			fun ConsultarKDF3UNI()			{					var cmdQuery ="";										cmdQuery = "select c1 as cve,c2 as Descripción from keplersc.KDF3UNI ";					cmdQuery = cmdQuery & " order by c1 asc ";					//frn.dialog("genlistasel","Alta Pedido / Catálogo SAT ",cmdQuery,"cve","k_valor_unidad","0","","N");					frn.dialog("genlistafiltrosel","Alta Pedido / Catálogo SAT ",cmdQuery,"cve","k_valor_unidad","0","0","N","N");			}						fun ValidarValorKDF3UNI()			{				valorRetorno = frn.get("k_mov",-1,"c6");				var cmd ="",cuboProd,ok,mensajeError,prodExiste ;					cmd = "select count(*) as c1 from keplersc.KDF3UNI where c1 = '" & valorRetorno &  "'"; 				cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaPedidoAutos.ValidarValorKDF3UNI()");				//frn.lib("libGeneral.kpl","FileSave",cuboProd,"C:\Basura\cuboProdKDF3PS");								ok=getXmlAtt(cuboProd,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								prodExiste = getXmlAtt(cuboProd,"r0","c1");				if (prodExiste <= "0")				{									frn.message("El producto no existe.","Error","&Aceptar");					return;				}			}						fun ValidarValorKDF3PS()			{				valorRetorno = frn.get("k_mov",-1,"c4");				var cmd ="",cuboProd,ok,mensajeError,prodExiste ;					cmd = "select count(*) as c1 from keplersc.KDF3PS where c1 = '" & valorRetorno &  "'"; 				cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaPedidoAutos.ValidarValorKDF3PS()");				//frn.lib("libGeneral.kpl","FileSave",cuboProd,"C:\Basura\cuboProdKDF3PS");								ok=getXmlAtt(cuboProd,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboProd,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								prodExiste = getXmlAtt(cuboProd,"r0","c1");				if (prodExiste <= "0")				{									frn.message("El producto no existe.","Error","&Aceptar");					return;				}			}			fun ConsultarCliente()			{					var cmdQuery ="";										cmdQuery = "select c2 as cve,c3 as descripcion from keplersc.kdud k";					cmdQuery = cmdQuery & " order by cve asc ";					frn.dialog("genlistasel","Alta Pedido / Catálogo Clientes",cmdQuery,"cve","k_cliente","0","","N");			}				fun ConsultarKDF3PS()			{					var cmdQuery ="";										cmdQuery = "select c1 as cve,c2 as Descripción from keplersc.KDF3PS ";					cmdQuery = cmdQuery & " order by c2 asc ";					frn.dialog("genlistafiltrosel","Alta Pedido / Catálogo SAT ",cmdQuery,"cve","k_valor_retorno","0","0","N","N");					//frn.dialog("genlistafiltrosel","Alta Pedido / Catálogo SAT ",cmdQuery,"cve","k_valor_retorno","0","","N","S");								}			fun ValidarKDF3PS()			{				valorRetorno = frn.get("k_valor_retorno");				frn.setX(valorRetorno,"k_mov",-1,"c4");				}			fun ValidarKDF3UNI()			{				valorRetorno = frn.get("k_valor_unidad");				frn.setX(valorRetorno,"k_mov",-1,"c6");				}			fun inicializa(){//Da valor a los combos y prepara la página dependiendo del tipo de Operación a realizar				var resValidacion, 						resMensaje, 						cubo, 						cmd, 						ok,						mensajeError,						sucursal_id,						v_cliente,						v_tipoOperacion;				kdb.kde("KDE");//								Configuración del servidor				kdb.exec();				anio_contable = kdb.get("KDE","14");				frn.set("k_fecha",sys.date());												if(frn.nParam()>0 ){//Se han mandado parámetros a la página					gen_doc=trim(frn.param(0)); 					nat_doc=trim(frn.param(1)); 					gpo_doc=trim(frn.param(2));					tip_doc=trim(frn.param(3)); 					fija_doc=trim(frn.param(4));					tip_ope=trim(frn.param(5));					uen=trim(frn.param(6));									}				else				{					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}				ConfiguraCamposOpcion();				//Llena lista de grupo de documentos								if(tip_ope==0)				{//Baja					v_tipoOperacion = "Alta Pedido";				}				if(tip_ope==3)				{//Baja					v_tipoOperacion = "Baja Pedido";									}				if(tip_ope==1)				{//Baja					v_tipoOperacion = "Consulta Pedido";				}				frn.set("inp_titulo",v_tipoOperacion);				addDocto(v_tipoOperacion,gen_doc,nat_doc,gpo_doc,0,0,"A",30,35);											//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1, c2 as c3 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));								//Llenar combo tipo								LlenaCmbTipo();								frn.setX("N", "k_flotilla",0,0);				frn.setX("S", "k_flotilla",1,0);								Fecha();//Indica fecha correcta, y trae monedas y paridades de esa fecha. 				if (strlen(tip_doc)>0) frn.setPos("k_tipon",-1,4,"internal:Y","val:" & tip_doc);//Posiciona el combo de Tipo de documento al especificado como parï¿½metro								//LlenaCmbMoneda();				//Llenar Vendedor k_vendedor	k_tipo_operacion k_coach	k_cliente				LLenaCmbVendedores();								//llenar Operacion								cmd = "select '['||c1||'] '||c2 c2, c2, c1 from keplersc.KDTOP";										cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaPedido.Vendedor()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_tipo_operacion",getXml(cubo));								//Llenar k_coach				cmd = "select '['||c1||'] '||c2 as c3, c2,c1  from keplersc.KDCATCOACH";									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaPedido.Coach()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_coach",getXml(cubo));								//Llenar k_cliente				//cmd = "select '['||c2||'-'||c3||']' as c3, c2  from keplersc.kdud";				cmd = "select '['||c2||']-'||c3||'' as c3, c2  from keplersc.kdud";									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaPedido.Cliente()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_cliente",getXml(cubo));								//				if(tip_ope==0){//Alta					frn.set("operacion","ALTA");				}				else if(tip_ope==1){//Consulta					frn.set("operacion","CONSULTA");				}				else if(tip_ope==2){//Cancelaciï¿½n					frn.set("operacion","CANCELACIÓN");				}					else if(tip_ope==3){//Baja					frn.set("operacion","BAJA");				}					else if(tip_ope==4){//Modificaciï¿½n					frn.set("operacion","MODIFICACIÓN");				}				BorraDatos();			}						fun LlenaCmbTipo(){				var cubo,cmd,ok,mensajeError;				sucursal_id=frn.get("k_sucn",-1,1);						cmd = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and col_sucursal='" & sucursal_id & "'";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTipoDocto");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_tipon",getXml(cubo));			}						fun LLenaCmbVendedores(){				var cubo,cmd,ok,mensajeError;				sucursal_id = frn.get("k_sucn",-1,1);				cmd = "select '['||c2||'] '||c3 as c1, c3,c2 from keplersc.kduv where c1 = '" & sucursal_id &  "'";									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaPedido.Vendedor()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_vendedor",getXml(cubo));			}						fun CambiaSucursal(){				sucursal_id = frn.get("k_sucn",-1,1);				LlenaCmbTipo();				LLenaCmbVendedores();				Valida_Tipo_Docto();						}						fun LlenaCmbMoneda(){				frn.setX("PESOS","k_moneda",0,0);			} 						fun Valida_Tipo_Docto(){				var resValidacion, resMensaje, cubo, cmd, ok, tip_doc;							//Valida documento vigente				tip_doc=frn.get("k_tipon",-1,4);				kdb.rst();								cmd= "select * from keplersc.verify_valid_document('" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & tip_doc & ")"; //genero text, naturaleza text, grupo integer, tipo_movto integer				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Valida_Tipo_Docto()");								resValidacion= getXml(cubo,"validacion","resultado");				resMensaje = getXml(cubo,"validacion","mensaje");				if(resMensaje &! ""){					frn.message(resMensaje, "Mensaje","&Aceptar");					frn.setPos("k_tipon");				}								}						fun ConfiguraControlesOff()			{				var strValAtr;				strValAtr = "N";				//Deshabilita todos los campos y botones				frn.setAtt("grpDatosGenerales","available",strValAtr);				frn.setAtt("grDocumentos","available",strValAtr);								frn.setAtt("grpDoc","available","N");				frn.setAtt("grpDetalle","available",strValAtr);				frn.setAtt("grpInventario","available",strValAtr);				frn.setAtt("grpconceptosextras","available",strValAtr);				frn.setAtt("Aceptar","available",strValAtr);				frn.setAtt("Aceptar","visible",strValAtr);				frn.setAtt("Imprimir","available",strValAtr);				frn.setAtt("Imprimir","visible",strValAtr);					frn.setAtt("Cancelar","available",strValAtr);				frn.setAtt("Cancelar","visible",strValAtr);									frn.setAtt("k_folio","modify",strValAtr);					frn.setAtt("k_folio","visible",strValAtr);										frn.setAtt("k_fecha","modify",strValAtr);					frn.setAtt("k_fecha","available",strValAtr);				frn.setAtt("k_refer","modify",strValAtr);					frn.setAtt("k_refer","available",strValAtr);				frn.setAtt("k_fecref","modify",strValAtr);					frn.setAtt("k_fecref","available",strValAtr);				frn.setAtt("k_plazo","modify",strValAtr);					frn.setAtt("k_plazo","available",strValAtr);				frn.setAtt("k_cond","modify",strValAtr);					frn.setAtt("k_cond","available",strValAtr);					frn.setAtt("k_coment","modify",strValAtr);				frn.setAtt("k_coment","available",strValAtr);							frn.setAtt("k_c10","available",strValAtr);				frn.setAtt("k_c30","available",strValAtr);				frn.setAtt("k_c4","available",strValAtr);				frn.setAtt("k_c5","available",strValAtr);				frn.setAtt("k_c6","available",strValAtr);			}						fun ConfiguraCamposOpcion(){				var strValAtr;				ConfiguraControlesOff();				//HAbilita segun tipo de operacion				strValAtr = "Y";				switch(tip_ope){					case 0: //Alta						frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpDatosGenerales","modify",strValAtr);						frn.setAtt("grDocumentos","available",strValAtr);						frn.setAtt("grDocumentos","modify",strValAtr);						frn.setAtt("grpDetalle","available",strValAtr);						frn.setAtt("grpDetalle","modify",strValAtr);						frn.setAtt("grpInventario","available",strValAtr);						frn.setAtt("grpInventario","modify",strValAtr);						frn.setAtt("grpconceptosextras","available",strValAtr);						frn.setAtt("grpconceptosextras","modify",strValAtr);						frn.setAtt("Aceptar","available",strValAtr);						frn.setAtt("Aceptar","visible",strValAtr);							frn.setAtt("Cancelar","available",strValAtr);						frn.setAtt("Cancelar","visible",strValAtr);														frn.setAtt("k_fecha","modify",strValAtr);							frn.setAtt("k_fecha","available",strValAtr);						frn.setAtt("k_refer","modify",strValAtr);							frn.setAtt("k_refer","available",strValAtr);						frn.setAtt("k_fecref","modify",strValAtr);							frn.setAtt("k_fecref","available",strValAtr);						frn.setAtt("k_plazo","modify",strValAtr);							frn.setAtt("k_plazo","available",strValAtr);						frn.setAtt("k_cond","modify",strValAtr);							frn.setAtt("k_cond","available",strValAtr);													frn.setAtt("k_coment","modify",strValAtr);						frn.setAtt("k_coment","available",strValAtr);																		break;					case 1: //Consulta												frn.setAtt("grpDatosGenerales","available",strValAtr);						//frn.setAtt("grpDocumentos","available",strValAtr);						//frn.setAtt("grpDocumentos","modify",strValAtr);						frn.setAtt("k_folio","modify",strValAtr);							frn.setAtt("k_folio","visible",strValAtr);												frn.setAtt("Imprimir","available",strValAtr);						frn.setAtt("Imprimir","visible",strValAtr);						frn.setAtt("k_coment","available",strValAtr);													break;					case 2: // modificar										break;					case 3: // BAJA						frn.setAtt("grpDatosGenerales","available",strValAtr);						frn.setAtt("grpDatosGenerales","modify",strValAtr);						frn.setAtt("grDocumentos","available",strValAtr);						frn.setAtt("grDocumentos","modify",strValAtr);						frn.setAtt("grpDetalle","available","N");						frn.setAtt("grpDetalle","modify","N");						frn.setAtt("grpProveedor","available","N");						frn.setAtt("grpProveedor","modify","N");						frn.setAtt("grpconceptosextras","available","N");						frn.setAtt("grpconceptosextras","modify","N");						frn.setAtt("Aceptar","available",strValAtr);						frn.setAtt("Aceptar","visible",strValAtr);							frn.setAtt("Cancelar","available",strValAtr);						frn.setAtt("Cancelar","visible",strValAtr);						frn.setAtt("k_folio","modify",strValAtr);							frn.setAtt("k_folio","visible",strValAtr);											frn.setAtt("k_coment","available",strValAtr);						break;					case 4: 						break;					default:				}											}									fun BorraDatos(){ //Limpia todos los campos para generar un nuevo documento. 				frn.set("k_folio","","statusDoc","","k_clave","","k_refer","","k_fecref",""); 				frn.rst("k_mov");frn.rst("k_poliza");								Clave(1);				if(tip_ope>0) frn.setPos("k_folio");							}						fun addDocto(Descripcion,Gen,Nat,Gru,bTipo_Especifico,bSoloAutorizado,NatPrv,GruPrv,Gru2Prv){				var renglon=frn.N("grpDoc");				frn.setX(trim(Descripcion),"grpDoc",renglon,0);				frn.setX(trim(Gen),"grpDoc",renglon,1);				frn.setX(trim(Nat),"grpDoc",renglon,2);				frn.setX(trim(Gru),"grpDoc",renglon,3);				frn.setX(trim(bTipo_Especifico),"grpDoc",renglon,4);				frn.setX(trim(bSoloAutorizado),"grpDoc",renglon,5);				frn.setX(trim(NatPrv),"grpDoc",renglon,6);				frn.setX(trim(GruPrv),"grpDoc",renglon,7);				frn.setX(trim(Gru2Prv),"grpDoc",renglon,8);			}								fun Clave(iModo){//Actualiza los datos del cliente o Proveedor 				if(iModo==0){					var cmd="datos,u,1,0,'" & frn.get("k_clave") & "',&,u1...u50,v3";kdb.rel("v2=u12"); kdb.search(cmd); 					kdb.exec(); 					if(kdb.ok("datos")==0){						if(strlen(trim(frn.get("k_clave")))>0)	frn.message("La clave "&frn.get("k_clave")&" no se encontró","Error","&Aceptar");						frn.setPos("k_clave");//La clave no existe					}				}else{kdb.rst("datos");}//Borra la info anterior				frn.set("k_clave",kdb.get("datos","u2"),"k_rfc",kdb.get("datos","u10"),"k_plazo",kdb.get("datos","u16"));				frn.set("k_nombreprov",kdb.get("datos","u3"));				frn.set("k_calleprov",kdb.get("datos","u4"));				frn.set("k_coloniaprov",kdb.get("datos","u5"));				frn.set("k_poblacionprov",kdb.get("datos","u6"));				frn.set("k_cpprov",kdb.get("datos","u27"));								//frn.setM("k_datCve",kdb.get("datos","u3"),kdb.get("datos","u4"),kdb.get("datos","u5"),kdb.get("datos","u6"),kdb.get("datos","u27"));				frn.setM("k_coment",kdb.get("datos","u24"),kdb.get("datos","u25"),kdb.get("datos","u26"));								Plazo();				CalcTotal();//para que aplique descuentos, etc.			}						fun Plazo(){ //Calcula la fecha de pago, y las condiciones de pago en base al plazo				frn.set("k_vence",fnDate("addC",frn.get("k_fecha"),frn.get("k_plazo")));//Suma días comerciales				var cond=frn.get("k_plazo") & " días fecha factura";				if (frn.get("k_plazo")==0) cond="Pago de contado";				frn.set("k_cond",cond);  			}						fun Fecha(){//Verifica que la fecha del documento sea correcta. Ademï¿½s trae monedas y paridades de esa fecha. 				var cubo, cmd, resValidacion, resMensaje, fecha;				var validDate=frn.lib("libKepler","ValidOpDate",frn.get("k_fecha"));												frn.set("k_moneda","PESOS");				frn.set("k_paridad",0);								kdb.rst();				frn.rst("results");				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				if (tip_ope == 0 ){					cmd= "select * from keplersc.verify_year('" & fecha & "')";					cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Fecha()");									;										resValidacion= getXml(cubo,"validacion","resultado");					resMensaje = getXml(cubo,"validacion","mensaje");					if(resMensaje &! ""){						frn.message(resMensaje, "Mensaje","&Aceptar");					}											if(resValidacion &= "0"){						frn.setPos("k_fecha");						return;					}									}				//Plazo();			}									fun CalcTotal(){ //Calcula los importes parciales y el total				var bConsulta=((tip_ope>=1)&&(tip_ope<=3))?1:0;//Se está consultando el documento. Solo recalcular subtotales				var T=0,IVA=0; //SUBTOTAL, IVA x partida				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {					if ( (frn.get("k_mov",i,"k_precio")==0)&&(frn.get("k_mov",i,"k_monto")>0) ){//Se requiere calcular el precio en base al importe						var prc=frn.get("k_mov",i,"k_monto")/frn.get("k_mov",i,"k_Q");						frn.setX(prc,"k_mov",i,"k_precio"); 					}					var imp=frn.get("k_mov",i,"k_Q")*frn.get("k_mov",i,"k_precio");//importe de partida					frn.setX(imp,"k_mov",i,"k_monto");										T=T+ math("round",imp,2);					//Impuesto por producto					if (frn.get("k_tipon",-1,6)==99)//Iva por producto						if (frn.get("k_mov",i,"k_iva")<0){								T=T-math("round",imp,2);								imp=frn.get("k_mov",i,"k_Q")*frn.get("k_mov",i,"k_precio");//importe de partida							  imp=imp/(1+((-1)*(frn.get("k_mov",i,"k_iva")/100)));//desglosar el IVA							  								T=T+ math("round",imp,2);								IVA=IVA+imp*(-1)*(frn.get("k_mov",i,"k_iva")/100);													}else {														IVA=IVA+imp*frn.get("k_mov",i,"k_iva")/100;						}								}				frn.set("subt",T); 				if(bConsulta)return;				if (frn.get("k_tipon",-1,6)==99){					frn.set("k_iva",IVA*0.16);//Al tener iva por producto;				}				else{					frn.set("k_iva",(frn.get("subt"))*frn.get("k_tipon",-1,6)/100);				}								frn.set("k_ivaRet",frn.get("subt")*frn.get("k_tipo",-1,8)/100);				frn.set("k_monto",frn.get("subt")+frn.get("k_iva")-frn.get("k_ivaRet"));			}						fun Cantidad(checa_cero)			{ //Si checa_cero=1, solo despliega la ventana de control auxiliar si la cantidad es 0				var bAux=(frn.get("k_tipon",-1,10) && frn.get("k_mov",-1,"k_recAux"));				if (checa_cero==1){					var Qiguales=1;					if(bAux){						var S=0; for(var i=0,n=frn.N("k_mov",-1,"k_recAuxReal");i<n;i++) S+=frn.get("k_mov",-1,"k_recAuxReal","r" & i,"k_Q");						if(S!=frn.get("k_mov",-1,"k_Q"))Qiguales=0;					}					if(Qiguales && frn.get("k_mov",-1,"k_Q")>0)return;				}				if (bAux){					frn.setPos("k_mov",-1,"k_Q");					Dialog(3,(frn.get("k_tipon",-1,2) &= "D")?"doc_aux":"doc_auxE","k_mov",frn.get("k_mov",-1,"k_bSer"),frn.get("k_mov",-1,"k_iLot"),frn.get("k_mov",-1,"k_bPed"),frn.get("k_mov",-1,"k_bUbi"),frn.get("k_mov",-1,"k_iTMC"),frn.get("k_pedimento"));				}else{					var bNoRojo=frn.get("k_tipon",-1,9),inv=frn.get("k_mov",-1,"k_inv"),q=frn.get("k_mov",-1,"k_Q"),iNat=frn.get("k_mov",-1,"k_iNat");					if (bNoRojo&&inv<q&&iNat&!"N"&&iNat&!"V"){						frn.message("No se permite movimiento en rojo", "Error","&Aceptar");						frn.setX(inv,"k_mov",-1,"k_Q");					}				}				CalcTotal();			}			fun Monto(){//Cambia el precio de la partida en base al monto especificado(importe de partida)				var prc=frn.get("k_mov",-1,"k_monto")/frn.get("k_mov",-1,"k_Q");				frn.setX(prc,"k_mov",-1,"k_precio"); 				CalcTotal();			}			fun ConsultarFolio()			{					var strTmp;										strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & frn.get("k_folio");					frn.set("k_docto",strTmp);										valorRetorno = frn.get("k_folio");					var cmd ="",cuboProd,ok,mensajeError,prodExiste;										cmd = "select km1.c1,km1.c9,km1.c10,km1.c11, ";					cmd = cmd & "(select '['||c2||'] '||c3 from keplersc.kduv uv where uv.c1=km1.c1 and uv.c2=km1.c12) as c12, ";					cmd = cmd & "km1.c14,km1.c15,km1.c16,km1.c22,km1.c30,km1.c32, ";					cmd = cmd & "(select '['||c1||'] '||c2 c2 from keplersc.KDTOP ktop where ktop.c1 = km1.c97) as c97, "; 					cmd = cmd & "(select '['||c1||'] '||c2 from keplersc.KDCATCOACH kdcat where kdcat.c1 =  km1.c27) as c27, ";					cmd = cmd & "(select c29 from keplersc.kdpedido kp where kp.c1 = km1.c1 and kp.c7 = km1.c6  and kp.c2 = km1.c11) as c29, c24,c25,c26 ";					cmd = cmd & "from keplersc.kdm1 km1 where km1.c2 = '" & gen_doc &  "' and km1.c3 = '" & nat_doc &  "' and km1.c4 = '" & gpo_doc &  "' and km1.c5 = '"&tip_doc &"' and km1.c6 = '" & valorRetorno &  "' order by km1.c9 desc"; frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdPedido");					cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaPedidoAutos.ConsultarFolio()");frn.lib("libGeneral.kpl","FileSave",cuboProd,"C:\Basura\cuboPedido");					ok=getXmlAtt(cuboProd,"ok");					if(ok &! "" && !ok)					{						mensajeError = getXmlAtt(cuboProd,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					prodExiste = getXmlAtt(cuboProd,"r0","c1");										if (prodExiste <= "0")					{						frn.message("El producto no existe.","Error","&Aceptar");						return;					}					frn.set("k_inventario",getXmlAtt(cuboProd,"r0","c11"));					frn.set("k_flotilla",getXmlAtt(cuboProd,"r0","c29"));					frn.set("k_vendedor",getXmlAtt(cuboProd,"r0","c12"));					MostrarInventario();					frn.set("k_tipo_operacion",getXmlAtt(cuboProd,"r0","c97"));					frn.set("k_coach",getXmlAtt(cuboProd,"r0","c27"));					frn.set("k_cliente",getXmlAtt(cuboProd,"r0","c10"));										frn.set("subt",getXmlAtt(cuboProd,"r0","c15"));					frn.set("k_iva",getXmlAtt(cuboProd,"r0","c14"));					frn.set("k_monto",getXmlAtt(cuboProd,"r0","c16"));					frn.set("k_coment",getXmlAtt(cuboProd,"r0","c24"));					frn.set("k_fecha",getXmlAtt(cuboProd,"r0","c9"));					MostrarCliente();			}						fun ObtenerFolio()			{				   var cmdQuery ="",v_tipo_n;					v_tipo_n = frn.get("k_tipon",-1,4);					sucursal_id = frn.get("k_sucn",-1,1);					cmdQuery = "select c1 as tip, c6 as folio, to_char(c9, 'dd/mm/yyyy') as fecha,c11 as referencia, c16 as monto   from keplersc.kdm1  where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc&  "' and c3 = '" & nat_doc&  "' and c4 = '" & gpo_doc&  "' and c5 = '" & v_tipo_n &  "'  and c43 <> 'C' ";					cmdQuery = cmdQuery & " order by c6 desc ";					frn.dialog("genlistasel","Alta Pedido / Folio.",cmdQuery,"folio","k_folio","0","","N");			}					fun CalcFolio(){//Se ejecuta después de consultar documento en disco (consulta,documento previo,etc), para manipulaciones adicionales en pantalla				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {//Se recalcula el precio con mayor precisión (decimales)					var prc=frn.get("k_mov",i,"k_monto")/frn.get("k_mov",i,"k_Q");					frn.setX(prc,"k_mov",i,"k_precio");				}				CalcTotal();//Recalcula Totales			}			fun Ejecuta(){				if(tip_ope==0){Alta();}				else if(tip_ope==1){Consulta();}				else if(tip_ope==2){Cancela();}				else if(tip_ope==3){Baja();}				else if(tip_ope==4){Modifica();}			}						fun Alta()			{				var resultado, mensaje, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd;				var partidasValidas = 0;				kdb.rst();				frn.rst("results");								fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				cmd= "select * from keplersc.verify_year('" & fecha & "')";				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"CREW_PEDIDO.Alta()");												resultado= getXml(cubo,"validacion","resultado");				mensaje = getXml(cubo,"validacion","mensaje");				if(mensaje &! ""){					frn.message(mensaje,"Error al generar el documento","Aceptar");				}									if(resultado &= "0"){					frn.setPos("k_fecha");					return;				}								if( frn.get("k_monto") <= 0 ){					frn.message("Monto cero ó negativo","Error","&Aceptar");return;				}								fecha = sys.date();				hora= sys.time();				//cubo = "dat";				kdb.rst();				frn.rst("results");				frn.rst(xmlPantalla);				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;								setXml(xmlPantalla,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"k_clave",frn.get("k_cliente" , -1, 1));				setXml(xmlPantalla,"k_vendedor",frn.get("k_vendedor" , -1, 2));				setXml(xmlPantalla,"k_refer",frn.get("k_inventario"));				setXml(xmlPantalla,"k_natdocto",nat_doc);				setXml(xmlPantalla,"k_gpodocto",35); //definido para Alta				setXml(xmlPantalla,"k_tipodocto",tip_doc); 				setXml(xmlPantalla,"k_fecref",strFecha);				setXml(xmlPantalla,"operacion",frn.get("k_tipo_operacion", -1, 2));				setXml(xmlPantalla,"k_ivadesglosado","N");				setXml(xmlPantalla,"k_nombreimprfact",frn.get("k_c30"));				setXml(xmlPantalla,"k_claveinv",frn.get("k_inventario"));				setXml(xmlPantalla,"k_tipopagos","0");				setXml(xmlPantalla,"k_tipoauto","N");				setXml(xmlPantalla,"k_correo",v_correo);				setXml(xmlPantalla,"k_cfdi",v_uso_cfdi);				setXml(xmlPantalla,"k_pedimento",frn.get("k_coach", -1, 2));					frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlAltaPedidoAutos");				cmd="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"comopecompras.Alta");								resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");								if(resultado &= "1")				{					tip_ope = 1;					frn.set("k_folio",mensaje); 					frn.set("operacion","CONSULTA");										strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);					ConfiguraCamposOpcion();										mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;					frn.message(mensaje, "Mensaje","&Aceptar");				}else{					frn.message(mensaje, "Error","&Aceptar");				}			}						fun Consulta(){//Imprime el reporte del documento especificado 				if(strlen(trim(frn.get("k_folio")))==0){ 					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");					frn.setPos("k_folio");return;					}								reporte();				frn.setPos("k_folio");			}						fun Cancela() {				frn.message("Función no implementada...","Error","&Aceptar");			}						fun Baja()			{ 				var folio_baja,xmlPantalla,cuboResultados,cmd,ok,mensajeError,resultado,mensaje  ;				frn.rst(xmlPantalla);				folio_baja = frn.get("k_folio");								xmlPantalla = getXml(frn.dataPag());				setXml(xmlPantalla,"k_folio",folio_baja);				setXml(xmlPantalla,"k_rol_usuario",rol_usuario);				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\cuboResultadosBajaPedido");				cmd="SELECT * FROM keplersc.cat_autobajapedido_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"AltaPedido.Baja()");				resultado = getXml(cuboResultados,"resultado");				mensaje = getXml(cuboResultados,"mensaje");				if(ok &! "" && !ok)				{					mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				else				{					if (resultado==1){						frn.message("Folio " & folio_baja & " se dió de baja.","Información","Aceptar");					}else{						frn.message(mensaje,"Error","Aceptar");					}				}			}							fun Modifica(){				frn.message("Funcion no implementada...","Error","&Aceptar");			}			fun reporte()			{				//se obtiene la información a utilizar										sucursal_id = frn.get("k_sucn",-1,1);									v_inventario = frn.get("k_inventario");									var xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaPedido");															var cmd ="",cuboProd,ok,mensajeError,prodExiste;					cmd = "select (select c5 from keplersc.KDUD where c2 = '"&frn.get("k_cliente")&"' ) as udc5,"&							" (select c6 from keplersc.KDUD where c2 = '"&frn.get("k_cliente")&"' ) as udc6,"&							"(select c7 from keplersc.KDUD where c2 = '"&frn.get("k_cliente")&"' ) as udc7, "&							"c1,c21,c5,c15,''||c17||' '||(select km.c2 from keplersc.kdmarca km where km.c1 = c17) as c17,"&							"''||c3||'-'||c4 as c3,''||c10||'   '||c34 as c10,''||c11||'   '||c35 as c11,c8,"&							" (select ''||ki.c1||'   '||ki.c2  from keplersc.KDIC ki where ki.c1 = c18) as c18,c9 "&							"from keplersc.KDINF  where c1 = '" & sucursal_id & "' and c2 = '" & v_inventario &  "'"; 					cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"AltaPedidoAutos.ConsultarDescripcionKDINF()");					frn.lib("libGeneral.kpl","FileSave",cuboProd,"C:\Basura\cuboConsPedido");										ok=getXmlAtt(cuboProd,"ok");					if(ok &! "" && !ok)					{						mensajeError = getXmlAtt(cuboProd,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					prodExiste = getXmlAtt(cuboProd,"r0","c1");										if (prodExiste <= "0")					{						frn.message("El producto no existe.","Error","&Aceptar");						return;					}								var prefix=frn.lib("libKepler","langPrefix");				//var pageFto="\#092"&"k80_xsddesarrollo"&"\#092"&prefix&"comopecomprasfto"; //"\k80_xsddesarrollo\" & prefix & "comopecomprasfto"; //prefix&"comopecomprasfto";				//kdb.readPage("datos", pageFto);//se define el formato a usar				kdb.kde("KDE");//Configuración del servidor				kdb.exec();								kdb.readPage("datos","ven_Altapedido_crud_fto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos")); 				rep.rst(); 				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste								rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");								rep.set("k_empresa",kdb.get("KDE","1"));				rep.set("titulo",frn.get("k_tipon"));				rep.exe("tit");								rep.set("rep_suc",frn.get("k_sucn",-1,0));					rep.set("rep_inventario_anterior",getXmlAtt(cuboProd,"r0","c9"));				rep.set("rep_docto",frn.get("k_docto"));				rep.set("rep_refer",frn.get("k_folio"));				rep.set("rep_fecha",frn.get("k_fecha"));				rep.exe("encabezado");				rep.set("rep_cliente",frn.get("k_cliente"));				rep.set("rep_clientedir1",frn.get("k_nombre_impresion"));				rep.set("rep_nombrecliente",frn.get("k_c30"));				rep.set("rep_nombreimpresion",frn.get("k_nombre_impresion"));				rep.set("rep_clientedir2",frn.get("k_c4"));								rep.set("rep_rfc",frn.get("k_c10"));				rep.set("rep_colonia",getXmlAtt(cuboProd,"r0","udc5"));				rep.set("rep_poblacion",getXmlAtt(cuboProd,"r0","udc6"));				rep.set("rep_telefono",getXmlAtt(cuboProd,"r0","udc7"));				rep.set("rep_condiciones",frn.get("k_vendedor"));				rep.set("rep_usadonuevo",getXmlAtt(cuboProd,"r0","c21"));				rep.set("rep_inventario",frn.get("k_inventario"));								rep.set("rep_serie",getXmlAtt(cuboProd,"r0","c5"));				rep.set("rep_modelo",getXmlAtt(cuboProd,"r0","c15"));				rep.set("rep_marca",getXmlAtt(cuboProd,"r0","c17"));				rep.set("rep_clase",getXmlAtt(cuboProd,"r0","c18"));				rep.set("rep_tipooperacion",frn.get("k_tipo_operacion"));								rep.set("rep_tipo",getXmlAtt(cuboProd,"r0","c3"));				rep.set("rep_color",getXmlAtt(cuboProd,"r0","c10"));				rep.set("rep_vestiduras",getXmlAtt(cuboProd,"r0","c11"));				rep.set("rep_transmision",getXmlAtt(cuboProd,"r0","c8"));				rep.set("rep_preciobase",(frn.get("k_monto")-frn.get("k_iva")-frn.get("subt")));				rep.set("rep_precioisvn",frn.get("subt"));				rep.set("rep_precioiva",frn.get("k_iva"));				rep.set("rep_preciototal",frn.get("k_monto"));								rep.exe("seccion_detalle");								rep.set("rep_ad_administra","0");				rep.set("rep_ad_accesorios","0");				rep.set("rep_ad_garantiaext","0");				rep.set("rep_ad_seguroauto","0");				rep.set("rep_ad_intereses","0");				rep.set("rep_ad_cobranza","0");				rep.set("rep_ad_descuentos","0");				rep.set("rep_suc_recibi",frn.get("k_sucn",-1,2));				rep.exe("seccion_detalle_tres");				rep.win(); 			}					fun Documentos(tipo) {//Tipo: 1)Permite consultar documentos; 2) Permite referenciar documentos previos; 3) Permite referenciar partidas previas				//var pag_dialogo="doc_part_prv";				switch(tipo){					case 1:						frn.dialog("doc_consulta","k_folio",frn.get("grpDoc",-1,1));						break;					case 2:						break;					case 3:						break;				}			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaciï¿½n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se estï¿½ en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}			}				</script></pag>