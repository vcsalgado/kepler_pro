	<script>
		InstallDriver("KDB75");
		
		class Main {
			var frn,kdb, sys, rep, frP;
			var usuario, rol_usuario, suc_usuario, anio_contable;
			// Variables de control
			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, cliente_id, refer_id, adenda_id,tiporden,desc_tipo, numorden, punto, descripcion, costo, resVal, porc_iva;
			var segmento, variable,valor, tipo_id, m67, m77;
			var fileSavePath;
			//Variables de parametros
			var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope,uen;
							
		fun Main() {
			frn=new FRNT;
			kdb=new KDB;
			rep=new REP;
			frP=new FRNTP;
			sys=new SYS;
			kdb.connect();
			kdb.kde("KDE");
			kdb.exec();
			anio_contable = kdb.get("KDE","14");
			usuario = frn.config("user","name");
			rol_usuario = frn.config("user","role");
			suc_usuario = frn.lib("libKepler","UserInfo(1)");
			fileSavePath = "C:\Basura";
			Inicializa();				
			ConfiguraControlesOpcion();
		}
			
		//Validacion Datos Generales antes de Guardar.
		//El resultado de cada validacion se guarda en la variable global resVal.
		fun ValidarDatos() {
			var totReg, strTotal=0,subTotal=0,iva=0,total=0,formapago_id,str,metodoPago,usoCfdi,email,nReg,CveInv;
			//Obtener variables
			sucursal_id = frn.get("k_sucn",-1,1);
			cliente_id = frn.get("k_clave");
			
			//Validar Cliente
			cmdQuery="SELECT count(*) as totreg from keplersc.kdud where c2 = '" & cliente_id & "'";
			rstXml(cuboQuery);				
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venaltanticipo.ValidarDatos()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			totReg=getXmlAtt(cuboQuery,"r0","totreg");
			if(totReg==0){
				frn.message("El cliente no existe.","Error","Aceptar");
				resVal=0;
				return;
			}
			
			//Validar Forma de Pago
			formapago_id=frn.get("k_f_pago",-1,1);			
			if (formapago_id &=""){
				frn.setPos("k_f_pago");
				resVal=0;
				frn.message("Es necesario seleccionar la Forma de Pago","Error","Aceptar");
				return;			
			}

			//Valida Cuenta			
			formapago_id=frn.get("k_f_pago",-1,1);			
			if (formapago_id &="02" || formapago_id &="03" || formapago_id &="04" || formapago_id &="06" || formapago_id &="28" || formapago_id &="29"){
				if(frn.get("k_cuenta")==0 || frn.get("k_cuenta")&=""){
					frn.setPos("k_cuenta");
					resVal=0;
					frn.message("Es necesario capturar la Cuenta","Error","Aceptar");
					return;
				}	
			}
			//Validar Metodo de Pago, Uso Cfdi
			metodoPago=frn.get("k_m_pago");	
			usoCfdi=frn.get("k_cfdi");
			email=frn.get("k_correo");			
			if (metodoPago &="" || usoCfdi &="") {
				frn.setPos("k_clave");
				resVal=0;
				frn.message("Es necesario actualizar los datos del cliente, falta método de pago o uso de CFDI","Error","Aceptar");
				return;			
			}
				
			//Validar Totales
			CalculaTotales();
			total=frn.get("k_monto");
			if (total <= 0){
				frn.message("El total de la operación no puede ser cero.","Error","Aceptar");
				resVal=0;
				return;
			}								
		} 

		fun CambiaFolio(){
			frn.set("k_docto", "");
			frn.set("k_fecha", "");
			frn.set("k_hora", "");
			LimpiaInf();
			LimpiaDatosCte();
		}

		fun Formar_folio(){
			var xmlReqEst, cubofol, cmd, ok, mensajeError ;
			CambiaFolio();
			setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));
			setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));
			setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));
			setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));
			setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));
			setXml(xmlReqEst,"document","uen",uen);

			cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";
			cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venaltanticipo.Formar_folio()");
			var resultado =getXmlAtt(cubofol,"r0", "resultado");
			if(resultado &= "0"){
				mensajeError = getXmlAtt(cubofol,"r0", "mensaje");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			var fol = getXmlAtt(cubofol,"r0", "mensaje");
			frn.set("k_folio", fol);
		}

		fun ObtenerFolio() {
			sucursal_id = frn.get("k_sucn",-1,1);
			LimpiaEncabezado();
			cmdQuery = "select c5 as tipo, c6 as folio, substring(cast(c9 as VARCHAR),1,10) as fecha, c10 as cve_cliente, " &
						"c11 as referencia, c100 as inventario, c16 as monto ,concat(c5,'~',c6) as llave " &
						"from keplersc.kdm1 " &
						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" & gpo_doc &
						" order by c9 desc";
				
			frn.dialog("genlistafiltrosel","Folios de Anticipos",cmdQuery,"llave","strfolio","0","0","N","S");	
		
		}

		fun SeparaFolio(){
			var folio,nCampos,nfolio;	
			//Separa el folio y tipo, vienen concatenados con ~
			nCampos = strSplit(frn.get("strfolio"),"~",-1);
			if (nCampos > 1) {
				tip_doc = strSplit(frn.get("strfolio"),"~",0);
				nfolio = strSplit(frn.get("strfolio"),"~",1);
				frn.set("k_tipon",descr_combo("k_tipon",4,tip_doc));
			}else{
				nfolio = frn.get("strfolio");
			}	
			folio = nfolio;
			frn.set("k_folio", folio);

		}

		fun BuscarFolio() {
			var folio;
			folio =frn.get("k_folio");
			resVal = 1;
			//ValidaFolioCancelado(folio);			//validar si hay folios cancelados
			if(resVal == 0){
				return;
			}
			else{
				MostrarDatos(folio);
			}			
			ArmarRefDocto();
		}

		fun Cancela() {
			CambiaSucursal();
			Inicializa();
			ConfiguraControlesOpcion();
		}
			
		fun ModoBuscar() {
			LimpiaEncabezado();
			ConfiguraControlesOpcion();
		}
		
		fun Ejecuta() {
			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;
			var nat_doc_anx, gpo_doc_anx, tip_doc_anx, folio_doc_anx, iva_desg,strCfdi,strCveInv,moneda,fec_vencimiento;
			var resultado, mensaje, folio;
				
			fecha = sys.date();
			hora= sys.time();
			strCfdi=frn.get("k_cfdi",-1,1);
			fec_vencimiento=frn.get("k_fecha");
			if (tip_ope &= "A") {			
				//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok
				resVal = 1;
				ValidarDatos();
				if(ok &! "1" || resVal == 0){
					return;
				}
				
				//Pantalla validacion CFDI
				if (frn.get("datcfdi") &= "N"){
					frn.dialog("icfdreview",frn.get("k_sucn",-1,1),frn.get("k_clave"),"Ejecuta","cmb",frn.get("k_f_pago",-1,1),frn.get("k_cuenta"),frn.get("k_m_pago"), "cmb", frn.get("k_cfdi", -1, 1));
					return;
				}	
				
				continua = frn.message("¿Desea continuar con la alta de la factura?","Atención",2);
				if (continua == 0){
					frn.set("datcfdi","N");	//Pantalla validacion CFDI
					return;
				}				
				
				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
				//Agregar usuario, fecha y hora de movimiento, nat, gpo y tipo docto a anexar, IVA desglosado
				
				folio_doc_anx="VXX0000001";
				iva_desg="S";
				moneda="PESOS";
				strFecha = fnDate("year",fecha) & "-";
				strTmp = fnDate("month",fecha);
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp & "-";
				strTmp = fnDate("day",fecha);
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp;
				//agregar fecha vencimiento k_vence
				setXml(xmlPantalla,"k_vence",fec_vencimiento);
				setXml(xmlPantalla,"k_moneda","r0",moneda);
				setXml(xmlPantalla,"k_foliodocto",folio_doc_anx);
				setXml(xmlPantalla,"k_ivadesglosado","r0",iva_desg);
				setXml(xmlPantalla,"k_cfdi",strCfdi);
				setXml(xmlPantalla,"movimiento","usuario",usuario);
				setXml(xmlPantalla,"movimiento","fecha",strFecha);
				setXml(xmlPantalla,"movimiento","hora",
				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 
				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));
				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);
				setXml(xmlPantalla,"ambiente","uen",uen);
					
				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaAnticipo");
		
				
				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";
				//kdb.rst(cuboQuery);
				rstXml(cuboQuery);
					
				cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"venaltanticipo.Ejecuta");				
				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoFactOrden");
					
				resultado = getXml(cuboQuery,"resultado");
				mensaje = getXml(cuboQuery,"mensaje");
					
				ok = getXmlAtt(cuboQuery,"ok");
				if(ok &! "" && !ok) {
					mensajeError = getXmlAtt(cuboQuery,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;	
				}

				if(resultado &= "1") {
					tip_ope = "C";
					frn.set("k_folio", mensaje); 
					frn.set("operacion", "CONSULTA");
					strTmp = frn.get("k_docto");
					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;
					frn.set("k_docto", strTmp);
					strMsg = "El Folio utilizado para esta operación fue : " & mensaje;
					ConfiguraControlesOpcion(); 
					frn.message(strMsg, "Mensaje", "Aceptar");
					folio = frn.get("k_folio");
					MostrarDatos(folio);	
					BuscarFolio();
				} else {
					frn.message(mensaje, "Error", "Aceptar");
					frn.set("datcfdi","N");	//Pantalla validacion CFDI
					return;
				}
				
			} else {/*Consulta*/
				folio = frn.get("k_folio");
				MostrarDatos(folio);
				ArmarRefDocto();
				
			}		
		}
						
		fun Inicializa(){ //Inicializa los valores en Pantalla
			// Revisa parametros recibidos
			if( frn.nParam() == 6 ){ //Se han mandado parámetros a la página
                gen_doc=trim(frn.param(0)); 
                nat_doc=trim(frn.param(1)); 
                gpo_doc=trim(frn.param(2));
                tip_doc=trim(frn.param(3)); 
                tip_ope=trim(frn.param(4));
				uen=trim(frn.param(5));
				if (uen &= ""){
					uen="XXX";
				}
                
			} else {
			frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");
			frn.open("redirect",2);
			return;
			}
            
			if(tip_ope &= "A"){ //Alta
				frn.set("operacion","ALTA");
			} else {
				if(tip_ope &= "B"){ //Baja
					frn.set("operacion","BAJA");
				} else {
					if(tip_ope &= "C"){ //Consulta
						frn.set("operacion","CONSULTA");
					} else {
						frn.message("Operación no válida ...", "Mensaje","&Aceptar");
						frn.open("index",4);
						return;			
					}
				}
			}
				
			// Fill Combo Sucursal (Con Query de PostgreSQL)
			cmdQuery = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdms";
			IniCombos("k_sucn",cmdQuery);
			
			// Fill Combo Tipo (Con Query FTO Kepler) 
			cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5,"&
					   "c16 as c6,c7,c14,c47,c80,c86,c89,c67,c77 from keplersc.kdmm"&
					   " where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' order by c4";
			IniCombos("k_tipon",cmdQuery);

			//Llena Combo Forma de pago
			CmbFormaPago();
			
			//Llena Combo Uso Cfdi
			cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3uso";
			IniCombos("k_cfdi",cmdQuery);

			frn.set("k_fecha",sys.date());
			frn.set("k_hora",sys.time());	
							
			// Fill k_docto | referencia docto
			ArmarRefDocto();
			LimpiaDatosCte();

			if(tip_ope &= "A"){
				fecha_config();
			}
			IniParams();
			
			frn.set("datcfdi","N");		//Pantalla validacion CFDI
		}

		fun fecha_config(){
			//validar k_fecha
			//se basa en k75 SUB CFD_FOLIO
			
			var cmd, cubo;
			sucursal_id=frn.get("k_sucn",-1,1);				
			cmd = "select C4 from keplersc.kdcfdconfig where c1='" & sucursal_id & "'";				
			cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venaltanticipo.fecha_config()");
			//frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboc4");
			ok=getXmlAtt(cubo,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cubo,"native3");
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			var fec = getXmlAtt(cubo,"r"&0,"c4");	
			if (getXmlAtt(cubo,"r"&0,"c4") &= "1"){
				frn.set("k_fecha",sys.date(sys.date("year"),sys.date("month")-1,31));
				//frn.message(sys.date(sys.date("year"));
				//frn.message(sys.date("month"));
			}else{
				frn.set("k_fecha",sys.date());
			}
			Ajustes_doc();
		}

		//validaciones por tipo de documento 
		fun Ajustes_doc() {
			//se basa en k75 SUB DEFINE_CFD_LINKS y en SUB CFD_FOLIO
			var cmd,cubo;
			cmd = "select c80 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4='" & tip_doc & "'" ;
			cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venaltanticipo.Ajustes_doc()");
			//frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\c80");
			ok=getXmlAtt(cubo,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cubo,"native3");
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			if (getXmlAtt(cubo,"r"&0,"c80") &= "S"){
				frn.setAtt("k_fecha", "modify", "N" );
			}else {
				frn.setAtt("k_fecha", "modify", "Y" );
			}
		}

		fun CmbFormaPago(){
			tipo_id = frn.get("k_tipon",-1,4);
			if (tipo_id == 1 && tip_ope &="A"){
				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3fp where c1 not in ('"& "99')";
				frn.setAtt("k_f_pago","available", "Y");
			}else{
				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3fp";
				frn.setAtt("k_f_pago","available", "Y");
			}
			IniCombos("k_f_pago",cmdQuery);
		}
			
		fun IniCombos(ctrl_combo, query){
			cmdQuery = query;
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venaltanticipo.IniCombos()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			frn.set(ctrl_combo,cuboQuery);
		}

		fun descr_combo(combo,posicion,valor){
			var descr, valor_actual;
			var len_combo = frn.N(combo);
			for (var cont=0; cont<len_combo ; cont++){
				valor_actual= frn.get(combo,cont,posicion);
				if (valor_actual &=  valor){
					descr = frn.get(combo,cont,0);
					return descr;
				}
			}
		}

		// Armado del Docto Referencia
		fun ArmarRefDocto {
			var cadena,tmpFolio, tmpGrupo, tmpTipo;
			tmpFolio = frn.get("k_folio");
			tmpFolio = PadLeft(tmpFolio,"7","0");
			tmpGrupo = PadLeft(gpo_doc,"2","0");
			tmpTipo = PadLeft(tip_doc,"3","0");
			cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;
			frn.set("k_docto", cadena);
		}
			
		fun PadLeft(pText,pRelleno,pCaracterRelleno) {
			var Resultado;
			var pos_ini = pText;
			var nReg = strlen(pText);
			for (var cont = nReg; cont < pRelleno; cont++) {
				Resultado = pCaracterRelleno & Resultado;
			}
			Resultado = Resultado & pText;                
			return Resultado;
		}


