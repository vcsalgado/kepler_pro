		}

		fun CambiaSucursal() {
			LimpiaEncabezado();
			frn.set("k_fecha",sys.date());
			frn.set("k_hora",sys.time());	
			ArmarRefDocto();				
		}
			
		fun CambiaTipo() {
			tipo_id = frn.get("k_tipon",-1,4);
			tip_doc = tipo_id;
			CmbFormaPago();
			LimpiaEncabezado();
			frn.set("k_fecha",sys.date());
			frn.set("k_hora",sys.time());	
			
			ArmarRefDocto();
		}

		fun ObtenerCliente() {
			frn.set("k_clave", "");			
			LimpiaDatosCte();
			cmdQuery = "select c2 as clave, C3 as nombre " &
						"from keplersc.kdud order by c2";

			frn.dialog("genlistasel","Clientes",cmdQuery,"clave","k_clave",0,"","S");			
		}

		fun BuscarCliente(){		
			var xmlProd;				
				
			sucursal_id = frn.get("k_sucn",-1,1);
			cliente_id = frn.get("k_clave");
			LimpiaDatosCte();
			LimpiaDatosDoc();							
			if (strlen(frn.get("k_clave")) == 0) {
				return;
			}
					
			cmdQuery = "select cte.c10 as k_rfc,cte.c3 as k_nombreprov,cte.c4 as k_calleprov,cte.c5 as k_coloniaprov,cte.c6 as k_poblacionprov,cte.c27 as k_cpprov, " &				
					"cte.c11 as k_correo, case when cte.c16 is null then '0' when cte.c16='" & "' then '0' else cte.c16 end k_plazo,cte.c30 as k_nombreimprfact," &
					"'['||uso.c1||'] '||uso.c2 as k_cfdi " &
					"from keplersc.kdud cte "&
					"left join keplersc.kdf3uso uso on uso.c1=cte.c53 " &
					"where cte.c1='" & sucursal_id  & "' and cte.c2='" & cliente_id & "'" ;
					
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venaltanticipo.BuscaCliente()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;	
			}
			if(nXml(cuboQuery) == 0){
				frn.setPos("k_clave");
				frn.message("El cliente no existe","Error","Aceptar");
				return;	
			}
				
			rstXml(xmlProd);
			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");
			frn.setX(xmlProd);
			DefineMetodoCfd();
			frn.set("k_refer","PENDIENTE");				
		}
			
		fun DefineMetodoCfd(){
			var m80,m14,m86; 
				
			m80 = frn.get("k_tipon",-1,10);				
			m14 = frn.get("k_tipon",-1,8);								
			m86 = frn.get("k_tipon",-1,11);				
			if (m80 &= "S" && gen_doc &= "U"){
				if (m14 &="S"){
					frn.set("k_m_pago","PUE");	
					if (m86 &="P" || m86 &="S"){
						frn.set("k_m_pago","PPD");
					}
				}else {
					descr_combo("k_f_pago",1,"99");
					frn.set("k_f_pago",descr_combo("k_f_pago",1,"99"));
					//frn.setAtt("k_f_pago","available", "S"); 
					frn.set("k_m_pago","PPD");	
				}
			}else{
				frn.set("k_m_pago","PUE");
			}
		}

		fun ValidaFolioCancelado(folio){
		var statusfolio;	
		cmdQuery = "select c43 as status_folio " & 
						"from keplersc.kdm1 " &
						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc & " and c6= '" & folio & "'";
			
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidaFolioCancelado()");
			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ValidaFolioCancelado");
			ok = getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok) {
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;	
			}
			statusfolio = getXmlAtt(cuboQuery,"r0","status_folio");
			if (statusfolio &= "C"){	// C=Cerrado
				resVal=0;
				frn.message("El TOTs se encuentra cancelado","Error","Aceptar");
				return;
			}

		}
			
		fun MostrarDatos(nFolio) {
			var folio, refer, xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle;
			var tmpStr, tmpXml, contDet, xmlCurDet, xmlDetConv;

			// Guarda Datos para Busqueda 
			sucursal_id = frn.get("k_sucn",-1,1);
			folio = nFolio;
								
			setXml(xmlRequest,"document","sucursal_id",sucursal_id);
			setXml(xmlRequest,"document","genero",gen_doc);
			setXml(xmlRequest,"document","naturaleza",nat_doc);
			setXml(xmlRequest,"document","grupo",gpo_doc);
			setXml(xmlRequest,"document","tipo",tip_doc);
			setXml(xmlRequest,"document","folio",folio);
	
			cmdQuery = "select * from keplersc.ser_alta_anticipo_cons('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";
			frn.lib("libGeneral.kpl","FileSave",xmlRequest, fileSavePath & "\venaltanticipo_xml_K80ToPostgreSql_buscar");
				
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venaltanticipo.MostrarDatos()");
			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\venaltanticipo_xml_PostgreSql_buscar");
				
			ok = getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok) {
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;	
			}
			//Limpiar antes de presentar datos
			LimpiaInf();		
			//Datos de encabezado
			tmpStr=getXmlAtt(cuboQuery,"r0","encabezado");
			rstXml(xmlEncabezado);
			tmpStr=delScpScn(tmpStr);
			setXmlStr(xmlEncabezado,tmpStr);
			tmpXml = getXml(xmlEncabezado,"row");
			frn.lib("libGeneral.kpl","FileSave",tmpXml , fileSavePath & "\venaltanticipo_xml_Converted_Enc_buscar");				
			frn.setX(tmpXml);
			tipo_id = frn.get("k_tipon",-1,4);
			tip_doc = tipo_id;
			if(nXml(tmpXml) == 0){
				frn.message("El folio de la orden : " & folio & ", No se encontró ...","Error","Aceptar");
				return;				
			}					
		} 

		fun CalculaTotales() {
			var subTotal = 0, iva = 0, total = 0, costo = 0;
			porc_iva = frn.get("k_tipon",-1,6);	
			//Calcular totales
			subTotal = frn.get("k_monto")/(1+porc_iva/100);
			iva = frn.get("k_monto")-subTotal;		
							
			frn.set("k_subtotal",subTotal);
			frn.set("k_iva",iva);
			frn.set("k_porciva",porc_iva);
					
		}


		fun IniParams(){//Inicializa parÃ¡metros de impresiÃ³n, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar PÃ¡gina
				frn.set("param_paper","letter");//	"paper=letter|legal|size"
				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"
				frn.set("param_borderL","1","param_borderT","1.5","param_borderR","1","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"
				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"
				frn.set("param_landscape","Y");//	"landscape=N|Y"
				frn.set("param_emp","L");//			"@emp=L|R|C"
				frn.set("param_header",1);
			}	
			
		fun setRepPage() {//Establece los parï¿½metros finales de impresiï¿½n.
			var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";
			var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";
			var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");
			var lndsp="landscape=" & frn.get("param_landscape");
			var emp="@emp=" & frn.get("param_emp");
			rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);
		}	

		fun EjecReporte(){//Imprime el reporte del documento especificado 
			if(strlen(trim(frn.get("k_folio")))==0){ 
				frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");
				frn.setPos("k_folio");return;	
			}else{
				Reporte();
				frn.setPos("k_folio");
			}
		}				
		
		fun Reporte(){
				var compania,contProd, contDet, tmpStr,concepto,cantidad_letra;
				var xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle;
					var tmpXml, contDet, xmlCurDet, xmlDetConv, datdoc;
				var fecha,hora,total, importe, folio;
				
				sucursal_id = frn.get("k_sucn",-1,1);
				folio = frn.get("k_folio");
				tip_doc = frn.get("k_tipon",-1,4);
				concepto = frn.get("k_tipon",-1,0);
				porc_iva = frn.get("k_tipon",-1,6);	
				fecha = sys.date();
				hora = sys.time();
				cantidad_letra=strFormat("number",frn.get("k_monto"),0);
				//Armar xml con los parametros
				setXml(xmlRequest,"document","sucursal_id",sucursal_id);
				setXml(xmlRequest,"document","genero",gen_doc);
				setXml(xmlRequest,"document","naturaleza",nat_doc);
				setXml(xmlRequest,"document","grupo",gpo_doc);
				setXml(xmlRequest,"document","tipo",tip_doc);
				setXml(xmlRequest,"document","folio",folio);
		
				cmdQuery = "select * from keplersc.ser_alta_anticipo_cons('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";

				frn.lib("libGeneral.kpl","FileSave",xmlRequest , fileSavePath & "\xmlConsultaReporte");
				cmdQuery="select * from keplersc.ser_alta_anticipo_cons('"& getXmlStr(xmlRequest,"EOF:13_10") &"')";
				rstXml(cuboQuery);    //xml general con todos los datos
				cuboQuery= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venaltanticipo.Reporte()");
				ok=getXmlAtt(cuboQuery,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboQuery,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}	
				
				//Procesa xml encabezado
				frn.lib("libGeneral.kpl","FileSave",cuboQuery , fileSavePath & "\xmlResQueryReporteCompleto ");	
				tmpStr=getXmlAtt(cuboQuery,"r0","encabezado");
				tmpStr=delScpScn(tmpStr);	
				rstXml(xmlEncabezado);
				setXmlStr(xmlEncabezado,tmpStr);
				tmpXml = getXml(xmlEncabezado,"row");
				frn.lib("libGeneral.kpl","FileSave",tmpXml , fileSavePath & "\xmlResQueryReporte");	
											
				//Obtener datos de encabezado
				kdb.kde("KDE");//Configuraci??el servidor
				kdb.exec();
				compania = kdb.get("KDE","1");   // Se obtiene el nombre de la compania
				// Se define el formato a usar y se liga a la variable del reporte "rep"
				kdb.readPage("datFto","venaltanticipofto.kpl");
				kdb.exec();
				rep.source(kdb.get("datFto")); 
				rep.rst();
				setRepPage();//Establece los par?metros finales de impresi?n(rep.page(...);), pues pueden haber cambiado por el usuario 
				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");
				//Da valor a los inputs del reporte(rep.set();), e indica la ejecuci?n de "grupos de renglones de impresi?n" (rep.exe();)
				rep.set("fecha",fecha);
				rep.set("hora",hora);
				rep.set("nombreempresa",compania);
				rep.exe("encabezado");
				rep.set("fecha_anticipo",getXml(tmpXml,"k_fecha"));
				rep.set("folio",folio);
				rep.set("nombre",getXml(tmpXml,"k_nombreprov"));
				rep.set("cliente",getXml(tmpXml,"k_clave"));
				rep.set("calle",getXml(tmpXml,"k_calleprov"));
				rep.set("rfc",getXml(tmpXml,"k_rfc"));
				rep.set("colonia",getXml(tmpXml,"k_coloniaprov"));
				rep.set("poblacion",getXml(tmpXml,"k_poblacionprov")& " "&getXml(tmpXml,"k_cpprov"));
				rep.set("referencia",getXml(tmpXml,"k_refer"));
				rep.set("concepto",concepto);
				rep.set("observaciones",getXml(tmpXml,"k_coment"));
				rep.set("cantidad_letra",cantidad_letra);
				rep.set("subtotal",getXml(tmpXml,"k_subtotal"));
				rep.set("porciva",porc_iva);
				rep.set("iva",getXml(tmpXml,"k_iva"));
				rep.set("total",getXml(tmpXml,"k_monto"));
				
				rep.exe("detalle");
									
				rep.win(); //Muestra la vista previa de la impresi?n. A partir de la vista previa (Preprint) se decide si se imprime o no.
			}

		} // End of class Main
	</script>
</pag>