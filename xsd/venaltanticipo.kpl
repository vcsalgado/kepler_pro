			frn.setAtt("Aceptar", "visible", "N");								
		}
			
		fun ConfiguraControlesOpcion() {

			ConfiguraControlesOff();

			if(tip_ope &= "A"){ //Alta
				frn.setAtt("k_tipon", "available", "Y");
				frn.setAtt("k_fecha", "available", "Y");
				frn.setAtt("k_hora", "available", "Y");
				frn.setAtt("k_clave", "available", "Y");
				frn.setAtt("k_monto", "available", "Y");			
				frn.setAtt("k_refer", "available", "Y");
				frn.setAtt("k_claveinv", "available", "Y");			
				frn.setAtt("k_f_pago","modify", "Y");
				frn.setAtt("k_f_pago","available", "Y");
				frn.setAtt("k_cfdi","modify", "Y");
				frn.setAtt("k_cfdi","available", "Y");
				frn.setAtt("k_cuenta","modify", "Y");
				frn.setAtt("k_cuenta","available", "Y");
				frn.setAtt("k_correo","modify", "Y");
				frn.setAtt("k_correo","available", "Y");
				frn.setAtt("k_coment","modify", "Y");
				frn.setAtt("k_coment","available", "Y");
				frn.setAtt("Imprimir", "visible", "N");
				frn.setAtt("Cancelar", "visible", "N");
				frn.setAtt("Aceptar", "visible", "Y");		
			} else {
				if(tip_ope &= "C"){ //Consulta
					frn.setAtt("textFolio", "visible", "Y");
					frn.setAtt("k_folio", "available", "Y");
					frn.setAtt("k_folio", "visible", "Y");
					frn.setAtt("BuscarFol", "visible", "Y");	
					frn.setAtt("k_tipon", "available", "Y");					
					frn.setAtt("k_fecha", "available", "N");
					frn.setAtt("k_hora", "available", "N");
					frn.setAtt("k_refer", "available", "N");
					frn.setAtt("k_claveinv", "available", "N");	
					frn.setAtt("k_f_pago","available", "N");
					frn.setAtt("k_cfdi","available", "N");
					frn.setAtt("k_correo","available", "N");
					frn.setAtt("k_cuenta","available", "N");						
					frn.setAtt("k_coment","available", "Y");
					frn.setAtt("k_coment","modify", "N");
					frn.setAtt("Imprimir", "visible", "Y");
					frn.setAtt("Cancelar", "visible", "N");
					frn.setAtt("Aceptar", "visible", "N");
				} else {
					frn.setAtt("textFolio", "visible", "Y");
					frn.setAtt("k_folio", "available", "Y");
					frn.setAtt("k_folio", "visible", "Y");
					frn.setAtt("k_fecha", "available", "Y");
					frn.setAtt("k_hora", "available", "Y");
				}
			}
		}
			
		fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 
			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    
			1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 
			2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 
			3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 
			*/
			var prefix=frn.lib("libKepler","langPrefix");
			var page=prefix&pag;
			var b_valido=1;
			// var tip_ope; 
			var tip_oper;
			if(iModo==0)
				page=pag; 
			else if(iModo==2&&(strlen(par0)>0)){
				//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       
				if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;
				if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 
				if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;
			}
			else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;
				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     
		}	
			
		
