			frn.setAtt("BuscarFol", "visible", "N");
			frn.setAtt("k_tipon", "available", "N");	
			frn.setAtt("k_fecha", "available", "N");
			frn.setAtt("k_hora", "available", "N");
			frn.setAtt("k_clave", "available", "N");
			frn.setAtt("k_monto", "available", "N");
			frn.setAtt("k_refer", "available", "N");
			frn.setAtt("k_claveinv", "available", "N");					
			frn.setAtt("k_f_pago","available", "N");
			frn.setAtt("k_cuenta","available", "N");
			frn.setAtt("k_correo","available", "N");
			frn.setAtt("k_coment","available", "N");			

			frn.setAtt("Imprimir", "visible", "N");
