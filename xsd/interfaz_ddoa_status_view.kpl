<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="P&#243;lizas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,10" bclr="192,205,213" unfont="0">	<tab/><txt fnt=",22" clr="0,0,0">Estado de Interfaces DDOA</txt>	<br/><br/><tab/>	<hLine clr="0,0,0"/>	<br/><br/>	<tab/>		<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="110,55,10,9" brdr="0,5" tit="Interfaz Sofia" fnt="Arial,16"><tab/>			<txt>Sucursal: </txt>			<cmb id="k_suc" clr="64,64,64" clrBrdr="192,205,213"  				dim="32,1" bclr="255,255,255" brdr="0,0" fnt="Arial,16" available="Y" Null="N"/>			<sp/>			<br/>			<grp id="gpo_3" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,0,0" dim="52,6,10,9" brdr="0,0" fnt="Arial,16"><tab/><txt>Fecha inicial:</txt>				<edt id="k_fecha_ini" dim="10,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213"					type="date" modify="Y" available="Y" fnt="Arial,16" OnF9="Dialog(3,_ks_fecha,k_fecha_ini)" page="_ks_fecha,k_fecha_ini" fmt="DD/MM/CCYY" nc="-1"/>				<tab/><txt>Fecha final:</txt>				<edt id="k_fecha_fin" dim="10,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213"					type="date" modify="Y" available="Y" fnt="Arial,16" OnF9="Dialog(3,_ks_fecha,k_fecha_fin)" page="_ks_fecha,k_fecha_fin" fmt="DD/MM/CCYY" nc="-1"/><br/><tab/><txt>Interfaz DDOA: </txt>				<cmb id="k_movto" dim="20,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N"/>				<sp/><txt>Estatus: </txt>				<cmb id="k_estatus" dim="10,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N"/>            <br/>			</grp>			<grp id="gpo_4" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,0,0" dim="20,6,10,9" brdr="0,0" fnt="Arial,16">				<br/>				<img id="Aceptar" dim="20,20" bPx="Y" brdr="0,1"   default="0" img="_20_Find.png" OnEnter="Buscar_Registros(0)" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			</grp>			<br/><sp/>				<hLine clr="0,0,0"/>			<br/><br/><sp/>						<tbl id="results" clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" brdr="1,0" dim="108,20" modify="N" nren="fijo" Reorder="Y">				<col id="interfaz" name="Interfaz"/>				<col id="registro" name="Registro" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="estatus" name="Estatus" type="string"/>				<col id="envio" name="Envio" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="resultado" name="Resultado" type="string"/>				<col id="descripcion" name="Descripcion" type="string"/>				<col id="sucursal" name="Sucursal" type="string"/>				<col id="gen" name="Gen." type="string"/>				<col id="nat" name="Nat." type="string"/>				<col id="gpo" name="Gpo." type="string"/>				<col id="tipo" name="Tipo" type="string"/>				<col id="folio" name="Folio" type="string"/>				<col id="referencia" name="Referencia" type="string"/>			</tbl>			<br/>			<grp id="gpo_3" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="80,3,10,25" brdr="0,5" fnt="Arial,16" visible="S">				<tab n="1"/>				<bot id="k_btn_selec" dim="10,10" brdr="5" text="Seleccionar" default="0" step="0"  OnEnter="abrir_crud()" fnt="Arial,16" visible="N"/> 				<tab/>				<inp id="reg_mostrados" dim="20,1" clr="0,0,0"  type="string" modify="N" available="N" fnt="Arial,16"/><tab/>				<bot id="banterior"  dim="6,10" brdr="5" text="&lt;&lt;" fnt="Arial,16" OnEnter="Buscar_Registros(-100)" visible="N" tooltip="Anterior p&#225;gina de resultados" available="N" modify="N"/>				<tab/>				<bot id="bsiguiente"  dim="6,0" brdr="5" text="&gt;&gt;" fnt="Arial,16" OnEnter="Buscar_Registros(100)" visible="N" tooltip="Siguiente p&#225;gina de resultados" available="N" modify="N"/>			</grp>			<sp/>		</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;			var cmd,strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna; 			var  mostrarRegistros, offset;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								Inicializa();			}			fun Buscar_Registros(pag){				var mensajeError,ok,nReg, cuboXml n_reg_tabla,xmlPantalla;				if (pag==0){					offset=0;				}				offset = offset+pag;									cmd="select nace.api_id as interfaz, nace.fecha_registro as registro , nace.estatus as estatus, nace.fecha_envio as envio, nace.resultado as resultado, 					nace.descripcion_resultado as descripcion,nace.sucursal, nace.genero as gen, nace.naturaleza as nat, nace.grupo as gpo, nace.tipo as tipo, 					nace.folio as folio, m1.c11 as referencia					from keplersc.notif_api_control_envios nace 					left outer join keplersc.kdm1 m1 on m1.c1=nace.sucursal and m1.c2=nace.genero and m1.c3=nace.naturaleza and m1.c4=grupo and m1.c5=nace.tipo and m1.c6=nace.folio					where 1=1 and nace.api_id like 'DDOA%' ";				cmd=cmd & "and nace.fecha_registro >='" & frn.get("k_fecha_ini") & " 00:00:00' "; 				cmd=cmd & "and nace.fecha_registro <= '" & frn.get("k_fecha_fin") & " 23:59:59' ";				if(frn.get("k_movto",-1,0) &! "Todos"){					cmd=cmd & "and nace.api_id = '" & frn.get("k_movto",-1,0) & "' ";				}								if(frn.get("k_estatus",-1,0) &! "Todos"){					cmd=cmd & "and nace.estatus = '" & frn.get("k_estatus",-1,1) & "' ";				}				/*								setXml(xmlPantalla,"document","sucursal_id",frn.get("k_suc",-1,1));				setXml(xmlPantalla,"document","fecha_inicial",frn.get("k_fecha_ini"));				setXml(xmlPantalla,"document","fecha_final",frn.get("k_fecha_fin"));				setXml(xmlPantalla,"document","movto_sofia",frn.get("k_movto",-1,0));								setXml(xmlPantalla,"document","sofia_estatus",frn.get("k_estatus",-1,1));				cmd="SELECT * FROM keplersc.rep_estatus_sofia('" & getXmlStr(xmlPantalla,"EOF:13_10") & "')";*/								frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdDDOA");																	var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"interfaz_sofia.Buscar_Registros()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",cubo, "C:\Basura\cuboDDOA");				frn.setX(cubo,"results");	/*								var tmpStr=getXmlAtt(cubo,"r0","rep_estatus_sofia");				var consultaXml;				rstXml(consultaXml);				tmpStr=delScpScn(tmpStr);				setXmlStr(consultaXml,tmpStr);								frn.lib("libGeneral.kpl","FileSave",consultaXml, "C:\Basura\xmlDDOA");				frn.setX(consultaXml,"results");*/			}			fun valida_offset(n_reg_tabla){				var txt = "Mostrando registros del " & (offset+1) & " al " & offset + 100 & " de " & n_reg_tabla;				if (offset <= 0) {											frn.setAtt("banterior", "available", "N" );					frn.setAtt("banterior", "modify", "N" );					frn.setAtt("banterior", "visible", "N" );				}else{					frn.setAtt("banterior", "available", "Y" );					frn.setAtt("banterior", "modify", "Y" );					frn.setAtt("banterior", "visible", "Y" );				}								if (offset+100 >= n_reg_tabla){										frn.setAtt("bsiguiente", "available", "N" );					frn.setAtt("bsiguiente", "modify", "N" );					frn.setAtt("bsiguiente", "visible", "N" );					txt = "Mostrando registros del " & (offset+1) & " al " & n_reg_tabla & " de " & n_reg_tabla;								}else{					frn.setAtt("bsiguiente", "available", "Y" );					frn.setAtt("bsiguiente", "modify", "Y" );					frn.setAtt("bsiguiente", "visible", "Y" );				}				if (mostrarRegistros &= "S"){					frn.set("reg_mostrados", txt);				}			}									fun Inicializa(){				mostrarRegistros = "N";				Inicia_Forma();				mostrarRegistros = "S";			}				fun Inicia_Forma(){				var ok,mensajeError, cubo, cmdQueryanio, cmdQuerymes;				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";								if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}										cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"conpolizasView.Inicia_Forma()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				frn.set("k_suc",getXml(cubo));				//Lenar combo tipo movto				frn.setX("Todos","k_movto",0,0);				frn.setX("DDOA_ROR","k_movto",1,0);								frn.setX("DDOA_RDR","k_movto",2,0);				frn.setX("DDOA_SSC","k_movto",3,0);				frn.setX("DDOA_PO","k_movto",4,0);								//Lenar combo estatus				frn.setX("Todos","k_estatus",0,0);				frn.setX("Todos","k_estatus",0,1);								frn.setX("Pendientes","k_estatus",1,0);				frn.setX("P","k_estatus",1,1);								frn.setX("Enviados","k_estatus",2,0);				frn.setX("E","k_estatus",2,1);				frn.setX("Error","k_estatus",5,0);				frn.setX("R","k_estatus",5,1);				frn.set("k_fecha_ini",fnDate("add",sys.date(),-10));				frn.set("k_fecha_fin",sys.date());				}						fun abrir_crud(){/*							var opcion, grupo, tipo, folio, serie;				opcion= frn.get("results",-1,"movto_sofia");				grupo = frn.get("results",-1,"grupo");				tipo = frn.get("results",-1,"tipo");				folio = frn.get("results",-1,"folio");				serie = frn.get("results",-1,"serie");				if (strFormat("ucase",frn.get("results",-1,"k80_sofia")) &! "ENVIADO"){					if (opcion &= "Invoice Notification"){				//Factura UD06						frn.dialog("ifz_sofiainvoicenotification", "INVOICENOTIFICATION", "ALTA", folio, tipo);					} else if(opcion &= "Invoice Cancelled"){			//Anulacion UA70 o Nota de credito UA60						frn.dialog("ifz_sofiainvoicecancelled","INVOICECANCELLED", "ALTA", folio, grupo, tipo);					} else if (opcion &= "Delivery Notification"){	//Alta de vale NA13						frn.dialog("ifz_sofiadeliverynotification","DELIVERYNOTIFICATION", "ALTA", folio);					} else if (opcion &= "Return Delivery"){			//Baja de vale NA13						frn.dialog("ifz_sofiareturndelivery","RETURNDELIVERY", "ALTA", folio);					} else if (opcion &= "Demo In Servicio"){						frn.dialog("ifz_sofiademo","DEMO", "ALTA", serie, "PDSIN");					} else if (opcion &= "Demo In Ventas"){						frn.dialog("ifz_sofiademo","DEMO", "ALTA", serie, "PDVIN");					} else if (opcion &= "Demo Out"){						frn.dialog("ifz_sofiademo","DEMO", "ALTA", serie, "PDOUT");					}				} else{						frn.message("Este registro ya fue enviado a SOFIA","Error","Aceptar");				} */							}							//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------GAD fl4r30n									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>