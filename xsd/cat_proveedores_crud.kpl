		<tab/>
		<grp dim="50,33,7,12" clrBrdr="0,58,112" brdr="0,5" tit="General" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4">
			<tab/><txt>Sucursal donde est&#225; dado de alta</txt><tab/>
