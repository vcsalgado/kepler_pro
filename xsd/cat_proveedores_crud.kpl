			<inp id="C3" dim="30,1" type="string" nc="60" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(3,C3)"/><br/><tab/><txt>Calle y el n&#250;mero de la direcci&#243;n</txt><tab/>
			<inp id="C4" dim="30,1" type="string" nc="40" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(4,C4)"/><br/><tab/><txt>Colonia donde est&#225; el proveedor</txt><tab/>
			<inp id="C5" dim="30,1" type="string" nc="40" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(5,C5)"/><br/><tab/><txt>Poblaci&#243;n donde se ubica</txt><tab/>
			<inp id="C6" dim="30,1" type="string" nc="40" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(6,C6)"/><br/><tab/><txt>N&#250;mero de su tel&#233;fono</txt><tab/>
			<inp id="C7" dim="16,1" type="string" nc="14" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(7,C7)"/><br/><tab/><txt>Segundo n&#250;mero telef&#243;nico</txt><tab/>
			<inp id="C8" dim="16,1" type="string" nc="14" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(8,C8)"/><br/><tab/><txt>N&#250;mero del FAX</txt><tab/>
			<inp id="C9" dim="16,1" type="string" nc="14" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(9,C9)"/><br/><tab/><txt>RFC</txt><tab/>
			<inp id="C10" dim="20,1" type="string" nc="18" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(10,C10)"/><br/><tab/><txt>Direcci&#243;n de Internet</txt><tab/>
			<inp id="C11" dim="30,1" type="string" nc="60" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(11,C11)"/><br/><tab/><txt>Clave del agente de comp. que lo atiende</txt><tab/>
			<inp id="C12" dim="7,1" type="capital" nc="5" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(12,C12)"/><br/><tab/><txt>Clave del grupo al que pertenece</txt><tab/>
			<inp id="C13" dim="7,1" type="capital" nc="5" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(13,C13)"/><br/><tab/><txt>Clave de la zona donde se ubica</txt><tab/>
			<inp id="C14" dim="7,1" type="capital" nc="5" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(14,C14)"/><br/><tab/><txt>L&#237;mite de cr&#233;dito asignado</txt><tab/>
			<inp id="C15" dim="17,1" type="number" nc="15" nd="2" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(15,C15)"/>
		</grp>
		<tab/>
		<grp dim="50,27,7,12" clrBrdr="0,58,112" brdr="0,5" tit="Detalle" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4">
			<tab/><txt>Plazo de cr&#233;dito que se le d&#225;</txt><tab/>
			<inp id="C16" dim="6,1" type="number" nc="4" nd="0" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(16,C16)"/><br/><tab/><txt>Descuento que ordinariamente se le d&#225; ( )</txt><tab/>
			<inp id="C17" dim="6,1" type="capital" nc="4" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(17,C17)"/><br/><tab/><txt>Segundo descuento porcentual</txt><tab/>
			<inp id="C18" dim="6,1" type="capital" nc="4" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(18,C18)"/><br/><tab/><txt>Tercer descuento porcentual</txt><tab/>
			<inp id="C19" dim="6,1" type="capital" nc="4" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(19,C19)"/><br/><tab/><txt>D&#237;a de revisi&#243;n</txt><tab/>
			<inp id="C20" dim="4,1" type="capital" nc="2" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(20,C20)"/><br/><tab/><txt>Hora de revisi&#243;n</txt><tab/>
			<inp id="C21" dim="13,1" type="capital" nc="11" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(21,C21)"/><br/><tab/><txt>D&#237;a de pago</txt><tab/>
			<inp id="C22" dim="4,1" type="capital" nc="2" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(22,C22)"/><br/><tab/><txt>Hora de pago</txt><tab/>
			<inp id="C23" dim="13,1" type="capital" nc="11" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(23,C23)"/><br/><tab/><txt>Lugar de entrega de mercanc&#237;a</txt><tab/>
			<inp id="C24" dim="30,1" type="string" nc="40" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(24,C24)"/><br/><tab/><txt>Lugar de entrega de mercanc&#237;a</txt><tab/>
			<inp id="C25" dim="30,1" type="string" nc="40" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(25,C25)"/><br/><tab/><txt>Lugar de entrega de mercanc&#237;a</txt><tab/>
			<inp id="C26" dim="30,1" type="string" nc="40" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(26,C26)"/><br/><tab/><txt>C&#243;digo postal</txt><tab/>
			<inp id="C27" dim="12,1" type="capital" nc="10" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Cambio(27,C27)"/><br/>
		</grp><tab/>
		<br/>
	</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,frP,kdb,sys;
			/* PARÁMETROS (Tienen sentido cuando la opción se ha ejecutado como diálogo)
			param(0) = Nombre del input (o grid) al que se devolverá la clave en la pantalla padre
			param(1) = (Opcional) Nombre de la columna al que se devolverá la clave en la pantalla padre(Especificar el grid en el parámetro anterior)
			param(2) = (Opcional) Bandera de control. Es un string que indica ciertos parámetros de funcionamiento de la opción
							Se toman de izquierda a derecha y significan:
							Bit 1= Indica la columna del input de la que se tomará el último campo llave. Si es 0, de la columna visible. Si es 1, de la primer columna oculta. Default=0.
							Bit 2= Si es 1, permite modificar el catálogo. Si es 0, no permite modificación. Default=1.
							Bit 3= Si es 1, permite insertar/borrar registros. Si es 0, no permite insertar/borrar. Default=1.
							Bit 4= Si es 1, permite cambiar de registro. Si es 0, no permite cambiar de registro. Si es 2, permite cambiar sólo el último campo llave. Default=1.
							Bit 5= (para guardar la info en un combo) Si es 1, regresa cubo de memoria con la clave en columna visible. Si es 2, regresa cubo con descripción en columna visible. Si es 3, regresa cubo con combinacion "clave - desc" en columna visible.  Si es 0, no regresa cubo. Default=0.
			param(3) = (Opcional) Función de la pantalla padre a ejecutar antes de regresarle el control.
			Valor de retorno = registro seleccionado a la página padre.
			*/
			var bit1,bit2,bit3,bit4,bit5;//Banderas de comportamiento (Ver descripción arriba)
			var tabla_base;//Tabla base del catalogo (Se abre con el alias "a")
			var camposDeseados;//Campos de la tabla que se requieren(Ej: a1...a4)

			fun Main() {
				frn=new FRNT;
				frP=new FRNTP;
				kdb=new KDB;
				sys=new SYS;
				kdb.connect();
				//Parámetros de funcionamiento
				bit1=0;bit2=1;bit3=1;bit4=1;bit5=0;//Inicializa las banderas con los valores default.
				var bCtrl=trim(frn.param(2));
				if (strlen(bCtrl)>0){ //Se especificó una bandera de control.
					bit1=mid(bCtrl,0,1);bit2=mid(bCtrl,1,1);bit3=mid(bCtrl,2,1);bit4=mid(bCtrl,3,1);bit5=mid(bCtrl,4,1);
				}var bGrid=(strlen(trim(frn.param(1)))>0);if(bGrid)bit5=0;//Si se especifica una columna, no se devolverán todos los registros, solo el actual
				//Inicialización
				tabla_base="KDXD";
				camposDeseados="a1...a27";
				kdb.open("a," & tabla_base & ",w,kdlogmov");
				//Se llenan los campos llave si es ventana de diálogo
				if(frn.nParam()>0){
					frn.set("C2",frP.get(frn.param(0),-1,(bGrid?frn.param(1):bit1)));
				}
				Bus(1);
				deshabilita_campos();
			}

			fun camposLlave(){ //Regresa un String con los campos llaves del registro.(Separados por comas, y delimitados por comilla simple '')
				var llave="'" & frn.get("C2") & "'";
				return llave;//Campos que forman la llave. Puede ser una llave combinada
			}

			fun setData(){ //Función que llena los campos en pantalla con la información de la base de datos
				set("C1","a1"); set("C2","a2"); set("C3","a3"); set("C4","a4"); set("C5","a5"); 
				set("C6","a6"); set("C7","a7"); set("C8","a8"); set("C9","a9"); set("C10","a10"); 
				set("C11","a11"); set("C12","a12"); set("C13","a13"); set("C14","a14"); set("C15","a15"); 
				set("C16","a16"); set("C17","a17"); set("C18","a18"); set("C19","a19"); set("C20","a20"); 
				set("C21","a21"); set("C22","a22"); set("C23","a23"); set("C24","a24"); set("C25","a25"); 
				set("C26","a26"); set("C27","a27"); 
			}

			fun valoresDefault(){ //Indica los valores que por default tendrán ciertos campos al generar un nuevo registro.
				var valores="";//Número_de_campo1,valor_default1[,Número_de_campoN,valor_defaultN,...]
				return valores;
			}

			fun verifica_borrar(){ //Funcion que valida que el registro pueda ser borrado. Regresa 1 si se puede borrar. 0 si no.
				//Error("Existen movimientos con este registro, NO es posible borrarlo");return 0;
				return (frn.message("Está a punto de borrar el registro \"" & frn.get("C3") & "\". ¿Desea Continuar?","Precaución","&Si","&No")==1)?1:0;
			}

			fun deshabilita_campos(){ //Habilita/Deshabilita campos dependiendo de los bits de control 2(campos no llave) y 4(campos llave)
				if(bit2==0){//Deshabilita todos los campos que no sean parte de la llave. Pone invisibles los botones
					var elm=frn.dataPag();var nElem=getXmlX(elm,2);var nom="";
					for(var i=0;i<nElem;i++){nom=getXmlX(elm,5,i);if(strlen(nom)>0)setmfy(nom);}//Desactiva TODOS los objetos en pantalla
				}
				var val=1; if(bit4==0)val=0;//Desactiva los campos llave para que no pueda cambiarse de registro
				setmfy("C2",val); //Habilita/Deshabilita los campos que son parte de la llave
			}

			fun validaBus(){ //Valida que se pueda cambiar de registro. Regresa 1 si puede cambiarse. 0 si no puede
				if(bit4==0) return 0;
				return 1;
			}

			fun Exit(){ //Tiene sentido cuando la opción se ha ejecutado como diálogo. Actualiza los campos de la ventana padre
				if(frn.nParam()>0){//Sólo si se han pasado parámetros
					if (strlen(trim(frn.param(0)))>0){ //Solo si se especificó un campo a devolver los datos
						if(bit5>0){//Se regresará un cubo de memoria con todos los registros (para llenar un combo o una lista)
							var cmd="dat1,a,1,&,a2,a2,a3";//Se ordena por clave, y el campo visible es la clave
							if(bit5==2)cmd="dat1,a,2,&,a3,a2";//Se ordena por descripción, y el campo visible es la descripción
							kdb.table(cmd);kdb.exec();var cubo=kdb.get("dat1");
							if(bit5==3)//Combina "clave - descripción" el campo visible
								for(var i=0,n=nXml(cubo);i<n;i++){
									var clavecombinada=getXmlAtt(cubo,"r" & i,"a2") & " - " & getXmlAtt(cubo,"r" & i,"a3");
									setXmlAtt(cubo,"r" & i,"a2",clavecombinada);
								}
							frP.set(frn.param(0),cubo);//Se llena el combo
						}
						//Posiciona el registro correcto
						var bGrid=(strlen(trim(frn.param(1)))>0);
						if(bGrid) frP.setX(frn.get("C2"),frn.param(0),-1,frn.param(1)); else if(bit1>0) frP.setPos(frn.param(0),-1,1,"internal:Y","val:" & camposLlave()); else frP.set(frn.param(0),frn.get("C2"));
						frP.scriptElm(frn.param(0),"OnChange",frn.param(1));
					}
					if (strlen(trim(frn.param(3)))>0) frP.script(frn.param(3)); //Se ejecutará la función indicada en la ventana padre.
				}
				frn.exit();
			}

			/*	Funciones Auxiliares para Catálogos(Genéricas).
				Necesitan las variable globales tabla_base y camposDeseados.
				tabla_base especifica el nombre de la tabla del catálogo que se está editando
				camposDeseados indica los campos que se modificaran de la tabla. Ej a1...a70
				Ademas de una funcion "camposLlave()" que devuleva los campos que forman la clave
				Una funcion "setData()" que establece en pantalla los valores de la base de datos. (Cubo de información: "datos")
				Una función "valoresDefault()" que indica los valores que por default tendrán ciertos campos al generar un nuevo registro.
				Una función "validaBus()" que regresa 1 si se puede cambiar de registro, 0 si no. */
			fun set(objeto,campo){ frn.set(objeto,kdb.get("datos",campo));} //Establece el valor de un campo de la BD al objeto indicado
			fun Error(string){ frn.messageBar(string,1); sys.sound(1);} //Establece un mensaje de error en la barra de estado. Y emite un sonido de alerta.
			fun Busca(){ if(validaBus())Bus(0);}
			fun PgUp(){ if(validaBus())Bus(6);}
			fun PgDn(){ if(validaBus())Bus(5);}
			fun CtrIni(){ if(validaBus())Bus(7);}
			fun CtrEnd(){ if(validaBus())Bus(8);}
			fun Bus(relacional){ //0:=	1:>=	2:<=	3:>	4:<	5:Siguiente		6:Anterior	7:Primero	8:Ultimo
				frn.messageBar("");
				var cmd="datos,a,1," & relacional & "," & camposLlave() & ",&," & camposDeseados;
				kdb.search(cmd); kdb.exec(); setData();
			}
			fun Cambio(numero_campo,objeto,desplazamiento){ //Realiza un cambio de valor en la BD
				if(bit3==0){//No permite insertar nuevos registros
					if(kdb.ok("datos")==0){frn.message("No es posible dar de alta nuevos registros","Permisos restringidos","&Aceptar");return;}
				}
				var cmd="datos,a,1," & camposLlave() & ",&," & numero_campo & ",'" & frn.get(objeto,-1,desplazamiento) & "',&," & valoresDefault() & ",&," & camposDeseados;
				kdb.write("logmov,w,1,'"&strFormat("ucase",frn.config("user","name"))&"','"&sys.date()&"','"&sys.time()&"','"&frn.FileName()&"',&,5,'"&numero_campo&"',6,'"&frn.get(objeto,-1,desplazamiento)&"',7,'"&frn.getPrv(objeto,-1,desplazamiento)&"',8,'"&tabla_base&"',9,'"&camposLlave()&"'");
				kdb.write(cmd);kdb.exec();setData();
			}
			fun CtrDel(){ //Borra el registro actual y devuelve el siguiente
				if(bit3==1){
					if (verifica_borrar()){//Solo borrará el registro si la funcion verifica_borrar devuelve 1. Cada catálogo define su validacion para borrar.
						var cmd="datos,a,1," & camposLlave() & ",&," & camposDeseados;
						kdb.write("logmov,w,1,'"&strFormat("ucase",frn.config("user","name"))&"','"&sys.date()&"','"&sys.time()&"','"&frn.FileName()&"',&,5,BORR,6,'"&camposLlave()&"',8,'"&tabla_base&"'");
						kdb.del(cmd); kdb.exec();
						if(bit4==1)setData();else frn.exit();//Si no se puede posicionar en otro registro, se sale de la opción después de borrar.
					}
				}
			}
			fun Ventana(arch,cmp0,cmp1,cmp2,cmp3,cmp4,cmp5,cmp6,cmp7,cmp8,cmp9){ //Abre pagina indicada como dialogo SOLO si el campo cmp0 se puede modificar(El cmp0 puede ser una tabla, y cmp1 la columna)
				var b_valido=1;
				if(strlen(cmp0)>0){//Se toma el cmp0 como el objeto (o grid) al que se devolverá el resultado.
					if( frn.getAtt(cmp0,"modify",cmp1) &= "N" ) b_valido=0;
					if( frn.getAtt(cmp0,"available",cmp1) &= "N" ) b_valido=0;
					if( frn.getAtt(cmp0,"visible",cmp1) &= "N" ) b_valido=0;
				}
				if(b_valido==1)frn.dialog(arch,cmp0,cmp1,cmp2,cmp3,cmp4,cmp5,cmp6,cmp7,cmp8,cmp9);
			}
			fun setmfy(campo,valor){ //Modifica el atrbuto modify de cierto objeto(0=no permite modificacion. 1=Permite modificacion)
				var atrib=(valor==1)?"Y":"N";
				frn.setAtt(campo,"modify",atrib);
			}
			fun setvbl(campo,valor){ //Modifica el atrbuto visible de cierto objeto(0=no lo muestra. 1=si lo muestra)
				var atrib=(valor==1)?"Y":"N";
				frn.setAtt(campo,"visible",atrib);
			}
			//Funciones de uso común
			fun CombinaCombo(combo,colClave,colDesc,posFinal){//Combina el contenido de 2 columnas de un combo y lo pone en la columna visble. Ej: para mostrar "Clave - Descripción".
				//NOTA: Por default posiciona el combo con el primer elemento. Se puede pasar como parametro "posicionaFinal" un 1 para que se posicione en el ultimo registro
				var clavecombinada="";
				for(var i=0,n=frn.N(combo);i<n;i++){
					clavecombinada=frn.get(combo,i,colClave) & " - " & frn.get(combo,i,colDesc);
					frn.setX(clavecombinada,combo, i, 0);
				}
				if(posFinal==1&&frn.N(combo)>0) frn.setPos(combo,frn.N(combo)-1,0,"internal:Y");//Lo posiciona en el último renglon
				else frn.setPos(combo,0,0,"internal:Y");
			}
		}
	</script>
</pag>