<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Cat&#225;logo de KDXD">
	<grp dim="1,-1,10,20" brdr="2,1" bclr="192,205,213" fnt="Arial,16" clr="0,58,112" unfont="0"
