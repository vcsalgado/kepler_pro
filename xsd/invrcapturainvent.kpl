<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Captura Inventario">	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<grp dim="55,47,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Captura Inventario">			<sp n="4"/>			<txt>Sucursal:</txt><tab/><cmb id="cmb_sucursal" dim="50,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16"  Null="N" modify="Y" available="Y"/><br/>					<br/>				<sp n="4"/><txt clr="0,58,112" fnt="Arial,16">Fecha:</txt><tab n="2"/>			<edt id="k_fecha" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" modify="Y" available="N"/>			<tab n="8"/><txt clr="0,58,112" fnt="Arial,16">NOTA: Importante, si el Inventario F&#237;sico fue 0 tambien hay que ingresarlo</txt><br/> 			<br/>			<!-- <sp/> -->			<!-- OnButton="ObtenerRef()" -->			<!-- inp -->			<edt id="k_refer" dim="14,1" brdr="1,1" clrBrdr="255,255,255" clr="64,64,64" bclr="255,255,255" type="string" OnButton="ObtenerRef()" OnF9="ObtenerRef()" OnChange="MostrarRef()" OnEnter="MostrarRef()" modify="N" available="N" visible="N"/>			<br/>	<br/>				<sp n="4"/><txt>Producto:</txt><tab/>						<!-- tooltip="Seleccionar F9,Nuevo F10,Modificar F11" -->			<inp id="k_parte" clr="64,64,64"  brdr="1,1" clrBrdr="255,255,255" nc="30" OnChange="Producto()" OnF9="Dialog(3,invcatprdbus,k_parte)"  OnF10="Dialog(3,cat_prod_crud,Nuevo,x,s)" OnF11="Dialog(3,cat_prod_crud,Modificar,x,s)"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available="Y" modify="Y"/>			<inp id="k_parte_desc" dim="45,1" brdr="1,1" clrBrdr="255,255,255" clr="64,64,64" bclr="255,255,255"  modify="N" type="capital" available="N"/>						<sp n="2"/>			<inp id="c_parte" dim="35,1" bclr="240,240,240" clr="198,20,38" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",17" just="L"/> 						<br/><br/>			<sp n="4"/><txt>Unidad:</txt><tab n="2"/>			<!-- cmb -->			<inp id="k_unidad" dim="20,1" brdr="2,1" bclr="255,255,255" clr="64,64,64"  modify="N" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" available="N"/>						<inp id="k_dif_exist" dim="0,0" brdr="1,1" clrBrdr="255,255,255" clr="64,64,64" bclr="255,255,255"  visible="N" type="capital"/>			<inp id="k_dif_valor_invr" dim="0,0" brdr="1,1" clrBrdr="255,255,255" clr="64,64,64" bclr="255,255,255"  visible="N" type="capital"/>						<br/><br/>				<tab n="9"/><txt  fnt="Arial,17">Resultado del Conteo:</txt>			<br/>	<br/>			<sp n="4"/><txt>Existencia:</txt><tab n="4"/>			<inp id="k_exist" dim="14,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" available="N" type="number"/>						<!-- OnChange="Valor()" -->			<inp id="k_exist_real" dim="25,1" brdr="1,1" bclr="255,255,255" OnChange="Recalc()" clr="64,64,64" clrBrdr="236,240,243" type="number"/><br/><br/>									<sp n="4"/><txt>Valor del Inventario:</txt><tab n="1"/>			<inp id="k_valor_inv" dim="14,1" brdr="1,1" nd="2" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" available="N" type="number"/>			<inp id="k_valor_inv_real" dim="25,1" brdr="1,1" nd="2" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" available="N" type="number"/><br/><br/>									<sp n="4"/><txt>Costo Promedio:</txt><tab n="2"/>			<inp id="k_costo_prom" dim="14,1" brdr="1,1" nd="2" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" available="N" type="number"/>						<!-- OnChange="Valor()" -->			<inp id="k_costo_prom_real" dim="25,1" brdr="1,1" nd="2" bclr="255,255,255" OnChange="Recalc()" clr="64,64,64" clrBrdr="236,240,243" type="number" available="Y"/>						<br/><br/>						<sp n="5"/>	<txt> NOTA: El Costo promedio que aparece en Costo promedio es el sugerido por el sistema. ADEMAS el costo promedio que se </txt><br/>			<sp n="5"/>	<txt>	 inserta en el resultado del conteo, es el que quedara como costo promedio despues del ajuste por Inventario Fisico.</txt>						<br/> <br/>						<sp n="4"/><txt>Ultimo Costo:</txt><tab n="3"/>			<inp id="k_ult_costo" dim="14,1" brdr="1,1"  nd="2" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" available="N" type="number"/>  						<br/> <br/>						<sp n="4"/><txt>Penultimo Costo:</txt><tab n="2"/>			<inp id="k_penult_costo" dim="14,1" brdr="1,1"  nd="2" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" available="N" type="number"/>  						<br/> <!-- <br/> -->						<!--						<sp n="4"/><txt>Costo de GM:</txt><tab n="3"/>			<inp id="k_costo_gm" dim="14,1" brdr="1,1"  nd="2" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" available="N" type="number"/>			<br/>			--> 						<tab n="26"/>	<img  id="bot_guardar"  dim="60,60" bPx="Y" brdr="0,1"  img="_60_Save.png" OnEnter="Guardar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			<br/>						</grp>			</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys,suc_usuario;			var ultimoCriterio;			var perfil_usuario,usuario ,rol_usuario  ,asterisco;			// JMM Adds ...			var cmdQuery, cuboQuery, fileSavePath, ok, mensajeError;			var sucursal_id, refer_id, prod_id, resVal;						fun Main() {							frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;								kdb.connect();				kdb.open("i,kdini,j,kdinm,k,kdink,l,kdinl,s,kdms,m,kdmm");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";								Inicializa();												// Code Added by JMM 				frn.setAtt("k_parte", "available", "Y");				frn.setAtt("bot_guardar", "available", "Y");				frn.setAtt("bot_guardar", "visible", "Y");				rst_values();				//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";				fileSavePath = "C:\Basura";							}												// New Code Implemented by JMM ...						//Obsoleto			fun ObtenerRef() {							var win_tit, field_key, field_col, cmdQuery;								/*            proveedor_id = frn.get("k_clave");            sucursal_id = frn.get("k_sucn",-1,1);	            */                        win_tit = "Marbetes";				field_key = "folio";				field_col = "k_refer";            cmdQuery = "select c1 as folio, c2 as clave, c3 as descripcion from keplersc.kdmarbe "; /* & */                 // "where c1 = '" & sucursal_id &  "' and c4 = 10";            cmdQuery = cmdQuery & " order by c1 ";                        	         frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");                     }         			//Obsoleto			fun MostrarRef() {							var xmlGrd;																		frn.setAtt("k_parte", "available", "N");																						sucursal_id = frn.get("cmb_sucursal", -1, 1);				refer_id = frn.get("k_refer");												//Reset campos				rst_values();								frn.set("k_refer", refer_id);								if ( strlen(refer_id) == 0 ) { 					frn.setAtt("k_parte", "available", "Y");					frn.setAtt("bot_guardar", "available", "Y");					frn.setAtt("bot_guardar", "visible", "Y");					//frn.message("Debe Registrar el Folio del Marbete ...","Info","Aceptar"); // Se comento porque se habilitara el Producto ...					return; 				}										cmdQuery = "" &					"select m.*, coalesce(l.c2,'') as prod, coalesce(f.c2,'') as prod_fis, coalesce(f.c6,0) as exist, coalesce(f.c7,0) as costo, " &					"( coalesce(f.c6,0) * coalesce(f.c7,0) ) as valor from keplersc.kdmarbe m " &					/*"inner join keplersc.kdini i on i.c1 = h.c3 " &*/					"left join keplersc.kdinl l on l.c2 = m.c2 and l.c1 = '" & sucursal_id & "'" & 					"left join keplersc.kdifis f on f.c2 = m.c2 and f.c1 = '" & sucursal_id & "'" &					"where m.c1 = " & refer_id & " ";									rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"capinvent_mostrardatos()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\capinvent_mostrardatos");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.message("El Folio del Marbete No Existe ...","Info","Aceptar");					frn.set("k_refer", refer_id);					frn.setPos("k_refer");					return;					}									frn.set("k_refer", getXmlAtt(cuboQuery,"r0", "c1"));				frn.set("k_parte", getXmlAtt(cuboQuery,"r0", "c2"));				frn.set("k_parte_desc", getXmlAtt(cuboQuery,"r0", "c3"));				frn.set("k_unidad", getXmlAtt(cuboQuery,"r0", "c7"));								if ( strlen( getXmlAtt(cuboQuery,"r0", "prod") ) == 0 ) {									frn.setAtt("bot_guardar", "available", "N");					frn.setAtt("bot_guardar", "visible", "N");					frn.message("No se Encontro Informacion del Producto contenido en el  Marbete ...","Info","Aceptar");					frn.setPos("k_refer");					return;									} else {									// Llenar Objs con Info de la TBL.kdinl										Valor();										if ( strlen( getXmlAtt(cuboQuery,"r0", "prod_fis") ) != 0 ) {						frn.set("k_exist_real", getXmlAtt(cuboQuery,"r0", "exist"));						frn.set("k_valor_inv_real", getXmlAtt(cuboQuery,"r0", "valor"));						frn.set("k_costo_prom_real", getXmlAtt(cuboQuery,"r0", "costo"));						frn.set("c_parte", "");					} else {						frn.set("k_costo_prom_real", frn.get("k_costo_prom"));						frn.set("c_parte", "Sin Registro en Inventario Fisico");					}					 					frn.setAtt("bot_guardar", "available", "Y");					frn.setAtt("bot_guardar", "visible", "Y");									}														return;						   } // End MostrarRef()									fun Recalc() {							frn.set("k_valor_inv_real", frn.get("k_exist_real") * frn.get("k_costo_prom_real") );						}									//Validacion Datos Generales y Partidas antes de Guardar.			//El resultado de cada validacion se guarda en la variable global resVal.			fun ValidarDatos(iModo) {				var totReg, dato_num, dato_txt;								frn.set("k_refer", trim(frn.get("k_refer")));				frn.set("k_parte", trim(frn.get("k_parte")));								//Obtener variables				sucursal_id = frn.get("k_sucn",-1,1);				refer_id = trim(frn.get("k_refer"));				prod_id = trim(frn.get("k_parte"));								if ( strlen(prod_id) == 0 ) {					frn.message("No esta Registrado el Producto ...","Error","Aceptar"); 					resVal=0;					return;				}								if ( strlen(refer_id) > 0 ) {					// No se usa el Marbate ...										//Validar Referencia					cmdQuery = "select count(*) as totreg from keplersc.kdmarbe " & 						 "where c1 = " & refer_id &  " "; 												rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"captura_invent.ValidarDatos()");					ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error DB","Aceptar"); //TO DO Homologar mensaje en todo el proyecto, agregar DB						resVal=0;						return;					}					totReg = getXmlAtt(cuboQuery,"r0","totreg");					if(totReg==0){						frn.message("El Marbete No Existe ...","Error","Aceptar"); 						resVal=0;						return;					}						else	{															cmdQuery = "select c1 as folio, c2 as producto from keplersc.kdmarbe " & 							"where c1 = " & refer_id &  " "; 												rstXml(cuboQuery);								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"captura_invent.ValidarDatos()");						ok = getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error DB","Aceptar"); //TO DO Homologar mensaje en todo el proyecto, agregar DB							resVal=0;							return;						}						if (nXml(cuboQuery) == 0) {							frn.message("El Marbete No se encontro ...","Error","Aceptar"); 							resVal=0;							return;						} else {							dato_txt = getXmlAtt(cuboQuery,"r0","producto");							if( dato_txt &! prod_id ){								frn.message("El Producto No corresponde con el Registrado en el Marbete ...","Error","Aceptar"); 								resVal=0;								return;							}						}											}								} else {									// No se usa el Marbate ...										if ( strlen(prod_id) == 0 ) {						frn.message("Debe capturar un Producto Valido ...","Error","Aceptar"); 						resVal=0;						return;					}										cmdQuery = "select count(*) as totreg from keplersc.kdinl " & 						 "where c2 = '" & prod_id &  "'"; 												rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"captura_invent.ValidarDatos()");					ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error DB","Aceptar"); //TO DO Homologar mensaje en todo el proyecto, agregar DB						resVal=0;						return;					}					totReg = getXmlAtt(cuboQuery,"r0","totreg");					if(totReg==0){						frn.message("El Producto No Existe en [kdinl] ...","Error","Aceptar"); 						resVal=0;						return;					}										// Validations Added 20231212 										if ( frn.get("k_exist_real") < 0 ) {						frn.message("El se pueden Registrar Cantidades Negativas ...","Error","Aceptar"); 						resVal=0;						return;					}										if ( frn.get("k_valor_inv_real") < 0 ) {						frn.message("El Valor del Inventario Fisico No puede ser Negativo ...","Error","Aceptar"); 						resVal=0;						return;					}										if ( frn.get("k_costo_prom_real") < 0 ) {						frn.message("El Costo Promedio Real [Fisico} No puede ser Negativo ...","Error","Aceptar"); 						resVal=0;						return;					}										if ( frn.get("k_exist_real") > 0 && frn.get("k_valor_inv_real") == 0 ) {						frn.message("El Valor del Inventario Fisico No puede ser igual a cero, si la Captura del Inventario es mayor a cero ...","Error","Aceptar"); 						resVal=0;						return;					}									}								return;							} // End ValidarDatos()									// End New Code Implemented by JMM ...												fun Inicializa(){//Inicializa los valores en Pantalla y variables						suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				asterisco = "*";				frn.set("k_fecha",sys.date());				IniCombos();						}									fun IniCombos(){				var cmd, cubo , ok, mensajeError;												//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("cmb_sucursal",getXml(cubo));														/*				//llenar combo unidad				cmd = "select c1||'-'||c2 as descripcion ,c1 as clave from keplersc.kdinu" ;				cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invcapturainvent.IniCombos()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}									var unidad = "k_unidad";									frn.setX("", unidad,0,0);				frn.setX("", unidad, 0, 1);									llenar_cmb(cuboResultados,unidad);				*/							}										fun rst_values(){							frn.set("k_fecha",sys.date());				frn.rst("k_refer");								// Added by JMM				frn.rst("k_parte");				frn.rst("k_parte_desc");				frn.rst("k_unidad");				frn.rst("k_dif_exist");				frn.rst("k_dif_valor_invr");								frn.setAtt("bot_guardar", "available", "N");				frn.setAtt("bot_guardar", "visible", "N");								frn.rst("c_parte");				// End Added by JMM								frn.rst("k_exist");				frn.rst("k_exist_real");				frn.rst("k_valor_inv");				frn.rst("k_valor_inv_real");				frn.rst("k_costo_prom");				frn.rst("k_costo_prom_real");				frn.rst("k_ult_costo");				frn.rst("k_penult_costo");				//frn.rst("k_costo_gm");					}						fun Producto(){							// Code Added by JMM 20231117 				sucursal_id = frn.get("cmb_sucursal", -1, 1);				refer_id = frn.get("k_refer");					prod_id = frn.get("k_parte");									//Reset campos				rst_values();								if ( strlen(prod_id) == 0 ) {					return;				}								frn.set("k_refer", refer_id);				frn.set("k_parte", prod_id);							// End Code Added by JMM 20231117 										//rst_values(); // Commented 20231117  										var xmlRequest, cmd, cuboResultados, ok, mensajeError, resultado_len, parte/*, sucursal_id*/;								sucursal_id = frn.get("cmb_sucursal", -1, 1);				parte = frn.get("k_parte");								//Commented by JMM 20231118				//cmd = "select ini.c2 as desc, uni.c1||'-'||uni.c2 as unidad from keplersc.kdini as ini left outer join keplersc.kdinu as uni on ini.c19=uni.c1 where ini.c1='" & parte & "'" ;								//UPD by JMM 20231118				cmd = "select ini.c2 as desc, ini.c19 /*uni.c1||'-'||uni.c2*/ as unidad from keplersc.kdini as ini /*left outer join keplersc.kdinu as uni on ini.c19=uni.c1*/ where ini.c1='" & parte & "'" ;								cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invcapturainvent.Producto()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								resultado_len = nXml(cuboResultados);							if (resultado_len /*!=*/ == 0){									// Adapted by JMM 20231117					/*					frn.set("k_parte_desc",getXmlAtt(cuboResultados ,"r"&0,"desc"));					frn.set("k_unidad",getXmlAtt(cuboResultados ,"r"&0,"unidad"));					*/					frn.message("No existe parte","Error","Aceptar");					/*					frn.rst("k_parte");					frn.rst("k_parte_desc");					frn.rst("unidad");					*/					return; // Added by JMM 20231117									}				else {									/*					frn.message("No existe parte","Error","Aceptar");					frn.rst("k_parte");					frn.rst("k_parte_desc");					frn.rst("unidad");					*/					frn.set("k_parte_desc",getXmlAtt(cuboResultados ,"r"&0,"desc"));					frn.set("k_unidad",getXmlAtt(cuboResultados ,"r"&0,"unidad"));										frn.setAtt("bot_guardar", "available", "Y");					frn.setAtt("bot_guardar", "visible", "Y");											}								//Commented by JMM 20231118				//cmd = "select c4 as fecha,c5 as refer,c6 as existencia_real,c7 as costo_promedio_real from keplersc.kdifis where c1='" & sucursal_id & "' and c2= '" & parte & "'";								//UPD by JMM 20231118				cmd = "select c4 as fecha,c5 as refer,c6 as existencia_real,c7 as costo_promedio_real, ( coalesce(c6,0) * coalesce(c7,0) ) as valor from keplersc.kdifis where c1='" & sucursal_id & "' and c2= '" & parte & "'";											cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invcapturainvent.Producto()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								resultado_len = nXml(cuboResultados);								//Put by JMM 20231118				Valor();							if (resultado_len != 0){								//frn.set("k_fecha",getXmlAtt(cuboResultados ,"r"&0,"fecha"));					//frn.set("k_refer", getXmlAtt(cuboResultados ,"r"&0,"refer"));									frn.set("k_exist_real",getXmlAtt(cuboResultados,"r"&0,"existencia_real"));					frn.set("k_costo_prom_real",getXmlAtt(cuboResultados,"r"&0,"costo_promedio_real"));										frn.set("k_valor_inv_real", getXmlAtt(cuboResultados,"r"&0, "valor"));										frn.set("c_parte", "");									}				// Added by JMM 20231118				else {									// Check if is necessary do something 					frn.set("k_costo_prom_real", frn.get("k_costo_prom"));					frn.set("c_parte", "Sin Registro en Inventario Fisico");								}							//Commented by JMM 20231118				//Valor();								}						fun Valor(){							var xmlRequest,cmd,cuboResultados,ok, mensajeError,resultado_len;							setXml(xmlRequest,"document","sucursal_id",frn.get("cmb_sucursal", -1, 1));				setXml(xmlRequest,"document","k_parte", frn.get("k_parte"));				setXml(xmlRequest,"document","existencia_real",	frn.get("k_exist_real"));				setXml(xmlRequest,"document","costo_promedio_real",frn.get("k_costo_prom_real"));				setXml(xmlRequest,"document","movimiento","usuario",frn.lib("libKepler","UserInfo"));				frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.invr_captura_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invcapturainvent.Valor()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								cuboResultados = getXmlAtt(cuboResultados,"r0","invr_captura_sel");				cuboResultados = delScpScn(cuboResultados);								var xml_nivel_1;				setXmlStr(xml_nivel_1,cuboResultados);				frn.lib("libGeneral.kpl","FileSave",xml_nivel_1,"C:\Basura\xmlcubo");							frn.set("k_exist", getXml(xml_nivel_1, "exist"));				frn.set("k_valor_inv",getXml(xml_nivel_1, "valor_inv"));				frn.set("k_costo_prom",getXml(xml_nivel_1, "costo_promedio"));								frn.set("k_ult_costo",getXml(xml_nivel_1, "ultimo_costo"));				frn.set("k_penult_costo",getXml(xml_nivel_1, "penultimo_costo"));				frn.set("k_costo_gm",getXml(xml_nivel_1, "precio_gm"));								frn.set("k_costo_prom_real", getXml(xml_nivel_1, "costo_promedio_real"));				frn.set("k_valor_inv_real",getXml(xml_nivel_1, "valor_inv_real"));								frn.set("k_dif_exist", getXml(xml_nivel_1, "diferencia_existencia"));				frn.set("k_dif_valor_invr", getXml(xml_nivel_1, "diferencia_valor_inventario"));						}						fun Guardar(){							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;				ValidarDatos();				if(ok &! "1" || resVal == 0){					//frn.message("Se encontraron Errores de Validacion ...","Info !!!","Aceptar");					return;				}								// For Testing ...				/*				frn.message("La Informacion se Procesara ...","Info !!!","Aceptar");				return;				*/							var xmlRequest,cmd,cuboResultados,ok, mensajeError,resultado_len;								xmlRequest = getXml(frn.dataPag()); 							frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest_CapInvFis");								cmd="SELECT * FROM keplersc.invr_captura_insert('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"invcapturainvent.Guardar()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\xmlResult_CapInvFis");								var resultado=getXml(cuboResultados ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cuboResultados ,"mensaje");					frn.setPos("k_refer");					frn.message(mensajeError,"Error","Aceptar");					return;						}else{								frn.message("Guardado correctamente","mensaje","Aceptar");										// Code Added by JMM 20231118 										//frn.set("c_parte", "");										if ( strlen( trim(refer_id) ) > 0 ) {						MostrarRef();						frn.setPos("k_refer");					} else {						if ( strlen( trim(prod_id) ) > 0 ) {							Producto();							frn.setPos("k_parte");						}					}										// End Code Added by JMM 20231118 															//frn.setPos("k_refer"); //commented by JMM 20231118					return;									}						}										fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}														fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else 				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}								}	</script></pag>