<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="TMKT"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0">		<tab/>		 <txt clr="0,0,0" fnt="Arial,25" id="textTmkt">Telemarketing</txt><br/>		<tab/>		<hLine dim="92,1,0,0" clr="0,0,0"/>	<br/><br/>	<tab/>		<txt fnt=",18b">Sucursal: </txt>		<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="35,36" bclr="255,255,255" 			brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y" OnChange="borrar()"/>				<br/>	<br/><br/>			<tab/>					<grp  unfont="0"  bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18"  clrBrdr="0,58,112" hSpace="4"  dim="92,55,10,10" brdr="0,5" tit="Lista Objetivo">						<tab/><txt clr="0,58,112">Folio:</txt>		<inp id="folio_contacto" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/> 				<sp/><txt clr="0,58,112">Serie:</txt>		<inp id="serie" dim="12,1" brdr="2,0" clr="64,64,64" OnF9="Seleccionar_serie()" tooltip="F9 series" bclr="255,255,255" clrBrdr="255,255,255"/>   				<sp/>				<tab/><txt clr="0,58,112" hk="S">Asesor</txt>		<cmb id="asesor" clr="64,64,64" clrBrdr="255,255,255" dim="12,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y" modify="Y"/>						<sp/>		<txt>Prog ini:</txt>		<edt id="fecha_prog_ini" dim="8,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_prog_ini" OnF9="Dialog(3,_ks_fecha,fecha_prog_ini)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2"/>		 		 		 		 <sp/>		<txt>Prog fin:</txt>		<edt id="fecha_prog_fin" dim="8,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_prog_fin" OnF9="Dialog(3,_ks_fecha,fecha_prog_fin)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2"/>		 		<br/>				<tab/><txt clr="0,58,112" hk="S">Cliente</txt>		<inp id="cliente" dim="8,1" brdr="2,0" clr="64,64,64" OnF9="Seleccionar_cliente()" tooltip="F9 clientes" bclr="255,255,255" clrBrdr="255,255,255"/>						<sp/>						<txt clr="0,58,112" hk="S">Tipo N</txt>		<cmb id="tipo_n" clr="64,64,64" clrBrdr="255,255,255"  dim="12,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y" modify="Y"/>					<sp/>		<txt clr="0,58,112" hk="S">Medio de Contacto</txt>		<cmb id="medio_contacto" clr="64,64,64" clrBrdr="255,255,255"  dim="12,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y" modify="Y"/>						<sp/>		<txt>Creacion ini:</txt>		<edt id="fecha_creacion_ini" dim="8,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_creacion_ini" OnF9="Dialog(3,_ks_fecha,fecha_creacion_ini)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2"/>		 		<sp/>		<txt>Creacion fin:</txt>		<edt id="fecha_creacion_fin" dim="8,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_creacion_fin" OnF9="Dialog(3,_ks_fecha,fecha_creacion_fin)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2"/>		 				<br/>					<tab/><txt clr="0,58,112" hk="S">Motivo</txt>		<cmb id="motivo" clr="64,64,64" clrBrdr="255,255,255"  dim="16,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y" modify="Y"/>				<sp/>		<txt clr="0,58,112" hk="S">Resultado</txt>		<cmb id="resultado" clr="64,64,64" clrBrdr="255,255,255"  dim="16,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y" modify="Y"/>				<sp/>		<txt clr="0,58,112" hk="S">Accion</txt>		<cmb id="accion" clr="64,64,64" clrBrdr="255,255,255"  dim="16,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y" modify="Y"/>				<sp/>		<txt clr="0,58,112" hk="S">Origen</txt>		<cmb id="origen" clr="64,64,64" clrBrdr="255,255,255"  dim="11,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y" modify="Y"/>				<tab n="1"/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		<br/>			<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" OnEnter="Exit" OnMouseD="Exit" dim="86,27" available="Y" nren="fijo">		<col id="folio" name="Folio TMKT"/>		<col id="serie" name="Serie"/>		<col id="programacion" name="Programacion"/>		<col id="asesor" name="Asesor"/>		<col id="tipo_n" name="Tipo_N"/>		<col id="cliente" name="Cliente"/>		<col id="medio_contacto" name="Medio_Contacto"/>		<col id="motivo" name="Motivo"/>		<col id="resultado" name="Resultado"/>		<col id="accion" name="Accion"/>		<col id="vale_salida_ult_servicio" name="Vale_salida\Ult_serv"/>		<col id="creacion" name="Creacion"/>		<col id="obs1" name="Obs1"/>		<col id="obs2" name="Obs2"/>		<col id="folio_cita" name="Folio Cita"/>				</tbl>  <br/>			</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,rol_usuario ,perfil_usuario,asterisco  ;			fun Main(){				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								Inicializa();										}								fun Inicializa(){							var cmd,cubo,ok,combo, mensajeError ;																//Llena combo de sucursales				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmktview.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_sucN",getXml(cubo));															//Llenar combo asesores				cmd = "select '['||c1||'] '||c2 as descripcion, c1 as clave from keplersc.kdsercattmkt";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_view.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									combo = "asesor";			   frn.setX("", combo ,0,0);				llenar_cmb(cubo ,combo );											//Llenar combo motivo				cmd = "select '['||motivo_id||'] '||descripcion as descripcion, motivo_id as clave from keplersc.kdtmktmotivo order by motivo_id";						cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_view.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									combo = "motivo";			   frn.setX("", combo ,0,0);				llenar_cmb(cubo ,combo );									//Llenar combo resultado				cmd = "select '['||resultado_id||'] '||descripcion as descripcion, resultado_id as clave from keplersc.kdtmktresult order by resultado_id";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_view.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}					combo = "resultado";			   frn.setX("", combo ,0,0);				llenar_cmb(cubo ,combo );																//Llenar combo accion				cmd = "select '['||accion_id||'] '||descripcion as descripcion, accion_id as clave from keplersc.kdtmktaccion order by accion_id";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_view.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}					combo = "accion";			   frn.setX("", combo ,0,0);				llenar_cmb(cubo ,combo );												//Llenar combo tipo_n				cmd = "select '['||c2||'] '||c3 as descripcion, c2 as clave from keplersc.kd_tipo_n where c1='" & frn.get("k_sucN",-1,1) & "'";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_view.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}					combo = "tipo_n";			   frn.setX("", combo ,0,0);				llenar_cmb(cubo ,combo );												//Llenar combo medio_contacto				cmd = "select '['||c1||'] '||c2 as descripcion, c1 as clave from keplersc.kdmediocontacto";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_view.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}					combo = "medio_contacto";			   frn.setX("", combo ,0,0);				llenar_cmb(cubo ,combo );																	//Llenar combo origen				cmd = "select '['||c1||'] '||c2 as descripcion, c1 as clave from keplersc.kdtmktorigen";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_view.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}					combo = "origen";			   frn.setX("", combo ,0,0);				llenar_cmb(cubo ,combo );																cmd = " select c6 from keplersc.kdtmktserconf where c1='" & frn.get("k_sucN",-1,1) & "'";						cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_view.Inicializa()");								ok=getXmlAtt(cubo ,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo ,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var fecha_ultima_rutina = getXmlAtt(cubo ,"r0","c6");								frn.set("fecha_creacion_ini", fecha_ultima_rutina );				frn.set("fecha_creacion_fin", fecha_ultima_rutina );											Buscar();						}						fun borrar(){							frn.rst("tabla");										}								fun Buscar() {							var xmlRequest,cmd,ok,cuboResultados, tot , cont;						cmd= "select tmkt.c2,tmkt.c3,tmkt.c5,mtv.descripcion as motivo, res.descripcion as result,acc.descripcion as accion,tmkt.c14,tmkt.c20,tmkt.c22,medc.c2 as m_contacto ";					cmd= cmd & " ,tmkt.c11,tmkt.c12,tmkt.c24,tmkt.c26, tmkt.c15 from keplersc.kdtmktser2 as tmkt  inner join keplersc.kdtmktmotivo as mtv on tmkt.c7=mtv.motivo_id ";								cmd= cmd & " inner join keplersc.kdtmktresult as res on tmkt.c8=res.resultado_id inner join keplersc.kdtmktaccion as acc on tmkt.c9 = acc.accion_id";							cmd= cmd & " inner join keplersc.kdmediocontacto as medc on tmkt.c23=medc.c1 where tmkt.c1='" & frn.get("k_sucN",-1,1) & "'";								var fol =  frn.get("folio_contacto");				if (fol &! ""){					cmd = cmd & " and tmkt.c2 ='" & fol & "'";				}								var serie = frn.get("serie");				if (serie &! ""){					cmd = cmd & " and tmkt.c14 ='" & serie & "'";				}								var asesor = frn.get("asesor", -1, 1);				if (asesor &! ""){					cmd = cmd & " and tmkt.c3 ='" & asesor & "'";				}								var motivo = frn.get("motivo", -1, 1);				if (motivo &! ""){					cmd = cmd & " and tmkt.c7 ='" & motivo & "'";				}									var resultado = frn.get("resultado", -1, 1);				if (resultado &! ""){					cmd = cmd & " and tmkt.c8 ='" & resultado & "'";				}									var accion = frn.get("accion", -1, 1);				if (accion &! ""){					cmd = cmd & " and tmkt.c9 ='" & accion & "'";				}									var cliente = frn.get("cliente");				if (cliente &! ""){					cmd = cmd & " and tmkt.c20 ='" & cliente & "'";				}									var tipo_N = frn.get("tipo_n", -1, 1);				if (tipo_N &! ""){					cmd = cmd & " and tmkt.c22 ='" & tipo_N & "'";				}									var medio_contacto = frn.get("medio_contacto", -1, 1);				if (medio_contacto &! ""){					cmd = cmd & " and tmkt.c23 ='" & medio_contacto & "'";				}									var prog_ini = frn.get("fecha_prog_ini");				if (prog_ini &! ""){					cmd = cmd & " and tmkt.c5 >= '" & prog_ini & "'";				}									var prog_fin = frn.get("fecha_prog_fin");				if (prog_fin &! ""){					cmd = cmd & " and tmkt.c5 <= '" & prog_fin & "'";				}									var creacion_ini = frn.get("fecha_creacion_ini");				if (creacion_ini &! ""){					cmd = cmd & " and tmkt.c24 >= '" & creacion_ini & "'";				}									var creacion_fin = frn.get("fecha_creacion_fin");				if (creacion_fin &! ""){					cmd = cmd & " and tmkt.c24 <= '" & creacion_fin & "'";				}								var origen = frn.get("origen", -1, 1);				if (origen &! ""){					cmd = cmd & " and tmkt.c25 ='" & origen  & "'";				}										cmd = cmd & " order by tmkt.c5 desc ";						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_view.Buscar()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								tot = nXml(cuboResultados);							borrar();				for (cont=0; cont<tot; cont++){										frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c2"),"tabla",cont,"folio");					frn.setX( getXmlAtt(cuboResultados,"r"&cont,"c14") ,"tabla",cont,"serie");					frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c5"),"tabla",cont,"programacion");					frn.setX( getXmlAtt(cuboResultados,"r"&cont,"c3") ,"tabla",cont,"asesor");						frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c22"),"tabla",cont,"tipo_n");					frn.setX(getXmlAtt(cuboResultados,"r"&cont,"m_contacto"),"tabla",cont,"medio_contacto");					frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c20"),"tabla",cont,"cliente");								frn.setX(getXmlAtt(cuboResultados,"r"&cont,"motivo"),"tabla",cont,"motivo");						frn.setX(getXmlAtt(cuboResultados,"r"&cont,"result"),"tabla",cont,"resultado");						frn.setX(getXmlAtt(cuboResultados,"r"&cont,"accion"),"tabla",cont,"accion");						frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c11"),"tabla",cont,"obs1");						frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c12"),"tabla",cont,"obs2");							frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c24"),"tabla",cont,"creacion");					frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c26"),"tabla",cont,"vale_salida_ult_servicio");					frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c15"),"tabla",cont,"folio_cita");													}						}									fun Seleccionar_serie() {						var cmdQuery = "select c1 as identificador , c2 as marca, c3 as modelo, c8 as placas, c9 as cliente, c4 as serie from keplersc.kdserie ";								frn.dialog("genlistafiltrosel","Clientes",cmdQuery,"identificador","serie", "N");	         }									fun Seleccionar_cliente() {						var cmdQuery = "select c2 as clave, c3 as nombre from keplersc.kdud ";								frn.dialog("genlistafiltrosel","Clientes",cmdQuery,"clave","cliente", "N");	         }         												fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}												fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}								}	</script></pag>