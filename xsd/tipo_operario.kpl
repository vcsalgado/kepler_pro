<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Tipo Operario"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="46,40,10,10" brdr="0,5" tit="Tipo Operario" fnt="Arial,16">					<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" OnEnter="Exit" OnMouseD="Exit" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="40,22" modify="N" nren="fijo">		<col id="clave" name="Clave"/>		<col id="tipo" name="Tipo"/>		</tbl> 		<tab n="7"/>		<br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario ,asterisco, externo,tipo_punto;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				tipo_punto= frP.get("tabla_puntos" , -1, "tipo_punto");				Inicializa();					}						fun Inicializa() {							var xmlRequest,cmd,ok,cuboResultados, totres , contres;								cmd= "select cat.c1,cat.c2 from keplersc.kdpuntop as top inner join keplersc.kdtoper as cat on cat.c1=top.c2 where top.c1='" & tipo_punto & "'";							cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tipo_operario.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								totres = nXml(cuboResultados);							frn.rst("tabla");				for (contres=0; contres<totres ; contres++){								frn.setX( getXmlAtt(cuboResultados,"r"&contres,"c1"),"tabla",contres,"clave");					frn.setX( getXmlAtt(cuboResultados,"r"&contres,"c2"),"tabla",contres,"tipo");								}						}						fun Exit(){							var clave_ope = frn.get("tabla", -1, "clave");											frP.setX(clave_ope,"tabla_puntos",-1,"tipo_operario"); 				frP.scriptElm("tabla_puntos","OnChange","tipo_operario");												var desc_ope  = frn.get("tabla", -1, "tipo");											frP.setX(desc_ope  ,"tabla_puntos",-1,"desc_operario"); 				frP.scriptElm("tabla_puntos","OnChange","desc_operario");								frn.exit();							}						}	</script></pag>