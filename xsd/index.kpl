<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Kepler ERP">	<grp dim="-1,-1,6,16" fnt="Arial,16">		<book rpage="principal">			<tree OnEnter="OpenPageK" brdr="2,1" bclr="192,205,213" close="N" dimImg="60,60,24,24" fnt="Arial,18" fnt2="Arial,16">				<branch txt="Contabilidad" hk="C" img="60_Contabilidad.png">					<branch txt="Cat&#225;logo de Cuentas" hk="C">						<branch txt="Edita Cat&#225;logo OCCE" hk="A" pag="cat_cuentas_view.kpl" roles="ADMINISTRADOR,RKMARTINEZ,RALIZARDI,RANUNEZ,RGGARCIA,RRVELAZQUEZ,RBHERNANDEZ"/>						<branch txt="* Define Cuentas" hk="D" pag="concatdefpag.kpl" roles="ADMINISTRADOR,RKMARTINEZ,RALIZARDI,RANUNEZ,RRVELAZQUEZ"/>					</branch>					<branch txt="Emisi&#243;n de P&#243;lizas" hk="P">						<branch txt="Alta de P&#243;liza" pag="conpolizapag.kpl" param="N,A,21,,A,0" roles="ADMINISTRADOR,RALIZARDI,RKMARTINEZ,RANUNEZ,RLGAONA,RBHERNANDEZ,RJACOSTA,RRVELAZQUEZ"/>						<branch txt="Modificaci&#243;n de P&#243;liza" pag="conpolizasview.kpl" param="MODIFICAR" roles="ADMINISTRADOR,RRVELAZQUEZ,RLGAONA,RBHERNANDEZ,RANUNEZ,RJACOSTA"/>						<branch txt="Baja de P&#243;liza" pag="conpolizasview.kpl" param="BAJA" hk="B" roles="ADMINISTRADOR,RALIZARDI,RKMARTINEZ,RANUNEZ,RLGAONA,RBHERNANDEZ,RJACOSTA,RRVELAZQUEZ"/>						<branch txt="Consulta P&#243;lizas" hk="C" param="CONSULTA" pag="conpolizasview.kpl" roles="ADMINISTRADOR,RALIZARDI,RGGARCIA,RJFERNANDEZ,RKMARTINEZ,RANUNEZ,RLGAONA,RBHERNANDEZ,RJACOSTA,RRVELAZQUEZ"/>						<branch txt="* Busca Monto" hk="M" pag="conemibmopag.kpl" roles="ADMINISTRADOR,RRVELAZQUEZ"/>					</branch>					<branch txt="Reportes" hk="R">						<branch txt="Generar Subcuentas" pag="congensubcuentas.kpl" roles="ADMINISTRADOR,RRVELAZQUEZ"/>						<branch txt="Auxiliar" hk="C" pag="conrepaux.kpl" roles="ADMINISTRADOR,RJFERNANDEZ,RKMARTINEZ,RRVELAZQUEZ,RFISCAL,RJACOSTA,RANUNEZ"/>						<branch txt="Mayor Auxiliar" hk="A" pag="conRepMayAux.kpl" roles="ADMINISTRADOR,RJFERNANDEZ,RKMA