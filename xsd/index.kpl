<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Kepler ERP">	<grp dim="-1,-1,6,16" fnt="Arial,16">		<book rpage="principal">			<tree OnEnter="OpenPageK" brdr="2,1" bclr="192,205,213" close="N" dimImg="60,60,24,24" fnt="Arial,18" fnt2="Arial,16">				<branch txt="Contabilidad" hk="C" img="60_Contabilidad.png">					<branch txt="Cat&#225;logo de Cuentas" hk="C">						<branch txt="Edita Cat&#225;logo OCCE" hk="A" pag="cat_cuentas_view.kpl" roles="ADMINISTRADOR,RAARAUZ,SCTR,RLJIMENEZ,RRVELAZQUEZ,RMNOPAL,SCONT,VCAJA,VCTRX,RGGARCIA"/>						<branch txt="* Define Cuentas" hk="D" pag="concatdefpag.kpl" roles="ADMINISTRADOR,RAARAUZ,RRVELAZQUEZ"/>					</branch>					<branch txt="Emisi&#243;n de P&#243;lizas" hk="P">						<branch txt="Alta de P&#243;liza" pag="conpolizapag.kpl" param="N,A,21,,A,0" roles="ADMINISTRADOR,RAARAUZ,SCTR,RLJIMENEZ,RRVELAZQUEZ,RMNOPAL,SCONT,VCAJA,VCTRX,RLGAONA,RBHERNANDEZ,REGOMEZ"/>						<branch txt="Modificaci&#243;n de P&#243;liza" pag="conpolizasview.kpl" param="MODIFICAR" roles="ADMINISTRADOR,RLJIMENEZ,RRVELAZQUEZ,RLGAONA" user="JNAVARRO,MNOPAL,IBAEZA,DRESENDIZ"/>						<branch txt="Baja de P&#243;liza" pag="conpolizasview.kpl" param="BAJA" hk="B" roles="ADMINISTRADOR,RAARAUZ,SCTR,RLJIMENEZ,RRVELAZQUEZ,RMNOPAL,SCONT,VCAJA,VCTRX,RLGAONA,RBHERNANDEZ,REGOMEZ"/>						<branch txt="Consulta P&#243;lizas" hk="C" param="CONSULTA" pag="conpolizasview.kpl" roles="ADMINISTRADOR,RAARAUZ,SCTR,RLJIMENEZ,RRVELAZQUEZ,RGGARCIA,RMNOPAL,SCONT,VCAJA,VCTRX,CONTRALOR,RLGAONA,RBHERNANDEZ,REGOMEZ"/>						<branch txt="* Busca Monto" hk="M" pag="conemibmopag.kpl" roles="ADMINISTRADOR,RAARAUZ"/>					</branch>					<branch txt="Reportes" hk="R">						<branch txt="Generar Subcuentas" pag="congensubcuentas.kpl" roles="ADMINISTRADOR,RAARAUZ,SCONT,SCTR,RRVELAZQUEZ,RMNOPAL"/>						<branch txt="Auxiliar" hk="C" pag="conrepaux.kpl" roles="ADMINISTRADOR,RAARAUZ,SCTR,RMNOPAL,RRVELAZQUEZ"/>						<branch txt="Mayor Auxiliar" hk="A" pag="conRepMayAux.kpl" roles="ADMINISTRADOR,RAARAUZ,RRVELAZQUEZ,RMNOPAL"/>						<branch txt="* Libro Mayor" hk="M" pag="conRepMayRep.kpl" roles="ADMINISTRADOR,RAARAUZ"/>						<branch txt="* Balanza de Comprobaci&#243;n" hk="B" pag="conrepbalanzacomp.kpl" roles="ADMINISTRADOR,RAARAUZ,RRVELAZQUEZ"/>						<branch txt="Imprime una P&#243;liza OCRI" hk="B" pag="contreppoliza.kpl" roles="ADMINISTRADOR,RAARAUZ,CONVR,RCONT,RGGARCIA,RCT,SCONT,SCTR,RLJIMENEZ,RRVELAZQUEZ,RMNOPAL,VCONT,VCTRX,VCAJA,CONTRALOR,RLGAONA,RBHERNANDEZ,REGOMEZ"/>					</branch>					<branch txt="Consulta de Saldos OCS" pag="conconsultasaldos.kpl" hk="S" roles="ADMINISTRADOR,RAARAUZ,CONVR,RCT,SCONT,SCTR,RLJIMENEZ,RRVELAZQUEZ,RMNOPAL,VCONT,VCTRX,VCAJA,CONTRALOR,RLGAONA,RBHERNANDEZ"/>					<branch txt="Mantenimiento" hk="M">						<branch txt="Fin de Anio" hk="F">							<branch txt="X Configurar Cuentas" hk="A" roles="ADMINISTRADOR,RAARAUZ"/>							<branch txt="Fin de Anio" hk="E" roles="ADMINISTRADOR,RAARAUZ,SCTR,RRVELAZQUEZ,SCONT,VCAJA,VCTRX" pag="cont_fin_anio.kpl"/>						</branch>						<branch txt="Regeneracion Masiva CFDI" pag="cfdiview.kpl" param="CFDIMASIVO" roles="ADMINISTRADOR,RAARAUZ,SCTR,RLJIMENEZ,RRVELAZQUEZ,RMNOPAL,SCONT,VCAJA,VCTRX,RGGARCIA"/>						<branch txt="Regenera CFDI OCMC" pag="cfdiregenerafolio.kpl" param="CFDIFOLIO" roles="ADMINISTRADOR,RAARAUZ,RGGARCIA,VCAJA,VCONC,VGERO,SCTR,RLJIMENEZ,RRVELAZQUEZ,RMNOPAL,SCONT,VCAJA,VCTRX,VCTR,RGREF,CONTRALOR,RLGAONA,RBHERNANDEZ,REGOMEZ,RLMENDOZA,RDGIRON,RBMARTINEZ"/>						<branch txt="Regeneraci&#243;n de P&#243;lizas" hk="R" pag="cont_regenerar_polizas" roles="ADMINISTRADOR,RAARAUZ,RRVELAZQUEZ"/>						<branch txt="Actualizaci&#243;n de Saldos" pag="cont_regeneracion_saldos.kpl" hk="R" roles="ADMINISTRADOR,RAARAUZ,SCTR,RLJIMENEZ,RRVELAZQUEZ,SCONT,VCAJA,VCTRX"/>						<branch txt="Abre - Cierra mes" pag="cierra_abre_mes.kpl" roles="ADMINISTRADOR,RAARAUZ,SCONT,CONTRALOR,RRVELAZQUEZ"/>						<branch txt="Reasignar Cuenta" hk="G" pag="cont_re