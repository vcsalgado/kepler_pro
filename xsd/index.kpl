EZ"/>						<branch txt="Actualizaci&#243;n de Saldos" pag="cont_regeneracion_saldos.kpl" hk="R" roles="ADMINISTRADOR,RRVELAZQUEZ"/>						<branch txt="Abre - Cierra mes" pag="cierra_abre_mes.kpl" roles="ADMINISTRADOR,RRVELAZQUEZ"/>						<branch txt="Reasignar Cuenta" hk="G" pag="cont_reasignar_cuenta" roles="ADMINISTRADOR,RRVELAZQUEZ,RJACOSTA,RANUNEZ"/>						<branch txt="Genera CxCP" pag="regenerarcxp.kpl" roles="ADMINISTRADOR"/>						<branch txt="Configuracion de polizas para facturas" pag="conf_polizas_facturas.kpl" roles="ADMINISTRADOR,RRVELAZQUEZ"/>											</branch>				</branch>				<branch txt="Presupuestos" img="60_Presupuesto.png">					<branch txt="Conceptos de Presupuesto">						<branch txt="Alta" pag="cat_concepresup_crud.kpl" roles="ADMINISTRADOR,RKMARTINEZ" param="NUEVO"/>						<branch txt="Modificar" pag="gencatalogoview.kpl" param="CONPRES,MODIFICAR" roles="ADMINISTRADOR,RKMARTINEZ"/>						<branch txt="Consultar" pag="gencatalogoview.kpl" param="CONPRES,CONSULTAR" roles="ADMINISTRADOR,RKMARTINEZ"/>					</branch>					<branch txt="Configuracion de Presupuesto" pag="presupuesto.kpl" roles="ADMINISTRADOR,RLGAONA,RBHERNANDEZ,RRVELAZQUEZ,RKMARTINEZ" user=""/>					<branch txt="Configura cuentas" pag="cat_cuentasppto.kpl" roles="ADMINISTRADOR,RRVELAZQUEZ,RKMARTINEZ"/>				</branch>				<branch txt="Cuentas x Cobrar" hk="U" img="60_CxC.png" roles="ADMINISTRADOR">					<branch txt="Cargos a CXC" hk="C">						<branch txt="Alta de Cargos CXC" hk="A" pag="cargos_abonos_a_cxc.kpl" param="U,D,13,1,A,,VEN" roles="RGGARCIA,RRVELAZQUEZ,RGGARCIA"/>						<branch txt="Consulta de Cargos CXC" hk="C" pag="cargos_abonos_a_cxc.kpl" param="U,D,13,1,C,,VEN" roles="RANUNEZ,RKMARTINEZ,RGGARCIA,RJACOSTA,RRVELAZQUEZ"/>					</branch>					<branch txt="Abonos a CXC" hk="C">						<branch txt="Alta de Abonos CXC" hk="A" pag="cargos_abonos_a_cxc.kpl" param="U,A,13,1,A,,VEN" roles="RGGARCIA,RRVELAZQUEZ,RGGARCIA"/>						<branch txt="Consulta de Abonos CXC" hk="C" pag="c