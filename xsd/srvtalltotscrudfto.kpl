<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de TOTs" scale="48">	<grp dim="1,-1,10,25" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,15" unfont="0">				<br exe="encabezado"/>		<hLine dim="95,0" g="2" type="1"/>		<br exe="encabezado"/>		<grp dim="13,5,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>			</grp>		<grp dim="62,6,7,12">			<br/>			<inp id="nombreempresa" dim="60,1"  fnt="19b,19b"  type="string" modify="N" brdr="1,0" bclr="255,255,255" just="C"/>			<br/>			<br/>						<txt fnt=",19b" clr="0,58,112">Recibo para elaboraci&#243;n de cheques de Refacciones y Trabajos de otros Talleres</txt>			<br exe="encabezado"/>						<br exe="encabezado"/>		</grp>		<grp dim="15,4,7,12">			<tab n="2"/><txt>P&#225;g:   </txt>			<inp id="k_pag" dim="5,1" type="number" mcr="k_pag"/><br/><br/>			<inp id="fecha" dim="10,1" type="date" fmt="DD-MM-CCYY" nc="-1" just="R"/>			<inp id="hora" dim="7,1" type="time" nc="-1" just="L"/>		</grp>				<grp dim="5,5,7,12"/>			<br exe="encabezado"/>			<hLine dim="95,0" g="2" type="1"/>			<br exe="encabezado"/><sp/>			<txt fnt=",-1b">Sucursal: </txt>			<tab/>			<inp id="desc_sucursal" dim="30,1" type="string"/>			<tab n="10"/>			<txt fnt=",-1b">Docto: </txt>			<tab n="1"/>			<inp id="docto" dim="13,1" type="string" just="L"/>			<br exe="encabezado"/>			<tab n="23"/>			<txt fnt=",-1b">Folio: </txt>			<tab n="1"/>			<inp id="folio" dim="10,1" type="string" just="L"/>			<br exe="encabezado"/><sp/>			<txt fnt=",-1b">Proveedor: </txt>			<tab n="1"/>			<inp id="proveedor_id" dim="10,1" type="string"/>			<br exe="encabezado"/><tab n="3"/>			<inp id="nombre" dim="70,1" type="string"/>			<br exe="encabezado"/>			<tab n="3"/>			<inp id="direccion" dim="50,1" type="string"/>			<br exe="encabezado"/>			<tab n="3"/>			<inp id="colonia" dim="40,1" type="string"/>			<inp id="cp" dim="7,1" type="string"/>			<tab/><br exe="encabezado"/><sp/>			<txt fnt=",-1b">R.F.C.: </txt>			<tab n="2"/>			<inp id="rfc" dim="20,1" type="string"/>			<br exe="encabezado"/>			<br exe="encabezado"/><sp/>			<txt fnt=",-1b">Factura de Compra:</txt>			<inp id="referencia" dim="40,1" type="string"/>			<tab n="5"/>			<txt fnt=",b">Monto: </txt>					<inp id="monto_total" dim="10,1" type="number" just="R" nd="2"/>			<txt fnt=",b"> Pesos</txt>			<br exe="encabezado"/>			<br exe="encabezado"/>			<hLine g="2" dim="95,0"/><br  exe="encabezadoPol"/><tab n="13"/>			<txt>P O L I Z A  C O N T A B L E</txt><br exe="encabezadoPol"/>			<sp/><txt fnt="Arial,18b">P&#243;liza </txt>			<inp id="tPol"  dim="2,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15b"/>			<inp id="nPol"  dim="15,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15b"/>			<br exe="encabezadoPol"/>			<br exe="encabezadoPol"/>			<sp/><txt fnt="Arial,15b">N&#250;mero</txt><tab n="6"/>			<txt>Cuenta</txt><tab n="6"/>			<txt>          Referencia</txt><tab n="3"/>			<txt>Debe</txt><tab n="4"/>			<txt>Haber</txt>			<br exe="encabezadoPol"/>			<hLine dim="95,0" g="2"/>			<br  exe="encabezadoPol"/>			<inp id="PolClave"  dim="20,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/>			<inp id="PolDescr"  dim="25,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/>			<inp id="PolRefer" dim="10,1" type="string" just="R" fnt="Arial,15" brdr="0,1"/><tab/>			<inp id="PolDebe"  dim="15,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15" nd="2"/>			<br exe="partPolC"/>			<inp id="PolClave2"  dim="20,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/>			<inp id="PolDescr2"  dim="25,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/>			<inp id="PolRefer2" dim="10,1" type="string" just="R" fnt="Arial,15" brdr="0,1"/><tab/>			<inp id="espacio"  dim="15,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15" nd="2"/>			<inp id="PolHaber"  dim="15,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15" nd="2"/>			<br exe="partPolA"/>			<hLine dim="95,0" g="2"/>			<br exe="PolTotales"/>			<tab n="16"/><txt>Sumas    </txt><tab/>			<inp id="totCargo"  dim="15,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15b" nd="2"/>			<inp id="totAbono"  dim="15,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15b" nd="2"/>			<br exe="PolTotales"/><tab/>			<br exe="fin"/>			<hLine dim="95,0" g="2" type="1"/>				<br exe="notastitulos"/><tab n="1"/>			<txt fnt=",-1bi">N O T A S : </txt>			<br exe="notastitulos"/><sp n="2"/>			<inp id="desc_notas" dim="87,2" type="string"/><tab/>			<br exe="notastitulos"/>			<tab n="21"/><txt fnt=",b">-M A R G E N -</txt>			<br exe="notastitulos"/>					<tab/><txt fnt=",b">Orden</txt><tab/><sp/>			<txt fnt=",0b">Punto</txt><tab n="4"/>			<txt fnt=",-1b">Descripci&#243;n</txt><tab n="6"/><sp/>			<txt fnt=",0b">Costo</txt><tab n="2"/><sp/><txt fnt=",0b">Precio</txt><sp/>			<txt fnt=",0b">Min</txt><sp n="1"/>			<txt fnt=",0b">Carg</txt><tab n="2"/>			<txt fnt=",0b">Cliente</txt><tab/>			<br exe="notastitulos"/>					<hLine dim="95,0" g="2" type="1"/>			<br exe="notastitulos"/>			<br exe="producto"/>			<inp id="tipo_orden" dim="2,1" type="string"/><sp/>			<inp id="num_orden" dim="7,1" type="string"/><sp/>			<inp id="punto" dim="2,1" type="string"/><sp/>			<inp id="desc_tot" dim="30,1" type="string"/><sp/>			<inp id="costo" dim="8,1" type="number" just="R" nd="2"/><sp/>			<inp id="precio" dim="8,1" type="number" just="R" nd="2"/><sp/>			<inp id="min" dim="3,1" type="number" just="R"/><sp/>			<inp id="carg" dim="3,1" type="number" just="R" nd="2"/><sp/>			<inp id="cliente" dim="20,1" type="string"/>			<br exe="detalle"/>	 					<br exe="totalproducto"/>  				<hLine dim="95,0" g="2" type="1"/>			<br exe="totalproducto"/>					</grp></pag>