<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Esquemas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">	<tab/><txt fnt=",22" clr="0,0,0"> Configuraci&#243;n de comisiones de Telemarketing</txt><tab/>	<br/>		<tab/><hLine clr="0,0,0"	dim="36,0"/>	<br/>	<br/><tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="45,15,10,17" brdr="0,5" tit="Configuracion de comisiones" fnt="Arial,16"><tab/><txt>Rangos  Proactivas</txt><tab n="4"/><txt>Rangos Pasivas</txt><tab n="3"/><txt>Comisiones Paquetes</txt><tab/>				<br/>		<sp/>		<tbl id="k_comis_pro" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="25,10" modify="Y" Reorder="Y" available="Y" insdel="Y">			<col name="Lim.Inf." id="lim_inf"  modify="Y" visible="Y" type="number" available="Y"/>			<col name="Lim.Sup." id="lim_sup"  modify="Y" visible="Y" available="Y" type="number"/>			<col name="Comision Cita" id="comis_pro"  nc="5" modify="Y" visible="Y" type="number" available="Y"/>		</tbl>			<sp/>		<tbl id="k_comis_pas" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="15,10" modify="Y" Reorder="Y" available="Y" insdel="N">			<col name="Comision Cita" id="comis_pas"  nc="5" modify="Y" visible="Y" type="number" available="Y"/>		</tbl>		<sp/>		<tbl id="k_comis_paq" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="46,10" modify="Y" Reorder="Y" available="Y" insdel="N">			<col name="Comision" id="comis_paq"  nc="5" modify="Y" visible="Y" type="number" available="Y"/>			<col name="Paquete" id="paquete"  modify="N" visible="Y" type="string" available="Y"/>			<col name="Descripcion" id="descripcion"  modify="N" visible="Y" type="string" available="Y"/>		</tbl>				<br/><sp/>		<bot id="k_btn_guardar" dim="10,10" brdr="5" text="Guardar" hk="K" default="1" step="0"  OnEnter="Guardar()" fnt="Arial,16"/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, asterisco  ;		var cmdQuery, cuboQuery, ok, mensajeError;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			rol_usuario = frn.config("user","role");			asterisco = "*";						llena_combos();			cargar_configuracion_comision();						ConfiguraUI();			Inicializa();		}		fun Inicializa(){		}				            		fun llena_combos(){			ResetDetalle();		}				fun ResetDetalle(){			frn.rst("k_mov");		}				fun Guardar(){			var xmlPantalla,no_partidas,resultado,mensaje,adicionales;			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			no_partidas=frn.N("k_comis_pro")-1;									setXml(xmlPantalla ,"k_partidas_pro","no_partidas",no_partidas);						no_partidas=frn.N("k_comis_pas")-1;									setXml(xmlPantalla ,"k_partidas_pas","no_partidas",no_partidas);						no_partidas=frn.N("k_comis_paq")-1;									setXml(xmlPantalla ,"k_partidas_paq","no_partidas",no_partidas);			var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);			if (resultado_confirmacion &! 1)  {				return;			}										frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaComisTmkt");			cmdQuery="select * from keplersc.tmkt_comis_config('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						kdb.rst(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"tmkt_comis_config.Alta");			resultado= getXml(cuboQuery,"resultado");			mensaje= getXml(cuboQuery,"mensaje");							if(resultado &= "0"){				frn.message(mensaje,"Error","Aceptar");				return;			}			frn.message("Registros modificados","Mensaje","Aceptar");		}				fun ConfiguraUI(){		}		            fun cargar_configuracion_comision(){			var cmd = "select c1,c2,c3 from keplersc.kdctascomis order by c1";			var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_comis_config()");						ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}							frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");							frn.setX(cubo,"k_comis_pro");			cmd = "select c2 from keplersc.kdctascomispasivas limit 1";			frn.rst(cubo);			cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_comis_config()");						ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}							frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");							frn.setX(cubo,"k_comis_pas");									cmd = "select distinct com.c2, com.c1, paq.c5 from keplersc.kdctascomispaq com inner join keplersc.kdspaq paq on paq.c4=com.c1 order by paq.c5";						frn.rst(cubo);			cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_comis_config()");						ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}							frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");							frn.setX(cubo,"k_comis_paq");		}      		fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}									fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}			           					}				</script></pag>