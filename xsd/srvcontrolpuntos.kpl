<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Control"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>	<br/><tab n="1"/><txt clr="0,0,0" fnt="Arial,22">Control de &#211;rdenes</txt><br/>	<tab/><hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp dim="110,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle de la orden">		<sp/><txt fnt=",b">Sucursal:</txt><sp/><inp id="k_sucursal" dim="5,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<sp/><inp id="k_sucnombre" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/><tab/><txt fnt=",b">Fecha:  </txt>		<inp id="k_fecha" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" modify="N" available="N" fmt="DD/MM/CCYY" nc="-1" fnt=",0"/><tab/><txt fnt=",b">Estatus:</txt>		<inp id="k_estatusdesc" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/><tab n="2"/>		<br/>		<sp/><txt  fnt="Arial,b">Tipo:</txt><sp/><inp id="k_tipo" clr="64,64,64"  dim="3,1" fnt="Arial,0" clrBrdr="255,255,255"   bclr="255,255,255" modify="N" visible="Y" type="string" brdr="2,0"/>		<sp/><inp id="k_tipodesc" dim="25,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" fnt=",0" modify="N" available="N"/>		<tab/><txt  fnt="Arial,b">Folio:</txt><sp/><inp id="k_folio" clr="64,64,64"  dim="18,1" fnt="Arial,0" clrBrdr="255,255,255"   bclr="255,255,255" brdr="2,0"  modify="N" visible="Y" type="string"/>		<tab/><txt fnt=",b">Cliente: </txt><sp/><inp id="k_cliente" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<sp/><inp id="k_nombre" dim="50,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<br/>		<sp/><txt fnt=",b">VIN: </txt><sp/><inp id="k_serie" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<tab/><txt fnt=",b"> Marca:</txt><sp/>	<inp id="k_marca" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<tab/><txt fnt=",b">Modelo:</txt><sp/><inp id="k_modelo" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<tab/><txt fnt=",b">A&#241;o:</txt><sp/><inp id="k_anio" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<tab/><txt fnt=",b">Placas:</txt><sp/><inp id="k_placa" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>		<tab/><txt fnt=",b">Bonete:</txt><sp/><inp id="k_bonete" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>	</grp>	<br/><br/>	<tab n="1"/><grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="110,29,10,10" brdr="0,5" tit="Detalle de Control" fnt="Arial,16">				<br/>			<sp/><tab/><tbl id="tabla_puntos" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="98,9"  hk="z" OnChange="" Reorder="N" modify="Y" available="Y">			<col id="tipo_punto" name="Tipo de Punto" modify="N" visible="N"  type="capital"/>			<col id="desc_punto" name="Tipo de Punto" modify="N"  type="capital"/>			<col id="trabajo_a_realizar" name="Descripcion" modify="N" type="capital"/>			<col id="tipo_operario" name="Tipo de Operario" visible= "N"/>			<col id="desc_operario"  OnF9="Dialog(3,tipo_operario)" modify="N" name="Tipo de Operario"/>			<col id="clave_operario" OnF9="Seleccionar_operario()" OnChange="insert_operario()" modify="N" name="Operario"/>			<col id="estatus" name="Estatus" modify="Y" OnF9="Seleccionar_Estatus()" OnChange="insert_Estatus()" nc="1"/>			<col id="codigo_suspension" name="Susp"/>							</tbl>		<br/><br/>		<tab n="25"/><bot id="bot_reporte" dim="14,0" brdr="5" text="Imprime Reporte" default="0" OnEnter="Reporte()"/>		<tab n="1"/><bot id="bot_guardar" dim="14,0" brdr="5" text="Guardar Cambios" default="0" OnEnter="Guardar()"/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,usuario,suc_usuario,perfil_usuario,rol_usuario  ,asterisco,vin , externo, sucursal,folio_orden, tipo_orden, rep, clave_tecnico ;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				rep=new REP;				kdb.connect();												suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");								rol_usuario = frn.config("user","role");				asterisco = "*";								sucursal =trim(frn.param(0));				tipo_orden=trim(frn.param(1));				folio_orden=trim(frn.param(2));					Inicializa();			}			fun IniParams(){//Inicializa par�metros de impresi�n. Pueden ser cambiados por el usuario final mediante men�: Archivo -> Configurar P�gina				frn.set("param_paper","letter");	//Tama�o de papel predefinido:	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tama�o de papel personalizado	"size=21.59,27.94cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//M�rgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0");	//Escala de impresi�n (1=100 por ciento)	"F=1,1"				frn.set("param_landscape","N");	//Orientaci�n	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"				frn.set("param_emp","L");	//Posici�n de "Raz�n social"(izq,der,cen)	@emp=L|R|C"			}						fun Reporte(){//Ejecuta el Reporte				// Se define el formato a usar y se liga a la variable del reporte "rep"				var cubo, ok, cmd, mensajeError ;				var compania, usuario, strValor, fechaImpresion, horaImpresion;				var k_bonete, k_orden, k_unidad, k_placas, k_km, k_punto, k_status, k_auto, k_trabajo_1, k_trabajo_2, k_trabajo_3, k_serie, k_fventa, k_recep, k_operario, k_cliente, k_sucursal, k_sucnombre, k_folio;				kdb.readPage("datFto","srvcontrolpuntosfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				kdb.kde("KDE");				kdb.exec();				compania = kdb.get("KDE","1");				k_sucursal = frn.get("k_sucursal");				k_sucnombre = frn.get("k_sucnombre");				k_folio = frn.get("k_folio");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();				rep.rst();				setRepPage();				rep.set("fecha",sys.date());rep.set("hora",sys.time());				rep.set("k_empresa",compania);				rep.set("k_sucursal",k_sucursal); 				rep.set("k_sucnombre",k_sucnombre); 				rep.set("k_fecha",frn.get("edt_fecha"));				rep.set("k_fecha_imp",fechaImpresion);				rep.set("K_hora_imp",horaImpresion);				rep.exe("encabezado");				cmd = "select						ord.c1 as sucursal,						concat(ord.c2,'   ',ord.c3) k_orden,						ord.c19 as k_bonete,						concat(modelos.c3,' / ', serie.c10, ' / ', serie.c11) k_unidad,						serie.c8 k_placas,						serie.c12 k_km,						serie.c4 k_serie,						serie.c13 k_fventa,						recep.c2 k_recep,						case 							when concat(oper.c1, oper.c3) = ''							then ' NO ASIGNADO'							else concat(oper.c1, '  ',oper.c3)						end k_operario,						ord.c11 k_cliente,						pun.c4 k_punto,						case 							when margen.c2 = 'N' and pun.c6 = 'S'							or margen.c2 = 'N' and pun.c6 = 'F'							or margen.c2 = 'N' and pun.c6 ='H'							or margen.c2 = 'N' and pun.c6 ='L'							then 'AUTORIZA' 							when margen.c2 = 'N' and pun.c6 ='P'							then 'PRESUPUESTO'							when margen.c2 = 'N' and pun.c6 = 'N'							then 'NO AUTORIZA'						end k_auto,						case 							when pun.c7 = 'A'							then 'ACTIVO'							when pun.c7 = 'P'							then  'PENDIENTE'							when pun.c7 = 'S'							then 'SUSPENDIDO'						end k_status,						pun.c8 k_trabajo_1						from keplersc.kdord ord						inner join keplersc.kdmargen margen						on margen.c1 = ord.c2 						inner join keplersc.kdserie serie						on serie.c1 = ord.c6						inner join keplersc.kdmarcas marcas 						on marcas.c1 = serie.c2 						inner join keplersc.kdmodelos modelos						on modelos.c1 = serie.c2 and modelos.c2 = serie.c3 						inner join keplersc.kdrecep recep						on recep.c1 = ord.c22 						inner join keplersc.kdpun pun						on pun.c1 = ord.c1 and pun.c2 = ord.c2 and pun.c3 = ord.c3 						left  join keplersc.kdoper oper						on pun.c9 = oper.c1 						where ord.c1 = '"& k_sucursal &"' and ord.c3 ='"& k_folio &"'						order by k_operario";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"vcssprod.Ejecuta()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboPrueba");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var acum=0,val=0;				var oper ="";				for(var ren=0;ren<nXml(cubo);ren++){										k_bonete = getXmlAtt(cubo,"r"&ren,"k_bonete");					k_orden = getXmlAtt(cubo,"r"&ren,"k_orden");					k_unidad = getXmlAtt(cubo,"r"&ren,"k_unidad");					k_placas = getXmlAtt(cubo,"r"&ren,"k_placas");					k_km = getXmlAtt(cubo,"r"&ren,"k_km");					k_serie = getXmlAtt(cubo,"r"&ren,"k_serie");					k_fventa = getXmlAtt(cubo,"r"&ren,"k_fventa");					k_recep = getXmlAtt(cubo,"r"&ren,"k_recep");					k_operario = getXmlAtt(cubo,"r"&ren,"k_operario");					k_cliente = getXmlAtt(cubo,"r"&ren,"k_cliente");					k_punto = getXmlAtt(cubo,"r"&ren,"k_punto");					k_status = getXmlAtt(cubo,"r"&ren,"k_status");					k_auto = getXmlAtt(cubo,"r"&ren,"k_auto");					k_trabajo_1 = mid(delScpScn(getXmlAtt(cubo,"r"&ren,"k_trabajo_1")),0,30);					k_trabajo_2 = mid(delScpScn(getXmlAtt(cubo,"r"&ren,"k_trabajo_1")),30,30);					k_trabajo_3 = mid(delScpScn(getXmlAtt(cubo,"r"&ren,"k_trabajo_1")),60,30);					if(oper &! k_operario){						oper = k_operario;						rep.set("k_bonete",k_bonete);						rep.set("k_orden", k_orden);						rep.set("k_unidad",k_unidad);						rep.set("k_placas",k_placas);						rep.set("k_km",k_km);						rep.set("k_serie",k_serie);						rep.set("k_fventa",k_fventa);						rep.set("k_recep", k_recep);						rep.set("k_operario", k_operario);						rep.set("k_cliente",k_cliente);						rep.exe("encabezado_recep");					}					rep.set("k_punto",k_punto);					rep.set("k_status",k_status);					rep.set("k_auto",k_auto);					rep.set("k_trabajo_1",k_trabajo_1);					rep.exe("detalle");					rep.set("k_trabajo_2",k_trabajo_2);					rep.set("k_trabajo_3",k_trabajo_3);					rep.exe("trabajo_1");					rep.exe("salto");										var sig_oper = getXmlAtt(cubo,"r"&ren+1,"k_operario");					if(oper &! sig_oper){						rep.exe("linea");						rep.set("k_orden_2", k_orden);						rep.set("k_operario_2", k_operario);						rep.set("k_unidad_2",k_unidad);						rep.set("k_placas_2",k_placas);						rep.set("k_fecha_2",fechaImpresion);						rep.exe("fin_reporte");					}					val = ren + 1 ; 				}					acum = val;				rep.set("input3",acum);				rep.exe("total");								//Modos de impresi�n 				rep.win(); //Muestra la vista previa de la impresi�n. A partir de la vista previa (Preprint) se decide si se imprime o no.				//rep.print("\\192.168.1.100\HPLaserJet"); //Env�a el reporte directamente a una impresora, sin mostrar la vista previa.				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresi�n. No muestra la vista previa.				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardar� el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html			}						fun setRepPage() {//Establece los par�metros finales de impresi�n.				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}									fun Inicializa(){				var cmd, cubo, ok, mensajeError ;				var xmlOrden, xmlDatos;							xmlOrden= frn.lib("libOrdenes.kpl","ConsultaOrden",sucursal,tipo_orden,folio_orden);								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				xmlDatos = frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",xmlOrden,"r0");				frn.setX(xmlDatos);																/*cmd = " select c1 from keplersc.kdrecep where c1='" & usuario & "'";									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcontrolpuntos.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\perfil_usuario");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}							if (nXml(cubo) &= "0"){					frn.message("No tienes permisos para acceder a esta opcion","Error","Aceptar");					frn.timer(0,1,"salir()");				}*/					//puntos				cmd = " select cat.c1 as tipo_punto, cat.c2 desc_punto,pun.c8 as trabajo_a_realizar, oper.c1 as tipo_operario, oper.c2 as desc_operario ";				cmd = cmd & " , pun.c9 as clave_operario, pun.c7 as estatus,pun.c17 as codigo_suspension ,  ser.c1 as serie ";				cmd = cmd & "from keplersc.kdord as ord left outer join keplersc.kdpun as pun on pun.c1=ord.c1 and pun.c2=ord.c2 ";				cmd = cmd & " and pun.c3=ord.c3 left outer join keplersc.kdserie as ser on ser.c1=ord.c6 ";				cmd = cmd & " left outer join keplersc.kdspaq as paq on paq.c1=ser.c2 and paq.c2=ser.c3 and paq.c4=pun.c5 ";				cmd = cmd & " inner join keplersc.catpuntos as cat on cat.c1=pun.c6 inner join keplersc.kdtoper as oper on oper.c1=pun.c37 ";				cmd = cmd & " where ord.c1='" & sucursal & "' and ord.c2='" & tipo_orden & "' and ord.c3='" & folio_orden & "' order by pun.c4 " ;							rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcontrolpuntos.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\puntos");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												frn.setX(cubo,"tabla_puntos");								vin = getXmlAtt(cubo,"r0","serie");				IniParams();														}						fun valida_tecnico(){							//verifica que sea un tecnico 				var cmd = " select c1 from keplersc.kdoper where c20='" & usuario  & "'";											var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcontrolpuntos.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\puntos");				var ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}															clave_tecnico = getXmlAtt(cubo,"r0","c1");								var tecnico_asignado = frn.get("tabla_puntos", -1, "clave_operario") ;									if (clave_tecnico &! "" && tecnico_asignado &! ""){									if (clave_tecnico &! tecnico_asignado){											frn.message("No puedes modificar el tecnico asignado","Error","Aceptar");						return 0;					}				}										}									fun Seleccionar_operario() {			/* MSS: 12/09/2024 Por el momento se pone comentario para que deje cambiar el operario, TO DO: Parametrizar validacion Celaya no lo valide y Pachuca si				var res = valida_tecnico();								if (res &= 0){					return;				}			*/					var tip_ope = frn.get("tabla_puntos", -1, "tipo_operario") ;				var cmdQuery = "select c1 as clave,c3 as descripcion from keplersc.kdoper where c2='" & tip_ope  & "' and c12='S' ";             frn.dialog("genlistasel","Operarios",cmdQuery,"clave","tabla_puntos","", "clave_operario","N");         }                           fun insert_operario(){						  var clave_ope = frn.get("tabla_puntos", -1, "clave_operario") ;			  var tip_ope = frn.get("tabla_puntos", -1, "tipo_operario") ;         				var cmd = "select c1 from keplersc.kdoper where c1='" & clave_ope & "' and c2='" & tip_ope  & "' and c12='S' ";				var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcontrolpuntos.insert_operario()");							var ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var len_result = nXml(cubo);								if (len_result == 0){					frn.message("La clave no se encuentra en el catalogo de operarios tipo " & tip_ope  & " ,o este ya se encuentra inactivo.","Error","Aceptar");					frn.setX("", "tabla_puntos", -1, "clave_operario");					return;				}			            frn.setX(getXmlAtt(cubo,"r0", "c1") , "tabla_puntos", -1, "clave_operario");          						}                                                     			fun Seleccionar_Estatus() {							var cmdQuery = "select c1 as clave,c2 as descripcion from keplersc.kdstatuspun ";            frn.dialog("genlistasel","Estatus",cmdQuery,"clave","tabla_puntos","", "estatus","N");         }                                               fun insert_Estatus(){						   var estatus = frn.get("tabla_puntos", -1, "estatus") ;			 				var cmd = "select c1 from keplersc.kdstatuspun where c1='" & estatus & "'";				var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcontrolpuntos.insert_Estatus()");							var ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var len_result = nXml(cubo);								if (len_result == 0){					frn.message("La clave no se encuentra en el catalogo de estatus de puntos.","Error","Aceptar");					frn.setX("", "tabla_puntos", -1, "estatus");					return;				}			            frn.setX(getXmlAtt(cubo,"r0", "c1") , "tabla_puntos", -1, "estatus");         			}                                             fun Guardar (){         				var cmd, cubo, ok, mensajeError,xmlRequest ;								xmlRequest = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				setXml(xmlRequest,"sucursal_id", sucursal );				setXml(xmlRequest, "folio_orden", folio_orden);				setXml(xmlRequest,"tipo_orden", tipo_orden);				setXml(xmlRequest,"vin", vin);				setXml(xmlRequest ,"ctd_puntos",frn.N("tabla_puntos") - 1);										frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.control_puntos(' <document> " & getXmlStr(xmlRequest,"EOF:13_10") & " </document> ')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcontrolpuntos.Guardar()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var resultado = getXmlAtt(cubo,"r0","resultado");							if(resultado &= "0"){					mensajeError = getXmlAtt(cubo,"r0","mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								if(resultado &= "1"){					var mensaje = getXmlAtt(cubo,"r0","mensaje");					frn.message(mensaje ,"Atencion","Aceptar");				}							}											fun salir (){							frn.exit();						}			//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------								fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}																																		}	</script></pag>