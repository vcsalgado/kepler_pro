<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Balance de Clientes">	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<grp dim="40,20,7,12" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Balance de Clientes">			<tab/><txt>Sucursal:</txt><sp n="2"/><cmb id="cmb_sucursal" dim="50,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y"/><tab/><br/><br/>			<tab/><txt>Cliente inicial:</txt><sp/>			<edt id="edt_cli_ini" dim="20,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" fnt="Arial,15" 			page="cat_cli_view,s,edt_cli_ini" OnF9="Dialog(3,cat_cli_view,s,edt_cli_ini)"/>			<tab/><txt>Cliente final:</txt><sp/>			<edt id="edt_cli_fin" dim="20,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" fnt="Arial,15" 			page="cat_cli_view,s,edt_cli_fin" OnF9="Dialog(3,cat_cli_view,s,edt_cli_fin)"/><br/><br/>				<tab/><txt>Detalle: </txt>				<cmb id="cmb_detalle" dim="60,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"/><br/><br/>			<tab/><txt>Incluir movimientos saldados: </txt>			<chck id="ch_incluir" dim="3,16" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><br/>						<tab n="9"/><bot id="bot_ejecutar" dim="20,0" brdr="5" text="Ejecutar" OnEnter="Execute()" default="1"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys,suc_usuario ,perfil_usuario,asterisco  ;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;								kdb.connect();				kdb.open("s,kdms,i,kdini,c,kdud");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				asterisco = "*";				Inicializa();							}						fun Inicializa(){//Inicializa los valores en Pantalla				IniCombos();				IniParams();//Inicializa parámtros de impresión entre otros				frn.set("ch_incluir","1");			}									fun IniCombos(){				var cmd, cuboQuery, xmlResQuery, ok, mensajeError, strTmp;				cuboQuery="datDoc";										//Llenar combo sucursales								cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (perfil_usuario &! "ADMINISTRADOR"  && perfil_usuario &! "ADMINISTRATOR" && "Administrador Kepler 8.0"){							cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cxcrepbalancecli.IniCombos()");								ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("cmb_sucursal",getXml(cuboQuery));												//Llenar combos de clientes				kdb.search("datosI,c,1,7,&,c2");				kdb.search("datosF,c,1,8,&,c2");				kdb.exec();							//frn.set("edt_cli_ini",kdb.get("datosI","c2"));				frn.set("edt_cli_ini","C000001");				frn.set("edt_cli_fin",kdb.get("datosF","c2"));									frn.setX("Saldos por cliente","cmb_detalle",0,0);				frn.setX("1","cmb_detalle",0,1);				frn.setX("Saldos por cliente y por factura","cmb_detalle",1,0);				frn.setX("2","cmb_detalle",1,1);				frn.setX("Saldos por cliente y por factura, incluyendo movimientos","cmb_detalle",2,0);				frn.setX("3","cmb_detalle",2,1);				frn.set("cmb_detalle","Saldos por cliente y por factura, incluyendo movimientos");												//frn.lib("libGeneral.kpl","FileSave",kdb.get("datalm"),"D:\Basura\datalm");											}			fun IniParams(){//Inicializa parámetros de impresión, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Página				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}			fun setRepPage() {//Establece los parámetros finales de impresión.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}												fun Execute() {				if (ValidarInfo() == 0){					return;				};				GenerarReporte();								//var val=frn.get("input");				//frn.message("Valor proporcionado:" & val,"Notificación","Aceptar");			}						fun GenerarReporte(){				var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var cuboResultados, cuboDoctos, cuboMovtos;				var xmlRequest,sqlXmlResultados,xmlCurDocto,xmlCurMovto,cmd,ok,mensaje;				var cli_clave, cli_desc, cli_cargos, cli_abonos, cli_saldo;				var factura, documento, expedicion, vencimiento, cargos, abonos, saldo;				var movto, movto_desc, movto_cargo, movto_abono;				var totDoctoCargos, totDoctoAbonos, totDoctoSaldo;				var totMovtoCargos, totMovtoAbonos, totMovtoSaldo;				var totRepCargos, totRepAbonos, totRepSaldo;				var nivel_detalle, incluir_saldados;				var totCli, contCli, totDoctos, contDoctos, totMovtos, contMovtos;				var strTmp;								kdb.kde("KDE");//Configuración del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();				incluir_saldados= frn.get("ch_incluir");				if(incluir_saldados && "1"){					incluir_saldados = "S";				}else{					incluir_saldados = "N";					}				nivel_detalle=frn.get("cmb_detalle",-1,1);								//Obtener saldos totales //				setXml(xmlRequest,"document","sucursal_id",frn.get("cmb_sucursal",-1,1));				setXml(xmlRequest,"document","clienteprov_ini",frn.get("edt_cli_ini",-1,0));				setXml(xmlRequest,"document","clienteprov_fin",frn.get("edt_cli_fin",-1,0));				setXml(xmlRequest,"document","nivel_detalle",nivel_detalle);				setXml(xmlRequest,"document","inc_saldados",incluir_saldados);				setXml(xmlRequest,"document","tipo","cliente");				setXml(xmlRequest,"document","movimiento","usuario",frn.lib("libKepler","UserInfo"));				frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.cxcp_rep_balance_clienteprov('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cxcrepbalancecli.GenerarReporte()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								kdb.readPage("datos","cxcrepbalanceclifto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parámetros finales de impresión.(rep.page(...);)								rep.set("k_empresa",compania);				rep.set("k_sucursal",frn.get("cmb_sucursal",-1,0));				rep.set("k_cli_ini",frn.get("edt_cli_ini",-1,0));				rep.set("k_cli_fin",frn.get("edt_cli_fin",-1,0));				rep.set("k_fecha_imp",fechaImpresion);				rep.set("K_hora_imp",horaImpresion);				rep.exe("encabezado");								totRepCargos=0;				totRepAbonos=0;				totRepSaldo=0;				totCli = nXml(cuboResultados);				for (contCli=0; contCli<totCli;contCli++){					cli_clave = getXmlAtt(cuboResultados,"r"&contCli,"clienteprov_clave");					cli_desc = getXmlAtt(cuboResultados,"r"&contCli,"clienteprov_desc");					cli_cargos = getXmlAtt(cuboResultados,"r"&contCli,"cargos");					cli_abonos = getXmlAtt(cuboResultados,"r"&contCli,"abonos");					cli_saldo = getXmlAtt(cuboResultados,"r"&contCli,"saldo");					totRepCargos=totRepCargos+cli_cargos ;					totRepAbonos=totRepAbonos+cli_abonos ;					rep.set("k_cli_clave",cli_clave);					rep.set("k_cli_desc",cli_desc);					rep.set("k_cargos_cli",cli_cargos);					rep.set("k_abonos_cli",cli_abonos);					rep.set("k_saldo_cli",cli_saldo);										rep.exe("seccion_cliente_resumen");					if(nivel_detalle &= "2" || nivel_detalle &= "3"){						rep.exe("seccion_factura_line_top");						rstXml(cuboDoctos);						strTmp = getXmlAtt(cuboResultados,"r"&contCli,"doctos");						strTmp = delScpScn(strTmp);						setXmlStr(cuboDoctos,strTmp);						frn.setX(cuboDoctos);						if (nXml(cuboDoctos) > 0) {							totDoctoCargos=0;							totDoctoAbonos=0;							totDoctoSaldo=0;							totDoctos = nXml(cuboDoctos);							for (contDoctos=0; contDoctos<totDoctos; contDoctos++){								rstXml(xmlCurDocto);								xmlCurDocto = getXmlX(cuboDoctos,3,contDoctos);																							factura = getXml(xmlCurDocto,"factura");								documento= getXml(xmlCurDocto,"documento");								expedicion= getXml(xmlCurDocto,"expedicion");								vencimiento= getXml(xmlCurDocto,"vencimiento");								cargos= getXml(xmlCurDocto,"cargos");								abonos = getXml(xmlCurDocto,"abonos");								saldo = getXml(xmlCurDocto,"saldo");								totDoctoCargos=totDoctoCargos+cargos;								totDoctoAbonos=totDoctoAbonos+abonos;								rep.set("k_factura",factura);								rep.set("k_documento",documento);								rep.set("k_expedicion",expedicion);								rep.set("k_vencimiento",vencimiento);								rep.set("k_cargos_docto",cargos);								rep.set("k_abonos_docto",abonos);								rep.set("k_saldo_docto",saldo);								rep.exe("seccion_factura_resumen");																if(nivel_detalle &= "3"){									rep.exe("seccion_movto_line_top");									rstXml(cuboMovtos);																cuboMovtos = getXml(xmlCurDocto,"movtos");																			if (nXml(cuboMovtos) > 0) {										totMovtoCargos=0;										totMovtoAbonos=0;										totMovtoSaldo=0;										totMovtos = nXml(cuboMovtos);										for (contMovtos=0; contMovtos<totMovtos; contMovtos++){											rstXml(xmlCurMovto);											xmlCurMovto = getXmlX(cuboMovtos,3,contMovtos);											movto= getXml(xmlCurMovto,"movto");											movto_desc= getXml(xmlCurMovto,"movto_desc");											movto_cargo= getXml(xmlCurMovto,"movto_cargo");											movto_abono= getXml(xmlCurMovto,"movto_abono");											totMovtoCargos=totMovtoCargos + movto_cargo;											totMovtoAbonos=totMovtoAbonos + movto_abono;											rep.set("k_movto",movto);											rep.set("k_movto_desc",movto_desc);											rep.set("k_movto_cargo",movto_cargo);											rep.set("k_movto_abono",movto_abono);											rep.exe("seccion_movto_det");										}										totMovtoSaldo = totMovtoCargos- totMovtoAbonos;										rep.set("k_factura_movtos",factura);										rep.set("k_total_cargos_factura",totMovtoCargos);										rep.set("k_total_abonos_factura",totMovtoAbonos);										rep.set("k_total_saldo_factura",totMovtoSaldo);										rep.exe("seccion_factura_total");									}								}																}							totDoctoSaldo = totDoctoCargos - totDoctoAbonos;							rep.set("k_doctos_cli_clave",cli_clave);							rep.set("k_total_cargos_cli",totDoctoCargos);							rep.set("k_total_abonos_cli",totDoctoAbonos);							rep.set("k_total_saldo_cli",totDoctoSaldo);							rep.exe("seccion_cliente_total");																				}					}				}				totRepSaldo = totRepCargos - totRepAbonos;				rep.set("k_total_cargos",totRepCargos);				rep.set("k_total_abonos",totRepAbonos);				rep.set("k_total_saldo",totRepSaldo);				rep.exe("seccion_total_reporte");				rep.win();			}						fun ValidarInfo(){				return 1;			}											}	</script></pag>