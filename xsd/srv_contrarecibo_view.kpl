<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="CR-VIEW">
	<grp dim="1,-1,10,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">
	<br/>
	<br/>
	<sp n="1"/> <!--<tab/>--> <txt fnt=",22" clr="0,0,0">Contrarecibo - Vista</txt><br/>
	<sp n="1"/> <!--<tab/>--> <hLine clr="0,0,0"/>
	<br/> <br/> 
	<sp n="1"/> <!--<tab/>-->
		<grp dim="44,11,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,16" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,15" tit="Datos Generales">
			<sp n="1"/> <txt>Sucursal :</txt> <sp n="2"/> <inp id="k_sucn" clr="64,64,64" dim="40,1" brdr="0,1" fnt=",15" available="N"/>
			<br/>
			<sp n="1"/> <txt>Tipo :</txt> <sp n="5"/> <inp id="k_tipon" clr="64,64,64" dim="40,1" brdr="0,1" fnt=",15" available="N"/>
			<br/>
			<sp n="1"/> <txt>Proveedor :</txt> <sp n="1"/> <inp id="k_clave" clr="64,64,64"  dim="20,1" brdr="0,1" fnt=",15" available="N"/>
			<sp n="3"/> <txt>R.F.C. :</txt> <sp n="1"/> <inp id="k_rfc" clr="64,64,64" dim="20,1" brdr="0,1" fnt=",15" available="N"/>
			<br/>	
			<sp n="1"/> <txt>Nombre :</txt> <sp n="2"/> <inp id="k_nombreprov" clr="64,64,64" dim="50,1" brdr="0,1" fnt=",15" available="N"/>
			<br/>			
			
			<br/>
			<sp n="1"/>
			<txt id="text_chk" fnt="Arial,15" clr="0,58,112" bclr="255,255,255" visible="Y">Documentos : </txt>
			<sp n="3"/>
			<txt id="text_chk_1" fnt="Arial,15" clr="0,58,112" bclr="255,255,255" visible="Y">Activos </txt>		
			<chck id="chk_pc_1" clr="64,64,64"  dim="3,21" bclr="255,255,255" brdr="2,0" YN="10" clrBrdr="255,255,255" OnChange="Change_Mode_1()" available="Y" visible="Y"/>
			<!-- <br/> -->
			<sp n="5"/>
			<txt id="text_chk_2" fnt="Arial,15" clr="0,58,112" bclr="255,255,255" visible="Y">Log </txt>		
			<chck id="chk_pc_2" clr="64,64,64"  dim="3,21" bclr="255,255,255" brdr="2,0" YN="10" clrBrdr="255,255,255" OnChange="Change_Mode_2()" available="Y" visible="Y"/>
			
		</grp>
		<sp/>
		<grp dim="44,12,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,16" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,15" tit="Datos Documento">
			<sp n="1"/> <txt>Docto. :</txt>  <sp n="2"/> <inp id="k_docto" clr="64,64,64"  dim="30,1" brdr="0,1" fnt=",15" available="N"/>
			<br/>
			<sp n="1"/> <txt>Folio :</txt>  <sp n="3"/> <inp id="k_folio" clr="64,64,64"  dim="30,1" brdr="0,1" fnt=",15" available="N" visible="Y"/>
			<br/>
			<sp n="1"/> <txt>Saldo :</txt> <sp n="2"/> <inp id="k_saldo" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",15" available="N"/>
			<br/>
			<sp n="1"/> <txt>Estatus :</txt> <sp n="1"/> <inp id="statusdoc" clr="64,64,64"  dim="52,1" brdr="0,1" fnt=",15b" available="N"/>
			<br/>
			<sp n="1"/> <txt>Referencia :</txt>
			<br/>  
			<sp n="1"/> <inp id="k_refer" clr="64,64,64" dim="60,1" brdr="0,1" fnt=",15" available="N" visible="Y"/>
			<br/>
		</grp>
		<br/>
		<br/>
		<sp n="1"/> <!--<tab/>-->
		
		<grp dim="89,23,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="236,240,243" fntBrdr="Arial,16" hSpace="4" fnt="Arial,15" tit="Relacion de Documentos">
		<!-- <tab/> -->
		<sp n="1"/>
		<!-- dim="120,8" -->
		<tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,14" 
				dim="125,15"  hk="z" Reorder="N" modify="N" insdel="N" available="Y">
			<col id="c_doc" name="Docto"  type="string" OnF9="" visible="Y" modify="N" available="N" np="30"/>
			<col id="c_fol" name="Folio"  type="string" OnF9="" visible="Y" modify="N" available="N" np="30"/>
			<col id="c_fch" name="Fecha Oper."  type="string" nc="16" OnF9="" visible="Y" modify="N" available="N" np="60"/>
			<col id="c_tot" name="Monto"  type="number" nd="2" nc="15" modify="N" available="N" np="50"/>
			<col id="c_st" name="Estatus"  type="string" OnF9="" visible="Y" modify="N" available="N" np="30"/>
			<col id="c_ope" name="Operacion"  type="string" OnF9="" visible="Y" modify="N" available="N" np="70"/>
			<col id="c_ref" name="Referencia"  type="string" OnF9="" visible="Y" modify="N" available="N" np="70"/>
			<col id="c_refext" name="Ref. Compl."  type="string" OnF9="" visible="Y" modify="N" available="N" np="70"/>
			<col id="c_fch_apl" name="Fecha Compl."  type="string" nc="16" OnF9="" visible="Y" modify="N" available="N" np="50"/>
		</tbl>
		<br/>
		<sp n="1"/>
		
		</grp>
	
						
	</grp>
	
	<script>
		InstallDriver("KDB75");
		
		class Main {
			var frn,kdb, sys, rep, frP;
			var usuario, rol_usuario, suc_usuario, anio_contable;
			// Variables de control
			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal, tabla, estatus_doc;
			var fileSavePath;
			// Variables validacion factura
			var str_uuid, fecha_uuid, rfc_uuid, total_uuid;					
			// Variables de parametros
         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope/*, paramProd*/;
         // Params Added by JMM 20240808
         var p_suc, p_tipo, p_prov, p_rfc, p_nomb, p_fol, p_doc, p_st, p_ref, p_sucn;
         // Params Added by JMM 20240809
         var p_status;
			var editable; //Se controla si la poliza se puede editar, cancelar o dar de baja	
			// Porcentajes kdmm
			var prc_iva;
			// Cont
			var presupuesto , saldo, fecha_baja, cargos_factura, abonos_factura, cargos_iva_factura, abonos_iva_factura;
			var uen;
			
		fun Main() {
			frn=new FRNT;
			kdb=new KDB;
			rep=new REP;
			frP=new FRNTP;
			sys=new SYS;
			kdb.connect();
			kdb.kde("KDE");
			kdb.exec();
			anio_contable = kdb.get("KDE","14");
			usuario = frn.config("user","name");
			rol_usuario = frn.config("user","role");
			suc_usuario = frn.lib("libKepler","UserInfo(1)");
			fileSavePath = "C:\Basura";
			Inicializa();
			ConfiguraControlesOpcion();				
		}
			
		fun Inicializa(){ //Inicializa los valores en Pantalla
			// Revisa parametros recibidos
			if( frn.nParam() == 14 /*7*/ ){ //Se han mandado parametros de otro KPL 
			
				tip_ope = "C";
				
				p_status = "";
			
            gen_doc = trim(frn.param(0)); 
            nat_doc = trim(frn.param(1)); 
            gpo_doc = trim(frn.param(2));
            tip_doc = trim(frn.param(3));
            
            p_sucn = trim(frn.param(13));
            
            p_suc = trim(frn.param(4));
            p_tipo = trim(frn.param(5));
            p_prov = trim(frn.param(6));
            p_rfc = trim(frn.param(7));
            p_nomb = trim(frn.param(8));
            p_doc = trim(frn.param(9));
            p_fol = trim(frn.param(10));
            p_st = trim(frn.param(11));
            p_ref = trim(frn.param(12));
             
            frn.set("k_sucn", p_suc );
            frn.set("k_tipon", p_tipo );
            frn.set("k_clave", p_prov );
            frn.set("k_rfc", p_rfc );
            frn.set("k_nombreprov", p_nomb );
            frn.set("k_docto", p_doc );
            frn.set("k_folio", p_fol );
            frn.set("statusdoc", p_st );
            frn.set("k_refer", p_ref );
            
            frn.set("k_saldo", Get_Saldo() );
                    
			} else {
				frn.message("Operacion no valida ...", "Mensaje","&Aceptar");
				/*
				frn.open("redirect",2);
				return;
				*/
			}
         
         tip_ope = "C";
         
         /*
			if(tip_ope &= "A"){ //Alta
				frn.set("operacion","ALTA");
			} else {
				if(tip_ope &= "B"){ //Baja
					frn.set("operacion","BAJA");
				} else {*/
					if(tip_ope &= "C"){ //Consulta
						frn.set("operacion","CONSULTA");
					} else {
						frn.message("Operacion no valida ...", "Mensaje","&Aceptar");
						frn.open("index",4);
						return;		
					}
			/*	
				}
			}
			*/
			
			// Condition Added by JMM 20240809
			if ( strlen(p_status) == 0 ) {
				frn.set("chk_pc_1",1);
				MostrarDatosGrd(1);
			} else {
				frn.set("chk_pc_2",1);
				MostrarDatosGrd(2);
			}
			
		} // End : Func Inicializa()
		
		
		// Fun Added by JMM 20240808 
		fun LimpiaDatosDoc {
				// Limpia todos los objetos asociados a los detalles incluido el k_mov
				frn.set("k_mov", "");
		} /* END Func LimpiaDatosDoc() */
		
		
		// Fun Added by JMM 20240808 
		fun MostrarDatosGrd(imodo) {
		   
				var xmlGrd, strTmp, partdoc;
								
				sucursal_id = p_sucn;
				
				partdoc = gen_doc & nat_doc & gpo_doc & tip_doc;
				
				//frn.message("Var { partdoc } ... " & partdoc,"Info","Aceptar");
		
				LimpiaDatosDoc();
								
				if ( imodo == 1 ) {
									
					// Condition Added by JMM 20240809 
					if ( p_status &= "ERR" || p_status &= "C" ) {
						cmdQuery = "";
					} else {
					
						// Condition Added by JMM 20240824 ... Commented by JMM 20240905
						
						//if ( tip_doc &= "90" ) {
						//
						//	cmdQuery = "select (w.c2||w.c3||w.c4||w.c5) as c_doc, w.c6 as c_fol, e.c11 c_fch, e.c13 c_tot, w.c43 c_st, m.c5 c_ope, e.c3 c_ref " &
						//	", case when length(coalesce(e.doc_refer_compl,'')) > 0 then e.doc_refer_compl else case when (w.c2||w.c3||w.c4) = 'XD31' and t.c5 <> '90' then 'DESPUES_DE_CONTR_REC_COMPROBACION' else '' end end c_refext/*refer_ext*/ " &
						//	"/*, (left(w.c9::text,10) || ' ' || w.c69) fech_hr_doc*/ from keplersc.kdm1 t " &
						//	"inner join keplersc.kduxe e on e.c2 = t.c10 and e.c3 = t.c11 and e.c13 > 0 " &
						//	"inner join keplersc.kdm1 w on w.c1 = e.c1 and w.c2 = e.c5 and w.c3 = e.c6 and w.c4 = e.c7 and w.c5 = e.c8 and w.c6 = e.c9 " & 
						//	"inner join keplersc.kdmm m on w.c2 = m.c1 and w.c3 = m.c2 and w.c4 = m.c3 and w.c5 = m.c4 " & 
						//	"inner join keplersc.kdusraccess u1 on u1.c4 = e.c1 and u1.c5 = e.c5 and u1.c6 = e.c6 and u1.c7 = e.c7 and u1.c8 = e.c8 and u1.c9 = e.c9 and u1.c11 like '%" & p_fol & "%' " &  
						//	"left join keplersc.kdm5 p on p.c1 = e.c1 and p.c2 = e.c5 and p.c3 = e.c6 and p.c4 = e.c7 and p.c5 = e.c8 and p.c6 = e.c9 and p.c14 = e.c3 " & 
						//	"where t.c1 = '" & sucursal_id & "'" & " and (t.c2||t.c3||t.c4||t.c5) = '" & partdoc & "'" & " and t.c6 = '" & p_fol & "' " & 
						//	"and upper(w.c43) <> 'C' and upper(coalesce(p.st_x_comprobar,'')) <> 'N' " & 
						//	"order by e.c11, (left(w.c9::text,10) || ' ' || w.c69)" ;
						//
						//} else { 
						
							cmdQuery = "select (w.c2||w.c3||w.c4||w.c5) as c_doc, w.c6 as c_fol, e.c11 c_fch/*fecha_registro*/, e.c13 c_tot/*total*/, w.c43 c_st/*status*/, m.c5 c_ope/*oper*/, e.c3 c_ref/*refer*/ " &
							", case when length(coalesce(e.doc_refer_compl,'')) > 0 then e.doc_refer_compl else case when (w.c2||w.c3||w.c4) = 'XD31' and t.c5 <> '90' then 'DESPUES_DE_CONTR_REC_COMPROBACION' else '' end end c_refext/*refer_ext*/ " &
							"/*, (left(w.c9::text,10) || ' ' || w.c69) fech_hr_doc*/ from keplersc.kdm1 t " &
							"inner join keplersc.kduxe e on e.c2 = t.c10 and e.c3 = t.c11 and e.c13 > 0 " &
							"inner join keplersc.kdm1 w on w.c1 = e.c1 and w.c2 = e.c5 and w.c3 = e.c6 and w.c4 = e.c7 and w.c5 = e.c8 and w.c6 = e.c9 " & 
							"inner join keplersc.kdmm m on w.c1 = m.col_sucursal and w.c2 = m.c1 and w.c3 = m.c2 and w.c4 = m.c3 and w.c5 = m.c4 " & 
							"left join keplersc.kdm5 p on p.c1 = e.c1 and p.c2 = e.c5 and p.c3 = e.c6 and p.c4 = e.c7 and p.c5 = e.c8 and p.c6 = e.c9 and p.c14 = e.c3 " & 
							"where t.c1 = '" & sucursal_id & "'" & " and (t.c2||t.c3||t.c4||t.c5) = '" & partdoc & "'" & " and t.c6 = '" & p_fol & "' " & 
							"and upper(w.c43) <> 'C' and upper(coalesce(p.st_x_comprobar,'')) <> 'N' " & 
							"order by e.c11, (left(w.c9::text,10) || ' ' || w.c69)" ;
						
						//}
							
					}	
	
				} else {
				
					cmdQuery = "select /*r.**/ r.doc as c_doc, r.fol as c_fol, r.fecha_registro as c_fch, r.total as c_tot, r.status as c_st, r.oper as c_ope, r.refer as c_ref, r.refer_ext as c_refext, r.fech_hr_doc as c_fch_apl from ( " & 
						"select (u.c5||u.c6||u.c7||u.c8) as doc, u.c9 as fol, u.fecha_registro, w.c16 total, w.c43 status, u.c10 oper, u.c11 refer, '' refer_ext , (left(u.c2::text,10) || ' ' || u.c3) fech_hr_doc " & 
						"from keplersc.kdusraccess u inner join keplersc.kdm1 w on u.c4 = w.c1 and u.c5 = w.c2 and u.c6 = w.c3 and u.c7 = w.c4 and u.c8 = w.c5 and u.c9 = w.c6 " & 
						"where u.c4 = '" & sucursal_id & "'" & " and (u.c5||u.c6||u.c7||u.c8/*||u.c9*/) = '" & partdoc & "'" & " and u.c9 = '" & p_fol & "' " &
						"union all " &
						"select (w5.c2||w5.c3||w5.c4||w5.c5) as doc, w5.c6 as fol, w5.fecha_registro, case when upper(w5.st_x_comprobar) = 'N' then 0 else w5.c12 end total " & 
						", case when upper(w5.st_x_comprobar) = 'N' and w5.c5 = 11 then 'N' else w.c43 end status, m.c5 oper, w5.c14 refer " & 
						", /*case when length(coalesce(w5.doc_refer_compl,'')) > 0 then*/ w5.doc_refer_compl /*else w5.c14 end*/ refer_ext " & 
						", (left(w.c9::text,10) || ' ' || w.c69) fech_hr_doc from keplersc.kdm5 w5 " & 
						"inner join keplersc.kdm1 w on w5.c1 = w.c1 and w5.c2 = w.c2 and w5.c3 = w.c3 and w5.c4 = w.c4 and w5.c5 = w.c5 and w5.c6 = w.c6 " & 
						"inner join keplersc.kdmm m on w5.c1 = m.col_sucursal and w5.c2 = m.c1 and w5.c3 = m.c2 and w5.c4 = m.c3 and w5.c5 = m.c4 " & 
						"where w5.c1 = '" & sucursal_id & "'" & " and w5.c2 = 'X' and w5.c3 = 'D' and w5.c4 = 31 and w5.c5 in (1, 11) " &   
						"and ( w5.doc_refer_compl like ('%' || '[D] ' || '" & partdoc & "' || '" & p_fol & "' || '%') ) " & 
						") as r " & 
						"order by r.fecha_registro, r.fech_hr_doc ";
					
					//frn.lib("libGeneral.kpl","FileSave",cmdQuery, fileSavePath & "\query_mostrardatosgrid_asigusd");

				}
				
				rstXml(cuboQuery);
				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comaltasigcrud.mostrardatosgrid()");
				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosgrid");
				ok=getXmlAtt(cuboQuery,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboQuery,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;	
				}
				if(nXml(cuboQuery) == 0){
					frn.message("Sin Registros por mostrar ...","Info","Aceptar");
					//frn.setPos("k_sucn");
					return;	
				}	
				//frn.set(cuboQuery);
				
				// Uncommented by JMM 20240809
				frn.setX(cuboQuery,"k_mov");  // Llena Grid Directamente, se usa en Grid de Columnas Fijas ...
			
			
				// Start : Commented by JMM 20240809
				/*
				
				// / * 
				// Codigo Original ... Presenta Problemas con Caracteres de Escape 
				rstXml(xmlGrd);
				xmlGrd=frn.lib("libGeneral.kpl","CreaXmlDesdeTagRow",cuboQuery,"r","k_mov");
				frn.lib("libGeneral.kpl","FileSave",xmlGrd, fileSavePath & "\mostrardatosgrid_parsed");
				frn.setX(xmlGrd);
				// * /

				rstXml(xmlGrd);
				//frn.lib("libGeneral.kpl","FileSave",xmlGrd, fileSavePath & "\mostrardatosgrid_antes_parsed");
				xmlGrd=frn.lib("libGeneral.kpl","CreaXmlDesdeTagRow",cuboQuery,"r","k_mov");
				//frn.lib("libGeneral.kpl","FileSave",xmlGrd, fileSavePath & "\mostrardatosgrid_despues_parsed");
				
				//
				strTmp = getXmlStr(xmlGrd);
				//frn.lib("libGeneral.kpl","FileSave",strTmp, fileSavePath & "\strTmp_Ini");	
							
				strTmp=delScpScn(strTmp);
				strTmp=delScpScn(strTmp);
				//frn.lib("libGeneral.kpl","FileSave",strTmp, fileSavePath & "\strTmp_Fin");	
							
				rstXml(xmlGrd);
				setXmlStr(xmlGrd,strTmp);
				//frn.lib("libGeneral.kpl","FileSave",xmlGrd, fileSavePath & "\mostrardatosgrid_parsed_cleaned_CRView");
				
				frn.setX(xmlGrd);
				
				*/ 
				// End : Commented by JMM 20240809
				
				
		} /* END Func MostrarDatosGrd() */
		
		
			
		// Fun Added by JMM 20240808	
		fun Get_Saldo(){
			var xmlProd, partdoc;				
			
			partdoc = gen_doc & nat_doc & gpo_doc & tip_doc;
			
			// Commented by JMM 20240809
			/*
			cmdQuery = "select g.c7 - g.c6 saldo from keplersc.kduxe e " & 
				"inner join keplersc.kduxg g on e.c1 = g.c1 and e.c2 = g.c3 and e.c3 = g.c4 " & 
				"where e.c1 = '" & p_sucn & "' and (e.c5||e.c6||e.c7||e.c8) = '" & partdoc & "' and e.c9 = '" & p_fol & "' and e.c13 > 0 ";
			*/	
			
			// Adapted by JMM 20240809	
			cmdQuery = "select (w.c2||w.c3||w.c4||w.c5||w.c6) doc, case when w.c16 = 0 or upper(w.c43) = 'C' then 0 else (g.c7 - g.c6) end saldo /*g.**/ /*w.**/ " & 
				", upper(w.c43) status from keplersc.kdm1 w " & 
				"inner join keplersc.kduxg g on w.c1 = g.c1 and w.c10 = g.c3 and w.c11 = g.c4 " & 
				"where w.c1 = '" & p_sucn & "' and (w.c2||w.c3||w.c4||w.c5) = '" & partdoc & "' and w.c6 /*=*/ in ('" & p_fol & "'/*, 'VXX0014012'*/) /*and w.c16 > 0*/ ";
										
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscarProvPago()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				p_status = "ERR"; //Added by JMM 20240809
				//frn.set("k_nombreprov_pago","ERROR EN BUSQUEDA ...");
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return "Error BD ...";	
			}
			if(nXml(cuboQuery) == 0){
				/*
				frn.set("k_nombreprov_pago","NO EXISTE ...");
				frn.setPos("k_clave_pago");
				frn.message("El Proveedor de Pago No existe ...","Error","Aceptar");
				*/
				p_status = "ERR"; //Added by JMM 20240809
				return "DOC No Encontrado ...";	
			} 
			else	{		
				p_status = getXmlAtt(cuboQuery,"r0", "status"); //Added by JMM 20240809
				//frn.set("k_nombreprov_pago", getXmlAtt(cuboQuery,"r0", "k_nombreprov_pagos") );
				return getXmlAtt(cuboQuery,"r0", "saldo");
			}
			
		} // End : Fun BuscarProvPago()
			
			
		// Added by JMM, 20240809 
		fun Change_Mode_1() {

			if ( frn.get("chk_pc_1") == 1 ) { //frn.message("Check Encendido ...","Info !!!","Aceptar");
				frn.set("chk_pc_2",0);
				MostrarDatosGrd(1);		
			} else { //frn.message("Check Apagado ...","Info !!!","Aceptar");
				frn.set("chk_pc_2",1);
				MostrarDatosGrd(2);
			}
			return;
				
		}	// End : Fun Change_Mode_1()
			

		// Added by JMM, 20240809 
		fun Change_Mode_2() {

			if ( frn.get("chk_pc_2") == 1 ) { //frn.message("Check Encendido ...","Info !!!","Aceptar");
				frn.set("chk_pc_1",0);
				MostrarDatosGrd(2);		
			} else { //frn.message("Check Apagado ...","Info !!!","Aceptar");
				frn.set("chk_pc_1",1);
				MostrarDatosGrd(1);
			}
			return;
				
		}	// End : Fun Change_Mode_1()

			
		// Armado del Docto Referencia
		fun ArmarRefDocto {
			var cadena = frn.get("k_tipon", -1, 5);
			var fol = frn.get("k_folio");
			if (tip_ope &! "A" && fol &! ""){
				cadena = strSplit(cadena,"-",0) & "-" & fol;
			}		
			frn.set("k_docto", cadena);
		}
			
		fun PadLeft(pText,pRelleno,pCaracterRelleno) {
			var Resultado;
			var pos_ini = pText;
			var nReg = strlen(pText);
			for (var cont = nReg; cont < pRelleno; cont++) {
				Resultado = pCaracterRelleno & Resultado;
			}
			Resultado = Resultado & pText;                
			return Resultado;
		}
		
	
		// imodo Added by JMM, 20240205
		fun LimpiaEncabezado(imodo) {
			if ( imodo != 1 ) { frn.set("k_folio", ""); } // Adapted by JMM, 20240205 
			frn.set("k_docto", "");
			frn.set("k_fecha", "");
			frn.set("k_hora", "");
			//LimpiaDatosProv();
			frn.set("k_clave", "");
		}
		
		fun borrar_datos(){
			frn.rst("k_mov");
			frn.rst("k_refer");
			frn.rst("k_coment");
			frn.set("k_subtotal", 0);
			frn.set("k_iva", 0);
			frn.set("k_monto", 0);
		}
		

		//-----------------------------------------------
		
		fun ConfiguraControlesOff() {

			frn.setAtt("k_sucn", "available", "N"); 
			frn.setAtt("k_tipon", "available", "N"); 
			frn.setAtt("k_clave", "available", "N");
			frn.setAtt("k_rfc", "available", "N");
			frn.setAtt("k_nombreprov", "available", "N");
			
			frn.setAtt("k_docto", "available", "N");
			frn.setAtt("k_folio", "available", "N");
			frn.setAtt("statusdoc", "available", "N");
			frn.setAtt("k_refer", "available", "N");
			
			frn.setAtt("k_mov", "modify", "N");
			frn.setAtt("k_mov", "available", "N");
							
		}
		
		
		fun ConfiguraControlesOpcion() {
			
			ConfiguraControlesOff();

			if(tip_ope &= "C"){ //Consulta
				frn.setAtt("k_mov", "available", "Y");	
				frn.setPos("k_mov",-1,"c_doc");				
			} 

		}
		
		fun MostrarDatos(nFolio) {
		
			var cmd,xmlRequest,xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError,   ;
			
			sucursal_id = frn.get("k_sucn",-1,1);
		
			cmd= " select c10 as k_clave, c9 as k_fecha,c11 as k_refer ,c69 as k_hora , c24 as k_coment, c43 as estatus_doc , c197 as fecha_baja " ;
			cmd = cmd & " , c14 as k_iva, c16 as k_monto, (c16-c14) as k_subtotal "; /*Added by JMM 20240606*/			
			cmd = cmd & " from keplersc.kdm1 where c1='" & sucursal_id  & "' and c2='" & gen_doc  &"' and c3='" & nat_doc & "' and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";
	
			cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cheque_crud.MostrarDatos()");
			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");
				
			ok=getXmlAtt(cuboResultados,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboResultados,"native3");
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}

			var xml_kdm1  = getXml(cuboResultados,"r0" );

			//frn.setX(cuboResultados ); TODO, checar setX
			// Moved down by JMM, 20240202
			frn.set("k_clave",getXmlAtt(xml_kdm1,"k_clave") );
			/*
			frn.set("k_fecha",getXmlAtt(xml_kdm1,"k_fecha") );
			frn.set("k_hora",getXmlAtt(xml_kdm1,"k_hora") );
			frn.set("k_coment",getXmlAtt(xml_kdm1,"k_coment") );
			*/
			
			//BuscarProveedor();
			
			// Moved here by JMM, 20240202
			//frn.set("k_clave",getXmlAtt(xml_kdm1,"k_clave") );
			frn.set("k_fecha",getXmlAtt(xml_kdm1,"k_fecha") );
			frn.set("k_hora",getXmlAtt(xml_kdm1,"k_hora") );
			frn.set("k_coment",getXmlAtt(xml_kdm1,"k_coment") );
			
			frn.set("k_refer",getXmlAtt(xml_kdm1  ,"k_refer") );		
				
			fecha_baja = getXmlAtt(xml_kdm1  ,"fecha_baja");
			
			estatus_doc = getXmlAtt(xml_kdm1  ,"estatus_doc");	
			
			if (estatus_doc &= "C"){	// C=Cancelado
				frn.message("El Cheque se encuentra cancelado","Error","Aceptar");
				frn.set("statusdoc", "CANCELADO");
			}else{
				frn.set("statusdoc", "");
			}

			rstXml(cmd);
			
			// Commented by JMM, 20240205
			/*
			cmd = "select c14 as k_factura,c12 as k_monto_factura,c13 as k_iva_factura from keplersc.kdm5 where c1='" & sucursal_id & "' and c2='" & gen_doc &"' and c3='" & nat_doc & "'";
			cmd = cmd & " and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";
			*/
			
			//Updated with ORs TBLs.doc_refer_compl in links selects , 20240409
			cmd = "select " &  
				"coalesce(w1.uuid_serie,'') c_serie, coalesce(w1.uuid_folio, '') c_folio, " &
				"abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) saldo, to_date( coalesce(g.c12::text , current_date::text) ,'yyy-mm-dd') vencimiento, " &
				"/*coalesce(w1.c11,w5.c14) UPD by JMM 20240724*/ coalesce(w5.c14, coalesce(w1.c11,'') ) k_factura, " &
				"w5.c12 k_monto_factura, w5.c13 k_iva_factura, '' k_factura_rfc, w5.cve_prov_oper k_prov " &
				"from keplersc.kdm5 w5 " &
				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kduxg g on g.c1 = w5.c1 and g.c2 = w5.c2 and (g.c4 = w5.c14 or g.doc_refer_compl = w5.c14) " & 
				" and w5.cve_prov_oper = g.c3 /*= w1.c10 upd for addapting 20240624*/ /*Added by JMM 20240606*/ and w5.cve_prov_pago = g.cve_prov_pago /*Added by JMM 20240624*/ " &  
				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kduxe e on e.c1 = g.c1 and e.c2 = g.c3 and e.c3 = g.c4 and e.c5 = g.c2 and e.c6 = 'A' and e.c11 = g.c11 " & 
				"/*Added by JMM 20240724*/ and ( e.c13 > 0 /* or monto_rollback = 0 */ )" & 
				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kdm1 w1 on w1.c1 = w5.c1 and w1.c2 = w5.c2 and w1.c3 = 'A' and w1.c4 = e.c7 and w1.c5 = e.c8  and (w1.c11 = w5.c14 or w1.doc_refer_compl = w5.c14) /*and w1.c43 <> 'C'*//*Added 20240515 Commented 20240624*/ " &
				" and w1.c10 = w5.cve_prov_oper /*Added by JMM 20240606*/ and w1.cve_prov_pago = w5.cve_prov_pago /*Added by JMM 20240624*/ " & 
				" /*Added by JMM 20240724*/ and w1.c6 = e.c9 " & 
				"where w5.c1='" & sucursal_id & "' and w5.c2='" & gen_doc &"' and w5.c3='" & nat_doc & "' and w5.c4=" & gpo_doc & " " & 
				"and w5.c5=" & tip_doc & " and w5.c6='" & nFolio & "' ";
			
			frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\Query_MostrarDatos");
			
			cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cheque_crud.MostrarDatos()");
			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_MostrarDatos");
				
			ok=getXmlAtt(cuboResultados,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboResultados,"native3");
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			
			frn.setX(cuboResultados, "k_mov");

			//Commented by JMM 20240606 
			//CalcTotal();
			
			// Added by JMM 20240606 
			// /*
			frn.set("k_subtotal",getXmlAtt(xml_kdm1,"k_subtotal") );
			frn.set("k_iva",getXmlAtt(xml_kdm1,"k_iva") );
			frn.set("k_monto",getXmlAtt(xml_kdm1,"k_monto") );
			// */
							
		} //End MostrarDatos()
		
		
		
		//-----------------REPORTE-----------
		
		
		// ----------------------------------------------	 START : NEW FUNCTIONS IMPLEMENTED BY JMM 20240606  --------------------------------------------
		
		// ZONA	CODIGO REPORTE(S) 
			
			fun IniParams(){//Inicializa parámetros de impresión. Pueden ser cambiados por el usuario final mediante menú: Archivo -> Configurar Página
				frn.set("param_paper","letter");	//Tamaño de papel predefinido:	"paper=letter|legal|size"
				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tamaño de papel personalizado	"size=21.59,27.94cm"
				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//Márgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"
				frn.set("param_Fx","1.0");	//Escala de impresión (1=100 por ciento)	"F=1,1"
				frn.set("param_landscape","L"/*Y*/);	//Orientación	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"
				frn.set("param_emp","L");	//Posición de "Razón social"(izq,der,cen)	@emp=L|R|C"
			}
			
			fun setRepPage() {//Establece los parámetros finales de impresión.
				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";
				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";
				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");
				var lndsp="landscape=" & frn.get("param_landscape");
				var emp="@emp=" & frn.get("param_emp");
				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);
			}
			
			fun Ejecuta_Reporte() {
			
				// Commented 20221208 
				//IniParams(); //Inicializa parámtros de impresión entre otros
			
				Reporte();
			
			} /* END Func Ejecuta_Reporte() */
			
			fun Reporte() {
			
				// Our Vars
				var compania, titrep, titrepaux;
				//var contProd, contDet, tmpStr ,xmlDet, xmlCurDocto;
				var nFolio;
				//var p_fecha, var_fecha;
				//var p_subtotal, p_utilidad, p_perce, p_costo, p_total, p_iva;
				//var gt_subtotal, gt_utilidad, gt_perce, gt_costo, gt_total, gt_iva;
				
				if( strlen(trim(frn.get("k_folio")))==0 || strlen(trim(frn.get("k_fecha")))==0 ){ 
					frn.message("Es necesario seleccionar un documento valido a consultar ...","Error","&Aceptar");
					frn.setPos("k_folio");
					return;
				}
				
				//Obtener datos generales
				kdb.kde("KDE");//Configuracion del servidor
				kdb.exec();
				compania = kdb.get("KDE","1");		
			
				// Se define el formato a usar y se liga a la variable del reporte "rep"	// Se define el formato a usar y se liga a la variable del reporte "rep"
				rep.rst(); // 20121208
				IniParams(); // 20121208
				kdb.readPage("datFto","srv_cheque_doc_fto.kpl");
				kdb.exec();
				rep.source(kdb.get("datFto")); 
				//rep.rst(); // 20121208
				setRepPage();//Establece los parámetros finales de impresión(rep.page(...);), pues pueden haber cambiado por el usuario 
				//Da valor a los inputs del reporte(rep.set();), e indica la ejecución de "grupos de renglones de impresión" (rep.exe();)
				
				titrepaux = frn.get("k_tipon", -1, 0);
				titrep = "C H E Q U E  -  ";
				rep.set("leyendatx", "[ " & frn.get("k_clave") & " ]   " & frn.get("k_nombreprov") & "   [ " & frn.get("k_rfc") & " ]");
				rep.set("fechoper","Datos Transaccion  :  Folio  " & frn.get("k_folio") & "  ,  Fecha  " & frn.get("k_fecha"));
				if( strlen(trim(frn.get("statusdoc"))) > 0 ){ 
					rep.set("estatustx", frn.get("statusdoc") );
				}
				
				rep.set("fecha",sys.date());
				rep.set("hora",sys.time());
				rep.set("nombreempresa",compania);
				rep.set("tituloreporte",titrep & titrepaux);
					
				rep.exe("encabezado");
				
				
				sucursal_id = frn.get("k_sucn",-1,1);
				nFolio = frn.get("k_folio");
				
				cmdQuery = "select " &  
				"w5.cve_prov_pago k_clave, coalesce(d.c3, coalesce(d2.c3,'No Existe ...')  ) k_nombreprov, coalesce(w5.cta_deposito,'') c_cuenta, " &
				"coalesce(w1.uuid_serie,'') c_serie, coalesce(w1.uuid_folio, '') c_folio, " &
				"abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) saldo, to_date( coalesce(g.c12::text , current_date::text) ,'yyy-mm-dd') vencimiento, " &
				"/*coalesce(w1.c11,w5.c14) UPD by JMM 20240724*/ coalesce(w5.c14, w1.c11) k_factura, " &
				"w5.c12 k_monto_factura, w5.c13 k_iva_factura, '' k_factura_rfc, w5.cve_prov_oper k_prov " &
				", coalesce(w5.st_x_comprobar,'') paso /*added by JMM 20240605*/ " & 
				", coalesce(d2.c3,'') provopernomb /*added by JMM 20240606*/ " & 
				"from keplersc.kdm5 w5 " &
				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kduxg g on g.c1 = w5.c1 and g.c2 = w5.c2 and (g.c4 = w5.c14 or g.doc_refer_compl = w5.c14) " &
				"/*line added by JMM 20240520*/ and w5.cve_prov_oper = g.c3 and w5.cve_prov_pago = g.cve_prov_pago " &
				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kduxe e on e.c1 = g.c1 and e.c2 = g.c3 and e.c3 = g.c4 and e.c5 = g.c2 and e.c6 = 'A' and e.c11 = g.c11 " & 
				"/*Added by JMM 20240724*/ and ( e.c13 > 0 /* or monto_rollback = 0 */ )" & 
				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kdm1 w1 on w1.c1 = w5.c1 and w1.c2 = w5.c2 and w1.c3 = 'A' and w1.c4 = e.c7 and w1.c5 = e.c8 and (w1.c11 = w5.c14 or w1.doc_refer_compl = w5.c14) /*and w1.c43 <> 'C'*//*Added 20240515 Commented 20240520*/ " &
				"/*line added by JMM 20240520*/ and w1.c10 = w5.cve_prov_oper and w1.cve_prov_pago = w5.cve_prov_pago " & 
				" /*Added by JMM 20240724*/ and w1.c6 = e.c9 " &
				"left join keplersc.kdxd d on /*d.c1 = w5.c1 and*/ d.c2 = w5.cve_prov_pago " &  
				"left join keplersc.kdxd d2 on /*d2.c1 = '" & sucursal_id & "' and*/ d2.c2 = w5.cve_prov_oper " & /* w1.c10  ... '" & prov_hist & "' */
				"where w5.c1='" & sucursal_id & "' and w5.c2='" & gen_doc &"' and w5.c3='" & nat_doc & "' and w5.c4=" & gpo_doc & " " & 
				"and w5.c5=" & tip_doc & " and w5.c6='" & nFolio & "' ";
				
				rstXml(cuboQuery);
				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_transfer_crud()");
				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\srv_transfer_crud_rpt");
				ok = getXmlAtt(cuboQuery,"ok");
				if(ok &! "" && !ok) {
					mensajeError = getXmlAtt(cuboQuery,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
					
				for(var x=0; x < nXml(cuboQuery); x++)
				{	
					
					rep.set("fact", getXmlAtt(cuboQuery,"r"&x,"k_factura"));
					rep.set("monto",getXmlAtt(cuboQuery,"r"&x,"k_monto_factura"));
					rep.set("iva", getXmlAtt(cuboQuery,"r"&x,"k_iva_factura"));
					rep.set("provoper", getXmlAtt(cuboQuery,"r"&x,"k_prov"));
					rep.set("nombre", getXmlAtt(cuboQuery,"r"&x,"provopernomb"));
																	
					rep.exe("detalle");
				}
				
				if (nXml(cuboQuery) > 0) { 
				
					rep.exe("linea_t1"); 
					
					rep.set("tsubt", frn.get("k_subtotal"));
					rep.set("tiva", frn.get("k_iva"));
					rep.set("ttot", frn.get("k_monto"));
					rep.set("ttottx", strFormat("number",frn.get("k_monto"),0) );
					rep.exe("total");
					
					rep.exe("linea_t2");
					
					rep.set("ref", frn.get("k_refer"));
					rep.set("comment", frn.get("k_coment"));
					rep.exe("comentarios");
					
				}
									
				//Modos de impresión 
				rep.win(); //Muestra la vista previa de la impresión. A partir de la vista previa (Preprint) se decide si se imprime o no.
				//rep.print("\\192.168.1.100\HPLaserJet"); //Envía el reporte directamente a una impresora, sin mostrar la vista previa.
				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresión. No muestra la vista previa.
				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardará el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html	
			
			
			} /* END Func Reporte() */
			
			
			// END : ZONA	CODIGO REPORTE(S)
	
		
			// ----------------------------------------------	 END : NEW FUNCTIONS IMPLEMENTED BY JMM 20240606  --------------------------------------------
			
		
		} // End of class Main
	</script>
</pag>