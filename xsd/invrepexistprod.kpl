<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Existencia de Refacciones">	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<tab/><txt fnt=",22" clr="0,0,0">Exstencia de Refacciones</txt><br/>		<tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/><grp dim="40,18,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="8" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Criterio de selecci&#243;n">			<sp/><txt>Sucursal:</txt><sp n="2"/>				<cmb id="cmb_sucursal" dim="50,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y"/><tab/><br/><br/>			<sp/><txt>Producto inicial:</txt><sp/>			<edt id="edt_prod_ini" dim="20,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" fnt="Arial,15"				page="invcatprdbus,edt_prod_ini" OnF9="Dialog(1,invcatprdbus,edt_prod_ini)"/>			<tab/><txt>Producto final:</txt><sp/>			<edt id="edt_prod_fin" dim="20,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" fnt="Arial,15"				page="invcatprdbus,edt_prod_fin" OnF9="Dialog(1,invcatprdbus,edt_prod_fin)"/><br/><br/>			<sp/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">A&#241;o</txt><sp/>			<inp id="anio" clr="64,64,64" clrBrdr="255,255,255"  dim="6,1" bclr="255,255,255" fnt="Arial,16" type="number" nc="4" min="2020" available="Y" modify="Y" just="R" fmt="5" max="2050" nd="0"/>			<tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Mes</txt>			<sp/>			<inp id="mes" clr="64,64,64" clrBrdr="255,255,255"  dim="6,1" bclr="255,255,255" fnt="Arial,16" type="number" nc="2" min="1" max="12" available="Y" modify="Y" OnChange="CambiaMes()"/>			<br/><br/>						<tab n="1"/><bot id="bot_ejecutar" dim="20,0" brdr="5" text="Ejecutar" OnEnter="Execute()" default="1"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys, suc_usuario,perfil_usuario,asterisco   ;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;								kdb.connect();				kdb.open("i,kdini,j,kdinm,k,kdink,l,kdinl,s,kdms,m,kdmm");								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				asterisco = "*";								Inicializa();							}						fun Inicializa(){//Inicializa los valores en Pantalla				frn.set("anio",sys.date(sys.date("year")));				frn.set("mes",sys.date(sys.date("month")));				IniCombos();				IniParams();//Inicializa parámtros de impresión entre otros			}									fun IniCombos(){				var cmd, cuboQuery, xmlResQuery, ok, mensajeError, strTmp,cubo;				cuboQuery="datDoc";																		//Llenar combo sucursales								cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";								if (perfil_usuario &! "ADMINISTRADOR"  && perfil_usuario &! "ADMINISTRATOR" && perfil_usuario &! "Administrador Kepler 8.0"){													cmd = cmd & " where c1='" & suc_usuario & "'";									}else {									if (suc_usuario &! asterisco && suc_usuario &! "" ){									cmd = cmd & " where c1='" & suc_usuario & "'";										}								}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepexistprod.IniCombos()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}												frn.set("cmb_sucursal",getXml(cubo));																	//Llenar combos de productos				kdb.search("datosI,i,1,7,&,i1");				kdb.search("datosF,i,1,8,&,i1");				kdb.exec();				frn.set("edt_prod_ini",kdb.get("datosI","i1"));				frn.set("edt_prod_fin",kdb.get("datosF","i1"));				}			fun IniParams(){//Inicializa parámetros de impresión, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Página				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}			fun setRepPage() {//Establece los parámetros finales de impresión.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}												fun Execute() {				if (ValidarInfo() == 0){					return;				};				GenerarReporte();			}						fun GenerarReporte(){				var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var cuboSaldos,cuboMovtos, cuboIdxMovtos, fecha_rep;				var xmlRegistros, cmd,ok,mensaje;				var totExist, totValor, totProm, contReg, totRegs;				var k_prod_clave,k_prod_descripcion,k_exist,k_valor,k_prom,k_min,k_max,k_loc;				var excluir_cero;								kdb.kde("KDE");//Configuración del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = frn.config("user","name");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();				fecha_rep=frn.get("anio") & "-" & frn.get("mes") & "-" & "01";								//Obtener saldos totales //				setXml(xmlRegistros,"document","sucursal_id",frn.get("cmb_sucursal",-1,1));				setXml(xmlRegistros,"document","producto_ini",frn.get("edt_prod_ini",-1,0));				setXml(xmlRegistros,"document","producto_fin",frn.get("edt_prod_fin",-1,0));				setXml(xmlRegistros,"document","fecha",fecha_rep);				setXml(xmlRegistros,"document","movimiento","usuario",frn.lib("libKepler","UserInfo"));				frn.lib("libGeneral.kpl","FileSave",xmlRegistros,"C:\Basura\xmlReqRepExist");								cmd="select * from keplersc.invr_rep_exisprod_sel('" & getXmlStr(xmlRegistros,"EOF:13_10") & "')";				xmlRegistros = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepmovprod.GenerarReporte()");				frn.lib("libGeneral.kpl","FileSave",xmlRegistros,"C:\Basura\xmlSelRepExist");								ok=getXmlAtt(xmlRegistros,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(xmlRegistros,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												kdb.readPage("datos","invrepexistprodfto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parámetros finales de impresión.(rep.page(...);)				rep.set("k_empresa",compania);				rep.set("k_sucursal",frn.get("cmb_sucursal",-1,0)); 				rep.set("k_fecha", frn.get("mes") & " del " & frn.get("anio"));				rep.set("k_fecha_imp",fechaImpresion);				rep.set("K_hora_imp",horaImpresion);				rep.exe("encabezado");								//Iniciar totales				totExist=0;				totValor=0;				totProm=0;				totRegs = nXml(xmlRegistros);												for(contReg=0; contReg<totRegs; contReg++){					k_prod_clave= getXmlAtt(xmlRegistros,"r"&contReg,"k_clave");					k_prod_descripcion = getXmlAtt(xmlRegistros,"r"&contReg,"k_descripcion");					k_exist = getXmlAtt(xmlRegistros,"r"&contReg,"k_existencias");					k_valor = getXmlAtt(xmlRegistros,"r"&contReg,"k_valor");					k_prom = getXmlAtt(xmlRegistros,"r"&contReg,"k_promedio");					k_min = getXmlAtt(xmlRegistros,"r"&contReg,"k_minimo");					k_max = getXmlAtt(xmlRegistros,"r"&contReg,"k_maximo");					k_loc = getXmlAtt(xmlRegistros,"r"&contReg,"k_loc");					totExist = totExist + k_exist;					totValor = totValor + k_valor;										rep.set("k_prod_clave",k_prod_clave);					rep.set("k_prod_descripcion",k_prod_descripcion);					rep.set("k_exist",strFormat("nfmt",k_exist,2));					rep.set("k_valor",strFormat("nfmt",k_valor,2));					rep.set("k_prom",strFormat("nfmt",k_prom,2));					rep.set("k_min",strFormat("nfmt",k_min,2));						rep.set("k_max",strFormat("nfmt",k_max,2));					rep.set("k_loc",k_loc);					rep.exe("seccion_detalle");									}								if(totExist > 0){					totProm = totValor/totExist;				}				rep.set("k_tot_exist",strFormat("nfmt",totExist,2));				rep.set("k_tot_valor",strFormat("nfmt",totValor,2));				rep.set("k_tot_prom",strFormat("nfmt",totProm,2));				rep.exe("seccion_total_reporte");				rep.win();			}						fun ValidarInfo(){				return 1;			}											}	</script></pag>