<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<tab/><inp id="k_titulo" dim="65,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"				type="string" modify="N" available="N" fnt="Arial,22"/>		<br/>		<br/>		<tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grupo_crud" dim="80,16,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="Nuevo" available="Y"><tab/>			<br/><br/><tab n="5"/>            <txt>Modelo:</txt>			<inp id="k_modelo" dim="25,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="18" available="Y" OnF9="ObtenerModelo()" OnChange="BuscarModelo()" OnF10="Dialog(3,cat_crud_autos,N)" tooltip="Clave del Modelo ( F9 b&#250;squeda, F10 Nuevo )"/><br/><sp/><tab n="2"/><txt>    Clave del color: </txt>			<inp id="k_color" dim="15,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="10" available="Y" OnF9="ObtenerColor()" tooltip="Clave del Color ( F9 b&#250;squeda )"/><br/><sp/><tab/>			<txt>Descripci&#243;n del color: </txt>			<inp id="k_descripcion" dim="55,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="40" clrBrdr="255,255,255" tooltip="Descripci&#243;n del color"/><br/><sp/><tab/>			<br/>            <tab n="11"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/><br/>			<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP, accion,externo, clave_sel,sucursal_id,cve_color,resVal,straccion;            var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();							ctlrs_off();				insertar_datos();											}						fun ctlrs_off(){						accion = frn.param(0);				frn.set("input_crud", accion);				frn.rst("grupo_crud");				externo	= frn.param(2);				if (accion &= "NUEVO"){                    straccion = "Nuevo" ;                   }else if (accion &= "CONSULTAR"){                    straccion = "Consultar";                }else if (accion &= "MODIFICAR"){                    straccion = "Modificar";                }else if (accion &= "ELIMINAR"){                    straccion = "Eliminar";                }   				frn.setAtt("grupo_crud", "tit", straccion );				clave_sel = frn.param(1);                cve_color = frn.param(3);                sucursal_id = frn.param(4);						frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );				if (accion &= "NUEVO"){					frn.setAtt("k_modelo", "available", "Y" );				    frn.setAtt("k_color", "available", "Y" );					frn.set("k_titulo","Catálogo de Colores Interiores del Vehículo");											}else{					frn.setAtt("k_modelo", "available", "Y" );					frn.setAtt("k_modelo", "modify", "N" );				    frn.setAtt("k_color", "available", "N" );					frn.set("k_modelo", clave_sel);                    frn.set("k_color", cve_color);				}				if (accion &! "CONSULTAR"){					frn.setAtt("btn_aceptar", "available", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );				}						}							fun insertar_datos(){					if (accion &= "MODIFICAR"){					//llamada externa(padre)					if (externo &= "s"){						if (clave_sel &= ""){							frn.message("selecciona una clave con F9 para modificar","Error","Aceptar");							frn.setAtt("btn_aceptar", "visible", "N" );							return;						}					}				}				if (accion &! "NUEVO") {					cmdQuery="select c4 from keplersc.kdice3 where c1='" & clave_sel & "' and c3 ='" & cve_color & "'"; 					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_interiores_crud.insertar_datos()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}						frn.set("k_descripcion",getXmlAtt(cuboResultados,"r"&0,"c4"));					if (accion &= "MODIFICAR") {                        frn.setAtt("grupo_crud", "available","Y");                    }else{                        frn.setAtt("k_modelo", "available","Y");						frn.setAtt("k_modelo", "modify", "N" );                        frn.setAtt("k_color", "available","N");                        frn.setAtt("k_descripcion", "available","N");						frn.setPos("k_modelo");                     }                }else{                    frn.setAtt("grupo_crud", "available","Y");                    frn.setPos("k_modelo");    				}			}			fun ValidarDatos(){				if (frn.get("k_modelo") &= "") {											frn.setPos("k_modelo");					resVal=0;					frn.message("Debe especificar el modelo, verificar","Error","Aceptar");				} else{					BuscarModelo();					}				if (frn.get("k_color") &= "") {											frn.setPos("k_color");					resVal=0;					frn.message("Debe especificar el color, verificar","Error","Aceptar");				}				if (frn.get("k_descripcion") &= "") {											frn.setPos("k_descripcion");					resVal=0;					frn.message("Debe especificar la descripción del color, verificar","Error","Aceptar");				}			}			fun Execute() {				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}								var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}								xmlRequest = getXml(frn.dataPag());					frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmdQuery="SELECT * FROM keplersc.cat_interiores_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_interiores_crud.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frP.script("Inicia_Forma()");				if (accion &= "NUEVO" || accion &= "MODIFICAR") {						var sms =  "";					if (accion &= "NUEVO"){						sms = "Registro guardado";					}else {						sms = "Registro modificado";					}					frn.setAtt("btn_aceptar", "available", "N" );					frn.setAtt("k_modelo", "available","N");                    frn.setAtt("k_color", "available","N");                    frn.setAtt("k_descripcion", "available","N");					frn.message(sms ,"Mensaje","Aceptar");						frn.exit();					}				if (accion &= "ELIMINAR"){					frn.message("Registro eliminado","Mensaje","Aceptar");					frn.exit();							}			}							            fun ObtenerModelo(){                    cmdQuery = "select c1 as modelo,c2 as descripcion from keplersc.kdiv";                frn.dialog("genlistafiltrosel","Modelos de Vehículos",cmdQuery,"modelo","k_modelo","0","0","N","S");			               }             fun ObtenerColor(){   					clave_sel = frn.get("k_modelo");                  if (clave_sel &=""){                    frn.message("Debe especificar el modelo","Mensaje","Aceptar");                    frn.setPos("k_modelo");                    return;                  }                 cmdQuery = "select c3 as color,c4 as descripcion from keplersc.kdice3 where c1='" & clave_sel & "'";                frn.dialog("genlistafiltrosel","Colores del Modelo",cmdQuery,"color","k_color","0","0","N","S");			               }			fun BuscarModelo(){				var modelo_id;				modelo_id=frn.get("k_modelo");				cmdQuery = "select c1 as modelo from keplersc.kdiv " &						"where c1='" & modelo_id & "'";											rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_interiores_crud.BuscarModelo()");				frn.lib("libGeneral.kpl","FileSave",cubo, "C:\Basura\cuboResultados");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if((nXml(cubo) == 0) && (modelo_id &! "")) {					frn.setPos("k_modelo");					frn.message("El modelo del vehículo no existe","Error","Aceptar");					resVal = 0;					return;				}			}			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    				1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 				2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 				3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				// var tip_ope; 				var tip_oper;				if(iModo==0)					page=pag; 				else if(iModo==2&&(strlen(par0)>0)){					//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;					if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     			}			}	</script></pag>