<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" dim="0,0,10,10" tit="Saldos iniciales">	<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="-1,-1,10,20" clrBrdr="0,97,181"  bclr="192,205,213" unfont="0" tit="Saldos iniciales" OnPgUp="PgUp" OnPgDn="PgDn" OnCtrPgUp="CtrPgUp" OnCtrPgDn="CtrPgDn" OnF1="Dialog(1,concatsalayu)" OnCtrIni="CtrIni" OnCtrEnd="CtrEnd" OnEnter="Exit"><tab/><br/><br/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="45,9,7,12"  tit="Cuentas y saldos iniciales" fnt="Arial,16" unfont="0"><tab/>			<txt hk="N" fnt="Arial,16" clr="0,58,112" bclr="255,255,255">N&#250;mero de cuenta</txt><tab n="2"/>				<inp id="numero" clr="64,64,64" clrBrdr="255,255,255"  dim="22,1" bclr="255,255,255" brdr="2,0" type="capital" OnF9="Dialog(1,concatcuebus,numero)" OnChange="Bus(1)" OnF10="Dialog(1,concatcuepag,numero,,10100)"/>				<sp/><img id="bc" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Dialog(1,concatcuepag,numero,,10111)" available="Y"/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Descripci&#243;n</txt><tab n="4"/>				<inp id="descripcion" clr="64,64,64" clrBrdr="255,255,255"  modify="N" dim="37,1" bclr="255,255,255" brdr="2,0" type="string" available="Y" visible="Y"/><br/><tab/>			<txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Saldo inicial</txt><tab n="4"/>				<inp id="saldo" clr="64,64,64" clrBrdr="255,255,255"  dim="17,1" bclr="255,255,255" brdr="2,0" OnChange="Cambio(14,saldo)" nc="15" type="number" nd="2" visible="Y" modify="Y"/><br/><br/><tab n="2"/>		</grp><br/><br/>	</grp>	<tools>		<tool name="endleft" OnMouseL="CtrIni()" img="_TL_First.png"/>		<tool name="left" OnMouseL="PgUp()" img="_TL_Previous.png"/>		<tool name="right" OnMouseL="PgDn()" img="_TL_Next.png"/>		<tool name="endright" OnMouseL="CtrEnd()" img="_TL_Last.png"/>	</tools>		<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys;			/* PARÁMETROS (Tienen sentido cuando la opción se ha ejecutado como diálogo.)			param(0) = Nombre del campo (o tabla) al que se devolverá la clave o descripción en la pantalla padre			param(1) = (Opcional) Nombre de la columna al que se devolverá la clave en la pantalla padre(Se debe especificar el grid en el parametro anterior)			param(2) = (Opcional) Bandera binaria de control. Es un string que indica ciertos parámetros de funcionamiento de la opción							Los caracteres se toman de izquierda a derecha y tienen el siguiente significado:							Bit 1= Si toma valor de 1, se devuelve la clave. Si toma valor de 0, se devuelve la descripción. Por default se toma valor de 1.							Bit 2= Si toma valor de 1, permite modificar el catálogo. Si toma valor de 0, no permite modificación. Por default se toma valor de 1.							Bit 3= Si toma valor de 1, permite insertar/borrar registros. Si toma valor de 0, no permite insertar/borrar. Por default se toma valor de 1.							Bit 4= Si toma valor de 1, permite cambiar de registro. Si toma valor de 0, no permite cambiar de registro. Por default se toma valor de 1.							Bit 5= Si toma valor de 1, regresa un cubo de memoria con campos principales de TODOS los registros(para guardar la info en un combo). Si toma valor de 0, solo regresa la clave o descripción. Por default se toma valor de 1.			param(3) = (Opcional) Función de la pantalla padre a ejecutar antes de regresarle el control.									Valor de retorno = clave o descripción del producto			*/			var bit1,bit2,bit3,bit4,bit5;//Banderas de comportamiento (Ver descripción arriba)			var tabla_base;//Tabla base del catálogo (Se abre con el alias "a")			var camposDeseados;//Campos de la tabla que se requieren(Ej: a1...a4)			var year;			fun Main() { 				frn=new FRNT; 				frP=new FRNTP; 				kdb=new KDB;				sys=new SYS;				bit1=1;bit2=1;bit3=1;bit4=1;bit5=1;//Inicializa las banderas con los valores default.				var bCtrl=trim(frn.param(2));				if (strlen(bCtrl)>0){ //Se especificó una bandera de control.					bit1=mid(bCtrl,0,1);bit2=mid(bCtrl,1,1);bit3=mid(bCtrl,2,1);					bit4=mid(bCtrl,3,1);bit5=mid(bCtrl,4,1);				}				if (strlen(trim(frn.param(1)))>0){ bit5=0;}//Si se especifica una columna, no se devolverán todos los registros, solo el actual				kdb.connect();				/*kdb.kde("yr");				kdb.exec();				year=kdb.get("yr",14);*/				if(frn.config("temp","k_workDate")){					year=mid(frn.config("temp","k_workYear"),2,2);				}else {					kdb.kde("yr");kdb.exec();					year=kdb.get("yr",14);				}				tabla_base="kdc1" & year;//Cuentas				camposDeseados="a1...a2,a14";				kdb.open("a," & tabla_base);				kdb.open("w,kdlogmov");				var valor_inicial=(bit1==1)? frP.get(frn.param(0),-1,0): frP.get(frn.param(0),-1,1);				if (strlen(trim(frn.param(1)))>0){ valor_inicial=frP.get(frn.param(0),-1,frn.param(1)); }//Se devolverá el valor a una tabla 				frn.set("numero",valor_inicial);//Se llena la clave si es ventana de diálogo.				Bus(1);				if(bit2==0)deshabilita_campos();			}			fun camposLlave() {var llave=frn.get("numero");				if (bit4==0){ setmfy("numero"); } //Desactiva los campos de la llave para que no pueda cambiarse de registro				return llave;}//Campos que forman la llave. Puede ser una llave combinada			fun setData() { //Funcion que llena los campos en pantalla con la información de la base de datos				set("numero","a1");set("descripcion","a2"); set("saldo","a14");				kdb.sp("k_cuenta","dat",frn.get("numero"),year);				kdb.exec(); 				if(kdb.get("dat","k_cuenta")&=frn.get("numero")){					frn.setAtt("saldo","modify","Y");				}else{					frn.setAtt("saldo","modify","N");				}			}			fun LlenaCombo(combo,alias,indice,campoVisible,camposOcultos,posicionaFinal){				var cmd="tmp," & alias & "," & indice & ",&," & campoVisible & "," & camposOcultos;				kdb.table(cmd);kdb.exec();				frn.set(combo,kdb.get("tmp"));				if(posicionaFinal==1&&frn.N(combo)>0){frn.set(combo,frn.get(combo,frn.N(combo)-1,-1));}//Lo posiciona en el ultimo renglon			}			fun verifica_borrar(){				var cve=camposLlave();				var cmd="tmp,j,6,1," & cve & ",&,j3";				kdb.search(cmd); kdb.exec(); 				var valor=kdb.get("tmp","j3");				if(valor &=cve)				{Error("Existe al menos un movimiento de inventario con este producto, NO es posible borrarlo");return 0;}				else{return frn.message("Está a punto de borrar el producto " & frn.get("desc") & ". ¿Desea Continuar?","Precaución",1);}//Regresa 1 si se puede borrar. 0 si no.			}						fun deshabilita_campos(){//Deshabilita todos los campos que no sean parte de la llave. Pone invisibles los botones				setmfy("numero"); setmfy("descripcion"); setmfy("saldo");			}						fun Exit() { //Tiene sentido cuando la pagina se ejecuta como dialogo, pues regresa el registro actual.				kdb.table("dat1,a,1,&,a2,a1");				kdb.exec();				frP.set(frn.param(0),kdb.get("dat1"));//Se llena el combo				frP.set(frn.param(0),frn.get("numero"));//Se posiciona en el registro correcto				if (strlen(trim(frn.param(0)))>0){ //Solo si se especificó un campo a devolver los datos 					if(bit5==1){//Se regresará un cubo de memoria con todos los registros (para llenar un combo o una lista)						var cmd="dat1,a,1,&,a1,a2";//Por default se ordena por clave, y el campo visible es la clave(bit1=1)						if(bit1==0) cmd="dat1,a,2,&,a2,a1";//Se ordena por descripción, y el campo visible es la descripción						kdb.table(cmd);kdb.exec();						frP.set(frn.param(0),kdb.get("dat1"));//Se llenan los combos					}					var valor_retorno=frn.get("numero");//Por default se devuelve la clave(bit1=1)					if( bit1==0 ){						valor_retorno=frn.get("descripcion");//Se devuelve la descripcion					}					if (strlen(trim(frn.param(1)))>0){ //Se devolverá el valor a una tabla 						frP.setX(valor_retorno,trim(frn.param(0)),-1,trim(frn.param(1))); 						frP.scriptElm(frn.param(0),"OnChange",frn.param(1));					}					else{ //se devolverá el valor a un campo						frP.set(frn.param(0),valor_retorno); 						frP.scriptElm(frn.param(0),"OnChange");					}				}				if (strlen(trim(frn.param(3)))>0){ //Se ejecutará la función indicada en la ventana padre.					frP.script(frn.param(3));				}				frn.exit();			}			//Funciones Auxiliares Para Catálogos(Genericas). 			//Necesitan las variable globales tabla_base y camposDeseados. 			//tabla_base especifíca el nombre de la tabla del catálogo que se está editando			//camposDeseados indica los campos que se modificaran de la tabla. Ej a1...a70			//Ademas de una funcion camposLlave que devuleva los campos que forman la clave			//Una funcion setData que establece en pantalla los valores de la base de datos. (Cubo de información: "datos")			//Una funcion verifica_borrar() que regresa 1 si se puede borrar el registro, 0 si no se debe borrar.			fun set(objeto,campo) { frn.set(objeto,kdb.get("datos",campo));}//Establece el valor de un campo de la BD al objeto indicado			fun Busca() {if(bit4==1) Bus(0);}			fun PgUp() {if(bit4==1) Bus(6);}			fun PgDn() {if(bit4==1) Bus(5);}			fun CtrIni() {if(bit4==1) Bus(7);}			fun CtrEnd() {if(bit4==1) Bus(8);}			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}			fun Error(string){frn.messageBar(string,1); frn.sound(1);}//Establece un mensaje de error en la barra de estado. Y emite un sonido de alerta.			fun Bus(relacional) { //1:>=	2:<=		3:>	 4:<		 5:Siguiente		6:Anterior		7:Primero		8:Ultimo				frn.messageBar("");				var cmd="datos,a,1," & relacional & "," & camposLlave() & ",&," & camposDeseados;				kdb.search(cmd); kdb.exec(); setData();			}			fun Cambio(numero_campo,objeto,desplazamiento) { //Realiza un cambio de valor en la BD					var cmd=tabla_base & ",1," & camposLlave() & ",&," & numero_campo & "," & frn.get(objeto,-1,desplazamiento); 					//Agrega el LOG					kdb.write("logmov,w,1,'"&strFormat("ucase",frn.config("user","name"))&"','"&sys.date()&"','"&sys.time()&"','"&frn.FileName()&"',&,1,'"&strFormat("ucase",frn.config("user","name"))&"',2,'"&sys.date()&"',3,'"&sys.time()&"',4,'"&frn.FileName()&"',5,'"&numero_campo&"',6,'"&frn.get(objeto,-1,desplazamiento)&"',7,'"&frn.getPrv(objeto,-1,desplazamiento)&"',8,'"&tabla_base&"',9,'"&camposLlave()&"'");					kdb.update(cmd); 			}			fun CtrDel() {//Borra el registro actual y devuelve el siguiente				if(bit3==1){					if ( verifica_borrar()==1 ){//Solo borrará el registro si la funcion verifica_borrar devuelve 1. Cada catálogo define su validacion para borrar.						var cmd="datos,a,1," & camposLlave() & ",&," & camposDeseados;						//Agrega LOG						kdb.write("logmov,w,1,'"&strFormat("ucase",frn.config("user","name"))&"','"&sys.date()&"','"&sys.time()&"','"&frn.FileName()&"',&,1,'"&strFormat("ucase",frn.config("user","name"))&"',2,'"&sys.date()&"',3,'"&sys.time()&"',4,'"&frn.FileName()&"',5,BORR,6,'"&camposLlave()&"',8,'"&tabla_base&"'");						kdb.del(cmd); kdb.exec(); 						if(bit4==1)setData();else frn.exit();//Si no se puede posicionar en otro registro, se sale de la opción después de borrar.					}				}			}			fun setmfy(campo,valor){//Modifica el atrbuto modify de cierto objeto(0=no permite modificacion. 1=Permite modificacion)				var atrib=(valor==1)?"Y":"N";				frn.setAtt(campo,"modify",atrib);			}			fun setvbl(campo,valor){//Modifica el atrbuto visible de cierto objeto(0=no lo muestra. 1=si lo muestra)				var atrib=(valor==1)?"Y":"N";				frn.setAtt(campo,"visible",atrib);			}		}			/*		Nombre				fecha				Cambio		----------------------------------------------------------------		Alfredo Flores    18-07-2011		Se modifico Dialog(1,concatcuepag,numero,,10100) en la definición del input numero para que funcionara correctamente		EFDA					28/oct/2011		Se abre la tabla kdlogmov con alias w																		Se define la variable sys y su instanciacion de la clase SYS																		Se modifica la funcion Cambio p/escribir a la tabla kdlogmov																		Se modifica la funcion CtrDel p/escribir a la tabla kdlogmov	*/		</script></pag>