<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Catalogo de Cuentas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,15,12" bclr="192,205,213" unfont="0">	<tab/>	<br/><sp/><txt clr="0,0,0" fnt=",22">Consulta Saldo de Cuentas</txt>	<br/>	<sp/>	<hLine clr="0,0,0"/>	<br/><br/>	<sp/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="70,34,10,10" brdr="0,5" tit="Lista de Cuentas" fnt="Arial,16">		<sp/>		<txt>Sucursal:</txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="40,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="BorraDatos()" 			available="Y" OnChange="ResetResults()"/><tab/>		<txt>A&#241;o:</txt>		<cmb id="k_anio" clr="64,64,64" clrBrdr="192,205,213" dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 			available="Y" OnChange="ResetResults()"/>		<br/>		<sp/><txt>Columna </txt>		<cmb id="k_filtros" clr="64,64,64" clrBrdr="192,205,213"  				dim="20,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  				Null="N" available="Y" tooltip="Selecciona columna base de b&#250;squeda"/>		<tab/>		<inp id="k_busqueda" dim="28,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213"				type="capital" tooltip="texto a buscar"/>		<tab n="1"/>		<img id="bot_buscar" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_Registros(1)" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>						<br/>		<sp/>		<tbl clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" brdr="1,0" id="results" dim="102,16" 			modify="N" nren="fijo" Reorder="Y" clrCur="192,205,213" OnEnter="ConsultarSaldos()" OnMouseD="ConsultarSaldos()" OnMouseL="ConsultarSaldos()">			<col name="C1" id="c1"/>		</tbl>		<tab n="1"/>		<br/>	</grp>	<br/><br/>		<sp/>	<grp bclr="192,205,213" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,0" dim="80,30,7,12">		<grp bclr="236,240,243" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="64,28,7,12"  tit="Saldo de la Cuenta" fnt="Arial,16" unfont="0">			<sp/><txt>Cuenta: </txt>			<inp id="k_cuenta" clr="64,64,64" clrBrdr="255,255,255"  dim="16,1" bclr="255,255,255" brdr="2,0" type="capital"  nc="20" modify="N" available="N"/><sp/>			<inp id="k_descripcion" clr="64,64,64" clrBrdr="255,255,255"  modify="N" dim="38,1" bclr="255,255,255" brdr="2,0" type="string" available="Y" visible="Y" nc="35"/>			<br/><sp/>						<tbl id="k_saldos" dim="62,18" brdr="1,0" clrBrdr="64,64,64" bclr="255,255,255" modify="N" nren="fijo" clr="64,64,64" clrCur="192,205,213" 				OnEnter="ConsultarMovtos()" OnMouseD="ConsultarMovtos()" OnMouseL="ConsultarMovtos()">				<col id="mes" name="Mes"/>				<col id="cargos" name="Cargos" type="number" nd="2"/>				<col id="abonos" name="Abonos" type="number" nd="2"/>				<col id="saldo" name="Saldo" type="number" nd="2"/>				<rec id="tot_cuenta" fixed="Y"/>			</tbl>			<br/><txt fnt=",0" clr="250,0,0">  * Doble cick para ver movimientos del mes</txt>		</grp>		<tab/>		<grp bclr="236,240,243" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="84,33,7,12"  tit="Movimientos del mes" fnt="Arial,16" unfont="0"><txt> Mes: </txt>			<inp id="k_mes_movtos" dim="25,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>			<br/><sp/>			<tbl id="k_movtos" dim="82,18" brdr="1,0" clrBrdr="64,64,64" bclr="255,255,255" modify="N" nren="fijo" clr="64,64,64" clrCur="192,205,213" 				OnEnter="abrir_poliza()" OnMouseD="abrir_poliza()">				<col id="k_poliza" name="P&#243;liza"/>				<col id="fecha" name="Fecha" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="tipopoliza" name="Tipo" type="string"/>				<col id="cargo_movto" name="Cargos" type="number" nd="2"/>				<col id="abono_movto" name="Abonos" type="number" nd="2"/>								<col id="descripcion" name="Descripci&#243;n" type="string"/>				<col id="referencia" name="Referencia" type="string"/>				<col id="genero" name="Gen" type="string"/>				<col id="naturaleza" name="Nat" type="string"/>				<col id="grupo" name="Gpo" type="string"/>				<col id="tipo" name="Tipo" type="string"/>				<col id="desc_movto" name="Descripci&#243;n" type="string"/>				<rec id="tot_movto" fixed="Y"/>			</tbl><br/><txt clr="250,0,0">* Doble clickpara ver p&#243;lza del movimiento</txt>		</grp>	</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;			var accion,tipoOper; 			var regTotales,ultimoValorEncontrado, contGlobalResults; //variables del llenado de la tabla			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				//Constantes								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";				ConfiguraUI();				Inicializa();			}			fun ResetResults(){				frn.rst("results");				frn.rst("k_saldos");				frn.rst("k_movtos");				frn.set("k_cuenta","");						frn.set("k_descripcion","");				frn.set("k_mes_movtos","");			}			fun ConsultarMovtos(){				var clave,descripcion,anio,mes,mes_desc;				var cmd, mensajeError,ok,nReg, colCriterio,criterio,expWhere,expOrder;				anio=frn.get("k_anio",-1,0);								clave=frn.get("results",-1,"cuenta");				descripcion=frn.get("results",-1,"descripcion");				mes=frn.getJ("k_saldos");				mes_desc=frn.get("k_saldos",-1,"mes");				frn.set("k_mes_movtos",mes_desc);				if(strlen(mes)==1){					mes="0"&mes;				}								frn.set("k_mes_movtos",mes_desc);				cmd="select kdc2.c1 as k_poliza, kdc2.c2 as fecha, kdc2.c8 as tipopoliza, " &					"case when kdc2.c4 = 'C' then kdc2.c5 else 0 end cargo_movto, " &					"case when kdc2.c4 = 'A' then kdc2.c5 else 0 end abono_movto, " &					"kdc2.c6 as descripcion, kdc2.c7 as referencia, " &					"kdc2.c15 as genero, " &					"kdc2.c16 as naturaleza, " &					"kdc2.c17 as grupo, " &					"kdc2.c18 as tipo, " &					"mm.c5 as desc_movto, kdc2.c19 as folio " &					"from keplersc.kdc2_view kdc2, keplersc.kdmm mm " &					"where kdc2.anio='" & anio & "' and kdc2.mes = '" & mes & "' and kdc2.c3='" & clave & "' " &					"and kdc2.c14=mm.col_sucursal and kdc2.c15=mm.c1 and kdc2.c16=mm.c2 and kdc2.c17=mm.c3 and kdc2.c18=mm.c4 order by k_poliza";frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdConsMovtos");										cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"conconsultasaldos.ConsultarMovtos()");frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\xmConsMovtos");					ok=getXmlAtt(cuboXml,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}						frn.set("k_movtos",cuboXml);					CalcTotales();			}						fun ConsultarSaldos(){				var clave,descripcion,anio;				var cmd, mensajeError,ok,nReg, colCriterio,criterio,expWhere,expOrder;								anio=frn.get("k_anio",-1,0);								clave=frn.get("results",-1,"cuenta");				descripcion=frn.get("results",-1,"descripcion");				if (clave==""){					frn.message("No ha seleccionado una cuenta de la lista","Mensaje","&Aceptar");					return;				}				//Inicia campos de detalle dependientes				frn.rst("k_movtos");				frn.set("k_cuenta",""); frn.set("k_cuenta",clave);				frn.set("k_descripcion",""); frn.set("k_descripcion",descripcion);				frn.set("k_mes_movtos","");												cmd="select mes, cargos, abonos, saldo from (" & 					"select 0 as orden, c1 as cuenta, 'SALDO INICIAL' as descripcion, 'SALDO INICIAL' as mes, " &					"0 as cargos, 0 as abonos, c14 as saldo " &					"from keplersc.kdc1_view k where  anio = '" & anio & "'" & " and c1='"& clave & "' " &					"union " &					"select 1 as orden, c1 as cuenta, c2 as descripcion, 'Enero' as mes, " &					"c27 as cargos, c63 as abonos, " &					"c14+c27-c63 as saldo " &					"from keplersc.kdc1_view k where anio = '" & anio & "'" & " and c1='"& clave & "' " &					"union " &					"select 2 as orden, c1 as cuenta, c2 as descripcion, 'Febrero' as mes, " &					"c28 as CARGOS, c64 as abonos, " &					"c14+c27+c28-c63-c64 as saldo " &					"from keplersc.kdc1_view k where anio = '" & anio & "'" & " and c1='"& clave & "' " &					"union " &					"select 3 as orden, c1 as cuenta, c2 as descripcion,'Marzo' as mes, " &					"c29 as cargos,c65 as abonos, " &					"c14+c27+c28+c29-c63-c64-c65 as saldo " &					"from keplersc.kdc1_view k where anio = '" & anio & "'" & " and c1='"& clave & "' " &					"union " &					"select 4 as orden, c1 as cuenta, c2 as descripcion, 'Abril' as mes, " &					"c30 as cargos, c66 as abonos, " &					"c14+c27+c28+c29+c30-c63-c64-c65-c66 as saldo " &					"from keplersc.kdc1_view k where anio = '" & anio & "'" & " and c1='"& clave & "' " &					"union " &					"select 5 as orden, c1 as cuenta, c2 as descripcion, 'Mayo' as mes, " &					"c31 as cargos, c67 as abonos,  " &					"c14+c27+c28+c29+c30+c31-c63-c64-c65-c66-c67 as saldo " &					"from keplersc.kdc1_view k where anio = '" & anio & "'" & " and c1='"& clave & "' " &					"union " &					"select 6 as orden, c1 as cuenta, c2 as descripcion, 'Junio' as mes, " &					"c32 as cargos, c68 as abonos,  " &					"c14+c27+c28+c29+c30+c31+c32-c63-c64-c65-c66-c67-c68 as saldo " &					"from keplersc.kdc1_view k where anio = '" & anio & "'" & " and c1='"& clave & "' " &					"union " &					"select 7 as orden, c1 as cuenta, c2 as descripcion, 'Julio' as mes, " &					"c33 as cargos, c69 as abonos,  " &					"c14+c27+c28+c29+c30+c31+c32+c33-c63-c64-c65-c66-c67-c68-c69 as saldo " &					"from keplersc.kdc1_view k where anio = '" & anio & "'" & " and c1='"& clave & "' " &					"union " &					"select 8 as orden, c1 as cuenta, c2 as descripcion, 'Agosto' as mes, " &					"c34 as cargos, c70 as abonos,  " &					"c14+c27+c28+c29+c30+c31+c32+c33+c34-c63-c64-c65-c66-c67-c68-c69-c70 as saldo " &					"from keplersc.kdc1_view k where anio = '" & anio & "'" & " and c1='"& clave & "' " &					"union " &					"select 9 as orden, c1 as cuenta, c2 as descripcion, 'Septiembre' as mes, " &					"c35 as cargos, c71 as abonos,  " &					"c14+c27+c28+c29+c30+c31+c32+c33+c34+c35-c63-c64-c65-c66-c67-c68-c69-c70-c71 as saldo " &					"from keplersc.kdc1_view k where anio = '" & anio & "'" & " and  c1='"& clave & "' " &					"union " &					"select 10 as orden, c1 as cuenta, c2 as descripcion, 'Octubre' as mes, " &					"c36 as cargos, c72 as abonos,  " &					"c14+c27+c28+c29+c30+c31+c32+c33+c34+c35+c36-c63-c64-c65-c66-c67-c68-c69-c70-c71-c72 as saldo " &					"from keplersc.kdc1_view k where anio = '" & anio & "'" & " and c1='"& clave & "' " &					"union " &					"select 11 as orden, c1 as cuenta, c2 as descripcion, 'Noviembre' as mes, " &					"c37 as cargos, c73 as abonos, " &					"c14+c27+c28+c29+c30+c31+c32+c33+c34+c35+c36+c37-c63-c64-c65-c66-c67-c68-c69-c70-c71-c72-c73 as saldo " &					"from keplersc.kdc1_view k where anio = '" & anio & "'" & " and c1='"& clave & "' " &					"union " &					"select 12 as orden, c1 as cuenta, c2 as descripcion, 'Diciembre' as mes, " &					"c38 as cargo, c74 as abono,  " &					"c14+c27+c28+c29+c30+c31+c32+c33+c34+c35+c36+c37+c38-c63-c64-c65-c66-c67-c68-c69-c70-c71-c72-c73-c74 as saldo " &					"from keplersc.kdc1_view k where anio = '" & anio & "'" & " and c1='" & clave & "') as registros " &					"order by orden ";frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdConsSaldos");										cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"conconsultasaldos.ConsultarSaldos()");frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\xmConsSaldos");					ok=getXmlAtt(cuboXml,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}						frn.set("k_saldos",cuboXml);										CalcTotales();			}						fun Encabezados(){				var colIds, totReg, colNd;				frn.rst("results");								totReg=nXml(cuboXml);				colIds=getXmlAtt(cuboXml,"k_ColName");				colNd=getXmlAtt(cuboXml,"k_ColNd");				colNd=frn.lib("libGeneral.kpl","StrReplace",colNd,"1","2");				colNd=frn.lib("libGeneral.kpl","StrReplace",colNd,"-","");				if(colIds &! ""){					frn.setX(colIds,"results","k_ColName");					frn.setX(getXmlAtt(cuboXml,"k_ColType"),"results","k_ColType");					frn.setX(colNd,"results","k_ColNd");					frn.setAtt("llave","visible","N");				}							}			fun ConfiguraUI(){							}								fun Inicializa(){				var cmd, cubo, ok,resValidacion,resMensaje ;							frn.rst("gpo_2");				Encabezados();				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",getXml(cubo));									cmd="SELECT concat(substring(table_name,5,2)) as anio FROM INFORMATION_SCHEMA.TABLES 					WHERE table_schema='keplersc' and table_type='BASE TABLE' and TABLE_NAME LIKE 'kdc22%'					group by anio					order by anio desc";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"conpolizasView.Inicia_Forma()");				frn.set("k_anio",getXml(cubo));								Inicia_Forma();			}				fun Inicia_Forma(){				//Etiquetas 				frn.set("inp_mensaje","No se encontraron registros...");				//frn.set("inp_titulo",strTitulo);				frn.set("inp_filtros","Busqueda");				//Obtencion de registros				Buscar_Registros(0);			}			fun Buscar_Registros(bini){				var cmd, mensajeError,ok,nReg, colCriterio,criterio,expWhere,expOrder;				var tabla;				kdb.rst();				ResetResults();				if (bini == 0){					tabla="kdc1";					colCriterio="";					criterio="";				}else{					tabla="kdc1"&frn.get("k_anio",-1,0);					colCriterio=frn.get("k_filtros",-1,0);					criterio=frn.get("k_busqueda");					if (colCriterio &! "" && criterio &! ""){						expWhere = frn.get("k_filtros",-1,0);						expWhere = " where " & expWhere & "::text like '%" & frn.get("k_busqueda") & "%' ";						expOrder = " order by " & frn.get("k_filtros",-1,0);					}									}				strQuery = "select * from (select c1 as cuenta, c2 as descripcion, c14 as saldo_ini, 					c27+c28+c29+c30+c31+c32+c33+c34+c35+c36+c37+c38 as cargos,					c63+c64+c65+c66+c67+c68+c69+c70+c71+c72+c73+c74 as abonos,					c14 + c27+c28+c29+c30+c31+c32+c33+c34+c35+c36+c37+c38 -					(c63+c64+c65+c66+c67+c68+c69+c70+c71+c72+c73+c74) as saldo_fin					from keplersc." & tabla & " order by c1) as resultados ";									cmd = strQuery & expWhere & expOrder;frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdBuscar_Registros");									cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_cuentas_view.buscar_registros()");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}					Encabezados();				frn.set("results",cuboXml);				nReg=nXml(cuboXml);				regTotales = nReg;				if(nReg>0){				  frn.set("inp_mensaje","");									}				if (bini == 0){									frn.rst("k_filtros");					llenar_filtro_busqueda(cuboXml,"k_filtros");				}			}			fun llenar_filtro_busqueda(cuboResultados, cmb)			{					var valor;				var encabezados = getXmlAtt(cuboXml,"k_ColName");				var len_cubo = 1000;				var pos_ini = frn.N(cmb)+1;				frn.setX("", cmb, 0,0);				for (var cont=0; cont<len_cubo ; cont++)				{										valor = strSplit(encabezados,",",cont);										if(valor &! ""){						frn.setX(valor, cmb, cont+pos_ini,0);					}					else{						cont = len_cubo;					}				}			}			fun CalcTotales() { 				var C=0,A=0; 				for (var i=0,n=frn.N("k_saldos");i<n;i++) { 					C=C+frn.get("k_saldos",i,"cargos");					A=A+frn.get("k_saldos",i,"abonos");				}				frn.setX("TOTALES","k_saldos","tot_cuenta","mes");				frn.setX(C,"k_saldos","tot_cuenta","cargos");				frn.setX(A,"k_saldos","tot_cuenta","abonos");				C=0;				A=0; 				for (var i=0,n=frn.N("k_movtos");i<n;i++) { 					C=C+frn.get("k_movtos",i,"cargo_movto");					A=A+frn.get("k_movtos",i,"abono_movto");				}//				frn.setX("TOTALES","k_movtos","tot_movto","mes");				frn.setX(C,"k_movtos","tot_movto","cargo_movto");				frn.setX(A,"k_movtos","tot_movto","abono_movto");							}						fun abrir_poliza(){				var cmd ="",v_strTmp,v_anio, v_mes,cuboProd,ok,mensajeError;				var gen,nat,gpo,tipo,sucursal_id,anio,mes,tipo_poliza,folio,tipo_movto,param;												v_strTmp = frn.get("tabla",-1,"t_fecha");				v_anio = frn.get("k_anio");				v_mes=frn.getJ("k_saldos");				sucursal_id = frn.get("k_sucn",-1,1);				anio =frn.get("k_anio");				mes=frn.getJ("k_saldos");																gen=frn.get("k_movtos",-1,"genero");				nat=frn.get("k_movtos",-1,"naturaleza");				gpo=frn.get("k_movtos",-1,"grupo");				tipo=frn.get("k_movtos",-1,"tipo");				tipo_poliza=frn.get("k_movtos",-1,"tipopoliza");								folio=frn.get("k_movtos",-1,"k_poliza");				tipo_movto = "C";//param=gen & "," & nat &  "," & gpo & "," & tipo & "," & tipo_movto & "," & sucursal_id & "," & anio & "," & mes & "," & tipo_poliza & "," & folio;//frn.message(param,"Mensaje","Aceptar");					frn.dialog("conpolizapag.kpl",gen,nat,gpo,tipo,tipo_movto,sucursal_id,anio,mes,tipo_poliza,folio);			}												fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>