<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Libreria">	<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,20" bclr="192,205,213"><br/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="70,50,7,12" brdr="0,5" tit="Datos generales" fnt="Arial,16"><br/>		</grp><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,sys;			var bConect;//Bandera que indica si ya está conectado o no.			/*			Ejemplo de uso de librerías en Kepler.			Funcionalidad de librerías: Permiten definir códigos genéricos que se utilizarán en varias pantallas y reutilizar ese código.			Limitante: Las librería no pueden modificar objetos gráficos de la ventana padre.			Nota: A diferencia de las patallas de diálogo, al mandar llamar a una librería desde el script de la página padre, 					se detiene la ejcución de la página padre hasta que la librería le regrese el control			Las funciones de las librerías reciben, como cualquier otra función, variables XML, por lo que pueden recibir estructuras complejas.			Así mismo cada rutina devuelve una estructura(variable) XML.			Ejemplo:			=====			Función definida en librería			====			fun rutina1(elmXml1,elmXml2){				var dato1=elmXml1;				var dato2=getXml(elmXml2,"hijo","nieto",...);				var resultado;				setXml(resultado,"r0","val1","Valor de respuesta");				setXml(resultado,"r1","val1","Otro valor de respuesta");			return resultado;			}			====			Página padre:			====			var input;			setXml(input,"hijo","nieto",...,"VALOR");			var output=frn.lib("libGeneral.kpl","rutina1",450,input);			var temp;			temp=getXml(output,"r0","val1");			temp=getXml(output,"r1","val1");			*/			fun Main() {				frn=new FRNT;//Solo para frn.message, no se puede modificar objetos gráficos de la ventana principal				kdb=new KDB;				sys=new SYS;				bConect=0;				//Esta rutina se ejecuta solo la primera vez que se manda llamar alguna función de la librería. 			}			fun Conexion(){//Cuando se quiera accesar a base de datos, ejecutar esta función, antes de cualquier cosa. 				if(bConect==0){kdb.connect();bConect=1;}			}			//====================			//||Funciones generales||			//====================						//====================			//Descripcion: Ejecuta un comando sql validando resultado de ejecucion,			//  los errores se registran en un archivo texto y se regresa el xml con 			//  los resultados de la operacion			//Autor: Victor Salgado			//Fecha: 27/Julio/2021			//====================			fun EjecutarSql(expSql){				var resultado, mensaje, cubo, resultadoXML;				Conexion();				cubo = "dat";				kdb.rst();				frn.rst("results");				var cmd= expSql;						cmd = delScpScn(cmd); //Eliminar secuencias escape				resultado = 1;				kdb.native(cmd,cubo);								Valido==0 && (strlen(trim(producto))>0)){ //El producto no existe				frn.message("Entro a libreria", "Mensaje","&Aceptar");										var okCnc=kdb.exec();								if(!okCnc){					mensaje = "Sin conexión";					GuardarLog("ERROR", expSql, mensaje,"");					resultado = 0;				}else{					var ok=kdb.get(cubo,"ok");					if(ok &! "" && !ok){						var err=kdb.get(cubo,"err"),ierr=kdb.get(cubo,"ierr"),mssg=kdb.get(cubo,"mssg");						var native1=kdb.get(cubo,"native1"),native2=kdb.get(cubo,"native2"),native3=kdb.get(cubo,"native3");						mensaje = "'" & mssg & "'|" & err & "|" & ierr & "|" & native1 & "|" & native2 & "|" & native3 & "|";						GuardarLog("ERROR", expSql, mensaje,getXmlStr(kdb.get(cubo),"EOF:13_10"));						resultado = 0;					}					else					{						resultado = 1;					}										resultadoXML = kdb.get(cubo);					return resultadoXML;				}			}						//====================			//Descripcion: Guarda a disco un mensaje catalogado como error,			//  la carpeta debe existir de forma previa			//Autor: Victor Salgado			//Fecha: 27/Julio/2021			//====================			fun GuardarLog(tipoMensaje, origen, mensaje, mensajeXml){				var fileName,fecha,time,cadena;				fecha = sys.date(); //2021/07/27				time = sys.time();				fileName = "C:\Log\K80\K80_" & mid(fecha,0,4) & mid(fecha,5,2) & mid(fecha,8,2) & ".log";				cadena = fecha & " " & time & " " & tipoMensaje & " Descripcion: " & mensaje & " Origen: " & origen;				kdb.save("_"&fileName,cadena);			}						//====================			//Descripcion: Guarda a disco un mensaje formato xml en un archivo especifico,			//  la carpeta debe existir de forma previa			//Autor: Victor Salgado			//Fecha: 27/Julio/2021			//====================				fun FileSave(xmlVar,FileName){//Lectura/escritura				var documentXml = getXmlStr(xmlVar,"EOF:13_10");				kdb.save("_"&FileName&".txt",documentXml);			}					}	</script></pag>