<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Adenda">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<grp dim="70,20,7,12" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle Adenda">			<br/>			<tab n="1"/>			<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="94,12,7,12" brdr="0,5" tit="" fnt="Arial,16">					<br/>						<sp/>				<tbl id="tabla_adenda" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="92,7"  hk="z" Reorder="N" available="Y" insdel="N" nren="fijo">					<col id="k_adenda" name="Adenda" modify="N" visible= "Y" available="N"/>					<col id="k_descripcion" name="Descripci&#243;n" modify="N" visible= "Y" available="N"/>					<col id="k_segmento" name="Segmento" modify="N" visible= "Y" available="N"/>					<col id="k_variable" name="Variable" modify="N" visible= "Y" available="N"/>					<col id="k_valor" name="Valor" modify="Y" visible= "Y" available="Y" type="capital"/>				</tbl>			</grp>			<br/>			<tab n="14"/>			<bot id="bot_guardar" dim="20,0" brdr="5" text="Guardar" OnEnter="Ejecuta()" default="1"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb, externo,cliente_id,adenda_id,segmento,variable,valor,resVal;			var cmdQuery, cuboQuery, ok, mensajeError, fileSavePath;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();				fileSavePath = "C:\Basura";				externo	= frn.param(0);				cliente_id = frn.param(1);				Inicializa();			}						//<txt>Cliente:</txt><tab/>			//<inp id="k_clave" dim="15,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/>						fun Inicializa(){				PreCargaAdenda(cliente_id);			}			fun PreCargaAdenda(cliente_id){							LimpiaAdenda();				cmdQuery = "select c1 as cve_adenda " & 							"from keplersc.kdadheader " &							"where c3='" &cliente_id & "'";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.Adenda()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\kdadheader");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				adenda_id = getXmlAtt(cuboQuery,"r0","cve_adenda");				if((nXml(cuboQuery) > 0) && (adenda_id &! "")) {					//Precargas información de adendas de kdadvariables						cmdQuery = "select var.c1 as adenda,hd.c2 as desc_adenda,var.c2 as segmento,var.c3 as variable,var.c4 as valor " & 							"from keplersc.kdadvariable var " &							"inner join keplersc.kdadheader hd on hd.c1=var.c1 " &							"where var.c1='" &adenda_id & "'";					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cfd_adenda.PreCargaAdenda()");					frn.lib("libGeneral.kpl","FileSave",cuboQuery,fileSavePath &"\precargadenda");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}													frn.setX(cuboQuery,"tabla_adenda");				}			}			fun LimpiaAdenda(){				frn.setX("","tabla_adenda",-1,"k_adenda");				frn.setX("","tabla_adenda",-1,"K_descripcion");				frn.setX("","tabla_adenda",-1,"k_segmento");				frn.setX("","tabla_adenda",-1,"k_variable");				frn.setX("","tabla_adenda",-1,"k_valor");			}			fun ValidarDatos(){			var totReg, total=0, renglones;				//Validar datos de la adenda				for (var i=0,n=frn.N("tabla_adenda");i<n;i++) {					adenda_id = frn.get("tabla_adenda",i,"k_adenda");					segmento = frn.get("tabla_adenda",i,"k_segmento");					variable = frn.get("tabla_adenda",i,"k_variable");					valor = frn.get("tabla_adenda",i,"k_valor");					//frn.message("Adenda: "& adenda_id&" Segmento: "&segmento& "Variable: " &variable&" Valor: "& valor);					if ((adenda_id &!"") && (segmento &!"") && (variable &!"")){						if (valor &= "") {													frn.setPos("tabla_adenda",i,"k_valor");							resVal=0;							frn.message("El valor de la variable "&variable&"| del segmento "&segmento& " no puede quedar en blanco","Error","Aceptar");							}						if(resVal==0){							return;						}					}				}				}			fun Ejecuta() {				var continua, xmlPantalla, resultado, mensaje;				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}				continua = frn.message("¿Desea continuar con la configuración de la adenda?","Atención",2);				if (continua == 0){					return;				}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				setXml(xmlPantalla,"tabla_adenda","no_partidas",frn.N("tabla_adenda"));				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantalla_cfdAdenda");				cmdQuery="SELECT * FROM keplersc.cfd_alta_adenda('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				rstXml(cuboQuery);				cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cfd_adenda.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultado_cfdAdenda");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					frn.setAtt("tabla_adenda", "modify", "N");					frn.setAtt("bot_guardar","available","N");					frn.message("Adenda Grabada", "Mensaje", "Aceptar");				} else {					frn.message(mensaje, "Error", "Aceptar");				}			}		}	</script></pag>