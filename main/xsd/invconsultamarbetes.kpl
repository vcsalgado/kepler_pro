<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Selecci&#243;n de Registro"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,15,12" bclr="192,205,213" unfont="0">	<tab/>	<inp id="inp_titulo" dim="50,1" clr="0,0,0"  type="string" modify="N" available="N" fnt="Arial,22"/>	<br/>	<tab n="1"/>	<hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="50,45,10,10" brdr="0,5" tit="Resultado de b&#250;squeda" fnt="Arial,16">		<tab n="1"/>		<br/>		<sp/><tab/><txt>Sucursal: </txt>		<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"			OnChange="Reset_Registros()"/>		<br/>		<tab n="1"/>							<inp id="inp_filtros" dim="8,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213" 				type="string" modify="N" available="N" fnt="Arial,18"/>		<tab/>		<cmb id="k_filtros" clr="64,64,64" clrBrdr="192,205,213"  				dim="20,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  				Null="N" available="Y" tooltip="Selecciona columna base de b&#250;squeda"/>		<tab/>		<inp id="k_busqueda" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213"				type="capital"  just="L" tooltip="texto a buscar"/>		<tab n="1"/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_Registros()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>				<br/>		<tab n="1"/>		<tbl clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" brdr="1,0" id="results" dim="70,18" 			modify="N" nren="fijo" Reorder="Y" OnMouseD="Execute()">			<col name="C1" id="c1"/>		</tbl>		<tab n="1"/>		<br/>		<grp id="gpo_3" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="50,5,10,10" brdr="0,5" fnt="Arial,16" visible="S">			<tab n="1"/>			<img id="Exportar" dim="40,40" bPx="1" brdr="0,1" available="Y" img="_60_Save.png" OnEnter="guardar_tabla(results)"/> 		</grp>		<br/>	</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,cuboXml;			var expSql,titulo,mostrarRegs,perfil_usuario,suc_usuario,usuario ,rol_usuario,asterisco;			var accion,tipoOper; //Variables relacionadas con parametros			var regTotales; //variables del llenado de la tabla			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna;			var cmd,cubo,ok,mensajeError ;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");								asterisco = "*";				ConfiguraUI();				Inicializa();				mostrarRegs="S"; //Habilita consulta de registros			}						fun Encabezados(){				var colIds, totReg;				frn.rst("results");								totReg=nXml(cuboXml);				colIds=getXmlAtt(cuboXml,"k_ColName");				if(colIds &! ""){					frn.setX(colIds,"results","k_ColName");					frn.setX(getXmlAtt(cuboXml,"k_ColType"),"results","k_ColType");					frn.setX(getXmlAtt(cuboXml,"k_ColNd"),"results","k_ColNd");					frn.setAtt("llave","visible","N");				}							}			fun ConfiguraUI(){				frn.set("inp_titulo","Consulta de Marbetes"); //EL TITULO DEL REPORTE EN PANTALLA				frn.setAtt("gpo_2","Resultados de búsqueda"); //TITULO DE GRUPO EN PANTALLA							}								fun Inicializa(){				frn.rst("gpo_2");				Encabezados();				Inicia_Forma();				mostrarRegs = "N";				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invgenerarmarbets.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));								Buscar_Registros();			}				fun Inicia_Forma(){				//Etiquetas 				frn.set("inp_mensaje","No se encontraron registros...");				frn.set("inp_filtros","Búsqueda");			}			fun Reset_Registros(){				frn.rst("results");			}			fun Buscar_Registros(){				var tabla,expSelect,expWhere,expOrder;				var colCriterio, criterio, sucursal_id;				sucursal_id=frn.get("k_sucN",-1,1);				kdb.rst();				frn.rst("results");				colCriterio=frn.get("k_filtros",-1,0);				criterio=frn.get("k_busqueda");				expSelect = "select * from (select c1 as folio, c2 as parte, c3 as descripcion, c4 as loc_1, c5 as loc_2, c6 as loc_3, c7 as unidad from keplersc.kdmarbe where col_sucursal='" & sucursal_id & "' ) as resultado " ;				if (colCriterio &! "" && criterio &! ""){					expWhere = frn.get("k_filtros",-1,0);					expWhere = " where " & expWhere & "::text like '%" & frn.get("k_busqueda") & "%' ";					expOrder = " order by " & frn.get("k_filtros",-1,0);				}				if(mostrarRegs &= "N"){					expWhere = " where 1=0 ";				}				expSelect = expSelect & expWhere & expOrder;				frn.lib("libGeneral.kpl","FileSave",expSelect,"C:\Basura\cuboXml");				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",expSelect ,"gencatalogoview.buscar_registros()");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}					Encabezados();				frn.set("results",cuboXml);				var nReg=nXml(cuboXml);				regTotales = nReg;				if(nReg>0){				  frn.set("inp_mensaje","");									}				if(mostrarRegs &= "N"){ //Inicio de formulario					frn.rst("k_filtros");					llenar_filtro_busqueda(cuboXml,"k_filtros");								}			}			fun llenar_filtro_busqueda(cuboResultados, cmb)			{					var valor;				var encabezados = getXmlAtt(cuboXml,"k_ColName");				var len_cubo = 1000;				var pos_ini = frn.N(cmb)+1;				frn.setX("", cmb, 0,0);				for (var cont=0; cont<len_cubo ; cont++)				{										valor = strSplit(encabezados,",",cont);										if(valor &! ""){						frn.setX(valor, cmb, cont+pos_ini,0);					}					else{						cont = len_cubo;					}				}			}					fun Execute(){				var valorSel, renSel,mensaje;				valorSel = "";				mensaje="Opcion Normal";				renSel = frn.getJ("results");				if(renSel > -1){					valorSel = frn.get("results",renSel,strColValor);				}				if(strRenglon &= "0" )				{					frP.set(strCtrlSet,valorSel);					frP.scriptElm(strCtrlSet,"OnChange");				}				else				{//	valor | ID_elemento | strRenglon (o puede ser -1 actual)| strColumna					frP.setX(valorSel,strCtrlSet,-1,strColumna);														frP.scriptElm(strCtrlSet,"OnChange",strColumna);				}								frn.exit();			}						fun guardar_tabla(tabla){				var save = frn.saveFile("tabla","Todos los archivos,*.*","_C:","Para guardar archivo");				frn.dialog("guarda_tabla",tabla,save); 			}						//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------/*						fun llenar_cmb(cuboResultados, cmb){				var len_cubo = nXml(cuboResultados);				var pos_ini = frn.N(cmb);				for (var cont=0; cont<len_cubo ; cont++){					var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");					frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);				}				}						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}*/		}	</script></pag>