<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Solicita Cotizacion"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0">	<br/>	<tab/><inp id="inp_titulo" clr="0,0,0" dim="80,1"  clrBrdr="255,255,255" type="string" modify="N" available="N" fnt="Arial,22"/>	<br/><tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp dim="68,45,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Solicita Cotizacion">					<tab n="1"/><txt clr="0,58,112" hk="S">Sucursal: </txt>			<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><sp n="1"/>						<tab n="1"/><txt id="txt_folio" visible="N">Folio:</txt>			<inp id="folio" dim="9,1"  OnF9="ObtenerFolio()" brdr="2,0" clr="64,64,64"  tooltip="F9 Cotizaciones" OnChange="borrar_datos()" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/>	<sp/>						<img id="bot_buscar" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>			<br/>								<br/>			<tab/>			<txt>Orden: </txt><sp/>			<cmb id="tipo_orden" clr="64,64,64" clrBrdr="255,255,255"  dim="31,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="valida_orden()"  available="Y"/><sp/>			<inp id="folio_orden" dim="8,1" brdr="2,0" clr="64,64,64"  OnChange="Formar_folio()"  OnF9="ObtenerOrdenes()" tooltip="F9 Ordenes" type="folio" bclr="255,255,255" clrBrdr="255,255,255"/><sp/>					<tab n="1"/><txt id="txt_fecha_solicitud" visible="N">Fecha:</txt>			<edt id="fecha_solicitud" dim="9,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_solicitud" OnF9="Dialog(3,_ks_fecha,fecha_solicitud)"  modify="N" bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" brdr="2,0" visible="N"/>								<br/>						<tab/><txt>Operario: </txt>			<cmb id="operario" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/>			<tab n="1"/><txt id="txt_hora_solicitud" visible="N">Hora:</txt>			<inp id="hora_solicitud" dim="4,1" nc="-1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="time" brdr="2,0" visible="N"/>				<br/>			<tab/><txt>Asesor: </txt><sp/>			<cmb id="asesor" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><br/>							<tab/><txt>Cliente: </txt><sp/>			<inp id="cliente" dim="8,1"  brdr="2,0" clr="64,64,64" bclr="255,255,255"  modify="N" clrBrdr="255,255,255"/><sp/>			<inp id="nombre_cli" dim="31,1"  brdr="2,0" clr="64,64,64" bclr="255,255,255" modify="N" clrBrdr="255,255,255"/><sp/>						<br/>											<tab/><txt>Serie: </txt><tab/>			<inp id="serie" dim="16,1"  brdr="2,0" clr="64,64,64" bclr="255,255,255"  modify="N" clrBrdr="255,255,255"/><sp/>			<tab/><txt>Placas: </txt><sp/>			<inp id="placas" dim="16,1"  brdr="2,0" clr="64,64,64" bclr="255,255,255" modify="N" clrBrdr="255,255,255"/><sp/>									<br/>									<tab/><txt>Marca: </txt><sp/>			<inp id="marca" dim="16,1"  brdr="2,0" clr="64,64,64" bclr="255,255,255"  modify="N" clrBrdr="255,255,255"/><sp/>			<tab/><txt>Modelo: </txt><sp/>			<inp id="modelo" dim="16,1"  brdr="2,0" clr="64,64,64" bclr="255,255,255" modify="N" clrBrdr="255,255,255"/><sp/>								<br/><br/>			<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="62,10">				<col id="num_punto" type="number" name="Punto"/>				<col id="desc" name="Descripcion"/>						</tbl> 					<br/><br/>			<tab n="17"/><sp/><bot id="bot_guardar" dim="12,0" brdr="5" text="Guardar" default="0" OnEnter="Ejecuta()" visible="Y"/>				</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco, externo ;			var folio_cotizacion, tipo_mov  ; //Variables relacionadas con parametros			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";								tipo_mov = trim(frn.param(0));															Inicializa();								controles_off();						}												fun Inicializa(){				var cmd,cubo,ok,mensajeError ;						//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));				frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));																//Llenar combo tipo orden				cmd = "select c1||'-'||c3 as descripcion, c1 as clave  from keplersc.kdmargen";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"solicitacotizacion.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){				   mensajeError = getXmlAtt(cubo,"native3");				   mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						   var cmd_tipo_orden = "tipo_orden";				frn.setX("", cmd_tipo_orden ,0,0);				frn.setX("", cmd_tipo_orden , 0, 1);									llenar_cmb(cubo ,cmd_tipo_orden );												//Llenar combo operarios				cmd = "select '['||c1||'] '||c3 as descripcion, c1 as clave from keplersc.kdoper where c12='S' ";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"solicitacotizacion.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){				   mensajeError = getXmlAtt(cubo,"native3");				   mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						   var cmd_operarios = "operario";				frn.setX("", cmd_operarios ,0,0);				frn.setX("", cmd_operarios , 0, 1);									llenar_cmb(cubo ,cmd_operarios );														//Llenar combo asesores				cmd = "select '['||c1||'] '||c2 as descripcion, c1 as clave from keplersc.kdrecep where c11='S' ";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"solicitacotizacion.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){				   mensajeError = getXmlAtt(cubo,"native3");				   mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						   var cmd_asesor = "asesor";				frn.setX("", cmd_asesor ,0,0);				frn.setX("", cmd_asesor , 0, 1);									llenar_cmb(cubo ,cmd_asesor );							}						fun borrar_datos(){				frn.set("tipo_orden",descr_combo("tipo_orden",1, ""));					frn.rst("folio_orden");				frn.rst("cliente");				frn.rst("nombre_cli");				frn.rst("serie");				frn.rst("placas");				frn.rst("marca");				frn.rst("modelo");				frn.set("operario",descr_combo("operario",1, ""));					frn.set("asesor",descr_combo("asesor",1, ""));					frn.rst("fecha_solicitud");				frn.rst("hora_solicitud");				frn.rst("tabla");										}									fun controles_off(){						frn.setAtt("txt_folio", "visible", "N");				frn.setAtt("folio", "visible", "N");				frn.setAtt("bot_buscar", "visible", "N");				frn.setAtt("txt_fecha_solicitud", "visible", "N");				frn.setAtt("txt_hora_solicitud", "visible", "N");				frn.setAtt("fecha_solicitud", "visible", "N");				frn.setAtt("hora_solicitud", "visible", "N");				frn.setAtt("bot_guardar", "visible", "Y");					if (tipo_mov &= "modificacion"){					frn.set("inp_titulo", "Modifica Solicita Cotizacion");					frn.setAtt("txt_folio", "visible", "Y");					frn.setAtt("folio", "visible", "Y");					frn.setAtt("bot_buscar", "visible", "Y");					frn.setAtt("txt_fecha_solicitud", "visible", "Y");					frn.setAtt("txt_hora_solicitud", "visible", "Y");					frn.setAtt("fecha_solicitud", "visible", "Y");					frn.setAtt("hora_solicitud", "visible", "Y");								}else{					frn.set("inp_titulo", "Alta Solicita Cotizacion");				}						}									fun ObtenerFolio() {				var sucursal_id = frn.get("k_sucN",-1,1);				var cmdQuery = "select c2 as folio, to_char(c3,'dd/mm/yyyy') as fecha_solicitud, c4 as hora_solicitud from keplersc.kdsercot where c1='" & sucursal_id  & "' order by c2 desc "									frn.dialog("genlistafiltrosel","Folios de Cotizaciones",cmdQuery,"folio","folio","0","0","N","S");							}											fun ObtenerOrdenes() {				var cmdQuery = "select c2 as tipo, c3 as folio, to_char(c4, 'dd/mm/yyyy') as fecha, c6 as serie, c11 as cliente from keplersc.kdord where c8 <> 50 and c1 ='" & frn.get("k_sucN",-1,1) & "'";								var tipo_orden = frn.get("tipo_orden", -1, 1);								if (tipo_orden &! ""){									cmdQuery = cmdQuery & " and c2='" & tipo_orden  & "'";								}								cmdQuery = cmdQuery & " order by c3 desc ";									frn.dialog("genlistafiltrosel","Ordenes de Servicio",cmdQuery,"folio","folio_orden","0","0","N","S");							}								fun Formar_folio(){							var xmlReqEst, cubofol, cmd, ok, mensajeError ;				if (frn.get("folio_orden") &! ""){				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucN",-1,1));					setXml(xmlReqEst,"document","folio_id",frn.get("folio_orden"));										cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";					cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"solicitacotizacion.Formar_folio()");					frn.lib("libGeneral.kpl","FileSave",cubofol,"C:\Basura\cuboFol");									var resultado =getXmlAtt(cubofol,"r0", "resultado");					if(resultado &= "0"){						mensajeError = getXmlAtt(cubofol,"r0", "mensaje");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					var fol = getXmlAtt(cubofol,"r0", "mensaje");										frn.set("folio_orden", fol);				}								valida_orden();			}												fun valida_orden(){							var sucursal_id = frn.get("k_sucN",-1,1);				var folio_orden = frn.get("folio_orden");								if (folio_orden &= ""){					return ;				}         				var cmd = "select ord.c3, ord.c10, ord.c11,  ord.c6, ord.c21, ser.c2 as marca , ser.c3 as modelo " &				" from keplersc.kdord as ord  inner join keplersc.kdserie as ser on ser.c1=ord.c6 " &				" where ord.c1='" & sucursal_id & "' and ord.c3='" & folio_orden & "'";								var tipo_orden = frn.get("tipo_orden", -1, 1);								if (tipo_orden &! ""){									cmd = cmd & " and ord.c2='" & tipo_orden  & "'";								}								var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"solicitacotizacion.valida_orden()");							var ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var len_result = nXml(cubo);								if (len_result == 0){					frn.message("La Orden ingresada no existe","Error","Aceptar");					frn.set("folio_orden", "");					frn.set("cliente", "");					frn.set("nombre_cli", "");					frn.set("serie", "");					frn.set("placas", "");					frn.set("marca", "");					frn.set("modelo", "");										return;				}												frn.set("cliente",getXmlAtt(cubo,"r0", "c10"));				frn.set("nombre_cli",getXmlAtt(cubo,"r0", "c11"));				frn.set("serie",getXmlAtt(cubo,"r0", "c6"));				frn.set("placas",getXmlAtt(cubo,"r0", "c21"));				frn.set("marca",getXmlAtt(cubo,"r0", "marca"));				frn.set("modelo",getXmlAtt(cubo,"r0", "modelo"));						   			}											fun Ejecuta(){							if (tipo_mov &= "alta"){					Guardar("Nuevo");				}else{					Guardar("Modifica");				}						}										fun Guardar(crud){							var xmlRequest ,cmd, cubo,ok ,mensajeError ;						xmlRequest = getXml(frn.dataPag()); //Obtener el xml de la pantalla;							setXml(xmlRequest ,"ctd_puntos",frn.N("tabla") - 1);				setXml(xmlRequest ,"crud",crud);				setXml(xmlRequest ,"modulo","SOLICITA");				setXml(xmlRequest ,"usuario",usuario);								frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequestAlta ");								cmd="SELECT * FROM keplersc.ser_cotizaciones_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"solicitacotizacion.Alta()");										frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");							var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								if(resultado &= "1"){					var mensaje = getXml(cubo ,"mensaje");					frn.message(mensaje ,"Atencion","Aceptar");				}								folio_cotizacion = getXml(cubo ,"adicionales");								if (tipo_mov &= "alta"){					frn.setAtt("bot_guardar", "visible", "N");				}						}						fun Buscar(){							var cmd, cubo, ok,mensajeError ; 								var sucursal_id = frn.get("k_sucN",-1,1);				var fol_cotizacion = frn.get("folio");								cmd="select c3,c4,c12,c13,c21,c22,c30,c31 from keplersc.kdsercot " &				" where c1='" & sucursal_id  & "' and c2='" & fol_cotizacion  & "'";									frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmd");									rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"solicitacotizacion.Buscar()");				frn.lib("libGeneral.kpl","FileSave",cubo,"c:\Basura\cubo");										ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("fecha_solicitud", getXmlAtt(cubo, "r0" , "c3"));				frn.set("hora_solicitud", getXmlAtt(cubo, "r0" , "c4"));				frn.set("tipo_orden",descr_combo("tipo_orden",1,getXmlAtt(cubo, "r0" , "c12")));					frn.set("folio_orden", getXmlAtt(cubo, "r0" , "c13"));				frn.set("operario",descr_combo("operario",1,getXmlAtt(cubo, "r0" , "c21")));					frn.set("asesor",descr_combo("asesor",1,getXmlAtt(cubo, "r0" , "c22")));					frn.set("cliente", getXmlAtt(cubo, "r0" , "c30"));				frn.set("nombre_cli", getXmlAtt(cubo, "r0" , "c31"));												cmd="select c3 as num_punto, c4 as desc from keplersc.kdsercotdet where c1='" & sucursal_id   & "' and c2='" & fol_cotizacion  & "'";								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdpun");									rstXml(cubo);								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"solicitacotizacion.Buscar()");										frn.set("tabla",getXml(cubo));									valida_orden();							}						//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------									fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>