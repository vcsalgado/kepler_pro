inf-taller-obspt2");						}						if (strlen(dt27>0)||strlen(dt28>0)){							rep.exe("section-inf-taller-obspt3");						}						rep.exe("section-inf-taller-2");						dato_id = "";						cmdQuery = "select c12 as cu12 from keplersc.kdusrinfo where c1 = '" & dt18 & "'";						rstXml(xmlDet);						xmlDet = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");						frn.lib("libGeneral.kpl","FileSave",xmlDet, fileSavePath & "\ser_ordenrpt_data_se_rpt");						ok=getXmlAtt(xmlDet,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(xmlDet,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;						}						dato_id = getXmlAtt(xmlDet,"r0", "cu12");						if ( strlen(dato_id) == 0 ) {							// Not records found						} else {							cu12 = getXmlAtt(xmlDet,"r0", "cu12");							rep.set("inftaller_usrcal",cu12);							rep.exe("section-inf-taller-usr");						}										}															// Horas ...					dato_id = "";					cmdQuery = "select c6 as t6, c7 as t7, c8 as t8, c14 as t14 from keplersc.kdhoras " &					"where c1 = '" & sucursal_id & "' and c2 = '" & v_tipoorden & "'" & " and c3 = '" & v_folio & "' and c4 = " & punto;					rstXml(xmlAlt);					xmlAlt = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");					frn.lib("libGeneral.kpl","FileSave",xmlAlt, fileSavePath & "\ser_ordenrpt_data_t_rpt");					ok=getXmlAtt(xmlAlt,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(xmlAlt,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										if (nXml(xmlAlt) > 0) { rep.exe("section-horas"); }										if (nXml(xmlAlt) > 0) {											for(var yx=0; yx < nXml(xmlAlt); yx++)						{														t6 = getXmlAtt(xmlAlt,"r"&yx,"t6");							t7 = getXmlAtt(xmlAlt,"r"&yx,"t7");							t8 = getXmlAtt(xmlAlt,"r"&yx,"t8");							t14 = getXmlAtt(xmlAlt,"r"&yx,"t14");														b2 = t8 * t14;							b10 = b10 + b2;																			rep.set("horas_cve",t6);							rep.set("horas_dscr",t7);							rep.set("horas_cant",t8);							rep.set("horas_importe",b2);																	rep.exe("section-horas-det");													}									}										if (nXml(xmlAlt) > 0) { rep.exe("section-horas_line"); }					// END Horas ...															// Refacciones ...					dato_id = "";					cmdQuery = "select c5 as u5, c6 as u6, c7 as u7, c8 as u8, c9 as u9, c11 as u11, c12 as u12, c13 as u13, c14 as u14, " &					"c15 as u15, c16 as u16 from keplersc.kdref " &					"where c1 = '" & /*"02"*/sucursal_id & "' and c2 = '" & v_tipoorden & "'" & " and c3 = '" & v_folio & "' and c4 = " & punto;					rstXml(xmlAlt);					xmlAlt = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");					frn.lib("libGeneral.kpl","FileSave",xmlAlt, fileSavePath & "\ser_ordenrpt_data_u_rpt");					ok=getXmlAtt(xmlAlt,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(xmlAlt,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										if (nXml(xmlAlt) > 0) { rep.exe("section-refacc"); }										if (nXml(xmlAlt) > 0) {											for(var yx=0; yx < nXml(xmlAlt); yx++)						{														u5 = getXmlAtt(xmlAlt,"r"&yx,"u5");							u6 = getXmlAtt(xmlAlt,"r"&yx,"u6");							u7 = getXmlAtt(xmlAlt,"r"&yx,"u7");							u8 = getXmlAtt(xmlAlt,"r"&yx,"u8");							u9 = getXmlAtt(xmlAlt,"r"&yx,"u9");							u11 = getXmlAtt(xmlAlt,"r"&yx,"u11");							u12 = getXmlAtt(xmlAlt,"r"&yx,"u12");							u13 = getXmlAtt(xmlAlt,"r"&yx,"u13");							u14 = getXmlAtt(xmlAlt,"r"&yx,"u14");							u15 = getXmlAtt(xmlAlt,"r"&yx,"u15");							u16 = getXmlAtt(xmlAlt,"r"&yx,"u16");														b1 = u15;							b2 = u16;							b11 = b11 + b2;														r10 = u5 & u6 & PadLeft(u7,"2","0") & PadLeft(u8,"3","0") & "-" & u9;														rep.set("refacc_folio",r10);												rep.set("refacc_cve",u11);							rep.set("refacc_dscr",u12);							rep.set("refacc_cant",u13);							rep.set("refacc_um",u14);							rep.set("refacc_unit",b1);							rep.set("refacc_importe",b2);																	rep.exe("section-refacc-det");													}									}										if (nXml(xmlAlt) > 0) { rep.exe("section-refacc_line"); }					// END Refacciones ...																			// TOTs ...					dato_id = "";					cmdQuery = "select c5 as v5, c6 as v6, c7 as v7, c8 as v8, c9 as v9, c10 as v10, c16 as v16 " &					"from keplersc.kdtot " &					"where c1 = '" & /*"02"*/sucursal_id & "' and c2 = '" & v_tipoorden & "'" & " and c3 = '" & v_folio & "' and c4 = " & punto;					rstXml(xmlAlt);					xmlAlt = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");					frn.lib("libGeneral.kpl","FileSave",xmlAlt, fileSavePath & "\ser_ordenrpt_data_v_rpt");					ok=getXmlAtt(xmlAlt,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(xmlAlt,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										if (nXml(xmlAlt) > 0) { rep.exe("section-tots"); }										if (nXml(xmlAlt) > 0) {											for(var yx=0; yx < nXml(xmlAlt); yx++)						{														v5 = getXmlAtt(xmlAlt,"r"&yx,"v5");							v6 = getXmlAtt(xmlAlt,"r"&yx,"v6");							v7 = getXmlAtt(xmlAlt,"r"&yx,"v7");							v8 = getXmlAtt(xmlAlt,"r"&yx,"v8");							v9 = getXmlAtt(xmlAlt,"r"&yx,"v9");							v10 = getXmlAtt(xmlAlt,"r"&yx,"v10");							v16 = getXmlAtt(xmlAlt,"r"&yx,"v16");																		b1 = v16;							b12 = b12 + b1;														r10 = v5 & v6 & PadLeft(v7,"2","0") & PadLeft(v8,"3","0") & "-" & v9;														rep.set("tots_folio",r10);												rep.set("tots_dscr",v10);							rep.set("tots_importe",b1);																	rep.exe("section-tots-det");													}									}										if (nXml(xmlAlt) > 0) { rep.exe("section-tots_line"); }					// END TOTs ...										// Cargos Varios ...					dato_id = "";					cmdQuery = "select c6 as w6, c7 as w7, c10 as w10 " &					"from keplersc.kdcar " &					"where c1 = '" & sucursal_id & "' and c2 = '" & v_tipoorden & "'" & " and c3 = '" & v_folio & "' and c4 = " & punto;					rstXml(xmlAlt);					xmlAlt = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");					frn.lib("libGeneral.kpl","FileSave",xmlAlt, fileSavePath & "\ser_ordenrpt_data_w_rpt");					ok=getXmlAtt(xmlAlt,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(xmlAlt,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										if (nXml(xmlAlt) > 0) { rep.exe("section-carg"); }										if (nXml(xmlAlt) > 0) {											for(var yx=0; yx < nXml(xmlAlt); yx++)						{														w6 = getXmlAtt(xmlAlt,"r"&yx,"w6");							w7 = getXmlAtt(xmlAlt,"r"&yx,"w7");							w10 = getXmlAtt(xmlAlt,"r"&yx,"w10");																		b1 = w10;							b13 = b13 + b1;														rep.set("carg_cve",w6);												rep.set("carg_dscr",w7);							rep.set("carg_importe",b1);																	rep.exe("section-carg-det");													}									}										if (nXml(xmlAlt) > 0) { rep.exe("section-carg_line"); }					// END Cargos Varios ...					rep.exe("section-puntos-det-final");									}	// End For PUNTOS {cuboQuery}						//if (nXml(cuboQuery) > 0) { rep.exe("section-puntos-final"); }								// DATOS TOTALES ORDEN 								h11 = 0;								dato_id = "";				cmdQuery = "select c11 as h11 from keplersc.kdmargen where c1 = '" & v_tipoorden & "'";				rstXml(xmlDet);				xmlDet = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",xmlDet, fileSavePath & "\ser_ordenrpt_data_h_rpt");				ok=getXmlAtt(xmlDet,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlDet,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(xmlDet,"r0", "h11");				if ( strlen(dato_id) == 0 ) {					// Not records found				} else {					h11 = getXmlAtt(xmlDet,"r0", "h11");				}					b14 = 0;				b15 = 0;				b16 = 0;				b17 = 0;				b18 = 0;								b14 = b10 + b11 + b12 + b13;				b16 = b14 - b15;				b17 = (b16 * h11) / 100;				b18 = b16 + b17;								rep.set("totord_mo",b10);									rep.set("totord_ref",b11);				rep.set("totord_tots",b12);				rep.set("totord_carg",b13);								rep.set("totord_subt1",b14);				rep.set("totord_desc",b15);				rep.set("totord_subt2",b16);				rep.set("totord_iva",b17);				rep.set("totord_total",b18);								rep.exe("section-totales-orden");												// DATOS FACTURACION ORDEN 								dato_id = "";				cmdQuery = "select c6 as g6, c51 as g51, c52 as g52, c53 as g53, c54 as g54, c9 as g9, c10 as g10, c32 as g32, c33 as g33, " & 				"c34 as g34, c35 as g35, c22 as g22, c51 as g51, c52 as g52, c53 as g53, c54 as g54, c13 as g13, c14 as g14, c16 as g16 " & 				"from keplersc.kdm1 where c1 = '" & i1 & "' and c2 = '" & i40 & "'" & " and c3 = '" & i41 & "' and c6 = '" & i44 & "' " &				" and c4 = " & i42 & " and c5 = " & i43;				rstXml(xmlAlt);				xmlAlt = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",xmlAlt, fileSavePath & "\ser_ordenrpt_data_g_rpt");				ok=getXmlAtt(xmlAlt,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlAlt,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(xmlAlt,"r0", "g6");				if ( strlen(dato_id) == 0 ) {					// Not records found				} else {					sucursal_id=frn.get("k_sucn",-1,1);							dato_id = "";					cmdQuery = "select c5 as f5 from keplersc.kdmm " & 					"where c1 = '" & i40 & "' and c2 = '" & i41 & "'" & " and c3 = " & i42 & " and c4 = " & i43 & " and col_sucursal='" & sucursal_id & "'"; 					rstXml(xmlDet);					xmlDet = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");					frn.lib("libGeneral.kpl","FileSave",xmlDet, fileSavePath & "\ser_ordenrpt_data_f_rpt");					ok=getXmlAtt(xmlDet,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(xmlDet,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					dato_id = getXmlAtt(xmlDet,"r0", "f5");					if ( strlen(dato_id) == 0 ) {						// Not records found					} else {						f5 = getXmlAtt(xmlDet,"r0", "f5");					}									g51 = getXmlAtt(xmlAlt,"r0", "g51");					g52 = getXmlAtt(xmlAlt,"r0", "g52");					g53 = getXmlAtt(xmlAlt,"r0", "g53");					g54 = getXmlAtt(xmlAlt,"r0", "g54");					g9 = getXmlAtt(xmlAlt,"r0", "g9");					g10 = getXmlAtt(xmlAlt,"r0", "g10");					g32 = getXmlAtt(xmlAlt,"r0", "g32");					g33 = getXmlAtt(xmlAlt,"r0", "g33");					g34 = getXmlAtt(xmlAlt,"r0", "g34");					g35 = getXmlAtt(xmlAlt,"r0", "g35");					g22 = getXmlAtt(xmlAlt,"r0", "g22");					g51 = getXmlAtt(xmlAlt,"r0", "g51");					g52 = getXmlAtt(xmlAlt,"r0", "g52");					g53 = getXmlAtt(xmlAlt,"r0", "g53");					g54 = getXmlAtt(xmlAlt,"r0", "g54");					g13 = getXmlAtt(xmlAlt,"r0", "g13");					g14 = getXmlAtt(xmlAlt,"r0", "g14");					g16 = getXmlAtt(xmlAlt,"r0", "g16");										r10 = i40 & i41 & PadLeft(i42,"2","0") & PadLeft(i43,"3","0") & "-" & i44;					b1 = g51 + g52 + g53 + g54;										rep.set("docfech",g9);					rep.set("docfolio",r10);					rep.set("docdscr",f5);										rep.set("factcve",g10);					rep.set("factclie",g32);					rep.set("factdir",g33);					rep.set("factcol",g34);					rep.set("factedo",g35);					rep.set("factrfc",g22);										rep.set("fact_mo",g51);					rep.set("fact_ref",g52);					rep.set("fact_tots",g53);					rep.set("fact_carg",g54);										rep.set("fact_subt",b1);					rep.set("fact_desc",g13);					rep.set("fact_iva",g14);					rep.set("fact_total",g16);									rep.exe("section-fact");									}															// Historial Documentos ...				dato_id = "";				cmdQuery = "select c6 as cv6, c7 as cv7, c8 as cv8, c9 as cv9, c10 as cv10, c11 as cv11, c12 as cv12, c13 as cv13, " &				"c20 as cv20, c21 as cv21, c22 as cv22, c23 as cv23, c24 as cv24, c25 as cv25, c26 as cv26 " & 				"from keplersc.kdvntall " &				"where c1 = '" & i1 & "' and c2 = '" & i2 & "'" & " and c3 = '" & i3 & "'";				rstXml(xmlAlt);				xmlAlt = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",xmlAlt, fileSavePath & "\ser_ordenrpt_data_cv_rpt");				ok=getXmlAtt(xmlAlt,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlAlt,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									/*if (nXml(xmlAlt) > 0) { rep.exe("section-carg"); }*/ // This N.A. for this section 								rep.exe("section-hist");									if (nXml(xmlAlt) > 0) {										for(var yx=0; yx < nXml(xmlAlt); yx++)					{													cv6 = getXmlAtt(xmlAlt,"r"&yx,"cv6");						cv7 = getXmlAtt(xmlAlt,"r"&yx,"cv7");						cv8 = getXmlAtt(xmlAlt,"r"&yx,"cv8");						cv9 = getXmlAtt(xmlAlt,"r"&yx,"cv9");						cv10 = getXmlAtt(xmlAlt,"r"&yx,"cv10");						cv11 = getXmlAtt(xmlAlt,"r"&yx,"cv11");						cv12 = getXmlAtt(xmlAlt,"r"&yx,"cv12");						cv13 = getXmlAtt(xmlAlt,"r"&yx,"cv13");						cv20 = getXmlAtt(xmlAlt,"r"&yx,"cv20");						cv21 = getXmlAtt(xmlAlt,"r"&yx,"cv21");						cv22 = getXmlAtt(xmlAlt,"r"&yx,"cv22");						cv23 = getXmlAtt(xmlAlt,"r"&yx,"cv23");						cv24 = getXmlAtt(xmlAlt,"r"&yx,"cv24");						cv25 = getXmlAtt(xmlAlt,"r"&yx,"cv25");						cv26 = getXmlAtt(xmlAlt,"r"&yx,"cv26");												r10 = "";						r11 = "";						r12 = "";						rc = "";								b1 = cv20 + cv21 + cv22 + cv23;						r10 = cv6 & cv7 & PadLeft(cv8,"2","0") & PadLeft(cv9,"3","0") & "-" & cv10;												sucursal_id=frn.get("k_sucn",-1,1);								dato_id = "";						cmdQuery = "select c5 as f5 from keplersc.kdmm " & 						"where c1 = '" & cv6 & "' and c2 = '" & cv7 & "'" & " and c3 = " & cv8 & " and c4 = " & cv9 & " and col_sucursal='" & sucursal_id & "'"; 						rstXml(xmlDet);						xmlDet = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");						frn.lib("libGeneral.kpl","FileSave",xmlDet, fileSavePath & "\ser_ordenrpt_data_f_rpt");						ok=getXmlAtt(xmlDet,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(xmlDet,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;						}						dato_id = getXmlAtt(xmlDet,"r0", "f5");						if ( strlen(dato_id) == 0 ) {							// Not records found						} else {							f5 = getXmlAtt(xmlDet,"r0", "f5");							r11 = f5;						}																		dato_id = "";						cmdQuery = "select c3 as d3 from keplersc.kdud " & 						"where c2 = '" & cv12 & "'"; 						rstXml(xmlDet);						xmlDet = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");						frn.lib("libGeneral.kpl","FileSave",xmlDet, fileSavePath & "\ser_ordenrpt_data_d_rpt");						ok=getXmlAtt(xmlDet,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(xmlDet,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;						}						dato_id = getXmlAtt(xmlDet,"r0", "d3");						if ( strlen(dato_id) == 0 ) {							// Not records found						} else {							d3 = getXmlAtt(xmlDet,"r0", "d3");							r12 = d3;						}																			rc = "[" & cv12 & "]  " & r12;												rep.set("hist_fech",cv11);											rep.set("hist_folio",r10);						rep.set("hist_tipo",r11);						rep.set("hist_clie",rc);						rep.set("hist_asesor",cv13);													rep.set("hist_mo",cv20);											rep.set("hist_ref",cv21);						rep.set("hist_tots",cv22);						rep.set("hist_carg",cv23);												rep.set("hist_sub",b1);						rep.set("hist_iva",cv25);						rep.set("hist_total",cv26);																			rep.exe("section-hist-det");												}								}									/*if (nXml(xmlAlt) > 0) { rep.exe("section-carg_line"); }*/ // This N.A. for this section 								// END Historial Documentos ...														//rep.exe("endrep");														//Modos de impresión 				rep.win(); //Muestra la vista previa de la impresión. A partir de la vista previa (Preprint) se decide si se imprime o no.				//rep.print("\\192.168.1.100\HPLaserJet"); //Envía el reporte directamente a una impresora, sin mostrar la vista previa.				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresión. No muestra la vista previa.				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardará el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html										} /* END Func Reporte() */			// END : ZONA	CODIGO REPORTE(S)			//MSS Se usa funcion y se corrige separacion de palabras, numeros los omite y/o pasa al sig renglon, y que no ponga palabras que no continuan			fun textos_largos(texto,input){				var renglon1=0,renglon2=0,renglon3=0;				var strObservaciones = texto;				var num_strObservaciones = strSplit(strObservaciones," ",-1);				var observaciones1 = "";				var observaciones2 = "";				var observaciones3 = "";								for (var palabra=0; palabra<num_strObservaciones ;palabra++){					if ((strlen(observaciones1)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon1 == 0){						observaciones1 = observaciones1 & strSplit(strObservaciones," ", palabra) & " ";					}					else{						if ((strlen(observaciones2)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon2 == 0){							renglon1= 1;							observaciones2 = observaciones2 & strSplit(strObservaciones," ", palabra) & " ";						}						else{							if ((strlen(observaciones3)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon3 == 0){								renglon2= 1;								observaciones3 = observaciones3 & strSplit(strObservaciones," ", palabra) & " ";							}							}					}					}				rep.set(input,observaciones1);				rep.set(input & "2",observaciones2);				rep.set(input & "3",observaciones3);							}						//MSS Se usa funcion y se corrige separacion de palabras, numeros los omite y/o pasa al sig renglon, y que no ponga palabras que no continuan 			fun textos_largos_1(texto,input){				var renglon1=0,renglon2=0,renglon3=0,renglon4=0,renglon5=0,renglon6=0;				var strObservaciones = texto;				var num_strObservaciones = strSplit(strObservaciones," ",-1);				var observaciones1 = "";				var observaciones2 = "";				var observaciones3 = "";				var observaciones4 = "";				var observaciones5 = "";				var observaciones6 = "";				for (var palabra=0; palabra<num_strObservaciones ;palabra++){					if ((strlen(observaciones1)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon1 == 0){						observaciones1 = observaciones1 & strSplit(strObservaciones," ", palabra) & " ";					}					else{						if ((strlen(observaciones2)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon2 == 0){							renglon1= 1;							observaciones2 = observaciones2 & strSplit(strObservaciones," ", palabra) & " ";						}						else{							if ((strlen(observaciones3)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon3 == 0){								renglon2= 1;								observaciones3 = observaciones3 & strSplit(strObservaciones," ", palabra) & " ";													}							else{								if ((strlen(observaciones4)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon4 == 0){									renglon3= 1;									observaciones4 = observaciones4 & strSplit(strObservaciones," ", palabra) & " ";								}								else{									if ((strlen(observaciones5)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon5 == 0){										renglon4= 1;										observaciones5 = observaciones5 & strSplit(strObservaciones," ", palabra) & " ";									}else{										if ((strlen(observaciones6)+strlen(strSplit(strObservaciones," ", palabra)))<100 && renglon6 == 0){											renglon5= 1;											observaciones6 = observaciones6 & strSplit(strObservaciones," ", palabra) & " ";										}									}								}							}						}					}					}				rep.set(input & "1",observaciones1);				rep.set(input & "2",observaciones2);				rep.set(input & "3",observaciones3);				rep.set(input & "4",observaciones4);				rep.set(input & "5",observaciones5);				rep.set(input & "6",observaciones6);			}										} // End of class Main			</script></pag>