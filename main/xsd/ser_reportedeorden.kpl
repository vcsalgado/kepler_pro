<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<tab/><txt fnt=",22" clr="0,0,0">Reporte Orden de Servicio</txt><br/> 	<tab/><hLine clr="0,0,0"/> 	<br/> <br/>		<tab/>		<grp dim="48,11,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">			<br/>			<txt>  Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>			<br/>			<txt>  Tipo :        </txt>			<cmb id="k_tipon" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="CambiaTipo()" available="Y" modify="Y"/>			<br/>			<txt id="textFolio" visible="Y">  Folio :       </txt>			<edt id="k_folio" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" visible="Y" OnButton="ObtenerFolios()" OnF9="ObtenerFolios()" OnChange="BuscarFolio()"/> 			<br/>		</grp>		<sp/>		<grp dim="36,11,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<br/>			<sp n="1"/>			<txt>  Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N"/> 			<sp n="1"/> 			<txt>  Hora : </txt> 			<sp n="1"/> 			<edt id="k_hora" dim="15,1" type="string" nc="-1" bclr="240,240,240" modify="N" fmt="HH:MM:SS" available="N"/> 			<br/>		</grp>		<br/>		<br/>		<tab/>		<grp dim="85,14,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Totales ">			<sp n="1"/> 			<tbl id="k_mov" dim="119,6" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" hk="z" OnChange="" Reorder="N" modify="Y" insdel="N" nren="fijo">								<col id="tipo" name="Tipo"  type="string" modify="N" available="Y"/>				<col id="folio" name="Folio" type="string" modify="N" available="Y"/>				<col id="estatus" name="Estatus"  type="string"/>				<col id="fecha" name="Fecha"  type="date" modify="N" available="Y" fmt="DD/MM/CCYY"/>				<col id="hora" name="Hora"  type="string" modify="N" available="Y"/>				<col id="num_serie" name="Num_Serie"  type="string" modify="N" available="Y"/>				<col id="kilometraje" name="Kilometraje"  type="number" modify="N" available="Y"/>				</tbl>			<br/>					<sp n="15"/><tab n="26"/>		<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Ejecuta_Reporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>					<sp n="3"/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="N"/>					<sp n="3"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>							</grp>				<br/>		<br/>									</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable,asterisco ;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal;			var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd,uen;         var v_tipoorden, v_folio;                  // Vars Reports			var cmd, xmlResQuery, strTmp;			var fech_original;										fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";				fileSavePath = "C:\Basura";				Inicializa();								ConfiguraControlesOpcion();			}									fun BuscarFolio() {				var folio, folio2;				folio = frn.get("k_folio");								//Added 230926				folio2 = PadLeft(folio, 10, "0");				frn.set("k_folio", folio2);								//frn.lib("libGeneral.kpl","PadLeft", folio, 7, "0");				folio = PadLeft(folio, 7, "0");				//ArmarRefDocto();				MostrarDOC(folio);				}			fun Cancela() {				CambiaSucursal();				Inicializa();				ConfiguraControlesOpcion();			}						fun ModoBuscar() {				tip_ope = "C";				frn.set("operacion", "CONSULTA");				LimpiaEncabezado();				ConfiguraControlesOpcion();			}						fun Inicializa(){ //Inicializa los valores en Pantalla				// Our code 				// Revisa y Carga en Variables los Parámetros Recibidos en la corrida				if( frn.nParam() == 1 ){ //Se han mandado parámetros a la página					               uen = trim(frn.param(0));					if (uen != "SER"/*&= ""*/) {						//uen="SER";						frn.message("Esta acción no está permitida.","Info !!!","&Aceptar");						frn.open("redirect",2);						return;					}				} else {					frn.message("Esta acción no está permitida.","Info !!!","&Aceptar");					frn.open("redirect",2);					return;				}				// Testing Code //				/*				gen_doc = "N"; 				nat_doc = "D"; 				gpo_doc = "21";				tip_doc = "1"; 				tip_ope = "C"; // "A" 				uen = "SER";            */            tip_ope = "C";            uen = "SER";            				if(tip_ope &= "C"){ //Consulta					frn.set("operacion","CONSULTA");				} else {				   frn.message("Operación no válida ...", "Mensaje","&Aceptar");					//frn.open("anuncios",4);					frn.open("index",4);					return;							}													//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));											// Fill Combo Tipo (Con Query FTO Kepler) 							rstXml(cuboQuery);				cmdQuery = "select c1||'-'||c3 as c2, c1 from keplersc.kdmargen";				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Inicializa()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboTipoDocto");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error BD","Aceptar");					return;				}				frn.set("k_tipon",getXml(cuboQuery));								frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());											}						fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         }			fun ConfiguraControlesOff() {								frn.setAtt("textFolio", "visible", "N");				frn.setAtt("k_folio", "available", "N");				frn.setAtt("k_folio", "visible", "N");								frn.setAtt("k_fecha", "available", "N");				frn.setAtt("k_hora", "available", "N");				frn.setAtt("k_refer", "available", "N");				frn.setAtt("k_fecref", "available", "N");								frn.setAtt("k_coment", "available", "N");				frn.setAtt("k_coment2", "available", "N");				frn.setAtt("k_coment3", "available", "N");								//frn.setAtt("k_mov", "visible", "N", "c_reemplazo");								frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											}						fun ConfiguraControlesOpcion() {							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta					//frn.setAtt("k_fecha", "available", "Y");					//frn.setAtt("k_hora", "available", "Y");					frn.setAtt("k_refer", "available", "Y");								frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");													} else {					if(tip_ope &= "B"){ //Baja										frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("Imprimir", "visible", "N");						frn.setAtt("Cancelar", "visible", "Y");						frn.setAtt("Aceptar", "visible", "Y");															} else {						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("Imprimir", "visible", "Y");						frn.setAtt("Cancelar", "visible", "N");						frn.setAtt("Aceptar", "visible", "N");						}				}			}						fun LimpiaDatosDoc {				frn.set("k_refer", "");				frn.set("k_fecref", "");				frn.set("k_mov", "");				frn.set("k_coment", "");				frn.set("k_coment2", "");				frn.set("k_coment3", "");			}						fun LimpiaTotalesDoc {				//frn.set("k_subtotal", "");				//frn.set("k_iva", "");				frn.set("k_monto", "");			}						fun LimpiaEncabezado {				frn.set("k_folio", "");				frn.set("k_docto", "");				frn.set("k_fecha", "");				frn.set("k_hora", "");			}						fun CambiaSucursal {				LimpiaDatosDoc();				LimpiaTotalesDoc();				LimpiaEncabezado();				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());					//ArmarRefDocto();							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						}					}								}			}						fun CambiaTipo {				LimpiaDatosDoc();				//LimpiaTotalesDoc();				LimpiaEncabezado();				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());					//ArmarRefDocto();								if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						}					}								}			}        			fun ObtenerFolios() {			            sucursal_id = frn.get("k_sucn",-1,1);	            cmdQuery = "" &						"select i.c3 as folio, i.c11 as cliente, i.c4 as fecha from keplersc.kdord i " & 						"where i.c1 = '" & /*"02"*/sucursal_id & "' and i.c2 = '" & frn.get("k_tipon",-1,1)  & "' order by i.c3 desc";						                                    frn.dialog("genlistasel","Relacion de Ordenes",cmdQuery,"folio","k_folio","0","","N");                     }				   			fun MostrarDOC(nFolio) {							var xmlGrd, flagErr;												flagErr = 0;								sucursal_id = frn.get("k_sucn",-1,1);				v_tipoorden = frn.get("k_tipon",-1,1);				v_folio = frn.get("k_folio");								LimpiaDatosDoc();				//LimpiaTotalesDoc();				//LimpiaEncabezado();								cmdQuery = "" &				"select i.c3 folio, i.c4 as fecha, i.c5 hora " &				"from keplersc.kdord i where i.c1 = '" & /*"02"*/sucursal_id & "' and i.c2 = '" & v_tipoorden & "' and i.c3 = '" & v_folio  & "'";								//frn.message(cmdQuery,"Info !","Aceptar");								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.upd()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosorden");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					//frn.setAtt("Aceptar", "visible", "N");					//ConfiguraControlesOff();					frn.message("La Orden No Existe (verifique el Tipo seleccionado) ...","Info","Aceptar");					flagErr = 1;					//ArmarRefDocto();					return;					//Cancela();					}	else {					// Ok ...				}							ConfiguraControlesOpcion();															frn.set("k_folio", getXmlAtt(cuboQuery,"r0", "folio"));				frn.set("k_fecha", getXmlAtt(cuboQuery,"r0", "fecha"));				frn.set("k_hora", getXmlAtt(cuboQuery,"r0", "hora"));									//ArmarRefDocto();								MostrarDOCDet(nFolio);						}			fun MostrarDOCDet(nFolio) {					var refer;				var xmlGrd;																				sucursal_id = frn.get("k_sucn",-1,1);				v_tipoorden = frn.get("k_tipon",-1,1);				v_folio = frn.get("k_folio");								//Reset campos				frn.set("k_mov", "");														// Based on Saltiel Query (other KPL for ST Description)				cmdQuery = "" &				"select i.c2 tipo, i.c3 folio, case when i.c8 = 0 then 'PENDIENTE' when i.c8 = 10 then 'ACTIVA' when i.c8 = 20 then 'SUSPENDIDA' " &				"when i.c8 = 30 then 'TERMINADA' when i.c8 = 40 then 'CERRADA'  when i.c8 = 50 then 'FUERA TALLER' end estatus, i.c4 fecha, i.c5 hora, " &				"i.c6 num_serie, i.c20 kilometraje from keplersc.kdord i where i.c1 = '" & /*"02"*/sucursal_id & "' and i.c2 = '" & v_tipoorden & "' and i.c3 = '" & v_folio  & "'";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.mostrardatosgrid()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosdocgrid");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.message("Sin Registros por mostrar ...","Info","Aceptar");					return;					}					//frn.set(cuboQuery);							rstXml(xmlGrd);				xmlGrd=frn.lib("libGeneral.kpl","CreaXmlDesdeTagRow",cuboQuery,"r","k_mov");				frn.lib("libGeneral.kpl","FileSave",xmlGrd, fileSavePath & "\mostrardatosdocgrid_parsed");				frn.setX(xmlGrd);												return;						   } // End MostrarDOCDet()	   										// ZONA	CODIGO REPORTE(S) 						fun IniParams(){//Inicializa parámetros de impresión. Pueden ser cambiados por el usuario final mediante menú: Archivo -> Configurar Página				frn.set("param_paper","letter");	//Tamaño de papel predefinido:	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tamaño de papel personalizado	"size=21.59,27.94cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//Márgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0");	//Escala de impresión (1=100 por ciento)	"F=1,1"				frn.set("param_landscape","N"/*"Y"*/);	//Orientación	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"				frn.set("param_emp","L");	//Posición de "Razón social"(izq,der,cen)	@emp=L|R|C"			}						fun setRepPage() {//Establece los parámetros finales de impresión.				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Ejecuta_Reporte() {							if (  ( frn.N("k_mov") == 0 ) || ( strlen( trim(/*frn.get("k_folio")*/frn.get("k_mov",-1,"folio")) ) == 0 )  ) {					frn.message("Sin Registros por mostrar ...","Info","Aceptar");					return;				}						Reporte();						} /* END Func Ejecuta_Reporte() */						fun Reporte() {							// Our Vars				var compania, titrep;				var contProd, contDet, tmpStr;								var dato_id; 								var sucursal, sucursaltx, fech_oper, xmlAlt ,xmlDet;								var i1, i2, i3, i4, i5, i6, i7, i10, i35, i37, i21, i20, i22, i19, i55, i24, i25, i26, i27, i28, i29, i40, i41, i42, i43, i44, iKms_salida;				var q2, q12, q13;				var r202, r200, r201, r19, r200_1, r1, r2, r10, r11, r12, r13, r14, r15, rc;				var b1, b2, b10, b11, b12, b13, b14, b15, b16, b17, b18; 				var a4, a10, a11, a12, a13;				var d2, d3, d4, d6, d47, d45, d46, d48, d49, d27, d5, d7, d8, d9, d33, d34, d35, d36, d37, d10;				var k2, k3, k11, k14, k4, k5, k6, k7, k10, k13;				var dd4, dd5, dd6, dd7;				var o2, l2, m3, p3, z2, cu12, h11, f5;				var c7, c8, c9, c10;				var x2, x3, x7;				var j6, j7, punto, j8, j9, j17, j15, j18, j19, j10, j11, j12, j13, j14, j42, j43, j44, j45, j46, j47;				var j20, j21, j22, j23, j24;				var sc6, sc7, sd1, sd2, se2, se3;				var enter_dt, dt6, dt7, dt8, dt9, dt10, dt19, dt11, dt12, dt13, dt14, dt15, dt16, dt21, dt22, dt23, dt26, dt27, dt28, dt29, dt30, dt31, dt32, dt33;				var dt24, dt18;				var y6, y7, y8, y9, y10, y11;				var t6, t7, t8, t14;				var u5, u6, u7, u8, u9, u11, u12, u13, u14, u15, u16;				var v5, v6, v7, v8, v9, v10, v16;				var w6, w7, w10;				var g51, g52, g53, g54, g9, g10, g32, g33, g34, g35, g22, g51, g52, g53, g54, g13, g14, g16;				var cv6, cv7, cv8, cv9, cv10, cv11, cv12, cv13, cv20, cv21, cv22, cv23, cv24, cv25, cv26;  								//var folio;				var p_fecha, var_fecha;				var p_subtotal, p_utilidad, p_perce, p_costo, p_total, p_iva;				var gt_subtotal, gt_utilidad, gt_perce, gt_costo, gt_total, gt_iva;								sucursal_id = frn.get("k_sucn",-1,1);				v_tipoorden = frn.get("k_tipon",-1,1);				v_folio = frn.get("k_folio");								sucursal = frn.get("k_sucn",-1,1);				sucursaltx = frn.get("k_sucn",-1,0);								//Obtener datos generales				kdb.kde("KDE");//Configuracion del servidor				kdb.exec();				compania = kdb.get("KDE","1");									// Se define el formato a usar y se liga a la variable del reporte "rep"	// Se define el formato a usar y se liga a la variable del reporte "rep"				rep.rst(); // 20121208				IniParams(); // 20121208				kdb.readPage("datFto","ser_reportedeordenfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				//rep.rst(); // 20121208				setRepPage();//Establece los parámetros finales de impresión(rep.page(...);), pues pueden haber cambiado por el usuario 				//Da valor a los inputs del reporte(rep.set();), e indica la ejecución de "grupos de renglones de impresión" (rep.exe();)												titrep = "R E P O R T E   I N T E R N O   D E   L A   O R D E N";												rep.set("fecha",sys.date());				rep.set("hora",sys.time());				rep.set("nombreempresa",compania);				rep.set("tituloreporte",titrep);								rep.set("suctx",sucursaltx);				rep.set("tipdoc",frn.get("k_tipon",-1,1));				rep.set("foldoc",frn.get("k_folio"));								b10 = 0;				b11 = 0;				b12 = 0;				b13 = 0;								dato_id = "";				cmdQuery = "select c1 as i1, c2 as i2, c3 as i3, c4 as i4, c5 as i5, c6 as i6, c7 as i7, c10 as i10, c35 as i35, c37 as i37, " &				"c21 as i21, c20 as i20, c22 as i22, c19 as i19, c55 as i55, concat(c24,' ',c25,' ',c26,' ',c27,' ',c28,' ',c29) as i24, " & 				"c40 as i40, c41 as i41, c42 as i42, c43 as i43, c44 as i44, kms_salida " & 				"from keplersc.kdord " &				"where c1 = '" & /*"02"*/sucursal_id & "' and c2 = '" & v_tipoorden & "'" & " and c3 = '" & v_folio & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ser_ordenrpt_data_i_rpt");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "i3");				if ( strlen(dato_id) == 0 ) {					// Not records found				} else {					i1 = getXmlAtt(cuboQuery,"r0", "i1");					i2 = getXmlAtt(cuboQuery,"r0", "i2");					i3 = getXmlAtt(cuboQuery,"r0", "i3");					i4 = getXmlAtt(cuboQuery,"r0", "i4");					i5 = getXmlAtt(cuboQuery,"r0", "i5");					i6 = getXmlAtt(cuboQuery,"r0", "i6");					i7 = getXmlAtt(cuboQuery,"r0", "i7");					i10 = getXmlAtt(cuboQuery,"r0", "i10");					i35 = getXmlAtt(cuboQuery,"r0", "i35");					i37 = getXmlAtt(cuboQuery,"r0", "i37");										i21 = getXmlAtt(cuboQuery,"r0", "i21");					i20 = getXmlAtt(cuboQuery,"r0", "i20");					i22 = getXmlAtt(cuboQuery,"r0", "i22");					i19 = getXmlAtt(cuboQuery,"r0", "i19");					i55 = getXmlAtt(cuboQuery,"r0", "i55");					i24 = getXmlAtt(cuboQuery,"r0", "i24");										i40 = getXmlAtt(cuboQuery,"r0", "i40");					i41 = getXmlAtt(cuboQuery,"r0", "i41");					i42 = getXmlAtt(cuboQuery,"r0", "i42");					i43 = getXmlAtt(cuboQuery,"r0", "i43");					i44 = getXmlAtt(cuboQuery,"r0", "i44");					iKms_salida = getXmlAtt(cuboQuery,"r0", "kms_salida");										r202 = "";					if ( i7 == 0 ) { r202 = "-  Orden Abierta"; }					if ( i7 == 10 ) { r202 = "-  Orden Cerrada y Lista para Facturar"; }					if ( i7 == 20 ) { r202 = "-  Orden Lista para Imprimir Vale de Salida"; }										r19 = i37 & ":00";								}												dato_id = "";				cmdQuery = "select c2 as d2, c3 as d3, c4 as d4, c6 as d6, c47 as d47, c45 as d45, c46 as d46, c48 as d48, c49 as d49, c27 as d27, " &				"c5 as d5, c7 as d7, c8 as d8, c9 as d9, c33 as d33, c34 as d34, c35 as d35, c36 as d36, c37 as d37, c10 as d10 " &  				"from keplersc.kdud where c2 = '" & i10 & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ser_ordenrpt_data_d_kdud_rpt");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "d2");				if ( strlen(dato_id) == 0 ) {					// Not records found				} else {					d2 = getXmlAtt(cuboQuery,"r0", "d2");					d3 = getXmlAtt(cuboQuery,"r0", "d3");					d4 = getXmlAtt(cuboQuery,"r0", "d4");					d6 = getXmlAtt(cuboQuery,"r0", "d6");					d47 = getXmlAtt(cuboQuery,"r0", "d47");					d45 = getXmlAtt(cuboQuery,"r0", "d45");					d46 = getXmlAtt(cuboQuery,"r0", "d46");					d48 = getXmlAtt(cuboQuery,"r0", "d48");					d49 = getXmlAtt(cuboQuery,"r0", "d49");					d27 = getXmlAtt(cuboQuery,"r0", "d27");										d5 = getXmlAtt(cuboQuery,"r0", "d5");					d7 = getXmlAtt(cuboQuery,"r0", "d7");					d8 = getXmlAtt(cuboQuery,"r0", "d8");					d9 = getXmlAtt(cuboQuery,"r0", "d9");					d33 = getXmlAtt(cuboQuery,"r0", "d33");					d34 = getXmlAtt(cuboQuery,"r0", "d34");					d35 = getXmlAtt(cuboQuery,"r0", "d35");					d36 = getXmlAtt(cuboQuery,"r0", "d36");					d37 = getXmlAtt(cuboQuery,"r0", "d37");					d10 = getXmlAtt(cuboQuery,"r0", "d10");										a4 = d3;					r200 = d4;					r201 = d6;										r200_1 = d33 & " " & d34 & " " & d35;										if ( strlen(d6) == 0 ) { r201 = d47; }					if ( strlen(d45) > 0 ) { r200 = r200 & " " & d45; }					if ( strlen(d46) > 0 ) { r200 = r200 & " " & d46; }										if ( strlen(d48) > 0 ) { 						if ( strlen(r201) > 0 ) {							r201 = r201 & " " & d48;						} else {							r201 = d48;						} 					}										if ( strlen(d49) > 0 ) { 						if ( strlen(r201) > 0 ) {							r201 = r201 & " " & d49;						} else {							r201 = d49;						} 					}										if ( strlen(d27) > 0 ) { 						if ( strlen(r201) > 0 ) {							r201 = r201 & " C.P. " & d27;						} else {							r201 = " C.P. " & d27;						} 					}								}												dato_id = "";				cmdQuery = "select c2 as k2, c3 as k3, c11 as k11, c14 as k14, c4 as k4, c5 as k5, c6 as k6, c7 as k7, c10 as k10, c13 as k13 " &				"from keplersc.kdserie where c1 = '" & i6 & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ser_ordenrpt_data_k_rpt");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "k2");				if ( strlen(dato_id) == 0 ) {					// Not records found				} else {					k2 = getXmlAtt(cuboQuery,"r0", "k2");					k3 = getXmlAtt(cuboQuery,"r0", "k3");					k11 = getXmlAtt(cuboQuery,"r0", "k11");					k14 = getXmlAtt(cuboQuery,"r0", "k14");										k4 = getXmlAtt(cuboQuery,"r0", "k4");					k5 = getXmlAtt(cuboQuery,"r0", "k5");					k6 = getXmlAtt(cuboQuery,"r0", "k6");					k7 = getXmlAtt(cuboQuery,"r0", "k7");					k10 = getXmlAtt(cuboQuery,"r0", "k10");					k13 = getXmlAtt(cuboQuery,"r0", "k13");										a10 = k2;					a11 = k3;					a12 = k11;					a13 = k14;				}												rep.set("flujoadmon",r202);								rep.exe("encabezado");								rep.set("fechrec",i4);				rep.set("horarec",i5);												dato_id = "";				cmdQuery = "select c2 as q2, c12 as q12, c13 as q13 from keplersc.kdctasser " &				"where c1 = '" & sucursal_id & "' and c21 = '" & v_tipoorden & "'" & " and c22 = '" & v_folio & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ser_ordenrpt_data_q_rpt");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "q12");				if ( strlen(dato_id) == 0 ) {					// Not records found				} else {					q2 = getXmlAtt(cuboQuery,"r0", "q2");					q12 = getXmlAtt(cuboQuery,"r0", "q12");					q13 = getXmlAtt(cuboQuery,"r0", "q13");				}								rep.set("fechcit",q12);				rep.set("horacit",q13);				rep.set("foliocit",q2);				dato_id = "";				cmdQuery = "select c4 as dd4, c5 as dd5, c6 as dd6, c7 as dd7 from keplersc.kdordent " &				"where c1 = '" & /*"02"*/sucursal_id & "' and c2 = '" & v_tipoorden & "'" & " and c3 = '" & v_folio & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ser_ordenrpt_data_q_rpt");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "dd4");				if ( strlen(dato_id) == 0 ) {					// Not records found				} else {					dd4 = getXmlAtt(cuboQuery,"r0", "dd4");					dd5 = getXmlAtt(cuboQuery,"r0", "dd5");					dd6 = getXmlAtt(cuboQuery,"r0", "dd6");					dd7 = getXmlAtt(cuboQuery,"r0", "dd7");				}								rep.set("fechproo",dd6);				rep.set("horaproo",dd7);				rep.set("fechpro",dd4);				rep.set("horapro",dd5);								rep.set("fechcie",i35);				rep.set("horacie",r19);												rep.exe("section-dates");								rep.exe("section-wlka");										cmdQuery = "" & 				"select col_clave_actividad cve, col_descripcion area, col_resultado res, col_comentario obs, orden ord from keplersc.kdordcuest tw " & 				"inner join keplersc.kdcatcuest twc on twc.tipo_actividad = tw.col_tipo_actividad and twc.clave = tw.col_clave_actividad " & 				"and twc.descripcion = tw.col_descripcion " &				"where tw.col_tipo_actividad = 'WLKA' and tw.col_sucursal = '" & sucursal_id & "' and tw.col_tipo_orden = '" & v_tipoorden & "' " & 				"and tw.col_folio_orden = '" & v_folio & "' order by twc.orden";										rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.WLKA()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ser_ordenrpt_data_wlka_rpt");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									for(var x=0; x < nXml(cuboQuery); x++)				{						rep.set("wlka_cve",getXmlAtt(cuboQuery,"r"&x,"cve"));					rep.set("wlka_area", getXmlAtt(cuboQuery,"r"&x,"area"));					rep.set("wlka_res", getXmlAtt(cuboQuery,"r"&x,