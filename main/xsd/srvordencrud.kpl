_vin()" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital"  brdr="0,2" modify="Y"/>			<sp/><txt>Marca:</txt>			<inp id="marca" dim="15,1" modify="N" modify="N"  bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<sp/><txt>Modelo:</txt>			<inp id="modelo" dim="20,1" modify="N" modify="N"  bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string"  brdr="0,2"/>			<sp/><txt>Kms:</txt>			<inp id="kms" dim="9,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  type="string" brdr="0,2" modify="Y"/>			<sp/><txt>A&#241;o:</txt>			<inp id="anio" dim="4,1" nc="4" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="string" brdr="0,2"/>			<sp/><txt>Color:</txt>			<inp id="color" dim="20,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="string" brdr="0,2"/>			<br/>			<sp/><txt>Placas:</txt>			<inp id="placas" dim="9,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N"  type="string" brdr="0,2"/>			<sp/><txt>Codigo:</txt>			<inp id="codigo" dim="20,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="string" brdr="0,2"/>			<sp/><txt>Bonete:</txt>			<inp id="bonete" dim="20,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2" nc="5" modify="Y"/>			<sp/><txt>Siniestro:</txt>			<inp id="siniestro" dim="20,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2" nc="20" modify="Y"/>			</grp>			</grp>		</grp>	<br/>			<tab n="2"/>	<grp  bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="0" clrBrdr="0,58,112" dim="135,35,7,12" brdr="0,5"  fnt="Arial,16">			<tab n="2"/><txt fnt=",bs">Puntos:</txt>		<br/>		<tab n="1"/>		<tbl id="tabla_puntos" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="105,8"  hk="z" OnChange="" Reorder="N" modify="Y">		<col id="tipo_punto" name="Tipo de Punto" visible="N" modify="N" OnChange="calc_importe()" OnF9="tipo_punto()" OnF10="Dialog(3,detalles_paquete)"  OnF11="Dialog(3,detalles_ref)" nc="1" type="capital"/>		<col id="desc_punto" name="Tipo de Punto" modify="Y" OnF9="ObtenerTipoPunto()" OnF10="Dialog(3,detalles_paquete)"  OnF11="Dialog(3,detalles_ref)" type="capital" OnChange="valTipo_punto()"/>		<col id="tipo_operario" OnF9="Dialog(3,tipo_operario)" visible="N" modify="N" OnF10="Dialog(3,detalles_paquete)" OnF11="Dialog(3,detalles_ref)" type="capital" name="Tipo de Operario"/>		<col id="desc_operario" OnF9="ObtenerTipoOperario()"  modify="Y" OnF10="Dialog(3,detalles_paquete)" OnF11="Dialog(3,detalles_ref)" type="capital" name="Tipo de Operario" OnChange="valTipo_operario()"/>		<col id="clave_paquete" OnF9="catalogo_paquetes()" OnF10="Dialog(3,detalles_paquete)" OnChange="ValPaquete()" OnF11="Dialog(3,detalles_ref)"  name="Paquete"  modify="Y" visible="Y" type="capital"/>		<col id="clave_campana" OnF9="catalogo_campanas()" OnF10="Dialog(3,detalles_paquete)" OnF11="Dialog(3,detalles_ref)"  name="Campa&#241;a"  modify="N" visible="N"/>		<col id="trabajo_a_realizar" name="Descripcion" OnF10="Dialog(3,detalles_paquete)"  OnF11="Dialog(3,detalles_ref)"  modify="Y" type="capital"/>		<col id="horas" name="Horas" OnChange="calc_importe()" OnF10="Dialog(3,detalles_paquete)" OnF11="Dialog(3,detalles_ref)"  type="number" visible="Y"/>		<col id="precio_punto" name="Precio"  OnF10="Dialog(3,detalles_paquete)"  OnF11="Dialog(3,detalles_ref)" modify="N" type="number" visible="Y"/>		<col id="clave_operario" OnF9=""  visible="N" OnChange="Ope_insert()" modify="N" OnF10="Dialog(3,detalles_paquete)" OnF11="Dialog(3,detalles_ref)" type="capital" name="Operario"/>		<col id="clave_operario_desc" OnF9="Operadores()" OnChange="ValOperario()" modify="Y" OnF10="Dialog(3,detalles_paquete)" OnF11="Dialog(3,detalles_ref)" type="capital" name="Operario"/>		<col id="status" name="Status"  OnF10="Dialog(3,detalles_paquete)"  OnF11="Dialog(3,detalles_ref)" modify="N" visible="N"/>	</tbl>			<grp dim="25,6,10,5" fnt="Arial,16" hSpace="4" brdr="0,5">				<tab n="1"/><bot id="bot_historial" dim="14,0" brdr="5" text="Historial" default="0" OnEnter="MostrarHistOrdenes()" clr="0,0,0"/>	<br/>		<tab n="1"/>	<bot id="bot_campanas" dim="14,0" brdr="5" text="Campa&#241;as" OnEnter="MostrarCampanas()" default="0" clr="0,0,0" bclr="237,238,239" fnt=","/>		<br/>			<tab n="1"/><bot id="bot_horarios" dim="14,0" OnEnter="MostrarHorarios()" brdr="5" text="Horarios Disp" default="0" OnChange="" clr="0,0,0"/>			<br/>		<tab n="1"/><bot id="bot_recomendaciones" dim="14,0" brdr="5" text="Recomendaciones" default="0" OnEnter="MostrarRecomendaciones()" clr="0,0,0" fnt=","/>			<br/>		<tab/><bot id="bot_walkaround" dim="14,0" brdr="5" text="Walkaround" default="0" OnEnter="walkaround()" clr="180,180,180" available="N"/>		</grp>			<br/>			<tab n="1"/>				<grp dim="72,25,7,12" fnt="Arial,16" hSpace="4">					<tab n="1"/><txt fnt=",bs">Sintomas:</txt>			<br/>			<tbl id="tabla_sintomas" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="72,8"  hk="z" OnChange="" Reorder="N" modify="Y" OnF9="Dialog(3,sintomas_tipos)">			<col id="tipo_sintoma" name="Tipo de Sintoma" OnF9="ObtenerTipoSintoma()" modify="Y"  OnChange="valTipo_sintomas()" type="capital" OnActive="consulta_comentarios()"/>			<col id="clave_sintoma"  modify="Y" OnF9="ObtenerCveSintoma()" OnChange="valCve_sintomas()" name="Clave" type="capital" OnActive="consulta_comentarios()"/>			<col id="desc_sintoma"  modify="N"  name="Descripcion" OnActive="consulta_comentarios()"/>			<col id="punto_sintoma"   name="Punto" type="number"  nc="2" modify="Y" OnActive="consulta_comentarios()"/>			<col id="cmnts_sintoma"  name="Comentarios" modify="N" type="capital" OnActive="consulta_comentarios()"/>			<col id="partida_sintoma"   name="Partida" type="number" visible="N" modify="N" OnActive="consulta_comentarios()"/>			</tbl>			<br/>			<txt>Comentarios Punto:</txt><sp/>			<inp id="puntorel_sintoma"  dim="3,1" fnt="Arial,16" visible="S" available="N" type="string"/>			<txt>Sintoma:</txt><sp/>			<inp id="rel_sintoma"  dim="35,1" fnt="Arial,16" visible="S" available="N" type="string"/>			<br/>			<inp id="comentarios_sintomas" dim="67,2" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="300" modify="Y"/>			<sp/><img id="img" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_60_DocNew.png" OnEnter="acepta_comentario()" tooltip="Aceptar comentario"/>			<br/><bot id="limpiar_pantalla" dim="15,0" brdr="5" OnEnter="borrar_datos()"  text="Limpiar Pantalla" default="0"/><sp/>			<inp id="vin" clr="64,64,64"  dim="10,1" fnt="Arial,16" type="number" nd="2" visible="N"/>			<inp id="partida_sintoma" clr="64,64,64"  dim="3,1" fnt="Arial,16" visible="S" available="N"/>								</grp>				<tab n="1"/>		<grp dim="55,25,7,12" fnt="Arial,16" hSpace="4">				<txt>Subtotal</txt><tab n="3"/>				<inp id="subt" clr="64,64,64"  dim="12,1" fnt="Arial,16" type="number" nd="2" available="N"/>				<br/>				<txt>IVA</txt><tab n="3"/>				<inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/><br/>				<txt fnt=",16b">IMPORTE</txt><tab/>				<inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="192,205,213" brdr="0,2" type="number" nd="2" modify="N"/>								<tab n="3"/><txt>Tiempo</txt><tab n="1"/>				<inp id="tiempo" clr="64,64,64" clrBrdr="255,255,255"  dim="7,1" fnt=",16b" bclr="192,205,213" brdr="0,2" modify="N"/>								<br/>						<txt clr="0,58,112">Observaciones</txt><br/>						<inp id="observaciones" clr="64,64,64" clrBrdr="255,255,255"  dim="55,4" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nc="1000" modify="Y" type="capital" available="Y"/>				<br/>							<br/>				<sp/><tab n="6"/><bot id="Aceptar" dim="20,0" brdr="5"  OnEnter="Alta()"  text="GUARDAR ORDEN" default="0" visible="Y"/>					<tab n="4"/>				<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="GenerarReporte()" tooltip="Imprimir Orden" available="Y" clrBrdr="0,0,0" visible="N"/>				<br/>		</grp>	</grp><br/><br/></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb, sys, rep;			var tip_ope,suc_usuario, perfil_usuario,asterisco,suc_param ,tip_orden,folio_orden ,rol_usuario,usuario, iva ;			var tipo_cita,historial_consultado,campanas_consultado, recomendaciones_consultado  , num_recomendaciones , num_campanas, kodawari;			var horas_P, horas_H , horas_G , horas_I , horas_L, horas_Q, horas_F,	horas_R,hora_limite_semana ,hora_limite_sabado,hora_limite_domingo, costo_por_mano  ;			var folio,num_citas, rango_inicial,rango_final,ParamValor,folioManual,nfolioManual,resVal,msg_activo,cons_ifz,cons_BP;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();				sys=new SYS;				rep=new REP;			   usuario = frn.config("user","name");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				rol_usuario = frn.config("user","role");				asterisco = "*";							//PARAMETROS				tip_ope=trim(frn.param(0));				suc_param =trim(frn.param(1));				if ( suc_param &! ""){					suc_usuario =trim(frn.param(1));				}				folio_orden = trim(frn.param(2));				tip_orden = trim(frn.param(3));								cons_ifz = "0";					//MSS 04022026 Ifz campanas				cons_BP = "0";						//MSS 04022026 Ifz campanas				historial_consultado = "0";				campanas_consultado = "0";				recomendaciones_consultado = "0";				num_recomendaciones = 0;				num_campanas = 0;				rango_inicial = fnDate("add", sys.date(), "-8");				rango_final = fnDate("add", sys.date(), "8");				ctrls_off();				Inicializa();			}			fun VerImgRecep(){				var suc,fecha,vin;				suc = frn.get("k_sucN",-1,1);				fecha=frn.get("fecha_captura_orden");				vin=frn.get("serie");				if (vin &= ""){					frn.message("Debe ingresar un vin válido.","Error","Aceptar");					return;				}				frn.dialog("ser_imagenes_recepcion",suc,fecha,vin);			}					fun ctrls_off() {				frn.setAtt("tipo_orden_bus", "visible", "N" );				frn.setAtt("clave_cliente_txt", "visible", "N" );				frn.setAtt("clave_cliente_bus", "visible", "N" );				frn.setAtt("vin_txt", "visible", "N" );				frn.setAtt("vin_bus", "visible", "N" );				frn.setAtt("placas_bus_txt", "visible", "N" );				frn.setAtt("placas_bus", "visible", "N" );				frn.setAtt("buscar_datos", "visible", "N" );				frn.setAtt("bot_imgrep", "visible", "N" );													frn.setAtt("tipo_orden", "bclr", "255,255,255" );				frn.setAtt("Aceptar", "visible", "N" );				frn.setAtt("Cita_txt", "visible", "N" );				frn.setAtt("txt_folio_cita", "visible", "N" );				frn.setAtt("folio_cita", "visible", "N" );				frn.setAtt("txt_cve_tmkt", "visible", "N" );				frn.setAtt("cve_tmkt", "visible", "N" );				frn.setAtt("txt_fecha_cita", "visible", "N" );				frn.setAtt("fecha_cita", "visible", "N" );				frn.setAtt("txt_hora_cita", "visible", "N" );				frn.setAtt("hora_cita", "visible", "N" );				frn.setAtt("bot_walkaround", "available", "N" );				frn.setAtt("Imprimir", "visible", "N" );				colores_botones();							frn.setAtt("tabla_puntos","visible","N", "status");				frn.setAtt("txt_promesa_original", "visible", "N" );				frn.setAtt("fecha_orgin", "visible", "N" );				frn.setAtt("fecha_original", "visible", "N" );				frn.setAtt("hora_orgin", "visible", "N" );				frn.setAtt("hora_original", "visible", "N" );				frn.setAtt("tipo_orden", "available", "N" );					if (tip_ope == 0){					botones_alta();				}else{					botones_modificar();				}				}			fun botones_alta(){				frn.setAtt("Aceptar", "visible", "Y" );				frn.setAtt("Cancelar", "visible", "Y" );				frn.setAtt("tipo_orden", "available", "Y" );				frn.set("tit_text", " Alta Orden");				frn.setAtt("Imprimir", "visible", "N" );				frn.setAtt("bot_recoleccion","visible","N");							confWalkaround();				permitir_modificacion();			}						fun botones_modificar(){				frn.setAtt("Aceptar", "visible", "Y" );				frn.setAtt("Cita_txt", "visible", "Y" );				frn.setAtt("txt_promesa_original", "visible", "Y" );				frn.setAtt("fecha_orgin", "visible", "Y" );				frn.setAtt("fecha_original", "visible", "Y" );				frn.setAtt("hora_orgin", "visible", "Y" );				frn.setAtt("hora_original", "visible", "Y" );					frn.setAtt("tabla_puntos","visible","Y", "status");				frn.set("tit_text", " Modificacion Orden");				frn.setAtt("Imprimir", "visible", "Y" );								if (frn.get("cmb_tipo_servicio",-1,1) &= "R"){						frn.setAtt("bot_recoleccion","visible","Y");				} else{					frn.setAtt("bot_recoleccion","visible","N");				}				confWalkaround();			}						fun bloquear_modificacion{				frn.setAtt("Aceptar", "visible", "N" );				frn.setAtt("k_sucN", "modify", "N" );				frn.setAtt("recepcionista", "modify", "N" );				frn.setAtt("cmb_tipo_servicio", "modify", "N" );				frn.setAtt("cmb_ubica_servicio", "modify", "N" );				frn.setAtt("fecha_entrega", "modify", "N" );				frn.setAtt("hora_entrega", "modify", "N" );				frn.setAtt("fecha_captura_orden", "modify", "N" );				frn.setAtt("hora_captura_orden", "modify", "N" );				frn.setAtt("fecha_original", "modify", "N" );				frn.setAtt("hora_original", "modify", "N" );				frn.setAtt("cli_desea_ser_contactado", "modify", "N" );				frn.setAtt("cmb_promocion", "modify", "N" );				frn.setAtt("cliente_id", "modify", "N" );				frn.setAtt("serie", "modify", "N" );				frn.setAtt("kms", "modify", "N" );				frn.setAtt("bonete", "modify", "N" );				frn.setAtt("siniestro", "modify", "N" );				frn.setAtt("comentarios_sintomas", "modify", "N" );				frn.setAtt("observaciones", "modify", "N" );				//Inhabilita F9, F10 o F11 no consultar para que no modifique 				frn.setAtt("fecha_entrega", "OnF9", "");				frn.setAtt("fecha_entrega", "page","");				frn.setAtt("fecha_original", "OnF9","");				frn.setAtt("fecha_original", "page","");				frn.setAtt("fecha_captura_orden", "OnF9","");				frn.setAtt("fecha_captura_orden", "page","");								frn.setAtt("cliente_id", "OnF9","");				frn.setAtt("cliente_id", "OnF10","");//				frn.setAtt("cliente_id", "OnF11","");					//MSS 09062025 No permitir modificacion en este modulo solo para GM parametrizar				frn.setAtt("serie", "OnF9","");				frn.setAtt("serie", "OnF10","");				frn.setAtt("serie", "OnF11","");				frn.setAtt("tabla_puntos", "OnF9","","desc_punto");				frn.setAtt("tabla_puntos", "OnF9","","desc_operario");				frn.setAtt("tabla_puntos", "OnF9","","clave_paquete");				frn.setAtt("tabla_puntos", "OnF9","","clave_operario_desc");				frn.setAtt("tabla_sintomas", "OnF9","","tipo_sintoma");				frn.setAtt("tabla_sintomas", "OnF9","","clave_sintoma");				frn.setAtt("tabla_puntos", "modify", "N" );				frn.setAtt("tabla_sintomas", "modify", "N" );							}			fun permitir_modificacion(){				var nivelUsuario;				frn.setAtt("k_sucN", "modify", "Y" );				frn.setAtt("recepcionista", "modify", "Y" );				frn.setAtt("cmb_tipo_servicio", "modify", "Y" );				frn.setAtt("cmb_ubica_servicio", "modify", "Y" );				frn.setAtt("fecha_entrega", "modify", "Y" );				frn.setAtt("hora_entrega", "modify", "Y" );				frn.setAtt("fecha_captura_orden", "modify", "N" );				frn.setAtt("hora_captura_orden", "modify", "N" );				frn.setAtt("cli_desea_ser_contactado", "modify", "Y" );				frn.setAtt("cmb_promocion", "modify", "Y" );				frn.setAtt("cliente_id", "modify", "Y" );				frn.setAtt("serie", "modify", "Y" );				frn.setAtt("kms", "modify", "Y" );				frn.setAtt("bonete", "modify", "Y" );				frn.setAtt("siniestro", "modify", "Y" );				frn.setAtt("tabla_puntos", "modify", "Y" );				frn.setAtt("tabla_sintomas", "modify", "Y" );				frn.setAtt("comentarios_sintomas", "modify", "Y" );				frn.setAtt("observaciones", "modify", "Y" );				//Habilita funcion F9,F10 o F11				frn.setAtt("fecha_entrega", "OnF9","Dialog(3,_ks_fecha,fecha_entrega)");				frn.setAtt("fecha_entrega", "page","_ks_fecha,fecha_entrega");				frn.setAtt("fecha_original", "OnF9","Dialog(3,_ks_fecha,fecha_original)");				frn.setAtt("fecha_original", "page","_ks_fecha,fecha_original");				frn.setAtt("fecha_captura_orden", "OnF9","");				frn.setAtt("fecha_captura_orden", "page","");				//MSS 010824 Permitir modificar fecha para ordenes de garantia				nivelUsuario=ValNivelUsuario();				if (frn.get("tipo_orden", -1, 1) &= "G" || frn.get("tipo_orden", -1, 1) &= "M" && ValNivelUsuario()>0){			//MSS 14112025 Considerar mismo procedimiento de las ordenes G a las M								frn.setAtt("fecha_captura_orden","modify","Y");					frn.setAtt("hora_captura_orden", "modify", "Y" );					frn.setAtt("fecha_original","modify","Y");					frn.setAtt("hora_original","modify","Y");					frn.setAtt("fecha_captura_orden","available","Y");					frn.setAtt("hora_captura_orden","available","Y");					frn.setAtt("fecha_original","available","Y");					frn.setAtt("hora_original","available","Y");					//Habilita funcion F9,F10 o F11					frn.setAtt("fecha_captura_orden", "OnF9","Dialog(3,_ks_fecha,fecha_captura_orden)");					frn.setAtt("fecha_captura_orden", "page","_ks_fecha,fecha_captura_orden");									}else{					frn.setAtt("fecha_captura_orden","modify","N");					frn.setAtt("fecha_original","modify","N");					frn.setAtt("hora_captura_orden","modify","N");					frn.setAtt("hora_original","modify","N");								}											frn.setAtt("cliente_id", "OnF9","obtenerCliente()");				frn.setAtt("cliente_id", "OnF10","Dialog(3,cat_cli_crud,Nuevo,x,s,cliente_id)");//				frn.setAtt("cliente_id", "OnF11","ModificaCliente()");					//MSS 09062025 No permitir modificacion en este modulo solo para GM parametrizar				frn.setAtt("serie", "OnF9","obtenerSerie(serie)");				frn.setAtt("serie", "OnF10","Dialog(3,cat_serie_crud,Nuevo,x,s,serie)");				frn.setAtt("serie", "OnF11","edicion_vin()");				frn.setAtt("tabla_puntos", "OnF9","ObtenerTipoPunto()","desc_punto");			//MSS 09122024 Permitir captura directa				frn.setAtt("tabla_puntos", "OnF9","ObtenerTipoOperario()","desc_operario");		//MSS 09122024 Permitir captura directa				frn.setAtt("tabla_puntos", "OnF9","catalogo_paquetes()","clave_paquete");				frn.setAtt("tabla_puntos", "OnF9","Operadores()","clave_operario_desc");				frn.setAtt("tabla_sintomas", "OnF9","Dialog(3,sintomas_tipos)");				frn.setAtt("tabla_sintomas","clave_sintoma", "OnF9","Dialog(3,sintomas_vals)");							}					fun Inicializa(){				kdb.kde("KDE");//						kdb.exec();							var cmd, cubo, ok,mensajeError ;										//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));								frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));												//Llenar combo recepcionista				cmd = "select '['||c1||'] '||c2 as descripcion, c12 as clave from keplersc.kdrecep";				if  (tip_ope == 0){					cmd = cmd & " where c11='S' ";				}						cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboRecepcionista");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						   var cmd_recepcionista = "recepcionista";			   frn.setX("", cmd_recepcionista ,0,0);				llenar_cmb(cubo ,cmd_recepcionista );												frn.set(cmd_recepcionista ,descr_combo(cmd_recepcionista ,1,usuario ));									frn.set("fecha_captura_orden",sys.date());				frn.set("hora_captura_orden",sys.time());										//Llenar combo tipo orden				cmd = "select c1||'-'||c2 as descripcion, c1 as clave  from keplersc.kdcatcitasordenes";								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\query  ");								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_orden  ");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var cmd_tipo_orden = "tipo_orden";				llenar_cmb(cubo ,cmd_tipo_orden );				frn.set(cmd_tipo_orden ,descr_combo(cmd_tipo_orden ,1,"T"));				//Llenar combo tipo_orden_bus				cmd = "select c1 from keplersc.kdcatcitasordenes";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}					frn.set("tipo_orden_bus",cubo);				frn.set("tipo_orden_bus","T");								//llenar combo cliente desea ser contactado				frn.setX("", "cli_desea_ser_contactado", 0 ,0);				frn.setX("S", "cli_desea_ser_contactado", 1 ,0);				frn.setX("N", "cli_desea_ser_contactado", 2 ,0);								//Llenar combo tipo de servicio				frn.setX("","cmb_tipo_servicio",0,0);				frn.setX("","cmb_tipo_servicio",0,1);				frn.setX("Recoleccion","cmb_tipo_servicio",1,0);				frn.setX("R","cmb_tipo_servicio",1,1);				frn.setX("Servicio Domicilio","cmb_tipo_servicio",2,0);				frn.setX("D","cmb_tipo_servicio",2,1);				frn.setX("Mantenimiento Express","cmb_tipo_servicio",3,0);				frn.setX("E","cmb_tipo_servicio",3,1);								//Llenar combo ubicacion de servicio				cmd = "select '['||clave||'] '||descripcion as descripcion, clave " &					"from keplersc.kdsercatubica ubi " &					"inner join keplersc.kdcfdconfig cfd on cfd.c7=ubi.concesionario and cfd.c1='" & frn.get("k_sucN",-1,1) &					"' order by ubi.clave";						cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.setX("","cmb_ubica_servicio", 0 ,0);				llenar_cmb(cubo,"cmb_ubica_servicio");				//Llenar combo promocion				Llena_cmbpromocion();				//horas				cmd = "select c26,c27,c28,c29,c11,c30,c10,c31,c32,c33,c34 from keplersc.kdserconfctas"; //where c=sucursal				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_hrs   ");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								//horas por tipo de punto				horas_P = getXmlAtt(cubo,"r0" ,"c26");				horas_H = getXmlAtt(cubo,"r0" ,"c27");				horas_G = getXmlAtt(cubo,"r0" ,"c28");				horas_I = getXmlAtt(cubo,"r0" ,"c29");				horas_L = getXmlAtt(cubo,"r0" ,"c11");				horas_Q = getXmlAtt(cubo,"r0" ,"c30");				horas_F = getXmlAtt(cubo,"r0" ,"c10");								horas_R = getXmlAtt(cubo,"r0" ,"c34");								//horas limites 				hora_limite_semana = getXmlAtt(cubo,"r0" ,"c31");				hora_limite_sabado = getXmlAtt(cubo,"r0" ,"c32");				hora_limite_domingo = getXmlAtt(cubo,"r0" ,"c33");								cambio_orden();						//obtener kodawari				cmd = "select c9 from keplersc.kdconftaller where c2='" & frn.get("k_sucN" , -1, 1) & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_kodawari  ");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								kodawari = getXmlAtt(cubo,"r0" ,"c9");				frn.set("num_citas","");				if (tip_ope == 1){					if (frn.get("cmb_tipo_servicio",-1,1) &= "R"){							frn.setAtt("bot_recoleccion","visible","Y");					} else{						frn.setAtt("bot_recoleccion","visible","N");					}				}				ActivaFolioManual();			//MSS 05122024: Permitir capturar un folio manual			}									fun buscar_datos(){							var xmlRequest,cmd,ok,cubo,mensajeError;				setXml(xmlRequest,"document","folio_orden", frn.get("folio_orden_bus"));				setXml(xmlRequest,"document","tipo_orden", frn.get("tipo_orden_bus"));				setXml(xmlRequest,"document","vin",frn.get("vin_bus"));				setXml(xmlRequest,"document","placas",frn.get("placas_bus"));				setXml(xmlRequest,"document","clave_cliente",frn.get("clave_cliente_bus"));				setXml(xmlRequest,"document","sucursal_id",frn.get("k_sucN", -1, 1));				borrar_datos();					frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestsel");								cmd="select * from keplersc.datos_orden_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								insertar_registros(cubo, "orden");				calc_importe();								//MSS 04112025 Interfaz campanas				if (InterfazCampanas() &= "S"){					verifica_ifz_bp_campanas_vin();				}else{						verifica_campanas_recomen();					}			}											fun insertar_registros(cubo, tipo){							var strTmp,cubo_cli_vin,cubo_orden,cubo_pun, cubo_sin ,xmlRes,cmd,ok ,mensajeError ; 											strTmp = getXmlAtt(cubo,"r0","datos_cli_vin");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_cli_vin,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_cli_vin,"C:\Basura\cubo_cli_vin");						xmlRes= getXmlX(cubo_cli_vin,3,0);				frn.setX(xmlRes);					rstXml(strTmp);				rstXml(xmlRes);							if (tipo &= "cita"){					strTmp = getXmlAtt(cubo,"r0","datos_cita");				}else{					strTmp = getXmlAtt(cubo,"r0","datos_orden");				}									strTmp = delScpScn(strTmp);				setXmlStr(cubo_orden   ,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_orden   ,"C:\Basura\cubo_res   ");						xmlRes= getXmlX(cubo_orden ,3,0);				frn.lib("libGeneral.kpl","FileSave",xmlRes,"C:\Basura\xmlRes ");				frn.setX(xmlRes);										var tipo_orden;								if (tipo &= "orden" ){					var estatus_orden = getXml(xmlRes, "flujo_admon");					//MSS 010824 Subi antes del if las sig 3 lineas, se utiliza el valor actualizado de tipo_orden					tipo_orden= getXml(xmlRes, "tipo_orden");					frn.set("tipo_orden",descr_combo("tipo_orden",1,tipo_orden));					frn.set("tipo_orden_bus",descr_combo("tipo_orden_bus",1,tipo_orden));					if (estatus_orden != 0){						cons_ifz = "1";					//MSS 04022026 Ifz campanas -No solicitar consulta de Ifz a BP						frn.message("Imposible Modificar una orden que ya esta cerrada, solo permite Consultar","Error","Aceptar");						bloquear_modificacion();		//MSS 04/07/24: Mod funcion no permita modificar bloqueando los campos					} else {						permitir_modificacion();		//MSS 04/07/24: Habilitar los campos, para permitir modificar						cons_ifz = "0";					//MSS 04022026 Ifz campanas -Solicitar consulta de Ifz a BP					}											var desea_ser_cont = getXml(xmlRes, "cli_desea_ser_contactado");					frn.set("cli_desea_ser_contactado",descr_combo("cli_desea_ser_contactado",0,desea_ser_cont ));					}								var recepcionista = getXml(xmlRes, "recepcionista");				var cmd_recep = "select c12 from keplersc.kdrecep where c1='" & recepcionista & "'";				var cubo_recep = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd_recep ,"srvordencrud.insertar_registros()");								frn.lib("libGeneral.kpl","FileSave",cubo_recep ,"C:\Basura\cuborecep");								ok=getXmlAtt(cubo_recep ,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo_recep ,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var usuario_recepcionista = getXmlAtt(cubo_recep ,"r0","c12");				frn.set("recepcionista",descr_combo("recepcionista",1,usuario_recepcionista ));					var tipo_servicio = getXml(xmlRes, "cmb_tipo_servicio");				frn.set("cmb_tipo_servicio",descr_combo("cmb_tipo_servicio",1,tipo_servicio));				var ubica_servicio = getXml(xmlRes, "cmb_ubica_servicio");				frn.set("cmb_ubica_servicio",descr_combo("cmb_ubica_servicio",1,ubica_servicio));				if (frn.get("cmb_tipo_servicio",-1,1) &= "R"){						frn.setAtt("bot_recoleccion","visible","Y");				} else{					frn.setAtt("bot_recoleccion","visible","N");				}				var promocion = getXml(xmlRes, "cmb_promocion");				frn.set("cmb_promocion",descr_combo("cmb_promocion",1,promocion));				cambio_orden();									//inserta regitros de puntos				rstXml(strTmp);				rstXml(xmlRes);				strTmp = getXmlAtt(cubo,"r0","datos_puntos");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_pun,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_pun,"C:\Basura\cubo_pun   ");				frn.setX(cubo_pun,"tabla_puntos");  										//inserta regitros de sintomas				rstXml(strTmp);				rstXml(xmlRes);				strTmp = getXmlAtt(cubo,"r0","datos_sintomas");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_sin ,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_sin ,"C:\Basura\cubo_sin   ");				frn.setX(cubo_sin ,"tabla_sintomas");				carga_comentarios(cubo_sin);						}			fun carga_comentarios(cubo){				var comentario,renglones,ncubo,pto_sin,par_sin,cubo_pto,cubo_par,xmlRow;				renglones = frn.N("tabla_sintomas");				ncubo= nXml(cubo);				for (var i=0; i<renglones; i++) {					pto_sin = frn.get("tabla_sintomas",i,"punto_sintoma");					par_sin = frn.get("tabla_sintomas",i,"partida_sintoma");					for(var j=0;j<ncubo;j++){						xmlRow = getXmlX(cubo,3,j);						cubo_pto = getXml(xmlRow,"punto_sintoma");						cubo_par = getXml(xmlRow,"partida_sintoma");						comentario=getXml(xmlRow,"cmnts_sintoma");						if (cubo_pto &= pto_sin && cubo_par &= par_sin){							frn.setX(comentario,"tabla_sintomas",i,"cmnts_sintoma");						}					}				}			}			fun consulta_comentarios(){				frn.set("comentarios_sintomas",frn.get("tabla_sintomas",-1,"cmnts_sintoma"));				frn.set("puntorel_sintoma",frn.get("tabla_sintomas",-1,"punto_sintoma"));				frn.set("rel_sintoma",frn.get("tabla_sintomas",-1,"desc_sintoma"));			}			fun acepta_comentario(){				if (frn.get("puntorel_sintoma") &="" || frn.get("rel_sintoma")&=""){					frn.message("Falta especificar el punto y/o la descripcion del sintoma","Atencion","Aceptar");					return;				} else{					frn.setX(frn.get("comentarios_sintomas"),"tabla_sintomas",-1,"cmnts_sintoma");				}				}						fun verifica_campanas_recomen(){				var cmd, ok,cubo,tot,mensajeError ;				var suc = frn.get("k_sucN", -1, 1);				var VN = frn.get("serie");				if (VN &! ""){					cmd = "select c3 as clave_campana from keplersc.kdsercampana where c2='" & VN & "' and c6='" &  suc & "' and c4=" & 0;					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.verifica_campanas_recomen()");								ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}									frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_campanas   ");					num_campanas = nXml(cubo);					if (num_campanas != 0){						//MSS 04112025 Solo muestre una vez el mensaje y el color del boton completo						if (msg_activo == 0){							frn.message("El vehiculo tiene campañas por realizar","Anuncio","Aceptar");							msg_activo = 1;						}						frn.setAtt("bot_campanas", "bclr", "89,164,40");						frn.setAtt("bot_campanas", "clr", "255,255,255");						frn.setAtt("bot_campanas", "fnt",",b");					}													//verifica si hay recomendaciones para la unidad									cmd= "select c3 from keplersc.kdpunres where c1='" & suc & "' and c25='" &  VN  & "' and c5<> " & 30 ;					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.verifica_campanas_recomen()");								ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_recomendaciones");					num_recomendaciones  = nXml(cubo);					if (num_recomendaciones &! 0){						frn.message("La Serie tiene recomendaciones ","Anuncio","Aceptar");						frn.setAtt("bot_recomendaciones", "clr", "120,210,59" );						frn.setAtt("bot_recomendaciones", "fnt",",b");					}									}										}						fun bus_cli_vin(origen){ 							var vn , cli ,cmd, cubo, ok, xmlRequest,mensajeError,strTmp,cubo_cli_vin,xmlRes,cita_cte,folio_cita,tmkt,fcha_cita,hr_cita,vnum_citas;				var xmlcte;				var suc = frn.get("k_sucN", -1, 1);								cli = frn.get("cliente_id");				vn = frn.get("serie");				cita_cte = frn.get("cita_cliente");								borrar_datos_cli();				borrar_datos_vin();												if (origen &= "cliente"){					vn="";					if ( cli &! ""){						setXml(xmlRequest,"document","clave_cliente",cli);						if (vn &! ""){							setXml(xmlRequest,"document","vin",vn );						}					}else{						return ; 					}				}				if (origen &= "serie"){					cli = "";					if (vn &! ""){						setXml(xmlRequest,"document","vin",vn );					}else{						return ; 					}				}											//busca si hay alguna cita pendiente o confirmada				if (tip_ope == 0 ){						if (cita_cte &! ""){																			cmd = "select c2 as folio_cita, c3 as cve_tmkt, c12 as fecha_cita, c13 as hora_cita,c37 as tipo_cita " &							"from keplersc.kdctasser " &							"where c1='" & suc & "' and c2='" & cita_cte & "'";					} else{						if (frn.get("num_citas") &= ""){							//valida si hay mas de 1 cita							cmd = "select count(*) as num_citas 								from keplersc.kdctasser where c1='" & suc & "' and (c20=0 or c20=10) and c12>='" & rango_inicial & "' and c12<='" & rango_final & "' ";																									 							if (cli &! ""){								cmd = cmd & " and c4='" & cli & "'";							}							if (vn &! ""){								cmd = cmd & " and (c9 ='" & vn & "' or c6 like '%" & vn & "')";							}														frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdnum_citas");							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.bus_cli_vin()");							frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubonum_citas");														ok=getXmlAtt(cubo,"ok");							if(ok &! "" && !ok){								mensajeError = getXmlAtt(cubo,"native3");								mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);								frn.message(mensajeError,"Error","Aceptar");								return;							}							vnum_citas = getXmlAtt(cubo, "r0", "num_citas");							frn.set("num_citas",vnum_citas);							if (frn.get("num_citas") > 1){								frn.message("Se encontraron mas de 1 cita, selecione la cita correcta con F9","Atencion");								if (origen &= "serie"){									frn.setPos("serie");								} else {									frn.setPos("cliente_id");								}								return;							}						}							//extrae los datos de la cita						cmd = "select c2 as folio_cita, c3 as cve_tmkt, c12 as fecha_cita, c13 as hora_cita,c37 as tipo_cita from keplersc.kdctasser where c1='" & suc & "'";						cmd= cmd & " and (c20=0 or c20=10 or c20=50) and c12>='" & rango_inicial & "' and c12<='" & rango_final & "' ";						if (cli &! ""){							cmd = cmd & " and c4='" & cli & "'";						}						if (vn &! ""){							cmd = cmd & " and (c9 ='" & vn & "' or c6 like '%" & vn & "')";						}											cmd = cmd & " order by c2 limit 1";					}					frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdcita_encontrada");					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.bus_cli_vin()");					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubocita_encontrada");											ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}															folio_cita = getXmlAtt(cubo, "r0", "folio_cita");					tmkt= getXmlAtt(cubo, "r0", "cve_tmkt");					fcha_cita= getXmlAtt(cubo, "r0", "fecha_cita");					hr_cita= getXmlAtt(cubo, "r0", "hora_cita");					tipo_cita = getXmlAtt(cubo, "r0", "tipo_cita");														//si encontro cita buscar datos					if (folio_cita &! "" && frn.get("folio_cita") &= "" ){						frn.message("El sistema encuentra una cita pendiente, se bajaran los datos de la Cita","Atencion");						frn.setAtt("txt_folio_cita", "visible", "Y" );						frn.setAtt("folio_cita", "visible", "Y" );						frn.setAtt("txt_cve_tmkt", "visible", "Y" );						frn.setAtt("cve_tmkt", "visible", "Y" );						frn.setAtt("txt_fecha_cita", "visible", "Y" );						frn.setAtt("fecha_cita", "visible", "Y" );						frn.setAtt("txt_hora_cita", "visible", "Y" );						frn.setAtt("hora_cita", "visible", "Y" );												frn.set("folio_cita" , folio_cita);						frn.set("cve_tmkt" , tmkt);						frn.set("fecha_cita" , fcha_cita);						frn.set("hora_cita" , hr_cita);												setXml(xmlRequest,"document","sucursal_id", suc );						setXml(xmlRequest,"document","folio_cita", folio_cita );						setXml(xmlRequest,"document","tipo_cita", tipo_cita );						setXml(xmlRequest,"document","tipo_operacion", "1");							frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestselcita");									cmd="select * from keplersc.datos_cita_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";						cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.bus_cli_vin()");									frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								ok=getXmlAtt(cubo,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cubo,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return ;						}												frn.set("tipo_orden",descr_combo("tipo_orden",1,tipo_cita ));						insertar_registros(cubo, "cita");						calc_importe();												//MSS 06112025 Interfaz campanas						if (InterfazCampanas() &= "S"){							verifica_ifz_bp_campanas_vin();						}else{								verifica_campanas_recomen();							}						return ;					}								} //fin tip_ope=0								setXml(xmlRequest,"document","sucursal_id",suc);				frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");				cmd="select * from keplersc.cli_vin_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.bus_cli_vin()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								strTmp = getXmlAtt(cubo,"r0","datos");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_cli_vin,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_cli_vin,"C:\Basura\cubo_cli_vin ");						xmlRes= getXmlX(cubo_cli_vin,3,0);				frn.setX(xmlRes);					rstXml(strTmp);				rstXml(xmlRes);								//MSS 06112025 Interfaz campanas				if (InterfazCampanas() &= "S"){					verifica_ifz_bp_campanas_vin();				}else{						verifica_campanas_recomen();					}										if (tip_ope == 0){					frn.set("kms", "");				}				Valserievscliente();			}						fun Valserievscliente(){				var xmlRequest,cmd,ok,cubo,mensajeError;				if (frn.get("serie") &! "" && frn.get("cliente_id") &!""){					cmd="select count(*) as totReg from keplersc.kdserie " & 						"where c4 = '" & frn.get("serie") & "' and c9='" & frn.get("cliente_id") & "'"; 					cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.Valserievscliente()");					//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");					ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					if (getXmlAtt(cubo,"r0","totReg") &= "0") {						frn.message("El no. de serie no pertenece al cliente. Edite la serie con F11 para modificar","Atencion","Aceptar");						return;					}												}			}			fun calc_importe()	{																								//MSS 13062024 AJUSTE PARA PRECIO 0 EN TIPO DE PUNTO G, ESTABA PARA TIPO DE ORDEN 							var cmd,cubo,ok, mensajeError; 				var precio_punto,importe_final = 0;				for (var i=0,n=frn.N("tabla_puntos")-1;i<n;i++) {										var tipo_punto = frn.get("tabla_puntos", i, "tipo_punto");					if (tipo_punto &! "S" && tipo_punto &! "" ){						//un punto diferente a S no puede tener un paquete						if (frn.get("tabla_puntos",i,"clave_paquete") &! ""){							frn.setX("","tabla_puntos", i, "clave_paquete");							frn.setX("","tabla_puntos", i, "trabajo_a_realizar");							frn.setX("","tabla_puntos", i, "horas");							frn.setX("","tabla_puntos", i, "precio_punto");						}							horas_puntos(i);						if ( frn.get("tipo_orden", -1, 1) &= "H" || frn.get("tipo_orden", -1, 1) &= "K"){							ParamValor = ParametroValor("Precio inicial 0 orden hojalateria");					//MSS 04122024 PARAMETRIZAR PRECIO EN 0 PARA ORDENES DE HOJALATERIA														if (ParamValor &= "S"){										if (tip_ope == 0){																				//MSS 22102024 CERO EN PRECIO DE PUNTO EN UNA ALTA PARA ORDENES H Y K									frn.setX(0,"tabla_puntos", i, "precio_punto");								}else{									precio_punto = 0;									precio_punto = (costo_por_mano * frn.get("tabla_puntos",i,"horas")) * iva;										frn.setX(precio_punto ,"tabla_puntos", i, "precio_punto");								}							} else {								if (tipo_punto &! "L"){									precio_punto = 0;									precio_punto = (costo_por_mano * frn.get("tabla_puntos",i,"horas")) * iva;										frn.setX(precio_punto ,"tabla_puntos", i, "precio_punto");								}							}							}else{							if (tipo_punto &! "L"){								if (tipo_punto &= "G"){									frn.setX(0,"tabla_puntos", i, "precio_punto");								}else {										precio_punto = 0;									precio_punto = (costo_por_mano * frn.get("tabla_puntos",i,"horas")) * iva;										frn.setX(precio_punto ,"tabla_puntos", i, "precio_punto");								}							}						}					}else{						horas_puntos(i);					}					if (tipo_punto &= "L"){						frn.setX("LAVADO","tabla_puntos", i, "trabajo_a_realizar");						frn.setX(0,"tabla_puntos", i, "precio_punto");					}					importe_final = importe_final + frn.get("tabla_puntos",i,"precio_punto");					}							//precios traen iva inculido								frn.set("k_monto",importe_final);				var subtotal = importe_final/iva;				frn.set("subt", subtotal);				var iva_total = importe_final - subtotal;				frn.set("k_iva",iva_total);								calc_tiempo();						}						fun calc_tiempo(){				var hrs_necesarias = 0;				for (var i=0,n=frn.N("tabla_puntos")-1;i<n;i++) {					var hrs_por_punto = frn.get("tabla_puntos",i,"horas");					if (hrs_por_punto > 0 ){						hrs_necesarias = hrs_necesarias + hrs_por_punto ;					}					}				frn.set("tiempo",hrs_necesarias );			}						fun cambio_orden(){				borrar_tablas();								var t_orden = frn.get("tipo_orden" , -1, 1);								frn.setAtt("tabla_puntos", "visible", "Y" , "clave_paquete" );				frn.setAtt("tabla_puntos", "visible", "Y" , "horas" );				frn.setAtt("tabla_puntos", "visible", "Y" , "precio_punto" );					frn.setAtt("tabla_puntos", "visible", "Y" , "clave_campana" );				if (t_orden &= "C" || t_orden &= "D" || t_orden &= "E" || t_orden &= "G" || t_orden &= "H" || t_orden &= "R" || t_orden &= "I" || t_orden &= "P" || t_orden &= "K" || t_orden &= "M"){ //MSS 14112025 Considerar mismo procedimiento de las ordenes G a las M					frn.setAtt("tabla_puntos", "visible", "N" , "clave_paquete" );				}								if (t_orden &= "C"){		//MSS 14112025 Agregar manejo de campanas para ordenes de garantia G o M					frn.setAtt("tabla_puntos", "visible", "N" , "horas" );					frn.setAtt("tabla_puntos", "visible", "N" , "precio_punto" );				}else{					if (t_orden &= "G" || t_orden &= "M"){						frn.setAtt("tabla_puntos", "visible", "Y" , "clave_campana" );					}else{						frn.setAtt("tabla_puntos", "visible", "N" , "clave_campana" ); 					}				}								//obtener costo por mano de obra para orden																														var cmd = "select c4 as costo_por_mano, c11 as iva from keplersc.kdmargen where c1='" & frn.get("tipo_orden", -1, 1) & "'";				var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.cambio_orden()");				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_resultados   ");							var ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									costo_por_mano = getXmlAtt(cubo,"r0","costo_por_mano");				iva = 1+(getXmlAtt(cubo,"r0","iva")/100);											}											fun horas_puntos(i){							var hrs = frn.get("tabla_puntos",-1,"horas");				var tipo_punto =  frn.get("tabla_puntos", i, "tipo_punto" );								if (hrs &= "" || hrs <= 0 ){									if (tipo_punto &= "P" ){							frn.setX(horas_P ,"tabla_puntos", i , "horas");					}					if (tipo_punto &= "H" ){							frn.setX(horas_H ,"tabla_puntos", i , "horas");					}					if (tipo_punto &= "G" ){							frn.setX(horas_G ,"tabla_puntos", i , "horas");					}					if (tipo_punto &= "I" ){							frn.setX(horas_I ,"tabla_puntos", i , "horas");					}					if (tipo_punto &= "L" ){							frn.setX(horas_L ,"tabla_puntos", i , "horas");					}					if (tipo_punto &= "Q" ){							frn.setX(horas_Q ,"tabla_puntos", i , "horas");					}					if (tipo_punto &= "F" ){							frn.setX(horas_F ,"tabla_puntos", i , "horas");					}					if (tipo_punto &= "R" ){							frn.setX(horas_R ,"tabla_puntos", i , "horas");					}									}							}												fun Alta(){				var xmlRequest ,cmd, cubo,ok ,mensajeError,promo_sel;				//Validaciones pre ejecucion								resVal = 1;					//MSS 15102024: Permitir capturar un folio manual				FolioManual();									if(resVal == 0){								return;				}				promo_sel=frn.get("cmb_promocion",-1,1);				if (promo_sel &!""){					cmd ="select count(*) as totReg " &						"from keplersc.kdsercatpromo " &						"where clave ='" & promo_sel & "' and fecha_inicial <='" & frn.get("fecha_cita") & "' and fecha_final >= '" & frn.get("fecha_cita") &	"'";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.validaciones_pre_ejecucion()");					ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					if (getXmlAtt(cubo,"r0","totreg")&=0){						frn.message("La promocion seleccionada no esta vigente","Error","Aceptar");						return 1;					}				}				if ( frn.get("serie") &! "" ){					if (kodawari &= "S" ){										if (historial_consultado &= "0" ){							frn.message("Tiene que consultar el historial de la unidad por lo menos una vez","Error","Aceptar");							return ;						}					}									if (campanas_consultado &= "0" && num_campanas > 0 ){						frn.message("Tiene que consultar las campañas pendientes de la unidad","Error","Aceptar");						return ;					}										if (recomendaciones_consultado &= "0" && num_recomendaciones > 0 ){						frn.message("Tiene que consultar las Recomendaciones pendientes de la unidad","Error","Aceptar");						return ;					}									}								var respuesta = frn.message("¿ Seguro quieres guardar la orden ?","Atencion",2);				if (respuesta == 0){					return;				}							xmlRequest = getXml(frn.dataPag()); //Obtener el xml de la pantalla;							setXml(xmlRequest ,"ctd_puntos",frn.N("tabla_puntos") - 1);				setXml(xmlRequest ,"ctd_sintomas",frn.N("tabla_sintomas") - 1);				setXml(xmlRequest ,"tipo_operacion",tip_ope);				setXml(xmlRequest,"folio_cita_encontrada",frn.get("folio_cita"));				setXml(xmlRequest ,"usuario",usuario);								frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequestAlta ");								cmd="SELECT * FROM keplersc.orden_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"srvordencrud.Alta");										frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");							var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								if(resultado &= "1"){					var mensaje = getXml(cubo ,"mensaje");					frn.message(mensaje ,"Atencion","Aceptar");				}								folio_orden = getXml(cubo ,"adicionales");				tip_orden =  frn.get("tipo_orden",-1,1);												if (tip_ope == 0){					ParamValor = ParametroValor("Precio inicial 0 orden hojalateria");		//MSS 04122024 PARAMETRIZAR PRECIO EN 0 PARA ORDENES DE HOJALATERIA					if (ParamValor &= "S"){											if (frn.get("tipo_orden", -1, 1) &= "H" || frn.get("tipo_orden", -1, 1) &= "K"){	//MSS 22102024 CERO EN PRECIO DE PUNTO EN UNA ALTA PARA ORDENES H Y K							frn.set("tipo_orden_bus",descr_combo("tipo_orden_bus",1, tip_orden  ));							frn.set("folio_orden_bus",folio_orden );												tip_ope = 1;							ctrls_off();						}						} else {						frn.set("tipo_orden_bus",descr_combo("tipo_orden_bus",1, tip_orden  ));						frn.set("folio_orden_bus",folio_orden );										tip_ope = 1;						ctrls_off();						buscar_datos();					}				}				confWalkaround();			}							fun borrar_datos(){							frn.rst("folio_cita");				frn.rst("clave_cliente");				frn.rst("vin");				frn.rst("placas_bus");				frn.rst("fecha_cita");				frn.rst("hora_cita");				frn.rst("fecha_entrega");				frn.rst("hora_entrega");				frn.rst("fecha_original");				frn.rst("hora_original");				frn.rst("cliente_rfc");				frn.rst("cliente_extension");				frn.set("tipo_orden",descr_combo("tipo_orden",1,"T"));				frn.rst("folio_orden_bus");				frn.rst("clave_cliente_bus");				frn.rst("vin_bus");				frn.rst("placas_bus");				frn.set("num_citas","");								colores_botones();				borrar_cita_anterior();									borrar_datos_cli();				borrar_datos_vin();						frn.set("cli_desea_ser_contactado", "");							frn.rst("bonete");				frn.rst("siniestro");				borrar_tablas();				frn.rst("subt");				frn.rst("k_iva");				frn.rst("tiempo");				frn.rst("k_monto");				frn.rst("observaciones");					}						fun borrar_tablas(){				frn.rst("tabla_puntos");				frn.rst("tabla_sintomas");				frn.rst("puntorel_sintoma");				frn.rst("rel_sintoma");				frn.rst("comentarios_sintomas");			}						fun borrar_cita_anterior(){				frn.setAtt("folio_cita", "visible", "N");				frn.setAtt("txt_folio_cita", "visible", "N");				frn.setAtt("cve_tmkt", "visible", "N");				frn.setAtt("txt_cve_tmkt", "visible", "N");				frn.setAtt("fecha_cita", "visible", "N");				frn.setAtt("txt_fecha_cita", "visible", "N");				frn.setAtt("hora_cita", "visible", "N");				frn.setAtt("txt_hora_cita", "visible", "N");			}												fun borrar_datos_cli(){								frn.rst("cliente_id");					frn.rst("cliente_nombre");					frn.rst("cliente_calle");					frn.rst("cliente_ext");					frn.rst("cliente_int");					frn.rst("cliente_colonia");					frn.rst("cliente_rfc");					frn.rst("cliente_poblacion");					frn.rst("cliente_municipio");					frn.rst("cliente_estado");					frn.rst("cliente_pais");					frn.rst("cliente_cp");					frn.rst("cliente_correo");					frn.rst("cliente_tcasa");					frn.rst("cliente_toficina");					frn.rst("cliente_tmovil");					frn.rst("cita_cliente");			}						fun borrar_datos_vin(){								frn.rst("marca");					frn.rst("modelo");					frn.rst("anio");					frn.rst("color");					frn.rst("kms");					frn.rst("serie");					frn.rst("placas");					frn.rst("codigo");			}						fun colores_botones(){				//MSS 005112025 Ajustes conf botones Campanas-Ifz				frn.setAtt("bot_campanas", "bclr", "237,238,239");				frn.setAtt("bot_campanas", "clr", "0,0,0" );				frn.setAtt("bot_campanas", "fnt",",");				frn.setAtt("bot_recomendaciones", "clr", "0,0,0" );				frn.setAtt("bot_recomendaciones", "fnt",",");				frn.setAtt("bot_historial", "clr", "0,0,0" );				frn.setAtt("bot_horarios", "clr", "0,0,0" );				frn.setAtt("bot_walkaround", "clr", "0,0,0" );			}						fun confWalkaround(){				if (tip_ope == 0){					frn.setAtt("bot_walkaround", "available", "N" );					frn.setAtt("bot_walkaround", "clr", "180,180,180" );				}else{					frn.setAtt("bot_walkaround", "available", "Y" );					frn.setAtt("bot_walkaround", "clr", "0,0,0" );				}					}			fun MostrarHistOrdenes(){				var serie=frn.get("vin");				frn.dialog("serhistorialorden",serie,frn.get("k_sucN",-1,1));				historial_consultado = "1";			}			fun MostrarRecomendaciones(){				frn.dialog("recomendaciones");				recomendaciones_consultado = "1";			}			fun MostrarCampanas(){				frn.dialog("campanas","s");				campanas_consultado = "1";			}					fun catalogo_paquetes(){							var tipo_punto = frn.get("tabla_puntos",-1,"tipo_punto");								if (tipo_punto &! "S"){					frn.message("Selecciona un punto S para poder abrir el catalogo de paquetes","Error","Aceptar");					return;				}								var marca = frn.get("marca");				var modelo = frn.get("modelo");								if (marca &= "" || modelo &= ""){					frn.message("Selecciona Marca y Modelo para abrir el Catalogo de paquetes","Error","Aceptar");					return;				}							//frn.dialog("cat_paquetes",marca,modelo);				ObtenerCatPaquetes();			//MSS 09122024 Obtiene catalogo			}						fun catalogo_campanas(){							var tipo_punto = frn.get("tabla_puntos",-1,"tipo_punto");								if (tipo_punto &! "G"){					frn.message("Selecciona un punto G para poder abrir el catalogo de campañas","Error","Aceptar");					return;				}								var serie= frn.get("serie");				if (serie &= ""){					frn.message("Selecciona una serie para abrir el Catalogo de campañas","Error","Aceptar");					return;				}                        //MSS 06112025 Cambie el catalogo de kdcat_campana por kdsercampanacat y sus respectivas columnas				var cmdQuery = "select camp.c3 as clave, cat.descripcion as descripcion									from keplersc.kdsercampana as camp inner join keplersc.kdsercampanacat as cat on cat.clave_campana=camp.c3 where camp.c2='" & serie & "' and camp.c4=0";                        frn.dialog("genlistafiltrosel","Campañas Pendientes",cmdQuery,"clave","tabla_puntos", "-1","clave_campana","S","S");						}						fun MostrarHorarios(){				frn.dialog("horarios_disp_recep",tip_ope);			}						fun tipo_punto(){				frn.dialog("tipo_punto",frn.get("tipo_orden", -1, 1));			}						fun ListaOrdenes(){				var cmdQuery;				borrar_datos();				cmdQuery = "select ord.c2 as t,ord.c3 as orden,to_char(ord.c4, 'dd/mm/yyyy') as fecha,ord.c6 as vin_ult_8,ser.c3 as modelo,ord.c10 as cve_cte,ord.c11 as nombre,						ord.c21 as placas,case when ord.c7=0 then 'ABIERTA' when ord.c7=10 then 'CERRADA' when ord.c7=20 then 'LISTA P/VALE' 						when ord.c7=30 then 'VALE SALIDA' else '' end as estatus,concat(ord.c2,'~',ord.c3) as torden						from keplersc.kdord ord						inner join keplersc.kdud as cli on ord.c10=cli.c2						left join keplersc.kdserie ser on ser.c1=ord.c6						where ord.c1 ='" & frn.get("k_sucN", -1, 1) & "' order by ord.c4 desc"; 				frn.dialog("genlistafiltrosel","Ordenes Taller",cmdQuery,"torden","folio_orden_bus","0","0","S","N");										}								fun GenerarReporte(){							var compania,strValor, fechaImpresion, horaImpresion,contpun,cmd ,cubo,ok,mensajeError,ftoReporte,numCaracteres;				if (frn.get("folio_orden_bus") &= ""){					frn.message("No ha seleccionado una orden para imprimir");					return;				}				IniParams();								kdb.kde("KDE");//Configuracion del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();								//MSS 11062025 Parametrizar el formato que se utilizara para el reporte				ftoReporte = ParametroValor("Formato alta orden");				if (ftoReporte &= ""){					kdb.readPage("datos","srvordencrudfto");//se define el formato a usar					numCaracteres = 167;			//Tamaño de letra Arial 10 en observaciones				} else{					kdb.readPage("datos",ftoReporte);//se define el formato a usar					numCaracteres = 115;			//Tamaño de letra Arial 15 en observaciones				}					kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parametros finales de impresion.(rep.page(...);)				rep.set("suc_desc",frn.get("k_sucN",-1,0));				rep.set("tipo_orden",frn.get("tipo_orden",-1,1));				rep.set("folio_orden",frn.get("folio_orden_bus"));							//obtener datos asesor de servicio				cmd = "select c2,c6,c7,c20 from keplersc.kdrecep where c12='" & frn.get("recepcionista",-1,1) & "'"; 				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.GenerarReporte()");				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo   ");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				rep.set("asesor_servicio",getXmlAtt(cubo,"r0" ,"c2"));				rep.set("tel_movil_asesor",getXmlAtt(cubo,"r0" ,"c6"));				rep.set("tel_oficina_asesor",getXmlAtt(cubo,"r0" ,"c7"));				rep.set("extension_asesor",getXmlAtt(cubo,"r0" ,"c20"));									rep.set("fecha_recep",frn.get("fecha_captura_orden"));				rep.set("hora_recep",frn.get("hora_captura_orden"));				rep.set("fecha_entrega",frn.get("fecha_entrega"));				rep.set("hora_entrega",frn.get("hora_entrega"));				rep.set("rep_fecha",fechaImpresion);				rep.set("rep_hora",horaImpresion);				rep.exe("encabezado");								rep.set("clave_cli",frn.get("cliente_id"));				rep.set("cliente_nombre",frn.get("cliente_nombre"));				rep.set("nombre_razon_social",frn.get("cliente_nombre"));								rep.set("correo",frn.get("cliente_correo"));								rep.set("rfc",frn.get("cliente_rfc"));				rep.set("calle",frn.get("cliente_calle"));				rep.set("no_int",frn.get("cliente_int"));				rep.set("no_ext",frn.get("cliente_ext"));				rep.set("colonia",frn.get("cliente_colonia"));				rep.set("cuidad_poblacion",frn.get("cliente_poblacion"));				rep.set("municipio_delegacion",frn.get("cliente_municipio"));								rep.set("estado",frn.get("cliente_estado"));				rep.set("pais",frn.get("cliente_pais"));				rep.set("codigo_postal",frn.get("cliente_cp"));								rep.set("tel_casa",frn.get("cliente_tcasa"));				rep.set("tel_oficina",frn.get("cliente_toficina"));				rep.set("extension",frn.get("cliente_extension"));				rep.set("tel_movil",frn.get("cliente_tmovil"));								rep.set("vin",frn.get("vin"));				rep.set("serie",frn.get("serie"));				rep.set("marca",frn.get("marca"));				rep.set("modelo",frn.get("modelo"));				rep.set("anio",frn.get("anio"));								rep.set("color",frn.get("color"));				rep.set("placas",frn.get("placas"));				rep.set("kms",frn.get("kms"));								rep.exe("datos_principales");				rep.exe("tit_trabajos");				rep.exe("encabezadotrabajos");						for (contpun=0; contpun<frn.N("tabla_puntos") - 1;contpun++){									var pun = frn.get("tabla_puntos" , contpun, "tipo_punto");					var paq = frn.get("tabla_puntos" , contpun, "clave_paquete");					var desc_pun = frn.get("tabla_puntos" , contpun, "trabajo_a_realizar");					var trabajo = pun ;									if( paq &! ""){						trabajo = trabajo & " - " & paq ;					}					if( desc_pun &! ""){						trabajo = trabajo & "  " & desc_pun ;					}					rep.set("trabajo",trabajo);					rep.set("costo",frn.get("tabla_puntos" , contpun, "precio_punto"));					rep.exe("trabajos");				}								rep.exe("linea_trabajos");				rep.set("subtotal",frn.get("subt"));				rep.set("iva",frn.get("k_iva"));				rep.set("total",frn.get("k_monto"));				rep.exe("totales");				var strObservaciones = frn.get("observaciones");				var num_strObservaciones = strSplit(strObservaciones," ",-1);				var observaciones1 = "";				var observaciones2 = "";				var observaciones3 = "";				var observaciones4 = "";				var observaciones5 = "";				var observaciones6 = "";				for (var palabra=0; palabra<num_strObservaciones ;palabra++){					if ((strlen(observaciones1)+strSplit(strObservaciones," ", palabra)) < numCaracteres){						observaciones1 = observaciones1 & strSplit(strObservaciones," ", palabra) & " ";					}					else{						if ((strlen(observaciones2)+strSplit(strObservaciones," ", palabra)) < numCaracteres){						observaciones2 = observaciones2 & strSplit(strObservaciones," ", palabra) & " ";						}						else{							if ((strlen(observaciones3)+strSplit(strObservaciones," ", palabra)) < numCaracteres){							observaciones3 = observaciones3 & strSplit(strObservaciones," ", palabra) & " ";							}							else{								if ((strlen(observaciones4)+strSplit(strObservaciones," ", palabra)) < numCaracteres){								observaciones4 = observaciones4 & strSplit(strObservaciones," ", palabra) & " ";								}								else{									if ((strlen(observaciones5)+strSplit(strObservaciones," ", palabra)) < numCaracteres){									observaciones5 = observaciones5 & strSplit(strObservaciones," ", palabra) & " ";									}else{										if ((strlen(observaciones6)+strSplit(strObservaciones," ", palabra)) < numCaracteres){										observaciones6 = observaciones6 & strSplit(strObservaciones," ", palabra) & " ";										}									}								}							}						}					}					}				rep.set("observaciones1",observaciones1);				rep.set("observaciones2",observaciones2);				rep.set("observaciones3",observaciones3);				rep.set("observaciones4",observaciones4);				rep.set("observaciones5",observaciones5);				rep.set("observaciones6",observaciones6);							//obtener actividades preentrega				cmd = "select c2 from keplersc.kdactpreent"; 				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.GenerarReporte()");				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo   ");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								var totacts = nXml(cubo);								for (var contact=0; contact<totacts ;contact++){					rep.set("act" & contact ,getXmlAtt(cubo,"r" & contact ,"c2"));				}								rep.set("contacto_firma1",frn.get("cliente_nombre"));				rep.set("contacto_firma2",frn.get("cliente_nombre"));				rep.exe("datos_secundarios");								rep.exe("encabezado_sintomas");				//obtener sintomas				var k_suc = frn.get("k_sucN" , -1, 1);				var k_tipo_ord = frn.get("tipo_orden", -1, 1);				var k_folio_ord = frn.get("folio_orden_bus");				cmd = "						select tsin.c2 as tipo_sintoma, des.c3 as desc_sintoma from keplersc.kdordsint clv						inner join keplersc.kdvaltipsin des on clv.c6 = des.c1 and clv.c7 = des.c2 						inner join keplersc.kdtipsin tsin on clv.c6 = tsin.c1						where clv.c1 = '"& k_suc &"' and clv.c2 ='"& k_tipo_ord &"' 						and clv.c3 ='"& k_folio_ord &"' order by clv.c4"; 				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.GenerarReporte()");				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_sintomas   ");					var n_sintomas = nXml(cubo);				for (var ren=0; ren<n_sintomas ;ren++){					rep.set("tipo_sintoma",getXmlAtt(cubo,"r" & ren ,"tipo_sintoma"));					rep.set("desc_sintoma",getXmlAtt(cubo,"r" & ren ,"desc_sintoma"));					rep.exe("dato");				}				rep.exe("datos_firmas");				rep.win();							}						fun edicion_vin(){				var strSerie = frn.get("serie");				if (strSerie &= ""){					frn.message("Debe especificar una serie para modificar","Error","Aceptar");					return ; 				}				frn.set("serie_paso",frn.get("serie"));				frn.dialog("cat_serie_crud","Modificar","x","s","serie_paso");			}						fun Operadores(){				var tipo_operario = frn.get("tabla_puntos",-1,"tipo_operario");				var cmdQuery = "select c1 as clave, c2 as tipo, c3 as nombre , c1 || '|' || c3 as clave_desc " &				" from keplersc.kdoper where c2='" & tipo_operario & "' and c12='S' ";				//					frn.dialog("genlistasel","Operadores",cmdQuery,"clave_desc","tabla_puntos", "","clave_operario","N");					frn.dialog("genlistafiltrosel","Operadores",cmdQuery,"clave_desc","tabla_puntos", "","clave_operario","N");            			}						fun Ope_insert(){						  var clave_operario = frn.get("tabla_puntos", -1, "clave_operario");			  			  var clave= strSplit(clave_operario ,"|",0);           var descr = strSplit(clave_operario ,"|",1);                      frn.setX(clave, "tabla_puntos", -1, "clave_operario");           frn.setX(descr , "tabla_puntos", -1, "clave_operario_desc");            						}						fun walkaround(){				var vin,cmd,cubo,ok,mensajeError,cliente,nombre,foliorden,tiporden; 				vin=mid(frn.get("serie"),9,8);				tiporden = frn.get("tipo_orden",-1,1);				if (tip_ope == 0){					foliorden = folio_orden;				}				if (tip_ope == 1){					foliorden = frn.get("folio_orden_bus");				}				if (foliorden &= ""){					frn.message("No hay una orden seleccionada");					return;				}				cmd = " select c10, c11 from keplersc.kdord where c1='" & frn.get("k_sucN",-1,1) & "' and c2='" & tiporden & "' and c3='" & foliorden  & "' and c6='" & vin & "'";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcerrarorden.walkaround()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\walk");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				cliente =getXmlAtt(cubo,"r0", "c10");				nombre=getXmlAtt(cubo,"r0", "c11");						frn.dialog("srv_cuest_pre","CUESTWLKA", frn.get("k_sucN",-1,1),tiporden,foliorden, vin, cliente, nombre);				frn.setAtt("Imprimir", "visible", "Y" );			}						fun obtenerSerie(tipo){						var cmdQuery, sucursal_id;				sucursal_id=frn.get("k_sucN", -1, 1);				frn.set("folio_cita","");				if (tipo&="serie") {					cmdQuery = "select s.c4 as serie,s.c2 as marca,s.c3 as modelo,s.c10 as color,s.c8 as placas,s.c9 as cve_cte,cli.c3 as nombre,						ct.c37 as tipo,ct.c2 as cita,concat(s.c4,'~',ct.c2) as cita_serie 						from keplersc.kdserie as s						inner join keplersc.kdud as cli on s.c9=cli.c2 " &						"left join keplersc.kdctasser ct on ct.c9=s.c4 and ct.c20 in (0,10) 						and ct.c12>='" & rango_inicial & "' and ct.c12<='" & rango_final & "' ";					frn.dialog("genlistafiltrosel","Catalogo de Series",cmdQuery,"cita_serie","serie","0","0","S","N");				}				}			fun obtenerCliente(){				var cmdQuery, sucursal_id;				sucursal_id=frn.get("k_sucN", -1, 1);				frn.set("folio_cita","");				frn.set("serie","");				cmdQuery = "select ud.c2 as cve_cte,ud.c3 as nombre,ct.c9 as serie,ser.c3 as modelo,ct.c37 as tipo,ct.c2 as cita,concat(ud.c2,'~',ct.c2) as cita_cliente " &						"from keplersc.kdud ud " &						"left join keplersc.kdctasser ct on ct.c4=ud.c2 and ct.c20 in (0,10)  						and ct.c12>='" & rango_inicial & "' and ct.c12<='" & rango_final &  						"' left join keplersc.kdserie ser on ser.c4=ct.c9 order by ud.c2 ";																			frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\cmdcliente");				frn.dialog("genlistafiltrosel","Clientes",cmdQuery,"cita_cliente","cliente_id","0","0","S","N");				}			fun separaSerieCita(){				var fcita,nCampos,serie_id;					frn.set("folio_cita","");				frn.set("cve_tmkt","");				frn.set("fecha_cita","");				frn.set("hora_cita","");								//Separa el serie y folio cita, vienen concatenados con ~				nCampos = strSplit(frn.get("serie"),"~",-1);				if (nCampos > 1) {					serie_id = strSplit(frn.get("serie"),"~",0);					fcita = strSplit(frn.get("serie"),"~",1);					frn.set("serie",serie_id);					frn.set("cita_cliente",fcita);				}								bus_cli_vin("serie");			}			fun OrdenTipo(){				var tord,nCampos,nfolio;					//Separa el tipo y folio orden, vienen concatenados con ~				nCampos = strSplit(frn.get("folio_orden_bus"),"~",-1);				if (nCampos > 1) {					tord = strSplit(frn.get("folio_orden_bus"),"~",0);					nfolio = strSplit(frn.get("folio_orden_bus"),"~",1);					frn.set("tipo_orden_bus",tord);					frn.set("folio_orden_bus",nfolio);				}				Formar_folio();				//MSS 010824 Limpiar datos placas, cliente, y ult8vin para sig asegurar siguientes busquedas				frn.set("clave_cliente_bus","");				frn.set("vin_bus","");				frn.set("placas_bus","");			}			fun ModificaCliente(){				var strCte = frn.get("cliente_id");				if (strCte &= ""){					frn.message("Debe especificar un cliente para modificar","Error","Aceptar");					return ; 				}				frn.set("cte_paso",frn.get("cliente_id"));				Dialog(3,"cat_cli_crud","Modificar","x","s","cte_paso"); 			}			fun ActualizaDatosCteVin(tipo){				var kms_ord, bonete_ord, siniestro_ord;				kms_ord = frn.get("kms");				bonete_ord = frn.get("bonete");				siniestro_ord = frn.get("bonete");				bus_cli_vin(tipo);				//actualiza los datos que traia la orden				frn.set("kms",kms_ord);				frn.set("bonete",bonete_ord);				frn.set("siniestro",siniestro_ord);			}			fun ValidaRecoleccion(){				if (frn.get("cmb_tipo_servicio",-1,1) &= "R"){					frn.dialog("srvrecoleccion.kpl");					frn.setAtt("bot_recoleccion","visible","Y");				} else {					frn.setAtt("bot_recoleccion","visible","N");					frn.set("calle_recoleccion","");					frn.set("num_ext_recoleccion","");					frn.set("num_int_recoleccion","");					frn.set("colonia_recoleccion","");					frn.set("poblacion_recoleccion","");					frn.set("municipio_recoleccion","");					frn.set("estado_recoleccion","");					frn.set("cp_recoleccion","");					frn.set("contacto_recoleccion","");					frn.set("fecha_recoleccion","");					frn.set("horario_recoleccion",);					frn.set("regresa_domicilio","");					frn.set("observaciones_recoleccion","");				}			}			fun Llena_cmbpromocion(){				var cmd, cubo, ok,mensajeError; 				cmd = "select '['||clave||'] '||descripcion as descripcion, clave " &					"from keplersc.kdsercatpromo " &					"where fecha_inicial <='" & frn.get("fecha_captura_orden") & "' and fecha_final >= '" & frn.get("fecha_captura_orden") &					"' order by fecha_inicial";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Llena_cmbpromocion()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.rst("cmb_promocion");				frn.setX("","cmb_promocion", 0 ,0);				llenar_cmb(cubo,"cmb_promocion");			}						//MSS 010824 Permitir modificar fecha para ordenes de garantia			fun ValNivelUsuario(){				var cmd, cuboXml, ok,mensajeError;				cmd = "select count(*) as nivel from keplersc.param_opc_usr_sec						where sucursal ='" & frn.get("k_sucN",-1,1) & "' and opcion='Modifica fecha orden G' and lower(usuario) = lower('" & usuario & "')"; 				rstXml(cuboXml);				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"presupuesto.buscar_registros()");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}					return(getXmlAtt(cuboXml,"r0","nivel"));								}			//MSS 010824 Valida Fecha de captura 			fun FechaCaptura() {				var hr_ant;				hr_ant = frn.get("hora_captura_orden");				frn.set("hora_captura_orden",sys.time());				if (strFormat("date",frn.get("fecha_captura_orden"),0,"DD/MM/YY") > strFormat("date",sys.date(),0,"DD/MM/YY")){		//Validar fecha que no sea futura					frn.set("hora_captura_orden",hr_ant);					frn.message("La fecha no puede ser mayor a la fecha de hoy","Atencion","Aceptar");					return;				}			}			//MSS 010824			fun FechaEnt(){				frn.set("fecha_original",frn.get("fecha_entrega"));			}				//MSS 010824			fun HoraEnt(){				frn.set("hora_original",frn.get("hora_entrega"));			}						fun ParametroValor(ParamNombre){			//MSS 04122024 PARAMETRIZAR PRECIO EN 0 PARA ORDENES DE HOJALATERIA				var cubo,cmd,ok,mensajeError ;				cmd = "select coalesce(valor,'') as valor from keplersc.param_oper						where sucursal ='" & frn.get("k_sucN",-1,1) & "' and parametro='" & ParamNombre & "'";				rstXml(cubo);				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"autorizacion.ParametroValor()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				return getXmlAtt(cubo,"r0","valor");			}			fun ActivaFolioManual(){		//MSS 05122024: Permitir capturar un folio manual				var configfolio;				configfolio = ParametroValor("Folio manual orden");								if (tip_ope &=0){					if (configfolio &= "S") {	// Folio Manual						folioManual = "S";						frn.setAtt("folio_orden_bus", "visible", "Y");						frn.setAtt("buscadores", "visible", "Y" );						frn.setAtt("tipo_orden_bus", "visible", "N" );						frn.setAtt("clave_cliente_txt", "visible", "N" );						frn.setAtt("clave_cliente_bus", "visible", "N" );						frn.setAtt("vin_txt", "visible", "N" );						frn.setAtt("vin_bus", "visible", "N" );						frn.setAtt("placas_bus_txt", "visible", "N" );						frn.setAtt("placas_bus", "visible", "N" );						frn.setAtt("buscar_datos", "visible", "N" );						frn.setAtt("bot_imgrep", "visible", "N" );												} else{						folioManual = "N";						frn.setAtt("buscadores", "visible", "N" );						}				} else{						frn.setAtt("folio_orden_bus", "visible", "Y");						frn.setAtt("tipo_orden_bus", "visible", "Y" );						frn.setAtt("clave_cliente_txt", "visible", "Y" );						frn.setAtt("clave_cliente_bus", "visible", "Y" );						frn.setAtt("vin_txt", "visible", "Y" );						frn.setAtt("vin_bus", "visible", "Y" );						frn.setAtt("placas_bus_txt", "visible", "Y" );						frn.setAtt("placas_bus", "visible", "Y" );						frn.setAtt("buscar_datos", "visible", "Y" );						frn.setAtt("bot_imgrep", "visible", "Y" );						frn.setAtt("buscadores", "visible", "Y" );				}											}			fun FolioManual(){					//Valida Folio Manual				//MSS 09112024: Permitir capturar un folio manual				var totReg;				var cuboQuery,cmdQuery,ok,mensajeError;				nfolioManual = frn.get("folio_orden_bus");				if (folioManual &="S"){					if (nfolioManual &= ""){						frn.setPos("folio_orden_bus");						resVal=0;						frn.message("Es necesario capturar el Folio","Error","Aceptar");						return;					} else{								//valida longitud del folio						if (strlen(nfolioManual) < 10){							frn.setPos("folio_orden_bus");							resVal=0;							frn.message("El folio debe ser de 10 caracteres....Verifique","Error","Aceptar");							return;						}						if (strlen(nfolioManual) > 10){							frn.setPos("folio_orden_bus");							resVal=0;							frn.message("El folio no puede ser mayor de 10 caracteres....Verifique","Error","Aceptar");							return;						}						//valida que no exista						cmdQuery = "select count(*) as totreg " & 							"from keplersc.kdord " &							"where c1='" & frn.get("k_sucN",-1,1) & "' and c3='" & nfolioManual  & "'";										rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.FolioManual()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery, "c:\Basura\ExisteFolioManual");						ok = getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok) {							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;							}						totReg=getXmlAtt(cuboQuery,"r0","totreg");						if (totReg > 0){							frn.setPos("folio_orden_bus");							resVal=0;							frn.message("El folio capturado ya existe....Verifique","Error","Aceptar");							return;						}					}				}			}			fun ObtenerTipoPunto(){					//MSS 09122024 Obtiene catalogo				var cmd;												cmd= "select pun.c2 as punto, cat.c2 as descripcion from keplersc.kdtipoordentipopuntos as pun " & 					"inner join keplersc.catpuntos as cat on cat.c1= pun.c2 " &					"where pun.c1='" & frn.get("tipo_orden", -1, 1) & "'";					frn.dialog("genlistafiltrosel","Puntos",cmd,"punto","tabla_puntos",-1,"desc_punto","S","S");					   			}				fun valTipo_punto(){			//MSS 06122024 Valida dato capturado				var cubo,cmd,ok,mensajeError,len_result;								cmd="select punto,descr from (" &					"select pun.c2 as punto, cat.c2 as descr from keplersc.kdtipoordentipopuntos as pun " & 					"inner join keplersc.catpuntos as cat on cat.c1= pun.c2 " &					"where pun.c1='" & frn.get("tipo_orden", -1, 1) & "') puntos " &					"where punto='" & frn.get("tabla_puntos", -1, "desc_punto") & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"valTipo_punto.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								len_result = nXml(cubo);								if (len_result == 0){					frn.message("El tipo de punto " & frn.get("tabla_puntos", -1, "desc_punto")  & " para el tipo de orden " & frn.get("tipo_orden", -1, 1) & " no existe. Verifique...","Error","Aceptar");					frn.setPos("tabla_puntos", -1, "desc_punto");					frn.setX("", "tabla_puntos", -1, "desc_punto");					frn.setX("", "tabla_puntos", -1, "tipo_punto");					return;				} else {					frn.setX(getXmlAtt(cubo,"r0", "punto"), "tabla_puntos", -1, "tipo_punto");					frn.setX(getXmlAtt(cubo,"r0", "descr"), "tabla_puntos", -1, "desc_punto");				}				calc_importe();			}			fun ObtenerTipoOperario(){				//MSS 09122024 Obtiene catalogo				var cmd,tipo_punto;				tipo_punto= frn.get("tabla_puntos" , -1, "tipo_punto");								cmd= "select cat.c1 clave,cat.c2 tipo from keplersc.kdpuntop as top inner join keplersc.kdtoper as cat on cat.c1=top.c2 where top.c1='" & tipo_punto & "'";					frn.dialog("genlistafiltrosel","Tipo Operario",cmd,"clave","tabla_puntos",-1,"desc_operario","S","S");					   			}			fun valTipo_operario(){					//MSS 06122024 Valida dato capturado				var cubo,cmd,ok,mensajeError,len_result,tipo_punto,tipo_oper;				tipo_oper=frn.get("tabla_puntos" , -1, "desc_operario");				tipo_punto= frn.get("tabla_puntos" , -1, "tipo_punto");				cmd="select tipo,descr from (" & 					"select cat.c1 tipo,cat.c2 descr from keplersc.kdpuntop as top inner join keplersc.kdtoper as cat on cat.c1=top.c2 where top.c1='" & tipo_punto & "') tp " &					"where tipo = '" & tipo_oper & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"valTipo_operario.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								len_result = nXml(cubo);								if (len_result == 0){					frn.message("El tipo de operario no existe. Verifique...","Error","Aceptar");					frn.setPos("tabla_puntos", -1, "desc_operario");					frn.setX("", "tabla_puntos", -1, "desc_operario");					frn.setX("", "tabla_puntos", -1, "tipo_operario");					return;				} else {					frn.setX(getXmlAtt(cubo,"r0", "tipo"), "tabla_puntos", -1, "tipo_operario");					frn.setX(getXmlAtt(cubo,"r0", "descr"), "tabla_puntos", -1, "desc_operario");				}						}			fun ObtenerCatPaquetes(){				//MSS 09122024 Obtiene catalogo			var cmd,marca,modelo;				marca = frn.get("marca");				modelo = frn.get("modelo");				cmd="select c4 clave,c5 descripcion,c9 horas,c10 precio from keplersc.kdspaq where c1='" & marca & "' and c2='" & modelo & "'";				frn.dialog("genlistafiltrosel","Catalogo Paquetes",cmd,"clave","tabla_puntos",-1,"clave_paquete","S","S");				}			fun ValPaquete(){						//MSS 09122024 Valida datos capturado				var cubo,cmd,ok,mensajeError,len_result,marca,modelo,paquete,tipo_punto;				marca = frn.get("marca");				modelo = frn.get("modelo");				paquete= frn.get("tabla_puntos" , -1, "clave_paquete");				tipo_punto = frn.get("tabla_puntos",-1,"tipo_punto");				if (paquete &! ""){					if (tipo_punto &! "S"){						frn.setX(getXmlAtt(""), "tabla_puntos", -1, "clave_paquete");						frn.setPos("tabla_puntos", -1, "clave_paquete");						frn.message("Selecciona un punto S para paquetes","Error","Aceptar");						return;					}														if (marca &= "" || modelo &= ""){						frn.setX(getXmlAtt(""), "tabla_puntos", -1, "clave_paquete");						frn.setPos("tabla_puntos", -1, "clave_paquete");						frn.message("Selecciona Marca y Modelo para validar el paquete","Error","Aceptar");						return;					}										cmd="select clave,descr,horas,precio from (" & 						"select c4 clave,c5 descr,c9 horas,c10 precio from keplersc.kdspaq where c1='" & marca & "' and c2='" & modelo & "') pq " &						"where clave = '" & paquete & "'";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ValPaquete.Inicializa()");										frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");										ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");									len_result = nXml(cubo);									if (len_result == 0){						frn.message("El paquete no existe. Verifique...","Error","Aceptar");						frn.setPos("tabla_puntos", -1, "clave_paquete");						frn.setX("", "tabla_puntos", -1, "clave_paquete");						frn.setX("", "tabla_puntos", -1, "trabajo_a_realizar");						frn.setX("", "tabla_puntos", -1, "horas");						frn.setX("", "tabla_puntos", -1, "precio_punto");						return;					} else {						frn.setX(getXmlAtt(cubo,"r0", "clave"), "tabla_puntos", -1, "clave_paquete");						frn.setX(getXmlAtt(cubo,"r0", "descr"), "tabla_puntos", -1, "trabajo_a_realizar");						frn.setX(getXmlAtt(cubo,"r0", "horas"), "tabla_puntos", -1, "horas");						frn.setX(getXmlAtt(cubo,"r0", "precio"), "tabla_puntos", -1, "precio_punto");					}					calc_importe();				}			}						fun ValOperario(){					//MSS 09122024 Obtiene catalogo				var cubo,cmd,ok,mensajeError,len_result,tipo_operario,cve_operario_desc;				tipo_operario = frn.get("tabla_puntos",-1,"tipo_operario");				cve_operario_desc = frn.get("tabla_puntos", -1, "clave_operario_desc");				if (cve_operario_desc &! ""){					cmd="select clave,nombre from (" & 						"select c1 as clave, c2 as tipo, c3 as nombre , c1 || '|' || c3 as clave_desc " &						" from keplersc.kdoper where c2='" & tipo_operario & "' and c12='S') tp " &						"where clave = '" & cve_operario_desc & "'";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"valTipo_operario.Inicializa()");										frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");										ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");									len_result = nXml(cubo);									if (len_result == 0){						frn.message("El operario no existe. Verifique...","Error","Aceptar");						frn.setPos("tabla_puntos", -1, "clave_operario_desc");						frn.setX("", "tabla_puntos", -1, "clave_operario_desc");						frn.setX("", "tabla_puntos", -1, "clave_operario");						return;					} else {						frn.setX(getXmlAtt(cubo,"r0", "clave"), "tabla_puntos", -1, "clave_operario");						frn.setX(getXmlAtt(cubo,"r0", "nombre"), "tabla_puntos", -1, "clave_operario_desc");					}				}				}			fun ObtenerTipoSintoma(){				//MSS 09122024 Obtiene catalogo				var cmd;												cmd= "select c1 clave,c2 tipo from keplersc.kdtipsin";					frn.dialog("genlistafiltrosel","Tipos de Sintomas",cmd,"clave","tabla_sintomas",-1,"tipo_sintoma","S","S");					   			}				fun valTipo_sintomas(){			//MSS 06122024 Valida dato capturado				var cubo,cmd,ok,mensajeError,len_result,tipo_sintoma;				tipo_sintoma=frn.get("tabla_sintomas", -1, "tipo_sintoma");				if (tipo_sintoma &! ""){					cmd="select clave,tipo from (" &						"select c1 clave,c2 tipo from keplersc.kdtipsin) sint " &						"where clave='" & tipo_sintoma & "'";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"valTipo_punto.Inicializa()");										frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");										ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");									len_result = nXml(cubo);									if (len_result == 0){						frn.message("El tipo de sintoma no existe. Verifique...","Error","Aceptar");						frn.setPos("tabla_sintomas", -1, "tipo_sintoma");						frn.setX("", "tabla_sintomas", -1, "tipo_sintoma");						return;					} else {						frn.setX(getXmlAtt(cubo,"r0", "clave"), "tabla_sintomas", -1, "tipo_sintoma");					}				}			}			fun ObtenerCveSintoma(){				//MSS 09122024 Obtiene catalogo				var cmd,tipo_sintoma;				tipo_sintoma=frn.get("tabla_sintomas", -1, "tipo_sintoma");;												cmd= "select c2 clave,c3 descripcion from keplersc.kdvaltipsin where c1='" & tipo_sintoma & "'";				frn.dialog("genlistafiltrosel","Sintomas",cmd,"clave","tabla_sintomas",-1,"clave_sintoma","S","S");					   			}				fun valCve_sintomas(){			//MSS 06122024 Valida dato capturado				var cubo,cmd,ok,mensajeError,len_result,tipo_sintoma,clave_sintoma;				tipo_sintoma=frn.get("tabla_sintomas", -1, "tipo_sintoma");				clave_sintoma=frn.get("tabla_sintomas", -1, "clave_sintoma");				if (clave_sintoma &! ""){					cmd="select clave,descripcion from (" &						"select c2 clave,c3 descripcion from keplersc.kdvaltipsin where c1='" & tipo_sintoma & "') sint " &						"where clave='" & clave_sintoma & "'";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"valTipo_punto.Inicializa()");										frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");										ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");									len_result = nXml(cubo);									if (len_result == 0){						frn.message("El sintoma no existe. Verifique...","Error","Aceptar");						frn.setPos("tabla_sintomas", -1, "clave_sintoma");						frn.setX("", "tabla_sintomas", -1, "clave_sintoma");						frn.setX("", "tabla_sintomas", -1, "desc_sintoma");						return;					} else {						frn.setX(getXmlAtt(cubo,"r0", "descripcion"), "tabla_sintomas", -1, "desc_sintoma");					}				}			}						fun verifica_ifz_bp_campanas_vin(){					//MSS 06112025 Campanas-Ifz				var cmd, ok, cubo, mensajeError, VN, bp_campanas;				VN = frn.get("serie");				verifica_campanas_recomen();				//verifica ifz				if (cons_ifz &= "0" && VN &! "") {					cmd = "select upper(clave_campana) as clave_campana from keplersc.ifz_bp_campanas_vin where serie='" & VN & "' and fecha_solicitud >= current_date-1 order by fecha_solicitud desc limit 1";									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.verifica_ifz_actualiza_campanas()");								ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}									frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\ifz_campanas");					bp_campanas = nXml(cubo);					if (bp_campanas > 0){						//verificar si esta pendiente la solicitud de consulta a Bp						if (getXmlAtt(cubo,"r0","clave_campana") &= "PENDIENTE") {							//solicitar consulta a Bp							SolicitaConsultaBp(VN);						}					} else{		//si no hay registro de solicitud de consulta						//solicitar consulta a Bp						SolicitaConsultaBp(VN);					}					}							}						fun SolicitaConsultaBp(VN){							//MSS 06112025 Campanas-Ifz				var cmd, ok,cubo,mensajeError, resultado, mensaje,sucursal_id;				sucursal_id=frn.get("k_sucN", -1, 1);;								if (cons_BP &= "0") {					cmd ="select * from keplersc.notif_registrar_movto_campanas('" & VN & "." & sucursal_id & "')";						rstXml(cubo);											cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"srvcitacrud.verifica_ifz_bp_campanas_vin");										frn.lib("libGeneral.kpl","FileSave",cubo,"c:\basura\XmlResultadoConsBP");											resultado = getXml(cubo,"resultado");						mensaje = getXml(cubo,"mensaje");											ok = getXmlAtt(cubo,"ok");						if(ok &! "" && !ok) {							mensajeError = getXmlAtt(cubo,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;							}																	if(resultado &= "1") {							frn.setAtt("bot_campanas", "bclr", "244,230,26");							frn.setAtt("bot_campanas", "clr", "0,0,0");							frn.setAtt("bot_campanas", "fnt",",b");							cons_BP = "1";						} else {											frn.message("No se concreto la consulta a Bp de las campañas|" &mensaje, "Error", "Aceptar");						}				}			}					fun InterfazCampanas(){									//MSS 06112025 Campanas-Ifz				var cuboQuery,cmdQuery,ok,mensajeError,ifz_campanas,sucursal_id;				sucursal_id=frn.get("k_sucN",-1,1);					cmdQuery = "select valor from keplersc.param_oper where sucursal='" & sucursal_id & "' and parametro='interfaz_campanas'";				frn.lib("libGeneral.kpl","FileSave",cmdQuery,"c:\basura\cmdselparamoper");				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcitacrud.InterfazCampanas()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				ifz_campanas = getXmlAtt(cuboQuery,"r0", "valor");				return ifz_campanas;			}			//--------------------------------------------------- funciones importadas----------------------------------------------------------------------		 fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}												fun llenar_cmb(cuboResultados, cmb){				var len_cubo = nXml(cuboResultados);				var pos_ini = frn.N(cmb);				for (var cont=0; cont<len_cubo ; cont++){					var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");					frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}									fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucN",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("folio_orden_bus"));								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				frn.lib("libGeneral.kpl","FileSave",cubofol,"C:\Basura\cuboFol");								var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");								frn.set("folio_orden_bus", fol);				if(tip_ope == 0){ //Alta			//MSS 05122024: Permitir capturar un folio manual					if (folioManual &= "S"){									FolioManual();					}					}						}					fun IniParams(){//Inicializa parametros de impresion, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Pï¿½gina				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","N");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}			fun setRepPage() {//Establece los parametros finales de impresion.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}				}	</script></pag>