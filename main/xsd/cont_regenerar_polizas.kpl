<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte Auxiliar">	<grp dim="1,-1,10,20" brdr="0,0" bclr="192,205,213" clr="0,58,112" fnt="Arial,16" unfont="0" OnF1="Ventana(rep_Hlp)"><br/>	<tab n="1"/>	<txt fnt=",22" clr="0,0,0">Regeneraci&#243;n de P&#243;lizas</txt><br/><tab/>	<hLine dim="0,1" clr="0,0,0"/> 	<br/> 	<br/><tab n="1"/>		<grp dim="90,38,10,5" bclr="236,240,243" tit="Criterio de proceso" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">			<grp dim="70,41,10,5" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">				<sp/>				<chck id="chk_rango" dim="2,16" brdr="1,0" clr="64,64,64" bclr="255,255,255" clrBrdr="0,0,0" YN="10" OnChange="ConfigCriterio(1)"/>				<txt clr="0,0,0" fnt=",16b"> Criterio por rango de cuentas y fechas</txt>				<br/><tab/>				<txt>Iniciales </txt>				<cmb id="k_sucn_ini" clr="64,64,64" clrBrdr="255,255,255"  dim="24,1" bclr="254,254,254" brdr="0,0" fnt="Arial,16" Null="N" hk="S"  					OnChange="resetCampos()" available="Y" modify="Y"/><tab/><txt>Gen.</txt>				<inp id="k_gen_ini" dim="2,1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" 					OnChange="resetCampos()" nc="1"/><txt>  Nat.:</txt>				<inp id="k_nat_ini" dim="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" 					OnChange="resetCampos()" nc="1"/><tab/><txt>Gpo.:</txt>				<inp id="k_gpo_ini" dim="3,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" fmt="5" 					OnChange="resetCampos()" nd="0" nc="3" just="R" max="100" min="1" default="1"/><tab/><txt>Tipo:</txt>				<inp id="k_tipo_ini" dim="3,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nc="3" 					OnChange="resetCampos()" fmt="5" just="R" max="999" min="1" default="1" nd="0"/>				<br/><tab n="1"/>				<txt>Finales </txt><tab/>				<cmb id="k_sucn_fin" clr="64,64,64" clrBrdr="255,255,255"  dim="24,1" bclr="255,255,255" brdr="0,0" fnt="Arial,16" 					OnChange="resetCampos()" Null="N" hk="S"  available="Y"/><tab/><txt>Gen.</txt>				<inp id="k_gen_fin" dim="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" 					OnChange="resetCampos()" nc="1"/><tab/><txt>Nat.:</txt>				<inp id="k_nat_fin" dim="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" 					OnChange="resetCampos()" nc="1"/><tab/><txt>Gpo.:</txt>				<inp id="k_gpo_fin" dim="3,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" 					OnChange="resetCampos()" nc="3" just="R" fmt="5" max="100" min="1" default="1" nd="0"/><tab/><txt>Tipo:</txt>				<inp id="k_tipo_fin" dim="3,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" 					OnChange="resetCampos()" nc="3" just="R" fmt="5" max="100" min="1" default="1" nd="0"/>				<br/>				<sp/>				<chck id="chk_movto" dim="2,16" brdr="1,0" clr="64,64,64" bclr="255,255,255" clrBrdr="0,0,0" YN="10" OnChange="ConfigCriterio(2)"/>				<txt clr="0,0,0" fnt=",16b"> Criterio por movimiento</txt>				<br/><tab n="3"/>				<cmb id="k_sucn_mov" clr="64,64,64" clrBrdr="255,255,255"  dim="24,1" bclr="254,254,254" brdr="0,0" fnt="Arial,16" Null="N" hk="S"  					OnChange="resetCampos()" available="Y" modify="Y"/><tab/><txt>Gen.</txt>				<inp id="k_gen_mov" dim="2,1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" 					OnChange="resetCampos()" nc="1"/><txt>  Nat.:</txt>				<inp id="k_nat_mov" dim="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" 					OnChange="resetCampos()" nc="1"/><txt>  Gpo.: </txt>				<inp id="k_gpo_mov" dim="3,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" fmt="5" 					OnChange="resetCampos()" nd="0" nc="3" just="R" max="100" min="1" default="1"/><txt>    Tipo:</txt>				<inp id="k_tipo_mov" dim="3,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nc="3" 					OnChange="resetCampos()" fmt="5" just="R" max="999" min="1" default="1" nd="0"/><tab/>				<br/><br/>				<hLine/><br/>				<sp/><txt>Fecha inicial: </txt>				<edt id="fecha_ini" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnChange="resetCampos()" type="date" OnButton="Dialog(0,_ks_fecha,fecha_ini)" nc="11" OnChange="AjustaFechaFin(I)"/>				<tab/><txt>Fecha final:</txt>				<edt id="fecha_fin" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnChange="resetCampos()" type="date" OnButton="Dialog(0,_ks_fecha,fecha_fin)" nc="11" OnChange="AjustaFechaFin(F)"/><tab/>				<txt>Movimiento:</txt>				<inp id="inp_mov" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="10"/><br/>							</grp>			<tab n="1"/>						<grp dim="20,41,10,5" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">				<br/><br/><br/><br/><br/><br/><br/><tab/>				<img id="Previo" dim="40,40" bPx="Y" brdr="0,1"  img="20_Find.png" OnEnter="Ejecuta(P)"  available="Y" clrBrdr="0,0,0" visible="Y" modify="Y" tooltip="Vista previa de proceso"/>								</grp>		</grp>		<br/><br/><tab n="1"/>		<grp dim="90,60,10,5" bclr="255,255,255" tit="Detalle de registros a procesar" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">			<sp/>					<tbl id="k_mov" dim="88,13" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" nren="fijo" insdel="N" modify="N" Reorder="N">				<col id="simbolo" name="S" nc="-1" modify="N"/>				<col id="sucursal_id" name="Suc." nc="2"/>				<col id="genero" name="G&#233;n." nc="1"/>				<col id="naturaleza" name="Nat." nc="1"/>				<col id="grupo" name="Gpo." type="string" nc="3"/>				<col id="tipo" name="Tipo" type="string" nc="3"/>				<col id="descripcion" name="Descripci&#243;n" type="string" nc="20"/>				<col id="folio" name="Folio" type="string" nc="15"/>				<col id="fecha" name="Fecha" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="tipo_poliza" name="Tipo" type="string" nc="1"/>				<col id="no_poliza" name="No. P&#243;liza" type="number"/>				<col id="nota" name="Notas" nc="-1"/>				<col id="tipo_poliza_nueva" name="Tipo_N" type="string" nc="1"/>				<col id="no_poliza_nueva" name="P&#243;liza_N" type="number"/><col id="funcion_cont" name="Funcion" type="string" nc="-1"/><col id="tabla_poliza" name="Tabla" type="string"/>							</tbl>			<br/>					<grp dim="20,10,10,5" bclr="255,255,255" tit="" brdr="0,0" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">				<sp/>				<img id="Ejecutar" dim="40,40" bPx="Y" brdr="0,1" img="_60_DocNew.png" OnEnter="Ejecuta(F)"  available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Ejecutar proceso definitivo"/>				<tab n="2"/>					<img id="Exportar" dim="40,40" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(k_mov)" available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Guardar tabla"/>								</grp>					</grp>			</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys, year, usuario;			var cubo, ok, cmd, mensajeError, xmlRequest;						fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;				kdb.connect();				Inicializa();			}						fun valida(){			}			fun Inicializa(){//Inicializa los valores en Pantalla				if(frn.config("temp","k_workDate")){					year=mid(frn.config("temp","k_workYear"),2,2);				}else {					kdb.kde("yr");kdb.exec();					year=kdb.get("yr",14);				}				frn.set("fecha_ini",sys.date(year,sys.date("month"),1));				frn.set("fecha_fin",sys.date(year,sys.date("month"),31));				frn.set("k_gpo_ini","1");				frn.set("k_tipo_ini","1");				frn.set("k_gpo_fin","1");				frn.set("k_tipo_fin","1");								frn.set("k_gpo_mov","1");				frn.set("k_tipo_mov","1");				frn.set("chk_rango","1");				frn.set("chk_movto","0");						IniCombos();				frn.setAtt("Ejecutar", "visible", "N");			}									fun IniCombos(){				var cmdQuery, cuboQuery;            cmdQuery = "select '['||c1||'] '||c2 as c2, c1, c2 as c3  from keplersc.kdms";            rstXml(cuboQuery);            cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comdevdircrud.IniCombos()");            ok=getXmlAtt(cuboQuery,"ok");            if(ok &! "" && !ok){                mensajeError = getXmlAtt(cuboQuery,"native3");                mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);                frn.message(mensajeError,"Error","Aceptar");                return;            }            frn.set("k_sucn_ini",cuboQuery);				frn.set("k_sucn_fin",cuboQuery);				frn.set("k_sucn_mov",cuboQuery);			}						fun AjustaFechaFin(origen){				var fecha_ini, fecha_fin, dif, mes_fin, mes_ini, anio_ini, anio_fin;				fecha_ini = frn.get("fecha_ini");				fecha_fin=frn.get("fecha_fin");				mes_ini = mid(fecha_ini,5,2);				mes_fin = mid(fecha_fin,5,2);				anio_ini = mid(fecha_ini,2,2);				anio_fin = mid(fecha_fin,2,2);												dif=fnDate("dif",fecha_fin,fecha_ini);				if (origen&="I"){						frn.set("fecha_fin",sys.date(anio_ini,mes_ini,31));				}else{					if (dif < 0){						frn.set("fecha_fin",sys.date(anio_ini,mes_ini,31));										}						}			}			fun ConfigCriterio(control){				if (control&="1"){					if (frn.get("chk_rango") &= "1"){						frn.set("chk_movto","0");					}else{						frn.set("chk_movto","1");					}				}else{					if (frn.get("chk_movto") &= 1){						frn.set("chk_rango","0");					}else{						frn.set("chk_rango","1");					}								}							}									fun resetCampos(){				frn.rst("k_mov");				frn.setAtt("Ejecutar", "visible", "N");			}									fun Ejecuta(tipoProc){//Prepara datos del reporte 				var sucursal_id, fecha_ini, fecha_fin, resultado, mensaje, strTmp;				var cuboMovtos,tmpCubo,registros,tmpStr,criterio,movto;								criterio=frn.get("chk_movto");				movto=frn.get("inp_mov");				if (criterio == 1){					if(movto &= ""){						frn.message("Debe ingersar movimiento","Error","Aceptar");						return;					}				}								if (tipoProc &= "F"){					registros=frn.N("k_mov");					tmpStr=frn.get("k_mov",0,"folio");					if (registros==0 || (registros==1 && tmpStr &= "") ){						frn.message("No hay registros a procesar.","Mensaje","&Aceptar");						return;					}					if (frn.message("¿Ejecutar proceso de regeneración de Pólizas?","Confirmación",2)==0){						return;					}								}				xmlRequest = getXml(frn.dataPag());				resetCampos();				//Agregar el tipo de proceso y datos adicionales				usuario = frn.config("user","name");				setXml(xmlRequest,"tipo_proc",tipoProc);				setXml(xmlRequest,"movimiento","usuario",usuario);								cmd="select * from keplersc.cont_regenerar_poliza('<document>" & getXmlStr(xmlRequest,"EOF:13_10") & "</document>')";				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRegPol");								cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cont_regenerar_poliza.Ejecuta()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\xmlRegPol");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				rstXml(tmpCubo);				strTmp=getXmlAtt(cubo,"r0","cont_regenerar_poliza");				strTmp= delScpScn(strTmp);				setXmlStr(tmpCubo,strTmp);				frn.setX(tmpCubo);				rstXml(cuboMovtos);				cuboMovtos=frn.lib("libGeneral.kpl","FormateaXmlNoRowId",tmpCubo,"r","k_mov");								frn.lib("libGeneral.kpl","FileSave",cuboMovtos,"C:\Basura\xmlCuboMovtos");				frn.setX(cuboMovtos);				if	(tipoProc&="F"){					frn.message("Proceso terminado.","Mensaje","Aceptar");					frn.setAtt("Ejecutar", "visible", "N");									}else{					frn.setAtt("Ejecutar", "visible", "Y");				}			}						fun guardar_tabla(tabla){				var save = frn.saveFile("tabla","Todos los archivos,*.*","_C:","Para guardar archivo");				frn.dialog("guarda_tabla",tabla,save); 			}		}	}	</script></pag>