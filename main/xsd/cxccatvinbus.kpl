<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="B&#250;squeda VIN">	<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,20" bclr="192,205,213"			OnPgUp="PgUp" OnPgDn="PgDn" OnCtrPgUp="CtrPgUp" 			OnF1="VntF1" OnCtrPgDn="CtrPgDn" OnCtrIni="CtrIni" OnCtrEnd="CtrEnd" OnCtrDel="CtrDel" unfont="0"><br/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="53,35,7,12" brdr="0,5" tit="B&#250;squeda VIN" fnt="Arial,16" clr="0,58,112"><tab/><txt hk="B" fnt="Arial,16b">Buscar</txt>		<inp id="texto" clr="64,64,64" clrBrdr="255,255,255"  dim="62,1" brdr="2,0" bclr="255,255,255" OnEnter="Busqueda" hk="B" type="string"/><br/><tab n="2"/><txt>Buscar por:</txt>		<tab/><ratio id="Clave" clr="64,64,64"  dim="2,16" bclr="255,255,255" hk="C" available="Y" default="1" OnChange="Busqueda"/><sp/><txt hk="C">Vin</txt>		<tab n="2"/><ratio id="Descripcion" clr="64,64,64"  dim="2,16" bclr="255,255,255" hk="D" available="Y" OnChange="Busqueda"/><sp/><txt>Vin Completo</txt><br/>		<tab n="2"/><txt hk="x">B&#250;squeda extendida </txt><chck id="bus_ext" clr="64,64,64"  dim="3,16" brdr="2,0" bclr="255,255,255" YN="10" OnChange="Busqueda" hk="x" clrBrdr="255,255,255"/><br/>		<br/><tab/><txt hk="e" fnt=",b">Resultados:</txt><br/><tab/>		<tbl id="resultados" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="69,15"  hk="e" modify="N" nren="fijo" Reorder="Y" OnEnter="Exit" OnMouseD="Exit">			<col id="clave" name="Serie"/>			<col id="desc" name="Marca"/>			<col id="" name="Modelo"/>			<col id="" name="Placas"/>		</tbl>		<br/><tab/><inp id="mensaje" clr="64,64,64"  dim="60,2" brdr="0,1" type="string" fnt="Arial,16b" modify="N" available="N"/>		</grp><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys;			/* PARÁMETROS			param(0) = Nombre del campo (o tabla) al que se devolverá la clave o descripción en la pantalla padre			param(1) = (Opcional) Nombre de la columna al que se devolverá la clave en la pantalla padre(Se debe especificar el grid en el parametro anterior)			param(2) = (Opcional) Bandera binaria de control. Es un string que indica ciertos parámetros de funcionamiento de la opción							Los caracteres se toman de izquierda a derecha y tienen el siguiente significado:							Bit 1= Si toma valor de 1, se devuelve la clave. Si toma valor de 0, se devuelve la descripción. Por default se toma valor de 1.			param(3) = (Opcional) Función de la pantalla padre a ejecutar antes de regresarle el control.										Valor de retorno = clave o descripción del cliente			*/			var bit1;//Banderas de comportamiento (Ver descripción arriba)			fun Main() {				frn=new FRNT; 				frP=new FRNTP; 				sys=new SYS;				kdb=new KDB;				bit1=1;//Inicializa las banderas con los valores default.				//var bCtrl=trim(frn.param(2));				//if (strlen(bCtrl)>0){bit1=mid(bCtrl,0,1);}//Se especificó una bandera de control.				kdb.connect();				var bd_abrir=frn.param(2);				kdb.open("c,kdserie");				frn.setAtt("Clave","available","Y");				frn.setAtt("Descripcion","available","Y");				frn.set("mensaje","");				var valor_inicial=(bit1==1)? frP.get(frn.param(0),-1,0): frP.get(frn.param(0),-1,1);				if (strlen(trim(frn.param(1)))>0){ valor_inicial=frP.get(frn.param(0),-1,frn.param(1)); }//Se devolverá el valor a una tabla 				frn.set("texto",valor_inicial);				frn.set("bus_ext",1);			}			fun Busqueda() { 				frn.set("mensaje","");				if (frn.get("bus_ext")==1){					frn.setAtt("Clave","available","N");					frn.setAtt("Descripcion","available","N");					var cmd=frn.get("texto") & " inside c1,c4"; kdb.lim(cmd);				}				else{					frn.setAtt("Clave","available","Y");					frn.setAtt("Descripcion","available","Y");					var campo_de_busqueda="c1"; //Por default por Clave					if(frn.get("Descripcion")==1)						campo_de_busqueda="c4";					var cmd=campo_de_busqueda & ">=" & frn.get("texto"); kdb.lim(cmd);				   cmd=campo_de_busqueda & "<="  & frn.get("texto") & "z"; kdb.lim(cmd);				}				if(frn.get("Descripcion")==1)					kdb.table("datos,c,1,&,c4,c2,c3,c8, max,50");//Utiliza el índice 2				else					kdb.table("datos,c,1,&,c4,c2,c3,c8 ,max,50");//Utiliza el índice 1				kdb.exec();				var q=kdb.get("datos","k_max");//Si se excedió el numero de registros máximos a buscar				if (q>0) {					sys.sound(1);					frn.set("mensaje","Búsqueda produce demasiados resultados. Favor de redefinir");				}				frn.set("resultados",kdb.get("datos"));				if(kdb.N("datos")>0) frn.setPos("resultados");			}			fun Exit() { 				var valor_retorno=frn.get("resultados",-1,"clave");//Por default se devuelve la clave				if( bit1==0 ){					valor_retorno=frn.get("resultados",-1,"desc");//Se devuelve la descripcion				}				if (strlen(trim(frn.param(1)))>0){ //Se devolverá el valor a una tabla 					frP.setX(valor_retorno,frn.param(0),-1,frn.param(1)); 					frP.scriptElm(frn.param(0),"OnChange",frn.param(1));				}				else{ //se devolverá el valor a un campo					frP.set(frn.param(0),valor_retorno); 					frP.scriptElm(frn.param(0),"OnChange");				}				if (strlen(trim(frn.param(3)))>0){ //Se ejecutará la función indicada en la ventana padre.					frP.script(frn.param(3));				}				frn.exit();			}		}    /*Autor									Fecha							Cambio			-------------------------------------------------------------------------------------------------------------------------------	      Fran Tapia            11/07/2016          Se eliminó atribuo "brdr" del elemento ratio.      */	</script></pag>