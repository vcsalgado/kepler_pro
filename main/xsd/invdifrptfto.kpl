<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de " scale="48">	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,16" unfont="0">			<br exe="encabezado"/>		<hLine dim="89,0" g="2" type="1"/>		<!-- <hLine dim="111,0" g="2" type="1"/> -->		<br exe="encabezado"/>				<grp dim="12,5,7,12">			<br/>			<img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>				<!-- <grp dim="60,7,7,12"> -->		<grp dim="62,7,7,12"> 			<br/>			<!-- dim="70,1" -->			<inp id="nombreempresa" dim="85,1" fnt="20b,20b" type="string" modify="N" bclr="249,249,249"/>			<br/>			<!-- dim="70,1" -->			<inp id="tituloreporte" dim="85,1" fnt="20b,20b" type="string" modify="N" bclr="249,249,249" clr="6,14,136"/>			<br/>			<!-- dim="70,1" 			<inp id="leyendatx" dim="85,1" type="string" fnt=",16b" modify="N" just="L" nc="-1"/>			<br/>			-->			<br/>			<txt fnt=",16b">Sucursal : </txt> <sp n="1"/>			<inp id="suc" dim="10,1" fnt="16b,16b" type="string" modify="N" bclr="249,249,249"/>			<sp n="2"/>			<inp id="sucnomb" dim="45,1" fnt="16b,16b" type="string" modify="N" bclr="249,249,249"/>			<br exe="encabezado"/>		</grp>				<tab n="1"/>				<grp dim="15,5,7,12">			<tab n="2"/><txt>P&#225;g:</txt>			<sp/> <inp id="k_pag" dim="5,1" type="number" mcr="k_pag"/><br/><br/>			<inp id="fecha" dim="10,1" type="date" fmt="DD-MM-CCYY" nc="-1"/>			<sp/> <inp id="hora" dim="5,1" type="time"/>		</grp>		<br exe="encabezado"/>		<br exe="encabezado"/>				<hLine dim="89,0" g="2" type="1"/> 		<!-- <hLine dim="111,0" g="2" type="1"/> -->			<br exe="encabezado"/>			<sp n="1"/>			<txt fnt=",14b">Producto </txt> <sp n="4"/>			<txt fnt=",14b">Descripcion</txt> <sp n="8"/>			<txt fnt=",14b">Fecha </txt> <sp n="4"/>			<txt fnt=",14b">Inv Fisico</txt> <sp n="1"/>			<txt fnt=",14b">Inv Teorico</txt> <sp n="1"/>			<txt fnt=",14b">Diferencia</txt> <sp n="2"/>			<txt fnt=",14b">Cost. Real</txt> <sp n="1"/>			<txt fnt=",14b">Cost. Teorico</txt> <sp n="1"/>			<txt fnt=",14b">Diferencia</txt> <sp n="1"/>			<txt fnt=",14b">Ubicacion</txt> <sp n="1"/>			<br exe="encabezado"/>		<hLine dim="89,0" g="2" type="1"/> 		<!-- <hLine dim="111,0" g="2" type="1"/> -->		<br exe="encabezado"/>		<br exe="encabezado"/>		<sp n="1"/> 		<inp id="d-prod" dim="9,1" type="string" modify="N" fnt=",13"/> <sp n="1"/>		<inp id="d-dscr" dim="12,1" type="string" modify="N" just="L" fnt=",13"/> <sp n="1"/>		<inp id="d-fech" dim="7,1" type="date" fmt="DD-MM-CCYY" nc="-1" fnt=",13"/> <sp n="1"/>		<inp id="d-invfis" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13"/> <sp n="1"/>		<inp id="d-invteo" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13"/> <sp n="1"/>		<inp id="d-invdif" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13"/> <sp n="1"/>		<inp id="d-costfis" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13"/> <sp n="1"/>		<inp id="d-costteo" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13"/> <sp n="1"/>		<inp id="d-costdif" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13"/> <sp n="1"/>		<inp id="d-ubica" dim="8,1" type="string" modify="N" fnt=",13"/> <sp n="1"/>		<br exe="detalle"/>						<sp n="1"/> 		<inp id="f-prod" dim="9,1" type="string" modify="N" fnt=",13"/> <sp n="1"/>		<inp id="f-dscr" dim="12,1" type="string" modify="N" just="L" fnt=",13"/> <sp n="1"/>		<txt fnt=",13">-----------------------</txt> <sp n="1"/>		<txt fnt=",13">-----------------------</txt> <sp n="1"/>		<inp id="f-invteo" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13"/> <sp n="1"/>		<inp id="f-invdif" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13"/> <sp n="1"/>		<inp id="f-costfis" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13"/> <sp n="1"/>		<inp id="f-costteo" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13"/> <sp n="1"/>		<inp id="f-costdif" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13"/> <sp n="1"/>		<inp id="f-ubica" dim="8,1" type="string" modify="N" fnt=",13"/> <sp n="1"/>		<br exe="detalle-notfis"/>						<br exe="total"/> 				<sp n="22"/> <hLine dim="67,0" g="2" type="1"/> 		<br exe="total"/>				<sp n="24"/> <txt fnt=",15b">Gran Total</txt> <sp n="2"/>				<inp id="t-invfis" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13b"/> <sp n="1"/>		<inp id="t-invteo" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13b"/> <sp n="1"/>		<inp id="t-invdif" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13b"/> <sp n="1"/>		<inp id="t-costfis" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13b"/> <sp n="1"/>		<inp id="t-costteo" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13b"/> <sp n="1"/>		<inp id="t-costdif" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",13b"/> <sp n="1"/>		<br exe="total"/>				<sp n="22"/> <hLine dim="67,0" g="2" type="1"/>				<br exe="total"/>			</grp></pag>