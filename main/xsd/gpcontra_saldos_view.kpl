<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Configuracion de Presupuesto"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,15,12" bclr="192,205,213" unfont="0">	<tab/>	<br/><sp/><txt clr="0,0,0" fnt=",22">Consulta de Saldos de Gastos</txt>	<br/>	<sp/>	<hLine clr="0,0,0"/>	<br/><br/>	<sp/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="66,35,7,11" brdr="0,5" tit="Presupuesto" fnt="Arial,15">		<tab/>		<txt>Sucursal:</txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  			available="Y" OnChange="ResetResults()"/><tab n="2"/>		<!--		<txt>A&#241;o: </txt>		<cmb id="k_anio" clr="64,64,64" clrBrdr="192,205,213" dim="10,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 			available="Y" OnChange="ResetResults()"/>        <tab/><txt>Mes:</txt>		<cmb id="k_mes" dim="6,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y" fnt="Arial,0" Null="N" OnChange="ResetResults()"/>			<tab n="2"/>		<img id="bot_buscar" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_Registros()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		-->		<br/>		<tab/><txt clr="250,0,0">* Click para ver detalle de movimientos comprobados</txt>		<br/><tab/>		<tbl clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" brdr="1,0" id="results" dim="136,19" 			nren="fijo" Reorder="Y" clrCur="192,205,213" OnEnter="ConsultarMovtos()" OnMouseD="ConsultarMovtos()" OnMouseL="ConsultarMovtos()">         <col name="Id Grupo" id="grupo_id" modify="N"/>			<col name="Descripcion Gasto" id="desc_gpocontra" modify="N"/>			<col name="Fecha Registro" id="fec_registro" modify="N" type="date" nc="-1" fmt="DD/MM/CCYY"/>			<col name="Id Prov Interno" id="idgpo" modify="N"/>         <col name="Nombre Prov Interno" id="desc_gpogastos" modify="N"/>			<col name="Importe Asignado" id="imp_asignado" modify="N" type="number" nd="2"/>         <col name="Importe Comprobado" id="imp_comprobado" modify="N" type="number" nd="2"/>         <col name="Estatus" id="gpo_st" modify="N"/>		</tbl><br/><br/>	</grp>	<br/><br/>		<sp/>		<grp bclr="236,240,243" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="66,22,7,11"  tit="Detalle de gastos" fnt="Arial,15" unfont="0"><tab/><txt clr="250,0,0">* Doble click para ver p&#243;lza del movimiento</txt><br/>			<tab/>			<tbl id="k_movtos" dim="136,12" brdr="1,0" clrBrdr="64,64,64" bclr="255,255,255" modify="N" nren="fijo" clr="64,64,64" clrCur="192,205,213" 				OnEnter="abrir_poliza()" OnMouseD="abrir_poliza()">				<col id="fecha" name="Fecha" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="folio" name="Folio" type="string"/>				<col id="proveedor" name="Proveedor" type="string"/>				<col id="imp_comprobado" name="Importe Comprobado" type="number" nd="2"/>				<col id="referencia" name="Referencia" type="string"/>				<col id="gen" name="Gen" type="string"/>				<col id="nat" name="Nat" type="string"/>				<col id="gpo" name="Gpo" type="string"/>				<col id="tipo" name="Tipo" type="string"/>				<col id="desc_movto" name="Desc. Movimiento" type="string"/>			<!--	<rec id="tot_movto" fixed="Y"/> -->			</tbl><br/>		</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,usuario,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;			var accion,tipoOper,tabla,desc_ope,resVal; 			var regTotales,ultimoValorEncontrado, contGlobalResults; //variables del llenado de la tabla			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna;			var cmd,cubo,ok,mensajeError;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				//Constantes				usuario = frn.config("user","name");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";				Inicializa();			}			fun ResetResults(){				frn.rst("results");							frn.rst("k_movtos");							}			fun ConsultarMovtos(){				var clave,descripcion,anio,mes,mes_desc;				var nReg, colCriterio,criterio,expWhere,expOrder;							// Commented by JMM 20241121 				/*				if (frn.get("results",-1,"imp_comprobado")>0){				*/					//Adapted by JMM 20241103 					cmd="select m1.c9 as fecha, m1.c6 as folio, m1.c10 as proveedor, m1.c16 as imp_comprobado,							m1.c11 as referencia, mm.c1 as gen, mm.c2 as nat, mm.c3 as gpo, mm.c4 as tipo, mm.c5 as desc_movto 							from keplersc.kdgpcontra gp 							/*inner join keplersc.kdgpgastos gg on gg.idgpo = gp.idgpo*/							inner join keplersc.kdxd k on gp.proveedor_id = k.c2 and k.interno = 1 							inner join keplersc.kdm1 m1 on m1.c1=gp.sucursal_id and m1.grupo_id = gp.grupo_id and m1.c43 <> 'C'							inner join keplersc.kdmm mm on mm.col_sucursal=m1.c1 and mm.c1=m1.c2 and mm.c2=m1.c3 and mm.c3=m1.c4 and mm.c4=m1.c5							where gp.sucursal_id = '" & frn.get("k_sucn",-1,1) & "' and gp.grupo_id ='" & frn.get("results",-1,"grupo_id") &"'";											frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdConsMovtos");										cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"conconsultasaldos.ConsultarMovtos()");					frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\xmlConsMovtos");					ok=getXmlAtt(cuboXml,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						//Added by JMM 20241103						frn.rst("k_movtos");						return;					}						frn.set("k_movtos",cuboXml);				// Commented by JMM 20241121				/*				}else{					frn.rst("k_movtos");				}				*/								}										fun Inicializa(){				var resValidacion,resMensaje ;							frn.rst("gpo_2");				//Encabezados();				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";								if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR" && rol_usuario &! "Administrador Kepler 8.0" && rol_usuario &! ""){											cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",getXml(cubo));					Buscar_Registros();			}			fun Buscar_Registros(){				var nReg, colCriterio,criterio,expWhere,expOrder;				var carppto,nivelUsuario,fec_gastado;				kdb.rst();				ResetResults();								//Commented & Adapted by JMM 20241103				/*				cmd = "select gp.grupo_id,gp.descripcion as desc_gpocontra,gp.fecha_registro as fec_registro,gg.idgpo, gg.descripcion as desc_gpogastos, gp.importe_asignado as imp_asignado,                    (select sum(c16) from keplersc.kdm1 m1 where m1.c1=gp.sucursal_id and m1.grupo_id = gp.grupo_id and m1.c43<>'C') as imp_comprobado                    from keplersc.kdgpcontra gp 					inner join keplersc.kdgpgastos gg on gg.idgpo = gp.idgpo					where gp.sucursal_id='" & frn.get("k_sucn",-1,1) & "' order by gg.idgpo,gp.grupo_id";				*/								cmd = "select gp.grupo_id,gp.descripcion as desc_gpocontra,gp.fecha_registro as fec_registro, /*gg.idgpo*/ k.c2 , /*gg.descripcion*/ k.c3 as desc_gpogastos, gp.importe_asignado as imp_asignado,                    /*(select sum(c16) from keplersc.kdm1 m1 where m1.c1=gp.sucursal_id and m1.grupo_id = gp.grupo_id and m1.c43<>'C')*/ gp.importe_comprobado as imp_comprobado, gp.estatus as gpo_st                     from keplersc.kdgpcontra gp 					inner join keplersc.kdxd k on gp.proveedor_id = k.c2 and k.interno = 1 					where gp.sucursal_id='" & frn.get("k_sucn",-1,1) & "' order by /*gg.idgpo*/k.c2 , gp.grupo_id";													rstXml(cuboXml);					cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"presupuesto.buscar_registros()");					ok=getXmlAtt(cuboXml,"ok");					if(ok &! "" && !ok){							mensajeError = getXmlAtt(cuboXml,"native3");							//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;					}						frn.set("results",cuboXml);					}			fun abrir_poliza(){				var gen,nat,gpo,tipo,sucursal_id,anio,mes,tipo_poliza,folio,folio_pol,tipo_movto,param;				cmd ="";								sucursal_id = frn.get("k_sucn",-1,1);				mes = fnDate("month",frn.get("k_movtos",-1,"fecha"));				anio = fnDate("year",frn.get("k_movtos",-1,"fecha"));				anio = mid(anio,2,2);				mes = frn.lib("libGeneral.kpl","PadLeft",mes,"2","0");																gen=frn.get("k_movtos",-1,"gen");				nat=frn.get("k_movtos",-1,"nat");				gpo=frn.get("k_movtos",-1,"gpo");				tipo=frn.get("k_movtos",-1,"tipo");				folio=frn.get("k_movtos",-1,"folio");				tipo_movto = "C";				if (folio &! "" && gen &! "" && nat &! "" && gpo &! "" && tipo &! ""){						//Obtener no. de poliza					cmd = "select kdc2.c1 as foliopol,kdc2.c8 as tipopoliza					from keplersc.kdc2_view kdc2					where kdc2.anio='" & anio & "' and kdc2.mes ='" & mes & "'					and kdc2.c14='" & frn.get("k_sucn",-1,1) & "' and kdc2.c15='" & gen & "' and kdc2.c16='" & nat & "' and kdc2.c17=" & gpo & " and kdc2.c18=" & tipo & " and kdc2.c19='" & folio & "'					limit 1";					frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdAbrirPoliza");						rstXml(cuboXml);					cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"presupuesto.buscar_registros()");					frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\xmlDatPol");					ok=getXmlAtt(cuboXml,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					folio_pol = getXmlAtt(cuboXml,"r0","foliopol");					tipo_poliza = getXmlAtt(cuboXml,"r0","tipopoliza");					//param=gen & "," & nat &  "," & gpo & "," & tipo & "," & tipo_movto & "," & sucursal_id & "," & anio & "," & mes & "," & tipo_poliza & "," & folio_pol;					//frn.message(param,"Mensaje","Aceptar");						frn.dialog("conpolizapag.kpl",gen,nat,gpo,tipo,tipo_movto,sucursal_id,anio,mes,tipo_poliza,folio_pol);				} else{					frn.message("No hay poliza por mostrar","Atencion","Aceptar");				}				}									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>