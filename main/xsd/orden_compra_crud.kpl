<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Orden de Compra">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<tab/><txt fnt=",22" clr="0,0,0">Orden de Compra</txt><br/>	<tab/><hLine clr="0,0,0"/> 	<br/> <br/><tab/>		<grp dim="46,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros"><txt>  Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" tooltip="Sucursal" available="Y" modify="Y"/>			<br/><br/>			<txt>  Tipo :        </txt>			<cmb id="k_tipon" dim="40,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo()" tooltip="Tipo de Movimiento"/>			<br/>			<tab n="4"/><inp id="statusdoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/>		</grp>		<sp/>		<grp dim="34,10,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C"/><tab/> <br/>			<txt id="textFolio" visible="Y">  Folio :  </txt>			<edt id="k_folio" dim="30,1" brdr="2,0" OnChange="Formar_folio()" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="10" tooltip="Folio ( F9 b&#250;squeda )" modify="Y" available="Y" visible="Y" OnF9="ObtenerFolio()" 			OnButton="ObtenerFolio()"/>	<sp n="2"/>			<img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="BuscarFolio()" available="Y" clrBrdr="0,0,0" visible="Y"/>			 <br/>			<sp n="1"/>			<inp id="k_docto" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="C"/> <br/>			<txt>  Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="Y" tooltip="Fecha"/> 			<sp n="1"/> 			<txt>  Hora : </txt> 			<sp n="1"/> 			<edt id="k_hora" dim="15,1" type="time" nc="-1" bclr="240,240,240" fmt="HH:MM:SS" available="N"/> 			<br/>		</grp>		<br/>		<br/>		<tab/>		<grp dim="81,12,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Proveedor">				<grp dim="38,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">								<sp n="1"/> <txt clr="0,58,112" hk="P">Proveedor : </txt><tab/>				<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnButton="Dialog(3,cxpcatprobus,k_clave)" OnF9="Dialog(3,cxpcatprobus,k_clave)" OnChange="BuscarProveedor()" 					type="capital" nc="7" tooltip="Proveedor ( F9 b&#250;squeda )" modify="Y" hk="C" available="N"/> 				<br/>				<sp n="1"/> <txt>RFC : </txt><sp n="5"/>				<inp id="k_rfc" clr="64,64,64"  dim="18,1" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>				<br/>			</grp>			<sp n="1"/>			<grp dim="75,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="1,5" fnt="Arial,16">				<sp n="1"/> <txt>Datos del proveedor : </txt>				<br/>				<sp n="1"/>					<inp id="k_nombreprov" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_calleprov" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_coloniaprov" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_poblacionprov" clr="64,64,64" clrBrdr="255,255,255"  dim="50,1" fnt="Arial,16" type="string" modify="N" available="N" nc="50" visible="Y"/>				<sp n="1"/>				<inp id="k_cpprov" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt="Arial,16" type="string" modify="N" available="N" nc="10" visible="Y"/>			</grp>													</grp>			<br/>			<tab/>		<grp dim="81,28,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" fnt=",0"><tab/>		<tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" 				dim="111,8"  hk="z" Reorder="N" modify="N"  insdel="Y">			<col id="k_partida" name="Partida"  nc="1" type="number"  modify="N" visible="N"/>			<col id="k_clave_gasto" name="Clave Gasto"  nc="5" modify="Y" OnF9="select_Gasto()" OnChange="Gasto()" visible="Y" available="Y"/>			<col id="k_desc_gasto" name="Descripcion"   nc="30" modify="N" available="Y" visible="Y"/>			<col id="k_monto_gasto" name="Monto"  type="number" nd="2" nc="15" OnChange="CalcTotal()"  modify="Y" visible="Y"/>		</tbl>		<br/>		<tab/>		<grp dim="70,20,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" fnt=",0">		<sp/><txt fnt=",">Plazo:  </txt>		<inp id="k_plazo" dim="8,1" brdr="2,0"  OnChange="plazo()" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="Y" just="R" clr="64,64,64" available="N"/><br/>		<sp/><txt fnt=",">Fecha de Pago:  </txt>		<edt id="k_vence" dim="15,1" type="date" OnChange="Vence()" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_vence" OnF9="Dialog(3,_ks_fecha,k_vence)" clrBrdr="255,255,255" available="N" tooltip="Fecha"/> 		<br/>				<sp/><txt fnt=",">Comentarios:  </txt>		<inp id="k_coment" dim="50,4" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="capital" modify="N" available="N" clr="64,64,64"/><br/>		<br/>		<sp n="40"/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="N"/>					<sp n="8"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>						</grp>			<tab n="2"/>		<grp dim="40,20,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" fnt=",0">		<sp/><txt fnt=",">Subtotal:  </txt><tab n="3"/>		<inp id="k_subtotal" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" clr="64,64,64"/><br/>				<sp/><txt fnt=",">IVA:  </txt><tab n="4"/>		<inp id="k_iva" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="6" clr="64,64,64"/><br/>		<sp/><txt fnt=",">Importe:  </txt><tab n="3"/>		<inp id="k_monto" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0b" clr="64,64,64"/><br/>			</grp>				</grp>								</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Variables de control			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, resVal, tabla, estatus_doc ;			var fileSavePath;			//Variables validacion factura			var	str_uuid, fecha_uuid, rfc_uuid, total_uuid;								//Variables de parametros         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd;			var editable; //Se controla si la poliza se puede editar, cancelar o dar de baja				//Porcentajes kdmm			var prc_iva ;			//cont			var presupuesto , saldo, fecha_baja ;			var uen;		fun Main() {			frn=new FRNT;			kdb=new KDB;			rep=new REP;			frP=new FRNTP;			sys=new SYS;			kdb.connect();			kdb.kde("KDE");			kdb.exec();			anio_contable = kdb.get("KDE","14");			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			suc_usuario = frn.lib("libKepler","UserInfo(1)");			fileSavePath = "C:\Basura";			Inicializa();			ConfiguraControlesOpcion();								}						//------------------------------------CONFIGURACIONES------------------------							fun Inicializa(){ //Inicializa los valores en Pantalla			// Revisa parametros recibidos			if( frn.nParam() == 7 ){ //Se han mandado par�metros a la p�gina                gen_doc=trim(frn.param(0));                 nat_doc=trim(frn.param(1));                 gpo_doc=trim(frn.param(2));                tip_doc=trim(frn.param(3));                 tip_ope=trim(frn.param(4));                paramProd=trim(frn.param(5));			} else {				frn.message("Operaci�n no v�lida ...", "Mensaje","&Aceptar");				frn.open("redirect",2);				return;			}            			if(tip_ope &= "A"){ //Alta				frn.set("operacion","ALTA");			} else {				if(tip_ope &= "B"){ //Baja					frn.set("operacion","BAJA");				} else {					if(tip_ope &= "C"){ //Consulta						frn.set("operacion","CONSULTA");					} else {											if(tip_ope &= "M"){ //Modificacion							frn.set("operacion","MODIFICACION");						}else{							frn.message("Operaci�n no v�lida ...", "Mensaje","&Aceptar");							frn.open("index",4);							return;														}																					}				}			}						uen=trim(frn.param(6));			if (uen &= ""){				uen="XXX";			}							// Fill Combo Sucursal (Con Query de PostgreSQL)			cmdQuery = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdms";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"orden_compra_crud.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_sucn",cuboQuery);								// Fill Combo Tipo (Con Query FTO Kepler) 			cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"orden_compra_crud.Inicializa()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error BD","Aceptar");				return;			}			frn.set("k_tipon",getXml(cuboQuery));						frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				frn.set("k_vence",sys.date());							// Fill k_docto | referencia docto			ArmarRefDocto();					configuraciones_kdmm();					}					// Armado del Docto Referencia		fun ArmarRefDocto {			var cadena = frn.get("k_tipon", -1, 5);			var fol = frn.get("k_folio");			if (tip_ope &! "A" && fol &! ""){				cadena = strSplit(cadena,"-",0) & "-" & fol;			}					frn.set("k_docto", cadena);		}					fun PadLeft(pText,pRelleno,pCaracterRelleno) {			var Resultado;			var pos_ini = pText;			var nReg = strlen(pText);			for (var cont = nReg; cont < pRelleno; cont++) {				Resultado = pCaracterRelleno & Resultado;			}			Resultado = Resultado & pText;                			return Resultado;		}				fun CambiaTipo() {				tip_doc  = frn.get("k_tipon", -1, 4);			configuraciones_kdmm();			borrar_datos();			LimpiaEncabezado();								//TODO, borrar todos los datos			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();						}				fun configuraciones_kdmm(){						var cmd, cuboResultados ,ok,mensajeError;								cmd= " select c16 from keplersc.kdmm where c1='" & gen_doc & "'" ;							cmd = cmd & " and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4='" & tip_doc & "'";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"compra_crud.configuraciones_kdmm()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				prc_iva = getXmlAtt(cuboResultados , "r0","c16");				}						fun CambiaSucursal() {			sucursal_id = frn.get("k_sucn",-1,1);			LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();						}				fun LimpiaEncabezado() {			frn.set("k_folio", "");			frn.set("k_docto", "");			frn.set("k_fecha", "");			frn.set("k_hora", "");			LimpiaDatosProv();			frn.set("k_clave", "");		}				fun borrar_datos(){			frn.rst("k_mov");			frn.set("k_vence", sys.date());			frn.set("k_plazo", 0);			frn.rst("k_coment");			frn.set("k_subtotal", 0);			frn.set("k_iva", 0);			frn.set("k_monto", 0);		}				fun Cancela() {			CambiaSucursal();			borrar_datos();			Inicializa();			ConfiguraControlesOpcion();		}									fun ConfiguraControlesOff() {							frn.setAtt("textFolio", "visible", "N");			frn.setAtt("k_folio", "available", "N");			frn.setAtt("k_folio", "visible", "N");			frn.setAtt("k_mov", "modify", "N");			frn.setAtt("k_mov", "visible", "N", "k_partida");			frn.setAtt("k_clave", "available", "N");			frn.setAtt("k_vence", "available", "N");			frn.setAtt("k_plazo", "available", "N");			frn.setAtt("k_coment","modify", "N");			frn.setAtt("k_coment","available", "N");			frn.setAtt("Cancelar", "visible", "N");			frn.setAtt("Aceptar", "visible", "N");			frn.setAtt("buscar_datos", "visible", "N");										}						fun ConfiguraControlesOpcion() {						ConfiguraControlesOff();			if(tip_ope &= "A"){ //Alta				frn.setAtt("k_clave", "available", "Y");				frn.setAtt("k_mov", "modify", "Y");				frn.setAtt("k_coment","modify", "Y");				frn.setAtt("k_plazo", "available", "Y");				frn.setAtt("k_coment","available", "Y");				frn.setAtt("k_fecha", "available", "Y");	//MSS Habilitar fecha				frn.setAtt("Cancelar", "visible", "Y");				frn.setAtt("Aceptar", "visible", "Y");												} else {				if(tip_ope &= "B"){ //Baja					frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");								frn.setAtt("Aceptar", "visible", "Y");						frn.setAtt("buscar_datos", "visible", "Y");											frn.setAtt("k_fecha", "available", "Y");	//MSS Habilitar fecha				} else {					if(tip_ope &= "C"){ //Consulta						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("buscar_datos", "visible", "Y");						} else {											if(tip_ope &= "M"){ //Modificacion													frn.setAtt("k_clave", "available", "Y");							frn.setAtt("k_mov", "modify", "Y");							frn.setAtt("k_mov", "visible", "Y", "k_partida");							frn.setAtt("k_coment","modify", "Y");							frn.setAtt("k_plazo", "available", "Y");							frn.setAtt("k_coment","available", "Y");							frn.setAtt("k_fecha", "available", "Y");	//MSS Habilitar fecha							frn.setAtt("Cancelar", "visible", "Y");							frn.setAtt("Aceptar", "visible", "Y");															frn.setAtt("textFolio", "visible", "Y");							frn.setAtt("k_folio", "available", "Y");							frn.setAtt("k_folio", "visible", "Y");													frn.setAtt("buscar_datos", "visible", "Y");														}else {												frn.setAtt("textFolio", "visible", "Y");							frn.setAtt("k_folio", "available", "Y");							frn.setAtt("k_folio", "visible", "Y");						}									}					}			}		}								//------------------------------PROVEEDOR-----------------------			fun BuscarProveedor(){			var xmlProd;											sucursal_id = frn.get("k_sucn",-1,1);			proveedor_id = frn.get("k_clave");			LimpiaDatosProv();					if (strlen(frn.get("k_clave")) == 0) {				return;			}							cmdQuery = "select c10 as k_rfc, c3 as k_nombreprov, c4 as k_calleprov, c5 as k_coloniaprov, c6 as k_poblacionprov, c27 as k_cpprov, c16 as k_plazo " &									"from keplersc.kdxd where c1='" & sucursal_id & "' and c2='" & proveedor_id & "'" ;								rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.BuscaProveedor()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.setPos("k_clave");				frn.message("El proveedor no existe","Error","Aceptar");				return;				}			//Plazo();				rstXml(xmlProd);			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");			frn.setX(xmlProd);									}				fun LimpiaDatosProv() {			frn.set("k_rfc", "");			frn.set("k_nombreprov", "");			frn.set("k_calleprov", "");			frn.set("k_coloniaprov", "");			frn.set("k_poblacionprov", "");			frn.set("k_cpprov", "");		}					//---------------------------------------GRID------------------------------									fun select_Gasto(){						frn.setX("", "k_mov", -1, "k_clave_gasto");				frn.setX("", "k_mov", -1, "k_desc_gasto");				var cmdSel = "select c1 as clave, c2 as descripcion, c3 as cuenta1 ,c5 as cuenta2 ,c7 as cuenta3, c9 as cuenta4, c11 as cuenta5 from keplersc.kdcatgastos " ;            frn.dialog("genlistafiltrosel","Gastos",cmdSel ,"clave","k_mov","", "k_clave_gasto","N");     		}							fun Gasto() {				var cmd = "select c1,c2 from keplersc.kdcatgastos where c1='" & frn.get("k_mov", -1, "k_clave_gasto") & "'";								var cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"compra_crud.Gasto()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				if ( nXml(cuboResultados) == 0){									frn.message("Gasto no existe","Error","Aceptar");					frn.setX("", "k_mov", -1, "k_clave_gasto");					frn.setX("", "k_mov", -1, "k_desc_gasto");					return;				}else{					frn.setX(getXmlAtt(cuboResultados, "r0", "c2"), "k_mov", -1, "k_desc_gasto");				}						}					fun CalcTotal() { 				var subt=0; 				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) { 					subt=subt+frn.get("k_mov",i,"k_monto_gasto");				}							var importe= 0;				var iva = subt * prc_iva/100;				if (prc_iva &! "N" ){ 					importe= subt  + iva;				}else{ 					importe= subt ;					iva = 0;				}								frn.set("k_subtotal", subt, "k_iva" ,iva, "k_monto", importe);				}					//---------------------------------------EJECUTA---------------------------------			fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			var resultado, mensaje, folio;							fecha = sys.date();			hora= sys.time();							if (tip_ope &= "A") {							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;				ValidarDatos();				if(ok &! "1" || resVal == 0){					return;				}				continua = frn.message("�Desea continuar con la alta?","Atenci�n",2);				if (continua == 0){					return;				}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;											setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov") -1);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);												frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudcontrarecibo");				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cuboQuery);				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_contrarecibo_crud.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudContrarecibo");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					tip_ope = "C";					frn.set("k_folio", mensaje); 					frn.set("operacion", "CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto", strTmp);					strMsg = "El Folio utilizado para esta operaci�n fue : " & mensaje;					ConfiguraControlesOpcion(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");					MostrarDatos(folio);						//BuscarFolio();				} else {					frn.message(mensaje, "Error", "Aceptar");				}			} else {				if (tip_ope &= "B") {									if (estatus_doc &= "C"){						frn.message("No puedes dar de baja un folio cancelado.", "Error", "Aceptar");						return ;					}					continua = frn.message("�Desea continuar con la baja?","Atenci�n",2);					if (continua == 0){						return;					}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;													setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);					setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov"));					setXml(xmlPantalla,"operacion","baja");					setXml(xmlPantalla,"ambiente","uen",uen);																frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudcontrarecibo");					cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					rstXml(cuboQuery);											cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_contrarecibo_crud.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudContrarecibo");											resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok) {						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}					if(resultado &= "1") {						tip_ope = "C";						frn.set("operacion", "CONSULTA");						ConfiguraControlesOpcion();						BuscarFolio();					} else {						frn.message(mensaje, "Error", "Aceptar");					}				} else {					folio = frn.get("k_folio");					MostrarDatos(folio);				}	/*End Consulta*/ 			}						}				fun ValidarDatos() {			var totReg, strTotal=0,subTotal=0, iva=0, total=0, renglones, str;			//Obtener variables			sucursal_id = frn.get("k_sucn",-1,1);			proveedor_id = frn.get("k_clave");													//Validar Proveedor			cmdQuery="SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_id & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("El proveedor no existe.","Error","Aceptar");				resVal=0;				return;			}					if(frn.N("k_mov")-1==0){				frn.message("No es posible dar de alta una Orden de Compra sin datos. Favor de verificar", "Error","&Aceptar");				resVal=0;return;			}											} 			//-----------------------BAJA,CONSULTA----------------------------							fun BuscarFolio() {			var folio;			folio = frn.get("k_folio");			folio = PadLeft(folio, 7, "0");			ArmarRefDocto();			borrar_datos();			MostrarDatos(folio);						}						fun ObtenerFolio() {			sucursal_id = frn.get("k_sucn",-1,1);			cmdQuery = "select c6 as folio, substring(cast(c9 as VARCHAR),1,10) as fecha, c10 as cve_proveedor, " &						" c16 as monto, c43 estatus " &						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc & " order by c6 desc ";									frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryfoliomov");							frn.dialog("genlistafiltrosel","Folios de Ordenes de Compras",cmdQuery,"folio","k_folio","0","","S");					}						fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								LimpiaDatosProv();				borrar_datos();								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);		}			fun MostrarDatos(nFolio) {					var cmd,xmlRequest,xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError,   ;						sucursal_id = frn.get("k_sucn",-1,1);					cmd= " select c10 as k_clave, c9 as k_fecha,c69 as k_hora , c18 as k_vence, c17 as k_plazo, c24 as k_coment, c43 as estatus_doc , c197 as fecha_baja " ;						cmd = cmd & " from keplersc.kdm1 where c1='" & sucursal_id  & "' and c2='" & gen_doc  &"' and c3='" & nat_doc & "' and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			var xml_kdm1  = getXml(cuboResultados,"r0" );			//frn.setX(cuboResultados ); TODO, checar setX			frn.set("k_clave",getXmlAtt(xml_kdm1  ,"k_clave") );			BuscarProveedor();			frn.set("k_fecha",getXmlAtt(xml_kdm1 ,"k_fecha") );			frn.set("k_hora",getXmlAtt(xml_kdm1  ,"k_hora") );			frn.set("k_plazo",getXmlAtt(xml_kdm1  ,"k_plazo") );			frn.set("k_vence",getXmlAtt(xml_kdm1   ,"k_vence") );			frn.set("k_coment",getXmlAtt(xml_kdm1   ,"k_coment") );											fecha_baja = getXmlAtt(xml_kdm1  ,"fecha_baja");						estatus_doc = getXmlAtt(xml_kdm1  ,"estatus_doc");				rstXml(cmd);							cmd = "select c7,c8,c9,c11 from keplersc.kdm6 where c1='" & sucursal_id & "' and c2='" & gen_doc &"' and c3='" & nat_doc & "'";			cmd = cmd & " and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "' order by c7 ";						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			totRen = nXml(cuboResultados);										for(contRen=0; contRen<totRen; contRen++){				frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c7"),"k_mov",contRen,"k_partida");				frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c8"),"k_mov",contRen,"k_clave_gasto");				frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c9"),"k_mov",contRen,"k_desc_gasto");				frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c11"),"k_mov",contRen,"k_monto_gasto");			}						CalcTotal();						ArmarRefDocto();										if (estatus_doc &= "C"){	// C=Cancelado				frn.message("La Orden de Compra se encuentra cancelada","Error","Aceptar");				frn.set("statusdoc", "CANCELADO");			}else{				frn.set("statusdoc", "");			}													} //End MostrarDatos()											//-----------------------------------------EXTRAS--------------------------------								fun plazo(){					var plazo = frn.get("k_plazo");					frn.set("k_vence", fnDate("add",frn.get("k_vence"),plazo )  );					}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    			1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 			2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 			3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			// var tip_ope; 			var tip_oper;			if(iModo==0)				page=pag; 			else if(iModo==2&&(strlen(par0)>0)){				//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       				if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 				if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;			}			else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     		}										} // End of class Main	</script></pag>