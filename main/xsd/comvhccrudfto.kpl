<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de " scale="48">	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,16" unfont="0">			<br exe="encabezado"/>		<hLine dim="90,0" g="2" type="1"/>		<br exe="encabezado"/>				<grp dim="15,5,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>				<grp dim="60,8,7,12">			<br/>			<inp id="nombreempresa" dim="70,1" fnt="20b,20b" type="string" modify="N" bclr="249,249,249" just="C" clr="13,13,103"/>			<br/>			<br/>			<inp id="tituloreporte" dim="70,1" fnt="20b,19b" type="string" modify="N" bclr="249,249,249" just="C"/>			<br/>			<inp id="titulost" dim="70,1" fnt="20b,19b" type="string" modify="N" bclr="249,249,249" just="C" clr="255,0,0"/>			<!-- <sp n="1"/> -->			<!-- <inp id="fechoper" dim="12,1" type="date" fnt=",16b" fmt="DD/MM/CCYY" modify="N" just="L" nc="-1"/> -->			<br exe="encabezado"/>		</grp>				<tab n="1"/>				<grp dim="15,5,7,12">			<!-- <tab n="2"/> -->			<!-- <txt>P&#225;g:</txt> -->			<!-- <sp/> -->			<!-- <inp id="k_pag" dim="5,1" type="number" mcr="k_pag"/> -->			<!-- <br/> -->			<br/>			<inp id="fecha" dim="11,1" type="date" fmt="DD-MM-CCYY" nc="-1" just="R"/>			<!-- <sp/> --> 			<br/>			<inp id="hora" dim="5,1" type="time" nc="-1" just="R"/> 			<sp n="1"/> <txt fnt=",">Hrs.</txt> 		</grp>		<br exe="encabezado"/>					<hLine dim="90,0" g="2" type="1"/>		<br exe="encabezado"/>				<br exe="detalle"/>		<sp n="1"/> <inp id="c_foliotx" dim="10,1" type="string" modify="N" clr="13,13,103"/> <sp n="2"/> <inp id="c_folio" dim="15,1" type="string" modify="N" clr="13,13,103"/>		<sp n="38"/> <inp id="c_anexotx" dim="10,1" type="string" modify="N" clr="13,13,103"/> 		<br exe="detalle"/>		<br exe="detalle"/>		<sp n="1"/> <inp id="c_folioreftx" dim="10,1" type="string" modify="N" clr="190,3,28"/> <sp n="2"/> <inp id="c_folioref" dim="15,1" type="string" modify="N" clr="190,3,28"/>		<br exe="detalle"/>		<br exe="detalle"/>		<sp n="1"/> <txt fnt=",">Inventario : </txt> <sp n="5"/> <inp id="c_invent" dim="12,1" type="string" modify="N"/> 		<sp n="35"/> <txt fnt=",">Serie : </txt> <sp n="1"/> <inp id="c_serie" dim="20,1" type="string" modify="N"/>		<br exe="detalle"/>		<sp n="55"/> <txt fnt=",">Cve. Vehicular : </txt> <sp n="1"/> <inp id="c_cvevhc" dim="20,1" type="string" modify="N"/>		<br exe="detalle"/>		<br exe="detalle"/> 		<sp n="1"/> <txt fnt=",">Numero Factura : </txt> <sp n="1"/> <inp id="c_fact" dim="12,1" type="string" modify="N"/>		<br exe="detalle"/>		<sp n="1"/> <txt fnt=",">Fecha Factura : </txt> <sp n="2"/> <inp id="c_fact_fech" dim="12,1" type="date" modify="N" fmt="DD/MM/CCYY" nc="-1"/>			<br exe="detalle"/>		<br exe="detalle"/>					<sp n="1"/> <inp id="c_prov_cve" dim="10,1" type="string" modify="N"/> <sp n="2"/> <inp id="c_prov_name" dim="45,1" type="string" modify="N"/>		<br exe="detalle"/>		<sp n="13"/> <inp id="c_prov_calle" dim="45,1" type="string" modify="N"/>		<br exe="detalle"/>		<sp n="13"/> <inp id="c_prov_col" dim="45,1" type="string" modify="N"/>			<br exe="detalle"/>		<sp n="13"/> <inp id="c_prov_pob" dim="45,1" type="string" modify="N"/>			<br exe="detalle"/>		<sp n="13"/> <inp id="c_prov_rfc" dim="45,1" type="string" modify="N"/>			<br exe="detalle"/>		<br exe="detalle"/>				<sp n="1"/> <txt fnt=",">Pedimento : </txt> <sp n="4"/> <inp id="c_ped" dim="45,1" type="string" modify="N"/>		<br exe="detalle"/>		<sp n="1"/> <txt fnt=",">Fecha Pedimento : </txt> <inp id="c_ped_fech" dim="45,1" type="date" modify="N" fmt="MM/DD/CCYY" nc="-1"/>		<br exe="detalle"/>		<sp n="1"/> <txt fnt=",">Lugar Importacion : </txt> <inp id="c_ped_lugar" dim="45,1" type="string" modify="N"/>		<br exe="detalle"/>		<br exe="detalle"/>				<sp n="1"/> <txt fnt=",">Producto </txt> <sp n="16"/> <txt fnt=",">Descripcion </txt> <sp n="49"/> <txt fnt=",">Importe</txt>		<br exe="detalle"/>		<br exe="detalle"/> 		<sp n="1"/> <inp id="c_prod" dim="20,1" type="string" modify="N"/> 		<sp n="2"/> <inp id="c_prod_name" dim="45,1" type="string" modify="N"/>		<sp n="2"/> <inp id="c_importe" dim="15,1" type="number" modify="N" just="R" nd="2"/>					<br exe="detalle"/>		<br exe="total"/> 				<sp n="15"/> <hLine dim="71,0" g="2" type="1"/> 		<br exe="total"/>				<sp n="55"/> <txt fnt=",">Subtotal </txt> <sp n="9"/> <inp id="c_subt" dim="15,1" type="number" modify="N" just="R" nd="2"/>		<br exe="total"/>		<sp n="55"/> <txt fnt=",">Iva </txt> <sp n="13"/> <inp id="c_iva" dim="15,1" type="number" modify="N" just="R" nd="2"/>		<br exe="total"/>				<sp n="55"/> <txt fnt="," clr="255,0,0">Retenciones </txt> <sp n="7"/> <inp id="c_ret" dim="15,1" type="number" modify="N" just="R" nd="2" clr="255,0,0"/>		<br exe="total"/>				<sp n="55"/> <inp id="c_holdtx" dim="10,1" type="string" modify="N"/> <sp n="5"/> <inp id="c_hold" dim="15,1" type="string" modify="N" just="R"/>		<br exe="total"/>		<sp n="55"/> <txt fnt=",">Importe </txt> <sp n="10"/> <inp id="c_tot" dim="15,1" type="number" modify="N" just="R" nd="2"/>		<br exe="total"/>				<sp n="15"/> <hLine dim="71,0" g="2" type="1"/>		<br exe="total"/>				<br exe="coments"/> 				<sp n="1"/> <txt fnt=",">Comentarios : </txt>		<br exe="coments"/> 		<br exe="coments"/>		<sp n="1"/> <inp id="c_cmnt1" dim="60,1" type="string" modify="N"/> 		<br exe="coments"/> 		<sp n="1"/> <inp id="c_cmnt2" dim="60,1" type="string" modify="N"/>		<br exe="coments"/>  		<sp n="1"/> <inp id="c_cmnt3" dim="60,1" type="string" modify="N"/> 		<br exe="coments"/> 				<!-- <br exe="coments"/> -->				<!-- <br exe="total"/>  -->		<!-- <tab n="5"/><txt fnt=",-1bi">Total:</txt><tab/><inp id="input3" dim="10,1" type="number" brdr="1,0" fnt=",0b"/>  -->		<!-- <br exe="total"/>  -->			</grp></pag>