<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Catalogo Refacciones"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="66,40,10,10" brdr="0,5" tit="Catalogo Refacciones" fnt="Arial,16">					<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" OnEnter="Exit" OnMouseD="Exit" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="60,22" modify="N" nren="fijo">		<col id="clave" name="Clave"/>		<col id="descr" name="Descripcion"/>		</tbl> 		<tab n="7"/>		<br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();							Inicializa();											}											fun Inicializa() {							var xmlRequest,cmd,ok,cuboResultados, totresults , contresults;									cmd= "select c1,c2 from keplersc.kdini";							cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_refacciones.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								totresults = nXml(cuboResultados);							frn.rst("tabla");				for (contresults=0; contresults<totresults ; contresults++){								frn.setX( getXmlAtt(cuboResultados,"r"&contresults,"c1"),"tabla",contresults,"clave");					frn.setX( getXmlAtt(cuboResultados,"r"&contresults,"c2"),"tabla",contresults,"descr");								}						}						fun Exit(){						var clave_ref = frn.get("tabla", -1, "clave");						frP.set("clave_ref", clave_ref ); 				frP.scriptElm("OnChange","clave_ref");								frn.exit();							}						}	</script></pag>