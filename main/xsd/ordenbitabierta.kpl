<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Bitacora de ordenes abiertas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0">	<br/>		<tab/><inp id="k_titulo" dim="50,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"			type="string" modify="N" available="N" fnt="Arial,22"/>	<br/><tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp dim="90,45,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Bitacora de ordenes abiertas">					<sp/><tab n="1"/><txt clr="0,58,112" hk="S">Sucursal</txt>			<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><sp n="1"/><txt clr="0,58,112" hk="S">Tipo</txt>			<cmb id="tipo_orden_bus" clr="64,64,64" clrBrdr="255,255,255"  dim="10,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><sp/><txt>Orden:</txt>			<inp id="folio_orden_bus" clr="64,64,64"  dim="12,1" fnt="Arial,16" clrBrdr="255,255,255"  OnChange="Formar_folio()" tooltip="Seleccionar orden F9"  OnF9="Dialog(3,ordentallerdet,s,folio_orden_bus)" nc="10"  bclr="255,255,255" brdr="2,0"  visible="Y"/>			<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			<br/>			<tab n="1"/>			<txt>Clave del Cliente: </txt>			<inp id="cliente_id" dim="10,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" brdr="0,2"/>			<sp/><txt>Nombre: </txt>			<inp id="cliente_nombre" dim="34,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" brdr="0,2"/>			<br/>			<tab n="1"/>			<txt fnt=",bs">Datos del Vehiculo:</txt><br/>			<tab n="1"/>			<txt>Serie:</txt>			<inp id="serie" dim="20,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" brdr="0,2"/>			<sp/><txt>Marca:</txt>			<inp id="marca" dim="10,1" modify="N" tooltip="Seleccionar F9" modify="N"  bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<sp/><txt>Modelo:</txt>			<inp id="modelo" dim="10,1" modify="N" tooltip="Seleccionar F9"  modify="N"  bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string"  brdr="0,2"/>			<sp/><txt>A&#241;o:</txt>			<inp id="anio" dim="4,1" nc="4" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="string" brdr="0,2"/>			<sp/><txt>Placas:</txt>			<inp id="placas" dim="9,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N"  type="string" brdr="0,2"/>			<br/>			<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="84,16" fixed="3">				<col id="sucursal" name="Sucursal" nc="7" visible="N"/>				<col id="tipo" name="Tipo" nc="1" visible="N"/>				<col id="orden" name="Orden" nc="10" visible="N"/>				<col id="fec_reg" name="Fecha Sistema" type="date" nc="-1" fmt="DD/MM/CCYY" modify="N" available="N"/>				<col id="hora_reg" name="Hora Sistema" type="time" nc="-1" modify="N" available="N"/>				<col id="usr" name="Usuario" nc="10" visible="N"/>				<col id="actividad" name="Actividad" nc="300" type="capital" modify="N" available="Y" visible="Y" 					OnF9="texto_emergente(tabla)" OnMouseD="texto_emergente(tabla)" OnEnter="texto_emergente(tabla)"/>			</tbl> 			<tab n="7"/>			<br/>			<sp n="3"/>			<txt>*Presionar F9 o Enter o dar doble click sobre el campo &quot;Actividad&quot; para ingresar el texto</txt>			<br/>			<tab n="1"/><bot id="bot_guardar" dim="14,0" brdr="5" text="Guardar" default="0" OnEnter="Guardar()"/>		</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco, externo ;			var tipoOper; //Variables relacionadas con parametros			var consAdmin, consControl, consPlantilla, consCargarHorasTab,consCierraAbrePuntosTab ,consCargos,consCargosSel,consRefsCierra,consRefsAbre,				consIniciarTerminarTrabajo,consCargosAbre,consTotsCierra,consCargosCierra ,consTotsAbre,consCalidadAlta, resVal,				consCalidadBaja,consAutorizaCierre,consAbreOrdenGeneral,consCierraOrdenGeneral;			var consCuestPre, consCuestEnt, consCuestWlka ; //CUEST			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";																Inicializa();						}//==================================================================================================================			//====================			//Descripcion: Se agrega como OnF9="texo_emergente()" o OnF5="texto_emergente(table)"			//En el grupo general y cuando se presione F5 en cualquier input			//que cumpla con los parametros, abrira un texto emergente 			//si se agrega a un elemento tabla funciona igual 			//Parametros: table = nombre del elemento grafico tabla			//Condiciones: Elemento Grafico Input o Tabla			//	Input: modify="Y" available="Y"			//	Tabla: modify="Y" available="Y"			//Salida: Resultado operacion que se agrega a el elemento grafico			//Depende: xsd/texto_emergente.kpl			//Autor: Gad Miranda			//Fecha: 17/octubre/2023			//====================			fun texto_emergente(tabla){				var id_ele_grafic, ele_available, ele_modify, ele_tipo, ele_tabla, col_tabla, ren_tabla				,t_ele_modify, t_ele_available, t_ele_tipo				,t_ele_valor, ele_valor;				id_ele_grafic = frn.getPos();				ele_available = frn.getAtt(id_ele_grafic,"available");				ele_modify = frn.getAtt(id_ele_grafic,"modify");				ele_tipo = frn.getAtt(id_ele_grafic,"type");				ele_tabla = tabla;				if (ele_tabla &! ""){					col_tabla = frn.getIdI(ele_tabla);					ren_tabla = frn.getIdJ(ele_tabla);					t_ele_modify = frn.getAtt(ele_tabla,"modify",col_tabla);					t_ele_available = frn.getAtt(ele_tabla,"available",col_tabla);				//	if(t_ele_available&="Y" && t_ele_modify &="Y"){						t_ele_valor = frn.get(ele_tabla,ren_tabla,col_tabla);						frn.dialog("texto_emergente.kpl",t_ele_valor,"",ele_tabla,ren_tabla,col_tabla);				//	}				}								if (ele_available &= "Y" && ele_modify &= "Y"){					ele_valor=frn.get(id_ele_grafic);					frn.dialog("texto_emergente.kpl",ele_valor,id_ele_grafic);				}			}					//==================================================================================================================			fun ListaOrdenes(){	//				borrar_datos();											frn.dialog("ordentallerdet", "s");			}					fun ValidarDatos(){				if (frn.get("folio_orden_bus") &= "") {											frn.setPos("folio_orden_bus");					resVal=0;					frn.message("Debe especificar numero de orden, verificar","Error","Aceptar");					return;				}				if (frn.get("serie") &= "") {											frn.setPos("folio_orden_bus");					resVal=0;					frn.message("La orden no existe, verificar","Error","Aceptar");					return;				}				if (frn.get("tabla", 0, "actividad") &= "") {											frn.setPos("tabla", 0, "actividad");					resVal=0;					frn.message("La actividad no puede estar vacia, verificar","Error","Aceptar");					return;				}			}			fun Guardar() {				var cmdQuery, mensajeError;				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}							var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}				var xmlRequest = getXml(frn.dataPag());					setXml(xmlRequest ,"k_n_renglon",frn.N("tabla") - 1);				setXml(xmlRequest ,"usuario",usuario);				frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");				cmdQuery="SELECT * FROM keplersc.ordenbitabierta('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				var cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"ordenbitabierta.Guardar()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");				if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}					frn.message("Registro Guardado","Mensaje","Aceptar");					Buscar();			}				fun Inicializa(){				var cmd,cubo,ok,mensajeError ;				//Llenar combo tipo_orden_bus				cmd = "select c1 from keplersc.kdcatcitasordenes";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}					frn.set("tipo_orden_bus",cubo);				frn.set("tipo_orden_bus","T");								//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));								frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));				frn.set("k_titulo","Bitacora de ordenes abiertas");					}						fun Buscar() {							var xmlRequest,cmd,ok,cuboResultados, totOrd , contOrd, ref_clave, ref_desc;						var folio_orden = frn.get("folio_orden_bus");				var suc_bus = frn.get("k_sucN", -1, 1);				var tipo_orden = frn.get("tipo_orden_bus", -1, 1);				cmd= "SELECT COUNT(*) AS numero_registros					FROM keplersc.ordenbitabierta					where sucursal='" & suc_bus  & "' and tipo='" & tipo_orden & "' and orden='" & folio_orden & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ordenbitabierta.Buscar()");					//llena datos de la orden					cmd= "select ord.c1 as sucursal, ord.c2 as tipo, ord.c3 as orden, ord.c10 as cliente_id, ord.c11  cliente_nombre,						ord.c6 as serie, ser.c2 as marca, ser.c3 as modelo, ser.c11 as anio, ord.c21 as placas						from keplersc.kdord ord inner join keplersc.kdserie ser on ord.c6 = ser.c1 						where ord.c1='" & suc_bus  & "' and ord.c2='" & tipo_orden & "' and ord.c3='" & folio_orden & "'";					frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRequest");					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ordenentsaluni.Buscar()");					ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cuboResultados,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cubocliente");					frn.set("cliente_id",getXmlAtt(cuboResultados,"r0","cliente_id"));					frn.set("cliente_nombre",getXmlAtt(cuboResultados,"r0","cliente_nombre"));					frn.set("serie",getXmlAtt(cuboResultados,"r0","serie"));					frn.set("marca",getXmlAtt(cuboResultados,"r0","marca"));					frn.set("modelo",getXmlAtt(cuboResultados,"r0","modelo"));					frn.set("anio",getXmlAtt(cuboResultados,"r0","anio"));					frn.set("placas",getXmlAtt(cuboResultados,"r0","placas"));				if (getXmlAtt(cuboResultados,"r0","numero_registros")&="0"){					cmd= "select c1 as sucursal,c2 as tipo,c3 as orden from keplersc.kdord 						where c1='" & suc_bus  & "' and c2='" & tipo_orden & "' and c3='" & folio_orden & "'";					frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRequest");					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ordenview.Buscar()");					ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cuboResultados,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");					totOrd = nXml(cuboResultados);					frn.rst("tabla");					for (contOrd=0; contOrd<totOrd ; contOrd++){											frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"sucursal"),"tabla",contOrd,"sucursal");						frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"orden"),"tabla",contOrd,"orden");						frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"tipo"),"tabla",contOrd,"tipo");					}				} else{					cmd= "select sucursal, tipo, orden, fec_hora_reg, usr, actividad from keplersc.kdordenbitabierta						where sucursal='" & suc_bus  & "' and tipo='" & tipo_orden & "' and orden='" & folio_orden & "'";										cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"kdordenbitabierta.Buscar()");					frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");					totOrd = nXml(cuboResultados);					frn.rst("tabla");					for (contOrd=0; contOrd<totOrd ; contOrd++){											frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"sucursal"),"tabla",contOrd,"sucursal");						frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"orden"),"tabla",contOrd,"orden");						frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"tipo"),"tabla",contOrd,"tipo");						frn.setX( mid(getXmlAtt(cuboResultados,"r"&contOrd,"fec_hora_reg"),0,10),"tabla",contOrd,"fec_reg");						frn.setX( mid(getXmlAtt(cuboResultados,"r"&contOrd,"fec_hora_reg"),11,5),"tabla",contOrd,"hora_reg");						frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"usr"),"tabla",contOrd,"usr");						frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"actividad"),"tabla",contOrd,"actividad");					}				}				}														//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------									fun Formar_folio(){							var xmlReqEst, cubofol, cmd, ok, mensajeError ;				if (frn.get("folio_orden_bus") &! ""){					setXml(xmlReqEst,"document","folio_id",frn.get("folio_orden_bus"));										cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";					cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");					frn.lib("libGeneral.kpl","FileSave",cubofol,"C:\Basura\cuboFol");									var resultado =getXmlAtt(cubofol,"r0", "resultado");					if(resultado &= "0"){						mensajeError = getXmlAtt(cubofol,"r0", "mensaje");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					var fol = getXmlAtt(cubofol,"r0", "mensaje");										frn.set("folio_orden_bus", fol);				}				Buscar();			}									fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>