<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Masivo Contable"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">	<tab/><txt fnt=",22" clr="0,0,0">Masivo Contable</txt><tab/>	<br/>		<tab/><hLine clr="0,0,0"/>	<br/>	<br/><tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="45,25,10,17" brdr="0,5" tit="Masivo Contable" fnt="Arial,16">					<sp/><txt clr="0,58,112" hk="S">Sucursal:</txt>		<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="23,36" bclr="255,255,255" brdr="2,0" OnChange="ResetDetalle()" fnt="Arial,16" Null="N" hk="S" available="Y"/>		<sp n="2"/><txt>Anio en Curso:</txt>		<inp id="anio" clr="64,64,64" clrBrdr="255,255,255"  dim="4,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" OnChange="ResetDetalle()" type="text" nc="4" available = "Y" modify="Y"/>				<sp n="2"/><txt>Clave Vehiculo:</txt>		<inp id="cve_vehiculo" clr="64,64,64" clrBrdr="255,255,255"  dim="10,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" OnChange="ResetDetalle()" type="capital" nc="10" available = "Y" modify="Y"/>				<sp/>		<img id="img_buscar" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png"  OnEnter="ObtenerDatos()"/>			<br/>		<sp/>				<tbl id="k_mov" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="88,20" modify="Y" Reorder="Y" available="Y" insdel="Y">			<col name="Clave Vehiculo" id="clave_vehiculo"  modify="N" visible="Y"/>			<col name="Descripcion" id="desc_vehiculo"  modify="N" visible="Y"/>			<col name="N.Descuento" id="n_descuento"   visible="Y"/>			<col name="Ventas F&amp;I" id="ventas_fi" visible="Y"/>			<col name="Costo F&amp;I" id="costo_fi"   visible="Y"/>			<col name="Ventas Ctdo" id="ventas_ctdo"   visible="Y"/>			<col name="Proveedores" id="proveedores"   visible="Y"/>			<col name="Inventario" id="inventario"   visible="Y"/>			<col name="Costo" id="costo"   visible="Y"/>			<col name="Venta" id="venta"   visible="Y"/>			<col name="IVA Venta" id="iva_venta"   visible="Y"/>			<col name="IVA Compra" id="iva_compra"   visible="Y"/>			<col name="Traspaso Costo" id="traspaso_costo"   visible="Y"/>			<col name="Traspaso Venta" id="traspaso_venta"   visible="Y"/>		</tbl>		<br/><sp/>		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Guardar" hk="K" default="0" step="0"  OnEnter="Guardar()" fnt="Arial,16"/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, asterisco  ;		var cmdQuery, cuboQuery, ok, mensajeError;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			rol_usuario = frn.config("user","role");			asterisco = "*";						llena_combos();			ConfiguraUI();			Inicializa();		}            		fun llena_combos(){					//Llenar combo sucursales			cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}			}							cmdQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery ,"cat_crud_vendedores.Inicializa()");								ok=getXmlAtt(cmdQuery ,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cmdQuery ,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}							frn.set("k_sucN",getXml(cmdQuery ));			frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));								ResetDetalle();		}				fun ResetDetalle(){			frn.rst("k_mov");		}				fun ObtenerDatos(){			var xmlPantalla;			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			cmdQuery = "select vc.c1 as clave_vehiculo, iv.c2 as desc_vehiculo,  vc.c15 as n_descuento, vc.c16 as ventas_fi, vc.c17 as costo_fi, vc.c18 as ventas_ctdo,  ";			cmdQuery = cmdQuery & " vc.c19 as proveedores, vc.c20 as inventario, vc.c21 as costo, vc.c22 as venta, vc.c23 as iva_venta, vc.c24 iva_compra, vc.c25 as traspaso_costo, ";			cmdQuery = cmdQuery & " vc.c26 as traspaso_venta from keplersc.kdivcl as vc inner join keplersc.kdiv as iv on vc.c1=iv.c1 ";			cmdQuery = cmdQuery & " where vc.c3='" & frn.get("k_sucN", -1 , 1) & "' and vc.c2=right('" & frn.get("anio") & "',2)";						var clave_vehiculo = frn.get("cve_vehiculo");			if ( clave_vehiculo &! ""){				cmdQuery = cmdQuery & " and vc.c1='" & clave_vehiculo & "'";			}			rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"masivo_contable.ObtenerDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_mov",cuboQuery);					}				fun Guardar(){			var xmlPantalla,no_partidas,resultado,mensaje,adicionales;			//Validaciones			no_partidas=frn.N("k_mov")-1;			if (no_partidas==0) {				frn.message("Error, no se tiene registros de configuración","Error","Aceptar");				return;			}			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;						setXml(xmlPantalla ,"k_partidas","no_partidas",no_partidas);						frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaLineas");			cmdQuery="select * from keplersc.masivo_contable('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						kdb.rst(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"masivo_contable.Guardar()");			resultado= getXml(cuboQuery,"resultado");			mensaje= getXml(cuboQuery,"mensaje");							if(resultado &= "0"){				frn.message(mensaje,"Error","Aceptar");				return;			}			frn.message("Registros modificados","Mensaje","Aceptar");		}				fun ConfiguraUI(){			if (frn.nParam() == 0){				frn.message("Acción no permitida.","Error","&Aceptar");//				frn.open("redirect",2);				return;			}		}				fun Inicializa(){			frn.rst("gpo_2");						frn.set("anio", sys.date());						ObtenerDatos();		}						fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}												fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}			           					}				</script></pag>