<?xml version="1.0" encoding="UTF-8"?><pag xmlns='www.kepler.com.mx/2003/KSchema' tit='Orden' scale="48"><grp dim='1,-1,10,20' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0"><br/>	<grp dim="15,10,7,12"><sp/>		<img id="img"  dim="14,80" brdr="0,1" img="img_en_blanco.png"/>	</grp>	<grp dim="40,8,7,1">		<inp id="titulo"  dim="50,1" brdr="0,1" type="string" fnt="Arial,30b"/><br/><tab n="4"/><sp/>		<br/>			</grp>	<br exe="encabezado"/>	<br exe="encabezado"/>	<br exe="encabezado"/>	<br exe="encabezado"/>	<br exe="encabezado"/>	<br exe="encabezado"/><grp dim='100,5,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0"><sp/><txt>Sucursal:</txt><inp id="suc_desc"  just="L" dim="60,1" brdr="0,1" type="string" fnt="Arial,15" bclr="255,255,255" nc="20"/><br/><sp/><txt>Orden de Servicio: </txt><inp id="tipo_orden"  dim="2,1" fnt="Arial,15" brdr="0,1" bclr="255,255,255" type="string"/><inp id="folio_orden"  dim="10,1" fnt="Arial,15" brdr="0,1" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Asesor: </txt><inp id="asesor_servicio"  dim="20,1" fnt="Arial,15" brdr="0,1" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Tel.Oficina: </txt><inp id="tel_oficina_asesor"  dim="10,1" fnt="Arial,15" brdr="0,1" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Extension: </txt><inp id="extension_asesor"  dim="10,1" fnt="Arial,15" brdr="0,1" bclr="255,255,255" type="string"/><tab n="1"/><br/><sp/><txt>Fecha/Hora Recepcion: </txt><inp id="fecha_recep"  dim="8,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><inp id="hora_recep"  dim="6,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><sp/><txt>Fecha/Hora Entrega: </txt><inp id="fecha_entrega"  dim="8,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><inp id="hora_entrega"  dim="6,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Tel.Movil: </txt><inp id="tel_movil_asesor"  dim="10,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/></grp><br exe="encabezado"/><grp dim='100,17,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0"><sp/><txt fnt="Arial,18b">Datos del Cliente </txt><inp id="clave_cli"  dim="10,1" brdr="0,1" bclr="255,255,255" type="string"/><br/><sp/><txt>Nombre o Razon Social: </txt><inp id="nombre_razon_social"  dim="40,1" fnt="Arial,15" brdr="0,1" bclr="255,255,255" type="string"/><tab n="2"/><sp/><txt>RFC: </txt><inp id="rfc"  dim="20,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><br/><sp/><txt>Correo: </txt><inp id="correo"  dim="50,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><br/><sp/><txt>Calle: </txt><inp id="calle"  dim="28,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>No.Int: </txt><inp id="no_int"  dim="3,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>No.Ext: </txt><inp id="no_ext"  dim="3,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Colonia: </txt><inp id="colonia"  dim="30,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><br/><sp/><txt>Cuidad o Poblacion: </txt><inp id="cuidad_poblacion"  dim="20,1" fnt="Arial,15" brdr="0,1" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Municipio o Delegacion: </txt><inp id="municipio_delegacion"  dim="12,1" fnt="Arial,15" brdr="0,1" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Estado: </txt><inp id="estado"  dim="20,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><br/><sp/><txt>Pais: </txt><inp id="pais"  dim="12,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Codigo Postal: </txt><inp id="codigo_postal"  dim="12,1" fnt="Arial,15" brdr="0,1" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Telefono de Casa: </txt><inp id="tel_casa"  dim="12,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><br/><sp/><txt>Telefono de Oficina: </txt><inp id="tel_oficina"  dim="12,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Extension: </txt><inp id="extension"  dim="12,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Telefono Movil: </txt><inp id="tel_movil"  dim="12,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><br/><br/><sp/><txt fnt="Arial,18b">Datos del Vehiculo </txt><inp id="vin"  dim="10,1" brdr="0,1" bclr="255,255,255"/><br/><sp/><txt>Serie: </txt><inp id="serie"  dim="20,1" brdr="0,1"  fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Marca: </txt><inp id="marca"  dim="12,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>A&#241;o: </txt><inp id="anio"  dim="6,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Modelo: </txt><inp id="modelo"  dim="12,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><br/><sp/><txt>Placas: </txt><inp id="placas"  dim="12,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Kilometraje: </txt><inp id="kms"  dim="12,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/><sp/><txt>Color: </txt><inp id="color"  dim="12,1" brdr="0,1" fnt="Arial,15" bclr="255,255,255" type="string"/><tab n="1"/></grp><grp dim='10,10,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0"/><br exe="datos_principales"/><br/><sp/><txt fnt="Arial,18b">Trabajos Solicitados</txt><br exe="tit_trabajos"/><sp/><txt>Descripcion</txt><tab n="24"/><sp/><txt>Importe</txt><br exe="encabezadotrabajos"/><hLine dim="90,0" g="2"/><br exe="linea_encabezados"/><sp/><inp id="trabajo"  dim="60,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/><tab n="6"/><sp/><inp id="costo"  dim="6,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15"/><br exe="trabajos"/><grp dim='100,5,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0"><hLine dim="90,0" g="2"/><br/><tab n="20"/><sp/><txt>Subtotal</txt><tab n="1"/><inp id="subtotal"  dim="15,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15b" nd="2"/><br/><tab n="20"/><sp/><txt>IVA</txt><tab n="2"/><inp id="iva"  dim="15,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15b" nd="2"/><br/><tab n="20"/><sp/><txt>Total</txt><tab n="2"/><inp id="total"  dim="15,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15b" nd="2"/></grp><br exe="totales"/><grp dim='100,21,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0"><sp/><txt>Observaciones:</txt><br/><sp/><inp id="observaciones1"  dim="98,1" brdr="0,1" fnt="Arial,10" bclr="255,255,255" type="string"/><tab n="1"/><br/><sp/><inp id="observaciones2"  dim="98,1" brdr="0,1" fnt="Arial,10" bclr="255,255,255" type="string"/><tab n="1"/><br/><sp/><inp id="observaciones3"  dim="98,1" brdr="0,1" fnt="Arial,10" bclr="255,255,255" type="string"/><tab n="1"/><br/><sp/><inp id="observaciones4"  dim="98,1" brdr="0,1" fnt="Arial,10" bclr="255,255,255" type="string"/><tab n="1"/><br/><sp/><inp id="observaciones5"  dim="98,1" brdr="0,1" fnt="Arial,10" bclr="255,255,255" type="string"/><tab n="1"/><br/><sp/><inp id="observaciones6"  dim="98,1" brdr="0,1" fnt="Arial,10" bclr="255,255,255" type="string"/><tab n="1"/><br/><br/><sp/><txt>Actividades Preentrega:</txt><br/><sp/><txt>__</txt><inp id="act0"  dim="32,1" brdr="0,1" bclr="255,255,255" type="string"/><sp/><txt>__</txt><inp id="act1"  dim="32,1" brdr="0,1" bclr="255,255,255" type="string"/><sp/><txt>__</txt><inp id="act2"  dim="32,1" brdr="0,1" bclr="255,255,255" type="string"/><br/><sp/><txt>__</txt><inp id="act3"  dim="32,1" brdr="0,1" 