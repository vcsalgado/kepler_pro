"12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/><br/>				<tab n="1"/><txt>17</txt><sp/>		<inp id="17:00" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="17:15" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="17:30" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="17:45" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/><br/>				<tab n="1"/><txt>18</txt><sp/>		<inp id="18:00" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="18:15" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="18:30" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="18:45" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/><br/>						<tab n="1"/><txt>19</txt><sp/>		<inp id="19:00" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="19:15" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="19:30" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="19:45" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/><br/>			<tab n="1"/><txt>20</txt><sp/>		<inp id="20:00" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="20:15" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="20:30" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="20:45" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/><br/>					<br/>		<br/>					</grp>					</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,fecha,recepcionista,sucursal,suc_usuario,folio_cita,folio_orden,tip_ope, llamadas_por_cuarto_de_hora  ;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				suc_usuario = frn.lib("libKepler","UserInfo(1)");								fecha= frP.get("k_fecha");				sucursal = frP.get("k_sucN", -1, 1);				folio_orden = frP.get("folio_orden");												if (sucursal &= ""){					sucursal = suc_usuario;				}							Inicializa();			}											fun Inicializa() {							var xmlRequest,cmd,ok,cubo, mensajeError ;								if (fecha &= ""){					fecha= fnDate("add",sys.date(),"+1");				}						frn.set("fecha_busqueda", fecha);											cmd = "select c3 from keplersc.kdconfsegpos " ;						cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"horarios_segposventa.Inicializa()");										frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_recep_citas");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				llamadas_por_cuarto_de_hora = getXmlAtt(cubo ,"r0","c3");				if (llamadas_por_cuarto_de_hora &= ""){					llamadas_por_cuarto_de_hora = 1;				}											buscar_datos();			}									fun buscar_datos(){							var cmd,cubo,ok, mensajeError,strTmp,xmlRes,xmlRequest,totresultados ,contresultados ;							var fcha = frn.get("fecha_busqueda");												var compara_fechas = fnDate("cmp",fcha ,sys.date());				if (compara_fechas == -1 || compara_fechas == 0 ){					frn.message("No se puede consultar fechas menores o iguales a la fecha actual","Error","Aceptar"); return ;				}								borrar_datos();										//	busca encuestas para el mismo dia 				cmd = "select c2,c3,c5 from keplersc.kdencprog where c1='" & sucursal & "' and c4 = '" & fcha & "' and c6=" & 10 ;											cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"horarios_segposventa.buscar_datos()");										frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_recep_citas");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								totresultados = nXml(cubo );					for (contresultados=0; contresultados<totresultados ; contresultados++){					var tipo_ord= getXmlAtt(cubo ,"r"&contresultados ,"c2");					var fol = getXmlAtt(cubo ,"r"&contresultados ,"c3");					var horario =getXmlAtt(cubo ,"r"&contresultados ,"c5");										//	busca encuestas para el mismo horario					cmd = "select count(*) as ctd_encuenstas from keplersc.kdencprog where c1='" & sucursal & "' and c4 = '" & fcha & "' and c5='" & horario  & "' and c6=" & 10 ;												cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"horarios_segposventa.buscar_datos()");											frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_recep_citas");								ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					var ctd_encuestas = getXmlAtt(cubo ,"r0","ctd_encuenstas");										if (ctd_encuestas >= llamadas_por_cuarto_de_hora) {						frn.set(horario ,tipo_ord & " " & fol);										}				}								}						fun borrar_datos(){							frn.rst("07:00");				frn.rst("07:15");				frn.rst("07:30");				frn.rst("07:45");				frn.rst("08:00");				frn.rst("08:15");				frn.rst("08:30");				frn.rst("08:45");				frn.rst("09:00");				frn.rst("09:15");				frn.rst("09:30");				frn.rst("09:45");					frn.rst("10:00");				frn.rst("10:15");				frn.rst("10:30");				frn.rst("10:45");						frn.rst("11:00");				frn.rst("11:15");				frn.rst("11:30");				frn.rst("11:45");					frn.rst("12:00");				frn.rst("12:15");				frn.rst("12:30");				frn.rst("12:45");						frn.rst("13:00");				frn.rst("13:15");				frn.rst("13:30");				frn.rst("13:45");						frn.rst("14:00");				frn.rst("14:15");				frn.rst("14:30");				frn.rst("14:45");				frn.rst("15:00");				frn.rst("15:15");				frn.rst("15:30");				frn.rst("15:45");									frn.rst("16:00");				frn.rst("16:15");				frn.rst("16:30");				frn.rst("16:45");									frn.rst("17:00");				frn.rst("17:15");				frn.rst("17:30");				frn.rst("17:45");				frn.rst("18:00");				frn.rst("18:15");				frn.rst("18:30");				frn.rst("18:45");								frn.rst("19:00");				frn.rst("19:15");				frn.rst("19:30");				frn.rst("19:45");				frn.rst("20:00");				frn.rst("20:15");				frn.rst("20:30");				frn.rst("20:45");							}																	}	</script></pag>