<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Horarios Disponibles"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="61,45,10,10" brdr="0,5" tit="Horarios Disponibles" fnt="Arial,16">				<tab n="1"/><txt>Fecha:</txt>		<edt id="fecha_busqueda" dim="9,1"  fmt="DD/MM/CCYY"  page="_ks_fecha,fecha_busqueda" OnF9="Dialog(3,_ks_fecha,fecha_busqueda)"  bclr="192,205,213" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<tab n="1"/>		<img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="buscar_datos()" available="Y" clrBrdr="0,0,0"/>			<br/>						<br/>	<br/>					<tab n="3"/><sp n="2"/><txt>00</txt><tab n="3"/><sp n="3"/><txt>15</txt><tab n="4"/><sp/><txt>30</txt><tab n="4"/><txt>45</txt><br/>		<tab n="1"/><txt>07</txt><sp/>		<inp id="07:00" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="07:15" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="07:30" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="07:45" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/><br/>				<tab n="1"/><txt>08</txt><sp/>		<inp id="08:00" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="08:15" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="08:30" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp/>		<inp id="08:45" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><sp