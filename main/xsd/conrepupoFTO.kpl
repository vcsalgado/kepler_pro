<?xml version="1.0" encoding="UTF-8"?><pag xmlns='www.kepler.com.mx/2003/KSchema' tit="Impresion de polizas" scale="56">	<grp dim='1,-1,10,20' brdr='0,1' clr='0,0,0' bclr='255,255,255' unfont="0"><txt>______________________________________________________________________________________________________________________________________________________________________________________________________</txt><br exe="encabezadoP"/><tab/><txt fnt="Tahoma,17b" clr="0,58,112" bclr="255,255,255">Reporte de impresion de polizas</txt><br exe="encabezadoP"/><br/><txt>______________________________________________________________________________________________________________________________________________________________________________________________________</txt><br exe="encabezado"/><br/><tab n="23"/><txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Documento que genero la poliza</txt><inp id="sucP"  dim="2,1" type="string"/><inp id="gdocP"  dim="2,1" type="string"/><inp id="ndocP"  dim="2,1" type="string"/><inp id="gpodocP"  dim="2,1" type="string"/><inp id="tdocP"  dim="2,1" type="string"/><inp id="fdocP"  dim="10,1" type="string" nc="10"/><inp id="descdocP"  dim="20,1" type="string" nc="10"/><br exe="encabezado"/><tab/><br exe="encabezado"/><tab/><txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Fecha poliza</txt><tab n="3"/><inp id="fechaP"  dim="10,1" type="date" fmt="DD/MM/CCYY" nc="-1"/><br exe="encabezado"/><tab n="2"/><br exe="encabezado"/><tab/><txt fnt=",16" clr="0,58,112" bclr="255,255,255">Numero de cuenta</txt><tab n="2"/><txt fnt=",16" clr="0,58,112" bclr="255,255,255">Nombre de la cuenta</txt><tab n="6"/><txt fnt="Arial,0" clr="0,58,112">Descripcion del movimiento                     </txt><tab/><txt fnt="Arial,0" clr="0,58,112">Concepto  </txt><tab n="2"/><txt fnt="Arial,0" clr="0,58,112"> </txt><tab/><txt fnt="Arial,0" clr="0,58,112"> Depto               proyecto</txt><tab n="4"/><txt fnt="Arial,0" clr="0,58,112" bclr="255,255,255">Cargo</txt><tab n="4"/><txt fnt="Arial,0,0,0,0,0,0" clr="0,58,112">Abono</txt><tab n="22"/><br exe="encabezado"/><txt>______________________________________________________________________________________________________________________________________________________________________________________________________</txt><br exe="linea"/><tab/><tab/><inp id="numero_cuenta"  dim="15,1" type="string"/><inp id="nombre_cuenta"  dim="30,1" type="string"/><inp id="descripcionP"  dim="29,1" type="string"/><inp id="conceptoP"  dim="12,1" type="string" nd="2"/><inp id="deptoP"  dim="12,1" type="string" nd="2"/><inp id="proyP"  dim="12,1" type="string" nd="2"/><inp id="cargoP"  dim="13,1" type="number" nd="2"/><inp id="abonoP"  dim="13,1" type="number" nd="2"/><tab n="17"/><br exe="detalle"/><br/><tab n="14"/><txt>__________________________________________________________________________________________________________________________________________</txt><br exe="totales"/><tab n="25"/><txt fnt="Arial,16b" clr="0,58,112">Sumas iguales</txt><tab n="2"/><txt>     </txt><tab/><txt> </txt><inp id="total_cargos"  dim="15,1" type="number" nd="2"/><inp id="total_abonos"  dim="15,1" type="number" nd="2"/><br exe="totales"/><tab/><txt fnt="Arial,16" clr="0,58,112">Poliza</txt><tab n="2"/><inp id="tipoP"  dim="2,1" type="string"/><tab/><inp id="numeroP"  dim="3,1" type="string"/><tab n="7"/><txt fnt="Arial,0,0,0,0,0" clr="0,58,112">Referencia</txt><inp id="referenciaP"  dim="10,1" type="string"/><br exe="totales"/><br/><br exe="vacio"/>	</grp></pag>