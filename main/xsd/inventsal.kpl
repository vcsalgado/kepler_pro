<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Entrada y Salidas de Almac&#233;n"><grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><tab/>	<txt fnt=",22" clr="0,0,0">Ajustes al inventario</txt><br/><tab/>	<hLine dim="0,1" clr="0,0,0"/> 	<br/> <br/>	<tab n="1"/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="50,11,7,12" tit="Datos generales"  fnt="Arial,16"><tab/>		<txt clr="0,58,112" hk="S">Sucursal</txt>		<tab n="1"/>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="40,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  OnChange="CambiaSucursal()" available="Y"/><br/><tab/>	   <txt clr="0,58,112">Tipo docto</txt><tab n="1"/>		<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255"  dim="25,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="TipoMov()" OnEnter="TipoMov()" available="Y"/><br/>		<inp id="tipo_movto" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N" visible="N"/>		<inp id="k_iva" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N" visible="N"/>		<br/><br/><tab/>		<bot id="bot_preload" dim="10,0" brdr="5" available="Y" visible="Y" text="Cargar" OnEnter="_pre_cargar_partes()"/><tab/>		</grp><sp/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="29,12,7,12" tit="Documento" fnt="Arial,16">		<tab n="3"/><inp id="operacion" clr="64,64,64"  dim="18,1" brdr="0,1" fnt=",18b" available="N" type="string"/><br/><tab/>		<txt id="foliotxt"  visible="N" hk="F" clr="0,58,112" fnt="Arial,16">Folio</txt><tab/>		<edt id="k_folio" clr="64,64,64" clrBrdr="255,255,255" dim="18,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" visible="N" hk="F" OnChange="Formar_folio()" OnF9="ObtenerFolio()" OnMouseL="ObtenerFolio()" modify="N" type="string" nc="10" tooltip="Folio del movimiento ( F9 b&#250;squeda )" available="Y"/>		<tab/><img id="k_buscar_folio" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_folio()" tooltip="Consultar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>		<br/><tab/>		<inp id="k_docto" clr="64,64,64"  dim="22,1" brdr="0,1" fnt="Arial,16" available="N" link="k_tipon,5" type="string"/><br/><tab/><txt clr="0,58,112" fnt="Arial,16">Fecha</txt><tab/>		<edt id="k_fecha" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" modify="Y" available="Y"/><tab n="2"/> 		<inp id="statusdoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N" type="string"/>		</grp><br/><br/>	<tab/>	<grp  bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="0" clrBrdr="0,58,112" dim="80,25,7,12" brdr="0,5"  fnt="Arial,16"><tab/><br/> <br/>		<tab/>		<tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="108,10"  hk="z" OnChange="" Reorder="N" modify="Y" available="Y">			<col id="k_parte" name="Art&#237;culo"  type="capital" nc="18" 			OnF9="ConsultaProductos()"			OnF10="Dialog(3,cat_prod_crud,Nuevo,x,s)" 			OnF11="Dialog(3,cat_prod_crud,Modificar,x,s)" 			OnMouseL="ConsultaProductos()"			OnChange="Producto()"			OnActive="CalcTotalImporte()"/>			<col id="k_descr" name="Descripci&#243;n" modify="N" OnActive="CalcTotalImporte()"/>			<col id="k_q" name="Cantidad"  type="number" nd="-1" min="0" OnChange="Cantidad()" OnActive="CalcTotalImporte()"/>			<col id="k_unidad" name="Unidad" modify="N" type="capital" OnActive="CalcTotalImporte()"/>			<col id="k_precio" name="Costo"  type="number" OnChange="Cantidad()" nd="-1" visible="Y" OnActive="CalcTotalImporte()"/>			<col id="k_monto" name="Importe"  type="number" nd="2" min="0" OnChange="Monto()" OnActive="CalcTotalImporte()"/>			<col id="k_partesel" name="Ref. Original" type="capital" nc="18" modify="N" OnActive="CalcTotalImporte()"/>		</tbl><br/>	<grp dim="70,14,7,12" hSpace="4">		<br/>		<tab/><txt fnt="Arial,16" clr="0,58,112" bclr="255,255,255">Comentarios:</txt><br/><tab/>		<inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="60,3" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" type="capital"/>	</grp>		<grp dim="50,10,7,12" hSpace="4" clr="0,58,112">		<br/>		<tab n="7"/><txt fnt="Arial,16s" clr="0,58,112" bclr="255,255,255">IMPORTE</txt> 		<inp id="k_monto" clr="64,64,64"  dim="10,1" fnt="Arial,16s" type="number" nd="2" modify="N" available="N"/>		<br/><br/>		<tab n="1"/>		<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Consulta()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>		<tab n="6"/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/><tab/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Alta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><tab/>			</grp></grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb, sys, rep;			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc, tip_ope, entrada_salida,suc_usuario,perfil_usuario ,asterisco,rol_usuario;			var especificaciones_doc ;			var monto_total;			var folio;			var uen;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();				//kdb.open("s,kdms");				sys=new SYS;				rep=new REP;								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								Inicializa();							}			fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;								setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"inventsal.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);			}						fun ObtenerFolio(){				var cmdQuery;				cmdQuery="select c6 as folio, to_char(c9,'dd/mm/yyyy') as fecha, c10 as cliente, c32 as nombre,c11 as factura, c16 as monto " & 					"from keplersc.kdm1 where c1='" & 					frn.get("k_sucn",-1,1) & "' and c2='" & gen_doc & "' and c3='" & nat_doc & "' and c4=" & gpo_doc 					& " and c5=" & frn.get("k_tipon",-1,4) & " order by c9 desc";				frn.dialog("genlistafiltrosel","Movimiento a taller",cmdQuery,"folio","k_folio","0","0","N","N");								}			fun Inicializa(){				uen=trim(frn.param(7));				if (uen &= ""){					uen="XXX";					}					if( frn.nParam()>0 ){//Se han mandado parámetros a la página					gen_doc=trim(frn.param(0)); nat_doc=trim(frn.param(1)); gpo_doc=trim(frn.param(2));					tip_doc=trim(frn.param(3)); fija_doc=trim(frn.param(4));tip_ope=trim(frn.param(5));					entrada_salida=trim(frn.param(6));				}else				{					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}						if (strlen(gen_doc)==0) gen_doc="N"; if (strlen(nat_doc)==0) nat_doc="A"; if (strlen(gpo_doc)==0) gpo_doc="20";				if (strlen(tip_ope)==0) tip_ope=0;if (strlen(entrada_salida)==0) entrada_salida="E";//Valores Default				if(fija_doc==1){//No permite cambiar los combos de grupo o tipo de documento					frn.setAtt("grpDoc","available","N");					if(strlen(tip_doc)>0)frn.setAtt("k_tipon","available","N");				}else{ 					frn.setAtt("grpDoc","available","Y"); frn.setAtt("k_tipon","available","Y");				} 										frn.set("k_fecha",sys.date());								frn.set("k_hora",sys.time());								frn.set("tipo_movto",entrada_salida);							frn.setAtt("bot_preload", "available", "N" );				frn.setAtt("bot_preload", "visible", "N" );				if(tip_ope==0){//Alta					frn.set("operacion","ALTA");					frn.setAtt("foliotxt", "visible", "N" );					frn.setAtt("k_folio", "visible", "N" );					frn.setAtt("Imprimir", "visible", "N" );					frn.setAtt("Aceptar", "visible", "Y" );					frn.setAtt("Cancelar", "visible", "Y" );					frn.setAtt("k_buscar_folio", "visible", "N" );					frn.setAtt("k_fecha", "available", "Y" );					frn.setAtt("k_mov", "available", "Y" );					if (rol_usuario &= "ADMINISTRADOR"){						frn.setAtt("bot_preload", "available", "Y" );						frn.setAtt("bot_preload", "visible", "Y" );					}				}				else if(tip_ope==1){//Consulta					frn.set("operacion","CONSULTA");					botones_consulta();							}							var cmd, cubo, ok;							//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));						//Llenar combo tipo docto				LlenaCmbTipo();								tip_doc=1;				folio = "0000000";				especificaciones_doc =  gen_doc & nat_doc & gpo_doc & 0 & 0 & tip_doc & "-" & folio  ;								frn.set("k_docto",especificaciones_doc);							}						fun LlenaCmbTipo(){				var cubo,cmd,ok,mensajeError;				var sucursal_id=frn.get("k_sucn",-1,1);						//Llenar combo tipo docto				cmd = "select c4||'-'||c5,c1,c2,c3,c4 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and col_sucursal='" & sucursal_id & "'";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"inventsal.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_tipon",getXml(cubo));			}						fun CambiaSucursal(){				var sucursal_id;				sucursal_id = frn.get("k_sucn",-1,1);				LlenaCmbTipo();				TipoMov();						}							fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}						fun Producto(){ 				var cmd, cubo, ok,,mensajeError,valorRetorno, prod_original;				valorRetorno = frn.get("k_mov",-1,"k_parte");				cmd="select * from keplersc.prod_obtener_original('" & valorRetorno & "')";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.ValidaArticulo()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												prod_original = getXmlAtt(cubo,"r0","prod_obtener_original");				if (prod_original &= "0"){					mensajeError="El producto " & valorRetorno & " es reemplazo de otro producto el cual no existe como original.";					frn.message(mensajeError,"Error","&Aceptar");					frn.setX("","k_mov",-1,"k_parte");					frn.setX("","k_mov",-1,"k_q");					frn.setX("","k_mov",-1,"k_unidad");					frn.setX("","k_mov",-1,"k_precio");					frn.setX("","k_mov",-1,"k_monto");					frn.setX("","k_mov",-1,"k_control");					frn.setX("","k_mov",-1,"k_descr");					return;				}				//Obtener detalle de producto				rstXml(cubo);								valorRetorno = frn.get("k_mov",-1,"k_parte");						cmd = "select c19,c11,c2 from keplersc.kdini where c1='" & prod_original & "'";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"inventsal.Producto()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var resultado_len = nXml(cubo);								var suc = frn.get("k_sucn",-1,"c1");								if (resultado_len != 0){									var unidad =getXmlAtt(cubo,"r"&0,"c19");					var descripcion =getXmlAtt(cubo,"r"&0,"c2");									frn.setX(unidad ,"k_mov",-1,"k_unidad");					frn.setX(descripcion ,"k_mov",-1,"k_descr");									frn.setX(0,"k_mov",-1,"k_q");					frn.setX(0,"k_mov",-1,"k_monto");					frn.setX(prod_original,"k_mov",-1,"k_partesel");					precio_especifico(-1,suc,"DT");					//No se duplique el prod_original					refacc_duplicada();								}else {									frn.message("Parte no existe","Error","Aceptar");					frn.setX("","k_mov",-1,"k_parte");				}					}			//Valida refacciones duplicadas			fun refacc_duplicada(){					var renglon_id, renglones, articulo;				renglones = frn.N("k_mov")-1;				renglon_id = frn.getIdJ("k_mov");				articulo = frn.get("k_mov",-1,"k_parte");				for (var i=0; i<renglones; i++) {					if (renglon_id != i){						if ( (frn.get("k_mov",i,"k_parte") &= articulo)) { 							frn.setX("","k_mov",-1,"k_parte");							frn.setX("","k_mov",-1,"k_q");							frn.setX("","k_mov",-1,"k_unidad");							frn.setX("","k_mov",-1,"k_precio");							frn.setX("","k_mov",-1,"k_monto");							frn.setX("","k_mov",-1,"k_descr");							frn.setX("","k_mov",-1,"k_partesel");							frn.message("Verifique, esta intentado dar de alta la misma refaccion: "& articulo,"Error","Aceptar");							return;						}					}					}			}					fun Cantidad(){				var cmd,cubo,ok,producto_original;				var clave_producto= frn.get("k_mov", -1, "k_parte");					producto_original= frn.get("k_mov", -1, "k_partesel");				//Obtener clave del producto original				var cantidad= frn.get("k_mov", -1, "k_q");				var precio= frn.get("k_mov", -1, "k_precio");								var suc = frn.get("k_sucn", -1, 1);												if (entrada_salida &= "S"){									cmd = "select c5-c6 as disponibles from keplersc.kdinl where c1='" & suc & "' and  c2='" & producto_original & "'";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"inventsal.Cantidad()");									ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}									frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");															var inv_disponible  =getXmlAtt(cubo,"r"&0,"disponibles");										if (cantidad > inv_disponible ){											frn.message("No hay suficiente inventario","Error","Aceptar");						frn.setX(0 ,"k_mov", -1, "k_q");						frn.setX(0 ,"k_mov", -1, "k_monto");						return;										}													}								if (cantidad >= 0){									var importe =  precio*cantidad;					frn.setX(importe ,"k_mov",-1,"k_monto");				}								CalcTotalImporte();						}						fun CalcTotalImporte(){							monto_total = 0;				var x = frn.N("k_mov");						for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {					monto_total  += frn.get("k_mov", i, "k_monto");				}								//rutina iva				if (entrada_salida &= "E"){					/*					var importe_iva = monto_total * 0.16;					frn.set("k_iva", importe_iva );					monto_total += importe_iva ;					*/					frn.set("k_iva", 0);									}else {									frn.set("k_iva", 0);							}//fin rutina iva							frn.set("k_monto",monto_total);					}						fun Alta(){							var xmlRequest;				var resultado, mensaje, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd;				var no_partidas, prod_ui, prod_original;				var partidasValidas = 0;								var num_partes = frn.N("k_mov")-1;							for (var i=0;i<num_partes ;i++) {								if(frn.get("k_mov",i,"k_parte") &= "" ){						frn.message("Selecciona una refaccion","Error","Aceptar");						return;					}				}					if (num_partes==0){					frn.message("Selecciona una refaccion","Error","Aceptar");					return;				}								rstXml(xmlRequest);								xmlRequest = frn.dataPag();											fecha = sys.date();				hora= sys.time();				//cubo = "dat";				kdb.rst();				frn.rst("results");				frn.rst(xmlRequest );				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								xmlRequest = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				setXml(xmlRequest ,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlRequest ,"movimiento","fecha",strFecha);				setXml(xmlRequest ,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));				setXml(xmlRequest ,"k_mov","no_partidas",frn.N("k_mov")-1);			//	setXml(xmlRequest ,"ambiente","anio_contable",anio_contable);				setXml(xmlRequest ,"ambiente","uen",uen);				no_partidas=frn.N("k_mov") -1;				for(var i =0;i<no_partidas;i++){					prod_ui = getXml(xmlRequest,"k_mov","r" & i ,"k_parte");					prod_original = getXml(xmlRequest,"k_mov","r" & i ,"k_partesel");					setXml(xmlRequest,"k_mov","r" & i,"k_parte",prod_original);					setXml(xmlRequest,"k_mov","r" & i,"k_partesel",prod_ui);				}								frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest");						cmd="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"inventsal.Alta");								resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");								if(resultado &= "1"){					tip_ope = 1;										botones_consulta();						frn.set("k_folio",mensaje); 					frn.set("operacion","CONSULTA");										strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);					//ConfiguraCamposOpcion();					//Deshabilita_campos();										mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;					frn.message(mensaje, "Mensaje","&Aceptar");				}else{					frn.message(mensaje, "Error","&Aceptar");				}						}						fun Buscar_folio() {							BorraDatos();				var cmd, cubo,ok, xmlRequest,cuboProd,prod_original;				var mensaje = "Folio no encontrado" ;								var suc_id =  frn.get("k_sucn",-1,1);				folio = frn.get("k_folio");								TipoMov();										cmd = "select c8,c9,c10,c11,c12,c13,c28 from keplersc.kdm2 where c1='" & suc_id & "' and c2= '" & gen_doc & "' and c3= '" & nat_doc & "' and c4='" & gpo_doc & "' and c5= '" & tip_doc & "' and c6= '"  & folio & "'";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"inventsal.Folio()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var lenght_xml = nXml(cubo); 								if(lenght_xml != 0 ){									for (var i=0;i<lenght_xml;i++) {									var clave_prod =getXmlAtt(cubo,"r"&i,"c8");						var descripcion =getXmlAtt(cubo,"r"&i,"c10");						var cantidad=getXmlAtt(cubo,"r"&i,"c9");						var unidad =getXmlAtt(cubo,"r"&i,"c11");						var precio_unitario =getXmlAtt(cubo,"r"&i,"c12");						var importe_partida=getXmlAtt(cubo,"r"&i,"c13");						prod_original=getXmlAtt(cubo,"r"&i,"c28");											if(prod_original &="0" || prod_original &=""){								cmd="select * from keplersc.prod_obtener_original('" & clave_prod & "')";							cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"inventsal.Buscar_folio()");							prod_original = getXmlAtt(cuboProd,"r0","prod_obtener_original");						}						frn.setX(clave_prod ,"k_mov",i,"k_parte");						frn.setX(descripcion ,"k_mov",i,"k_descr");						frn.setX(cantidad,"k_mov",i,"k_q");						frn.setX(unidad ,"k_mov",i,"k_unidad");						frn.setX(precio_unitario ,"k_mov",i,"k_precio");						frn.setX(importe_partida,"k_mov",i,"k_monto");						frn.setX(prod_original,"k_mov",i,"k_partesel");					}										cmd = "select c9,c16,c24 from keplersc.kdm1 where c1='" & suc_id & "' and c2= '" & gen_doc & "' and c3= '" & nat_doc & "' and c4='" & gpo_doc & "' and c5= '" & tip_doc & "' and c6= '"  & folio & "'";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"inventsal.Folio()");									ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}									frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");									lenght_xml = nXml(cubo); 										if(lenght_xml != 0 ){											frn.set("k_fecha",getXmlAtt(cubo,"r"&0,"c9"));						frn.set("k_monto",getXmlAtt(cubo,"r"&0,"c16"));						frn.set("k_coment",getXmlAtt(cubo,"r"&0,"c24"));														}else {											frn.message(mensaje ,"Error","Aceptar");					}									}else  {									frn.message(mensaje ,"Error","Aceptar");								}										}									fun BorraDatos() {							frn.rst("k_mov");				frn.rst("k_monto");				frn.rst("k_coment");									}						fun Consulta(){//Imprime el reporte del documento especificado 				if(strlen(trim(frn.get("k_folio")))==0){ 					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");					frn.setPos("k_folio");return;					}				reporte();				frn.setPos("k_folio");			}									fun reporte(){							// Se define el formato a usar				var prefix=frn.lib("libKepler","langPrefix");				//var pageFto="\#092"&"k80_xsddesarrollo"&"\#092"&prefix&"comopecomprasfto"; //"\k80_xsddesarrollo\" & prefix & "comopecomprasfto"; //prefix&"comopecomprasfto";				//kdb.readPage("datos", pageFto);//se define el formato a usar								kdb.readPage("datos","inventsalfto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos")); 				rep.rst(); 				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				rep.set("titulo",frn.get("k_tipon"));				rep.exe("tit");					rep.set("rep_suc",frn.get("k_sucn"));				rep.set("rep_docto",frn.get("k_docto"));				rep.set("rep_fecha",frn.get("k_fecha"));				rep.set("rep_folio",frn.get("k_folio"));									rep.exe("encabezado");				rep.exe("partidas");				for(var i=0,n=frn.N("k_mov")-1;i<n;i++){					rep.set("rep_cantidad",frn.get("k_mov",i,"k_q"));					rep.set("rep_unidad",frn.get("k_mov",i,"k_unidad"));					rep.set("rep_clave",frn.get("k_mov",i,"k_parte"));					rep.set("rep_producto",frn.get("k_mov",i,"k_descr"));					rep.set("rep_precio",frn.get("k_mov",i,"k_precio"));					rep.set("rep_importe",frn.get("k_mov",i,"k_monto"));									rep.exe("partida");				}					rep.exe("lineaFinal");rep.exe("vacio");				rep.exe("partida2");				rep.exe("vacio");				rep.set("rep_comentario1",frn.getM("k_coment",0));				rep.set("rep_comentario2",frn.getM("k_coment",1));				rep.set("rep_comentario3",frn.getM("k_coment",2));				rep.set("rep_total",frn.get("k_monto"));				rep.exe("fin");				rep.exe("Comentarios");				rep.win(); 			}						fun TipoMov(){							tip_doc=frn.get("k_tipon",-1,4);						especificaciones_doc = gen_doc & nat_doc & gpo_doc & 0 & 0 & tip_doc & "-" & folio  ;				frn.set("k_docto",especificaciones_doc );				BorraDatos();			}									fun botones_consulta(){							frn.setAtt("foliotxt", "visible", "Y" );				frn.setAtt("k_folio", "visible", "Y" );				frn.setAtt("k_folio", "available", "Y" );				frn.setAtt("Imprimir", "visible", "Y" );				frn.setAtt("Aceptar", "visible", "N" );				frn.setAtt("Cancelar", "visible", "N" );				frn.setAtt("k_buscar_folio", "visible", "Y" );				frn.setAtt("k_fecha", "available", "N" );				frn.setAtt("k_mov", "available", "N" );							}						fun Monto(){							var cantidad= frn.get("k_mov", -1, "k_q");				var monto= frn.get("k_mov", -1, "k_monto");								if (cantidad != 0){					monto =  monto/cantidad;				}								frn.setX(monto ,"k_mov",-1,"k_precio");												}									fun precio_especifico(param, suc, precio){								var cmd, cubo, ok, xmlRequest;									setXml(xmlRequest,"document","sucursal_id",suc_usuario);				setXml(xmlRequest,"document","nombre_precio",precio);				setXml(xmlRequest,"document","producto",frn.get("k_mov", param, "k_partesel")); //Precio sobre refaccion original									cmd="select * from keplersc.invr_calc_precio_metodo_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";								cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"inventsal.precio_especifico()");					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");													var resultado=getXml(cubo,"resultado");											ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var lenght = nXml(cubo);								var precio_especifico = getXmlAtt(cubo,"r0" ,"precio");								frn.setX(precio_especifico ,"k_mov",param,"k_precio");							}			//Consulta productos			fun ConsultaProductos(){				var cmdQuery,suc,producto;				suc = frn.get("k_sucn",-1,1);				producto=frn.get("k_mov", -1, "k_parte");				cmdQuery="";				frn.dialog("prodlistafiltrosel","Refacciones",cmdQuery,"clave_actual","k_mov",-1,"k_parte","N","N",suc,producto,"Clave");			}						fun pre_cargar_partes(){				var cont, cmd, cubo, ok, xmlRequest;				var suc = frn.get("k_sucn",-1,"c1");								frn.rst("k_mov");				if (entrada_salida &= "E"){					cmd=-"select nl.c2 as k_parte, ini.c2 as k_descr, 0 as k_q, ini.c19 as k_unidad, (nl.c9-nl.c8) as k_precio, (nl.c9-nl.c8) as k_monto ";					cmd = cmd & "from keplersc.kdinl nl inner join keplersc.kdini ini on ini.c1=nl.c2 ";					cmd = cmd & "where nl.c1='" & suc & "' and nl.c5-nl.c6=0 and nl.c8-nl.c9<0";					}else{					cmd=-"select nl.c2 as k_parte, ini.c2 as k_descr, 0 as k_q, ini.c19 as k_unidad, (nl.c8-nl.c9) as k_precio, (nl.c8-nl.c9) as k_monto ";					cmd = cmd & "from keplersc.kdinl nl inner join keplersc.kdini ini on ini.c1=nl.c2 ";					cmd = cmd & "where nl.c1='" & suc & "' and nl.c5-nl.c6=0 and nl.c8-nl.c9>0";					}				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"inventsal.precio_especifico()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboInventarioCero");													ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_mov",cubo);								frn.set("k_coment","Ajuste costo de inventario en ceros");								CalcTotalImporte();			}				}	</script></pag>