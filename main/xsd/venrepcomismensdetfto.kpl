<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de " scale="48">	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,16" unfont="0">		<br exe="encabezado"/>		<!-- <hLine dim="90,0" g="2" type="1"/> en portrait cabe bien dim = 90 -->		<!-- <hLine dim="120,0" g="2" type="1"/> en landscape cabe bien dim = 120 -->		<hLine dim="181,0" g="2" type="1"/>		<br exe="encabezado"/>				<grp dim="15,5,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>				<grp dim="152,6,7,12">			<br/>			<inp id="nombreempresa" dim="205,1" fnt="20b,20b" type="string" modify="N" just="C" bclr="249,249,249"/>			<br/>			<inp id="titulorpt" dim="205,1" type="string" fnt=",19b" modify="N" just="C"/>			<br/>			<sp n="88"/>			<txt fnt=",16b">Mes </txt>			<sp n="2"/>			<inp id="mes" dim="3,1" type="string" fnt=",16b" modify="N" just="L" nc="-1"/>			<sp n="2"/>			<txt fnt=",16b">  /     A&#241;o </txt>			<sp n="2"/>			<inp id="anio" dim="3,1" type="string" fnt=",16b" modify="N" just="L" nc="-1"/>			<br exe="encabezado"/>		</grp>				<tab n="1"/>				<grp dim="15,5,7,12">			<tab n="1"/><txt>P&#225;g:</txt>			<sp/> <inp id="k_pag" dim="5,1" type="number" mcr="k_pag"/>			<br/><br/>			<sp n="1"/> <inp id="fecha" dim="12,1" type="date" fmt="DD-MM-CCYY" nc="-1" just="R"/>			<br/>			<sp n="6"/> <inp id="hora" dim="7,1" type="time" nc="-1" just="R"/>		</grp>		<br exe="encabezado"/>		<br exe="encabezado"/>				<hLine dim="181,0" g="2" type="1"/>			<br exe="encabezado"/>						<!-- <txt fnt=",15b"> Asesor </txt> <sp n="2"/> -->			<txt fnt=",15b"> Tipo </txt> <sp n="7"/>									<txt fnt=",15b">Inventario</txt> <sp n="5"/>			<txt fnt=",15b">A / B </txt> <sp n="3"/>			<txt fnt=",15b">Fecha</txt> <sp n="5"/> 			<txt fnt=",15b">Oper</txt> <sp n="3"/>			<txt fnt=",15b">Modelo</txt> <sp n="6"/>			<txt fnt=",15b">Linea</txt> <sp n="5"/> 			<txt fnt=",15b">Edad</txt> <sp n="6"/>									<txt fnt=",15b">    Utilidad</txt> <sp n="1"/>			<txt fnt=",15b">---------------------------------------------------------------------------------------------------------------         Comisiones         -------------------------------------------------------------------------------------------------------------------</txt> <sp n="1"/>						<br exe="encabezado"/>	  			<!-- <sp n="11"/> -->			<sp n="72"/>			<txt fnt=",15b">  Bruta </txt> <sp n="9"/>			<txt fnt=",15b"> Base</txt> <sp n="3"/>			<txt fnt=",15b"> Traslado</txt> <sp n="4"/> 			<txt fnt=",15b"> Edad</txt> <sp n="4"/>			<txt fnt=",15b"> Linea</txt> <sp n="3"/>				<txt fnt=",15b"> Gastos</txt> <sp n="2"/>			<txt fnt=",15b"> Seguro</txt> <sp n="4"/>			<txt fnt=",15b"> Extras</txt> <sp n="1"/>			<txt fnt=",15b"> Accesorios</txt> <sp n="3"/>						<txt fnt=",15b"> Semana</txt> <sp n="5"/>			<txt fnt=",15b"> Total</txt> <sp n="4"/>			<txt fnt=",15b"> TMKT</txt> <sp n="6"/>			<txt fnt=",15b"> Total</txt> 				<br exe="encabezado"/>		<hLine dim="181,0" g="2" type="1"/> 		<br exe="encabezado"/>		<!-- <br exe="encabezado"/>  -->						<!-- Esta seccion se usa como base para el desarrollo del FTO para el Detalle -->		<br exe="gp_vend"/>		<!-- <txt fnt=",16b" clr="20,0,96">Asesor : </txt> -->		<inp id="vend" dim="3,1" bclr="255,255,255" clrBrdr="255,255,255" type="string" modify="N" clr="20,0,96" fnt=",14"/>		<sp n="1"/>  		<inp id="descvend" dim="40,1" bclr="255,255,255" clrBrdr="255,255,255" type="string" modify="N" fnt=",14" clr="20,0,96"/>		<!-- <sp n="127"/> -->		<sp n="23"/>		<txt fnt=",14"> --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- </txt> 		<sp n="3"/>		<inp id="basevend" dim="8,1" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" fnt=",14" clr="143,21,13" just="R" nd="2"/> <!-- Este espacio sera mayor cuando se desarrolle el FTO para el Detalle -->		<br exe="gp_vend"/>		<br exe="gp_vend"/>		<!-- Esta seccion se usa como base para el desarrollo del FTO para el Detalle -->		<!-- <inp id="vend" dim="5,1" type="date" modify="N" fmt="CCYY/MM/DD" nc="-1" fnt=",14"/> -->		<inp id="tipo" dim="9,1" type="string" modify="N" nc="-1" fnt=",14"/> <sp n="1"/> 				<inp id="inventario" dim="10,1" type="string" modify="N" fnt=",14"/> <sp n="1"/>		<inp id="ab" dim="5,1" type="string" modify="N" fnt=",14"/> <sp n="1"/>		<inp id="fecha_det" dim="8,1" type="date"  modify="N" just="L" nc="-1" fnt=",14" fmt="DD/MM/CCYY"/> <sp n="1"/> 		<inp id="oper" dim="5,1" type="string" modify="N" fnt=",14"/> <sp n="1"/>		<inp id="modelo" dim="10,1" type="string" modify="N" fnt=",14"/> <sp n="1"/>		<inp id="linea" dim="7,1" type="string" modify="N" just="L" nd="2" fnt=",14"/> <sp n="1"/>		<inp id="edad" dim="4,1" type="number" modify="N" just="R" fnt=",14" nd="0"/> <sp n="2"/>								<inp id="utilidad" dim="10,1" type="number" modify="N" fnt=",14" nd="2" just="R"/> <sp n="1"/>		<inp id="c_base" dim="10,1" type="number" modify="N" fnt=",14" just="R" nd="2"/> <sp n="2"/>		<inp id="c_traslado" dim="7,1" type="number"  modify="N" just="R" nc="-1" fnt=",14" nd="2"/> <sp n="1"/> 		<inp id="c_edad" dim="7,1" type="number" modify="N" fnt=",14" just="R" nd="2"/> <sp n="1"/>		<inp id="c_linea" dim="7,1" type="number" modify="N" fnt=",14" just="R" nd="2"/> <sp n="1"/>		<inp id="c_gastos" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",14"/> <sp n="1"/>		<inp id="c_seguro" dim="7,1" type="number" modify="N" just="R" fnt=",14" nd="2"/> <sp n="1"/>		<inp id="c_extras" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",14"/> <sp n="1"/>		<inp id="c_accesorios" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",14"/> <sp n="1"/>		<inp id="c_semana" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",14"/> <sp n="1"/>		<inp id="c_subtotal" dim="8,1" type="number" modify="N" just="R" nd="2" fnt=",14"/> <sp n="1"/>		<inp id="c_tmkt" dim="7,1" type="number" modify="N" just="R" nd="2" fnt=",14"/> <sp n="1"/>		<inp id="c_total" dim="8,1" type="number" modify="N" just="R" nd="2" fnt=",14"/>		<br exe="detalle"/>							<!-- INI -- Totales x Vendedor -->		<br exe="totalvend"/> 		<hLine dim="181,0" g="1" type="1"/> 		<br exe="totalvend"/> 				<txt fnt=",14" clr="20,0,96">Total Asesor : </txt> 		<inp id="tp_descvend" dim="40,1" type="string" fnt=",14" clr="20,0,96"/>		<sp n="19"/>		<inp id="tp_utilidad" dim="10,1" type="number" fnt=",14" nd="2" clr="20,0,96" just="R"/> <sp n="1"/>		<inp id="tp_c_base" dim="10,1" type="number" fnt=",14" nd="2" clr="20,0,96" just="R"/> <sp n="2"/>		<inp id="tp_c_traslado" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>			<inp id="tp_c_edad" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="tp_c_linea" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="tp_c_gastos" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="tp_c_seguro" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="tp_c_extras" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="tp_c_accesorios" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="tp_c_semana" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="tp_c_subtotal" dim="8,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="tp_c_tmkt" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="tp_c_total" dim="8,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> 				<br exe="totalvend"/> 		<hLine dim="181,0" g="1" type="1"/>		<br exe="totalvend"/>		<!-- END -- Totales x Vendedor -->				<!-- INI -- Totales x Gran Total -->		<br exe="total"/>		<hLine dim="181,0" g="2" type="1"/> 		<br exe="total"/> 		<txt fnt=",15b" clr="20,0,96">Gran Total Comisiones : </txt>		<sp n="53"/>				<inp id="gt_utilidad" dim="10,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="gt_c_base" dim="10,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="2"/>		<inp id="gt_c_traslado" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>			<inp id="gt_c_edad" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="gt_c_linea" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="gt_c_gastos" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="gt_c_seguro" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="gt_c_extras" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="gt_c_accesorios" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="gt_c_semana" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="gt_c_subtotal" dim="8,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="gt_c_tmkt" dim="7,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> <sp n="1"/>		<inp id="gt_c_total" dim="8,1" type="number" fnt=",14" nd="2" clr="20,0,96"/> 				<br exe="total"/> 		<hLine dim="181,0" g="2" type="1"/> 		<br exe="total"/>		<!-- END -- Totales x Gran Total -->			</grp></pag>