<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Nota de Credito"><grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,10" bclr="192,205,213" unfont="0"	OnF1="Dialog(1,invEntSalAyu)" clrBrdr="0,97,181" tit=""><br/>	<tab/><txt clr="0,0,0" fnt=",22">Nota de Credito</txt><br/><tab/><hLine clr="0,0,0"/><br/><tab n="2"/>		<br/>		<tab/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="50,11,7,12" tit="Datos generales"  fnt="Arial,16"><tab/>		<txt clr="0,58,112" hk="S">Sucursal</txt><tab n="2"/>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="45,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y"/><br/><tab/>	   <txt clr="0,58,112">Tipo docto</txt><tab n="1"/>		<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255"  dim="30,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="TipoMov()" OnEnter="TipoMov()"/><br/>		<inp id="tipo_movto" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N" visible="N"/>						<br/><br/>						<tab/><txt id="factura_txt" visible="Y">Factura</txt>	<tab n="2"/>			<inp id="k_foliodocto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="10" available = "Y" tooltip="F9 Facturas" modify="Y" 		OnF9="BusquedaFactura()"  OnChange="Formar_folio_factura()" visible="Y"/><sp n="1"/>				<img id="buscar_factura" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_folio(Factura)" tooltip="Consultar factura" available="Y" clrBrdr="0,0,0"  modify="Y" visible="Y"/>		</grp><tab/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="44,12,7,12" tit="Documento" fnt="Arial,16">		<tab n="3"/><inp id="operacion" clr="64,64,64"  dim="18,1" brdr="0,1" fnt=",18bs" available="N" type="string"/><br/><tab/>		<txt id="foliotxt"  visible="N" hk="F" clr="0,58,112" fnt="Arial,16">Folio</txt><tab/>		<edt id="k_folio" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" visible="N" hk="F"  nc="10" OnF9="ObtenerFolio()" OnMouseL="ObtenerFolio()" OnChange="Formar_folio()" tooltip="Folio del movimiento ( F9 b&#250;squeda )"/><sp/>		<img id="k_buscar_folio" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_folio()" tooltip="Consultar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>		<br/><tab/>				<inp id="k_docto" clr="64,64,64"  dim="18,1" brdr="0,1" fnt="Arial,16" available="N" link="k_tipon,5" type="string"/><br/><tab/><txt clr="0,58,112" fnt="Arial,16">Fecha</txt><tab/>		<edt id="k_fecha" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" modify="N"/><br/><tab/> 		<inp id="statusdoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/>		</grp><br/><br/>	<tab/>		<grp id="grpDetalle" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5" dim="95,16,7,10" tit="Detalle"  fnt="Arial,16" available="Y" modify="N">			<grp dim="130,12,7,12" brdr="0,0" hSpace="4"><tab/>				<grp dim="39,11,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">					<sp/><txt clr="0,58,112" hk="P">Cliente :</txt><tab n="4"/>					<inp id="k_clave" clr="64,64,64" clrBrdr="255,255,255"   dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="10" available = "Y" modify="Y"/>					<br/><sp/>					<txt clr="0,58,112">Referencia :</txt><tab n="3"/>					<inp id="k_refer" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="10" available = "Y" modify="Y"/><tab n="5"/><sp/>					<br/><sp/>					<txt clr="0,58,112">Serie del Vehiculo :</txt>					<inp id="k_serievehiculo" clr="64,64,64" clrBrdr="255,255,255" nc="17" dim="20,1" bclr="255,255,255" brdr="2,0"   fnt="Arial,16"  type="capital"  available = "Y" modify="Y"/>					<br/>																	<cmb id="k_ivadesglosado" clr="64,64,64" clrBrdr="255,255,255" OnChange="CalcTotalImporte()" dim="15,5" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N" available="Y" modify="N" visible="N"/>				</grp><tab/>				<grp id="grpCliente" dim="135,9,7,12"  brdr="0,0" hSpace="4" available="Y" modify="Y">					<tab/>					<txt>RFC :</txt><tab n="2"/>					<inp id="k_rfc" clr="64,64,64"  dim="18,1" fnt="Arial,16" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" type="string" nc="16" modify="N" available="Y"/>					<br/>					<tab/>					<txt>Datos del Cliente :</txt>					<br/>					<tab/>					<inp id="k_datcve" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="70,5" fnt="Arial,16" type="string" modify="N" available="Y" nc="300"/>				</grp>			</grp>				<br/>			</grp>		<br/><br/>	<tab/>		<grp  bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="0" clrBrdr="0,58,112" dim="95,33,7,10" brdr="0,5"  fnt="Arial,16"><tab/><br/>	<tab n="1"/>	<tbl id="k_mov" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="130,7"  hk="z" OnChange="" Reorder="N" modify="N" available="Y">		<col id="k_parte" name="Art&#237;culo"  type="capital" nc="18"/>		<col id="k_descr" name="Descripci&#243;n" modify="N"/>		<col id="k_q" name="Cantidad"  type="number" nd="-1" min="0"/>		<col id="k_unidad" name="Unidad" modify="N" type="capital"/>		<col id="k_precio" name="Precio"  type="number"  nd="-1" visible="Y"/>		<col id="k_monto" name="Importe"  type="number" nd="2" min="0"/>		<col id="k_partesel" name="Ref. Original" type="capital" nc="18" modify="N"/>	</tbl><br/>			<grp dim="70,8,7,10" fnt="Arial,16" modify="N" hSpace="4"><tab n="1"/><txt clr="0,58,112">Plazo</txt><tab n="5"/>				<inp id="k_plazo" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nd="0" nc="4" min="0"  modify="Y" available="Y"/>				<br/><tab n="1"/><txt clr="0,58,112" fnt="Arial,16">Fecha de Pago</txt><tab n="2"/>				<edt id="k_vence" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date"  available="Y" modify="N"/><br/>							<tab n="1"/><txt clr="0,58,112">Condiciones</txt><tab n="3"/>				<inp id="k_cond" clr="64,64,64" clrBrdr="255,255,255"  dim="39,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="33" modify="Y" available="Y"/>				<br/>					</grp><tab n="5"/>		<grp dim="40,8,7,10" fnt="Arial,16" hSpace="4">				<txt>Subtotal</txt><tab n="2"/>				<inp id="subt" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" available="Y"/>				<br/>				<txt>IVA</txt><tab n="3"/>				<inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="6" modify="N" available="Y"/><br/><txt fnt=",16b">IMPORTE</txt><tab/>				<inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="Y"/>		</grp>				<br/>		<grp dim="72,15,7,10" modify="N"  fnt="Arial,16" hSpace="4"><tab/>				<txt clr="0,58,112">Metodo de Pago</txt><tab n="2"/>				<inp id="k_m_pago" clr="64,64,64" clrBrdr="255,255,255" nc="3" dim="10,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="text" OnChange=""  available="Y" modify="N"/>				<br/>				<tab/><txt clr="0,58,112">Forma de Pago</txt><tab n="2"/>					<cmb id="k_f_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="20,40" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N" available="Y" modify="Y"/>						<br/>				<tab/><txt clr="0,58,112">Cuenta</txt><tab n="4"/>				<inp id="k_cuenta" clr="64,64,64" clrBrdr="255,255,255" nc="50" dim="40,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="text" OnChange="" available="Y" modify="Y"/>				<br/>				<tab/><txt clr="0,58,112">Uso del CFDI</txt><tab n="3"/>				<inp id="k_cfdi" clr="64,64,64"  dim="15,1" fnt="Arial,16" nc="4"  brdr="2,0" type="text" OnChange="" modify="N" available="Y" clrBrdr="255,255,255" bclr="255,255,255"/>				<br/>				<tab/><txt clr="0,58,112">Correo Electronico</txt><tab/>				<inp id="k_correo" clr="64,64,64"  dim="50,1" fnt="Arial,16" type="text" brdr="2,0" OnChange="" modify="N" available="Y" clrBrdr="255,255,255" bclr="255,255,255"/>					</grp>				<sp/>		<grp dim="70,15,7,10" fnt="Arial,16" hSpace="4">			<txt clr="0,58,112">Comentarios</txt>			<br/>			<inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="60,3" bclr="255,255,255" brdr="2,0" fnt="Arial,16" nr="3,60" modify="N" type="string" available="Y"/>			<br/><tab n="13"/>			<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/><tab/>			<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Alta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><tab/>		</grp>		</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb, sys, rep, rol_usuario ;			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc, tip_ope, anio_contable,limite_credito ,usuario,suc_usuario, perfil_usuario,asterisco;			var especificaciones_doc ;			var monto_total,uen;			var folio;			var nat_doc_anex, gpo_doc_anex;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();				sys=new SYS;				rep=new REP;							suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				asterisco = "*";				rol_usuario = frn.config("user","role");								if(frn.param(0)&= "")				{					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}									gen_doc=trim(frn.param(0)); 				nat_doc=trim(frn.param(1)); 				gpo_doc=trim(frn.param(2));				tip_doc=1;				fija_doc=trim(frn.param(4));				tip_ope=trim(frn.param(5));				uen=trim(frn.param(6));				if (uen &= ""){					uen="XXX";				}				ctrls_off();				Inicializa();												nat_doc_anex = "D";				gpo_doc_anex= 22;			}					//-------------------------------------------------------------CONFIGURACIONES---------------------------------			fun Inicializa(){				kdb.kde("KDE");//												kdb.exec();				anio_contable = kdb.get("KDE","14");			//MSS----------------------				usuario = frn.config("user","name");			//-------------------------						var cmd, cubo, ok,resValidacion,resMensaje ;													frn.set("k_vence",sys.date());								frn.set("k_hora",sys.time());					frn.setX("S", "k_ivadesglosado",0,0);				frn.setX("N", "k_ivadesglosado",1,0);					//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));							var sucursal_id=frn.get("k_sucn",-1,1);						//Llenar combo tipo docto				LlenaCmbTipo();								tip_doc=1;				folio = "0000000";							especificaciones_doc =  gen_doc & nat_doc & gpo_doc & 0 & tip_doc & "-" & folio  ;								frn.set("k_docto",especificaciones_doc);											//Llenar combo forma de pago				cmd = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdf3fp";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_f_pago",getXml(cubo));							frn.set("k_fecha",sys.date());						}						fun LlenaCmbTipo(){				var cmd, cubo, ok,resMensaje,sucursal_id;				sucursal_id=frn.get("k_sucn",-1,1);				cmd = "select c5,c1,c2,c3,c4 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and col_sucursal='" & sucursal_id & "'";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_tipon",getXml(cubo));					}							fun CambiaSucursal() {				LlenaCmbTipo();				TipoMov();									}			fun ctrls_off() {				frn.setAtt("foliotxt", "visible", "N" );				frn.setAtt("k_folio", "visible", "N" );				frn.setAtt("k_buscar_folio", "visible", "N" );								frn.setAtt("factura_txt", "visible", "N" );				frn.setAtt("k_foliodocto", "visible", "N" );					frn.setAtt("buscar_factura", "visible", "N" );										frn.setAtt("Aceptar", "visible", "N" );				frn.setAtt("Cancelar", "visible", "N" );												if (tip_ope== 0){					botones_alta();								}else{					botones_consulta();				}					}				fun botones_alta(){							frn.set("operacion","ALTA");				frn.setAtt("Aceptar", "visible", "Y" );				frn.setAtt("Cancelar", "visible", "Y" );												frn.setAtt("factura_txt", "visible", "Y" );				frn.setAtt("k_foliodocto", "visible", "Y" );					frn.setAtt("buscar_factura", "visible", "Y" );													}						fun botones_consulta(){							frn.set("operacion","CONSULTA");				frn.setAtt("foliotxt", "visible", "Y" );				frn.setAtt("k_buscar_folio", "visible", "Y" );				frn.setAtt("k_folio", "visible", "Y" );							}																	fun BorraDatos() {				frn.rst("k_clave");				frn.rst("k_mov");				frn.set("k_ivadesglosado", "S");				frn.rst("k_monto");				frn.rst("k_datcve");				frn.rst("k_coment");				frn.rst("k_refer");				frn.rst("k_serievehiculo");				frn.set("k_fecha",sys.date());				frn.rst("k_rfc");				frn.set("k_vence",sys.date());				frn.rst("subt");				frn.rst("k_iva");				frn.rst("k_monto");				frn.set("k_plazo", 0);				frn.rst("k_cond");				frn.set("k_correo");				frn.rst("k_m_pago");				frn.rst("k_cfdi");				frn.rst("k_cuenta");						frn.set("k_f_pago", "[01] EFECTIVO");							}														//-----------------------------------------------------FACTURA--------------------------------------------------------------												fun BusquedaFactura()			{				  				var cmdQuery = "select c6 as folio, to_char(c9, 'dd/mm/yyyy') as fecha,c10 as cliente,c11 as referencia, c16 as monto from keplersc.kdm1  where c1 = '" & frn.get("k_sucn",-1,1) &  "' and c2 = '" & gen_doc&  "' and c3 = '" & nat_doc_anex &  "' and c4 = '" & gpo_doc_anex  &  "' and c5 = '" & frn.get("k_tipon",-1,4) &  "' ";				cmdQuery = cmdQuery & " order by c9 desc, c6 desc ";				frn.dialog("genlistafiltrosel","Facturas",cmdQuery,"folio","k_foliodocto","0","","S");					          			}									fun Formar_folio_factura(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_foliodocto"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",nat_doc_anex );				setXml(xmlReqEst,"document","k_tipon","r3",gpo_doc_anex  );				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								BorraDatos();								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_subsidio.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_foliodocto", fol);			}									//----------------------------------------ALTA----------------------------------------						fun Alta(){							var xmlRequest, resultado, mensaje, cubo, fecha, hora, strFecha, strTmp, cmd;				var no_partidas, prod_ui, prod_original;				var partidasValidas = 0;								var resultado_validaciones = Validaciones_pre_ejecucion();								if (resultado_validaciones == 0 ){					return;				}					xmlRequest = frn.dataPag();					fecha = sys.date();				hora= sys.time();				//cubo = "dat";				kdb.rst();				frn.rst("results");				frn.rst(xmlRequest );				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								xmlRequest = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				setXml(xmlRequest ,"movimiento","usuario",frn.lib("libKepler","UserInfo"));				setXml(xmlRequest ,"movimiento","fecha",strFecha);				setXml(xmlRequest ,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));				setXml(xmlRequest ,"k_mov","no_partidas",frn.N("k_mov")-1);				setXml(xmlRequest ,"ambiente","anio_contable",anio_contable);				setXml(xmlRequest,"k_var_sr","SR");								setXml(xmlRequest,"k_natdocto",nat_doc_anex );				setXml(xmlRequest,"k_gpodocto",gpo_doc_anex );				setXml(xmlRequest,"k_tipodocto",frn.get("k_tipon",-1,4));				setXml(xmlRequest,"k_foliodocto",frn.get("k_foliodocto"));								setXml(xmlRequest,"ambiente","uen",uen);				no_partidas=frn.N("k_mov") -1;				for(var i =0;i<no_partidas;i++){					prod_ui = getXml(xmlRequest,"k_mov","r" & i ,"k_parte");					prod_original = getXml(xmlRequest,"k_mov","r" & i ,"k_partesel");					setXml(xmlRequest,"k_mov","r" & i,"k_parte",prod_original);					setXml(xmlRequest,"k_mov","r" & i,"k_partesel",prod_ui);				}								frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequestfactdirectanotacredito ");								cmd="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"venfactdirecta.Alta");								resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");					if(resultado &= "1"){					tip_ope = 1;					ctrls_off();						frn.set("k_folio",mensaje); 										strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto",strTmp);					//ConfiguraCamposOpcion();					//Deshabilita_campos();										mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;					frn.message(mensaje, "Mensaje","&Aceptar");				}else{					frn.message(mensaje, "Error","&Aceptar");				}				}				   fun Validaciones_pre_ejecucion(){		   				var resultado, mensaje, cubo,fecha, hora, cmd;											var num_partes = frn.N("k_mov")-1;				if (frn.get("k_plazo")!=0){  					if (limite_credito < monto_total){						frn.message("El Cliente sobrepasa su limite de credito","Error","Aceptar");						return 0;					}				}								//Validar fecha				kdb.rst();				frn.rst("results");								fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));				cmd= "select * from keplersc.verify_year('" & fecha & "')";				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"venfactdirecta.Validaciones_pre_ejecucion()");							resultado= getXml(cubo,"validacion","resultado");				mensaje = getXml(cubo,"validacion","mensaje");				if(mensaje &! ""){					frn.message(mensaje,"Error al generar el documento","Aceptar");				}									if(resultado &= "0"){					frn.setPos("k_fecha");					return 0;				}										//Validar clave del cliente				if(strlen(trim(frn.get("k_clave")))==0){ 					frn.message("Es necesario especificar la clave del Cliente","Error","&Aceptar");					frn.setPos("k_clave");return 0;					}																//Validar Referencia				if(strlen(trim(frn.get("k_refer")))==""){ 					frn.message("Es necesario especificar Referencia","Error","&Aceptar");					frn.setPos("k_refer");return 0;					}				//Validar productos				for(var i =0;i<frn.N("k_mov");i++){					if(frn.get("k_mov",i,"k_parte")&!"" || frn.get("k_mov",i,"k_q")&!""){						if(frn.get("k_mov",i,"k_q")<=0 || strlen(frn.get("k_mov",i,"k_q"))==0){							frn.message("Se ha generado el siguiente error: producto con cantidad 0","Error al generar el documento","Aceptar");							frn.setPos("k_mov","ren:"&i);							return 0;						}						if(frn.get("k_mov",i,"k_parte")&=""){							frn.message("Se ha generado el siguiente error: clave de producto vacia","Error al generar el documento","Aceptar");							frn.setPos("k_mov","ren:"&i);							return 0;						}						if(frn.get("k_mov",i,"k_unidad")&=""){							frn.message("Se ha generado el siguiente error: unidad de producto vacia","Error al generar el documento","Aceptar");							frn.setPos("k_mov","ren:"&i);							return 0;						}						if(frn.get("k_mov",i,"k_precio")&="" || frn.get("k_mov",i,"k_precio")&="0"){							frn.message("Se ha generado el siguiente error: precio de producto cero","Error al generar el documento","Aceptar");							frn.setPos("k_mov","ren:"&i);							return 0;						}						}				}											if( frn.get("k_monto") <= 0 ){					frn.message("No se puede dar de alta el documento ya que el importe es cero","Error","&Aceptar");return 0;				}								return 1;			}									//---------------------------------------------CONSULTA-------------------------------------						fun ObtenerFolio() {					var cmdQuery = "select c6 as folio, to_char(c9, 'dd/mm/yyyy') as fecha, c10 as cve_cliente, " &						" c16 as monto, c43 estatus " &						"from keplersc.kdm1 " &						"where c1='" & frn.get("k_sucn",-1,1) & "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc						& " order by c9 desc, c6 desc ";							frn.dialog("genlistafiltrosel","Folios de Documentos",cmdQuery,"folio","k_folio","0","","S");					}						fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								BorraDatos();								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);		}											fun Buscar_folio(Origen) {				var cmd, cubo,ok, xmlRequest,cuboProd,prod_original;				BorraDatos();			 				var mensaje = "Folio no encontrado" ;								var suc_id =  frn.get("k_sucn",-1,1);							TipoMov();								var fol_bus, nat_bus, gpo_bus;				if (Origen &= "Factura"){									folio = frn.get("k_foliodocto");						nat_bus = nat_doc_anex;						gpo_bus = gpo_doc_anex;								}else{									folio = frn.get("k_folio");						nat_bus = nat_doc;					gpo_bus = gpo_doc;				}						cmd = "select c8,c9,c10,c11,c12,c13,c28 from keplersc.kdm2 where c1='" & suc_id & "' and c2= '" & gen_doc & "' and c3= '" & nat_bus & "' and c4='" & gpo_bus & "' and c5= '" & tip_doc & "' and c6 =upper('" & folio & "')";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Buscar_folio()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var lenght_xml = nXml(cubo); 								if(lenght_xml != 0 ){									for (var i=0;i<lenght_xml;i++) {									var clave_prod =getXmlAtt(cubo,"r"&i,"c8");						var descripcion =getXmlAtt(cubo,"r"&i,"c10");						var cantidad=getXmlAtt(cubo,"r"&i,"c9");						var unidad =getXmlAtt(cubo,"r"&i,"c11");						var precio_unitario =getXmlAtt(cubo,"r"&i,"c12");						var importe_partida=getXmlAtt(cubo,"r"&i,"c13");						prod_original=getXmlAtt(cubo,"r"&i,"c28");											if(prod_original &="0" || prod_original &=""){								cmd="select * from keplersc.prod_obtener_original('" & clave_prod & "')";							cuboProd = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta_notacredito.Buscar_folio()");							prod_original = getXmlAtt(cuboProd,"r0","prod_obtener_original");						}											frn.setX(clave_prod ,"k_mov",i,"k_parte");						frn.setX(descripcion ,"k_mov",i,"k_descr");						frn.setX(cantidad,"k_mov",i,"k_q");						frn.setX(unidad ,"k_mov",i,"k_unidad");						frn.setX(precio_unitario ,"k_mov",i,"k_precio");						frn.setX(importe_partida,"k_mov",i,"k_monto");						frn.setX(prod_original,"k_mov",i,"k_partesel");					}										var campos ="'['||kfp.c1||'] '||kfp.c2 as forma_pago,k1.c9,k1.c10,k1.c11,k1.c12,k1.c14,k1.c16,k1.c17,k1.c18,k1.c22,k1.c24,k1.c30,k1.c32,k1.c33,k1.c34,k1.c35,k1.c98,k1.c133,k1.c161,k1.c162,k1.c163,k1.c164,k1.c165"																																																							cmd = "select " & campos & " from keplersc.kdm1 as k1 inner join keplersc.kdf3fp as kfp on k1.c160=kfp.c1 where k1.c1='" & suc_id & "' and k1.c2= '" & gen_doc & "' and k1.c3= '" & nat_bus & "' and k1.c4='" & gpo_bus & "' and k1.c5= '" & tip_doc & "' and k1.c6=upper('" & folio & "')";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Buscar_folio()");									ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cubo,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}									frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");									lenght_xml = nXml(cubo); 										if(lenght_xml != 0 ){											if (Origen &! "Factura"){							frn.set("k_fecha",getXmlAtt(cubo,"r"&0,"c9"));							}																	frn.set("k_clave",getXmlAtt(cubo,"r"&0,"c10"));						frn.set("k_ivadesglosado",getXmlAtt(cubo,"r"&0,"c98"));											frn.set("k_rfc",getXmlAtt(cubo,"r"&0,"c22"));						frn.set("k_refer",getXmlAtt(cubo,"r"&0,"c11"));						frn.set("k_serievehiculo",getXmlAtt(cubo,"r"&0,"c133"));						frn.set("k_plazo",getXmlAtt(cubo,"r"&0,"c17"));						frn.set("k_vence",getXmlAtt(cubo,"r"&0,"c18"));						frn.set("k_cond",getXmlAtt(cubo,"r"&0,"c30"));												var IVA = getXmlAtt(cubo,"r"&0,"c14");												var MONTO = getXmlAtt(cubo,"r"&0,"c16");												frn.set("k_iva",IVA );						frn.set("subt",MONTO - IVA);												frn.set("k_monto",MONTO );												frn.set("k_coment",getXmlAtt(cubo,"r"&0,"c24"));																	var nombre = getXmlAtt(cubo,"r"&0,"c32");						var calle= getXmlAtt(cubo,"r"&0,"c33");						var colonia= getXmlAtt(cubo,"r"&0,"c34");						var poblacion= getXmlAtt(cubo,"r"&0,"c35");						var codigo_p= getXmlAtt(cubo,"r"&0,"c163");														frn.setM("k_datcve",nombre ,calle,colonia,poblacion,codigo_p);							frn.set("k_correo", getXmlAtt(cubo,"r"&0,"c165"));						frn.set("k_m_pago", getXmlAtt(cubo,"r"&0,"c162"));						frn.set("k_cfdi", getXmlAtt(cubo,"r"&0,"c164"));						frn.set("k_cuenta", getXmlAtt(cubo,"r"&0,"c161"));						frn.set("k_f_pago",getXmlAtt(cubo,"r"&0,"forma_pago"));																					}else {											frn.message(mensaje &".... m1" ,"Error","Aceptar");					}									}else  {					frn.message(mensaje&".... m2" ,"Error","Aceptar");								}		}												//-----------------------------------------------------EXTRAS---------------------------------------------------------------								fun Fecha(){//Verifica que la fecha del documento sea correcta. 				var cubo, cmd, resValidacion, resMensaje, fecha;				var validDate=frn.lib("libKepler","ValidOpDate",frn.get("k_fecha"));								fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));										if (tip_ope == 0 ){					cmd= "select * from keplersc.verify_year('" & fecha & "')";					cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"venfactdirecta.Fecha()");					resValidacion= getXml(cubo,"validacion","resultado");					resMensaje = getXml(cubo,"validacion","mensaje");					if(resMensaje &! ""){						frn.message(resMensaje, "Mensaje","&Aceptar");					}											if(resValidacion &= "0"){						frn.setPos("k_fecha");						return;					}									}			}																fun TipoMov(){							tip_doc=frn.get("k_tipon",-1,4);						especificaciones_doc = gen_doc & nat_doc & gpo_doc & 0 & tip_doc & "-" & folio ;				frn.set("k_docto",especificaciones_doc );								if (tip_ope == 0){					Valida_Tipo_Docto();								}								BorraDatos();			}												fun Valida_Tipo_Docto(){				var resValidacion, resMensaje, cubo, cmd, ok;							//Valida documento vigente				kdb.rst();				cmd= "select * from keplersc.verify_valid_document('" & frn.get("k_sucn",-1,1) & "','" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & frn.get("k_tipon",-1,4) & ")"; //suc text, genero text, naturaleza text, grupo integer, tipo_movto integer				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"venfactdirecta.Valida_Tipo_Docto()");				resValidacion= getXml(cubo,"validacion","resultado");				resMensaje = getXml(cubo,"validacion","mensaje");				if(resMensaje &! ""){					frn.message(resMensaje, "Mensaje","&Aceptar");					frn.setPos("k_tipon");				}										}													fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaciï¿½n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaciï¿½n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para pï¿½ginas de operacion:Solo si se estï¿½ en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverï¿½ el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}					}	</script></pag>