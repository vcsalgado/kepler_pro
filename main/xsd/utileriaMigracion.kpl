<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Migraci&#243;n de tablas a multibase de datos">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0">		<br/><sp/>				<grp dim="30,18,7,12" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="0" clrBrdr="0,58,112" brdr="1,5" fnt="Arial,16">			<sp/><txt fnt=",20b">Configuraci&#243;n:</txt><br/>			<sp/><txt fnt=",14">Datasource:</txt>					<cmb id="k_datasource" dim="30,1"  brdr="2,0" bclr="255,255,255" type="capital" clrBrdr="255,255,255" clr="64,64,64" fnt=",14"/>			<br/><sp/><txt fnt=",14">IP Srv.: </txt><inp id="k_ip" dim="12,1"  brdr="2,0" bclr="255,255,255" type="string" clrBrdr="255,255,255" clr="64,64,64" modify="N" available="N" fnt=",14"/><tab/><txt fnt=",14">Puerto K9-K75:</txt>			<inp id="k_port" dim="6,1" brdr="2,0" bclr="255,255,255" type="number" clrBrdr="255,255,255" clr="64,64,64" fmt="2" nc="8" modify="N" available="N" fnt=",14"/>				<br/><sp/><txt fnt=",14">Ruta DEF: </txt>			<inp id="k_ruta_def" dim="34,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",14"/>											<br/><sp/><txt fnt=",14">Ruta Datos:</txt><sp/>			<inp id="k_ruta_datos" dim="34,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",14"/>						<br/>			<hLine/>			<br/><sp/>			<txt fnt=",14">Guarda log</txt><sp/>			<chck id="k_log" dim="3,14" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" YN="10" 				tooltip="Guarda el log de las inserciones, este proceso hace mas lenta la tarea de guardado"/><txt fnt=",14">  Regs. X Pag.</txt>			<inp id="k_pagVale" dim="8,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" visible="1" modify="Y" nc="6" nd="0" min="1" max="1000" fnt=",14"/><txt fnt=",14"> Elim.Prev</txt>			<chck id="k_drop" dim="3,14" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" YN="10"/>			 <br/><sp/>			<bot id="k_updregs" dim="14,0" brdr="5" text="Act No. Reg BD" 				OnEnter="EjecutarActualizarRegs()" tooltip="Actualizar numero de registros de cada tabla en la bd" fnt=",14"/><tab/>			<bot id="k_MigraFol" dim="10,0" brdr="5" tooltip="Migra folios unicamente" OnEnter="EjecutaMigraFolio()" text="Migrar Folios" fnt=",14"/><tab/>			<bot id="k_ejecuta" dim="10,0" brdr="5" tooltip="Ejecutar" OnEnter="EjecutaMigracion()" text="Ejecutar" fnt=",14b"/>			<br/><hLine/>							<br/>						<sp/><txt fnt=",14">Tabla:</txt>			<inp id="k_tabla" dim="23,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" just="C" fnt=",14"/>			<br/>			<sp/><txt fnt=",14">Registros:</txt>			<inp id="k_regTotal" dim="12,1" bclr="236,243,240" clr="0,58,112" clrBrdr="255,255,255" type="string" just="L" modify="N" available="N" fnt=",14"/>			<inp id="k_min" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",14"/><txt>--</txt>			<inp id="k_max" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",14"/><br/>			<sp/><txt fnt=",14">Inicio:</txt>			<inp id="k_iniTime" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" fnt=",14" nc="-1" modify="N" available="N"/>			<sp/><txt fnt=",14">Fin:</txt>			<inp id="k_finTime" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" fnt=",14" nc="-1" modify="N" available="N"/>			<br/>			<sp/><txt fnt=",14">Total:</txt><tab/>			<inp id="k_totalTime" dim="26,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" fnt=",14" nc="-1" modify="N" available="N"/>						</grp>		<sp/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,kdbsql;			var kdbF,sys,maxReg; //kdbF= instancia de conexión a servidor remoto, maxReg=Numero de registros maximos a desplegar.			var xmlTablas,xmlProcesa;//xmlTablas = xml donde se almacena la infomración de todas las tablas del datasource, usada para mostrar en la pantalla. 											//xmlProcesa = xml que contiene las tablas a migrar incluyendo su estatus, registros y errores.			var kdbSys;//Instancia de conexión para KDB en el datasource de KEPLER 9 SYS, usado para la inserción de los datos sysTable, sysIndex y sysColumn			var xmlTablasParticion;			var rowIni,rowFin;			var sqlFlag;//Bandera para deteminar si se trata de un sistema que usa SQL			var grupo,rutaDef,rutaDatos,rutaBitacora;			var curTabla,aplica_filtro,filtro_k75,filtro_k80;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdbF=new KDB;				kdbSys=new KDB;				kdbsql = new KDB;				sys=new SYS;				kdb.connect();				//Datos de conexión base				frn.set("k_port","1803");				//frn.set("k_datasource","k75repositorio");				frn.set("k_ip","127.0.0.1");				maxReg = 500;//Numero de registros desplegados default				ConectaSys();				Conecta();				frn.set("k_pag",maxReg);				frn.set("k_all",1);				frn.set("k_log",0);				frn.set("k_iniTime","");				frn.set("k_current",1);				frn.set("k_drop",1);				//ConsultaDataSource();				frn.setAtt("k_atras","visible","N");				frn.setAtt("k_adelante","visible","Y");				frn.set("k_pagVale",1000);//Default de paginado				Inicializa();			}				fun EjecutarActualizarRegs(){				var expSql,reg,varRet,regOrigen,nTabla,cuboTablas,regTablas,tamDisco,cuboRegs,xmlDef, cuboDef;				var ip,port,datasource,registro,ok,cuboResultados,cuboTmp,cuboTabla, cuboDef, nDef,nomDef;				var strTmp,boolTmp;				//kdbsql ya esta instanciado u configurado desde ConectaSys								//Reset	a valores actuales				expSql="update keplersc_mig_core.mig_ctrl_tablas_proceso set proceso_id=0, registros_origen=0, ";				expSql=expSql & "estatus_proceso = 'P', inicio=null, fin=null, registros_migrados=0, tamano_disco=0, error_global='', seleccionada='S'";				kdbsql.native(expSql,"cuboResultados");				kdbsql.exec();				rstXml(cuboTabla);				cuboResultados=kdbsql.get("cuboResultados");												ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}																			kdb.file("dat,list,"&rutaDatos&"\\*.DAT");//Listar las tablas encontradas en la carpeta de datos				kdb.exec();				rstXml(cuboTablas);				cuboTablas	=	getXml(kdb.get("dat"));				reg = nXml(cuboTablas);				kdb.file("def,list,"&rutaDef&"\\*.DEF");//Listar las tablas encontradas en la carpeta de datos				kdb.exec();				rstXml(cuboDef);				cuboDef =getXml(kdb.get("def"));				nDef=nXml(cuboDef);//FileSave(cuboDef,"D:\Basura\cuboDef");											for(var i=0;i<reg;i++){					nTabla=getXml(cuboTablas,"r"&i,"");					nTabla=strSplit(nTabla,".",0);					if(nTabla &= "KDMODELOS"){						strTmp="1";					}					tamDisco=getXmlAtt(cuboTablas,"r"&i,"len");					//1. Validar que la tabla este en la tabla de control, si no existe se agrega					expSql="select count(*) from keplersc_mig_core.mig_ctrl_tablas_proceso where nombre_tabla='" & nTabla & "'";					kdbsql.native(expSql,"cuboResultados");					kdbsql.exec();					rstXml(cuboTabla);					cuboResultados=kdbsql.get("cuboResultados");													ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}										strTmp=getXmlAtt(cuboResultados,"r0","count");					if (strTmp==0){ //Si no existe, la agrega						expSql="insert into keplersc_mig_core.mig_ctrl_tablas_proceso (nombre_tabla,seleccionada,tabla_activa) values ('" & nTabla & "','N','N')";						kdbsql.native(expSql,"cuboResultados");						kdbsql.exec();											}					//FIN 1										//FileSave(cuboResultados,"D:\Basura\cuboResultados");										//Marca como iniciada en proceso					expSql="update keplersc_mig_core.mig_ctrl_tablas_proceso set proceso_id= " & i & ",estatus_proceso='E', inicio=CURRENT_TIMESTAMP where nombre_tabla='" & nTabla & "'";					kdbsql.native(expSql,"cuboResultados");					kdbsql.exec();					rstXml(cuboTabla);					cuboResultados=kdbsql.get("cuboResultados");													ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}									//Validar que la tabla tenga un def 					boolTmp=0;					strTmp = mid(nTabla,0,4);					if (strTmp &! "KDC1" && strTmp &! "KDC2" && strTmp &! "KDCN"){						strTmp = nTabla;					}					for(var contDef=0; contDef < nDef; contDef++){						nomDef=getXml(cuboDef,"r"&contDef);						nomDef=strSplit(nomDef,".",0);						if(nomDef &= strTmp){							boolTmp=1;							break;						}					}										if (boolTmp==0){						expSql="update keplersc_mig_core.mig_ctrl_tablas_proceso set tamano_disco= " & tamDisco & ",error_global='SIN DEF', seleccionada='N', fin=CURRENT_TIMESTAMP, estatus_proceso='T' where nombre_tabla='" & nTabla & "'";						kdbsql.native(expSql,"cuboResultados");						kdbsql.exec();						rstXml(cuboTabla);						cuboResultados=kdbsql.get("cuboResultados");																ok=getXmlAtt(cuboResultados,"ok");						if(ok &! "" && !ok){							var mensajeError = getXmlAtt(cuboResultados,"native3");							frn.message(mensajeError,"Error","Aceptar");							return;						}						continue;					}					//FIN de validacion DEF															frn.set("k_tabla",nTabla);												kdbF.open("c,"&nTabla);//Abre la tabla en el servidor remoto.						//Validar que la tabla exista en el esquema de la bd					expSql="select count(*) from information_schema.tables where table_schema = 'keplersc_mig' and upper(table_name)='" & nTabla & "'";					kdbsql.native(expSql,"cuboResultados");					kdbsql.exec();					rstXml(cuboTabla);					cuboResultados=kdbsql.get("cuboResultados");													ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}										strTmp=getXmlAtt(cuboResultados,"r0","count");					if (strTmp==0){ //Si no existe, la agrega						expSql="update keplersc_mig_core.mig_ctrl_tablas_proceso set error_global='SIN ESTRUCTURA', seleccionada='N', fin=CURRENT_TIMESTAMP, estatus_proceso='T' where nombre_tabla='" & nTabla & "'";						kdbsql.native(expSql,"cuboResultados");						kdbsql.exec();						rstXml(cuboTabla);						cuboResultados=kdbsql.get("cuboResultados");																ok=getXmlAtt(cuboResultados,"ok");						if(ok &! "" && !ok){							var mensajeError = getXmlAtt(cuboResultados,"native3");							frn.message(mensajeError,"Error","Aceptar");							return;						}//						continue;										}					//FIN Validacion	existe	en esquema													strTmp = mid(nTabla,0,4);					if (strTmp &= "KDC1" || strTmp &= "KDC2" || strTmp &= "KDCN"){						kdb.def("datDef",strTmp,"descr:Y");					}else{						kdb.def("datDef",nTabla,"descr:Y");					} 										kdb.sp("k_nreg","datNreg",nTabla,"cuentaReal:N");																					kdb.exec();										rstXml(xmlDef);					setXml(xmlDef,kdb.get("datDef"));//FileSave(xmlDef,"D:\Basura\xmlDef");										cuboTmp=kdb.get("datNreg");//FileSave(cuboTmp,"D:\Basura\datNreg");										regOrigen = kdb.get("datNreg");										frn.set("k_regTotal",regOrigen);										//Actualizar info en bd					expSql="update keplersc_mig_core.mig_ctrl_tablas_proceso set registros_origen=" & regOrigen & ", tamano_disco= "& tamDisco & ", fin=CURRENT_TIMESTAMP, estatus_proceso='T' where nombre_tabla='" & nTabla & "'";					kdbsql.native(expSql,"cuboResultados");					kdbsql.exec();					rstXml(cuboTabla);					cuboResultados=kdbsql.get("cuboResultados");										//FileSave(cuboResultados,"D:\Basura\cuboResultados");											ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}				};//				kdb.close();				frn.message("Proceso terminado","Mensaje","Aceptar");			}						 			fun ConectaSys(){				var ip,port,datasource;				kdbSys.connect();//Se establece una conexión nueva para estos datos				port = frn.get("k_port");//Obtener el puerto de pantalla				port = (port != 0)?port:1803;///Use an new connect				ip = frn.get("k_ip");				datasource = "SYS"; 				kdbSys.setKde(3,"\\KS9\\"&ip&"," & port & "\\"&datasource&"\\");				kdbSys.stmt("SELECT k_description,k_code FROM sysDataSource WHERE k_server != '' AND k_database  != '' AND k_schema != '' AND k_user  != '' AND k_password  != ''","datInsSys");//Validar que conexión opere correctamente.				kdbSys.exec();//var cuboTabla=kdbSys.get("datInsSys");//FileSave(cuboTabla,"D:\Basura\datInsSys");								if(kdbSys.get("datInsSys","ok") &= ""){					frn.message("Errror en la configuración de servidor KEPLER 9| Para migrar información sys.","Error","&Aceptar");					return;				}else{					frn.set("k_datasource",kdbSys.get("datInsSys"));				}								kdbsql.connect();//Se establece una conexión nueva para estos datos				port = frn.get("k_port");//Obtener el puerto de pantalla				port = (port != 0)?port:1803;///Use an new connect				ip = frn.get("k_ip");				kdbsql.setKde(3,"\\KS9\\"&ip&"," & port & "\\"& strFormat("ucase",frn.get("k_datasource",-1,1)) &"\\");							}			fun Conecta(){				var ip,port,datasource;				kdbF.connect();//Se establece una conexión con el servidor destino.				if(!kdbF.exec()){					frn.message("Contraseña erronea","Error","&Aceptar");					return;				}				port = frn.get("k_port");//Obtener el puerto de pantalla				port = (port != 0)?port:1803;				ip = frn.get("k_ip");				datasource = strFormat("ucase",frn.get("k_datasource",-1,1));//datasource de Kepler 9 para migrar.				if(datasource &= ""){					frn.message("No se especifico el datasource definido en KPLER 9 para realizar la migración","Error","&Aceptar");					return;				}				kdbF.setKde(3,"\\KS9\\"&ip&"," & port & "\\" & datasource & "\\");				kdbF.open("i,KDID");				kdbF.stmt("SELECT c1 FROM KDID","datConnect");//Validar que conexión opere correctamente.				kdbF.exec();				if(kdbF.get("datConnect","ok") &= ""){					frn.message("Errror en la configuración de servidor KEPLER 9| Validar contraseña y nombre del 'Datasource'.","Error","&Aceptar");					return;				}				}												fun Inicializa()			{				var k75path,manualPath,server_path;				rutaDef="D:\\KE\\K75 Server Migracion";				rutaDatos="D:\\KE\\DATOS 75\\INMOTIONPACHUCA";				rutaBitacora="D:\\KE\\Migracion Bitacora\\";				server_path = sys.path();				frn.set("k_ruta_def",rutaDef);								frn.set("k75pathDef",rutaDef);//Variable que se guarda para usar en migración de folios.											frn.set("k_ruta_datos",rutaDatos);												frn.set("k75path",rutaDatos);//Variable que se guarda para usar en migración de folios.								//Obtiene lista de archivos de definiciones				kdb.file("def,list,"&rutaDef&"\\*.DEF");//Listar las DEF de tablas encontradas en la carpeta de Server				kdb.exec();			}						fun EjecutaMigracion(){							var ip,port,datasource;				var expSql,cmd,cuboTabla,proceso_id,proceso_tmp,fecha,xmlProcesa;					kdb.rst();				//Inicia estado de proceso				frn.set("k_totalTime","Actualizando estatus de control...");								expSql="update keplersc_mig_core.mig_ctrl_tablas_proceso set proceso_id=0, inicio=null, fin=null, error_global='' ";				expSql=expSql & "where seleccionada = 'S' and estatus_proceso='P'";				kdbsql.native(expSql,"cuboResultados");				kdbsql.exec();				curTabla = "INICIAL";				while(curTabla &! ""){kdbsql.rst();						curTabla = "";					//Obtener siguiente tabla a migrar					fecha=sys.date() & " " &sys.time();					proceso_id=math("rand");					proceso_tmp=math("rand");					if(proceso_id > proceso_tmp){						proceso_id=proceso_id - proceso_tmp + math("rand");					}else{						proceso_id=proceso_tmp - proceso_id + math("rand");					}															frn.set("k_totalTime","Obteniendo tabla...");					expSql="update keplersc_mig_core.mig_ctrl_tablas_proceso ";							expSql=expSql & "set proceso_id=" & proceso_id & ", estatus_proceso ='E', inicio='" & fecha & "' ";					expSql=expSql & "where nombre_tabla = ";					expSql=expSql & "(select nombre_tabla from keplersc_mig_core.mig_ctrl_tablas_proceso ";					expSql=expSql & "where seleccionada= 'S' and registros_origen <> 0 and estatus_proceso ='P'";					expSql=expSql & "order by registros_origen limit 1)";					kdbsql.native(expSql,"cuboResultados");					kdbsql.exec();									expSql="select nombre_tabla from keplersc_mig_core.mig_ctrl_tablas_proceso ";					expSql=expSql & "where proceso_id=" & proceso_id & " and estatus_proceso ='E' and inicio=to_timestamp('" & fecha & "','yyyy/mm/dd HH24:MI:SS') ";					kdbsql.native(expSql,"cuboResultados");					kdbsql.exec();					rstXml(cuboTabla);					cuboTabla=kdbsql.get("cuboResultados");//FileSave(cuboTabla,"D:\Basura\cuboTabla");									if (nXml(cuboTabla) == 0  || getXmlAtt(cuboTabla,"r0","nombre_tabla") &="" ){						frn.set("k_totalTime","Proceso terminado");//						continue;					}															curTabla=getXmlAtt(cuboTabla,"r0","nombre_tabla");					aplica_filtro=getXmlAtt(cuboTabla,"r0","aplica_filtro");					filtro_k75=getXmlAtt(cuboTabla,"r0","filtro_k75");					filtro_k80=getXmlAtt(cuboTabla,"r0","filtro_k80");					frn.set("k_tabla",curTabla);										rstXml(xmlTablas);					frn.set("k_totalTime","Obteniendo def "&curTabla);										CrearTablaXml();					frn.set("k_totalTime","Creando xmlProcesa "&curTabla);										rstXml(xmlProcesa);					xmlProcesa = SeleccionaTablas();//Se revisa la tabla para detectar las tablas a procesar.//					FileSave(xmlProcesa,"D:\Basura\xmlProcesa_"&curTabla);													Execute();								}							}			fun CrearTablaXml(){				var tabla,tablaDef;				tabla=frn.get("k_tabla");				kdb.open("b,"&tabla);//Se le la tabla local con la información de las tablas.				tabla=frn.get("k_tabla");					tablaDef = kdb.get("def",tabla);								setXmlAtt(xmlTablas,tabla,"migrado","N");														var nReg = nXml(xmlTablas);				kdb.sp("k_nreg","datNreg"&tabla,tabla,"cuentaReal:N");									kdb.def("datDef"&tabla,tabla,"descr:Y");	//				kdb.table("datInddes,b,1,&,b1...b12");//Consultar los indices de las tablas				kdb.exec();//				var xmlTablaDes = frn.lib("FE33WS_Cancela","SetKDtoXml",kdb.get("datInddes"),"b1");//Se reordena en un XML para su uso mas eficiente.				var xmlDef;				var registro = kdb.get("datNreg"&tabla);//Numero de registros de la tabla						var indice;						rstXml(xmlDef);						setXml(xmlDef,kdb.get("datDef"&tabla));//Obtener el DEF de una tabla y se asigna en XML												//if(tabla == "KDINM")//VCSS						//{						//	FileSave(xmlDef,"D:\Basura\1_tableDef");						//}						var nCampos = nXmlAtt(xmlDef,"ind","r0");//Se usara solo el primer indice						if(nCampos == 0){							setXmlAtt(xmlTablas,tabla,"NoMigrableDef","1");//						}						for(var j=0;j<nCampos;j++){//Armar el inidice 1 de la tabla							indice = (strlen(indice)==0)?getXmlAtt(xmlDef,"ind","r0","c"&j):(indice & "," & getXmlAtt(xmlDef,"ind","r0","c"&j));						}						nCampos = nXml(xmlDef,"cmp");						for(var j=0;j<nCampos;j++){							var campo = getXmlX(xmlDef,"cmp",5,j);//campo							var tip = getXmlAtt(xmlDef,"cmp",campo,"ti");//Tipo de campo							var val = j+1;							setXml(xmlTablas,tabla,"campos",val,tip);							setXmlAtt(xmlTablas,tabla,"campos",val,"name",getXmlAtt(xmlDef,"cmp",campo,"mn"));//Agregar nombre del campo							setXmlAtt(xmlTablas,tabla,"campos",val,"ncar",getXmlAtt(xmlDef,"cmp",campo,"nc"));//Agregar numero de caracteres							setXmlAtt(xmlTablas,tabla,"campos",val,"nDecim",getXmlAtt(xmlDef,"cmp",campo,"nd"));//Agregar nombre del campo							setXmlAtt(xmlTablas,tabla,"campos",val,"tipo",tip);//Agregar tipo						}						setXmlAtt(xmlTablas,tabla,"indice",indice);//Indice 1 de la tabla (por lo regular el que asegura que un registro es unico)//						setXmlAtt(xmlTablas,tabla,"desc",getXmlAtt(xmlTablaDes,tabla,"b2"));//Descripción de la tabla, para ser usado en la tabla						setXmlAtt(xmlTablas,tabla,"desc",tabla);//Descripción de la tabla, para ser usado en la tabla												setXmlAtt(xmlTablas,tabla,"nCampos",nXml(xmlDef,"cmp"));//Numero de campos de la tabla						setXmlAtt(xmlTablas,tabla,"nRegistros",registro);//Numero de registros de la tabla						nCampos = nXml(xmlDef,"ind");						var r,val,ncols,col;						for(var j=0;j<nCampos;j++){							r = "r"&j;							ncols = nXmlAtt(xmlDef,"ind",r);							for(var k=0;k<ncols;k++){								col = "c"&k;								val = getXmlAtt(xmlDef,"ind",r,col);								setXmlAtt(xmlTablas,tabla,"ind",r,col,"c" & val);							}						}					//}else{//En caso de no tener información se ignora					//	continue;					//}//if registros//				}//Recorres registros								rowIni = 0;				var totales = math("ceil",(nXml(xmlTablas)/maxReg));				frn.set("k_totales",totales);//FileSave(xmlTablas,"D:\Basura\xmlTablas");							}			fun Execute() {				var log = frn.get("k_log");//Bandera de log				var textXml,nRegForaneo,regs,cuboResultados;				rstXml(textXml);				frn.set("k_iniTime","");//Limpiamos los valores de tiempo				frn.set("k_finTime","");				frn.set("k_totalTime","");				frn.set("k_iniTime",sys.date() & " " & sys.time());				//frn.set("k_fechaIni",sys.date());					var nRegXmlTablas = nXml(xmlProcesa);				var fileName, iniciarTabla;				var tabla;														for(var i=0;i<nRegXmlTablas;i++){//Se recorren las tablas seleccionadas para determinar el tipo de migración que se usará					tabla = getXmlX(xmlProcesa,5,i);					fileName = "D:\KE\Migracion Bitacora\Migracion_" & tabla & frn.get("k_iniTime") & ".txt";					iniciarTabla=frn.get("k_drop");					if(iniciarTabla==1){//En caso que el usuario lo indique, eliminar los registros previos.						kdbsql.native("TRUNCATE TABLE keplersc_mig."& tabla ,"datDel");						kdbsql.exec();						cuboResultados=kdbsql.get("datDel");//FileSave(cuboResultados,"D:\Basura\cuboTruncate");																var ok=getXmlAtt(cuboResultados,"ok");						if(ok &! "" && !ok){							var mensajeError = getXmlAtt(cuboResultados,"native3");							frn.message(mensajeError,"Error","Aceptar");							FileSave(mensajeError,fileName);														return;						}											}										//En caso de ser KDC1 o 2 no procesar directamente					if(getXmlAtt(xmlTablasParticion,tabla,"P")){continue;}//Estas tablas directamente no tinen datos.(o no deberian)					var nCampos = getXmlAtt(xmlProcesa,tabla,"nCampos");					var indice = getXmlAtt(xmlProcesa,tabla,"indice");					regs =  getXmlAtt(xmlProcesa,tabla,"nRegistros");					//Llevar el control de la tabla a procesar					if(log){						setXmlAtt(textXml,tabla,"Estatus","Iniciado");						setXmlAtt(textXml,tabla,"RegistrosOrigen",regs);						setXmlAtt(textXml,tabla,"TiempoInicio",sys.time());						setXmlAtt(textXml,tabla,"FechaInicio",sys.date());						FileSave(textXml,fileName);					}					frn.set("k_tabla",tabla);					if(getXmlAtt(xmlProcesa,tabla,"ok")){						MigracionKDB(tabla,nCampos,indice,regs);					}					nRegForaneo = getXmlAtt(xmlProcesa,tabla,"regsForaneo");					if(log){//Guarda el archivo de log para llevar el control de las tablas procesadas						setXmlAtt(textXml,tabla,"Estatus","Completado");						setXmlAtt(textXml,tabla,"RegistrosDestino",nRegForaneo);						setXmlAtt(textXml,tabla,"TiempoFin",sys.time());						setXmlAtt(textXml,tabla,"FechaFin",sys.date());						setXmlAtt(textXml,tabla,"TiempoNecesario",Tiempo(getXmlAtt(textXml,tabla,"TiempoInicio"),getXmlAtt(textXml,tabla,"FechaInicio")));						FileSave(textXml,fileName);					}				}//Fin FOR								var xmlErrors;				rstXml(xmlErrors);				var cnt;				var nombre,valor,regErr,i,j,k,regLoop;				var loop,insertNumber,error;				for(i=0;i<nRegXmlTablas;i++){					tabla = getXmlX(xmlProcesa,5,i);					if(getXmlAtt(xmlTablasParticion,tabla,"P")){continue;}					cnt = 0;					var ok = getXmlAtt(xmlProcesa,tabla,"ok");//Valida si la tabla tiene errores de insersión					if(!ok){//En caso de error						var nAtts = nXmlAtt(xmlProcesa,tabla);//Numero de atributos						for(j=0;j<nAtts;j++){							/*nombre = getXmlX(xmlProcesa,tabla,8,j);							valor = getXmlAtt(xmlProcesa,tabla,nombre);*/							setXmlAtt(xmlErrors,tabla,"desc",getXmlAtt(xmlProcesa,tabla,"desc"));							setXmlAtt(xmlErrors,tabla,"nRegistros",getXmlAtt(xmlProcesa,tabla,"nRegistros"));							setXmlAtt(xmlErrors,tabla,"regsForaneo",getXmlAtt(xmlProcesa,tabla,"regsForaneo"));							setXmlAtt(xmlErrors,tabla,"regsForaneo",getXmlAtt(xmlProcesa,tabla,"regsForaneo"));							setXmlAtt(xmlErrors,tabla,"Error",getXmlAtt(xmlProcesa,tabla,"Error"));						}						regErr = nXml(xmlProcesa,tabla,"Error");						for(j=0;j<regErr;j++){							loop = getXmlX(xmlProcesa,tabla,"Error",5,j);							regLoop = nXml(xmlProcesa,tabla,"Error",loop);							for(k=0;k<regLoop;k++){								insertNumber = getXmlX(xmlProcesa,tabla,"Error",loop,5,k);								setXmlAtt(xmlErrors,tabla,"Errores",cnt,"Error",getXmlAtt(xmlProcesa,tabla,"Error",loop,insertNumber,"Error"));								setXmlAtt(xmlErrors,tabla,"Errores",cnt,"Insert",getXmlAtt(xmlProcesa,tabla,"Error",loop,insertNumber,"Insert"));								cnt++;							}						}					}				}				frn.set("k_finTime",sys.date & " " & sys.time());//Hora de fin				frn.set("k_totalTime",Tiempo(frn.get("k_iniTime"),frn.get("k_fechaIni")));//Hora de fin								//Actualizar estado del proceso en la BD				var expSql="update keplersc_mig_core.mig_ctrl_tablas_proceso "; 				expSql=expSql & "set estatus_proceso='T', fin='" & frn.get("k_finTime") &  "',registros_origen=" & regs& ", registros_migrados=" & nRegForaneo & " ";				expSql=expSql & "where nombre_tabla='" & tabla & "'";				kdbsql.native(expSql,"cuboResultados");				kdbsql.exec();																					//Guardar errores				var nReg = nXml(xmlErrors);//Si se procesaron errores se deben mostrar				var cmpFile=sys.date() & "_" & sys.time();				if(nReg > 0){					FileSave(xmlErrors,rutaBitacora & frn.get("k_tabla") & "_" & cmpFile & "_Errores"); //VCSS				}							}						fun SeleccionaTablas(){//Recorre los valores de la tabla para procesar la migración				var tabla;				var reg = 1;				var varRet;				rstXml(varRet);				//for(var i=0;i<reg;i++){					tabla = frn.get("k_tabla"); 					if (tabla &! ""){						if(getXmlAtt(xmlTablas,tabla,"NoMigrableDef")==1){							continue;						}						setXmlAtt(varRet,tabla,"procesar","1");						setXmlAtt(varRet,tabla,"indice",getXmlAtt(xmlTablas,tabla,"indice"));						setXmlAtt(varRet,tabla,"desc",getXmlAtt(xmlTablas,tabla,"desc"));						setXmlAtt(varRet,tabla,"nCampos",getXmlAtt(xmlTablas,tabla,"nCampos"));						setXmlAtt(varRet,tabla,"nRegistros",getXmlAtt(xmlTablas,tabla,"nRegistros"));						setXmlAtt(varRet,tabla,"renglonTabla",1);//Guardar el numero de renglon que corresponde para poder enviar los registros migrados.						setXmlAtt(varRet,tabla,"ok",1);						var campos = nXml(xmlTablas,tabla,"campos");						for(var j=0;j<campos;j++){							var campo = getXmlX(xmlTablas,tabla,"campos",5,j);							setXml(varRet,tabla,"campos",campo,getXml(xmlTablas,tabla,"campos",campo));						}					}//				}				return varRet;//Regresa el valor del 			}						fun GetFileName(){//Funcion para nombre de archivo de log, importante, si se usan multiples pantallas en una migración				var time,date,user,pag;				time =frn.get("k_iniTime");				time = strSplit(time,":",0) & "_" & strSplit(time,":",1) & "_" & strSplit(time,":",2);				date = frn.get("k_fechaIni");				date = strSplit(date,"/",0) & "_" & strSplit(date,"/",1) & "_" & strSplit(date,"/",2);				user = frn.get("k_usuario");				pag = frn.get("k_current");				var name = "migracion" & "_" & time & "_" & date & "_" & ((user &= "")?"USUARIO":user) & "_" & pag;				return name;			}						fun FileSave(xmlVar,FileName){//Lectura/escritura				var documentXml = getXmlStr(xmlVar,"EOF:13_10");				kdb.save("_"&FileName&".txt",documentXml);			}						fun MigraDef(tabla){				kdbF.open("c,"&tabla);//Abre la tabla en el servidor remoto.				kdbF.rst("datSelectDef");				kdbF.stmt("SELECT count(*) as c1 FROM " & tabla &" LIMIT 1","datSelectDef");				if(frn.get("k_drop")){//En caso que el usuario lo indique, eliminar los registros previos.					kdbF.stmt("DELETE FROM "& tabla &" WHERE 1=1","datDel");				}				kdbF.exec();				var XmlTmp ;				XmlTmp = kdbF.get("datSelectDef");//FileSave(XmlTmp,"D:\Basura\datSelectDef");				setXmlAtt(xmlProcesa,tabla,"ok",1);/*				if(kdbF.get("datSelectDef","ok")){					setXmlAtt(xmlProcesa,tabla,"ok",1);				}else{//Error en la creaciónn de la tabla					setXmlAtt(xmlProcesa,tabla,"ok",0);					setXmlAtt(xmlProcesa,tabla,"ErrorN",kdbF.get("datSelectDef","native3"));					setXmlAtt(xmlProcesa,tabla,"ErrorCode",kdbF.get("datSelectDef","native2"));					setXmlAtt(xmlProcesa,tabla,"ErrorCodeK",kdbF.get("datSelectDef","A001"));					WriteLog(kdbF.get("datSelectDef","native3")); //VCSS				}*/			}									fun Tiempo(iniTime,iniDate){				var finTime = sys.time();				var finDate = sys.date();				var horaIni,minIni,secIni;				var horaFin,minFin,secFin;				horaIni = strSplit(iniTime ,":",0) * 3600;//Volver segundos				minIni = strSplit(iniTime ,":",1) * 60;//segundos por minuto				secIni = strSplit(iniTime ,":",2);				horaFin = strSplit(finTime,":",0) * 3600;//Volver segundos				minFin = strSplit(finTime,":",1) * 60;//segundos por minuto				secFin = strSplit(finTime,":",2);				iniTime = horaIni+minIni+secIni;//Segundos totales hora inicio				finTime = horaFin + minFin + secFin;//Segundos totales hora fin				var segXDia = 86399;//segundos por día				var difDia = fnDate("dif",finDate,iniDate);//				var total,dias,hora,minuto,segundo;				if(difDia == 0){//Mismo día resta diretca					total = finTime - iniTime;				}else{//Diferente día, calcular el numero de dias * segundos por dia - el tiempo del primer dia (dia de inicio) + el tiempo del dia final 					total = ((difDia * segXDia) - iniTime) + finTime;				}				dias = math("int",(total/segXDia));				total = math("abs",(total - (dias * segXDia)));				hora = math("int",(total/3600));				total = math("abs",(total - (hora * 3600)));				minuto = math("int",(total/60));				total = math("abs",(total - (minuto * 60)));				segundo = total;				return "DD "&dias &" HH: "& hora &" MM: "& minuto &" SS: "& segundo;			}										fun MigraFolios(){				if(sqlFlag){					/*kdb.query("datFolio","SELECT c1,c4 FROM SqlIov");					kdb.exec();					var val;					nReg = kdb.N("datFolio");					for(var i=0;i<nReg;i++){						val = kdb.get("datFolio","r"&i,"c1");//query inicia en c0						if(val != 0){							setXmlAtt(xmlFolios,kdb.get("datFolio","r"&i,"c0"),"Folio","Y");						}					}*/					return;//SQL migra la tabla y el def, lo obtiene de SQL por lo que no es necesario procesarlo				}else{					var path = frn.get("k75path");					kdb.file("dat,list,"&path&"\\*.*");//Listar las tablas encontradas en la carpeta de datos					kdb.exec();					var nReg = kdb.N("dat");					var xmlFolios;					for(var i=0;i<nReg;i++){						var file = kdb.get("dat","r"&i,);						var typeFile = strSplit(file,".",1);						if (((typeFile &! "DAT")&&(typeFile &! "SRT"))){							setXmlAtt(xmlFolios,file,"Folio","Y");						}					}					nReg = nXml(xmlFolios);					var string,archivo,folio,ext;					for(var i=0;i<nReg;i++){						archivo = getXmlX(xmlFolios,5,i);						ext = strSplit(archivo,".",1);						if(strlen(ext)>0){							string = "GET,"&archivo&",a1,$,datFolio"&i;							setXmlAtt(xmlFolios,archivo,"FolioFile","1");						}else{							string = "GET,"&archivo&",a1...a127,$,datFile"&i;	//127 es el numero maximo que se puede usar en un archivo iov							setXmlAtt(xmlFolios,archivo,"FolioFile","0");						}						kdb.iov(string);					}					kdb.exec();					for(var i=0;i<nReg;i++){						archivo = getXmlX(xmlFolios,5,i);						if(getXmlAtt(xmlFolios,archivo,"FolioFile")){							folio = kdb.get("datFolio"&i,"a1");							if(folio &! "" || folio != 0){								string = "PUT,"&archivo&","&folio;								kdbF.iov(string);							}						}else{							var dato,prefijo;							var bandera=0,;							var XmlfolioTemp;							var val=0;							var nReg1 = kdb.N("datFile"&i);							for(var j=0;j<nReg1;j++){								dato = kdb.get("datFile"&i,"a"&(j+1));								if(dato &! ""){									setXmlAtt(XmlfolioTemp,"r"&bandera,"campo",dato);									setXmlAtt(XmlfolioTemp,"r"&bandera,"nCampo",j+1);									setXmlAtt(XmlfolioTemp,"r"&bandera,"nCmpIgnore",val);									val = "";									bandera++;								}else{val++;}							}							nReg1 = nXml(XmlfolioTemp);							var tempData;							for(var j=0;j<nReg1;j++){								bandera = getXmlAtt(XmlfolioTemp,"r"&j,"nCmpIgnore");								val = getXmlAtt(XmlfolioTemp,"r"&j,"campo");								prefijo = (j==0)?"":",";								if(bandera > 0){									for(var k=0;k<bandera;k++){										tempData = tempData & ",";									}								}else{tempData = "";}								dato = dato & prefijo & tempData &  val;								tempData = "";							}							dato = trim(dato);							string = "PUT,"&archivo&","	&	dato;							kdbF.iov(string);						}					}					kdbF.exec();				}//else tipo de BD			}//funcion								fun MigracionKDB(tabla,nCampos,indice,regs){				frn.set("k_regTotal",regs);				var xmlInsert,strValor;				var parentesisAbre = "1(1";//Parentesis por código				parentesisAbre = mid(parentesisAbre,1,1);				var parentesisCierra = "1)1";//Parentesis por código				parentesisCierra = mid(parentesisCierra,1,1);				var nCamposLlave = strSplit(indice,",",-1);				var xmlCampos;rstXml(xmlCampos);//Generar Xml de campos llave				var cnt = 0, filtro;//Contador generico				for(var j=0;j<nCamposLlave;j++){//Generar los datos de el select y order de los campos llave					var campo = strSplit(indice,",",j);					setXmlAtt(xmlCampos,campo,"Llave","1");//Se establece este campo como campo llave				}				var regXLoop = frn.get("k_pagVale");//Registros por vuelta.				var actualMin= 0;//Registro primero actual.				var acutualMax = actualMin+ regXLoop;//Set de valores iniciales				//variable usadas en la paginación				var loop = 0;				//Variables que se ocupan dentro del ciclo, se ponen afuera para evitar crear y destruitlas en cada ciclo.				var cubo = "dat"&tabla&"-";//Cubo base para select				var cuboWrite = cubo;//Cubo base para write				var insertValuesXml,insertCamposXml;//Variables XMl que contendrán los campos y valores del armado del insert				var insertXml,XmlResult;				var xmlCamposTabla = getXml(xmlProcesa,tabla,"campos");				var i,j,r;//Contadores usados en los ciclos				var Base,reg,prefijo,table;				var val,tipoDato;//Variable que almacena cada valor de cada tabla,variable que toma el tipo de dato que se esta consultando				var cuboLoop,cuboWriteLoop,insertBase;				setXml(insertValuesXml,cnt,",c,1,&,c1...c");cnt++;				setXml(insertValuesXml,cnt,nCampos);cnt++;				setXml(insertValuesXml,cnt,",&,max,"&regXLoop);				table= catXml(insertValuesXml);				kdb.open("c,"&tabla);//Nos aseguramos que la tabla este abierta.				var nReg,string;//Cpontador para registros de KDB.				var tempBorrar;				var logStr = ""; //VCSS//Obtener total de registros a procesar aplicando filtros//FileSave(cuboLoop,"D:\Basura\cuboLoop");				//				regs= kdb.N(cuboLoop);//				rstXml(cuboLoop);//				frn.set("k_regTotal",regs);				var contLoop=0;				while(actualMin < regs){					contLoop=contLoop+1;//frn.set("k_totalTime","Ciclo: " & contLoop);									cuboLoop = cubo&loop;//Nombre completo de cubo en select y write					cuboWriteLoop = cuboWrite&loop&"-";					frn.set("k_min",actualMin);//Se mandan los valores actuales que se estan procesando					frn.set("k_max",acutualMax);					string = cuboLoop&table;					//if(loop != 0){string = string & "," & (actualMin+1);}//					filtro="c9 >= 2023-01-01";//					kdb.lim(filtro);					if(loop != 0){						string = string & "," & actualMin;					}					kdb.table(string);									kdb.exec();					nReg = kdb.N(cuboLoop);					WriteLog(getXmlStr("dat"&tabla&"-")); //VCSS					insertBase = "INSERT INTO " & tabla & parentesisAbre;					rstXml(xmlInsert);					for(i=0;i<nReg;i++){						rstXml(insertValuesXml);						rstXml(insertCamposXml);						cnt=0;//Preparamos variable para crear write						r = "r"&i;						reg = kdb.get(cuboLoop,r);						for(j=1;j<=nCampos;j++){							val = getXmlAtt(reg,"c"&j);							tipoDato = getXml(xmlCamposTabla,(j));//dejar como variable fija?							if((getXmlAtt(xmlCampos,j,"Llave"))||((strlen(val)>0) && (val &! "   /  /    ") && (val &! " ") && (tipoDato != 2 || val != 0))){								if(tipoDato == 3){									val = GetDateFormat(val);									if(val &= ""){										val = "90/01/01";										val = GetDateFormat(val);									} //VCSS								}								prefijo=""; if(nXml(insertCamposXml)>0)prefijo=",";								setXml(insertCamposXml,cnt,prefijo& "c"&j);//El select inicia en c0								setXml(insertValuesXml,cnt,prefijo& "'"&val&"'");//valor del campo.								cnt++;							}//if valida						}//ciclo campos						if(nXml(insertCamposXml)==0)continue; //No debe haber un registro totalmente en blanco.						cnt = 0;						insertCamposXml = catXml(insertCamposXml);//variable con todos los campos a insertar						insertValuesXml = catXml(insertValuesXml);//Variable con los valores a insertart						rstXml(insertXml);//variable para armar el insert						setXml(insertXml,cnt,insertBase);cnt++;//Insert into tabla 						setXml(insertXml,cnt,insertCamposXml);cnt++;// ("campos"						setXml(insertXml,cnt,parentesisCierra);cnt++;//	) carater de cierre						setXml(insertXml,cnt," VALUES ");cnt++;// Values						setXml(insertXml,cnt,parentesisAbre);cnt++; //(						setXml(insertXml,cnt,insertValuesXml);cnt++;// valores 						setXml(insertXml,cnt,parentesisCierra);cnt++;// ) carater de cierre						Base = catXml(insertXml);// String de Insert						kdbF.stmt(Base,cuboWriteLoop&i);						setXml(xmlInsert,"r"&i,Base);					}//ciclo renglones					kdbF.exec(); 					for(i=0;i<nReg;i++){						reg = kdbF.get(cuboWriteLoop&i);												setXml(tempBorrar,i,getXmlStr(kdbF.get(cuboWriteLoop&i)));						if((getXmlAtt(reg,"ok") != 1) || (getXmlAtt(reg,"err") &! "")){//Error							r = getXmlAtt(reg,"native3");							if (r &! ""){								setXmlAtt(XmlResult,loop,i,"Error",strSplit(r,";",0));							}else if(getXmlAtt(reg,"mssg") &! ""){								setXmlAtt(XmlResult,loop,i,"Error",strSplit(getXmlAtt(reg,"mssg"),";",0));							}else{								setXmlAtt(XmlResult,loop,i,"Error","Error de inserción");							}							setXmlAtt(XmlResult,loop,i,"Insert",getXml(xmlInsert,"r"&i));							logStr = r; //VCSS							WriteLog(logStr); //VCSS						}					}					kdb.rst(); 					kdbF.rst();//Resetear todos los cubos usados.					//Enviar al siguiente query					actualMin= acutualMax;					acutualMax = ((actualMin + regXLoop)>regs)?regs:(actualMin + regXLoop);					loop++;				}//loop				kdbF.sp("k_nreg","datNreg"&tabla,tabla); 				kdbF.exec();				var regsDestino = kdbF.get("datNreg"&tabla);				if(regsDestino != regs){					setXmlAtt(xmlProcesa,tabla,"ok",0);					setXmlAtt(xmlProcesa,tabla,"Error","Hay menos registros de los correctos en el destino");					setXml(xmlProcesa,tabla,"Error",getXml(XmlResult));				}else{					cnt = nXml(XmlResult);//Si tiene un hijo, entro en error en algun loop					if(cnt==0){						setXmlAtt(xmlProcesa,tabla,"ok",1);//Por lo que de no tener hijos todos los registros se insertaron correctamente.					}else{						setXmlAtt(xmlProcesa,tabla,"ok",0);						setXml(xmlProcesa,tabla,"Error",getXml(XmlResult));						setXmlAtt(xmlProcesa,tabla,"Error","Hay inserts que regresaron errores");					}				}				setXmlAtt(xmlProcesa,tabla,"regsForaneo",regsDestino);			}									fun GetDateFormat(val){				var dateTem = strSplit(val,"/");				if (val &= "  /  /  " || val &= "  /  /    "){return "";}				else{					if(sqlFlag){						return getXml(dateTem,"r2") & "-" & getXml(dateTem,"r1") & "-" & getXml(dateTem,"r0");					}else{						return getXml(dateTem,"r0") & "-" & getXml(dateTem,"r1") & "-" & getXml(dateTem,"r2");					}				}			}									fun EjecutaMigraFolio(){				if(!kdbF.exec()){//En caso no tener la conexión al servidor remoto, se intenta reconectar					//Conecta();					if(!kdbF.exec()){						frn.message("No se ha logrado la conexión al servidor destino","Error","&Aceptar");						return;					}				}				MigraFolios();				frn.message("Proceso de migración de folios completada","Exito","&Ok");			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;					else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if(frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if(frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if(frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}					//VCSS Escribir a log de proceso			fun WriteLog(texto){//Anteponer "_" para indicar ruta local (m?quina cliente). De otra forma guarda en el servidor 				if (texto &= ""){					return;				}								var datXml;				setXml(datXml,"r0",delScpScn(texto));				var cmd="datFile,write,'D:\Basura\Error.log',append";				kdb.file(cmd,datXml);				kdb.exec(); 			}							fun WriteLog_bak(texto,FileName){//Lectura/escritura				//db.save("_"&FileName&".txt",getXmlStr(xmlVar,"EOF:13_10"));			}		}	</script></pag>