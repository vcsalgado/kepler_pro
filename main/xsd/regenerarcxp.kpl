<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<tab/><txt fnt=",22" clr="0,0,0">Generar CxCP</txt><br/>		<tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp dim="140,49,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="8" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Criterio de selecci&#243;n">			<tab/><txt>Sucursal:</txt><sp n="2"/><tab/><cmb id="cmb_sucursal" dim="50,36" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y" OnChange="resetCampos()"/>			<br/><tab/>			<txt>Tipo CXCP:</txt><sp n="2"/><cmb id="cmb_tipoCxCP" dim="8,36" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y" OnChange="Cambia_tipoCxCP()"/><tab n="2"/><txt>Documento: Gen.</txt>			<inp id="k_gen" dim="3,1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" 				OnChange="resetCampos()" nc="1" modify="N"/><txt>  Nat.:</txt>			<inp id="k_nat" dim="3,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" 				OnChange="resetCampos()" nc="1" modify="N"/>			<txt>  Gpo.: </txt>			<inp id="k_gpo" dim="3,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" fmt="5" 				OnChange="resetCampos()" nd="0" nc="3" just="R" max="100" min="0"/><txt>    Tipo:</txt>			<inp id="k_tipo" dim="3,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nc="3" 				OnChange="resetCampos()" fmt="5" just="R" max="999" min="0" nd="0"/><tab n="2"/><br/><tab/><txt>Fecha inicial: </txt>			<edt id="edt_fecha_ini" dim="14,1" brdr="0,5" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" fmt="DD/MM/CCYY" fnt="Arial,16" page="_ks_fecha,edt_fecha_ini"/>			<tab n="2"/><txt>Fecha final: </txt>			<edt id="edt_fecha_fin" dim="14,1" brdr="0,5" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" fmt="DD/MM/CCYY" fnt="Arial,16" page="_ks_fecha,edt_fecha_fin"/><tab n="2"/>			<img id="bot_buscar" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			<br/><br/>						<tab/><tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="194,20">				<col id="sel_reg" name="S/N" OnMouseD="SoN(sel_reg)" modify="N"/>				<col id="k_sucn" name="Suc"/>				<col id="genero" name="Gen"/>				<col id="naturaleza" name="Nat"/>				<col id="grupo" name="Gpo" type="number"/>				<col id="tipo" name="Tipo" type="number"/>				<col id="movto" name="Movimiento"/>				<col id="folio" name="Folio"/>				<col id="fecha" name="Fecha" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="factura" name="Factura"/>				<col id="importe" name="Importe" type="number"/>				<col id="iva" name="Iva" type="number"/>					<col id="vence" name="Vencimiento" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="cteprov" name="Cte-Prov"/>				<col id="nat_anx" name="Nat"/>				<col id="gpo_anx" name="Gpo" type="number"/>				<col id="tipo_anx" name="Tipo" type="number"/>				<col id="folio_anx" name="Folio Anx"/>				<col id="estatus" name="Estatus"/>								<col id="diferencias" name="Revision CxCP"/>			</tbl> 			<br/><br/><tab/><bot id="bot_sel" dim="12,0" brdr="5" text="Sel. Todos" OnEnter="SeleccTodos()" tooltip="Seleccionar todos los registros"/>			<sp/><bot id="bot_des" dim="12,0" brdr="5" text="Des. Todos" OnEnter="DeseleccTodos()" tooltip="Deseleccionar todos los registros"/>			<tab n="2"/><txt>Registros seleccionados:</txt><sp/>			<inp id="inp_registros_sel" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" just="R" modify="N" available="N" tooltip="No. contactos seleccionados"/>			<sp/><tab n="2"/><bot id="bot_generar" dim="12,0" brdr="5" text="Generar" OnEnter="Ejecuta()" tooltip="Genera CxCP de registros seleccionados" visible="Y"/>			<br/><br/>			<tab n="63"/>			<img id="Exportar" dim="40,40" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(k_mov)" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y" tooltip="Guardar tabla"/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys,rol_usuario,suc_usuario,usuario,asterisco;			var cmdQuery, cuboQuery, ok, mensajeError, fileSavePath, continua, xmlRequest,cuboResultados;			fun Main() {				frn=new FRNT;				kdb=new KDB;				sys=new SYS;				kdb.connect();				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				usuario = frn.config("user","name");				asterisco = "*";				fileSavePath = "C:\Basura";				Inicializa();			}			fun Inicializa(){//Inicializa los valores en Pantalla				frn.set("edt_fecha_ini",sys.date(sys.date("year"),sys.date("month"),1));				frn.set("edt_fecha_fin",sys.date(sys.date("year"),sys.date("month"),31));				IniCombos();				frn.setAtt("k_gen","modify", "N");				frn.setAtt("k_nat","modify", "N");			}						fun resetCampos(){				frn.rst("k_mov");				frn.set("inp_registros_sel",0);			}									fun IniCombos(){				var xmlResQuery, strTmp;				cuboQuery="datDoc";											//Llenar combo sucursales				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";					}				}								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("cmb_sucursal",getXml(cuboQuery));								//Llenar combo tipo CxCP				frn.setX("UD","cmb_tipoCxCP",0,0);				frn.setX("UD","cmb_tipoCxCP",0,1);				frn.setX("UA","cmb_tipoCxCP",1,0);				frn.setX("UA","cmb_tipoCxCP",1,1);				frn.setX("X","cmb_tipoCxCP",2,0);				frn.setX("X","cmb_tipoCxCP",2,1);								frn.set("k_gen",mid(frn.get("cmb_tipoCxCP",-1,1),0,1));				frn.set("k_nat",mid(frn.get("cmb_tipoCxCP",-1,1),1,1));			}			fun Buscar(){							var tipoCxCP; 								var sucursal_id = frn.get("cmb_sucursal",-1,1);								tipoCxCP = frn.get("cmb_tipoCxCP",-1,1);				frn.setAtt("bot_generar","visible", "Y");					if (tipoCxCP &= "UD"){					cmdQuery = "select 'N' as sel_reg, m1.c1 as sucursal, m1.c2 as gen, m1.c3 as nat, m1.c4 as grupo, m1.c5 as tipo, mm.c5, m1.c6 as folio, m1.c9 as fecha, m1.c11 as factura, m1.c16 as importe, m1.c14 as iva, m1.c18 as vencimiento,							m1.c10 as clave_cteprov, m1.c36 as nat_anx, m1.c37 as gpo_anx, m1.c38 as tipo_anx, m1.c39 as folio_anx, '' as estatus,							m1.tipo_relacion, m1.motivo_cancelacion									from keplersc.kdm1 m1							inner join keplersc.kdmm mm on mm.col_sucursal=m1.c1 and  mm.c1=m1.c2 and mm.c2=m1.c3 and mm.c3=m1.c4 and mm.c4=m1.c5							where m1.c1='" & sucursal_id & "' and m1.c2='" & frn.get("k_gen") & "' and m1.c3='" & frn.get("k_nat") & "' and mm.c7 = 'S' and mm.c47 <> 'S' and m1.c43 <> 'C'							--and (select count(*) from keplersc.kduxg xg where xg.c1=m1.c1 and xg.c2=m1.c2 and xg.c3=m1.c10 and xg.c4=m1.c6 /*folio_operacion*/) = 0							and (select count(*) from keplersc.kduxe xe where xe.c1=m1.c1 and xe.c2=m1.c10 and xe.c5=m1.c2 and xe.c6=m1.c3 and xe.c7=m1.c4 and xe.c8=m1.c5 and xe.c9=m1.c6 /*folio_operacion*/) = 0							and (select count(*) from keplersc.kdm1 m1b where m1b.c1=m1.c1 and m1b.c2=m1.c2 and m1b.c36=m1.c3 and m1b.c37=m1.c4 and m1b.c38=m1.c5 and m1b.c39=m1.c6) = 0							and m1.c9 >= '" & frn.get("edt_fecha_ini") & " 00:00:00" & "' and m1.c9<='" & frn.get("edt_fecha_fin") & " 23:59:59' ";				}								if (tipoCxCP &= "UA"){					cmdQuery = "select 'N' as sel_reg, m1.c1 as sucursal, m1.c2 as gen, m1.c3 as nat, m1.c4 as grupo, m1.c5 as tipo, mm.c5, m1.c6 as folio, m1.c9 as fecha, m1.c11 as factura, m1.c16 as importe, m1.c14 as iva, m1.c18 as vencimiento,							m1.c10 as clave_cteprov, m1.c36 as nat_anx, m1.c37 as gpo_anx, m1.c38 as tipo_anx, m1.c39 as folio_anx, '' as estatus,							m1.tipo_relacion, m1.motivo_cancelacion									from keplersc.kdm1 m1							inner join keplersc.kdmm mm on mm.col_sucursal=m1.c1 and  mm.c1=m1.c2 and mm.c2=m1.c3 and mm.c3=m1.c4 and mm.c4=m1.c5							where m1.c1='" & sucursal_id & "' and m1.c2='" & frn.get("k_gen") & "' and m1.c3='" & frn.get("k_nat") & "' and mm.c7 = 'S' and mm.c47 <> 'S' and m1.c43 <> 'C'							--and (select count(*) from keplersc.kduxg xg where xg.c1=m1.c1 and xg.c2=m1.c2 and xg.c3=m1.c10 and xg.c4=m1.c39 /*folio_docto_anx*/) = 0							and (select count(*) from keplersc.kduxe xe where xe.c1=m1.c1 and xe.c2=m1.c10 and xe.c5=m1.c2 and xe.c6=m1.c3 and xe.c7=m1.c4 and xe.c8=m1.c5 and xe.c9=m1.c6 /*folio_operacion*/) = 0							and (select count(*) from keplersc.kdm1 m1b where m1b.c1=m1.c1 and m1b.c2=m1.c2 and m1b.c36=m1.c3 and m1b.c37=m1.c4 and m1b.c38=m1.c5 and m1b.c39=m1.c6) = 0							and m1.c9 >= '" & frn.get("edt_fecha_ini") & " 00:00:00" & "' and m1.c9<='" & frn.get("edt_fecha_fin") & " 23:59:59' ";				}								if (tipoCxCP &= "X"){					cmdQuery = "select 'N' as sel_reg, m1.c1 as sucursal, m1.c2 as gen, m1.c3 as nat, m1.c4 as grupo, m1.c5 as tipo, mm.c5, m1.c6 as folio, m1.c9 as fecha, m1.c11 as factura, m1.c16 as importe, m1.c14 as iva, m1.c18 as vencimiento,							m1.c10 as clave_cteprov, m1.c36 as nat_anx, m1.c37 as gpo_anx, m1.c38 as tipo_anx, m1.c39 as folio_anx, '' as estatus,							m1.tipo_relacion, m1.motivo_cancelacion							from keplersc.kdm1 m1							inner join keplersc.kdmm mm on mm.col_sucursal=m1.c1 and  mm.c1=m1.c2 and mm.c2=m1.c3 and mm.c3=m1.c4 and mm.c4=m1.c5							where m1.c1='" & sucursal_id & "' and m1.c2='" & frn.get("k_gen") & "' and mm.c7 = 'S' and mm.c47 <> 'S' and m1.c43 <> 'C'							--and (select count(*) from keplersc.kduxg xg where xg.c1=m1.c1 and xg.c2=m1.c2 and xg.c4=m1.c11 /*referencia*/) = 0							and (select count(*) from keplersc.kduxe xe where xe.c1=m1.c1 and xe.c2=m1.c10 and xe.c5=m1.c2 and xe.c6=m1.c3 and xe.c7=m1.c4 and xe.c8=m1.c5 and xe.c9=m1.c6 /*folio_operacion*/) = 0							and (select count(*) from keplersc.kdm1 m1b where m1b.c1=m1.c1 and m1b.c2=m1.c2 and m1b.c36=m1.c3 and m1b.c37=m1.c4 and m1b.c38=m1.c5 and m1b.c39=m1.c6) = 0							and m1.c9 >= '" & frn.get("edt_fecha_ini") & " 00:00:00" & "' and m1.c9<='" & frn.get("edt_fecha_fin") & " 23:59:59' ";					if (frn.get("k_nat") &! ""){						cmdQuery=cmdQuery	& "and m1.c3='" & frn.get("k_nat") & "' ";					}						}									if (frn.get("k_gpo") != "0"){					cmdQuery=cmdQuery	& "and m1.c4=" & frn.get("k_gpo") & " ";				}				if (frn.get("k_tipo") != "0"){					cmdQuery=cmdQuery	& "and m1.c5=" & frn.get("k_tipo") & " ";				}									cmdQuery=cmdQuery	& "order by m1.c9 desc";												frn.lib("libGeneral.kpl","FileSave",cmdQuery ,"C:\Basura\cmdBuscarCxCP");									rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"Regenerarcxp.Buscar()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery,"c:\Basura\cuboBuscarCxCP");										ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}					if (nXml(cuboQuery) > 0){					frn.set("k_mov",cuboQuery);				}else{					frn.message("No existen registros","Atencion","Aceptar");				}			}									fun guardar_tabla(tabla){				var save = frn.saveFile("tabla","Todos los archivos,*.csv","_C:","Para guardar archivo");				frn.dialog("guarda_tabla",tabla,save); 			}						fun Cambia_tipoCxCP(){				frn.set("k_gen","");				frn.set("k_nat","");				frn.set("k_gpo","0");				frn.set("k_tipo","0");								frn.set("k_gen",mid(frn.get("cmb_tipoCxCP",-1,1),0,1));				frn.set("k_nat",mid(frn.get("cmb_tipoCxCP",-1,1),1,1));								if (mid(frn.get("cmb_tipoCxCP",-1,1),0,1) &="X"){						frn.setAtt("k_nat","modify", "Y");				}else{					frn.setAtt("k_nat","modify", "N");					}				resetCampos();			}						fun SoN(campo) {/*				var gn,nt,gp;				gn = frn.get("k_mov",-1,"genero");				nt = frn.get("k_mov",-1,"naturaleza");				gp = frn.get("k_mov",-1,"grupo");*/				if (frn.get("k_mov",-1,campo) &= "S"){					frn.setX("N","k_mov",-1,campo);            } else {/*					if (gn&nt&gp &= "UD19" || gn&nt&gp &= "UD63" || gn&nt&gp &= "UD81"){						frn.message("Este tipo de movimiento se debe generar de forma manual la cxcp|Solicite apoyo al area de sistemas","Atencion","Aceptar");					}else{*/											frn.setX("S","k_mov",-1,campo);//					}            }				CuentaSel("k_mov","sel_reg","inp_registros_sel");         }                  fun CuentaSel(tabla,campo,actualiza){				var renglones, cuentaS, cuentaN;				cuentaS=0;				cuentaN=0;				renglones = frn.N(tabla);				for (var i=0; i<renglones; i++) {					if (frn.get(tabla,i,campo) &="S"){						cuentaS = cuentaS + 1;					}					if (frn.get(tabla,i,campo) &="N"){						cuentaN = cuentaN + 1;					}									}				frn.set(actualiza,cuentaS);							}  			fun SeleccTodos(){				var renglones,cuenta,gn,nt,gp,movtos_manuales;				movtos_manuales = 0;				renglones = frn.N("k_mov");				for (var i=0; i<renglones-1; i++) {/*									gn = frn.get("k_mov",i,"genero");					nt = frn.get("k_mov",i,"naturaleza");					gp = frn.get("k_mov",i,"grupo");					if (gn&nt&gp &= "UD19" || gn&nt&gp &= "UD63" || gn&nt&gp &= "UD81"){						movtos_manuales = 1;					}else{*/											frn.setX("S","k_mov",i,"sel_reg");						cuenta = cuenta + 1;					//					}				}				frn.set("inp_registros_sel",cuenta);/*								if (movtos_manuales ==1){					frn.message("Los movtos UD19,UD63 y UD81 se debe generar de forma manual la cxcp|Solicite apoyo al area de sistemas","Atencion","Aceptar");				}*/							}			fun DeseleccTodos(){				var renglones, cuenta;				renglones = frn.N("k_mov");				for (var i=0; i<renglones-1; i++) {					frn.setX("N","k_mov",i,"sel_reg");				}				frn.set("inp_registros_sel",0);			}									fun Ejecuta(){				var xmlPantalla,resultado,mensaje,folio,adicionales,contErr,nCampos,separacion,renglones;				var strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua, str_folio, str_error, str_diferencias, msg_diferencias;				msg_diferencias = 0;				fecha = sys.date();				hora= sys.time();				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;				continua = frn.message("¿Desea continuar con la generacion de las CxCP?","Atención",2);				if (continua == 0){					return;				}							xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;								setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov"));				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaGeneraCxcp");				cmdQuery="SELECT * FROM keplersc.cxcp_genera_cuenta('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"regenerarcxp.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoGeneraCxcp");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");				adicionales = getXml(cuboQuery,"adicionales");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {									if (frn.get("inp_registros_sel") &! mensaje){						strMsg = "Se generaron " & mensaje & " CxCP,| Hubo errores, revisar la columna **Estatus** ";					} else {						strMsg = "Se generaron " & mensaje & " CxCP ";					}									renglones = frn.N("k_mov");						for (var i=0; i<renglones; i++) {							if (frn.get("k_mov",i,"sel_reg") &= "S"){								nCampos = strSplit(adicionales,"~",-1);								//folio-error o estatus~folio-error o estatus~folio-error o estatus~								if (nCampos > 1) {																		for (contErr=0; contErr<nCampos ; contErr++){										separacion = strSplit(adicionales,"~",contErr);										if (strlen(separacion)>0){											str_folio = strSplit(separacion,"-",0);			//Folio											str_folio = trim(frn.lib("libGeneral.kpl","StrReplace",str_folio,"~",""));											str_error = strSplit(separacion,"-",1);			//Error o estatus											str_diferencias = strSplit(separacion,"-",2);	//Diferencia en cargos y abonos de cuenta saldada											str_error = trim(frn.lib("libGeneral.kpl","StrReplace",str_error,"~",""));											if (frn.get("k_mov",i,"folio") &= str_folio){												frn.setX(str_error,"k_mov",i,"estatus");												frn.setX(str_diferencias,"k_mov",i,"diferencias");												if (frn.get("k_mov",i,"diferencias") &! ""){													msg_diferencias = 1;												}											}										}										}										}											}						}										if (msg_diferencias &= 1){							frn.message(strMsg & "| Cuentas saldadas con diferencias en cargos y abonos, revise la columna **Revision CxCP**", "Mensaje", "Aceptar");					}else {						frn.message(strMsg, "Mensaje", "Aceptar");					}					frn.setAtt("bot_generar","visible", "N");					} else {					frn.message(mensaje, "Error", "Aceptar");					return;				}			}		}	</script></pag>