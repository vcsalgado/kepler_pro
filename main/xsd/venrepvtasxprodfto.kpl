<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de " scale="48">	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,16" unfont="0">		<br exe="encabezado"/>		<hLine dim="90,0" g="2" type="1"/>		<br exe="encabezado"/>				<grp dim="15,5,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>				<grp dim="60,6,7,12">			<br/>			<inp id="nombreempresa" dim="60,1" fnt="20b,20b" type="string" modify="N" bclr="249,249,249"/>			<br/>			<txt fnt=",20b" clr="0,58,112">Ventas entre dos fechas por Producto </txt>			<br/>			<txt fnt=",b">Del : </txt>			<inp id="fechaini" dim="12,1" type="date" fnt=",0b" fmt="DD/MM/CCYY" modify="N" just="L"/>			<txt fnt=",b">Al : </txt>			<inp id="fechafin" dim="12,1" type="date" fnt=",0b" fmt="DD/MM/CCYY" modify="N" just="L"/>			<br exe="encabezado"/>		</grp>				<tab n="1"/>				<grp dim="15,5,7,12">			<tab n="2"/><txt>P&#225;g:</txt>			<sp/> <inp id="k_pag" dim="5,1" type="number" mcr="k_pag"/><br/><br/>			<inp id="fecha" dim="10,1" type="date" fmt="DD-MM-CCYY"/>			<sp/> <inp id="hora" dim="5,1" type="time"/>		</grp>		<br exe="encabezado"/>		<br exe="encabezado"/>				<hLine dim="90,0" g="2" type="1"/>			<br exe="encabezado"/>			<txt fnt=",b"> Folio</txt> <tab n="4"/>			<txt fnt=",b"> Fecha</txt> <tab n="3"/>			<txt fnt=",b"> Remplazo</txt> <tab n="4"/>			<txt fnt=",b"> Subtotal </txt> <sp n="1"/>			<txt fnt=",0b"> Iva</txt> <sp n="4"/>			<txt fnt=",b"> Total</txt> <sp n="5"/> 			<txt fnt=",b"> Costo </txt> <sp n="3"/>			<txt fnt=",b"> Utilidad</txt> <sp n="3"/><txt>  %</txt>			<br exe="encabezado"/>		<hLine dim="90,0" g="2" type="1"/>		<br exe="encabezado"/>		<br exe="encabezado"/>				<hLine dim="90,0" g="1" type="1"/> 		<br exe="producto"/>		<txt fnt=",b"> Producto</txt>		<inp id="producto" dim="12,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",0b"/> <sp n="1"/> 		<inp id="descprod" dim="20,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",0b"/>		<br exe="producto"/>			<sp n="40"/>		<txt>             -----------------  ---------------   --------------------  ------------------  --------------------  ----------</txt>		<br exe="detalle_lines"/>		<inp id="folio" dim="14,1" type="string" modify="N"/> <sp/>		<inp id="fecha_folio" dim="11,1" type="date" fmt="DD/MM/CCYY" modify="N" just="L" nc="-1"/><sp/> 		<inp id="remplazo" dim="17,1" type="string" modify="N"/> <sp n="1"/>		<inp id="subtotal" dim="7,1" type="number" modify="N"/> <sp n="1"/>		<inp id="iva" dim="6,1" type="number" modify="N"/> <sp n="1"/>		<inp id="total" dim="8,1" type="number" modify="N"/> <sp n="1"/> 		<inp id="costo" dim="7,1" type="number" modify="N"/> <sp n="1"/> 		<inp id="utilidad" dim="8,1" type="number" modify="N"/> <!-- <sp n="1"/> -->		<inp id="perce" dim="4,1" type="number" nd="2" just="R"/>		<br exe="detalle"/>					<!-- INI -- Totales x Produto -->		<br exe="totalproducto"/> 		<tab n="8"/> <hLine dim="67,0" g="1" type="1"/> 		<br exe="totalproducto"/> 		<tab n="9"/><txt fnt=",0b">Total x Producto : </txt>		<tab n="2"/>		<inp id="tpsubtotal" dim="7,1" type="number"/><sp n="1"/>		<inp id="tpiva" dim="6,1" type="number"/> <sp n="1"/>		<inp id="tptotal" dim="8,1" type="number"/> <sp n="1"/>		<inp id="tpcosto" dim="7,1" type="number"/> <sp n="1"/>		<inp id="tputilidad" dim="8,1" type="number"/> <sp n="1"/>		<inp id="tpperce" dim="4,1" type="number"/>		<br exe="totalproducto"/> 		<tab n="8"/> <hLine dim="67,0" g="1" type="1"/>		<br exe="totalproducto"/>				<br exe="totalproducto"/>		<!-- END -- Totales x Produto -->				<!-- INI -- Totales x Gran Total -->		<br exe="total"/>		<tab n="3"/> <hLine dim="82,0" g="2" type="1"/> 		<br exe="total"/> 		<tab n="4"/><txt fnt=",21" clr="20,0,96">Gran Total del periodo consultado : </txt>		<tab n="2"/>		<inp id="gtsubtotal" dim="7,1" type="number"/><sp n="1"/>		<inp id="gtiva" dim="6,1" type="number"/> <sp n="1"/>		<inp id="gttotal" dim="8,1" type="number"/> <sp n="1"/>		<inp id="gtcosto" dim="7,1" type="number"/> <sp n="1"/>		<inp id="gtutilidad" dim="8,1" type="number"/> <sp n="1"/>		<inp id="gtperce" dim="4,1" type="number"/>		<br exe="total"/> 		<tab n="3"/> <hLine dim="82,0" g="2" type="1"/> 		<br exe="total"/>		<!-- END -- Totales x Gran Total -->			</grp></pag>