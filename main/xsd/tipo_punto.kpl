<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Puntos">
<grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>
		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="66,40,10,10" brdr="0,5" tit="Puntos" fnt="Arial,16">
		
	
		<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" OnEnter="Exit" OnMouseD="Exit" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="60,22" modify="N" nren="fijo">
		<col id="punto" name="Punto"/>
		<col id="descr" name="Descripcion"/>
		</tbl> 
		<tab n="7"/>
		<br/>
		
		</grp>
	
	
</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,frP,kdb,sys,Criterio,Tipo;

			fun Main(){
				frn=new FRNT;
				kdb=new KDB;
				frP=new FRNTP;
				sys=new SYS;
				kdb.connect();
				
				Criterio=trim(frn.param(0)); 
	
				Inicializa();
		
			}
			
		
			
			fun Inicializa() {
			
				var xmlRequest,cmd,ok,cuboResultados, totpuns , contpuns;
				var tabla;

				cmd= "select pun.c2 as punto, cat.c2 as descr from keplersc.kdtipoordentipopuntos as pun inner join keplersc.catpuntos as cat on cat.c1= pun.c2";
				
				cmd = cmd & " where pun.c1='" & Criterio & "'";
			
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tipo_punto.Inicializa()");
				
				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");
				
				ok=getXmlAtt(cuboResultados,"ok");
				if(ok &! "" && !ok){
					var mensajeError = getXmlAtt(cuboResultados,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				totpuns = nXml(cuboResultados);
			
				frn.rst("tabla");
				for (contpuns=0; contpuns<totpuns ; contpuns++){
			
					frn.setX( getXmlAtt(cuboResultados,"r"&contpuns,"punto"),"tabla",contpuns,"punto");
					frn.setX( getXmlAtt(cuboResultados,"r"&contpuns,"descr"),"tabla",contpuns,"descr");
				
				}	
		
			}
			
			fun Exit(){
			
				var punto = frn.get("tabla", -1, "punto");		
				frP.setX(punto ,"tabla_puntos",-1,"tipo_punto"); 
				frP.scriptElm("tabla_puntos","OnChange","tipo_punto");
				
				var desc = frn.get("tabla", -1, "descr");	
				frP.setX(desc ,"tabla_puntos",-1,"desc_punto"); 
				frP.scriptElm("tabla_puntos","OnChange","desc_punto");
				
				frn.exit();	
			
			}
				
		}
	</script>
</pag>