<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<grp id="grupo_crud" dim="50,55,20,10" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16"><tab/>							<txt id="text_id">Serie:</txt><tab n="2"/>			<inp id="input_serie" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" nc="17" clrBrdr="255,255,255" available="N"/><br/><tab/>			<txt id="text_id">Marca:</txt><tab n="2"/>			<cmb id="input_marca" clr="64,64,64" clrBrdr="255,255,255"  dim="10,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16" OnChange="actualizar_modelos()" Null="N"  available="Y"/><br/>			<tab/><txt id="text_id">Modelo:</txt><tab/>			<cmb id="input_modelo" clr="64,64,64" clrBrdr="255,255,255"  dim="10,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N"  available="Y"/><br/><tab/>			<txt>Motor:</txt><tab n="2"/>			<inp id="input_motor" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt>Transmisi&#243;n:</txt><tab/>			<inp id="input_transmision" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt>Eje Trasero:</txt><tab/>			<inp id="input_eje_trasero" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>					<txt>Placas:</txt><tab/>			<inp id="input_placas" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt>Contacto:</txt><tab/>			<inp id="input_contacto" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255"  OnChange="Validar_cliente()"  clrBrdr="255,255,255" OnF9="Dialog(3,cat_cli_view,s,input_contacto)" OnF10="Dialog(3,cat_cli_crud,Nuevo,x,s,input_contacto)" OnF11="Dialog(3,cat_cli_crud,Modificar,x,s,input_contacto)" tooltip="Seleccionar F9,Nuevo F10,Modificar F11"/><br/><tab/>			<txt>Color:</txt><tab n="2"/>			<inp id="input_color" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt>A&#241;o:</txt><tab n="2"/>			<cmb id="input_ano" clr="64,64,64" clrBrdr="255,255,255"  dim="10,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N"  available="Y"/><br/><tab/>			<txt>Fecha de Venta:</txt><tab/>			<edt id="input_fecha_venta" dim="6,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" page="_ks_fecha,input_fecha_venta" OnF9="Dialog(3,_ks_fecha,input_fecha_venta)" modify="Y" available="Y"/><br/> 			<tab/><txt>Concesionario:</txt><tab/>			<cmb id="input_concesionario" clr="64,64,64" clrBrdr="255,255,255"  dim="10,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N"  available="Y"/><br/><tab/>			<txt>&#218;ltima Visita:</txt><tab n="1"/>			<edt id="input_ult_visita" dim="6,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="Fecha()" page="_ks_fecha,input_ult_visita" OnF9="Dialog(3,_ks_fecha,input_ult_visita)" modify="Y" available="Y"/><br/> 			<tab/><txt>Ult. Kilometraje:</txt><tab/>			<inp id="input_kilometraje" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" available="S"/><br/><tab/>			<txt>C&#243;digo Planta:</txt><tab/>			<inp id="input_codigo_planta" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y"/><br/>			<br/>			<tab n="5"/><bot id="btn_aceptar" dim="5,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="0" visible="Y" available="Y"/><br/>						<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>									</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP, accion,externo,serie;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();				ctlrs_off();				llenar_ctlrs_default();								}												fun ctlrs_off(){											frn.setAtt("input_serie", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );								frn.setAtt("input_kilometraje", "available", "S" );			}							fun llenar_ctlrs_default(){												frn.rst("grupo_crud");							accion = frn.param(0);								externo	= frn.param(2);							var xmlRequest,cmd,ok, cuboResultados;								frn.set("input_crud", accion);							frn.setAtt("grupo_crud", "tit", accion );											//llenar combo marca				cmd = "select c2 as descripcion ,c1 as clave from keplersc.kdmarcas" ;				cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_vin_crud.llenar_ctlrs_default()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}										var combo_marcas = "input_marca";									frn.setX("", combo_marcas ,0,0);				frn.setX("", combo_marcas , 0, 1);									llenar_cmb(cuboResultados,combo_marcas );																					//llenar combo modelo				cmd = "select c3 as descripcion ,c2 as clave from keplersc.kdmodelos" ;				cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_vin_crud.llenar_ctlrs_default()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}										var combo_modelos = "input_modelo";									frn.setX("", combo_modelos ,0,0);				frn.setX("", combo_modelos , 0, 1);									llenar_cmb(cuboResultados,combo_modelos );													if (accion &= "Modificar"){									frn.setAtt("input_kilometraje", "available", "N" );									//llamada externa(padre)					if (externo &= "s"){											serie =frP.get(frn.param(3));												if (serie &= ""){													frn.message("selecciona una serie con F9 para modificar","Error","Aceptar");							return;						}											}else {											serie = frn.param(1);					}				}																		//llenar combo concesionario				cmd = "select c1||'-'||c2 as descripcion ,c1 as clave from keplersc.kdconc" ;				cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_vin_crud.llenar_ctlrs_default()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}										var combo_concesionarios = "input_concesionario";									frn.setX("", combo_concesionarios ,0,0);				frn.setX("", combo_concesionarios ,0,1);									llenar_cmb(cuboResultados,combo_concesionarios);																							//llenar combo anio				cmd = "select c2 as descripcion,c1 as clave from keplersc.kdanio" ;				cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_vin_crud.llenar_ctlrs_default()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}										var combo_anios = "input_ano";									frn.setX("", combo_anios ,0,0);				frn.setX("", combo_anios ,0,1);									llenar_cmb(cuboResultados,combo_anios);															if (accion &! "Nuevo") {									if (accion &= "Eliminar" || accion &= "Consultar" ){											serie = frn.param(1);										}								var campos = "ma.c2,mo.c3,s.c4,s.c5,s.c6,s.c7,s.c8,s.c9,s.c10,s.c11,s.c12,s.c13,co.c1||'-'||co.c2 as concesionario,s.c15,s.c17";																				cmd="select " & campos & " from keplersc.kdserie as s left outer join keplersc.kdmarcas as ma on s.c2=ma.c1 left outer join keplersc.kdmodelos as mo on s.c3=mo.c2 left outer join keplersc.kdconc as co on s.c14=co.c1 where s.c4 ='" & serie & "'"; 									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_vin_crud.llenar_ctlrs_default()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}											frn.set("input_serie", getXmlAtt(cuboResultados,"r"&0,"c4") );					frn.set("input_marca",getXmlAtt(cuboResultados,"r"&0,"c2"));					actualizar_modelos();					frn.set("input_modelo",getXmlAtt(cuboResultados,"r"&0,"c3"));					frn.set("input_motor",getXmlAtt(cuboResultados,"r"&0,"c5"));					frn.set("input_transmision",getXmlAtt(cuboResultados,"r"&0,"c6"));					frn.set("input_eje_trasero",getXmlAtt(cuboResultados,"r"&0,"c7"));					frn.set("input_placas",getXmlAtt(cuboResultados,"r"&0,"c8"));					frn.set("input_contacto",getXmlAtt(cuboResultados,"r"&0,"c9"));					frn.set("input_color",getXmlAtt(cuboResultados,"r"&0,"c10"));					frn.set("input_ano",getXmlAtt(cuboResultados,"r"&0,"c11"));					frn.set("input_kilometraje",getXmlAtt(cuboResultados,"r"&0,"c12"));										var fecha_venta = getXmlAtt(cuboResultados,"r"&0,"c13");					if (fecha_venta &! "2001-01-01"){						frn.set("input_fecha_venta",fecha_venta);					}										frn.set("input_concesionario",getXmlAtt(cuboResultados,"r"&0,"concesionario"));										var ult_visita = getXmlAtt(cuboResultados,"r"&0,"c15");					if (ult_visita &! "2001-01-01"){						frn.set("input_ult_visita",ult_visita );					}										frn.set("input_codigo_planta",getXmlAtt(cuboResultados,"r"&0,"c17"));															} else {					frn.setAtt("input_serie", "available", "Y" );									}								if (accion &! "Consultar"){					frn.setAtt("btn_aceptar", "available", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );				}							}									fun Execute() {						var xmlRequest,cmd,cuboResultados,ok,cmd,cubo, mensajeError ;								var resultado_confirmacion = frn.message("¿Estas seguro?","Mensaje de Confirmacion", 2);									if (resultado_confirmacion &! 1)  {					return;				}																	xmlRequest = getXml(frn.dataPag()); 							frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmd="SELECT * FROM keplersc.vin_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";					cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"cat_vin_crud.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");													var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;						}												if (accion &= "Nuevo" || accion &= "Modificar") {									serie = frn.get("input_serie");														if (externo &= "n"){											var marca_nueva= frn.get("input_marca");						var modelo_nuevo= frn.get("input_modelo");						var color_nuevo= frn.get("input_color");						var ano_nuevo = frn.get("input_ano");										frP.setX(serie ,"tabla",-1,"serie"); 						frP.scriptElm("tabla","OnChange","serie");												frP.setX(marca_nueva,"tabla",-1,"marca"); 						frP.scriptElm("tabla","OnChange","marca");													frP.setX(modelo_nuevo,"tabla",-1,"modelo"); 						frP.scriptElm("tabla","OnChange","modelo");													frP.setX(color_nuevo,"tabla",-1,"color"); 						frP.scriptElm("tabla","OnChange","color");													frP.setX(ano_nuevo ,"tabla",-1,"ano"); 						frP.scriptElm("tabla","OnChange","ano");																			}else {																frP.set(frn.param(3),serie ); 						frP.scriptElm(frn.param(3),"OnChange");														}										var sms =  "";										if (accion &= "Nuevo"){						sms = "VIN registrado";					}else {						sms = "VIN modificado";					}											frn.message(sms ,"Mensaje","Aceptar");					frn.exit();										}								if (accion &= "Eliminar"){															frP.setX("","tabla",-1,"serie"); 					frP.scriptElm("tabla","OnChange","serie");										frP.setX("","tabla",-1,"marca"); 					frP.scriptElm("tabla","OnChange","marca");												frP.setX("","tabla",-1,"modelo"); 					frP.scriptElm("tabla","OnChange","modelo");												frP.setX("","tabla",-1,"color"); 					frP.scriptElm("tabla","OnChange","color");												frP.setX("","tabla",-1,"ano"); 					frP.scriptElm("tabla","OnChange","ano");											frn.message("VIN eliminado","Mensaje","Aceptar");					frn.exit();									}														}									fun actualizar_modelos(){							var cmd,cuboResultados,ok;							var marca = frn.get("input_marca",-1,"c1");								cmd = "select c3 as descripcion ,c2 as clave from keplersc.kdmodelos where c1='" & marca & "'" ;								cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_vin_crud.llenar_ctlrs_default()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("input_modelo",cuboResultados);									}						fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}																		fun Validar_cliente(){							var clave_cli = frn.get("input_contacto");				var cmd,ok,cubo;								cmd = "select c2 from keplersc.kdud where c2='" & clave_cli & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_vin_crud.Validar_cliente()");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var len_result = nXml(cubo);								if (len_result == 0){					frn.message("Contacto no existe","Error","Aceptar");					frn.rst("input_contacto");					return;				}										}															fun edicion_cliente(tipo_edicion){				frn.dialog("cat_vin_crud",tipo_edicion,"x","s","serie", frn.get("cliente_id"));			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;							frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}													}	</script></pag>