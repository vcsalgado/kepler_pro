<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte Auxiliar">
	<grp dim="1,-1,10,20" brdr="0,0" bclr="192,205,213" clr="0,58,112" fnt="Arial,16" unfont="0" OnF1="Ventana(rep_Hlp)"><br/>
	<tab n="1"/>
	<txt fnt=",22" clr="0,0,0">Regenerar saldos de cuentas</txt><br/><tab/>
	<hLine dim="0,1" clr="0,0,0"/> 
	<br/> 
	<br/><tab n="1"/>
		<grp dim="55,45,10,5" bclr="236,240,243" tit="Criterio de proceso" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">
			<grp dim="70,41,10,5" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">
				<sp/>
				<txt>Sucursal:</txt><tab n="1"/>
				<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="30,1" bclr="254,254,254" brdr="0,0" fnt="Arial,16" Null="N" hk="S"  
					available="Y" modify="Y"/>
				<br/><sp/><txt>A&#241;o inicial:</txt><tab/>
				<cmb id="k_anio" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N"/><br/>
				<br/><txt clr="218,11,33" fnt=",b">* Los saldos se actualizar&#225;n del a&#241;o inicial hacia delante, el proceso puede tardar </txt><br/><txt clr="218,11,33" fnt=",b">  algunos minutos, no salga de la opci&#243;n hasta que esta haya concluido.</txt><br/><br/><txt clr="218,11,33" fnt=",b">* Se recomienda ejecutar este proceso fuera de horario laboral para tener resultados</txt><br/><txt clr="218,11,33" fnt=",b">  exactos.</txt><br/><br/><tab n="9"/>

				<img id="Ejecutar" dim="40,40" bPx="Y" brdr="0,1" img="_60_DocNew.png" OnEnter="Ejecuta()"  available="Y" clrBrdr="0,0,0" visible="Y" 
					modify="Y" tooltip="Ejecutar proceso definitivo"/>	
			</grp>
		</grp>
	</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,kdb,rep,sys, year, usuario,suc_usuario,perfil_usuario,rol_usuario,asterisco;
			var cubo, ok, cmd, mensajeError, xmlRequest;			
			fun Main() {
				frn=new FRNT;
				kdb=new KDB;
				rep=new REP;
				sys=new SYS;
				kdb.connect();
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				perfil_usuario = frn.lib("libKepler","UserInfo(2)");
				usuario = frn.config("user","name");
				rol_usuario = frn.config("user","role");
				asterisco = "*";
				
				Inicializa();
			}	

		
			fun valida(){
			}

			fun Inicializa(){//Inicializa los valores en Pantalla
				year = sys.date();
				year=mid(year,0,4);
				IniCombos();
			}
						
			fun IniCombos(){
				var cmdQuery, cuboQuery, cont;
            //Llenar combo sucursales
				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";
				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){
					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";
				}else {
					if (suc_usuario &! asterisco && suc_usuario &! "" ){
						cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";
					}
				}
            
            rstXml(cuboQuery);
            cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comdevdircrud.IniCombos()");
            ok=getXmlAtt(cuboQuery,"ok");
            if(ok &! "" && !ok){
                mensajeError = getXmlAtt(cuboQuery,"native3");
                mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
                frn.message(mensajeError,"Error","Aceptar");
                return;
            }
            frn.set("k_sucn",cuboQuery);
				for (cont=2022; cont <=year; cont++){
					frn.setX(cont,"k_anio",cont-2022,0);
					frn.setX(mid(cont,2,2),"k_anio",cont-2022,1);
				}
				frn.set("k_anio",year);
			}
			
			fun Ejecuta(){//Prepara datos del reporte 
				var sucursal_id;
				var cuboMovtos,tmpCubo,registros,tmpStr,resultado,mensaje; 
				if (frn.message("La regeneracion puede tardar varios minutos(5 o mas), no salga de esta pantalla ni interrumpa el proceso. Ejecutar proceso? ","Confirmacion",2)==0){
						return;
				}
																
				xmlRequest = getXml(frn.dataPag());
				//Agregar el tipo de proceso y datos adicionales
				usuario = frn.config("user","name");
				setXml(xmlRequest,"movimiento","usuario",usuario);
				cmd="select * from keplersc.cont_actualizar_saldos('<document>" & getXmlStr(xmlRequest,"EOF:13_10") & "</document>')";
				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRegSaldos");				
				frn.messageBar("Actualizando saldos de cuentas...",0);				
				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cont_regeneracion_saldos.Ejecuta()");
				frn.messageBar("",1);
				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\xmlRegSaldos");				
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}

				resultado= getXmlAtt(cubo,"r0","resultado");
				mensaje= getXmlAtt(cubo,"r0","mensaje");
				
				if(resultado &= "1"){
					frn.message("Proceso terminado.","Mensaje","Aceptar");
				}else{
					frn.message(mensaje, "Error","&Aceptar");
				}
				frn.messageBar("",1);
			}
		}
	}
	</script>
</pag>