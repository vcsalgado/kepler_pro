<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Pago Operarios"><grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,20" bclr="192,205,213" unfont="0"	OnF1="Dialog(1,invEntSalAyu)" clrBrdr="0,97,181" tit=""><br/>	<tab n="1"/>	<sp/><txt fnt=",22" clr="0,0,0">Pago Operarios</txt><br/>		<tab n="1"/><hLine clr="0,0,0"/> 	<br/><br/>								<tab n="1"/><grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="65,11,7,12" tit="Datos generales"  fnt="Arial,16"><tab/>		<txt clr="0,58,112" hk="S">Sucursal</txt><tab n="2"/>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="60,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="Grupo(1)" available="Y"/><br/><tab/>	   <txt clr="0,58,112">Tipo docto</txt><tab n="1"/>		<cmb id="k_tipon" clr="64,64,64" clrBrdr="255,255,255"  dim="40,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" OnChange="TipoMov()" OnEnter="TipoMov()"/><br/>		<inp id="tipo_movto" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N" visible="N"/>		<br/>		<br/>		<tab/><txt clr="0,58,112" id="fecha_inicial_txt" fnt="Arial,16" visible="Y">Fecha Inicial:</txt><tab/>		<edt id="fecha_inicial" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16"  type="date" OnChange="BorrarGridNomina()" page="_ks_fecha,fecha_inicial" OnF9="Dialog(3,_ks_fecha,fecha_inicial)" visible="Y"/><tab n="1"/><txt clr="0,58,112" id="fecha_final_txt"  fnt="Arial,16" visible="Y">Fecha Final:</txt><tab/>		<edt id="fecha_final" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16"  type="date" OnChange="BorrarGridNomina()" page="_ks_fecha,fecha_final" OnF9="Dialog(3,_ks_fecha,fecha_final)" visible="Y"/><tab n="2"/><img id="buscar_nomina" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="calculos_pago_ope()"  available="Y" clrBrdr="0,0,0" visible="Y"/>						</grp><tab/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="29,12,7,12" tit="Documento" fnt="Arial,16">		<tab n="3"/><inp id="operacion" clr="64,64,64"  dim="18,1" brdr="0,1" fnt=",18bs" available="N" type="string"/><br/><tab/>		<txt id="foliotxt"  visible="N" hk="F" clr="0,58,112" fnt="Arial,16">Folio</txt><tab/>		<inp id="k_folio" clr="64,64,64" OnChange="Formar_folio()" clrBrdr="255,255,255"  OnF9="folios_nomina()"  dim="15,1" bclr="255,255,255" brdr="2,0"  fnt="Arial,16" visible="N" hk="F" type="string" tooltip="seleccionar F9"  nc="10"/>		<tab/>	<img id="k_buscar_folio" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_folio()" tooltip="Consultar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>		<br/><tab/>		<inp id="k_docto" clr="64,64,64"  dim="18,1" brdr="0,1" fnt="Arial,16" available="N" link="k_tipon,5" type="string"/><br/><tab/><txt clr="0,58,112" fnt="Arial,16">Fecha</txt><tab/>		<edt id="k_fecha" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16"  modify="N" type="date" OnChange="Fecha()" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" modify="Y"/><br/><tab/> 		<inp id="statusdoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/>		</grp><br/><br/>			<tab n="1"/>		<grp id="grpDetalle" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5" dim="95,30,7,10" tit="Detalle"  fnt="Arial,16" available="Y" modify="Y">						<br/>		<br/><tab n="1"/>	<tbl id="tabla_pagos" bclr="236,240,243" modify="N" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="130,10"  hk="z" OnChange="" Reorder="N" modify="Y" available="Y">		<col id="clave_ope" name="Clave Operario" modify="N"/>		<col id="nombre_ope" modify="N" name="Nombre"/>		<col id="horas_tabuladas" nd="2" type="number" name="Horas Tabuladas"/>		<col id="horas_base" modify="N" nd="2" type="number" name="Horas Base"/>		<col id="costo_por_hora" modify="N" nd="2" type="number" name="Costo por Hora"/>		<col id="sueldo_base" modify="N" nd="2" type="number" name="Sueldo Base"/>		<col id="comisiones" modify="N" nd="2" type="number" name="Comisiones"/>		<col id="total" name="Total" nd="2" type="number" modify="N"/>		<col id="ayudante" name="Ayudante"  visible="N"/>		</tbl>		<br/>	<br/>		<tab n="1"/><txt>Descripci&#243;n Poliza:</txt>		<inp id="k_descr" dim="40,1" brdr="2,0" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="Y"/>				<tab n="1"/><txt>Referencia:</txt>		<inp id="k_refer" dim="10,1" brdr="2,0" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="Y"/>					<tab n="11"/><txt>Nomina:</txt>		<inp id="k_monto" dim="15,1" brdr="2,0" nd="2" bclr="192,205,213" clr="64,64,64" type="number" modify="N" clrBrdr="255,255,255"/>		<br/>		<br/>		<br/><tab n="39"/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0"/><tab/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" modify="Y"/><tab/>		</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb, sys, rep;			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc, fileSavePath ,tip_ope, fecha_baja ,fecha,hora ,usuario ,folio,partida , estatus_doc ,anio_contable,suc_usuario,horas_reales_trabajadas, perfil_usuario, asterisco, especificaciones_doc,tabla   ;			var presupuesto , saldo, rol_usuario ;			var uen;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();				sys=new SYS;				rep=new REP;							suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";				usuario = frn.config("user","name");						if(frn.param(0)&= "")				{					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}				gen_doc=trim(frn.param(0)); 				nat_doc=trim(frn.param(1)); 				gpo_doc=trim(frn.param(2));				tip_doc=1;				fija_doc=trim(frn.param(4));				tip_ope=trim(frn.param(5));				fileSavePath = "C:\Basura";								ctrls_off();				Inicializa();								IniParams();					}						fun Inicializa(){				kdb.kde("KDE");//								Configuraciï¿½n del servidor				kdb.exec();				anio_contable = kdb.get("KDE","14");							var cmd, cubo, ok,resValidacion,resMensaje, mensajeError  ;								uen=trim(frn.param(6));				if (uen &= ""){					uen="XXX";				}								hora = sys.time();				frn.set("k_hora",sys.time());								fecha = sys.date();				frn.set("k_fecha",sys.date());									//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));							//Llenar combo tipo docto				LlenaCmbTipo();								folio = "0000000";				docto();										/*if (tip_ope== 0){					calculos_pago_ope();				}*/			}						fun CambiaSucursal() {				BorraDatos();										LlenaCmbTipo();				docto();							}			fun LlenaCmbTipo(){				var cmd, cubo, ok,resValidacion,resMensaje, mensajeError  ;				cmd = "select c5,c1,c2,c3,c4 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and col_sucursal='" & frn.get("k_sucn", -1, 1) & "'" ;								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}							frn.set("k_tipon",getXml(cubo));							}						fun docto(){							especificaciones_doc =  gen_doc & nat_doc & gpo_doc & 0 & tip_doc & "-" & folio  ;								frn.set("k_docto",especificaciones_doc);						}						fun ctrls_off() {				frn.setAtt("foliotxt", "visible", "N" );				frn.setAtt("k_folio", "visible", "N" );				frn.setAtt("k_buscar_folio", "visible", "N" );				frn.setAtt("k_mov", "modify", "N" );				frn.setAtt("k_fecha", "modify", "N" );				frn.setAtt("k_clave","modify", "N");								frn.setAtt("k_descr", "modify", "N" );				frn.setAtt("k_refer", "modify", "N" );																				frn.setAtt("fecha_inicial_txt", "visible", "N" );				frn.setAtt("fecha_inicial", "visible", "N" );				frn.setAtt("fecha_final_txt", "visible", "N" );				frn.setAtt("fecha_final", "visible", "N" );				frn.setAtt("buscar_nomina", "visible", "N" );				frn.setAtt("Aceptar", "img", "_60_DocNew.png" );								if (tip_ope== 0){					botones_alta();								}else{					if (tip_ope== 1){						botones_baja();					}else {						botones_consulta();					}				}						}			fun botones_alta(){								frn.set("operacion","ALTA");					frn.setAtt("k_mov", "modify", "Y" );					frn.setAtt("k_clave","modify", "Y");					frn.setAtt("k_descr", "modify", "Y" );					frn.setAtt("k_refer", "modify", "Y" );																frn.setAtt("fecha_inicial_txt", "visible", "Y" );					frn.setAtt("fecha_inicial", "visible", "Y" );					frn.setAtt("fecha_final_txt", "visible", "Y" );					frn.setAtt("fecha_final", "visible", "Y" );					frn.setAtt("buscar_nomina", "visible", "Y" );																}						fun botones_baja(){							frn.set("operacion","BAJA");				frn.setAtt("foliotxt", "visible", "Y" );				frn.setAtt("k_buscar_folio", "visible", "Y" );				frn.setAtt("k_folio", "visible", "Y" );										}							fun botones_consulta(){							frn.set("operacion","CONSULTA");				frn.setAtt("foliotxt", "visible", "Y" );				frn.setAtt("k_buscar_folio", "visible", "Y" );				frn.setAtt("k_folio", "visible", "Y" );				frn.setAtt("Aceptar", "img", "_60_Print.png" );												}							fun BorraDatos() {							frn.rst("k_descr");				frn.rst("k_refer");				frn.rst("statusdoc");				frn.rst("fecha_inicial");				frn.rst("fecha_final");				frn.rst("k_folio");				folio = "0000000";				docto();				frn.rst("tabla_pagos");				frn.rst("k_monto");				frn.set("k_fecha",sys.date());			}						fun BorrarGridNomina(){				frn.rst("tabla_pagos");				frn.rst("k_monto");			}					fun TipoMov(){							tip_doc=frn.get("k_tipon",-1,4);						especificaciones_doc = gen_doc & nat_doc & gpo_doc & 0 & tip_doc & "-" & folio ;				frn.set("k_docto",especificaciones_doc );						}						fun calculos_pago_ope(){							var xmlRequest, cmd, cubo, ok, mensajeError , xmlRes, strTmp ;					setXml(xmlRequest,"document","sucursal_id",frn.get("k_sucn", -1, 1));				setXml(xmlRequest,"document","fecha_inicial",frn.get("fecha_inicial"));				setXml(xmlRequest,"document","fecha_final",frn.get("fecha_final"));					frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.ser_calculos_pago_ope('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}					frn.set("k_monto", getXmlAtt(cubo, "r0","nomina"));				horas_reales_trabajadas = getXmlAtt(cubo, "r0","horas_reales_trabajadas");												var cubo_ope;				rstXml(strTmp);				strTmp = getXmlAtt(cubo,"r0","nomina_por_operarios");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_ope,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_ope,"C:\Basura\cubo   ");				frn.setX(cubo_ope,"tabla_pagos"); 							}						//solo en BAJA y CONSULTA			fun Buscar_folio(){							var cmd, cuboResultados, ok; 				var fol_sel = frn.get("k_folio");				var sucursal_id = frn.get("k_sucn", -1, 1);				cmd="select ope.c1 as clave_ope, ope.c3 as nombre_ope, nom.c8 as horas_tabuladas, nom.c9 as horas_base, nom.c10 as costo_por_hora, nom.c12 as sueldo_base"; 				cmd = cmd & " ,nom.c13 as comisiones,nom.c15 as total, nom.c16 as fecha, nom.c17 as estatus, nom.c18 as fecha_baja from keplersc.kdtablanom   ";				cmd= cmd & "  as nom inner join keplersc.kdoper as ope on ope.c1=nom.c7 where nom.c1='" & sucursal_id  & "' and nom.c2='" & gen_doc & "'" ;							cmd = cmd & " and nom.c3='" & nat_doc & "' and nom.c4='" & gpo_doc & "' and nom.c5='" & tip_doc & "' and nom.c6='" & fol_sel  & "'";								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.Buscar_folio ()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.setX(cuboResultados,"tabla_pagos");								var nom;				for (var i=0,n=frn.N("tabla_pagos")-1;i<n;i++) {					nom = nom + frn.get("tabla_pagos", i, "total");				}								frn.set("k_monto", nom);				var fecha_poliza = getXmlAtt(cuboResultados,"r0", "fecha");				frn.set("k_fecha",fecha_poliza );								estatus_doc = getXmlAtt(cuboResultados,"r0", "estatus");				if (estatus_doc &= "B"){					frn.set("statusdoc","CANCELADO");					fecha_baja = getXmlAtt(cuboResultados,"r0", "fecha_baja");				}else{					frn.set("statusdoc","");				}												//datos poliza				var anio = mid(strSplit(fecha_poliza, "-", 0), 2,2);				var mes = strSplit(fecha_poliza, "-", 1);				tabla = " keplersc.kdc2" & anio & mes;				cmd= " select c6,c7,c10 from " & tabla & " where c14='" & sucursal_id  & "' and c15='" & gen_doc & "'" ;							cmd = cmd & " and c16='" & nat_doc & "' and c17='" & gpo_doc & "' and c18='" & tip_doc & "' and c19='" & fol_sel  & "'";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.Buscar_folio()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_refer", getXmlAtt(cuboResultados , "r0","c7"));				frn.set("k_descr", getXmlAtt(cuboResultados, "r0","c6" ));								var num_res = nXml(cuboResultados);								partida = getXmlAtt(cuboResultados, "r" & num_res - 1  ,"c10" );								folio = fol_sel ;				docto();			  			}							fun Ejecuta(){							if (tip_ope== 0){									if (frn.get("k_descr") &= "" ){						frn.message("Falta descripciï¿½n.", "Mensaje","Aceptar");						return ;					}					if (frn.get("k_refer") &= "" ){						frn.message("Falta referencia.", "Mensaje","Aceptar");						return ;					}					if (frn.get("k_monto") == 0){						frn.message("No hay pagos por realizar.", "Mensaje","Aceptar");						return ;					}					Alta();					return ;				}								if (frn.get("k_folio") &= ""){					frn.message("Selecciona un folio","Error","Aceptar");					return ;				}												var len_pagos = frn.N("tabla_pagos");									if (len_pagos == 1){					frn.message("Selecciona un documento","Error","Aceptar");					return ;				}								if (tip_ope == 1){									var cmd, cuboResultados, ok;											if (estatus_doc &= "B"){						frn.message("No puedes dar de baja un documento que ya esta cancelado","Error","Aceptar");						return ;					}								for (var i=0,n=len_pagos-1;i<n;i++) {											var ope = frn.get("tabla_pagos", i, "clave_ope");										cmd="select c12 from keplersc.kdoper where c1='" & ope & "'"; 						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.Ejecuta()");										frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cuboResultadosbaja");										ok=getXmlAtt(cuboResultados,"ok");						if(ok &! "" && !ok){							var mensajeError = getXmlAtt(cuboResultados,"native3");							frn.message(mensajeError,"Error","Aceptar");							return;						}									   var estatus_ope = getXmlAtt(cuboResultados,"r0", "c12");						 						/*if (estatus_ope &= "N"){							frn.message("Operario " & ope & " inactivo, no se puede dar de baja pago.", "Mensaje","&Aceptar");							return ;						}*/										}										Baja();					return ;				}									if (tip_ope == 2){									GenerarReporte();				}			}															fun Alta(){						var cmdQuery, cuboQuery,xmlPantalla , ok, mensajeError,resultado ,mensaje, continua ,strFecha ,strTmp ,strMsg    ;							continua = frn.message("?Desea continuar con la alta?","Atenci?n",2);				if (continua == 0){					return;				}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;				setXml(xmlPantalla,"horas_reales_trabajadas",horas_reales_trabajadas);				setXml(xmlPantalla,"ctd_pagos",frn.N("tabla_pagos") -1);				setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"nomina",frn.get("k_monto"));				setXml(xmlPantalla,"k_montoext1",frn.get("k_monto"));				setXml(xmlPantalla,"k_monto",0);									frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaSrv_pago_operarios");				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cuboQuery);				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_pago_operarios.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlCuboSrv_pago_operarios");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1"){					strMsg = "El Folio utilizado para esta operaci?n fue : " & mensaje;					frn.message(strMsg, "Mensaje", "Aceptar");					tip_ope = 2;					ctrls_off();					Inicializa();					folio = mensaje ;					frn.set("k_folio",folio );					docto();					Buscar_folio();					GenerarReporte();				}else {					frn.message(mensaje, "Error", "Aceptar");				}						}						fun Baja(){							var cmdQuery, cuboQuery,xmlPantalla , ok, mensajeError,resultado ,mensaje, continua ,strFecha ,strTmp    ;								continua = frn.message("?Desea continuar con la baja?","Atenci?n",2);					if (continua == 0){						return;					}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;													setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);					setXml(xmlPantalla,"operacion","baja");					setXml(xmlPantalla,"ambiente","uen",uen);																frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallasrv_pago_operarios");					cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					rstXml(cuboQuery);											cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_pago_operarios.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlPantallasrv_pago_operarios");											resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok) {						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}										if(resultado &= "1"){						frn.message("El Documento se ha dado de baja","","Aceptar");						tip_ope = 2;						ctrls_off();						Inicializa();						folio = mensaje ;						frn.set("k_folio",folio );						docto();						Buscar_folio();						GenerarReporte();					}else {						frn.message(mensaje, "Error", "Aceptar");					}						}									fun GenerarReporte(){								var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var cuboResultados, xmlRequest,sqlXmlResultados,xmlCurDocto,xmlCurMovto,cmd,ok,mensaje;								kdb.kde("KDE");//Configuraciï¿½n del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();				var incluir_salto_pagina= frn.get("salto_de_pagina");				var sucursal_id =  frn.get("k_sucn", -1, 1);								cmd="select ope.c1, ope.c3, ope.c17, nom.c8, nom.c9, nom.c10, nom.c12,nom.c13,nom.c15 from keplersc.kdtablanom as nom ";				cmd= cmd & " inner join keplersc.kdoper as ope on ope.c1=nom.c7 where nom.c1='" &  sucursal_id  & "' and nom.c2='" & gen_doc & "'" ;							cmd = cmd & " and nom.c3='" & nat_doc & "' and nom.c4='" & gpo_doc & "' and nom.c5='" & tip_doc & "' and nom.c6='" & folio & "'";								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.GenerarReporte()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultadosrep");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								kdb.readPage("datos","srv_pago_operariosfto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parï¿½metros finales de impresiï¿½n.(rep.page(...);)				rep.set("suc_desc", frn.get("k_sucn", -1, 0));				rep.set("docto",frn.get("k_docto"));				rep.set("fecha",frn.get("k_fecha"));				rep.set("referencia",frn.get("k_refer"));				rep.set("descripcion",frn.get("k_descr"));				rep.set("rep_fecha",fechaImpresion);				rep.set("rep_hora",horaImpresion);				rep.exe("encabezado");				rep.exe("tit_reporte");				rep.exe("encabezadoColumnas");				rep.exe("linea_encabezados");						var clave_ope, nombre_ope, tip_pago, hrs_tab, hrs_base, costo_hora,sueldo_base;				var comisiones, total_pag, totnomina, contnomina,tot_sueldo_base, tot_comisiones , tot_nomina  ;								totnomina = nXml(cuboResultados);				for (contnomina=0; contnomina<totnomina ;contnomina++){									clave_ope= getXmlAtt(cuboResultados,"r"&contnomina, "c1");					nombre_ope= getXmlAtt(cuboResultados,"r"&contnomina, "c3");					tip_pago= getXmlAtt(cuboResultados,"r"&contnomina, "c17");					hrs_tab= getXmlAtt(cuboResultados,"r"&contnomina, "c8");					hrs_base= getXmlAtt(cuboResultados,"r"&contnomina, "c9");					costo_hora= getXmlAtt(cuboResultados,"r"&contnomina, "c10");					sueldo_base= getXmlAtt(cuboResultados,"r"&contnomina, "c12");					comisiones= getXmlAtt(cuboResultados,"r"&contnomina, "c13");					total_pag= getXmlAtt(cuboResultados,"r"&contnomina, "c15");									rep.set("clave_ope",clave_ope);					rep.set("nombre_ope",nombre_ope);					rep.set("tip_pago",tip_pago);					rep.set("hrs_tab",hrs_tab);					rep.set("hrs_base",hrs_base);					rep.set("costo_hora",costo_hora);					rep.set("sueldo_base",sueldo_base);					rep.set("comisiones",comisiones);					rep.set("total_pag",total_pag);					rep.exe("nomina");											tot_sueldo_base = tot_sueldo_base + sueldo_base;					tot_comisiones = tot_comisiones + comisiones;					tot_nomina = tot_nomina + total_pag;								}					rep.exe("linea_totales");				rep.set("tot_sueldo_base",tot_sueldo_base);				rep.set("tot_comsisiones",tot_comisiones );				rep.set("tot_nomina",tot_nomina );				rep.exe("totales_nomina");								//Procesa poliza contable				var tablakdc1_alta = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;				var tablakdc2_alta = " keplersc.kdc2" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) & strSplit(frn.get("k_fecha"), "-", 1);				var tablakdc1_baja = " keplersc.kdc1" & mid(strSplit(fecha_baja, "-", 0), 2,2) ;				var tablakdc2_baja = " keplersc.kdc2" & mid(strSplit(fecha_baja, "-", 0), 2,2) & strSplit(fecha_baja, "-", 1);				var tipo = ""; var nPolAlta = "" ;				if (tablakdc2_baja &= tablakdc2_alta ){					tipo = "Misma_tabla";										cmd= " select c1 as num_pol from " & tablakdc2_alta & " where c14='" & sucursal_id  & "' and c15='" & gen_doc & "' and c16= '" & nat_doc & "'" ;					cmd = cmd & " and c17='" & gpo_doc & "' and c18='" & tip_doc & "' and c19='" & frn.get("k_folio")& "'";									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.GenerarReporte()");					frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");									ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}									nPolAlta =getXmlAtt(cuboResultados,"r0", "num_pol" );								}				imprime_poliza(tablakdc1_alta , tablakdc2_alta, "Alta", tipo, nPolAlta);								if (estatus_doc &= "B" && fecha_baja &! "1800-01-01"){					imprime_poliza(tablakdc1_baja , tablakdc2_baja, "Baja", tipo, nPolAlta);				}									rep.set("desc_notas",frn.get("k_descr"));				rep.exe("notastitulos");								if (estatus_doc &! "B") {					rep.exe("extras");				}									rep.win();										}						fun imprime_poliza(tablakdc1 , tablakdc2, operacion, tipo, nPolAlta ){							var cmd, cuboResultados , ok;				var sucursal_id =  frn.get("k_sucn", -1, 1);								//Procesa poliza contable				cmd= " select kc2.c1 as num_pol, kc2.c3 as cuenta, kc2.c4 as tipo_asiento, kc2.c5 as monto, kc1.c2 as desc_pol, kc2.c7 as refer, kc2.c8 as tipo_pol from " & tablakdc2 & " as kc2 " ;				cmd = cmd & " inner join " & tablakdc1 & " as kc1 on kc1.c1=kc2.c3 ";				cmd = cmd & " where kc2.c14='" & sucursal_id  & "' and kc2.c15='" & gen_doc & "' and kc2.c16= '" & nat_doc & "' and kc2.c17='" & gpo_doc & "' and kc2.c18='" & tip_doc & "' and kc2.c19='" & frn.get("k_folio")& "'";				if (operacion &= "Alta" && tipo &= "Misma_tabla"){					cmd = cmd & " and kc2.c1 = " & nPolAlta ; 				}				if (operacion &= "Baja" && tipo &= "Misma_tabla"){					cmd = cmd & " and kc2.c1 <> " & nPolAlta ; 				} 				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.imprime_poliza()");				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var nRenPol= nXml(cuboResultados);				var tPoliza=getXmlAtt(cuboResultados,"r0", "tipo_pol" );				var nPoliza=getXmlAtt(cuboResultados,"r0", "num_pol" );				var referPoliza=getXmlAtt(cuboResultados,"r0", "refer" );								if (strlen(tPoliza)>0 && strlen(nPoliza)>0 ){						rep.set("tPol",tPoliza);						rep.set("nPol",nPoliza);						rep.set("referPol",referPoliza);						rep.exe("encabezadoPol");						var tAbonosPol=0, tCargosPol=0;						for(var i=0;i<nRenPol;i++){							if (getXmlAtt(cuboResultados,"r"&i, "tipo_asiento" )&= "A"){								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave2",cuenta );								rep.set("PolDescr2",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolHaber",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tAbonosPol=tAbonosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								pol_saldo_presupuesto(cuenta);								rep.set("PolSaldo2",saldo);								rep.set("PolPresupuesto2",presupuesto );								rep.exe("partPolA");							}else{								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave",cuenta );								rep.set("PolDescr",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolDebe",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tCargosPol=tCargosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								pol_saldo_presupuesto(cuenta);								rep.set("PolSaldo",saldo );								rep.set("PolPresupuesto",presupuesto );								rep.exe("partPolC");							}						}						rep.set("totCargo",tCargosPol);						rep.set("totAbono",tAbonosPol);						rep.exe("PolTotales");				}			}							fun pol_saldo_presupuesto(cuenta){						var cmd, cuboResultados , ok, mensajeError  ;								var mes = strSplit(frn.get("k_fecha"), "-", 1);				tabla = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2);								var col_cargos = 26 + mes;				var col_abonos = 62 + mes;				var col_presupuesto= 38 + mes;				 				cmd= " select c" & col_cargos & " as cargos ,c" & col_abonos & " as abonos ,c" & col_presupuesto & " as pres from " & tabla & " where c1='" & cuenta & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.pol_saldo_presupuesto()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				var cargos = getXmlAtt(cuboResultados,"r0", "cargos" );				var abonos = getXmlAtt(cuboResultados,"r0", "abonos" );				presupuesto = getXmlAtt(cuboResultados,"r0", "pres" );				saldo = cargos - abonos;			}									fun folios_nomina(){				var cmdQuery = "select c6 as folio, round(sum(c15),2) as total, to_char(c16, 'dd/mm/yyyy' ) as fecha, c17 as estatus from keplersc.kdtablanom where c1='" & frn.get("k_sucn", -1, 1) & "' group by c1,c2,c3,c4,c5,c6,c16,c17 order by c16 desc ";            frn.dialog("genlistasel","Documentos",cmdQuery,"folio ","k_folio","","N");            BorraDatos();            			}															//extras--------------------------------------------------------------------------------------------------------------------------------												fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);			}												fun Valida_Tipo_Docto(){				var resValidacion, resMensaje, cubo, cmd, ok;							//Valida documento vigente				kdb.rst();				cmd= "select * from keplersc.verify_valid_document('" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & frn.get("k_tipon",-1,4) & ")"; //genero text, naturaleza text, grupo integer, tipo_movto integer				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"venfactdirecta.Valida_Tipo_Docto()");				resValidacion= getXml(cubo,"validacion","resultado");				resMensaje = getXml(cubo,"validacion","mensaje");				if(resMensaje &! ""){					frn.message(resMensaje, "Mensaje","&Aceptar");					frn.setPos("k_tipon");				}										}															fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaciï¿½n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaciï¿½n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para pï¿½ginas de operacion:Solo si se estï¿½ en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverï¿½ el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}									fun IniParams(){//Inicializa parï¿½metros de impresiï¿½n, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Pï¿½gina				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}			fun setRepPage() {//Establece los parï¿½metros finales de impresiï¿½n.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}																			}	</script></pag>