<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Genera Catalogo"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,15,13" bclr="192,205,213" unfont="0">	<tab/>	<inp id="inp_titulo" dim="50,1" clr="0,0,0"  type="string" modify="N" available="N" fnt="Arial,22"/>	<br/>	<tab n="1"/>	<hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="50,40,10,11" brdr="0,5" tit="Consultar registro" fnt="Arial,16">		<sp n="2"/>		<txt>Sucursal:</txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="25,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/>		<sp/>		<inp id="inp_filtros" dim="6,1" clrBrdr="255,255,255" 				type="string" modify="N" available="N" fnt="Arial,16"/>		<cmb id="k_filtros" clr="64,64,64" clrBrdr="192,205,213"  				dim="10,15" bclr="255,255,255" brdr="2,0" Null="N" available="Y" tooltip="Selecciona columna base de b&#250;squeda"/><sp/>		<inp id="k_busqueda" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213"				type="capital" tooltip="texto a buscar"/><sp/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_Registros()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>						<br/>		<sp n="2"/>		<tbl clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" brdr="1,0" id="results" dim="71,20" 			modify="N" nren="fijo" Reorder="Y" OnMouseD="Execute()">			<col name="C1" id="c1"/>		</tbl>		<tab n="1"/>		<br/>		<grp id="gpo_3" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="80,3,10,25" brdr="0,5" fnt="Arial,16" visible="S">			<tab n="1"/>			<bot id="k_btn_selec" dim="10,10" brdr="5" text="Seleccionar" default="0" step="0"  OnEnter="abrir_crud(Opcion)" fnt="Arial,16"/> 			<tab/>			<inp id="reg_mostrados" dim="58,1" clr="0,0,0"  type="string" modify="N" available="N" fnt="Arial,16"/>			<br/>			<tab n="10"/>			<bot id="banterior"  dim="6,10" brdr="5" text="&lt;&lt;" fnt="Arial,16" OnEnter="Buscar_Registros(-100)" visible="N" tooltip="Anterior p&#225;gina de resultados" available="N" modify="N"/>			<tab/>			<bot id="bsiguiente"  dim="6,0" brdr="5" text="&gt;&gt;" fnt="Arial,16" OnEnter="Buscar_Registros(100)" visible="Y" tooltip="Siguiente p&#225;gina de resultados" available="Y" modify="Y"/>		</grp>		<br/>	</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;			var accion,tipoOper; //Variables relacionadas con parametros//--------------------------------------------------------------------Agregar Variables de Codigo Duro --------------------------------------------------------------------			var consAdmin, consVarios, consPlantilla, consControl, consAutos, consAutosAlta, consAutosConsultar, consAutosEliminar, consAutosModificar; //variables de codigo duro			var consClases, consMarca, consIsan, consLinea, consProveedores, consExterior, consInterior,consNotaCargo,consVehiculo, consRecep, consOper, consClasPag;			var consCoachesobjmens, consTipoOperarios, consModelo, consConsecionario, consGruposFolio, consSuspensiones;			var consTipoVehiculos, consPaquetes,consAjusteCosto,consPartes,consClasifPagos,consCuentasUnidades, consAnio, consDupPaq, consSucursal,consTisan, consPorcentajes;				var consUnidades, consMotivosCancelacionCitas,consInvAutos,consKdtvr2,consSerie, consClasPaq, consReem, consVEsqVeh, consAsesoresTMKT,consHorariosNoDispTaller,consKddinv;			var consConPres, consGpContra, consGpGastos,consLealtad;			var regTotales,ultimoValorEncontrado, contGlobalResults; //variables del llenado de la tabla			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna;			var NUEVO,MODIFICAR,CONSULTAR,ELIMINAR;			var mostrarRegistros;			var offset;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				//Constantes				NUEVO="N";				MODIFICAR="M";				CONSULTAR="C";				ELIMINAR="E";								//Parametros				if (frn.nParam() < 2){					frn.message("Acción no permitida.","Error","&Aceptar");					frn.open("principal",4);					return;				}				tipoOper = frn.param(0);				accion=frn.param(1);				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";				offset =0;								ConfiguraUI();								Inicializa();						}//--------------------------------------------------------------------Agregar el KPL CRUD a abrir --------------------------------------------------------------------			fun abrir_crud(){				var param = frn.get("results", -1, "k_clave");				var param1 = frn.get("results", -1, "k_clave");								var param2 = frn.get("results", -1, "k_clave_2");				var param3 = frn.get("results", -1, "k_clave_3");				var param4 = frn.get("results", -1, "k_clave_4");								var cve_color,desc, gen = "G"; //				if (tipoOper &="VARIOS"){ //AGREGAR ELSE IF  QUE DIRECCIONE AL KPL CORRECTO					frn.dialog("cat_crud_varios",accion, param); 				}				else if (tipoOper &="AUTOS"){ 					frn.dialog("cat_crud_autos",accion, param); 				}				else if (tipoOper &="CLASES"){ 					frn.dialog("cat_crud_clases",accion, param, gen); 				}				else if (tipoOper &="MARCA"){ 					frn.dialog("cat_crud_marca",accion, param, gen); 				}else if (tipoOper &="ISAN"){ 					frn.dialog("cat_crud_isan",accion, param, gen); 				}else if (tipoOper &="LINEA"){ 					frn.dialog("cat_lineas_crud",accion, param, "n"); 				}else if (tipoOper &="PROVEEDORES"){ 					frn.dialog("cat_crud_proveedores",accion, param, gen); 				}else if (tipoOper &="EXTERIOR"){ 					cve_color = frn.get("results", -1, "color");					frn.dialog("cat_exteriores_crud",accion, param, "n", cve_color); 				}else if (tipoOper &="INTERIOR"){ 					cve_color = frn.get("results", -1, "color");					frn.dialog("cat_interiores_crud",accion, param, "n", cve_color);				}else if (tipoOper &="C_COACHESOBJMENS"){ 					frn.dialog("cat_crud_coachesobjmens",accion, param, gen, param2); 				}else if (tipoOper &="NOTACARGO"){ 					frn.dialog("cat_notacargo_crud",accion, param, "n");					}else if (tipoOper &="VEHICULO"){ 					desc = frn.get("results", -1, "descripcion");					frn.dialog("cat_vehiculo_crud",accion, param, "n");										}else if (tipoOper &="RECEP"){ 					frn.dialog("cat_recepcionistas_crud",accion, param, "n");					}else if (tipoOper &="OPER"){ 					frn.dialog("cat_operarios_crud",accion, param, "n");				}else if (tipoOper &="CLASPAG"){ 					frn.dialog("cat_claspag_crud",accion, param, "n");							}else if (tipoOper &="TIPO_OPERARIOS"){ 					frn.dialog("cat_crud_tipo_operarios",accion, param, "n");						}else if (tipoOper &="MODELO"){ 					var cve_marca = frn.get("results", -1, "cve_marca")					frn.dialog("cat_crud_modelos",accion, param, "n", cve_marca);						}else if (tipoOper &="CONSECIONARIO"){ 					frn.dialog("cat_crud_consecionarios",accion, param, "n");						}else if (tipoOper &="GRUPOS_FOLIO"){ 					var sucn = frn.get("k_sucn",-1,1);					frn.dialog("cat_crud_grupos_folio",accion, param, "n", sucn);						}else if (tipoOper &="SUSPENSIONES"){ 					frn.dialog("cat_crud_suspensiones",accion, param, "n");						}else if (tipoOper &="TIPOVEHICULOS"){ 					frn.dialog("cat_crud_tipo_vehiculos",accion, param, "n");						}else if (tipoOper &="PAQUETES"){ 					frn.dialog("cat_crud_paquetes",accion, param, "n");										}else if (tipoOper &="AUTOSAJUSTECOSTO"){ 					frn.dialog("ven_ajuste_costo",accion, param, "n");										}else if (tipoOper &="INV_PARTES"){ 					frn.dialog("inv_partes_crud",accion, param, "n");										}else if (tipoOper &="CLASIF_PAGOS"){ 					//Mismo que CLASPAG					//frn.dialog("cat_clasifpagos_crud.kpl",accion, param, "n");										}else if (tipoOper &="CUENTAS_UNIDADES"){ 					param2 = frn.get("results", -1, "k_anio");					param3 = frn.get("results", -1, "k_suc");					frn.dialog("cat_cuentas_unidades_crud.kpl",accion, param, param2,param3,"n");										}else if (tipoOper &="ANIO"){ 					frn.dialog("cat_anio_crud.kpl",accion, param, "n");										}else if (tipoOper &="DUP_PAQ"){ 					param2 = frn.get("results", -1, "k_modelo");					param3 = frn.get("results", -1, "k_clave_paq");					frn.dialog("cat_duplica_paquete_crud.kpl",accion, param, param2,param3,"n");										}else if (tipoOper &="SUCURSAL"){ 					frn.dialog("cat_sucursales_crud.kpl",accion, param,"n");										}else if (tipoOper &="TISAN"){ 					frn.dialog("cat_tisan_crud.kpl",accion, param,"n");										}else if (tipoOper &="PORCENTAJES"){ 					frn.dialog("cat_porcentajes_crud.kpl",accion, param,"n");										}else if (tipoOper &="UNIDADES"){ 					frn.dialog("cat_unidades_crud.kpl",accion, param,"n");										}else if (tipoOper &="CANCELACION_CITAS"){ 					frn.dialog("cat_cancelacion_citas_crud.kpl",accion, param,"n");										}else if (tipoOper &="KDTVR2"){ 					frn.dialog("cat_kdtvr2_crud.kpl",accion, param,"n");										}else if (tipoOper &="SERIES"){ 					param =frn.get("results", -1, "serie");					if (param &= ""){						frn.message("No has seleccionado una Serie","Error","Aceptar");					}else{						frn.dialog("cat_serie_crud.kpl",accion, param,"n");					}											}else if (tipoOper &="CLAS_PAQ"){ 					frn.dialog("cat_claspaq_crud.kpl",accion, param,"n");				}else if (tipoOper &="VESQVEH"){					frn.dialog("cat_comis_ven_esqveh_crud.kpl",accion,frn.get("results", -1,"sucursal"),frn.get("results", -1,"tipo_esquema"),						frn.get("results", -1,"tipo_operacion"),frn.get("results", -1,"tipo_auto"),frn.get("results", -1,"tipo_comision"),"n");				}else if (tipoOper &="ASESORES_TMKT"){ 					frn.dialog("cat_crud_tmkt",accion, param, "n");						}else if (tipoOper &="HORARIOS_NODISP_TALLER"){ 					frn.dialog("cat_crud_nodisp_taller",accion,					frn.get("results", -1, "fecha"),					frn.get("results", -1, "horario_nodisp_inicio"),					frn.get("results", -1, "horario_nodisp_fin"), "n");						}else if (tipoOper &="KDDINV"){ 					frn.dialog("cat_crud_kddinv",accion, 					frn.get("results", -1, "clave"),					frn.get("results", -1, "descr"),					frn.get("results", -1, "anio"),					frn.get("results", -1, "id"),					frn.get("results", -1, "nuevo_usado"), "n");						}else if (tipoOper &="INVAUTOS"){					var k_inv, k_tipo;					k_inv=frn.get("results", -1, "k_clave");					k_tipo=frn.get("results", -1, "k_tipo");					if(k_tipo&="NUEVO")					{						frn.dialog("tbl_kdinf_upd", k_inv, "A","MostrarInventario()");											}else{						frn.dialog("tbl_kdinf_updU", k_inv, "A","MostrarInventario()");					}				}else if (tipoOper &="CONPRES"){					frn.dialog("cat_concepresup_crud",accion, frn.get("results", -1,"clave"), "n", frn.get("k_sucn",-1,1));							}else if (tipoOper &="GPCONTRA"){					frn.dialog("cat_gpcontra_crud",accion, frn.get("results", -1,"grupo_id"), "n", frn.get("k_sucn",-1,1));				}else if (tipoOper &="GPGASTOS"){					frn.dialog("cat_gpgastos_crud",accion, frn.get("results", -1,"grupo_id"), "n");				}else if (tipoOper &=consLealtad	){					param1 = frn.get("results", -1, "ident"); //Id					param2 = frn.get("results", -1, "suc"); //Sucursal					frn.dialog("conf_lealtad_crud",accion, param1,param2);				}			}			fun Encabezados(){				var colIds, totReg;				frn.rst("results");								totReg=nXml(cuboXml);				colIds=getXmlAtt(cuboXml,"k_ColName");				if(colIds &! ""){					frn.setX(colIds,"results","k_ColName");					frn.setX(getXmlAtt(cuboXml,"k_ColType"),"results","k_ColType");					frn.setX(getXmlAtt(cuboXml,"k_ColNd"),"results","k_ColNd");					frn.setAtt("llave","visible","N");				}							}//----------------------------------------Agregar  Titulos y Variable  para configugar interfas grafica --------------------------------------------------------------------			fun ConfiguraUI(){				consVarios="VARIOS";				consAutos="AUTOS";					consClases="CLASES";					consMarca="MARCA";				consIsan="ISAN";				consLinea="LINEA";				consProveedores="PROVEEDORES";				consExterior="EXTERIOR";				consInterior="INTERIOR";				consNotaCargo="NOTACARGO";				consVehiculo="VEHICULO";				consCoachesobjmens="C_COACHESOBJMENS";				consRecep="RECEP";				consOper="OPER";				consClasPag="CLASPAG";				consTipoOperarios="TIPO_OPERARIOS";				consModelo="MODELO";				consConsecionario="CONSECIONARIO";				consGruposFolio="GRUPOS_FOLIO";				consSuspensiones="SUSPENSIONES";				consTipoVehiculos="TIPOVEHICULOS";				consPaquetes="PAQUETES";				consAjusteCosto="AUTOSAJUSTECOSTO";				consInvAutos="INVAUTOS";				consPartes="INV_PARTES";				consClasifPagos="CLASIF_PAGOS";				consCuentasUnidades="CUENTAS_UNIDADES";				consAnio="ANIO";				consDupPaq="DUP_PAQ";				consSucursal="SUCURSAL";				consTisan="TISAN";				consPorcentajes="PORCENTAJES";				consUnidades="UNIDADES";				consMotivosCancelacionCitas="CANCELACION_CITAS";				consKdtvr2="KDTVR2";								consSerie="SERIES";				consClasPaq="CLAS_PAQ";				consReem="REEMPLAZOS";				consVEsqVeh="VESQVEH";				consAsesoresTMKT="ASESORES_TMKT";				consHorariosNoDispTaller="HORARIOS_NODISP_TALLER";				consKddinv= "KDDINV";				consConPres="CONPRES";				consGpContra="GPCONTRA";				consGpGastos="GPGASTOS";				consLealtad="LEALTAD";								//Establecer titulo del catalogo				if (tipoOper &= consVarios){					frn.set("inp_titulo","Cargos Varios"); //EL TITULO DEL REPORTE EN PANTALLA					frn.setAtt("gpo_2","tit","Catálogo de Cargos Varios"); //TITULO DE GRUPO EN PANTALLA				}else if(tipoOper &= consAutos){ 					frn.set("inp_titulo","Catálogo de Autos");					frn.setAtt("gpo_2","tit","Catálogo autos"); 				}else if(tipoOper &= consClases){ 					frn.set("inp_titulo","Catálogo de Clases");					frn.setAtt("gpo_2","tit","Catálogo Clases"); 				}else if(tipoOper &= consMarca){ 					frn.set("inp_titulo","Catálogo de Marca");					frn.setAtt("gpo_2","tit","Catálogo Marca"); 				}else if(tipoOper &= consIsan){ 					frn.set("inp_titulo","Catálogo de ISAN");					frn.setAtt("gpo_2","tit","Catálogo ISAN"); 				}else if(tipoOper &= consLinea){ 					frn.set("inp_titulo","Catálogo de Líneas");					frn.setAtt("gpo_2","tit","Líneas"); 				}else if(tipoOper &= consProveedores){ 					frn.set("inp_titulo","Catálogo de Proveedores");					frn.setAtt("gpo_2","tit","Catálogo Proveedores"); 				}else if(tipoOper &= consExterior){ 					frn.set("inp_titulo","Catálogo de Colores Exteriores del Vehículo");					frn.setAtt("gpo_2","tit","Colores Exteriores del Vehículo");				}else if(tipoOper &= consInterior){ 					frn.set("inp_titulo","Catálogo de Interiores del Vehículo");					frn.setAtt("gpo_2","tit","Colores Interiores del Vehículo");				}else if(tipoOper &= consCoachesobjmens){ 					frn.set("inp_titulo","Coaches, Objetivos Mensuales");					frn.setAtt("gpo_2","tit","Coaches, Objetivos Mensuales"); 				}else if(tipoOper &= consNotaCargo){ 					frn.set("inp_titulo","Catálogo de Notas de Cargo");					frn.setAtt("gpo_2","tit","Notas de Cargo");					}else if(tipoOper &= consVehiculo){ 					frn.set("inp_titulo","Catálogo de Vehículos");					frn.setAtt("gpo_2","tit","Vehículos");										}else if(tipoOper &= consRecep){ 					frn.set("inp_titulo","Catálogo de Recepcionistas");					frn.setAtt("gpo_2","tit","Recepcionistas");					}else if(tipoOper &= consOper){ 					frn.set("inp_titulo","Catálogo de Operarios");					frn.setAtt("gpo_2","tit","Operarios");				}else if(tipoOper &= consClasPag){ 					frn.set("inp_titulo","Catálogo Clasificacion de Pagos");					frn.setAtt("gpo_2","tit","Clasificaciones Pagos");							}else if(tipoOper &= consTipoOperarios){ 					frn.set("inp_titulo","Catálogo de Tipo Operarios");					frn.setAtt("gpo_2","tit","Tipo Operarios");								}else if(tipoOper &= consModelo){ 					frn.set("inp_titulo","Catálogo de Modelos");					frn.setAtt("gpo_2","tit","Modelos");								}else if(tipoOper &= consConsecionario){ 					frn.set("inp_titulo","Catálogo de Consecionarios");					frn.setAtt("gpo_2","tit","Consecionarios");								}else if(tipoOper &= consGruposFolio){ 					frn.set("inp_titulo","Catálogo de Grupos Folio");					frn.setAtt("gpo_2","tit","Grupos Folio");								}else if(tipoOper &= consSuspensiones){ 					frn.set("inp_titulo","Catálogo de Suspensiones");					frn.setAtt("gpo_2","tit","Suspensiones");								}else if(tipoOper &= consTipoVehiculos){ 					frn.set("inp_titulo","Catálogo de Tipo Vehiculos");					frn.setAtt("gpo_2","tit","Tipo Vechiculos");								}else if(tipoOper &= consPaquetes){ 					frn.set("inp_titulo","Catálogo de Paquetes");					frn.setAtt("gpo_2","tit","Paquetes");				}else if(tipoOper &= consAjusteCosto){ 					frn.set("inp_titulo","Ajuste de Costo");					frn.setAtt("gpo_2","tit","Ajuste de Costo");				}else if(tipoOper &= consInvAutos){ 					frn.set("inp_titulo","Inventario de Autos");					frn.setAtt("gpo_2","tit","Inventario de Autos");														}else if(tipoOper &= consPartes){ 					frn.set("inp_titulo","Inventario Piezas Originales");					frn.setAtt("gpo_2","tit","Inventario Piezas Originales");				}else if(tipoOper &= consClasifPagos){ 					frn.set("inp_titulo","Catálogo Clasificación de Pagos");					frn.setAtt("gpo_2","tit","Catálogo Clasificación de Pagos");				}else if(tipoOper &= consCuentasUnidades){ 					frn.set("inp_titulo","Catálogo Cuentas de Unidades");					frn.setAtt("gpo_2","tit","Catálogo Cuentas de Unidades");				}else if(tipoOper &= consAnio){ 					frn.set("inp_titulo","Catálogo Año");					frn.setAtt("gpo_2","tit","Catálogo Año");				}else if(tipoOper &= consDupPaq){ 					frn.set("inp_titulo","Catálogo Duplica Paquete");					frn.setAtt("gpo_2","tit","Catálogo Duplica Paquete");				}else if(tipoOper &= consSucursal){ 					frn.set("inp_titulo","Catálogo Sucursales");					frn.setAtt("gpo_2","tit","Catálogo Sucursales");				}else if(tipoOper &= consTisan){  					frn.set("inp_titulo","Catálogo TISAN");					frn.setAtt("gpo_2","tit","Cátalogo TISAN");				}else if(tipoOper &= consPorcentajes){  					frn.set("inp_titulo","Catálogo Porcentajes");					frn.setAtt("gpo_2","tit","Catálogo Porcentajes");				}else if(tipoOper &= consUnidades){  					frn.set("inp_titulo","Catálogo Unidades");					frn.setAtt("gpo_2","tit","Catálogo Unidades");				}else if(tipoOper &= consMotivosCancelacionCitas){  					frn.set("inp_titulo","Catálogo Motivos Cancelación de Citas");					frn.setAtt("gpo_2","tit","Catálogo Motivos Cancelación de Citas");				}else if(tipoOper &= consKdtvr2){  					frn.set("inp_titulo","Catálogo de Partes Toyota (Kdtvr2)");					frn.setAtt("gpo_2","tit","Cátalogo de Partes Toyota (Kdtvr2)");				}else if(tipoOper &= consSerie){  					frn.set("inp_titulo","Catálogo de Series");					frn.setAtt("gpo_2","tit","Catálogo de Series");				}else if(tipoOper &= consClasPaq){  					frn.set("inp_titulo","Catálogo de Clasificacion de paquetes");					frn.setAtt("gpo_2","tit","Catálogo de Clasificacion de paquetes");				}else if(tipoOper &= consReem){  					frn.set("inp_titulo","Catálogo de Reemplazos");					frn.setAtt("gpo_2","tit","Reemplazos");				}else if(tipoOper &= consVEsqVeh){  					frn.set("inp_titulo","Esquemas de comisión por Vehículo");					frn.setAtt("gpo_2","tit","Esquemas de comisión por Vehículo");				}else if(tipoOper &= consAsesoresTMKT){ 					frn.set("inp_titulo","Asesores TMKT");					frn.setAtt("gpo_2","tit","Asesores TMKT");								}else if(tipoOper &= consHorariosNoDispTaller){ 					frn.set("inp_titulo","Horarios No Disponibles Taller");					frn.setAtt("gpo_2","tit","Horarios No Disponibles Taller");								}else if(tipoOper &= consKddinv){ 					frn.set("inp_titulo","Inventario");					frn.setAtt("gpo_2","tit","Inventario");				}else if(tipoOper &= consConPres){  					frn.set("inp_titulo","Catálogo de Conceptos de Presupuesto");					frn.setAtt("gpo_2","tit","Catálogo de Conceptos de Presupuesto");				}else if(tipoOper &= consGpContra){  					frn.set("inp_titulo","Grupos de Gastos Internos");					frn.setAtt("gpo_2","tit","Grupos de Gastos Internos");				}else if(tipoOper &= consGpGastos){  					frn.set("inp_titulo","Catalogo de Grupos de Gastos");					frn.setAtt("gpo_2","tit","Catalogo de Grupos de Gastos");				}else if(tipoOper &= consLealtad){ 					frn.set("inp_titulo","Configuracion Lealtad");					frn.setAtt("gpo_2","tit","Configuracion Lealtad");														}else{					frn.message("Acción no permitida.","Error","&Aceptar");					frn.open("redirect",2);					return;				}								//Establecer titulo de ventana de acion				if (accion &= NUEVO){					frn.setAtt("gpo_2","tit","Nuevo registro");								}												if (accion &= MODIFICAR){					frn.setAtt("gpo_2","tit","Modificar registro");								}				if (accion &= ELIMINAR){					frn.setAtt("gpo_2","tit","Eliminar registro");								}				if (accion &= CONSULTAR){					frn.setAtt("gpo_2","tit","Consultar registro");								}															}								fun Inicializa(){				mostrarRegistros = "S";				//Establecer variable para mostrar registros en primera busqueda				if (tipoOper &= consInvAutos || tipoOper &= consSerie){								mostrarRegistros = "N";				}				frn.rst("gpo_2");				Encabezados();				Inicia_Forma();				mostrarRegistros = "S";			}				fun Inicia_Forma(){				//Etiquetas 				frn.set("inp_mensaje","No se encontraron registros...");				//frn.set("inp_titulo",strTitulo);				frn.set("inp_filtros","Búsqueda");											//Llenar combo sucursales				var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}									var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						var ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));																//Obtencion de registros				Buscar_Registros();			}			fun valida_offset(n_reg_tabla){				var txt = "Mostrando registros del " & (offset+1) & " al " & offset + 100 & " de " & n_reg_tabla;				if (offset <= 0) {											frn.setAtt("banterior", "available", "N" );					frn.setAtt("banterior", "modify", "N" );					frn.setAtt("banterior", "visible", "N" );				}else{					frn.setAtt("banterior", "available", "Y" );					frn.setAtt("banterior", "modify", "Y" );					frn.setAtt("banterior", "visible", "Y" );				}								if (offset+100 >= n_reg_tabla){										frn.setAtt("bsiguiente", "available", "N" );					frn.setAtt("bsiguiente", "modify", "N" );					frn.setAtt("bsiguiente", "visible", "N" );					txt = "Mostrando registros del " & (offset+1) & " al " & n_reg_tabla & " de " & n_reg_tabla;								}else{					frn.setAtt("bsiguiente", "available", "Y" );					frn.setAtt("bsiguiente", "modify", "Y" );					frn.setAtt("bsiguiente", "visible", "Y" );				}				if (mostrarRegistros &= "S"){					frn.set("reg_mostrados", txt);				}			}//-----------------------------------------------------agregar el cms sql a ejecutar por catalogo --------------------------------------------------------------------			fun Buscar_Registros(pag){				var cmd, mensajeError,ok,nReg, colCriterio,criterio,expWhere,expOrder,sucursal_id, n_reg_tabla;				if (pag==0){					offset=0;				}				offset = offset+pag;				kdb.rst();				frn.rst("results");				colCriterio=frn.get("k_filtros",-1,0);				criterio=frn.get("k_busqueda");				sucursal_id = frn.get("k_sucn",-1,1);				if (tipoOper &= consVarios){ //AGREGAR UN ELSE IF DONDE SE GUARDARA EL CMD SLQL A EJECUTAR					strQuery = "select c1 as k_clave,							c2 as k_descrip,							c3 as k_precio							from keplersc.KDCARTALL order by c1";				}				else if (tipoOper &= consAutos){					strQuery = "select c1 as k_clave,c2 as k_desc,							c4 as k_clase,c5 as k_marca,c6 as k_isa,c7 as k_linea,c8 as k_nou,c10 as k_meses_entrega,c11 as k_prduce,c14 as k_precio_list,							c50 as k_cilindros,c51 as k_ocupantes,c52 as k_procedencia,c53 as k_combustible,c54 as k_n_puertas from keplersc.kdiv";				}				else if (tipoOper &= consClases){					strQuery = "select c1 as k_clave,							c2 as k_descrip							from keplersc.KDIC order by c1";				}				else if (tipoOper &= consMarca){					strQuery = "select c1 as k_clave,							c2 as k_descrip							from keplersc.KDMARCA order by c1";				}				else if (tipoOper &= consIsan){					strQuery = "select c1 as k_clave,							c2 as k_descrip							from keplersc.KDTISAN order by c1";				}				else if (tipoOper &= consLinea){					strQuery = "select c1 as k_clave,							c2 as descripcion							from keplersc.KDIVL order by c1";				}				else if (tipoOper &= consProveedores){					strQuery = "select c2 as k_clave, c3 as k_nombre							from keplersc.KDXD order by c2";				}				else if (tipoOper &= consExterior){					strQuery = "select c1 as k_clave,							c3 as color, c4 as descripcion 							from keplersc.KDICE2 order by c1,c3";				}				else if (tipoOper &= consInterior){					strQuery = "select c1 as k_clave,							c3 as color, c4 as descripcion 							from keplersc.KDICE3 order by c1,c3";				}				else if (tipoOper &= consCoachesobjmens){					strQuery = "select c1 as k_clave, c2 as k_nombre,								c3 as k_usuario, c4 as k_status, c5 as k_clave_2, c6 as k_esquema							from keplersc.kdcatcoach where c5='" & sucursal_id & "' order by c1, c3";				}				else if (tipoOper &= consNotaCargo){					strQuery = "select c1 as k_clave,							c2 as cve_sat, c3 as descripcion, c4 as unidad							from keplersc.kdncargocat order by c1,c2";				}				else if (tipoOper &= consVehiculo){					strQuery = "select c1 as k_clave,							c2 as descripcion							from keplersc.kdiv order by c1";													} else if (tipoOper &= consRecep){					strQuery = "select c1 as k_clave, c2 as nombre, c11 as activo 							from keplersc.kdrecep order by c1";												} else if (tipoOper &= consOper){					strQuery = "select c1 as k_clave, c3 as nombre 							from keplersc.kdoper order by c1";						} else if (tipoOper &= consClasPag){					strQuery = "select c1 as k_clave, c2 as descripcion, c3 as hr_base, c5 as sueldo_base,						c6 as Pr_Ord_Norm, c7 as Pr_Ord_Gar, c8 as Pr_Ord_Int, c9 as Pr_Ord_Prev, c10 as Pr_Ord_Rec, 						c4 as Tar_1, c11 as Esc_1,						c12 as Tar_2, c13 as Esc_2, 						c14 as Tar_3, c15 as Esc_3, c16 as Tar_Ult_Esc  						from keplersc.kdclaspag order by c1";								}else if (tipoOper &= consTipoOperarios){					strQuery = "select c1 as k_clave,							c2 as descripcion							from keplersc.kdtoper order by c1";							}				else if (tipoOper &= consModelo){					strQuery = "select c1 as cve_marca,							c2 as k_clave, c3 as descripcion							from keplersc.kdmodelos order by c1";							}				else if (tipoOper &= consConsecionario){					strQuery = "select c1 as k_clave,							c2 as descripcion							from keplersc.kdconc order by c1";					}				else if (tipoOper &= consGruposFolio){					strQuery = "select c2 as k_clave, c3 as folio, c4 as descripcion							from keplersc.kdgruposfolio where c1='" & sucursal_id & "'  order by c2";					}				else if (tipoOper &= consSuspensiones){					strQuery = "select c1 as k_clave,							c2 as k_desc, c3 as refaccion							from keplersc.kdsusp order by c1";					}				else if (tipoOper &= consTipoVehiculos){					strQuery = "select c1 as k_clave,							c2 as k_desc							from keplersc.kdtipoveh order by c1";					}else if (tipoOper &= consPaquetes){					strQuery = "select c1 as k_clave,							c2 as k_desc, c3 as k_clas_paquete, c4 as k_clas_horas							from keplersc.kdcatpaq order by c1";					}else if (tipoOper &= consAjusteCosto){					strQuery = "select vta.c100 as inventario, vta.c2||'-'||vta.c3||'-'||vta.c4||'-'||vta.c5||'-'||vta.c6 as movvta,						vta.c9 as fecha_vta,vta.c16 as importe_venta, vta.c14 as iva_venta,						mc.c2||'-'||mc.c3||'-'||mc.c4||'-'||mc.c5||'-'||mc.c6 as movcompra,mc.c9 as fecha_compra, 						mc.c16 as importe_compra, mc.c14 as iva_compra,						val.c2||'-'||val.c3||'-'||val.c4||'-'||val.c5||'-'||val.c6 as movvale,val.c9 as fecha_vale						from keplersc.kdm1 vta 						left outer join keplersc.kdm1 mc on vta.c1=mc.c1 and vta.c100=mc.c100						and mc.c2='X' and mc.c3='A' and (mc.c4=6 or mc.c4=7) 						left outer join keplersc.kdm1 val on vta.c1=val.c1 and vta.c100=val.c100						and val.c2='N' and val.c3='A' and val.c4=13 						where vta.c1='" & sucursal_id & "' and vta.c2='U' and vta.c3='D' and vta.c4=6 						and vta.c6 not in (select mexv.c39 from keplersc.kdm1 mexv where vta.c1=mexv.c1 and vta.c6=mexv.c39)						and mc.c6 not in(select kexc.c39 from keplersc.kdm1 kexc where kexc.c1=mc.c1 and mc.c6=kexc.c39)						and val.c43 <>'C'";				}else if (tipoOper &= consInvAutos){					strQuery = "select c2 as inventario, c3 as clave_vehiculo , c4 as descripcion, 						c5 as serie, c6 as motor,	c8 as trans, c90 as Procedencia, c91 as Ocupantes, c92 as Cilindros, c93 as Puertas, 						c2 as k_clave, c21 as k_tipo							from keplersc.kdinf where c1='" & sucursal_id & "' order by c1,c2";					}else if (tipoOper &= consPartes){					strQuery = "select c1 as k_clave, c2 as k_descripcion , c8 as k_grupo								from keplersc.kdini";					}else if (tipoOper &= consClasifPagos){					strQuery = "select c1 as k_clave, c2 as k_descripcion								from keplersc.kdclaspag";					}else if (tipoOper &= consCuentasUnidades){					strQuery = "select m.c1 as k_clave, k.c2 as k_descripcion, m.c2 as k_anio, m.c3 as k_suc from keplersc.kdivcl m								inner join keplersc.kdiv k on k.c1 = m.c1";					}else if (tipoOper &= consAnio){					strQuery = "select c1 as k_clave, c2 as k_descripcion								from keplersc.kdanio";					}else if (tipoOper &= consDupPaq){					strQuery = "select c1 as k_clave, c2 as k_modelo, c4 as k_clave_paq, c5 as k_descrip								from keplersc.kdspaq";					}else if (tipoOper &= consSucursal){					strQuery = "select c1 as k_clave, c2 as k_desc								from keplersc.kdms";				}else if (tipoOper &= consTisan){					strQuery = "select c1 as k_clave, c2 as k_desc								from keplersc.kdtisan";				}else if (tipoOper &= consPorcentajes){					strQuery = "select c1 as k_clave, c2 as com_seg, c3 as com_g_ext, c4 as utl_accs, c5 as otros								from keplersc.kdvpor";				}else if (tipoOper &= consUnidades){					strQuery = "select c1 as k_clave, c2 as k_desc								from keplersc.kdinu";				}else if (tipoOper &= consMotivosCancelacionCitas){					strQuery = "select c1 as k_clave, c2 as k_desc, c3 as k_estatus								from keplersc.kdmotivoscancelacioncitas";				}else if (tipoOper &= consKdtvr2){					strQuery ="select c1 as k_clave, c3 as k_desc								from keplersc.kdtvr2								";				}else if (tipoOper &= consSerie){					strQuery = "select s.c1 as identificador,s.c2 as marca,s.c3 as modelo,s.c4 as serie,s.c10 as color,s.c11 as año,s.c8 as placas,s.c9 as contacto,ud.c3 as nombre_contacto								from keplersc.kdserie s								left join keplersc.kdud ud on ud.c2=s.c9";				}else if (tipoOper &= consClasPaq){					strQuery = "select c1 as k_clave,							c2 as descripcion							from keplersc.kdclaspaq order by c1";				}else if (tipoOper &= consReem){					strQuery = "select r.c2 as clave_original, i.c2 as descripcion, 						(select cadena_reemplazo from keplersc.prod_cadena_reemplazo(r.c1)) 						from keplersc.kdinr r 						inner join keplersc.kdini i on i.c1=r.c2						order by r.c2";																		}else if (tipoOper &= consVEsqVeh){					strQuery = "select c1 as sucursal, c2 as tipo_esquema, c3 as tipo_operacion, c4 as tipo_auto, c5 as tipo_comision							from keplersc.kdvesqveh order by c1,c2,c3,c4,c5";				}else if (tipoOper &= consAsesoresTMKT){					strQuery = "select c1 as k_clave, c2 as descripcion, c3 as estatus from keplersc.kdsercattmkt " &							" where col_sucursal='" & frn.get("k_sucn",-1,1) & "' order by c1 ";							}else if (tipoOper &= consHorariosNoDispTaller){					strQuery = "select sucursal, fecha, horario_nodisp_inicio, horario_nodisp_fin from keplersc.horario_nodisp_taller " &							" where sucursal='" & frn.get("k_sucn",-1,1) & "' order by fecha desc ";							}else if (tipoOper &= consKddinv){					strQuery = "select c1 as clave, c2 as descr, c3 as anio, c4 as id , c6 as consecutivo, c7 as nuevo_usado from keplersc.kddinv "	;				}else if (tipoOper &= consConPres){					strQuery = "select cve_concepto as clave, descripcion							from keplersc.kdcatconpres 							where sucursal='" & sucursal_id & "' order by cve_concepto";				}else if (tipoOper &= consGpContra){					//UPD by JMM 20241101 field.name, Added Data 20241104 					strQuery = "select gp.grupo_id as grupo_id, to_char(gp.fecha_registro,'DD-MM-YYYY') as fecha_registro, k.c3 as proveedor, gp.descripcion, gp.importe_asignado, gp.importe_comprobado, estatus  							from keplersc.kdgpcontra gp inner join keplersc.kdxd k on gp.proveedor_id = k.c2 							where sucursal_id='" & sucursal_id & "' order by grupo_id";					}else if (tipoOper &= consGpGastos){					strQuery = "select idgpo as grupo_id, descripcion							from keplersc.kdgpgastos";				}else if (tipoOper &= consLealtad){					strQuery = "select c1 as ident,  c2 as suc, c3 as porcentaje_1, c4 as porcentaje_2, c5 as porcentaje_3, c6 as porcentaje_4 from keplersc.kdconflealtad";											}else{					frn.message("Definir Catalogo.","Error","&Aceptar");					frn.open("redirect",2);					return;				}	 				cmd = "select * from (" & strQuery & ") as resultado " ;				if (colCriterio &! "" && criterio &! ""){					expWhere = frn.get("k_filtros",-1,0);					expWhere = " where " & expWhere & "::text like '%" & frn.get("k_busqueda") & "%' ";					expOrder = " order by " & frn.get("k_filtros",-1,0);				}								cmd = cmd & expWhere & expOrder ;				n_reg_tabla = "SELECT COUNT(*) FROM ("& cmd &") AS subconsulta";				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",n_reg_tabla,"gencatalogoview.buscar_registros()");				frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\registros");				n_reg_tabla = getXmlAtt(cuboXml,"r0","count");				valida_offset(n_reg_tabla);				cmd = cmd & " LIMIT 100 OFFSET " & offset;				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"gencatalogoview.buscar_registros()");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}					//frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\cuboPrueba");				Encabezados();				if (mostrarRegistros &= "S"){					frn.set("results",cuboXml);					nReg=nXml(cuboXml);					regTotales = nReg;					if(nReg>0){						frn.set("inp_mensaje","");					}else{						frn.message("No se encontraron registros.","Mensaje","Aceptar");					}					frn.rst("k_filtros");							}				llenar_filtro_busqueda(cuboXml,"k_filtros");					frn.setPos("k_filtros",0,0,"internal:Y","val:" & colCriterio);				frn.set("k_filtros",colCriterio);		//mss seleccione el ultimo criterio								}			fun llenar_filtro_busqueda(cuboResultados, cmb)			{					var valor;				var encabezados = getXmlAtt(cuboXml,"k_ColName");				var len_cubo = 1000;				var pos_ini = frn.N(cmb)+1;				frn.setX("", cmb, 0,0);				for (var cont=0; cont<len_cubo ; cont++)				{										valor = strSplit(encabezados,",",cont);										if(valor &! ""){						frn.setX(valor, cmb, cont+pos_ini,0);					}					else{						cont = len_cubo;					}				}							}						fun IniCombos(ctrl_combo, query){				var cmd, mensajeError,ok;				cmd = query;				rstXml(cuboXml);				cuboXml = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"gencatalogoview.IniCombos()");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboXml,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set(ctrl_combo,cuboXml);			}			//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------						fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>