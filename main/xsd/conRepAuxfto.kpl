<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" dim="0,0,10,10" tit="Reporte auxiliar" scale="57"><grp dim="0,0,10,20" clr="0,0,0" bclr="255,255,255" fnt="Tahoma,15" unfont="0">		<br exe="encabezado"/>		<hLine dim="100,0" g="2" type="1"/>		<br exe="encabezado"/>		<grp dim="10,7,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>		<tab n="1"/>		<grp dim="62,5,7,12">			<br/>			<inp id="k_empresa" fnt=",20b" dim="80,1" clr="0,58,112" type="string" available = "N"/>			<br/>			<txt fnt=",16b" clr="0,58,112">Reporte Auxiliar de la fecha </txt>			<inp id="k_fecha_ini" fnt=",16b" dim="12,1" clr="0,58,112" type="date" just="C" fmt="DD/MM/CCYY" available = "N" nc="-1"/>			<txt fnt=",16b" clr="0,58,112">  a la fecha </txt>			<inp id="k_fecha_fin" fnt=",16b" dim="12,1" clr="0,58,112" type="date" just="C" fmt="DD/MM/CCYY" available = "N" nc="-1"/>			<br/>				<inp id="k_sucursal" fnt=",16b" dim="80,1" clr="0,58,112" type="string" available = "N"/>			<br/>		</grp>		<tab n="5"/>		<grp dim="20,5,7,12">			<br/>			<txt>P&#225;g:</txt><tab/><inp id="k_pag" dim="4,1" type="number" just="L" mcr="k_pag"/>			<br/>			<txt>Fecha:</txt><inp id="k_fecha_imp" dim="10,1" type="date" just="L" fmt="DD-MM-CCYY" nc="-1"/>			<br/>			<txt>Hora:</txt><tab n="1"/><inp id="K_hora_imp" dim="6,1" type="time" just="L" nc="-1"/>		</grp>		<br exe="encabezado"/>		<sp/><txt fnt=",-1b">Cuenta</txt>		<inp id="k_numero_cuenta"  dim="15,1" type="text" mcr="k_cuenta">000-000-000-000</inp>		<tab/><inp id="k_desc_cuenta"  dim="25,1" type="string" mcr="k_desc_cuenta">Este es un ejemplo descripcion</inp>		<br exe="encabezado_cuenta"/>		<sp/><txt fnt=",-1b">P&#243;liza</txt>		<tab n="1"/><txt fnt=",-1b">Fecha</txt>		<tab n="5"/><txt fnt=",-1b">S</txt>		<sp/><txt fnt=",-1b">Documento</txt>		<tab n="6"/><txt fnt=",-1b">Usuario</txt>		<tab n="2"/><txt fnt=",-1b">Descripci&#243;n</txt>		<tab n="3"/><txt fnt=",-1b">Debe</txt>		<tab n="2"/><txt fnt=",-1b">Haber</txt>		<tab n="2"/><txt fnt=",-1b">Saldo</txt>					<br exe="encabezado_cuenta"/>		<hLine dim="100,0" g="2" type="1"/>		<br exe="encabezado"/>		<tab n="18"/><txt fnt=",12b">Saldo Inicial</txt>		<tab n="10"/>	<inp id="k_saldo_ini" dim="10,1" type="number" fnt=",12b" modify="N" available="N" nd="2"/>		<br exe="encabezado_cuenta"/>	<sp/><inp id="k_tipo_poliza" dim="1,1" fnt=",12" type="string"/><tab/>	<inp id="k_n_poliza" dim="3,1" fnt=",12" type="string" modify="N" available="N" just="C"/>	<inp id="k_fecha_poliza" dim="6,1" fnt=",12" type="date" fmt="DD-MM-CCYY" nc="-1"/>	<sp/><inp id="k_ref_poliza" dim="10,1" fnt=",12" type="string"/>	<inp id="k_suc_poliza" dim="2,1" fnt=",12" type="string"/>	<inp id="k_folio_poliza" dim="10,1" fnt=",12" type="string"/>	<inp id="k_desc_mov" dim="13,1" fnt=",12" type="string"/>	<sp/>	<inp id="k_usuario" dim="8,1" fnt=",12" type="string"/>	<inp id="k_desc_poliza" dim="15,1" fnt=",12" type="string"/><tab/>	<inp id="k_debe" dim="8,1" fnt=",12" type="number" nd="2"/>	<sp/>	<inp id="k_haber" dim="8,1" fnt=",12" type="number" nd="2"/>	<sp/>	<inp id="k_saldo_fin" dim="7,1" fnt=",12" type="number" nd="2"/>	<br exe="detalle"/>	<tab n="18"/><txt fnt=",12b">Sumas</txt>	<tab n="3"/><sp/><tab n="3"/><inp id="k_suma_cargo" dim="8,1" fnt=",12" type="number" nd="2"/><tab/><inp id="k_suma_abono" dim="8,1" fnt=",12" type="number" nd="2"/>	<br exe="detalle_fin"/>		<tab n="18"/><txt fnt=",12b">Saldo Final</txt><tab n="10"/>	<inp id="k_suma_saldo" dim="10,1" type="number" modify="N" available="N" fnt=",12b" nd="2"/>	<br exe="detalle_fin"/>	<hLine dim="100,0" g="1" type="1"/>	<br exe="detalle_fin"/>	</grp></pag>