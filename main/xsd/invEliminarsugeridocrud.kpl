<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo"><grp dim="40,20,15,15" 	  brdr="0,0" 	  clr="0,58,112" 	  bclr="192,205,213" 	  fnt="Arial,16" 	  unfont="0" id="Principal"><br/>			<tab/>			<grp bclr="236,240,243" 			fntClrBrdr="255,206,0" 			fntBrdr="Arial,18" 			hSpace="4" 			clrBrdr="0,58,112" 			brdr="0,5" 			dim="35,25,9,9" 			tit="Eliminar Sugerido"			fnt="Arial,16">				<br/>				<tab n="4"/><txt> Sucursal : </txt>				<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  						dim="32,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  						Null="N"  available="Y" OnChange="CargarPedidoSugerido(0)"/><br/>				<br/>				<tab n="1"/><txt>	N&#250;mero de pedido : </txt>				<tab n="2"/><inp id="k_numeroPedido_A6" dim="12,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="Y"				 OnEnter="CargarPedidoSugerido(1)"/><br/>				<tab n="1"/><txt>Fecha creaci&#243;n : </txt>				<tab n="2"/><inp id="k_fechaCreacion_A2" dim="12,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="N" available="Y"/><br/>				<tab n="1"/><txt>Estatus del periodo : </txt>				<tab n="2"/><inp id="k_estatusPedido_A3" dim="12,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="N" available="Y"/><br/>				<br/>				<br/>				<tab n="10"/><bot id="btn_aceptar_A100" dim="9,0" brdr="5" text="Continuar" default="1" visible="Y" available="Y" OnEnter="Execute(1)"/>				<br/>			<br/>			</grp></grp>	<script>		InstallDriver("KDB75");		class Main {						var frn,kdb,frP,externo,accion,suc_usuario,perfil_usuario ;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();				ctlrs_off();				llenar_ctlrs_default();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				Inicializa();			}			fun Inicializa()			{				frn.setX(1,"k_cicloReorden_A1");							}						fun ctlrs_off()			{								frn.setAtt("btn_cancelar", "visible", "Y" );				//frn.setAtt("btn_cancelar", "visible", "Y" );				frn.setAtt("btn_aceptar", "visible", "Y" );			}						fun llenar_ctlrs_default()			{				frn.rst("principal");				accion = frn.param(0);				var xmlRequest,					 cmd,					 ok, 					 cuboResultados,					 mensajeError;								frn.setAtt("principal", "tit", accion );								cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_InvPedSug.llenar_ctlrs_default()");				ok = getXmlAtt(cuboResultados ,"ok");				if(ok &! "" && !ok)				{				   mensajeError = getXmlAtt(cuboResultados ,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucN",getXml(cuboResultados));			}						fun CargarPedidoSugerido(piOpcion)			{				var v_sucursal_A1, 						v_numeroPedido_A6,						cmd,cuboResultados,ok, mensajeError,						fecharesultado,						estadoresultado;				if(piOpcion == 1)				{					v_numeroPedido_A6 = PadLeft(frn.get("k_numeroPedido_A6"),10,"0"); //0000000001 					frn.setX(v_numeroPedido_A6,"k_numeroPedido_A6");					v_sucursal_A1 = frn.get("k_sucN", -1, 1);					cmd = "select * from keplersc.kdpedref where c1 = '" & v_sucursal_A1 & "' AND c2 = '" & v_numeroPedido_A6 & "'";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_InvPedSug.llenar_ctlrs_default()");					ok = getXmlAtt(cuboResultados ,"ok");										if(ok &! "" && !ok)					{					   mensajeError = getXmlAtt(cuboResultados ,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\CargarPedidoSugerido");					fecharesultado=getXmlAtt(cuboResultados,"r0", "c3");					frn.set("k_fechaCreacion_A2",fecharesultado);					estadoresultado = getXmlAtt(cuboResultados,"r0", "c4");															if(estadoresultado == 0 )					{					   frn.set("k_estatusPedido_A3", "ELIMINADO");					   frn.message("Este pedido sugerido ya ha sido previamente eliminado","Información","Aceptar");					   frn.setAtt("btn_aceptar", "visible", "N" );					}					else if(estadoresultado == 10 )					{						frn.set("k_estatusPedido_A3", "EDITABLE");						frn.setAtt("btn_aceptar", "visible", "Y" );					}					else if (estadoresultado == 20 )					{						frn.set("k_estatusPedido_A3", "SOLICITADO");						frn.message("Este pedido sugerido ya sido solicitado y no puede ser eliminado.","Información","Aceptar");						frn.setAtt("btn_aceptar", "visible", "N" );						return;					}					else					{							frn.message("El pedido sugerido indicado no existe","Error","Aceptar");						frn.setAtt("btn_aceptar", "visible", "N" );						return;					}				}			}			fun Validaciones(psOpcion)			{				var v_estatus_A3;															v_estatus_A3 = frn.get("k_estatusPedido_A3");					if(v_estatus_A3 != "ELIMINADO")					{						frn.message("Este pedido sugerido ya ha sido previamente eliminado", "ADVERTENCIA","&Aceptar");						return 0;					}										if(v_estatus_A3 != "SOLICITADO")					{						frn.message("Este pedido sugerido ya ha sido solicitado y no puede ser eliminado.", "ADVERTENCIA","&Aceptar");						return 0;					}									return 1;			}//end fun Validaciones						fun PadLeft(pText,pRelleno,pCaracterRelleno)			{				var Resultado;				var pos_ini = pText;				var nReg= strlen(pText);				for (var cont = nReg; cont < pRelleno; cont++)				{					Resultado = pCaracterRelleno & Resultado;				}				Resultado = Resultado & pText;				//frn.message(Resultado ,"Información","Aceptar");				return Resultado;			}						fun Execute(pIOpcion)			{				var xmlRequest,						cmd,						ok, 						cuboResultados,						mensajeError,						sucursal,						fecha_r1, //fecha						fechames_r2 = 0, //mes						fechaanio_r3 = 0, //año						strTmp,						xmlPantalla,						cubo,						resultado,						mensaje,						tip_ope,						mensaje,						k_cicloReorden_A1,						k_leadTime_A2,						k_MaxFluleTime_A3,						k_TasaServicio_A4,						k_StockSeg_A5;								if(pIOpcion == 1) // GUARDAR				{					if(Validaciones()<=0)					{						return;					}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;										kdb.rst(cuboResultados);										cuboResultados  = getXml(frn.dataPag()); //Obtener el xml de la pantalla;										setXml(cuboResultados,"k_sucN","02");										//frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\sqlXmlResultadoeliminar");										cmd = "SELECT * FROM keplersc.cat_pedidosugerido_eliminasugerido_crud('<document>" & getXmlStr(cuboResultados,"EOF:13_10") & "</document>')";					kdb.rst(cuboResultados);					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"cat_InvPedSugParaGen.Execute");									ok = getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok)					{											mensajeError = getXmlAtt(cuboResultados,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										resultado= getXml(cuboResultados,"resultado");					mensaje= getXml(cuboResultados,"mensaje");										if(resultado &= "1")					{						frn.message(mensaje, "Registro eliminado.","&Aceptar");					}else{						frn.message(mensaje, "Error","&Aceptar");					}														}	//end opcion 0			}//end fun Execute											}	</script></pag>