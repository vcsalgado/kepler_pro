/><sp/><txt>Medio preferido de contacto: </txt>			<inp id="medio_preferido_prop" dim="15,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnF9="ObtenerMedPrefProp()" OnChange="BuscarMedPref(medio_preferido_prop,desc_medio_preferido_prop)" type="capital" nc="5" tooltip="Clave Medio Preferido de Contacto"  brdr="0,2"/>			<sp/>			<inp id="desc_medio_preferido_prop" dim="15,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="capital"  brdr="0,2"/>			<tab n="2"/><txt>Num. preferido: </txt>			<inp id="num_preferido_prop" dim="25,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" type="string"  brdr="0,2"/>			<br/>			<tab/><sp/><txt>Tipo snack:  </txt>			<edt id="tipo_snack_prop" dim="12,1" brdr="0,2" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" tooltip="Tipo de snack preferido"/><sp/>			<inp id="desc_snack_prop" dim="40,1" brdr="0,2" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="40" tooltip="Descripcion de snack preferido"/>			<tab/><txt>Tipo bebida: </txt>			<edt id="tipo_bebida_prop" dim="12,1" brdr="0,2" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" tooltip="Tipo de bebida preferida"/><sp/>			<inp id="desc_bebida_prop" dim="40,1" brdr="0,2" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="40" tooltip="Descripcion de bebida preferida"/><br/><br/>			</grp>			<br/>			<br/>			<tab n="2"/>			<grp id="grpVehiculo" dim="135,6,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" fntBrdr="Arial,18"  clrBrdr="0,58,112" brdr="0,5"  tit="Datos del vehiculo"  fnt="Arial,16" available="Y" modify="Y">			<tab/><sp/><txt>Serie:</txt>			<inp id="serie" dim="20,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string"  brdr="0,2" modify="N"			tooltip="Nuevo F10" OnF10="edicion_vin(Nuevo)"/>			<sp/><txt>Marca:</txt>			<inp id="marca" dim="15,1" tooltip="Marca"   modify="N" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<sp/><txt>Modelo:</txt>			<inp id="modelo" dim="74,1" tooltip="Modelo"   modify="N" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string"  brdr="0,2"/>			<br/>			<sp n="2"/><tab/><txt> A&#241;o:</txt>			<inp id="anio" dim="8,1" nc="4" bclr="192,205,213" modify="N" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<sp/><txt>Color:</txt>			<inp id="color" dim="25,1" bclr="192,205,213" modify="N" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/>			<sp n="2"/><txt>Codigo:</txt>			<inp id="codigo" dim="12,1" bclr="255,255,255" modify="Y"  clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="15" brdr="0,2" available="Y"/>						<tab/><sp/><txt>Kms:</txt>			<inp id="kms" dim="9,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2"/><tab/><txt>Placas:</txt>			<inp id="placas" dim="9,1" bclr="255,255,255" modify="Y" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="10" brdr="0,2"/><tab/><txt>Concesionario: </txt>			<inp id="concesionario" dim="15,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" modify="N" type="capital"  brdr="0,2"/>			<br/><br/>			</grp>						<br/><br/>			<tab n="38"/>			<bot id="Aceptar" dim="20,0" brdr="5"  OnEnter="Alta()"  text="Aceptar" default="0" visible="Y"/>			<br/>		<tab n="4"/></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb, sys, rep, frP;			var tip_ope,suc_usuario,modulo_origen,folio_cit, perfil_usuario,asterisco,cli,vn,inv,rol_usuario;			var hora_limite_semana,hora_limite_sabado,hora_limite_domingo ,usuario,folio_tmkt;			var folio,kodawari,resVal;			var xmlRequest ,cmd, cubo,ok ,mensajeError;						fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();				sys=new SYS;				rep=new REP;				frP=new FRNTP;			   usuario = frn.config("user","name");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				rol_usuario = frn.config("user","role");				asterisco = "*";							//PARAMETROS				tip_ope=trim(frn.param(0));				ctrls_off();				Inicializa();							}					fun ctrls_off() {				frn.setAtt("Aceptar", "visible", "N" );				frn.setAtt("Inv_txt", "visible", "N" );				frn.setAtt("Cve_TMKT", "available", "N" );				frn.setAtt("buscadores", "visible", "N" );				frn.setAtt("cve_inv", "visible", "N" );												frn.setAtt("vin", "visible", "N" );				frn.setAtt("clave_cliente", "visible", "N" );								frn.setAtt("txt_cve_inv", "visible", "N" );															frn.setAtt("cliente_id", "modify", "N" );				frn.setAtt("serie", "modify", "N" );						if (tip_ope == 0){					botones_alta();				}else{					botones_modificar();				}						}											fun botones_alta(){				frn.setAtt("Aceptar", "visible", "Y" );				frn.set("tit_text", "Evento de Bienvenida");			}						fun botones_modificar(){				frn.set("tit_text", "Evento de Bienvenida");				frn.setAtt("Aceptar", "visible", "Y" );				frn.setAtt("Inv_txt", "visible", "Y" );				frn.setAtt("buscadores", "visible", "Y" );				frn.setAtt("cve_inv", "visible", "Y" );				frn.setAtt("txt_cve_inv", "visible", "Y" );						}						fun bloquear_modificacion{				frn.setAtt("Aceptar", "visible", "N" );							}					fun Inicializa(){				kdb.kde("KDE");//						kdb.exec();							//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvbienvenida.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));				frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));							//Llena combo atendio				LlenaComboAtendio();				SetAtendio();				//Llenar Tipo snack y tipo bebida				cmd = "select C2 as descripcion, c1 as clave from keplersc.kdsertiposnack";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvbienvenida.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						   				frn.setX("","tipo_snack",0,0);				llenar_cmb(cubo ,"tipo_snack");				frn.setX("","tipo_snack_prop",0,0);				llenar_cmb(cubo ,"tipo_snack_prop");				//Llenar Tipo bebida				cmd = "select C2 as descripcion, c1 as clave from keplersc.kdsertipobebida";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvbienvenida.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						   				frn.setX("","tipo_bebida",0,0);				llenar_cmb(cubo ,"tipo_bebida");				frn.setX("","tipo_bebida_prop",0,0);				llenar_cmb(cubo ,"tipo_bebida_prop");				//obtener kodawari				cmd = "select c9 from keplersc.kdconftaller where c2='" & frn.get("k_sucN" , -1, 1) & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvbienvenida.Inicializa()");				//frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_kodawari  ");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								kodawari = getXmlAtt(cubo,"r0" ,"c9");							}			fun LlenaComboAtendio(){				frn.setX("Cliente","cmb_asistira",0,0);				frn.setX("0","cmb_asistira",0,1);				frn.setX("Otro","cmb_asistira",1,0);				frn.setX("1","cmb_asistira",1,1);			}			fun SetAtendio(){				var atendio, nombre;				atendio = frn.get("cmb_asistira",-1,0);				nombre=frn.get("cliente_nombre");				frn.set("persona_evento",nombre);				if(atendio &= "Cliente"){					frn.setAtt("persona_evento","modify","N");				}				else{					frn.setAtt("persona_evento","modify","Y");				}				if (frn.get("persona_evento") &="") {					frn.setAtt("persona_evento","modify","Y");				}			}			fun ObtenerMedPref(){ 				cmd = "select c1 as clave, c2 as descripcion from keplersc.kdsercontpref";				frn.dialog("genlistafiltrosel","Medio Preferido de Contacto",cmd,"clave","medio_preferido","0","0","N","S");			}						fun ObtenerMedPrefProp(){ 				cmd = "select c1 as clave, c2 as descripcion from keplersc.kdsercontpref";				frn.dialog("genlistafiltrosel","Medio Preferido de Contacto",cmd,"clave","medio_preferido_prop","0","0","N","S");			}			fun BuscarMedPref(input_id,input_desc){				var medio_pref_id;				medio_pref_id=frn.get(input_id);//"medio_preferido"				cmd = "select c2 as descripcion from keplersc.kdsercontpref " &						"where c1='" & medio_pref_id & "'";				//frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\querymedpref");										rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvbienvenida.BuscarMedPref()");				//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubomedpref");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if((nXml(cubo) == 0) && (medio_pref_id &! "")) {					frn.setPos(input_id);					frn.set(input_id,"");					frn.message("El medio preferido de contacto no existe","Error","Aceptar");					resVal = 0;					return;                 } else{				    frn.set(input_desc,getXmlAtt(cubo,"r0","descripcion"));	    				}					}			fun Carga_datos(){				buscar_datos();				frn.message("Recuerde dar de alta y completar los datos de la serie, los contactos de Mantto y Conductor con F10 en el dato Serie","Mensaje");			}			fun buscar_datos(){				var strTmp,cubo_cli_vin,cubo_cli,cubo_cita,xmlRes ,tot;				rstXml(xmlRequest);				setXml(xmlRequest,"document","vin",frn.get("vin"));				setXml(xmlRequest,"document","clave_cliente",frn.get("clave_cliente"));				setXml(xmlRequest,"document","inventario",frn.get("inventario"));				setXml(xmlRequest,"document","sucursal_id",frn.get("k_sucN", -1, 1));								borrar_datos();								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");										cmd="select * from keplersc.datos_bienvenida_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				rstXml(cubo);				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvbienvenida.buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				strTmp = getXmlAtt(cubo,"r0","datos_bienv");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_cita   ,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_cita,"C:\Basura\cubo_bienv");						xmlRes= getXmlX(cubo_cita,3,0);				frn.lib("libGeneral.kpl","FileSave",xmlRes,"C:\Basura\xmlRes");				frn.setX(xmlRes);							}													fun Alta(param){				var respuesta;					frn.message("Recuerde dar de alta y completar los datos de la serie, los contactos de Mantto y Conductor con F10 en el dato Serie","Mensaje");				respuesta = frn.message("¿ Seguro quieres guardar la informacion ?","Atencion",2);				if (respuesta == 0){					return;				}								rstXml(xmlRequest);				xmlRequest = getXml(frn.dataPag()); //Obtener el xml de la pantalla;							setXml(xmlRequest ,"tipo_operacion",tip_ope);				setXml(xmlRequest ,"usuario",usuario);						frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequestB");								cmd="SELECT * FROM keplersc.bienvenida_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";							rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"srvbienvenida.Alta");										//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");							var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								if(resultado &= "1"){					var mensaje = getXml(cubo ,"mensaje");					frn.message(mensaje ,"Atencion","Aceptar");					tip_ope = 1;										buscar_datos();					ctrls_off();				}								if (tip_ope == 2){					bloquear_modificacion();				}			}							fun borrar_datos(){				frn.set("fecha_cita","");				frn.set("hora_cita","");				frn.set("inventario","");				frn.set("desc_vendedor","");				frn.set("vendedor","");				frn.set("cmb_asistira","");				frn.set("persona_evento","");				frn.set("medio_preferido","");				frn.set("desc_medio_preferido","");				frn.set("num_preferido","");				frn.set("tipo_snack","");				frn.set("desc_snack","");				frn.set("tipo_bebida","");				frn.set("desc_bebida","");				frn.set("medio_preferido_prop","");				frn.set("desc_medio_preferido_prop","");				frn.set("num_preferido_prop","");				frn.set("tipo_snack_prop","");				frn.set("desc_snack_prop","");				frn.set("tipo_bebida_prop","");				frn.set("desc_bebida_prop","");				frn.set("folio_cita","");				frn.set("clave_cliente","");				frn.set("vin","");				borrar_datos_cli();				borrar_datos_vin();				frn.set("observaciones","");					}									fun borrar_datos_cli(){				frn.set("cliente_id","");				frn.set("cliente_nombre","");				frn.set("cliente_calle","");				frn.set("cliente_ext","");				frn.set("cliente_int","");				frn.set("cliente_colonia","");				frn.set("cliente_poblacion","");				frn.set("cliente_municipio","");				frn.set("cliente_estado","");				frn.set("cliente_pais","");				frn.set("cliente_cp","");				frn.set("cliente_correo","");				frn.set("cliente_tcasa","");				frn.set("cliente_toficina","");				frn.set("cliente_tmovil","");				frn.set("cliente_rfc","");				frn.set("cliente_extension","");				frn.set("propietario_id","");				frn.set("propietario_nombre","");				frn.set("propietario_calle","");				frn.set("propietario_ext","");				frn.set("propietario_int","");				frn.set("propietario_colonia","");				frn.set("propietario_poblacion","");				frn.set("propietario_municipio","");				frn.set("propietario_estado","");				frn.set("propietario_pais","");				frn.set("propietario_cp","");				frn.set("propietario_correo","");				frn.set("propietario_tcasa","");				frn.set("propietario_toficina","");				frn.set("propietario_tmovil","");				frn.set("propietario_rfc","");				frn.set("propietario_extension","");					}						fun borrar_datos_vin(){				frn.set("marca","");				frn.set("modelo","");				frn.set("anio","");				frn.set("color","");				frn.set("kms","");				frn.set("serie","");				frn.set("placas","");				frn.set("codigo","");				frn.set("concesionario","");			}										fun edicion_cliente(tipo_edicion){				var propietario_id = frn.get("propietario_id");				if (tipo_edicion &= "Seleccionar" ){					frn.dialog("cat_cli_view","s","propietario_id");					return ;				}						if (tipo_edicion &= "Nuevo" ||tipo_edicion &= "Modificar"){					frn.dialog("cat_cli_crud",tipo_edicion,"x","s","propietario_id");					return ; 				}				}									fun edicion_vin(tipo_edicion){				var strSerie = frn.get("serie");				if (tipo_edicion &= "Modificar" && strSerie &= ""){					frn.message("Debe especificar una serie para modificar","Error","Aceptar");					return ; 				}				frn.dialog("cat_serie_crud",tipo_edicion,"x","s","serie","Bienvenida");			}			fun llenar_cmb(cuboResultados, cmb){						var len_cubo = nXml(cuboResultados);				var pos_ini = frn.N(cmb);				for (var cont=0; cont<len_cubo ; cont++){					var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}			fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}							fun BuscaInventario(){				var cmdQuery, sucursal_id;				sucursal_id=frn.get("k_sucN", -1, 1);				borrar_datos();				cmdQuery = "select ctEB.c2 as folio,ctEB.c4 as cliente,ud.c3 as nombre,ctEB.c15 as inventario,ctEB.c6 as vin								from keplersc.kdctasbienvser ctEB								inner join keplersc.kdud ud on ud.c2=ctEB.c4								where ctEB.c1='" & sucursal_id & "'";						frn.dialog("genlistafiltrosel","Inventarios para Evento Bienvenida",cmdQuery,"inventario","cve_inv","0","0","S","N");							}						fun Inventario(){				frn.set("inventario",frn.get("cve_inv"));				}			fun RepiteMismo(){				ValidaSoNMismo();				if (frn.get("mismo") &= "S"){					frn.set("propietario_id",frn.get("cliente_id"));					frn.set("propietario_nombre",frn.get("cliente_nombre"));					frn.set("propietario_calle",frn.get("cliente_calle"));					frn.set("propietario_ext",frn.get("cliente_ext"));					frn.set("propietario_int",frn.get("cliente_int"));					frn.set("propietario_colonia",frn.get("cliente_colonia"));					frn.set("propietario_poblacion",frn.get("cliente_poblacion"));					frn.set("propietario_municipio",frn.get("cliente_municipio"));					frn.set("propietario_estado",frn.get("cliente_estado"));					frn.set("propietario_pais",frn.get("cliente_pais"));					frn.set("propietario_cp",frn.get("cliente_cp"));					frn.set("propietario_correo",frn.get("cliente_correo"));					frn.set("propietario_rfc",frn.get("cliente_rfc"));					frn.set("propietario_tcasa",frn.get("cliente_tcasa"));					frn.set("propietario_toficina",frn.get("cliente_toficina"));					frn.set("propietario_tmovil",frn.get("cliente_tmovil"));					frn.set("propietario_extension",frn.get("cliente_extension"));					frn.set("medio_preferido_prop",frn.get("medio_preferido"));					frn.set("desc_medio_preferido_prop",frn.get("desc_medio_preferido"));					frn.set("num_preferido_prop",frn.get("num_preferido"));					frn.set("tipo_snack_prop",frn.get("tipo_snack",-1,1));					frn.set("desc_snack_prop",frn.get("desc_snack"));					frn.set("tipo_bebida_prop",frn.get("tipo_bebida",-1,1));					frn.set("desc_bebida_prop",frn.get("desc_bebida"));									} else {					frn.set("propietario_id","");					frn.set("propietario_nombre","");					frn.set("propietario_calle","");					frn.set("propietario_ext","");					frn.set("propietario_int","");					frn.set("propietario_colonia","");					frn.set("propietario_poblacion","");					frn.set("propietario_municipio","");					frn.set("propietario_estado","");					frn.set("propietario_pais","");					frn.set("propietario_cp","");					frn.set("propietario_correo","");					frn.set("propietario_tcasa","");					frn.set("propietario_toficina","");					frn.set("propietario_tmovil","");					frn.set("propietario_rfc","");					frn.set("propietario_extension","");					frn.set("medio_preferido_prop","");					frn.set("desc_medio_preferido_prop","");					frn.set("num_preferido_prop","");					frn.set("tipo_snack_prop","");					frn.set("desc_snack_prop","");					frn.set("tipo_bebida_prop","");					frn.set("desc_bebida_prop","");				}			}						fun ValidaSoNMismo(){                if (frn.get("mismo") &! "S" && frn.get("mismo") &! "N"){                    frn.setPos("mismo");                    frn.message("Sólo puede ser S o N","Error","&Aceptar");                    return;                }              }			fun ValidarCliente(){				var len_result ,xmlProp,strTmp,clave_cli = frn.get("propietario_id");				cmd = "select udp.c3 as propietario_nombre,udp.c4 as propietario_calle, udp.c45 as propietario_ext, udp.c46 as propietario_int, udp.c5 as propietario_colonia, 						udp.c6 as propietario_poblacion, udp.c47 as propietario_municipio, udp.c48 as propietario_estado, udp.c49 as propietario_pais, 						udp.c27 as propietario_cp, udp.c11 as propietario_correo, udp.c10 as propietario_rfc,udp.c7 as propietario_tcasa, udp.c8 as propietario_toficina, 						udp.c9 as propietario_tmovil,  udp.c37 as propietario_extension 						from keplersc.kdud udp where c2='" & clave_cli & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvbienvenida.ValidarCliente()");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}							len_result = nXml(cubo);				if (len_result == 0 && clave_cli &! "") {					frn.message("Clave cliente no existe","Error","Aceptar");                    frn.setPos("propietario_id");					frn.rst("propietario_id");					return;				}else{					frn.set("propietario_nombre",getXmlAtt(cubo,"r0","propietario_nombre"));					frn.set("propietario_calle",getXmlAtt(cubo,"r0","propietario_calle"));					frn.set("propietario_ext",getXmlAtt(cubo,"r0","propietario_ext"));					frn.set("propietario_int",getXmlAtt(cubo,"r0","propietario_int"));					frn.set("propietario_colonia",getXmlAtt(cubo,"r0","propietario_colonia"));					frn.set("propietario_poblacion",getXmlAtt(cubo,"r0","propietario_poblacion"));					frn.set("propietario_municipio",getXmlAtt(cubo,"r0","propietario_municipio"));					frn.set("propietario_estado",getXmlAtt(cubo,"r0","propietario_estado"));					frn.set("propietario_pais",getXmlAtt(cubo,"r0","propietario_pais"));					frn.set("propietario_cp",getXmlAtt(cubo,"r0","propietario_cp"));					frn.set("propietario_correo",getXmlAtt(cubo,"r0","propietario_correo"));					frn.set("propietario_rfc",getXmlAtt(cubo,"r0","propietario_rfc"));					frn.set("propietario_tcasa",getXmlAtt(cubo,"r0","propietario_tcasa"));					frn.set("propietario_toficina",getXmlAtt(cubo,"r0","propietario_toficina"));					frn.set("propietario_tmovil",getXmlAtt(cubo,"r0","propietario_tmovil"));					frn.set("propietario_extension",getXmlAtt(cubo,"r0","propietario_extension"));				}					}			//--------------------------------------------------- funciones importadas----------------------------------------------------------------------			 fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>