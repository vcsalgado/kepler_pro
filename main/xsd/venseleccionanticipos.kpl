<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit=""><grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0">	<br/>	<br/>	<tab/>    <grp id="gpo_general" bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="100,26,7,11" brdr="0,5" fnt="Arial,16" tit="Anticipos">		<br/>        <tab/><sp n="3"/><txt>S/N (Doble click para seleccionar)</txt>        <br/><tab/>        <tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" 				bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="94,7"  hk="z"  Reorder="N" modify="N" available="Y" insdel="N">            <col id="sel" name="S/N" modify="N" available="Y" OnChange="ValidaSoN()" OnActive="consulta_comentarios()"/>				<col id="gen_anticipo" name="G"  type="string"  visible="N"/> 				<col id="nat_anticipo" name="N"  type="string"  visible="N"/> 				<col id="gpo_anticipo" name="Gpo"  type="string"  visible="N"/>				<col id="tpo_anticipo" name="Tpo"  type="string"  visible="N"/>				<col id="folio" name="Folio"  type="string"  modify="N" OnActive="consulta_comentarios()"/>				<col id="fecha" name="Fecha"  type="date"  modify="N" OnActive="consulta_comentarios()" nc="-1" fmt="DD/MM/CCYY"/>					<col id="monto_factura" name="Monto" nd="2"  type="number" OnActive="consulta_comentarios()"/>				<col id="iva_factura" name="IVA"  type="number" nd="6" min="0" modify="N" OnActive="consulta_comentarios()"/>            <col id="referencia" name="Referencia"  type="string"  modify="N" OnActive="consulta_comentarios()"/>				<col id="estatus" name="Estatus"  type="string"  modify="N" visible="S" OnActive="consulta_comentarios()"/> 				<col id="cve_seleccion" name="Seleccion"  type="string"  modify="N" visible="S" OnActive="consulta_comentarios()"/>             <col id="cmnts_anticipo" name="Observaciones"  type="string"  visible="N" modify="N" OnActive="consulta_comentarios()"/>				</tbl>        <br/>        <tab/><txt>Observaciones: </txt><br/>		<sp n="2"/><inp id="comentarios" dim="95,2" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="N" available="N" brdr="0,2"/>	   <br/>      <br/>		<tab n="11"/><sp n="2"/>		<bot id="bot_aceptar" dim="12,0" brdr="5" text="Aceptar" hk="K" step="0" OnEnter="Ejecuta()" visible="N"/><tab n="2"/>		<bot id="bot_cancelar" dim="12,0" brdr="5" text="Cancelar" hk="K" step="0" OnEnter="Cancelar()" visible="N"/>	</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,cmdQuery,cuboQuery,ok,mensajeError;			var sucursal_id,cve_seleccion,cve_cliente,rfc,origen, inventario,tip_ope,resVal,montoAnticipos,strOrigenMov,estado_venta;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				sucursal_id = trim(frn.param(0));				cve_cliente = trim(frn.param(1));				rfc = trim(frn.param(2));				cve_seleccion = trim(frn.param(3));		//Rrefacc: No. serie		Servicio: Tipo-Orden		Autos: No. inventario				tip_ope=trim(frn.param(4));				//0 o A = Alta		1 o C = Consulta				origen=trim(frn.param(5));					//AUTOS|PEDIDO, AUTOS|FACTURA, SERVICIO o REFACCIONES				Inicializa();				ConfiguraCamposOpcion();			}								fun Inicializa(){				var fecha_anticipos,renglones,nCampos,strOrigen;				frn.rst("gpo_general");				strOrigen = origen;				nCampos = strSplit(strOrigen,"|",-1);				if (nCampos > 1) {					origen = strSplit(strOrigen,"|",0);			//Origen					strOrigenMov = strSplit(strOrigen,"|",1);	//Movimiento				}else{ 					strOrigenMov = "";				}             				//frn.message("Suc:" & sucursal_id &" RFC: "&rfc& " Cliente: "&cve_cliente & " CveSeleccion:"& cve_seleccion & " Tip_ope:" &tip_ope & " Origen:" &origen & " strOrigenMov: "&strOrigenMov);				cmdQuery = "select valor from keplersc.param_oper where sucursal='" & sucursal_id & "' and parametro='Fecha considerar anticipos'";				frn.lib("libGeneral.kpl","FileSave",cmdQuery,"c:\basura\cmdselparamoper");				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venseleccionanticipos.Inicializa()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				fecha_anticipos = getXmlAtt(cuboQuery,"r0", "valor");				//Si tiene tipo_relacion=07 y folio_relacionado tiene valor, ya esta seleccionado a la factura, si c8=10 ya esta aplicado a la factura 				if (tip_ope &= "0" || tip_ope &= "A") {//					if (rfc &= "XAXX010101000" || rfc &="XEXX010101000"){			//Pongo comentario en el if y else hasta que se depuren las claves de los clientes					//Muestre anticipos que esten seleccionados sin aplicar o sin seleccionar					if (origen &= "AUTOS"){						cmdQuery = "select 'N',dm1.c2,dm1.c3,dm1.c4,dm1.c5,dm1.c6,dm1.c9,dm1.c16,dm1.c14,dm1.c11,case when nca.tipo_relacion='' and nca.folio_relacionado <> '' then 'SELECCIONADO' else '' end,nca.folio_relacionado,concat(dm1.c24,' ',dm1.c25,' ',dm1.c26) " &								"from keplersc.kdm1 dm1 " & 								"inner join keplersc.kdf3ncant nca on nca.c1=dm1.c1 and nca.c2=dm1.c2 and nca.c3=dm1.c3 and nca.c4=dm1.c4 and nca.c5=dm1.c5 and nca.c6=dm1.c6 and nca.c8=0 " &								"and nca.tipo_relacion ='' and (nca.folio_relacionado= '' or (substring(nca.folio_relacionado,1,1) ~ '^[0-9]' and length(nca.folio_relacionado) <> 17)) " &				//1er caracter sea un numero y no tenga long de 17 (no. serie para refacc)								"where dm1.c1 = '" & sucursal_id& "' and dm1.c2 = 'U' and dm1.c3 = 'D' and dm1.c4 = '79' and dm1.c10='" & cve_cliente & "' ";					}					if (origen &= "SERVICIO"){						cmdQuery = "select 'N',dm1.c2,dm1.c3,dm1.c4,dm1.c5,dm1.c6,dm1.c9,dm1.c16,dm1.c14,dm1.c11,case when nca.tipo_relacion='' and nca.folio_relacionado <> '' then 'SELECCIONADO' else '' end,nca.folio_relacionado,concat(dm1.c24,' ',dm1.c25,' ',dm1.c26) " &								"from keplersc.kdm1 dm1 " & 								"inner join keplersc.kdf3ncant nca on nca.c1=dm1.c1 and nca.c2=dm1.c2 and nca.c3=dm1.c3 and nca.c4=dm1.c4 and nca.c5=dm1.c5 and nca.c6=dm1.c6 and nca.c8=0 " &								"and nca.tipo_relacion ='' and (nca.folio_relacionado= '' or nca.folio_relacionado ~ '^[A-Za-z]-[0-9]+$') " &					//Comience con 1 letra,-,numeros p.e. S-0000001234								"where dm1.c1 = '" & sucursal_id& "' and dm1.c2 = 'U' and dm1.c3 = 'D' and dm1.c4 = '79' and dm1.c10='" & cve_cliente & "' ";					}					if (origen &= "REFACCIONES"){						cmdQuery = "select 'N',dm1.c2,dm1.c3,dm1.c4,dm1.c5,dm1.c6,dm1.c9,dm1.c16,dm1.c14,dm1.c11,case when nca.tipo_relacion='' and nca.folio_relacionado <> '' then 'SELECCIONADO' else '' end,nca.folio_relacionado,concat(dm1.c24,' ',dm1.c25,' ',dm1.c26) " &								"from keplersc.kdm1 dm1 " & 								"inner join keplersc.kdf3ncant nca on nca.c1=dm1.c1 and nca.c2=dm1.c2 and nca.c3=dm1.c3 and nca.c4=dm1.c4 and nca.c5=dm1.c5 and nca.c6=dm1.c6 and nca.c8=0 " &								"and nca.tipo_relacion ='' and (nca.folio_relacionado= '' or length(nca.folio_relacionado) = 17) " &								"where dm1.c1 = '" & sucursal_id& "' and dm1.c2 = 'U' and dm1.c3 = 'D' and dm1.c4 = '79' and dm1.c10='" & cve_cliente & "' ";					}/*					} else {						cmdQuery = "select 'N',dm1.c2,dm1.c3,dm1.c4,dm1.c5,dm1.c6,dm1.c9,dm1.c16,dm1.c14,dm1.c11,'',concat(dm1.c24,' ',dm1.c25,' ',dm1.c26) " &								"from keplersc.kdm1 dm1 " & 								"inner join keplersc.kdf3ncant nca on nca.c1=dm1.c1 and nca.c2=dm1.c2 and nca.c3=dm1.c3 and nca.c4=dm1.c4 and nca.c5=dm1.c5 and nca.c6=dm1.c6 and nca.c8=0 " &								"and nca.tipo_relacion = '' and (nca.folio_relacionado= '' or substring(nca.folio_relacionado,1,1) ~ '^[0-9\.]+$' = true) " &								"where dm1.c1 = '" & sucursal_id& "' and dm1.c2 = 'U' and dm1.c3 = 'D' and dm1.c4 = '79' and dm1.c22='" & rfc & "' ";					}*/										if (fecha_anticipos &! "") {						cmdQuery = cmdQuery & "and dm1.c9 >= '" & fecha_anticipos & "' ";					}										cmdQuery = cmdQuery & "order by dm1.c9 desc";					frn.lib("libGeneral.kpl","FileSave",cmdQuery,"c:\basura\cmdselanticipos");					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venseleccionanticipos.Inicializa()");					frn.lib("libGeneral.kpl","FileSave",cuboQuery,"c:\basura\selanticipos");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					if(nXml(cuboQuery) == 0){						frn.message("No hay anticipos registrados", "Error", "Aceptar");						return;					} else{						frn.setX(cuboQuery,"k_mov");						renglones=frn.N("k_mov");						for (var i=0; i<renglones; i++){				//Marcar como seleccionado "S" si corresponde al no. inventario, no. de serie u orden de servicio 							if (frn.get("k_mov",i,"cve_seleccion") &= cve_seleccion) {								frn.setX("S","k_mov",i,"sel");							}						}					}					}				if (tip_ope &= "1" || tip_ope &= "C") {				//Desde el pedido, para consultas: si no esta facturado el inv kdinf=10, la consulta es por inv. y si debe permitir modificar en consulta					if (origen &= "AUTOS" && strOrigenMov &= "PEDIDO"){		//Para el alta de la factura de auto solo es consulta						//buscar en kdinf en inventario						cmdQuery = "select c32 from keplersc.kdinf where c1 = '" & sucursal_id &  "' and c2 = '" & cve_seleccion & "'";						rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venseleccionanticipos.Inicializa()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery,"c:\basura\selanticipos");						ok=getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;						}						estado_venta = getXmlAtt(cuboQuery,"r0","c32");									if (estado_venta &= 10){		//Si no esta facturado mostrar anticipos del cliente							cmdQuery = "select 'N',dm1.c2,dm1.c3,dm1.c4,dm1.c5,dm1.c6,dm1.c9,dm1.c16,dm1.c14,dm1.c11,case when nca.tipo_relacion='' and nca.folio_relacionado <> '' then 'SELECCIONADO' else '' end,nca.folio_relacionado,concat(dm1.c24,' ',dm1.c25,' ',dm1.c26) " &								"from keplersc.kdm1 dm1 " & 								"inner join keplersc.kdf3ncant nca on nca.c1=dm1.c1 and nca.c2=dm1.c2 and nca.c3=dm1.c3 and nca.c4=dm1.c4 and nca.c5=dm1.c5 and nca.c6=dm1.c6 and nca.c8=0 " &								"and nca.tipo_relacion ='' and (nca.folio_relacionado= '' or (substring(nca.folio_relacionado,1,1) ~ '^[0-9]' and length(nca.folio_relacionado) <> 17)) " &				//1er caracter sea un numero y no tenga long de 17 (no. serie para refacc)								"where dm1.c1 = '" & sucursal_id& "' and dm1.c2 = 'U' and dm1.c3 = 'D' and dm1.c4 = '79' and dm1.c10='" & cve_cliente & "' ";							} else if (estado_venta >10){		//Si esta facturado							frn.message("Los anticipos ya se relacionaron a una factura, consulte la factura","Atencion","Aceptar");							return;						}					} else{						cmdQuery = "select 'S',ant.c2,ant.c3,ant.c4,ant.c5,ant.c6,ant.c9,ant.c16,ant.c14,ant.c11,case when nca.c8=10 and nca.c12 <> '' then 'APLICADO' else 'SELECCIONADO' end,nca.folio_relacionado, concat(ant.c24,' ',ant.c25,' ',ant.c26) " &								"from keplersc.kdm1 dm1 " & 								"inner join keplersc.kdf3ncant nca on nca.c1=dm1.c1 and nca.genero_doctorel =dm1.c2 and nca.naturaleza_doctorel =dm1.c3 and nca.grupo_doctorel =dm1.c4 and nca.tipo_doctorel =dm1.c5 and nca.folio_relacionado=dm1.c6 " &								"inner join keplersc.kdm1 ant on ant.c1=dm1.c1 and ant.c2 =nca.c2 and ant.c3 =nca.c3 and ant.c4 =nca.c4 and ant.c5 =nca.c5 and ant.c6=nca.c6 " &								"where dm1.c1='"&sucursal_id&"' and dm1.c2='"&frP.get("k_tipon",-1,1)&"' and dm1.c3='"&frP.get("k_tipon",-1,2)&"' and dm1.c4='"&frP.get("k_tipon",-1,3)&"' and dm1.c5='"&frP.get("k_tipon",-1,4)&"' and dm1.c6='"&frP.get("k_folio")&"' "&								"order by dm1.c9 desc";					}					frn.lib("libGeneral.kpl","FileSave",cmdQuery,"c:\basura\cmdselanticipos");					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venseleccionanticipos.Inicializa()");					frn.lib("libGeneral.kpl","FileSave",cuboQuery,"c:\basura\selanticipos");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}								if (nXml(cuboQuery) == 0){						frn.message("No hay anticipos seleccionados/aplicados", "Error", "Aceptar");						return;									} else{						frn.setX(cuboQuery,"k_mov");						if (origen &= "AUTOS" && strOrigenMov &= "PEDIDO"){							renglones=frn.N("k_mov");							for (var i=0; i<renglones; i++){				//Marcar como seleccionado "S" si corresponde al no. inventario								if (frn.get("k_mov",i,"cve_seleccion") &= cve_seleccion) {									frn.setX("S","k_mov",i,"sel");								}							}						}					}				}				}			fun ConfiguraControlesOff()			{				frn.setAtt("bot_cancelar","visible","N");				frn.setAtt("bot_aceptar","visible","N");				frn.setAtt("comentarios","available","N");				//frn.setAtt("k_mov","available","N","sel");				frn.setAtt("k_mov","OnMouseD","","sel");			}			fun ConfiguraCamposOpcion()			{				ConfiguraControlesOff();				if (tip_ope &= "0" || tip_ope &= "A") {					frn.setAtt("bot_cancelar","visible","Y");					frn.setAtt("bot_aceptar","visible","Y");					frn.setAtt("comentarios","available","Y");					frn.setAtt("k_mov","OnMouseD","SoN()","sel");					if (origen &= "AUTOS" && strOrigenMov &= "FACTURA"){		//Para el alta de la factura de auto solo es consulta						frn.setAtt("bot_cancelar","visible","N");						frn.setAtt("bot_aceptar","visible","N");						frn.setAtt("comentarios","available","Y");						frn.setAtt("k_mov","OnMouseD","","sel");					}				} else if (tip_ope &= "1" || tip_ope &= "C") {					frn.setAtt("bot_cancelar","visible","N");					frn.setAtt("bot_aceptar","visible","N");					frn.setAtt("comentarios","available","Y");					if (origen &= "AUTOS" && strOrigenMov &= "PEDIDO" && estado_venta &= 10){			//Si no esta facturado el pedido habilitar boton aceptar para actualizar						frn.setAtt("bot_cancelar","visible","Y");						frn.setAtt("bot_aceptar","visible","Y");						frn.setAtt("comentarios","available","Y");						frn.setAtt("k_mov","OnMouseD","SoN()","sel");					}				}			}            fun SoN() {					var porciva,movto;					movto = frP.get("k_tipon",-1,1) & frP.get("k_tipon",-1,2) & frn.lib("libGeneral.kpl","PadLeft",frP.get("k_tipon",-1,3),2,"0") & frn.lib("libGeneral.kpl","PadLeft",frP.get("k_tipon",-1,4),3,"0");					if (frn.get("k_mov",-1,"sel") &= "S"){						frn.setX("N","k_mov",-1,"sel");               } else {						frn.setX("S","k_mov",-1,"sel");												if (origen &= "SERVICIO" || origen &= "REFACCIONES"){		//Solo validar anticipos con IVA vs. facturas con IVA de Servicio y Refacciones 						cmdQuery = "select c16 								from keplersc.kdmm 								where col_sucursal='" & sucursal_id & "' and c1='"&frP.get("k_tipon",-1,1)&"' and c2='"&frP.get("k_tipon",-1,2)&"' and c3='"&frP.get("k_tipon",-1,3)&"' and c4='"&frP.get("k_tipon",-1,4)&"'";							frn.lib("libGeneral.kpl","FileSave",cmdQuery,"c:\basura\cmdkdmm");							rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venseleccionanticipos.Inicializa()");							frn.lib("libGeneral.kpl","FileSave",cuboQuery,"c:\basura\selanticipos");							ok=getXmlAtt(cuboQuery,"ok");							if(ok &! "" && !ok){								mensajeError = getXmlAtt(cuboQuery,"native3");								mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);								frn.message(mensajeError,"Error","Aceptar");								return;							}										porciva = getXmlAtt(cuboQuery,"r0","c16");							if (porciva == 16){								if (frn.get("k_mov",-1,"iva_factura") == 0){									frn.message("El movimiento " & movto & " tiene IVA y el anticipo No tiene IVA|Seleccione un anticipo con IVA","Atencion","&Aceptar");									frn.setX("N","k_mov",-1,"sel");									}							}else{								if (frn.get("k_mov",-1,"iva_factura") > 0){									frn.message("El movimiento " & movto & " no tiene IVA y el anticipo tiene IVA|Seleccione un anticipo sin IVA","Atencion","&Aceptar");									frn.setX("N","k_mov",-1,"sel");									}							}						}												if (origen &= "AUTOS"){							if (mid(cve_seleccion,7,1) &= "N"){		//Lleva IVA autos nuevos								if (frn.get("k_mov",-1,"iva_factura") == 0){									frn.message("El inventario " & cve_seleccion & " es de un vehiculo NUEVO|Seleccione un anticipo con IVA","Atencion","&Aceptar");									frn.setX("N","k_mov",-1,"sel");									}							} else{											//No lleva IVA autos seminuevos								if (frn.get("k_mov",-1,"iva_factura") > 0){									frn.message("El inventario " & cve_seleccion & " es de un vehiculo SEMINUEVO|Seleccione un anticipo sin IVA","Atencion","&Aceptar");									frn.setX("N","k_mov",-1,"sel");									}							}																			} 					}	            }			fun ValidaSoN(){            //solo si el campo esta disponible                 if (frn.get("k_mov",-1,"sel") &! "S" && frn.get("k_mov",-1,"sel") &! "N"){                    frn.setPos("k_mov",-1,"sel");                    frn.message("Sólo puede ser S o N","Error","&Aceptar");                    return;                 } 			}         fun consulta_comentarios(){				frn.set("comentarios",frn.get("k_mov",-1,"cmnts_anticipo"));			}			fun Ejecuta() {				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;				var resultado, mensaje, folio;				fecha = sys.date();				hora= sys.time();					if (tip_ope &= "0" || tip_ope &= "A") {								//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok					resVal = 1;					ValidarDatos();					if(resVal == 0){						return;					}										continua = frn.message("¿Desea seleccionar los anticipos?  *Suma Anticipos seleccionados: " & montoAnticipos & "    *Monto Factura: " & frP.get("k_monto"),"Atencion",1);					if (continua == 0){						return;					}									xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;										setXml(xmlPantalla,"k_sucursal",sucursal_id);					setXml(xmlPantalla,"k_seleccion",cve_seleccion);					setXml(xmlPantalla,"tip_ope",tip_ope);					setXml(xmlPantalla,"origen",origen);					setXml(xmlPantalla,"origenmov",strOrigenMov);								setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);																frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"c:\basura\xmlPantallaSA");										cmdQuery="SELECT * FROM keplersc.ven_seleccion_anticipos('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					rstXml(cuboQuery);						cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"venseleccionanticipos.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, "c:\basura\xmlResultadoSelanticpos");											resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok) {						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}					if(resultado &= "1") {						frn.message(mensaje, "Mensaje", "Aceptar");						frn.exit();					} else {						frn.message(mensaje, "Error", "Aceptar");						return;					}				} else {					if (tip_ope &= "1" || tip_ope &= "C") {						if (origen &= "AUTOS" && strOrigenMov &= "PEDIDO" && estado_venta &= 10){				//Si no esta facturado el inventario puede actualizar los anticipos							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok							resVal = 1;							ValidarDatos();							if(resVal == 0){								return;							}												continua = frn.message("¿Desea actualizar los anticipos?  *Suma Anticipos seleccionados: " & montoAnticipos & "    *Monto Factura: " & frP.get("k_monto"),"Atencion",1);							if (continua == 0){								return;							}											xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;												setXml(xmlPantalla,"k_sucursal",sucursal_id);							setXml(xmlPantalla,"k_seleccion",cve_seleccion);							setXml(xmlPantalla,"tip_ope",tip_ope);							setXml(xmlPantalla,"origen",origen);										setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);																		frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"c:\basura\xmlPantallaSA");												cmdQuery="SELECT * FROM keplersc.ven_seleccion_anticipos('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";							rstXml(cuboQuery);								cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"venseleccionanticipos.Ejecuta");											frn.lib("libGeneral.kpl","FileSave",cuboQuery, "c:\basura\xmlResultadoSelanticpos");													resultado = getXml(cuboQuery,"resultado");							mensaje = getXml(cuboQuery,"mensaje");													ok = getXmlAtt(cuboQuery,"ok");							if(ok &! "" && !ok) {								mensajeError = getXmlAtt(cuboQuery,"native3");								mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);								frn.message(mensajeError,"Error","Aceptar");								return;								}							if(resultado &= "1") {								frn.message(mensaje, "Mensaje", "Aceptar");								frn.exit();							} else {								frn.message(mensaje, "Error", "Aceptar");								return;							}											}					} else{						frn.exit();					}				}					}			fun ValidarDatos(){				var renglones, regSel, validaMonto;				renglones=frn.N("k_mov");				regSel=0;				montoAnticipos=0;				for (var i=0; i<renglones; i++){					if (frn.get("k_mov",i,"sel") &= "S") {						regSel = regSel+1;						montoAnticipos = montoAnticipos + frn.get("k_mov",i,"monto_factura"); 					}				}				if (regSel ==0){					frn.message("No ha seleccionado anticipos", "Atencion", "Aceptar");//					resVal=0;				} 								if (montoAnticipos > frP.get("k_monto")){					frn.message("La suma de los anticipos seleccionados es: "& montoAnticipos &" no puede ser mayor al monto de la factura: "& frP.get("k_monto") & "|Verifique","Atencion","Aceptar");					resVal=0;					}											}			fun Cancelar(){				frn.exit();						}			//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>