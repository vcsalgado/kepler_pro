<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Costeo de Unidades">
	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">
		<grp dim="28,47,7,12" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Costeo de Unidades">
			
			<br/><tab/><txt>Sucursal:</txt><sp n="2"/><cmb id="k_sucn" dim="45,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 
			      Null="N" modify="Y" available="Y"/>
			      <br/>  

				 <tab/><txt>Inventario:</txt>	<sp/>
			      <inp id="k_inventario" dim="13,1" bclr="255,255,255" OnF9="ObtenerInventario()" OnChange="MostrarInventario()" clr="64,64,64"  clrBrdr="255,255,255"  type="string" brdr="0,2"/>
			        
			       <br/>   <br/>  
				<tab/>	<txt>Clave:</txt>	
			      <inp id="clave_vehiculo" dim="11,1" bclr="192,205,213"  clr="64,64,64" modify="N" clrBrdr="255,255,255"  type="string" brdr="0,2"/>
								      
			      <sp/>
			      <txt>Modelo:</txt>
			      <inp id="modelo" dim="5,1" bclr="192,205,213"  clr="64,64,64" modify="N" clrBrdr="255,255,255"  type="string" brdr="0,2"/>
			      <sp/><txt>Fecha Compra:</txt>
			      <inp id="fecha_compra" dim="12,1" bclr="192,205,213"  clr="64,64,64" modify="N" clrBrdr="255,255,255"  type="string" brdr="0,2"/>
			       <br/>
			      
			        
			       
			       
					<tab/><txt>Vehiculo:</txt>	<tab/>
			      <inp id="desc_vehiculo" dim="46,1" bclr="192,205,213"  clr="64,64,64" modify="N" clrBrdr="255,255,255"  type="string" brdr="0,2"/>
			      <br/>  
			       
			       <br/>  
			       
			       <tab/><txt>Costo de la Unidad:</txt>	<tab n="6"/>
			      <inp id="costo_unidad" dim="11,1" bclr="192,205,213"  clr="64,64,64" modify="N" clrBrdr="255,255,255" nd="2" type="number" brdr="0,2"/>
			       <br/>    <br/>  
			       
			       <tab/><txt>Holdback:</txt>	<tab n="8"/>
			      <inp id="holdback" dim="11,1" bclr="192,205,213"  clr="64,64,64" modify="N" clrBrdr="255,255,255" nd="2" type="number" brdr="0,2"/>
			       <br/>    <br/>  
			       <tab/><txt>Cargos al Costo de la Unidad:</txt>	<tab n="3"/>
			      <inp id="cargos_costo_unidad" dim="11,1" bclr="192,205,213"  clr="64,64,64" modify="N" clrBrdr="255,255,255"  nd="2" type="number" brdr="0,2"/>
			       <br/> 
			       <tab/><txt>Cargos al Costo de Accesorios:</txt>	<tab n="2"/>
			      <inp id="cargos_costo_accesorios" dim="11,1" bclr="192,205,213"  clr="64,64,64" modify="N" clrBrdr="255,255,255" nd="2"  type="number" brdr="0,2"/>
			       <br/>    <br/>  
			       <tab/><txt>Bonificaciones:</txt>	<tab n="7"/>
			      <inp id="bonificaciones" dim="11,1" bclr="192,205,213"  clr="64,64,64" modify="N" clrBrdr="255,255,255" nd="2" type="number" brdr="0,2"/>
			       <br/>    <br/>  
			       
			       <tab/><txt>Descuentos:</txt>	<tab n="8"/>
			      <inp id="descuentos" dim="11,1" bclr="192,205,213"  clr="64,64,64" modify="N" clrBrdr="255,255,255"  nd="2" type="number" brdr="0,2"/>
			       <br/>
			       <tab/> <txt>Subsidios:</txt>	<tab n="8"/>
			      <inp id="subsidios" dim="11,1" bclr="192,205,213"  clr="64,64,64" modify="N" clrBrdr="255,255,255"  nd="2" type="number" brdr="0,2"/>
			       <br/>   <br/>  
			       
			     <tab/>  <txt>Precio antes de Impuestos:</txt>	<tab n="4"/>
			      <inp id="precio_antes_impuestos" dim="11,1" bclr="192,205,213"  clr="64,64,64" modify="N" clrBrdr="255,255,255" nd="2" type="number" brdr="0,2"/>
			       <br/>
			       
			        <tab/><txt>I.S.A.N:</txt>	<tab n="9"/>
			      <inp id="isan" dim="11,1" bclr="192,205,213"  clr="64,64,64" modify="N" clrBrdr="255,255,255" nd="2" type="number" brdr="0,2"/>
			       <br/>
			       
			      <tab/> <txt>I.V.A:</txt>	<tab n="10"/>
			      <inp id="iva" dim="11,1" bclr="192,205,213" clr="64,64,64" modify="N" clrBrdr="255,255,255" clr="64,64,64" nd="2" type="number" brdr="0,2"/>
			       <br/>
			       
			       
			       <tab/><txt>Precio de Venta:</txt>	<tab n="7"/>
			      <inp id="precio_venta" dim="11,1" bclr="255,255,255" clr="64,64,64" OnChange="Utilidad()" clrBrdr="255,255,255"  nd="2" type="number" brdr="0,2"/>
			       <br/>   <br/>     <br/>  
			       
			       
			       <tab/><txt>Utilidad Bruta (incluye Holdback):</txt>	<tab n="2"/>
			      <inp id="utilidad_bruta" dim="11,1" bclr="192,205,213" clr="64,64,64" modify="N"  bclr="230,230,230"  nd="2" type="number" brdr="0,2"/>
			       <br/>
			       
			      <tab/> <txt>Porcentaje:</txt>	<tab n="8"/>
			      <inp id="porcentaje" dim="11,1" bclr="192,205,213"  clr="64,64,64" modify="N"  bclr="230,230,230"  nd="2" type="number" brdr="0,2"/>
			       <br/>
			       
			       
			       
			       
			     

		</grp><br/><br/>
	</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,kdb,rep,sys,suc_usuario ,perfil_usuario,asterisco,rol_usuario   ;
			fun Main() {
				frn=new FRNT;
				kdb=new KDB;
				rep=new REP;
				sys=new SYS;				
				kdb.connect();
				kdb.open("s,kdms,i,kdini,c,kdud");
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				perfil_usuario = frn.lib("libKepler","UserInfo(2)");
				rol_usuario = frn.config("user","role");
				asterisco = "*";
				Inicializa();				
			}
			

			fun Inicializa(){
				var cmd, cubo, xmlResQuery, ok, mensajeError, strTmp;
			
				//Llenar combo sucursales
				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";
				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){
					cmd = cmd & " where c1='" & suc_usuario & "'";
				}else {
					if (suc_usuario &! asterisco && suc_usuario &! "" ){
						cmd = cmd & " where c1='" & suc_usuario & "'";
					}
				}
				
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");		
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
					
				frn.set("k_sucn",getXml(cubo));
								
			}


			fun ObtenerInventario(){
					var cmdQuery = "select c2 as inventario, c3 as clave_vehiculo, c4 as descripcion, c5 as serie from keplersc.kdinf where c1='" & frn.get("k_sucn", -1, 1) & "'";
					frn.dialog("genlistafiltrosel","Inventarios",cmdQuery,"inventario","k_inventario","0","","S");
			}
			
			
			fun MostrarInventario(){
			
				var cmd,ok, cuboResultados;
					 
				var inv= frn.get("k_inventario");
				
				borrar_datos();
				
				//INVENTARIO
				cmd = "select c2,c3,c4,c15 from keplersc.kdinf where c1 ='" & frn.get("k_sucn", -1, 1) & "' and c2='" & inv  & "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"costeo_unidades.MostrarInventario()");
			
				if (nXml(cuboResultados ) == 0){
					frn.message("Inventario no existe","Error","Aceptar");
					return;
				}
		
				frn.set("k_inventario", getXmlAtt(cuboResultados , "r0", "c2") );
				frn.set("clave_vehiculo", getXmlAtt(cuboResultados , "r0", "c3") );
				frn.set("desc_vehiculo", getXmlAtt(cuboResultados , "r0", "c4") );
				frn.set("modelo", getXmlAtt(cuboResultados , "r0", "c15") );
		
				//ULTIMO COSTO, PRIMERA FECHA
				cmd = "select c7,c8 from keplersc.kdlinv where c1 ='" & frn.get("k_sucn", -1, 1) & "' and c2='" & inv  & "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"costeo_unidades.MostrarInventario()");
				frn.set("fecha_compra", getXmlAtt(cuboResultados , "r0", "c7") );
				frn.set("costo_unidad", getXmlAtt(cuboResultados , "r0", "c8") );
				
				//HOLDBACK
				cmd = "select c33 from keplersc.kdicom where c1 ='" & frn.get("k_sucn", -1, 1) & "' and c2='" & inv  & "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"costeo_unidades.MostrarInventario()");
				frn.set("holdback", getXmlAtt(cuboResultados , "r0", "c33") );
				
				//CARGOS AL COSTO DE UNIDADES
				cmd = "select c2,c3,c9,c10 from keplersc.kdsunicosto where c7 ='" & frn.get("k_sucn", -1, 1) & "' and c8='" & inv  & "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"costeo_unidades.MostrarInventario()");
				
				var totres = nXml(cuboResultados );
	
				var cargos_costo_unidad  = 0; var cargos_costo_accesorios = 0;
				for (var contador = 0; contador < totres ;contador ++){
				
					var genero_costo = getXmlAtt(cuboResultados,"r"&contador , "c2");
					var naturaleza_costo = getXmlAtt(cuboResultados,"r"&contador , "c3");
					var tipo_costo = getXmlAtt(cuboResultados,"r"&contador , "c9");
					var costo = getXmlAtt(cuboResultados,"r"&contador , "c10");
					
					if ((genero_costo &= "U" && naturaleza_costo &= "D" ) || ( genero_costo &= "X" && naturaleza_costo &= "A")){
						if (tipo_costo &= "U"){
							cargos_costo_unidad = cargos_costo_unidad + costo ;
						}else{
							cargos_costo_accesorios = cargos_costo_accesorios + costo ;
						}
					}else{
						if (tipo_costo &= "U"){
							cargos_costo_unidad = cargos_costo_unidad - costo ;
						}else{
							cargos_costo_accesorios = cargos_costo_accesorios - costo ;
						}
					}
				}
				
				frn.set("cargos_costo_unidad" ,cargos_costo_unidad  );
				frn.set("cargos_costo_accesorios" ,cargos_costo_accesorios );
				
			
				//BONIFICACIONES
				cmd = "select c3,c10 from keplersc.kdbonif where c1 ='" & frn.get("k_sucn", -1, 1) & "' and c8='" & inv  & "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"costeo_unidades.MostrarInventario()");
				
				totres = nXml(cuboResultados );
		
				var bonificaciones = 0;
				for (var contador = 0; contador < totres ;contador ++){
				
					var naturaleza_boni = getXmlAtt(cuboResultados,"r"&contador , "c3");
					var monto_boni = getXmlAtt(cuboResultados,"r"&contador , "c10");
					
					if (naturaleza_boni &= "D"){
						bonificaciones = bonificaciones + monto_boni;
					}else{
						bonificaciones = bonificaciones - monto_boni;
					}	
				}
				frn.set("bonificaciones" ,bonificaciones );
				

				//DESCUENTOS
				cmd = "select c3,c4,c9,c10 from keplersc.kdncred where c1 ='" & frn.get("k_sucn", -1, 1) & "' and c2='" & inv  & "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"costeo_unidades.MostrarInventario()");
				
				totres = nXml(cuboResultados );
		
				var descuentos= 0;
				for (var contador = 0; contador < totres ;contador ++){
				
					var genero_descuento = getXmlAtt(cuboResultados,"r"&contador , "c3");
					
					if (genero_descuento &= "U"){
					
						var naturaleza_descuento = getXmlAtt(cuboResultados,"r"&contador , "c4");
						var iva_descuento = getXmlAtt(cuboResultados,"r"&contador , "c9");
						var importe_descuento = getXmlAtt(cuboResultados,"r"&contador , "c10");
					
						if (naturaleza_descuento &= "A"){
							descuentos = descuentos + (importe_descuento - iva_descuento );
						}else{
							descuentos = descuentos - (importe_descuento - iva_descuento );
						}
					}
				}
				frn.set("descuentos" ,descuentos);
				
				
				//SUBSIDIOS
				cmd = "select c15 from keplersc.kdpedido where c1 ='" & frn.get("k_sucn", -1, 1) & "' and c2='" & inv  & "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"costeo_unidades.MostrarInventario()");
				frn.set("subsidios" ,getXmlAtt(cuboResultados,"r0", "c15"));
				
			 Utilidad();
			
			}
			
			
			fun Utilidad(){
			
				var v_iva, v_costo, resultado, mensaje, cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd, adicionales;					 
				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
				setXml(xmlPantalla,"k_b7012",frn.get("precio_venta"));
				setXml(xmlPantalla,"k_b7013",16);//se calcula dentro de la funci?n al momento de procesarse 
				setXml(xmlPantalla,"k_b7014",frn.get("precio_venta"));
				setXml(xmlPantalla,"k_b7015",1);				
				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlSumas_inv");
				cmd="SELECT * FROM keplersc.invlib_sumas_inv('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";
				kdb.rst(cubo);
				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"costeo_unidades.Utilidad()");				

				resultado= getXml(cubo,"resultado");
				var isan = getXml(cubo,"mensaje"); // v_B7010
				var iva = getXml(cubo,"adicionales"); // v_B7011
				if(resultado &= "1")
				{
					frn.set("isan",isan );
					frn.set("iva",iva );
					
					var precio_antes_impuestos = frn.get("precio_venta") - iva - isan;
					frn.set("precio_antes_impuestos" ,precio_antes_impuestos);
			
					var utilidad_bruta = precio_antes_impuestos - frn.get("costo_unidad") - frn.get("cargos_costo_unidad") - frn.get("cargos_costo_accesorios");
					utilidad_bruta = utilidad_bruta  + frn.get("bonificaciones") - frn.get("descuentos") - frn.get("subsidios");
					frn.set("utilidad_bruta" ,utilidad_bruta );
					
					var porcentaje = utilidad_bruta / precio_antes_impuestos * 100;
					frn.set("porcentaje" ,porcentaje );
					
				}
				else{
					frn.message(mensaje, "Error","Aceptar");
				}		
				
	
			}
			
			
			fun borrar_datos(){
			
				frn.rst("k_inventario");
				frn.rst("clave_vehiculo");
				frn.rst("desc_vehiculo");
				frn.rst("modelo");
				frn.rst("fecha_compra");
				frn.rst("costo_unidad");
				frn.rst("holdback");
				frn.rst("cargos_costo_unidad");
				frn.rst("cargos_costo_accesorios");
				frn.rst("bonificaciones");
				frn.rst("descuentos");
				frn.rst("subsidios");
				frn.rst("precio_antes_impuestos");
				frn.rst("isan");
				frn.rst("iva");
				frn.rst("precio_venta");
				frn.rst("utilidad_bruta");
				frn.rst("porcentaje");
			}
			
			
			
	
			
			//-------------------------------------------------extras------------------------------------------------
			
			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){
				/*iModo: 0)No hace mayor validacion. Siempre despliega la ventana. NO CONCATENA PREFIJO
							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validacion. Siempre despliega la ventana
							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)
							3)Modo especial para paginas de operacion:Solo si se esta en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje
				*/
				var prefix=frn.lib("libKepler","langPrefix");
				var page=prefix&pag;
				var b_valido=1;
				if(iModo==0)page=pag;
				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolvera el resultado.
					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;
				}
				else if(iModo==3)b_valido=0;
				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);
			}
			
		
			
			
			
		
									
		}
	</script>
</pag>