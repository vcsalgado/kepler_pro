			<br/>
            <tab n="13"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/><br/>
			<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>
		</grp><br/><br/>
	</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,kdb,frP, accion,externo, clave_sel,sucursal_id,cve_color,resVal,straccion;
            var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError;
			fun Main() {
				frn=new FRNT;
				frP=new FRNTP;
				kdb=new KDB;
				kdb.connect();
			
				Inicializa();
				ctlrs_off();
				insertar_datos();
				ctlrs_opcion();
					
			}
			
            fun Inicializa(){
				accion = frn.param(0);
				clave_sel = frn.param(1);
                externo =  frn.param(2);
                frn.set("input_crud", accion);
				frn.rst("grupo_crud");
				
						frn.set("k_clave", clave_sel);	
			}

			fun ctlrs_off(){
				frn.setAtt("btn_aceptar", "available", "N" );
				frn.setAtt("btn_aceptar", "visible", "N" );
			}
				
            fun ctlrs_opcion(){
                frn.setAtt("k_clave", "available", "Y" );
                frn.setAtt("k_clave", "modify", "N" );
				if (accion &= "CONSULTAR"){
				    frn.setAtt("c_pq01", "available","N");
					frn.setAtt("c_pq02", "available","N");
                    frn.setAtt("c_pq03", "available","N");
				    frn.setAtt("c_pq04", "available","N");
					frn.setAtt("c_pq05", "available","N");
                    frn.setAtt("c_pq06", "available","N");						
					frn.setAtt("c_pq07", "available","N");
					frn.setAtt("c_pq08", "available","N");
				    frn.setAtt("c_pq09", "available","N");
					frn.setAtt("c_pq10", "available","N");
					frn.setAtt("c_pq11", "available","N");
					frn.setAtt("c_pq12", "available","N");
                    frn.setAtt("c_pq13", "available","N");						
					frn.setAtt("c_pq14", "available","N");
					frn.setAtt("c_pq15", "available","N");
					frn.setAtt("c_pq16", "available","N");
					frn.setAtt("c_pq17", "available","N");						
					frn.setAtt("c_pq18", "available","N");
					frn.setAtt("c_pq19", "available","N");
					frn.setAtt("btn_aceptar", "visible", "N" );										
				} else {
                    frn.setAtt("btn_aceptar", "available", "Y" );
					frn.setAtt("btn_aceptar", "visible", "Y" );
				}
			}

			fun insertar_datos(){	
				if (accion &= "MODIFICAR"){
					//llamada externa(padre)
					if (externo &= "s"){
						if (clave_sel &= ""){
							frn.message("selecciona una clave con F9 para modificar","Error","Aceptar");
							frn.setAtt("btn_aceptar", "visible", "N" );
							return;
						}
					}
				}
				if (accion &! "NUEVO") {
					cmdQuery="select c2 as c_pq01,c3 as c_pq02,c4 as c_pq03,c5 as c_pq04,c6 as c_pq05,c7 as c_pq06,c8 as c_pq07,c9 as c_pq08,c10 as c_pq09," &
                            "c11 as c_pq10,c12 as c_pq11,c13 as c_pq12,c14 as c_pq13,c15 as c_pq14,c16 as c_pq15,c17 as c_pq16,c18 as c_pq17,c19 as c_pq18,c20 as c_pq19 " & 
                            "from keplersc.kdpaq where c1='" & clave_sel & "'"; 
					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_vehiculopaqetes_crud.insertar_datos()");
				
					frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");
					
					ok=getXmlAtt(cuboResultados,"ok");
					if(ok &! "" && !ok){
						mensajeError = getXmlAtt(cuboResultados,"native3");
						frn.message(mensajeError,"Error","Aceptar");
						return;
					}	
                    rstXml(xmlRequest);
					xmlRequest=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboResultados,"r0");
					frn.setX(xmlRequest);
                }else{
                    frn.setAtt("grupo_crud", "available","Y");
                    frn.setPos("c_pq01");    
				}
			}
		
			fun Execute() {
					
				var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);
				if (resultado_confirmacion &! 1)  {
					return;
				}
				
				xmlRequest = getXml(frn.dataPag());	
				frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");
		
				cmdQuery="SELECT * FROM keplersc.cat_vpaquetes_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";
				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_interiores_crud.Execute()");	
				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");					
				var resultado=getXml(cubo ,"resultado");
				
				if(resultado &= "0"){
					mensajeError = getXml(cubo ,"mensaje");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				if (accion &= "NUEVO" || accion &= "MODIFICAR") {	
					var sms =  "";
					if (accion &= "NUEVO"){
						sms = "Registro guardado";
					}else {
						sms = "Registro modificado";
					}
					accion="CONSULTAR";
					ctlrs_opcion();
					frn.message(sms ,"Mensaje","Aceptar");	
					frn.exit();	
				}
				if (accion &= "ELIMINAR"){
					frn.message("Registro eliminado","Mensaje","Aceptar");
					frn.exit();			
				}
			}		
			
		}
	</script>
</pag>