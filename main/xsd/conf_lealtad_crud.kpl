<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Configuracion Lealtad"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">	<txt fnt=",22" clr="0,0,0">  Configuracion Lealtad</txt><tab/>	<br/>	<hLine clr="0,0,0"	dim="40,0,0,0"/>	<br/>	<br/>	<grp id="grupo_crud" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="40,9,10,30" brdr="0,5" tit="Modifica" fnt="Arial,16" available="Y">		<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/>		<br/>		<tab/>									<txt>Sucursal de Ventas: </txt>			<tab n="12"/><sp/>						<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1"  bclr="255,255,255" brdr="0,2" fnt="Arial,16" Null="N" hk="S"  available="Y" modify="Y"/>		<sp/>		<br/>				<tab/>									<txt>Porcentaje de Descuento en Fallas para Clientes de la Agencia: </txt>			<tab n="4"/><sp/>			<inp id="porcentaje_1" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number" nd="5" available="Y" modify="Y"/>		<sp/>		<br/>		<tab/>									<txt>Porcentaje de Descuento en Fallas para Clientes de Otras Agencia: </txt>			<tab n="3"/><sp/>			<inp id="porcentaje_2" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number" nd="5" available="Y" modify="Y"/>		<sp/>		<br/>		<tab/>									<txt>Porcentaje de Descuento en Hojalateria para Clientes de la Agencia: </txt>			<tab n="3"/><sp/>			<inp id="porcentaje_3" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number"  nd="5" available="Y" modify="Y"/>		<sp/>		<br/>		<tab/>									<txt>Porcentaje de Descuento en Hojalateria para Clientes de Otras Agencia: </txt>			<tab n="2"/><sp/>			<inp id="porcentaje_4" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number"  nd="5" available="Y" modify="Y"/>		<sp/>		<br/>		<br/>		<tab/>		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Guardar" hk="K" default="0" step="0"  OnEnter="Execute()" fnt="Arial,16" visible="Y" available="Y"/>		<tab/>		<bot id="btn_aceptar" dim="10,10" brdr="5" text="Aceptar" hk="K" default="0" step="0"  OnEnter="salir()" fnt="Arial,16" available="N" visible="N"/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, asterisco  ;		var cmdQuery, cuboQuery, ok, mensajeError, xml_cubo_cata, accion, externo, straccion, clave_sel, sucursal_id, resVal;		var k_ident, k_suc ;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			rol_usuario = frn.config("user","role");			asterisco = "*";			accion = frn.param(0);			k_ident = frn.param(1);			k_suc = frn.param(2);									ConfiguraUI();			Inicializa();					}		fun vacia_campos(){			frn.rst("k_suc");			frn.rst("porcentaje_1");			frn.rst("porcentaje_2");			frn.rst("porcentaje_3");			frn.rst("porcentaje_4");		}            		fun salir(){			//accion="NUEVO";			//vacia_campos();			//Inicializa();			frn.exit();					}		fun carga_datos(){			//k_ident=frn.param(2);			k_suc=frn.get("k_sucN",-1,1);			cmdQuery = "select c2,c3,c4,c5,c6  from keplersc.kdconflealtad " &				 " where c1 = " & k_ident & " and c2= '" & k_suc & "'";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conf_lealtad_crud.IniCombos()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery ,"C:\Basura\cuboQuery ");									frn.set("k_sucN",descr_combo("k_sucN",1,getXmlAtt(cuboQuery ,"r0","c2")));				frn.set("porcentaje_1",getXmlAtt(cuboQuery ,"r0","c3") );			frn.set("porcentaje_2",getXmlAtt(cuboQuery ,"r0","c4") );			frn.set("porcentaje_3",getXmlAtt(cuboQuery ,"r0","c5") );			frn.set("porcentaje_4",getXmlAtt(cuboQuery ,"r0","c6") );									}		fun ValidarDatos(){			if (frn.get("k_sucN") &= "") {										frn.setPos("k_sucN");				resVal=0;				frn.message("Debe especificar Sucursal, verificar","Error","Aceptar");				return;			}			if (frn.get("porcentaje_1") &= "") {										frn.setPos("porcentaje_1");				resVal=0;				frn.message("Debe especificar porcentaje 1, verificar","Error","Aceptar");				return;			}			if (frn.get("porcentaje_2") &= "") {										frn.setPos("porcentaje_2");				resVal=0;				frn.message("Debe especificar porcentaje 2, verificar","Error","Aceptar");				return;			}			if (frn.get("porcentaje_3") &= "") {										frn.setPos("porcentaje_3");				resVal=0;				frn.message("Debe especificar porcentaje 3, verificar","Error","Aceptar");				return;			}						if (frn.get("porcentaje_4") &= "") {										frn.setPos("porcentaje_4");				resVal=0;				frn.message("Debe especificar porcentaje 4, verificar","Error","Aceptar");				return;			}		}		fun Execute() {			resVal = 1;			ValidarDatos();			if(resVal == 0){				return;			}						var resultado_confirmacion = frn.message("Desea continuar?","Mensaje de Confirmacion", 2);			if (resultado_confirmacion &! 1)  {				return;			}						var xmlRequest = getXml(frn.dataPag());						setXml(xmlRequest,"document","ident", k_ident );											frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");					cmdQuery="SELECT * FROM keplersc.conf_lealtad_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";			var cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_sucursales.Execute()");				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");								var resultado=getXml(cubo ,"resultado");						if(resultado &= "0"){				mensajeError = getXml(cubo ,"mensaje");				frn.message(mensajeError,"Error","Aceptar");				return;			}			frP.script("Inicia_Forma()");					var sms =  "";			if (accion &= "NUEVO"){				sms = "Registro guardado";				frn.setAtt("k_btn_cons", "available", "N" );				frn.setAtt("k_btn_cons", "visible", "N" );				frn.message(sms ,"Mensaje","Aceptar");					salir();			}			if (accion &= "MODIFICAR"){				sms = "Registro modificado";//				accion="CONSULTAR";//				ctlrs_opcion();				frn.message(sms ,"Mensaje","Aceptar");					salir();					}									if (accion &= "ELIMINAR"){				frn.message("Registro eliminado","Mensaje","Aceptar");				salir();						}		}					fun ctlrs_opcion(){			frn.set("input_crud", accion);			frn.rst("grupo_crud");			if (accion &= "NUEVO"){				frn.setAtt("k_sucN", "available", "Y" );				frn.setAtt("k_sucN", "modify", "Y" );				frn.setAtt("porcentaje_1", "available", "Y" );				frn.setAtt("porcentaje_1", "modify", "Y" );				frn.setAtt("porcentaje_2", "available", "Y" );				frn.setAtt("porcentaje_2", "modify", "Y" );				frn.setAtt("porcentaje_3", "available", "Y" );				frn.setAtt("porcentaje_3", "modify", "Y" );								frn.setAtt("porcentaje_4", "available", "Y" );				frn.setAtt("porcentaje_4", "modify", "Y" );			    frn.set("k_titulo","Nueva Conf Lealtad");				frn.setAtt("grupo_crud", "tit", "Nuevo" );				frn.setAtt("k_btn_cons", "visible", "Y" );				frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );						}			if (accion &= "MODIFICAR") {				carga_datos();				frn.setAtt("k_sucN", "available", "Y" );				frn.setAtt("k_sucN", "modify", "Y" );				frn.setAtt("porcentaje_1", "available", "Y" );				frn.setAtt("porcentaje_1", "modify", "Y" );				frn.setAtt("porcentaje_2", "available", "Y" );				frn.setAtt("porcentaje_2", "modify", "Y" );				frn.setAtt("porcentaje_3", "available", "Y" );				frn.setAtt("porcentaje_3", "modify", "Y" );				frn.setAtt("porcentaje_4", "available", "Y" );				frn.setAtt("porcentaje_4", "modify", "Y" );				frn.set("k_titulo","Modifica Conf Lealtad");				frn.setAtt("grupo_crud", "tit", "Modifica" );            frn.setAtt("grupo_crud", "available","Y");				frn.setAtt("k_btn_cons", "visible", "Y" );				frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );			}			if (accion &= "ELIMINAR") {				carga_datos();				frn.set("k_titulo","Elimina Conf Lealtad");				frn.setAtt("grupo_crud", "tit", "Eliminar" );				frn.setAtt("grupo_crud", "available","Y");				frn.setAtt("k_btn_cons", "visible", "Y" );				frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );			}               			if (accion &= "CONSULTAR"){				frn.set("k_titulo","Consulta Conf Lealtad");				frn.setAtt("grupo_crud", "tit", "Consultar" );				frn.setAtt("btn_aceptar", "available", "Y" );				frn.setAtt("btn_aceptar", "visible", "Y" );				frn.setAtt("k_btn_cons", "available", "NN" );				frn.setAtt("k_btn_cons", "visible", "N" );			}					}						fun ConfiguraUI(){			if (frn.nParam() == 0){				frn.message("Accion no permitida.","Error","&Aceptar");				frn.open("redirect",2);				return;			}		}				fun Inicializa(){									//Llenar combo sucursales				var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));								frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));					ctlrs_opcion();									}										fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}								           					}				</script></pag>