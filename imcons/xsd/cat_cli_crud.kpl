<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,12" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<grp id="grupo_crud" dim="125,50,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16"><tab/>			<txt id="txt_clave" visible="Y">*Clave: </txt>			<inp id="input_clave" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" nc="8" available="N" visible="Y" type="string"/>			<tab/><txt>Estatus: </txt>			<inp id="estatus_cte" dim="2,1" brdr="0,2" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" OnF9="ObtenerEstatus()" OnChange="BuscarEstatus()" type="number" tooltip="Clave estatus del cliente ( F9 b&#250;squeda )" fmt="5" nc="1"/>			<sp n="1"/>			<inp id="k_desc_estatus" dim="19,1" brdr="0,2" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" available="Y" type="capital" tooltip="Estatus del cliente" modify="N"/>			<tab n="4"/>			<txt>Sub-Estatus:</txt><tab n="4"/>			<inp id="subestatus_cte" dim="2,1" brdr="0,2" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="N" available="Y" OnF9="ObtenerSubEstatus()" OnChange="BuscarSubEstatus()" type="number" tooltip="Clave Sub-estatus del cliente ( F9 b&#250;squeda )" fmt="5" nc="1"/>			<sp/>			<inp id="k_desc_subestatus" dim="27,1" brdr="0,2" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" available="Y" type="capital" tooltip="Sub-estatus del cliente" modify="N"/>												<br/><tab/><txt id="text_id" visible="Y">*Nombre o raz&#243;n social:</txt><tab n="1"/>			<br/><tab/><inp id="input_nombre_razonsocial"  type="capital" dim="114,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="N" nc="150" fnt=",15" tooltip="Nombre o razon social"/>			<br/><tab/><txt id="text_id">Nombre para impresi&#243;n:</txt><tab/>			<inp id="input_nombre_impresion" type="capital" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y"/><tab n="4"/>			<txt>*Apellido Paterno:</txt><tab n="2"/>			<inp id="input_apellido_p" dim="30,1" brdr="2,0" clr="64,64,64" type="capital" bclr="255,255,255" clrBrdr="255,255,255" tooltip="Apellido paterno"/><br/><tab/><txt>*Apellido Materno:</txt><tab n="2"/>			<inp id="input_apellido_m" type="capital" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" tooltip="Apellido materno"/><tab n="4"/>			<txt>*Nombre(s):</txt><tab n="4"/>			<inp id="input_nombres" type="capital" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" tooltip="Nombre (s)"/><br/><tab/><txt fnt=",b">DIRECCION:</txt><tab/>			<br/><tab/><txt>Calle:</txt><tab n="6"/>			<inp id="input_calle" dim="30,1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" tooltip="Calle"/><tab n="4"/>			<txt>No. Exterior:</txt><tab n="4"/>			<inp id="input_no_exterior" dim="30,1"  brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" tooltip="No. exterior"/><br/><tab/><txt>No. Interior:</txt><tab n="4"/>			<inp id="input_no_interior" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" tooltip="No. interior"/><tab n="4"/>				<txt>Colonia:</txt><tab n="5"/>			<inp id="input_colonia" dim="30,1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" tooltip="Colonia"/><br/><tab/><txt>Ciudad o Poblaci&#243;n:</txt><tab n="2"/>			<inp id="input_ciudad" dim="30,1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" tooltip="Ciudad"/><tab n="4"/>			<txt>Municipio o Delegaci&#243;n:</txt><tab n="1"/>			<inp id="input_municipio" dim="30,1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" tooltip="Municipio"/><br/><tab/>				<txt id="txt_estado" clr="255,0,0" dim="10,10" visible="N">El valor original:</txt><tab/>			<inp id="est" clr="255,0,0" clrBrdr="255,255,255" dim="15,1" bclr="236,240,243" brdr="0,0" fnt="Arial,16bi" tooltip="Estado Incorrecto" available="N" visible="N"/><txt id="txt_estado_2" clr="255,0,0" dim="50,10" visible="N">no es un estado valido. Por favor, elija el correcto de la lista.</txt>			<br/><tab/>			<txt>Estado:</txt><tab n="5"/>			<cmb id="input_estado" clr="64,64,64" clrBrdr="255,255,255" dim="30,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" tooltip="Estado" available="Y" visible="Y"/>			<inp id="input_estado_manual" dim="0,0" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" tooltip="Estado manual" available="N"/><tab n="4"/>			<txt>Pa&#237;s:</txt><tab n="6"/>			<inp id="input_pais" dim="30,1"  brdr="2,0" modify="N" OnF9="ObtenerPais()" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="string" tooltip="Pais ( F9 b&#250;squeda )"/>			<br/><tab/><txt>C&#243;digo Postal:</txt><tab n="3"/>			<inp id="input_cp" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" nc="5" clrBrdr="255,255,255" tooltip="C.P."/><tab n="4"/>			<txt>Correo Electr&#243;nico:</txt><tab n="2"/>			<inp id="input_correo" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" tooltip="Correo electronico"/><br/><tab/><txt fnt=",b">TELEFONOS:</txt><tab/>			<br/><tab/><txt>Tel. Casa:</txt><tab n="4"/>			<inp id="input_tel_casa" dim="30,1" brdr="2,0" clr="64,64,64"  bclr="255,255,255" clrBrdr="255,255,255" visible="Y" tooltip="Telefono casa" type="string" nc="10"/>			<tab n="4"/><txt>Tel. Oficina:</txt><tab n="4"/>			<inp id="input_tel_oficina" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" tooltip="Telefono oficina" type="string" nc="10"/><tab/>			<br/><tab/><txt>Extensi&#243;n:</txt><tab n="4"/>			<inp id="input_tel_ext" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" tooltip="Extension" type="string"/>			<tab n="4"/><txt>*Tel. M&#243;vil:</txt><tab n="4"/>			<inp id="input_tel_movil" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" tooltip="Telefono Movil" type="string"/><tab/>			<br/><tab/><txt>Tel. Referencia:</txt><tab n="3"/>			<inp id="input_tel_referencia" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" tooltip="Telefono de referencia" type="string" nc="10"/><br/><tab/><txt>Nombre Referencia:</txt><tab n="2"/>			<inp id="input_nombre_referencia" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" tooltip="Nombre Referencia" type="capital"/><tab n="4"/><txt>Parentesco c/Cliente:</txt><tab/>			<inp id="input_parentesco_refer_cte" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" tooltip="Parentesco con el titular" type="capital"/>			<br/><tab/><txt fnt=",b">DATOS FACTURACION:</txt>			<br/><tab/><txt>R.F.C.:</txt><tab n="5"/>			<inp id="input_rfc" dim="30,1" brdr="2,0" type="capital" clr="64,64,64" bclr="255,255,255" nc="13" clrBrdr="255,255,255" tooltip="R.F.C."/><tab n="4"/>			<txt>R&#233;gimen Fiscal:</txt><tab n="3"/>			<cmb id="cmb_regfiscal" clr="64,64,64" clrBrdr="255,255,255"  dim="30,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N"  available="Y" tooltip="Regimen fiscal"/>			<br/><tab/><txt>M&#233;todo de Pago:</txt><tab n="2"/>			<cmb id="cmb_metodo_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="30,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N"  available="Y" tooltip="Metodo de pago"/><tab n="4"/>			<txt>Uso del CDFI:</txt><tab n="3"/>			<cmb id="cmb_uso_cfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="30,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N"  available="Y" tooltip="Uso CFDI"/><br/><tab/><txt fnt=",b">INFORMACION DE CREDITO:</txt><tab/>			<br/><tab/><txt>L&#237;mite de Cr&#233;dito:</txt><tab n="2"/>			<inp id="input_limite_credito" dim="30,1" brdr="2,0" nc="15" clr="64,64,64"  type="number" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" tooltip="Limite de credito"/><tab n="4"/>			<txt>Plazo:</txt><tab n="5"/>			<inp id="input_plazo" dim="30,1" brdr="2,0" nc="4" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" tooltip="Plazo"/><tab/>			<br/><tab/><txt id="text_ult_modificacion" visible="Y" fnt=",b">ULTIMA MODIFICACION:</txt><tab/>			<br/><tab/><txt id="text_fecha" visible="Y">Fecha:</txt><tab n="5"/>			<inp id="input_ult_modificacion" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" available="N" type="string" tooltip="Fecha ultima modificacion"/>			<tab n="4"/><txt id="text_usuario" visible="Y">Usuario:</txt><tab n="5"/>			<inp id="input_usuario" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" available="N"/><br/><tab/><bot id="btn_aceptar" dim="15,0" brdr="5" default="0" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/><tab n="2"/>						<inp id="input_crud" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>									</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP,sys, accion,externo,suc_usuario,perfil_usuario,rol_usuario ,asterisco,nombre_usuario , clave,resVal;			var estado_extranjero;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				sys=new SYS;				kdb=new KDB;				kdb.connect();													suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");			   nombre_usuario = frn.lib("libKepler","UserInfo(3)");			   rol_usuario = frn.config("user","role");				asterisco = "*";								ctlrs_off();				llenar_ctlrs_default();				config_ctrls_permisos();								}						fun ctlrs_off(){				frn.setAtt("input_ult_modificacion", "available", "N" );				frn.setAtt("input_usuario", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );				frn.setAtt("text_ult_modificacion", "visible", "N" );				frn.setAtt("input_ult_modificacion", "visible", "N" );				frn.setAtt("input_usuario", "visible", "N" );				frn.setAtt("text_fecha", "visible", "N" );				frn.setAtt("text_usuario", "visible", "N" );				frn.setAtt("txt_clave", "visible", "Y" );				frn.setAtt("input_clave", "visible", "Y" );				frn.setAtt("input_nombre_razonsocial", "available", "N" );							}							fun llenar_ctlrs_default(){												frn.rst("grupo_crud");							accion = frn.param(0);								if (accion &= "Nuevo"){					frn.setAtt("txt_clave", "visible", "N" );					frn.setAtt("input_clave", "visible", "N" );					frn.set("estatus_cte",1);					frn.set("k_desc_estatus","ACTIVO");					frn.setPos("input_nombre_razonsocial");				}								externo	= frn.param(2);							var xmlRequest,cmd,ok, cuboResultados;								frn.set("input_crud", accion);							frn.setAtt("grupo_crud", "tit", accion );								//llenar combo uso cfdi				cmd = "select '['||c1||'] '||c2 as descripcion,c1 as clave from keplersc.kdf3uso" ;				cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_cli_crud.llenar_ctlrs_default()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				var combo_uso_cfdi = "cmb_uso_cfdi";					frn.setX("", combo_uso_cfdi,0,0);				frn.setX("", combo_uso_cfdi, 0, 1);									llenar_cmb(cuboResultados,combo_uso_cfdi);									//llenar combo metodo de pago				cmd = "select '['||c1||'] '||c2 as descripcion,c1 as clave from keplersc.kdf3mp" ;				cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_cli_crud.llenar_ctlrs_default()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				var combo_metodos_de_pago = "cmb_metodo_pago";					frn.setX("", combo_metodos_de_pago ,0,0);				frn.setX("", combo_metodos_de_pago , 0, 1);									llenar_cmb(cuboResultados,combo_metodos_de_pago );								//llenar combo regimen fiscal				cmd = "select '['||c1||'] '||c2 as descripcion,c1 as clave from keplersc.kdf3rf" ;				cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_cli_crud.llenar_ctlrs_default()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				var combo_regfiscal = "cmb_regfiscal";					frn.setX("", combo_regfiscal ,0,0);				frn.setX("", combo_regfiscal , 0, 1);									llenar_cmb(cuboResultados,combo_regfiscal);				//llenar combo uso estado				cmd = "select estado_canonico as descripcion from keplersc.cat_estados_match order by estado_canonico" ;				cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_cli_crud.llenar_ctlrs_default()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				var combo_input_estado = "input_estado";					frn.setX("", combo_input_estado,0,0);				frn.setX("", combo_input_estado, 0, 1);									llenar_cmb(cuboResultados,combo_input_estado);				if (accion &= "Modificar"){									//llamada externa(padre)					if (externo &= "s"){											clave =frP.get(frn.param(3));												if (clave &= ""){													frn.message("No hay ningun cliente seleccionado","Error","Aceptar");							return;						}											}else {											clave = frn.param(1);					}				}								if (accion &! "Nuevo") {					if (accion &! "Modificar"){						clave = frn.param(1);					}									frn.setAtt("text_ult_modificacion", "visible", "Y" );					frn.setAtt("input_ult_modificacion", "visible", "Y" );					frn.setAtt("input_usuario", "visible", "Y" );					frn.setAtt("text_fecha", "visible", "Y" );					frn.setAtt("text_usuario", "visible", "Y" );									var campos = "cli.c2,cli.c3,cli.c30,cli.c33,cli.c34,cli.c35,cli.c4,cli.c45,cli.c46,cli.c5,cli.c6,cli.c47,COALESCE(est.estado_canonico, cli.c48) AS estado,pa.c1 as pais,cli.c27,cli.c10,cli.c11,cli.estatus,cu.c2 as desc_estatus,cli.subestatus,sec.c3 as desc_subestatus,";							campos = campos & "cli.c7,cli.c8,cli.c37,cli.c9,cli.c36,'['||mp.c1||'] '||mp.c2 as m_pago,'['||uso.c1||'] '||uso.c2 as uso_cfdi,'['||rf.c1||'] '||rf.c2 as regfiscal,cli.c15,cli.c16,cli.c42,cli.c43,cli.nombre_referencia,cli.parentesco_refer_cte"; 					cmd="select " & campos & " from keplersc.kdud as cli left outer join keplersc.kdf3mp as mp on cli.c52=mp.c1 "; 					cmd = cmd & "left outer join keplersc.kdf3uso as uso on cli.c53=uso.c1 left outer join keplersc.kdf3rf as rf on cli.c54=rf.c1 ";					cmd = cmd & "left outer join keplersc.kdconduni as cu on cu.c1=cli.estatus ";					cmd = cmd & "left outer join keplersc.kdsubestatuscte as sec on sec.c1=cli.subestatus and sec.c2=cli.estatus ";					cmd = cmd & "left outer join keplersc.cat_estados_match est ON upper(trim(cli.c48)) ~ est.patron_regex ";					cmd = cmd & "left outer join keplersc.kdf3pais as pa on cli.c49=pa.c1 where cli.c2 ='" & clave & "'";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_vin_crud.llenar_ctlrs_default()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}													frn.set("input_clave",getXmlAtt(cuboResultados,"r"&0,"c2"));										frn.set("estatus_cte",getXmlAtt(cuboResultados,"r"&0,"estatus"));					frn.set("k_desc_estatus",getXmlAtt(cuboResultados,"r"&0,"desc_estatus"));					frn.set("subestatus_cte",getXmlAtt(cuboResultados,"r"&0,"subestatus"));					frn.set("k_desc_subestatus",getXmlAtt(cuboResultados,"r"&0,"desc_subestatus"));					frn.set("input_nombre_razonsocial",getXmlAtt(cuboResultados,"r"&0,"c3"));					frn.set("input_nombre_impresion",getXmlAtt(cuboResultados,"r"&0,"c30"));					frn.set("input_apellido_p", getXmlAtt(cuboResultados,"r"&0,"c33"));					frn.set("input_apellido_m",getXmlAtt(cuboResultados,"r"&0,"c34"));					frn.set("input_nombres",getXmlAtt(cuboResultados,"r"&0,"c35"));									frn.set("input_calle",getXmlAtt(cuboResultados,"r"&0,"c4"));					frn.set("input_no_exterior",getXmlAtt(cuboResultados,"r"&0,"c45"));					frn.set("input_no_interior",getXmlAtt(cuboResultados,"r"&0,"c46"));					frn.set("input_colonia",getXmlAtt(cuboResultados,"r"&0,"c5"));					frn.set("input_ciudad",getXmlAtt(cuboResultados,"r"&0,"c6"));					frn.set("input_municipio",getXmlAtt(cuboResultados,"r"&0,"c47"));					frn.set("input_pais",getXmlAtt(cuboResultados,"r"&0,"pais"));					frn.set("input_cp",getXmlAtt(cuboResultados,"r"&0,"c27"));					frn.set("input_rfc",getXmlAtt(cuboResultados,"r"&0,"c10"));					frn.set("input_correo",getXmlAtt(cuboResultados,"r"&0,"c11"));					frn.set("input_tel_casa",getXmlAtt(cuboResultados,"r"&0,"c7"));					frn.set("input_tel_oficina",getXmlAtt(cuboResultados,"r"&0,"c8"));					frn.set("input_tel_ext",getXmlAtt(cuboResultados,"r"&0,"c37"));					frn.set("input_tel_movil",getXmlAtt(cuboResultados,"r"&0,"c9"));					frn.set("input_tel_referencia",getXmlAtt(cuboResultados,"r"&0,"c36"));					frn.set("cmb_metodo_pago",getXmlAtt(cuboResultados,"r"&0,"m_pago"));					frn.set("cmb_uso_cfdi",getXmlAtt(cuboResultados,"r"&0,"uso_cfdi"));					frn.set("cmb_regfiscal",getXmlAtt(cuboResultados,"r"&0,"regfiscal"));					frn.set("input_limite_credito",getXmlAtt(cuboResultados,"r"&0,"c15"));					frn.set("input_plazo",getXmlAtt(cuboResultados,"r"&0,"c16"));					frn.set("input_ult_modificacion",getXmlAtt(cuboResultados,"r"&0,"c42"));					frn.set("input_usuario",getXmlAtt(cuboResultados,"r"&0,"c43"));					//MSS 22012026 Agregar datos de referencia					frn.set("input_nombre_referencia",getXmlAtt(cuboResultados,"r"&0,"nombre_referencia"));					frn.set("input_parentesco_refer_cte",getXmlAtt(cuboResultados,"r"&0,"parentesco_refer_cte"));										var estado_db = getXmlAtt(cuboResultados,"r"&0,"estado");					toggle_estado_control(estado_db);										if (frn.get("estatus_cte")&=0){						frn.set("estatus_cte",1);						frn.set("k_desc_estatus","ACTIVO");					}						} 								if (accion &! "Consultar"){										frn.setAtt("btn_aceptar", "visible", "Y" );				}			}					fun toggle_estado_control(estado_valor){								var cmd, cuboResultados, ok;				estado_extranjero = 0;				if (accion &= "Modificar" || accion &= "Consultar"){					cmd = "SELECT EXISTS ( " &						"SELECT 1 FROM keplersc.cat_estados_match " &						"WHERE upper(trim('" & estado_valor & "')) = estado_canonico ) " &						"AND trim('" & estado_valor & "') NOT IN ('', '.') " &						"AS estado_valido";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",											cmd,"cat_cli_crud.toggle_estado_control()");																frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\estado_valido");					ok = getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						return;					}					var estado_valido = getXmlAtt(cuboResultados,"r0","estado_valido");				if (estado_valido == "1" ){					frn.setAtt("input_estado", "available", "Y");					frn.setAtt("input_estado", "visible", "Y");					frn.setAtt("input_estado", "dim", "30,1");					frn.set("input_estado", trim(estado_valor));										frn.setAtt("txt_estado", "visible", "N");					frn.setAtt("est", "visible", "N");					frn.setAtt("txt_estado_2", "visible", "N");					frn.setAtt("input_estado_manual", "available", "N");					frn.setAtt("input_estado_manual", "dim", "0,0");					frn.setAtt("input_estado_manual", "visible", "N");				} else if (frn.get("input_pais") &= "MEX"){					frn.setAtt("txt_estado", "visible", "Y");					frn.setAtt("est", "visible", "Y");					frn.set("est", estado_valor);					frn.setAtt("txt_estado_2", "visible", "Y");					frn.setAtt("input_estado_manual", "available", "N");					frn.setAtt("input_estado_manual", "dim", "0,0");															frn.setAtt("input_estado", "available", "Y");					frn.setAtt("input_estado", "dim", "30,1");					frn.setAtt("input_estado", "visible", "Y");					frn.set("input_estado", trim(estado_valor));									} else if (frn.get("input_pais") &! "MEX"){					frn.setAtt("input_estado", "available", "N");					frn.setAtt("input_estado", "dim", "0,0");					frn.setAtt("input_estado", "visible", "N");					frn.setAtt("input_estado_manual", "available", "Y");					frn.setAtt("input_estado_manual", "dim", "30,1");					frn.set("input_estado_manual", estado_valor);					estado_extranjero = 1;				}			}else if(accion &= "Nuevo"){				frn.setAtt("input_estado_manual", "available", "N");				frn.setAtt("input_estado_manual", "dim", "0,0");				frn.setAtt("input_estado_manual", "visible", "N");				frn.setAtt("input_estado", "available", "Y");				frn.setAtt("input_estado", "dim", "30,1");				frn.setAtt("input_estado", "visible", "Y");							 			}		}					fun config_ctrls_permisos(){		//MSS 01112024 Activa el campo de nombre y permite modificarlo dependiendo del usuario autorizado 				var opc_usuario;				if (accion &! "Nuevo") {					if (accion &= "Modificar") {						opc_usuario = frn.lib("libGeneral.kpl","ValidaPermisosUsr",suc_usuario, "Modifica nombre en cat clientes",nombre_usuario);						if (opc_usuario==0){							frn.setAtt("input_nombre_razonsocial", "available", "N" );						} else {							frn.setAtt("input_nombre_razonsocial", "available", "Y" );						}					} else{						frn.setAtt("input_nombre_razonsocial", "available", "N" );					}	 				} else{					frn.setAtt("input_nombre_razonsocial", "available", "Y" );					}												}						fun Execute() {						var resultado_confirmacion,xmlRequest,cmd,cuboResultados,ok,cmd,cubo, mensajeError ;								resVal =1;				ValidaEstatus_Subestatus();				if(resVal == 0){					return;				}				resultado_confirmacion = frn.message(" Estas seguro?","Mensaje de Confirmacion",2);								if (resultado_confirmacion &! 1)  {					return;					}											frn.set("input_ult_modificacion",sys.date());								frn.set("input_usuario",nombre_usuario);					if (estado_extranjero &= 1){					frn.setX(frn.get("input_estado_manual"), "input_estado",0,0 );				}														xmlRequest = getXml(frn.dataPag()); 							frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmd="SELECT * FROM keplersc.cli_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";					cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"cat_cli_crud.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");													var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;						}											if (accion &= "Nuevo" || accion &= "Modificar") {									clave = getXml(cubo ,"mensaje");										var nuevo_nombre = frn.get("input_nombre_razonsocial");									if (externo &= "n"){										frP.setX(clave ,"tabla",-1,"clave"); 						frP.scriptElm("tabla","OnChange","clave");						frP.setX(nuevo_nombre ,"tabla",-1,"nombre"); 						frP.scriptElm("tabla","OnChange","nombre");						frP.script("CargaEvento()");					}else{												frP.set(frn.param(3),clave ); 						frP.scriptElm(frn.param(3),"OnChange");					}														var sms =  "";										if (accion &= "Nuevo"){						sms = "Cliente registrado";					}else {						sms = "Cliente modificado";					}											frn.message(sms ,"Mensaje","Aceptar");					frn.exit();										}								if (accion &= "Eliminar"){										frP.setX("","tabla",-1,"clave"); 					frP.scriptElm("tabla","OnChange","clave");					frP.setX("","tabla",-1,"nombre"); 					frP.scriptElm("tabla","OnChange","nombre");								frn.message("Cliente eliminado","Mensaje","Aceptar");					frn.exit();									}												}						fun ObtenerPais() {							var cmdQuery = "select c1 as clave,c2 as descripcion from keplersc.kdf3pais";            frn.dialog("genlistasel","Catalogo de Paises",cmdQuery,"clave","input_pais","","N");         }									fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave_cli = getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave_cli , cmb, cont+pos_ini ,1);								}				}						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}							fun ObtenerEstatus(){ 				var cmdQuery = "select c1 as clave, c2 as descripcion from keplersc.kdconduni order by c1";				ObtenerDato(cmdQuery,"estatus_cte","Estatus de Cliente");  			}			fun BuscarEstatus(){				var estatus_cte_id,cmdQuery;				estatus_cte_id=frn.get("estatus_cte");				cmdQuery = "select c2 as descripcion from keplersc.kdconduni " &						"where c1='" & estatus_cte_id & "'";				BuscarDato(cmdQuery,"estatus_cte","k_desc_estatus","El estatus del cliente");				frn.set("subestatus_cte",0);				frn.set("k_desc_subestatus","");				frn.setAtt("subestatus_cte", "available","Y");				frn.setAtt("subestatus_cte", "modify","Y");			}			fun ObtenerSubEstatus(){ 				var estatusCte_id,cmdQuery;				estatusCte_id=frn.get("estatus_cte"); 				cmdQuery = "select c1 as clave, c3 as descripcion from keplersc.kdsubestatuscte where c2='" &estatusCte_id & "'  order by c1";				ObtenerDato(cmdQuery,"subestatus_cte","Sub-Estatus de Cliente");  			}			fun BuscarSubEstatus(){				var subestatusCte_id,estatusCte_id,cmdQuery;				estatusCte_id=frn.get("estatus_cte");				subestatusCte_id=frn.get("subestatus_cte");				if (estatusCte_id =="" || estatusCte_id ==0){					frn.setPos("estatus_cte");					frn.message("Debe seleccionar un estatus del cliente","Error","Aceptar");					return;				}									cmdQuery = "select c3 as descripcion from keplersc.kdsubestatuscte " &						"where c1='" & subestatusCte_id & "' and c2='" & estatusCte_id & "'";				BuscarDato(cmdQuery,"subestatus_cte","k_desc_subestatus","El sub-estatus del cliente");			}			fun ObtenerDato(cmdQuery,input,etiqueta){    				frn.dialog("genlistafiltrosel",etiqueta,cmdQuery,"clave",input,"0","0","N","S");						   			}			fun BuscarDato(cmdQuery,clave,desc,msg){				var cve_valor;				var xmlRequest,ok,cuboResultados,cubo,mensajeError,cmd;				cve_valor=frn.get(clave);				//frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\query"&msg);										rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_serie_crud.BuscarDato"&msg&"()");				//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubo"&msg);				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if((nXml(cubo) == 0) && (cve_valor &! "")) {					frn.setPos(cve_valor);					frn.set(clave,"");					frn.message(msg & " no existe","Error","Aceptar");					resVal = 0;					return;                 } else{				    frn.set(desc,getXmlAtt(cubo,"r0","descripcion"));	    				}					}			fun ValidaEstatus_Subestatus(){				if (frn.get("estatus_cte") == 0){					resVal= 0;					frn.setPos("estatus_cte");					frn.message("Debe ingresar el estatus del cliente","Error","Aceptar");					return;				} else{ 					if (frn.get("estatus_cte") == 2 && frn.get("subestatus_cte") == 0) {						resVal= 0;						frn.setPos("subestatus_cte");						frn.message("Debe ingresar el sub-estatus del cliente","Error","Aceptar");						return;					}					}							}				}	</script></pag>