<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>	<tab/><txt fnt=",22" clr="0,0,0">Abrir orden Cerrada en 0s</txt><br/>	<br/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grupo_crud" dim="110,37,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" 			hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" available="Y" tit="Datos orden"><tab/>			<br/>			<tab/>			<txt>Sucursal : </txt>						<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" tooltip="Sucursal" available="Y" modify="Y"/>			<br/>			<br/><tab/> <txt clr="0,58,112">Tipo :</txt><tab n="2"/>			<cmb id="k_tipo_orden" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "Y" modify="Y" 				 tooltip="Tipo de Orden" OnChange="SelTipoOrden()"/>			<sp n="3"/> <txt clr="0,58,112">Orden : </txt>			<inp id="k_orden" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" available = "Y" modify="Y" visible="Y"				 tooltip="N&#250;mero de &#243;rden ( F9 b&#250;squeda )" OnF9="ObtenerNumOrden()" OnChange="OrdenTipo()"/>			<tab/>	 			<img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="BuscarOrden()" available="Y" clrBrdr="0,0,0" visible="Y" tooltip="Buscar Orden"/>			<br/><tab/>				<txt fnt=",bs">Datos del cierre en 0s:</txt>			<br/><tab/>			<txt>Usuario : </txt><tab/>			<inp id="k_usuario" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="18" available="Y" OnChange="" tooltip="Clave de Usuario" modify="N"/>			<tab/><txt>Fecha :  </txt><tab/>			<inp id="k_fecha" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="date" nc="-1" available="Y" OnChange="" tooltip="Fecha de proceso" modify="N" fmt="DD/MM/CCYY"/>			<br/><tab/><txt>Motivo :  </txt><tab/>			<inp id="k_motivo" dim="96,2" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="100" clrBrdr="255,255,255" tooltip="Motivo para cerrar en 0s" available="Y" modify="N"/>			<br/>			<br/>			<tab/>			<grp  bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="0" clrBrdr="0,58,112" dim="110,13,7,12" brdr="0,5"  fnt="Arial,16">				<txt fnt=",bs">Puntos:</txt>				<br/>				<tbl id="tabla_puntos" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="105,8"  hk="z" OnChange="" Reorder="N" modify="Y" insdel="N">					<col id="tipo_punto" name="CveTipo de Punto" visible="N" modify="N" OnChange="calc_importe()" OnF9=""  nc="1" type="capital"/>					<col id="desc_punto" name="Tipo de Punto" modify="Y" OnF9="ObtenerTipoPunto()" type="capital" OnChange="valTipo_punto()"/>					<col id="tipo_operario" OnF9="" visible="N" modify="N" type="capital" name="Tipo de Operario"/>					<col id="desc_operario" OnF9="ObtenerTipoOperario()"  modify="Y" type="capital" name="Tipo de Operario" OnChange="valTipo_operario()"/>					<col id="clave_paquete" OnF9="" OnChange="" name="Paquete"  modify="N" visible="Y" type="capital"/>					<col id="clave_campana" OnF9="" name="Campa&#241;a"  modify="N" visible="N"/>					<col id="trabajo_a_realizar" name="Descripcion" modify="Y" type="capital"/>					<col id="horas" name="Horas" OnChange="calc_importe()" type="number" modify ="N" visible="Y"/>										<col id="clave_operario" OnF9="" visible="N" OnChange="Ope_insert()" modify="N" type="capital" name="CveOperario"/>					<col id="clave_operario_desc" OnF9="Operadores()" OnChange="ValOperario()" modify="Y" type="capital" name="Operario"/>					<col id="status" name="Status" modify="N" visible="N"/>				</tbl>			</grp><br/>			<tab/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Ejecuta()" default="" visible="Y" available="Y"/><br/><br/><tab/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP,sys,resVal;            var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError,cuboQuery,usuario,fileSavePath;            var sucursal_id,tiporden,numorden,rol_usuario,suc_usuario,asterisco, ParamValor, tip_ope;            var horas_P, horas_H , horas_G , horas_I , horas_L, horas_Q, horas_F,	horas_R,hora_limite_semana ,hora_limite_sabado,hora_limite_domingo, costo_por_mano, iva;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				kdb.connect();			   usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				fileSavePath = "C:\Basura";				Inicializa();								tip_ope = 1;							}						fun Inicializa(){				//Llenar combo sucursales				var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}												IniCombos("k_sucn",cmd );							//Fill Combo Tipo de Orden 				cmdQuery = "select c1||'-'||c3 as c2, c1  from keplersc.kdmargen";				IniCombos("k_tipo_orden",cmdQuery);				frn.set("k_tipo_orden", "");							//horas				cmd = "select c26,c27,c28,c29,c11,c30,c10,c31,c32,c33,c34 from keplersc.kdserconfctas"; //where c=sucursal				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_hrs   ");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								//horas por tipo de punto				horas_P = getXmlAtt(cubo,"r0" ,"c26");				horas_H = getXmlAtt(cubo,"r0" ,"c27");				horas_G = getXmlAtt(cubo,"r0" ,"c28");				horas_I = getXmlAtt(cubo,"r0" ,"c29");				horas_L = getXmlAtt(cubo,"r0" ,"c11");				horas_Q = getXmlAtt(cubo,"r0" ,"c30");				horas_F = getXmlAtt(cubo,"r0" ,"c10");								horas_R = getXmlAtt(cubo,"r0" ,"c34");							}					fun IniCombos(ctrl_combo, query){				cmdQuery = query;				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.IniCombos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set(ctrl_combo,cuboQuery);			}			fun SelTipoOrden(){				LimpiaTipOrden();			}			fun LimpiaTipOrden(){				frn.set("k_orden", "");				frn.set("k_usuario", "");				frn.set("k_fecha", "");					frn.set("k_motivo", "");				frn.rst("tabla_puntos");			}						fun LimpiaOrden(){				frn.set("k_usuario", "");				frn.set("k_fecha", "");					frn.set("k_motivo", "");				frn.rst("tabla_puntos");			}						fun LimpiaPunto(){							frn.setX("","tabla_puntos",-1,"tipo_punto");				frn.setX("","tabla_puntos",-1,"desc_punto");				frn.setX("","tabla_puntos",-1,"tipo_operario");				frn.setX("","tabla_puntos",-1,"desc_operario");				frn.setX("","tabla_puntos",-1,"clave_paquete");				frn.setX("","tabla_puntos",-1,"clave_campana");				frn.setX("","tabla_puntos",-1,"trabajo_a_realizar");				frn.setX("","tabla_puntos",-1,"horas");				frn.setX("","tabla_puntos",-1,"precio_punto");				frn.setX("","tabla_puntos",-1,"clave_operario");				frn.setX("","tabla_puntos",-1,"clave_operario_desc");				frn.setX("","tabla_puntos",-1,"status");							}				fun ObtenerNumOrden() {							sucursal_id = frn.get("k_sucn",-1,1);				tiporden = frn.get("k_tipo_orden",-1,1);				LimpiaTipOrden();				cmdQuery = "select c2 as tipo, c3 as orden, c4 as usuario, to_char(c5, 'dd/mm/yyyy') as fecha, concat(c2,'~',c3) as torden							from keplersc.kdordceros							where c1 = '" & sucursal_id & "'";											if (tiporden &! ""){					cmdQuery = cmdQuery & " and c2= '" & tiporden & "'";				}							cmdQuery =	cmdQuery &	" order by c5 desc";	 				frn.dialog("genlistafiltrosel","Ordenes cerradas en Os",cmdQuery,"torden","k_orden","0","0","S","N");											}								fun BuscarOrden(){					var xmlRef, nCampos, xmlRequest, xmlEncabezado;				var tmpStr, tmpXml, contDet, xmlCurDet, xmlDetConv, tmpUsocfdi;				if (frn.get("k_tipo_orden",-1,1) &= ""){					frn.message("Debe seleccionar tipo de Orden","Error","Aceptar");					return;				}								// Guarda Datos para Busqueda 				sucursal_id = frn.get("k_sucn",-1,1);												tiporden = frn.get("k_tipo_orden",-1,1);				numorden = PadLeft(frn.get("k_orden"),"10","0"); 				frn.set("k_orden",numorden);					if (tiporden &= ""){					frn.setPos("k_tipo_orden");					frn.message("Debe seleccionar tipo de Orden","Error","Aceptar");					return;				}				LimpiaOrden();				//Datos	de orden en ceros				cmdQuery = "select c4, c5, c6 from keplersc.kdordceros							where c1='" & sucursal_id & "' and c2='" & tiporden & "' and c3='" & numorden & "'";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcerrarordenceros.BuscarOrden()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboorden");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if((nXml(cuboQuery) > 0)) {					frn.set("k_usuario",getXmlAtt(cuboQuery,"r0","c4"));					frn.set("k_fecha",getXmlAtt(cuboQuery,"r0","c5"));					frn.set("k_motivo",getXmlAtt(cuboQuery,"r0","c6"));					frn.message("1. Cambie los tipos de puntos No autorizados al tipo correspondinete|2. Para cambiar precio y/o horas entre a la opcion de Modificacion de Ordenes","Error","Aceptar");				}else{					frn.setPos("k_orden");					frn.message("La orden no esta cerrada en 0s","Error","Aceptar");					return;				}								//Puntos				cmdQuery = "select pun.c6 as tipo_punto, cat.c2 desc_punto, pun.c37 as tipo_operario,oper.c2 as desc_operario, pun.c5 as clave_paquete, pun.c50 as clave_campana,							pun.c8 as trabajo_a_realizar, pun.c40 as horas, /*paq.c10 as precio_punto,*/ ope.c1 as clave_operario, ope.c3 as clave_operario_desc, pun.c7 as status							from keplersc.kdordceros as ord left outer join keplersc.kdpun as pun on pun.c1=ord.c1 and pun.c2=ord.c2							and pun.c3=ord.c3 left outer join keplersc.kdserie as ser on ser.c1=ord.c6 							left outer join keplersc.kdspaq as paq on paq.c1=ser.c2 and paq.c2=ser.c3 and paq.c4=pun.c5							left outer join keplersc.catpuntos as cat on cat.c1=pun.c6 left outer join keplersc.kdtoper as oper on oper.c1=pun.c37							left outer join keplersc.kdoper as ope on ope.c1=pun.c9							where ord.c1='" & sucursal_id & "' and ord.c2='" & tiporden & "' and ord.c3='" & numorden & "' order by pun.c4";										rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcerrarordenceros.BuscarOrden()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cubopuntos");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if((nXml(cuboQuery) > 0)) {					frn.set("tabla_puntos",cuboQuery);				}								//obtener costo por mano de obra para orden																														var cmd = "select c4 as costo_por_mano, c11 as iva from keplersc.kdmargen where c1='" & frn.get("k_tipo_orden", -1, 1) & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvordencrud.cambio_orden()");				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_resultados   ");							ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									costo_por_mano = getXmlAtt(cubo,"r0","costo_por_mano");				iva = 1+(getXmlAtt(cubo,"r0","iva")/100);										}						fun OrdenTipo(){				var tord,nCampos,nfolio;					//Separa el tipo y folio orden, vienen concatenados con ~				nCampos = strSplit(frn.get("k_orden"),"~",-1);				if (nCampos > 1) {					tord = strSplit(frn.get("k_orden"),"~",0);					nfolio = strSplit(frn.get("k_orden"),"~",1);					frn.set("k_tipo_orden",tord);					frn.set("k_orden",nfolio);					frn.set("k_tipo_orden",descr_combo("k_tipo_orden",1,tord));				}				Formar_folio();			}				fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_orden"));								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvabrirordenceros.Formar_folio()");				frn.lib("libGeneral.kpl","FileSave",cubofol,"C:\Basura\cuboFol");								var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");								frn.set("k_orden", fol);			}			fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}			fun ValidarDatos(){				if (frn.get("k_tipo_orden") &= "") {											frn.setPos("k_tipo_orden");					resVal=0;					frn.message("Debe especificar el tipo de la órden, verificar","Error","Aceptar");				}				if (frn.get("k_orden") &= "") {											frn.setPos("k_orden");					resVal=0;					frn.message("Debe especificar el folio de la órden, verificar","Error","Aceptar");				}			}			fun Ejecuta() {				var xmlPantalla,continua,partidas;				partidas = 1;				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}				continua = frn.message("¿Desea continuar para abrir la orden cerrada en ceros?","Atención",2);				if (continua == 0){					return;				}				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;										setXml(xmlPantalla ,"ctd_puntos",frn.N("tabla_puntos") - 1);				setXml(xmlPantalla ,"usuario",usuario);				setXml(xmlPantalla ,"flag_abrir_orden","abrir_ceros");				frn.lib("libGeneral.kpl","FileSave",xmlPantalla ,"C:\Basura\xmlPantalla ");					cmdQuery="SELECT * FROM keplersc.abrir_orden_ceros('<document>" & getXmlStr(xmlPantalla ,"EOF:13_10") & "</document>')";				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvcerrarordenceros.Ejecuta()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");				var mensaje = getXml(cubo,"mensaje");				if(resultado &= "0"){					frn.message(mensaje ,"Error","Aceptar");					return;				}					if(resultado &= "1"){					frn.message(mensaje ,"Atencion","Aceptar");				}							}						fun PadLeft(pText,pRelleno,pCaracterRelleno) {			var Resultado;			var pos_ini = pText;			var nReg = strlen(pText);			for (var cont = nReg; cont < pRelleno; cont++) {				Resultado = pCaracterRelleno & Resultado;			}			Resultado = Resultado & pText;                			return Resultado;		}							fun ObtenerTipoPunto(){			var cmd;										cmd= "select pun.c2 as punto, cat.c2 as descripcion from keplersc.kdtipoordentipopuntos as pun " & 					"inner join keplersc.catpuntos as cat on cat.c1= pun.c2 " &					"where pun.c1='" & frn.get("k_tipo_orden", -1, 1) & "'";				frn.dialog("genlistafiltrosel","Puntos",cmd,"punto","tabla_puntos",-1,"desc_punto","S","S");					   		}				fun valTipo_punto(){			//MSS 06122024 Valida dato capturado			var cmd,ok,mensajeError,len_result;							cmd="select punto,descr from (" &				"select pun.c2 as punto, cat.c2 as descr from keplersc.kdtipoordentipopuntos as pun " & 				"inner join keplersc.catpuntos as cat on cat.c1= pun.c2 " &				"where pun.c1='" & frn.get("k_tipo_orden", -1, 1) & "') puntos " &				"where punto='" & frn.get("tabla_puntos", -1, "desc_punto") & "'";			cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"valTipo_punto.Inicializa()");							frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");							ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");							len_result = nXml(cubo);							if (len_result == 0){				resVal=0;				frn.message("El tipo de punto " & frn.get("tabla_puntos", -1, "desc_punto")  & " para el tipo de orden " & frn.get("k_tipo_orden", -1, 1) & " no existe. Verifique...","Error","Aceptar");				frn.setPos("tabla_puntos", -1, "desc_punto");								return;			} else {				frn.setX(getXmlAtt(cubo,"r0", "punto"), "tabla_puntos", -1, "tipo_punto");				frn.setX(getXmlAtt(cubo,"r0", "descr"), "tabla_puntos", -1, "desc_punto");			}//no	calcule		calc_importe();		}		fun ObtenerTipoOperario(){			var cmd,tipo_punto;			tipo_punto= frn.get("tabla_puntos" , -1, "tipo_punto");						cmd= "select cat.c1 clave,cat.c2 tipo from keplersc.kdpuntop as top inner join keplersc.kdtoper as cat on cat.c1=top.c2 where top.c1='" & tipo_punto & "'";				frn.dialog("genlistafiltrosel","Tipo Operario",cmd,"clave","tabla_puntos",-1,"desc_operario","S","S");					   		}		fun valTipo_operario(){					//MSS 06122024 Valida dato capturado			var cmd,ok,mensajeError,len_result,tipo_punto,tipo_oper;			tipo_oper=frn.get("tabla_puntos" , -1, "desc_operario");			tipo_punto= frn.get("tabla_puntos" , -1, "tipo_punto");			cmd="select tipo,descr from (" & 				"select cat.c1 tipo,cat.c2 descr from keplersc.kdpuntop as top inner join keplersc.kdtoper as cat on cat.c1=top.c2 where top.c1='" & tipo_punto & "') tp " &				"where tipo = '" & tipo_oper & "'";			cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"valTipo_operario.Inicializa()");							frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");							ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");							len_result = nXml(cubo);							if (len_result == 0){				resVal=0;				frn.message("El tipo de operario no existe. Verifique...","Error","Aceptar");				frn.setPos("tabla_puntos", -1, "desc_operario");				return;			} else {				frn.setX(getXmlAtt(cubo,"r0", "tipo"), "tabla_puntos", -1, "tipo_operario");				frn.setX(getXmlAtt(cubo,"r0", "descr"), "tabla_puntos", -1, "desc_operario");			}				}						fun ValOperario(){			var cmd,ok,mensajeError,len_result,tipo_operario,cve_operario_desc;			tipo_operario = frn.get("tabla_puntos",-1,"tipo_operario");			cve_operario_desc = frn.get("tabla_puntos", -1, "clave_operario_desc");			if (cve_operario_desc &! ""){				cmd="select clave,nombre from (" & 					"select c1 as clave, c2 as tipo, c3 as nombre , c1 || '|' || c3 as clave_desc " &					" from keplersc.kdoper where c2='" & tipo_operario & "' and c12='S') tp " &					"where clave = '" & cve_operario_desc & "'";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"valTipo_operario.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdResultados");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								len_result = nXml(cubo);								if (len_result == 0){					resVal=0;					frn.message("El operario no existe. Verifique...","Error","Aceptar");					frn.setPos("tabla_puntos", -1, "clave_operario_desc");					return;				} else {					frn.setX(getXmlAtt(cubo,"r0", "clave"), "tabla_puntos", -1, "clave_operario");					frn.setX(getXmlAtt(cubo,"r0", "nombre"), "tabla_puntos", -1, "clave_operario_desc");				}			}			}							fun Ope_insert(){						var clave_operario = frn.get("tabla_puntos", -1, "clave_operario");			var clave= strSplit(clave_operario ,"|",0);			var descr = strSplit(clave_operario ,"|",1);           			frn.setX(clave, "tabla_puntos", -1, "clave_operario");         frn.setX(descr , "tabla_puntos", -1, "clave_operario_desc");            		}						fun Operadores(){			var tipo_operario = frn.get("tabla_puntos",-1,"tipo_operario");			cmdQuery = "select c1 as clave, c2 as tipo, c3 as nombre , c1 || '|' || c3 as clave_desc " &							" from keplersc.kdoper where c2='" & tipo_operario & "' and c12='S' ";			frn.dialog("genlistafiltrosel","Operadores",cmdQuery,"clave_desc","tabla_puntos", "","clave_operario","N");            		}				fun ParametroValor(ParamNombre){			//MSS 04122024 PARAMETRIZAR PRECIO EN 0 PARA ORDENES DE HOJALATERIA			var cmd,ok,mensajeError ;			cmd = "select coalesce(valor,'') as valor from keplersc.param_oper					where sucursal ='" & frn.get("k_sucN",-1,1) & "' and parametro='" & ParamNombre & "'";			rstXml(cubo);			cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"autorizacion.ParametroValor()");			ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			return getXmlAtt(cubo,"r0","valor");		}							}	</script></pag>