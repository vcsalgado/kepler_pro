<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Vendedores">
<grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">
	<tab/><txt fnt=",22" clr="0,0,0">  VENDEDORES</txt><tab/>
	<br/>
		<tab/><hLine clr="0,0,0"	dim="45,0,0,0"/>
	<br/>
	<br/><tab/>
	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 
		dim="45,25,10,17" brdr="0,5" tit="Vendedores" fnt="Arial,16">
		
			<sp/><txt clr="0,58,112" hk="S">Sucursal:</txt>
		<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="23,36" bclr="255,255,255" brdr="2,0" OnChange="ResetDetalle()" fnt="Arial,16" Null="N" hk="S" available="Y"/>
		<sp n="2"/><txt>Vendedor:</txt>
		<cmb id="vendedores" dim="25,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y" fnt="Arial,0" Null="N" OnChange="ResetDetalle()"/>	<tab/>
		<img id="img_buscar" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="ObtenerVendedor()"/>	
		<br/>
		<sp/>
		
		<tbl id="k_mov" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="88,20" modify="Y" Reorder="Y" available="Y" insdel="Y">
			<col name="Clave" id="clave"  modify="N" visible="Y"/>
			<col name="Nombre" id="nombre"  nc="30" visible="Y"/>
			<col name="Empresa" id="empresa"  nc="5" visible="Y"/>
			<col name="Usuario" id="usuario"  nc="21" visible="Y"/>
			<col name="Activo" id="activo"  modify="N" visible="Y"/>
			<col name="Grupo" id="grupo"  nc="1" visible="Y"/>	
			<col name="Esquema" id="esquema" OnF9="esquema_sel()" nc="5" OnChange="insert_registro_esquema()"  visible="Y"/>
		</tbl>
		<br/><sp/>
		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Guardar" hk="K" default="1" step="0"  OnEnter="Guardar()" fnt="Arial,16"/>
	</grp>
</grp>
<script>
	InstallDriver("KDB75");
	class Main {
		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, asterisco  ;
		var cmdQuery, cuboQuery, ok, mensajeError;
		fun Main(){
			frn=new FRNT;
			kdb=new KDB;
			frP=new FRNTP;
			sys=new SYS;
			kdb.connect();
			
			suc_usuario = frn.lib("libKepler","UserInfo(1)");
			perfil_usuario = frn.lib("libKepler","UserInfo(2)");
			rol_usuario = frn.config("user","role");
			asterisco = "*";
			
			llena_combos();
			ConfiguraUI();
			Inicializa();
		}
            
		fun llena_combos(){
		
	
		//Llenar combo sucursales
			cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";
			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){
				cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";
			}else {
				if (suc_usuario &! asterisco && suc_usuario &! "" ){
					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";
				}
			}
				
			cmdQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery ,"cat_crud_vendedores.Inicializa()");
					
			ok=getXmlAtt(cmdQuery ,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cmdQuery ,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
				
			frn.set("k_sucN",getXml(cmdQuery ));
			frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));	
				
				
				
			//vendedores
			cmdQuery = "select c3 as descripcion,c2 as clave from keplersc.kduv where c1='" & frn.get("k_sucN", -1 , 1) & "'";
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_vendedores.llena_combos()");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
		
			frn.setX("", "vendedores",0,0);

			llenar_cmb(cuboQuery ,"vendedores");	

			ResetDetalle();
		}
		
		fun ResetDetalle(){
			frn.rst("k_mov");
		}
		
		fun ObtenerVendedor(){
			var xmlPantalla;
			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;

			cmdQuery = "select c2 as  clave, c3 as nombre, c4 as empresa, c5 as usuario, c6 as activo, c7 as grupo, c8 as esquema from keplersc.kduv where c1='" & frn.get("k_sucN", -1 , 1) & "'";
			
			var vendedor_sel = frn.get("vendedores", -1, 1);
			if ( vendedor_sel &! ""){
				cmdQuery = cmdQuery & " and c2='" & vendedor_sel & "'";
			}

			rstXml(cuboQuery);
			
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_vendedores.ObtenerVendedor");
			ok=getXmlAtt(cuboQuery,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cuboQuery,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			frn.set("k_mov",cuboQuery);			
		}
		
		fun Guardar(){
			var xmlPantalla,no_partidas,resultado,mensaje,adicionales;
			//Validaciones
			no_partidas=frn.N("k_mov")-1;
			if (no_partidas==0) {
				frn.message("Error, no se tiene registros de configuracion","Error","Aceptar");
				return;
			}
			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
			
			setXml(xmlPantalla ,"k_partidas","no_partidas",no_partidas);			
			frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaLineas");
			cmdQuery="select * from keplersc.vendedores_editar('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";			
			kdb.rst(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_crud_vendedores.Alta");
			resultado= getXml(cuboQuery,"resultado");
			mensaje= getXml(cuboQuery,"mensaje");
				
			if(resultado &= "0"){
				frn.message(mensaje,"Error","Aceptar");
				return;
			}
			frn.message("Registros modificados","Mensaje","Aceptar");
		}
		
		fun ConfiguraUI(){
			if (frn.nParam() == 0){
				frn.message("Accion no permitida.","Error","&Aceptar");
//				frn.open("redirect",2);
				return;
			}
		}		

		fun Inicializa(){
			frn.rst("gpo_2");
			
			ObtenerVendedor();
		}
		
		
		fun esquema_sel() {
		
				cmdQuery = "select c1 as clave, c2 as descripcion from keplersc.kdvesq ";
				
				frn.dialog("genlistafiltrosel","Esquemas",cmdQuery,"clave","k_mov", -1, "esquema","S");
	
      }
      
  
      
      fun insert_registro_esquema(){
	
			  var esq = frn.get("k_mov", -1 , "esquema");

				var cmd = "select c1 from keplersc.kdvesq where c1='" & esq & "'";
				
				var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_crud_vendedores.insert_registro_esquema()");			
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");				
				var len_result = nXml(cubo);				
				if (len_result == 0){
					frn.message("La clave no se encuentra en el catalogo de esquemas para los vendedores ","Error","Aceptar");
					frn.setX("", "k_mov", -1, "esquema");
					return;
				}
		
			}
      
      
		
		
		
		fun llenar_cmb(cuboResultados, cmb){
					
				var len_cubo = nXml(cuboResultados);
				
				var pos_ini = frn.N(cmb);
					
				for (var cont=0; cont<len_cubo ; cont++){
			
					var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");
					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");
					
					frn.setX(desc, cmb, cont+pos_ini ,0);
					frn.setX(clave, cmb, cont+pos_ini ,1);
				
				}	
			}
			
			
			
			fun descr_combo(combo,posicion,valor){

				var descr, valor_actual;
				var len_combo = frn.N(combo);

				for (var cont=0; cont<len_combo ; cont++){
					valor_actual= frn.get(combo,cont,posicion);
					if (valor_actual &=  valor){
						descr = frn.get(combo,cont,0);
						return descr;
					}
				}
			}
			
           
				
	}
	
		
	</script>
</pag>