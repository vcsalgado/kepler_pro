<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<tab/><txt fnt=",22" clr="0,0,0">Refacciones - Inventario Fisico - Diferencias</txt><br/>		<!-- dim="81,0" --> 		<!-- dim="85,0" -->		<tab/><hLine clr="0,0,0"/> 		<br/> 		<br/> 		<!-- <grp dim="46,9,7,12" -->				<tab/>		<grp dim="60,13,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">			<br/>			<sp n="1"/>			<inp id="operacion" dim="30,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" available="N" modify="N" fnt=",18b" just="C"/> 			<br/>			<br/>			<sp n="1"/> <txt>Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>			<br/>			<br/>			<sp n="1"/> <txt>Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N"/> 			<sp n="1"/> <txt>Hora : </txt> 			<sp n="1"/> 			<edt id="k_hora" dim="15,1" type="string" nc="-1" bclr="240,240,240" modify="N" fmt="HH:MM:SS" available="N"/> 			<br/>			<br/>		</grp>				<br/>		<br/>				<sp n="15"/>		<img id="Imprimir" dim="35,35" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Ejecuta_Reporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>					<sp n="25"/>		<img id="Cancelar" dim="35,35" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="N"/>					<sp n="10"/>		<img id="Aceptar" dim="35,35" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Crear registros &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>							</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal, asterisco ;			var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd, uen;         var row_grid, err_data, err_empty, fech_original, view_adicionales;                  // Vars Reports			var cmd, xmlResQuery, strTmp;			var sucursal, xmlPar;										fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";				fileSavePath = "C:\Basura";								row_grid = 0;				err_empty = 0;				err_data = 0;								Inicializa();								ConfiguraControlesOpcion();							} /* END Func Main() */			fun ModoBuscar() {				tip_ope = "C";				frn.set("operacion", "CONSULTA");				ConfiguraControlesOpcion();			}						fun Inicializa(){ //Inicializa los valores en Pantalla				// Our code				var fech_init, strFecha, strTmp,fecha; 			   // Revisa y Carga en Variables los Parámetros Recibidos en la corrida				if( frn.nParam() >= 1 ){ //Se han mandado parámetros a la página					/*					gen_doc = trim(frn.param(0));                nat_doc = trim(frn.param(1));                gpo_doc = trim(frn.param(2));               tip_doc = trim(frn.param(3));                tip_ope = trim(frn.param(4));               */               uen = trim(frn.param(0/*5*/));               tip_ope = "C";					if (uen &! "REF") {						frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");						// /*						//frn.open("index",4);						frn.open("redirect",2);						return;						// */					}				} else {					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					// /*					//frn.open("index",4);					frn.open("redirect",2);					return;					// */				}							// Testing Code //				/*				gen_doc = "N"; 				nat_doc = "D"; 				gpo_doc = "22";				tip_doc = "1"; 				*/				tip_ope = "C"; // "A" 				uen = "REF";				tip_ope_original = tip_ope;					//frn.message("Parameters : " & frn.nParam() & " ; tip_ope : " & tip_ope, "Info Parameters", "Aceptar");								/*if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {*/					/*					if(tip_ope &= "B"){ //Baja						frn.set("operacion","BAJA");					} else {*/						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} else {					      frn.message("Operación no válida ...", "Mensaje","&Aceptar");							//frn.open("anuncios",4);							frn.open("index",4);							return;									}					/*}*/				/*}*/												//LimpiaDatosDoc();								/*if(tip_ope &! "A"){*/																			//Llenar combo sucursales					cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";					if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){						cmd = cmd & " where c1='" & suc_usuario & "'";					}else {						if (suc_usuario &! asterisco && suc_usuario &! "" ){							cmd = cmd & " where c1='" & suc_usuario & "'";						}					}									var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");							ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										frn.set("k_sucn",getXml(cubo));										//CambiaSucursal();											/*} else {*/					/*					row_grid = -1; //0					err_empty = 0;					err_data = 0;					*/							/*}*/								frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());									// Fill k_docto | referencia docto				//ArmarRefDocto();								/*				strFecha = sys.date();				fech_init = strFecha;				frn.set("k_fecha", fech_init);				fech_original = frn.get("k_fecha");				*/							} /* END Func Inicializa() */						fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         } /* END Func PadLeft() */			fun ConfiguraControlesOff() {							frn.setAtt("k_fecha", "available", "N");				frn.setAtt("k_hora", "available", "N");								//frn.setAtt("suctxt", "visible", "N");				//frn.setAtt("k_sucn", "visible", "N");															frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											} /* END Func ConfiguraControlesOff() */									fun ConfiguraControlesOpcion(imodo) {							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta									frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");													} else {														if(tip_ope &= "B"){ //Baja											frn.setAtt("Imprimir", "visible", "N");						frn.setAtt("Cancelar", "visible", "Y");						frn.setAtt("Aceptar", "visible", "Y");															} else {											frn.setAtt("Imprimir", "available", "Y");						frn.setAtt("Imprimir", "visible", "Y");						frn.setAtt("Cancelar", "visible", "N");						frn.setAtt("Aceptar", "visible", "N");						}				}			} /* END Func ConfiguraControlesOpcion() */						fun CambiaSucursal {				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());					if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					/*if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {*/						/*if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {*/							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						/*}*/					/*}*/								}			}						fun CalculaTotales(iModo) {				var monto = 0, monto_acum = 0;				var cantValida = 1, rows;								rows = frn.N("k_mov") - 1; 				//Calcular totales				for (var i=0; i < rows/*frn.N("k_mov")*/; i++) {					if ( strlen(frn.get("k_mov",i,"k_parte")) != 0 ) {						monto = frn.get("k_mov",i,"k_q") * frn.get("k_mov",i,"k_precio");						monto_acum = monto_acum + monto;						frn.setX(monto, "k_mov", i, "monto");					} else {						frn.setX("", "k_mov", i, "monto");					}				}								//frn.set("k_subtotal",subTotal);				//frn.set("k_iva",iva);								frn.set("k_monto",monto_acum);								return cantValida;			}					   					// ZONA	CODIGO REPORTE(S) 						fun IniParams(){//Inicializa parámetros de impresión. Pueden ser cambiados por el usuario final mediante menú: Archivo -> Configurar Página				frn.set("param_paper","letter");	//Tamaño de papel predefinido:	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tamaño de papel personalizado	"size=21.59,27.94cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//Márgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0");	//Escala de impresión (1=100 por ciento)	"F=1,1"				frn.set("param_landscape","N"/*"Y"*/);	//Orientación	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"				frn.set("param_emp","L");	//Posición de "Razón social"(izq,der,cen)	@emp=L|R|C"			}						fun setRepPage() {//Establece los parámetros finales de impresión.				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Ejecuta_Reporte() {							/*				if (  ( frn.N("k_mov") == 0 ) || ( strlen( trim(frn.get("k_folio")) ) == 0 )  ) {					frn.message("Sin Registros por mostrar ...","Info","Aceptar");					return;				}				*/								// Commented 20221208 				//IniParams(); //Inicializa parámtros de impresión entre otros							//Code Added 20121208 				/*				//rstXml(xmlPar);				*/								/*				if ( tip_ope_original &= "C" && tip_ope &= "C" ) {					CambiaSucursal(3); 				}				*/									// fech_original = "2022-11-03"; // 4 Testing				// tip_ope_original = "A"; // 4 Testing								//...(cubos de datos e información necesaria)				sucursal = frn.get("k_sucn",-1,1);								/*				if ( tip_ope_original &= "A" && tip_ope &= "C" ) {					fech_oper = fech_original; // frn.get("k_fecha");				}				tipo_auto = "NUEVO";				*/								/*				// setXml(xmlPar,"document","sucursal_id",sucursal);				*/								/*				if ( tip_ope_original &= "A" && tip_ope &= "C" ) {					setXml(xmlPar,"document","fech_oper", fech_oper); 				}				setXml(xmlPar,"document","tipo_auto", tipo_auto);				*/								//code Added 20221208 by JMM				/*				if ( strlen(frn.get("k_fecha")) > 0 ) { 					setXml(xmlPar,"document","fech_I", frn.get("k_fecha"));				}				if ( strlen(frn.get("k_fecha_F")) > 0 ) { 					setXml(xmlPar,"document","fech_F", frn.get("k_fecha_F"));				}					*/								/*				//setXml(xmlPar,"document","folio",frn.get("k_folio"));				//setXml(xmlPar,"document","fecha",frn.get("k_fecha"));				*/								/*				frn.lib("libGeneral.kpl","FileSave",xmlPar, fileSavePath & "\refalatapedcrud_rpt_xmlPar");												cmd="select * from keplersc.autos_com_asig_rpt('"& getXmlStr(xmlPar,"EOF:13_10") &"')";				rstXml(xmlResQuery);				xmlResQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comaltasigcrudN_rpt.Ejecuta_Reporte()");				ok=getXmlAtt(xmlResQuery ,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlResQuery ,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						frn.lib("libGeneral.kpl","FileSave",xmlResQuery, fileSavePath & "\comaltasigcrudN_rpt_xmlResQuery");								*/								Reporte();						} /* END Func Ejecuta_Reporte() */						fun Reporte() {							// Our Vars				var compania, titrep, sucnomb,dato_id;				var contProd, contDet, tmpStr ,xmlDet, xmlCurDocto;				var p_fecha, var_fecha;				var t_invfis, t_invteo, t_invdif, t_costfis, t_costteo, t_costdif;								//Obtener datos generales				kdb.kde("KDE");//Configuracion del servidor				kdb.exec();				compania = kdb.get("KDE","1");									// Se define el formato a usar y se liga a la variable del reporte "rep"	// Se define el formato a usar y se liga a la variable del reporte "rep"				rep.rst(); // 20121208				IniParams(); // 20121208				kdb.readPage("datFto","invdifrptfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				//rep.rst(); // 20121208				setRepPage();//Establece los parámetros finales de impresión(rep.page(...);), pues pueden haber cambiado por el usuario 				//Da valor a los inputs del reporte(rep.set();), e indica la ejecución de "grupos de renglones de impresión" (rep.exe();)												titrep = "Diferencias de Inventario contra el Ultimo Inventario Fisico";												rep.set("fecha",sys.date());				rep.set("hora",sys.time());				rep.set("nombreempresa",compania);				rep.set("tituloreporte",titrep);								dato_id = "";				cmdQuery = "select c2 from keplersc.kdms " & 				"where c1 = '" & sucursal & "'"; 				rstXml(xmlDet);				xmlDet = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Data_Rpt()");				//frn.lib("libGeneral.kpl","FileSave",xmlDet, fileSavePath & "\ser_ordenrpt_data_d_rpt");				ok=getXmlAtt(xmlDet,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlDet,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(xmlDet,"r0", "c2");				if ( strlen(dato_id) == 0 ) {					// Not records found					sucnomb = "Sin Descripcion ...";				} else {					sucnomb = getXmlAtt(xmlDet,"r0", "c2");				}									rep.set("suc",sucursal);				rep.set("sucnomb",sucnomb);								t_invfis = 0;				t_invteo = 0;				t_invdif = 0;				t_costfis = 0;				t_costteo = 0;				t_costdif = 0;								/*				//contProd=nXml(xmlResQuery);				contProd=frn.N("k_mov")-1;				*/								rep.exe("encabezado");												cmdQuery = "" & 					"select " &					"k.c2 prod, coalesce(h.dscr,'Not in Kdini') dscr, coalesce(f.c4,'1800-01-01')::text fecha, coalesce(f.c6,-999999) ifisico, " & 					"(k.c5-k.c6) iteorico, ( coalesce(f.c6,0) - (k.c5-k.c6) ) idiferencia, ( coalesce(f.c6,0) * coalesce(f.c7,0) ) creal, " &					"(k.c8-k.c9) cteorico, ( ( coalesce(f.c6,0) * coalesce(f.c7,0) ) - (k.c8-k.c9) ) cdiferencia, " & 					"trim( h.ubi1 || ' ' || h.ubi2 || ' ' || h.ubi3 ) ubic " &					"from keplersc.kdinl k " & 					"left join (select c1 prod, c2 dscr, coalesce(c3,'') ubi1, coalesce(c4,'') ubi2, coalesce(c5,'') ubi3 " &  						"from keplersc.kdini) h on h.prod = k.c2 " & 					"left join keplersc.kdifis f on f.c1 = k.c1 and f.c2 = k.c2 " &  					"where k.c1 = '" & sucursal & "' order by k.c2 ";					//and k.c2 <> '78181500' Not in K75 at 20231120 ... Only used for testing & validating data  								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"invdifrpt.WLKA()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\invdifrpt_data_rpt");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									for(var x=0; x < nXml(cuboQuery); x++)				{										if ( getXmlAtt(cuboQuery,"r"&x,"ifisico") == -999999 ) { 											// condition added on 20231120 ... cteorico condition is not in K75 but is necessary due to data status in kdinl 						if ( getXmlAtt(cuboQuery,"r"&x,"iteorico") !=/*>*/ 0 || getXmlAtt(cuboQuery,"r"&x,"cteorico") !=/*>*/ 0 || getXmlAtt(cuboQuery,"r"&x,"creal") !=/*>*/ 0 ) {												rep.set("f-prod",getXmlAtt(cuboQuery,"r"&x,"prod"));							rep.set("f-dscr", getXmlAtt(cuboQuery,"r"&x,"dscr"));							rep.set("f-invteo", getXmlAtt(cuboQuery,"r"&x,"iteorico"));							rep.set("f-invdif", getXmlAtt(cuboQuery,"r"&x,"idiferencia")); 							rep.set("f-costfis",getXmlAtt(cuboQuery,"r"&x,"creal"));							rep.set("f-costteo", getXmlAtt(cuboQuery,"r"&x,"cteorico"));							rep.set("f-costdif", getXmlAtt(cuboQuery,"r"&x,"cdiferencia"));							rep.set("f-ubica", getXmlAtt(cuboQuery,"r"&x,"ubic"));															rep.exe("detalle-notfis");												}										} else {											rep.set("d-prod",getXmlAtt(cuboQuery,"r"&x,"prod"));						rep.set("d-dscr", getXmlAtt(cuboQuery,"r"&x,"dscr"));						rep.set("d-fech", getXmlAtt(cuboQuery,"r"&x,"fecha"));						rep.set("d-invfis", getXmlAtt(cuboQuery,"r"&x,"ifisico"));						rep.set("d-invteo", getXmlAtt(cuboQuery,"r"&x,"iteorico"));						rep.set("d-invdif", getXmlAtt(cuboQuery,"r"&x,"idiferencia")); 						rep.set("d-costfis",getXmlAtt(cuboQuery,"r"&x,"creal"));						rep.set("d-costteo", getXmlAtt(cuboQuery,"r"&x,"cteorico"));						rep.set("d-costdif", getXmlAtt(cuboQuery,"r"&x,"cdiferencia"));						rep.set("d-ubica", getXmlAtt(cuboQuery,"r"&x,"ubic"));											rep.exe("detalle");										}										if ( getXmlAtt(cuboQuery,"r"&x,"ifisico") >= 0 ) {						t_invfis = t_invfis + getXmlAtt(cuboQuery,"r"&x,"ifisico");					}					t_invteo = t_invteo + getXmlAtt(cuboQuery,"r"&x,"iteorico");					t_invdif = t_invdif + getXmlAtt(cuboQuery,"r"&x,"idiferencia");					t_costfis = t_costfis + getXmlAtt(cuboQuery,"r"&x,"creal");					t_costteo = t_costteo + getXmlAtt(cuboQuery,"r"&x,"cteorico");					t_costdif = t_costdif + getXmlAtt(cuboQuery,"r"&x,"cdiferencia");					//t_costdif = t_costfis - t_costteo; // Sale el mismo resultado al final ...							} // End For 												if (nXml(cuboQuery) > 0) { 									rep.set("t-invfis",t_invfis);					rep.set("t-invteo",t_invteo);					rep.set("t-invdif",t_invdif);					rep.set("t-costfis",t_costfis);					rep.set("t-costteo",t_costteo);					rep.set("t-costdif",t_costdif);										rep.exe("total");									}												//Modos de impresión 				rep.win(); //Muestra la vista previa de la impresión. A partir de la vista previa (Preprint) se decide si se imprime o no.				//rep.print("\\192.168.1.100\HPLaserJet"); //Envía el reporte directamente a una impresora, sin mostrar la vista previa.				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresión. No muestra la vista previa.				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardará el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html										} /* END Func Reporte() */									// END : ZONA	CODIGO REPORTE(S) 											} // End of class Main			</script></pag>