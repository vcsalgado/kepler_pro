<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Libreria">
	<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,20" bclr="192,205,213"><br/>
		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="70,50,7,12" brdr="0,5" tit="Datos generales" fnt="Arial,16"><br/>
		</grp><br/>
	</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,kdb,sys,rep;
			var bConect;
			fun Main() {
				frn=new FRNT;
				kdb=new KDB;
				sys=new SYS;
				rep=new REP;
				bConect=0;
				//Esta rutina se ejecuta solo la primera vez que se manda llamar alguna función de la librería. 
			}
			
			fun Conexion(){//Cuando se quiera accesar a base de datos, ejecutar esta función, antes de cualquier cosa. 
				if(bConect==0){kdb.connect();bConect=1;}
			}
			
			fun IniParams(){//Inicializa parámetros de impresión, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Página
				frn.set("param_paper","letter");//	"paper=letter|legal|size"
				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"
				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"
				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"
				frn.set("param_landscape","Y");//	"landscape=N|Y"
				frn.set("param_emp","L");//			"@emp=L|R|C"
				frn.set("param_header",1);
			}

			fun setRepPage() {//Establece los parámetros finales de impresión.
				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc
				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");
				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";
				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";
				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");
				var lndsp="landscape=" & frn.get("param_landscape");
				var emp="@emp=" & frn.get("param_emp");
				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);
			}			
			
			fun GenerarReportePoliza(sucursal_id,anio,mes,tipo_poliza,folio_ini,folio_fin,salto_pagina){
				var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;
				var cuboResultados, cuboDoctos, cuboMovtos;
				var xmlRequest,sqlXmlResultados,xmlCurDocto,xmlCurMovto,cmd,ok,mensaje;
				var contpol, totpolizas ;
				var poliza,fecha_pol,fecha_mov,suc_desc,doc,desc_mov,polizas,numpolizas,cont;
				var cuenta,desc_cuenta,descripcion,refer,cargo_abono,monto;
				
				kdb.kde("KDE");//Configuración del servidor
				kdb.exec();
				compania = kdb.get("KDE","1");
				usuario = kdb.get("KDE","14");
				strValor = sys.date();	
				fechaImpresion = sys.date();
				horaImpresion = sys.time();
				
				//Obtener saldos totales //
				setXml(xmlRequest,"document","sucursal_id",sucursal_id);
				setXml(xmlRequest,"document","mes",mes);
				setXml(xmlRequest,"document","tipo_poliza",tipo_poliza);
				setXml(xmlRequest,"document","poliza_inicial",folio_ini);
				setXml(xmlRequest,"document","poliza_final",folio_fin);
				setXml(xmlRequest,"document","movimiento","usuario",frn.lib("libKepler","UserInfo"));

				cmd="select * from keplersc.cont_rep_poliza('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"contreppoliza.GenerarReporte()");
				
				ok=getXmlAtt(cuboResultados,"ok");
				if(ok &! "" && !ok){
					var mensajeError = getXmlAtt(cuboResultados,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				kdb.readPage("datos","contreppolizafto");//se define el formato a usar
				kdb.exec();
				rep.source(kdb.get("datos"));
				rep.rst(); 
				setRepPage();//Establece los parámetros finales de impresión.(rep.page(...);)

				rep.set("rep_suc",frn.get("cmb_sucursal",-1,0));
				rep.set("rep_fecha",fechaImpresion);
				rep.set("rep_hora",horaImpresion);
				rep.exe("encabezado");
				
				cuboResultados = getXmlAtt(cuboResultados,"r0","cont_rep_poliza");
				cuboResultados = delScpScn(cuboResultados);
				
				var xml_nivel_1;
				setXmlStr(xml_nivel_1,cuboResultados);
				frn.lib("libGeneral.kpl","FileSave",xml_nivel_1,"C:\Basura\xmlcubo");
				
				var xml_nivel_2;
				xml_nivel_2=getXml(xml_nivel_1, "document");
				
				totpolizas = nXml(xml_nivel_2);
				
				for (contpol=0; contpol<totpolizas ;contpol++){
				
					tipo_poliza = getXml(xml_nivel_2,"r"&contpol, "tipo_poliza");
					poliza= getXml(xml_nivel_2,"r"&contpol, "poliza");
					fecha_pol= getXml(xml_nivel_2,"r"&contpol, "fecha_pol");
					fecha_mov= getXml(xml_nivel_2,"r"&contpol, "fecha_mov");
					sucursal_id= getXml(xml_nivel_2,"r"&contpol, "sucursal_id");
					suc_desc= getXml(xml_nivel_2,"r"&contpol, "suc_desc");
					doc= getXml(xml_nivel_2,"r"&contpol, "doc");
					desc_mov= getXml(xml_nivel_2,"r"&contpol, "desc_mov");
					
					rep.set("tPol",tipo_poliza );
					rep.set("nPol",poliza);
					rep.set("fecha_pol",fecha_pol);
					rep.set("fecha_mov",fecha_mov);
					rep.exe("encabezadoPol1");
					
					rep.set("suc_id",sucursal_id);
					rep.set("suc_desc",suc_desc);	
					rep.set("doc",doc);
					rep.set("desc_mov",desc_mov);
					rep.exe("encabezadoPol2");
				
					polizas = getXml(xml_nivel_2,"r"&contpol, "polizas");
	
					numpolizas = nXml(polizas);
					
					var totcargo = 0;
					var totabono = 0;
					
					for (cont=0; cont<numpolizas ;cont++){
						
						cuenta = getXml(polizas ,"r"&cont, "cuenta");
						desc_cuenta= getXml(polizas ,"r"&cont, "desc_cuenta");
						descripcion= getXml(polizas ,"r"&cont, "descripcion");
						refer= getXml(polizas ,"r"&cont, "refer");
						cargo_abono= getXml(polizas ,"r"&cont, "cargo_abono");
						monto= getXml(polizas ,"r"&cont, "monto");
						
						if (cargo_abono &= "C"){
						
							rep.set("PolClave",cuenta );
							rep.set("PolCuenta",desc_cuenta);
							rep.set("PolDescr",descripcion);
							rep.set("PolRefer",refer);
							rep.set("PolDebe",monto);
							rep.exe("partPolC");
							
							totcargo = totcargo + monto;
							
						
						}else {
						
							rep.set("PolClave2",cuenta );
							rep.set("PolCuenta2",desc_cuenta);
							rep.set("PolDescr2",descripcion);
							rep.set("PolRefer2",refer);
							rep.set("PolHaber",monto);
							rep.exe("partPolA");
							
							totabono = totabono + monto;		
						}
					}
											
					rep.set("totCargo",totcargo);
					rep.set("totAbono",totabono );
					
					if (totcargo != totabono) {
					
						rep.set("poliza_descuadrada","*** POLIZA DESCUADRADA ***");
					}
					rep.exe("PolTotales");
					rep.exe("fin");
					if(salto_pagina && "1"){
						rep.newPag();
					}
				}
frn.message("Enviando reporte...","Mensaje","Aceptar");
				rep.win();
			}			
		}
		/*
		Autor						Fecha			Cambio
		-------------------------------------------------------------------------------
		Victor Salgado		25 Ago 2022 	Creacion de la libreria
		*/
	</script>
</pag>