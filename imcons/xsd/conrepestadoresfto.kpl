<?xml version="1.0" encoding="UTF-8"?><pag xmlns='www.kepler.com.mx/2003/KSchema' tit="Estado de resultados" scale="56">	<grp dim='1,-1,10,20' brdr='0,1' clr='0,0,0' bclr='255,255,255' unfont="0">		<br exe="encabezadoP"/>		<hLine dim="100,0" g="2" type="1"/>		<br exe="encabezadoP"/>		<grp dim="10,7,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>		<tab n="1"/>		<grp dim="62,5,7,12" brdr="0,1">			<br/>			<inp id="empresa" fnt=",20b" dim="80,1" clr="0,58,112" type="string" available = "N"/>			<br/>			<inp id="numMes"  dim="70,1" type="string" nd="2" nc="20" fnt="Arial,20b" clr="0,58,112" just="L" modify="N"/>			<br exe="encabezadoP"/><tab n="24"/><sp n="2"/>			<br exe="encabezadoP"/>						<br/>			<br/>		</grp><tab n="5"/>		<grp dim="20,5,7,12">			<br/>			<txt>P&#225;g:</txt><tab/><inp id="k_pag" dim="4,1" type="number" just="L" mcr="k_pag" modify="N"/>			<br/>			<txt>Fecha:</txt><inp id="fecha" dim="10,1" type="date" just="L" fmt="DD-MM-CCYY"/>			<br/>			<txt>Hora:</txt><sp/><inp id="hora" dim="5,1" type="time" just="L"/>		</grp>		<br exe="encabezadoP"/>				<hLine dim="100,0" g="2" type="1"/>		<br exe="encabezadoP"/>		<tab n="14"/><br exe="encabezadoP"/><tab n="19"/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">Mes</txt><sp n="2"/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">Porcentaje</txt><tab n="4"/><sp/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">Acumulado</txt><br exe="encabezadoP"/><tab/><txt fnt="Arial,16b" clr="0,58,112">V E N T A S</txt><br exe="ventas"/><tab n="2"/><inp id="descripcionP"  dim="32,1" type="string"/><tab n="6"/><inp id="montoMesP"  dim="15,1" type="number" nd="2"/><sp/><inp id="porMesP"  dim="5,1" type="number" nd="2" nc="5"/><inp id="montoAcumP"  dim="15,1" type="number" nd="2"/><inp id="porAcumP"  dim="5,1" type="number" nd="2" nc="5"/><br exe="detalle2"/><tab n="3"/><inp id="descripcion3P"  dim="32,1" type="string"/><tab n="5"/><inp id="montoMes3P"  dim="15,1" type="number" nd="2"/><sp/><inp id="porMes3P"  dim="5,1" type="number" nd="2" nc="5"/><inp id="montoAcum3P"  dim="15,1" type="number" nd="2"/><inp id="porAcum3P"  dim="5,1" type="number" nd="2" nc="5"/><br exe="detalle3"/><tab/><txt fnt="Arial,16b" clr="0,58,112">C O S T O </txt><tab/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">D E </txt><tab/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">V E N T A S</txt><br exe="costo"/><tab/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">G A S T O S</txt><br exe="gastos"/><tab/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">P R O D U C T O S </txt><tab/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">F I N A N C I E R O S</txt><br exe="prodfinan"/><tab/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">I M P U E S T O S </txt><br exe="impuestos"/><br exe="vacio"/><tab/><txt fnt="Arial,16b" clr="0,58,112">T O T A L   </txt><tab/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">D E </txt><tab/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">V E N T A S</txt><tab n="10"/><inp id="totalMesVtaP"  dim="15,1" type="number" nd="2"/><sp/><inp id="porTotMesP"  dim="5,1" type="number" nd="2" nc="5"/><inp id="totalAcumVtaP"  dim="15,1" type="number" nd="2"/><inp id="porTotAcumP"  dim="5,1" type="number" nd="2" nc="5"/><br exe="totalventas"/><tab/><txt fnt="Arial,16b" clr="0,58,112">T O T A L   </txt><tab/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">D E </txt><tab/><txt fnt="Arial,16b" clr="0,58,112">C O S T O</txt><tab n="10"/><inp id="totalMesCtoP"  dim="15,1" type="number" nd="2"/><sp/><inp id="porTotCtoMesP"  dim="5,1" type="number" nd="2" nc="5"/><inp id="totalAcumCtoP"  dim="15,1" type="number" nd="2"/><inp id="porTotCtoAcumP"  dim="5,1" type="number" nd="2" nc="5"/><br exe="totalcosto"/><tab/><txt fnt="Arial,16b" clr="0,58,112">U T I L I D A D  </txt><tab/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">B R U T A </txt><tab n="11"/><inp id="totalMesUBP"  dim="15,1" type="number" nd="2"/><sp/><inp id="porTotMesUBP"  dim="5,1" type="number" nd="2" nc="5"/><inp id="totalAcumUBP"  dim="15,1" type="number" nd="2"/><inp id="porTotAcumUBP"  dim="5,1" type="number" nd="2" nc="5"/><br exe="utilidadbruta"/><br/><tab/><txt fnt="Arial,16b" clr="0,58,112">T O T A L   </txt><tab/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">D E </txt><tab/><txt fnt="Arial,16b" clr="0,58,112">G A S T O S</txt><tab n="10"/><inp id="totalMesGtoP"  dim="15,1" type="number" nd="2"/><sp/><inp id="porTotGtoMesP"  dim="5,1" type="number" nd="2" nc="5"/><inp id="totalAcumGtoP"  dim="15,1" type="number" nd="2"/><inp id="porTotGtoAcumP"  dim="5,1" type="number" nd="2" nc="5"/><br exe="totalgastos"/><tab/><txt fnt="Arial,16b" clr="0,58,112">U T I L I D A D  </txt><tab/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">O P E R A T I V A</txt><tab n="10"/><inp id="totalMesUOP"  dim="15,1" type="number" nd="2"/><sp/><inp id="porTotMesUOP"  dim="5,1" type="number" nd="2" nc="5"/><inp id="totalAcumUOP"  dim="15,1" type="number" nd="2"/><inp id="porTotAcumUOP"  dim="5,1" type="number" nd="2" nc="5"/><br exe="utilidadoperativa"/><tab/><txt fnt="Arial,16b" clr="0,58,112">T O T A L   </txt><tab/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">D E </txt><tab/><txt fnt="Arial,16b" clr="0,58,112">P R O D U C T O S  F I N A N C I E R O S</txt><tab n="4"/><inp id="totalMesPFinanP"  dim="15,1" type="number" nd="2"/><sp/><inp id="porTotPFMesP"  dim="5,1" type="number" nd="2" nc="5"/><inp id="totalAcumPFinanP"  dim="15,1" type="number" nd="2"/><inp id="porTotPFAcumP"  dim="5,1" type="number" nd="2" nc="5"/><br exe="totalprodfinan"/><tab/><txt fnt="Arial,16b" clr="0,58,112">T O T A L   </txt><tab/><txt fnt="Arial,16b" clr="0,58,112" bclr="255,255,255">D E </txt><tab/><txt fnt="Arial,16b,16b,16b" clr="0,58,112" bclr="255,255,255">I M P U E S T O S</txt><tab n="9"/><inp id="totalMesImpP"  dim="15,1" type="number" nd="2"/><sp/><inp id="porTotImpMesP"  dim="5,1" type="number" nd="2" nc="5"/><inp id="totalAcumImpP"  dim="15,1" type="number" nd="2"/><inp id="porTotImpAcumP"  dim="5,1" type="number" nd="2" nc="5"/><br exe="totalimpuestos"/><tab/><txt fnt="Arial,16b" clr="0,58,112">U T I L I D A D  </txt><tab/><txt fnt="Arial,16b" clr="0,58,112">N E T A</txt><tab n="12"/><inp id="totalMesUNP"  dim="15,1" type="number" nd="2"/><sp/><inp id="porTotMesUNP"  dim="5,1" type="number" nd="2" nc="5"/><inp id="totalAcumUNP"  dim="15,1" type="number" nd="2"/><inp id="porTotAcumUNP"  dim="5,1" type="number" nd="2" nc="5"/><br exe="utilidadneta"/><br/><br/><br/>	</grp>		<script>	InstallDriver("KDB75");	class Main {}	/*	----------------------------------------------------------------	CAMBIOS GRAFICOS   ----------------------------------------------------------------   Autor				Fecha				Elemento				Cambio   ----------------------------------------------------------------   Fran Tapia		02-oct-2020		numMes			-Se modifican para ajustar a la pantalla y se muestre correctamente en la impresión.											fecha				-Se modifican para ajustar a la pantalla y se muestre correctamente en la impresión.											hora				-Se modifican para ajustar a la pantalla y se muestre correctamente en la impresión.   */	</script></pag>