<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Tiempos no disponibles"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp  unfont="0"  bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18"  clrBrdr="0,58,112" hSpace="4"  dim="90,45,10,10" brdr="0,5" tit="Tiempos no disponibles">					<tab n="1"/>		<txt>Fecha ini:</txt>		<edt id="fecha_ini" dim="10,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_ini" OnF9="Dialog(3,_ks_fecha,fecha_ini)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2" OnChange="LimpiaCriterio(otro)"/>		<tab n="1"/>		<txt>Fecha fin:</txt>		<edt id="fecha_fin" dim="10,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_fin" OnF9="Dialog(3,_ks_fecha,fecha_fin)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2" OnChange="LimpiaCriterio(otro)"/>		<tab/><txt clr="0,58,112" hk="S">Tipo:</txt>		<cmb id="tipo_recep_ope" clr="64,64,64" clrBrdr="255,255,255"  OnChange="recep_opes()" dim="12,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y" modify="Y"/><tab n="1"/>		<txt clr="0,58,112" hk="S">Recep/Operario</txt>		<cmb id="recep_operario" clr="64,64,64" clrBrdr="255,255,255"  dim="12,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y" modify="Y"/><tab n="2"/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		<br/>			<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" OnEnter="" OnMouseD="Exit" dim="84,22" modify="N" nren="fijo">		<col id="fecha" name="Fecha"/>		<col id="recep_oper" name="Recep/Oper"/>		<col id="nombre_recep_ope" name="Nombre"/>		<col id="top" name="Top"/>		<col id="tipo_recep_ope_desc" name="Tipo"/>		<col id="horas" name="Horas"/>		<col id="comentarios" name="Comentarios"/>		<col id="horario_ini" name="Horario Incial"/>		<col id="horario_fin" name="Horario Final"/>			</tbl>  <br/>		<tab n="7"/>		<bot id="k_btn_nvo" dim="10,10" brdr="5" text="Nuevo" hk="K" default="0" step="0"  OnEnter="abrir_curd(Nuevo)" fnt="Arial,16b"/> 		<bot id="k_btn_mod" dim="10,10" brdr="5" text="Modificar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Modificar)" fnt="Arial,16b"/> 		<bot id="k_btn_elimnr" dim="10,10" brdr="5" text="Eliminar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Eliminar)" fnt="Arial,16b"/> 		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Consultar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Consultar)" fnt="Arial,16b"/> <br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,rol_usuario ,perfil_usuario,asterisco  ;			fun Main(){				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";										Inicializa();										}								fun Inicializa(){							var cmd,cubo,ok;							//Llenar combo tipo operarios				cmd = "select '['||c1||'] '||c2 as descripcion, c1 as clave from keplersc.kdtoper ";											cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tiempos_no_disponibles_view.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}					var cmd_tipo_recep_ope = "tipo_recep_ope";									frn.setX("RECEPCIONISTA", cmd_tipo_recep_ope ,0,0);				frn.setX("RECEP", cmd_tipo_recep_ope ,0,1);								llenar_cmb(cubo ,cmd_tipo_recep_ope );								recep_opes();									frn.set("fecha_ini", sys.date());				frn.set("fecha_fin", sys.date());			}						fun recep_opes(){							var cmd_recep_operario = "recep_operario";								frn.rst(cmd_recep_operario );								var tipo_recep_ope = frn.get("tipo_recep_ope" , -1, 1);												var cmd;				if (tipo_recep_ope &= "RECEP"){									cmd = "select '['||c1||'] '||c2 as descripcion, c1 as clave  from keplersc.kdrecep where c11='S' ";										}else{								//Llenar combo operarios					cmd = "select '['||c1||'] '||c3 as descripcion, c1 as clave  from keplersc.kdoper where c12='S' ";														if (tipo_recep_ope &! "" ){						cmd = "select '['||c1||'] '||c3 as descripcion, c1 as clave from keplersc.kdoper where c2='" & tipo_recep_ope & "' and c12='S' ";					}																		}							var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tiempos_no_disponibles_view.Inicializa()");									var ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}							frn.setX("", cmd_recep_operario ,0,0);				llenar_cmb(cubo ,cmd_recep_operario );						}						fun Buscar() {							var xmlRequest,cmd,ok,cuboResultados, tot , cont;						var fecha_ini = frn.get("fecha_ini");				var fecha_fin = frn.get("fecha_fin");								if (fecha_ini &= "" || fecha_fin &= ""){					frn.message("Selecciona un rango de fechas","Error","Aceptar");					return;				}								var tipo_recep_ope = frn.get("tipo_recep_ope", -1, 1);												if (tipo_recep_ope &= "RECEP" ){									cmd= "select tm.c3 as fecha, recp.c1 as recep_oper, recp.c2 as nombre_recep_ope, " &					" 'RECEP' as top, 'RECEPCIONISTA' as  tipo_recep_ope_desc, tm.c4 as horas, tm.c7 as comentarios," &					" tm.c9 as horario_ini ,  tm.c10 as horario_fin " &					" from keplersc.kdtiemposnd as tm inner join keplersc.kdrecep as recp on tm.c1=recp.c1 " &					" where tm.c3>= '" & fecha_ini &  "' and tm.c3<='" & fecha_fin & "'";									}else{					cmd= "select tm.c3 as fecha, ope.c1 as recep_oper, ope.c3 as nombre_recep_ope, " &					" tope.c1 as top, tope.c2 as  tipo_recep_ope_desc, tm.c4 as horas, tm.c7 as comentarios," &					" tm.c9 as horario_ini ,  tm.c10 as horario_fin " &					" from keplersc.kdtiemposnd as tm inner join keplersc.kdoper as ope on tm.c1=ope.c1 " &					" inner join keplersc.kdtoper as tope on tm.c2=tope.c1 " &					" where tm.c3>= '" & fecha_ini &  "' and tm.c3<='" & fecha_fin & "'";					}											if (tipo_recep_ope &! ""){					cmd = cmd & " and tm.c2 ='" & tipo_recep_ope  & "'";				}							var recep_ope = frn.get("recep_operario", -1, 1);				if (recep_ope &! ""){					cmd = cmd & " and tm.c1 ='" & recep_ope & "'";				}								cmd = cmd & " order by tm.c3 desc ";								frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdquery");								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tiempos_no_disponibles_view.Buscar()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("tabla",getXml(cuboResultados ));							}									fun abrir_curd(accion){										if (accion &! "Nuevo"){												var oper= frn.get("tabla", -1, "recep_oper");					var top= frn.get("tabla", -1, "top");					var fecha= frn.get("tabla", -1, "fecha");									if (oper &= ""){										frn.message("Selecciona un tiempo antes.","Error","Aceptar");									}else{										frn.dialog("tiempos_no_disponibles_crud",accion,oper,top,fecha);					}				}else {									frn.dialog("tiempos_no_disponibles_crud",accion,"","","");									}							}									fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}												fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}									}	</script></pag>