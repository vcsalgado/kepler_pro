<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<tab/><txt fnt=",22" clr="0,0,0">Factura Orden</txt><br/>	<tab/><hLine clr="0,0,0"/> 	<br/> <br/><tab/>		<grp dim="46,11,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">			<sp n="2"/>			<txt>Sucursal : </txt><sp n="1"/>						<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" tooltip="Sucursal" available="Y" modify="Y"/>			<br/><br/>			<sp n="2"/>			<txt>Tipo :        </txt>			<cmb id="k_tipon" dim="40,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo()" tooltip="Tipo de Movimiento" available="Y"/>			<br/>		</grp>		<sp/>		<grp dim="34,13,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C"/>			<inp id="strfolio" clr="64,64,64" clrBrdr="255,255,255"  dim="7,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "N" modify="Y" visible="N"						OnChange="SeparaFolio()"/><br/>				<txt id="textFolio" visible="N">  Folio :  </txt>			<edt id="k_folio" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="10" tooltip="Folio ( F9 b&#250;squeda )" modify="Y" available="N" visible="N" 			OnF9="ObtenerFolio()" OnButton="ObtenerFolio()" OnChange="Formar_folio()"/><sp n="1"/>			<txt id="capturaFolio" visible="N" clr="254,1,1" fnt=",b">Captura Folio</txt>			<img id="BuscarFol" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="BuscarFolio()" visible="N"/> <br/>			<sp n="1"/>			<inp id="k_docto" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="C"/> <br/>			<txt>  Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" clrBrdr="255,255,255" available="Y" tooltip="Fecha" modify="N"/> 			<sp n="1"/> 			<txt>  Hora : </txt> 			<sp n="1"/> 			<edt id="k_hora" dim="15,1" type="time" nc="-1" bclr="240,240,240" modify="Y" fmt="HH:MM:SS" available="Y" tooltip="Hora"/> 			<br/>		</grp>		<br/>		<br/><tab/>		<grp dim="81,17,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Orden">				<grp dim="39,14,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<sp n="2"/> <txt clr="0,58,112">Tipo :</txt><tab n="3"/><sp n="1"/>				<cmb id="k_tipo_orden" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "Y" modify="Y" 					 tooltip="Tipo de Orden" OnChange="SelTipoOrden()"/>				<sp n="1"/>				<br/>				<sp n="2"/> <txt clr="0,58,112">Orden : </txt><tab n="2"/><sp n="1"/>				<inp id="k_orden" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" available = "Y" modify="Y" visible="Y"					 tooltip="N&#250;mero de &#243;rden ( F9 b&#250;squeda )" OnF9="ObtenerNumOrden()" OnChange="BuscarOrden()"/>				<br/>	 				<sp n="2"/>  <txt clr="0,58,112">Recepcionista : </txt>	 				<inp id="k_vendedor" clr="64,64,64" clrBrdr="255,255,255"  dim="9,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "Y" modify="Y" 					 tooltip="Recepcionista ( F9 b&#250;squeda )" OnF9="ObtenerRecep()" OnChange="BuscarRecep()"/>				<br/><sp n="2"/>				<inp id="k_nombre_recep" clr="64,64,64" clrBrdr="255,255,255"  dim="34,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "Y" modify="N" 					 tooltip="Nombre Recepcionista"/>				<br/>				<sp n="2"/>  <txt clr="0,58,112">Referencia : </txt><tab/><sp n="1"/>	 				<inp id="k_refer" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "N" modify="Y" 					 tooltip="Referencia &#243;rden"/>				<br/>				<sp n="2"/>  <txt clr="0,58,112">Inventario :</txt><sp n="1"/>				<inp id="k_pedimento" clr="64,64,64" clrBrdr="255,255,255"  dim="3,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "N" modify="Y" visible="N"					 tooltip="Sucursal Inventario"/>				<sp n="1"/>				 				<edt id="k_claveinv" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "N" modify="N" 					 OnF9="ObtenerInv()" OnButton="ObtenerInv()" tooltip="N&#250;mero Inventario"/>				<inp id="strcveinv" clr="64,64,64" clrBrdr="255,255,255"  dim="1,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "N" modify="Y" visible="N"					 OnChange="SelSucInvent()"/>		 			</grp>									<grp dim="75,15,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<grp dim="75,3,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">					<sp n="1"/> <txt clr="0,58,112">Cliente : </txt>					<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 						OnF9="ObtenerCliente()" OnF10="Dialog(3,cat_cli_crud,Nuevo,x,s,k_clave)" OnF11="Dialog(3,cat_cli_crud,Modificar,x,s,k_clave)"						OnButton="ObtenerCliente()" OnChange="BuscarCliente()" 						type="capital" nc="7" tooltip="Cliente ( F9-B&#250;squeda, F10-Nuevo, F11-Modificar )" modify="Y" available="Y"/><tab n="1"/> 					<txt>RFC : </txt>					<inp id="k_rfc" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="20,1" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>					<sp n="1"/>					<inp id="k_nombreimprfact" clr="64,64,64"  dim="7,1" fnt="Arial,16" type="string"  modify="N" available="N" visible="N"/>					<sp n="1"/><bot id="bot_adenda" dim="10,0" brdr="3,0" text="Adenda" visible="N" OnEnter="EjecutaAdenda()" tooltip="Actualiza datos de la Adenda" available="N"/>				</grp>				<br/>				<grp dim="75,11,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="1,5" fnt="Arial,16">					<sp n="1"/> <txt>Datos del cliente : </txt>					<br/>					<sp n="1"/>						<inp id="k_nombreprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>					<br/>					<sp n="1"/>					<inp id="k_calleprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>					<br/>					<sp n="1"/>					<inp id="k_coloniaprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>					<br/>					<sp n="1"/>					<inp id="k_poblacionprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="50,1" fnt="Arial,16" type="string" modify="N" available="N" nc="50" visible="Y"/>					<sp n="1"/>					<inp id="k_cpprov" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="10,1" fnt="Arial,16" type="string" modify="N" available="N" nc="10" visible="Y"/>				</grp>			</grp>			<br/>							</grp>		<br/>		<br/><tab/>		<grp dim="81,25,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Factura">			<grp dim="45,13,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<sp n="2"/><txt>Mano Obra : </txt><tab/><sp n="2"/> 				<inp id="k_montoext1" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="6" modify="N" available="N" tooltip="Importe mano de obra"/>				<br/>				<sp n="2"/><txt>Refacciones : </txt><sp n="3"/> 				<inp id="k_montoext2" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="6" modify="N" available="N" tooltip="Importe refacciones"/>				<br/>				<sp n="2"/><txt>TOTs : </txt><tab n="2"/><sp n="2"/> 				<inp id="k_montoext3" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="6" modify="N" available="N" tooltip="Importe TOTs"/>				<br/>				<sp n="2"/><txt>Cargos Varios : </txt><sp/> 				<inp id="k_montoext4" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="6" modify="N" available="N" tooltip="Importe cargos varios"/>				<br/>				<sp n="2"/><txt>Antes de IVA : </txt><sp n="2"/> 				<inp id="k_subtotal" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="6" modify="N" available="N" tooltip="Subtotal (antes de IVA)"/>				<br/>				<sp n="2"/> <txt>IVA :</txt><tab n="2"/><sp n="5"/> 				<inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="6" modify="N" available="N" tooltip="IVA"/>				<txt>  (</txt>				<inp id="k_porciva" dim="5,1" bclr="240,240,240" clrBrdr="255,255,255" type="string" modify="N" available="N" just="C"/>				<txt> %)</txt>							<br/>				<sp n="2"/> <txt fnt=",16b">Importe : </txt><tab n="2"/><sp n="2"/>				<inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="15,1" fnt=",16b" type="number" nd="2" modify="N" available="N" tooltip="Importe factura"/>  			</grp>						<grp dim="70,11,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">								<sp n="1"/>  <txt clr="0,58,112">Plazo : </txt><tab n="3"/>					<inp id="k_plazo" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nd="0" min="0" OnChange="ValidarPlazo()" modify="Y" available="Y" visible="Y" tooltip="Plazo del pago"/>								<tab n="2"/>				<sp n="1"/><txt clr="0,58,112">Fecha Pago :  </txt>						<edt id="k_vence" clr="64,64,64"  dim="15,1" brdr="2,0" bclr="255,255,255" type="date" nc="-1" fnt="Arial,0" available="Y" fmt="DD/MM/CCYY" page="_ks_fecha,k_vence" OnF9="Dialog(3,_ks_fecha,k_vence)" clrBrdr="255,255,255" visible="Y" modify="Y" tooltip="Fecha de pago"/><tab n="3"/>				<br/>				<sp n="1"/>  <txt clr="0,58,112">Condiciones : </txt><tab/>				<inp id="k_cond" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="33" modify="Y" available="Y" visible="Y" tooltip="Condiciones de pago"/>				<br/>				<sp n="1"/>  <txt clr="0,58,112">Forma Pago : </txt><tab/>					<cmb id="k_f_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="50,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string"  OnChange="" modify="Y" available="Y" visible="Y" tooltip="Forma de pago"/>				<br/>				<sp n="1"/>  <txt clr="0,58,112">Cuenta : </txt><tab n="2"/>						<inp id="k_cuenta" clr="64,64,64"  dim="50,1" brdr="2,0" bclr="255,255,255" type="number" fnt="Arial,0" available="Y" OnF9="" clrBrdr="255,255,255" visible="Y" modify="Y" tooltip="N&#250;mero de cuenta" fmt="5" just="L"/>				<br/>				<sp n="1"/>  <txt clr="0,58,112">M&#233;todo Pago : </txt>				<tab/>				<inp id="k_m_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="3" modify="Y" available="N" visible="Y" tooltip="M&#233;todo de pago"/>				<tab n="2"/><txt clr="0,58,112">Uso CFDI : </txt>				<cmb id="k_cfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="31,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" modify="Y" available="Y" visible="Y" tooltip="Uso de CFDI"/>				<br/>				<sp n="1"/><txt clr="0,58,112">Email : </txt><tab/>						<sp n="1"/><tab n="2"/><inp id="k_correo" clr="64,64,64" clrBrdr="255,255,255"  dim="50,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" modify="Y" available="Y" visible="Y" tooltip="Correo electr&#243;nico"/>			</grp>				<br/>				<grp dim="85,9,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">									<sp n="2"/><txt> N O T A S : </txt>					<sp/><inp id="datcfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="3,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="1" modify="Y" available="Y" visible="N"/>					<br/>					<sp n="2"/> <inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="82,3" brdr="2,0" fnt="Arial,16" modify="Y" available="Y" type="capital" bclr="255,255,255"/>				</grp>				<grp dim="29,9,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">					<tab n="3"/>					<bot id="bot_selec_anticipos" dim="15,0" brdr="5" text="Anticipos" OnEnter="SeleccionAnticipos()" clr="0,0,0" visible="Y" available="Y"/>						<br/><br/>					<sp n="2"/>					<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="EjecReporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>					<sp n="2"/>					<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="N"/>					<sp n="2"/>					<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>				</grp>					</grp>		<br/><br/>				</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Variables de control			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, cliente_id, refer_id, adenda_id,tiporden,desc_tipo, numorden, punto, descripcion, costo, resVal, porc_iva;			var segmento, variable,valor, tipo_id, m67,m77,m80,folioManual,nfolioManual,cve_seleccion;			var fileSavePath, asterisco;			//Variables de parametros			var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope,uen;						fun Main() {			frn=new FRNT;			kdb=new KDB;			rep=new REP;			frP=new FRNTP;			sys=new SYS;			kdb.connect();			kdb.kde("KDE");			kdb.exec();			anio_contable = kdb.get("KDE","14");			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			suc_usuario = frn.lib("libKepler","UserInfo(1)");			asterisco = "*";			fileSavePath = "C:\Basura";			Inicializa();							ConfiguraControlesOpcion();		}							//Validacion Datos Generales antes de Guardar.		//El resultado de cada validacion se guarda en la variable global resVal.		fun ValidarDatos() {			var totReg, strTotal=0,subTotal=0,iva=0,total=0,formapago_id,str,metodoPago,usoCfdi,email,nReg,CveInv,totalAnticipos=0;			//Obtener variables			sucursal_id = frn.get("k_sucn",-1,1);			cliente_id = frn.get("k_clave");			//Validar folio manual			FolioManual();					//MSS 09102024: Permitir capturar un folio manual						//Validar Orden			numorden = frn.get("k_orden");			tiporden = frn.get("k_tipo_orden");			if (tiporden&=""){				frn.setPos("k_tipo_orden");				resVal=0;				frn.message("Es necesario seleccionar el Tipo de Orden","Error","Aceptar");				return;				}			if (numorden&=""){				frn.setPos("k_orden");				resVal=0;				frn.message("Es necesario capturar el Numero de la Orden","Error","Aceptar");				return;				}			//Validar Cliente			cmdQuery="SELECT count(*) as totreg from keplersc.kdud where c2 = '" & cliente_id & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("El cliente no existe.","Error","Aceptar");				resVal=0;				return;			}			//Validar Adenda			adenda_id=Adenda(cliente_id);			if ((adenda_id &! "")){				cmdQuery = "select c1 as adenda,c2 as segmento,c3 as variable,c4 as valor " & 							"from keplersc.kdadvariable " &							"where c1='" &adenda_id & "'";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.ValidarDatos()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\kdadvariable");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				nReg=nXml(cuboQuery);				for(var i=0; i< nReg; i++){					segmento = getXmlAtt(cuboQuery,"r"&i,"segmento");					variable = getXmlAtt(cuboQuery,"r"&i,"variable");					valor = getXmlAtt(cuboQuery,"r"&i,"valor");					//Validar que tenga datos completos la adenda(seg,variable y valor)					if ((segmento &!"") && (variable &!"")){						if (valor &= "") {									frn.setPos("bot_adenda");							resVal=0;							frn.message("Es necesario completar los datos de la Adenda","Error","Aceptar");							return;						}						}					}			}			//Validar Recepcionista			if (frn.get("k_vendedor")&=""){				frn.setPos("k_vendedor");				resVal=0;				frn.message("En necesario seleccionar un recepcionista","Error","Aceptar");				return;			}			//Validar Clave inventario			if (m77 &= "S"){				if (m67 &= "A" || m67 &= "U"){					CveInv=frn.get("k_claveinv");					if (CveInv &= ""){						frn.setPos("k_claveinv");						resVal=0;						frn.message("Es necesario seleccionar la Clave de Inventario","Error","Aceptar");						return;					} 				}			}			//Validar Forma de Pago			formapago_id=frn.get("k_f_pago",-1,1);						if (formapago_id &=""){				frn.setPos("k_f_pago");				resVal=0;				frn.message("Es necesario seleccionar la Forma de Pago","Error","Aceptar");				return;						}			//Valida Cuenta						formapago_id=frn.get("k_f_pago",-1,1);						if (formapago_id &="02" || formapago_id &="03" || formapago_id &="04" || formapago_id &="06" || formapago_id &="28" || formapago_id &="29"){				if(frn.get("k_cuenta")==0 || frn.get("k_cuenta")&=""){					frn.setPos("k_cuenta");					resVal=0;					frn.message("Es necesario capturar la Cuenta","Error","Aceptar");					return;				}				}			//Validar Metodo de Pago, Uso Cfdi			metodoPago=frn.get("k_m_pago");				usoCfdi=frn.get("k_cfdi");			email=frn.get("k_correo");						if (metodoPago &="" || usoCfdi &="") {				frn.setPos("k_clave");				resVal=0;				frn.message("Es necesario actualizar los datos del cliente, falta método de pago o uso de CFDI","Error","Aceptar");				return;						}							//Validar Totales			total=frn.get("k_monto");			m80 = frn.get("k_tipon",-1,10);				if (m80 &= "S" && total <= 0){			//MSS 09042026 Solo validar el monto si genera CFDI				frn.message("El total de la operacion no puede ser cero","Error","Aceptar");				resVal=0;				return;			}						//Valida Anticipos							//MSS 15052026 Validar la suma de los anticipos vs la factura			if (frn.get("k_tipo_orden",-1,1) &! "" && frn.get("k_orden")&!""){				cmdQuery = "select coalesce(sum(dm1.c16),0) as totalAnticipos from keplersc.kdf3ncant nca							inner join keplersc.kdm1 dm1 on nca.c1=dm1.c1 and nca.c2=dm1.c2 and nca.c3=dm1.c3 and nca.c4=dm1.c4 and nca.c5=dm1.c5 and nca.c6=dm1.c6  							where nca.c1 = '" & sucursal_id & "' and nca.c8=0 and nca.folio_relacionado = '" & frn.get("k_tipo_orden",-1,1) & "-" & frn.get("k_orden") & "'";							rstXml(cuboQuery);				frn.lib("libGeneral.kpl","FileSave",cmdQuery, fileSavePath & "\ValidaAnticipos");								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.ValidarDatos()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboValidaAnticipos");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}							totalAnticipos=getXmlAtt(cuboQuery,"r0","totalanticipos");				//frn.message("totalAnticipos:" &totalAnticipos & "monto:" &frn.get("k_monto"));				if(totalAnticipos>frn.get("k_monto")){					frn.message("La suma de los anticipos seleccionados:" & totalAnticipos & " es mayor al total de la factura: " & frn.get("k_monto") & "|Verifique","Error","Aceptar");					resVal=0;					return;				}			}											}				fun SeparaFolio(){			var folio,nCampos,nfolio;				//Separa el folio y tipo, vienen concatenados con ~			nCampos = strSplit(frn.get("strfolio"),"~",-1);			if (nCampos > 1) {				tip_doc = strSplit(frn.get("strfolio"),"~",0);				nfolio = strSplit(frn.get("strfolio"),"~",1);				frn.set("k_tipon",descr_combo("k_tipon",4,tip_doc));			}else{				nfolio = frn.get("strfolio");			}				folio = nfolio;			frn.set("k_folio", folio);		}		fun BuscarFolio() {			var folio;			folio =frn.get("k_folio");			resVal = 1;			if (folio &=""){				frn.setPos("k_folio");				frn.message("Debe especificar un No. Folio","Error","Aceptar");				return;			}			//ValidaFolioCancelado(folio);			//validar si hay folios cancelados			if(resVal == 0){				return;			}			else{				MostrarDatos(folio);			}						ArmarRefDocto();		}		fun Formar_folio(){			var xmlReqEst, cubofol, cmd, ok, mensajeError ;						CambiaFolio();			setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));			setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));			setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));			setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));			setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));			setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));			setXml(xmlReqEst,"document","uen",uen);						cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";			cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactorden.Formar_folio()");			var resultado =getXmlAtt(cubofol,"r0", "resultado");			if(resultado &= "0"){				mensajeError = getXmlAtt(cubofol,"r0", "mensaje");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			var fol = getXmlAtt(cubofol,"r0", "mensaje");			frn.set("k_folio", fol);			if(tip_ope &= "A"){ //Alta				//MSS 09102024: Permitir capturar un folio manual				if (folioManual &= "S"){												FolioManual();					ArmarRefDocto();				}					}		}		fun Cancela() {			CambiaSucursal();			Inicializa();			ConfiguraControlesOpcion();		}					fun ModoBuscar() {			LimpiaEncabezado();			ConfiguraControlesOpcion();		}				fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			var varSR, nat_doc_anx, gpo_doc_anx, tip_doc_anx, folio_doc_anx, iva_desg,strCfdi,strCveInv;			var resultado, mensaje, folio;							fecha = sys.date();			hora= sys.time();			varSR="SR";			strCfdi=frn.get("k_cfdi",-1,1);						if (tip_ope &= "A") {							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}				//Pantalla validacion CFDI				if (frn.get("datcfdi") &= "N"){					frn.dialog("icfdreview",frn.get("k_sucn",-1,1),frn.get("k_clave"),"Ejecuta","cmb",frn.get("k_f_pago",-1,1),frn.get("k_cuenta"),frn.get("k_m_pago"), "cmb", frn.get("k_cfdi", -1, 1));					return;				}					continua = frn.message("¿Desea continuar con la alta de la factura?","Atención",2);				if (continua == 0){					frn.set("datcfdi","N");	//Pantalla validacion CFDI					return;				}				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fecha y hora de movimiento, variable sr(k_var_sr), nat, gpo y tipo docto a anexar, IVA desglosado				nat_doc_anx="A"; 				gpo_doc_anx=35; 				tip_doc_anx=1;				folio_doc_anx="VXX0000001";				iva_desg="S";				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;				setXml(xmlPantalla,"folioManual",folioManual);			//MSS 09102024: Permitir capturar un folio manual				setXml(xmlPantalla,"k_natdocto",nat_doc_anx);				setXml(xmlPantalla,"k_gpodocto",gpo_doc_anx);				setXml(xmlPantalla,"k_tipodocto",tip_doc_anx);				setXml(xmlPantalla,"k_foliodocto",folio_doc_anx);				setXml(xmlPantalla,"k_ivadesglosado","r0",iva_desg);				setXml(xmlPantalla,"k_var_sr",varSR);				setXml(xmlPantalla,"k_cfdi",strCfdi);				setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"k_seleccion",frn.get("k_tipo_orden",-1,1) & "-" & frn.get("k_orden"));				//MSS 22042026 Seleccion de anticipos de autos, servicio y refacciones						frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaFactOrden");				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cuboQuery);				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"venfactorden.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoFactOrden");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					tip_ope = "C";					frn.set("k_folio", mensaje); 					frn.set("operacion", "CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto", strTmp);					strMsg = "El Folio utilizado para esta operacion fue : " & mensaje;					ConfiguraControlesOpcion(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");					frn.set("datcfdi","N");		//Pantalla validacion CFDI										MostrarDatos(folio);					BuscarFolio();				} else {					frn.message(mensaje, "Error", "Aceptar");					frn.set("datcfdi","N");	//Pantalla validacion CFDI					return;				}							} else {/*Consulta*/				folio = frn.get("k_folio");				MostrarDatos(folio);				ArmarRefDocto();							}				}								fun Inicializa(){ //Inicializa los valores en Pantalla			// Revisa parametros recibidos			if( frn.nParam() == 6 ){ //Se han mandado parametros a la pagina                gen_doc=trim(frn.param(0));                 nat_doc=trim(frn.param(1));                 gpo_doc=trim(frn.param(2));                tip_doc=trim(frn.param(3));                 tip_ope=trim(frn.param(4));				uen=trim(frn.param(5));				if (uen &= ""){					uen="XXX";				}                			} else {				frn.message("Operacion no valida...(No coinciden parametros)", "Mensaje","&Aceptar");				frn.open("redirect",2);				return;			}            			if(tip_ope &= "A"){ //Alta				frn.set("operacion","ALTA");			} else {				if(tip_ope &= "B"){ //Baja					frn.set("operacion","BAJA");				} else {					if(tip_ope &= "C"){ //Consulta						frn.set("operacion","CONSULTA");					} else {						frn.message("Operacion no valida ...", "Mensaje","&Aceptar");						frn.open("index",4);						return;								}				}			}					//Llenar combo sucursales			var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmd = cmd & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmd = cmd & " where c1='" & suc_usuario & "'";				}			}							var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");					ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}								frn.set("k_sucn",getXml(cubo));			frn.set("k_sucn",descr_combo("k_sucn",1,suc_usuario));					// Fill Combo Tipo (Con Query FTO Kepler) 			LlenaCmbTipo();						//Fill Combo Tipo de Orden 			cmdQuery = "select c1||'-'||c3 as c2, c1  from keplersc.kdmargen";			IniCombos("k_tipo_orden",cmdQuery);			frn.set("k_tipo_orden", "");				//Llena Combo Forma de pago			CmbFormaPago();						//Llena Combo Uso Cfdi			cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3uso";			IniCombos("k_cfdi",cmdQuery);			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());			frn.set("datcfdi","N");		//Pantalla validacion CFDI							// Fill k_docto | referencia docto			ArmarRefDocto();			LimpiaDatosCte();						if(tip_ope &= "A"){				fecha_config();			}			IniParams();			ActivaFolioManual();		//MSS 09102024: Permitir capturar un folio manual								}		fun fecha_config(){			//validar k_fecha			//se basa en k75 SUB CFD_FOLIO						var cmd, cubo;			sucursal_id=frn.get("k_sucn",-1,1);							cmd = "select C4 from keplersc.kdcfdconfig where c1='" & sucursal_id & "'";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactorden.fecha_config()");			frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboc4");			ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			var fec = getXmlAtt(cubo,"r"&0,"c4");				if (getXmlAtt(cubo,"r"&0,"c4") &= "1"){				frn.set("k_fecha",sys.date(sys.date("year"),sys.date("month")-1,31));				//frn.message(sys.date(sys.date("year"));				//frn.message(sys.date("month"));			}else{				frn.set("k_fecha",sys.date());			}			}		fun CmbFormaPago(){			tipo_id = frn.get("k_tipon",-1,4);			if (tipo_id == 1 && tip_ope &="A"){				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3fp where c1 not in ('"& "99')";				frn.setAtt("k_f_pago","available", "Y");			}else{				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3fp";				frn.setAtt("k_f_pago","available", "Y");			}			IniCombos("k_f_pago",cmdQuery);			if (tipo_id == 2 || tipo_id == 11 || tipo_id == 14){				frn.setAtt("k_f_pago","available", "N");			}		}					fun IniCombos(ctrl_combo, query){			cmdQuery = query;			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set(ctrl_combo,cuboQuery);		}		fun descr_combo(combo,posicion,valor){			var descr, valor_actual;			var len_combo = frn.N(combo);			for (var cont=0; cont<len_combo ; cont++){				valor_actual= frn.get(combo,cont,posicion);				if (valor_actual &=  valor){					descr = frn.get(combo,cont,0);					return descr;				}			}		}		// Armado del Docto Referencia		fun ArmarRefDocto() {			var cadena,tmpFolio, tmpGrupo, tmpTipo;			tmpFolio = frn.get("k_folio");			tmpFolio = PadLeft(tmpFolio,"7","0");			tmpGrupo = PadLeft(gpo_doc,"2","0");			tip_doc = frn.get("k_tipon", -1,4);			tmpTipo = PadLeft(tip_doc,"3","0");			cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;			frn.set("k_docto", cadena);		}					fun PadLeft(pText,pRelleno,pCaracterRelleno) {			var Resultado;			var pos_ini = pText;			var nReg = strlen(pText);			for (var cont = nReg; cont < pRelleno; cont++) {				Resultado = pCaracterRelleno & Resultado;			}			Resultado = Resultado & pText;                			return Resultado;		}		fun ConfiguraControlesOff() {			frn.setAtt("capturaFolio", "visible", "N");			//MSS 09102024: Permitir capturar un folio manual			frn.setAtt("textFolio", "visible", "N");			frn.setAtt("k_folio", "available", "N");			frn.setAtt("k_folio", "visible", "N");			frn.setAtt("k_tipon", "available", "N");				frn.setAtt("k_fecha", "available", "N");			frn.setAtt("k_hora", "available", "N");						frn.setAtt("k_clave", "available", "N");						frn.setAtt("k_tipo_orden", "available", "N");							frn.setAtt("k_orden", "available", "N");							frn.setAtt("k_vendedor", "available", "N");		//k_vendedor=Recepcionista							frn.setAtt("k_refer", "available", "N");			frn.setAtt("k_pedimento", "available", "N");			frn.setAtt("k_claveinv", "available", "N");								frn.setAtt("k_plazo","available", "N");			frn.setAtt("k_vence","available", "N");						frn.setAtt("k_cond","available", "N");			frn.setAtt("k_f_pago","available", "N");			frn.setAtt("k_cuenta","available", "N");			frn.setAtt("k_correo","available", "N");			frn.setAtt("k_coment","available", "N");			frn.setAtt("bot_selec_anticipos","visible","N");		//MSS 20042026 Seleccion de anticipos						frn.setAtt("bot_adenda","visible", "N");			frn.setAtt("bot_adenda","available", "N");			frn.setAtt("Imprimir", "visible", "N");			frn.setAtt("Cancelar", "visible", "N");			frn.setAtt("Aceptar", "visible", "N");			frn.setAtt("BuscarFol", "visible", "N");										}					fun ConfiguraControlesOpcion() {			ConfiguraControlesOff();			if(tip_ope &= "A"){ //Alta				if (folioManual&="S"){		//MSS 09102024: Permitir capturar un folio manual					frn.setAtt("capturaFolio", "visible", "Y");						frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");					}				frn.setAtt("k_tipon", "available", "Y");				frn.setAtt("k_fecha", "available", "Y");				frn.setAtt("k_hora", "available", "Y");				frn.setAtt("k_clave", "available", "Y");							frn.setAtt("k_tipo_orden", "modify", "Y");				frn.setAtt("k_tipo_orden", "available", "Y");								frn.setAtt("k_orden", "available", "Y");				frn.setAtt("k_orden", "modify", "Y");								frn.setAtt("k_vendedor", "available", "Y");		//k_vendedor=Recepcionista				frn.setAtt("k_vendedor", "modify", "Y");								frn.setAtt("k_refer", "available", "N");							frn.setAtt("k_plazo","modify", "Y");				frn.setAtt("k_plazo","available", "Y");				frn.setAtt("k_vence","modify", "Y");				frn.setAtt("k_vence","available", "Y");							frn.setAtt("k_cond","modify", "Y");				frn.setAtt("k_cond","available", "Y");				frn.setAtt("k_f_pago","modify", "Y");				frn.setAtt("k_f_pago","available", "Y");				frn.setAtt("k_cfdi","modify", "Y");				frn.setAtt("k_cfdi","available", "Y");				frn.setAtt("k_cuenta","modify", "Y");				frn.setAtt("k_cuenta","available", "Y");				frn.setAtt("k_correo","modify", "Y");				frn.setAtt("k_correo","available", "Y");				frn.setAtt("k_coment","modify", "Y");				frn.setAtt("k_coment","available", "Y");				frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "Y");				frn.setAtt("BuscarFol", "visible", "N");				//HabilitaAnticipos();										//MSS 28052026 Seleccion de anticipos servicio y refacciones solo CXC				frn.setAtt("bot_selec_anticipos","visible","Y");	//MSS 28052026 Seleccion de anticipos de autos, servicio y refacciones			} else {				if(tip_ope &= "C"){ //Consulta					frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");						frn.setAtt("k_tipon", "available", "Y");										frn.setAtt("k_fecha", "available", "N");					frn.setAtt("k_hora", "available", "N");					frn.setAtt("k_tipo_orden", "available", "N");									frn.setAtt("k_orden", "available", "N");															frn.setAtt("k_vendedor", "available", "N");		//k_vendedor=Recepcionista															frn.setAtt("k_refer", "available", "N");					frn.setAtt("k_claveinv", "available", "N");						frn.setAtt("k_pedimento", "available", "N");																frn.setAtt("k_plazo","available", "N");										frn.setAtt("k_vence","available", "N");									frn.setAtt("k_cond","available", "N");					frn.setAtt("k_f_pago","available", "N");					frn.setAtt("k_cfdi","available", "N");					frn.setAtt("k_correo","available", "N");					frn.setAtt("k_cuenta","available", "N");											frn.setAtt("k_coment","available", "Y");					frn.setAtt("k_coment","modify", "N");					frn.setAtt("Imprimir", "visible", "Y");					frn.setAtt("Cancelar", "visible", "N");					frn.setAtt("Aceptar", "visible", "N");					frn.setAtt("BuscarFol", "visible", "Y");					//HabilitaAnticipos();											//MSS 28052026 Seleccion de anticipos de autos, servicio y refacciones					frn.setAtt("bot_selec_anticipos","visible","Y");	//MSS 28052026 Seleccion de anticipos de autos, servicio y refacciones												} else {					frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");					frn.setAtt("k_fecha", "available", "Y");					frn.setAtt("k_hora", "available", "Y");				}			}		}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    			1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 			2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 			3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			// var tip_ope; 			var tip_oper;			if(iModo==0)				page=pag; 			else if(iModo==2&&(strlen(par0)>0)){				//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       				if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 				if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;			}			else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     		}								fun LimpiaDatosCte() {					frn.set("k_rfc", "");			frn.set("k_nombreimprfact","");			frn.set("k_nombreprov", "");			frn.set("k_calleprov", "");			frn.set("k_coloniaprov", "");			frn.set("k_poblacionprov", "");			frn.set("k_cpprov", "");			frn.setAtt("bot_adenda","visible", "N");			frn.setAtt("bot_adenda","available", "N");			LimpiaDatosDoc();		}					fun LimpiaDatosDoc() {			frn.set("k_plazo", "");			frn.set("k_vence", "");			frn.set("k_cond", "");			frn.set("k_coment", "");			frn.set("k_f_pago", "");			frn.set("k_cuenta", "");			frn.set("k_m_pago", "");			frn.set("k_cfdi", "");			frn.set("k_correo", "");			frn.set("datcfdi","N");		//Pantalla validacion CFDI		}					fun LimpiaTotalesDoc() {			frn.set("k_montoext1", "");			frn.set("k_montoext2", "");			frn.set("k_montoext3", "");			frn.set("k_montoext4", "");			frn.set("k_subtotal", "");			frn.set("k_iva", "");			frn.set("k_monto", "");			frn.set("k_porciva", "");		}					fun LimpiaEncabezado() {			frn.set("k_folio", "");			frn.set("k_docto", "");			frn.set("k_fecha", "");			frn.set("k_hora", "");			frn.set("k_tipo_orden", "");			LimpiaTipOrden();			LimpiaDatosCte();			}		fun CambiaFolio(){			frn.set("k_docto", "");			frn.set("k_fecha", "");			frn.set("k_hora", "");			frn.set("k_tipo_orden", "");			LimpiaTipOrden();			LimpiaDatosCte();		}				fun LimpiaTipOrden(){			frn.set("k_orden", "");				LimpiaNumOrden();		}					fun LimpiaNumOrden(){			frn.set("k_vendedor", "");			frn.set("k_nombre_recep", "");				frn.set("k_refer", "");			frn.set("k_pedimento","");			frn.set("k_claveinv", "");			frn.set("k_clave", "");				LimpiaDatosCte();			LimpiaDatosDoc();			LimpiaTotalesDoc();		}		fun CambiaSucursal() {			LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());										LlenaCmbTipo();						ArmarRefDocto();			if(tip_ope &= "A"){				fecha_config();			}			ActivaFolioManual();			//MSS 09102024: Permitir capturar un folio manual			//HabilitaAnticipos();			//MSS 28052026 Seleccion de anticipos servicio y refacciones solo CXC		}				fun LlenaCmbTipo(){			sucursal_id = frn.get("k_sucn",-1,1);						// Fill Combo Tipo (Con Query FTO Kepler) 			cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5,"&					   "c16 as c6,c7,c14,c47,c80,c86,c89,c67,c77 from keplersc.kdmm"&					   " where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' order by c5";			IniCombos("k_tipon",cmdQuery);		}					fun CambiaTipo() {			tipo_id = frn.get("k_tipon",-1,4);			tip_doc = tipo_id;			CmbFormaPago();			LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();			fecha_config();			ActivaFolioManual();			//MSS 09102024: Permitir capturar un folio manual			HabiltaInv();			//HabilitaAnticipos();			//MSS 28052026 Seleccion de anticipos servicio y refacciones solo CXC		}		fun HabiltaInv(){			m67 = frn.get("k_tipon",-1,13);							m77 = frn.get("k_tipon",-1,14);						if (m77 &= "S"){				if (m67 &= "A" || m67 &= "U"){					frn.setAtt("k_claveinv", "available", "Y");						frn.setAtt("k_claveinv", "modify", "Y");				}			}else{				frn.setAtt("k_claveinv", "available", "N");					frn.setAtt("k_claveinv", "modify", "N");			}						}		fun ObtenerCliente() {			frn.set("k_clave", "");						LimpiaDatosCte();			cmdQuery = "select c2 as clave, C3 as nombre " &						"from keplersc.kdud";			frn.dialog("genlistasel","Clientes",cmdQuery,"clave","k_clave",0,"","S");					}		fun BuscarCliente(){					var xmlProd;											sucursal_id = frn.get("k_sucn",-1,1);			cliente_id = frn.get("k_clave");			LimpiaDatosCte();			LimpiaDatosDoc();										if (strlen(frn.get("k_clave")) == 0) {				return;			}								cmdQuery = "select cte.c10 as k_rfc, cte.c3 as k_nombreprov, cte.c4 as k_calleprov, cte.c5 as k_coloniaprov, cte.c6 as k_poblacionprov, cte.c27 as k_cpprov, " &									"cte.c11 as k_correo, case when cte.c16 is null then '0' when cte.c16='" & "' then '0' else cte.c16 end k_plazo, cte.c30 as k_nombreimprfact," &					"'['||uso.c1||'] '||uso.c2 as k_cfdi " &					"from keplersc.kdud cte "&					"left join keplersc.kdf3uso uso on uso.c1=cte.c53 " &					"where cte.c2='" & cliente_id & "'" ;			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.BuscaCliente()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.setPos("k_clave");				frn.message("El cliente no existe","Error","Aceptar");				return;				}							rstXml(xmlProd);			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");			frn.setX(xmlProd);			Plazo();			DefineMetodoCfd();			adenda_id=Adenda(cliente_id);						}					fun SelTipoOrden(){			LimpiaTipOrden();		}		fun ObtenerNumOrden() {						sucursal_id = frn.get("k_sucn",-1,1);			tiporden = frn.get("k_tipo_orden",-1,1);			if (tiporden &= ""){				frn.message("Debe seleccionar tipo de Orden","Error","Aceptar");				return;			}				LimpiaNumOrden();			cmdQuery = "select C3 as orden, to_char(C4, 'dd/mm/yyyy') as fecha, C6 as serie,C11 as cliente " &						"from keplersc.kdord " & 						"where c1 = '" & sucursal_id & "' and c2= '" & tiporden & "' and c7=10 order by c4 desc ";			frn.dialog("genlistasel","Ordenes",cmdQuery,"orden","k_orden","","","S");					}        		fun BuscarOrden(){				var xmlRef, nCampos, xmlRequest, xmlEncabezado;			var tmpStr, tmpXml, contDet, xmlCurDet, xmlDetConv, tmpUsocfdi;			// Guarda Datos para Busqueda 			sucursal_id = frn.get("k_sucn",-1,1);										tiporden = frn.get("k_tipo_orden",-1,1);			numorden = PadLeft(frn.get("k_orden"),"10","0"); 			frn.set("k_orden",numorden);				if (tiporden &= ""){				frn.setPos("k_tipo_orden");				frn.message("Debe seleccionar tipo de Orden","Error","Aceptar");				return;			}					setXml(xmlRequest,"document","sucursal_id",sucursal_id);			setXml(xmlRequest,"document","tipo_orden",tiporden);			setXml(xmlRequest,"document","num_orden",numorden);							cmdQuery = "select * from keplersc.ser_fact_orden_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";			frn.lib("libGeneral.kpl","FileSave",xmlRequest, fileSavePath & "\xmlentradaser_fact_orden");							rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.BuscarOrden()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlsalidaser_fact_orden");							ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}								//Datos de orden->xmlEncabezado			tmpStr=getXmlAtt(cuboQuery,"r0","encabezado");			rstXml(xmlEncabezado);			tmpStr=delScpScn(tmpStr);			setXmlStr(xmlEncabezado,tmpStr);			tmpXml = getXml(xmlEncabezado,"row");			frn.lib("libGeneral.kpl","FileSave",tmpXml , fileSavePath & "\venfactorden_xml_Convertido");							frn.setX(tmpXml);						if(nXml(tmpXml) == 0){				frn.message("La orden : " & numorden & ", No se encontro ...","Error","Aceptar");				return;							}			Plazo();			DefineMetodoCfd();			tmpUsocfdi= frn.get("k_cfdi");			frn.setX(tmpUsocfdi,"k_cfdi",-1);			porc_iva = frn.get("k_tipon",-1,6);			frn.set("k_porciva",porc_iva);			//VCSS 10 julio 2025 Recalcular el iva de la orden			var nuevo_iva=frn.get("k_subtotal") * (porc_iva/100);			frn.set("k_iva",nuevo_iva);			frn.set("k_monto",frn.get("k_subtotal") + nuevo_iva);						if (frn.get("k_subtotal") == 0 && frn.get("k_iva") == 0 && frn.get("k_monto") == 0){				//VCSS 02 Junio 2025				//Cambiar esrtus de orden a Terminada (30) para cerrar, este caso normalmente suede				//cuando se inicia la operacion con K80, la causa es que los totales se calculan en esta version				//como una funcion nueva				cmdQuery = "update keplersc.kdord set c7=0, c8=30 where c1='" & sucursal_id & "' " & 					" and c2='" & tiporden & "' and c3= '" & numorden & "' " ;//				frn.lib("libGeneral.kpl","FileSave",xmlRequest, fileSavePath & "\xmlentradaser_fact_orden");								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.BuscarOrden()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboUpdateOrden");								ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}								frn.message("Cierre la Orden para generar los montos de la factura","Error","Aceptar");				return;			}					}		fun ObtenerRecep() {			cmdQuery = "select c1 as clave, c2 as recepcionista " & 						"from keplersc.kdrecep";			frn.dialog("genlistasel","Recepcionistas",cmdQuery,"clave","k_vendedor",-1,"","S");						}		fun DefineMetodoCfd(){			var m14,m86; 							m80 = frn.get("k_tipon",-1,10);							m14 = frn.get("k_tipon",-1,8);											m86 = frn.get("k_tipon",-1,11);							if (m80 &= "S" && gen_doc &= "U"){				if (m14 &="S"){					frn.set("k_m_pago","PUE");						if (m86 &="P" || m86 &="S"){						frn.set("k_m_pago","PPD");					}				}else {					descr_combo("k_f_pago",1,"99");					frn.set("k_f_pago",descr_combo("k_f_pago",1,"99"));					//frn.setAtt("k_f_pago","available", "S"); 					frn.set("k_m_pago","PPD");					}			}else{				frn.set("k_m_pago","PUE");			}		}		fun SelSucInvent(){			var vsuc,nCampos,vcveinv;				//Separa el sucursal e inventario vienen concatenados con |			nCampos = strSplit(frn.get("strcveinv"),"|",-1);			if (nCampos > 1) {				vsuc = trim(strSplit(frn.get("strcveinv"),"|",0));				vcveinv = trim(strSplit(frn.get("strcveinv"),"|",1));				frn.set("k_claveinv",vcveinv);				frn.set("k_pedimento",vsuc);			}		}		fun Adenda(cve_cliente){			var m89;			m80 = frn.get("k_tipon",-1,10);				m89 = frn.get("k_tipon",-1,12);							if (m80 &= "S" && m89 &= "S"){							cmdQuery = "select c1 as cve_adenda " & 							"from keplersc.kdadheader " &							"where c3='" &cve_cliente & "'";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.Adenda()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\kdadheader");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				adenda_id = getXmlAtt(cuboQuery,"r0","cve_adenda");				if((nXml(cuboQuery) > 0) && (adenda_id &! "")) {					frn.setAtt("bot_adenda","visible", "S");					frn.setAtt("bot_adenda","available", "S");					return adenda_id;				}			}		}		fun EjecutaAdenda(){			var externo, nReg;			cliente_id = frn.get("k_clave");			adenda_id=Adenda(cliente_id);			if ((adenda_id &! "")){				cmdQuery = "select c1 as adenda,c2 as segmento,c3 as variable,c4 as valor " & 							"from keplersc.kdadvariable " &							"where c1='" &adenda_id & "'";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.ValidarDatos()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\kdadvariable");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				nReg=nXml(cuboQuery);				for(var i=0; i< nReg; i++){					segmento = getXmlAtt(cuboQuery,"r"&i,"segmento");					variable = getXmlAtt(cuboQuery,"r"&i,"variable");					valor = getXmlAtt(cuboQuery,"r"&i,"valor");					//Validar que tenga datos de segmento y variable la adenda					if ((segmento &="") || (variable &="")){						frn.message("Falta datos de segmento o variable de la adenda","Error","Aceptar");						return;					}					}					}			frn.dialog("cfd_adenda",externo,cliente_id);		}		fun BuscarRecep(){			var recep_id;			recep_id=frn.get("k_vendedor");			cmdQuery = "select C2 as descripcion from keplersc.kdrecep " &					"where c1='" & recep_id & "'";									rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.BuscarRecep()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cubo");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if((nXml(cuboQuery) == 0) && (recep_id &! "")) {				frn.setPos("k_vendedor");				frn.message("La clave de recepcionista no existe","Error","Aceptar");				return;			} else{				frn.set("k_nombre_recep",getXmlAtt(cuboQuery,"r0","descripcion"));					}					}		fun ObtenerFolio() {			sucursal_id = frn.get("k_sucn",-1,1);			LimpiaEncabezado();			cmdQuery = "select c5 as tipo, c6 as folio, to_char(c9, 'dd/mm/yyyy') as fecha, c10 as cve_cliente, " &						"c11 as referencia, c121 as t, c122 as orden, c16 as monto, concat(c5,'~',c6) as llave " &						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc &						" order by c5,c9 desc";							frn.dialog("genlistafiltrosel","Folios de Ordenes Enviados a Facturar",cmdQuery,"llave","strfolio","0","0","N","S");						}		fun ObtenerInv() {			cmdQuery = "select c1||' | '|| c2 as inventario from keplersc.kdinf";							frn.dialog("genlistafiltrosel","Numeros de Inventario",cmdQuery,"inventario","strcveinv","0","0","N","S");						}		fun ValidaFolioCancelado(folio){		var statusfolio;			cmdQuery = "select c43 as status_folio " & 						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc & " and c6= '" & folio & "'";						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.ValidaFolioCancelado()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ValidaFolioCancelado");			ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			statusfolio = getXmlAtt(cuboQuery,"r0","status_folio");			if (statusfolio &= "C"){	// C=Cerrado				resVal=0;				frn.message("El folio se encuentra cancelado","Error","Aceptar");				return;			}		}					fun MostrarDatos(nFolio) {			var folio, refer, xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle;			var tmpStr, tmpXml, contDet, xmlCurDet, xmlDetConv;			// Guarda Datos para Busqueda 			sucursal_id = frn.get("k_sucn",-1,1);			folio = nFolio;											setXml(xmlRequest,"document","sucursal_id",sucursal_id);			setXml(xmlRequest,"document","genero",gen_doc);			setXml(xmlRequest,"document","naturaleza",nat_doc);			setXml(xmlRequest,"document","grupo",gpo_doc);			setXml(xmlRequest,"document","tipo",tip_doc);			setXml(xmlRequest,"document","folio",folio);				cmdQuery = "select * from keplersc.ser_fact_orden_cons('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";			frn.lib("libGeneral.kpl","FileSave",xmlRequest, fileSavePath & "\venfactorden_xml_K80ToPostgreSql_buscar");							rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\venfactorden_xml_PostgreSql_buscar");							ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			//Limpiar antes de presentar datos			LimpiaTipOrden();					//Datos de encabezado			tmpStr=getXmlAtt(cuboQuery,"r0","encabezado");			rstXml(xmlEncabezado);			tmpStr=delScpScn(tmpStr);			setXmlStr(xmlEncabezado,tmpStr);			tmpXml = getXml(xmlEncabezado,"row");			frn.lib("libGeneral.kpl","FileSave",tmpXml , fileSavePath & "\venfactorden_xml_Converted_Enc_buscar");							frn.setX(tmpXml);			tipo_id = frn.get("k_tipon",-1,4);			tip_doc = tipo_id;			if(nXml(tmpXml) == 0){				frn.message("El folio de la orden : " & folio & ", No se encontro ...","Error","Aceptar");				return;							}							} 		fun ValidarPlazo(){			if (frn.get("k_plazo")>20){				frn.setPos("k_plazo");				frn.message("El plazo maximo es de 20 dias","Error","Aceptar");				return;			}			Plazo();			}					fun Plazo(){ //Calcula la fecha de pago, y las condiciones de pago en base al plazo			var cond, m7, m47, valplazo = 0;			m7 = frn.get("k_tipon",-1,7);							m47 = frn.get("k_tipon",-1,9);			frn.setAtt("k_plazo","available", "Y");			frn.setAtt("k_vence","available", "Y");						frn.setAtt("k_cond","available", "Y");					if (m7 &="S" && m47 &="N"){				cond=frn.get("k_plazo") & " dias fecha factura";							} else{				frn.set("k_plazo", valplazo);				frn.setAtt("k_plazo","available", "N");				frn.setAtt("k_vence","available", "N");							frn.setAtt("k_cond","available", "N");			}						if (frn.get("k_plazo")==0){ 				cond="Pago de contado";			}			frn.set("k_vence",fnDate("addC",frn.get("k_fecha"),frn.get("k_plazo")));//Suma dias comerciales			frn.set("k_cond",cond);						}		fun ActivaFolioManual(){		//MSS 09102024: Permitir capturar un folio manual			var configfolio;			cmdQuery = "select folio_manual " & 						"from keplersc.kdmm " &						"where col_sucursal='" &sucursal_id& "' and c1='" &gen_doc& "' and c2='" &nat_doc& "' and c3 =" &gpo_doc& " and c4= " & tip_doc;						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.ActivaFolioManual()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\FolioManual");			ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			configfolio = getXmlAtt(cuboQuery,"r0","folio_manual");			if (configfolio &= "S") {	// Folio Manual				folioManual = "S";				frn.setAtt("capturaFolio", "visible", "Y");				//frn.message("El movimiento requiere folio manual","Atencion","Aceptar");			} else{				folioManual = "N";				frn.setAtt("capturaFolio", "visible", "N");				}			ConfiguraControlesOpcion();		}		fun FolioManual(){					//Valida Folio Manual				//MSS 09112024: Permitir capturar un folio manual			var totReg;			nfolioManual = frn.get("k_folio");			if (folioManual &="S"){				if (nfolioManual &= ""){					frn.setPos("k_folio");					resVal=0;					frn.message("Es necesario capturar el Folio","Error","Aceptar");					return;				} else{							//valida longitud del folio					if (strlen(nfolioManual) > 10){						frn.setPos("k_folio");						resVal=0;						frn.message("El folio no puede tener mas de 10 caracteres....Verifique","Error","Aceptar");						return;					}					//valida que no exista					cmdQuery = "select count(*) as totreg " & 						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc & " and c6= '" & nfolioManual & "'";								rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.FolioManual()");					frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ExisteFolioManual");					ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok) {						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}					totReg=getXmlAtt(cuboQuery,"r0","totreg");					if (totReg > 0){						frn.setPos("k_folio");						resVal=0;						frn.message("El folio capturado ya existe....Verifique","Error","Aceptar");						return;					}				}			}		}				fun SeleccionAnticipos(){					//MSS 20042026 Seleccion de anticipos			var operacion,movto;			movto = "SERVICIO";			if (frn.get("k_tipo_orden") &! "" && frn.get("k_orden") &! "" && frn.get("k_clave") &! ""){				cve_seleccion = frn.get("k_tipo_orden",-1,1) & "-" & frn.get("k_orden");				if (tip_ope &="A"){					operacion = 0;				}else if (tip_ope &="C"){					operacion = 1;				}				frn.dialog("venseleccionanticipos.kpl", frn.get("k_sucn",-1,1), frn.get("k_clave"), frn.get("k_rfc"), cve_seleccion, operacion, movto);			} else{				frn.message("Es necesario indicar el Tipo de Orden, No. Orden y/o Cliente","Error","Aceptar");				return;				}			}				fun HabilitaAnticipos(){		//MSS 28052026 Seleccion de anticipos servicio y refacciones solo CXC			var cxc;			cxc = frn.get("k_tipon",-1,7);			if (cxc &= "S"){				frn.setAtt("bot_selec_anticipos","visible","Y");			} else{				frn.setAtt("bot_selec_anticipos","visible","N");			}		}		fun IniParams(){//Inicializa parÃ¡metros de impresiÃ³n, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar PÃ¡gina				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1","param_borderT","1.5","param_borderR","1","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}						fun setRepPage() {//Establece los parametros finales de impresion.			var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";			var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";			var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");			var lndsp="landscape=" & frn.get("param_landscape");			var emp="@emp=" & frn.get("param_emp");			rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);		}			fun EjecReporte(){//Imprime el reporte del documento especificado 			if(strlen(trim(frn.get("k_folio")))==0){ 				frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");				frn.setPos("k_folio");return;				}			m80 = frn.get("k_tipon",-1,10);							if (m80 &= "S"){				Reporte();				frn.setPos("k_folio");			}else{				frn.message("Se imprime solo para documentos que generan CFD","Error","&Aceptar");				frn.setPos("k_folio");return;			}		}								fun Reporte(){				var compania,contProd, contDet, tmpStr;				var xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle;					var tmpXml, contDet, xmlCurDet, xmlDetConv, datdoc;				var fecha, total, importe, folio;								sucursal_id = frn.get("k_sucn",-1,1);				folio = frn.get("k_folio");				tip_doc = frn.get("k_tipon",-1,4);				//Armar xml con los parametros				setXml(xmlRequest,"document","sucursal_id",sucursal_id);				setXml(xmlRequest,"document","genero",gen_doc);				setXml(xmlRequest,"document","naturaleza",nat_doc);				setXml(xmlRequest,"document","grupo",gpo_doc);				setXml(xmlRequest,"document","tipo",tip_doc);				setXml(xmlRequest,"document","folio",folio);				frn.lib("libGeneral.kpl","FileSave",xmlRequest , fileSavePath & "\xmlConsultaReporte");				cmdQuery="select * from keplersc.ser_factura_orden_rep('"& getXmlStr(xmlRequest,"EOF:13_10") &"')";				rstXml(cuboQuery);    //xml general con todos los datos				cuboQuery= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venfactorden.Reporte()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									//Procesa xml encabezado				frn.lib("libGeneral.kpl","FileSave",cuboQuery , fileSavePath & "\xmlResQueryReporteCompleto ");					tmpStr=getXmlAtt(cuboQuery,"r0","encabezado");				tmpStr=delScpScn(tmpStr);					rstXml(xmlEncabezado);				setXmlStr(xmlEncabezado,tmpStr);				tmpXml = getXml(xmlEncabezado,"row");				frn.lib("libGeneral.kpl","FileSave",tmpXml , fileSavePath & "\xmlResQueryReporte");																//Obtener datos de encabezado				kdb.kde("KDE");//Configuraci??el servidor				kdb.exec();				compania = kdb.get("KDE","1");   // Se obtiene el nombre de la compania				// Se define el formato a usar y se liga a la variable del reporte "rep"				kdb.readPage("datFto","venfactordenfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				rep.rst();				rep.page("paper=size","size=8,14cm","border=.5,.5,.5,.5cm","F=1,1","landscape=N","color=N","prompt=N","@emp=L","collate=N","copies=1","pages=1,999");											//Da valor a los inputs del reporte(rep.set();), e indica la ejecuci?n de "grupos de renglones de impresi?n" (rep.exe();)				rep.set("fecha",getXml(tmpXml,"fecha"));				rep.set("hora",getXml(tmpXml,"hora"));				rep.set("nombreempresa",compania);				rep.exe("encabezado");				rep.set("rfc",getXml(tmpXml,"rfc"));				rep.set("nombre",getXml(tmpXml,"nombre"));				rep.set("calle",getXml(tmpXml,"calle"));				rep.set("num_orden",getXml(tmpXml,"orden"));				rep.set("folio",folio);				rep.set("importe_total",getXml(tmpXml,"importe_total"));				rep.set("forma_pago",getXml(tmpXml,"forma_pago"));				rep.set("vin",getXml(tmpXml,"vin"));				rep.set("cajera",getXml(tmpXml,"cajera"));				rep.exe("detalle");													rep.win(); //Muestra la vista previa de la impresi?n. A partir de la vista previa (Preprint) se decide si se imprime o no.			}		} // End of class Main	</script></pag>