<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<!-- dim="1,-1,10,11" -->	<grp dim="1,-1,10,9" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<!-- <tab/> -->  <sp n="2"/>		<txt fnt="Arial,22" clr="0,0,0">TOTs</txt>		<br/>		<!-- <tab/> -->  <sp n="2"/>		<hLine clr="0,0,0"/> 		<br/> <br/>		<!-- <tab/> -->  <sp n="2"/>		<!-- dim="46,10,7,11" -->		<!-- dim="50,10,7,11" -->		<grp dim="50,12,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">			<!-- <br/> -->			<sp n="2"/>			<txt>Sucursal :</txt>			<sp n="2"/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="54,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" tooltip="Sucursal" available="Y" modify="Y"/>			<br/> <!-- <br/> -->			<sp n="2"/>			<txt>Tipo :</txt>			<sp n="6"/>			<cmb id="k_tipon" dim="54,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo()" tooltip="Tipo de Movimiento"/>						<br/>			<sp n="2"/> <txt id="textProvPago" clr="6,31,255" hk="P" visible="Y">Proveedor de Pago :</txt>			<sp n="1"/>			<edt id="k_clave_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 				OnButton="Get_Cat(1)" OnF9="Get_Cat(1)" OnChange="BuscarProvPago()" 				type="capital" nc="7" tooltip="Proveedor de Pago" modify="Y" hk="C" available="Y" visible="Y"/> 			<br/>			<sp n="13"/>			<!-- clr="64,64,64" -->			<inp id="k_nombreprov_pago" clr="6,31,255" clrBrdr="255,255,255"  dim="54,1" fnt="Arial,16" type="capital" modify="N" available="N" nc="50" visible="Y"/>						</grp>				<sp/>				<!-- dim="34,10,7,11" -->		<!-- dim="37,10,7,11" -->		<grp dim="37,12,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="2"/>			<inp id="operacion" dim="48,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C"/><tab/> <br/>			<sp n="2"/>			<txt id="textFolio" visible="N">Folio :  </txt>			<edt id="k_folio" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" tooltip="Folio ( F9 b&#250;squeda )" modify="Y" available="N" visible="N" 			OnF9="ObtenerFolio()" OnButton="ObtenerFolio()" OnChange="Formar_folio()"/><tab n="2"/>			<img id="BuscarFol" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="BuscarFolio()" visible="N"/> <br/>			<sp n="2"/>			<inp id="k_docto" dim="48,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="C"/> <br/>			<sp n="2"/>			<txt>Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N" tooltip="Fecha"/> 			<sp n="1"/> 			<txt>  Hora : </txt> 			<sp n="1"/> 			<edt id="k_hora" dim="15,1" type="time" nc="-1" bclr="240,240,240" modify="Y" fmt="HH:MM:SS" available="Y"/> 			<br/>				<sp n="2"/> <inp id="statusDoc" clr="64,64,64"  dim="48,1" brdr="0,1" fnt=",16b" available="N" just="C"/> <br/>					</grp>		<br/>		<br/> 		<!-- <tab/> -->  <sp n="2"/>		<!-- dim="81,16,7,11" -->		<grp dim="88,21,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Proveedor">						<sp n="1"/> <txt clr="0,58,112" fnt=",b">Selecciona UUID : </txt>			<sp n="3"/>			<inp id="k_refer" clr="64,64,64" clrBrdr="255,255,255"  dim="80,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "N" modify="Y" 				tooltip="Factura del Proveedor"/>					<sp n="5"/>			<!-- OnEnter="ObtenerFactura()" -->			<bot id="Buscar" dim="10" brdr="5" OnEnter="ProcesarFactura()" tooltip="Busca UUID de la factura del proveedor" available="Y" visible="Y"/>				<br/>						<!-- dim="38,9,7,11" -->			<!-- dim="48,13,7,11" -->			<grp dim="52,16,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<sp n="1"/> <txt clr="0,58,112">Proveedor : </txt><tab/>				<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnButton="Dialog(3,cxpcatprobus,k_clave)" OnF9="Dialog(3,cxpcatprobus,k_clave)" OnChange="BuscarProveedor()" 					type="capital" nc="7" tooltip="Proveedor ( F9 b&#250;squeda )" modify="Y" hk="P" available="N"/> 				<br/>				<sp n="1"/> <txt clr="0,58,112">RFC : </txt><sp n="5"/>				<inp id="k_rfc" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="20,1" fnt="Arial,16" type="string" nc="16" modify="Y" available="N"/>				<br/>				<sp n="1"/> <txt clr="0,58,112" fnt=",b">Datos UUID : </txt><sp n="5"/>				<br/>				<sp n="1"/> <txt clr="0,58,112">Serie : </txt><sp n="1"/>				<inp id="k_uuid_serie" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="20,1" fnt="Arial,16" type="string" nc="18" modify="N" available="N"/>				<br/>				<sp n="1"/> <txt clr="0,58,112">Folio : </txt><sp n="1"/>				<inp id="k_uuid_folio" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="30,1" fnt="Arial,16" type="string" nc="18" modify="N" available="N"/>				<br/>								<sp n="1"/> <txt clr="0,58,112">Total : </txt> <sp n="1"/> 				<inp id="k_uuid_monto" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="17,1" fnt="Arial,16" type="string" nc="18" modify="N" available="N"/>								<sp n="1"/> <txt clr="0,58,112">Impuesto : </txt> <!-- <sp n="1"/> -->				<inp id="k_uuid_impuesto" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="15,1" fnt="Arial,16" type="string" nc="1