5,255" brdr="2,0" dim="14,1" fnt="Arial,16" type="string" modify="Y" available="N" nc="10" visible="Y"/>								<br/>				<sp n="1"/> <txt clr="0,58,112">Plazo :</txt><sp n="1"/>				<inp id="k_plazo" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nd="0" min="0" OnChange="Plazo()" modify="Y" available="N" visible="Y"/>				<sp n="1"/> 				<inp id="k_cond" clr="64,64,64" clrBrdr="255,255,255"  dim="28,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="33" modify="N" available="N" visible="Y"/>				<sp n="2"/> <txt clr="0,58,112">Vencimiento :</txt><sp n="1"/>				<edt id="k_vence" clr="64,64,64"  dim="13,1" brdr="2,0" bclr="255,255,255" type="date" nc="-1" fnt="Arial,0" available="N" fmt="DD/MM/CCYY" page="_ks_fecha,k_vence" OnF9="Dialog(3,_ks_fecha,k_vence)" clrBrdr="255,255,255" visible="Y"/><tab/>					</grp> 						<!-- <txt clr="0,58,112">Factura del proveedor : </txt> -->					</grp>				<br/>		<br/>		<!-- <tab/> -->  <sp n="2"/>		<!-- dim="81,21,7,11" -->		<grp dim="81,19,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Movimientos">			<sp n="1"/> 			<tbl id="k_mov" dim="113,6" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" hk="z" OnChange="" Reorder="N" modify="Y" insdel="Y" available="Y">				<col id="k_tipo_orden" name="T"  type="capital" tooltip="Tipo de Orden ( F9 b&#250;squeda )" nc="2" OnF9="ObtenerTipoOrden()" OnChange="BuscarTipoOrden()"					OnMouseL="ObtenerTipoOrden()" modify="Y" available="Y" visible="Y"/>				<col id="k_desc_tipo" name="Desc. Tipo Orden" type="capital" modify="N" tooltip="Descripci&#243;n Tipo de Orden" nc="15" visible="Y" available="N"/>							<col id="k_num_orden" name="Orden" type="capital" OnF9="ObtenerNumOrden()" 					OnMouseL="ObtenerNumOrden()" modify="N" tooltip="N&#250;mero de Orden ( F9 b&#250;squeda )" nc="15" visible="Y" available="Y"/>						<col id="k_punto" name="Punto"  type="number"  modify="N" OnF9="ObtenerPunto()" OnMouseL="ObtenerPunto()" 					OnChange="ValidaPuntoOrden()" OnActive="" visible="Y" tooltip="Punto ( F9 b&#250;squeda )" nc="5" available="Y"/>				<col id="k_desc_punto" name="Desc. Punto" type="capital" modify="N" tooltip="Descripci&#243;n Punto" nc="40" visible="Y" available="N"/>							<col id="k_descriptot" name="Descripci&#243;n TOTs"  type="capital" OnChange="ValidaDescripcion()" OnF9="" OnMouseL="ValidaDescripcion()" modify="Y" available="Y" tooltip="Descripci&#243;n" nc="70" visible="Y"/>				<col id="k_costo" name="Costo"  type="number" nd="2"	OnChange="CalculaPrecio()" tooltip="Costo" modify="Y" available="Y" visible="Y"/>									<col id="k_precio" name="Precio"  type="number" nd="2" min="0" OnF9="" OnMouseL="" OnChange="" OnActive="" tooltip="Precio" modify="N" visible="Y" available="N"/>			</tbl>			<br/>			<sp/>			<grp dim="70,8,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">								<sp n="1"/> <txt clr="0,58,112">N O T A S:</txt>					<!--					<inp id="k_plazo" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nd="0" min="0" OnChange="Plazo()" modify="Y" available="N" visible="Y"/>					<edt id="k_vence" clr="64,64,64"  dim="15,1" brdr="2,0" bclr="255,255,255" type="date" nc="-1" fnt="Arial,0" available="N" fmt="DD/MM/CCYY" page="_ks_fecha,k_vence" OnF9="Dialog(3,_ks_fecha,k_vence)" clrBrdr="255,255,255" visible="Y"/><tab/>					<sp n="1"/> 					<inp id="k_cond" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="33" modify="N" available="N" visible="Y"/>					// Moved to other section (Proveedor Data)					-->				<br/>				<sp n="1"/> <inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="68,3" brdr="2,0" fnt="Arial,16" modify="Y" available="Y" type="string" bclr="255,255,255"/>			</grp>				<sp n="1"/>			<grp dim="41,10,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<sp n="1"/><txt>Antes de IVA : </txt> 				<sp n="3"/> <inp id="k_subtotal" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/>				<br/>				<sp n="1"/> <txt>IVA :</txt><tab n="2"/><sp n="5"/> <inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/>				<txt>  (</txt>				<inp id="k_porciva" dim="4,1" bclr="240,240,240" clrBrdr="255,255,255" type="string" modify="N" available="N" just="L"/>				<txt> %)</txt>									<br/>				<sp n="1"/> <txt fnt=",16" clr="108,34,38">Retenciones ( - ) </txt> <sp n="1"/>				<!-- clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" -->				<inp id="k_sumrets" clr="64,64,64" dim="15,1" fnt=",16" type="number" nd="2" modify="N" available="N"/>										<br/>				<sp n="1"/> <txt fnt=",16b">Importe : </txt>				<sp n="7"/> <inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="N"/>  				<br/>			<!-- <sp n="10"/> -->						</grp>							</grp>					<!-- Esta seccion se saco del Grupo del Grid para crear un Gpo Contiguo -->				<!-- <sp n="1"/> -> Created & Removed --> 		<grp dim="7,10,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit=" ">				<!-- <br/> -->					<br/>		<sp n="2"/>		<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="EjecReporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>						<!-- <sp n="5"/> -->		<br/>		<br/>		<sp n="2"/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>						<!-- <sp n="5"/> -->		<br/>		<br/>		<sp n="2"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		</grp>									</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Variables de control			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, tiporden,desc_tipo, numorden, punto, descripcion, costo, resVal, porc_iva;			var fileSavePath,asterisco;						//Variables validacion factura			var str_uuid, fecha_uuid, rfc_uuid, total_uuid;							//Added by JMM 20240111, 20240120			var nombre_uuid, regimen_uuid, folio_uuid, serie_uuid, NewProvId;			//Added by JMM 20240229			var paramProvPago, proveedor_pago_id;			var impuesto_uuid;			//Added by JMM 20240626			var retisr_uuid, retiva_uuid;						//Variables de parametros			var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd,uen;								fun Main() {			frn=new FRNT;			kdb=new KDB;			rep=new REP;			frP=new FRNTP;			sys=new SYS;			kdb.connect();			kdb.kde("KDE");			kdb.exec();			anio_contable = kdb.get("KDE","14");			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			suc_usuario = frn.lib("libKepler","UserInfo(1)");			asterisco="*";			fileSavePath = "C:\Basura";			Inicializa();							ConfiguraControlesOpcion();		}							//Validacion Datos Generales y Partidas antes de Guardar.		//El resultado de cada validacion se guarda en la variable global resVal.		fun ValidarDatos() {			var totReg, strTotal=0,subTotal=0, iva=0, total=0, renglones, str,vdiferencia;			// New 20240121 ... To Get of PARAMs 			var gapMonto, gapDias; 						//Obtener variables			sucursal_id = frn.get("k_sucn",-1,1);			proveedor_id = frn.get("k_clave");			refer_id = frn.get("k_refer");			// Added JMM 20240229			proveedor_pago_id = trim(frn.get("k_clave_pago"));			//Obtener PARAMs (GAPs) ... 20240112 ... NEW			cmdQuery="SELECT count(*) as totreg from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro in ('GAP Dias Fecha Gastos','GAP Monto Gastos')";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				resVal=0;				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("Los Parametros [GAPs] Necesarios para la Operacion No Existen ...","Error","Aceptar");				resVal=0;				return;			} else {				if(totReg<2){					frn.message("Los Parametros [GAPs] Necesarios para la Operacion No estan Completos ...","Error","Aceptar");					resVal=0;					return;				} else {									// Obtener PARAMs 					// { GAP Dias Fecha Gastos }					cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Dias Fecha Gastos'";					rstXml(cuboQuery);									cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidarDatos()");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPDias");										ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						resVal=0;						return;					}					if (nXml(cuboQuery) > 0) {						gapDias = getXmlAtt(cuboQuery,"r0","paramvalor");					} else {						frn.message("Hubo problemas para obtener los Parametros [GAP Dias Fecha Gastos] ...","Error","Aceptar");						resVal=0;						return;					}										// { GAP Monto Gastos }					cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Monto Gastos'";					rstXml(cuboQuery);									cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidarDatos()");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPMonto");										ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						resVal=0;						return;					}					if (nXml(cuboQuery) > 0) {						gapMonto = getXmlAtt(cuboQuery,"r0","paramvalor");					} else {						frn.message("Hubo problemas para obtener los Parametros [GAP Monto Gastos] ...","Error","Aceptar");						resVal=0;						return;					}									}			}			//Validar Referencia ... Moved here 20240112 			if (refer_id &= ""){				frn.setPos("k_refer");				resVal=0;				frn.message("Es necesario seleccionar la Factura del Proveedor ...","Error","Aceptar");				return;			}									if ( strlen(/*folio_uuid*/nombre_uuid) == 0 || strlen(rfc_uuid) == 0 || strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {				frn.message("No se cuenta con todos los datos mandatorios del UUID.","Error","Aceptar");				resVal=0;				return;			}							//Validar Fecha Referencia ... 20240112 ... NEW			if ( Validar_Fecha_UUID() == 0 ) {					resVal = 0;				return;			}													//Validar Proveedor			// Added 20240112			if ( strlen(frn.get("k_clave")) == 0 || frn.get("k_clave") &= strFormat("ucase","No Existe ...") ) {				if ( strlen(frn.get("k_clave")) == 0 ) {					frn.message("No hay Proveedor Asociado a la Operacion ...","Error","Aceptar");				} else {					frn.message("El Proveedor No Existe ...","Error","Aceptar");				}				resVal=0;				return;			}						cmdQuery="SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_id & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("El Proveedor No Existe ...","Error","Aceptar");				resVal=0;				return;			}									//Validar Proveedor Pago			// Added 20240229			if ( strlen(frn.get("k_clave_pago")) == 0 || frn.get("k_nombreprov_pago") &= strFormat("ucase","No Existe ...") ) {				if ( strlen(frn.get("k_clave_pago")) == 0 ) {					frn.message("No hay Proveedor de Pago Asociado a la Operacion ...","Error","Aceptar");				} else {					frn.message("El Proveedor de Pago No Existe ...","Error","Aceptar");				}				resVal=0;				return;			}			// Added 20240229			cmdQuery = "SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_pago_id & "'";			cmdQuery = cmdQuery & " and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')"; 			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("El Proveedor de Pago No Existe.","Error","Aceptar");				resVal=0;				return;			}						//Validar Referencia ... Moved Up 20240112 			/*			if (refer_id &= ""){				frn.setPos("k_refer");				resVal=0;				frn.message("Es necesario seleccionar la factura del proveedor","Error","Aceptar");				return;			}			*/			//Validar datos del Punto			for (var i=1,n=frn.N("k_mov");i<n-1;i++) {				tiporden = frn.get("k_mov",i,"k_tipo_orden");				numorden = frn.get("k_mov",i,"k_num_orden");				punto = frn.get("k_mov",i,"k_punto");				descripcion = frn.get("k_mov",i,"k_descriptot");				costo = frn.get("k_mov",i,"k_costo");				if ((tiporden &! "") && (numorden &! "")) {					if (tiporden &= ""){						frn.setPos("k_mov",i,"k_tipo_orden");						resVal=0;						frn.message("Debe seleccionar tipo de órden","Error","Aceptar");					}					if (numorden &= ""){						frn.setPos("k_mov",i,"k_num_orden");						resVal=0;						frn.message("Debe seleccionar número de órden","Error","Aceptar");					}					if (punto &= ""){						frn.setPos("k_mov",i,"k_punto");						resVal=0;						frn.message("Debe seleccionar un punto","Error","Aceptar");					}					if (descripcion &= ""){						frn.setPos("k_mov",i,"k_descriptot");						resVal=0;						frn.message("Debe capturar la descripción del punto","Error","Aceptar");					}					if (costo == ""){						frn.setPos("k_mov",i,"k_costo");						resVal=0;						frn.message("Debe capturar el costo del punto","Error","Aceptar");					}					if(resVal==0){						return;					}				}			}			//Validar Costos			for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {				frn.setPos("k_mov",i,"k_costo");				CalculaTotales();							}			//Validar Margen de utilidad			if (ValidaMargenUtilidad()==0){				resVal=0;				return;			};						//Validar Totales			subTotal=frn.get("k_subtotal");			iva=frn.get("k_iva");			total=frn.get("k_monto");			if (total <= 0){				resVal=0;				frn.message("El total de la operación no puede ser cero.","Error","Aceptar");				return;			}			//Validar rfc y monto total de factura correspondan a datos de UUID			strTotal = frn.get("k_monto");			vdiferencia = (strTotal-total_uuid);			if (vdiferencia < 0){				vdiferencia = vdiferencia *(-1); 			}						// Adapted 20240112 ... Se Gestionara por PARAM {TBL : param_oper}			if ( vdiferencia > gapMonto /*0.1*/ ) {				resVal=0;				frn.message("El importe total del TOT no corresponde al de la factura.","Error","Aceptar");				return;			}								if (frn.get("k_rfc") &! rfc_uuid) {				resVal=0;				frn.message("El RFC del TOT no corresponde al de la factura.","Error","Aceptar");				return;			}									} // End ValidarDatos()			fun ValidaPuntoDuplicado() {			var renglon_id, renglones;			renglones = frn.N("k_mov")-1;			renglon_id = frn.getIdJ("k_mov");			tiporden = frn.get("k_mov",-1,"k_tipo_orden");			numorden = frn.get("k_mov",-1,"k_num_orden");			punto = frn.get("k_mov",-1,"k_punto");			for (var i=0; i<renglones; i++) {				if (renglon_id != i){					if ( (frn.get("k_mov",i,"k_tipo_orden") &= tiporden) && (frn.get("k_mov",i,"k_num_orden") &= numorden) &&						(frn.get("k_mov",i,"k_punto") &= punto)) {  						frn.message("Verifique, esta intentado dar de alta el mismo TOT","Error","Aceptar");						return;					}				}				}			}		fun BuscarFolio() {			var folio;			folio = frn.get("k_folio");			resVal = 1;			ArmarRefDocto();						//Commented by JMM 20240710 			/*ValidaFolioCancelado(folio);*/			//Added by JMM 20240710			var stDoc = ValidaFolioCancelado(folio);			frn.set( "statusDoc", stDoc );						//Commented by JMM 20240710 			/*			if(resVal == 0){				return;			}			else{				MostrarDatos(folio);			}			*/				MostrarDatos(folio);	// Adapted by JMM 20240710, Run Func Everytime 		}		fun Cancela() {			CambiaSucursal();			Inicializa();			ConfiguraControlesOpcion();		}					fun ModoBuscar() {			LimpiaEncabezado();			ConfiguraControlesOpcion();		}				fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			var resultado, mensaje, folio;							fecha = sys.date();			hora= sys.time();									if (tip_ope &= "A") {							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;				ValidarDatos();				if(ok &! "1" || resVal == 0){					return;				}				continua = frn.message("¿Desea continuar con la alta?","Atención",2);				if (continua == 0){					return;				}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;											setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);								//Added 20240112				setXml(xmlPantalla,"uuid","serie",serie_uuid);				setXml(xmlPantalla,"uuid","folio",folio_uuid);				setXml(xmlPantalla,"uuid","total",total_uuid);				setXml(xmlPantalla,"uuid","fechatimbrado",fecha_uuid);				//Added 20240229				setXml(xmlPantalla,"uuid","impuesto",impuesto_uuid);				//Added 20240704				setXml(xmlPantalla,"uuid","retisr",retisr_uuid);				setXml(xmlPantalla,"uuid","retiva",retiva_uuid);								//Added by JMM 20240626				setXml(xmlPantalla,"k_miepsret",frn.get("k_uuid_retisr"));				setXml(xmlPantalla,"k_mivaret",frn.get("k_uuid_retiva"));				/*setXml(xmlPantalla,"k_montoanticipo",frn.get("k_otras_retenciones"));*/ // N.A. for these options								// Added by JMM 20240704				setXml(xmlPantalla,"ambiente","schema","CXP_CM_RETENCIONES");									frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudTOTs");												// For Testing ... 20240111 				/*				frn.message("La Informacion se Procesara ...","Info !!!","Aceptar");				return;				*/				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cuboQuery);				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvtalltotscrud.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudTOTs");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					tip_ope = "C";					frn.set("k_folio", mensaje); 					frn.set("operacion", "CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto", strTmp);					strMsg = "El Folio utilizado para esta operación fue : " & mensaje;					ConfiguraControlesOpcion(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");					MostrarDatos(folio);						BuscarFolio();				} else {					frn.message(mensaje, "Error", "Aceptar");					return;				}			} else {				if (tip_ope &= "B") {					resVal = 1;					ValidaBajaTot();					if(resVal == 0){					return;					}						continua = frn.message("¿Desea continuar con la baja?","Atención",2);					if (continua == 0){						return;					}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;													setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);											frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudTOTs");					cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					rstXml(cuboQuery);											cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvtalltotscrud.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudTOTs");											resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok) {						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}					if(resultado &= "1") {						// Commented by JMM 20240704 ... For Standar Show						/*						tip_ope = "C";						frn.set("operacion", "CONSULTA");						ConfiguraControlesOpcion();						strMsg = "El TOTs se ha dado de baja";						frn.message(strMsg, "Mensaje", "Aceptar");						*/						// Added by JMM 2024004 ... For Homologating						folio = frn.get("k_folio");						tip_ope = "C";						frn.set("operacion", "CONSULTA");						strMsg = "El Tots fue dado de Baja ...";						ConfiguraControlesOpcion(); 						frn.message(strMsg, "Mensaje", "Aceptar");						Formar_folio();						BuscarFolio();					} else {						frn.message(mensaje, "Error", "Aceptar");						return;					}				} else {					folio = frn.get("k_folio");					MostrarDatos(folio);				}	/*End Consulta*/ 			}						} // FIN ... Ejecuta()								fun Inicializa(){ //Inicializa los valores en Pantalla					paramProvPago = 0; // Added by JMM 20240229					// Revisa parametros recibidos			if( frn.nParam() == 6 ){ //Se han mandado parámetros a la página                gen_doc=trim(frn.param(0));                 nat_doc=trim(frn.param(1));                 gpo_doc=trim(frn.param(2));                tip_doc=trim(frn.param(3));                 tip_ope=trim(frn.param(4));                uen=trim(frn.param(5));				if (uen &= ""){					uen="XXX";				}			} else {				frn.message("Operación no válida ...", "Mensaje","&Aceptar");				frn.open("redirect",2);				return;			}            			if(tip_ope &= "A"){ //Alta				frn.set("operacion","ALTA");			} else {				if(tip_ope &= "B"){ //Baja					frn.set("operacion","BAJA");				} else {					if(tip_ope &= "C"){ //Consulta						frn.set("operacion","CONSULTA");					} else {						frn.message("Operación no válida ...", "Mensaje","&Aceptar");						frn.open("index",4);						return;								}				}			}							// Fill Combo Sucursal (Con Query de PostgreSQL)			cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}			}			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_sucn",cuboQuery);				sucursal_id = frn.get("k_sucn",-1,1);										// Added by JMM 20240229 ... Check Security PARAM for User to use PROV PAGO			paramProvPago = ProvPago_Sec(usuario);											// Fill Combo Tipo (Con Query FTO Kepler) 			cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.Inicializa()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error BD","Aceptar");				return;			}			frn.set("k_tipon",getXml(cuboQuery));						frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());								// Fill k_docto | referencia docto			ArmarRefDocto();			LimpiaDatosProv();			IniParams();		}					fun CalculaPrecio(){			var precio_punto= 0, margen = 0, iva = 0, margenUtil = 0, totalcte = 0;			var msgTxt;			tiporden = frn.get("k_mov",-1,"k_tipo_orden");			porc_iva = frn.get("k_tipon",-1,6);			numorden = frn.get("k_mov",-1,"k_num_orden"); 			punto = frn.get("k_mov",-1,"k_punto"); 			if (tiporden &= "" ){				frn.set("k_mov",-1,"k_costo","");				frn.setPos("k_mov",-1,"k_tipo_orden");				frn.message("Debe seleccionar tipo de órden","Error","Aceptar");				return;			}				cmdQuery = "select c6 from keplersc.kdmargen " &						"where c1 = '" & tiporden & "'";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.CalculaPrecio()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboMargen");					ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			margen = getXmlAtt(cuboQuery,"r0" ,"c6");							//Calcula precio del punto			precio_punto= frn.get("k_mov",-1,"k_costo")*(1+margen/100);			frn.setX(precio_punto,"k_mov",-1,"k_precio");						CalculaTotales();			if (frn.get("k_mov",-1,"k_descriptot") &= ""){				frn.setPos("k_mov",-1,"k_descriptot");				frn.message("La descripción del TOT no puede ir en blanco","Error","Aceptar");				return;				}		}		fun ValidaMargenUtilidad(){			var margenUtil = 0, margen = 0;			var descripTxt;			for (var i=0,renglones = frn.N("k_mov"); i<renglones; i++) {				tiporden = frn.get("k_mov",i,"k_tipo_orden");				margenUtil = (frn.get("k_mov",i,"k_precio")-frn.get("k_mov",i,"k_costo"))/frn.get("k_mov",i,"k_costo")*100;				cmdQuery = "select c6 from keplersc.kdmargen " &						"where c1 = '" & tiporden & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.CalculaPrecio()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboMargen");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				margen = getXmlAtt(cuboQuery,"r0" ,"c6");				//Calcula margen de utilidad				margenUtil = (frn.get("k_mov",i,"k_precio")-frn.get("k_mov",i,"k_costo"))/frn.get("k_mov",i,"k_costo")*100;				descripTxt = frn.get("k_mov",i,"k_descriptot");				if (margen>math("round",margenUtil,2)){										frn.setPos("k_mov",-1,"k_tipo_orden");					frn.message("El TOT o Refaccion: " & frn.get("k_mov",-1,"k_descriptot") & " No tiene el margen de utilidad minimo cargado","Error","Aceptar");									if (margenUtil <= 0){						resVal=0;						frn.message("El TOT o Refaccion: " & frn.get("k_mov",-1,"k_descriptot") & " El margen de utilidad no puede ser 0 o negativo","Error","Aceptar");						return;												//TO DO: PANTALLA DE PASSWORD DE AUTORIZACION Y resVal=1					}					}				return resVal;				}		}					// Armado del Docto Referencia		fun ArmarRefDocto {			var cadena,tmpFolio, tmpGrupo, tmpTipo;			tmpFolio = frn.get("k_folio");			tmpFolio = PadLeft(tmpFolio,"7","0");			tmpGrupo = PadLeft(gpo_doc,"2","0");			tmpTipo = PadLeft(tip_doc,"3","0");			cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;			frn.set("k_docto", cadena);		}					fun PadLeft(pText,pRelleno,pCaracterRelleno) {			var Resultado;			var pos_ini = pText;			var nReg = strlen(pText);			for (var cont = nReg; cont < pRelleno; cont++) {				Resultado = pCaracterRelleno & Resultado;			}			Resultado = Resultado & pText;                			return Resultado;		}		fun ConfiguraControlesOff() {							frn.setAtt("textFolio", "visible", "N");			frn.setAtt("k_folio", "available", "N");			frn.setAtt("k_folio", "visible", "N");							frn.setAtt("k_fecha", "available", "N");			frn.setAtt("k_hora", "available", "N");			frn.setAtt("k_clave", "available", "N");			frn.setAtt("k_refer", "available", "N");						// Added 20240131 by JMM 			frn.setAtt("k_plazo", "visible", "Y");			frn.setAtt("k_vence", "visible", "Y");			frn.setAtt("k_cond", "visible", "Y");			frn.setAtt("k_plazo", "available", "N");			frn.setAtt("k_vence", "available", "N");			frn.setAtt("k_cond", "available", "N");							frn.setAtt("Imprimir", "visible", "N");			frn.setAtt("Cancelar", "visible", "N");			frn.setAtt("Aceptar", "visible", "N");			frn.setAtt("BuscarFol", "visible", "N");			frn.setAtt("Buscar", "available", "N");							//Added by JMM 20240229			/*frn.setAtt("k_fecha", "available", "N");*/			frn.setAtt("Buscar", "visible", "N");			frn.setAtt("Buscar", "available", "N");						// Added by JMM 20240229			frn.setAtt("textProvPago", "visible", "Y");			frn.setAtt("k_clave_pago", "visible", "Y");			frn.setAtt("k_nombreprov_pago", "visible", "Y");			frn.setAtt("k_clave_pago", "available", "N");			frn.setAtt("k_nombreprov_pago", "available", "N");		}					fun ConfiguraControlesOpcion() {						ConfiguraControlesOff();			if(tip_ope &= "A"){ //Alta				//frn.setAtt("k_fecha", "available", "Y");				frn.setAtt("k_fecha", "available", "N"); // 20240112				//frn.setAtt("k_hora", "available", "Y");				frn.setAtt("k_hora", "available", "Y"); // 20240112								//frn.setAtt("k_clave", "available", "Y");				frn.setAtt("k_clave", "available", "N"); // 20240111								frn.setAtt("k_refer", "available", "N");				frn.setAtt("k_mov", "modify", "Y", "k_tipo_orden");				frn.setAtt("k_mov", "available", "Y", "k_tipo_orden");				frn.setAtt("k_mov", "modify", "Y", "k_descriptot");				frn.setAtt("k_mov", "modify", "Y", "k_costo");				frn.setAtt("k_mov", "available", "Y", "k_num_orden");				frn.setAtt("k_mov", "available", "Y", "k_punto");				frn.setAtt("k_mov", "available", "Y", "k_descriptot");				frn.setAtt("k_mov", "available", "Y", "k_costo");				frn.setAtt("k_coment","modify", "Y");				frn.setAtt("k_coment","available", "Y");				frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "Y"/*"N"*/);				frn.setAtt("Aceptar", "visible", "Y");									frn.setAtt("BuscarFol", "visible", "N");				frn.setAtt("Buscar", "available", "Y");									// Added by JMM 20240229				frn.setAtt("Buscar", "visible", "Y");				frn.setAtt("Buscar", "available", "Y");				// Added by JMM 20240229				if ( paramProvPago /*&= "P"*/ > 0 ) {									frn.setAtt("k_clave_pago", "available", "Y");				} else {					frn.setAtt("k_clave_pago", "available", "N");				}							} else {				if(tip_ope &= "B"){ //Baja									frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");					frn.setAtt("k_fecha", "available", "Y");					frn.setAtt("k_hora", "available", "Y");					frn.setAtt("k_mov", "modify", "N", "k_descriptot");					frn.setAtt("k_mov", "modify", "N", "k_costo");					frn.setAtt("k_mov", "available", "N", "k_tipo_orden");					frn.setAtt("k_mov", "available", "N", "k_num_orden");					frn.setAtt("k_mov", "available", "N", "k_punto");					frn.setAtt("k_mov", "available", "N", "k_descriptot");					frn.setAtt("k_mov", "available", "N", "k_costo");					frn.setAtt("k_mov", "available", "N", "k_precio");					frn.setAtt("k_coment","modify", "N");					frn.setAtt("k_coment","available", "Y");															frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "N");					frn.setAtt("Aceptar", "visible", "Y");												frn.setAtt("BuscarFol", "visible", "Y");					frn.setAtt("Buscar", "available", "N");										frn.setAtt("k_clave_pago", "available", "N"); // Added by JMM, 20240229 									} else {					if(tip_ope &= "C"){ //Consulta						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("k_fecha", "available", "N");						frn.setAtt("k_hora", "available", "N");											frn.setAtt("k_mov", "available", "N", "k_tipo_orden");						frn.setAtt("k_mov", "available", "N", "k_num_orden");						frn.setAtt("k_mov", "available", "N", "k_punto");						frn.setAtt("k_mov", "available", "N", "k_descriptot");						frn.setAtt("k_mov", "available", "N", "k_costo");						frn.setAtt("k_mov", "available", "N", "k_precio");						frn.setAtt("k_coment","modify", "N");						frn.setAtt("k_coment","available", "Y");						frn.setAtt("Imprimir", "visible", "Y");						frn.setAtt("Cancelar", "visible", "N");						frn.setAtt("Aceptar", "visible", "N");						frn.setAtt("BuscarFol", "visible", "Y");						frn.setAtt("Buscar", "available", "N");												frn.setAtt("k_clave_pago", "available", "N"); // Added by JMM, 20240229 											} else {						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");						frn.setAtt("k_fecha", "available", "Y");						frn.setAtt("k_hora", "available", "Y");													frn.setAtt("k_mov", "modify", "Y", "k_descriptot");						frn.setAtt("k_mov", "modify", "Y", "k_costo");												frn.setAtt("k_clave_pago", "available", "N"); // Added by JMM, 20240229 					}					}			}		}					fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    			1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 			2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 			3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			// var tip_ope; 			var tip_oper;			if(iModo==0)				page=pag; 			else if(iModo==2&&(strlen(par0)>0)){				//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       				if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 				if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;			}			else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     		}								fun LimpiaDatosProv() {			frn.set("k_rfc", ""); // Commented 20240111 , Descommented 20240131			frn.set("k_nombreprov", "");			frn.set("k_calleprov", "");			frn.set("k_coloniaprov", "");			frn.set("k_poblacionprov", "");			frn.set("k_cpprov", "");			LimpiaDatosDoc();			LimpiaTotalesDoc();			// Commented 20240111 ... Estos datos se gestionan al cargar UUID 			/*					frn.set("k_refer", "");			frn.set("k_fecha_exp", "");			*/		}					fun LimpiaDatosDoc() {			frn.set("k_mov", "");			frn.set("k_plazo", "");			frn.set("k_vence", "");			frn.set("k_cond", "");			frn.set("k_coment", "");		}					fun LimpiaTotalesDoc() {			frn.set("k_subtotal", "");			frn.set("k_iva", "");			frn.set("k_porciva", ""); // Added by JMM 20240229			frn.set("k_monto", "");			frn.set("k_sumrets",""); // Added by JMM 20240626 		}					fun LimpiaEncabezado() {			frn.set("k_folio", "");			frn.set("k_docto", "");			frn.set("k_fecha", "");			frn.set("k_hora", "");			LimpiaDatosProv();			frn.set("k_clave", "");			//Added by JMM, 20240229			frn.set("k_clave_pago", "");			frn.set("k_nombreprov_pago", "");		}				fun LimpiaTipOrden(){			frn.setX("","k_mov",-1,"k_desc_tipo");				frn.setX("","k_mov",-1,"k_num_orden");				LimpiaNumOrden();		}					fun LimpiaNumOrden(){			frn.setX("","k_mov",-1,"k_punto");			LimpiaPunto();		}		fun LimpiaPunto(){			frn.setX("","k_mov",-1,"k_desc_punto");			frn.setX("","k_mov",-1,"k_descriptot");			frn.setX("","k_mov",-1,"k_costo");			frn.setX("","k_mov",-1,"k_precio");		}		fun CambiaSucursal() {				// Added by JMM 20240229 ... Check Security PARAM for User to use PROV PAGO			sucursal_id = frn.get("k_sucn",-1,1);			paramProvPago = ProvPago_Sec(usuario);						LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();								limpiar_datos_uuid();	// Added by JMM 20240119		}					fun CambiaTipo() {			LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();						}		//------------------------Implementing UUID, by JMM 20240111----------------------------				fun BuscarProveedor(/*imodo*/){			var xmlProd;						// Added 20240119			var NewProv, ST_FUN, continua, resultado, mensaje, xmlAlta;			// Added by JMM 20240229 			var vProvPago;							sucursal_id = frn.get("k_sucn",-1,1);						// UPD 20240111			//proveedor_id = frn.get("k_clave");			proveedor_id = frn.get("k_rfc");						LimpiaDatosProv();			// 20240111 ... Los Ejecuta en : LimpiaDatosProv()			/*			LimpiaDatosDoc();			LimpiaTotalesDoc();			*/			//Added 20240131			frn.set("k_rfc", proveedor_id);						if (strlen(frn.get("k_rfc"/*"k_clave"*/)) == 0) {				return;			}						// Commented 20240111 			/*			if (strlen(frn.get("k_refer")) > 0) {				refer_id = frn.get("k_refer");			} else {				frn.set("k_fecha_exp", "");			}			*/							cmdQuery = "select c2 as k_clave, /*c10 as k_rfc,*/ c3 as k_nombreprov, c4 as k_calleprov, c5 as k_coloniaprov, c6 as k_poblacionprov, c27 as k_cpprov, c16 as k_plazo " &									"from keplersc.kdxd where keplersc.full_replace(c10,'-','') /*c2*/='" & proveedor_id & "'" ;			//and c1 ='" & sucursal_id & "' ... TO DO : NO VIENE DATO DE LA SUCURSAL A NIVEL DEL PROVEEDOR AUNQUE ESTA EL CAMPO ...			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.BuscaProveedor()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){							// Addapted 20240111				//frn.setPos("k_clave");				frn.set("k_clave","No Existe ...");  							if (/*imodo == 1*/ strlen(NewProvId) > 0 ) { 									frn.message("El proveedor no existe","Error","Aceptar");					return;									} else {									frn.message("El Proveedor No existe ..." & "|" & " " & 					"|" & " " & "Nombre : " & nombre_uuid &					"|" & " " & "R.F.C. : " & rfc_uuid & 					"|" & " " & "Fecha Docto. Seleccionado : " & fecha_uuid & 					"|" & " " & "Total Docto. Seleccionado : " & total_uuid & 					"|" & " " & "|" & " " & 					"Puede crearse Automaticamente, se recomienda complementar los Datos.", "Info !!!","Aceptar");					continua = frn.message("¿Continuar con el Alta del Proveedor?","Atencion !!!",2);					if (continua == 0){										return;										}	else {										setXml(xmlAlta,"sucursal",sucursal_id);						setXml(xmlAlta,"nombre",nombre_uuid);						setXml(xmlAlta,"rfc",rfc_uuid);											frn.lib("libGeneral.kpl","FileSave",xmlAlta,fileSavePath & "\XmlAltaProv_To_Send");											cmdQuery="SELECT * FROM keplersc.uuid_tools_alta_proveedor('<document>" & getXmlStr(xmlAlta,"EOF:13_10") & "</document>')";						rstXml(cuboQuery);											cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvtalltotscrud.Alta_Proveedor");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlAltaProv_Result");											resultado = getXml(cuboQuery,"resultado");						mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok) {							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;							}						if(resultado &= "1") {							NewProv = mensaje;							//frn.dialog("cat_crud_proveedores","Modificar"/*accion*/, NewProv/*param1*/,"UUID" /*param2*/);							//prov_data_upd(NewProv);							return NewProv/*1*/;						} else {							// Added 20240130 (else section)							frn.set("k_clave","");							frn.message(mensaje,"Error","Aceptar");							return;						}										} // End ... If ( continua )								} // End ... If ( imodo )							}						//Plazo();				rstXml(xmlProd);			frn.lib("libGeneral.kpl","FileSave",cuboQuery/*xmlAlta*/,fileSavePath & "\XmlAltaProv_To_Get");			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");			frn.setX(xmlProd);						// Added by JMM 20240229 			vProvPago = trim(frn.get("k_clave_pago"));			if ( strlen(trim(frn.get("k_clave"))) > 0 ) {				if ( strlen( vProvPago ) == 0 ) {					frn.set("k_clave_pago", frn.get("k_clave"));					BuscarProvPago();				} else {					if ( CheckProvPago() == 0 ) {						frn.set("k_clave_pago", frn.get("k_clave"));						BuscarProvPago();						}				}			}						Plazo(); // Moved 20240131				}						// New Func 20240120 by JMM		fun prov_data_upd(Prov){			frn.dialog("cat_crud_proveedores","Modificar"/*accion*/, Prov/*IdProv*/,"UUID" /*param2 UUIDCtrl*/,"BuscarProveedor()"/*paramRutina*/);		}								// New Func 20240111 by JMM			fun limpiar_datos_uuid() {			frn.set("k_clave","");			frn.set("k_rfc","");			frn.set("k_refer","");						frn.set("k_uuid_serie","");			frn.set("k_uuid_folio","");			frn.set("k_uuid_monto","");			frn.set("k_uuid_fecha","");						// Added 20240120			NewProvId = "";			LimpiaDatosProv();						//Added 20240229			frn.set("k_uuid_impuesto","");						//Added 20240626			frn.set("k_uuid_retisr","");				frn.set("k_uuid_retiva","");						//Added 20240328 			str_uuid = "";				rfc_uuid = "";				fecha_uuid = ""; 			total_uuid = "";								nombre_uuid = "";			regimen_uuid = "";			folio_uuid = "";			serie_uuid = "";			impuesto_uuid = "";						//Added by JMM 20240626			retisr_uuid = "";			retiva_uuid = "";						//Added 20240229			if ( paramProvPago /*&= "P"*/ > 0 ) {				if ( tip_ope &= "A" ) {						frn.setAtt("k_clave_pago", "available", "Y");				} else {					frn.setAtt("k_clave_pago", "available", "N");				}				if ( CheckProvPago() == 0 ) {					frn.set("k_clave_pago","");					frn.set("k_nombreprov_pago","");				}			} else {				frn.setAtt("k_clave_pago", "available", "N");				frn.set("k_clave_pago","");				frn.set("k_nombreprov_pago","");			}		}								// New Func 20240115 by JMM		fun BuscarUUID(referencia){			var xmlProd, respfunc;											sucursal_id = frn.get("k_sucn",-1,1);			respfunc = 1;														if (strlen(str_uuid) == 0) {				frn.message("No se tiene una Referencia [UUID] para validarse ...","Error","Aceptar");				return;			}						/*			cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &				"and c2 = '" & gen_doc & "' and c3 = '" & nat_doc & "' and c4 = " & gpo_doc & " and c5 = " & tip_doc & " and c11 = '" & referencia & "'";			*/						// Query updated at { C x P } validation, 20240201 			cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &				"and c2 = 'X' and c3 = 'A' and c11 = '" & referencia & "' and c43 <> 'C'";	 						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.BuscaFactura()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			/*			if ( nXml(cuboQuery) == 0 ) {				respfunc = 0;			}			*/			respfunc = nXml(cuboQuery);						return respfunc;									} // End Fun - BuscarUUID				// New Func 20240112 by JMM		fun Validar_Fecha_UUID() {			var fech_hoy, fech_ini, fech_limit, strFecha, strTmp, fech_lim_ini, fech_lim_fin, fech_buff;			var aj_dias, respfunc, gapDias,superUsuario,mensajeAdv,mensajeProceso;					respfunc = 0;			//VCSS 03/07/2024 Obtener usuario con nivel para poder hacer operaciones sin validaciones			cmdQuery="SELECT count(*) as superusuario from keplersc.param_opc_usr_sec where sucursal = '" & sucursal_id & "' and opcion = 'Operaciones Sin Validacion GAP' and usuario='" & usuario & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlSuperUsuario");								ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return respfunc;			}			superUsuario = getXmlAtt(cuboQuery,"r0","superusuario");			// { GAP Dias Fecha Gastos }			cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Dias Fecha Gastos'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPDias");								ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return respfunc;			}			if (nXml(cuboQuery) > 0) {				gapDias = getXmlAtt(cuboQuery,"r0","paramvalor");			} else {				frn.message("Hubo problemas para obtener los Parametros [GAP Dias Fecha Gastos] ...","Error","Aceptar");				return respfunc;			}							fech_hoy = sys.date();				strFecha = fnDate("year", fech_hoy) & "/" /*"-"*/;			strTmp = fnDate("month", fech_hoy);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "/" /*"-"*/ & "01";								fech_ini = strFecha;								//fech_hoy = "2024/12/05";  // For testing calc fech 			strTmp = fnDate("month", fech_hoy);			if ( strTmp == 12 ) {				strFecha = fnDate("year", fech_hoy) & "/12/31";								fech_limit = strFecha;							} else {				strFecha = fnDate("year", fech_hoy) & "/";				strTmp = fnDate("month", fech_hoy) + 1;				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "/" & "01";								fech_limit = fnDate("add",strFecha,-1);							} 						//fech_limit = fnDate("add",fech_limit,gapDias);  // Not Apply 			fech_limit = formato_fecha(fech_limit);									if ( gapDias > 0 ) { 				aj_dias = (gapDias /*+ 1*/) * (-1); 			} else {				aj_dias = gapDias /*- 1*/;			}			if ( gapDias == 0 ) {				fech_buff = fech_hoy;			} else {				fech_buff = fnDate("add", fech_hoy, aj_dias);			}			strTmp = fnDate("month", fech_buff);			if ( strTmp == 12 ) {				strFecha = fnDate("year", fech_buff) & "/12/31";								fech_lim_fin = strFecha;							} else {				strFecha = fnDate("year", fech_buff) & "/";				strTmp = fnDate("month", fech_buff) + 1;				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "/" & "01";								fech_lim_fin = fnDate("add",strFecha,-1);							} 								fech_lim_fin = formato_fecha(fech_lim_fin);										strFecha = fnDate("year", fech_lim_fin) & "/";			strTmp = fnDate("month", fech_lim_fin);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "/" /*"-"*/ & "01";						fech_lim_ini = strFecha;			fech_lim_ini = formato_fecha(fech_lim_ini);									if ( strlen( frn.get("k_uuid_fecha") ) == 0 ) {				frn.message("No hay Fecha UUID de Referencia para validar ...","Error","Aceptar");				return respfunc;			} 						strFecha = frn.get("k_uuid_fecha");			strFecha = formato_fecha(strFecha);						//VCSS	INI Validaciones para usuarios normales (no superUsuario)			if (superUsuario != "1"){				if ( fnDate("cmp", strFecha, fech_hoy) > 0 /*strFecha > fech_hoy*/ ) {					mensajeError="La Fecha del UUID, es mayor al dia de hoy ..." & "|" & " " & "|" & " " & strFecha;					mensajeAdv=mensajeAdv & "; " & mensajeError;					frn.message(mensajeError ,"Error","Aceptar");					return respfunc;				} 							if ( fnDate("cmp", strFecha, fech_limit) > 0 /*strFecha > fech_limit*/ ) {					mensajeError = "La Fecha del UUID, fuera de Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;					mensajeAdv=mensajeAdv & "; " & mensajeError;					frn.message(mensajeError ,"Error","Aceptar");					return respfunc;				} 							if ( fnDate("cmp", strFecha, fech_ini) < 0 /*strFecha < fech_ini*/ ) {					if ( fnDate("cmp", strFecha, fech_lim_ini) < 0 /*strFecha < fech_lim_ini*/ ) {						mensajeError = "La Fecha del UUID, es menor al Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;						mensajeAdv=mensajeAdv & "; " & mensajeError;						frn.message(mensajeError ,"Error","Aceptar");						return respfunc;					} else {						if ( fnDate("cmp", strFecha, fech_lim_fin) > 0 /*strFecha > fech_lim_fin*/ ) {						mensajeError = "La Fecha del UUID, fuera del Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;						mensajeAdv=mensajeAdv & "; " & mensajeError;						frn.message(mensajeError ,"Error","Aceptar");						return respfunc;						}					}				}			} 			//VCSS 17/06/2024 INI Evaluacion de fecha de transaccion, las transacciones que se realizan dentro de los primeros 			//dias del mes dentro del gap y la fecha del xml es del mes anterior o anteriores, 			//se registran el día último del mes del xml			var fechaMovto,fechaXml,fechaRefer,mesesDif; 			fechaXml= frn.get("k_uuid_fecha");			fechaXml= formato_fecha(fechaXml);										var diaMovto=fnDate("day", fech_hoy);			var mesMovto=fnDate("month",fechaXml);			//Calcular dierencia en meses del mes actual y del xml				strTmp=fnDate("month",fechaXml);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}										fechaXml=fnDate("year",fechaXml) & "/" & strTmp & "/" & "01";						strTmp=fnDate("month",fech_hoy);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}							fech_hoy=fnDate("year",fech_hoy) & "/" & strTmp & "/" & "01";			//Validar si xml es del mismo mes			if (fnDate("cmp",fechaXml,fech_hoy) == 0){ //Mismo mes				mesesDif=0;			}else{				fech_hoy=fnDate("add",fech_hoy,-1);				fech_hoy= formato_fecha(fech_hoy);				strTmp=fnDate("month",fech_hoy);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}								fech_hoy=fnDate("year",fech_hoy) & "/" & strTmp & "/" & "01";												if (fnDate("cmp",fechaXml,fech_hoy) == 0){					mesesDif=1;				}else{					mesesDif=2;				}			}							fechaMovto= frn.get("k_uuid_fecha");			if(mesesDif==2 && superUsuario==0){				mensajeError = "La Fecha del UUID, " & fechaMovto & " está fuera del Periodo Vigente.";				frn.message(mensajeError ,"Error","Aceptar");				return respfunc;			}			if (mesesDif != 0){				fechaMovto= frn.get("k_uuid_fecha");				strTmp=fnDate("month",fechaMovto);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}											fechaMovto=fnDate("year",fechaMovto) & "/" & strTmp & "/" & "31";				fechaMovto=formato_fecha(fechaMovto);				frn.set("k_fecha",fechaMovto);				frn.message("Los movimientos de meses anteriores se registrarán al último día del mismo mes.","Mensaje","Aceptar");			}			//VCSS 17/06/2024 FIN Evaluacion de fecha de transaccion...			respfunc = 1;			return respfunc;				} // End Fun - Validar_Fecha_UUID		// New Func 20240112 by JMM		fun formato_fecha(fech) {			var strFech, tmpData;						strFech = fnDate("year", fech) & "/";			tmpData = fnDate("month", fech);			if(strlen(tmpData) == 1){				tmpData = "0" & tmpData;			}			strFech = strFech & tmpData & "/";			tmpData = fnDate("day", fech);			if(strlen(tmpData) == 1){				tmpData = "0" & tmpData;			}			strFech = strFech & tmpData;						return strFech;			} // end fun - formato_fecha		fun ObtenerFactura(){			var nCampos, uuid="";			//Regresara la funcion UUID cadena con UUID, rfc, fecha, total			// Added 20240119 by JMM			var NewProv;						limpiar_datos_uuid();						uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID","k_refer", 0,"0");			// Replaced with new function, 20240111 			//uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID_Extended","k_refer", 0,"0");						nCampos = strSplit(uuid,"|",-1);			if (nCampos > 1) {					str_uuid = strSplit(uuid,"|",0);		  //UUID					rfc_uuid = strSplit(uuid,"|",1);		  //rfc					fecha_uuid = strSplit(uuid,"|",2);	  //fecha					total_uuid = strSplit(uuid,"|",3);	  //monto de la factura										// Added 20240111 by JMM					nombre_uuid = strSplit(uuid,"|",5);	  //nombre					regimen_uuid = strSplit(uuid,"|",6);  //regimen					folio_uuid = strSplit(uuid,"|",7);	  //folio					serie_uuid = strSplit(uuid,"|",8);	  //serie										// Added 20240224 by JMM					impuesto_uuid = strSplit(uuid,"|",9); //impuesto										//Added by JMM 20240626					retisr_uuid = strSplit(uuid,"|",10); //retencion isr					retiva_uuid = strSplit(uuid,"|",11); //retencion iva									// Conditions Added 20240111  by JMM					if ( strlen(/*folio_uuid*/nombre_uuid) == 0 || strlen(rfc_uuid) == 0 || strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {											//frn.set("k_refer","");						frn.message("No se pudieron obtener todos los datos mandatorios del UUID.","Error","Aceptar");											} else {											frn.set("k_refer",str_uuid);						frn.set("k_rfc",rfc_uuid);												if ( BuscarUUID(str_uuid) > 0 ) {							//frn.set("k_rfc","");							frn.set("k_clave","");							frn.message("Este Documento [UUID] ya ha sido Asociado previamente ...","Error","Aceptar");							return;						} 													frn.set("k_uuid_fecha",mid(fecha_uuid,0,10));						if ( Validar_Fecha_UUID() == 0 ) { 							//frn.set("k_rfc","");							frn.set("k_clave","");							return;						}												NewProv = "";						NewProv = BuscarProveedor();						if (strlen(NewProv) > 0/*== 1*/) {							//BuscarProveedor(NewProv);							NewProvId = NewProv;							frn.set("k_clave",NewProvId);						} else {							NewProvId = "";						}												if ( strlen(frn.get("k_clave")) > 0 && frn.get("k_clave") &! strFormat("ucase","No Existe ...") ) {														// Validations Moved UP by JMM 20240119 ( BuscarUUID, Validar_Fecha_UUID )																			frn.set("k_uuid_serie",serie_uuid);							frn.set("k_uuid_folio",folio_uuid);							frn.set("k_uuid_monto",total_uuid);							frn.set("k_uuid_fecha",mid(fecha_uuid,0,10));														// Added 20240229 by JMM							frn.set("k_uuid_impuesto",impuesto_uuid);														//Added 20240229 by JMM							frn.set("k_iva",impuesto_uuid);														// Added 20240626 by JMM							frn.set("k_uuid_retisr",retisr_uuid);							frn.set("k_uuid_retiva",retiva_uuid);														// Added 20240626 by JMM							var sumrets = retisr_uuid + retiva_uuid;							frn.set("k_sumrets",sumrets);														}					}			} else{				//frn.set("k_refer","");				frn.message("Faltan datos del UUID ...","Error","Aceptar");					}		}	// End Fun - Obtener Factura		//New Fuc 20240120 by JMM		fun ProcesarFactura() {					ObtenerFactura();						if ( strlen(NewProvId) > 0 ) {				prov_data_upd(NewProvId);			}						// Se elimina esta parte porque l ejecuta antes de abrir el dialogo ...			// /*			if ( strlen(NewProvId) > 0 ) {				BuscarProveedor();			}			// */					} // End Fun - ProcesarFactura 						//Function Added by JMM, 202040229  		fun Get_Cat(imodo) {            				var suc_id, dato_id;				var win_tit, field_key, field_col, cmdQuery;								sucursal_id = frn.get("k_sucn",-1,1);	            				if ( imodo <= 0 || imodo > /*2*/ 1 /*7*/ ) {					// No es opcion de CAT Valida ...					return;				}								win_tit = "";				field_key = "";				field_col = "";				cmdQuery = "";				/*				if (imodo == 1) {					win_tit = "CAT Vehiculos";					field_key = "clave";					field_col = "modelo";					cmdQuery = "select C1 as clave, C2 as descripción from keplersc.kdiv";				}				*/								/*				if (imodo == 2) {					win_tit = "CAT Inventarios";					field_key = "clave";					field_col = "invent";										dato_id = "";					cmdQuery = "select C8 as campo from keplersc.kdiv where c1 = '" & frn.get("k_mov",-1,"modelo") & "'";					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comaltasigcrud.Get_Cat_kdiv_c8()");					//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\Get_Cat_Get_Cat_kdiv_c8()");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					dato_id = getXmlAtt(cuboQuery,"r0", "campo");					cmdQuery = "select d.C1 as clave, d.C2 as descripción from keplersc.kddinv d where d.c7 = '" & dato_id & "'";				}				*/				       				if (imodo == 1) {									//Added by JMM 20240516					if ( strlen( frn.get("k_clave") ) == 0 || strlen( frn.get("k_rfc") ) == 0 ) {						frn.message("Para Modificar el Proveedor de Pago primero se debe tener un Proveedor de Documento valido ...", "Error","Aceptar");						return;					}									win_tit = "CAT Proveedores de Pago";					field_key = "clave";					field_col = "k_clave_pago";					cmdQuery = "select C2 as clave, C3 as nombre from keplersc.kdxd where pagador = 1 or c2 = '" & frn.get("k_clave") & "' order by C3";				}			         	         				if (imodo == 2) {					win_tit = "CAT Proveedores";					field_key = "clave";					field_col = "k_clave";					cmdQuery = "select C2 as clave, C3 as nombre from keplersc.kdxd order by C3";				}					            if ( strlen(win_tit) > 0 && strlen(field_key) > 0 && strlen(field_col) > 0 && strlen(cmdQuery) > 0 /*&& strlen(objeto) > 0*/ ) {                                        					//frn.dialog("genlistasel", win_tit,cmdQuery, field_key, "k_mov",-1, field_col,"S");  * * *  USADO EN GRIDS					//frn.dialog("genlistasel","Catálogo de Proveedores",cmdQuery,"k_claveprov","k_clave","0","","N");  * * *  USADO EN CTRLS SIMPLES										frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");				}						} /*END Func Get_Cat()*/		//Function Added by JMM, 202040229 		fun BuscarProvPago(){			var xmlProd;											sucursal_id = frn.get("k_sucn",-1,1);			proveedor_pago_id = frn.get("k_clave_pago");			proveedor_pago_id = trim(proveedor_pago_id);					if (strlen(/*frn.get("k_clave_pago")*/ proveedor_pago_id ) == 0) {				frn.set("k_nombreprov_pago","");				return;			}							cmdQuery = "select c3 as k_nombreprov_pagos " &									"from keplersc.kdxd where  c2 = '" & proveedor_pago_id & "' ";								cmdQuery = cmdQuery & "and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')";								rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscarProvPago()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				frn.set("k_nombreprov_pago","ERROR EN BUSQUEDA ...");				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.set("k_nombreprov_pago","NO EXISTE ...");				frn.setPos("k_clave_pago");				frn.message("El Proveedor de Pago No existe ...","Error","Aceptar");				return;				} 						frn.set("k_nombreprov_pago", getXmlAtt(cuboQuery,"r0", "k_nombreprov_pagos") );					} // End : Fun BuscarProvPago()				/*		// Added by JMM, 20240229		fun Plazo(){ //Calcula la fecha de pago, y las condiciones de pago en base al plazo			frn.set("k_vence",fnDate("addC",frn.get("k_fecha"),frn.get("k_plazo")));//Suma días comerciales			var cond=frn.get("k_plazo") & " dias fecha factura";			if (frn.get("k_plazo")==0) cond="Pago de contado";				frn.set("k_cond",cond);  		}		*/				/*		// Added by JMM, 20240229		fun Change_Mode() {			limpiar_datos_uuid();			if ( frn.get("chk_pc") == 1 ) { 				//frn.message("Check Encendido ...","Info !!!","Aceptar");				frn.setAtt("Buscar", "available", "N");				frn.setAtt("Buscar", "visible", "N");				frn.setAtt("k_refer", "available", "Y");				frn.setAtt("k_clave", "available", "Y");			} else {				//frn.message("Check Apagado ...","Info !!!","Aceptar");				frn.setAtt("Buscar", "available", "Y");				frn.setAtt("Buscar", "visible", "Y");				frn.setAtt("k_refer", "available", "N");				frn.setAtt("k_clave", "available", "N");			}			return;			}		*/				// New Func 20240229 by JMM		fun ProvPago_Sec(referencia){			var respfunc;											sucursal_id = frn.get("k_sucn",-1,1);			respfunc = 0; //Default es sin Permiso 						frn.setAtt("k_clave_pago", "available", "N");														if (strlen(referencia) == 0) {				return;			}						cmdQuery = "select * from keplersc.param_opc_usr_sec where sucursal = '" & sucursal_id & "' " & 				"and upper(opcion) = upper('Proveedor Pago') and upper(usuario) = upper('" & referencia & "')";						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ProvPagoSec()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			/*			if ( nXml(cuboQuery) == 0 ) {				respfunc = 0;			}			*/			respfunc = nXml(cuboQuery);						if ( respfunc /*paramProvPago &= "P"*/ > 0 ) {								if ( tip_ope &= "A" ) {						frn.setAtt("k_clave_pago", "available", "Y");				} else {					frn.setAtt("k_clave_pago", "available", "N");				}			} else {				frn.setAtt("k_clave_pago", "available", "N");			}						return respfunc;									} // End Fun - ProvPago_Sec 						//Function Added by JMM, 202040229  		fun CheckProvPago(){			var respfunc;											sucursal_id = frn.get("k_sucn",-1,1);			proveedor_pago_id = frn.get("k_clave_pago");			proveedor_pago_id = trim(proveedor_pago_id);						respfunc = 0; 					if (strlen(/*frn.get("k_clave_pago")*/ proveedor_pago_id ) == 0) {				frn.set("k_nombreprov_pago","");				return;			}							cmdQuery = "select c3 as k_nombreprov_pagos " &									"from keplersc.kdxd where c2 = '" & proveedor_pago_id & "' ";								cmdQuery = cmdQuery & "and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')";								rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscarProvPago()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				frn.set("k_nombreprov_pago","ERROR EN BUSQUEDA ...");				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.set("k_nombreprov_pago","NO EXISTE ...");				// Commented by JMM 20240227				//frn.setPos("k_clave_pago");				//frn.message("El Proveedor de Pago No existe ...","Error","Aceptar");				return;				} 						respfunc = 1;						// Commented by JMM 20240227			//frn.set("k_nombreprov_pago", getXmlAtt(cuboQuery,"r0", "k_nombreprov_pagos") );						return respfunc;					} // End : Fun CheckProvPago()						//------------------------End Implementing UUID, by JMM JMM 20240111-------------------------		fun ObtenerTipoOrden() {						proveedor_id = frn.get("k_clave");			sucursal_id = frn.get("k_sucn",-1,1);				LimpiaTipOrden();			CalculaTotales();			cmdQuery = "select C1 as tipo, C3 as descripcion from keplersc.kdmargen";													frn.dialog("genlistasel","Tipos de órden",cmdQuery,"tipo","k_mov",-1,"k_tipo_orden","S");        }		fun BuscarTipoOrden(){			var xmlProd;			tiporden=frn.get("k_mov", -1,"k_tipo_orden");			cmdQuery = "select C3 as descripcion from keplersc.kdmargen " &					"where c1='" & tiporden & "'";									rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcargosvarios.BuscarTipoOrden()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cubo");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if((nXml(cuboQuery) == 0) && (tiporden &! "")) {				frn.setPos("k_mov", -1,"k_tipo_orden");				frn.message("El tipo de orden no existe","Error","Aceptar");				return;			} else{				desc_tipo = getXmlAtt(cuboQuery,"r0","descripcion");				frn.setX(desc_tipo,"k_mov", -1,"k_desc_tipo");					}					}		fun ObtenerNumOrden() {			proveedor_id = frn.get("k_clave");			sucursal_id = frn.get("k_sucn",-1,1);			tiporden = frn.get("k_mov",-1,"k_tipo_orden"); 			if (tiporden &= ""){				frn.message("Debe seleccionar tipo de órden","Error","Aceptar");				return;			}				LimpiaNumOrden();			CalculaTotales();			cmdQuery = "select C3 as orden, C4 as fecha, C6 as serie,C11 as cliente " &						"from keplersc.kdord " & 						"where c1 = '" & sucursal_id & "' and c2= '" & tiporden & "' and c7=0";			frn.dialog("genlistasel","Ordenes",cmdQuery,"orden","k_mov",-1,"k_num_orden","S");					}         		fun ObtenerPunto() {			proveedor_id = frn.get("k_clave");			sucursal_id = frn.get("k_sucn",-1,1);			tiporden = frn.get("k_mov",-1,"k_tipo_orden"); 			numorden = frn.get("k_mov",-1,"k_num_orden"); 			if (tiporden &= ""){				frn.setPos("k_mov",-1,"k_tipo_orden");				frn.message("Debe seleccionar tipo de órden","Error","Aceptar");				return;			}			if (numorden &= ""){				frn.setPos("k_mov",-1,"k_num_orden");				frn.message("Debe seleccionar número de órden","Error","Aceptar");				return;			}				LimpiaPunto();			CalculaTotales();			cmdQuery = "select c4 as punto, c9 as operario, c8 Descripcion " & 						"from keplersc.kdpun " &						"where c1= '" & sucursal_id & "' and c2= '" & tiporden & "' and c3 = '" & numorden & "'";			frn.dialog("genlistasel","Puntos de órden",cmdQuery,"punto","k_mov",-1,"k_punto","S");						}		fun ObtenerFolio() {			sucursal_id = frn.get("k_sucn",-1,1);			LimpiaEncabezado();			cmdQuery = "select c6 as folio, substring(cast(c9 as VARCHAR),1,10) as fecha, c10 as cve_cliente, " &						"c11 as factura, c16 as monto, c43 as estatus " &						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc" &						" order by c9 desc, c6 desc";							frn.dialog("genlistasel","Folios de TOTs",cmdQuery,"folio","k_folio","0","","S");					}		fun ValidaFolioCancelado(folio){		var statusfolio;			cmdQuery = "select c43 as status_folio " & 						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc & " and c6= '" & folio & "'";						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidaFolioCancelado()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ValidaFolioCancelado");			ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return "Error obteniendo Estatus"; //Return Adapted by JMM 20240710			}			statusfolio = getXmlAtt(cuboQuery,"r0","status_folio");			if (statusfolio &= "C"){	// C=Cerrado				resVal=0;				//frn.message("El TOTs se encuentra cancelado","Error","Aceptar"); //Commented by JMM 20240710				return "TOTs Cancelado";  //Return Adapted by JMM 20240710			} else { return ""; } //Else Added by JMM 2020710		}		fun CambiaFolio() {			frn.set("k_docto", "");			frn.set("k_fecha", "");			frn.set("k_hora", "");			// Commented by JMM 20240131			/*			LimpiaDatosProv();			frn.set("k_clave", "");			*/			// Added by JMM 20240131			limpiar_datos_uuid();			//frn.set("k_refer", ""); // Added & Commented 20240131 by JMM			//Added by JMM, 20240301			frn.set("k_clave_pago", "");			frn.set("k_nombreprov_pago", "");		}				fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				CambiaFolio();				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvtalltotscrud.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);			}		fun ValidaPuntoOrden(){			var tipopunto, status, cerradotots, desc_punto, punto_existe, totReg; 			punto = frn.get("k_mov",-1,"k_punto"); 			cmdQuery = "select c6 as tipunto, c7 as statuspunto, c8 as descpunto, c23 as statustots " & 						"from keplersc.kdpun " &						"where c1= '" & sucursal_id & "' and c2= '" & tiporden & "' and c3 = '" & numorden & 						"' and c4 = " & punto;						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidaPuntoOrden()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\validapuntoorden");			ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			desc_punto	= getXmlAtt(cuboQuery,"r0","descpunto");			frn.setX(desc_punto,"k_mov",-1,"k_desc_punto");			tipopunto = getXmlAtt(cuboQuery,"r0","tipunto");			status = getXmlAtt(cuboQuery,"r0","statuspunto");			cerradotots = getXmlAtt(cuboQuery,"r0","statustots");						//Validar que el TOT no este dado de alta con KDTOT			ValidaExisteTot();						//Validar que no ingresen el mismo punto			ValidaPuntoDuplicado();			if (cerradotots &= "C"){	// C=Cerrado				frn.setX("","k_mov",-1,"k_punto");				LimpiaPunto(); 				frn.message("No se pueden cargar horas a un punto que esta cerrado por TOTs","Error","Aceptar");				return;			}			if (tipopunto &= "N"){ //N=No autorizados				frn.setX("","k_mov",-1,"k_punto");				LimpiaPunto();				frn.message("No puede cargar TOTs a puntos No Autorizados","Error","Aceptar");				return;			} else { 				if(tipopunto &= "P"){	//P=Por presupuestar					frn.setX("","k_mov",-1,"k_punto");					LimpiaPunto();					frn.message("No puede cargar TOTs a puntos Por Presupuestar","Error","Aceptar");					return;				} else { 					if(tipopunto &= "L"){	//L=Sin cargo al cliente						frn.setX("","k_mov",-1,"k_punto");						LimpiaPunto();						frn.message("No puede cargar TOTs a puntos Sin Cargo al Cliente","Error","Aceptar");						return;					} else{						if(tipopunto &= "S"){	//S=Paquetes de serivicios							frn.setX("","k_mov",-1,"k_punto");							LimpiaPunto();							frn.message("No puede cargar TOTs a Paquetes de Servicios","Error","Aceptar");							return;						}						}				}					}			if(status &= "P"){	//P=Pendiente				frn.setX("","k_mov",-1,"k_punto");				LimpiaPunto();				frn.message("No puede cargar TOTs a puntos pendientes","Error","Aceptar");				return;			} else{				if(status &= "S"){	//S=Suspendido					frn.setX("","k_mov",-1,"k_punto");					LimpiaPunto();					frn.message("No puede cargar TOTs a puntos suspendidos","Error","Aceptar");					return;				}			}						}		fun ValidaExisteTot(){			var punto_existe;			cmdQuery = "select count(*) as totexiste " & 						"from keplersc.kdtot " &						"where c1= '" & sucursal_id & "' and c2= '" & tiporden & "' and c3 = '" & numorden & 						"' and c4 = " & punto & " and c5= '" & gen_doc & "' and c6= '" & nat_doc & "' and c7= " & gpo_doc & " and c8= " & tip_doc; 							rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidaPuntoOrden()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\validapuntoexiste");			ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			punto_existe = getXmlAtt(cuboQuery,"r0","totexiste");			if (punto_existe > 0){				frn.setX("","k_mov",-1,"k_tipo_orden");				LimpiaTipOrden();				frn.message("No puede dar de alta un TOT que ya esta registrado||Tipo orden: "&tiporden&" Orden: "&numorden&" Punto :"&punto,"Error","Aceptar");				return;			}		}				fun ValidaDescripcion(){			punto = frn.get("k_mov",-1,"k_punto"); 			if (punto &= ""){				frn.setPos("k_mov",-1,"k_punto");				frn.message("Debe seleccionar un punto","Error","Aceptar");				return;			}							if (frn.get("k_mov",-1,"k_descriptot") &= ""){				frn.setPos("k_mov",-1,"k_descriptot");				frn.message("La descripción del TOT no puede ir en blanco","Error","Aceptar");				return;				}			}         		fun ValidaBajaTot(){			var cerradotots, renglones; 			renglones = frn.N("k_mov")-1;						for (var i=0; i<renglones; i++) {				tiporden = frn.get("k_mov",i,"k_tipo_orden");				numorden = frn.get("k_mov",i,"k_num_orden");				punto = frn.get("k_mov",i,"k_punto"); 				cmdQuery = "select c23 as statustots " & 						"from keplersc.kdpun " &						"where c1= '" & sucursal_id & "' and c2= '" & tiporden & "' and c3 = '" & numorden & 						"' and c4 = '" & punto & "'";							rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidaPuntoOrden()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\validapuntoorden");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				cerradotots = getXmlAtt(cuboQuery,"r0","statustots");				if (cerradotots &= "C"){	// C=Cerrado					resVal=0;					frn.message("Imposible borrar un TOT de un Punto que ya esta cerrado, Orden: "&tiporden& " " &numorden& " Punto: " &punto,"Error","Aceptar");					return;				}			}		} 		fun MostrarDatos(nFolio) {			var folio, refer, xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle;			var tmpStr, tmpXml, contDet, xmlCurDet, xmlDetConv;			// Guarda Datos para Busqueda 			frn.set("k_fecha_exp", "");			sucursal_id = frn.get("k_sucn",-1,1);							refer = frn.get("k_refer");			proveedor_id = frn.get("k_clave");			folio = nFolio;											setXml(xmlRequest,"document","sucursal_id",sucursal_id);			setXml(xmlRequest,"document","proveedor_id",proveedor_id);			setXml(xmlRequest,"document","referencia",refer);			setXml(xmlRequest,"document","genero",gen_doc);			setXml(xmlRequest,"document","naturaleza",nat_doc);			setXml(xmlRequest,"document","grupo",gpo_doc);			setXml(xmlRequest,"document","tipo",tip_doc);			setXml(xmlRequest,"document","folio",folio);				cmdQuery = "select * from keplersc.ser_tots_alta_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";			frn.lib("libGeneral.kpl","FileSave",xmlRequest, fileSavePath & "\srvtalltotscrud_xmlRequestFromK80TOPostgreSql_buscar");							rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\srvtalltotscrud_xml_GottenOfPostgreSql_buscar");							ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}								//Datos de encabezado			tmpStr=getXmlAtt(cuboQuery,"r0","encabezado");			rstXml(xmlEncabezado);			tmpStr=delScpScn(tmpStr);			setXmlStr(xmlEncabezado,tmpStr);			tmpXml = getXml(xmlEncabezado,"row");			frn.lib("libGeneral.kpl","FileSave",tmpXml , fileSavePath & "\srvtalltotscrud_xml_Converted_Enc_buscar");							frn.setX(tmpXml);			if(nXml(tmpXml) == 0){				frn.message("El TOTs : " & folio & ", No se encontró ...","Error","Aceptar");				return;							}									//Added by JMM 20240626 			var vretisr = frn.get("k_uuid_retisr");			var vretiva = frn.get("k_uuid_retiva");			var sumrets = vretisr + vretiva;			frn.set( "k_sumrets", sumrets );			var iva = frn.get( "k_iva");			var tot = frn.get( "k_monto");			var vsubt = tot - iva + sumrets;			frn.set( "k_subtotal", vsubt );						//Added by JMM 20240710			if ( tot == 0 ) {				vsubt = 0;				sumrets = 0;				frn.set( "k_subtotal", vsubt );				frn.set( "k_sumrets", sumrets );			}						//Added by JMM 20240710 			//var porc_iva; //Commented by JMM 20240710 ... var exists as global on this KPL			if ( vsubt/*subtotal*/ > 0 ) {				porc_iva = (iva * 100) / vsubt/*subtotal*/;			} else {				porc_iva = 0;			}			frn.set("k_porciva", porc_iva);										//Datos Detalle			rstXml(xmlDetConv);			tmpStr=getXmlAtt(cuboQuery,"r0","detpartidas");			rstXml(xmlDetalle);			tmpStr=delScpScn(tmpStr);			setXmlStr(xmlDetalle,tmpStr);			contDet=nXml(xmlDetalle);			for(var y=0; y< contDet; y++){				rstXml(xmlCurDet);				xmlCurDet= getXmlX(xmlDetalle,3,y);										setXml(xmlDetConv,"k_mov","r"&y,xmlCurDet);			}				frn.setX(xmlDetConv);			if (tip_ope &= "B") {				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());				}			frn.lib("libGeneral.kpl","FileSave",xmlDetConv, fileSavePath & "\srvtalltotscrud_xml_Converted_Det_buscar");						// Added by JMM 20240301			var vProvPago = trim(frn.get("k_clave_pago"));			if ( strlen(trim(frn.get("k_clave"))) > 0 ) {				if ( strlen( vProvPago ) > 0 ) { BuscarProvPago(); }			}							return;									} //End MostrarDatos()		fun CalculaTotales() {			var subTotal = 0, iva = 0, total = 0, costo = 0, renglones;			// Added by JMM 20240626 			var retisr=0, retiva=0, sumrets=0;						costo = frn.get("k_mov",-1,"k_costo");						//Calcular totales			renglones = frn.N("k_mov");			for (var i=0; i<renglones; i++) {				subTotal = subTotal + frn.get("k_mov",i,"k_costo");			}						// Commented by JMM 20240229			//iva = subTotal * (porc_iva)/100;						// Added by JMM 20240228			iva = frn.get("k_uuid_impuesto");			if ( subTotal > 0 ) {				porc_iva = (iva * 100) / subTotal;			} else {				porc_iva = 0;			}					// Added by JMM 20240626			retisr = frn.get("k_uuid_retisr");			retiva = frn.get("k_uuid_retiva");			sumrets = retisr + retiva;							/*total = subTotal + iva;*/ // Commented by JMM 20240626						// Added by JMM 20240626			if ( subTotal == 0 ) {				total = 0;			} else {				total = subTotal + iva - sumrets; // Adapted by JMM 20240619			}							frn.set("k_subtotal",subTotal);			frn.set("k_iva",iva);						// Commented by JMM 20240229 ... Un commented to check 			frn.set("k_porciva",porc_iva);						frn.set("k_monto",total);						frn.set("k_sumrets",sumrets); // Added by JMM 20240626						} // End : Calcula Totales 							fun Plazo(){ //Calcula la fecha de pago, y las condiciones de pago en base al plazo			frn.set("k_vence",fnDate("addC",frn.get("k_fecha"),frn.get("k_plazo")));//Suma días comerciales			var cond=frn.get("k_plazo") & " dias fecha factura"/*" días fecha factura"*/;			if (frn.get("k_plazo")==0) cond="Pago de contado";				frn.set("k_cond",cond);  			}		fun IniParams(){//Inicializa parÃ¡metros de impresiÃ³n, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar PÃ¡gina				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1","param_borderT","1.5","param_borderR","1","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}						fun setRepPage() {//Establece los parï¿½metros finales de impresiï¿½n.			var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";			var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";			var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");			var lndsp="landscape=" & frn.get("param_landscape");			var emp="@emp=" & frn.get("param_emp");			rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);		}			fun EjecReporte(){//Imprime el reporte del documento especificado 				if(strlen(trim(frn.get("k_folio")))==0){ 					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");					frn.setPos("k_folio");return;				}else{					ValidaFolioCancelado(frn.get("k_folio"));					//Commented by JMM 20240710					/*					if(resVal == 0){						return;					}						*/					}				Reporte();				frn.setPos("k_folio");			}							fun Reporte(){				var compania,contProd, contDet, tmpStr;				var xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle;				var tmpXml, contDet, xmlCurDet, xmlDetConv, datdoc;				var desc_sucursal, fecha, total, importe, folio, docto;				var cmd, cuboResultados , ok;								sucursal_id = frn.get("k_sucn",-1,1);				desc_sucursal = frn.get("k_sucn",-1,0);				proveedor_id = frn.get("k_clave");				refer_id = frn.get("k_refer");				folio = frn.get("k_folio");				docto = frn.get("k_docto");				//Armar xml con los parametros				setXml(xmlRequest,"document","sucursal_id",sucursal_id);				setXml(xmlRequest,"document","proveedor_id",proveedor_id);				setXml(xmlRequest,"document","referencia",refer_id);				setXml(xmlRequest,"document","genero",gen_doc);				setXml(xmlRequest,"document","naturaleza",nat_doc);				setXml(xmlRequest,"document","grupo",gpo_doc);				setXml(xmlRequest,"document","tipo",tip_doc);				setXml(xmlRequest,"document","folio",folio);				cmdQuery="select * from keplersc.ser_tots_cons_rep('"& getXmlStr(xmlRequest,"EOF:13_10") &"')";				rstXml(cuboQuery);    //xml general con todos los datos				cuboQuery= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.Reporte()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									//Procesa xml encabezado				frn.lib("libGeneral.kpl","FileSave",cuboQuery , fileSavePath & "\xmlResQueryReporteCompleto ");					tmpStr=getXmlAtt(cuboQuery,"r0","encabezado");				rstXml(xmlEncabezado);				tmpStr=delScpScn(tmpStr);					rstXml(xmlEncabezado);				setXmlStr(xmlEncabezado,tmpStr);				tmpXml = getXml(xmlEncabezado,"row");				frn.lib("libGeneral.kpl","FileSave",tmpXml , fileSavePath & "\xmlResQueryReporte");																//Obtener datos de encabezado				kdb.kde("KDE");//Configuraci??el servidor				kdb.exec();				compania = kdb.get("KDE","1");   // Se obtiene el nombre de la compania								// Se define el formato a usar y se liga a la variable del reporte "rep"				kdb.readPage("datFto","srvtalltotscrudfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				rep.rst();				setRepPage();//Establece los par?metros finales de impresi?n(rep.page(...);), pues pueden haber cambiado por el usuario 				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				//Da valor a los inputs del reporte(rep.set();), e indica la ejecuci?n de "grupos de renglones de impresi?n" (rep.exe();)								rep.set("titulost",frn.get("statusDoc")); //Added by JMM 20240710								rep.set("fecha",sys.date());				rep.set("hora",sys.time());				rep.set("nombreempresa",compania);				rep.set("desc_sucursal",desc_sucursal);				rep.set("docto",docto);				rep.set("folio",folio);				rep.set("proveedor_id",getXml(tmpXml,"k_clave"));				rep.set("nombre",getXml(tmpXml,"k_nombreprov"));				rep.set("direccion",getXml(tmpXml,"k_calleprov"));				rep.set("colonia",getXml(tmpXml,"k_coloniaprov"));				rep.set("cp",getXml(tmpXml,"k_cpprov"));				rep.set("rfc",getXml(tmpXml,"k_rfc"));				rep.set("referencia",getXml(tmpXml,"k_refer"));				rep.set("monto_total",getXml(tmpXml,"k_monto"));				rep.exe("encabezado");/*								//Procesa poliza contable				kdb.sp("k_getDoc","datDoc",sucursal_id,gen_doc,nat_doc,gpo_doc,tip_doc,folio); 				kdb.exec();				var nRenPol=kdb.NR("datDoc","k_poliza");				var tPoliza=kdb.get("datDoc","k_poliza","tpoliza");				var nPoliza=kdb.get("datDoc","k_poliza","npoliza");			   				if (strlen(tPoliza)>0 && strlen(nPoliza)>0 ){						rep.set("tPol",tPoliza);						rep.set("nPol",nPoliza);						rep.exe("encabezadoPol");						var tAbonosPol=0, tCargosPol=0;						for(var i=0;i<nRenPol;i++){							if (kdb.get("datDoc","k_poliza","r"&i,"k_cargo")==0){								rep.set("PolClave2",kdb.get("datDoc","k_poliza","r"&i,"k_cuenta"));								rep.set("PolDescr2",kdb.get("datDoc","k_poliza","r"&i,"k_ctaDescr"));								rep.set("PolHaber",kdb.get("datDoc","k_poliza","r"&i,"k_abono"));								tAbonosPol=tAbonosPol+kdb.get("datDoc","k_poliza","r"&i,"k_abono");								rep.exe("partPolA");							}else{								rep.set("PolClave",kdb.get("datDoc","k_poliza","r"&i,"k_cuenta"));								rep.set("PolDescr",kdb.get("datDoc","k_poliza","r"&i,"k_ctaDescr"));								rep.set("PolDebe",kdb.get("datDoc","k_poliza","r"&i,"k_cargo"));								tCargosPol=tCargosPol+kdb.get("datDoc","k_poliza","r"&i,"k_cargo");								rep.exe("partPolC");							}						}						rep.set("totCargo",tCargosPol);						rep.set("totAbono",tAbonosPol);						rep.exe("PolTotales");				}*/				//Procesa poliza contable				var tablakdc1_alta = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;				var tablakdc2_alta = " keplersc.kdc2" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) & strSplit(frn.get("k_fecha"), "-", 1);				//var tablakdc1_baja = " keplersc.kdc1" & mid(strSplit(fecha_baja, "-", 0), 2,2) ;				//var tablakdc2_baja = " keplersc.kdc2" & mid(strSplit(fecha_baja, "-", 0), 2,2) & strSplit(fecha_baja, "-", 1);				var tipo = ""; var nPolAlta = "" ;				//if (tablakdc2_baja &= tablakdc2_alta ){					tipo = "Misma_tabla";										cmd= " select c1 as num_pol from " & tablakdc2_alta & " where c14='" & sucursal_id  & "' and c15='" & gen_doc & "' and c16= '" & nat_doc & "'" ;					cmd = cmd & " and c17='" & gpo_doc & "' and c18='" & tip_doc & "' and c19='" & frn.get("k_folio")& "'";									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.GenerarReporte()");					frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");									ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}									nPolAlta =getXmlAtt(cuboResultados,"r0", "num_pol" );								//}				imprime_poliza(tablakdc1_alta , tablakdc2_alta, "Alta", tipo, nPolAlta);//hasta aqui				rep.set("desc_notas",getXml(tmpXml,"k_coment"));					rep.exe("notastitulos");								//Procesar xml detalle				rstXml(xmlDetConv);				tmpStr=getXmlAtt(cuboQuery,"r0","detpartidas");				frn.lib("libGeneral.kpl","FileSave",tmpStr , fileSavePath & "\xmlResQueryRepDetalle");					rstXml(xmlDetalle);				tmpStr=delScpScn(tmpStr);				setXmlStr(xmlDetalle,tmpStr);				contDet=nXml(xmlDetalle);				total = 0;				for(var y=0; y< contDet; y++){					rstXml(xmlCurDet);					xmlCurDet= getXmlX(xmlDetalle,3,y);						frn.lib("libGeneral.kpl","FileSave",xmlCurDet , fileSavePath & "\xmlResQueryRepCurDetalle");											rep.set("tipo_orden",getXml(xmlCurDet,"k_tipo_orden"));					rep.set("num_orden",getXml(xmlCurDet,"k_num_orden"));					rep.set("punto",getXml(xmlCurDet,"k_punto"));					rep.set("desc_tot",getXml(xmlCurDet,"k_descriptot"));					rep.set("costo",getXml(xmlCurDet,"k_costo"));					rep.set("precio",getXml(xmlCurDet,"k_precio"));					rep.set("min",getXml(xmlCurDet,"k_margtots"));					rep.set("carg",getXml(xmlCurDet,"k_marg_calc"));					rep.set("cliente",getXml(xmlCurDet,"k_cliente"));					rep.exe("detalle");				}										rep.set("subtotal",getXml(tmpXml,"k_subtotal"));				rep.set("monto_iva",getXml(tmpXml,"k_iva"));								//Added by JMM 20240710, para estandarizar ( subtotal e iva no existen en el FTO )				//... retenciones tampoco se incluyeron en el FTO 				rep.set("monto_retenciones",getXml(tmpXml,"k_sumrets"));								rep.set("monto_total",getXml(tmpXml,"k_monto"));				rep.exe("totalproducto");									rep.win(); //Muestra la vista previa de la impresi?n. A partir de la vista previa (Preprint) se decide si se imprime o no.			}						fun imprime_poliza(tablakdc1 , tablakdc2, operacion, tipo, nPolAlta ){							var cmd, cuboResultados , ok;								//Procesa poliza contable				cmd= " select kc2.c1 as num_pol, kc2.c3 as cuenta, kc2.c4 as tipo_asiento, kc2.c5 as monto, kc1.c2 as desc_pol, kc2.c7 as refer, kc2.c8 as tipo_pol from " & tablakdc2 & " as kc2 " ;				cmd = cmd & " inner join " & tablakdc1 & " as kc1 on kc1.c1=kc2.c3 ";				cmd = cmd & " where kc2.c14='" & frn.get("k_sucn", -1, 1) & "' and kc2.c15='" & gen_doc & "' and kc2.c16= '" & nat_doc & "' and kc2.c17='" & gpo_doc & "' and kc2.c18='" & tip_doc & "' and kc2.c19='" & frn.get("k_folio")& "'";				if (operacion &= "Alta" && tipo &= "Misma_tabla"){					cmd = cmd & " and kc2.c1 = " & nPolAlta ; 				}				if (operacion &= "Baja" && tipo &= "Misma_tabla"){					cmd = cmd & " and kc2.c1 <> " & nPolAlta ; 				}												//Added by JMM 20240314				cmd = cmd & " order by kc2.c1, kc2.c10 "; 				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.imprime_poliza()");				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var nRenPol= nXml(cuboResultados);				var tPoliza=getXmlAtt(cuboResultados,"r0", "tipo_pol" );				var nPoliza=getXmlAtt(cuboResultados,"r0", "num_pol" );								if (strlen(tPoliza)>0 && strlen(nPoliza)>0 ){						rep.set("tPol",tPoliza);						rep.set("nPol",nPoliza);						rep.exe("encabezadoPol");						var tAbonosPol=0, tCargosPol=0;						for(var i=0;i<nRenPol;i++){							if (getXmlAtt(cuboResultados,"r"&i, "tipo_asiento" )&= "A"){								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave2",cuenta );								rep.set("PolDescr2",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolHaber",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tAbonosPol=tAbonosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								//pol_saldo_presupuesto(cuenta);								//rep.set("PolSaldo2",saldo);								//rep.set("PolPresupuesto2",presupuesto );								rep.exe("partPolA");							}else{								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave",cuenta );								rep.set("PolDescr",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolDebe",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tCargosPol=tCargosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								//pol_saldo_presupuesto(cuenta);								//rep.set("PolSaldo",saldo );								//rep.set("PolPresupuesto",presupuesto );								rep.exe("partPolC");							}						}						rep.set("totCargo",tCargosPol);						rep.set("totAbono",tAbonosPol);						rep.exe("PolTotales");				}			}			} // End of class Main	</script></pag>