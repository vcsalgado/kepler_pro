<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,10" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<tab/><txt clr="0,0,0" fnt="Arial,25">Telemarketing</txt><br/>		<tab/><hLine/>		<br/><br/>		<tab/>		<grp dim="42,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 			brdr="0,5" fnt="Arial,16" tit="Generales">			<sp/><txt>Sucursal:</txt>			<inp id="sucursal_id" dim="4,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>			<sp/><inp id="sucursal" dim="42,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" tooltip="Sucursal"/>	   			<br/>			<sp/><txt>Folio:</txt><inp id="folio" dim="14,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" tooltip="Folio"/>			<sp/><txt>Fecha:</txt><inp id="fecha" dim="11,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" fmt="DD/MM/CCYY" nc="-1" modify="N" available="N" tooltip="Fecha"/>			<sp/><txt>Asesor:</txt><inp id="asesor" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" tooltip="Asesor"/>				</grp>		<sp/>		<grp dim="54,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 			brdr="0,5" fnt="Arial,16" tit="Veh&#237;culo">					<sp/>			<txt>ID: </txt>			<inp id="serie" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="Y"/>			<tab/><txt>VIN:</txt>			<inp id="vin" dim="23,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="Y" tooltip="Modificar F11" OnF11="edicion_vin(Modificar)" OnChange="ActualizaContacto()"/>			<tab/><sp/><txt>Vale Salida/Ult. Serv:</txt>			<inp id="fecha_dofu" dim="12,1" type="string" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="N" available="Y" tooltip="Fecha DOFU" nc="-1"/> 			<br/><sp/><txt>Marca:</txt>			<inp id="marca" dim="7,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="Y" tooltip="Marca"/>			<sp/><txt>Modelo: </txt>			<inp id="modelo" dim="26,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="Y" tooltip="Modelo"/>			<sp/><txt>A&#241;o:</txt>			<inp id="anio" dim="6,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="Y" tooltip="A&#241;o"/>			<sp/><txt>Kms.:</txt>			<inp id="kms" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="N" available="Y" nd="0" fmt="5" tooltip="Kilometraje"/>			<br/><txt> Garant&#237;a Extendida:</txt>			<inp id="protec_extend" dim="5,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="Y" tooltip="Garant&#237;a Extendida"/>			<sp/><txt>Expira Garant&#237;a:</txt>			<inp id="fecha_exp_garantia" dim="12,1" type="string" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="N" available="Y" tooltip="Expira Garant&#237;a" nc="-1"/><tab/> 						<inp id="k_serie" dim="3,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="N"/>			<inp id="tipo_auto" dim="3,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="N"/>					</grp>		<br/><br/>		<tab/>		<grp dim="97,12,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 			brdr="0,5" fnt="Arial,16" tit="Datos de Cliente">					<sp/><tbl id="tbl_perfiles" dim="136,7" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" nren="fijo" insdel="N" Reorder="N" modify="N">				<col id="perfil" name="Perfil" nc="-1" type="capital"/>				<col id="cliente_id" name="Cliente" type="capital" nc="-1" OnF11="edicion_cliente(Modificar)"/>				<col id="cliente_nombre" name="Nombre" type="capital" nc="-1"/>				<col id="cliente_tmovil" name="M&#243;vil" type="string" nc="10"/>				<col id="cliente_tcasa" name="Tel. Adicional" type="string" nc="10"/>				<col id="cliente_toficina" name="Tel. Ofna." type="string" nc="10"/>				<col id="medio_preferido" name="Medio Preferido" type="capital" nc="-1"/>				<col id="cliente_correo" name="Correo electr&#243;nico" type="string" nc="-1"/>				<col id="cliente_calle" name="Calle" type="capital" nc="-1"/>				<col id="cliente_ext" name="No." type="capital" nc="-1"/>				<col id="cliente_int" name="Int." type="capital" nc="-1"/>				<col id="cliente_colonia" name="Colonia" type="capital" nc="-1"/>				<col id="cliente_poblacion" name="Poblaci&#243;n" type="capital" nc="-1"/>				<col id="cliente_municipio" name="Municipio" type="capital" nc="-1"/>				<col id="cliente_estado" name="Estado" type="capital" nc="-1"/>				<col id="cliente_pais" name="Pa&#237;s" type="capital" nc="-1"/>				<col id="cliente_cp" name="C.P." type="string" nc="-1"/>			</tbl>		</grp>		<br/><br/>		<tab/>		<grp dim="97,15,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 			brdr="0,5" fnt="Arial,16" tit="Detalle de Contacto">					<sp/><txt fnt=",b">Motivo de contacto: </txt>			<sp/><inp id="motivo_contacto" dim="45,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" tooltip="Motivo de Contacto"/>			<tab n="2"/><txt>Atendi&#243;: </txt>			<sp n="3"/><cmb id="cmb_atendio" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" modify="Y" OnChange="SetAtendio()"/>			<sp/><inp id="inp_atendio" dim="38,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" tooltip="Nombre de la persona con la que se tuvo contacto." modify="N"/>			<br/>						<sp/><txt>Resultado contacto: </txt>			<tab/><cmb id="cmb_resultado" dim="45,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" OnEnter="LlenaComboAcciones()" tooltip="Resultado del Contacto"/>			<tab n="2"/><txt>Coment Res:</txt>			<inp id="inp_coment_resultado" dim="54,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="50" tooltip="Comentario del resultado del contacto" modify="N"/>			<br/>			<sp/><txt>Sig. acci&#243;n: </txt><sp/><tab n="3"/>			<cmb id="cmb_accion" dim="45,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" tooltip="Siguiente Acci&#243;n"/>			<tab n="2"/><txt>Fecha siguiente contacto: </txt><tab/><sp n="2"/>			<edt id="fecha_atencion" dim="12,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" 				fnt="Arial,16" type="date" page="_ks_fecha,fecha_atencion" OnF9="Dialog(3,_ks_fecha,fecha_atencion)" OnChange="ValidaFecha()" modify="Y" available="Y" tooltip="Fecha siguiente accion"/>				<br/>			<sp/><txt>Obsevaciones: </txt>			<sp/><tab n="2"/><inp id="observaciones" dim="116,3" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="240" tooltip="Observaciones"/>			<br/>			<tab n="1"/><bot id="img_guardar" dim="14,0" brdr="5" text="Guardar" tooltip="Actualizar registro" visible="Y" OnEnter="Guardar()"/>			<sp/><bot id="bot_nuevacita" dim="14,0" brdr="5" text="Nueva Cita" tooltip="Regitrar cita" OnEnter="AgendarCita()" visible="N"/>			<sp/><bot id="bot_citabienv" dim="22,0" brdr="5" text="Cita Evento Bienvenida" tooltip="Regitrar cita" OnEnter="AgendarCitaBienvenida()" visible="N"/>			</grp>		<br/><br/>		<tab/>		<grp dim="84,14,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 			brdr="0,5" fnt="Arial,16" tit="Resumen de citas">			<sp/>			<tbl id="tbl_citas" dim="118,7" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" nren="fijo" insdel="N" Reorder="N" modify="N">				<col id="estatus_cita" name="Estatus" nc="-1"/>				<col id="tipo" name="T" type="capital"/>				<col id="tipo_cita" name="Tipo" nc="-1" type="capital"/>				<col id="fecha_cita" name="Fecha" type="string" nc="-1" fmt="DD/MM/CCYY"/>				<col id="hora_cita" name="Hora" type="time" nc="-1"/>				<col id="punto_primario" name="Punto primario" type="string" nc="-1"/>				<col id="folio_cita" name="Folio" type="string" nc="10"/>                <col id="asesor_tmkt" name="Asesor Tmkt" type="string" nc="10"/>			</tbl>									<br/><br/>				<sp/><bot id="bot_modcita" dim="14,0" brdr="5" text="Modificar Cita" tooltip="Modificar cita" OnEnter="ModificarCita()" visible="N"/>					</grp>		<sp/>		<grp dim="12,16,7,12" brdr="1,4" clrBrdr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0">						<br/>			<br/>			<sp/><bot id="img_paquetes" dim="14,0"  brdr="5" text="Paquetes" tooltip="Paquetes disponibles" OnEnter="MostrarPaquetes()" visible="Y"/>			<br/>			<sp/><bot id="img_tmkt" dim="14,0"  brdr="5" text="Hist. TMKT" tooltip="Ver historial TMKT" visible="Y" OnEnter="MostrarHistTmkt()"/>			<br/>			<sp/><bot id="img_historial" dim="14,0"  brdr="5" text="Hist. &#211;rdenes" tooltip="Ver historial de &#243;rdenes" visible="Y" OnEnter="MostrarHistOrdenes()"/>			<br/>			<br/>			<br/><br/>			<sp/><bot id="img_salir" dim="14,0"  brdr="5" text="Salir" visible="Y" tooltip="Salir" OnEnter="Regresar()"/>						   </grp>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,sys,frP;			var cmd,cubo, mensajeError,ok;			var suc_usuario,usuario,rol_usuario,asterisco;			var parametros,paramllamada,tip_ope,suc_base,folio_base;			var motivo_id, evento_activo,cliente_id,cte_nombre;			var folio_cita_pendiente; //Variable en la que se registra si el cliente tiene una cita abierta asociada a una serie			//Variables relacionadas con el contacto(tmktsrv2)			var tipo_trabajo;			fun Main() {				frn=new FRNT;				kdb=new KDB;				sys=new SYS;				frP=new FRNTP;				kdb.connect();				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				//parametros = "P,01,0";			//Solo para probar, comentarior despues o quitar				paramllamada = frn.config("temp","parametros");  //estos son los param si se llama desde atender llamada				parametros = frn.param(0);				//frn.message("parametros llamada: " & paramllamada & " Parametros Contactos: " & parametros);				asterisco = "*";				evento_activo = "N";				Inicializa();				ConfiguraCamposOpcion();				if(folio_base &! ""){					CargaEvento(); //Si se muestra un evento, evento_activo regresa como "S"					if(evento_activo&="N"){						ConfiguraControlesOff();						return;					}					LlenaComboAtendio();					SetAtendio();					LlenaComboResultados();					LlenaComboAcciones();							}							}									fun MostrarPaquetes(){				var marca,modelo;				marca=frn.get("marca");				modelo=frn.get("modelo");				cmd="select paq.c4 as clave, paq.c5 as descripcion, paq.c10 as precio, coalesce(com.c2,0) as comision ";				cmd=cmd&"from keplersc.kdspaq paq left outer join keplersc.kdctascomispaq com on paq.c4=com.c1 ";				cmd=cmd&"where paq.c1='"&marca&"' and paq.c2='"&modelo&"' order by paq.c4" ;				frn.dialog("genlistasel","Paquetes disponibles",cmd,"clave","valorx","");			}						fun Inicializa(){				tip_ope=99;				if (strSplit(paramllamada,",",3) &= "Llamada"){					if(paramllamada&= "" || strSplit(paramllamada,",",-1)<4)					{						frn.message("Esta accion no esta permitida.","Faltan parametros","&Aceptar");						/*frn.open("redirect",2);						return;*/					}					tip_ope=strSplit(paramllamada,",",0); //S-seguimiento, P-Proactiva, R-Reactiva					suc_base = strSplit(paramllamada,",",1);					folio_base=strSplit(paramllamada,",",2);					frn.configSet("temp","parametros",""); //Reset a variable de sesion				} else{					if(parametros&= "" || strSplit(parametros,",",-1)<3)					{						frn.message("Esta accion no esta permitida.","Faltan parametros","&Aceptar");						/*frn.open("redirect",2);						return;*/					}						tip_ope=strSplit(parametros,",",0); //S-seguimiento, P-Proactiva, R-Reactiva					suc_base = strSplit(parametros,",",1);					folio_base=strSplit(parametros,",",2);				}				frn.setX(suc_base,"sucursal");				MostrarDatosSerie();				ValidaFecha();			}						fun MostrarDatosSerie(){				cmd = "select ser.c1 as serie, ser.c4 as vin, ser.c2 as marca, ser.c3 as modelo, ser.c11 as anio, ser.c12 as kms, " &					"ser.c38 as protec_extend, to_char(ser.c39, 'DD/MM/YYYY') as fecha_exp_garantia " &					"from keplersc.kdtmktser2 tmk " &					"left join keplersc.kdserie ser on ser.c1=tmk.c14 " &					"where tmk.c1='" & suc_base & "' and tmk.c2='" & folio_base & "'";									rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"setmkt.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\datosserie");												ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("serie",getXmlAtt(cubo,"r0" ,"serie"));				frn.set("vin",getXmlAtt(cubo,"r0" ,"vin"));				frn.set("marca",getXmlAtt(cubo,"r0" ,"marca"));				frn.set("modelo",getXmlAtt(cubo,"r0" ,"modelo"));				frn.set("anio",getXmlAtt(cubo,"r0" ,"anio"));				frn.set("kms",getXmlAtt(cubo,"r0" ,"kms"));				frn.set("protec_extend",getXmlAtt(cubo,"r0" ,"protec_extend"));				frn.set("fecha_exp_garantia",getXmlAtt(cubo,"r0" ,"fecha_exp_garantia"));			}						fun LlenaComboAtendio(){				frn.setX("Cliente","cmb_atendio",0,0);				frn.setX("Otro","cmb_atendio",1,0);			}			fun SetAtendio(){				var atendio, nombre;				atendio = frn.get("cmb_atendio",-1,0);				nombre=frn.get("tbl_perfiles",-1,"cliente_nombre");				frn.set("inp_atendio",nombre);				if(atendio &= "Cliente"){					frn.setAtt("inp_atendio","modify","N");				}				else{					frn.setAtt("inp_atendio","modify","Y");				}				if (frn.get("inp_atendio") &="") {					frn.setAtt("inp_atendio","modify","Y");				}			}			fun SetComentResultado(){				var res_contacto, nombre;				res_contacto = frn.get("cmb_resultado",-1,1);				frn.set("inp_coment_resultado","");				if(res_contacto &= "20" || res_contacto &= "21" || res_contacto &= "22"){					frn.setAtt("inp_coment_resultado","modify","Y");				}				else{					frn.setAtt("inp_coment_resultado","modify","N");				}			}						fun LlenaComboResultados(){				cmd = "select res.descripcion, res.resultado_id from keplersc.kdtmktresult res, keplersc.kdtmktmotres rel " &				"where res.resultado_id = rel.resultado_id and rel.motivo_id = " & motivo_id & " and seleccionable = 'S'";									rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"setmkt.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\xmlRes");												ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("cmb_resultado",getXml(cubo));				}						fun LlenaComboAcciones(){				//Llena combo acciones				var resultado_id;				resultado_id=frn.get("cmb_resultado",-1,1);				cmd = "select acc.descripcion, acc.accion_id " & 					"from keplersc.kdtmktaccion acc, keplersc.kdtmktresacc rel " & 					"where acc.accion_id=rel.accion_id and rel.resultado_id = " & resultado_id & " and acc.seleccionable = 'S' ";				rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"setmkt.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("cmb_accion",getXml(cubo));									//Inicia campo de fecha				frn.set("fecha_atencion",fnDate("addC",sys.date(),0));					SetComentResultado();						}									fun ConfiguraControlesOff(){				frn.setAtt("k_sucN","available","N");				frn.setAtt("img_paquetes","visible","N");				//frn.setAtt("img_VIN","visible","N");				frn.setAtt("img_tmkt","visible","N");				frn.setAtt("img_historial","visible","N");				frn.setAtt("img_campanas","visible","N");				frn.setAtt("img_guardar","visible","N");				frn.setAtt("bot_modcita","visible","N");				frn.setAtt("bot_nuevacita","visible","N");				frn.setAtt("bot_citabienv","visible","N");							}						fun ConfiguraCamposOpcion(){				var strValAtr;				ConfiguraControlesOff();				switch(tip_ope){					case 0: //Alta o Atencion de Evento						frn.setAtt("k_sucN","available","Y");						frn.setAtt("k_sucN","modify","Y");												frn.setAtt("img_paquetes","visible","Y");						//frn.setAtt("img_VIN","visible","Y");						frn.setAtt("img_tmkt","visible","Y");						frn.setAtt("img_historial","visible","Y");						frn.setAtt("img_campanas","visible","Y");						frn.setAtt("img_guardar","visible","Y");						//Los botones relacionados con la cita se habilitan en la seccion 						//de presentacion del detalle del  contacto, funcion CargaEvento()						//frn.setAtt("bot_modcita","visible","Y");						//frn.setAtt("bot_nuevacita","visible","Y");						break;					case 99: //Operacion no valida 						break;					default:										}								}						fun ValidaFecha(){				var fechaVal;				fechaVal = frn.get("fecha_atencion");				if(fechaVal &= ""){					fechaVal = fnDate("addC",sys.date(),1);				}				if(fnDate("dif",fechaVal,sys.date())<1){					fechaVal = fnDate("addC",sys.date(),0);				}								if(fnDate("dayweek",fechaVal)==0){					fechaVal = fnDate("addC",fechaVal,1);				}								frn.set("fecha_atencion",fechaVal);			}						fun CargaEvento(){				var renglon,cuboRows,xmlRes,serie;				var strCampos, totCampos, curCampo, curValor,  strCadena;				var xmlDetalle, strTmp, totRow, len_result;				var xmlDetConv, xmlCurDet, contDet, setXmlStr;				evento_activo="N";				serie=frn.get("k_serie");								//Obtiene informacion general de evento				cmd = "select * from keplersc.ser_tmkt_asignarevento('" & tip_ope & "','" & suc_base &"','" & folio_base & "','" & usuario & "')";															cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmkt.CargaEvento()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								//Obtiene los regitros				strTmp = getXmlAtt(cubo,"r0","ser_tmkt_asignarevento");				strTmp = delScpScn(strTmp);				setXmlStr(cuboRows,strTmp);								frn.lib("libGeneral.kpl","FileSave",cuboRows,"C:\Basura\cuboRows");								//Obtiene el primer registro, en este caso solo hay uno				rstXml(xmlRes);				xmlRes= getXmlX(cuboRows,3,0); //Se asume que solo se trae un evento				frn.lib("libGeneral.kpl","FileSave",xmlRes,"C:\Basura\xmlRes");												frn.setX(xmlRes);				frn.set("k_serie",frn.get("serie"));								//Obtener el tipo de trabajo (Proactivo o Reactivo)				tipo_trabajo = getXml(xmlRes,"tipo_trabajo");				motivo_id = getXml(xmlRes,"motivo_id");								//Obtiene informacion de los prefiles del cliente del evento				cmd = "select * from keplersc.ser_tmkt_asignarperfiles('" & suc_base &"','" & folio_base & "','" & usuario & "')";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmkt.CargaEvento()");				//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboRowsPerfiles");					ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				rstXml(xmlDetConv);				strTmp=getXmlAtt(cubo,"r0","ser_tmkt_asignarperfiles");				rstXml(xmlDetalle);				strTmp=delScpScn(strTmp);				setXmlStr(xmlDetalle,strTmp);				contDet=nXml(xmlDetalle);				for(var y=0; y< contDet; y++){					rstXml(xmlCurDet);					xmlCurDet= getXmlX(xmlDetalle,3,y);						setXml(xmlDetConv,"tbl_perfiles","r"&y,xmlCurDet);				}					frn.lib("libGeneral.kpl","FileSave",xmlDetConv,"C:\Basura\cuboRowsPerfilesFin");					//frn.setX(xmlDetConv);				//Llena manual la tabla				contDet = nXml(xmlDetConv,"tbl_perfiles");				frn.rst("tbl_perfiles");				for (var contOrd=0; contOrd<contDet ; contOrd++){					var strCte=getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_id");					//frn.message("cte: "&strCte & "contOrd:" &contOrd);					//if (strCte &! "" && !strCte){								frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"perfil"),"tbl_perfiles",contOrd,"perfil");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_id"),"tbl_perfiles",contOrd,"cliente_id");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_nombre"),"tbl_perfiles",contOrd,"cliente_nombre");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"medio_preferido"),"tbl_perfiles",contOrd,"medio_preferido");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_correo"),"tbl_perfiles",contOrd,"cliente_correo");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_tmovil"),"tbl_perfiles",contOrd,"cliente_tmovil");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_tcasa"),"tbl_perfiles",contOrd,"cliente_tcasa");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_toficina"),"tbl_perfiles",contOrd,"cliente_toficina");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_calle"),"tbl_perfiles",contOrd,"cliente_calle");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_ext"),"tbl_perfiles",contOrd,"cliente_ext");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_int"),"tbl_perfiles",contOrd,"cliente_int");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_colonia"),"tbl_perfiles",contOrd,"cliente_colonia");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_poblacion"),"tbl_perfiles",contOrd,"cliente_poblacion");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_municipio"),"tbl_perfiles",contOrd,"cliente_municipio");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_estado"),"tbl_perfiles",contOrd,"cliente_estado");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_pais"),"tbl_perfiles",contOrd,"cliente_pais");						frn.setX( getXml(xmlDetConv,"tbl_perfiles","r"&contOrd,"cliente_cp"),"tbl_perfiles",contOrd,"cliente_cp");					//}				}				//Obtiene la cve_cliente del perfil propietario(Kdserie)								totRow = frn.N("tbl_perfiles");				cliente_id ="";				serie = frn.get("serie");				for (var i=0; i<totRow; i++) {					if (frn.get("tbl_perfiles",i,"perfil") &= "PROPIETARIO"){						cliente_id = frn.get("tbl_perfiles",i,"cliente_id");						cte_nombre = frn.get("tbl_perfiles",i,"cliente_nombre");										cmd = "select c38 as medio_preferido " &								"from keplersc.kdctasbienvser where c1='" & frn.get("sucursal_id") & "' and c6='" & serie & "' and c33='" & cliente_id & 								"' order by c16 desc limit 1";						cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvtmkt.CargaEvento()");									ok=getXmlAtt(cubo,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cubo,"native3");							frn.message(mensajeError,"Error","Aceptar");							return;						}									len_result = nXml(cubo);									if (len_result >0){							frn.setX(getXmlAtt(cubo,"r0","medio_preferido"),"tbl_perfiles",i,"medio_preferido");						}						}					if (frn.get("tbl_perfiles",i,"perfil") &= "ADQUISICION"){						var adquisicion_id = frn.get("tbl_perfiles",i,"cliente_id");												cmd = "select c31 as medio_preferido " &								"from keplersc.kdctasbienvser where c1='" & frn.get("sucursal_id") & "' and c6='" & serie & "' and c4='" & adquisicion_id & 								"' order by c16 desc limit 1";															cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvtmkt.CargaEvento()");							//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubomediopref");							ok=getXmlAtt(cubo,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cubo,"native3");							frn.message(mensajeError,"Error","Aceptar");							return;						}									len_result = nXml(cubo);									if (len_result >0){							frn.setX(getXmlAtt(cubo,"r0","medio_preferido"),"tbl_perfiles",i,"medio_preferido");						}																}								}				if (motivo_id &= 80){			//Evento Bienvenida					frn.setAtt("bot_citabienv","visible","Y");					frn.setAtt("bot_nuevacita","visible","N");					frn.setAtt("img_paquetes","visible","N");					frn.setAtt("img_tmkt","visible","N");					frn.setAtt("img_historial","visible","N");					frn.setAtt("img_campanas","visible","N");				}else{					frn.setAtt("bot_citabienv","visible","N");					//Llena lista de citas relacionadas con el cliente					cmd = "select " &  						"CASE " &						" WHEN (cta.c20=0) THEN 'Pendiente' " &						" WHEN (cta.c20=10) THEN 'Confirmada' " &						" WHEN (cta.c20=20) THEN 'Concretada' " &						" WHEN (cta.c20=30) THEN 'Reprogramada' " &						" WHEN (cta.c20=40) THEN 'Cancelada' " &                        " WHEN (cta.c20=50) THEN 'No Show' " & 						"END AS estatus_cita, " &						"cta.c37 as t, " &						"tipo.c2 as tipo_cita, " &						"to_char(cta.c12, 'DD/MM/YYYY') as fecha_cita, " &						"cta.c13 as hora_cita, " &						"'' as punto_ptimario, " &                         "cta.c2 as folio_cita, " &					    "cta.c3 as asesor_tmkt " &						"from keplersc.kdctasser cta inner join keplersc.kdcatcitasordenes tipo on tipo.c1=cta.c37 " &						"where cta.c1='" & suc_base & "' and cta.c4='" & cliente_id & "' ";							if(serie &! ""){						cmd = cmd & " and cta.c6='" & serie & "' ";					}								cmd = cmd & "order by fecha_cita desc, estatus_cita desc" ;							frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\xmlCmd");											rstXml(cubo);					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmkt.CargaEvento()");					frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\xmlCitas");					ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}													frn.setX(cubo,"tbl_citas");										//Verificar si se tienen citas abiertas					folio_cita_pendiente = "";					var valcita = 0;					frn.setAtt("bot_modcita","visible","N");					frn.setAtt("bot_nuevacita","visible","N");					totRow = frn.N("tbl_citas");					for(renglon=0; renglon<totRow; renglon++){						strTmp=frn.get("tbl_citas",renglon,"estatus_cita");                        if(strTmp&="Pendiente" || strTmp&="Confirmada"){ 							   							folio_cita_pendiente = frn.get("tbl_citas",renglon,"folio_cita");							if (frn.get("tbl_citas",renglon,"tipo") &="S" || frn.get("tbl_citas",renglon,"tipo") &="T"){								frn.message("Se tiene una cita de tipo "& frn.get("tbl_citas",renglon,"tipo") & " pendiente abierta. Solo podra agendar una de Garantia","Mensaje","Aceptar");								valcita=0;							} else{								valcita=2;								frn.message("Se tiene una cita pendiente abierta.","Mensaje","Aceptar");								break;							}						}                        if(strTmp&="No Show"){                            if (frn.get("asesor") &! frn.get("tbl_citas",renglon,"asesor_tmkt")){                                //si el mes de la cita es = al mes de la fecha sistema enviar mesg y no dejar continuar                                if (fnDate("month",frn.get("tbl_citas",renglon,"fecha_cita")) &= fnDate("month",sys.date())){									valcita=1;									frn.message("Se tiene una cita en estatus No Show en el mes en curso. Imposible agendar con este asesor","Mensaje","Aceptar");								    break;                                }			                            }                            frn.message("Este cliente no asistio a su cita, tiene una cita en No Show.","Mensaje","Aceptar");                        }					}					//if(strTmp&!"Pendiente"){					if(valcita==0){							frn.setAtt("bot_nuevacita","visible","Y");											}else if(valcita==2){						frn.setAtt("bot_modcita","visible","Y");					}				}				evento_activo="S";							}						fun MostrarHistTmkt(){				var serie="";				serie=frn.get("serie");								cmd="select tmkt.c2 as folio, to_char(tmkt.c5, 'DD/MM/YYYY') as programado, ";				cmd=cmd&"coalesce(motivo.descripcion,'Sin Motivo') as motivo, ";				cmd=cmd&"coalesce(tmkt.c3,'SA') as asesor, ";				cmd=cmd&"case ";				cmd=cmd&"	when extract(year from tmkt.c10) = 1900 then '' ";				cmd=cmd&"	when extract(year from tmkt.c10) = 1800 then '' ";				cmd=cmd&"	else tmkt.c10::text ";				cmd=cmd&"end as atendido, ";				cmd=cmd&"coalesce(resultado.descripcion,'') as resultado, ";				cmd=cmd&"coalesce(accion.descripcion ,'') as accion ";				cmd=cmd&"from keplersc.kdtmktser2 tmkt ";				cmd=cmd&"left outer join keplersc.kdtmktmotivo motivo on motivo.motivo_id = tmkt.c7 ";				cmd=cmd&"left outer join keplersc.kdtmktresult resultado on resultado.resultado_id  = tmkt.c8 ";				cmd=cmd&"left outer join keplersc.kdtmktaccion accion  on accion.accion_id = tmkt.c9 ";				cmd=cmd&"where tmkt.c14='"& serie &"' and tmkt.c1='" & frn.get("sucursal_id") & "' " & 				"order by folio desc";						frn.dialog("genlistasel","Historia Telemarketing",cmd,"folio","prueba","");			}						fun MostrarHistOrdenes(){				var serie="";				serie=frn.get("serie");				frn.dialog("serhistorialorden",serie,frn.get("k_sucN",-1,1));			}						fun AgendarCita(){						var suc = frn.get("sucursal_id");				var ser = frn.get("serie");				if (ser &= ""){					frn.message("Debe especificar un VIN","Error","Aceptar");					return ; 				}								var folio_no_show = "";				var no_show = "no";								cmd = " select c2,c12,c20 from keplersc.kdctasser where c1='" & suc & 				"' and c6='" & ser & "' order by c2 desc limit 1";									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmkt.AgendarCita()");								frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo_kodawari  ");							var tot_res = nXml(cubo);								if (tot_res > 0){									var estatus_cta = getXmlAtt(cubo,"r0", "c20");										if (estatus_cta &= 50){											var fecha_cta = getXmlAtt(cubo,"r0", "c12");												var dif_dias = fnDate("dif", sys.date(), fecha_cta );												if ( dif_dias <= 30 ){													var respuesta = frn.message(" La ultima cita de esta serie es un No Show, se bajaran sus datos, ¿ Estas de acuerdo ?","Atencion",2);							if (respuesta == 1){														folio_no_show = getXmlAtt(cubo,"r0", "c2");								no_show = "si";													}else{								return;							}												}					}				}										frn.dialog("srvcitacrud",0,frn.get("folio"),frn.get("sucursal_id"),"T",folio_no_show , no_show );				//frn.open("sertmktview");  //si se pone este se borra rl filtro de sertmktview									}			fun AgendarCitaBienvenida(){				frn.dialog("srvcitabienvcrud",0,frn.get("folio"),frn.get("sucursal_id"),"T","");							}						fun ModificarCita(){				frn.dialog("srvcitacrud",1,"",frn.get("sucursal_id"),"T",frn.get("tbl_citas",-1,"folio_cita"));				//SfrP.script("Inicializa()");				//frn.open("sertmktview");    //si se pone este se borra rl filtro de sertmktview			}									fun Guardar() {				var seleccion, xmlPantalla,resultado,mensaje,adicionales;				var res_contacto, sig_accion;				var nombre_atendio, folio_cita;				res_contacto = frn.get("cmb_resultado",-1,1);				sig_accion = frn.get("cmb_accion",-1,1);				if(res_contacto &= ""){					frn.message("No ha seleccionado un resultado valido.","Mensaje","Aceptar");					return;				}				if(sig_accion &= ""){					frn.message("No ha seleccionado una accion valida.","Mensaje","Aceptar");					return;				}				//Valida si existen contactos posteriores generados				setXml(xmlPantalla,"sucursal_id",frn.get("sucursal_id"));				setXml(xmlPantalla,"folio",frn.get("folio"));				setXml(xmlPantalla,"asesor",frn.get("asesor"));				setXml(xmlPantalla,"accion",frn.get("cmb_accion",-1,1));				setXml(xmlPantalla,"fecha",frn.get("fecha"));				setXml(xmlPantalla,"serie",frn.get("serie"));												frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlContPost");								cmd="SELECT * FROM keplersc.ser_tmkt_valida_contactos_posteriores('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"sertmkt.Guardar");								ok=getXmlAtt(cubo,"ok");					resultado= getXml(cubo,"resultado");				mensaje= getXml(cubo,"mensaje");				if(resultado &= "1"){					if(mensaje &! ""){						mensaje = "La serie tiene contactos posteriores generados. El siguiente contacto esta programado para: " & mensaje & "| La accion seleccionada generara un contacto nuevo...Verifique!";						frn.message(mensaje, "Advertencia","&Aceptar");					}										}else{					frn.message(mensaje, "Error","&Aceptar");					return;				}				rstXml(xmlPantalla);				seleccion = frn.message("¿Confirma actualizar contacto?","Confirmar accion",2);				//Validar datos de registro				if (seleccion==1){					setXml(xmlPantalla,"sucursal_id",frn.get("sucursal_id"));					setXml(xmlPantalla,"folio",frn.get("folio"));					setXml(xmlPantalla,"asesor",frn.config("user","name"));					setXml(xmlPantalla,"resultado",frn.get("cmb_resultado",-1,1));					setXml(xmlPantalla,"accion",frn.get("cmb_accion",-1,1));					setXml(xmlPantalla,"fecha_accion",frn.get("fecha_atencion"));					setXml(xmlPantalla,"observaciones",frn.get("observaciones"));					setXml(xmlPantalla,"serie",frn.get("serie"));					setXml(xmlPantalla,"tipo_servicio","0");					setXml(xmlPantalla,"motivo_original",motivo_id);					setXml(xmlPantalla,"coment_resultado",frn.get("inp_coment_resultado"));					setXml(xmlPantalla,"cliente_id",cliente_id);					nombre_atendio = frn.get("inp_atendio");					if(nombre_atendio &= ""){						nombre_atendio=cte_nombre;					}					setXml(xmlPantalla,"nombre_atendio",nombre_atendio);					setXml(xmlPantalla,"folio_cita",folio_cita_pendiente);													frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\sqlXmlTmkt");									cmd="SELECT * FROM keplersc.ser_tmkt_upd('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					kdb.rst(cubo);					cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"sertmkt.Guardar");									ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										resultado= getXml(cubo,"resultado");					mensaje= getXml(cubo,"mensaje");										if(resultado &= "1"){						if(mensaje &! ""){							mensaje = "Se genero nuevo contacto con el folio: " & mensaje;						}						mensaje = "Registro de contacto actualizado." & mensaje;						//seleccion = frn.message(mensaje, "Mensaje","&Siguiente","&Salir");						seleccion = frn.message(mensaje, "Mensaje","&Aceptar");						Regresar();																	}else{						frn.message(mensaje, "Error","&Aceptar");					}				}			}						fun Regresar(){				if (strSplit(paramllamada,",",3) &= "Llamada"){					frn.open("sertmktview",4);			//cuando se abre con open desde tmkt_reactivo					frP.script("actualiza_pantalla()");					} else{					frP.script("actualiza_pantalla()");		//de la pantalla que la llamo sertmktview					frn.exit();				}			}						fun edicion_vin(tipo_edicion){				var strVin = frn.get("vin"); 				if (tipo_edicion &= "Modificar" && strVin &= ""){					frn.message("Debe especificar una serie para modificar/consultar","Error","Aceptar");					return ; 				}				frn.dialog("cat_serie_crud",tipo_edicion,"x","s","vin");			}						fun edicion_cliente(tipo_edicion){				var cte_id;				cte_id = frn.get("tbl_perfiles", -1, "cliente_id");				if (tipo_edicion &= "Modificar"){					if (cte_id &= ""){						frn.message("No has seleccionado Cliente","Error","Aceptar");					}else{						frn.dialog("cat_cli_crud",tipo_edicion,cte_id,"n");					}				}			}			fun ActualizaContacto(){				var xmlActualizaCont,totPerf,vcliente,ncliente,resultado,mensaje,strMsg;				totPerf = frn.N("tbl_perfiles");				vcliente ="";								for (var i=0; i<totPerf; i++) {					if (frn.get("tbl_perfiles",i,"perfil") &= "PROPIETARIO"){						vcliente = frn.get("tbl_perfiles",i,"cliente_id");					}				}				//actualiza contacto en kdtmktser2 c20 y el nombre en el c21				setXml(xmlActualizaCont,"sucursal_id",frn.get("sucursal_id"));				setXml(xmlActualizaCont,"folio_tmkt",frn.get("folio"));				setXml(xmlActualizaCont,"serie",frn.get("serie"));				setXml(xmlActualizaCont,"cliente",vcliente);								cmd="SELECT * FROM keplersc.ser_tmkt_actualizacontacto('<document>" & getXmlStr(xmlActualizaCont,"EOF:13_10") & "</document>')";				rstXml(cubo);					cubo= frn.lib("libGeneral.kpl","EjecutarSql",cmd,"sertmkt.ActualizaContacto");								frn.lib("libGeneral.kpl","FileSave",cubo, "C:\Basura\XmlResultadoActCont");										resultado = getXml(cubo,"resultado");				mensaje = getXml(cubo,"mensaje");								if (resultado &= "0") {					frn.message(mensaje, "Error", "Aceptar");					return;				}				CargaEvento();				for (var i=0; i<totPerf; i++) {					if (frn.get("tbl_perfiles",i,"perfil") &= "PROPIETARIO"){						ncliente = frn.get("tbl_perfiles",i,"cliente_id");					}				}				if (vcliente &! ncliente){					frn.message("Se detecto cambio de propietario... Contactos de telemarketing actualizados", "Mensaje", "Aceptar");									}			}			//TODO:			//1)			//Analizar definir lo que debe presentarse en el campo de observaciones,			//en K75 se presentan los campo tmkt.c11 al tmkt.c13 pero en que momento 			//se llenan estos campos			//			//2)Definir la actulizacion del evento actual y la creacion de uno nuevo a			//partir del actual			//			//3)Cual es la funciponm de imprimir VIN		}	</script></pag>