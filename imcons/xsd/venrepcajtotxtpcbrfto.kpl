<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de " scale="48">	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,16" unfont="0">		<br exe="encabezado"/>		<hLine dim="90,0" g="2" type="1"/>		<br exe="encabezado"/>				<grp dim="15,5,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>				<grp dim="60,6,7,12">			<br/>			<inp id="nombreempresa" dim="70,1" fnt="20b,20b" type="string" modify="N" just="C" bclr="249,249,249"/>			<br/>			<inp id="titulorpt" dim="70,1" type="string" fnt=",18b" modify="N" just="L"/>			<br/>			<txt fnt=",16b">Del : </txt>			<inp id="fechaini" dim="12,1" type="date" fnt=",16b" fmt="DD/MM/CCYY" modify="N" just="L" nc="-1"/>			<sp n="4"/>			<txt fnt=",16b">Al : </txt>			<inp id="fechafin" dim="12,1" type="date" fnt=",16b" fmt="DD/MM/CCYY" modify="N" just="L" nc="-1"/>			<br exe="encabezado"/>		</grp>				<tab n="1"/>				<grp dim="15,5,7,12">			<tab n="2"/><txt>P&#225;g:</txt>			<sp/> <inp id="k_pag" dim="5,1" type="number" mcr="k_pag"/><br/><br/>			<inp id="fecha" dim="10,1" type="date" fmt="DD-MM-CCYY"/>			<sp/> <inp id="hora" dim="5,1" type="time"/>		</grp>		<br exe="encabezado"/>		<br exe="encabezado"/>				<hLine dim="90,0" g="2" type="1"/>			<br exe="encabezado"/>			<txt fnt=",b"> Sucursal</txt> <sp n="1"/>			<txt fnt=",b"> Folio</txt> <sp n="11"/>			<txt fnt=",b"> Fecha</txt> <sp n="6"/>			<txt fnt=",b"> Referencia </txt> <sp n="6"/>			<txt fnt=",0b"> Nombre</txt> <sp n="30"/>			<txt fnt=",b"> Ingresos</txt> <sp n="2"/> 			<br exe="encabezado"/>		<hLine dim="90,0" g="2" type="1"/> 		<br exe="encabezado"/>		<!-- <br exe="encabezado"/>  -->						<br exe="gp_suc"/>		<txt fnt=",16b" clr="20,0,96">Sucursal : </txt>		<inp id="suc" dim="3,1" bclr="255,255,255" clrBrdr="255,255,255" type="string" modify="N" fnt=",0b" clr="20,0,96"/>		<sp n="1"/>  		<inp id="descsuc" dim="40,1" bclr="255,255,255" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" clr="20,0,96"/>		<sp n="6"/>		<txt>----------------------------------------------------------------------------------</txt>		<br exe="gp_suc"/>					<!-- <hLine dim="90,0" g="1" type="1"/>  -->		<br exe="documento"/>		<!-- <inp id="docto" dim="12,1" bclr="255,255,255" clrBrdr="255,255,255" type="string" modify="N" fnt=",0b"/> -->		<inp id="descdocto" dim="50,1" bclr="255,255,255" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b"/>		<sp n="16"/>		<txt>------------------------------------------------------------</txt>		<br exe="documento"/>		<br exe="documento"/> 			<inp id="sucursal" dim="6,1" type="string" modify="N"/> <sp n="1"/>		<inp id="folio" dim="14,1" type="string"  modify="N" just="L" nc="-1"/><sp/> 		<inp id="fecha_doc" dim="10,1" type="date" modify="N" fmt="CCYY/MM/DD" nc="-1"/> <sp n="1"/>		<inp id="referencia" dim="13,1" type="string" modify="N"/> <sp n="1"/>		<inp id="nombre" dim="25,1" type="string" modify="N"/> 		<inp id="po" dim="3,1" type="string" modify="N" just="L"/>		<inp id="ingresos" dim="13,1" type="number" modify="N" just="R" nd="2"/> 		<inp id="pc" dim="1,1" type="string" modify="N" just="L"/> 		<br exe="detalle"/>					<!-- INI -- Totales x Documento -->		<br exe="totaldocumento"/> 		<hLine dim="90,0" g="1" type="1"/> 		<br exe="totaldocumento"/> 		<txt fnt=",16b">Total x Tipo :</txt>		<sp n="2"/>		<inp id="tpdescdocto" dim="50,1" type="string" fnt=",16b"/>		<sp n="11"/>		<inp id="tpo" dim="3,1" type="string" modify="N" just="L" fnt=",0b"/>		<inp id="tptotaldoc" dim="13,1" type="number" fnt=",16b" nd="2"/> 		<inp id="tpc" dim="1,1" type="string" modify="N" just="L" fnt=",0b"/> 		<br exe="totaldocumento"/> 		<hLine dim="90,0" g="1" type="1"/>		<br exe="totaldocumento"/>		<!-- END -- Totales x Documento -->						<!-- INI -- Totales x Sucursal -->		<br exe="totalsucursal"/> 		<hLine dim="90,0" g="1" type="1"/> 		<br exe="totalsucursal"/> 		<txt fnt=",16b" clr="20,0,96">Total Sucursal :</txt>		<sp n="1"/>		<inp id="tpdescsuc" dim="50,1" type="string" fnt=",16b" clr="20,0,96"/>		<sp n="8"/>		<inp id="spo" dim="3,1" type="string" modify="N" just="L" fnt=",0b" clr="20,0,96"/>		<inp id="tptotalsuc" dim="16,1" type="number" fnt=",16b" clr="20,0,96" nd="2"/> 		<inp id="spc" dim="1,1" type="string" modify="N" just="L" fnt=",0b" clr="20,0,96"/>		<br exe="totalsucursal"/> 		<hLine dim="90,0" g="1" type="1"/>		<br exe="totalsucursal"/>		<!-- END -- Totales x Sucursal -->						<!-- INI -- Detalle Ordenes Ceros -->		<br exe="detalle_2_tit"/>		<txt fnt=",18b">Ordenes Cerradas sin Cargo :</txt>		<br exe="detalle_2_tit"/>		<br exe="detalle_2_tit"/>		<inp id="tipo" dim="6,1" type="string" modify="N"/> <sp n="1"/>		<inp id="orden" dim="14,1" type="string"  modify="N" just="L" nc="-1"/><sp/> 		<inp id="fecha_ord" dim="10,1" type="date" modify="N" fmt="CCYY/MM/DD" nc="-1"/> <sp n="1"/>		<inp id="usuario" dim="13,1" type="string" modify="N"/> <sp n="1"/>		<inp id="motivo" dim="27,1" type="string" modify="N"/> <sp n="1"/>		<br exe="detalle_2"/>		<!-- END -- Totales x Sucursal -->						<!-- INI -- Totales x Gran Total -->		<br exe="total"/>		<hLine dim="90,0" g="2" type="1"/> 		<br exe="total"/> 		<txt fnt=",19b" clr="20,0,96">Gran Total del rango de fechas consultado : </txt>		<sp n="33"/>		<inp id="gpo" dim="3,1" type="string" modify="N" just="L" fnt=",0b" clr="20,0,96"/>		<inp id="gttotal" dim="18,1" type="number" clr="20,0,96" fnt=",19b" nd="2"/> 		<inp id="gpc" dim="1,1" type="string" modify="N" just="L" fnt=",0b" clr="20,0,96"/>		<br exe="total"/> 		<hLine dim="90,0" g="2" type="1"/> 		<br exe="total"/>		<!-- END -- Totales x Gran Total -->			</grp></pag>