<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Recepci&#243;n Activa">	<grp brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0" OnEnter="Exit()"><br/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="97,60,10,10" brdr="0,5" tit="Im&#225;genes de recepci&#243;n" fnt="Arial,16"><br/><tab/>			<img id="imagen" dim="900,500" bPx="1" brdr="0,1" available="Y"/><br/><br/><tab/>			<bot id="bot_anterior" dim="18,0" brdr="5" text="Anterior" OnEnter="Anterior()" default="1"/><tab/>			<bot id="bot_siguiente" dim="18,0" brdr="5" text="Siguiente" OnEnter="Siguiente()" default="1"/><tab n="2"/>			<inp id="edt_mensajes" dim="46,1" brdr="2,0" bclr="255,255,255" clr="1,18,254" clrBrdr="255,255,255" type="string" fnt=",20" modify="N" available="N"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb;			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, tipo_orden, orden, consecutivo, cuboImagenes ;			var totImagenes, curImagen,filePath,di;			var vin, fecha;						fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();				Inicializar();			}						fun Inicializar(){				sucursal_id= frn.param(0);				fecha= frn.param(1);				vin = frn.param(2);				consecutivo = 0;				frn.setAtt("imagen","img","");				frn.set("edt_mensajes","");								if (sucursal_id &= "" || vin &= "" || fecha &= ""){					frn.message("Sin parámetros suficiente de consuta." & sucursal_id & "; " & fecha & "; " & vin,"Error","Aceptar");					frn.set("edt_mensajes","Sin parámetros suficiente de consuta.");					return;				}												ObtenerRutas();			}						fun ObtenerRutas(){								//Obtener consecutivo				cmdQuery = "select consecutivo from keplersc.ser_ra_recepcion_activa ra where sucursal= '" & sucursal_id & "' ";				cmdQuery = cmdQuery & "and vin = '" & vin & "' and fecha >= '" & fecha & " 00:00:00' and fecha <='" & fecha & " 23:59:59' ";				cmdQuery = cmdQuery & "order by fecha desc limit 1" ;				rstXml(cuboQuery);								cuboQuery= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_imagenes_recepcion.ObtenerRutas()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery,"c:\Basura\xmlRecepciones");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												consecutivo=getXmlAtt(cuboQuery,"r0","consecutivo");				if (!consecutivo){					frn.set("edt_mensajes","No hay recepción activa registrada.");					return;				}				 												cmdQuery = "select reverse(split_part(reverse(ruta),'/',2)) as consecutivo, reverse(split_part(reverse(ruta),'/',1)) as archivo, tipo ";				cmdQuery = cmdQuery  & "from keplersc.ser_ra_archivos sra where consecutivo=" & consecutivo & " ";				rstXml(cuboImagenes);				cuboImagenes= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_imagenes_recepcion.ObtenerRutas()");				frn.lib("libGeneral.kpl","FileSave",cuboImagenes,"c:\Basura\xmlImagenes");				ok=getXmlAtt(cuboImagenes,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboImagenes,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				totImagenes = nXml(cuboImagenes);				totImagenes = totImagenes -1;				curImagen=0;				Anterior();			}						fun Anterior() {				if (curImagen > 0){					curImagen=curImagen-1;				}				MostrarImagen();			}						fun Siguiente() {				if (curImagen < totImagenes){					curImagen=curImagen+1;				}				MostrarImagen();			}							fun MostrarImagen(){				var tipo;				filePath=delScpScn("_recepcion_activa\\");				filePath=filePath & getXmlAtt(cuboImagenes,"r" & curImagen,"consecutivo") & delScpScn("\\"); 				filePath=filePath & getXmlAtt(cuboImagenes,"r" & curImagen,"archivo") ;				tipo=getXmlAtt(cuboImagenes,"r" & curImagen,"tipo");								frn.setAtt("imagen","img",filePath);				frn.set("edt_mensajes",tipo);			}		}	</script></pag>