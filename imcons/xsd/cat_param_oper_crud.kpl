<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Esquema por Punto"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0">	<br/>	<tab/><inp id="k_titulo" dim="50,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213" type="string" modify="N" available="N" fnt="Arial,22"/>	<br/><tab/><hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp dim="60,40,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Parametros Operativos">				<tab/><br/><sp/>		<tbl id="k_parametros" dim="58,21" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" insdel="N">			<col id="k_sucursal" name="Sucursal" nc="7" modify="N" available="N"/>			<col id="k_parametro" name="Parametro" nc="35" modify="N" available="N"/>			<col id="k_valor_actual" name="Valor Actual" nc="35" modify="N" available="N"/>			<col id="k_valor_nuevo" name="Nuevo Valor" type="string" nc="35" OnChange="Guardar()" modify="Y" available="Y"/>		</tbl><br/><br/>	</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco, externo ;			var tipoOper; //Variables relacionadas con parametros			var consAdmin, consControl, consPlantilla, consCargarHorasTab,consCierraAbrePuntosTab ,consCargos,consCargosSel,consRefsCierra,consRefsAbre,				consIniciarTerminarTrabajo,consCargosAbre,consTotsCierra,consCargosCierra ,consTotsAbre,consCalidadAlta, resVal,				consCalidadBaja,consAutorizaCierre,consAbreOrdenGeneral,consCierraOrdenGeneral;			var consCuestPre, consCuestEnt, consCuestWlka ; //CUEST			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";				Inicializa();				Buscar();						}			fun Inicializa(){				var cmd,cubo,ok,mensajeError ;				frn.set("k_titulo","Configuracion de Parametros Generales");			}			fun ResetResults(){				frn.rst("k_parametros");				Buscar();			}					fun ValidarDatos(){				var	val1, val2;				resVal=1;			}			fun Guardar() {				var cmdQuery, mensajeError, xmlRequest, cubo ;				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}							var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}				rstXml(xmlRequest);				setXml(xmlRequest ,"k_usuario",usuario);				setXml(xmlRequest ,"k_sucursal",frn.get("k_parametros",-1,"k_sucursal"));				setXml(xmlRequest ,"k_parametro",frn.get("k_parametros",-1,"k_parametro"));				setXml(xmlRequest ,"k_valor_actual",frn.get("k_parametros",-1,"k_valor_actual"));				setXml(xmlRequest ,"k_valor_nuevo",frn.get("k_parametros",-1,"k_valor_nuevo"));								frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequestParamOper");				cmdQuery="SELECT * FROM keplersc.cat_param_oper_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_param_oper_crud.Guardar()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResParamOper");									var resultado=getXml(cubo ,"resultado");				if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.message("Registro Guardado","Mensaje","Aceptar");				Buscar();			}				fun Buscar() {				var xmlRequest,cmd,ok,cuboResultados, totOrd , contOrd, ref_clave, ref_desc;				var anio;				//llena datos de la orden				cmd= "select sucursal as k_sucursal, parametro as k_parametro, valor as k_valor_actual, valor as k_nuevo_valor ";				cmd=cmd & "from keplersc.param_oper";				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRequest");				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ordenentsaluni.Buscar()");				ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboParametros");				//xmlRequest=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboResultados);				frn.setX(cuboResultados,"k_parametros");			}											fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>