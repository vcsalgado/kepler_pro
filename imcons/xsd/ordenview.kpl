<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Ordenes Taller"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0">	<br/>	<tab/><inp id="inp_titulo" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>	<br/><tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp dim="100,45,10,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="&#211;rdenes de taller">					<tab n="1"/><txt clr="0,58,112" hk="S">Sucursal</txt>			<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="22,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><sp n="1"/><txt clr="0,58,112" hk="S">Tipo</txt>			<cmb id="tipo" clr="64,64,64" clrBrdr="255,255,255"  dim="10,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><sp/><txt>Orden:</txt>			<inp id="input_orden" dim="8,1" brdr="2,0" clr="64,64,64" OnChange="Formar_folio()" bclr="255,255,255" clrBrdr="255,255,255"/>			<sp/><txt>Serie:</txt>			<inp id="input_serie" dim="12,1" OnF9="obtenerSerie()"  brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="string"/><sp/><txt>Cliente:</txt>			<inp id="input_cliente" dim="8,1" OnF9="obtenerCliente()" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><sp/>			<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			<br/>			<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="92,22" modify="N" nren="fijo">				<col id="sucursal" name="Sucursal"/>				<col id="orden" name="Orden"/>				<col id="tipo" name="Tipo"/>				<col id="fecha" name="Fecha"/>				<col id="flujo_admon" name="Flujo Admon"/>				<col id="flujo_servicio" name="Flujo Servicio"/>				<col id="vin" name="Vin"/>				<col id="placas" name="Placas"/>				<col id="bonete" name="Bonete"/>				<col id="cliente" name="Cliente"/>				<col id="nombre" name="Nombre"/>			</tbl> 			<tab n="7"/>			<br/>			<tab n="1"/><bot id="bot_seleccionar" dim="14,0" brdr="5" text="Seleccionar" default="0" OnEnter="MostrarOpcion()"/>			<tab n="6"/>			<inp id="reg_mostrados" dim="58,1" clr="0,0,0"  type="string" modify="N" available="N" fnt="Arial,16"/>			<br/>			<tab n="13"/>			<bot id="banterior"  dim="6,10" brdr="5" text="&lt;&lt;" fnt="Arial,16" OnEnter="Buscar(-100)" visible="N" tooltip="Anterior p&#225;gina de resultados" available="N" modify="N"/>			<tab/>			<bot id="bsiguiente"  dim="6,0" brdr="5" text="&gt;&gt;" fnt="Arial,16" OnEnter="Buscar(100)" visible="N" tooltip="Siguiente p&#225;gina de resultados" available="N" modify="N"/>		</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco, externo ;			var tipoOper; //Variables relacionadas con parametros			var consAdmin, consControl, consPlantilla, consCargarHorasTab,consCierraAbrePuntosTab ,consCargos,consCargosSel,consRefsCierra,consRefsAbre,				consIniciarTerminarTrabajo,consCargosAbre,consTotsCierra,consCargosCierra ,consTotsAbre,consCalidadAlta,				consCalidadBaja,consAutorizaCierre,consAbreOrdenGeneral,consCierraOrdenGeneral;			var consCuestPre, consCuestEnt, consCuestWlka ; //CUEST			var offset, cuboXml;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";				offset =0;											ConfiguraUI();								Inicializa();						}						fun ConfiguraUI(){				consAdmin="ADMINISTRAR";				consControl="CONTROL";				consCargarHorasTab="CARGAR_HORAS_TAB";				consCierraAbrePuntosTab="CIERRA_ABRE_PUNTOS_TAB";				consCargos="CARGOSVARIOS";				consCargosSel="CONSULTACARGOS";				consCargosCierra = "CARGOSCIERRA";				consCargosAbre = "CARGOSABRE";				consTotsCierra = "TOTSCIERRA";				consTotsAbre = "TOTSABRE";				consRefsCierra = "REFSCIERRA";				consRefsAbre = "REFSABRE";				consCalidadAlta = "CALIDADALTA";				consCalidadBaja = "CALIDADBAJA";				consPlantilla="PLANTILLA";					consIniciarTerminarTrabajo	="INI_TER_TRABAJO";					consAutorizaCierre = "AUTORIZA_CIERRE";				consAbreOrdenGeneral = "ABRE_ORDEN_GENERAL";				consCierraOrdenGeneral = "CIERRA_ORDEN_GENERAL";				consCuestPre="CUESTPRE"; //CUEST				consCuestEnt="CUESTENT"; //CUEST				consCuestWlka = "CUESTWLKA";							if (frn.nParam() == 0){					frn.message("Acciï¿½n no permitida.","Error","&Aceptar");					frn.open("redirect",2);					return;				}				tipoOper = frn.param(0);				//Establecer titulo de la ventana				if (tipoOper &= consAdmin){					frn.set("inp_titulo","Administraciï¿½n de ï¿½rdenes");				}else if(tipoOper &= consControl){					frn.set("inp_titulo","Control");				}else if(tipoOper &= consCargarHorasTab){					frn.set("inp_titulo","Cargar Horas Tabulacion");				}else if(tipoOper &= consCierraAbrePuntosTab){					frn.set("inp_titulo","Cierra/Abre puntos Tabulacion");				}else if(tipoOper &= consCargos){					frn.set("inp_titulo","Carga Cargos");				}else if(tipoOper &= consCargosSel){					frn.set("inp_titulo","Consulta Cargos");				}else if(tipoOper &= consCargosCierra){					frn.set("inp_titulo","Cierra Orden Cargos Varios");					}else if(tipoOper &= consCargosAbre){					frn.set("inp_titulo","Abre Orden Cargos Varios");						}else if(tipoOper &= consTotsCierra){					frn.set("inp_titulo","Cierra Orden TOTs");					}else if(tipoOper &= consTotsAbre){					frn.set("inp_titulo","Abre Orden TOTs");				}else if(tipoOper &= consRefsCierra){					frn.set("inp_titulo","Cierra Orden Refacciones");				}else if(tipoOper &= consRefsAbre){					frn.set("inp_titulo","Abre Orden Refacciones");				}else if(tipoOper &= consCalidadAlta){					frn.set("inp_titulo","Alta Registro de Calidad");					}else if(tipoOper &= consCalidadBaja){					frn.set("inp_titulo","Baja Registro de Calidad");								}else if(tipoOper &= consPlantilla){					frn.set("inp_titulo","Plantilla...");														}else if(tipoOper &= consIniciarTerminarTrabajo	){					frn.set("inp_titulo","Iniciar/Terminar Trabajo");														}else if(tipoOper &= consAutorizaCierre){					frn.set("inp_titulo","Autoriza Cierre");														}else if(tipoOper &= consAbreOrdenGeneral ){					frn.set("inp_titulo","Abre Orden");														}else if(tipoOper &= consCierraOrdenGeneral ){					frn.set("inp_titulo","Cierra Orden");														}else if(tipoOper &= consCuestPre ){					frn.set("inp_titulo","Actividades Pre-entrega");														}else if(tipoOper &= consCuestEnt ){					frn.set("inp_titulo","Actividades Entrega");				}else if(tipoOper &= consCuestWlka ){					frn.set("inp_titulo","Walkaround");				}else{					frn.message("Acciï¿½n no permitida.","Error","&Aceptar");					frn.open("redirect",2);					return;				}			}									fun Inicializa(){				var cmd,cubo,ok,mensajeError ;				//Llenar combo tipo orden				cmd = "select c1||'-'||c3 as descripcion, c1 as clave  from keplersc.kdmargen";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ordenTallDetalles.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){				   mensajeError = getXmlAtt(cubo,"native3");				   mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						   var cmd_tipo_orden = "tipo";					//MSS: Pongo por default la orden T para que al buscar no se quede bloqueado y quito las sig lineas, agrego if frP.get.. y ejecute linea q ya tenia				frn.setX("", cmd_tipo_orden ,0,0);				frn.setX("", cmd_tipo_orden , 0, 1);									llenar_cmb(cubo ,cmd_tipo_orden );				frn.set(cmd_tipo_orden ,descr_combo(cmd_tipo_orden ,1,frP.get("k_tipo_orden")));								/*				frn.set(cmd_tipo_orden,cubo);				frn.set(cmd_tipo_orden ,descr_combo(cmd_tipo_orden ,1,"T"));				if (frP.get("k_tipo_orden") &! "" && !frP.get("k_tipo_orden")){ 					frn.set(cmd_tipo_orden ,descr_combo(cmd_tipo_orden ,1,frP.get("k_tipo_orden")));				}				*/				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));				frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));				}						fun valida_offset(n_reg_tabla){				var txt = "Mostrando registros del " & (offset+1) & " al " & offset + 100 & " de " & n_reg_tabla;				if (offset <= 0) {											frn.setAtt("banterior", "available", "N" );					frn.setAtt("banterior", "modify", "N" );					frn.setAtt("banterior", "visible", "N" );				}else{					frn.setAtt("banterior", "available", "Y" );					frn.setAtt("banterior", "modify", "Y" );					frn.setAtt("banterior", "visible", "Y" );				}								if (offset+100 >= n_reg_tabla){					frn.setAtt("bsiguiente", "available", "N" );					frn.setAtt("bsiguiente", "modify", "N" );					frn.setAtt("bsiguiente", "visible", "N" );					txt = "Mostrando registros del " & (offset+1) & " al " & n_reg_tabla & " de " & n_reg_tabla;								}else{					frn.setAtt("bsiguiente", "available", "Y" );					frn.setAtt("bsiguiente", "modify", "Y" );					frn.setAtt("bsiguiente", "visible", "Y" );				}				frn.set("reg_mostrados", txt);			}			fun Buscar(pag) {							var xmlRequest,cmd,ok,cuboResultados, totOrd , contOrd, ref_clave, ref_desc, n_reg_tabla;						var folio_orden = frn.get("input_orden");				var suc_bus = frn.get("k_sucN", -1, 1);				var tipo_orden = frn.get("tipo", -1, 1);				var cli = frn.get("input_cliente");				var serie = frn.get("input_serie");				if (pag==0){					offset=0;				}				offset = offset+pag;				//if ((serie &= "" ) && (cli &= "" ) && (tipo_orden &= "") && (folio_orden &= "" )){				//	frn.message("Seleccione por lo menos un criterio de búsqueda","Atención","Aceptar");				//	return ;				//}										cmd= "select ord.c1,ord.c2,ord.c3,to_char(ord.c4, 'dd/mm/yyyy')as fch ,ord.c6,ord.c7,ord.c8,ord.c10,ord.c11,ord.c19,ord.c21 from keplersc.kdord as ord ";				cmd = cmd & " inner join keplersc.kdpun as pun on ord.c1=pun.c1 and ord.c2=pun.c2 and ord.c3=pun.c3 ";												if(tipoOper &= consIniciarTerminarTrabajo	){									var cmd_ope =  " select c1 from keplersc.kdoper where c20 ='" & usuario  & "'";										var cubo_ope = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd_ope ,"ordenview.Buscar()");									var clave_ope = getXmlAtt(cubo_ope ,"r0","c1");										cmd = cmd & " and pun.c9= '" & clave_ope  & "'";									}												cmd = cmd & " where ord.c1='" & suc_bus  & "'";								if (tipo_orden &! ""){					cmd = cmd & " and ord.c2='" & tipo_orden & "'";				}								if (folio_orden &! "" ){					cmd = cmd & " and ord.c3 like '%" & folio_orden & "%'";				}								if (cli &! "" ){					cmd = cmd & " and ord.c10='" & cli & "'";				}								if (serie &! "" ){					cmd = cmd & " and ord.c6='" & serie & "'";				}															cmd = cmd & " group by ord.c1,ord.c2,ord.c3 order by ord.c4 desc,ord.c4 desc ";									n_reg_tabla = "SELECT COUNT(*) FROM ("& cmd &") AS subconsulta";				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",n_reg_tabla,"gencatalogoview.buscar_registros()");				frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\registros");				n_reg_tabla = getXmlAtt(cuboXml,"r0","count");				valida_offset(n_reg_tabla);				cmd = cmd & " LIMIT 100 OFFSET " & offset;				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRequest");									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ordenview.Buscar()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								totOrd = nXml(cuboResultados);							frn.rst("tabla");				for (contOrd=0; contOrd<totOrd ; contOrd++){								frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c1"),"tabla",contOrd,"sucursal");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c3"),"tabla",contOrd,"orden");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c2"),"tabla",contOrd,"tipo");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"fch"),"tabla",contOrd,"fecha");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c6"),"tabla",contOrd,"vin");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c7"),"tabla",contOrd,"flujo_admon");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c8"),"tabla",contOrd,"flujo_servicio");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c21"),"tabla",contOrd,"placas");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c10"),"tabla",contOrd,"cliente");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c11"),"tabla",contOrd,"nombre");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c19"),"tabla",contOrd,"bonete");				}							}								fun MostrarOpcion(){				var sucursal= frn.get("tabla", -1, "sucursal");				var tipo= frn.get("tabla", -1, "tipo");									var folio= frn.get("tabla", -1, "orden");					var vin = frn.get("tabla", -1, "vin");					var cliente = frn.get("tabla", -1, "cliente");				var nombre = frn.get("tabla", -1, "nombre");									if (folio &= ""){					frn.message("No ha seleccionado una Orden válida","Error","Aceptar");					return ; 				}				//Mostrar UI de opcion 				if (tipoOper &= consAdmin){					frn.dialog("administracionordenes",sucursal, tipo, folio, vin );				}else if(tipoOper &= consControl){					frn.dialog("srvcontrolpuntos",sucursal,tipo,folio, vin );				}else if(tipoOper &= consCargarHorasTab){					frn.dialog("srv_cargar_horas",sucursal,tipo,folio, vin );				}else if(tipoOper &= consCierraAbrePuntosTab){					frn.dialog("srvcierraabrepuntos",sucursal,tipo,folio, vin );				}else if(tipoOper &= consCargos){					frn.dialog("srvcargosvarios",sucursal,tipo,folio,"A");				}else if(tipoOper &= consCargosSel){					frn.dialog("srvcargosvarios",sucursal,tipo,folio,"C");				}else if(tipoOper &= consCargosCierra){					frn.dialog("srvabrecierraordcargtotsrefs",sucursal,tipo,folio,"CARGOS","C");				}else if(tipoOper &= consCargosAbre){					frn.dialog("srvabrecierraordcargtotsrefs",sucursal,tipo,folio,"CARGOS","A");								}else if(tipoOper &= consTotsCierra){					frn.dialog("srvabrecierraordcargtotsrefs",sucursal,tipo,folio,"TOTS","C");				}else if(tipoOper &= consTotsAbre){					frn.dialog("srvabrecierraordcargtotsrefs",sucursal,tipo,folio,"TOTS","A");				}else if(tipoOper &= consRefsCierra){					frn.dialog("srvabrecierraordcargtotsrefs",sucursal,tipo,folio,"REFS","C");				}else if(tipoOper &= consRefsAbre){					frn.dialog("srvabrecierraordcargtotsrefs",sucursal,tipo,folio,"REFS","A");				}else if(tipoOper &= consCalidadAlta){					frn.dialog("srvregistrocalidad",sucursal,tipo,folio,"A");					}else if(tipoOper &= consCalidadBaja){					frn.dialog("srvregistrocalidad",sucursal,tipo,folio,"B");						}else if(tipoOper &= consPlantilla){					frn.dialog("plantillaOrden",sucursal,tipo,folio, vin );				}else if(tipoOper &= consIniciarTerminarTrabajo	){					frn.dialog("admn_ini_ter_trabajo",sucursal,tipo,folio, vin );				}else if(tipoOper &= consAutorizaCierre ){					frn.dialog("srv_autoriza_cierre",sucursal,tipo,folio);				}else if(tipoOper &= consAbreOrdenGeneral ){					frn.dialog("srvabrirorden",sucursal,tipo,folio );				}else if(tipoOper &= consCierraOrdenGeneral ){					frn.dialog("srvcerrarorden",sucursal,tipo,folio, vin );				}else if(tipoOper &= consCuestPre){					frn.dialog("srv_cuest_pre",tipoOper, sucursal,tipo,folio, vin, cliente, nombre);				}else if(tipoOper &= consCuestEnt){					frn.dialog("srv_cuest_pre",tipoOper, sucursal,tipo,folio, vin, cliente, nombre);				}else if(tipoOper &= consCuestWlka){					frn.dialog("srv_cuest_pre",tipoOper, sucursal,tipo,folio, vin, cliente, nombre);				}else{					frn.message("Funcion no desarrollada.","Error","&Aceptar");				}							}														//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------									fun Formar_folio(){							var xmlReqEst, cubofol, cmd, ok, mensajeError ;				if (frn.get("input_orden") &! ""){				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucN",-1,1));					setXml(xmlReqEst,"document","folio_id",frn.get("input_orden"));										cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";					cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");					frn.lib("libGeneral.kpl","FileSave",cubofol,"C:\Basura\cuboFol");									var resultado =getXmlAtt(cubofol,"r0", "resultado");					if(resultado &= "0"){						mensajeError = getXmlAtt(cubofol,"r0", "mensaje");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					var fol = getXmlAtt(cubofol,"r0", "mensaje");										frn.set("input_orden", fol);				}			}									fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}									fun obtenerSerie(){		//MSS: reemplazar cat_vin_view				var cmdQuery, sucursal_id;				sucursal_id=frn.get("k_sucn", -1, 1);				cmdQuery = "select s.c1 as identificador,s.c2 as marca,s.c3 as modelo,s.c4 as serie,s.c10 as color,s.c11 as año,s.c8 as placas,s.c9 as contacto, cli.c3 as nombre								from keplersc.kdserie as s								inner join keplersc.kdud as cli on s.c9=cli.c2 ";				frn.dialog("genlistafiltrosel","Catálogo de Series",cmdQuery,"identificador","input_serie","0","0","S","N");			}						fun obtenerCliente(){		//MSS: reemplazar cat_vin_view				var cmdQuery, sucursal_id;				sucursal_id=frn.get("k_sucn", -1, 1);				cmdQuery = "select cli.c2 as clave, cli.c3 as nombre from keplersc.kdud as cli ";				frn.dialog("genlistafiltrosel","Catálogo de clientes",cmdQuery,"clave","input_cliente","0","0","S","N");			}												fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>