<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Terminar Trabajos"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/><inp id="titulo_pantalla" clr="0,0,0"  dim="25,1" brdr="0,1" fnt=",22" available="N"/><br/>	<tab/><hLine/>	<br/><br/>	<tab/>	<grp dim="100,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle de la orden">			<sp/><txt fnt=",b">Sucursal:</txt><sp/><inp id="k_sucursal" dim="5,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<sp/><inp id="k_sucnombre" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/><tab/><txt fnt=",b">Fecha:  </txt>			<inp id="k_fecha" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" modify="N" available="N" fmt="DD/MM/CCYY" nc="-1" fnt=",0"/><tab/><txt fnt=",b">Estatus:</txt>			<inp id="k_estatusdesc" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/><tab n="2"/>			<br/>			<sp/><txt  fnt="Arial,b">Tipo:</txt><sp/><inp id="k_tipo" clr="64,64,64"  dim="3,1" fnt="Arial,0" clrBrdr="255,255,255"   bclr="255,255,255" modify="N" visible="Y" type="string" brdr="2,0"/>			<sp/><inp id="k_tipodesc" dim="25,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" fnt=",0" modify="N" available="N"/>			<tab/><txt  fnt="Arial,b">Folio:</txt><sp/><inp id="k_folio" clr="64,64,64"  dim="18,1" fnt="Arial,0" clrBrdr="255,255,255"   bclr="255,255,255" brdr="2,0"  modify="N" visible="Y" type="string"/>			<tab/><txt fnt=",b">Cliente: </txt><sp/><inp id="k_cliente" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<sp/><inp id="k_nombre" dim="50,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<br/>			<sp/><txt fnt=",b">VIN: </txt><sp/><inp id="k_serie" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b"> Marca:</txt><sp/>	<inp id="k_marca" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b">Modelo:</txt><sp/><inp id="k_modelo" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b">A&#241;o:</txt><sp/><inp id="k_anio" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b">Placas:</txt><sp/><inp id="k_placa" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>			<tab/><txt fnt=",b">Bonete:</txt><sp/><inp id="k_bonete" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",0"/>	</grp>	<br/><br/>		<tab n="1"/>	<grp id="gpo_mantto" dim="100,40,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="">		<grp dim="140,40,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">			<sp/>			<tab n="24"/><txt fnt=",0b">Estatus: </txt><txt>B=BUENO; R=REGULAR; S=SE REALIZO; M=MALO; N= NO APLICA</txt><br/>			<tab/>			<tbl id="tbl_componentes" dim="135,23" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243">				<col id="cve_comp" name="Clave" modify="N" available="N"/>				<col id="desc_comp" name="Componenetes de mantenimiento" available="N"/>				<col id="estatus" name="Estatus" type="capital" modify="Y" available="Y" OnChange="estatus()"/>				<col id="observaciones" name="Observaciones" modify="Y" available="Y" type="capital"/>			</tbl>			<tab/><br/><br/>			<tab n="43"/><sp/>			<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><br/>		</grp>		<br/>		</grp>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco, externo, sucursal,folio_orden, tipo_orden , vin, tipo_mantto, tabla;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();												usuario = frn.config("user","name");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								sucursal =trim(frn.param(0));				folio_orden=trim(frn.param(1));				tipo_orden=trim(frn.param(2));				tipo_mantto=trim(frn.param(4));				Inicializa();			}												fun Inicializa(){							var cmd, cubo, ok, mensajeError, xmlOrden, xmlDatos;								if (tipo_mantto &= "C"){					frn.set("titulo_pantalla", "Servicio Completo");					frn.setAtt("gpo_mantto","tit","Plan de Mantenimiento de 40,000  80,000  120,000  y  160,000 kms");					tabla = "kdcomp";				} else if (tipo_mantto &= "M") {					frn.set("titulo_pantalla", "Servicio Medio");					frn.setAtt("gpo_mantto","tit","Plan de Mantenimiento de 20,000 60,000 140,000 180,000 kms");					tabla = "kdcompmedio";				} else if (tipo_mantto &= "B") {					frn.set("titulo_pantalla", "Servicio Basico");					frn.setAtt("gpo_mantto","tit","Plan de Mantenimiento de 10,000  30,000  50,000  70,000  90,000  110,000 kms");					tabla = "kdcompb";				}								xmlOrden= frn.lib("libOrdenes.kpl","ConsultaOrden",sucursal,tipo_orden,folio_orden);								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				xmlDatos = frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",xmlOrden,"r0");				frn.lib("libGeneral.kpl","FileSave",xmlOrden,"C:\Basura\xmlOrden");					frn.lib("libGeneral.kpl","FileSave",xmlDatos,"C:\Basura\xmlDatos");							frn.setX(xmlDatos);													cmd =	"select cp.c1,cp.c2,orden.c6,orden.c7 from keplersc." & tabla & " cp " &						"left join (select * from keplersc.kdcompord co where co.c1='" & sucursal &"' and co.c2='" & tipo_orden & 						"' and co.c3='" & folio_orden & "' and co.c8='" & tipo_mantto & "') orden on orden.c4=cp.c1 " &						"where cp.c3='10'";										rstXml(cubo);					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_componenetes_mantto.Inicializa()");					frn.lib("libGeneral.kpl","FileSave",cubo,"c:\Basura\componentes_mantto");					ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}						frn.setX(cubo,"tbl_componentes");					}						fun estatus(){				if (strlen(frn.get("tbl_componentes",-1,"estatus")) == 1){					if (frn.get("tbl_componentes",-1,"estatus") &= " "){						frn.setPos("tbl_componentes",-1,"estatus");						frn.message("No se permiten espacios en blanco","Error","Aceptar");					} else if (frn.get("tbl_componentes",-1,"estatus") &= "S"){						frn.setX("SE REALIZO","tbl_componentes",-1,"estatus");					} else if (frn.get("tbl_componentes",-1,"estatus") &= "B"){						frn.setX("BUENO","tbl_componentes",-1,"estatus");					} else if (frn.get("tbl_componentes",-1,"estatus") &= "R"){						frn.setX("REGULAR","tbl_componentes",-1,"estatus");					} else if (frn.get("tbl_componentes",-1,"estatus") &= "M"){						frn.setX("MALO","tbl_componentes",-1,"estatus");					} else if (frn.get("tbl_componentes",-1,"estatus") &= "N"){						frn.setX("NO APLICA","tbl_componentes",-1,"estatus");					} else {						frn.setPos("tbl_componentes",-1,"estatus");						frn.message("Solo puede ser SE REALIZO, BUENO, REGULAR, MALO o NO APLICA","Error","Aceptar");					}				} else {					if (frn.get("tbl_componentes",-1,"estatus") &! "SE REALIZO" && frn.get("tbl_componentes",-1,"estatus") &! "BUENO" && frn.get("tbl_componentes",-1,"estatus") &! "REGULAR" && frn.get("tbl_componentes",-1,"estatus") &! "MALO" && frn.get("tbl_componentes",-1,"estatus") &! "NO APLICA"){						frn.setPos("tbl_componentes",-1,"estatus");						frn.message("Solo puede ser SE REALIZO, BUENO, REGULAR, MALO o NO APLICA","Error","Aceptar");					}								}			}						fun Ejecuta() {				var xmlPantalla,continua, cmd, cubo, ok, mensajeError;				var resultado, mensaje, folio;								continua = frn.message("Desea continuar con el Registro de Componentes?","Atencion",2);				if (continua == 0){					return;				}								xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				setXml(xmlPantalla,"tbl_componentes","no_partidas",frn.N("tbl_componentes")-1);				setXml(xmlPantalla,"tabla",tabla);				setXml(xmlPantalla,"tipo_mantto",tipo_mantto);									frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"c:\Basura\XmlPantallaComponentes");				cmd = "SELECT * FROM keplersc.ser_componentes_mantto('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				rstXml(cubo);					cubo= frn.lib("libGeneral.kpl","EjecutarSql",cmd,"srv_componentes_mantto.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cubo, "c:\Basura\XmlResultadoComponentes");										resultado = getXml(cubo,"resultado");				mensaje = getXml(cubo,"mensaje");										ok = getXmlAtt(cubo,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					frn.message(mensaje, "Mensaje", "Aceptar");					return;				} else {					frn.message(mensaje, "Error", "Aceptar");					return;				}							}						fun salir (){							frn.exit();			}							//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------								fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}																}	</script></pag>