		<grp dim="110,4,7,13" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos del Pedido Sugerido : ">	
			<sp n="1"/> <txt>Sucursal :</txt> 
			<sp n="1"/> <inp id="c_suc" dim="5,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>
			<sp n="1"/> <inp id="k_suc" dim="35,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/> 
			<sp n="6"/> <txt>Referencia : </txt> 
			<inp id="c_ref" dim="10,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>
			<sp n="6"/> <txt>Estatus : </txt> 
			<inp id="c_st" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>
			<br/>

			<!--
			<br/>		
			<sp n="1"/> <txt clr="132,20,7">ERR LN Descrip : </txt>
			<br/>
			<sp n="1"/> <inp id="k_err" dim="53,2" clr="132,20,7" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="50"/>
			-->
				
		</grp>

		<!-- <sp n="1"/> -->
		<br/> 
		<br/>
		
		<grp dim="110,18,7,15" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Partidas ">

			<sp n="1"/> 
				<tbl id="k_mov" dim="155,15" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" hk="z" OnChange="CalcTotal()" Reorder="N" modify="Y" insdel="N" nren="fijo">
				
				<col id="k_st" name="ST"  type="capital" nc="18" modify="N" available="N"/>
				
				<col id="k_parte" name="Clave"  type="capital" nc="18" modify="N" available="N"/>
			   <col id="k_descr" name="Descripcion"  modify="N" nc="30" available="N"/>		
				<col id="k_pedesp" name="Pedido Especial"  type="number" nd="2" min="0" modify="N" OnF9="" OnMouseL="" 
					OnChange="" OnActive="" OnF10="" visible="Y" available="N"/>
				<col id="k_sugstck" name="Sugerido Stock"  type="number" nd="2" OnChange="" OnF9="" OnMouseL="" modify="N" available="N"/>
				<col id="k_surtstck" name="Surtir p/Stock"  type="number" nd="2" min="0" modify="Y" available="Y" visible="Y" OnChange="CalculaTotales(0)"/>
				<col id="k_cantped" name="Pedido"  type="number" nd="2" modify="N" available="N" visible="Y"/>
				<col id="k_factor" name="Factor Conv."  type="number" nd="2" min="0" OnF9="" OnMouseL="" 
					OnChange="" OnActive="" OnF10="" modify="N" visible="Y" available="N"/>
				<col id="k_mip" name="MIP"  type="number" nd="2" min="0" OnF9="" OnMouseL="" 
					OnChange="" OnActive="" OnF10="" modify="N" visible="Y" available="N"/>
				<col id="k_inv" name="Existencias"  type="number" nd="2" min="0" OnF9="" OnMouseL="" 
					OnChange="" OnActive="" OnF10="" modify="N" available="N"/>
				<col id="k_bckord" name="BackOrder"  type="number" nd="2" modify="N" available="N" visible="Y"/>					
				<col id="k_citas" name="Citas"  type="number" nd="2" min="0" OnF9="" OnMouseL="" 
					OnChange="" OnActive="" OnF10="" modify="N" available="N"/>	
					
				<col id="k_h11" name="H11"  type="number" nd="2" min="0" OnF9="" OnMouseL="" 
					OnChange="" OnActive="" OnF10="" modify="N" available="N" visible="N"/>	
				<col id="k_h12" name="H12"  type="number" nd="2" min="0" OnF9="" OnMouseL="" 
					OnChange="" OnActive="" OnF10="" modify="N" available="N" visible="N"/>	
							
			</tbl>
			<br/>

		</grp>

		<br/>
