	<script>
		InstallDriver("KDB75");
		
		class Main {
			var frn,kdb, sys, rep, frP;
			var usuario, rol_usuario, suc_usuario, anio_contable;
			// Our Ctrl Vars
			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal;
			var fileSavePath, tip_ope_original/*220726*/;
									
			// Vars Parameters
         var row_grid, err_data, err_empty, fech_original, view_adicionales, serie_original, descrip_original;
         
         var paramSuc, paramRef, paramRutina, paramST;
							
			fun Main() {
				frn=new FRNT;
				kdb=new KDB;
				rep=new REP;
				frP=new FRNTP;
				sys=new SYS;
				kdb.connect();
				kdb.kde("KDE");
				kdb.exec();
				anio_contable = kdb.get("KDE","14");
				usuario = frn.config("user","name");
				rol_usuario = frn.config("user","role");
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";
				fileSavePath = "C:\Basura";
				
				err_empty = 0;
				err_data = 0;
				
				Inicializa();				
				//ConfiguraControlesOpcion();
	
			} /* END Func Main() */

							
			fun Valid_Data() {
				var ErrText, ErrTextFull;
				var ResVal = 1;
				
				ErrText = "";
				ErrTextFull = "";
				frn.setX("", "k_err_d");
				
				if ( strlen( frn.get("c_suc") ) == 0 ) {
					ErrTextFull = ErrTextFull & "[ Sin Sucursal ]"  & " | " ;
					ResVal = 0;			
				}

				if ( strlen( frn.get("c_ref") ) == 0 ) {
					ErrTextFull = ErrTextFull & "[ Sin Referencia ]"  & " | " ;
					ResVal = 0;			
				}
				
				if ( strlen( frn.get("c_st") ) == 0 ) {
					ErrTextFull = ErrTextFull & "[ Sin Estatus ]" & " | " ;
					ResVal = 0;			
				} else {
					if ( frn.get("c_st") &! "10" ) {
						ErrTextFull = ErrTextFull & "[ Estatus <> 10 ]" & " | " ;
						ResVal = 0;					
					}
				}
				
				if (frn.N("k_mov") == 0) {
					ErrTextFull = ErrTextFull & "[ Sin Partidas ]" & " | " ;
					ResVal = 0;
				}
				
				
				if ( ResVal == 0 ) {
					frn.setX(ErrTextFull, "k_err_d");
					// return ResVal;
				}
				
				
				for (var i=0; i<frn.N("k_mov"); i++) {
					frn.setPos("k_mov",i,"k_surtstck");
					ErrText = CalculaTotales(1);
					ErrTextFull = ErrTextFull & ErrText;
				}
				
				frn.setX(ErrTextFull, "k_err_d");
				
			} /*END Func Valid_Data()*/


			fun Cancela() {
				//if ( strlen( trim(paramRutina) ) > 0 ) { frP.script(paramRutina); }
				frn.exit();
			} /* END Func Cancela() */
			
			
			fun Ejecuta() {
				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg;
				var resultado, mensaje, adicionales, folio;
				var RowErr, iLim;
							
				iLim = frn.N("k_mov") - 1;
				
				//Get_Data_Row();
				Valid_Data();
							
				if ( strlen( trim(frn.get("k_err_d")) ) > 0 ) {
					frn.message("Existen Errores en los Datos, No se podra Actualizar la Informacion del Pedido Sugerido ... ", "Alto !!! ", "Aceptar");
					return;
				}
	
				//fecha = sys.date();
				//hora = sys.time();
				
				resultado = "";
				mensaje = "";
				adicionales = "";
				
				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
				
				setXml(xmlPantalla,"k_mov","no_partidas", iLim);
					
				frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\XmltoPostgres_KDPEDREFMOV_UPD");
				
				// FOR TESTING 
				/*
				frn.message("Los Datos del Pedido Sugerido se Procesaran ... ", "Info !!! ", "Aceptar");
				return;
				*/
									
				// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 
			
				cmdQuery="SELECT * FROM keplersc.tbl_kdpedrefmov_upd('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";
				rstXml(cuboQuery);
				cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"tbl_kdpedrefmov_upd.Ejecuta");				

				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_KDPEDREFMOV_UPD");
					
				// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 
						
				/*
				resultado = "1";
				mensaje = "Las partidas han sido registradas exitosamente ..." & "|" & "Testing Pipe separator";
				//adicionales = "Testing Active Button ...";
				*/
					
				// /*
				resultado = getXml(cuboQuery,"resultado");
				mensaje = getXml(cuboQuery,"mensaje");
				adicionales = getXml(cuboQuery,"adicionales");
				// */
													
				if( resultado &= "1" ) {
					/*
					if ( strlen(adicionales ) == 0 ) {
						frn.message("Resultado [" & resultado & "] ; " & mensaje, "Info !!! ", "Aceptar");
					} else {
						frn.message("Resultado [" & resultado & "] ; " & mensaje & "|" & adicionales , "Info !!! ", "Aceptar");
					}
					*/
					frn.message("Resultado [" & resultado & "] ; " & mensaje, "Info !!! ", "Aceptar");
					
					MostrarDatos();
					MostrarDatosGrd();
					
					//frn.setPos("c_pq01");
					
					//if ( strlen( trim(paramRutina) ) > 0 ) { frP.script(paramRutina); } // 221010

				} else {
					if ( strlen(adicionales ) == 0 ) {
						frn.message(mensaje, "Error", "Aceptar");
					} else {
						frn.message(mensaje & "|" & adicionales, "Error", "Aceptar");
					}

					MostrarDatos();
					MostrarDatosGrd();
				}

			} /* END Func Ejecuta() */
						

			fun Inicializa(){ //Inicializa los valores en Pantalla
				// Our code
				var fech_init, strFecha, strTmp,fecha; 

				ConfiguraControlesOff();
				paramSuc = "";
				paramRef = "";
				paramRutina = "";
				
				// Revisa y Carga en Variables los Parámetros Recibidos en la corrida
				if( frn.nParam() /*>*/== 2 ){ //Se han mandado parámetros a la página
	              
					//paramSuc = "01";
					//paramRef = "0000000954";
					paramSuc = trim(frn.param(0)); 
					paramRef = trim(frn.param(1));
               
					//if ( frn.nParam() > 2 ) { paramRutina = trim(frn.param(2)); }
               
				} else {
            
					// To testing after including parameter(s)
					/*
					paramSuc = "01"; 
					paramRef = "0000000954"; // "0000000954" , "0000000953"
					paramRutina = "";
					*/

					// /*
					frn.message("Operación no válida [ sin Parametros ] ...", "Mensaje","&Aceptar");
					//frn.open("anuncios",4);
					frn.open("index",4);
					return;
					// */
					
				}
				
				MostrarDatos();
				MostrarDatosGrd();

				//frn.setPos("c_pq01");
			
				//frn.message("Parameters : " & frn.nParam() & " ; tip_ope : " & tip_ope, "Info Parameters", "Aceptar");
					
			} /* END Func Inicializa() */
			
			
			fun PadLeft(pText,pRelleno,pCaracterRelleno) {
				var Resultado;
				var pos_ini = pText;
            var nReg = strlen(pText);
            for (var cont = nReg; cont < pRelleno; cont++) {
					Resultado = pCaracterRelleno & Resultado;
            }
            Resultado = Resultado & pText;                
            return Resultado;
         } /* END Func PadLeft() */


			fun ConfiguraControlesOff() {

				/*							
				frn.setAtt("Imprimir", "visible", "N");
				frn.setAtt("Cancelar", "visible", "N");
				*/
				frn.setAtt("Aceptar", "visible", "N");
								
			} /* END Func ConfiguraControlesOff() */
			
			
			fun ConfiguraControlesOpcion(imodo) {
			
				//ConfiguraControlesOff();
				
				frn.setAtt("Aceptar", "visible", "Y");

			} /* END Func ConfiguraControlesOpcion() */

	
		   fun MostrarDatos(imodo) {
		   
				var xmlGrd, pedfech, flagErr;
				var x_marca, x_modelo, x_anio, x_version, x_serie; 
								
				flagErr = 0;
				
				paramST = "10";

				cmdQuery = "select h.c1 as c_suc, h.c2 as c_ref, h.c4 as c_st, s.c2 as k_suc " & 
						"from keplersc.kdpedref h inner join keplersc.kdms s on h.c1 = s.c1 " & 
						"where h.c1 = '" & paramSuc & "'" & " and h.c2 = '" & paramRef & "'" & " and h.c4 = " & paramST;

				//frn.message(cmdQuery,"Info !","Aceptar");
				
				rstXml(cuboQuery);
				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"tblkdinf.upd()");
				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatostblkdpedref");
				ok=getXmlAtt(cuboQuery,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboQuery,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;	
				}
				if(nXml(cuboQuery) == 0){
					//frn.setX("", "c_invent");
					//frn.setAtt("Aceptar", "visible", "N");
					ConfiguraControlesOff();
					frn.message("Sin Datos por mostrar ...","Info","Aceptar");
					flagErr = 1;
					return;
					//Cancela();	
				}	else {
					frn.setAtt("Aceptar", "visible", "Y");
				}
				//frn.set(cuboQuery);
				
				//if ( flagErr == 1 ) { Cancela(); }

				ConfiguraControlesOpcion();
				
				frn.setX(getXmlAtt(cuboQuery,"r0", "c_suc"), "c_suc");
				frn.setX(getXmlAtt(cuboQuery,"r0", "c_ref"), "c_ref");
				frn.setX(getXmlAtt(cuboQuery,"r0", "c_st"), "c_st");
				frn.setX(getXmlAtt(cuboQuery,"r0", "k_suc"), "k_suc");
				
		    } /* END Func MostrarDatos() */


			fun MostrarDatosGrd(imodo) {
		   
				var xmlGrd;
								
				if ( strlen( frn.get("c_suc") ) == 0 ) {
					return;
				}

				cmdQuery = "select h.c3 as k_parte, i.c2 as k_descr, h.c11 as k_pedesp, h.c12 as k_sugstck, h.c17 as k_surtstck, h.c18 as k_cantped, h.c13 as k_factor " & 
					", h.c14 as k_mip, h.c15 as k_inv, h.c16 as k_bckord, h.c20 as k_citas " & 
					", h.c11 as k_h11, h.c12 as k_h12 " &
					"from keplersc.kdpedrefmov h left join keplersc.kdini i on i.c1 = h.c3 " & 
					"where h.c1 = '" & paramSuc & "'" & " and h.c2 = '" & paramRef & "'" & " order by h.c2, h.c3";
				
				rstXml(cuboQuery);
				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"kdpedrefmovupd.mostrardatosgrid()");
				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatostblkdpedrefgrid");
				ok=getXmlAtt(cuboQuery,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboQuery,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;	
				}
				if(nXml(cuboQuery) == 0){
					frn.message("Sin Registros por mostrar ...","Info","Aceptar");
					frn.setPos("k_sucn");
					return;	
				}	
				//frn.set(cuboQuery);
			
				rstXml(xmlGrd);
				xmlGrd=frn.lib("libGeneral.kpl","CreaXmlDesdeTagRow",cuboQuery,"r","k_mov");
				frn.lib("libGeneral.kpl","FileSave",xmlGrd, fileSavePath & "\mostrardatosgrid_parsed");
				frn.setX(xmlGrd);
				
		    } /* END Func MostrarDatosGrd() */
		    
		    
		    fun CalculaTotales(iModo) {
		    
				var N1 = 0, N2 = 0, H11 = 0,  H12= 0, H13 = 0, A5 = 0, A6 = 0;
				var cantValida = 1, ErrMsg = "";

				H11 = frn.get("k_mov",-1,"k_h11");
				H12 = frn.get("k_mov",-1,"k_h12");
				H13 = frn.get("k_mov",-1,"k_factor");
				
				A5 = frn.get("k_mov",-1,"k_surtstck");
				A6 = frn.get("k_mov",-1,"k_cantped");
				
				N1 = H11 + A5; 
				N2 = H11 + H12;
				
				frn.setX("", "k_mov", -1, "k_st");
				
				// No ejecuta esta condicion, por el Minimo Fijado en la Columna : k_surtstck
				if ( A5 < 0 ) {
					if ( iModo == 1 ) {
						ErrMsg = "[" & frn.get("k_mov",-1,"k_parte") & "] < 0 | ";
						frn.setX("X", "k_mov", -1, "k_st");
						return ErrMsg;
					} else {
						frn.message("No se aceptan cantidades negativas");
						frn.setPos("k_mov",-1,"k_surtstck");
						cantValida = 0;
						return;
					}
				}
				
				if ( H13 > 0 ) {
					N1 = math("ceil",(N1 / H13));
					N1 = H13 * N1;
					N2 = math("ceil",(N2 / H13));
					N2 = N2 * H13;
				}				
				
				if ( N1 > N2 ) {
					if ( iModo == 1 ) {
						ErrMsg = "[" & frn.get("k_mov",-1,"k_parte") & "] > Sugerido Sistema | ";
						frn.setX("X", "k_mov", -1, "k_st");
						return ErrMsg;
					} else {
						frn.setX((N2 - H11),"k_mov",-1,"k_surtstck");
						frn.setX(N2,"k_mov",-1,"k_cantped");
						frn.message("No se puede solicitar más de lo sugerido por el sistema");
						frn.setPos("k_mov",-1,"k_surtstck");
						cantValida = 0;
						return;
					}
				} else {
					if(cantValida==1){
						frn.setX((N1 - H11),"k_mov",-1,"k_surtstck");
						frn.setX(N1,"k_mov",-1,"k_cantped");
					}
				}
				
				//return cantValida;
				return ErrMsg;
				
			} /* END Func CalculaTotales() */
					   
							
		} // End of class Main
		
	</script>
</pag>