<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/><tab/><inp id="k_titulo" dim="65,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"				type="string" modify="N" available="N" fnt="Arial,22"/>	<br/>	<br/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grupo_crud" dim="80,15,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="Nuevo"><tab/>					<sp n="1"/><tab n="1"/>			<txt>Sucursal:</txt><tab n="3"/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y" modify="Y"/>			<sp/>							<br/><sp n="1"/><tab n="2"/><txt>Fecha : </txt><tab n="3"/>			<edt id="k_fecha" dim="12,1"  fmt="DD/MM/CCYY" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" tooltip="Fecha"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2" available="Y" modify="Y"/>						<br/><sp/><tab n="2"/>			<txt>Horario inicio :  </txt><tab n="1"/>			<inp id="k_horario_ini" dim="6,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="time" nc="5" clrBrdr="255,255,255" tooltip="Horario no disponible inicial" available="Y" modify="Y"/><sp/>			<br/><sp/><tab n="2"/>			<txt>Horario fin :  </txt><tab n="2"/>			<inp id="k_horario_fin" dim="6,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="time" nc="5" clrBrdr="255,255,255" tooltip="Horario no disponible final" available="Y" modify="Y"/><sp/>										<br/><sp/><tab n="11"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/><br/>			<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>							</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP, accion,externo, clave_sel,sucursal_id,cve_color,resVal,straccion,suc_usuario,perfil_usuario,rol_usuario,asterisco    ;            var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError,cuboQuery,suc;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";			    Inicializa();				ctlrs_off();				insertar_datos();				ctlrs_opcion();			}						fun Inicializa(){				accion = frn.param(0);				frn.set("input_crud", accion);				frn.rst("grupo_crud");				externo	= frn.param(4);                if (accion &= "NUEVO"){                    straccion = "Nuevo" ;                   }else if (accion &= "CONSULTAR"){                    straccion = "Consultar";                }else if (accion &= "MODIFICAR"){                    straccion = "Modificar";                }else if (accion &= "ELIMINAR"){                    straccion = "Eliminar";                }     								frn.setAtt("grupo_crud", "tit", straccion );										//Llenar combo sucursales				var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));								sucursal();														}						fun ctlrs_off(){				frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );				frn.setAtt("k_sucn", "available", "N" );            frn.setAtt("k_sucn", "modify", "N" );				frn.setAtt("k_fecha", "available", "N" );            frn.setAtt("k_fecha", "modify", "N" );				frn.setAtt("k_horario_ini", "available", "N" );            frn.setAtt("k_horario_ini", "modify", "N" );				frn.setAtt("k_horario_fin", "available", "N" );            frn.setAtt("k_horario_fin", "modify", "N" );           			}							fun ctlrs_opcion(){				 frn.set("k_titulo","Horarios No Disponibles Taller");				if (accion &= "NUEVO"){										frn.setAtt("k_sucn", "available", "Y" );					frn.setAtt("k_sucn", "modify", "Y" );					frn.setAtt("k_fecha", "available", "Y" );					frn.setAtt("k_fecha", "modify", "Y" );					frn.setAtt("k_horario_ini", "available", "Y" );					frn.setAtt("k_horario_ini", "modify", "Y" );					frn.setAtt("k_horario_fin", "available", "Y" );					frn.setAtt("k_horario_fin", "modify", "Y" );				   frn.setAtt("btn_aceptar", "visible", "Y" );					frn.setAtt("btn_aceptar", "available", "Y" );						}								if (accion &= "ELIMINAR"){									frn.setAtt("btn_aceptar", "visible", "Y" );					frn.setAtt("btn_aceptar", "available", "Y" );								}					}						fun sucursal(){							suc = frP.get("k_sucn", -1, 1);					if (suc &= ""){					suc = frn.get("k_sucn", -1, 1);					}			}							fun insertar_datos(){					if (accion &! "NUEVO") {									frn.set("k_fecha", frn.param(1));					frn.set("k_horario_ini",frn.param(2));					frn.set("k_horario_fin",frn.param(3));									            }			}						fun ValidarDatos(){				if (frn.get("k_fecha") &= "") {											frn.setPos("k_fecha");					resVal=0;					frn.message("Debe especificar la Fecha, verificar","Error","Aceptar");				}				if (frn.get("k_horario_ini") &= "") {											frn.setPos("k_horario_ini");					resVal=0;					frn.message("Debe especificar el horario inicio, verificar","Error","Aceptar");				}				if (frn.get("k_horario_fin") &= "") {											frn.setPos("k_horario_fin");					resVal=0;					frn.message("Debe especificar el horario final, verificar","Error","Aceptar");				}						}			fun Execute() {				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}								var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}								xmlRequest = getXml(frn.dataPag());									sucursal();								setXml(xmlRequest,"document","sucursal_id",suc);				frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmdQuery="SELECT * FROM keplersc.crud_horarios_nodisp_taller('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_crud_tmkt.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frP.script("Inicia_Forma()");				if (accion &= "NUEVO") {						var sms =  "";					if (accion &= "NUEVO"){						sms = "Registro guardado";					}					ctlrs_opcion();					frn.message(sms ,"Mensaje","Aceptar");						Inicializa();					frn.exit();					}				if (accion &= "ELIMINAR"){					frn.message("Registro eliminado","Mensaje","Aceptar");					frn.exit();							}			}													fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}												}							</script></pag>