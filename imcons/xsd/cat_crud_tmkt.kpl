<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/><tab/><inp id="k_titulo" dim="65,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"				type="string" modify="N" available="N" fnt="Arial,22"/>	<br/>	<br/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grupo_crud" dim="80,28,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="Nuevo" available="Y"><tab/>					<sp n="1"/><tab n="1"/>			<txt>Sucursal:</txt><tab n="2"/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y" modify="Y"/>			<sp/>							<br/><sp n="1"/><tab n="2"/><txt>Clave : </txt><tab n="2"/>			<inp id="k_clave" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="15" available="Y" OnChange="" tooltip="Clave de Asesor" modify="Y"/>			<br/><sp/><tab n="2"/>			<txt>Nombre :  </txt><tab n="1"/>			<inp id="k_nombre" dim="50,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="30" clrBrdr="255,255,255" tooltip="Nombre Asesor"/><sp/>			<br/><sp/><tab n="2"/>			<txt>Estatus:  </txt><tab n="1"/>			<inp id="k_estatus" dim="3,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="1" clrBrdr="255,255,255" tooltip="Estatus"/><sp/>					<br/><sp/><tab n="2"/>			<txt>Correo:  </txt><tab n="2"/>			<inp id="k_correo" dim="50,1" brdr="2,0" clr="64,64,64" bclr="255,255,255"  nc="40" clrBrdr="255,255,255" tooltip="Correo"/><sp/>							<br/><sp/><tab n="2"/>			<txt>Telefono 1:  </txt><sp/>			<inp id="k_tel_1" dim="50,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" nc="30" clrBrdr="255,255,255" tooltip="Telefono 1"/><sp/>			<br/>						<sp/><tab n="2"/>			<txt>Telefono 2:  </txt><sp/>			<inp id="k_tel_2" dim="50,1" brdr="2,0" clr="64,64,64" bclr="255,255,255"  nc="30" clrBrdr="255,255,255" tooltip="Telefono 2"/><sp/>			<br/>			<sp/><tab n="2"/>			<txt>Extension:  </txt><tab n="1"/>			<inp id="k_ext" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255"  nc="30" clrBrdr="255,255,255" tooltip="Extension"/><sp/>			<br/>						<br/><sp/><tab n="13"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/><br/>			<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>							</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP, accion,externo, clave_sel,sucursal_id,cve_color,resVal,straccion,suc_usuario,perfil_usuario,rol_usuario,asterisco    ;            var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError,cuboQuery,suc;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";			    Inicializa();				ctlrs_off();				insertar_datos();				ctlrs_opcion();			}						fun Inicializa(){				accion = frn.param(0);				frn.set("input_crud", accion);				frn.rst("grupo_crud");				externo	= frn.param(2);                if (accion &= "NUEVO"){                    straccion = "Nuevo" ;                   }else if (accion &= "CONSULTAR"){                    straccion = "Consultar";                }else if (accion &= "MODIFICAR"){                    straccion = "Modificar";                }else if (accion &= "ELIMINAR"){                    straccion = "Eliminar";                }     								frn.setAtt("grupo_crud", "tit", straccion );				clave_sel = frn.param(1);				if (accion &! "NUEVO"){					frn.set("k_clave", clave_sel);				}								//Llenar combo sucursales				var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}									cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));								sucursal();														}						fun ctlrs_off(){				frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );				frn.setAtt("k_sucn", "available", "N" );            frn.setAtt("k_sucn", "modify", "N" );				frn.setAtt("k_clave", "available", "N" );            frn.setAtt("k_clave", "modify", "N" );            frn.setAtt("grupo_crud", "available","N");			}							fun ctlrs_opcion(){				 frn.set("k_titulo","Asesores TMKT");				if (accion &= "NUEVO"){					frn.setAtt("grupo_crud", "available","Y");					frn.setAtt("k_sucn", "available", "Y" );					frn.setAtt("k_sucn", "modify", "Y" );					frn.setAtt("k_clave","available","Y");					frn.setAtt("k_clave", "modify", "Y" );				   frn.setAtt("btn_aceptar", "visible", "Y" );					frn.setAtt("btn_aceptar", "available", "Y" );				    				}								if (accion &= "MODIFICAR") {                frn.setAtt("grupo_crud", "available","Y");                frn.setAtt("btn_aceptar", "visible", "Y" );                frn.setAtt("btn_aceptar", "available", "Y" );             }										}						fun sucursal(){							suc = frP.get("k_sucn", -1, 1);					if (suc &= ""){					suc = frn.get("k_sucn", -1, 1);					}			}							fun insertar_datos(){					if (accion &= "MODIFICAR"){					//llamada externa(padre)					if (externo &= "s"){						if (clave_sel &= ""){							frn.message("selecciona una clave con F9 para modificar","Error","Aceptar");							frn.setAtt("btn_aceptar", "visible", "N" );							return;						}					}				}				if (accion &! "NUEVO") {					cmdQuery="select c2,c3,c4,c5,c6,c7 from keplersc.kdsercattmkt where c1 ='"& clave_sel &"' and col_sucursal='" & suc & "'"; 					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_lineas_crud.insertar_datos()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.set("k_nombre",getXmlAtt(cuboResultados,"r"&0,"c2"));					frn.set("k_estatus",getXmlAtt(cuboResultados,"r"&0,"c3"));					frn.set("k_correo",getXmlAtt(cuboResultados,"r"&0,"c4"));					frn.set("k_tel_1",getXmlAtt(cuboResultados,"r"&0,"c5"));					frn.set("k_tel_2",getXmlAtt(cuboResultados,"r"&0,"c6"));					frn.set("k_ext",getXmlAtt(cuboResultados,"r"&0,"c7"));					            }			}						fun ValidarDatos(){				if (frn.get("k_clave") &= "") {											frn.setPos("k_clave");					resVal=0;					frn.message("Debe especificar la clave de Asesor, verificar","Error","Aceptar");				}				if (frn.get("k_nombre") &= "") {											frn.setPos("k_nombre");					resVal=0;					frn.message("Debe especificar el nombre del Asesor, verificar","Error","Aceptar");				}				if (frn.get("k_estatus") &! "I" &&  frn.get("k_estatus") &! "A") {											frn.setPos("k_estatus");					resVal=0;					frn.message("El estatus del Asesor debe ser A(ACTIVO) I(INACTIVO), verificar","Error","Aceptar");				}			}			fun Execute() {				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}								var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}								xmlRequest = getXml(frn.dataPag());									sucursal();								setXml(xmlRequest,"document","sucursal_id",suc);				frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmdQuery="SELECT * FROM keplersc.cat_crud_tmkt('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_crud_tmkt.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frP.script("Inicia_Forma()");				if (accion &= "NUEVO" || accion &= "MODIFICAR") {						var sms =  "";					if (accion &= "NUEVO"){						sms = "Registro guardado";					}else {						sms = "Registro modificado";					}					accion="CONSULTAR";					ctlrs_opcion();					frn.message(sms ,"Mensaje","Aceptar");						frn.exit();					}				if (accion &= "ELIMINAR"){					frn.message("Registro eliminado","Mensaje","Aceptar");					frn.exit();							}			}							}	</script></pag>