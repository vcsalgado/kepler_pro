<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Documents">	<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,20" OnPgUp="PgUp" OnPgDn="PgDn" OnCtrPgUp="CtrPgUp" 			OnF1="VntF1" OnCtrPgDn="CtrPgDn" OnCtrIni="CtrIni" OnCtrEnd="CtrEnd" OnCtrDel="CtrDel" 		 bclr="192,205,213" unfont="0"><br/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="70,25,7,12" brdr="0,5" tit="General data" fnt="Arial,16"><tab/>		<tbl id="registros" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="94,15"  nren="fijo" Reorder="Y" modify="N" OnMouseD="Consulta()" OnF9="filtros()">			<col id="c1" name="C1"/>			<col id="c2" name="C2"/>		</tbl><br/><tab/><txt fnt="Arial,0" clr="0,58,112" bclr="240,240,230">Note: Press  &lt;F9&gt; to specify search filters</txt><sp/>		</grp><br/><sp/><br/><tab n="18"/>		<img id="cancela" dim="60,60" brdr="0,1" bPx="1" img="_60_DocDel.png" OnEnter="Cancela()" tooltip="Cancelar" available="Y"/><tab/>		<img id="ok" dim="60,60" brdr="0,1" bPx="1" img="_60_DocNew.png" default="1"  OnEnter="Consulta()" tooltip="Aceptar" available="Y"/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,bCxp,genDoc,bNom,bReturn;			fun Main(){				frn=new FRNT; 				frP=new FRNTP; 				kdb=new KDB;				kdb.connect();				bCxp=0;                bReturn=frn.param(0)&=""?"k_folio":frn.param(0);                bNom=frn.param(1);				genDoc=frP.get("k_tipoN",-1,1);				if((frP.get("k_tipoN",-1,1)&="X")||(frP.get("k_tipoN",-1,1)&="x"))bCxp=1;				GetData();			}			fun GetData(){				var index=1,limExtra="",bClave=0;				if(strlen(trim(frn.get("clave")))>0){index=2;limExtra=",c10='" & frn.get("clave") & "'";bClave=1;}				if(strlen(trim(frn.get("fecI")))>0){limExtra=limExtra&",c9>='" & frn.get("fecI") & "'";if(!bClave)index=5;}				if(strlen(trim(frn.get("fecF")))>0){limExtra=limExtra&",c9<='" & frn.get("fecF") & "'";if(!bClave)index=5;}				var cmd="c,kdm1," & index & ",u," & ((bCxp)?"kdxd":"kdud") & ",$,u2=c10,$,c1='" & frP.get("k_sucN",-1,1) & "',c2='" & frP.get("k_tipoN",-1,1) & "',c3='" & frP.get("k_tipoN",-1,2) & "',c4='" & frP.get("k_tipoN",-1,3) & "',c5='" & frP.get("k_tipoN",-1,4) & "'" & limExtra & ",$,c6,c9,c10,c16,c7,c11,c12,c8,c13,c14,c15,c17,c18,c41,c42,u3,$,50";				var enc2="Documents,&,No,Date,"&((bCxp)?"Supplier":"Customer")&",Amount,Currency,Refer,"&((bCxp)?"Agent":"SalesRep")&",WH,Discount,Tax,Tax2,Term,PayDate,ReferDate,Balance,Name";				kdb.edittable(cmd,1,"registros",enc2);//Busca los último registros que cumplan las condiciones.			}			fun Consulta(){ 				frP.set(bReturn,frn.get("registros",-1,"c6"));				frP.scriptElm(bReturn,"OnChange");				frn.exit();			}			fun Cancela {				frn.exit();			}			fun filtros(){				Dialog(1,"doc_consulta2",bCxp,genDoc,bNom);			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				//else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}								}        		/*	---------------------------------------	AUTOR						FECHA			CAMBIO	---------------------------------------	FTM					29/07/19			-Se	modifica funcion	Main	para	agregar	variable de retorno, se modifica funciona Consulta para cambiar el valor fijo	"k_folio", por la variable bReturn	para hacer dinamica la pantalla.		EMR					06/05/20			-Se agrega variable genDoc para que la pantalla hijo llame a la pantalla de busqueda correspondiente (cliente,proveedor)										*/			</script></pag>