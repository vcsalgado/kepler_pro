<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Consulta Factura Veh&#237;culo" scale="48"><grp dim="1,-1,10,20" brdr="0,1" clr="0,0,0" bclr="255,255,255" unfont="0">	<br exe="encabezado"/>	<tab/><inp id="rep_suc"  just="L" dim="40,1" brdr="0,1" type="string" nc="20" modify="N" fnt=",20"/><tab n="13"/><txt fnt=",">FV-11</txt>		<br exe="encabezado"/>	<tab n="27"/><txt fnt=",">Version 7</txt><br/>		<br exe="encabezado"/>	<tab/><hLine dim="85,0" g="1"/>	<br exe="encabezado"/>		<tab n="6"/><txt fnt=",22">ENCUESTA DE SATISFACCION Y VALE DE SALIDA DE LA UNIDAD</txt>	<br exe="encabezado"/>	<tab/><hLine dim="85,0" g="1"/>					<br exe="encabezado"/>	<br exe="encabezado"/>	<tab/><txt fnt=",20">DISTRIBUIDOR:   </txt>	<inp id="distribuidor"  just="L" dim="40,1" brdr="0,1" type="string" nc="20" modify="N" fnt=",20"/>	<sp/><txt fnt=",16">FECHA:</txt>	<inp id="linea_fecha_carta" dim="30,1" type="string" modify="N" available="Y" fnt=",16" visible="Y"/>	<br exe="encabezado"/>	<tab/><txt>CLIENTE:</txt><inp id="linea_comprador" dim="40,1" type="capital" modify="N" fnt=",0"/>	<tab n="3"/><sp/><txt>TEL.:</txt><inp id="telefono" dim="25,1" type="capital" modify="N" fnt=",0"/>	<br exe="encabezado"/>	<tab/>	<txt>NO.FACT.:</txt><inp id="fol_factura" dim="44,1" type="capital" modify="N" fnt=",0"/>	<tab/><sp/>	<txt>FECHA FACT: </txt><inp id="fecha_factura" dim="44,1" type="capital" modify="N" fnt=",0"/>	<br exe="encabezado"/>	<tab/><txt>VENDEDOR:</txt>	<inp id="clave_vendedor" dim="6,1" type="capital" modify="N" fnt=",0"/>	<tab/>	<inp id="nombre_vendedor" dim="60,1" type="capital" modify="N" fnt=",0"/>	<br exe="encabezado"/>	<tab/><hLine dim="85,0" g="1"/>	<br exe="encabezado"/>	<br exe="encabezado"/>	<tab/><txt fnt=",b">DATOS DE LA UNIDAD</txt>	<br exe="encabezado"/>		<tab/><txt>INVENTARIO:</txt>	<inp id="inventario" dim="15,1" type="capital" modify="N" fnt=",0"/>	<tab n="4"/><txt>TIPO: </txt>	<inp id="tipo_auto" dim="80,1" type="capital" modify="N" fnt=",0"/>	<tab/>		<br exe="encabezado"/>	<tab n="1"/><txt>SERIE:</txt>	<inp id="serie" dim="16,1" type="capital" modify="N" fnt=",0"/>	<tab n="5"/><txt>MOTOR:</txt>	<inp id="motor" dim="10,1" type="capital" modify="N" fnt=",0"/>	<tab n="4"/>	<txt>MODELO:</txt>	<inp id="modelo" dim="10,1" type="capital" modify="N" fnt=",0"/>	<tab/>	<br exe="encabezado"/>	<tab n="1"/>	<txt>EXTERIOR:</txt>	<inp id="ext" dim="10,1" type="capital" modify="N" fnt=",0"/>	<tab n="7"/><txt>INTERIOR:</txt>	<inp id="int" dim="10,1" type="capital" modify="N" fnt=",0"/>	<br exe="encabezado"/>	<tab n="2"/><br/><tab/><hLine dim="85,0" g="1"/>	<br exe="encabezado"/>		<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/><tab/>	<txt fnt=",20">&#191;Qu&#233; tan probable es que Usted recomiende a nuestra distribuidora con familiares y/o amigos?</txt>	<br exe="seccion_detalle"/><tab/>	<txt>A)DEFINITIVAMENTE</txt><tab/><txt>B)PROBABLEMENTE</txt><sp/><txt>SI</txt><tab/><txt>C)PROBABLEMENTE NO</txt>	<tab/><txt>D)DEFINITIVAMENTE</txt><sp/><txt>NO</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>		<br/><br/><tab/><txt  fnt=",20">&#191;Qu&#233; tan probable ser&#237;a que vuelva a comprar un veh&#237;culo en esta distribuidora?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)DEFINITIVAMENTE</txt><tab/><txt>B)PROBABLEMENTE</txt><sp/><txt>SI</txt><tab/><txt>C)PROBABLEMENTE</txt>	<sp/><txt>NO</txt><tab/><txt>D)DEFINITIVAMENTE NO</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>		<br/><br/><tab/><txt  fnt=",20">&#191;Qu&#233; tan satisfecho se encuentra con el servicio obtenido durante todo el proceso de compra?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)MUY SATISFECHO</txt><tab/><txt>B)ALGO SATISFECHO</txt><sp/><tab/><txt>C)ALGO INSATISFECHO</txt>	<sp/><tab/><txt>D)MUY INSATISFECHO</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>		<br/><br/><tab/><txt  fnt=",20"> &#191;Como fue el trato que recibio de su Asesor de Ventas?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)MUY AMABLE</txt><tab n="2"/><txt>B)AMABLE</txt><sp/><tab n="4"/><txt>C)DESCORTES</txt>	<sp/><tab n="3"/><txt>D)MUY DESCORTES</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>		<br/><br/><tab/><txt  fnt=",20"> &#191;Le entregaron su maletin de herramientas original toyota?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)SI</txt><tab n="4"/><txt>B)NO</txt><sp/><tab n="5"/><txt>C)NO RESPONDE</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>		<br/><br/><tab/><txt  fnt=",20"> &#191;Como calificaria los conocimientos del Asesor acerca de nuestros productos?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)EXCELENTES</txt><tab n="2"/><txt>B)BUENOS</txt><sp/><tab n="4"/><txt>C)POBRES</txt>	<sp/><tab n="4"/><txt>D)NULOS</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>		<br/><br/><tab/><txt  fnt=",20"> &#191;Como calificaria los conocimientos del Asesor acerca de las opciones Financieras para su compra?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)EXCELENTES</txt><tab n="2"/><txt>B)BUENOS</txt><sp/><tab n="4"/><txt>C)POBRES</txt>	<sp/><tab n="4"/><txt>D)NULOS</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>		<br/><br/><tab/><txt  fnt=",20"> &#191;Como calificaria el seguimiento que le dio el Asesor al proceso para decidir su compra?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)EXCELENTE</txt><tab n="2"/><txt>B)BUENO</txt><sp/><tab n="4"/><txt>C)REGULAR</txt>	<sp/><tab n="3"/><txt>D)MALO</txt>	<br exe="seccion_detalle"/>			<br exe="seccion_detalle"/>	<br/><br/><tab/><txt  fnt=",20"> &#191;La fecha y hora pactada para la entrega de su vehiculo fue cumplida?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)SI</txt><tab n="4"/><txt>B)NO</txt><sp/><tab n="5"/><txt>C)NO RESPONDE</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br/><br/><tab/><txt  fnt=",20"> &#191;El tiempo transcurrido entre el cierre de su operacion y la entrega de su vehiculo fue?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)ADECUADO</txt><tab n="2"/><txt>B)TARDADO</txt><sp/><tab n="3"/><txt>C)EXCESIVO</txt>	<sp/><tab n="3"/><txt>D)NO RESPONDE</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br/><br/><tab/><txt  fnt=",20"> &#191;Como calificaria el estado del vehiculo al momento de la entrega? (Limpieza, apariencia, etc.)</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)EXCELENTE</txt><tab n="2"/><txt>B)BUENO</txt><sp/><tab n="4"/><txt>C)POBRE</txt>	<sp/><tab n="4"/><txt>D)MALO</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br/><br/><tab/><txt  fnt=",20"> &#191;Le explicaron la frecuencia y el costo de los servicios de mantenimiento para su vehiculo?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)SI</txt><tab n="4"/><txt>B)NO</txt><sp/><tab n="5"/><txt>C)NO RESPONDE</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>		<br/><br/><tab/><txt  fnt=",20"> &#191;Le explicaron el funcionamiento de su poliza de asistencia en el camino?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)SI</txt><tab n="4"/><txt>B)NO</txt><sp/><tab n="5"/><txt>C)NO RESPONDE</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br/><br/><tab/><txt  fnt=",20"> &#191;Como calificaria la atencion brindada por nuestra Cajera?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)MUY EFICIENTE</txt><tab/><txt>B)EFICIENTE</txt><sp/><tab n="3"/><txt>C)POCO EFICIENTE</txt>	<sp/><tab n="2"/><txt>D)NADA EFICIENTE</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br/><br/><tab/><txt  fnt=",20">En general, &#191;Como calificaria el trato brindado por nuestro personal?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)MUY AMABLE</txt><tab n="2"/><txt>B)AMABLE</txt><sp/><tab n="4"/><txt>C)DESCORTES</txt>	<sp/><tab n="3"/><txt>D)MUY DESCORTES</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br/><br/><tab/><txt  fnt=",20"> &#191;Como califica la comodidad y limpieza de nuestras instalaciones?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)EXCELENTE</txt><tab n="2"/><txt>B)BUENA</txt><sp/><tab n="4"/><txt>C)POBRE</txt>	<sp/><tab n="4"/><txt>D)MUY POBRE</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br/><br/><tab/><txt  fnt=",20"> &#191;Como califica la comodidad de nuestro estacionamiento?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)EXCELENTE</txt><tab n="2"/><txt>B)BUENA</txt><sp/><tab n="4"/><txt>C)POBRE</txt>	<sp/><tab n="4"/><txt>D)MUY POBRE</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br/><br/><tab/><txt  fnt=",20"> &#191;Desea ser contactado para recibir promociones e informacion de la Marca?</txt>	<br exe="seccion_detalle"/>	<tab/><txt>A)SI</txt><tab n="4"/><txt>B)NO</txt><sp/><tab n="5"/><txt>C)NO RESPONDE</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br/><br/><tab/><txt  fnt=",20"> &#191;Nos puede proporcional su e-mail?</txt>	<sp/><hLine dim="58,0" g="1"/>					<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br/><br/><tab/><txt  fnt=",20"> En su opinion, &#191;Como podriamos mejorar nuestra atencion?</txt>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<tab/><hLine dim="90,0" g="1"/>					<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<tab/><hLine dim="90,0" g="1"/>		<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<tab/><hLine dim="90,0" g="1"/>		<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>	<br exe="seccion_detalle"/>				<tab/><hLine dim="20,0" g="1"/>	<tab n="17"/><hLine dim="20,0" g="1"/>	<br exe="seccion_detalle"/>		<tab n="2"/><txt  fnt=",16"> AUTORIZA SALIDA </txt><tab n="18"/><txt  fnt=",16"> RECIBI DE CONFORMIDAD </txt>	<br exe="seccion_detalle"/>		<tab n="2"/><txt  fnt=",16">   Nombre y Firma </txt><tab n="21"/><txt  fnt=",16"> Cliente </txt>	<br exe="seccion_detalle"/></grp></pag>