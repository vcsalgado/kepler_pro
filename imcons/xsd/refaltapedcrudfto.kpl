<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de " scale="48">	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,16" unfont="0">			<br exe="encabezado"/>		<!-- <hLine dim="90,0" g="2" type="1"/> -->		<hLine dim="101,0" g="2" type="1"/>		<br exe="encabezado"/>				<grp dim="15,5,7,12">			<br/>			<img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>				<!-- <grp dim="60,7,7,12"> -->		<grp dim="70,10,7,12"> 			<br/>			<!-- dim="70,1" -->			<inp id="nombreempresa" dim="90,1" fnt="20b,20b" type="string" modify="N" bclr="249,249,249"/>			<br/>			<!-- dim="70,1" -->			<inp id="tituloreporte" dim="90,1" fnt="20b,18b" type="string" modify="N" bclr="249,249,249"/>			<br/>			<!-- dim="70,1" 			<inp id="leyendatx" dim="90,1" type="string" fnt=",16b" modify="N" just="L" nc="-1"/>			<br/>			-->			<!-- <inp id="fechItx" dim="7,1" type="string" fnt=",16b" modify="N" just="L" nc="-1"/> -->			<!-- <sp n="1"/> -->			<!-- <inp id="fechI" dim="10,1" type="date" fnt=",16b" modify="N" just="L" nc="-1" fmt="CCYY/MM/DD"/> -->			<!-- <sp n="2"/> -->			<!-- <inp id="fechFtx" dim="7,1" type="string" fnt=",16b" modify="N" just="L" nc="-1"/> -->			<!-- <sp n="1"/> -->			<!-- <inp id="fechF" dim="10,1" type="date" fnt=",16b" modify="N" just="L" nc="-1" fmt="CCYY/MM/DD"/>	-->					<!-- <sp n="1"/> -->			<!-- <inp id="fechoper" dim="12,1" type="date" fnt=",16b" fmt="DD/MM/CCYY" modify="N" just="L" nc="-1"/> -->			<br/>			<txt fnt=",16b">Sucursal : </txt> <sp n="1"/>			<inp id="suc" dim="25,1" fnt="16b,16b" type="string" modify="N" bclr="249,249,249"/>			<br/>			<txt fnt=",16b">Folio : </txt> <sp n="4"/>			<inp id="foldoc" dim="25,1" fnt="16b,16b" type="string" modify="N" bclr="249,249,249"/>			<sp n="15"/> <inp id="leyendatx" dim="20,1" type="string" fnt=",16b" modify="N" just="L" nc="-1" clr="152,7,11"/>			<br/>			<txt fnt=",16b">Fecha : </txt> <sp n="3"/>			<inp id="fechdoc" dim="25,1" fnt="16b,16b" type="date" modify="N" bclr="249,249,249" fmt="DD/MM/CCYY" nc="-1"/>			<br exe="encabezado"/>		</grp>				<tab n="1"/>				<grp dim="15,5,7,12">			<tab n="2"/><txt>P&#225;g:</txt>			<sp/> <inp id="k_pag" dim="5,1" type="number" mcr="k_pag"/><br/><br/>			<inp id="fecha" dim="10,1" type="date" fmt="DD-MM-CCYY" nc="-1"/>			<sp/> <inp id="hora" dim="5,1" type="time"/>		</grp>		<br exe="encabezado"/>		<br exe="encabezado"/>				<!-- <hLine dim="90,0" g="2" type="1"/> -->		<hLine dim="101,0" g="2" type="1"/> 			<br exe="encabezado"/>			<sp n="1"/>			<txt fnt=",b"> Reemplazo </txt> <sp n="2"/>			<txt fnt=",b"> Producto </txt> <sp n="3"/>			<txt fnt=",b"> Descripcion </txt> <sp n="19"/>			<txt fnt=",b"> Cantidad </txt> <sp n="3"/>			<txt fnt=",0b"> U.M. </txt> <sp n="7"/>			<txt fnt=",b"> Importe </txt> <sp n="8"/> 			<txt fnt=",b"> Stock </txt> <sp n="5"/>			<!-- <inp id="suctx" dim="4,1" type="string" modify="N" fnt=",0b"/> -->			<txt fnt=",b"> Especial </txt> <sp n="1"/>			<br exe="encabezado"/>		<!-- <hLine dim="90,0" g="2" type="1"/> -->		<hLine dim="101,0" g="2" type="1"/> 		<br exe="encabezado"/>		<br exe="encabezado"/>		<sp n="1"/> <inp id="reemplazo" dim="10,1" type="string" modify="N" fnt=",15"/>		<inp id="producto" dim="10,1" type="string" modify="N" fnt=",15"/>		<inp id="descrip" dim="25,1" type="string" modify="N" just="L" fnt=",15"/> <sp n="1"/>		<inp id="cantidad" dim="9,1" type="number" modify="N" just="R" nd="1" fnt=",15"/> <sp n="1"/>		<inp id="um" dim="7,1" type="string" modify="N" fnt=",15"/> <sp n="1"/>		<inp id="importe" dim="11,1" type="number" modify="N" just="R" nd="2" fnt=",15"/> <sp n="1"/>		<inp id="stock" dim="11,1" type="number" modify="N" just="R" nd="2" fnt=",15"/> <sp n="1"/>		<inp id="especial" dim="11,1" type="number" modify="N" just="R" nd="2" fnt=",15"/> 		<!-- 		<inp id="serie" dim="20,1" type="string" modify="N"/> <sp n="1"/> 		<inp id="color" dim="4,1" type="string" modify="N"/> <sp n="1"/> 		<inp id="vest" dim="4,1" type="string" modify="N"/> <sp n="1"/> 		<inp id="suc" dim="4,1" type="string" modify="N"/> 		-->		<br exe="detalle"/>				<!-- <hLine dim="35,0" g="2" type="1"/> -->		<!-- <br exe="linea"/> -->				<!-- <br exe="total"/> -->		<!-- <tab n="5"/><txt fnt=",-1bi">Total:</txt><tab/><inp id="input3" dim="10,1" type="number" brdr="1,0" fnt=",0b"/>  -->		<!-- <br exe="total"/>  -->				<br exe="total"/>		<br exe="total"/> 		<sp n="46"/> <hLine dim="55,0" g="2" type="1"/> 		<br exe="total"/>				<sp n="55"/> <txt fnt=",b">Subtotal </txt> 		<sp n="3"/> <inp id="c_subt" dim="12,1" type="number" modify="N" just="R" nd="2" fnt=",0b"/>		<br exe="total"/>				<sp n="55"/> <txt fnt=",b">Iva </txt> 		<sp n="6"/> <inp id="c_iva" dim="12,1" type="number" modify="N" just="R" nd="2" fnt=",0b"/>		<br exe="total"/>				<sp n="55"/> <txt fnt=",b">Total </txt> 		<sp n="5"/> <inp id="c_tot" dim="12,1" type="number" modify="N" just="R" nd="2" fnt=",0b"/>		<br exe="total"/>				<sp n="46"/> <hLine dim="55,0" g="2" type="1"/>		<br exe="total"/>				<br exe="coments"/> 				<sp n="1"/> 		<txt fnt=",b">Comentarios : </txt>		<br exe="coments"/> 		<br exe="coments"/>		<sp n="1"/> 		<inp id="c_cmnt1" dim="100,3" type="string" modify="N"/> 		<br exe="coments"/> 		<sp n="1"/> 		<inp id="c_cmnt2" dim="100,1" type="string" modify="N"/>		<br exe="coments"/>  		<sp n="1"/> 		<inp id="c_cmnt3" dim="100,1" type="string" modify="N"/> 				<br exe="coments"/> 			</grp></pag>