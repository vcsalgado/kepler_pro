<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Balance de Clientes" scale="48">
	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,15" unfont="0">
		<br exe="encabezado"/>
		<hLine dim="90,0" g="2" type="1"/>
		<br exe="encabezado"/>
		<grp dim="10,7,7,12">
			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>
		</grp>
		<tab n="1"/>
		<grp dim="62,5,7,12">
			<br/>
			<inp id="k_empresa" fnt=",20b" dim="80,1" clr="0,58,112" type="string" available = "N"/>
			<br/>
			<txt fnt=",16b" clr="0,58,112"> Balace de Clientes, del cliente</txt>
			<inp id="k_cli_ini" fnt=",16b" dim="15,1" clr="0,58,112" type="string" just="C" fmt="DD/MM/CCYY" available = "N" nc="-1"/>
			<txt fnt=",16b" clr="0,58,112"> al </txt>
			<inp id="k_cli_fin" fnt=",16b" dim="15,1" clr="0,58,112" type="string" just="C" fmt="DD/MM/CCYY" available = "N" nc="-1"/>
			<br/>	
			<inp id="k_sucursal" fnt=",16b" dim="80,1" clr="0,58,112" type="string" available = "N"/>
			<br/>
		</grp>
		<tab n="1"/>
		<grp dim="20,5,7,12">
			<br/>
			<txt>P&#225;g:</txt><tab/><inp id="k_pag" dim="4,1" type="number" just="L" mcr="k_pag"/>
			<br/>
			<txt>Fecha:</txt><tab/><inp id="k_fecha_imp" dim="10,1" type="date" just="L" fmt="DD-MM-CCYY"/>
			<br/>
			<txt>Hora:</txt><sp/><tab n="1"/><inp id="K_hora_imp" dim="5,1" type="time" just="L"/>
		</grp>
		<br exe="encabezado"/>
		<sp/><txt fnt=",b">Clave</txt>
		<tab n="2"/><txt fnt=",-1b">Cliente</txt>
		<tab n="1"/><txt fnt=",-1b">Factura</txt>
		<tab n="2"/><txt fnt=",-1b">Docto.</txt>
		<tab n="1"/><txt fnt=",b">Expedici&#243;n</txt>
		<tab/><txt fnt=",-1b">Vencimiento</txt>
		<tab n="2"/><txt fnt=",-1b">Cargos</txt>
		<tab n="3"/><txt fnt=",-1b">Abonos</txt>
		<tab n="3"/><txt fnt=",b">Saldo final</txt>	
		<br exe="encabezado"/>
		<hLine dim="90,0" g="2" type="1"/>
		<br exe="encabezado"/>
		
		<sp/><inp id="k_cli_clave" dim="8,1" type="string" fnt=",-1b"/>
		<sp/><inp id="k_cli_desc" dim="30,1" type="string" fnt=",-1b"/>
		<tab n="4"/><inp id="k_cargos_cli"  dim="10,1" type="number" nd="2" just="R"/>
		<tab/><inp id="k_abonos_cli" dim="10,1" type="number" nd="2" just="R"/>
		<tab/><inp id="k_saldo_cli"  dim="10,1" type="number" nd="2" just="R"/>	
		<br exe="seccion_cliente_resumen"/>

		<tab n="3"/><hLine dim="80,0" g="1" type="1"/>
		<br exe="seccion_factura_line_top"/>
		
		<tab n="4"/><inp id="k_factura" dim="13,1" type="string" fnt=",0b"/>
		<tab/><inp id="k_documento" dim="4,1" type="string"/>
		<tab/><inp id="k_expedicion" dim="8,1" type="date" fmt="DD/MM/YY" nc="-1" just="R"/>
		<tab/><inp id="k_vencimiento" dim="8,1" type="date" fmt="DD/MM/YY" nc="-1"/>
		<tab/><inp id="k_cargos_docto" dim="10,1" type="number" nd="2" just="R"/>
		<tab/><inp id="k_abonos_docto" dim="10,1" type="number" nd="2" just="R"/>
		<tab/><inp id="k_saldo_docto" dim="10,1" type="number" nd="2" just="R"/>
		<br exe="seccion_factura_resumen"/>

		<tab n="4"/><hLine dim="77,0" g="1" type="1"/>
		<br exe="seccion_movto_line_top"/>

		<tab n="5"/><inp id="k_movto" dim="13,1" type="string" fnt=",14"/><tab/><inp id="k_movto_desc" dim="19,1" type="string" fnt=",14"/>
		<tab/><inp id="k_movto_cargo" dim="10,1" type="number" nd="2" just="R" fnt=",14"/>
		<tab/><inp id="k_movto_abono" dim="10,1" type="number" nd="2" just="R" fnt=",14"/>
		<br exe="seccion_movto_det"/>

		<tab n="4"/><txt fnt=",b">Saldo para la factura</txt>
		<inp id="k_factura_movtos" dim="10,1" type="string" fnt=",0b"/>
		<tab n="6"/><inp id="k_total_cargos_factura" dim="10,1" type="number" nd="2" just="R"/>
		<tab/><inp id="k_total_abonos_factura" dim="10,1" type="number" nd="2" just="R"/>
		<tab/><inp id="k_total_saldo_factura" dim="10,1"  type="number" nd="2" just="R"/>
		<br exe="seccion_factura_total"/>
		<br exe="seccion_factura_total"/>
		
	
		<tab n="2"/><txt fnt=",b">Saldo para el cliente</txt>
		<inp id="k_doctos_cli_clave" dim="10,1" type="string" fnt=",0b"/>
		<tab n="8"/><inp id="k_total_cargos_cli" dim="10,1" type="number" nd="2" just="R"/>
		<tab/><inp id="k_total_abonos_cli" dim="10,1" type="number" nd="2" just="R"/>
		<tab/><inp id="k_total_saldo_cli" dim="10,1" type="number" nd="2" just="R"/>
		<tab n="14"/>
		<br exe="seccion_cliente_total"/>
		<br exe="seccion_cliente_total"/>
				
		<hLine dim="90,0" g="2" type="1"/>
		<br exe="seccion_total_reporte"/>		
		<sp/><txt fnt=",-1b">Saldo total para el reporte</txt>
		<tab n="12"/><inp id="k_total_cargos" dim="10,1" type="number" fnt=",-1b" just="R" nd="2"/>
		<tab/><inp id="k_total_abonos" dim="10,1" type="number" fnt=",-1b" just="R" nd="2"/>
		<tab/><inp id="k_total_saldo" dim="10,1" type="number" nd="2" just="R" fnt=",0b"/>
		<br exe="seccion_total_reporte"/>

	</grp>
</pag>
