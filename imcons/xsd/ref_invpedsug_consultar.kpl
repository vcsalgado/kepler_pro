<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Esquemas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">	<tab/><txt fnt=",22" clr="0,0,0"> Consulta de Pedido Sugerido</txt><tab/>	<br/>		<tab/><hLine clr="0,0,0"	dim="45,0,0,0"/>	<br/>	<br/><tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="45,25,10,17" brdr="0,5" tit="Esquemas" fnt="Arial,16">				<sp/><txt clr="0,58,112" hk="S">Sucursal:</txt>		<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="23,36" bclr="255,255,255" brdr="2,0" OnChange="ResetDetalle()" fnt="Arial,16" Null="N" hk="S" available="Y"/>		<tab n="1"/><txt>Fecha: </txt>		<edt id="fecha_inicial" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" fmt="DD/MM/CCYY" page="_ks_fecha,fecha_inicial"/>		<tab/><txt>Refaccion: </txt>		<inp id="refaccion" dim="14,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="20"/>		<img id="img_buscar" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="ObtenerPedido()"/>		<br/>		<sp/>				<tbl id="k_mov" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="88,20" modify="Y" Reorder="Y" available="Y" insdel="Y">			<col name="Fecha" id="k_fecha"  modify="N" visible="Y" type="date" nc="-1" fmt="DD/MM/CCYY"/>			<col name="Refaccion" id="k_refaccion"  modify="N" visible="Y"/>			<col name="MIP" id="k_mip" modify="N" visible="Y" type="number" nd="2"/>			<col name="Existencia" id="k_existencia" OnF9="comision_sel()" OnChange="insert_registro_comision()" visible="Y" type="number" nd="2" modify="N"/><col id="k_backorder" name="Backorder" type="number" nd="2" modify="N" visible="Y"/><col id="k_cantidad_sugerida" name="Cant. Sugerida" type="number" nd="2" modify="N" visible="Y"/><col id="k_cantidad_solicitada" name="Cant. Solicitada" type="number" nd="2" modify="N" visible="Y"/><col id="k_cantidad_surtida" name="Cant. Surtida" type="number" nd="2" modify="N" visible="Y"/>		</tbl>		<br/><sp/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, asterisco  ;		var cmdQuery, cuboQuery, ok, mensajeError;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			rol_usuario = frn.config("user","role");			asterisco = "*";						llena_combos();			ConfiguraUI();			Inicializa();		}            		fun llena_combos(){		//Llenar combo sucursales			cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}			}							cmdQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery ,"cat_crud_tipos.Inicializa()");								ok=getXmlAtt(cmdQuery ,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cmdQuery ,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}							frn.set("k_sucN",getXml(cmdQuery ));			frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));								ResetDetalle();		}				fun ResetDetalle(){			frn.rst("k_mov");		}				fun ObtenerPedido(){			var xmlPantalla;			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			if (frn.get("fecha_inicial") &= "" && frn.get("refaccion") &= ""){				frn.message("Debe seleccionar ingresar un criterio","Mensaje","Aceptar");				return;			}						cmdQuery = "select c9 as fecha, c3 as refaccion, c14 as mip, c15 as existencia, c16 as backorder, ";			cmdQuery = cmdQuery & "c12 as cant_sugerida, c18 as cant_solicitada, c19 as cant_surtida ";			cmdQuery = cmdQuery & "from keplersc.kdpedrefmov rm where 1=1 "; 			if (frn.get("fecha_inicial") != "" ){				cmdQuery = cmdQuery & "and c9 = '" & frn.get("fecha_inicial") & "' "; 			}			if (frn.get("refaccion") != ""){				cmdQuery = cmdQuery & "and c3 = '" & frn.get("refaccion") & "' "; 			}			cmdQuery = cmdQuery & "order by c9,c3 desc ";			rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ref_invpedsug_consultar.ObtenerPedido()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_mov",cuboQuery);					}				fun ConfiguraUI(){			if (frn.nParam() == 0){				frn.message("Acción no permitida.","Error","&Aceptar");//				frn.open("redirect",2);				return;			}		}				fun Inicializa(){				frn.set("fecha_inicial",fnDate(sys.date("year"),sys.date("month"),sys.date("day")));		}						fun comision_sel() {			cmdQuery = "select c1 as clave, c2 as descripcion from keplersc.kdtipocomis ";			frn.dialog("genlistafiltrosel","Comisiones",cmdQuery,"clave","k_mov", -1, "comision","S");      }      		fun llenar_cmb(cuboResultados, cmb){			var len_cubo = nXml(cuboResultados);			var pos_ini = frn.N(cmb);			for (var cont=0; cont<len_cubo ; cont++){				var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");				var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");				frn.setX(desc, cmb, cont+pos_ini ,0);				frn.setX(clave, cmb, cont+pos_ini ,1);			}			}							fun descr_combo(combo,posicion,valor){			var descr, valor_actual;			var len_combo = frn.N(combo);			for (var cont=0; cont<len_combo ; cont++){				valor_actual= frn.get(combo,cont,posicion);				if (valor_actual &=  valor){					descr = frn.get(combo,cont,0);					return descr;				}			}		}	}				</script></pag>