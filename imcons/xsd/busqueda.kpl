<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="B&#250;squeda">	<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,20" bclr="192,205,213"			OnPgUp="PgUp" OnPgDn="PgDn" OnCtrPgUp="CtrPgUp" 			OnF1="VntF1" OnCtrPgDn="CtrPgDn" OnCtrIni="CtrIni" OnCtrEnd="CtrEnd" OnCtrDel="CtrDel" unfont="0"><br/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="53,35,7,12" brdr="0,5" tit="B&#250;squeda" fnt="Arial,16"><tab/><txt hk="B" fnt="Arial,16b">Buscar</txt>		<inp id="texto" clr="64,64,64" clrBrdr="255,255,255"  dim="62,1" brdr="2,0" bclr="255,255,255" OnEnter="Busqueda" hk="B" type="string"/><br/>		<tab n="2"/><txt>Buscar por:</txt>		<tab/><ratio id="Clave" clr="64,64,64"  dim="2,16" bclr="255,255,255" hk="C" available="Y" default="1" OnChange="Busqueda"/><sp/><txt hk="C">Clave</txt>		<tab n="2"/><ratio id="Descripcion" clr="64,64,64"  dim="2,16" bclr="255,255,255" hk="D" available="Y" OnChange="Busqueda"/><sp/><txt>Descripci&#243;n</txt><br/>		<tab n="2"/><txt hk="x">B&#250;squeda extendida </txt><chck id="bus_ext" clr="64,64,64"  dim="3,16" brdr="2,0" bclr="255,255,255" YN="10" OnChange="Busqueda" hk="x" clrBrdr="255,255,255"/><br/><br/><tab/><txt hk="e" fnt=",b">Resultados:</txt><br/><tab/>		<tbl id="resultados" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="69,15"  hk="e" modify="N" nren="fijo" Reorder="Y" OnEnter="Exit" OnMouseD="Exit">			<col id="clave" name="Clave"/>			<col id="desc" name="Nombre / Descripci&#243;n"/>		</tbl>		<br/><tab/>		<bot id="banterior"  dim="6,0" brdr="5" text="&lt;&lt;" fnt="Arial,20" OnEnter="Busqueda(-50)" visible="N" tooltip="Anterior p&#225;gina de resultados"/><tab n="19"/>		<bot id="bsiguiente"  dim="6,0" brdr="5" text="&gt;&gt;" fnt="Arial,20" OnEnter="Busqueda(50)" visible="N" tooltip="Siguiente p&#225;gina de resultados"/>		</grp><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb;			/* PARÁMETROS			param(0) = Nombre del campo (o tabla) al que se devolverá la clave o descripción en la pantalla padre			param(1) = (Opcional) Nombre de la columna al que se devolverá la clave en la pantalla padre(Se debe especificar el grid en el parametro anterior)			param(2) = Nombre de la tabla, en la cual se hará la búsqueda en los campos 1 y 2 (clave y descripción)			param(3) = (Opcional) Bandera binaria de control. Es un string que indica ciertos parámetros de funcionamiento de la opción							Los caracteres se toman de izquierda a derecha y tienen el siguiente significado:							Bit 1= Si toma valor de 1, se devuelve la clave. Si toma valor de 0, se devuelve la descripción. Por default se toma valor de 1.										param(4) = (Opcional) Función de la pantalla padre a ejecutar antes de regresarle el control.										Valor de retorno = clave o descripción del cliente			*/			var bit1;//Banderas de comportamiento (Ver descripción arriba)			var bkmdb,offset;//Bandela KEPLER MUTIBASE DE DATOS.			fun Main() {				frn=new FRNT; 				frP=new FRNTP; 				kdb=new KDB;				bit1=1;//Inicializa las banderas con los valores default.				var bCtrl=trim(frn.param(3));				if (strlen(bCtrl)>0){bit1=mid(bCtrl,0,1);}//Se especificó una bandera de control.				kdb.connect();				var bd_abrir=frn.param(2);				kdb.open("c," & bd_abrir);				frn.setAtt("Clave","available","Y");				frn.setAtt("Descripcion","available","Y");				frn.setAtt("bsiguiente","visible","N");				frn.setAtt("banterior","visible","N");				var valor_inicial=(bit1==1)? frP.get(frn.param(0),-1,0): frP.get(frn.param(0),-1,1);				if (strlen(trim(frn.param(1)))>0){ valor_inicial=frP.get(frn.param(0),-1,frn.param(1)); }//Se devolverá el valor a una tabla 				frn.set("texto",valor_inicial);				frn.set("bus_ext",1);				kdb.kde("KDE");				kdb.exec();				bkmdb=!strcmp("KS9",mid(kdb.get("KDE",3),1,3));				bkmdb=(mid(bd_abrir,0,4)&="\\\\")?0:bkmdb;				offset=0;			}			fun Busqueda(nPag) {											if (frn.get("bus_ext")==1) {					frn.setAtt("Clave","available","N");					frn.setAtt("Descripcion","available","N");				}				else {					frn.setAtt("Clave","available","Y");					frn.setAtt("Descripcion","available","Y");				}				offset=offset+nPag;				offset=(offset<0?0:offset);				if(nPag&="") offset=0;				if(bkmdb){ BusquedaKMDB();}				else		{ BusquedaNativa();}				frn.rst("resultados");				if(kdb.N("datos")>0) {					frn.set("resultados",kdb.get("datos"));					frn.setPos("resultados");				}				if(kdb.N("datos")>49)	frn.setAtt("bsiguiente","visible","Y");									else							frn.setAtt("bsiguiente","visible","N");				if(offset<=0)				frn.setAtt("banterior","visible","N");				else							frn.setAtt("banterior","visible","Y");			}						fun BusquedaNativa() {				if (frn.get("bus_ext")==1){					var cmd="'" & frn.get("texto") & "' inside c1,c2";	kdb.lim(cmd);				}				else if(strlen(frn.get("texto"))>0){//Se hace una búsqueda exacta por índice					var campo_de_busqueda="c1"; //Por default por Clave					if(frn.get("Descripcion")==1)						campo_de_busqueda="c2";					var cmd=campo_de_busqueda & ">='" & frn.get("texto") & "'"; kdb.lim(cmd);					var bSql = strcmp("MSSQL",mid(kdb.get("KDE",3),1,5));					var limSup="\#254";if(bSql == 0)limSup="zzzz";					cmd=campo_de_busqueda & "<='" & frn.get("texto") & limSup &"'";					kdb.lim(cmd);				}				if(frn.get("Descripcion")==1)					kdb.table("datos,c,2,&,c1,c2,max,50,"&offset);//Utiliza el índice 2				else					kdb.table("datos,c,1,&,c1,c2,max,50,"&offset);//Utiliza el índice 1				kdb.exec();			}						fun BusquedaKMDB() {				var cmd="SELECT c1,c2 FROM "&frn.param(2);				var or="";				var p="";				var text=InsScpScn(frn.get("texto"));				if(text&!"") {					cmd=cmd&" WHERE";					if(frn.get("bus_ext")==1) p="%";					if(frn.get("bus_ext")==1||frn.get("Clave")==1) {						cmd=cmd&" c1 LIKE '"&p&text&"%'"; or=" OR ";					}					if(frn.get("bus_ext")==1||frn.get("Descripcion")==1) {						cmd=cmd&or&" c2 LIKE '"&p&text&"%'";					}				}				if(frn.get("Descripcion")==1) cmd=cmd&" ORDER BY c2";				else									cmd=cmd&" ORDER BY c1";				cmd=cmd&" LIMIT 50 OFFSET "&offset;				kdb.stmt(cmd,"datos");				kdb.exec();			}						fun InsScpScn(text) {				var tokens;				setXml(tokens,"r0","~");				setXml(tokens,"r1","%");				setXml(tokens,"r2","_");				setXml(tokens,"r3",mid(" [",1,1));				setXml(tokens,"r4","]");				setXml(tokens,"r5","!");				setXml(tokens,"r6","^");				for(var t=0,nt=nXml(tokens);t<nt;t++) {					var token=getXml(tokens,"r"&t);					var split=strSplit(text,token);					text=getXml(split,"r0");					for(var i=1;i<split;i++) text=text&"~"&token&getXml(split,"r"&i);				}				return text;			}						fun Exit() { 				var valor_retorno=frn.get("resultados",-1,"clave");//Por default se devuelve la clave				if( bit1==0 ){					valor_retorno=frn.get("resultados",-1,"desc");//Se devuelve la descripcion				}				if (strlen(trim(frn.param(1)))>0){ //Se devolverá el valor a una tabla 					frP.setX(valor_retorno,frn.param(0),-1,frn.param(1)); 					frP.scriptElm(frn.param(0),"OnChange",frn.param(1));				}				else{ //se devolverá el valor a un campo					frP.set(frn.param(0),valor_retorno); 					frP.scriptElm(frn.param(0),"OnChange");				}				if (strlen(trim(frn.param(4)))>0){ //Se ejecutará la función indicada en la ventana padre.					frP.script(frn.param(4));				}				frn.exit();			}								}					/*	-------------------------------------------	AUTOR							FECHA			CAMBIO	---------------------------------------------------	Eliana	Carrera	Meraz 07/06/2012		-Se elimina el atributo brdr a los Ratio Button.	Juan Cristobal Rangel	26/06/2015		-Se modifica la pantalla para que no se agregue ningún límite a la búsqueda, en caso que el campo de texto quede vacío. 															Esto debido a que cuando se busca sobre campos llave numéricos no mostraba ningún resultado.	Karen Rodriguez			22/11/2017		-Se agrega validación para poder filtrar correctamente por "descripción" (fecha) para el caso de la busqueda de patente SAT	Fran	Tapia					19/01/2018		-Se agrega funcion Buscamas para habilitar boton de mas resultados. 	Fabián Suárez				05/08/2019		-Se optimizaron búsquedas para kepler multibase de datos.														-Se paginaron las búsquedas (se eliminó la función 'BuscarMas()' porque con el offset quedó obsoleta).	Fabián Suárez				23/09/2019		-Se agrega función para insertar secuencias de escape para kmdb con el LIKE.														-Se modifica la búsqueda con kmdb para que busque solo al inicio como sin kmdb.														-Se agrega validación para revisar tablas del sistema.	----------------------------------------------------------------	CAMBIOS GRÁFICOS	----------------------------------------------------------------	AUTOR							FECHA				ELEMENTO					CAMBIO	----------------------------------------------------------------	Fabián Suárez				05/08/2019		mensaje					-Se eliminó el elemento gráfico 'mensaje' porque al estar paginado no se requiere mostrar la advertencia, mejor se habilitó y corrigió el funcionamiento del botón 'bsiguiente' y se implemento un botón 'banterior'.														banterior				-Se agregó este nuevo botón para, en el pagineo de las búsquedas, poder regresar a la página anterior.														bsiguiente				-Se modificó el atributo 'OnEnter' para mandar a llamar la función 'Busqueda(50)' y no la función 'BuscarMas()' que ya es obsoleta.	*/							</script></pag>