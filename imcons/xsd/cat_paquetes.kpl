<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Catalogo Paquetes"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="66,40,10,10" brdr="0,5" tit="Catalogo Paquetes" fnt="Arial,16">					<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" OnEnter="Exit" OnMouseD="Exit" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="60,22" modify="N" nren="fijo">		<col id="clave" name="Clave"/>		<col id="descr" name="Descripcion"/>		<col id="horas" name="Horas" type="number" nd="2"/>		<col id="precio"  type="number" name="Precio"/>		</tbl> 		<tab n="7"/>		<br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,marca,modelo;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								marca=trim(frn.param(0)); 				modelo=trim(frn.param(1)); 							Inicializa();					}											fun Inicializa() {							var xmlRequest,cmd,ok,cuboResultados, totOrd , contOrd, ref_clave, ref_desc;									cmd= "select c4,c5,c9,c10 from keplersc.kdspaq where c1='" & marca & "' and c2='" & modelo & "'";							cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_paquetes.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								totOrd = nXml(cuboResultados);							frn.rst("tabla");				for (contOrd=0; contOrd<totOrd ; contOrd++){								frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c4"),"tabla",contOrd,"clave");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c5"),"tabla",contOrd,"descr");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c9"),"tabla",contOrd,"horas");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c10"),"tabla",contOrd,"precio");								}						}						fun Exit(){						frP.setX("S","tabla_puntos",-1,"autorizacion"); 				frP.scriptElm("tabla_puntos","OnChange","autorizacion");							var clave_paq = frn.get("tabla", -1, "clave");						frP.setX(clave_paq ,"tabla_puntos",-1,"clave_paquete"); 				frP.scriptElm("tabla_puntos","OnChange","clave_paquete");								var desc = frn.get("tabla", -1, "descr");							frP.setX(desc ,"tabla_puntos",-1,"trabajo_a_realizar"); 				frP.scriptElm("tabla_puntos","OnChange","trabajo_a_realizar");								var hrs = frn.get("tabla", -1, "horas");						frP.setX(hrs ,"tabla_puntos",-1,"horas"); 				frP.scriptElm("tabla_puntos","OnChange","horas");							var precio= frn.get("tabla", -1, "precio");					frP.setX(precio,"tabla_puntos",-1,"precio_punto"); 				frP.scriptElm("tabla_puntos","OnChange","precio_punto");								frn.exit();							}						}	</script></pag>