<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/><tab/><inp id="k_titulo" dim="65,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"				type="string" modify="N" available="N" fnt="Arial,22"/>	<br/>	<br/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grupo_crud" dim="82,22,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" available="Y" tit="Nuevo">			 <sp n="2"/>			 <txt>Sucursal: </txt> <sp n="8"/>		    <cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="61,36" bclr="255,255,255" brdr="2,0" OnChange="CambiaSucursal()" fnt="Arial,16" Null="N" hk="S" available="Y" modify="Y" tooltip="Sucursal"/>          <br/>          <br/>          <sp n="2"/> <txt>Grupo: </txt> <sp n="10"/>          <inp id="k_clave" dim="15,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="10" available="N" OnChange="" tooltip="Clave del Grupo de Contrarecibo" modify="N" visible="Y"/>          <sp n="17"/> <txt>Fecha Registro: </txt>           <edt id="fec_registro" dim="15,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" page="_ks_fecha,fec_registro" modify="Y" available="N" tooltip="Fecha Registro"/>          <br/>          <sp n="2"/>          <txt>Proveedor Interno:</txt> <sp n="2"/>          <inp id="gpo_gasto" dim="15,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="10" OnF9="ObtenerGpo_gasto()" OnChange="BuscarGpo_gasto()" available="Y" OnChange="" tooltip="Grupo de Gasto" modify="Y" visible="Y"/>          <sp/>			 <inp id="desc_gasto" dim="45,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" clrBrdr="255,255,255" tooltip="Descripcion del Grupo de Gastos" available="N" modify="Y"/>			 <br/>			 <sp n="2"/> <txt>Descripci&#243;n: </txt> <sp n="6"/>			<inp id="descripcion" dim="61,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="100" clrBrdr="255,255,255" tooltip="Descripcion del Grupo" available="Y" modify="Y"/>						<br/> <sp n="2"/> <txt>Importe Asignado: </txt> <sp n="1"/>			<inp id="importe" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" available="N" type="number" nd="2" tooltip="Importe Asignado" modify="N"/>						<sp n="2"/>         <txt>Importe Comprobado:</txt> <sp n="1"/>			<inp id="comprobado" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" available="N" type="number" nd="2" tooltip="Importe Comprobado" modify="N"/>					<br/> <sp n="2"/> <txt>Estatus: </txt> <sp n="9"/>			<inp id="estatus" dim="3,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="1" clrBrdr="255,255,255" tooltip="Estatus Grupo" available="N" modify="N"/>						<sp n="3"/>			<txt id="text_chk" fnt="Arial,16b" clr="0,58,112" bclr="255,255,255" visible="N">Cerrar  </txt>			<chck id="chk_pc" clr="64,64,64"  dim="3,21" bclr="255,255,255" brdr="2,0" YN="10" clrBrdr="255,255,255" OnChange="Change_Mode()" available="N" visible="N"/>					         <br/><br/>         <tab n="11"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="0" visible="Y" available="Y"/><tab/>			<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N" type="string"/>		    							</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP,sys,accion,externo, clave_sel,sucursal_id,resVal,straccion;            var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError;            var usuario, rol_usuario, suc_usuario,asterisco;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				kdb.connect();				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";			   Inicializa();				ctlrs_off();				insertar_datos();				ctlrs_opcion();			}						fun Inicializa(){				accion = frn.param(0);				frn.set("input_crud", accion);				frn.rst("grupo_crud");				externo	= frn.param(2);                if (accion &= "NUEVO"){                    straccion = "Nuevo" ;                   }else if (accion &= "CONSULTAR"){                    straccion = "Consultar";                }else if (accion &= "MODIFICAR"){                    straccion = "Modificar";                }else if (accion &= "ELIMINAR"){                    straccion = "Eliminar";                }     								frn.setAtt("grupo_crud", "tit", straccion );				clave_sel = frn.param(1);                sucursal_id = frn.param(3);										//Llenar combo sucursales                var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";                if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){                    cmd = cmd & " where c1='" & suc_usuario & "'";                }else {                    if (suc_usuario &! asterisco && suc_usuario &! "" ){                        cmd = cmd & " where c1='" & suc_usuario & "'";                    }                }                                    cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_gpcontra.Inicializa()");		                ok=getXmlAtt(cubo,"ok");                if(ok &! "" && !ok){                    mensajeError = getXmlAtt(cubo,"native3");                    mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);                    frn.message(mensajeError,"Error","Aceptar");                    return;                }                                        frn.set("k_sucn",getXml(cubo));                frn.set("k_sucn",descr_combo("k_sucn",1,suc_usuario));	                if (accion &! "NUEVO"){                    frn.set("k_sucn",descr_combo("k_sucn",1,sucursal_id));								frn.set("k_clave", clave_sel);					}               frn.set("fec_registro",sys.date());			}						fun ctlrs_off(){            frn.setAtt("k_sucn", "available", "N" );				frn.setAtt("fec_registro","available","N");				frn.setAtt("gpo_gasto","available","N");				frn.setAtt("desc_gasto","available","N");				frn.setAtt("descripcion", "available", "N" );            frn.setAtt("importe", "available", "N" );            frn.setAtt("comprobado", "available", "N" ); //UPD by JMM 20241104 				frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );				// Added by JMM 20241105				frn.setAtt("chk_pc", "visible", "N");  				frn.setAtt("chk_pc", "available", "N");				frn.setAtt("text_chk", "visible", "N"); 			}							fun ctlrs_opcion(){							if (accion &= "NUEVO"){					frn.setAtt("k_sucn", "available", "Y" );               frn.setAtt("k_sucn", "modify", "Y" );                              frn.setAtt("k_clave", "available", "N"/*"Y"*/ ); //UPD by JMM 20241101               frn.setAtt("k_clave", "modify", "N" );               					frn.setAtt("gpo_gasto","available","Y");					frn.setAtt("gpo_gasto","modify","Y");										frn.setAtt("descripcion","available","Y");					frn.setAtt("descripcion", "modify", "Y" );										//Commented by JMM 20241101					//frn.setAtt("importe", "available", "N"/*"Y"*/ );               //frn.setAtt("importe", "modify", "N"/*"Y"*/ );                              // Added by JMM 20241105					frn.setAtt("chk_pc", "visible", "N");  					frn.setAtt("chk_pc", "available", "N");					frn.setAtt("text_chk", "visible", "N");               				   frn.set("k_titulo","Grupos de Gastos");											} else {									frn.setAtt("k_sucn", "available", "Y" );               frn.setAtt("k_sucn", "modify", "N" );               					frn.setAtt("k_clave", "available", "N"/*"Y"*/ ); //UPD by JMM 20241101               frn.setAtt("k_clave", "modify", "N" );                    					frn.setAtt("gpo_gasto","available","N"/*"Y"*/); //UPD by JMM 20241101					frn.setAtt("gpo_gasto","modify","N");										if (accion &= "MODIFICAR") {                   frn.setAtt("descripcion","available","Y");					    frn.setAtt("descripcion", "modify", "Y" );					    					    frn.setAtt("importe", "available", "N"/*"Y"*/ ); //UPD by JMM 20241101                   frn.setAtt("importe", "modify", "N"/*"Y"*/ );	//UPD by JMM 20241101                   						 // Added by JMM 20241105						 frn.setAtt("chk_pc", "visible", "Y");  						 frn.setAtt("chk_pc", "available", "Y");						 frn.setAtt("text_chk", "visible", "Y");				               }else{                                  frn.setAtt("descripcion","available","Y");                   frn.setAtt("descripcion", "modify", "N" );                                           frn.setAtt("importe", "available", "N"/*"Y"*/ ); //UPD by JMM 20241101                   frn.setAtt("importe", "modify", "N" );                                      // Added by JMM 20241105						 frn.setAtt("chk_pc", "visible", "N");  						 frn.setAtt("chk_pc", "available", "N");						 frn.setAtt("text_chk", "visible", "N");                                           frn.setAtt("btn_aceptar", "visible", "N" );               }									}								if (accion &! "CONSULTAR"){													frn.setAtt("btn_aceptar", "available", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );				}			}							fun insertar_datos(){					if (accion &= "MODIFICAR"){					//llamada externa(padre)					if (externo &= "s"){						if (clave_sel &= ""){							frn.message("selecciona una clave con F9 para modificar","Error","Aceptar");							frn.setAtt("btn_aceptar", "visible", "N" );							return;						}					}				}				if (accion &! "NUEVO") {									//Commented & Adapted by JMM 20241101					/*					cmdQuery="select kc.grupo_id, kc.fecha_registo as fecha,kc.descripcion,kc.importe_asignado,kc.idgpo,kg.descripcion as desc_gasto 							from keplersc.kdgpcontra kc							inner join keplersc.kdgpgastos kg on kg.idgpo = kc.idgpo							where sucursal_id='"& frn.get("k_sucn",-1,1) &"' and grupo_id='" & frn.get("k_clave") & "'";					*/ 										cmdQuery = "select g.grupo_id, g.descripcion, g.proveedor_id, g.importe_asignado, k.c3 as desc_gasto, g.fecha_registro as fecha, g.importe_comprobado, g.estatus " & 						"from keplersc.kdgpcontra g " & 						"inner join keplersc.kdxd k on g.proveedor_id = k.c2 and k.interno = 1 " &						"where g.sucursal_id = '" & frn.get("k_sucn",-1,1)/*sucursal_id*/ & "' and grupo_id='" & frn.get("k_clave") & "' " &							 " /*and g.proveedor_id = ' & proveedor_id & ' and g.estatus = 'A'*/";															cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_gpcontra_crud.insertar_datos()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}										frn.set("k_clave",getXmlAtt(cuboResultados,"r"&0,"grupo_id"));					frn.set("fec_registro",getXmlAtt(cuboResultados,"r"&0,"fecha"));					frn.set("descripcion",getXmlAtt(cuboResultados,"r"&0,"descripcion"));					frn.set("importe",getXmlAtt(cuboResultados,"r"&0,"importe_asignado"));					frn.set("comprobado",getXmlAtt(cuboResultados,"r"&0,"importe_comprobado")); // Added by JMM 20241104 					frn.set("estatus",getXmlAtt(cuboResultados,"r"&0,"estatus")); // Added by JMM 20241104 					frn.set("gpo_gasto",getXmlAtt(cuboResultados,"r"&0,"proveedor_id"/*"idgpo"*/));					frn.set("desc_gasto",getXmlAtt(cuboResultados,"r"&0,"desc_gasto"));										// Added by JMM 20241105					if ( frn.get("estatus") &= "C" ) { 						frn.set("chk_pc",1);					} else {						frn.set("chk_pc",0);					}            } else {               frn.setPos("descripcion");    				}			}						fun ValidarDatos(){							if (frn.get("gpo_gasto") &= "") {											frn.setPos("gpo_gasto");					resVal=0;					frn.message("Debe seleccionar un Proveedor Interno ...","Error","Aceptar");					return; // Added by JMM 20241104 				} else{					BuscarGpo_gasto();					//Added by JMM 20241104					if ( strlen ( trim(frn.get("desc_gasto")) ) == 0 ) {						frn.setPos("gpo_gasto");						resVal=0;						return; // Added by JMM 20241104 					}				}								if ( trim(frn.get("descripcion")) &= "") {											frn.setPos("descripcion");					resVal=0;					frn.message("Debe especificar la Descripción del Gasto ...","Error","Aceptar");					return; // Added by JMM 20241104 				}								//Commented by JMM 20241104				/*            if (frn.get("importe") == 0) {											frn.setPos("importe");					resVal=0;					frn.message("Debe especificar el importe asignado, verificar","Error","Aceptar");				}				*/			}			fun BuscarGpo_gasto(){							//Adapted by JMM 20241104				//cmdQuery="select descripcion from keplersc.kdgpgastos where idgpo='"& frn.get("gpo_gasto") &"'"; 								cmdQuery = "select c3 as nombre from keplersc.kdxd where interno = 1 and c2 = '"& frn.get("gpo_gasto") &"'";								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_gpcontra_crud.insertar_datos()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");									ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				if((nXml(cuboResultados) == 0) && (frn.get("gpo_gasto") &! "")) {					frn.setPos("gpo_gasto");					frn.set("desc_gasto","");					resVal=0;					frn.message("El Proveedor Interno No existe ...","Error","Aceptar");					return;				} else{						frn.set("desc_gasto",getXmlAtt(cuboResultados,"r"&0,"nombre"/*"descripcion"*/));				}			}			fun ObtenerGpo_gasto(){							//Adapted by JMM 20241104 				//cmdQuery = "select idgpo as gpo_gasto, descripcion from keplersc.kdgpgastos";								cmdQuery = "select c2 as id_prov, c3 as nombre from keplersc.kdxd where interno = 1";								frn.dialog("genlistafiltrosel","Grupos de Gastos",cmdQuery,"id_prov","gpo_gasto","0","0","S","S");						   			}			fun Execute() {							var resultado,sms,adicionales,resultado_confirmacion;				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}								resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}								xmlRequest = getXml(frn.dataPag());					frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmdQuery="SELECT * FROM keplersc.cat_gpcontra_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_exteriores_crud.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									resultado=getXml(cubo ,"resultado");				adicionales=getXml(cubo ,"adicionales");				if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frP.script("Inicia_Forma()");				if (accion &= "NUEVO" || accion &= "MODIFICAR") {						sms =  "";					if (accion &= "NUEVO"){						sms = "Registro guardado";						frn.set("k_clave",adicionales);					}else {						sms = "Registro modificado";											}					accion="CONSULTAR";					insertar_datos();					ctlrs_opcion();					frn.message(sms ,"Mensaje","Aceptar");						frn.exit();				}				if (accion &= "ELIMINAR"){					frn.message("Registro eliminado","Mensaje","Aceptar");					frn.exit();							}			}            fun CambiaSucursal() {				frn.set("gpo_gasto","");                frn.set("descripcion","");                frn.set("importe","");			}			fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}										// Added by JMM, 20240226		   fun Change_Mode() {							if ( frn.get("chk_pc") == 1 ) { //frn.message("Check Encendido ...","Info !!!","Aceptar");									frn.set("estatus","C");										} else { //frn.message("Check Apagado ...","Info !!!","Aceptar");							frn.set("estatus","A");							}				return;				}						}	</script></pag>