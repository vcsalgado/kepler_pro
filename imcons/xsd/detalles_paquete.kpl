<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Detalle Paquete"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="84,44,10,10" brdr="0,5" tit="Detalle Paquete" fnt="Arial,16">				<tab n="1"/><txt clr="0,58,112">Marca:</txt>		<inp id="marca"  nc="8" dim="7,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  available="S"/>	<sp/>		<txt clr="0,58,112">Modelo:</txt>		<inp id="modelo"  nc="8" dim="7,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  available="S"/>	<sp/>		<txt clr="0,58,112">Paquete:</txt>		<inp id="paquete"  nc="8" dim="7,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/>	<sp/>		<br/>					<tab n="1"/><txt clr="0,58,112">Detalles:</txt>		<br/>		<tab/><tbl id="tabla_detalles" bclr="236,240,243" clr="64,64,64" OnEnter="Exit" OnMouseD="Exit" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="78,5" modify="N" nren="fijo">		<col id="desc_paquete" name="Descripcion"/>		<col id="mano_de_obra"  type="number" name="Mano de Obra" nd="2"/>		<col id="hrs_tabuladas" name="Horas Tabuladas" type="number"/>		<col id="refacciones"  type="number" name="Refacciones" nd="2"/>		<col id="cargos_varios"  type="number" name="Cargos Varios" nd="2"/>		<col id="subtotal" name="Subtotal" type="number" nd="2"/>		<col id="iva" name="IVA"  type="number" nd="2"/>		<col id="importe" name="Importe"  type="number" nd="2"/>		</tbl> 				<br/>		<br/>		<tab n="1"/><txt clr="0,58,112">Refacciones:</txt>		<br/>		<tab/><tbl id="tabla_refacciones" bclr="236,240,243" clr="64,64,64" OnEnter="Exit" OnMouseD="Exit" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="78,14" modify="N" nren="fijo">		<col id="clave" name="Clave"/>		<col id="desc_refaccion" name="Refaccion"/>		<col id="ctd" name="Cantidad" type="number" nd="2"/>		<col id="importe_ref" type="number" nd="2" name="Importe"/>		<col id="exis" name="Existencia"/>		<col id="prepicking" name="Prepicking"/>		<col id="disponibilidad" name="Disponibilidad"/>		</tbl> 		<tab n="7"/>		<br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,marca,modelo,paquete,suc_usuario,sucursal  ;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();													suc_usuario = frn.lib("libKepler","UserInfo(1)");				sucursal = frP.get("k_sucN", -1, 1);					if (sucursal &= ""){					sucursal = suc_usuario ;				}											marca= frP.get("marca");				modelo= frP.get("modelo");				paquete= frP.get("tabla_puntos" ,-1,"clave_paquete");								frn.set("marca", marca);				frn.set("modelo", modelo);				frn.set("paquete", paquete);								Inicializa();						}											fun Inicializa(){							var xmlRequest,cmd,ok,cubo, totresults , contresults,mensajeError ;							setXml(xmlRequest,"document","marca",marca );				setXml(xmlRequest,"document","modelo ",modelo );				setXml(xmlRequest,"document","paquete",paquete);				setXml(xmlRequest,"document","sucursal_id",sucursal );					frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.detalles_paquete('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"detalles_paquete.detalles_refacciones_paquete()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												var cubo_paquete= getXmlAtt(cubo,"r0" ,"paquete");				setXmlStr(cubo_paquete,cubo_paquete);						frn.setX(getXml(cubo_paquete,"desc_paq"),"tabla_detalles","0","desc_paquete");				frn.setX(getXml(cubo_paquete,"mano_de_obra"),"tabla_detalles","0","mano_de_obra");				frn.setX(getXml(cubo_paquete,"hrs_tabuladas"),"tabla_detalles","0","hrs_tabuladas");				frn.setX(getXml(cubo_paquete,"refacciones"),"tabla_detalles","0","refacciones");				frn.setX(getXml(cubo_paquete,"cargos_varios"),"tabla_detalles","0","cargos_varios");					frn.setX(getXml(cubo_paquete,"subtotal"),"tabla_detalles","0","subtotal");				frn.setX(getXml(cubo_paquete,"iva"),"tabla_detalles","0","iva");				frn.setX(getXml(cubo_paquete,"importe_paq"),"tabla_detalles","0","importe");								var cubo_refacciones= getXmlAtt(cubo,"r0" ,"refacciones");				setXmlStr(cubo_refacciones,cubo_refacciones);				totresults = nXml(cubo_refacciones);								for (contresults=0; contresults<totresults ;contresults++){									var clave_ref = getXml(cubo_refacciones,"r"&contresults, "clave_ref");					var desc_ref = getXml(cubo_refacciones,"r"&contresults, "desc_ref");					var ctd = getXml(cubo_refacciones,"r"&contresults, "cantidad");					var importe_ref = getXml(cubo_refacciones,"r"&contresults, "importe_ref");					var existencia = getXml(cubo_refacciones,"r"&contresults, "existencia");					var prepicking = getXml(cubo_refacciones,"r"&contresults, "prepicking");					var disponibilidad= getXml(cubo_refacciones,"r"&contresults, "disponibilidad");						frn.setX(clave_ref , "tabla_refacciones", contresults, "clave");					frn.setX(desc_ref , "tabla_refacciones", contresults, "desc_refaccion");					frn.setX(ctd , "tabla_refacciones", contresults, "ctd");					frn.setX(importe_ref , "tabla_refacciones", contresults, "importe_ref");					frn.setX(existencia , "tabla_refacciones", contresults, "exis");					frn.setX(prepicking , "tabla_refacciones", contresults, "prepicking");					frn.setX(disponibilidad, "tabla_refacciones", contresults, "disponibilidad");				}							}						}	</script></pag>