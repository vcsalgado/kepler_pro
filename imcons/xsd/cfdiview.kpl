<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Regeneraci&#243;n Masiva de Cfdi"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0">	<br/>	<tab/><inp id="inp_titulo" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>	<br/><tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp dim="90,45,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Folios de CFDI">					<tab n="1"/><txt clr="0,58,112" hk="S">Sucursal:</txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="22,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><sp/>			<txt>Inicial</txt><sp/> 			<txt>G:</txt>				<inp id="k_genini" dim="2,1" nc="1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><sp/>			<txt>N:</txt>				<inp id="k_natini" dim="2,1" nc="1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><sp/>			<txt>Gpo:</txt>				<inp id="k_gpoini" dim="2,1" nc="2" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><sp/>			<txt>Tpo:</txt>				<inp id="k_tpoini" dim="2,1" nc="2" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><sp n="3"/>				<txt>Final</txt><sp/> 			<txt>G:</txt>				<inp id="k_genfin" dim="2,1" nc="1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><sp/>			<txt>N:</txt>				<inp id="k_natfin" dim="2,1" nc="1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><sp/>			<txt>Gpo:</txt>				<inp id="k_gpofin" dim="2,1" nc="2" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><sp/>			<txt>Tpo:</txt>				<inp id="k_tpofin" dim="2,1" nc="2" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/>			<tab n="12"/><txt>    Fecha Inicial:</txt>			<edt id="k_fechaini" dim="8,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213"				type="date" modify="Y" available="Y" fnt="Arial,16" OnF9="Dialog(3,_ks_fecha,k_fechaini)" page="_ks_fecha,k_fechaini" fmt="DD/MM/CCYY" nc="-1"/><tab/>			<txt>Fecha Final:</txt>			 <edt id="k_fechafin" dim="8,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213"				type="date" modify="Y" available="Y" fnt="Arial,16" OnF9="Dialog(3,_ks_fecha,k_fechafin)" page="_ks_fecha,k_fechafin" fmt="DD/MM/CCYY" nc="-1"/><sp/>			<tab n="4"/>			<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			<br/>			<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="84,20" nren="fijo" OnMouseD="Seleccionar()" Reorder="N" modify="N" insdel="N">				<col id="seleccionar" name="S/N"/>				<col id="validacfdi" name="CFDI"/>                <col id="sucursal" name="Suc" visible="N"/>				<col id="gen" name="G"/>				<col id="nat" name="N"/>				<col id="gpo" name="Gpo"/>				<col id="tipo" name="Tpo"/>				<col id="folio" name="Folio"/>				<col id="fecha" name="Fecha"/>				<col id="cliente" name="Cliente"/>				<col id="rfc" name="RFC"/>				<col id="f_pago" name="FPago"/>                <col id="cuenta" name="Cuenta"/>				<col id="m_pago" name="MPago"/>				<col id="uso_cfdi" name="Uso"/>				<col id="nombre" name="Nombre"/>				<col id="error" name="Error"/>			</tbl> 			<tab n="7"/>			<br/>			<tab n="1"/><bot id="bot_seleccionar" dim="14,0" brdr="5" text="Generar" default="0" OnEnter="Ejecuta()"/>			<sp/><inp id="datcfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="3,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="1" modify="Y" available="Y" visible="N" OnChange=""/>		</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco, externo ;			var cmdQuery, cuboQuery, ok, mensajeError, fileSavePath, continua, xmlRequest,cuboResultados,cmd;			var tipoOper; //Variables relacionadas con parametros			var consCfdi;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";				fileSavePath = "C:\Basura";				ConfiguraUI();								Inicializa();						}						fun ConfiguraUI(){			var nparam;				consCfdi = "CFDIMASIVO";				tipoOper = frn.param(0);				nparam = frn.nParam();				if (frn.nParam() == 0){					frn.message("Accion no permitida.","Error","&Aceptar");					frn.open("redirect",2);					return;				}							//Establecer titulo de la ventana				if (tipoOper &= consCfdi){					frn.set("inp_titulo","Regeneracion Masiva de Cfdi");												}else{					frn.message("Accion no permitida.","Error","&Aceptar");					frn.open("redirect",2);					return;				}			}									fun Inicializa(){				var cubo;									//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));				frn.set("k_sucn",descr_combo("k_sucn",1,suc_usuario));				}						fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;				var nReg = strlen(pText);				for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;				}				Resultado = Resultado & pText;                				return Resultado;			}			fun Buscar() {				var totOrd , contOrd, ref_clave, ref_desc;				var suc_bus = frn.get("k_sucn", -1, 1);				var folio = frn.get("k_folio");				var cli = frn.get("k_cliente");				var fecini = frn.get("k_fechaini");				var fecfin = frn.get("k_fechafin");				var doctoini = frn.get("k_genini")&frn.get("k_natini")&PadLeft(frn.get("k_gpoini"),"2","0")&PadLeft(frn.get("k_tpoini"),"2","0");				var doctofin  = frn.get("k_genfin")&frn.get("k_natfin")&PadLeft(frn.get("k_gpofin"),"2","0")&PadLeft(frn.get("k_tpofin"),"2","0");												if (fecini &! "" && fecfin &! "" && doctoini &="0000" && doctofin &="0000"){					cmd = "select * from (select case when count(udcfd.c1)=0 then 'N' else 'S' end as c0," &						"case when count(udcfd.c1)=0 then 'Sin validacion' else 'Validado' end as validacfdi," &						"dm1.c1,dm1.c2,dm1.c3,dm1.c4,dm1.c5,dm1.c6,dm1.c9,dm1.c10,dm1.c22,dm1.c160," &						"dm1.c161,dm1.c162,dm1.c164,dm1.c32,concat(dmm.c1,dmm.c2,lpad(dmm.c3::text,2,'0'),lpad(dmm.c4::text,2,'0')) as rango " &						"from keplersc.kdm1 dm1 " &						"inner join keplersc.kdmm dmm on col_sucursal=dm1.c1 and dmm.c1=dm1.c2 and dmm.c2=dm1.c3 and dmm.c3=dm1.c4 and dmm.c4=dm1.c5 " &						"left join keplersc.kdudcfd udcfd on udcfd.c1=dm1.c10 " &						"where dmm.c80='S' and dm1.c1='" & suc_bus  & "' " &						"and dm1.c9 between '" & fecini  & "' and '" & fecfin & 						"' group by dm1.c1,dm1.c2,dm1.c3,dm1.c4,dm1.c5,dm1.c6,dm1.c9,dm1.c10,dm1.c22,dm1.c160,dm1.c161,dm1.c162,dm1.c164,dm1.c32,rango " &						" order by dm1.c9 desc) as resultado " &						"where rango between 'AA0101' and 'ZZ9999'";				}				if (fecini &! "" && fecfin &! "" && doctoini &! "0000" && doctofin &! "0000" ){					cmd = "select * from (select case when count(udcfd.c1)=0 then 'N' else 'S' end as c0," &						"case when count(udcfd.c1)=0 then 'Sin validacion' else 'Validado' end as validacfdi," &						"dm1.c1,dm1.c2,dm1.c3,dm1.c4,dm1.c5,dm1.c6,dm1.c9,dm1.c10,dm1.c22,dm1.c160," &						"dm1.c161,dm1.c162,dm1.c164,dm1.c32,concat(dmm.c1,dmm.c2,lpad(dmm.c3::text,2,'0'),lpad(dmm.c4::text,2,'0')) as rango " &						"from keplersc.kdm1 dm1 " &						"inner join keplersc.kdmm dmm on col_sucursal=dm1.c1 and dmm.c1=dm1.c2 and dmm.c2=dm1.c3 and dmm.c3=dm1.c4 and dmm.c4=dm1.c5 " &						"left join keplersc.kdudcfd udcfd on udcfd.c1=dm1.c10 " &						"where dmm.c80='S' and dm1.c1='" & suc_bus  & "' " &						"and dm1.c9 between '" & fecini  & "' and '" & fecfin & 						"' group by dm1.c1,dm1.c2,dm1.c3,dm1.c4,dm1.c5,dm1.c6,dm1.c9,dm1.c10,dm1.c22,dm1.c160,dm1.c161,dm1.c162,dm1.c164,dm1.c32,rango " &						" order by dm1.c9 desc) as resultado " &						"where rango between '" & doctoini & "' and '" & doctofin & "'";				}				if (fecini &= "" && fecfin &= "" && doctoini &!"0000" && doctofin &!"0000"){					frn.message("Debe especificar un rango de fechas","Error","Aceptar");					return;					}				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRequest");									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cfdiview.Buscar()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								totOrd = nXml(cuboResultados);							frn.rst("tabla");				for (contOrd=0; contOrd<totOrd ; contOrd++){			        frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c0"),"tabla",contOrd,"seleccionar");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"validacfdi"),"tabla",contOrd,"validacfdi");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c1"),"tabla",contOrd,"sucursal");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c2"),"tabla",contOrd,"gen");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c3"),"tabla",contOrd,"nat");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c4"),"tabla",contOrd,"gpo");                    frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c5"),"tabla",contOrd,"tipo");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c6"),"tabla",contOrd,"folio");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c9"),"tabla",contOrd,"fecha");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c10"),"tabla",contOrd,"cliente");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c22"),"tabla",contOrd,"rfc");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c160"),"tabla",contOrd,"f_pago");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c161"),"tabla",contOrd,"cuenta");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c162"),"tabla",contOrd,"m_pago");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c164"),"tabla",contOrd,"uso_cfdi");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c32"),"tabla",contOrd,"nombre"); 				}				}					fun Seleccionar() {				var irow, icol;				if (frn.get("tabla",-1,"seleccionar") &= "N") {					if (frn.get("tabla",-1,"validacfdi") &= "Sin validacion") {						continua = frn.message("Desea validar la informacion del cliente para regenerar el cfdi?","Atencion",2);												if (continua == 0){							return;						} else{														if ( strlen(frn.get("tabla",-1,"cliente")) != 0 ) {								frn.dialog("icfdreview",frn.get("k_sucn",-1,1),frn.get("tabla",-1,"cliente"),"Actualiza_datcfdi","","","");							}											}					}				}else {					frn.setX("N","tabla",-1,"seleccionar");				}			}			fun Actualiza_datcfdi(){		//esta es la funcion que debe ejecutar al regreso del icfdreview				var suc = frn.get("k_sucn", -1, 1);				var cte = frn.get("tabla",-1,"cliente");				if (frn.get("datcfdi") &= "S"){					frn.setX("Validado","tabla",-1,"validacfdi");					frn.setX("S","tabla",-1,"seleccionar");					frn.set("datcfdi","N");/*//Este codigo es para actualizar la tabla con los cambios de la pantalla icfdreview que graba en kdudcfd, 					cmdQuery= "select udcfd.c11 as k_rfc,udcfd.c2 as k_nombre," &						"udcfd.c20 as k_f_pago,udcfd.c23 as k_cfdi,udcfd.c22 as k_cuenta,udcfd.c21 as k_m_pago " &						"from keplersc.kdudcfd udcfd " &						"where udcfd.c1='" & cte  & "' and udcfd.c13='" & suc  &"'";					frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\cmdRequest");											cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cfdiview.Buscar()");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.setX(getXmlAtt(cuboResultados,"r0","k_rfc"),"tabla",-1,"rfc");					frn.setX(getXmlAtt(cuboResultados,"r0","k_f_pago"),"tabla",-1,"f_pago");					frn.setX(getXmlAtt(cuboResultados,"r0","k_cuenta"),"tabla",-1,"cuenta");					frn.setX(getXmlAtt(cuboResultados,"r0","k_m_pago"),"tabla",-1,"m_pago");					frn.setX(getXmlAtt(cuboResultados,"r0","k_cfdi"),"tabla",-1,"uso_cfdi");					frn.setX(getXmlAtt(cuboResultados,"r0","k_nombre"),"tabla",-1,"nombre");*/				} else {					frn.setX("Sin validacion","tabla",-1,"validacfdi");					frn.setX("N","tabla",-1,"seleccionar");				}			}			fun Ejecuta(){				var xmlPantalla,resultado,mensaje,folio,adicionales,contErr,nCampos,separacion,renglones;				var strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua, str_folio,str_error;				fecha = sys.date();				hora= sys.time();				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;				continua = frn.message("Desea continuar con la Regeneracion xml cfdi?","Atencion",2);				if (continua == 0){					return;				}							xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				setXml(xmlPantalla,"tip_ope",tipoOper);				setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"tabla","no_partidas",frn.N("tabla"));				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaRegenCfdi");				cmdQuery="SELECT * FROM keplersc.cfd_regenera_masivo('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cdfiview.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadCdfiview");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");				adicionales = getXml(cuboQuery,"adicionales");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					if (strlen(adicionales)>0){						strMsg = "Se regeneraron " & mensaje & " xml para Cfdi,| Hubo errores, revisar la columna de Error";					} else {						strMsg = "Se regeneraron " & mensaje & " xml para Cfdi";					}							renglones = frn.N("tabla");						for (var i=0; i<renglones; i++) {							if (frn.get("tabla",i,"seleccionar") &= "S"){								nCampos = strSplit(adicionales,"~",-1);								//folio-error~folio-error~folio-error~								if (nCampos > 1) {																		for (contErr=0; contErr<nCampos ; contErr++){										separacion = strSplit(adicionales,"~",contErr);										if (strlen(separacion)>0){											str_folio = strSplit(separacion,"-",0);			//Folio											str_folio = trim(frn.lib("libGeneral.kpl","StrReplace",str_folio,"~",""));											str_error = strSplit(separacion,"-",1);			//Error											str_error = trim(frn.lib("libGeneral.kpl","StrReplace",str_error,"~",""));											if (frn.get("tabla",i,"folio") &= str_folio){												frn.setX(str_error,"tabla",i,"error");											}										}										}										}											}						}					frn.message(strMsg, "Mensaje", "Aceptar");				} else {					frn.message(mensaje, "Error", "Aceptar");					return;				}			}								fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>