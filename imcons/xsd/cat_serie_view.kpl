<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Catalogo de Series"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/>	<tab/>	<inp id="inp_titulo" dim="50,1" clr="0,0,0"  type="string" modify="N" available="N" fnt="Arial,22"/>	<br/>	<tab n="1"/>	<hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp bclr="236,240,243" fntClrBrdr="255,206,0" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="82,45,10,10" brdr="0,5" tit="Series" fnt="Arial,16">		<tab/><txt clr="0,58,112">No. Serie:</txt>		<inp id="vin" dim="17,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/>		<tab/><txt clr="0,58,112">Placas:</txt>		<inp id="placas" dim="8,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/>		<tab/><txt clr="0,58,112" hk="S">Sucursal</txt>		<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="25,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><tab n="1"/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		<br/>			<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" OnEnter="Exit" OnMouseD="Exit" dim="76,22" modify="N" nren="fijo">		<col id="identificador" name="Identificador"/>		<col id="marca" name="Marca"/>		<col id="modelo" name="Modelo"/>		<col id="serie" name="Serie"/>		<col id="color" name="Color"/>		<col id="ano" name="A&#241;o"/>		<col id="placs" name="Placas"/>		<col id="contacto" name="Contacto"/>				</tbl>  <br/>		<tab n="7"/>		<bot id="k_btn_nvo" dim="10,10" brdr="5" text="Nuevo" hk="K" default="0" step="1"  OnEnter="abrir_curd(Nuevo)" fnt="Arial,16b" visible="N"/> 		<bot id="k_btn_mod" dim="10,10" brdr="5" text="Modificar" hk="K" default="0" step="1"  OnEnter="abrir_curd(Modificar)" fnt="Arial,16b" visible="Y"/> 		<bot id="k_btn_elimnr" dim="10,10" brdr="5" text="Eliminar" hk="K" default="0" step="1"  OnEnter="abrir_curd(Eliminar)" fnt="Arial,16b" visible="N"/> 		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Consultar" hk="K" default="0" step="1"  OnEnter="abrir_curd(Consultar)" fnt="Arial,16b" visible="N"/> <br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,rol_usuario ,perfil_usuario,asterisco ,serie_completa ,externo,accion ;			fun Main(){				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								ctrls_off();								Inicializa();										}						fun ctrls_off(){						frn.setAtt("k_btn_nvo", "visible", "N");				frn.setAtt("k_btn_mod", "visible", "N");				frn.setAtt("k_btn_elimnr", "visible", "N");				frn.setAtt("k_btn_cons", "visible", "N");						}						fun Inicializa(){				frn.set("inp_titulo","Catálogo de Series");				externo = frn.param(0);				serie_completa = frn.param(2);				accion = frn.param(3);				if (externo &! "s"){					frn.setAtt("k_btn_nvo", "visible", "Y");					frn.setAtt("k_btn_mod", "visible", "Y");					frn.setAtt("k_btn_elimnr", "visible", "Y");					frn.setAtt("k_btn_cons", "visible", "Y");				}							if (accion &= "Modificar"){					frn.setAtt("k_btn_nvo", "visible", "N");					frn.setAtt("k_btn_mod", "visible", "Y");					frn.setAtt("k_btn_elimnr", "visible", "N");					frn.setAtt("k_btn_cons", "visible", "N");				} else {					 if (accion &= "Consultar"){						frn.setAtt("k_btn_nvo", "visible", "N");						frn.setAtt("k_btn_mod", "visible", "N");						frn.setAtt("k_btn_elimnr", "visible", "N");						frn.setAtt("k_btn_cons", "visible", "Y");					} else{						if (accion &= "Eliminar"){							frn.setAtt("k_btn_nvo", "visible", "N");							frn.setAtt("k_btn_mod", "visible", "N");							frn.setAtt("k_btn_elimnr", "visible", "Y");							frn.setAtt("k_btn_cons", "visible", "N");						}						}				}								var cmd,cubo,ok;							//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}													frn.set("k_sucN",getXml(cubo));										}						fun Buscar() {							var xmlRequest,cmd,ok,cuboResultados, tot , cont, identificador ,serie, marca, modelo, color, ano, placs,contacto;						var vin = frn.get("vin");				var placas = frn.get("placas");				var suc = frn.get("k_sucN" , -1, 1);								cmd= "select s.c1,s.c4,s.c2,s.c3,s.c10,s.c11,s.c8,s.c9 from keplersc.kdserie as s inner join keplersc.kdud as cli on s.c9=cli.c2 where cli.c1='"& suc &"'";								if (vin &! ""){					cmd = cmd & " and (s.c1 like upper('%" & vin & "%') or s.c4 like upper('%" & vin & "%'))";				}								if (placas &! ""){					cmd = cmd & " and s.c8 ='" & placas  & "'";				}								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_serie_view.Buscar()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								tot = nXml(cuboResultados);							frn.rst("tabla");				for (cont=0; cont<tot; cont++){								identificador = getXmlAtt(cuboResultados,"r"&cont,"c1");					serie= getXmlAtt(cuboResultados,"r"&cont,"c4");					marca= getXmlAtt(cuboResultados,"r"&cont,"c2");					modelo= getXmlAtt(cuboResultados,"r"&cont,"c3");					color= getXmlAtt(cuboResultados,"r"&cont,"c10");					ano= getXmlAtt(cuboResultados,"r"&cont,"c11");					placs= getXmlAtt(cuboResultados,"r"&cont,"c8");					contacto= getXmlAtt(cuboResultados,"r"&cont,"c9");										frn.setX(identificador,"tabla",cont,"identificador");					frn.setX(serie,"tabla",cont,"serie");					frn.setX(marca,"tabla",cont,"marca");								frn.setX(modelo,"tabla",cont,"modelo");					frn.setX(color,"tabla",cont,"color");								frn.setX(ano,"tabla",cont,"ano");					frn.setX(placs,"tabla",cont,"placs");					frn.setX(contacto,"tabla",cont,"contacto");							}							}									fun abrir_curd(accion){							if (accion &! "Nuevo"){									var param = frn.get("tabla", -1, "serie");													if (param &= ""){										frn.message("No has seleccionado VIN","Error","Aceptar");									}else{										frn.dialog("cat_serie_crud",accion, param, "n");					}				}else {									frn.dialog("cat_serie_crud", accion, "x", "n");									}							}									fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}						fun Exit(){								if (externo &= "s"){									if (serie_completa &= "n"){						frP.set(frn.param(1),frn.get("tabla", -1, "identificador")); 					}else {						frP.set(frn.param(1),frn.get("tabla", -1, "serie")); 					}										frP.scriptElm(frn.param(1),"OnChange");					frn.exit();									}					}		}	</script></pag>