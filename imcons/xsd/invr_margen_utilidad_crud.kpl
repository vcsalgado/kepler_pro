<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Configuracion de Margen de Utilidad"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">	<tab/><txt fnt=",22" clr="0,0,0">Configuracion de Margen de Utilidad</txt><tab/>	<br/>		<tab/><hLine clr="0,0,0"	dim="45,0,0,0"/>	<br/>	<br/><tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="45,25,10,17" brdr="0,5" tit="Margen de Utilidad" fnt="Arial,16">		<br/>		<sp/>				<tbl id="k_mov" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="88,20" modify="Y" Reorder="Y" available="Y" insdel="Y">			<col name="Clave" id="clave"  modify="N" visible="Y" nc="5" available="N"/>			<col name="Descripcion" id="descripcion"  nc="20" visible="Y" modify="N" available="N"/>			<col name="Metodo" id="metodo"  nc="1" visible="Y" type="number" modify="Y" available="Y"/>			<col name="% Utilidad" id="utilidad"  nc="6" visible="Y" type="number" nd="2" modify="Y" available="Y"/>			<col name="% IVA" id="iva"  modify="Y" visible="Y" nc="6" type="number" available="Y"/>			<col name="Catalogo" id="catalogo"  nc="2" visible="Y" type="number" modify="Y" available="Y"/>				<col name="Comisionable" id="comisionable" OnF9="esquema_sel()" nc="1" OnChange="insert_registro_esquema()"  visible="Y" modify="Y" available="Y"/>		</tbl>		<br/><sp/>		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Guardar" hk="K" default="1" step="0"  OnEnter="Guardar()" fnt="Arial,16"/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, asterisco  ;		var cmdQuery, cuboQuery, ok, mensajeError;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			rol_usuario = frn.config("user","role");			asterisco = "*";						ConfiguraUI();			Inicializa();		}            		fun ResetDetalle(){			frn.rst("k_mov");		}				fun ObtenerMargen(){			var xmlPantalla;			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			cmdQuery = "select c1 as  clave, c2 as descripcion, c3 as metodo, c4 as utilidad, c5 as iva, c6 as catalogo, c7 as comisionable from keplersc.kdicatprecio";						rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"invr_margen_utilidad_crud.ObtenerMargen");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_mov",cuboQuery);					}				fun Guardar(){			var xmlPantalla,no_partidas,resultado,mensaje,adicionales;			//Validaciones			no_partidas=frn.N("k_mov")-1;			if (no_partidas==0) {				frn.message("Error, no se tiene registros de configuracion","Error","Aceptar");				return;			}			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;						setXml(xmlPantalla ,"k_partidas","no_partidas",no_partidas);						frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlMargen");			cmdQuery="select * from keplersc.invr_margen_utilidad_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						kdb.rst(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"invr_margen_utilidad_crud.Guardar");			resultado= getXml(cuboQuery,"resultado");			mensaje= getXml(cuboQuery,"mensaje");							if(resultado &= "0"){				frn.message(mensaje,"Error","Aceptar");				return;			}			ResetDetalle();			ObtenerMargen();						frn.message("Registros modificados","Mensaje","Aceptar");					}				fun ConfiguraUI(){			if (frn.nParam() == 0){				frn.message("Accion no permitida.","Error","&Aceptar");//				frn.open("redirect",2);				return;			}		}				fun Inicializa(){			frn.rst("gpo_2");			ResetDetalle();			ObtenerMargen();		}			}				</script></pag>