<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Alta Tarjeta"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">	<txt fnt=",22" clr="0,0,0">  Alta Tarjeta</txt><tab/>	<br/>	<hLine clr="0,0,0"	dim="25,0,0,0"/>	<br/>	<br/>	<grp id="grupo" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="25,6,10,30" brdr="0,5" tit="Consulta" fnt="Arial,16">		<br/>		<tab/>									<txt>Sucursal de Ventas: </txt>			<tab n="1"/><sp/>			<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1"  bclr="255,255,255" brdr="0,2" fnt="Arial,16" Null="N" hk="S"  available="N" modify="N"/>		<sp/>		<br/>				<tab/>					<txt>VIN (Completo): </txt>			<tab n="2"/><sp/>			<inp id="vin" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" OnF9="obtenerSerie()"/>		<sp/>		<br/>		<br/>		<tab/>		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Guardar" hk="K" default="0" step="0"  OnEnter="Execute()" fnt="Arial,16" visible="Y" available="Y"/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, asterisco,usuario   ;		var cmdQuery, cuboQuery, ok, mensajeError,sucursal_id, resVal;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();			usuario = frn.config("user","name");			suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			rol_usuario = frn.config("user","role");			asterisco = "*";											ConfiguraUI();			Inicializa();					}		fun vacia_campos(){			frn.rst("k_suc");			frn.rst("vin");		}            		fun Execute() {					var resultado_confirmacion = frn.message("Desea continuar?","Mensaje de Confirmacion", 2);			if (resultado_confirmacion &! 1)  {				return;			}						var xmlRequest = getXml(frn.dataPag());						setXml(xmlRequest,"document","usuario", usuario );						frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");					cmdQuery="SELECT * FROM keplersc.alta_tarjeta('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";			frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\cmdAltaTarjeta");						var cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"alta_tarjeta.Execute()");				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");								var resultado=getXml(cubo ,"resultado");						var mensaje = getXml(cubo ,"mensaje");						if(resultado &= "0"){				frn.message(mensaje ,"Error","Aceptar");				return;			}					frn.setAtt("k_btn_cons", "available", "N" );			frn.setAtt("k_btn_cons", "visible", "N" );			frn.message(mensaje ,"Mensaje","Aceptar");					}								fun ConfiguraUI(){			if (frn.nParam() == 0){				frn.message("Accion no permitida.","Error","&Aceptar");				frn.open("redirect",2);				return;			}		}				fun Inicializa(){									//Llenar combo sucursales				var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));								frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));			}								fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}											fun obtenerSerie(){						cmdQuery = "select s.c4 as vin,s.c2 as marca,s.c3 as modelo, s.c9 as cve_cte ,s.c16 as cliente					from keplersc.kdserie as s";				frn.dialog("genlistafiltrosel","Catálogo de Series",cmdQuery,"vin","vin","0","0","S","N");			}          					}				</script></pag>