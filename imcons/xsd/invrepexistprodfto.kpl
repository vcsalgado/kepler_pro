<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de " scale="48">	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,15" unfont="0">		<br exe="encabezado"/>		<hLine dim="90,0" g="2" type="1"/>		<br exe="encabezado"/>		<grp dim="10,7,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>		<tab n="1"/>		<grp dim="62,5,7,12">			<br/>			<inp id="k_empresa" fnt=",20b" dim="80,1" clr="0,58,112" type="string" available = "N"/>			<br/>			<txt fnt=",16b" clr="0,58,112">Reporte de Existencias de Productos al mes </txt>			<inp id="k_fecha" fnt=",16b" dim="15,1" clr="0,58,112" type="string" just="L" fmt="DD/MM/CCYY" available = "N" nc="-1"/>			<br/>				<inp id="k_sucursal" fnt=",16b" dim="80,1" clr="0,58,112" type="string" available = "N"/>			<br/>		</grp>		<tab n="1"/>		<grp dim="20,5,7,12">			<br/>			<txt>P&#225;g:</txt><tab/><inp id="k_pag" dim="4,1" type="number" just="L" mcr="k_pag"/>			<br/>			<txt>Fecha:</txt><tab/><inp id="k_fecha_imp" dim="10,1" type="date" just="L" fmt="DD-MM-CCYY"/>			<br/>			<txt>Hora:</txt><sp/><tab n="1"/><inp id="K_hora_imp" dim="5,1" type="time" just="L"/>		</grp>		<br exe="encabezado"/>		<sp/><txt fnt=",b">Clave</txt>		<tab n="3"/><txt fnt=",-1b">Descripci&#243;n</txt><tab n="8"/><txt fnt=",b">Exist.</txt><tab n="2"/><txt fnt=",0b">Valor </txt><tab/><txt fnt=",0b">Promedio</txt><tab n="2"/><txt fnt=",0b">M&#237;nimo</txt><tab n="2"/><txt fnt=",0b">M&#225;ximo</txt>		<tab/><txt fnt=",-1b">Loc.</txt>			<br exe="encabezado"/>		<hLine dim="90,0" g="2" type="1"/>		<br exe="encabezado"/>				<sp/><inp id="k_prod_clave" dim="10,1" type="string" fnt=",0" modify="N"/>		<sp/><inp id="k_prod_descripcion" dim="25,1" type="string" fnt=",0" modify="N"/><tab/>		<inp id="k_exist" dim="8,1" type="decimal" modify="N"  just="R"/><tab/><inp id="k_valor" dim="8,1" type="decimal" modify="N" just="R"/><tab/><inp id="k_prom" dim="8,1" type="decimal" modify="N" just="R"/><tab/><inp id="k_min" dim="8,1" type="decimal" modify="N" just="R"/><tab/><inp id="k_max" dim="8,1" type="decimal" modify="N" just="R"/><tab/>		<inp id="k_loc" dim="6,1" type="string" modify="N"/>		<br exe="seccion_detalle"/>						<hLine dim="90,0" g="2" type="1"/>		<br exe="seccion_total_reporte"/>				<sp/><txt fnt=",b">Resumen del Reporte</txt><tab n="9"/>		<inp id="k_tot_exist" dim="8,1"  type="decimal" just="R"/><tab/>		<inp id="k_tot_valor" dim="8,1"  type="decimal" modify="N" just="R"/><tab/>		<inp id="k_tot_prom" dim="8,1"  type="decimal" just="R"/>		<br exe="seccion_total_reporte"/>			</grp></pag>