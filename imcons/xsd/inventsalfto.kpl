<?xml version="1.0" encoding="UTF-8"?><pag xmlns='www.kepler.com.mx/2003/KSchema' tit='Entradas' scale="48"><grp dim='1,-1,10,20' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">	<grp dim="15,8,7,12"><sp/>		<img id="img"  dim="14,80" brdr="0,1" img="logocliente.jpg"/>	</grp>	<grp dim="40,8,7,1">		<inp id="titulo"  dim="50,1" brdr="0,1" type="string" fnt="Arial,30b"/><br/><tab n="4"/><sp/>		<br/>		<txt fnt="Arial,18">Sucursal:</txt>		<inp id="rep_suc"  just="L" dim="60,1" brdr="0,1" type="string" fnt="Arial,17" nc="20"/><br/>	</grp><br exe="encabezado"/>		<sp/>	<grp dim="65,7,7,14" visible="N" brdr="2,5"/>	<tab n="1"/>	<grp id="tipo" dim="20,5,7,2" brdr="2,5" tit="Documento"><br/>		<sp/><txt fnt="Tahoma,21" clr="255,0,0">No.</txt><inp id="rep_folio"  dim="12,1" brdr="0,1" type="string" fnt="Tahoma,21" clr="255,0,0" nc="7"/><br/>		<sp/><inp id="rep_docto"  dim="20,1" brdr="0,1" type="string" fnt="Arial,14"/><br exe="encabezado"/><br/>		<sp/><txt>Fecha:</txt>			<tab/><inp id="rep_fecha" dim="20,1" brdr="0,1" type="date" fnt="Arial,15" fmt="DD/MM/CCYY" nc="-1"/><br/>	</grp>		<br exe="encabezado"/>	<br exe="encabezado"/>		<sp/>	<inp id="Clav_rep"  dim="15,1" bclr="136,137,150" type="string" just="L" clr="252,252,252">Clave</inp>	<inp id="Desc_rep"  dim="33,1" bclr="136,137,150" type="string" just="L" clr="252,252,252">Descripci&#243;n</inp>		<inp id="Cantidad_rep"  dim="7,1" bclr="136,137,150" type="string" just="C" clr="252,252,252">Cant.</inp>	<inp id="Uni_rep"  dim="5,1" bclr="136,137,150" type="string" just="C" clr="252,252,252">Unidad</inp>	<inp id="Cost_unit"  dim="8,1" bclr="136,137,150" type="string" just="C" clr="252,252,252">Monto</inp>	<inp id="Impor_rep"  dim="11,1" bclr="136,137,150" type="string" just="C" clr="252,252,252">Importe</inp>	<inp dim="8,1" bclr="136,137,150" type="string" just="C" clr="252,252,252"/>	<inp dim="8,1" bclr="136,137,150" type="string" just="C" clr="252,252,252"/>	<br exe="partidas"/>	<sp/>		<inp id="rep_clave"  dim="15,1" brdr="0,1" just="L" type="string" fnt="Arial,15" nc="20"/>		<inp id="rep_producto"  dim="30,1" brdr="0,1" just="L" type="string" fnt="Arial,15" nc="-1"/>		<inp id="rep_cantidad"  dim="8,1" brdr="0,1" just="R" type="number" fnt="Arial,15"/><tab/>		<inp id="rep_unidad"  dim="3,1" brdr="0,1" just="L" type="string" fnt="Arial,15" nc="5"/>		<inp id="rep_precio"  dim="8,1" brdr="0,1" bclr="255,255,255" just="L" type="number" nc="10" fnt="Arial,15" nd="2"/>		<inp id="rep_importe"  dim="9,1" brdr="0,1" just="R" type="number" fnt="Arial,15" nd="2" nc="-1"/>	<br exe="partida"/><tab n="4"/><sp/><tab n="5"/><sp/>				<br/>		<sp/><hLine dim="89,0"/><br exe="lineaFinal"/>		<tab n="21"/>						<grp dim="15,12,4,4">			<sp/><txt fnt="Arial,15b">TOTAL</txt>				<sp n="2"/><tab n="3"/><inp id="rep_total"  dim="14,1" brdr="0,1" just="R" type="number" fnt="Arial,15b" nd="2"/>		</grp><br exe="fin"/><br exe="fin"/><inp id="rep_TotalLetras"  dim="87,1" brdr="0,1" just="C" type="string" fnt="Arial,15"/>		<br exe="fin"/><br exe="fin"/><tab/><sp/>	<grp dim="43,10,7,12" brdr="0,7" visible="Y">		<txt fnt="Arial,0b" clr="0,0,0" bclr="255,255,255">Comentarios:</txt><br/>		<tab/><inp id="rep_comentario1"  dim="47,1" brdr="0,1" type="string" fnt="Arial,15"/><br/><tab n="3"/><sp n="2"/>		<tab/><inp id="rep_comentario2"  dim="47,1" brdr="0,1" type="string" fnt="Arial,15"/><br/><tab n="3"/><sp n="2"/>		<tab/><inp id="rep_comentario3"  dim="47,1" brdr="0,1" type="string" fnt="Arial,15"/>	</grp><br exe="Comentarios"/><tab n="5"/>						</grp>	<script>	/*	----------------------------------------------------------------	AUTOR						FECHA					CAMBIO	----------------------------------------------------------------		----------------------------------------------------------------	CAMBIOS GRÁFICOS	----------------------------------------------------------------	AUTOR						FECHA					ELEMENTO				CAMBIO	-------------------------