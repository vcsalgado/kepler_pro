			<inp id="nPol"  dim="15,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15b"/>
			<br exe="encabezadoPol"/>
			<br exe="encabezadoPol"/>
			<sp/><txt fnt="Arial,15b">N&#250;mero</txt><tab n="6"/>
			<txt>Cuenta</txt><tab n="6"/>
			<txt>          Referencia</txt><tab n="3"/>
			<txt>Debe</txt><tab n="4"/>
			<txt>Haber</txt>
			<br exe="encabezadoPol"/>
			<hLine dim="95,0" g="2"/>
			<br  exe="encabezadoPol"/>
			<inp id="PolClave"  dim="20,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/>
			<inp id="PolDescr"  dim="25,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/>
			<inp id="PolRefer" dim="10,1" type="string" just="R" fnt="Arial,15" brdr="0,1"/><tab/>
			<inp id="PolDebe"  dim="15,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15" nd="2"/>
			<br exe="partPolC"/>
			<inp id="PolClave2"  dim="20,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/>
			<inp id="PolDescr2"  dim="25,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15"/>
			<inp id="PolRefer2" dim="10,1" type="string" just="R" fnt="Arial,15" brdr="0,1"/><tab/>
			<inp id="espacio"  dim="15,1" brdr="0,1" bclr="255,255,255" type="string" fnt="Arial,15" nd="2"/>
			<inp id="PolHaber"  dim="15,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15" nd="2"/>
			<br exe="partPolA"/>
			<hLine dim="95,0" g="2"/>
			<br exe="PolTotales"/>
			<tab n="16"/><txt>Sumas    </txt><tab/>
			<inp id="totCargo"  dim="15,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15b" nd="2"/>
			<inp id="totAbono"  dim="15,1" brdr="0,1" bclr="255,255,255" type="number" fnt="Arial,15b" nd="2"/>
			<br exe="PolTotales"/><tab/>
			<br exe="fin"/>
			<hLine dim="95,0" g="2" type="1"/>	
			<br exe="notastitulos"/><tab n="1"/>
