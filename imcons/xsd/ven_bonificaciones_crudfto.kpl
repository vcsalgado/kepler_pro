<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de Subsidio GMAC" scale="48">
	<grp dim="1,-1,10,25" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,15" unfont="0">		
		<br exe="encabezado"/>
		<hLine dim="95,0" g="2" type="1"/>
		<br exe="encabezado"/>
		<grp dim="13,5,7,12">
			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>	
		</grp>
		<grp dim="62,6,7,12">
			<br/>
			<inp id="nombreempresa" dim="60,1"  fnt="19b,19b"  type="string" modify="N" brdr="1,0" bclr="255,255,255" just="C"/>
			<br/>
			<br/><tab n="8"/>
			
			<txt fnt=",19b" clr="0,58,112">Registro de Subsidio de GMAC</txt>
			<br exe="encabezado"/>			
			<br exe="encabezado"/>
		</grp>
		<grp dim="15,4,7,12">
			<tab n="2"/><txt>P&#225;g:   </txt>
			<inp id="k_pag" dim="5,1" type="number" mcr="k_pag"/><br/><br/>
			<inp id="fecha" dim="10,1" type="date" fmt="DD-MM-CCYY" nc="-1" just="R"/>
			<inp id="hora" dim="7,1" type="time" nc="-1" just="L"/>
		</grp>
			<br exe="encabezado"/>
			<hLine g="2" dim="95,0"/><br  exe="encabezadoPol"/><tab n="11"/>
			<txt>P O L I Z A  C O N T A B L E</txt><br exe="encabezadoPol"/>
			<sp/><txt fnt="Arial,18b">P&#243;liza </txt>
