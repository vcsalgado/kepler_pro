	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;
			var tipoOper,consPlantilla, accion, clave; //Variables relacionadas con parametros (colsulta , eliminar, baja)
			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna, cmdQuery, cubo, ok, mensajeError; 
			fun Main(){
				frn=new FRNT;
				kdb=new KDB;
				frP=new FRNTP;
				sys=new SYS;
				kdb.connect();
				
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				perfil_usuario = frn.lib("libKepler","UserInfo(2)");
				rol_usuario = frn.config("user","role");
				asterisco = "*";
				
				accion = frn.param(0);
				clave =frn.param(1);
				Inicializa(clave);
				ConfiguraUI(accion);
			}

		fun aplica_crud(accion){
			var query_auto, cuboQuery, resultado, mensaje, mensajeError, query, xmlPantalla;
			var k_clave=frn.get("k_clave");
			var k_desc=frn.get("k_desc");
			var k_clase=frn.get("k_clase");
			var k_marca=frn.get("k_marca");
			var k_tipo_cal_isa=frn.get("k_tipo_cal_isa");
			var k_linea=frn.get("k_linea");
			var k_nuevo_usado=frn.get("k_nuevo_usado");
			var k_meses_entrega=frn.get("k_meses_entrega");
			var k_v_se_prod=frn.get("k_v_se_prod");
			var k_precio_lista=frn.get("k_precio_lista");
			var k_cilindros=frn.get("k_cilindros");
			var k_ocupantes=frn.get("k_ocupantes");
			var k_procedencia=frn.get("k_procedencia");
			var k_combustible=frn.get("k_combustible");
			var k_n_puertas=frn.get("k_n_puertas");
			var k_fecha_ini_ven=frn.get("k_fecha_ini_ven");
			var k_vehiculo_reemplaza=frn.get("k_vehiculo_reemplaza");
			var k_no_usar_regla_3_mes=frn.get("k_no_usar_regla_3_mes");
			var k_codigo_sat=frn.get("k_codigo_sat");
			var codigo_sat_descrip=frn.get("codigo_sat_descrip");
			var k_unidad_medida=frn.get("k_unidad_medida");
			var k_desc_tabla_1 =frn.get("tabla", 0, "c2");
			var k_desc_tabla_2 =frn.get("tabla", 0, "c3");
			var k_desc_tabla_3 =frn.get("tabla", 0, "c4");
			var k_desc_tabla_4 =frn.get("tabla", 0, "c5");
			var k_desc_tabla_5 =frn.get("tabla", 0, "c6");
			var k_desc_tabla_6 =frn.get("tabla", 0, "c7");
			var k_desc_tabla_7 =frn.get("tabla", 0, "c8");
			var k_desc_tabla_8 =frn.get("tabla", 0, "c9");
			var k_desc_tabla_9 =frn.get("tabla", 0, "c10");
			var k_desc_tabla_10 =frn.get("tabla", 0, "c11");
			var k_desc_tabla_11 =frn.get("tabla", 0, "c12");
			var k_desc_tabla_12 =frn.get("tabla", 0, "c13");
			var k_desc_tabla_13 =frn.get("tabla", 0, "c14");
			var k_desc_tabla_14 =frn.get("tabla", 0, "c15");
			var k_desc_tabla_15 =frn.get("tabla", 0, "c16");
			var k_desc_tabla_16 =frn.get("tabla", 0, "c17");
			var k_desc_tabla_17 =frn.get("tabla", 0, "c18");
			var k_desc_tabla_18 =frn.get("tabla", 0, "c19");
			var k_desc_tabla_19 =frn.get("tabla", 0, "c20");
			
			//MSS:02-08-2023 Armar xml para llamar funcion de PostgreSQL cat_vehiculo_crud
			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
			setXml(xmlPantalla,"k_descripcion",k_desc);
			setXml(xmlPantalla,"k_calc_isan",k_tipo_cal_isa);
			setXml(xmlPantalla,"k_nou",k_nuevo_usado);
			setXml(xmlPantalla,"k_mesesprom",k_meses_entrega);				
			setXml(xmlPantalla,"k_produce",k_v_se_prod);
			setXml(xmlPantalla,"k_precio",k_precio_lista);
			setXml(xmlPantalla,"k_puertas",k_n_puertas);
			setXml(xmlPantalla,"k_inivta",k_fecha_ini_ven);
			setXml(xmlPantalla,"k_reemplaza",k_vehiculo_reemplaza);
			setXml(xmlPantalla,"k_regla3",k_no_usar_regla_3_mes);	
			setXml(xmlPantalla,"k_codsat",k_codigo_sat);	

			if(accion &= "N"){
				setXml(xmlPantalla,"input_crud","NUEVO");
				//frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"c:\basura\XmlPantallaCrud_autosAlta");
				if(k_clave &= ""){
					frn.message("La clave no puede estar vacia","Mensaje","&Aceptar");
					frn.setPos("k_clave");
				}else if(k_desc &= ""){
