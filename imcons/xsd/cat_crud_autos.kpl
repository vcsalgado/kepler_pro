		fun clave_tabla(){
			var k_clave = frn.get("k_clave");
			frn.setX(k_clave,"tabla",0,"c1");
		}

        fun carga_dat_tabla(){
			var k_clave = frn.get("k_clave");
			cmdQuery = "select *
							from keplersc.kdpaq 
							where  c1  = '"& k_clave &"'";
			cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conpolizasView.cargarPolizas()");
//			cubo = frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cubo,"r0");
			frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubo");
			frn.setX(cubo,"tabla");
			clave_tabla();
		}

		fun descrip_sat(){
			var k_codigo_sat = frn.get("k_codigo_sat");
			var cmd = "select c2 as descrip
				from keplersc.kdf3ps
				where c1 = '"& k_codigo_sat &"'";
			var cubo_desc = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_crud_autos.descrip_sat()");
			var cubo_descrip=getXmlAtt(cubo_desc,"r0","descrip");
//			frn.message(cubo_descrip, "Mensaje","&Aceptar");
			frn.set("codigo_sat_descrip", cubo_descrip);
//			frn.lib("libGeneral.kpl","FileSave",cubo_desc,"C:\Basura\cubo");
		}

		fun descrip_nou(){
			var nuevo_usado = frn.get("k_nuevo_usado");
			var cmd = "select c8 as nuevousado,
				case when c8 = 'N' then 'NUEVO'
				when c8 = 'U' then 'USADO'
				when c8 = '' then 'ERROR'
				end as descrip
				from keplersc.kdiv
				where c8 = '"& nuevo_usado & "'
				group by c8			
				order by c8 desc";
			var cubo_desc = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_crud_autos.descrip_nou()");
			var cubo_descrip=getXmlAtt(cubo_desc,"r0","descrip");
//			frn.message(cubo_descrip, "Mensaje","&Aceptar");
			frn.set("k_nuevo_usado_desc", cubo_descrip);
//			frn.lib("libGeneral.kpl","FileSave",cubo_desc,"C:\Basura\cubo");
		}

		fun cargaCata(clave){
			var queryCata, cubo_cata, ok, mensajeError, xml_cubo_cata, clave_auto, cubo, cmd;
			clave_auto = clave;
			queryCata = "select veh.c1 as k_clave,
							veh.c2 as k_desc,
							veh.c4 as k_clase,
							clas.c2 as k_desc_clase,
							veh.c5 as k_marca,
							mar.c2 as k_desc_marca,
							veh.c6 as k_tipo_cal_isa,
							isan.c2 as k_desc_cisan,
							veh.c7 as k_linea,
							lin.c2 as k_desc_linea,
							veh.c8 as k_nuevo_usado,
							case when veh.c8 = 'N' then 'NUEVO'
								when veh.c8 = 'U' then 'USADO'
								when veh.c8 = '' then 'ERROR'
							end as k_nuevo_usado_desc,
							veh.c10 as k_meses_entrega,
							veh.c11 as k_v_se_prod,
							veh.c14 as k_precio_lista,
							veh.c50 as k_cilindros,
							veh.c51 as k_ocupantes,
							veh.c52 as k_procedencia,
							veh.c53 as k_combustible,
							veh.c54 as k_n_puertas,
							veh.c26 as k_fecha_ini_ven,
							veh.c27 as k_vehiculo_reemplaza,
							veh.c28 as k_no_usar_regla_3_mes,
							veh.c30 as k_codigo_sat,
							veh.c31 as k_unidad_medida
							from keplersc.kdiv veh
							left join keplersc.kdic clas on clas.c1=veh.c4 
							left join keplersc.kdmarca mar on mar.c1=veh.c5
							left join keplersc.kdtisan isan on isan.c1=veh.c6
							left join keplersc.kdivl lin on lin.c1=veh.c7 
							left join keplersc.kdf3uni uni on uni.c1=veh.c31
							where veh.c1 = '"& clave_auto &"'";
				cubo_cata= frn.lib("libGeneral.kpl","EjecutarSqlSel",queryCata,"conpolizasView.cargarpolizas()");
				ok=getXmlAtt(cubo_cata,"ok");
				if(ok &! "" && !ok){
						mensajeError = getXmlAtt(cubo_cata,"native3");
						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
						frn.message(mensajeError,"Error","Aceptar");
						return;
				}	
//			frn.lib("libGeneral.kpl","FileSave",cubo_cata,"C:\Basura\cubo_cata");
			xml_cubo_cata=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cubo_cata,"r0");
//			frn.lib("libGeneral.kpl","FileSave",xml_cubo_cata,"C:\Basura\xml_cubo_cata");
			frn.setX(xml_cubo_cata);
			descrip_sat();
			carga_dat_tabla();

		}

			fun ConfiguraUI(accion){
				consPlantilla="PLANTILLA"; //AQUI DEFINE LA CONSTANTE PARA COMPARAR EN PARAMETROS
				if (frn.nParam() == 0){
					frn.message("Accion no permitida.","Error","&Aceptar");
					frn.open("redirect",2);
					return;
				}

				tipoOper = accion;
				//Establecer titulo de la ventana
				if (tipoOper &= "PLANTILLA"){
					frn.setAtt("gpo_2","tit","Catalogo PLANTILLA...");
					frn.set("k_titulo","Catalogo Vehiculos Plantilla");
				}
				else if (tipoOper &= "N"){
					frn.setAtt("gpo_2","tit","Catalogo de Autos Alta Nuevo");
					frn.set("k_titulo","Catalogo Vehiculos Alta");
					activaCampos();
				}
				else if (tipoOper &= "M"){
					frn.setAtt("gpo_2","tit","Catalogo de Autos Modificar");
					frn.set("k_titulo","Catalogo Vehiculos Modificar");
					activaCampos();
			 
				}
				else if (tipoOper &= "Eliminar"){
					frn.setAtt("gpo_2","tit","Catalogo de Autos Elimina Auto");
					frn.set("k_titulo","Catalogo Vehiculos Eliminar");
				}
				else if (tipoOper &= "C"){
					frn.setAtt("gpo_2","tit","Catalogo de Autos Consulta");
					frn.set("k_titulo","Catalogo Vehiculos Consulta");
					activaCampos();
				}
				else{
					frn.message("Accion no permitida.","Error","&Aceptar");
					frn.open("redirect",2);
					return;
				}
			}
					
			fun Inicializa(clave){
				frn.rst("gpo_2");
				Inicia_Forma(clave);
				frn.set("k_unidad_medida","XVN");
				BuscarUniMedida();
				}
	
