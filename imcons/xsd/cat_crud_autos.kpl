//MSS: Obtiene descripciones 
			fun BuscarLinea(){
				var linea_id;
				linea_id=frn.get("k_linea");
				cmdQuery = "select c2 as descripcion from keplersc.kdivl " &
						"where c1='" & linea_id & "'";
							
				rstXml(cubo);
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_autos.BuscarLinea()");
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;	
				}
				if((nXml(cubo) == 0) && (linea_id &! "")) {
					frn.setPos("k_linea");
					frn.message("La linea del vehiculo no existe","Error","Aceptar");
		
					return;
                 } else{
				    frn.set("k_desc_linea",getXmlAtt(cubo,"r0","descripcion"));	    
				}		
            }

			fun BuscarClase(){
				var clase_id;
				clase_id=frn.get("k_clase");
				cmdQuery = "select c2 as descripcion from keplersc.kdic " &
						"where c1='" & clase_id & "'";
							
				rstXml(cubo);
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_autos.BuscarClase()");
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;	
				}
				if((nXml(cubo) == 0) && (clase_id &! "")) {
					frn.setPos("k_clase");
					frn.message("La clase no existe","Error","Aceptar");
					return;
                } else{
				    frn.set("k_desc_clase",getXmlAtt(cubo,"r0","descripcion"));	    
				}
            }    

			fun BuscarCIsan(){
				var cisan_id;
				cisan_id=frn.get("k_tipo_cal_isa");
				cmdQuery = "select c2 as descripcion from keplersc.kdtisan " &
						"where c1='" & cisan_id & "'";
							
				rstXml(cubo);
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_autos.BuscarCIsan()");
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;	
				}
				if((nXml(cubo) == 0) && (cisan_id &! "")) {
					frn.setPos("k_calc_isan");
					frn.message("El tipo de calculo ISAN no existe","Error","Aceptar");
					return;
                 } else{
				    frn.set("k_desc_cisan",getXmlAtt(cubo,"r0","descripcion"));	    
				}		
            }

			fun BuscarMarca(){
				var marca_id;
				marca_id=frn.get("k_marca");
				cmdQuery = "select c2 as descripcion from keplersc.kdmarca " &
						"where c1='" & marca_id & "'";
							
				rstXml(cubo);
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_autos.BuscarMarca()");
				ok=getXmlAtt(cubo,"ok");
