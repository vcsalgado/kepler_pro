<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<br/>		<tab/><txt clr="0,0,0" fnt=",22">Generaci&#243;n de Marbetes</txt>		<br/>		<tab/><hLine dim="-1,1" clr="0,0,0"/>		<br/>		<tab/>		<br/>		<tab/>				<grp dim="50,15,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Generar Marbetes">			<br/>			<sp/><txt> Sucursal: </txt>			<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/>			<br/><sp/>			<txt clr="251,4,28" fnt=",16">*Se eliminar&#225;n todos los marbetes existentes y se crear&#225;n nuevamente.</txt>			<br/><sp/>			<txt clr="251,4,28" fnt=",16">*Se eliminar&#225; toda la captura de inventario que se haya realizado.</txt>						<br/><br/><tab n="7"/>			<bot id="bot_aceptar" dim="7" brdr="5" text="Generar" hk="G" OnEnter="Execute()"/>		</grp>		<br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco ;			var cmd,cubo,ok,mensajeError ;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";				Inicializa();							}			fun Inicializa(){				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invgenerarmarbets.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));				//frn.set("k_sucN",descr_combo("k_sucN",1,suc_usuario));				}									fun Execute() {				var xmlRequest;								var resultado_confirmacion = frn.message("¿Confirma la ejecución del proceso?","Mensaje de Confirmación", 2);				if (resultado_confirmacion &! "1")  {					return;				}								xmlRequest="<document>" & "<sucursal_id>" & frn.get("k_sucN",-1,1)& "</sucursal_id><parte>GENERARMARBETES</parte>" &"</document>";								cmd="SELECT * FROM keplersc.invr_generar_marbetes('" & xmlRequest & "')";				kdb.rst(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"invgenerarmarbetes.Execute()");										frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboMarbetes");							var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								if(resultado &= "1"){					var mensaje = "Proceso Terminado.";					frn.message(mensaje ,"Mensaje","Aceptar");				}			}		}	</script></pag>