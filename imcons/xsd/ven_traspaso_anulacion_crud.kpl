				var strValAtr;
				ConfiguraControlesOff();
				//HAbilita segun tipo de operacion
				strValAtr = "Y";
				switch(tip_ope){
					case 0: //Baja
						/*
						frn.setAtt("grpDatosGenerales","available",strValAtr);
						frn.setAtt("grpDatosGenerales","modify",strValAtr);
						frn.setAtt("grDocumentos","available",strValAtr);
						frn.setAtt("grDocumentos","modify",strValAtr);
						frn.setAtt("grpDetalle","available",strValAtr);
						frn.setAtt("grpDetalle","modify",strValAtr);
						frn.setAtt("grpInventario","available",strValAtr);
						frn.setAtt("grpInventario","modify",strValAtr);
						frn.setAtt("grpconceptosextras","available",strValAtr);
						frn.setAtt("grpconceptosextras","modify",strValAtr);
						frn.setAtt("grpComentarios","available",strValAtr);
						frn.setAtt("grpComentarios","modify",strValAtr);
						frn.setAtt("k_monto","modify",strValAtr);	
						frn.setAtt("k_cuenta","available",strValAtr);
						frn.setAtt("k_cuenta","visible",strValAtr);		
						frn.setAtt("k_coment","modify",strValAtr);
						frn.setAtt("k_coment","available",strValAtr);
						frn.setAtt("k_coment2","modify",strValAtr);
						frn.setAtt("k_coment2","available",strValAtr);
						frn.setAtt("k_coment3","modify",strValAtr);
						frn.setAtt("k_coment3","available",strValAtr);
						*/
						
						frn.setAtt("grpDatosGenerales","available",strValAtr);
						frn.setAtt("k_folio_ref","available",strValAtr);
						
						frn.setAtt("Aceptar","available",strValAtr);
						frn.setAtt("Aceptar","visible",strValAtr);	
						frn.setAtt("Cancelar","available",strValAtr);
						frn.setAtt("Cancelar","visible",strValAtr);
						
						break;
