			fun BorraDatos(){ //Limpia todos los campos para generar un nuevo documento. 
				frn.set("k_folio","","statusDoc","","k_clave","");				
				if(tip_ope>0) frn.setPos("k_folio");	
				frn.set("k_f_pago",descr_combo("k_f_pago",1, "99"));	
				frn.rst("k_clave");
				frn.rst("k_nombrecli");
				frn.rst("k_callecli");
				frn.rst("k_coloniacli");
				frn.rst("k_poblacioncli");
				frn.rst("k_cpcli");
				frn.rst("k_m_pago");	
				frn.rst("k_cfdi");
				frn.rst("k_cuenta");		
				frn.rst("k_correo");
				frn.rst("k_inventario");
				frn.rst("k_producto");
				frn.rst("k_serie");	
				frn.rst("k_importeprevio");	
				frn.rst("k_preciovehiculo");		
				frn.rst("k_iva");		
				frn.rst("k_monto");
				
			}
					
		
			fun Ejecuta(){
				if(tip_ope==0){Alta();}
				else if(tip_ope==1){Consulta();}
			}
						
			fun Alta()
			{
				var resultado, mensaje , mensajeError , cubo, xmlPantalla, fecha, hora, strFecha, strTmp, cmd,ok ;
				var partidasValidas = 0;
				kdb.rst();
				frn.rst("results");				
				if( frn.get("k_monto") <= 0 )
				{
					frn.message("Monto cero o negativo","Error","&Aceptar");return;
				}

				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
				
				fecha = sys.date();
				hora= sys.time();
				//cubo = "dat";
				kdb.rst();
				frn.rst("results");
				
				strFecha = fnDate("year",fecha) & "-";
				strTmp = fnDate("month",fecha);
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp & "-";
				strTmp = fnDate("day",fecha);
				if(strlen(strTmp) == 1){
					strTmp = "0" & strTmp;
				}
				strFecha = strFecha & strTmp;
				
				 //Obtener el xml de la pantalla;
				//Agregar usuario, fechay hora de movimiento
				setXml(xmlPantalla ,"movimiento","usuario",frn.lib("libKepler","UserInfo"));
				setXml(xmlPantalla ,"movimiento","fecha",strFecha);
				setXml(xmlPantalla ,"movimiento","hora",sys.time("hour",hora) & ":" & sys.time("min",hora));
				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);
				setXml(xmlPantalla,"ambiente","uen",uen);
				setXml(xmlPantalla,"k_refer",frn.get("k_inventario"));
				setXml(xmlPantalla,"k_claveinv",frn.get("k_inventario"));
				setXml(xmlPantalla,"k_serievehiculo",frn.get("k_serie"));
				setXml(xmlPantalla,"k_cond","Contado");
		
				if (tip_ope == 0) {
					setXml(xmlPantalla,"k_natdocto","D");
					setXml(xmlPantalla,"k_gpodocto",gpo_doc);
					setXml(xmlPantalla,"k_tipodocto",frn.get("k_tipon",-1,4));
					setXml(xmlPantalla,"k_foliodocto",frn.get("k_folio_ref"));
				}
		
				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\ven_traspaso_baja_XmlPantalla");

				// Code used 4 testing by JMM ...
				//frn.message("El XML se enviara a PostgreSQL ...","Info !!!","Aceptar");
				//return;
		
				cmd ="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";
				frn.lib("libGeneral.kpl","FileSave",cmd, fileSavePath & "\ven_traspaso_baja_cmd_Xml");
				
				//frn.message("Se armo XML que se enviara a PostgreSQL ...","Info !!!","Aceptar");
				//return;
				
				//kdb.rst(cubo);
				rstXml(cubo);
					
				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd ,"ven_traspaso_crud.Ejecuta");				
				frn.lib("libGeneral.kpl","FileSave",cubo, fileSavePath & "\ven_traspaso_baja_XmlResultado");
					
				resultado = getXml(cubo,"resultado");
				mensaje = getXml(cubo,"mensaje");
					
				ok = getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok) {
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;	
				}
						
				if(resultado &= "1")
				{
					tip_ope = 1;
					frn.set("k_folio",mensaje); 
					frn.set("operacion","CONSULTA");					
					strTmp = frn.get("k_docto");
					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;
					frn.set("k_docto",strTmp);
					ConfiguraCamposOpcion();					
					mensaje = "El Folio utilizado para esta operacion fue: " & mensaje;
					frn.message(mensaje, "Mensaje","&Aceptar");
				}else{
					frn.message(mensaje, "Error","&Aceptar");
				}
			}
			
	
			
			
			//-------------------------------------------EXTRAS----------------------------------------------------
			
			fun descr_combo(combo,posicion,valor){

				var descr, valor_actual;
				var len_combo = frn.N(combo);

				for (var cont=0; cont<len_combo ; cont++){
					valor_actual= frn.get(combo,cont,posicion);
					if (valor_actual &=  valor){
						descr = frn.get(combo,cont,0);
						return descr;
					}
				}
			}
			
			
				
			fun Valida_Tipo_Docto(){
				var resValidacion, resMensaje, cubo, cmd, ok, tip_doc;			
				//Valida documento vigente
				tip_doc=frn.get("k_tipon",-1,4);
				kdb.rst();
				
				cmd= "select * from keplersc.verify_valid_document('" & frn.get("k_sucn",-1,1) & "','" & gen_doc & "','" & nat_doc & "'," & gpo_doc & "," & frn.get("k_tipon",-1,4) & ")"; //suc text, genero text, naturaleza text, grupo integer, tipo_movto integer
				cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Valida_Tipo_Docto()");				
				resValidacion= getXml(cubo,"validacion","resultado");
				resMensaje = getXml(cubo,"validacion","mensaje");
				if(resMensaje &! ""){
					frn.message(resMensaje, "Mensaje","&Aceptar");
					frn.setPos("k_tipon");
				}					
			}
			
			
			
			fun Fecha(){//Verifica que la fecha del documento sea correcta. Ademas trae monedas y paridades de esa fecha. 
				var cubo, cmd, resValidacion, resMensaje, fecha;
				var validDate=frn.lib("libKepler","ValidOpDate",frn.get("k_fecha"));
				
				kdb.rst();
				frn.rst("results");
				fecha = fnDate("day", frn.get("k_fecha")) & "/" & fnDate("month", frn.get("k_fecha")) & "/" & fnDate("year", frn.get("k_fecha"));

				if (tip_ope == 0 ){
					cmd= "select * from keplersc.verify_year('" & fecha & "')";
					cubo = frn.lib("libGeneral.kpl","ValidarCondicion",cmd,"comopecompras.Fecha()");									;
					
					resValidacion= getXml(cubo,"validacion","resultado");
					resMensaje = getXml(cubo,"validacion","mensaje");
					if(resMensaje &! ""){
						frn.message(resMensaje, "Mensaje","&Aceptar");
					}
						
					if(resValidacion &= "0"){
						frn.setPos("k_fecha");
						return;
					}					
				}
			}
				
			

			
			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){
				/*iModo: 0)No hace mayor validacion. Siempre despliega la ventana. NO CONCATENA PREFIJO
							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validacion. Siempre despliega la ventana
							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)
							3)Modo especial para paginas de operacion:Solo si se esta en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje
				*/
				var prefix=frn.lib("libKepler","langPrefix");
				var page=prefix&pag;
				var b_valido=1;
				if(iModo==0)page=pag;
				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolvera el resultado.
					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;
				}
				else if(iModo==3&&(tip_ope>=1)&&(tip_ope<=3))b_valido=0;
				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);
			}	

		}			
	</script>
</pag>