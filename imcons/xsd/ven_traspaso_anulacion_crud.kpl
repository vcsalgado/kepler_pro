	<script>
		InstallDriver("KDB75");
		class Main {
			var gen_doc, nat_doc, gpo_doc, tip_doc, fija_doc,usuario,sucursal_id,suc_usuario,rol_usuario,asterisco, v_inventario,valorRetorno,v_IvaAuto,v_correo,v_uso_cfdi;
			var frn,kdb,rep,frP,sys;
			var tip_ope;//Tipo de operacion. "0" indica Alta; "1" indica consulta;
			var uen,v_KDM1_iva,v_KDM1_precio, v_KDM1_precio_vehiculo, fileSavePath;
			var anio_contable;

			fun Main() {
				frn=new FRNT;
				kdb=new KDB;
				rep=new REP;
				frP=new FRNTP;
				sys=new SYS;
				kdb.connect();
				kdb.open("c,kdm1,i,kdini,q,kdiq,m,kdmm,s,kdms,u,kdxd,v,kdxv,p,kdip,e,kdxe,f,kdxf,w,kdc2");
				ConfiguraControlesOff();
				usuario = frn.config("user","name");
				rol_usuario = frn.config("user","role");
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";
				fileSavePath = "C:\Basura";
				asterisco = "*";
				inicializa();
			}
		
		
			fun BuscarFolioRef() { // by JMM 20230106
				var folio;
				folio = frn.get("k_folio_ref");
				//frn.lib("libGeneral.kpl","PadLeft", folio, 7, "0");
				//folio = PadLeft(folio, 7, "0");
				//ArmarRefDocto(); 221120
				frn.set("k_folio_ref", folio); 
				//Mostrar_DOC(folio);
				ConsultarFolio(folio);	
			}
		
		   fun Get_Cat(imodo) { // by JMM 20230106
            
				var suc_id, dato_id;
				var win_tit, field_key, field_col, cmdQuery;
            
				if ( imodo <= 0 || imodo > 7 /*|| tip_ope &! "A"*/ ) {
					// No es opcion de CAT Valida ...
					return;
				}
				
				win_tit = "";
				field_key = "";
				field_col = "";
				cmdQuery = "";

				if (imodo == 4) {
					win_tit = "Traspasos de Autos";
					field_key = "folio";
					field_col = "k_folio_ref";
					cmdQuery = "select tdm1.c10 as cve_cliente, txd.c3 as nomb_cliente, tdm1.c6 as folio, to_char(tdm1.c9, 'dd/mm/yyyy') as fecha " &
						", tdm1.c11 as referencia from keplersc.kdm1 as tdm1 " & 
						"inner join keplersc.kdud as txd on txd.c2 = tdm1.c10 " & 
						"inner join keplersc.kdinf as inf on inf.c1 = tdm1.c1 and inf.c2 = tdm1.c100 " &
						"where tdm1.c2 = 'U' and tdm1.c3 = 'D' and tdm1.c4 = 21 and tdm1.c5 = " & frn.get("k_tipon",-1,4) & " and tdm1.c1 = '" & frn.get("k_sucn",-1,1) & "' " & 
						"and inf.c32 = 70 /*20*/ " &
						"order by tdm1.c9 desc, tdm1.c6 desc";
				}	
												
				//frn.lib("libGeneral.kpl","FileSave",cmdQuery, fileSavePath & "\ven_traspaso_baja_cmdQuery");
	
            if ( strlen(win_tit) > 0 && strlen(field_key) > 0 && strlen(field_col) > 0 && strlen(cmdQuery) > 0 /*&& strlen(objeto) > 0*/ ) {
                                        
					//frn.dialog("genlistasel", win_tit,cmdQuery, field_key, "k_mov",-1, field_col,"S");  * * *  USADO EN GRIDS
					//frn.dialog("genlistasel","Catalogo de Proveedores",cmdQuery,"k_claveprov","k_clave","0","","N");  * * *  USADO EN CTRLS SIMPLES
					
					frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");
				}
				
			} /*END Func Get_Cat()*/

		   
		   
			fun ConsultarFolio(nfolio)
			{
				var folio, nat_calc; // by JMM 20230106
				var xmlRequest,cmd,ok, cuboResultados, mensajeError;	
				
				if ( strlen(nfolio) != 0 ) { // by JMM 20230106
					folio = nfolio;
					nat_calc = "D";
					gpo_doc = "21";
					sucursal_id = frn.get("k_sucn",-1,1);
				} else {
					folio = frn.get("k_folio"); 
					nat_calc = nat_doc;
				}
							 
				cmd = "select * from keplersc.kdm1 where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc &"' and c3 = '" & nat_calc /*nat_doc*/ &  "' and c4 = '" & gpo_doc &  "' and c5 = '" & frn.get("k_tipon",-1,4) &  "' and c6 = '" & folio /*frn.get("k_folio")*/ & "'";
				
				//frn.lib("libGeneral.kpl","FileSave",cmd, fileSavePath & "\ven_traspaso_baja_cmd");
				
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.ConsultarFolio()");
				ok = getXmlAtt(cuboResultados ,"ok");
				if(ok &! "" && !ok)
				{
				   mensajeError = getXmlAtt(cuboResultados ,"native3");
					frn.message(mensajeError,"Criterios no encontrados","Aceptar");
					return;
				}
				
				frn.set("k_inventario",getXmlAtt(cuboResultados,"r0","c100"));
				frn.set("k_clave",getXmlAtt(cuboResultados,"r0","c10"));
				
				// by JMM 20230106
				if ( strlen(nfolio) == 0 ) {
					frn.set("k_fecha",getXmlAtt(cuboResultados,"r0","c9"));
					frn.set("k_folio_ref",getXmlAtt(cuboResultados,"r0","c39"));
				}
		
				MostrarCliente();

				v_KDM1_iva = getXmlAtt(cuboResultados,"r0","c14");
				v_KDM1_precio = getXmlAtt(cuboResultados,"r0","c16");
				v_KDM1_precio_vehiculo = v_KDM1_precio - v_KDM1_iva ;	
			
				frn.set("k_monto",v_KDM1_precio);
				frn.set("k_importeprevio",v_KDM1_precio_vehiculo);
				frn.set("k_preciovehiculo",v_KDM1_precio_vehiculo);
				frn.set("k_iva",v_KDM1_iva);
				frn.set("k_f_pago",descr_combo("k_f_pago",1, getXmlAtt(cuboResultados,"r0","c160") ) );	

				frn.set("k_m_pago",getXmlAtt(cuboResultados,"r0","c162"));
				frn.set("k_cfdi",getXmlAtt(cuboResultados,"r0","c164"));
				frn.set("k_correo",getXmlAtt(cuboResultados,"r0","c165"));
				//MSS 30092024 Extraer no. de cuenta y mostrarlo en k_cuenta, por validacion en postgres cfd_valid_cuenta, no active el coalesce
				frn.set("k_cuenta",getXmlAtt(cuboResultados,"r0","c161"));
			
				//seccion de KDINF				
				cmd = "select c3,c4,c5 from keplersc.kdinf where c1 = '" & sucursal_id &  "' and c2 = '" & frn.get("k_inventario") &  "' ";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.ConsultarFolio()");
				ok = getXmlAtt(cuboResultados ,"ok");
				if(ok &! "" && !ok)
				{
				   mensajeError = getXmlAtt(cuboResultados ,"native3");
					frn.message(mensajeError,"Criterios no encontrados","Aceptar");
					return;
				}
				frn.set("k_producto",getXmlAtt(cuboResultados,"r0","c3"));
				frn.set("k_desc_inv",getXmlAtt(cuboResultados,"r0","c4"));
				frn.set("k_serie",getXmlAtt(cuboResultados,"r0","c5"));
			}
		
			
			fun ObtenerFolio()
			{
				   var cmdQuery ="",v_tipo_n;
					v_tipo_n = frn.get("k_tipon",-1,4);
					sucursal_id = frn.get("k_sucn",-1,1);
					cmdQuery = "select c1 as tip, c6 as folio, to_char(c9, 'dd/mm/yyyy') as fecha,c11 as referencia, c16 as monto from keplersc.kdm1  where c1 = '" & sucursal_id &  "' and c2 = '" & gen_doc&  "' and c3 = '" & nat_doc&  "' and c4 = '" & gpo_doc&  "' and c5 = '" & v_tipo_n &  "' ";
					cmdQuery = cmdQuery & " order by c9 desc ";
					frn.dialog("genlistasel","Documentos de Traspasos",cmdQuery,"folio","k_folio","0","","N");
			}
			
			
			
			fun Formar_folio(){
				var xmlReqEst, cubofol, cmd, ok, mensajeError ;
				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));
				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));
				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));
				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));
				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));
				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));
				setXml(xmlReqEst,"document","uen",uen);
				
				cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";
				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");
				var resultado =getXmlAtt(cubofol,"r0", "resultado");
				if(resultado &= "0"){
					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				var fol = getXmlAtt(cubofol,"r0", "mensaje");
				frn.set("k_folio", fol);
		}
		

			
			
			fun Consulta(){//Imprime el reporte del documento especificado 
				if(strlen(trim(frn.get("k_folio")))==0){ 
					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");
					frn.setPos("k_folio");return;	
				}
				//reporte();
				frn.setPos("k_folio");
			}
			
			

			fun MostrarCliente()
			{
				var xmlRequest,
					 cmd,
					 ok, 
					 cuboResultados,
					 mensajeError, 
					 v_cliente;
					 v_correo = "";
					 v_uso_cfdi="";
					 v_cliente= frn.get("k_clave" , -1, 1);
					 cmd = "select c30,c4,c5,c6,c10,c11,c16,c52,c53,c27 from keplersc.kdud where c2 = '" & v_cliente & "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.MostrarCliente()");
				ok = getXmlAtt(cuboResultados ,"ok");
				if(ok &! "" && !ok)
				{
				   mensajeError = getXmlAtt(cuboResultados ,"native3");
					frn.message(mensajeError,"Criterios no encontrados","Aceptar");
					return;
				}
				frn.set("k_nombreimprfact",getXmlAtt(cuboResultados,"r0","c30"));
				frn.set("k_nombrecli",getXmlAtt(cuboResultados,"r0","c3"));
				frn.set("k_callecli",getXmlAtt(cuboResultados,"r0","c4"));
				frn.set("k_coloniacli",getXmlAtt(cuboResultados,"r0","c5"));
				frn.set("k_poblacioncli",getXmlAtt(cuboResultados,"r0","c6"));
				frn.set("k_rfccli",getXmlAtt(cuboResultados,"r0","c10"));
				frn.set("k_cpcli",getXmlAtt(cuboResultados,"r0","c27"));
				v_correo = getXmlAtt(cuboResultados,"r0","c11");
				v_uso_cfdi = getXmlAtt(cuboResultados,"r0","c53");
				frn.set("k_m_pago",getXmlAtt(cuboResultados,"r0","c52"));
				frn.set("k_cfdi",v_uso_cfdi );
				frn.set("k_correo",v_correo );

			}
			//INVENT					
			fun MostrarInventario() 
			{
				var xmlRequest,cmd,ok, cuboResultados, mensajeError,totOrd,contOrd;
					 
				sucursal_id = frn.get("k_sucn",-1,1);
				v_inventario = frn.get("k_inventario");	
								 
				cmd = "select c2,c3,c4,c5,c20 from keplersc.kdinf where c1 ='" & sucursal_id &  "' and c2 ='" & v_inventario & "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.MostrarInventario()");
				ok = getXmlAtt(cuboResultados ,"ok");
				if(ok &! "" && !ok)
				{
				   mensajeError = getXmlAtt(cuboResultados ,"native3");
					frn.message(mensajeError,"Criterios no encontrados","Aceptar");
					return;
				}
			
				frn.set("k_serie",getXmlAtt(cuboResultados,"r0","c5"));
				frn.set("k_producto",getXmlAtt(cuboResultados,"r0","c3"));
				frn.set("k_desc_inv",getXmlAtt(cuboResultados,"r0","c4"));
			
				
				frn.set("k_monto",0);
				frn.set("k_iva",0);
				frn.set("subt",0);
				
				
				cmd = "select c31,c33 from keplersc.kdicom where c1 = '" & sucursal_id &  "' and c2 = '" & v_inventario & "'";
				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.MostrarInventario()");
				
				var totres = nXml(cuboResultados);
				if (totres > 0){
					var subtotal_compra= getXmlAtt(cuboResultados,"r0","c31");
					var hold_back = getXmlAtt(cuboResultados,"r0","c33");
					var importe = (subtotal_compra + hold_back)*(1+16/100);
					frn.set("k_monto" , importe );
				
				}else{
				
					cmd = "select c8,c9 from keplersc.kdlinv where c1 = '" & sucursal_id &  "' and c2 = '" & v_inventario & "'";
					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.MostrarInventario()");
					ok = getXmlAtt(cuboResultados ,"ok");
					if(ok &! "" && !ok)
					{
					  mensajeError = getXmlAtt(cuboResultados ,"native3");
					  frn.message(mensajeError,"Criterios no encontrados","Aceptar");
					  return;
					}
				
					totres = nXml(cuboResultados);
					if (totres > 0){
					
						var ultimo_costo = getXmlAtt(cuboResultados,"r0","c8");
						var ultimo_iva = getXmlAtt(cuboResultados,"r0","c9");
						frn.set("k_monto" , ultimo_costo + ultimo_iva );
					
					}
				
				}
				
				monto();

			}
			
			fun monto(){
			
				var precio_vehiculo = frn.get("k_monto")/(1+16/100);
				frn.set("k_iva",frn.get("k_monto") - precio_vehiculo );
				frn.set("k_importeprevio" ,precio_vehiculo  );
				frn.set("k_preciovehiculo" ,precio_vehiculo  );
			
			}
		
			fun BusquedaInventario()
			{
				var cmdQuery ="";
					sucursal_id = frn.get("k_sucn",-1,1);
					cmdQuery = "select c2 as inventario, c3 as Clave,c4 as Descripcion, c5 as Serie from keplersc.kdinf where c1 = '" & sucursal_id &  "' and c31 =20 and c32 = 0 ";
						cmdQuery = cmdQuery & " order by c2 asc ";
						frn.dialog("genlistasel","Inventarios",cmdQuery,"inventario","k_inventario","0","","N");            
			}
	
			
			fun inicializa(){//Da valor a los combos y prepara la pagina dependiendo del tipo de Operacipn a realizar
				var resValidacion, 
						resMensaje, 
						cubo, 
						cmd, 
						ok,
						mensajeError,
						sucursal_id,
						v_cliente,
						v_tipoOperacion;
				kdb.kde("KDE");//								Configuracipn del servidor
				kdb.exec();
				anio_contable = kdb.get("KDE","14");
				frn.set("k_fecha",sys.date());								
				if(frn.nParam()>0 ){//Se han mandado parametros a la pagina
					gen_doc=trim(frn.param(0)); 
					nat_doc=trim(frn.param(1)); 
					gpo_doc=trim(frn.param(2));
					tip_doc=trim(frn.param(3)); 
					//fija_doc=trim(frn.param(4));
					tip_ope=trim(frn.param(4/*5*/));
					uen=trim(frn.param(5/*6*/));
				}
				else
				{
					frn.message("Esta accion no esta permitida.","Estimado Usuario","&Aceptar");
					frn.open("redirect",2);
					return;
				}
				ConfiguraCamposOpcion();
				if(tip_ope==0)
				{
					v_tipoOperacion = "Anulacion";
				}
				
				if(tip_ope==1)
				{
					v_tipoOperacion = "Consulta Anulacion";
				}
				frn.set("k_titulo_inicial",v_tipoOperacion);
							
				//Llenar combo sucursales
				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";
				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){
					cmd = cmd & " where c1='" & suc_usuario & "'";
				}else {
					if (suc_usuario &! asterisco && suc_usuario &! "" ){
						cmd = cmd & " where c1='" & suc_usuario & "'";
					}
				}
				
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");		
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
					
				frn.set("k_sucn",getXml(cubo));
			
				//Llena combo tipo
				LlenaCmbTipo();				
				
				// Fill Combo forma de pago(Con Query de PostgreSQL)
				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3fp";
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd ,"ven_traspaso_crud.Inicializa()");
				ok=getXmlAtt(cubo ,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo ,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				frn.set("k_f_pago",cubo );	
				
				
			
				Fecha();//Indica fecha correcta, y trae monedas y paridades de esa fecha. 
				if (strlen(tip_doc)>0) frn.setPos("k_tipon",-1,4,"internal:Y","val:" & tip_doc);//Posiciona el combo de Tipo de documento al especificado como parametro
				
				//
				if(tip_ope==0){//Alta
					frn.set("operacion","ANULACION");
				}
				else if(tip_ope==1){//Consulta
					frn.set("operacion","CONSULTA");
				}
			
				BorraDatos();
				
			}
			
			fun LlenaCmbTipo(){
				var cubo,cmd,ok,mensajeError;
				sucursal_id=frn.get("k_sucn",-1,1);		
												
				cmd = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and col_sucursal='" & sucursal_id & "'";
				
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspaso_crud.Inicializa()");
				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTipoDocto");		
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}

				frn.set("k_tipon",getXml(cubo));
			}
			
			fun CambiaSucursal(){
				sucursal_id = frn.get("k_sucn",-1,1);
				LlenaCmbTipo();
				Valida_Tipo_Docto();
			
			}

