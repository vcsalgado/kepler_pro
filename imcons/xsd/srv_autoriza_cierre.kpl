<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles=""><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="42,27,10,10" brdr="0,5" tit="Autoriza Cierre" fnt="Arial,16">				<br/>		<tab n="1"/><txt  fnt="Arial,16,b">ORDEN:</txt>	<sp/>				<inp id="tipo_orden" clr="64,64,64"  dim="2,1" fnt="Arial,20" clrBrdr="255,255,255"   bclr="255,255,255" brdr="2,0" modify="N"   visible="Y"/><sp/>			<inp id="folio_orden" clr="64,64,64"  dim="12,1" fnt="Arial,20" clrBrdr="255,255,255"   bclr="255,255,255" brdr="2,0"  modify="N" visible="Y"/><sp/>				<br/><br/>				<tab n="1"/><txt>Fecha de Autorizacion: </txt> 		<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" modify="N" clr="64,64,64" page="_ks_fecha,k_fecha"  clrBrdr="255,255,255"  tooltip="Fecha"/> 		 		<br/>		<tab n="1"/><txt>Hora de Autorizacion: </txt> 		<sp n="1"/> 		<edt id="k_hora" dim="8,1" type="time" nc="-1" bclr="240,240,240" modify="N" fmt="HH:MM:SS"/> 				<br/>		<tab n="1"/><txt>Usuario Autorizando: </txt> 		<sp n="1"/> 		<inp id="k_usuario_autorizando" clr="64,64,64"  dim="15,1" fnt="Arial,16" clrBrdr="255,255,255"   bclr="255,255,255" brdr="2,0"  modify="N" visible="Y"/>				<br/>	<br/>				<tab n="1"/><txt>Comentarios: </txt> 		<sp n="1"/> 		<inp id="k_comment" clr="64,64,64"  dim="25,2" fnt="Arial,20" clrBrdr="255,255,255"   bclr="255,255,255" brdr="2,0" visible="Y"/>								<br/>	<br/>			<tab n="4"/><bot id="bot_autorizar" dim="15,0" brdr="5" text="Autorizar" default="0" OnEnter="autorizar()"/>		</grp>					<br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,usuario,perfil_usuario,rol_usuario  ,flujo_admon,flujo_servicio  ,asterisco, externo, sucursal,folio_orden, tipo_orden, vin ;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("s,KDMS");								suc_usuario = frn.lib("libKepler","UserInfo(1)");				usuario = frn.config("user","name");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								sucursal =trim(frn.param(0));				tipo_orden=trim(frn.param(1));				folio_orden=trim(frn.param(2));				vin=trim(frn.param(3));													Inicializa();			}						fun Inicializa(){							frn.set("tipo_orden", tipo_orden );				frn.set("folio_orden", folio_orden );								var cmd, cubo, ok, mensajeError ;								/*cmd = " select c1 from keplersc.kdrecep where c1='" & usuario & "'";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvabrirorden.Inicializa()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\perfil_usuario");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}							if (nXml(cubo) &= "0"){					frn.message("No tienes permisos para acceder a esta opcion","Error","Aceptar");					frn.timer(0,1,"salir()");				}*/												frn.set("k_fecha", sys.date());				frn.set("k_hora", sys.time());				frn.set("k_usuario_autorizando", usuario );						}						fun autorizar(){							var cmd, cubo, ok, mensajeError,xmlRequest ;												xmlRequest = getXml(frn.dataPag()); //Obtener el xml de la pantalla;									setXml(xmlRequest ,"sucursal_id",sucursal);								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.ser_autoriza_cierre_orden(' <document> " & getXmlStr(xmlRequest,"EOF:13_10") & " </document> ')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_autoriza_cierre.autorizar()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var resultado = getXmlAtt(cubo,"r0","resultado");							if(resultado &= "0"){					mensajeError = getXmlAtt(cubo,"r0","mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}								if(resultado &= "1"){					var mensaje = getXmlAtt(cubo,"r0","mensaje");					frn.message(mensaje ,"Atencion","Aceptar");				}								}									fun salir (){							frn.exit();			}										}	</script></pag>