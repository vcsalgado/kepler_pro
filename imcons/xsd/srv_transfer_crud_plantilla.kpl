<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Transfer">	<grp dim="1,-1,10,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<sp n="1"/>	<txt fnt=",22" clr="0,0,0">Transferencia Electronica</txt><br/>	<sp n="1"/>	<hLine clr="0,0,0"/>	<br/> <br/>	<sp n="1"/>		<grp dim="51,11,7,13" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">			<sp n="1"/> <txt>Sucursal :  </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="60,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" tooltip="Sucursal" available="Y" modify="Y"/>			<br/>			<sp n="1"/> <txt>Tipo :        </txt>			<cmb id="k_tipon" dim="60,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo()" tooltip="Tipo de Movimiento" available="N"/>			<br/>			<sp n="11"/>			<inp id="statusdoc" clr="64,64,64"  dim="60,1" brdr="0,1" fnt=",16b" available="N"/> 			<br/> <br/> 			<sp n="1"/> <txt>Tipo Transferencia : </txt> <sp n="1"/>			<cmb id="cmb_tipo" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="Y"/>			<br/>			</grp>				<sp n="1"/>				<grp dim="52,11,7,13" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="1"/>			<inp id="operacion" dim="45,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C"/><tab/> <br/>			<sp n="1"/> <txt id="textFolio" visible="N">Folio :  </txt>			<edt id="k_folio" dim="38,1" brdr="2,0" bclr="255,255,255"  OnChange="Formar_folio()" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="10" tooltip="Folio ( F9 b&#250;squeda )" modify="Y" available="N" visible="N" OnF9="ObtenerFolio()" 			OnButton="ObtenerFolio()"/>			<sp n="2"/>			<img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="BuscarFolio()" available="Y" clrBrdr="0,0,0" visible="N"/>			 <br/>			<sp n="1"/>			<inp id="k_docto" dim="45,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="C"/> <br/>						<sp n="1"/> <txt>Documento </txt>			<sp n="1"/> <txt>Fecha : </txt> 			<edt id="k_fecha" dim="13,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N" tooltip="Fecha"/> 			<sp n="2"/> 			<txt>Hora :</txt> 			<sp n="1"/> 			<edt id="k_hora" dim="11,1" type="time" nc="-1" bclr="240,240,240"  fmt="HH:MM:SS" available="N"/> 			<br/>			<sp n="1"/> <txt clr="17,17,17">Validacion </txt>			<sp n="1"/>			<txt clr="17,17,17">Fecha : </txt> 			<edt id="c_fecha" dim="13,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,c_fecha" OnF9="Dialog(3,_ks_fecha,c_fecha)" clrBrdr="255,255,255" available="N" tooltip="Fecha Validacion"/> 			<sp n="2"/> 			<txt clr="17,17,17">Hora :</txt> 			<sp n="1"/> 			<edt id="c_hora" dim="11,1" type="time" nc="-1" bclr="240,240,240" clr="64,64,64" fmt="HH:MM:SS" available="N"/> 			<sp n="2"/>			<inp id="c_usr" dim="20,1" clr="64,64,64" bclr="240,240,240" clrBrdr="255,255,255" type="string" visible= "Y" available="N" modify="N" fnt=",16" just="L"/>			<br/>			</grp>		<br/>	<br/>	<sp n="1"/>		<grp dim="104,38,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" fnt=",0" tit="Seleccion de Documentos  -   Ctrl + Del [Eliminar Registro]">			<sp n="1"/>			<tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,14" 				dim="146,15"  hk="z" Reorder="N" modify="Y" insdel="Y" OnCtrDel="RemoverFactura()">								<col id="k_clave" name="Proveedor"  type="capital"  OnF9="Get_Cat(1)" OnChange="BuscarProveedor()" visible="Y" modify="Y" available="Y" np="30"/>					<col id="k_nombreprov" name="Nombre"  type="capital" visible="Y" modify="N" available="Y" nc="30" np="90"/>					<col id="c_cuenta" name="Cuenta Deposito"  type="number" fmt="5" nc="18" OnF9="" visible="Y" modify="Y" available="Y" np="40" nd="0"/>				<col id="c_serie" name="Serie"  type="string" OnF9="" visible="Y" modify="N" available="N" np="35"/>				<col id="c_folio" name="Folio"  type="string" OnF9="" visible="Y" modify="N" available="N" np="35"/>				<col id="c_saldo" name="Saldo"  type="number" OnF9="" visible="Y" modify="N" available="N" nc="15" nd="2" np="50"/>				<col id="c_vence" name="Vence"  type="string" nc="12" OnF9="" visible="Y" modify="N" available="N" np="50"/>				<col id="k_factura" name="Factura"  type="capital" OnF9="ObtenerCxP()" OnChange="ObtenerFactura()" visible="Y" modify="N" available="Y" np="120"/>				<col id="k_concepto_factura" name="Concepto"  type="capital" visible="Y" modify="N" available="Y" np="30"/>							<col id="k_monto_factura" name="Monto"  type="number" OnChange="monto()" nd="2" nc="15" modify="Y" np="50"/>				<col id="k_iva_factura" name="IVA Tras."  type="number" nd="2"  nc="15" OnChange=""  modify="N" visible="Y" np="50"/>				<col id="k_iva_ret" name="IVA Ret."  type="number" nd="2"  nc="15" OnChange=""  modify="N" visible="Y" np="50"/>				<col id="k_isr_ret" name="ISR Ret."  type="number" nd="2"  nc="15" OnChange=""  modify="N" visible="Y" np="50"/>							<col id="k_ieps_tras" name="IEPS Tras."  type="number" nd="2"  nc="15" OnChange=""  modify="N" visible="Y" np="50"/>				<col id="k_imptoadica" name="Impto. Local Tras."  type="number" nd="2"  nc="15" OnChange=""  modify="N" visible="Y" np="50"/>				<col id="k_imptoadicb" name="Impto. Local Ret."  type="number" nd="2"  nc="15" OnChange=""  modify="N" visible="Y" np="50"/>				<col id="k_factura_rfc" name="rfc"  modify="N" visible="N" available="N"/>						<col id="k_prov" name="Prov Oper"  type="string" OnF9="" visible="Y" modify="N" available="N" np="30"/>								<col id="k_monto_factura_anterior" name="Monto Ant"  type="number" OnChange="monto()" nd="2" nc="15" modify="Y" np="50"/>				<col id="k_iva_factura_anterior" name="IVA Tras. Ant"  type="number" nd="2"  nc="15" OnChange=""  modify="N" visible="Y" np="50"/>				<col id="k_iva_ret_anterior" name="IVA Ret. Ant"  type="number" nd="2"  nc="15" OnChange=""  modify="N" visible="Y" np="50"/>				<col id="k_isr_ret_anterior" name="ISR Ret. Ant"  type="number" nd="2"  nc="15" OnChange=""  modify="N" visible="Y" np="50"/>							<col id="k_ieps_tras_anterior" name="IEPS Tras. Ant."  type="number" nd="2"  nc="15" OnChange=""  modify="N" visible="Y" np="50"/>				<col id="k_imptoadica_anterior" name="Impto. Local Tras. Ant."  type="number" nd="2"  nc="15" OnChange=""  modify="N" visible="Y" np="50"/>				<col id="k_imptoadicb_anterior" name="Impto. Local Ret. Ant."  type="number" nd="2"  nc="15" OnChange=""  modify="N" visible="Y" np="50"/>										</tbl>			<br/>			<sp n="1"/><bot id="selMultiXML" dim="10,0" brdr="5" OnEnter="SelMultiXML()" tooltip="Seleccionar carpeta con facturas" available="Y" visible="Y" text="Sel. XMLs" fnt=",14"/><tab n="1"/>			<sp n="1"/><txt fnt=",14">Monto</txt>			<inp id="k_monto_total" dim="10,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",14" clr="64,64,64"/><tab/>			<txt fnt=",14">IVA Tras.</txt>			<inp id="k_iva_tras_total" dim="10,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",14" clr="64,64,64"/><tab/>			<txt fnt=",14">IVA Ret.</txt>			<inp id="k_iva_ret_total" dim="10,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",14" clr="64,64,64"/><tab/>					<txt fnt=",14">ISR Ret.</txt>			<inp id="k_isr_ret_total" dim="10,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",14" clr="64,64,64"/><tab/>					<txt fnt=",14">IEPS Tras.</txt>			<inp id="k_ieps_tras_total" dim="10,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",14" clr="64,64,64"/><tab/>				<txt fnt=",14">Impto.Adic Tras.</txt>			<inp id="k_imptoadica_total" dim="10,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",14" clr="64,64,64"/><tab/>				<txt fnt=",14">Impto.Adic.Ret.</txt>			<inp id="k_imptoadicb_total" dim="10,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",14" clr="64,64,64"/>			<br/><txt> Referencia : </txt>			<inp id="k_refer" dim="50,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="capital" just="L" nc="40" fnt=",0" clr="64,64,64" available="y"/><tab/><txt>Notas :</txt> <sp/>			<inp id="k_coment" dim="70,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="300" fnt=",0" clr="64,64,64" modify="Y" available="Y"/>			<br/><sp/>			<grp dim="108,20,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,16" hSpace="4" fnt=",0">				<tbl id="k_mov_ctas" dim="108,8" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" 				  hk="z" Reorder="Y" modify="N" OnChange="CalcTotal()"  insdel="N" available="Y">					<col id="k_cuenta" name="Cuenta"  type="capital" OnF9="select_cuenta()"  OnChange="Cuenta()" visible="Y" modify="N" np="90" available="Y"/>					<col id="k_cuentadesc" name="Nombre Cuenta" type="string" nc="35" modify="N" visible="Y" available="N" np="150"/>						<col id="k_cargo" name="Cargo" type="number" nd="2" OnChange="Cargo()" nc="15" available="Y" modify="N" visible="Y" np="80"/>					<col id="k_abono" name="Abono"  type="number" nd="2" OnChange="Abono()" nc="15" available="Y" modify="Y" visible="Y" np="80"/>					<col id="k_cuenta_grupo" name="Cta.Grupo" type="capital" nc="1" modify="N" available="N" visible="Y"/>					<col id="k_cuenta_divisible" name="Divisible" type="capital" nc="1" modify="N" available="N" visible="Y"/>					<col id="k_campo_cuenta_plantilla" name="Cta.Plantilla" type="capital" nc="3" modify="N" available="N" visible="Y"/>					<col id="k_id_concepto" name="Id Con." type="string" nc="10" modify="N" available="N" visible="Y"/>										<col id="k_cuenta_origen" name="Cta. Or."  type="capital" OnF9="select_cuenta()"  OnChange="Cuenta()" visible="Y" modify="N" np="90" available="N"/>					<col id="k_cuentadesc_origen" name="Nombre Or." type="string" nc="35" modify="N" visible="N" available="N" np="150"/>						<col id="k_cargo_origen" name="Cargo Or." type="number" nd="2" OnChange="Cargo()" nc="15" available="N" modify="N" visible="N" np="80"/>					<col id="k_abono_origen" name="Abono Or."  type="number" nd="2" OnChange="Abono()" nc="15" available="N" modify="N" visible="N" np="80"/>					<col id="k_cuenta_grupo_origen" name="Cta.Gpo.Or." type="capital" nc="1" modify="Y" available="N" visible="N"/>					<col id="k_cuenta_divisible_origen" name="Divisible" type="capital" nc="1" modify="N" available="N" visible="Y"/>					<col id="k_campo_cuenta_plantilla_origen" name="Cta.Plantilla" type="capital" nc="3" modify="N" available="N" visible="Y"/>					<col id="k_id_concepto_origen" name="Id Con." type="string" nc="10" modify="N" available="N" visible="N"/>						<col id="k_cuenta_base" name="Cuenta bae" type="capital" modify="N" available="N" visible="Y"/>					<col id="k_referencia_uuid" name="uuid" type="capital"/>				</tbl>				<br/><tab/><txt>Cargos : </txt>				<inp id="k_total_cargos" dim="12,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" just="R" nd="2" modify="N" available="N"/><tab n="2"/><txt>Abonos : </txt>				<inp id="k_total_abonos" dim="12,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" just="R" nd="2" modify="N" available="N"/><tab n="19"/>				<img id="Recalcular" dim="20,20" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="RecalcularPoliza()" tooltip="Recalcular poliza" available="Y" clrBrdr="0,0,0" visible="Y"/>						</grp>			<tab n="1"/>			<grp dim="45,20,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,16" hSpace="4" fnt=",0" clr="64,64,64">				<sp n="2"/><txt fnt=",">Subtotal : </txt>	<sp n="10"/>				<inp id="k_subtotal" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" clr="64,64,64"/><tab n="2"/>				<br/>							<sp n="2"/><txt>Impuestos Tras. : </txt> <sp n="4"/>				<inp id="k_imptos_tras_total" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0" clr="64,64,64"/>							<inp id="k_iva" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="L" nd="2" fnt=",0" clr="64,64,64" available="N" visible="N"/>				<br/><txt clr="108,34,38" fnt=",16">   Impuestos Ret. (-)</txt><tab n="2"/>				<inp id="k_imptos_ret_total" dim="15,1" brdr="2,0" bclr="255,255,255" clr="108,34,38" clrBrdr="255,255,255" type="number" modify="N" just="R"/>				<br/><txt>   Monto Transferencia : </txt>				<inp id="k_monto" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0b" clr="64,64,64"/>				<br/>				<sp/><tab n="3"/>				<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Ejecuta_Reporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/><sp n="4"/>				<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>				<sp n="4"/>				<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			</grp>		</grp>			</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Variables de control			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal, tabla, estatus_doc ;			var fileSavePath;			//Variables validacion factura			var	str_uuid, fecha_uuid, rfc_uuid, total_uuid;								//Variables de parametros         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd;			var editable; //Se controla si la poliza se puede editar, cancelar o dar de baja				//Porcentajes kdmm			var prc_iva ;			//cont			var presupuesto , saldo, fecha_baja, cargos_factura, abonos_factura, cargos_iva_factura, abonos_iva_factura;			//VCSS 11/09/2025 Impuestos adicionales			var abonos_ivaret, cargos_ivaret, abonos_isrret, cargos_isrret,abonos_iepstras, cargos_iepstras, abonos_otroimptoa;			var cargos_otroimptoa, abonos_otroimptob, cargos_otroimptob, concepto_factura;						var abonos_ivatras_old, cargos_ivatras_old, abonos_ivaret_old, cargos_ivaret_old, abonos_isrret_old, cargos_isrret_old, abonos_iepstras_old, cargos_iepstras_old, abonos_otroimptoa_old;			var cargos_otroimptoa_old, abonos_otroimptob_old, cargos_otroimptob_old, monto_old, subtotal_old;						var uen;			//Added by JMM 20240322			var CtaBnc, CtaInt;			//Added by JMM 20241031			var asterisco;				fun Main() {			frn=new FRNT;			kdb=new KDB;			rep=new REP;			frP=new FRNTP;			sys=new SYS;			kdb.connect();			kdb.kde("KDE");			kdb.exec();			anio_contable = mid(fnDate("year",sys.date()),2,2);			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			suc_usuario = frn.lib("libKepler","UserInfo(1)");			asterisco = "*"; //Added by JMM 20241031			fileSavePath = "C:\Basura";						//Added by JMM 20240322			CtaBnc = "Bancaria (10 digitos)";			CtaInt = "Interbancaria (18 digitos)";						Inicializa();			ConfiguraControlesOpcion();						}					fun Inicializa(){ //Inicializa los valores en Pantalla			// Revisa parametros recibidos			if( frn.nParam() == 7 ){ //Se han mandado parï¿½metros a la pï¿½gina                gen_doc=trim(frn.param(0));                 nat_doc=trim(frn.param(1));                 gpo_doc=trim(frn.param(2));                tip_doc=trim(frn.param(3));                 tip_ope=trim(frn.param(4));                paramProd=trim(frn.param(5));			} else {				frn.message("Operacion no valida ...", "Mensaje","&Aceptar");				frn.open("redirect",2);				return;			}            			if(tip_ope &= "A"){ //Alta				frn.set("operacion","ALTA");			} else {				if(tip_ope &= "B"){ //Baja					frn.set("operacion","BAJA");					frn.message("Operacion no dispoble en Nvo Esquema de Gastos ...", "Mensaje","&Aceptar");					/*frn.open("index",4);*/					frn.open("redirect",2);					return;					} else {					if(tip_ope &= "C"){ //Consulta						frn.set("operacion","CONSULTA");					} else {						frn.message("Operacion no valida ...", "Mensaje","&Aceptar");						frn.open("index",4);						return;								}				}			}									uen=trim(frn.param(6));			if (uen &= ""){				uen="XXX";			}							// Fill Combo Sucursal (Con Query de PostgreSQL)			cmdQuery = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdms";						//Added by JMM 20241031 			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}			}						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_sucn",cuboQuery);							//Added by JMM 20240924 ... To Homologated with VICSA			sucursal_id = frn.get("k_sucn",-1,1);							// Fill Combo Tipo (Con Query FTO Kepler) 			cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;			cmdQuery = cmdQuery & " and c4='" & tip_doc & "'"; //Condition used by JMM 20240312 as temporary until define DOCs or DOC Type 			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.Inicializa()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error BD","Aceptar");				return;			}			frn.set("k_tipon",getXml(cuboQuery));						// Added by JMM 20240322			frn.setX(" ","cmb_tipo",0,0);			frn.setX("","cmb_tipo",0,1);			frn.setX(CtaBnc/*"Bancaria (10 digitos) "*/,"cmb_tipo",1,0);			frn.setX("B","cmb_tipo",1,1);			frn.setX(CtaInt/*"Interbancaria (18 digitos) "*/,"cmb_tipo",2,0);			frn.setX("I","cmb_tipo",2,1);								frn.setPos("cmb_tipo","ren:0"); // Added by JMM 20240322									frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				frn.set("k_vence",sys.date());							// Fill k_docto | referencia docto			ArmarRefDocto();					porcentajes_kdmm();		}					// Armado del Docto Referencia		fun ArmarRefDocto {			var cadena = frn.get("k_tipon", -1, 5);			var fol = frn.get("k_folio");			if (tip_ope &! "A" && fol &! ""){				cadena = strSplit(cadena,"-",0) & "-" & fol;			}					frn.set("k_docto", cadena);		}					fun PadLeft(pText,pRelleno,pCaracterRelleno) {			var Resultado;			var pos_ini = pText;			var nReg = strlen(pText);			for (var cont = nReg; cont < pRelleno; cont++) {				Resultado = pCaracterRelleno & Resultado;			}			Resultado = Resultado & pText;                			return Resultado;		}				fun CambiaTipo() {				tip_doc  = frn.get("k_tipon", -1, 4);			porcentajes_kdmm();			borrar_datos();			LimpiaEncabezado();								//TODO, borrar todos los datos			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();						}		fun select_cuenta(){			var modificable,grupo;			var tbla = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2);			modificable = frn.get("k_mov_ctas",-1,"k_cuenta_grupo");			grupo = frn.get("k_mov_ctas",-1,"k_cuenta");			grupo=mid(grupo,0,3);			if (modificable &= "S"){				var cmdSel = "select c1 as clave_cuenta, c2 as desc_cuenta from " & tbla & " where substring(c1,1,3)='" & grupo & "'";				frn.dialog("genlistafiltrosel","Cuentas",cmdSel ,"clave_cuenta","k_mov_ctas","", "k_cuenta","N");			};		}		fun RemoverFactura(){			//Regenerar la lista de cuentas//			CargarCuentasConcepto();			CalcTotal();		}		fun RecalcularPoliza(){			CargarCuentasConcepto();			CalcTotal();				}		fun Cuenta() {            var cuenta = frn.get("k_mov_ctas", -1, "k_cuenta");             var xmlRequest, cmd, cubo , ok, mensajeError ;            setXml(xmlRequest,"document","cuenta",cuenta);            setXml(xmlRequest,"document","anio",mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2));                        frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\requestCuenta");				cmd="select * from keplersc.caracteristicas_cuenta('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultadosCuenta");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					//clear_row(); //Added by JMM 20240325					return;				}								var nivel_cuenta = getXmlAtt(cubo,"r0","nivel");				var descripcion_nivel = getXmlAtt(cubo,"r0","desc_nivel");				var tipo_cuenta = getXmlAtt(cubo,"r0","tipo");								if (descripcion_nivel &! "Menor"){					frn.message(/*"La Cuenta debe ser menor"*/"No es una Cuenta de Detalle","Error","Aceptar"); // UPD 20240229 by JMM					frn.setX("", "k_mov_ctas", -1, "k_cuenta");					frn.setX("", "k_mov_ctas", -1, "k_cuentadesc");					restore_row(); //Added by JMM 20240325					return ;            }           				if (tipo_cuenta &= "Cliente"){					frn.message("La Cuenta no puede ser de cliente.","Error","Aceptar");					frn.setX("", "k_mov_ctas", -1, "k_cuenta");					frn.setX("", "k_mov_ctas", -1, "k_cuentadesc");					restore_row(); //Added by JMM 20240325					return ;            }                				var tbla = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2);				cmd = "select c2 as desc_cuenta from " & tbla & " where c1='" & cuenta  &  "'";								var cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Cuenta()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					//clear_row(); //Added by JMM 20240325					return;				}				var descr = getXmlAtt(cuboResultados , "r0","desc_cuenta");                  frn.setX(cuenta, "k_mov_ctas", -1, "k_cuenta");            frn.setX(descr , "k_mov_ctas", -1, "k_cuentadesc");                        //Added by JMM 20240714            if ( strlen( frn.get("k_mov_ctas",-1,"k_cuenta") ) == 0 || strlen( frn.get("k_mov_ctas",-1,"k_cuentadesc") ) == 0 ) {					frn.message("Cuenta No Valida ...","Error","Aceptar");					//clear_row();            }          		}				fun restore_row() {			frn.setX(frn.get("k_mov_ctas", -1, "k_cuenta_origen"), "k_mov_ctas", -1, "k_cuenta");			frn.setX(frn.get("k_mov_ctas", -1, "k_cuentadesc_origen"), "k_mov_ctas", -1, "k_cuentadesc");		}								fun porcentajes_kdmm (){						var cmd, cuboResultados ,ok,mensajeError;								cmd= " select c15,c16,c33,c75 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "'" ;							cmd = cmd & " and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4='" & tip_doc & "'";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_transfer_crud.porcentajes_kdmm()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				prc_iva = getXmlAtt(cuboResultados , "r0","c16");					}				fun CambiaSucursal() {			sucursal_id = frn.get("k_sucn",-1,1);			LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();						}				// imodo Added by JMM, 20240205		fun LimpiaEncabezado(imodo) {			if ( imodo != 1 ) { frn.set("k_folio", ""); } // Adapted by JMM, 20240205 			frn.set("k_docto", "");			frn.set("k_fecha", "");			frn.set("k_hora", "");			LimpiaDatosProv();			frn.set("k_clave", "");			frn.set("cmb_tipo", ""); // Added by JMM, 20240322			frn.set("c_fecha", ""); // Added by JMM, 20240419			frn.set("c_hora", ""); // Added by JMM, 20240419 			frn.set("c_usr", ""); // Added by JMM, 20240429						//Commented by JMM 20240605, for New Print Fto			/*frn.set("chk_validado", "0");*/ /*Added by MSS Integration 20240520*/					}				fun borrar_datos(){			frn.rst("k_mov");			frn.rst("k_refer");			frn.rst("k_coment");			frn.set("k_subtotal", 0);			frn.set("k_iva", 0);			frn.set("k_monto", 0);						//Commented by JMM 20240605, for New Print Fto			//Added by JMM 20240520			/*			frn.setAtt("chk_validado", "visible", "N");			frn.setAtt("txt_validado", "visible", "N");			*/		}				fun BuscarFolio() {			var folio;			folio = frn.get("k_folio");			folio = PadLeft(folio, 7, "0");			ArmarRefDocto();			borrar_datos();			MostrarDatos(folio);			}		fun Cancela() {			CambiaSucursal();			borrar_datos();			Inicializa();			ConfiguraControlesOpcion();		}		fun ObtenerFolio() {			sucursal_id = frn.get("k_sucn",-1,1);			//Adapted by JMM 20240313			cmdQuery = "select c6 as folio, substring(cast(c9 as VARCHAR),1,10) as fecha, /*c10 as cve_proveedor,*/ " &						"c11 as factura, c16 as monto, c43 estatus " &						"from keplersc.kdm1 " &						"where c1='" & sucursal_id & "' and c2='" & gen_doc & "' and c3='" & nat_doc & "' and c4=" & gpo_doc & " and c5=" & tip_doc;									cmdQuery = cmdQuery & " order by c9 desc, c6 desc"; // Added by JMM, 20240202									frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryfoliomov");							frn.dialog("genlistafiltrosel","Folios de Transfers",cmdQuery,"folio","k_folio","0","","S");					}				fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    			1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 			2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 			3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			// var tip_ope; 			var tip_oper;			if(iModo==0)				page=pag; 			else if(iModo==2&&(strlen(par0)>0)){				//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       				if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 				if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;			}			else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     		}					//------------------------------PROVEEDOR-----------------------					//Function Added by JMM, 202040311  		fun Get_Cat(imodo) {            				var suc_id, dato_id;				var win_tit, field_key, field_col, cmdQuery;								sucursal_id = frn.get("k_sucn",-1,1);	            				if ( imodo <= 0 || imodo > 1 /*7*/ ) {					// No es opcion de CAT Valida ...					return;				}								win_tit = "";				field_key = "";				field_col = "";				cmdQuery = "";				/*				if (imodo == 1) {					win_tit = "CAT Vehiculos";					field_key = "clave";					field_col = "modelo";					cmdQuery = "select C1 as clave, C2 as descripción from keplersc.kdiv";				}				*/								/*				if (imodo == 2) {					win_tit = "CAT Inventarios";					field_key = "clave";					field_col = "invent";										dato_id = "";					cmdQuery = "select C8 as campo from keplersc.kdiv where c1 = '" & frn.get("k_mov",-1,"modelo") & "'";					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comaltasigcrud.Get_Cat_kdiv_c8()");					//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\Get_Cat_Get_Cat_kdiv_c8()");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					dato_id = getXmlAtt(cuboQuery,"r0", "campo");					cmdQuery = "select d.C1 as clave, d.C2 as descripción from keplersc.kddinv d where d.c7 = '" & dato_id & "'";				}				*/				       				if (imodo == 1) {									// Added by JMM 20240408					if ( strlen( frn.get("cmb_tipo",-1,1) ) == 0 ) {						frn.message("Debes seleccionar primero el Tipo de Transferencia ...", "Error","Aceptar");						//frn.setX("", "k_mov", -1, "k_clave");						frn.setPos("cmb_tipo");						return;					}									win_tit = "CAT Proveedores";					field_key = "clave";					field_col = "k_clave";					//cmdQuery = "select C2 as clave, C3 as nombre from keplersc.kdxd where c1 =  '" & sucursal_id & "' /*and pagador = 1*/ order by C3";					//UPD by JMM 20240924					cmdQuery = "select C2 as clave, C3 as nombre from keplersc.kdxd /*where c1 = 'sucursal_id'*/ /*and pagador = 1*/ order by C3";				}			         	                      if ( strlen(win_tit) > 0 && strlen(field_key) > 0 && strlen(field_col) > 0 && strlen(cmdQuery) > 0 /*&& strlen(objeto) > 0*/ ) {                                        					frn.dialog("genlistasel", win_tit,cmdQuery, field_key, "k_mov",-1, field_col,"S");  /* * * *  USADO EN GRIDS */					//frn.dialog("genlistasel","Catálogo de Proveedores",cmdQuery,"k_claveprov","k_clave","0","","N");  /* * * *  USADO EN CTRLS SIMPLES */										//frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");				}						} /*END Func Get_Cat()*/						//UPD by JMM 20240311 		fun BuscarProveedor(){			var xmlProd;										// Added by JMM 20240408			if ( strlen( frn.get("cmb_tipo",-1,1) ) == 0 ) {				frn.message("Debes seleccionar primero el Tipo de Transferencia ...", "Error","Aceptar");				frn.setX("", "k_mov", -1, "k_clave");				frn.setPos("cmb_tipo");				return;			}							sucursal_id = frn.get("k_sucn",-1,1);			proveedor_id =  frn.get("k_mov", -1, "k_clave"); /*frn.get("k_clave_pago");*/			proveedor_id = trim(proveedor_id);						LimpiaDatosProv(); // To change, Prov is included in the grid 					if ( strlen( /*frn.get("k_clave")*/ proveedor_id ) == 0) {				frn.setX("", "k_mov", -1, "k_nombreprov");				return;			}						//commented by JMM	20240311			/*			if (strlen(frn.get("k_refer")) > 0) {				refer_id = frn.get("k_refer");			} else {				frn.set("k_fecha_exp", "");			}			*/									/*			cmdQuery = "select c10 as k_rfc, c3 as k_nombreprov, c4 as k_calleprov, c5 as k_coloniaprov, c6 as k_poblacionprov, c27 as k_cpprov, c16 as k_plazo " &									"from keplersc.kdxd where c1='" & sucursal_id & "' and c2='" & proveedor_id & "'" ;			*/						// Query commented & replaced by JMM 20240311 			/*			cmdQuery = "select keplersc.full_replace(c10,'-','') as k_rfc, c3 as k_nombreprov, c4 as k_calleprov, c5 as k_coloniaprov, c6 as k_poblacionprov, c27 as k_cpprov, c16 as k_plazo " &									"from keplersc.kdxd where c1='" & sucursal_id & "' and c2='" & proveedor_id & "'" ;			*/						//Adapted c_cuenta by JMM 20240314 			cmdQuery = "select c3 as k_nombreprov, case when pagdev = 1 then '' else ctadep end as c_cuenta " &									"from keplersc.kdxd where /*c1=' sucursal_id ' and*/ c2='" & proveedor_id & "'" ;								rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.BuscaProveedor()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				frn.set("Error en Busqueda ...", "k_mov", -1, "k_nombreprov");				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.setX("No Existe ...", "k_mov", -1, "k_nombreprov");				frn.setPos("k_mov", -1, "k_clave");				frn.message("El Proveedor No existe ...","Error","Aceptar");				return;				} 						var paramProv = get_param_proveedor(); // Added by JMM 20240425						frn.setX(getXmlAtt(cuboQuery,"r0", "k_nombreprov"), "k_mov", -1, "k_nombreprov");						if ( trim(paramProv) &! trim(proveedor_id) ) {  // Condition Added by JMM 20240425				frn.setX(getXmlAtt(cuboQuery,"r0", "c_cuenta"), "k_mov", -1, "c_cuenta"); /*Added by JMM 20240314*/			} /*else {				frn.setX("", "k_mov", -1, "c_cuenta"); // Added by JMM 20240314			}*/		}						// Added by JMM, 20240425 		fun get_param_proveedor() {			var paramProv, cuboFun;					sucursal_id = frn.get("k_sucn",-1,1);					paramProv = "";					// { Param Cta Gastos x Comprobar }			cmdQuery="SELECT (coalesce(valor,'')) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'Devolucion Clientes Proveedor'";			rstXml(cuboFun);							cuboFun = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtransfercrud.get_param_proveedor_dev()");								frn.lib("libGeneral.kpl","FileSave",cuboFun, fileSavePath & "\xmlResultado_GetParamProvDev");								ok=getXmlAtt(cuboFun,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboFun,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return paramProv;			}			// Los Mensajes de este IF se comentaron porque el objetivo es regresar el valor si lo encuentra ...			if (nXml(cuboFun) > 0) {				paramProv = getXmlAtt(cuboFun,"r0","paramvalor");				paramProv = trim(paramProv);				/*				if ( strlen(paramProv) == 0 ) {					frn.message("El Proveedor para esta Operacion No esta Registrado en el Parametro [Devolucion Clientes Proveedor] ...","Error","Aceptar");				}				*/			} else {				/*				frn.message("Hubo problemas para obtener el Parametro [Devolucion Clientes Proveedor] ...","Error","Aceptar");				*/			}			return paramProv;					}						fun LimpiaDatosProv() {					/*			frn.set("k_rfc", "");			frn.set("k_nombreprov", "");			frn.set("k_calleprov", "");			frn.set("k_coloniaprov", "");			frn.set("k_poblacionprov", "");			frn.set("k_fecha_exp", "");						frn.set("k_refer", "");			frn.set("k_fecha_exp", "");			frn.set("k_cpprov", "");						borrar_datos(); // Added by JMM 20240202			*/						//Adapted by JMM 20240311 			frn.setX("", "k_mov", -1, "k_nombreprov");			borrar_datos_factura();					}			//-----------------------------------FACTURA------------------------				// Added by JMM, 20240204		fun ObtenerCxP() {					proveedor_id = frn.get("k_mov", -1, "k_clave") /*frn.get("k_clave")*/;			if (strlen(proveedor_id ) == 0){				frn.message("Debes Seleccionar el Proveedor ...","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				frn.setX("", "k_mov", -1, "k_factura_rfc");				borrar_datos_factura();				return;			}			sucursal_id = frn.get("k_sucn",-1,1);						// UPD by JMM 20240303 , Including Prov Pago Selection			cmdQuery = "" &				"select " & 				"m.c5 origen " &				", w.c9 fecha, w.c6 folio, w.c16 total_doc " & // Added by JMM 20240408 				", abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) saldo " &				", (to_date(g.c12::text,'yyyy-mm-dd'))::text vencimiento " & 				", w.uuid_serie, w.uuid_folio " & // Moved by JMM 20240425  				", g.c4 uuid_o_ref " & 				", w.doc_refer_compl ref_compl " & // Added by JMM 20240408 				", w.doc_refer_aux ref_aux " & // Added by JMM 20240905				", w.uuid_fecha, w.uuid_total" & // Moved by JMM 20240425 				", g.c3 prov_operacion, d.c3 prov_nombre " & // Added by JMM 20240303				", w.concepto_factura " & // VCSS Impuestos				"from keplersc.kduxg g " &  				"inner join keplersc.kduxe e on g.c1 = e.c1 and g.c2 = e.c5 and g.c3 = e.c2 and g.c4 = e.c3 " & 				"and e.c6 = 'A' " & 				"inner join keplersc.kdmm m on m.col_sucursal = e.c1 and m.c1 = e.c5 and m.c2 = e.c6 and m.c3 = e.c7 and m.c4 = e.c8 " & 				"inner join keplersc.kdm1 w on w.c1 = e.c1 and w.c2 = e.c5 and w.c3 = e.c6 and w.c4 = e.c7 and w.c5 = e.c8 and w.c6 = e.c9 and w.c43<>'C' /*and w.concepto_factura<>'' */ " & 				"inner join keplersc.kdxd d on d.c2 = g.c3 "; 								cmdQuery = cmdQuery & "" & 				"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and ( g.cve_prov_pago = '" & proveedor_id & "' or ( g.c3 = '" & proveedor_id & "' and length(g.cve_prov_pago) = 0 ) ) " &  				"and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10 /*to check GAP in balance to show record*/ " & 				"and w.c16 > 0 ";					      // Condicion si solo muestra las C x P vencidas   			//cmdQuery = cmdQuery & " and g.c12 <= current_date /*to check if this condition will be used*/ "; 						cmdQuery = cmdQuery & " order by g.c12 ";							frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQuery_ObtenerCxP");							frn.dialog("genlistafiltrosel","C x P  del  Proveedor",cmdQuery,"uuid_o_ref"/*"folio"*/,"k_mov",-1,"k_factura"/*"k_folio"*/,"S");								}						fun ObtenerFactura(){			proveedor_id = frn.get("k_mov", -1, "k_clave") /*frn.get("k_clave")*/;			if (strlen(proveedor_id ) == 0){				frn.message("Debes Seleccionar un Proveedor antes","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				frn.setX("", "k_mov", -1, "k_factura_rfc");				borrar_datos_factura();				return;			}									// Adapted (in this schema) by JMM, 20240204			str_uuid = "";			str_uuid = frn.get("k_mov", -1, "k_factura");			var irow = frn.getJ("k_mov");						var nreg = frn.N("k_mov")-1;//cuantos renglones hay			for(var i=0; i<nreg; i++){				if (frn.get("k_mov",i,"k_factura") &= str_uuid && i != irow ){					frn.message("Ya seleccionaste esta factura ...","Error","Aceptar");					borrar_datos_factura(); // Adapted (in this schema) by JMM, 20240204					return;				}			}							sucursal_id = frn.get("k_sucn",-1,1);						var res = factura_cargos_abonos(str_uuid);			if (res == 1){				return ;			}						var monto = abonos_factura - cargos_factura;					frn.setX(monto ,"k_mov", -1, "k_monto_factura");			//VCSS Impuestos//			frn.setX(monto ,"k_mov", -1, "k_monto_factura_anterior");			//frn.setX(rfc_uuid ,"k_mov", -1, "k_factura_rfc"); // Commented by JMM 20240204 						iva(monto);						}					fun monto(){					proveedor_id = frn.get("k_mov", -1, "k_clave") /*frn.get("k_clave")*/;			if (strlen(proveedor_id ) == 0){				frn.message("Debes Seleccionar un Proveedor antes","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				borrar_datos_factura();				return;			}						var monto_factura = frn.get("k_mov", -1, "k_monto_factura");			if (monto_factura <= 0){				frn.message("No se puede dejar el monto en 0s","Error","Aceptar");				borrar_datos_factura(1);				return;			}						sucursal_id = frn.get("k_sucn",-1,1);			var factura = frn.get("k_mov", -1, "k_factura");			var res = factura_cargos_abonos(factura);			if (res == 1){				return ;			}						var saldo_temporal = (monto_factura  + cargos_factura) - abonos_factura ;						if (saldo_temporal > 0){				frn.message("No puede pagar superior al saldo de una factura","Error","Aceptar");				borrar_datos_factura(1);				var monto = abonos_factura - cargos_factura;				frn.setX(monto ,"k_mov", -1, "k_monto_factura");				iva(monto);				return;			}						iva(monto_factura);				}				fun borrar_datos_factura(imodo){					var irow = frn.getJ("k_mov"); // Added by JMM 20240204						frn.setX("", "k_mov", -1, "k_monto_factura");			frn.setX("", "k_mov", -1, "k_iva_factura");						// Added by JMM 20240204 			// /*			frn.setX("", "k_mov", -1, "k_factura_rfc");			if ( imodo != 1 ) { 			  frn.setX("", "k_mov", -1, "k_factura");			  frn.setX("", "k_mov", -1, "c_serie");			  frn.setX("", "k_mov", -1, "c_folio");			  frn.setX("", "k_mov", -1, "c_saldo");			  frn.setX("", "k_mov", -1, "c_vence");			  frn.setX("", "k_mov", -1, "k_prov"); // Added by JMM 20240311//			  frn.setX("", "k_mov", -1, "c_cuenta"); // Added by JMM 202004				// VCSS Impuestos			  frn.setX("", "k_mov", -1, "k_concepto_factura");			  frn.setX("", "k_mov", -1, "k_monto_factura");			  frn.setX("", "k_mov", -1, "k_iva_factura");			  frn.setX("", "k_mov", -1, "k_iva_ret");			  frn.setX("", "k_mov", -1, "k_isr_ret");			  frn.setX("", "k_mov", -1, "k_ieps_tras");			  frn.setX("", "k_mov", -1, "k_imptoadica");			  frn.setX("", "k_mov", -1, "k_imptoadicb");			  frn.setX("", "k_mov", -1, "k_factura_rfc");			  frn.setX("", "k_mov", -1, "k_prov");			  frn.setX("", "k_mov", -1, "k_monto_factura_anterior");			  frn.setX("", "k_mov", -1, "k_iva_factura_anterior");			  frn.setX("", "k_mov", -1, "k_iva_ret_anterior");			  frn.setX("", "k_mov", -1, "k_isr_ret_anterior");			  frn.setX("", "k_mov", -1, "k_ieps_tras_anterior");			  frn.setX("", "k_mov", -1, "k_imptoadica_anterior");			  frn.setX("", "k_mov", -1, "k_imptoadicb_anterior");			  			}			// */			}				fun factura_cargos_abonos(factura) {					var fechvenc, fechoper;						// UPD by JMM 20240303 , Including Prov Pago Selection			cmdQuery = "" &				"select " & 				"m.c5 origen " &				", w.uuid_serie, w.uuid_folio, w.uuid_fecha, w.uuid_total " &				", abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) saldo " &  				", g.c4 uuid, to_date(g.c12::text,'yyy-mm-dd') vencimiento " & 				", g.c6 as cargos, g.c7 as abonos, g.c8 as cargos_iva, g.c9 as abonos_iva " & 				", g.c3 prov_operacion " &				", g.abonos_ivaret, g.cargos_ivaret, g.abonos_isrret, g.cargos_isrret, g.abonos_iepstras, g.cargos_iepstras " &				", g.abonos_otroimptoa, g.cargos_otroimptoa, g.abonos_otroimptob, g.cargos_otroimptob " &				",abonos_ivaret-cargos_ivaret as saldo_ivaret, abonos_isrret-cargos_isrret as saldo_isrret " & 				",abonos_iepstras-cargos_iepstras as saldo_iepstras,abonos_otroimptoa-cargos_otroimptoa as saldo_otrosa" & 				",abonos_otroimptob-cargos_otroimptob as saldo_otrosb,abonos_totalimptoret-cargos_totalimptoret as saldo_imptoret" & 				",abonos_totalimptotras-cargos_totalimptotras as saldo_imptotras,w.concepto_factura " &				"from keplersc.kduxg g " &  				"inner join keplersc.kduxe e on g.c1 = e.c1 and g.c2 = e.c5 and g.c3 = e.c2 and g.c4 = e.c3 " & 				"inner join keplersc.kdmm m on m.col_sucursal = e.c1 and m.c1 = e.c5 and m.c2 = e.c6 and m.c3 = e.c7 and m.c4 = e.c8 " & 				"inner join keplersc.kdm1 w on w.c1 = e.c1 and w.c2 = e.c5 and w.c3 = e.c6 and w.c4 = e.c7 and w.c5 = e.c8 and w.c6 = e.c9 "; /*&*/				// Select Conditions UPD by JMM 20240303  				//"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and g.c3 = '" & proveedor_id & "' " &  				//"and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10 /*to check GAP in balance to show record*/ ";							cmdQuery = cmdQuery & "" & 				"where g.c1 = '" & sucursal_id & "' and g.c2 = 'X' and e.c6 = 'A' and ( g.cve_prov_pago = '" & proveedor_id & "' or ( g.c3 = '" & proveedor_id & "' and length(g.cve_prov_pago) = 0 ) ) " &  				"and abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) > 0.10 /*to check GAP in balance to show record*/ and w.c43 <> 'C' ";											// Condicion si solo muestra las C x P vencidas   			//cmdQuery = cmdQuery & " and g.c12 <= current_date /*to check if this condition will be used*/ "; 						cmdQuery = cmdQuery & " and g.c4 = '" & factura & "' ";						frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\RequestCrudTransfer");								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_transfer_crud.factura_cargos_abonos()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery ,fileSavePath & "\cuboQueryCrudTransfer");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			var totReg=nXml(cuboQuery);			if(totReg==0){				frn.message(/*"La Factura no esta registrada todavía."*/"La Factura No esta Registrada con el Proveedor especificado ...","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				borrar_datos_factura();				return 1;			}			//VCSS Impuestos			concepto_factura=getXmlAtt(cuboQuery, "r0", "concepto_factura");			if (concepto_factura &= ""){				frn.message("La Factura debe pagarse por transferencia anterior","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				borrar_datos_factura();				RecalcularPoliza();				return 1;			}									cargos_factura = getXmlAtt(cuboQuery, "r0", "cargos" );			abonos_factura = getXmlAtt(cuboQuery, "r0", "abonos" );			cargos_iva_factura = getXmlAtt(cuboQuery, "r0", "cargos_iva" );			abonos_iva_factura = getXmlAtt(cuboQuery, "r0", "abonos_iva" );			//VCSS 11/09/2025 Impuestos adicionales			abonos_ivaret= getXmlAtt(cuboQuery, "r0", "abonos_ivaret" ); 			cargos_ivaret= getXmlAtt(cuboQuery, "r0", "cargos_ivaret" );			abonos_isrret= getXmlAtt(cuboQuery, "r0", "abonos_isrret" );			cargos_isrret= getXmlAtt(cuboQuery, "r0", "cargos_isrret" );			abonos_iepstras= getXmlAtt(cuboQuery, "r0", "abonos_iepstras" );				cargos_iepstras= getXmlAtt(cuboQuery, "r0", "cargos_iepstras" );			abonos_otroimptoa= getXmlAtt(cuboQuery, "r0", "abonos_otroimptoa" );				cargos_otroimptoa= getXmlAtt(cuboQuery, "r0", "cargos_otroimptoa" );			abonos_otroimptob= getXmlAtt(cuboQuery, "r0", "abonos_otroimptob" );				cargos_otroimptob= getXmlAtt(cuboQuery, "r0", "cargos_otroimptob" );			concepto_factura = getXmlAtt(cuboQuery, "r0", "concepto_factura" );			//VCSS 29/09/2025 Impuestos			frn.setX(concepto_factura, "k_mov", -1, "k_concepto_factura");									//Code below Added by JMM 20240205			frn.setX(getXmlAtt(cuboQuery, "r0", "uuid_serie" ) , "k_mov", -1, "c_serie");			frn.setX(getXmlAtt(cuboQuery, "r0", "uuid_folio" ) , "k_mov", -1, "c_folio");			frn.setX(getXmlAtt(cuboQuery, "r0", "saldo" ) , "k_mov", -1, "c_saldo");			//frn.setX(mid(getXmlAtt(cuboQuery, "r0", "vencimiento",0,10) ) , "k_mov", -1, "c_vence");			frn.setX(getXmlAtt(cuboQuery, "r0", "vencimiento" ) , "k_mov", -1, "c_vence");						// Added by JMM 20240303 			frn.setX(getXmlAtt(cuboQuery, "r0", "prov_operacion" ) , "k_mov", -1, "k_prov");						fechvenc = mid(frn.get("k_mov", -1, "c_vence"),0,10);						if ( strlen(fechvenc) == 0 ) {				frn.message("No se pudo obtener la Fecha de Vencimiento de la C x P ...","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				borrar_datos_factura();				return 1;			}						frn.setX(fechvenc, "k_mov", -1, "c_vence");			fechvenc = formato_fecha(fechvenc);						fechoper = frn.get("k_fecha");			if ( strlen(fechoper) == 0 ) { fechoper = sys.date(); };			fechoper = formato_fecha(fechoper);					//VCSS 29/09/2025 Impuestos				//CargarCuentasConcepto();			// Commented by JMM, This validation was postponeb by Juan Sabas (requested on meeting)			/*			if ( fnDate("cmp", fechvenc, fechoper ) > 0 ) {				frn.message("La Fecha de Operacion esta por debajo de la Fecha de Vencimiento ..." & "|" & " " & 					"|" & " " & fechvenc ,"Error","Aceptar");				frn.setX("", "k_mov", -1, "k_factura");				borrar_datos_factura();				return 1;			} 			*/								} // End : factura_cargos_abonos 		//VCSS 24/09/25 Impuestos		//Para el concepto factura seleccionado carga las cuentas 		fun CargarCuentasConcepto(){			var cuboCuenta,id_tipo_factura,noRegs,strValor,cuenta,complemento,descripcion,tipo_asiento,monto,campoUI,cuentaGrupo;			var proveedor,id_concepto,existeCta,renCtas,renCta,tipo_asiento, noRegsFac;			var importe,importe_cargo, importe_abono,divisible,cuentaPlantilla;			var expInProv, expInUUID,uuid,renFac;						frn.rst("k_mov_ctas");			noRegsFac=frn.N("k_mov");						//Armar	expresion	in con los uuid a consultar			expInUUID="'X'";			expInProv="'X'";			for(renFac=0; renFac < noRegsFac; renFac++){				uuid=frn.get("k_mov", renFac, "k_factura");  				proveedor=frn.get("k_mov", renFac, "k_clave");				if (uuid&! ""){					expInUUID= expInUUID& ",'" & uuid& "'";					expInProv= expInProv & ",'" & proveedor& "'";				}			}				if (expInProv &= "X"){ //No hay doctos seleccionados				return;			}			cmdQuery = "select " & 				"g.c3 prov_operacion " &				",g.c4 uuid " &				",w.concepto_factura " & 				",fd.cuenta, fd.complemento_cuenta, fd.tipo_asiento,  fd.descripcion_partida, fd.referencia_partida " &				",fd.cuenta_grupo as cuenta_grupo,fd.cuenta_divisible, fd.campo_cuenta_plantilla " &				",fd.id_concepto as id_concepto " &				",coalesce(k.c2,'CUENTA NO VALIDA...') as descripcion " &				",fc.id_campo_ui as campo_ui " &				"from keplersc.kduxg g " &				"inner join keplersc.kduxe e on g.c1 = e.c1 and g.c2 = e.c5 and g.c3 = e.c2 and g.c4 = e.c3  and e.c6 = 'A' " &				"inner join keplersc.kdm1 w on w.c1 = e.c1 and w.c2 = e.c5 and w.c3 = e.c6 and w.c4 = e.c7 and w.c5 = e.c8 and w.c6 = e.c9 and w.c43<>'C' and w.concepto_factura<>'' " &				"inner join keplersc.conf_polizas_facturas_det fd on fd.id_tipo_factura = w.concepto_factura " &				"inner join keplersc.conf_polizas_facturas_conceptos fc on fc.id_concepto = fd.id_concepto " &				"left outer join keplersc.kdc1" & anio_contable & " k on k.c1=fd.cuenta " &				"where g.c3 in (" & expInProv & ")  and g.c4 in (" & expInUUID & ") " & 				"and fd.tipo_movto ='PAGO' " &				"order by prov_operacion, uuid, concepto_factura, cuenta ; " &										rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_transfer_crud.CargarCuentasConcepto()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",cuboQuery,"C:\Basura\CargarCuentasConcepto");				noRegs=nXml(cuboQuery);//return;				//***							//Agregar cuentas asociadas al concepto de la factura				renFac=0;				for(var i=0; i<noRegs; i++){					cuenta=getXmlAtt(cuboQuery, "r" & i, "cuenta");					complemento=getXmlAtt(cuboQuery, "r" & i, "complemento_cuenta");					descripcion=getXmlAtt(cuboQuery, "r" & i, "descripcion");					tipo_asiento=getXmlAtt(cuboQuery, "r" & i, "tipo_asiento");					campoUI=getXmlAtt(cuboQuery, "r" & i, "campo_ui");					cuentaGrupo=getXmlAtt(cuboQuery, "r" & i, "cuenta_grupo");					divisible=getXmlAtt(cuboQuery, "r" & i, "cuenta_divisible");					cuentaPlantilla=getXmlAtt(cuboQuery, "r" & i, "campo_cuenta_plantilla");					id_concepto=getXmlAtt(cuboQuery, "r" & i, "id_concepto");					tipo_asiento=getXmlAtt(cuboQuery, "r" & i, "tipo_asiento");						uuid=getXmlAtt(cuboQuery, "r" & i, "uuid");					proveedor=getXmlAtt(cuboQuery, "r" & i, "prov_operacion");										monto=frn.get(campoUI);					//Ubicar el proveedor y docto en el grid					if (uuid &! frn.get("k_mov", renFac, "k_factura") || proveedor &! frn.get("k_mov", renFac, "k_clave")){						noRegsFac=frn.N("k_mov");						for(renFac=0; renFac < noRegsFac; renFac++){							if (uuid &= frn.get("k_mov", renFac, "k_factura") && proveedor&=frn.get("k_mov", renFac, "k_clave")){								break;							}												}					}					if (uuid &! frn.get("k_mov", renFac, "k_factura") || proveedor &! frn.get("k_mov", renFac, "k_clave")){						frn.message("No se tiene seleccionado el uuid: " & uuid & " del proveedor: " & proveedor, "Error", "Aceptar");						frn.rst("k_mov_ctas");						return;					}										if (complemento &= "PROVEEDOR"){						cuenta=cuenta & "-" & proveedor;						cmdQuery = "select c1 as cuenta, c2 as descripcion from keplersc.kdc1" & anio_contable & " k where c1='" & cuenta & "'";						rstXml(cuboCuenta);						cuboCuenta= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_transfer_crud.CargarCuentasConcepto()");						ok=getXmlAtt(cuboCuenta,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cuboCuenta,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;						}						if(getXmlAtt(cuboCuenta, "r0", "cuenta") &= ""){							descripcion="CUENTA NO VALIDA...";						}else{							descripcion=getXmlAtt(cuboCuenta, "r0", "descripcion");						}					}					//Buscar la cuenta en la lista, si no existe agregar					renCtas = frn.N("k_mov_ctas");					existeCta="N";					renCta=0;/*										for (renCtas=0; renCtas < frn.N("k_mov_ctas");  renCtas++){						if (frn.get("k_mov_ctas",renCtas,"k_cuenta_origen") &= cuenta){							existeCta="S";							renCta=renCtas;							break;						}					}*/					if (existeCta &= "N"){						renCta=renCtas-1;						frn.setX(cuenta, "k_mov_ctas",renCta,"k_cuenta");						frn.setX(descripcion, "k_mov_ctas",renCta,"k_cuentadesc");						frn.setX(cuentaGrupo, "k_mov_ctas",renCta,"k_cuenta_grupo");						frn.setX(id_concepto, "k_mov_ctas",renCta,"k_id_concepto");																//Datos originales pra reestablecer renglon						frn.setX(cuenta, "k_mov_ctas",renCta,"k_cuenta_origen");						frn.setX(descripcion, "k_mov_ctas",renCta,"k_cuentadesc_origen");						frn.setX(cuentaGrupo, "k_mov_ctas",renCta,"k_cuenta_grupo_origen");						frn.setX(divisible, "k_mov_ctas",renCta,"k_cuenta_divisible");						frn.setX(cuentaPlantilla, "k_mov_ctas",renCta,"k_campo_cuenta_plantilla");						frn.setX(id_concepto, "k_mov_ctas",renCta,"k_id_concepto_origen");						frn.setX(frn.get("k_mov", renFac, "k_factura"), "k_mov_ctas",i,"k_referencia_uuid");					}										//Sumar el monto del concepto					importe_cargo = frn.get("k_mov_ctas",renCta,"k_cargo");						importe_abono = frn.get("k_mov_ctas",renCta,"k_abono");											if (id_concepto &= "total"){						importe = frn.get("k_mov", renFac, "k_monto_factura");					}					if (id_concepto &= "iva_tras"){						importe = frn.get("k_mov", renFac, "k_iva_factura");					}					if (id_concepto &= "iva_ret"){						importe = frn.get("k_mov", renFac, "k_iva_ret");					}					if (id_concepto &= "isr_ret"){						importe = frn.get("k_mov", renFac, "k_isr_ret");					}					if (id_concepto &= "ieps_tras"){						importe = frn.get("k_mov", renFac, "k_ieps_tras");					}					if (id_concepto &= "impto_ced"){						importe = frn.get("k_mov", renFac, "k_imptoadicb");					}					if (id_concepto &= "impto_cedT"){						importe = frn.get("k_mov", renFac, "k_imptoadica");					}					if (id_concepto &= "subtotal"){						importe =frn.get("k_mov", renFac, "k_monto_factura") - (frn.get("k_mov", renFac, "k_iva_factura")+ frn.get("k_mov", renFac, "k_ieps_tras") + frn.get("k_mov", renFac, "k_imptoadica")) + 						(frn.get("k_mov", renFac, "k_iva_ret") + frn.get("k_mov", renFac, "k_isr_ret") +  frn.get("k_mov", renFac, "k_imptoadicb"));						}																																	if(tipo_asiento &= "C"){						importe_cargo=importe_cargo + importe;					}else{						importe_abono=importe_abono + importe;					}															frn.setX(importe_cargo, "k_mov_ctas",renCta,"k_cargo");					frn.setX(importe_abono, "k_mov_ctas",renCta,"k_abono");					frn.setX(importe_cargo, "k_mov_ctas",renCta,"k_cargo_origen");					frn.setX(importe_abono, "k_mov_ctas",renCta,"k_abono_origen");														}												//Evaluar y cambiar cuentas de plantilla				renCtas = frn.N("k_mov_ctas");				cuentaPlantilla="";				renCta=0;				for (renCtas=0; renCtas < frn.N("k_mov_ctas");  renCtas++){					cuentaPlantilla=frn.get("k_mov_ctas",renCtas,"k_campo_cuenta_plantilla");					if (cuentaPlantilla &! ""){						//Obtener campo cuenta						cmdQuery = "select " & cuentaPlantilla & " as cuenta from keplersc.kdmm mm where mm.c1='" & gen_doc & "' " ;						cmdQuery = cmdQuery & " and mm.c2='" & nat_doc & "' and mm.c3=" & gpo_doc & " and mm.c4=" & tip_doc & " ";						cmdQuery = cmdQuery & " and mm.col_sucursal='" & sucursal_id & "' ";						frn.lib("libGeneral.kpl","FileSave",cmdQuery ,"C:\Basura\cmdCuentaPlantilla");															rstXml(cuboCuenta);						cuboCuenta= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.CargarCuentasConcepto()");						frn.lib("libGeneral.kpl","FileSave",cuboCuenta,"C:\Basura\cuboCuentaPlantilla");						ok=getXmlAtt(cuboCuenta,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cuboCuenta,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;						}						cuenta=getXmlAtt(cuboCuenta, "r0", "cuenta");											//Obtener detalle de cuenta						cmdQuery = "select c1 as cuenta, c2 as descripcion from keplersc.kdc1" & anio_contable & " k where c1='" & cuenta & "'";						rstXml(cuboCuenta);						cuboCuenta= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.CargarCuentasConcepto()");						ok=getXmlAtt(cuboCuenta,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cuboCuenta,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;						}						if(getXmlAtt(cuboCuenta, "r0", "cuenta") &= ""){							descripcion="CUENTA NO VALIDA...";						}else{							descripcion=getXmlAtt(cuboCuenta, "r0", "descripcion");						}						frn.setX(cuenta, "k_mov_ctas",renCtas,"k_cuenta");						frn.setX(descripcion, "k_mov_ctas",renCtas,"k_cuentadesc");					}				}	//			var xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;//			frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaTransfer");		}				// New Func 20240205 by JMM		fun formato_fecha(fech) {			var strFech, tmpData;						strFech = fnDate("year", fech) & "/";			tmpData = fnDate("month", fech);			if(strlen(tmpData) == 1){				tmpData = "0" & tmpData;			}			strFech = strFech & tmpData & "/";			tmpData = fnDate("day", fech);			if(strlen(tmpData) == 1){				tmpData = "0" & tmpData;			}			strFech = strFech & tmpData;						return strFech;			} // end fun - formato_fecha						fun iva(monto){			var iva, valor, renCtas, tipo_asiento, id_concepto, importe_cargo, importe_abono, importe, totRen;			//TODO,ver como se calcula realmente			//var iva = monto * (1-(1/(1+prc_iva/100)));//frn.message("monto:" & monto &  " abonos_iva_factura:" &abonos_iva_factura & "abonos_factura:"& abonos_factura);			//VCSS 11/09/2025 Impuestos			//Pasar lo valores atuales a anteriores como respaldo			//frn.setX(monto,"k_mov", -1, "k_monto_factura_anterior"); //Actualizado desde la carga e ingreso			frn.setX(frn.get("k_mov", -1, "k_iva_factura"),"k_mov", -1, "k_iva_factura_anterior");			frn.setX(frn.get("k_mov", -1, "k_iva_ret"),"k_mov", -1, "k_iva_ret_anterior");			frn.setX(frn.get("k_mov", -1, "k_isr_ret"),"k_mov", -1, "k_isr_ret_anterior");			frn.setX(frn.get("k_mov", -1, "k_ieps_tras"),"k_mov", -1, "k_ieps_tras_anterior");			frn.setX(frn.get("k_mov", -1, "k_imptoadica"),"k_mov", -1, "k_imptoadica_anterior");			frn.setX(frn.get("k_mov", -1, "k_imptoadicb"),"k_mov", -1, "k_imptoadicb_anterior");								//VCSS 11/09/2025 Impuestos			iva = (monto * abonos_iva_factura)/abonos_factura;			frn.setX(iva ,"k_mov", -1, "k_iva_factura");						valor=(monto * abonos_ivaret)/abonos_factura;			frn.setX(valor,"k_mov", -1, "k_iva_ret");			valor=(monto * abonos_isrret)/abonos_factura;			frn.setX(valor,"k_mov", -1, "k_isr_ret");			valor=(monto * abonos_iepstras)/abonos_factura;			frn.setX(valor,"k_mov", -1, "k_ieps_tras");			valor=(monto * abonos_otroimptoa)/abonos_factura;			frn.setX(valor,"k_mov", -1, "k_imptoadica");			valor=(monto * abonos_otroimptob)/abonos_factura;			frn.setX(valor,"k_mov", -1, "k_imptoadicb");									//Regenerar la lista de cuentas//			CargarCuentasConcepto();			CalcTotal();		}				fun CalcTotal() { 						var monto_facturas =0, iva_facturas=0;				var ivaret_facturas=0,isrret_facturas=0,iepstras_facturas=0,otroimptoa_facturas=0,otroimptob_facturas=0; //VCSS 11/09/2025 Impuestos				var subtotal, total, totRen, importe_cargo, importe_abono;				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) { 					monto_facturas=monto_facturas +frn.get("k_mov",i,"k_monto_factura");					iva_facturas=iva_facturas+frn.get("k_mov",i,"k_iva_factura");										//VCSS 11/09/2025 Impuestos					ivaret_facturas=ivaret_facturas + frn.get("k_mov",i,"k_iva_ret");					isrret_facturas=isrret_facturas + frn.get("k_mov",i,"k_isr_ret");					iepstras_facturas=iepstras_facturas+ frn.get("k_mov",i,"k_ieps_tras");					otroimptoa_facturas=otroimptoa_facturas+ frn.get("k_mov",i,"k_imptoadica");					otroimptob_facturas=otroimptob_facturas+ frn.get("k_mov",i,"k_imptoadicb");									}								//VCSS 11/09/2025 Impuestos								frn.setX(monto_facturas,"k_monto_total");				frn.setX(iva_facturas,"k_iva_tras_total");								frn.setX(ivaret_facturas,"k_iva_ret_total");				frn.setX(isrret_facturas,"k_isr_ret_total");				frn.setX(iepstras_facturas,"k_ieps_tras_total");				frn.setX(otroimptoa_facturas,"k_imptoadica_total");				frn.setX(otroimptob_facturas,"k_imptoadicb_total");				subtotal=monto_facturas - (iva_facturas + iepstras_facturas + otroimptoa_facturas) + (ivaret_facturas + isrret_facturas + otroimptob_facturas);				frn.setX(subtotal,"k_subtotal");					frn.setX(iva_facturas + iepstras_facturas + otroimptoa_facturas,"k_imptos_tras_total");					frn.setX(ivaret_facturas + isrret_facturas + otroimptob_facturas,"k_imptos_ret_total");				frn.setX(monto_facturas ,"k_monto");								//frn.message("monto_facturas:" &monto_facturas & " iva_facturas:" &iva_facturas);				//				frn.set("k_subtotal", monto_facturas - iva_facturas, "k_iva" ,iva_facturas, "k_monto", monto_facturas);			totRen=frn.N("k_mov_ctas");			importe_cargo = 0;			importe_abono = 0;			for (var renCtas=0; renCtas < totRen;  renCtas++){				importe_cargo = importe_cargo + frn.get("k_mov_ctas",renCtas,"k_cargo");					importe_abono = importe_abono + frn.get("k_mov_ctas",renCtas,"k_abono");			}			frn.setX(importe_cargo, "k_total_cargos");			frn.setX(importe_abono, "k_total_abonos");		}					//-----------------------------------------------				fun ConfiguraControlesOff() {							frn.setAtt("textFolio", "visible", "N");			frn.setAtt("k_folio", "available", "N");			frn.setAtt("k_folio", "visible", "N");			frn.setAtt("k_mov", "modify", "N");			frn.setAtt("k_mov", "available", "N", "k_factura");			frn.setAtt("k_clave", "available", "N");			frn.setAtt("k_refer", "available", "N");			frn.setAtt("k_coment","modify", "N");			frn.setAtt("k_coment","available", "N");			frn.setAtt("Imprimir", "visible", "N");			//Commented by JMM 20240605, for New Print Fto			/*Added by MSS Integration 20240520*/			/*			frn.setAtt("chk_validado", "visible", "N");			frn.setAtt("txt_validado", "visible", "N");			*/						frn.setAtt("Cancelar", "visible", "N");			frn.setAtt("Aceptar", "visible", "N");			frn.setAtt("buscar_datos", "visible", "N");						frn.setAtt("k_factura_rfc", "available", "N");			frn.setAtt("k_factura_rfc", "visible", "N");						frn.setAtt("k_fecha", "available", "N"); // Added by JMM, 20240207 						frn.setAtt("k_tipon", "available", "N"); // Added by JMM, 20240312						frn.setAtt("k_mov", "visible", "N", "c_cuenta");	//Added	by JMM 20240314			frn.setAtt("k_mov", "modify", "N", "c_cuenta");	//Added	by JMM 20240314			frn.setAtt("k_mov", "available", "N", "c_cuenta");	//Added	by JMM 20240314						frn.setAtt("cmb_tipo", "available", "N");		//Added	by JMM 20240322										}						fun ConfiguraControlesOpcion() {						ConfiguraControlesOff();			if(tip_ope &= "A"){ //Alta				frn.setAtt("k_clave", "available", "Y");				frn.setAtt("k_refer", "available", "y");				frn.setAtt("k_mov", "modify", "Y");				frn.setAtt("k_mov", "available", "Y", "k_factura");				frn.setAtt("k_coment","modify", "Y");				frn.setAtt("k_coment","available", "Y");				frn.setAtt("k_fecha", "available", "N"/*"Y"*/);	//MSS Habilitar fecha // Unabled by JMM, 20240207				frn.setAtt("Cancelar", "visible", "Y");				frn.setAtt("Aceptar", "visible", "Y");										frn.setAtt("k_mov", "modify", "Y", "k_clave");	//Added	by JMM 20240311				frn.setAtt("k_mov", "available", "Y", "k_clave");	//Added	by JMM 20240311				frn.setAtt("k_tipon", "available", "N"); // Added by JMM, 20240312				frn.setAtt("k_mov", "visible", "Y", "c_cuenta");	//Added	by JMM 20240314				frn.setAtt("k_mov", "modify", "Y", "c_cuenta");	//Added	by JMM 20240314				frn.setAtt("k_mov", "available", "Y", "c_cuenta");	//Added	by JMM 20240314								frn.setAtt("cmb_tipo", "available", "Y");		//Added	by JMM 20240322							} else {				if(tip_ope &= "B"){ //Baja									frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");							frn.setAtt("Aceptar", "visible", "Y");						frn.setAtt("buscar_datos", "visible", "Y");											frn.setAtt("k_fecha", "available", "N"/*"Y"*/);	//MSS Habilitar fecha // Unabled by JMM, 20240207					frn.setAtt("k_tipon", "available", "N"); // Added by JMM, 20240312					frn.setAtt("k_mov", "visible", "N", "c_cuenta");	//Added	by JMM 20240314					frn.setAtt("k_mov", "modify", "N", "c_cuenta");	//Added	by JMM 20240314					frn.setAtt("k_mov", "available", "N", "c_cuenta");	//Added	by JMM 20240314										frn.setAtt("cmb_tipo", "available", "N");		//Added	by JMM 20240322									} else {					if(tip_ope &= "C"){ //Consulta						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");											frn.setAtt("Imprimir", "visible", "Y");						//Commented by JMM 20240520 ... Se evaluara en el Mostrar Datos 						/*						//Added by MSS Integration 20240520						frn.setAtt("chk_validado", "visible", "Y");						frn.setAtt("txt_validado", "visible", "Y");						*/												frn.setAtt("buscar_datos", "visible", "Y");						frn.setAtt("k_tipon", "available", "N"); // Added by JMM, 20240312						frn.setAtt("k_mov", "visible", "N", "c_cuenta");	//Added	by JMM 20240314						frn.setAtt("k_mov", "modify", "N", "c_cuenta");	//Added	by JMM 20240314						frn.setAtt("k_mov", "available", "N", "c_cuenta");	//Added	by JMM 20240314														frn.setAtt("cmb_tipo", "available", "N");		//Added	by JMM 20240322 												frn.setAtt("k_mov", "visible", "Y", "c_cuenta");	//Added	by JMM 20240327					} else {						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");						frn.setAtt("k_fecha", "available", "Y");						frn.setAtt("k_hora", "available", "Y");						frn.setAtt("k_tipon", "available", "N"); // Added by JMM, 20240312						frn.setAtt("k_mov", "visible", "N", "c_cuenta");	//Added	by JMM 20240314						frn.setAtt("k_mov", "modify", "N", "c_cuenta");	//Added	by JMM 20240314						frn.setAtt("k_mov", "available", "N", "c_cuenta");	//Added	by JMM 20240314						frn.setAtt("cmb_tipo", "available", "N");		//Added	by JMM 20240322					}					}			}		}				//---------------------------------------EJECUTA---------------------------------			fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			var resultado, mensaje, folio;							fecha = sys.date();			hora= sys.time();			RecalcularPoliza();	//Recalcula totales			if (tip_ope &= "A") {							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;				ValidarDatos();				if(ok &! "1" || resVal == 0){					return;				}								continua = frn.message("Desea continuar con el Alta ?","Atencion",2);				if (continua == 0){					return;				}									xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;											setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov") -1);				setXml(xmlPantalla,"k_tabla_mov","kdm5");				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"uuid","concepto_factura","GPODUMMY"); //Se manda este valor por tratarse de más de un tipo				setXml(xmlPantalla,"uuid","tipo_poliza","GPODUMMY"); //Se manda este valor por tartarse de más de un tipo												// Added by JMM 20240304				setXml(xmlPantalla,"ambiente","schema","CXP_TRANSFER");				// VCSS 12/11/2025 Impuestos				setXml(xmlPantalla,"k_mov_ctas","no_partidas",frn.N("k_mov_ctas") -1);									frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudTransfer");								// For Testing ... 20240111 				/*				frn.message("La Informacion se Procesara ...","Info !!!","Aceptar");				return;				*/				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cuboQuery);				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_transfer_crud.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudTransfer");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					tip_ope = "C";					frn.set("k_folio", mensaje); 					frn.set("operacion", "CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto", strTmp);					strMsg = "El Folio utilizado para esta operacion fue : " & mensaje;					ConfiguraControlesOpcion(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");					MostrarDatos(folio);						//BuscarFolio();				} else {					frn.message(mensaje, "Error", "Aceptar");				}			} else {				if (tip_ope &= "B") {									// Added by JMM 20240516 					frn.message("Operacion No Soportada, debes utilizar la Validacion de Transfer para Revertir Registros ...","Info !!!","Aceptar");					return;										if (estatus_doc &= "C"){						frn.message("No puedes dar de baja un folio cancelado.", "Error", "Aceptar");						return ;					}					continua = frn.message("Desea continuar con la baja?","Atencion",2);					if (continua == 0){						return;					}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;													setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);					setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov"));					setXml(xmlPantalla,"operacion","baja");					setXml(xmlPantalla,"ambiente","uen",uen);																frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudTransfer");					cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					rstXml(cuboQuery);											cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_transfer_crud.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudTransfer");											resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok) {						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}					if(resultado &= "1") {						tip_ope = "C";						frn.set("operacion", "CONSULTA");						ConfiguraControlesOpcion();						BuscarFolio();					} else {						frn.message(mensaje, "Error", "Aceptar");					}				} else {					folio = frn.get("k_folio");					MostrarDatos(folio);				}	/*End Consulta*/ 			}						}				//Validacion Datos Generales y Partidas antes de Guardar.		//El resultado de cada validacion se guarda en la variable global resVal.		fun ValidarDatos() {			var totReg, strTotal=0,subTotal=0, iva=0, total=0, renglones, str;			var tipo_trans; //Added by JMM 20240322					//Added by JMM 20240410 			CalcTotal();					//Obtener variables			sucursal_id = frn.get("k_sucn",-1,1);			/*proveedor_id = frn.get("k_clave");*/ //Moved below (items section) by JMM 20240311			refer_id = frn.get("k_refer");						tipo_trans = "";			tipo_trans = frn.get("cmb_tipo",-1,1);			if ( strlen(tipo_trans) == 0 ) {				frn.setPos("cmb_tipo");				resVal=0;				frn.message("Debes seleccionar el Tipo de Transferencia ...","Error","Aceptar");				return;			} else {				if ( tipo_trans &! "B" && tipo_trans &! "I" ) {					frn.setPos("cmb_tipo");					resVal=0;					frn.message("El Tipo de Transferencia No es Valido  ...","Error","Aceptar");					return;				}			}						//Moved below (items section) by JMM 20240311			/*					//Validar Proveedor			cmdQuery="SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_id & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_transfer_crud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				resVal=0; return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("El Proveedor No Existe ...","Error","Aceptar");				resVal=0; return;			}			*/									//Validar Referencia			if (refer_id &= ""){				frn.setPos("k_refer");				resVal=0;				frn.message("Es Necesario Registrar la referencia ...","Error","Aceptar");				return;			}					var nreg = frn.N("k_mov")-1;//cuantos renglones hay			if(nreg ==0){				frn.message("No es posible dar de alta un Transfer sin datos. Favor de verificar", "Error","&Aceptar");				resVal=0;return;			}					for(var i=0; i<nreg; i++){							var fac = frn.get("k_mov",i,"k_factura");				var fac_monto = frn.get("k_mov",i,"k_monto_factura");				var factura_numero = i + 1 ;								//Added by JMM 20240206				var fac_saldo = frn.get("k_mov",i,"c_saldo");				var fac_vence = frn.get("k_mov",i,"c_vence");				var fechvenc, fechoper;								//Added by JMM 20240314				var ctadep = frn.get("k_mov",i,"c_cuenta");								//Moved here & adapted by JMM 20240311				proveedor_id = frn.get("k_mov", i, "k_clave") /*frn.get("k_clave")*/;								cmdQuery="SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_id & "'";				rstXml(cuboQuery);								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_transfer_crud.ValidarDatos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					resVal=0; return;				}				totReg=getXmlAtt(cuboQuery,"r0","totreg");				if(totReg==0){					frn.setPos("k_mov", i,"k_clave");					frn.message("El Proveedor No Existe ... " & proveedor_id,"Error","Aceptar");					resVal=0; return;				}												//Added by JMM 20240322				if ( tipo_trans &= "B" && strlen(ctadep) != 10 ){					frn.message("Se ha generado el siguiente error en la partida " & factura_numero  & " : La Cuenta de Deposito debe ser de 10 digitos, Verifica bien este dato ya que es muy Sencible" ,"Error","&Aceptar");					frn.setPos("k_mov", i/*-1*/,"c_cuenta");					resVal=0;return;				}								if ( tipo_trans &= "I" && strlen(ctadep) != 18 ){					frn.message("Se ha generado el siguiente error en la partida " & factura_numero  & " : La Cuenta de Deposito debe ser de 18 digitos, Verifica bien este dato ya que es muy Sencible" ,"Error","&Aceptar");					frn.setPos("k_mov", i/*-1*/,"c_cuenta");					resVal=0;return;				}										if (strlen(fac) == 0){					frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : No se especifica la Factura" ,"Error","&Aceptar");					frn.setPos("k_mov", i/*-1*/,"k_factura");					resVal=0;return;				}								if (strlen(fac_monto) == 0 || fac_monto == 0){					frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : No se especifica el monto de la Factura" ,"Error","&Aceptar");					frn.setPos("k_mov", i/*-1*/,"k_monto_factura");					resVal=0;return;				}												//Conditions Added by JMM, 20240206 				if ( fac_monto > fac_saldo ) {					frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : Monto del Pago Mayor al Saldo del Documento" ,"Error","&Aceptar");					frn.setPos("k_mov", i/*-1*/,"k_monto_factura");					resVal=0;return;				}				if ( strlen(fac_vence) == 0 ) {					frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : No se cuenta con la Fecha de Vencimiento" ,"Error","&Aceptar");					frn.setPos("k_mov", i/*-1*/,"k_monto_factura");					resVal=0;return;				}				fechvenc = formato_fecha(fac_vence);								fechoper = sys.date();				fechoper = formato_fecha(fechoper);							// Validation commented by JMM 20240303 ... Based on meeting ( Juan Sabas )				//if ( fnDate("cmp", fechvenc, fechoper ) > 0 /*strFecha > fech_limit*/ ) {				/*				if ( fnDate("cmp", fechvenc, fechoper ) > 0 ) {					frn.message("Se ha generado el siguiente error en la factura " & factura_numero & " : Fecha de Operacion por debajo de la Fecha de Vencimiento" 						& "|" & " "   						& "|" & " " & fechoper & "  VS.  " & fechvenc ,"Error","Aceptar");					frn.setPos("k_mov",-1,"k_factura");					resVal=0;return;				} 				*/								//Validar que rfc de facturas correspondan al del proveedor				// Commented by JMM, 20240204, las CxP se seleccionan del Proveedor ...				/*				if (frn.get("k_rfc") &! frn.get("k_mov",i,"k_factura_rfc")) {					frn.message("El RFC de la factura " & factura_numero  & " no corresponde al proveedor.","Error","Aceptar");					resVal=0;return;				}				*/								//Validar quee Factura corresponda al Proveedor de Pago				cmdQuery="SELECT count(*) as totreg from keplersc.kduxg where c2 = 'X' and c4 = '" & fac & "' and ( cve_prov_pago = '" & proveedor_id & "' or ( c3 = '" & proveedor_id & "' and length(cve_prov_pago) = 0 ) ) ";				rstXml(cuboQuery);								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_transfer_crud.ValidarDatos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					resVal=0; return;				}				totReg=getXmlAtt(cuboQuery,"r0","totreg");				if(totReg==0){					frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : No corresponde al Proveedor de Pago" ,"Error","&Aceptar");					frn.setPos("k_mov", i,"k_factura");					resVal=0; return;				}			}					if (frn.get("k_total_cargos") &! frn.get("k_total_abonos")){				frn.message("Poliza descuadrada, verifque la configuracion.","Error","&Aceptar");				resVal=0; 				return;			}						var totRen=frn.N("k_mov_ctas");			for (var renCtas=0; renCtas < totRen;  renCtas++){				if (frn.get("k_mov_ctas",renCtas,"k_cuentadesc") &= "CUENTA NO VALIDA..."){					frn.message("La cuenta " & frn.get("k_mov_ctas",renCtas,"k_cuenta") & " no es valida." ,"Error","&Aceptar");					frn.setPos("k_mov_ctas", renCtas, "k_cuenta");					resVal=0; 					return;								}			}		} // End ValidarDatos()						//-----------------------BAJA,CONSULTA----------------------------			fun MostrarDatos(nFolio) {			var cmd,xmlRequest,xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError;			var prov_hist, tipo_transfer;						sucursal_id = frn.get("k_sucn",-1,1);					cmd = " select c10 as clave_doc, c9 as k_fecha,c11 as k_refer ,c69 as k_hora , c24 as k_coment, c43 as estatus_doc , c197 as fecha_baja " ;					cmd = cmd & " , coalesce(tipo_transfer,'') as tipo_transfer "; 			cmd = cmd & " , c14 as k_iva, c16 as k_monto, (c16-c14) as k_subtotal ";			cmd = cmd & " , fecha_comprobacion as f_compr, hora_comprobacion as h_compr ";  			cmd = cmd & " , usr_comprobacion as u_compr ";			cmd = cmd & " from keplersc.kdm1 where c1='" & sucursal_id  & "' and c2='" & gen_doc  &"' and c3='" & nat_doc & "' and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_transfer_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			//Added by JMM 20240322			if(nXml(cuboResultados) == 0) {				frn.message("El Documento No Existe ...","Error","Aceptar");				return;			}			var xml_kdm1  = getXml(cuboResultados,"r0" );						frn.set("k_fecha",getXmlAtt(xml_kdm1,"k_fecha") );			frn.set("k_hora",getXmlAtt(xml_kdm1,"k_hora") );			frn.set("k_coment",getXmlAtt(xml_kdm1,"k_coment") );						frn.set("k_refer",getXmlAtt(xml_kdm1  ,"k_refer") );						prov_hist = getXmlAtt(xml_kdm1  ,"clave_doc");						tipo_transfer = "";			frn.set("cmb_tipo", "");			tipo_transfer = getXmlAtt(xml_kdm1  ,"tipo_transfer");			if ( tipo_transfer &= "B" ) { frn.set("cmb_tipo", CtaBnc); } 			if ( tipo_transfer &= "I" ) { frn.set("cmb_tipo", CtaInt); }			frn.set("k_subtotal",getXmlAtt(xml_kdm1,"k_subtotal") );			frn.set("k_iva",getXmlAtt(xml_kdm1,"k_iva") );			frn.set("k_monto",getXmlAtt(xml_kdm1,"k_monto") );						frn.set("c_fecha",getXmlAtt(xml_kdm1,"f_compr") ); //Adapted by JMM 20240419			frn.set("c_hora",getXmlAtt(xml_kdm1,"h_compr") ); //Adapted by JMM 20240419			frn.set("c_usr",getXmlAtt(xml_kdm1,"u_compr") ); //Adapted by JMM 20240429						//Commented by JMM, Por Default que se vea el Transfer Original 			/*			//Added by MSS Integration 20240520			if (frn.get("c_fecha") &! "1800-01-01" && frn.get("c_fecha") &! ""){				frn.set("chk_validado", "1");			}else{				frn.set("chk_validado", "0");			}			*/			//Commented by JMM 20240605, for New Print Fto			//Adapted by JMM 20240520 			/*			frn.set("chk_validado", "0");			if (frn.get("c_fecha") &! "1800-01-01" && frn.get("c_fecha") &! ""){				frn.setAtt("chk_validado", "visible", "Y");				frn.setAtt("txt_validado", "visible", "Y");			} else {				frn.setAtt("chk_validado", "visible", "N");				frn.setAtt("txt_validado", "visible", "N");			}			*/									fecha_baja = getXmlAtt(xml_kdm1  ,"fecha_baja");						estatus_doc = getXmlAtt(xml_kdm1  ,"estatus_doc");							if (estatus_doc &= "C"){	// C=Cancelado				frn.message("El Transfer se encuentra cancelado","Error","Aceptar");				frn.set("statusdoc", "CANCELADO");			}else{				frn.set("statusdoc", "");			}			rstXml(cmd);						cmd = "select " &  				"w5.cve_prov_pago k_clave, coalesce(d.c3, coalesce(d2.c3,'No Existe ...')  ) k_nombreprov, coalesce(w5.cta_deposito,'') c_cuenta, " &				"coalesce(w1.uuid_serie,'') c_serie, coalesce(w1.uuid_folio, '') c_folio, " &				"abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) saldo, to_date( coalesce(g.c12::text , current_date::text) ,'yyy-mm-dd') vencimiento, " &				"coalesce(w5.c14, coalesce(w1.c11,'') ) k_factura, w1.concepto_factura as concepto_factura, " & 				"w5.c12 k_monto_factura, w5.c13 k_iva_factura, " & 				"w5.retiva k_iva_ret, w5.retisr k_isr_ret, w5.trasieps k_ieps_tras, w5.otroimptoa k_imptoadica, w5.otroimptob k_imptoadicb, " &				"'' k_factura_rfc, w5.cve_prov_oper k_prov " &				"from keplersc.kdm5 w5 " & 				"left join keplersc.kduxg g on g.c1 = w5.c1 and g.c2 = w5.c2 and (g.c4 = w5.c14 or g.doc_refer_compl = w5.c14) " &				"and w5.cve_prov_oper = g.c3 and w5.cve_prov_pago = g.cve_prov_pago " & 				"left join keplersc.kduxe e on e.c1 = g.c1 and e.c2 = g.c3 and e.c3 = g.c4 and e.c5 = g.c2 and e.c6 = 'A' and e.c11 = g.c11 " &				"and ( e.c13 > 0 /*or monto_rollback = 0*/ )" &  				"left join keplersc.kdm1 w1 on w1.c1 = w5.c1 and w1.c2 = w5.c2 and w1.c3 = 'A' and w1.c4 = e.c7 and w1.c5 = e.c8 and (w1.c11 = w5.c14 or w1.doc_refer_compl = w5.c14) /*and w1.c43 <> 'C'*//*Added 20240515 Commented 20240520*/ " &				"and w1.c10 = w5.cve_prov_oper and w1.cve_prov_pago = w5.cve_prov_pago " & 				"and w1.c6 = e.c9 " &				"left join keplersc.kdxd d on d.c2 = w5.cve_prov_pago " &  				"left join keplersc.kdxd d2 on d2.c2 = '" & prov_hist & "' " &				"where w5.c1='" & sucursal_id & "' and w5.c2='" & gen_doc &"' and w5.c3='" & nat_doc & "' and w5.c4=" & gpo_doc & " " & 				"and w5.c5=" & tip_doc & " and w5.c6='" & nFolio & "' ";						//Added by JMM 20240419 			cmd = cmd & " and length(coalesce(w5.st_x_comprobar,'')) = 0 ";						frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\Query_MostrarDatos");						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_transfer_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_MostrarDatos");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}						frn.setX(cuboResultados, "k_mov");			//Ctas en kdm6/*						cmd = "select " &  				"w6.c8 k_cuenta, w6.c9 k_cuentadesc, case when w6.c10='C' then w6.c11 else 0 end as k_cargo, " &				"case when w6.c10='A' then w6.c11 else 0 end as k_abono " &				"from keplersc.kdm6 w6 " & 				"where w6.c1='" & sucursal_id & "' and w6.c2='" & gen_doc &"' and w6.c3='" & nat_doc & "' and w6.c4=" & gpo_doc & " " & 				"and w6.c5=" & tip_doc & " and w6.c6='" & nFolio & "' ";*/						cmd = "select c8,c9,c10,c11,c13 ,c12 ,ctopto,referencia from keplersc.kdm6 where c1='" & sucursal_id & "' and c2='" & gen_doc &"' and c3='" & nat_doc & "'";			cmd = cmd & " and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";									frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\Query_MostrarDatosM6");						rstXml(cuboResultados);			cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_transfer_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_MostrarDatosM6");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			totRen = nXml(cuboResultados);										for(contRen=0; contRen<totRen; contRen++){				frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c8"),"k_mov_ctas",contRen,"k_cuenta");				frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c9"),"k_mov_ctas",contRen,"k_cuentadesc");				var cargo_abono = getXmlAtt(cuboResultados, "r"&contRen ,"c10");				var monto = getXmlAtt(cuboResultados, "r"&contRen ,"c11");								if (cargo_abono &= "C"){					frn.setX(monto ,"k_mov_ctas",contRen,"k_cargo");				}else{					frn.setX(monto ,"k_mov_ctas",contRen,"k_abono");				}								frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c13"),"k_mov_ctas",contRen,"k_inventario");								frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"c12"),"k_mov_ctas",contRen,"k_afecta"); // Added by JMM 20240308 								frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"ctopto"),"k_mov_ctas",contRen,"k_ctopto"); // Added by JMM 20240717				frn.setX(getXmlAtt(cuboResultados, "r"&contRen ,"referencia"),"k_mov_ctas",contRen,"k_referencia_uuid"); 			}						//			frn.setX(cuboResultados, "k_mov_ctas");						CalcTotal();						ArmarRefDocto();										} //End MostrarDatos()						/*Added by MSS Integration 20240520*/		fun polOrigen(cmd){			var cuboResultados,ok,mensaje,nPolOrigen;						//Commented by JMM 20240605, for New Print Fto			/*frn.set("chk_validado", "0");*/												cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_transfer_crud.EjecReporte()");			frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdNumPoliza");			frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboNumPoliza");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}							nPolOrigen =getXmlAtt(cuboResultados,"r0", "num_pol" );			return nPolOrigen; 		}				//-----------------REPORTE-----------							// ----------------------------------------------	 START : NEW FUNCTIONS IMPLEMENTED BY JMM 20240605  --------------------------------------------				// ZONA	CODIGO REPORTE(S) 						fun IniParams(){//Inicializa parámetros de impresión. Pueden ser cambiados por el usuario final mediante menú: Archivo -> Configurar Página				frn.set("param_paper","letter");	//Tamaño de papel predefinido:	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tamaño de papel personalizado	"size=21.59,27.94cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//Márgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0");	//Escala de impresión (1=100 por ciento)	"F=1,1"				frn.set("param_landscape","Y");	//Orientación	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"				frn.set("param_emp","L");	//Posición de "Razón social"(izq,der,cen)	@emp=L|R|C"			}						fun setRepPage() {//Establece los parámetros finales de impresión.				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Ejecuta_Reporte() {							// Commented 20221208 				//IniParams(); //Inicializa parámtros de impresión entre otros							Reporte();						} /* END Func Ejecuta_Reporte() */						fun Reporte() {							// Our Vars				var compania, titrep, titrepaux;				//var contProd, contDet, tmpStr ,xmlDet, xmlCurDocto;				var nFolio;				//var p_fecha, var_fecha;				//var p_subtotal, p_utilidad, p_perce, p_costo, p_total, p_iva;				//var gt_subtotal, gt_utilidad, gt_perce, gt_costo, gt_total, gt_iva;								if( strlen(trim(frn.get("k_folio")))==0 || strlen(trim(frn.get("k_fecha")))==0 ){ 					frn.message("Es necesario seleccionar un documento valido a consultar ...","Error","&Aceptar");					frn.setPos("k_folio");					return;				}								//Obtener datos generales				kdb.kde("KDE");//Configuracion del servidor				kdb.exec();				compania = kdb.get("KDE","1");									// Se define el formato a usar y se liga a la variable del reporte "rep"	// Se define el formato a usar y se liga a la variable del reporte "rep"				rep.rst(); // 20121208				IniParams(); // 20121208				kdb.readPage("datFto","srv_transfer_doc_fto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				//rep.rst(); // 20121208				setRepPage();//Establece los parámetros finales de impresión(rep.page(...);), pues pueden haber cambiado por el usuario 				//Da valor a los inputs del reporte(rep.set();), e indica la ejecución de "grupos de renglones de impresión" (rep.exe();)								titrepaux = frn.get("k_tipon", -1, 0);				titrep = "TRANSFERENCIAS INTERBANCARIAS  -  ";				//rep.set("leyendatx", "Folio Transaccion " & frn.get("k_folio"));				rep.set("fechoper","[ Datos Transaccion ]     Folio  " & frn.get("k_folio") & "   ,   Fecha  " & frn.get("k_fecha"));				if( strlen(trim(frn.get("c_fecha"))) > 0 ){ 					rep.set("validatx","[ Datos Validacion ]     Usuario  " & frn.get("c_usr") & "   ,   Fecha  " & frn.get("c_fecha"));				}								rep.set("fecha",sys.date());				rep.set("hora",sys.time());				rep.set("nombreempresa",compania);				rep.set("tituloreporte",titrep & titrepaux);								//To check if it will be included on this option ... checked with VCSS				rep.set("pasotx", "Paso?");					rep.exe("encabezado");												sucursal_id = frn.get("k_sucn",-1,1);				nFolio = frn.get("k_folio");								cmdQuery = "select " &  				"w5.cve_prov_pago k_clave, coalesce(d.c3, coalesce(d2.c3,'No Existe ...')  ) k_nombreprov, coalesce(w5.cta_deposito,'') c_cuenta, " &				"coalesce(w1.uuid_serie,'') c_serie, coalesce(w1.uuid_folio, '') c_folio, " &				"abs( ( coalesce(g.c6,0) - coalesce(g.c7,0) ) ) saldo, to_date( coalesce(g.c12::text , current_date::text) ,'yyy-mm-dd') vencimiento, " &				"/*coalesce(w1.c11,w5.c14) UPD by JMM 20240724*/ coalesce(w5.c14, coalesce(w1.c11,'') ) k_factura, " & 				"w5.c12 k_monto_factura, w5.c13 k_iva_factura, '' k_factura_rfc, w5.cve_prov_oper k_prov " &				", coalesce(w5.st_x_comprobar,'') paso /*added by JMM 20240605*/ " & 				"from keplersc.kdm5 w5 " &				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kduxg g on g.c1 = w5.c1 and g.c2 = w5.c2 and (g.c4 = w5.c14 or g.doc_refer_compl = w5.c14) " &				"/*line added by JMM 20240520*/ and w5.cve_prov_oper = g.c3 and w5.cve_prov_pago = g.cve_prov_pago " &				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kduxe e on e.c1 = g.c1 and e.c2 = g.c3 and e.c3 = g.c4 and e.c5 = g.c2 and e.c6 = 'A' and e.c11 = g.c11 " & 				"/*Added by JMM 20240725*/ and ( e.c13 > 0 /*or monto_rollback = 0*/ )" &  				"/*inner ... UPD 20240729 by JMM*/ left join keplersc.kdm1 w1 on w1.c1 = w5.c1 and w1.c2 = w5.c2 and w1.c3 = 'A' and w1.c4 = e.c7 and w1.c5 = e.c8 and (w1.c11 = w5.c14 or w1.doc_refer_compl = w5.c14) /*and w1.c43 <> 'C'*//*Added 20240515 Commented 20240520*/ " &				"/*line added by JMM 20240520*/ and w1.c10 = w5.cve_prov_oper and w1.cve_prov_pago = w5.cve_prov_pago " & 				" /*Added by JMM 20240724*/ and w1.c6 = e.c9 " & 				"left join keplersc.kdxd d on /*d.c1 = w5.c1 and*/ d.c2 = w5.cve_prov_pago " &  				"left join keplersc.kdxd d2 on /*d2.c1 = ' sucursal_id ' and*/ d2.c2 = w1.c10 " & /* '" & prov_hist & "' */				"where w5.c1='" & sucursal_id & "' and w5.c2='" & gen_doc &"' and w5.c3='" & nat_doc & "' and w5.c4=" & gpo_doc & " " & 				"and w5.c5=" & tip_doc & " and w5.c6='" & nFolio & "' ";								//To check if it will be included on this option ... checked with VCSS				//cmdQuery = cmdQuery & " and length(coalesce(w5.st_x_comprobar,'')) = 0 ";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_transfer_crud()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\srv_transfer_crud_rpt");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									for(var x=0; x < nXml(cuboQuery); x++)				{						rep.set("provpago",getXmlAtt(cuboQuery,"r"&x,"k_clave"));					rep.set("nombre", getXmlAtt(cuboQuery,"r"&x,"k_nombreprov"));					rep.set("fact", getXmlAtt(cuboQuery,"r"&x,"k_factura"));					rep.set("ctadep", getXmlAtt(cuboQuery,"r"&x,"c_cuenta")); 					rep.set("monto",getXmlAtt(cuboQuery,"r"&x,"k_monto_factura"));					rep.set("iva", getXmlAtt(cuboQuery,"r"&x,"k_iva_factura"));					rep.set("provoper", getXmlAtt(cuboQuery,"r"&x,"k_prov"));										//To check if it will be included on this option ... checked with VCSS					rep.set("paso", getXmlAtt(cuboQuery,"r"&x,"paso"));																		rep.exe("detalle");				}								if (nXml(cuboQuery) > 0) { 									rep.exe("linea_t1"); 										rep.set("tsubt", frn.get("k_subtotal"));					rep.set("tiva", frn.get("k_iva"));					rep.set("ttot", frn.get("k_monto"));					rep.set("ttottx", strFormat("number",frn.get("k_monto"),0) );					rep.exe("total");										rep.exe("linea_t2");										rep.set("ref", frn.get("k_refer"));					rep.set("comment", frn.get("k_coment"));					rep.exe("comentarios");									}													//Modos de impresión 				rep.win(); //Muestra la vista previa de la impresión. A partir de la vista previa (Preprint) se decide si se imprime o no.				//rep.print("\\192.168.1.100\HPLaserJet"); //Envía el reporte directamente a una impresora, sin mostrar la vista previa.				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresión. No muestra la vista previa.				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardará el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html										} /* END Func Reporte() */									// END : ZONA	CODIGO REPORTE(S)						// ----------------------------------------------	 END : NEW FUNCTIONS IMPLEMENTED BY JMM 20240605  --------------------------------------------							//Commented by JMM 20240605, for New Print Fto ... old functions related to printing rpt --> Poliza, were commented			/*			fun EjecReporte(){								var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var cuboResultados, xmlRequest,sqlXmlResultados,xmlCurDocto,xmlCurMovto,cmd,ok,mensaje;								// Added by JMM 20240520 ... c_fecha validation				if( strlen(trim(frn.get("k_folio")))==0 || strlen(trim(frn.get("k_fecha")))==0 ){ 					frn.message("Es necesario registrar un documento valido a consultar ...","Error","&Aceptar");					frn.setPos("k_folio");					return;				}								kdb.kde("KDE");//Configuraciï¿½n del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();				kdb.readPage("datos","srv_transfer_crudfto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parï¿½metros finales de impresiï¿½n.(rep.page(...);)				rep.set("suc_desc", frn.get("k_sucn", -1, 0));				rep.set("docto",frn.get("k_docto"));				rep.set("fecha",frn.get("k_fecha"));				rep.set("rep_fecha",fechaImpresion);				rep.set("rep_hora",horaImpresion);								rep.set("referencia",frn.get("k_refer"));				rep.set("k_monto",frn.get("k_monto"));								//TODO				rep.set("cantidad_en_letra",strFormat("number",frn.get("k_monto"),0));				rep.exe("encabezado");				rep.exe("tit_reporte");				rep.exe("encabezadoColumnas");				rep.exe("linea_encabezados");				//Procesa poliza contable				var tablakdc1_alta = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;				var tablakdc2_alta = " keplersc.kdc2" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) & strSplit(frn.get("k_fecha"), "-", 1);				//Tablas de validacion				var tablakdc1_baja = " keplersc.kdc1" & mid(strSplit(frn.get("c_fecha"), "-", 0), 2,2) ;				var tablakdc2_baja = " keplersc.kdc2" & mid(strSplit(frn.get("c_fecha"), "-", 0), 2,2) & strSplit(frn.get("c_fecha"), "-", 1);				var tipo = ""; var nPolAlta = "" ;								//MSS reporte				var st_validado, cmdbis;				st_validado=frn.get("chk_validado");				if (st_validado &="0"){					//Obtiene num poliza					cmd= " select c1 as num_pol from " & tablakdc2_alta & " where c14='" & sucursal_id  & "' and c15='" & gen_doc & "' and c16= '" & nat_doc & "'" ;					cmd = cmd & " and c17='" & gpo_doc & "' and c18='" & tip_doc & "' and c19='" & frn.get("k_folio")& "'";					cmd = cmd & " order by c1 limit 1";										cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud_unified.EjecReporte()");					frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdNumPoliza");					frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboNumPoliza");									ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}									nPolAlta =getXmlAtt(cuboResultados,"r0", "num_pol" );										imprime_poliza(tablakdc1_alta , tablakdc2_alta, "Alta", tipo, nPolAlta);				}				if (st_validado &="1"){					if (frn.get("c_fecha") &! "1800-01-01" && frn.get("c_fecha") &! "" ){						//Obtiene poliza validada						cmd= " select c1 as num_pol from " & tablakdc2_baja & " where c14='" & sucursal_id  & "' and c15='" & gen_doc & "' and c16= '" & nat_doc & "'" ;						cmd = cmd & " and c17='" & gpo_doc & "' and c18='" & tip_doc & "' and c19='" & frn.get("k_folio")& "' and c2='" & frn.get("c_fecha") & "'";						cmd = cmd & " order by c1 desc limit 1";													cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.GenerarReporte()");						frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdNumPoliza");						frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboNumPolCanc");										ok=getXmlAtt(cuboResultados,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cuboResultados,"native3");							frn.message(mensajeError,"Error","Aceptar");							return;						}										nPolAlta =getXmlAtt(cuboResultados,"r0", "num_pol" );												imprime_poliza(tablakdc1_baja , tablakdc2_baja, "Baja", tipo, nPolAlta);					}else {						//Si no hay poliza movto validado envia poliza origen						cmd= " select c1 as num_pol from " & tablakdc2_alta & " where c14='" & sucursal_id  & "' and c15='" & gen_doc & "' and c16= '" & nat_doc & "'" ;						cmd = cmd & " and c17='" & gpo_doc & "' and c18='" & tip_doc & "' and c19='" & frn.get("k_folio")& "'";						cmd = cmd & " order by c1 limit 1";						nPolAlta = polOrigen(cmd);						imprime_poliza(tablakdc1_alta , tablakdc2_alta, "Alta", tipo, nPolAlta);					}				}				rep.set("desc_notas",frn.get("k_coment"));				rep.exe("notastitulos");				rep.exe("extras");				rep.win();									}								fun imprime_poliza(tablakdc1 , tablakdc2, operacion, tipo, nPolAlta ){							var cmd, cuboResultados , ok;								//Procesa poliza contable				cmd= " select kc2.c1 as num_pol, kc2.c3 as cuenta, kc2.c4 as tipo_asiento, kc2.c5 as monto, kc1.c2 as desc_pol, kc2.c7 as refer, kc2.c8 as tipo_pol from " & tablakdc2 & " as kc2 " ;				cmd = cmd & " inner join " & tablakdc1 & " as kc1 on kc1.c1=kc2.c3 ";				cmd = cmd & " where kc2.c14='" & frn.get("k_sucn", -1, 1) & "' and kc2.c15='" & gen_doc & "' and kc2.c16= '" & nat_doc & "' and kc2.c17='" & gpo_doc & "' and kc2.c18='" & tip_doc & "' and kc2.c19='" & frn.get("k_folio")& "'";				cmd = cmd & " and kc2.c1 = " & nPolAlta ;  				//Added by JMM 20240325				cmd = cmd & " order by kc2.c1, kc2.c10 "; 				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.imprime_poliza()");				frn.lib("libGeneral.kpl","FileSave",cmd ,"c:\Basura\cuboResPoliza");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var nRenPol= nXml(cuboResultados);				var tPoliza=getXmlAtt(cuboResultados,"r0", "tipo_pol" );				var nPoliza=getXmlAtt(cuboResultados,"r0", "num_pol" );								if (strlen(tPoliza)>0 && strlen(nPoliza)>0 ){						rep.set("tPol",tPoliza);						rep.set("nPol",nPoliza);						rep.exe("encabezadoPol");						var tAbonosPol=0, tCargosPol=0;						for(var i=0;i<nRenPol;i++){							if (getXmlAtt(cuboResultados,"r"&i, "tipo_asiento" )&= "A"){								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave2",cuenta );								rep.set("PolDescr2",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolHaber",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tAbonosPol=tAbonosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								pol_saldo_presupuesto(cuenta);								rep.set("PolSaldo2",saldo);								rep.set("PolPresupuesto2",presupuesto );								rep.exe("partPolA");							}else{								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave",cuenta );								rep.set("PolDescr",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolDebe",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tCargosPol=tCargosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								pol_saldo_presupuesto(cuenta);								rep.set("PolSaldo",saldo );								rep.set("PolPresupuesto",presupuesto );								rep.exe("partPolC");							}						}						rep.set("totCargo",tCargosPol);						rep.set("totAbono",tAbonosPol);						rep.exe("PolTotales");				}			}						fun pol_saldo_presupuesto(cuenta){						var cmd, cuboResultados , ok, mensajeError  ;								var mes = strSplit(frn.get("k_fecha"), "-", 1);				tabla = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2);								var col_cargos = 26 + mes;				var col_abonos = 62 + mes;				var col_presupuesto= 38 + mes;				 				cmd= " select c" & col_cargos & " as cargos ,c" & col_abonos & " as abonos ,c" & col_presupuesto & " as pres from " & tabla & " where c1='" & cuenta & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_transfer_crud.pol_saldo_presupuesto()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				var cargos = getXmlAtt(cuboResultados,"r0", "cargos" );				var abonos = getXmlAtt(cuboResultados,"r0", "abonos" );				presupuesto = getXmlAtt(cuboResultados,"r0", "pres" );				saldo = cargos - abonos;			}					*/					fun Formar_folio(){							var xmlReqEst, cubofol, cmd, ok, mensajeError;								// Added by JMM, 20240925				sucursal_id = frn.get("k_sucn",-1,1);				setXml(xmlReqEst,"document","sucursal_id",sucursal_id);								setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);								//Added by JMM, 20240205 				borrar_datos();				LimpiaEncabezado(1);							} // End : Formar_folio()					fun SelMultiXML(){				var pathCompleto, rutaCarpeta, listadoArchivos, totalArchivos;				var nombreArchivo, extension, ok, mensajeError, cmdList, query, proveedor, uuid;								pathCompleto = frn.openFile("", "Archivos XML,*.xml", sys.path(), "Selecciona cualquier archivo XML de la carpeta objetivo");								if (strlen(pathCompleto) == 0) {					return;				}								var totalBloques = strSplit(pathCompleto, "\\", -1);				var indiceUltimo = totalBloques - 1;				var nombreArchivoFinal = strSplit(pathCompleto, "\\", indiceUltimo);								rutaCarpeta = mid(pathCompleto, 0, strlen(pathCompleto) - strlen(nombreArchivoFinal));								cmdList = "dat,list,_" & rutaCarpeta & "*.xml";								rstXml(listadoArchivos);				kdb.file(cmdList); 				kdb.exec(); 								listadoArchivos = getXml(kdb.get("dat"));								ok = getXmlAtt(listadoArchivos, "ok");				if (ok &! "" && !ok) {					mensajeError = getXmlAtt(listadoArchivos, "native3");					frn.message("Error al leer el directorio: " & mensajeError, "Error", "Aceptar");					return;				}								totalArchivos = nXml(listadoArchivos);								if (totalArchivos == 0) {					frn.message("No se encontraron registros XML para procesar.", "Aviso", "Aceptar");					return;				}								var huboError, mensajeValidacion;				huboError = 0;				mensajeValidacion = "";								borrar_datos();								for (var j = 0; j < totalArchivos; j++) {					nombreArchivo = getXml(listadoArchivos, "r" & j);					if (nombreArchivo &= "") {						continue;					}										var rutaArchivoIndividual = rutaCarpeta & nombreArchivo;										var cuboContenidoXML, totalLineasXML;					var rfcEncontrado = "";					var uuidXml = "";										rstXml(cuboContenidoXML);					kdb.file("dat,read,_" & rutaArchivoIndividual);					kdb.exec();										cuboContenidoXML = getXml(kdb.get("dat"));					totalLineasXML = nXml(cuboContenidoXML);										for (var k = 0; k < totalLineasXML; k++) {						var lineaTexto = getXml(cuboContenidoXML, "r" & k);												if (strSplit(lineaTexto, "Emisor", -1) > 1) {							var parteRfc = strSplit(lineaTexto, "Rfc=\"", 1);							if (parteRfc &= "") { parteRfc = strSplit(lineaTexto, "rfc=\"", 1); }							rfcEncontrado = trim(strSplit(parteRfc, "\"", 0));						}												if (strSplit(lineaTexto, "TimbreFiscalDigital", -1) > 1) {							var parteUuid = strSplit(lineaTexto, "UUID=\"", 1);							if (parteUuid &= "") { parteUuid = strSplit(lineaTexto, "uuid=\"", 1); }							uuidXml = trim(strSplit(parteUuid, "\"", 0));						}					}										if (rfcEncontrado &= "" || uuidXml &= "") {						huboError = 1;						mensajeValidacion = "El archivo XML no cuenta con una estructura CFDI estandar o carece de Timbre Fiscal Digital.";						break; 					}										var cuboProv, queryProv, cveProveedor = "", nombreProveedor = "", ctaDeposito = "";					queryProv = "SELECT c2 as cve, c3 as nom, ctadep FROM keplersc.kdxd WHERE c10 = '" & rfcEncontrado & "' LIMIT 1";					rstXml(cuboProv);					cuboProv = frn.lib("libGeneral.kpl", "EjecutarSqlSel", queryProv, "srv_transfer_crud.SelMultiXML()");										if (nXml(cuboProv) > 0) {						cveProveedor = getXmlAtt(cuboProv, "r0", "cve");						nombreProveedor = getXmlAtt(cuboProv, "r0", "nom");						ctaDeposito = getXmlAtt(cuboProv, "r0", "ctadep");					} else {						huboError = 1;						mensajeValidacion = "El RFC del Emisor [" & rfcEncontrado & "] no esta registrado en el Catalogo de Proveedores del sistema.";						break;					}										var cuboCxP, queryCxP;					sucursal_id = frn.get("k_sucn", -1, 1);					queryCxP = "SELECT count(*) as existe FROM keplersc.kduxg WHERE c1 = '" & sucursal_id & "' and c2 = 'X' and c4 = '" & uuidXml & "' and c3 = '" & cveProveedor & "'";					rstXml(cuboCxP);					cuboCxP = frn.lib("libGeneral.kpl", "EjecutarSqlSel", queryCxP, "srv_transfer_crud.ValidaExisteCxP");										if (getXmlAtt(cuboCxP, "r0", "existe") == 0) {						huboError = 1;						mensajeValidacion = "La factura con UUID [" & uuidXml & "] no cuenta con un contrarrecibo registrado. Necesario registrar el contrarrecibo antes de procesar la factura.";						break;					}										var renGrid = frn.N("k_mov") - 1;										frn.setX(cveProveedor, "k_mov", renGrid, "k_clave");					frn.setX(nombreProveedor, "k_mov", renGrid, "k_nombreprov");					frn.setX(ctaDeposito, "k_mov", renGrid, "c_cuenta");					frn.setX(uuidXml, "k_mov", renGrid, "k_factura");										frn.setPos("k_mov", renGrid);										ObtenerFactura();				}								if (huboError &= 1) {					borrar_datos();										var cadenaMensaje;					cadenaMensaje = "Error de Procesamiento Masivo" & "|";					cadenaMensaje = cadenaMensaje & "=========================================" & "|";					cadenaMensaje = cadenaMensaje & "Archivo con conflicto: " & nombreArchivo & "|";					cadenaMensaje = cadenaMensaje & "Causa: " & mensajeValidacion & "|";					cadenaMensaje = cadenaMensaje & "=========================================" & "|";					cadenaMensaje = cadenaMensaje & "Para poder procesar la carga por lotes, es necesario que todos los" & "|";					cadenaMensaje = cadenaMensaje & "archivos dentro de la carpeta est?n completamente estandarizados" & "|";					cadenaMensaje = cadenaMensaje & "y dados de alta previamente en el sistema.";										frn.message(cadenaMensaje, "Carga Interrumpida", "Aceptar");					return;				}								CargarCuentasConcepto();				CalcTotal();						}								//Commented by JMM 20240605, for New Print Fto			/*			fun IniParams(){//Inicializa parï¿½metros de impresiï¿½n, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Pï¿½gina				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}			fun setRepPage() {//Establece los parï¿½metros finales de impresiï¿½n.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}			*/				} // End of class Main	</script></pag>