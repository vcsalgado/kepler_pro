<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<grp id="grupo_crud" dim="50,23,20,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18"><tab/>			<br/><br/>			<tab/><txt id="text_id">Marca:</txt><tab n="2"/>			<inp id="input_marca" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" available="N"/><br/><tab/>						<txt id="text_id">Modelo:</txt><tab n="1"/>			<inp id="input_modelo" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" available="N"/><br/><tab/>						<txt id="text_id">Clave:</txt><tab n="2"/>			<inp id="input_clave" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" nc="10" clrBrdr="255,255,255" available="N"/><br/><tab/>						<txt>Descripcion:</txt><tab n="1"/>			<inp id="input_desc" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt>Horas:</txt><tab n="2"/>			<inp id="input_horas" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nd="6"  clrBrdr="255,255,255"/><br/><tab/>					<br/>			<tab n="5"/><bot id="btn_aceptar" dim="5,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="0" visible="Y" available="Y"/><br/>						<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>									</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP, accion,externo,clave_tab,cli, marca,modelo, serie   ;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();							ctlrs_off();				insertar_datos();											}						fun ctlrs_off(){							accion = frn.param(0);				frn.set("input_crud", accion);				frn.rst("grupo_crud");				externo	= frn.param(4);				frn.setAtt("grupo_crud", "tit", accion );				marca = frn.param(2);				modelo = frn.param(3);				frn.set("input_marca", marca );				frn.set("input_modelo", modelo );							frn.setAtt("input_clave", "available", "N" );				frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );								if (accion &= "Nuevo"){					frn.setAtt("input_clave", "available", "Y" );								}								if (accion &! "Consultar"){					frn.setAtt("btn_aceptar", "available", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );				}						}							fun insertar_datos(){							var xmlRequest,cmd,ok, cuboResultados;								if (accion &= "Modificar"){									//llamada externa(padre)					if (externo &= "s"){											clave_tab =frn.param(1);						if (clave_tab &= ""){													frn.message("selecciona una clave con F9 para modificar","Error","Aceptar");							frn.setAtt("btn_aceptar", "visible", "N" );							return;						}											}else {											clave_tab = frn.param(1);					}				}										if (accion &! "Nuevo") {									if (accion &= "Eliminar" || accion &= "Consultar" ){						clave_tab= frn.param(1);					}										cmd="select c3,c4,c5 from keplersc.kdtab where c1 ='" & marca & "' and c2='"  &  modelo & "' and c3='" & clave_tab & "'"; 									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_tab_crud.insertar_datos()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}											frn.set("input_clave",getXmlAtt(cuboResultados,"r"&0,"c3"));					frn.set("input_desc",getXmlAtt(cuboResultados,"r"&0,"c4"));					frn.set("input_horas",getXmlAtt(cuboResultados,"r"&0,"c5"));					}			}								fun Execute() {						var xmlRequest,cmd,cuboResultados,ok,cmd,cubo, mensajeError ;								var resultado_confirmacion = frn.message("�Estas seguro?","Mensaje de Confirmacion", 2);									if (resultado_confirmacion &! 1)  {					return;				}																	xmlRequest = getXml(frn.dataPag()); 							frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmd="SELECT * FROM keplersc.tab_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";					cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"cat_tab_crud.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");													var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;						}												if (accion &= "Nuevo" || accion &= "Modificar") {									serie = frn.get("input_serie");										var clave_nueva= frn.get("input_clave");					var desc_nueva = frn.get("input_desc");					var horas_nueva = frn.get("input_horas");														if (externo &= "n"){											frP.setX(clave_nueva,"tabla",-1,"clave"); 						frP.scriptElm("tabla","OnChange","clave");												frP.setX(desc_nueva ,"tabla",-1,"desc"); 						frP.scriptElm("tabla","OnChange","desc");													frP.setX(horas_nueva ,"tabla",-1,"horas"); 						frP.scriptElm("tabla","OnChange","horas");																	}else {									frP.setX(clave_nueva ,"tabla_horas",-1,"clave_horas"); 						frP.scriptElm("tabla_horas","OnChange","clave_horas");									}										var sms =  "";										if (accion &= "Nuevo"){						sms = "Registro guardado";					}else {						sms = "Registro modificado";					}											frn.message(sms ,"Mensaje","Aceptar");					frn.exit();										}								if (accion &= "Eliminar"){						frP.setX("","tabla",-1,"clave"); 					frP.scriptElm("tabla","OnChange","clave");											frP.setX("","tabla",-1,"desc"); 					frP.scriptElm("tabla","OnChange","desc");												frP.setX("","tabla",-1,"horas"); 					frP.scriptElm("tabla","OnChange","horas");									frn.message("Registro eliminado","Mensaje","Aceptar");					frn.exit();									}						}													}	</script></pag>