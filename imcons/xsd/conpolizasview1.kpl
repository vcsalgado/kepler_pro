				dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" available="Y"  OnChange="cargarPolizas()"/>
			<sp/>
				<inp id="rango_ini" dim="13,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 
					type="string" modify="N" available="N" fnt="Arial,16"/>
			<sp/>
				<inp id="k_rango_ini" dim="4,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 
					type="capital" modify="Y" available="Y" fnt="Arial,16"  OnChange="cargarPolizas()" nc="5"/>
						<tab/>
				<inp id="rango_fin" dim="13,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 
					type="string" modify="N" available="N" fnt="Arial,16"/>
			<sp/>
				<inp id="k_rango_fin" dim="4,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 
					type="capital" modify="Y" available="Y" fnt="Arial,16"  OnChange="cargarPolizas()" nc="5"/>
			<br/>

            <tab/>
				<inp id="tipo" dim="5,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 
					type="string" modify="N" available="N" fnt="Arial,16"/>
			<tab/>
				<cmb id="k_tipo" clr="64,64,64" clrBrdr="192,205,213"  
					dim="4,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" available="Y"  OnChange="cargarPolizas()"/>
			<sp/>
				<inp id="k_descrip_tipo" dim="20,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213" 
					type="string" modify="N" available="N" fnt="Arial,16"/>
