			<sp/>
				<inp id="k_folio" dim="12,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 
					type="capital" modify="Y" available="Y" fnt="Arial,16"  OnChange="cargarPolizas()" nc="12"/>
            <tab/>
				<inp id="fecha" dim="5,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 
					type="string" modify="N" available="N" fnt="Arial,16"/>
            <sp/>
				<edt id="k_fecha" dim="12,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" OnChange="cargarPolizas()"
					type="date" modify="Y" available="Y" fnt="Arial,16" OnF9="Dialog(3,_ks_fecha,fecha_captura)" page="_ks_fecha,fecha_captura" fmt="DD/MM/CCYY" nc="-1"/>
            <br/>
            <tab/>
				<inp id="referencia" dim="8,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 
					type="string" modify="N" available="N" fnt="Arial,16"/>
			<sp/>
				<inp id="k_refer" dim="60,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 
					type="capital" modify="Y" available="Y" fnt="Arial,16" OnChange="cargarPolizas()" nc="60"/>
            <br/>
            <tab n="2"/>
		<tbl id="tabla" clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" brdr="1,0" id="results" dim="70,18" 
			modify="N" nren="fijo" Reorder="Y">
			<col name="No. Poliza" id="t_n_poliza" type="text" nc="5" visible="Y"/>
			<col name="Tipo" id="t_tipo" type="text" nc="2" visible="Y"/>
			<col name="Fecha" id="t_fecha" type="date" nc="-1" fmt="DD/MM/CCYY" visible="Y"/>
			<col name="Folio" id="t_folio" type="text" nc="10" visible="Y"/>
			<col name="Referencia" id="t_referencia" type="string" nc="-1" visible="Y"/>
			<col name="Abonos" id="t_abonos" type="number" nc="-1" visible="Y" nd="2"/>
			<col name="Cargos" id="t_cargos" type="number" nc="-1" visible="Y" nd="2"/>
			<col name="Diferencia" id="t_diferencia" type="number" nc="-1" visible="Y" nd="2"/>
			<col id="genero" name="Gen" type="string" visible="Y"/>
			<col id="naturaleza" name="Nat" type="string" visible="Y"/>
			<col id="grupo" name="Gpo" type="string" visible="Y"/>
			<col id="tipo" name="Tipo" type="string" visible="Y"/>
			
		</tbl>
		<tab n="2"/>
		<br/>
		<tab n="2"/>
		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Seleccionar" hk="K" default="1" step="0"  OnEnter="abrir_poliza()" fnt="Arial,16"/> <br/>
		</grp>
</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;
			var tipoOper,consPlantilla; //Variables relacionadas con parametros (colsulta , eliminar, baja)
			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna; 
			fun Main(){
				frn=new FRNT;
				kdb=new KDB;
				frP=new FRNTP;
				sys=new SYS;
				kdb.connect();
				
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				perfil_usuario = frn.lib("libKepler","UserInfo(2)");
				rol_usuario = frn.config("user","role");
				asterisco = "*";
				
				ConfiguraUI();
				
				Inicializa();
			
			}
        
		fun cargarPolizas(){
			var queryTablas, cubo_lista_tablas, ok, mensajeError;
			queryTablas = "SELECT table_schema, table_name FROM INFORMATION_SCHEMA.TABLES 
								WHERE TABLE_NAME LIKE 'kdc22%'
								order by table_name";
				cubo_lista_tablas= frn.lib("libGeneral.kpl","EjecutarSqlSel",queryTablas,"conpolizasView.cargarpolizas()");
				ok=getXmlAtt(cubo_lista_tablas,"ok");
				if(ok &! "" && !ok){
						mensajeError = getXmlAtt(cuboXml,"native3");
						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
						frn.message(mensajeError,"Error","Aceptar");
						return;
				}	
//			frn.lib("libGeneral.kpl","FileSave",cubo_lista_tablas,"C:\Basura\cubo_lista_tablas");
			var anio =mid(frn.get("k_anio"),2,2);
			var k_tabla= "keplersc.kdc2"& anio & frn.get("k_mes");

			var k_rango_ini = frn.get("k_rango_ini");
			if (k_rango_ini &= ""){
				k_rango_ini = "0";
			}
			var k_rango_fin = frn.get("k_rango_fin");
			if (k_rango_fin &=""){
				k_rango_fin = "(select count(*) from " &k_tabla &")";
			}
			var k_suc = frn.get("k_suc",-1,1);

			var k_tipo = frn.get("k_tipo");

			var k_folio = frn.get("k_folio");
			if (k_folio &=""){
				k_folio = "%%";
			}
			else{
				k_folio = "%" & k_folio & "%";
			}

			var k_refer = frn.get("k_refer");
			if (k_refer &=""){
				k_refer = "%%";
			}
			else{
				k_refer = "%" & k_refer & "%";
			}

			var k_fecha = frn.get("k_fecha");
			if (k_fecha &=""){
				k_fecha = ">(SELECT TO_TIMESTAMP('2000-01-01 05:00:01','YYYY-MM-DD HH:MI:SS'))";
			}
			else{
				k_fecha = "=" & "(SELECT TO_TIMESTAMP('"&k_fecha&"','YYYY-MM-DD HH:MI:SS'))";
			}

			var cmdQuery ="select n_poliza as t_n_poliza, tipo_l as t_tipo, fecha as t_fecha,folio as t_folio , referencia as t_referencia, 
					coalesce (sum(abono_total),0) as t_abonos ,coalesce (sum(cargo_total),0) as t_cargos,
					coalesce (sum(sel.cargo_total)-sum(sel.abono_total),0) as t_diferencia,genero,naturaleza,grupo,tipo
					from(select c1 as n_poliza, c8 as tipo_l,c2 as fecha,c7 as referencia, c14 as suc,
					c15 as genero, c16 as naturaleza, c17 as grupo, c18 as tipo,c19 as folio, c4 as cargo_abono,
					case when c4 ='A' then sum(c5) end abono_total, 
					case when c4 ='C' then sum(c5) end cargo_total from "
					& k_tabla &
					" where c1 between  '"&k_rango_ini&"' and "& k_rango_fin &" 
					and c14 = '"&k_suc&"' and c15 = 'N' and c16='A' and c8='"&k_tipo&"' and c19 like '"&k_folio&"' and c7 like '"&k_refer&"' and c2 "&k_fecha&"
					group  by c1, c4, c8, c14, c15 , c16, c17, c18,c19 , c2, c7
					order by c1) as sel
					group by n_poliza, tipo_l, fecha, referencia,folio,genero,naturaleza,grupo,tipo";
//			frn.message(k_tabla,"Error","Aceptar");
			var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conpolizasView.cargarPolizas()");
			var consultaXml=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cubo,"r0");	
//			frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\consultaXml");
			frn.setX(cubo,"tabla");
			obtenerTipoDesc();
		}
	
        fun obtenerTipoDesc(){
            var tipo =mid(frn.get("k_tipo",-1,1),1,1);
            var cmd = "select c5 as k_descrip
                 from keplersc.kdmm
                where  c1 = 'N' and c2 = 'A' and c3 = '21' and c4='" &tipo& "'";
            cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"conpolizasview.obtenerTipoDesc()");
            var descripcion = getXmlAtt(cuboXml,"r0","k_descrip");
            frn.set("k_descrip_tipo",descripcion);
			
        }
			
         fun ObtenerTipo(){
			var ok, mensajeError, cubo;
            var cmdQuery = "select c18 as tipo_letra, concat('0',c4) as k_tipo, c5 as k_descrip
					from keplersc.kdmm
					where  c1 = 'N' and c2 = 'A' and c3 = '21'";
						
			cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"conpolizasView.ObtenerTipo()");
					
			ok=getXmlAtt(cubo,"ok");
			if(ok &! "" && !ok){
				mensajeError = getXmlAtt(cubo,"native3");
				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}	
			frn.set("k_tipo",getXml(cubo));

			cargarPolizas();
            }

			fun abrir_poliza(){
				var gen,nat,gpo,tipo,sucursal_id,anio,mes,tipo_poliza,folio,tipo_movto,param;
				gen=frn.get("tabla",-1,"genero");
				nat=frn.get("tabla",-1,"naturaleza");
				gpo=frn.get("tabla",-1,"grupo");
				tipo=frn.get("tabla",-1,"tipo");					
				sucursal_id = frn.get("k_suc",-1,1);
				anio =mid(frn.get("k_anio"),2,2);	
				mes=frn.get("k_mes");
				tipo_poliza=frn.get("tabla",-1,"t_tipo");
				folio=frn.get("tabla",-1,"t_n_poliza");
				if (tipoOper&="CONSULTA"){
					tipo_movto = "C";
				}else if(tipoOper&="BAJA"){
					tipo_movto = "B";
				}				
				param=gen & "," & nat &  "," & gpo & "," & tipo & "," & tipo_movto & "," & sucursal_id & "," & anio & "," & mes & "," & tipo_poliza & "," & folio;
				frn.message(param,"Mensaje",1);
				frn.dialog("conpolizapag.kpl",gen,nat,gpo,tipo,tipo_movto,sucursal_id,anio,mes,tipo_poliza,folio);
			}
			

			fun ConfiguraUI(){
				consPlantilla="CONSULTA"; //AQUI DEFINE LA CONSTANTE PARA COMPARAR EN PARAMETROS
				if (frn.nParam() == 0){
					frn.message("Acción no permitida.","Error","&Aceptar");
					frn.open("redirect",2);
					return;
				}
				tipoOper = frn.param(0);
				//Establecer titulo de la ventana
				if (tipoOper &= "CONSULTA"){
					frn.setAtt("gpo_2","tit","Consulta de pólizas");
					frn.set("k_titulo","Consulta de Pólizas");
				}else if(tipoOper &= "BAJA"){
					frn.setAtt("gpo_2","tit","Baja de pólizas");
					frn.set("k_titulo","Baja de Pólizas");				
				}
				else{
					frn.message("Acción no permitida.","Error","&Aceptar");
					frn.open("redirect",2);
					return;
				}
			}
					
			fun Inicializa(){
				frn.rst("gpo_2");
				Inicia_Forma();
				cargarPolizas();
				ObtenerTipo();
				obtenerTipoDesc();
				}
	
			fun Inicia_Forma(){
				var cmd,ok,mensajeError, cubo, cmdQueryanio, cmdQuerymes;
				//Etiquetas 
				frn.set("suc","Sucursal");
				frn.set("mes","Mes");
				frn.set("anio","Año");
				frn.set("rango_ini","Del No. de Póliza");
				frn.set("rango_fin","Al No. de Póliza");
				frn.set("tipo","Tipo");
				frn.set("folio","Folio");
				frn.set("fecha","Fecha");
                frn.set("referencia","Referencia");
				//Obtencion de registros
				cmd = "select concat('[',c1,']',c2) as c2, c1 from keplersc.kdms";
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"conpolizasView.Inicia_Forma()");
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
					}
				frn.set("k_suc",getXml(cubo));
				cmdQueryanio="SELECT concat('20',substring(table_name,5,2)) as anio FROM INFORMATION_SCHEMA.TABLES 
								WHERE TABLE_NAME LIKE 'kdc22%'
								group by anio
								order by anio desc";
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQueryanio,"conpolizasView.Inicia_Forma()");
				frn.set("k_anio",getXml(cubo));
				cmdQuerymes = "select substring(table_name,7,2) as mes from information_schema.tables
								where table_name  like 'kdc22%'  and substring(table_name,7,2) != ''
								group  by mes";
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuerymes,"conpolizasView.Inicia_Forma()");
				frn.set("k_mes",getXml(cubo));
			}
		
//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------GAD fl4r30n
						
			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){
				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO
							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana
							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)
							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje
				*/
				var prefix=frn.lib("libKepler","langPrefix");
				var page=prefix&pag;
				var b_valido=1;
				if(iModo==0)page=pag;
				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.
					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;
				}
				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);
			}
		}
	</script>
</pag>