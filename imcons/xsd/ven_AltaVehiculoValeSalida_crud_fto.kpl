<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns='www.kepler.com.mx/2003/KSchema' tit='Consulta Factura Veh&#237;culo' scale="48">
<grp dim='1,-1,10,20' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">
	<br exe="encabezado"/>
	<hLine dim="180,0"/>
	<br exe="encabezado"/>
	<grp dim="16,8,7,12"><sp/>
		<img id="img"  dim="14,80" brdr="0,1" img="logocliente.jpg"/>
	</grp>	
	<grp dim="180,16,7,1">
		<inp id="k_empresa" just="C" fnt=",20b" dim="80,1" clr="0,58,112" type="string" available = "N"/>		
		<br/>
		<inp id="titulo"  dim="40,1" clr="0,58,112" brdr="0,1" type="string" fnt="Arial,20b"/>
		<tab n="5"/><sp/><txt fnt="Arial,20" clr="255,0,0">No.</txt>
		<inp id="rep_docto"  just="R" dim="30,1" brdr="0,1" type="string" fnt="Arial,18" clr="255,0,0" nc="7"/>
		<br/>
		<txt fnt="Arial,18">Sucursal:</txt>
		<inp id="rep_suc"  just="L" dim="30,1" brdr="0,1" type="string" fnt="Arial,16" nc="20"/>
		<tab n="5"/>
		<sp/><txt>Ref:</txt>
		<inp id="rep_refer" just= "R" dim="30,1" brdr="0,1" type="string" fnt="Arial,15" fmt="DD/MM/CCYY" nc="-1"/><br/>
		<tab n="17"/><sp n="2"/><txt>Fecha:</txt>
		<inp id="rep_fecha" dim="20,1" just= "R" brdr="0,1" type="date" fnt="Arial,15" fmt="DD/MM/CCYY" nc="-1"/>
	</grp>	
	<sp/>
	<br exe="encabezado"/>
	<tab n="1"/>	
	<br exe="seccion_detalle"/>
	<hLine dim="180,0"/>	
	<br exe="seccion_detalle"/>
	<grp dim="180,40,7,14">		
		<inp id="rep_ver" just = "R" dim="120,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>		
		<inp id="rep_separadorA"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>		
		<inp id="rep_tit0"  dim="120,1" brdr="0,1" type="string" just="C" fnt="Arial,15"/><br/>		
		<inp id="rep_separadorA1"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>		
		<txt>NOMBRE DEL CLIENTE:</txt><sp/>
		<inp id="rep_nombrecliente"   dim="100,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>		
		<txt>TEL&#201;FONO:</txt><sp/>
		<inp id="rep_telefono"   dim="30,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>
		<txt>NO.FACT:</txt><sp/>
		<inp id="rep_noFact"  dim="30,1" brdr="0,1" type="string" fnt="Arial,15"/>			
		<txt>FECHA FACT:</txt><sp/>
		<inp id="rep_FechaFact"  dim="30,1" brdr="0,1" type="string" fnt="Arial,15"/>					
		<txt>NO. VALE:</txt><sp/>
		<inp id="rep_novale"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		
		<br/>
		<txt>VENDEDOR:</txt><sp/>
		<inp id="rep_vendedor"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15"/>
		<br/>
		<inp id="rep_separador"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>		
		<inp id="rep_tit1"  dim="120,1" brdr="0,1" type="string" just="C" fnt="Arial,15"/><br/>		
		<inp id="rep_separador2"  dim="120,1" brdr="0,1" type="string" just="C" fnt="Arial,15"/><br/>		
		<inp id="rep_inventario"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15b"/><br/>		
		<inp id="rep_serie"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15b"/><br/>		
		<inp id="rep_exterior"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15b"/><br/>
		<inp id="rep_separador1"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>						
		<br/>
		<br/>
		<inp id="rep_1"  dim="60,1" brdr="0,1" type="string" fnt="Arial,15" just="C"/>
		<inp id="rep_1A"  dim="60,1" brdr="0,1" type="string" fnt="Arial,15" just="C"/><br/>
		<inp id="rep_2"  dim="60,1" brdr="0,1" type="string" fnt="Arial,15" just="C"/>
		<inp id="rep_2A"  dim="60,1" brdr="0,1" type="string" fnt="Arial,15" just="C"/><br/>
		<inp id="rep_3"  dim="60,1" brdr="0,1" type="string" fnt="Arial,15" just="C"/>
		<inp id="rep_3A"  dim="60,1" brdr="0,1" type="string" fnt="Arial,15" just="C"/><br/>
		<inp id="rep_4"  dim="60,1" brdr="0,1" type="string" fnt="Arial,15" just="C"/>
		<inp id="rep_4A"  dim="60,1" brdr="0,1" type="string" fnt="Arial,15" just="C"/>
		<br/><br/><br/>
		<inp id="rep_5"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15" just="C"/><tab n="2"/><br/>
		<inp id="rep_6"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15" just="C"/><tab n="2"/><br/>
		<inp id="rep_7"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15" just="C"/><tab n="2"/><br/>
	</grp>
	<br exe="seccion_detalle"/>			
</grp>
