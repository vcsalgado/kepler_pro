<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Regeneraci&#243;n de Cfdi"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0">	<br/>	<tab/><inp id="inp_titulo" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>	<br/><tab/><hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp dim="80,5,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Folio">				<tab n="1"/><txt clr="0,58,112" hk="S">Sucursal:</txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="22,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><sp/>		<txt>Gen:</txt>		<inp id="k_gen" dim="2,1" nc="1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" tooltip="Genero"/><sp/>		<txt>Nat:</txt>		<inp id="k_nat" dim="2,1" nc="1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" tooltip="Naturaleza"/><sp/>		<txt>Gpo:</txt>		<inp id="k_gpo" dim="2,1" nc="2" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" tooltip="Grupo"/><sp/>		<txt>Tpo:</txt>		<inp id="k_tpo" dim="2,1" nc="2" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" tooltip="Tipo"/>		<inp id="strfolio" dim="1,1" type="capital" brdr="2,0" clr="64,64,64" OnChange="SeparaFolio()" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><sp/>		<txt>Folio:</txt>		<inp id="k_folio" dim="10,1" nc="10" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" OnF9="ObtenerFolio()" OnChange="LimpiarInf()" tooltip="Folio ( F9 b&#250;squeda )"/><sp/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y" tooltip="Buscar"/>		<sp/>		<img id="Cancelar" dim="20,20" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Limpia" available="Y" clrBrdr="0,0,0" visible="Y"/>		<br/>	</grp>	<br/><br/><tab/>		<grp dim="80,25,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">				<br/><tab/><txt>Cliente :</txt><tab n="2"/>		<inp id="k_clave" dim="12,1"  type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" available="N" modify="Y"/><sp/>		<inp id="k_nombre" dim="50,1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" available="N" modify="Y"/><sp/>		<br/><tab/>		<txt clr="0,58,112">RFC : </txt><tab n="2"/>				<inp id="k_rfc" dim="20,1" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="N" visible="Y" tooltip="RFC"/><sp/><tab n="6"/><txt visible="N"> Fecha Documento :</txt>				<inp id="k_fecha_docto" dim="12,1" type="date" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="N" visible="N" tooltip="RFC" fmt="DD/MM/YY" nc="-1"/><sp/>		<br/><tab/>		<txt>Forma Pago :</txt><tab/>		<cmb id="k_f_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="31,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string"  OnChange="" modify="Y" available="Y" visible="Y" tooltip="Forma de pago"/>		<br/><tab/>		<txt clr="0,58,112">Cuenta : </txt><tab/>				<inp id="k_cuenta" clr="64,64,64"  dim="31,1" brdr="2,0" bclr="255,255,255" type="number" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="N&#250;mero de cuenta" fmt="5" just="L"/>		<br/><tab/>		<txt clr="0,58,112">M&#233;todo Pago : </txt>		<inp id="k_m_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="3" modify="Y" available="Y" visible="Y" tooltip="M&#233;todo de pago"/>		<br/><tab/>		<txt clr="0,58,112">Uso CFDI : </txt><tab/>		<cmb id="k_cfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="31,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" modify="Y" available="N" visible="Y" tooltip="Uso de CFDI"/>		<br/><tab/>			<txt>R&#233;g. Fiscal:</txt><tab/>		<cmb id="k_regfiscal" clr="64,64,64" clrBrdr="255,255,255"  dim="31,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" modify="Y" available="N" visible="Y" tooltip="R&#233;gimen Fiscal"/><br/><tab/>		<br/>			<tab/><bot id="bot_validar" dim="18,0" brdr="5" text="Validaci&#243;n/Modificaci&#243;n" visible="Y" OnEnter="EjecutaValidaCFDI()"/>		<sp/><inp id="datcfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="3,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="1" modify="Y" available="Y" visible="N" OnChange="ControlGenera()"/>		<tab/><bot id="bot_seleccionar" dim="14,0" brdr="5" text="Generar" OnEnter="Ejecuta()" visible="N"/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco, externo ;		var cmdQuery, cuboQuery, ok, mensajeError, fileSavePath;		var tipoOper; //Variables relacionadas con parametros		var consCfdi,suc_bus,genero,naturaleza,grupo,tipo,folio;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			asterisco = "*";			fileSavePath = "C:\Basura";			ConfiguraUI();			Inicializa();		}					fun ConfiguraUI(){			var nparam;			consCfdi = "CFDIFOLIO";			tipoOper = frn.param(0);			nparam = frn.nParam();			if (frn.nParam() == 0){				frn.message("Accion no permitida.","Error","&Aceptar");				frn.open("redirect",2);				return;			}			//Establecer titulo de la ventana			if (tipoOper &= consCfdi){				frn.set("inp_titulo","Regeneracion de Cfdi");											}else{				frn.message("Accion no permitida.","Error","&Aceptar");				frn.open("redirect",2);				return;			}		}						fun Inicializa(){			var cmd,cubo;							//Llenar combo sucursales			cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmd = cmd & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmd = cmd & " where c1='" & suc_usuario & "'";				}			}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");					ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_sucn",getXml(cubo));			frn.set("k_sucn",descr_combo("k_sucn",1,suc_usuario));							//Llena Combo Forma de pago			cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3fp";			IniCombos("k_f_pago",cmd);							//Llena Combo Uso Cfdi			cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3uso";			IniCombos("k_cfdi",cmd);						//Llena Combo Regimen fiscal			cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3rf";			IniCombos("k_regfiscal",cmd);						frn.set("k_f_pago", "");			frn.set("k_cfdi", "");			frn.set("k_regfiscal","");			frn.set("datcfdi","N");		}					fun IniCombos(ctrl_combo, query){			cmdQuery = query;			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cfdiregenerafolio.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set(ctrl_combo,cuboQuery);		}		fun PadLeft(pText,pRelleno,pCaracterRelleno) {			var Resultado;			var pos_ini = pText;			var nReg = strlen(pText);			for (var cont = nReg; cont < pRelleno; cont++) {				Resultado = pCaracterRelleno & Resultado;			}			Resultado = Resultado & pText;                			return Resultado;		}		fun ObtenerFolio() {			suc_bus = frn.get("k_sucn",-1,1);			folio = frn.get("k_folio");			genero = frn.get("k_gen");			naturaleza = frn.get("k_nat");			grupo = frn.get("k_gpo");			tipo = frn.get("k_tpo");			LimpiarInf();			if (genero &! "" && naturaleza &! "" && grupo &! "" && tipo &! ""){				cmdQuery = "select dm1.c2 as G,dm1.c3 as N,dm1.c4 as gpo,dm1.c5 as tpo, dm1.c2||dm1.c3||lpad(dm1.c4::text,2,'0')||lpad(dm1.c5::text,3,'0')||'-'||dm1.C6 as documento,dm1.c6 as folio,dm1.c9 as fecha " &						"from keplersc.kdm1 dm1 " &						"inner join keplersc.kdmm dmm on col_sucursal=dm1.c1 and dmm.c1=dm1.c2 and dmm.c2=dm1.c3 and dmm.c3=dm1.c4 and dmm.c4=dm1.c5 " &						"where dmm.c80='S' and dm1.c1='" & suc_bus & "' and dm1.c2='" & genero & "' and dm1.c3='" & naturaleza & "' and dm1.c4=" & grupo & " and dm1.c5=" & tipo &						"order by dm1.c9 desc";			} else {				cmdQuery = "select dm1.c2 as G,dm1.c3 as N,dm1.c4 as gpo,dm1.c5 as tpo, dm1.c2||dm1.c3||lpad(dm1.c4::text,2,'0')||lpad(dm1.c5::text,3,'0')||'-'||dm1.C6 as documento,dm1.c6 as folio,dm1.c9 as fecha " &						"from keplersc.kdm1 dm1 " &						"inner join keplersc.kdmm dmm on col_sucursal=dm1.c1 and dmm.c1=dm1.c2 and dmm.c2=dm1.c3 and dmm.c3=dm1.c4 and dmm.c4=dm1.c5 " &						"where dmm.c80='S' and dm1.c1='" & suc_bus & "'" &						"order by dm1.c9 desc";			}							frn.dialog("genlistafiltrosel","Folios para regenerar Cfdi",cmdQuery,"documento","strfolio","0","0","N","S");			}		fun SeparaFolio(){			frn.set("k_gen",mid(frn.get("strfolio"),0,1));			frn.set("k_nat",mid(frn.get("strfolio"),1,1));			frn.set("k_gpo",mid(frn.get("strfolio"),2,2));			frn.set("k_tpo",mid(frn.get("strfolio"),5,2));			frn.set("k_folio",mid(frn.get("strfolio"),8,10));		}		fun Buscar() {			var xmlRequest,cmd,ok,cuboResultados, xmlProd,vfmov,vfreg;			suc_bus = frn.get("k_sucn", -1, 1);			folio = frn.get("k_folio");			genero = frn.get("k_gen");			naturaleza = frn.get("k_nat");			grupo = frn.get("k_gpo");			tipo = frn.get("k_tpo");			if (folio &=""){				frn.message("Debe seleccionar un folio","Error","Aceptar");				return;			} 			if (genero &! "" && naturaleza &! "" && grupo &! "" && tipo &! "" && folio &!""){				cmd = "select dm1.c10 as k_clave,udcfd.c11 as k_rfc,udcfd.c2 as k_nombre," &				"'['||fp.c1||'] '||fp.c2 as k_f_pago,'['||cfd.c1||'] '||cfd.c2 as k_cfdi,dm1.c161 as k_cuenta,dm1.c162 as k_m_pago,'['||rf.c1||'] '||rf.c2 as k_regfiscal,dm1.c9 as k_fecha_docto " &				"from keplersc.kdm1 dm1 " &				"inner join keplersc.kdudcfd udcfd on udcfd.c1=dm1.c10 " &				"inner join keplersc.kdmm dmm on col_sucursal=dm1.c1 and dmm.c1=dm1.c2 and dmm.c2=dm1.c3 and dmm.c3=dm1.c4 and dmm.c4=dm1.c5 " &				"left join keplersc.kdf3uso cfd on cfd.c1=udcfd.c23 " &				"left join keplersc.kdf3rf rf on rf.c1=udcfd.c24 " &				"left join keplersc.kdf3fp fp on fp.c1=dm1.c160 " &				"where dmm.c80='S' and dm1.c1='" & suc_bus & "' and dm1.c2='" & genero & "' and dm1.c3='" & naturaleza & 				"' and dm1.c4=" & grupo &" and dm1.c5=" & tipo &" and dm1.c6='" & folio &"'";			}			if (genero &= "" && naturaleza &= "" && grupo &= "" && tipo &= "" && folio &!""){				cmd = "select dm1.c10 as k_clave,udcfd.c11 as k_rfc,udcfd.c2 as k_nombre,dm1.c2 as k_gen,dm1.c3 as k_nat,dm1.c4 as k_gpo,dm1.c5 as k_tpo," &				"'['||fp.c1||'] '||fp.c2 as k_f_pago,'['||cfd.c1||'] '||cfd.c2 as k_cfdi,dm1.c161 as k_cuenta,dm1.c162 as k_m_pago,'['||rf.c1||'] '||rf.c2 as k_regfiscal,dm1.c9 as k_fecha_docto " &				"from keplersc.kdm1 dm1 " &				"inner join keplersc.kdudcfd udcfd on udcfd.c1=dm1.c10 " &				"inner join keplersc.kdmm dmm on col_sucursal=dm1.c1 and dmm.c1=dm1.c2 and dmm.c2=dm1.c3 and dmm.c3=dm1.c4 and dmm.c4=dm1.c5 " &				"left join keplersc.kdf3uso cfd on cfd.c1=udcfd.c23 " &				"left join keplersc.kdf3rf rf on rf.c1=udcfd.c24 " &				"left join keplersc.kdf3fp fp on fp.c1=dm1.c160 " &				"where dmm.c80='S' and dm1.c1='" & suc_bus & "' and dm1.c6='" & folio &"'";			}			frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRequest");								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cfdiregenerafolio.Buscar()");			ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			//Si no existe registro en kdudcfd busca en kdud			if(nXml(cuboResultados) == 0){				if (genero &! "" && naturaleza &! "" && grupo &! "" && tipo &! "" && folio &!""){					cmd = "select dm1.c10 as k_clave,ud.c10 as k_rfc,ud.c3 as k_nombre," &					"'['||fp.c1||'] '||fp.c2 as k_f_pago,'['||cfd.c1||'] '||cfd.c2 as k_cfdi,dm1.c161 as k_cuenta,dm1.c162 as k_m_pago,'['||rf.c1||'] '||rf.c2 as k_regfiscal,dm1.c9 as k_fecha_docto " &					"from keplersc.kdm1 dm1 " &					"inner join keplersc.kdud ud on ud.c2=dm1.c10 " &					"inner join keplersc.kdmm dmm on col_sucursal=dm1.c1 and dmm.c1=dm1.c2 and dmm.c2=dm1.c3 and dmm.c3=dm1.c4 and dmm.c4=dm1.c5 " &					"left join keplersc.kdf3uso cfd on cfd.c1=ud.c53 " &					"left join keplersc.kdf3rf rf on rf.c1=ud.c54 " &					"left join keplersc.kdf3fp fp on fp.c1=dm1.c160 " &					"where dmm.c80='S' and dm1.c1='" & suc_bus & "' and dm1.c2='" & genero & "' and dm1.c3='" & naturaleza & 					"' and dm1.c4=" & grupo &" and dm1.c5=" & tipo &" and dm1.c6='" & folio &"'";				}				if (genero &= "" && naturaleza &= "" && grupo &= "" && tipo &= "" && folio &!""){					cmd = "select dm1.c10 as k_clave,ud.c10 as k_rfc,ud.c3 as k_nombre,dm1.c2 as k_gen,dm1.c3 as k_nat,dm1.c4 as k_gpo,dm1.c5 as k_tpo," &					"'['||fp.c1||'] '||fp.c2 as k_f_pago,'['||cfd.c1||'] '||cfd.c2 as k_cfdi,dm1.c161 as k_cuenta,dm1.c162 as k_m_pago,'['||rf.c1||'] '||rf.c2 as k_regfiscal,dm1.c9 as k_fecha_docto " &					"from keplersc.kdm1 dm1 " &					"inner join keplersc.kdud ud on ud.c2=dm1.c10 " &					"inner join keplersc.kdmm dmm on col_sucursal=dm1.c1 and dmm.c1=dm1.c2 and dmm.c2=dm1.c3 and dmm.c3=dm1.c4 and dmm.c4=dm1.c5 " &					"left join keplersc.kdf3uso cfd on cfd.c1=ud.c53 " &					"left join keplersc.kdf3rf rf on rf.c1=ud.c54 " &					"left join keplersc.kdf3fp fp on fp.c1=dm1.c160 " &					"where dmm.c80='S' and dm1.c1='" & suc_bus & "' and dm1.c6='" & folio &"'";				}				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRequest");										cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cfdiregenerafolio.Buscar()");				ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}							}			if(nXml(cuboResultados) == 0){				frn.setPos("k_folio");				frn.message("El folio no existe","Error","Aceptar");				return;			}								rstXml(xmlProd);			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboResultados,"r0");			LimpiarInf();			frn.setX(xmlProd);					//valida fecha para regeneacion de cfdi, fechas anteriores se deben regenerar en en k75										cmd = " select c6 as fecha_regenera from keplersc.kdcfdconfig where c1='" & suc_bus & "'";								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cfdiregenerafolio.Buscar()");			ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}						vfmov= fnDate("julian",frn.get("k_fecha_docto"));			vfreg=fnDate("julian",getXmlAtt(cuboResultados,"r0","fecha_regenera"));			//frn.message("fecha movto:" &vfmov & "Fecha regenera:" &vfreg);            if (vfmov < vfreg){				frn.setAtt("bot_validar", "visible", "N" );				frn.message("No es posible regenerar este folio, factura generada en sistema anterior|Solicite apoyo a sistemas ","Atencion","Aceptar");				return;			}else {				frn.setAtt("bot_validar", "visible", "Y" );			}					}		fun LimpiarInf(){			frn.set("k_clave","");			frn.set("k_nombre","");			frn.set("k_f_pago", "");			frn.set("k_cuenta", "");			frn.set("k_m_pago", "");			frn.set("k_cfdi", "");			frn.set("k_rfc", "");			frn.set("k_regfiscal", "");			frn.setAtt("bot_seleccionar", "visible", "N" );			frn.setAtt("bot_validar", "visible", "N" );			frn.set("datcfdi","N");			frn.set("k_fecha_docto","");					}		fun BorraDatos(){			frn.set("k_gen","");			frn.set("k_nat","");			frn.set("k_gpo", "");			frn.set("k_tpo", "");			frn.set("k_folio", "");			LimpiarInf();		}				fun Ejecuta(){			var xmlPantalla,resultado,mensaje,folio,continua;			var xmlRequest,cmd,ok,cuboResultados;			var strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			fecha = sys.date();			hora= sys.time();			strFecha = fnDate("year",fecha) & "-";			strTmp = fnDate("month",fecha);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "-";			strTmp = fnDate("day",fecha);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp;			ControlGenera();			Buscar();			continua = frn.message("Desea continuar con la Regeneracion xml cfdi?","Atencion",2);			if (continua == 0){				return;			}			//Valida metodo de pago			if (frn.get("k_m_pago") &!"PUE" && frn.get("k_m_pago") &!"PPD"){				frn.setPos("k_m_pago");				frn.message("El metodo de pago solo puede ser PUE o PPD","Error","Aceptar");				return;			}							xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			setXml(xmlPantalla,"tip_ope",tipoOper);			setXml(xmlPantalla,"movimiento","usuario",usuario);			setXml(xmlPantalla,"movimiento","fecha",strFecha);			setXml(xmlPantalla,"movimiento","hora",			frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 			frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));						if (frn.get("k_gen") &= "U" && frn.get("k_nat") &= "A" && frn.get("k_gpo") &= "81"){				//MSS 29092025 Enviar identificador de aplicacion anticipos 				//Obtener datos del folio por anexar				cmd = "select c16, c36, c37, c38, c39 from keplersc.kdm1 dm1 				where dm1.c1='" & suc_bus & "' and dm1.c2='" & genero & "' and dm1.c3='" & naturaleza & "' and dm1.c4=" & grupo &" and dm1.c5=" & tipo &" and dm1.c6='" & folio &"'";								frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRequest");										cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cfdiregenerafolio.Buscar()");				ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								//PARAMETROS NECESARIOS PARA LA APLICACION DE ANTICIPOS				setXml(xmlPantalla,"ambiente","flag_cobros","APLICA_ANTICIPO");				setXml(xmlPantalla,"k_monto",getXmlAtt(cuboResultados,"r0","c16"));				setXml(xmlPantalla,"k_natdocto",getXmlAtt(cuboResultados,"r0","c36"));				setXml(xmlPantalla,"k_gpodocto",getXmlAtt(cuboResultados,"r0","c37"));				setXml(xmlPantalla,"k_tipodocto",getXmlAtt(cuboResultados,"r0","c38"));				setXml(xmlPantalla,"k_foliodocto",getXmlAtt(cuboResultados,"r0","c39"));									}			if (frn.get("k_gen") &= "U" && frn.get("k_nat") &= "D" && frn.get("k_gpo") &= "32"){				//MSS 29092025 Enviar identificador de anulacion de cobros				//PARAMETRO NECESARIO PARA LA ANULACION DE COBROS				setXml(xmlPantalla,"ambiente","flag_cobros","ANULACION_COB");				}								frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaRegenCfdi");			cmdQuery="SELECT * FROM keplersc.cfd_regenera_folio('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";			rstXml(cuboQuery);								cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cdfiview.Ejecuta");							frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadCdfiview");								resultado = getXml(cuboQuery,"resultado");			mensaje = getXml(cuboQuery,"mensaje");								ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(resultado &= "1") {				strMsg = "Se regenero xml para Cfdi";				frn.message(strMsg, "Mensaje", "Aceptar");				 frn.setAtt("bot_seleccionar", "visible", "N" );				 frn.set("datcfdi","N");			} else {				frn.message(mensaje, "Error", "Aceptar");				return;			}				}		fun ControlGenera(){			if (frn.get("datcfdi") &= "S"){                frn.setAtt("bot_seleccionar", "visible", "Y" );			} else {		        frn.setAtt("bot_seleccionar", "visible", "N" );			}		}		fun EjecutaValidaCFDI(){			if ( strlen(frn.get("k_clave")) != 0 ) {				frn.dialog("icfdreview",frn.get("k_sucn",-1,1),frn.get("k_clave"),"Ejecuta","cmb",frn.get("k_f_pago",-1,1),frn.get("k_cuenta"),frn.get("k_m_pago"));			}		}//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------		fun descr_combo(combo,posicion,valor){			var descr, valor_actual;			var len_combo = frn.N(combo);			for (var cont=0; cont<len_combo ; cont++){				valor_actual= frn.get(combo,cont,posicion);				if (valor_actual &=  valor){					descr = frn.get(combo,cont,0);					return descr;				}			}		}					fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO						1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana						2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)						3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			if(iModo==0)				page=pag;			else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.				if( frn.getAtt(par0,"modify",par1) &= "N" ) 					b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) 					b_valido=0;				if( frn.getAtt(par0,"visible",par1) &= "N" ) 					b_valido=0;			}			if(iModo==3)				frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>