<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Libreria">	<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,20" bclr="192,205,213"><br/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="70,50,7,12" brdr="0,5" tit="Datos generales" fnt="Arial,16"><br/>		</grp><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,sys;			var bConect;//Bandera que indica si ya está conectado o no.			/*			Ejemplo de uso de librerías en Kepler.			Funcionalidad de librerías: Permiten definir códigos genéricos que se utilizarán en varias pantallas y reutilizar ese código.			Limitante: Las librería no pueden modificar objetos gráficos de la ventana padre.			Nota: A diferencia de las patallas de diálogo, al mandar llamar a una librería desde el script de la página padre, 					se detiene la ejcución de la página padre hasta que la librería le regrese el control			Las funciones de las librerías reciben, como cualquier otra función, variables XML, por lo que pueden recibir estructuras complejas.			Así mismo cada rutina devuelve una estructura(variable) XML.			Ejemplo:			=====			Función definida en librería			====			fun rutina1(elmXml1,elmXml2){				var dato1=elmXml1;				var dato2=getXml(elmXml2,"hijo","nieto",...);				var resultado;				setXml(resultado,"r0","val1","Valor de respuesta");				setXml(resultado,"r1","val1","Otro valor de respuesta");			return resultado;			}			====			Página padre:			====			var input;			setXml(input,"hijo","nieto",...,"VALOR");			var output=frn.lib("libGeneral.kpl","rutina1",450,input);			var temp;			temp=getXml(output,"r0","val1");			temp=getXml(output,"r1","val1");			*/			fun Main() {				frn=new FRNT;//Solo para frn.message, no se puede modificar objetos gráficos de la ventana principal				kdb=new KDB;				sys=new SYS;				bConect=0;				//Esta rutina se ejecuta solo la primera vez que se manda llamar alguna función de la librería. 			}			fun Conexion(){//Cuando se quiera accesar a base de datos, ejecutar esta función, antes de cualquier cosa. 				if(bConect==0){kdb.connect();bConect=1;}			}			//====================			//||RUTINAS GENÉRICAS||			//====================			fun libCambiaRefer(referencia,fechaPoliza,tipoPoliza,numeroPoliza,nPartidas){//Cambia la referencia (nivel partida) de la póliza especificada				Conexion();				if( strlen(fechaPoliza)>0 && strlen(tipoPoliza)>0 && strlen(numeroPoliza)>0 && nPartidas>0 ){					kdb.open("d,kdc2&" & fnDate("year",fechaPoliza) & "&" & fnDate("month",fechaPoliza));					for(var i=0; i<nPartidas;i++){						kdb.write("cubSal,d,2,'"& tipoPoliza &"',"& numeroPoliza &","& i+1 &",&,7,'"& referencia &"'");					}					kdb.exec();				}//fin if de validacion de tipo y numero poliza			}						fun Poliza(docto){				Conexion();				var retXml;rstXml(retXml);				var paridad_Cobro = getXml(docto,"k_paridad");//Paridad del documento de  cobro 				var clave_Moneda_Cobro = getXml(docto,"k_moneda");//Clave de la moneda del documento de cobro				var xmlMonedasPartidas;//Xml que contendra las claves de monedas que se encuentren en las partidas del documento, necesario para llevar el monto por moneda				/*if(paridad_Cobro == 1){//No hay necesidad de recalculos en cobros realizados en moneda base o paridad 1					setXml(retXml,"ok","1");					setXml(retXml,"Poliza",getXml(docto,"k_poliza"));//Se devuelve la poliza de la misma forma que se envio.					return retXml;//Termina la ejecución				}*/				//variables generales				var IVACobrado;//				var IVAPagado;//Global de IVA que se pago realmente por los movimientos				var nReg = nXml(docto,"k_movcartera");//nReg variable generica de contador.Primera asignación el número de partidas en el k_movcartera				if(nReg==0){					setXml(retXml,"ok","0");					setXml(retXml,"Error","Documento sin partidas");					return retXml;//Termina la ejecución				}				//Se recorreran las partidas 				for(var i=0;i<nReg;i++){					var paridad_Factura = getXml(docto,"k_movcartera","r"&i,"k_par_orig");//Paridad original de la moneda en el momento de su creación.					var monto_Factura = getXml(docto,"k_movcartera","r"&i,"k_monto_orig");//Monto					var iva_factura = getXml(docto,"k_movcartera","r"&i,"k_iva");					var paridad_Factura_en_Cobro;					paridad_Factura_en_Cobro = getXml(docto,"k_movcartera","r"&i,"k_par_ref");					if(math("abs",(paridad_Factura_en_Cobro - getXml(docto,"k_movcartera","r"&i,"k_paridad")))>0.01){						paridad_Factura_en_Cobro = getXml(docto,"k_movcartera","r"&i,"k_paridad");					}					var monto = getXml(docto,"k_movcartera","r"&i,"k_monto");//Se aplica en el movimiento					var monto_a_pagar = (monto * paridad_Cobro) / paridad_Factura_en_Cobro;					var monto_en_moneda_Factura = (monto * paridad_Cobro) / paridad_Factura;					var PU = monto_en_moneda_Factura - monto_a_pagar;					PU = PU * paridad_Factura;					var iva_cobrado = paridad_Factura * (monto_en_moneda_Factura * iva_factura) /monto_Factura;					var iva_pagado = paridad_Factura * (monto_a_pagar * iva_factura) /monto_Factura;					IVAPagado += iva_cobrado;					IVACobrado += iva_pagado;					var clave_moneda_movimiento = getXml(docto,"k_movcartera","r"&i,"k_moneda");//Monenda en que se realizo el documento original					if(PU < 0){						PU = math("abs",PU);						PU = PU -(math("abs",(iva_pagado - iva_cobrado)));						PU = PU * (-1);						setXml(xmlMonedasPartidas,clave_moneda_movimiento,"monto",(getXml(xmlMonedasPartidas,clave_moneda_movimiento,"monto")+ PU ));//Se agrega el valor de PU a la moneda.					}else{						PU = PU -(math("abs",(iva_pagado - iva_cobrado)));						setXml(xmlMonedasPartidas,clave_moneda_movimiento,"monto",(getXml(xmlMonedasPartidas,clave_moneda_movimiento,"monto")+ PU ));//Se agrega el valor de PU a la moneda.					}				}//Fin recorrido de partidas en el documento				//Consultar valores de documento para modificar la poliza				kdb.open("m,kdmm,y,kdmy");				kdb.search("datMM,m,1,0,'"&getXml(docto,"k_genero")&"','"&getXml(docto,"k_naturaleza")&"','"&getXml(docto,"k_grupo")&"','"&getXml(docto,"k_tipo")&"',&,m19,m20,m25,m26,m40,m41");				nReg = nXml(xmlMonedasPartidas);//Recorrer las monedas contenidas en los movimientos del documento.				for(var i=0; i<nReg;i++){					var monedaMov = getXmlX(xmlMonedasPartidas,5,i);					kdb.search("datMon"&monedaMov&",y,1,0,'"&monedaMov&"',&,y4...y7");//Información de cuentas de moneda.				}				kdb.exec();				for(var i=0; i<nReg;i++){//Asignar a las monedas los valores de las cuentas usadas para perdida/utilidad					var monedaMov = getXmlX(xmlMonedasPartidas,5,i);					setXmlAtt(xmlMonedasPartidas,monedaMov,"cuentaGananciaMon",kdb.get("datMon"&monedaMov,"y6"));//Ganacia					setXmlAtt(xmlMonedasPartidas,monedaMov,"cuentaPerdidaMon",kdb.get("datMon"&monedaMov,"y7"));//Perdida				}				var cuentaIVAPendiente = kdb.get("datMM","m40");				var cuentaIVACobrado = kdb.get("datMM","m41");				//var cuentaAbono = (getXml(docto,"k_naturaleza") &= "A")?kdb.get("datMM","m20"):kdb.get("datMM","m19");				//var cuentaCargo = (getXml(docto,"k_naturaleza") &= "D")?kdb.get("datMM","m19"):kdb.get("datMM","m20");				//Reestructurar los registros de la poliza para unificar montos.				nReg = nXml(docto,"k_poliza");//Recorrer las polizas presentes				var xmlNuevaPoliza;//Variable temporal para organizar las cuentas en la poliza				for(var i=0;i<nReg;i++){//Se reorganizara la poliza para tener solo una partida por cuenta.					var cuenta = getXml(docto,"k_poliza","r"&i,"k_cuenta");//					setXml(xmlNuevaPoliza,cuenta,"k_cargo",(getXml(docto,"k_poliza","r"&i,"k_cargo")+getXml(xmlNuevaPoliza,cuenta,"k_cargo")));					setXml(xmlNuevaPoliza,cuenta,"k_abono",(getXml(docto,"k_poliza","r"&i,"k_abono")+getXml(xmlNuevaPoliza,cuenta,"k_abono")));					setXml(xmlNuevaPoliza,cuenta,"k_descr",getXml(docto,"k_poliza","r"&i,"k_descr"));					setXml(xmlNuevaPoliza,cuenta,"k_refer",getXml(docto,"k_poliza","r"&i,"k_refer"));					setXml(xmlNuevaPoliza,cuenta,"k_ctaDescr",getXml(docto,"k_poliza","r"&i,"k_ctaDescr"));					setXml(xmlNuevaPoliza,cuenta,"k_conc",getXml(docto,"k_poliza","r"&i,"k_conc"));					setXml(xmlNuevaPoliza,cuenta,"k_depto",getXml(docto,"k_poliza","r"&i,"k_depto"));					setXml(xmlNuevaPoliza,cuenta,"k_proy",getXml(docto,"k_poliza","r"&i,"k_proy"));					setXml(xmlNuevaPoliza,cuenta,"k_docto",getXml(docto,"k_poliza","r"&i,"k_docto"));					setXml(xmlNuevaPoliza,cuenta,"k_suc",getXml(docto,"k_poliza","r"&i,"k_suc"));					setXml(xmlNuevaPoliza,cuenta,"k_gen",getXml(docto,"k_poliza","r"&i,"k_gen"));					setXml(xmlNuevaPoliza,cuenta,"k_nat",getXml(docto,"k_poliza","r"&i,"k_nat"));					setXml(xmlNuevaPoliza,cuenta,"k_grp",getXml(docto,"k_poliza","r"&i,"k_grp"));					setXml(xmlNuevaPoliza,cuenta,"k_tip",getXml(docto,"k_poliza","r"&i,"k_tip"));					setXml(xmlNuevaPoliza,cuenta,"k_fol",getXml(docto,"k_poliza","r"&i,"k_fol"));				}//recorrer polizas				nReg = nXml(xmlMonedasPartidas);//Se recorrera el Xml de monedas para localizar				var GananciaREAL;				for(var i=0; i<nReg;i++){					var monedaMov = getXmlX(xmlMonedasPartidas,5,i);					GananciaREAL = getXml(xmlMonedasPartidas,monedaMov,"monto");					if(GananciaREAL > 0){//Actualizar valor de ganancia						GananciaREAL = math("round",GananciaREAL,2);						if(GananciaREAL != 0){							setXml(xmlNuevaPoliza,getXmlAtt(xmlMonedasPartidas,monedaMov,"cuentaGananciaMon"),"k_abono",GananciaREAL);						}					}else if(GananciaREAL < 0){						GananciaREAL = math("round",GananciaREAL,2);						GananciaREAL = math("abs",GananciaREAL);//En poliza solo se usan valores "reales" 						if(GananciaREAL != 0){							setXml(xmlNuevaPoliza,getXmlAtt(xmlMonedasPartidas,monedaMov,"cuentaPerdidaMon"),"k_cargo",GananciaREAL);						}					}				}//Fin	for revisar perdida/ganancia por moneda				IVACobrado = math("round",IVACobrado,2);//Se redondean los valores a solo 2 decimales para la poliza				IVAPagado = math("round",IVAPagado,2);				setXml(xmlNuevaPoliza,cuentaIVAPendiente,"k_cargo",IVACobrado);//Actualizar el valor del IVA pagado				setXml(xmlNuevaPoliza,cuentaIVACobrado,"k_abono",IVAPagado);//Actualizar el valor del IVA cobrado				//Modificar la poliza				var fecha,tipoPoliza,numPoliza;				fecha = getXml(docto,"k_fecha");				tipoPoliza = getXml(docto,"k_poliza","tpoliza");				numPoliza = getXml(docto,"k_poliza","npoliza");				var xmlTempPol;//Modificar la poliza de forma manual				setXml(xmlTempPol,"k_fecha",fecha);				setXml(xmlTempPol,"k_tipo",tipoPoliza);				setXml(xmlTempPol,"k_npoliza",numPoliza);				setXml(xmlTempPol,"k_refer",getXml(docto,"k_refer"));				setXml(xmlTempPol,"k_docto",getXml(docto,"k_docto"));				setXml(xmlTempPol,"k_suc",getXml(docto,"k_sucursal"));				setXml(xmlTempPol,"k_gen",getXml(docto,"k_genero"));				setXml(xmlTempPol,"k_nat",getXml(docto,"k_naturaleza"));				setXml(xmlTempPol,"k_grp",getXml(docto,"k_grupo"));				setXml(xmlTempPol,"k_tip",getXml(docto,"k_tipo"));				setXml(xmlTempPol,"k_fol",getXml(docto,"k_folio"));				setXml(xmlTempPol,"k_descr",getXml(docto,"k_descr"));				//Rehacer las partidas de la poliza				nReg = nXml(xmlNuevaPoliza);				var nReg1;				var cnt = 0;				for(var i=0;i<nReg;i++){//Enviar los valores de las cuentas a las partidas de la poliza					var cta = getXmlX(xmlNuevaPoliza,5,i);//Cuenta 					setXml(xmlTempPol,"k_poliza","r"&cnt,"k_cuenta",cta);					nReg1 = nXml(xmlNuevaPoliza,cta);					for(var j=0;j<nReg1;j++){						var elem = getXmlX(xmlNuevaPoliza,cta,5,j);//Elemento						if(elem &= "k_cargo" || elem &= "k_abono"){//Se eliminan los registros de abono y cargo que estan en cero							var val = getXml(xmlNuevaPoliza,cta,elem);							if(val == 0 || val &= ""){continue;}						}						setXml(xmlTempPol,"k_poliza","r"&cnt,elem,getXml(xmlNuevaPoliza,cta,elem));					}					cnt++;				}				//Validar que la poliza este cuadrada				nReg = nXml(xmlTempPol,"k_poliza");				var cargo=0,abono=0;				for(var i=0;i<nReg;i++){					cargo += getXml(xmlTempPol,"k_poliza","r"&i,"k_cargo");					abono += getXml(xmlTempPol,"k_poliza","r"&i,"k_abono");				}				var msag;				if(math("abs",(cargo-abono))>0.01){//En If nueva poliza cuadrada					kdb.sp("k_opeCancela",getXml(docto,"k_sucursal"),getXml(docto,"k_genero"),getXml(docto,"k_naturaleza"),getXml(docto,"k_grupo"),getXml(docto,"k_tipo"),getXml(docto,"k_folio"));					kdb.exec();//volver a activar antes de release para que cancele los documentos en caso de error					if (kdb.get("res","ok")){						msag = "Error en calculo de los importes para la poliza, se cancelo el documento para evitar inconsistencias en las pólizas. "& getXml(docto,"k_docto");					}else{						if (kdb.get("res","err")==1){							msag = "Documento referenciado, no se canceló";						}						else if (kdb.get("res","err")==2){							msag = "Documento no encontrado";						}							else{							msag = "Error en el calculo de la póliza, se intento cancelar el documento, pero no se permitio, se recomienda cancelar manualmente el documento, o llamar a su asesor KEPLER";						}					}					setXml(retXml,"ok","0");					setXml(retXml,"Error",msag);					kdb.close();//Al terminar libera todas las conexiones.					return retXml;				}else if((cargo-abono)>0){//Ajuste de cargo					nReg = nXml(xmlMonedasPartidas);//Se recorrera el Xml de monedas para localizar la primer cuenta de cargo para UP					var nPol = nXml(xmlTempPol,"k_poliza");					for(var i=0;i<nReg;i++){						var monedaMov = getXmlX(xmlMonedasPartidas,5,i);						GananciaREAL = getXml(xmlMonedasPartidas,monedaMov,"monto");						if(GananciaREAL > 0){//Actualizar valor de ganancia							setXml(xmlTempPol,"k_poliza","r"&nPol,"k_cuenta",getXmlAtt(xmlMonedasPartidas,monedaMov,"cuentaGananciaMon"));							setXml(xmlTempPol,"k_poliza","r"&nPol,"k_abono","0.01");							setXml(xmlTempPol,"k_poliza","r"&nPol,"k_descr","Ajuste de PerdidaUtilidad");						}					}				}else if((cargo-abono)<0){//Ajuste de Aboono					nReg = nXml(xmlMonedasPartidas);//Se recorrera el Xml de monedas para localizar la primer cuenta de cargo para UP					var nPol = nXml(xmlTempPol,"k_poliza");					for(var i=0;i<nReg;i++){						var monedaMov = getXmlX(xmlMonedasPartidas,5,i);						GananciaREAL = getXml(xmlMonedasPartidas,monedaMov,"monto");						if(GananciaREAL < 0){//Actualizar valor de ganancia							setXml(xmlTempPol,"k_poliza","r"&nPol,"k_cuenta",getXmlAtt(xmlMonedasPartidas,monedaMov,"cuentaGananciaMon"));							setXml(xmlTempPol,"k_poliza","r"&nPol,"k_cargo","0.01");							setXml(xmlTempPol,"k_poliza","r"&nPol,"k_descr","Ajuste de PerdidaUtilidad");						}					}				}				//La póliza esta cuadrada, se intentará modificar la poliza almacenada				//kdb.save("_xmlTempPol.xml",getXmlStr(xmlTempPol,"EOF:13_10"));				kdb.sp("k_poliza","modifica","datPoliza",xmlTempPol);//Modifica la poliza				kdb.exec();				if (!kdb.get("datPoliza")){//En caso de error en el cambio de poliza, se deberá cancelar el documento					kdb.sp("k_opeCancela",getXml(docto,"k_sucursal"),getXml(docto,"k_genero"),getXml(docto,"k_naturaleza"),getXml(docto,"k_grupo"),getXml(docto,"k_tipo"),getXml(docto,"k_folio"));					kdb.exec();					if (kdb.get("res","ok")){						setXml(retXml,"ok","0");						setXml(retXml,"Error","Error en modificación de la póliza, se cancelo el documento KEPLER para evitar errores. "& getXml(docto,"k_docto"));						kdb.close();//Al terminar libera todas las conexiones.						return retXml;					}else{						if (kdb.get("res","err")==1){							msag = "Documento referenciado, no se canceló";						}						else if (kdb.get("res","err")==2){							msag = "Documento no encontrado";						}							else{							msag = "No se canceló documento";						}						setXml(retXml,"ok","0");						setXml(retXml,"Error","Error en modificación de la póliza, se intento cancelar el documento KEPLER pero ocurrio un error: " & msag);						kdb.close();//Al terminar libera todas las conexiones.						return retXml;					}				}else{					setXml(retXml,"ok","1");					setXml(retXml,"Poliza",kdb.get("datPoliza","doc"));					setXml(retXml,"PolizaXml",xmlTempPol);					kdb.close();//Al terminar libera todas las conexiones.					return retXml;				}			}		}		/*		Autor						Fecha			Cambio		-------------------------------------------------------------------------------		Juan Crisotobal		18-03-20		-Se elimina escenario en el que en caso de ser moneda base en la paridad del cobro esta poliza no se recalcula													ahora sin importar la paridad se recalcularan todas las polizas.		*/	</script></pag>