<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Cambia Tipo Operacion"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="37,35,10,10" brdr="0,5" tit="Cambia Tipo Operacion" fnt="Arial,16">		<tab/><sp/><txt clr="0,58,112">Sucursal</txt>		<tab n="3"/><cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N"   available="S"/>				<br/>		<tab/><sp/><txt>Inventario: </txt>			<tab n="3"/><inp id="inventario" dim="15,1" bclr="192,205,213" clr="64,64,64" OnF9="bus_inv()" OnChange="Buscar_datos()" clrBrdr="255,255,255" type="string" brdr="0,2"/><br/>			<tab/><sp/><txt>Nuevo Tipo Operacion: </txt>			<inp id="tipo_operacion" dim="15,1" bclr="192,205,213" clr="64,64,64" OnF9="bus_tipo_operacion()" clrBrdr="255,255,255" tooltip="F9 Operaciones" type="string"  brdr="0,2"/>			<br/><sp n="2"/>			<tab/><sp/><txt>Unidad de traslado: </txt>			<tab/><inp id="unidad_traslado" dim="15,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="1" brdr="0,2"/>			<br/><sp/>				<tab/><sp/><txt>Asesor: </txt>			<tab n="3"/><inp id="asesor" dim="15,1" bclr="192,205,213" clr="64,64,64" OnF9="bus_asesor(asesor)" tooltip="F9 Asesores" clrBrdr="255,255,255" type="string"  brdr="0,2"/>			<br/>			<tab/><sp/><txt>Coach: </txt>			<tab n="3"/><inp id="coach" dim="15,1" bclr="192,205,213" clr="64,64,64" OnF9="bus_coach(coach)" tooltip="F9 Coaches" clrBrdr="255,255,255" type="string"  brdr="0,2"/><br/>		<tab/><sp/><txt>Modelo: </txt>			<tab n="3"/><inp id="modelo" dim="15,1" bclr="192,205,213" clr="64,64,64" OnF9="bus_modelo()" tooltip="F9 Modelos" clrBrdr="255,255,255" type="string" brdr="0,2"/>		 <br/>	<tab/><sp/><txt>Asesor Comprador: </txt>			<tab/><inp id="asesor_comprador" dim="15,1" bclr="192,205,213" clr="64,64,64" OnF9="bus_asesor(asesor_comprador)" tooltip="F9 Asesores" clrBrdr="255,255,255" type="string" brdr="0,2"/><br/>			<tab/><sp/><txt>Coach Comprador: </txt>			<tab/><inp id="coach_comprador" dim="15,1" bclr="192,205,213" clr="64,64,64" OnF9="bus_coach(coach_comprador)"  tooltip="F9 coaches" clrBrdr="255,255,255" type="string"  brdr="0,2"/>			<br/>			<tab/><sp n="1"/><txt>Valuador Comprador: </txt>			<sp/><inp id="valuador_comprador" dim="15,1" bclr="192,205,213" clr="64,64,64" OnF9="bus_valuador()" clrBrdr="255,255,255" tooltip="F9 Valuadores" type="string"  brdr="0,2"/><br/>						<tab/><sp/><txt>Fecha Factura: </txt>			<tab n="2"/>					<edt id="fecha_factura" dim="15,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_factura" OnF9="Dialog(3,_ks_fecha,fecha_factura)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2"/>		<br/>					<tab/><sp/><txt>Fecha Vale de Salida: </txt>								<edt id="fecha_vale_salida" dim="15,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_vale_salida" OnF9="Dialog(3,_ks_fecha,fecha_vale_salida)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2"/>				<br/>					<tab/><sp/><txt>Fecha de Compra: </txt>			<tab/>			<edt id="fecha_compra" dim="15,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_compra" OnF9="Dialog(3,_ks_fecha,fecha_compra)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2"/>				<br/>									<br/><tab n="4"/><bot id="ejecuta" dim="14,0" brdr="5" text="Aceptar" default="0" OnEnter="Ejecuta()"/>					</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario ,asterisco, rol_usuario;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("s,KDMS");								rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";												if(frn.param(0)&= "")				{					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					frn.open("redirect",2);					return;				}								Inicializa();										}									fun Inicializa(){								var cmd,cubo,ok,mensajeError ;				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"serhistorialorden.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));							}									fun Buscar_datos() {							var xmlRequest,cmd,ok,cuboResultados, totOrd , contOrd, ref_clave, ref_desc;						var inv = frn.get("inventario");								var suc = frn.get("k_sucN", -1, 1);				//buscar pedido				cmd= "select c11,c10,c42 from keplersc.kdpedido " ;				cmd= cmd & " where c1='" & suc & "' and c2='" & inv & "'";													cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cambiatipooperacion.Buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("tipo_operacion",getXmlAtt(cuboResultados,"r0","c11"));				frn.set("asesor",getXmlAtt(cuboResultados,"r0","c10"));				frn.set("coach",getXmlAtt(cuboResultados,"r0","c42"));																//buscar compra				cmd= "select c39 , c16, c41, c40, c42, c9 from keplersc.kdicom " ;				cmd= cmd & " where c1='" & suc & "' and c2='" & inv & "'";													cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cambiatipooperacion.Buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("unidad_traslado",getXmlAtt(cuboResultados,"r0","c39"));				frn.set("modelo",getXmlAtt(cuboResultados,"r0","c16"));				frn.set("asesor_comprador",getXmlAtt(cuboResultados,"r0","c41"));				frn.set("coach_comprador",getXmlAtt(cuboResultados,"r0","c40"));				frn.set("valuador_comprador",getXmlAtt(cuboResultados,"r0","c42"));				frn.set("fecha_compra",getXmlAtt(cuboResultados,"r0","c9"));																//busca fecha factura				cmd = "select c9 from keplersc.kdventas where c1='" & suc  &"' and c2='" & inv  & "' and c10=0 order by c9 desc limit 1 ";								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cambiatipooperacion.Buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("fecha_factura",getXmlAtt(cuboResultados,"r0","c9"));												//busca fecha vale de salida				cmd = "select c7 from keplersc.kdcomismov where c1='" & suc  &"' and c8='" & inv  & "' and c10='0' order by c7 desc limit 1 ";								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cambiatipooperacion.Buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("fecha_vale_salida",getXmlAtt(cuboResultados,"r0","c7"));							}														fun Ejecuta(){							var xmlRequest, cmd, cubo, ok;								xmlRequest= getXml(frn.dataPag()); //Obtener el xml de la pantalla;					frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.cambia_tipo_operacion('<document>" & getXmlStr(xmlRequest,"EOF:13_10") & "</document>')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cambiatipooperacion.Ejecuta()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultados");								var resultado = getXmlAtt(cubo, "r0", "resultado");				var mensaje = getXmlAtt(cubo, "r0" ,"mensaje");								var sms_desc = "Error";				if(resultado &= "1"){					sms_desc = "Aceptar";				}								frn.message(mensaje, sms_desc , "Aceptar");								}													fun bus_inv(){				var cmdQuery = "select c2 as inventario, c3 as modelo, c4 as descripcion, c5 as serie from keplersc.kdinf where c1='"  & frn.get("k_sucN", -1, 1) & "'";             frn.dialog("genlistafiltrosel","Inventarios",cmdQuery,"inventario","inventario","0","0","N","S");           			}									fun bus_tipo_operacion(){				var cmdQuery = "select c1 as clave, c2 as descripcion from keplersc.kdtop "             frn.dialog("genlistafiltrosel","Tipos de Operaciones",cmdQuery,"clave","tipo_operacion","0","0","N","S");			}									fun bus_asesor(campo){				var cmdQuery = "select c2 as clave, c3 as descripcion from keplersc.kduv "             frn.dialog("genlistafiltrosel","Asesores",cmdQuery,"clave",campo,"0","0","N","S");			}									fun bus_coach(campo){				var cmdQuery = "select c1 as clave, c2 as descripcion from keplersc.kdcatcoach "             frn.dialog("genlistafiltrosel","Coaches",cmdQuery,"clave",campo,"0","0","N","S");			}									fun bus_modelo(){				var cmdQuery = "select c1 as clave, c2 as descripcion from keplersc.kdiv "             frn.dialog("genlistafiltrosel","Modelos",cmdQuery,"clave","modelo","0","0","N","S");			}									fun bus_valuador(){				var cmdQuery = "select c1 as clave, c2 as descripcion from keplersc.kdcatval "             frn.dialog("genlistafiltrosel","Valuadores",cmdQuery,"clave","valuador_comprador","0","0","N","S");			}															fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}												//-------------------------------------EXTRAS------------------------------------------								 fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}											}	</script></pag>