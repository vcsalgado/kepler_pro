<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de Cargos Varios" scale="48">	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,16" unfont="0">				<br exe="encabezado"/>		<hLine dim="95,0" g="2" type="1"/>		<br exe="encabezado"/>		<grp dim="15,5,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>			</grp>		<grp dim="60,6,7,12">			<br/>			<inp id="nombreempresa" dim="60,1"  fnt="20b,20b"  type="string" modify="N" brdr="1,0" bclr="255,255,255" just="C"/>			<br/>			<tab n="5"/>			<txt fnt=",20b" clr="0,58,112">Reporte de Cargos Varios </txt>			<br/>			<br exe="encabezado"/>					</grp>		<tab n="1"/>		<grp dim="15,5,7,12">			<tab n="2"/><txt>P&#225;g: </txt>			<inp id="k_pag" dim="5,1" type="number" mcr="k_pag"/><br/><br/><sp/>			<inp id="fecha" dim="10,1" type="date" fmt="DD-MM-CCYY" nc="-1" just="R"/>			<inp id="hora" dim="5,1" type="time" nc="-1" just="R"/>		</grp>		<grp dim="5,5,7,12"/>			<br exe="encabezado"/>			<hLine dim="95,0" g="2" type="1"/>			<br exe="encabezado"/>			<tab/>			<txt fnt=",-1b">Sucursal: </txt>			<tab/>			<inp id="sucursal_id" dim="3,1" type="string"/><sp/>			<inp id="desc_sucursal" dim="30,1" type="string"/>			<br exe="encabezado"/>			<tab/>			<txt fnt=",-1b">Orden: </txt>			<tab n="2"/>			<inp id="tipo_orden" dim="3,1" type="string"/>			<sp n="1"/>			<inp id="num_orden" dim="10,1" type="string"/>			<tab n="3"/>			<txt fnt=",-1b">Marca: </txt>			<tab/>			<inp id="marca" dim="10,1" type="string"/>			<tab n="3"/>			<txt fnt=",-1b">Modelo: </txt>			<sp n="2"/>			<inp id="modelo" dim="15,1" type="string"/>			<br exe="encabezado"/>			<tab/>			<txt fnt=",-1b">Punto: </txt>			<tab n="2"/>			<inp id="punto" dim="10,1" type="string"/>			<br exe="encabezado"/>				<tab/>			<txt fnt=",-1b">Cliente: </txt>			<tab n="1"/>			<inp id="nombre" dim="70,1" type="string"/>			<br exe="encabezado"/>			<tab n="4"/>			<inp id="direccion" dim="50,1" type="string"/>			<br exe="encabezado"/>			<tab n="4"/>			<inp id="colonia" dim="40,1" type="string"/>			<inp id="cp" dim="7,1" type="string"/>			<br exe="encabezado"/>			<br exe="encabezado"/>						<tab n="2"/>			<txt fnt=",-1b">Clave</txt><tab n="8"/>			<txt fnt=",-1b">Descripci&#243;n</txt><tab n="11"/>			<txt fnt=",0b">Importe</txt>			<br exe="encabezado"/>					<hLine dim="95,0" g="2" type="1"/>			<br exe="encabezado"/>			<br exe="producto"/>			<tab n="2"/>			<inp id="cve_cargo" dim="10,1" type="string"/><tab/>			<inp id="desc_cargo" dim="50,1" type="string"/><tab/>			<inp id="importe" dim="10,1" type="number" just="R" nd="2"/>			<br exe="detalle"/> 			<br exe="detalle"/>	 			<tab n="11"/><sp n="2"/>			<hLine dim="60,0" g="2" type="1"/>					<br exe="totalproducto"/>  			<tab n="16"/>			<txt fnt=",-1bi">Total Cargos Varios: </txt><tab n="3"/>			<inp id="tot_cargos" dim="10,1" type="number" just="R" nd="2"/>			<br exe="totalproducto"/>			<br exe="totalproducto"/>			<br exe="totalproducto"/>			<hLine dim="95,0" g="2" type="1"/>			<br exe="totalproducto"/>			<hLine dim="95,0" g="2" type="2"/>				<br exe="totalproducto"/>			<br exe="totalproducto"/>			<br exe="totalproducto"/><tab n="6"/>			<txt fnt=",-1bi">Hecho </txt><sp n="2"/><tab n="5"/>			<txt fnt=",-1bi">Revisado </txt><tab n="5"/><sp n="1"/>			<txt fnt=",-1bi">Autoriz&#243; </txt>			<br exe="totalproducto"/><tab n="7"/><sp n="2"/>			<hLine dim="15,0" g="1" type="1"/><sp/><tab n="2"/>			<hLine dim="15,0" g="1" type="1"/><tab n="2"/>				<hLine dim="15,0" g="1" type="1"/>				<br exe="totalproducto"/>			<br exe="totalproducto"/>			<hLine dim="95,0" g="2" type="1"/>				<br exe="totalproducto"/>			</grp></pag>