<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Cargos Abonos a CXC">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<tab/>	<inp id="titulo_pantalla" clr="0,0,0"  dim="25,1" brdr="0,1" fnt=",22" available="N"/>	<br/>	<tab/><hLine clr="0,0,0"/>	<br/> <br/><tab/>		<grp dim="46,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros"><txt>  Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" tooltip="Sucursal" available="Y" modify="Y"/>			<br/><br/>			<txt>  Tipo :        </txt>			<cmb id="k_tipon" dim="40,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo()" tooltip="Tipo de Movimiento"/>			<br/>			<tab n="4"/><inp id="statusdoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/>		</grp>		<sp/>		<grp dim="34,10,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C"/><tab/> <br/>			<txt id="textFolio" visible="N">  Folio :  </txt>			<edt id="k_folio" dim="30,1" brdr="2,0" bclr="255,255,255"  OnChange="Formar_folio()" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="10" tooltip="Folio ( F9 b&#250;squeda )" modify="Y" available="N" visible="N" OnF9="ObtenerFolio()" 			OnButton="ObtenerFolio()"/>			<sp n="2"/>			<img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="BuscarFolio()" available="Y" clrBrdr="0,0,0" visible="N"/>			 <br/>			<sp n="1"/>			<inp id="k_docto" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="C"/> <br/>			<txt>  Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="Y" tooltip="Fecha"/> 			<sp n="1"/> 			<txt>  Hora : </txt> 			<sp n="1"/> 			<edt id="k_hora" dim="15,1" type="time" nc="-1" bclr="240,240,240"  fmt="HH:MM:SS" available="N"/> 			<br/>		</grp>		<br/>		<br/>		<tab/>		<grp dim="81,12,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Cliente">				<grp dim="38,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">								<sp n="1"/> <txt clr="0,58,112" hk="P">Cliente : </txt><tab/>				<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnF9="ConsultarClientes()" OnF11 = "Dialog(3,cat_cli_crud,Modificar,x,s,k_clave)"	OnChange="BuscarCliente()" OnButton="Dialog(3,cat_cli_view,s,k_clave)"					type="capital" nc="7" tooltip="Seleccionar F9, Modificar F11" modify="Y" hk="C" available="Y"/> 				<br/>				<sp n="1"/> <txt>RFC : </txt><sp n="5"/>				<inp id="k_rfc" clr="64,64,64"  dim="18,1" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>				<br/>			</grp>			<sp n="1"/>			<grp dim="75,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="1,5" fnt="Arial,16">				<sp n="1"/> <txt>Datos del Cliente : </txt>				<br/>				<sp n="1"/>					<inp id="k_nombrecli" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_callecli" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_coloniacli" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>				<br/>				<sp n="1"/>				<inp id="k_poblacioncli" clr="64,64,64" clrBrdr="255,255,255"  dim="50,1" fnt="Arial,16" type="string" modify="N" available="N" nc="50" visible="Y"/>				<sp n="1"/>				<inp id="k_cpcli" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt="Arial,16" type="string" modify="N" available="N" nc="10" visible="Y"/>			</grp>			<br/>					</grp>		<br/>		<br/>			<tab/>					<grp dim="81,27,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" fnt=",0"><tab/>		<tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" 				dim="110,8"  hk="z" Reorder="N" modify="Y"   insdel="Y">			<col id="k_factura" name="Referencia"  type="capital" nc="10" visible="Y" modify="Y" available="Y"/>			<col id="k_documento" name="Documento"  type="number" visible="Y" nc="1" modify="Y" available="Y"/>			<col id="k_monto_factura" name="Monto"  type="number" OnChange="monto()" nd="2"  modify="Y"/>			<col id="k_iva_factura" name="IVA"  type="number" nd="4"  modify="N" visible="Y"/>			<col id="k_vencimiento_factura" name="Vencimiento" type="date"  fmt="DD/MM/CCYY" OnChange="vencimiento()"  modify="Y" visible="Y"/>			</tbl>		<br/>		<tab/>		<grp dim="70,20,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,16" hSpace="4" fnt=",0">				<br/>			<sp/><txt fnt=",">Referencia del documento:  </txt>			<inp id="k_refer" dim="20,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="capital"  fnt=",0" clr="64,64,64" available="y"/>			<br/><txt>  Forma de Pago :</txt>			<inp id="k_forma_pago" clr="64,64,64" dim="6,1"  bclr="246,246,246" visible="Y" fnt="Arial,16"  tooltip="F9 Formas de Pago" OnF9="fromas_de_pago()" type="text" nc="2" modify="N" available="Y"/>						<sp/><txt>Cuenta:</txt>			<inp id="k_cuenta" clr="64,64,64" dim="40,1" visible="Y" fnt="Arial,16" type="string" nc="16" modify="Y" available="Y" bclr="246,246,246"/>		<br/>						<sp/><txt>Correo Electronico:   </txt>			<inp id="k_correo" clr="64,64,64" dim="50,1" visible="Y" fnt="Arial,16" type="string" nc="100" modify="N" available="Y"/>			<br/>							<br/>															<sp/><txt fnt=",">Notas:  </txt>			<inp id="k_coment" dim="61,4" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="capital"  fnt=",0" clr="64,64,64" modify="Y" available="Y"/>						</grp>			<tab n="2"/>		<grp dim="40,20,7,12" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,16" hSpace="4" fnt=",0" clr="64,64,64">			<sp/><txt fnt=",">Subtotal:  </txt>	<tab n="3"/>			<inp id="k_subtotal" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0" clr="64,64,64"/><br/>						<sp/><txt fnt=",">IVA:  </txt>	<sp/>	<tab n="4"/>			<inp id="k_iva" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="6" fnt=",0" clr="64,64,64"/><br/>			<sp/><txt fnt=",">Importe:  </txt>	<tab n="3"/>			<inp id="k_monto" dim="15,1" brdr="2,0" bclr="255,255,255" clrBrdr="255,255,255" type="number" modify="N" just="R" nd="2" fnt=",0b" clr="64,64,64"/><br/>	<br/>	<br/>		<sp n="5"/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>					<sp n="5"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>				</grp>				</grp>								</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario,asterisco, anio_contable;			// Variables de control			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, cliente_id, refer_id, resVal, tabla, estatus_doc ;			var fileSavePath;			//Variables validacion factura			var	str_uuid, fecha_uuid, rfc_uuid, total_uuid;								//Variables de parametros         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd;			var editable; //Se controla si la poliza se puede editar, cancelar o dar de baja				//Porcentajes kdmm			var prc_iva ;			//cont			var presupuesto , saldo, fecha_baja, cargos_factura, abonos_factura, cargos_iva_factura, abonos_iva_factura;			var uen;		fun Main() {			frn=new FRNT;			kdb=new KDB;			rep=new REP;			frP=new FRNTP;			sys=new SYS;			kdb.connect();			kdb.kde("KDE");			kdb.exec();			anio_contable = kdb.get("KDE","14");			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			suc_usuario = frn.lib("libKepler","UserInfo(1)");			asterisco = "*";			fileSavePath = "C:\Basura";			Inicializa();			ConfiguraControlesOpcion();								}				fun ConsultarClientes(){				cmdQuery = "select c2 as clave, c3 as nombre, c10 as rfc from keplersc.kdud order by c2";				frn.dialog("genlistafiltrosel","Catalogo de clientes",cmdQuery,"clave","k_clave","0","0","N","S");					}		//-------------------------CONFIGURACIONES-----------------------					fun Inicializa(){ //Inicializa los valores en Pantalla			// Revisa parametros recibidos			if( frn.nParam() == 7 ){ //Se han mandado parametros a la pagina                gen_doc=trim(frn.param(0));                 nat_doc=trim(frn.param(1));                 gpo_doc=trim(frn.param(2));                tip_doc=trim(frn.param(3));                 tip_ope=trim(frn.param(4));                paramProd=trim(frn.param(5));			} else {				frn.message("Operacion no valida ...", "Mensaje","&Aceptar");				frn.open("redirect",2);				return;			}            			if(tip_ope &= "A"){ //Alta				frn.set("operacion","ALTA");			} else {								if(tip_ope &= "C"){ //Consulta					frn.set("operacion","CONSULTA");				} else {					frn.message("Operacion no valida ...", "Mensaje","&Aceptar");					frn.open("index",4);					return;							}			}									uen=trim(frn.param(6));			if (uen &= ""){				uen="XXX";			}					//Llenar combo sucursales			cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}			}			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_sucn",cuboQuery);								// Fill Combo Tipo (Con Query FTO Kepler) 			LlenaCmbTipo();						frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				frn.set("k_vence",sys.date());							// Fill k_docto | referencia docto			ArmarRefDocto();						if (nat_doc &= "D"){				frn.set("titulo_pantalla", "Cargos CXC");				frn.setAtt("k_mov","visible", "Y", "k_vencimiento_factura");			}else{				frn.set("titulo_pantalla", "Abonos CXC");				frn.setAtt("k_mov","visible", "N", "k_vencimiento_factura");			}							porcentajes_kdmm();		}				fun LlenaCmbTipo(){			// Fill Combo Tipo (Con Query FTO Kepler) 			cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm 							where col_sucursal='" & frn.get("k_sucn",-1,1) & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.Inicializa()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error BD","Aceptar");				return;			}			frn.set("k_tipon",getXml(cuboQuery));		}							// Armado del Docto Referencia		fun ArmarRefDocto {			var cadena = frn.get("k_tipon", -1, 5);			var fol = frn.get("k_folio");			if (tip_ope &! "A" && fol &! ""){				cadena = strSplit(cadena,"-",0) & "-" & fol;			}					frn.set("k_docto", cadena);		}					fun PadLeft(pText,pRelleno,pCaracterRelleno) {			var Resultado;			var pos_ini = pText;			var nReg = strlen(pText);			for (var cont = nReg; cont < pRelleno; cont++) {				Resultado = pCaracterRelleno & Resultado;			}			Resultado = Resultado & pText;                			return Resultado;		}				fun CambiaTipo() {				tip_doc  = frn.get("k_tipon", -1, 4);			porcentajes_kdmm();			borrar_datos();			LimpiaEncabezado();						frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();						}				fun porcentajes_kdmm (){						var cmd, cuboResultados ,ok,mensajeError;								cmd= " select c16 from keplersc.kdmm where col_sucursal='" & frn.get("k_sucn",-1,1) & "' and c1='" & gen_doc & "'" ;							cmd = cmd & " and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4='" & tip_doc & "'";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.porcentajes_kdmm()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				prc_iva = getXmlAtt(cuboResultados , "r0","c16");					}				fun CambiaSucursal() {			sucursal_id = frn.get("k_sucn",-1,1);			LlenaCmbTipo();			CambiaTipo();							}				fun LimpiaEncabezado() {			frn.set("k_folio", "");			frn.set("k_docto", "");			frn.set("k_fecha", "");			frn.set("k_hora", "");			LimpiaDatosCli();			frn.set("k_clave", "");		}				fun borrar_datos(){			frn.rst("k_mov");						frn.set("k_m_pago","");			frn.set("k_forma_pago","");			frn.set("k_cfdi","");			frn.set("k_cuenta","");			frn.set("k_correo","");						frn.rst("k_refer");			frn.rst("k_coment");			frn.set("k_subtotal", 0);			frn.set("k_iva", 0);			frn.set("k_monto", 0);		}				fun BuscarFolio() {			var folio;			folio = frn.get("k_folio");			folio = PadLeft(folio, 7, "0");			ArmarRefDocto();			borrar_datos();			MostrarDatos(folio);								}		fun Cancela() {			CambiaSucursal();			borrar_datos();			Inicializa();			ConfiguraControlesOpcion();		}							fun ConfiguraControlesOff() {							frn.setAtt("textFolio", "visible", "N");			frn.setAtt("k_folio", "available", "N");			frn.setAtt("k_folio", "visible", "N");			frn.setAtt("k_mov", "modify", "N");			frn.setAtt("k_mov", "available", "N", "k_factura");			frn.setAtt("k_clave", "available", "N");			frn.setAtt("k_refer", "available", "N");			frn.setAtt("k_coment","modify", "N");			frn.setAtt("k_coment","available", "N");			frn.setAtt("Cancelar", "visible", "N");			frn.setAtt("Aceptar", "visible", "N");			frn.setAtt("buscar_datos", "visible", "N");													}						fun ConfiguraControlesOpcion() {						ConfiguraControlesOff();			if(tip_ope &= "A"){ //Alta				frn.setAtt("k_clave", "available", "Y");				frn.setAtt("k_refer", "available", "y");				frn.setAtt("k_mov", "modify", "Y");				frn.setAtt("k_mov", "available", "Y", "k_factura");				frn.setAtt("k_coment","modify", "Y");				frn.setAtt("k_coment","available", "Y");				frn.setAtt("k_fecha", "available", "Y");	//MSS Habilitar fecha				frn.setAtt("Cancelar", "visible", "Y");				frn.setAtt("Aceptar", "visible", "Y");												} else {				if(tip_ope &= "B"){ //Baja									frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");							frn.setAtt("Aceptar", "visible", "Y");						frn.setAtt("buscar_datos", "visible", "Y");											frn.setAtt("k_fecha", "available", "Y");	//MSS Habilitar fecha					frn.setAtt("k_coment","modify", "N");					frn.setAtt("k_coment","available", "Y");				} else {					if(tip_ope &= "C"){ //Consulta						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");											frn.setAtt("buscar_datos", "visible", "Y");								frn.setAtt("k_coment","modify", "N");						frn.setAtt("k_coment","available", "Y");					} else {						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");						frn.setAtt("k_fecha", "available", "Y");						frn.setAtt("k_hora", "available", "Y");						frn.setAtt("k_coment","modify", "N");						frn.setAtt("k_coment","available", "Y");					}					}			}		}						//------------------------------CLIENTE-----------------------			fun BuscarCliente(){			var xmlCli;											sucursal_id = frn.get("k_sucn",-1,1);			cliente_id = frn.get("k_clave");			LimpiaDatosCli();			borrar_datos();								if (strlen(frn.get("k_clave")) == 0) {				return;			}							if (strlen(frn.get("k_refer")) > 0) {				refer_id = frn.get("k_refer");			}							cmdQuery = "select c10 as k_rfc, c3 as k_nombrecli, c4 as k_callecli, c5 as k_coloniacli, c6 as k_poblacioncli, c27 as k_cpcli, c16 as k_plazo, c52 as k_m_pago, c53 as k_cfdi, c11 as k_correo " &									"from keplersc.kdud where c2='" & cliente_id & "'" ;			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.BuscarCliente()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.setPos("k_clave");				frn.message("El cliente no existe","Error","Aceptar");				frn.rst("k_clave");				return;				}			//Plazo();				rstXml(xmlCli);			xmlCli=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");			frn.setX(xmlCli);									}				fun LimpiaDatosCli() {			frn.set("k_rfc", "");			frn.set("k_nombrecli", "");			frn.set("k_callecli", "");			frn.set("k_coloniacli", "");			frn.set("k_poblacioncli", "");			frn.set("k_refer", "");			frn.set("k_cpcli", "");		}			//-----------------------------------GRID----------------------------					fun vencimiento(){					var vencimiento = frn.get("k_mov", -1, "k_vencimiento_factura");				if ( fnDate("cmp",vencimiento ,sys.date()) &= -1 ){							frn.message("La fecha de vencimiento no puede ser menor al dia de hoy","Error","Aceptar");				frn.setX("", "k_mov", -1, "k_vencimiento_factura");				return;						}					}			fun monto(){					cliente_id = frn.get("k_clave");			if (strlen(cliente_id ) == 0){				borrar_datos_factura();				frn.message("Debes Seleccionar un Cliente antes","Error","Aceptar");				return;			}						var monto_factura = frn.get("k_mov", -1, "k_monto_factura");			if (monto_factura <= 0){				frn.message("No se puede dejar el monto en 0s","Error","Aceptar");				return;			}					iva();				}						fun iva(){						var monto = frn.get("k_mov", -1, "k_monto_factura");					frn.setX(monto * (1-(1/(1+prc_iva/100))) ,"k_mov", -1, "k_iva_factura");						CalcTotal();		}				fun CalcTotal() { 					var monto_facturas =0, iva_facturas=0; 							for (var i=0,n=frn.N("k_mov")-1;i<n;i++) { 				monto_facturas=monto_facturas +frn.get("k_mov",i,"k_monto_factura");				iva_facturas=iva_facturas+frn.get("k_mov",i,"k_iva_factura");			}						frn.set("k_subtotal", monto_facturas - iva_facturas, "k_iva" ,iva_facturas, "k_monto", monto_facturas);				}				fun borrar_datos_factura(){			frn.setX("", "k_mov", -1, "k_factura");			frn.setX("", "k_mov", -1, "k_documento");			frn.setX("", "k_mov", -1, "k_monto_factura");			frn.setX("", "k_mov", -1, "k_iva_factura");			frn.setX("", "k_mov", -1, "k_vencimiento_factura");				}				//---------------------------------------EJECUTA---------------------------------			fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			var resultado, mensaje, folio;							fecha = sys.date();			hora= sys.time();							if (tip_ope &= "A") {							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;				ValidarDatos();				if(ok &! "1" || resVal == 0){					return;				}								continua = frn.message("Desea continuar con la alta?","Atenci?n",2);				if (continua == 0){					return;				}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;															setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov") -1);				setXml(xmlPantalla,"k_tabla_mov","kdm5");				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"k_f_pago","r1",frn.get("k_forma_pago"));									frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCargosCXC");				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cuboQuery);				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srv_cheque_crud.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudCheque");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					tip_ope = "C";					frn.set("k_folio", mensaje); 					frn.set("operacion", "CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto", strTmp);					strMsg = "El Folio utilizado para esta operacion fue : " & mensaje;					ConfiguraControlesOpcion(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");					MostrarDatos(folio);						//BuscarFolio();				} else {					frn.message(mensaje, "Error", "Aceptar");				}						}						}				//Validacion Datos Generales y Partidas antes de Guardar.		//El resultado de cada validacion se guarda en la variable global resVal.		fun ValidarDatos() {			var totReg, strTotal=0,subTotal=0, iva=0, total=0, renglones, str;			//Obtener variables			sucursal_id = frn.get("k_sucn",-1,1);			cliente_id = frn.get("k_clave");			refer_id = frn.get("k_refer");										//Validar Cliente			cmdQuery="SELECT count(*) as totreg from keplersc.kdud where c2 = '" & cliente_id & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("El Cliente no existe.","Error","Aceptar");				resVal=0;				return;			}			//Validar Referencia			if (refer_id &= ""){				frn.setPos("k_refer");				resVal=0;				frn.message("Es necesario seleccionar la referencia","Error","Aceptar");				return;			}					var nreg = frn.N("k_mov")-1;//cuantos renglones hay			if(nreg ==0){				frn.message("No es posible dar de alta Cargos sin facturas. Favor de verificar", "Error","&Aceptar");				resVal=0;return;			}					for(var i=0; i<nreg; i++){							var fac = frn.get("k_mov",i,"k_factura");				var fac_monto = frn.get("k_mov",i,"k_monto_factura");				var factura_numero = i +1 ;				if (strlen(fac) == 0){					frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : No se especifica la Factura" ,"Error","&Aceptar");					frn.setPos("k_mov",-1,"k_factura");					resVal=0;return;				}				var num_doc = frn.get("k_mov",i,"k_documento");				if (num_doc  &= ""){					frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : No se especifica el documento de la Factura" ,"Error","&Aceptar");					frn.setPos("k_mov",-1,"k_documento");					resVal=0;return;				}				if (strlen(fac_monto) == 0 || fac_monto == 0){					frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : No se especifica el monto de la Factura" ,"Error","&Aceptar");					frn.setPos("k_mov",-1,"k_monto_factura");					resVal=0;return;				}																						if (nat_doc &= "A"){									//Validar Cliente					cmdQuery="SELECT c6,c7 from keplersc.kduxg where c1 = '" & sucursal_id & "' and c2='" & gen_doc &  "' and c3='" & cliente_id  & "' and c4='" & fac  & "' and c5='" & num_doc & "'";					rstXml(cuboQuery);									cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cargos_abonos_a_cxc.ValidarDatos()");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}									if (nXml(cuboQuery) == 0 ){						frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : No existe la referencia seleccionada para el cliente." ,"Error","&Aceptar");						resVal=0;						return;					}										var cargos = getXmlAtt(cuboQuery, "r0","c6");					var abonos = getXmlAtt(cuboQuery, "r0","c7");										if (fac_monto + abonos > cargos ){						frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : No se puede cobrar mas del saldo de la factura" ,"Error","&Aceptar");						resVal=0;						return;					}													}else{									if ( frn.get("k_mov",i,"k_vencimiento_factura") &= "" ){						frn.message("Se ha generado el siguiente error en la factura " & factura_numero  & " : No se especifica el vencimiento de la Factura" ,"Error","&Aceptar");						frn.setPos("k_mov",-1,"k_vencimiento_factura");						resVal=0;return;					}								}											}						//Validar Fortma de pago			cmdQuery="SELECT count(*) as totreg from keplersc.kdf3fp where c1 = '" & frn.get("k_forma_pago") & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cargos_abonos_a_cxc.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("La Forma de Pago es invalida","Error","Aceptar");				resVal=0;				return;			}											} // End ValidarDatos()						//-----------------------CONSULTA----------------------------				fun ObtenerFolio() {			sucursal_id = frn.get("k_sucn",-1,1);			cmdQuery = "select c6 as folio, to_char(c9, 'DD/MM/YYYY') as fecha, c10 as cve_cliente, " &						"c11 as factura, c16 as monto, c43 estatus " &						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc & " order by c6 desc ";									frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryfoliomov");							frn.dialog("genlistafiltrosel","Movimientos",cmdQuery,"folio","k_folio","0","","S");					}								fun MostrarDatos(nFolio) {					var cmd,xmlRequest,xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError,   ;						sucursal_id = frn.get("k_sucn",-1,1);					cmd= " select c10 as k_clave, c9 as k_fecha,c11 as k_refer ,c69 as k_hora , c24 as k_coment, c43 as estatus_doc , c197 as fecha_baja, c160 as k_forma_pago, c161 as k_cuenta, c162 as k_m_pago, c164 as k_cfdi " ;						cmd = cmd & " from keplersc.kdm1 where c1='" & sucursal_id  & "' and c2='" & gen_doc  &"' and c3='" & nat_doc & "' and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cheque_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			var xml_kdm1  = getXml(cuboResultados,"r0" );			//frn.setX(cuboResultados ); TODO, checar setX			frn.set("k_clave",getXmlAtt(xml_kdm1  ,"k_clave") );			BuscarCliente();					frn.set("k_fecha",getXmlAtt(xml_kdm1 ,"k_fecha") );			frn.set("k_hora",getXmlAtt(xml_kdm1  ,"k_hora") );			frn.set("k_coment",getXmlAtt(xml_kdm1   ,"k_coment") );			frn.set("k_refer",getXmlAtt(xml_kdm1  ,"k_refer") );										frn.set("k_cuenta",getXmlAtt(xml_kdm1   ,"k_cuenta") );			frn.set("k_m_pago",getXmlAtt(xml_kdm1  ,"k_m_pago") );			frn.set("k_forma_pago",getXmlAtt(xml_kdm1   ,"k_forma_pago") );				frn.set("k_cfdi",getXmlAtt(xml_kdm1  ,"k_cfdi") );									fecha_baja = getXmlAtt(xml_kdm1  ,"fecha_baja");						estatus_doc = getXmlAtt(xml_kdm1  ,"estatus_doc");							if (estatus_doc &= "C"){	// C=Cancelado				frn.message("El Documento se encuentra cancelado","Error","Aceptar");				frn.set("statusdoc", "CANCELADO");			}else{				frn.set("statusdoc", "");			}			rstXml(cmd);							cmd = "select c14 as k_factura,c16 as k_documento, c12 as k_monto_factura,c13 as k_iva_factura, c15 as k_vencimiento_factura from keplersc.kdm5 where c1='" & sucursal_id & "' and c2='" & gen_doc &"' and c3='" & nat_doc & "'";			cmd = cmd & " and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_cheque_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}						frn.setX(cuboResultados , "k_mov");			CalcTotal();						ArmarRefDocto();													} //End MostrarDatos()								fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;								setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));							setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);		}												//--------------------------EXTRAS--------------------------------						fun fromas_de_pago(){					cmdQuery = "select c1 as clave, c2 as descripcion from keplersc.kdf3fp ";			frn.dialog("genlistafiltrosel","Formas de Pago",cmdQuery,"clave","k_forma_pago","0","","S");					}											fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    			1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 			2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 			3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			// var tip_ope; 			var tip_oper;			if(iModo==0)				page=pag; 			else if(iModo==2&&(strlen(par0)>0)){				//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       				if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 				if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;			}			else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     		}																				} // End of class Main	</script></pag>