<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Generaci&#243;n Archivo PLD">	<grp dim="1,-1,10,20" brdr="0,0" bclr="192,205,213" clr="0,58,112" fnt="Arial,16" unfont="0" OnF1="Ventana(rep_Hlp)"><br/>	<tab n="1"/>	<txt fnt=",22" clr="0,0,0">Generaci&#243;n de Archivo PLD</txt><br/><tab/>	<hLine dim="0,1" clr="0,0,0"/> 	<br/> 	<br/><tab n="1"/>		<grp dim="50,25,10,5" bclr="236,240,243" tit="Criterio de proceso" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">			<grp dim="70,41,10,5" bclr="236,240,243" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">				<sp/>				<txt>Sucursal</txt><tab n="1"/>				<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="24,1" bclr="254,254,254" brdr="0,0" fnt="Arial,16" Null="N" hk="S"  					available="Y" modify="Y"/>					<br/>					<sp/><txt>    Fecha Inicial:</txt>			<edt id="k_fecha_ini" dim="8,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213"				type="date" modify="Y" available="Y" fnt="Arial,16" OnF9="Dialog(3,_ks_fecha,k_fecha_ini)" page="_ks_fecha,k_fecha_ini" fmt="DD/MM/CCYY" nc="-1"/><tab/>			<txt>Fecha Final:</txt>			 <edt id="k_fecha_fin" dim="8,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213"				type="date" modify="Y" available="Y" fnt="Arial,16" OnF9="Dialog(3,_ks_fecha,k_fecha_fin)" page="_ks_fecha,k_fecha_fin" fmt="DD/MM/CCYY" nc="-1"/><tab/>				<img id="Ejecutar" dim="40,40" bPx="Y" brdr="0,1" img="_60_DocNew.png" OnEnter="Ejecuta()"  available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Ejecutar proceso definitivo"/>				</grp>		</grp>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys, year, usuario,suc_usuario,rol_usuario,asterisco  ;			var cubo, ok, cmd, mensajeError, xmlRequest, xmlPantalla;						fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;				kdb.connect();				suc_usuario = frn.lib("libKepler","UserInfo(1)");				rol_usuario = frn.config("user","role");				asterisco = "*";				Inicializa();			}						fun valida(){			}			fun Inicializa(){//Inicializa los valores en Pantalla				year=sys.date("year");								frn.set("k_fecha_ini",sys.date(year,sys.date("month"),1));				frn.set("k_fecha_fin",sys.date(year,sys.date("month"),31));				IniCombos();			}									fun IniCombos(){            				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_genera_pld.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));						}						fun Ejecuta(){//Prepara datos del reporte 				var sucursal_id, fecha_ini,fecha_fin;				var cuboMovtos,tmpCubo,registros,tmpStr,resultado,mensaje; 				fecha_ini = frn.get("k_fecha_ini");				fecha_fin = frn.get("k_fecha_fin");								if (fnDate("dif",fecha_fin,fecha_ini ) < 0) {					frn.message("La Fecha final debe ser mayor a la Fecha inicial","Error","Aceptar");					return 0;				}				if (frn.message("¿Desea continuar con la Generación del archivo PLD?","Confirmación",2)==0){						return;				}								xmlPantalla = getXml(frn.dataPag());				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaPLD");												cmd="SELECT * FROM keplersc.pld_crea_archivo('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdArchivoPLD");								cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_genera_pld.Ejecuta()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\ArchivoPLD");												ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				resultado= getXmlAtt(cubo,"r0","resultado");				mensaje= getXmlAtt(cubo,"r0","mensaje");								if(resultado &= "1"){					frn.message("Archivo Generado","Mensaje","Aceptar");				}else{					frn.message(mensaje, "Error","&Aceptar");				}			}		}	}	</script></pag>