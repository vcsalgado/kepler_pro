<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Libreria">	<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,20" bclr="192,205,213"><br/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="70,50,7,12" brdr="0,5" tit="Datos generales" fnt="Arial,16"><br/>		</grp><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,sys;			var bConect;//Bandera que indica si ya está conectado o no.			fun Main() {				frn=new FRNT;//Solo para frn.message, no se puede modificar objetos gráficos de la ventana principal				kdb=new KDB;				sys=new SYS;				bConect=0;				//Esta rutina se ejecuta solo la primera vez que se manda llamar alguna función de la librería. 			}						fun Conexion(){//Cuando se quiera accesar a base de datos, ejecutar esta función, antes de cualquier cosa. 				if(bConect==0){kdb.connect();bConect=1;}			}						fun Alta_Invr(M8,M52,M83,M84){				if(M8 &! "S" && M52 &! "S"){				}			}/*			 SUB ALTA_INVR  'ESTA FUNCION INGRESA AL INVENTARIO MOVIMIENTOS  'LOS MOVIMIENTOS SIEMPRE SON INGRESADOS COMO ORIGINALES NUNCA  'CON REEMPLAZOS  'TE PONDERA AUTOMATICAMENTE LOS CAMPOS A51...A53  IF M8="S" AND M52><"S" AND M83><"S" AND M84><"S" THEN    OPEN(H,KDINI,I,KDINR,J,KDINL,K,KDINK,L,KDINM)    N2=0    FOR N1=1 TO NMOV: IF DMOV(N1,1)><"" THEN N2+=DMOV(N1,3): ENDIF: NEXT    B10012=SUM(A51...A53)/N2:    N2=1    FOR N1=1 TO NMOV     IF DMOV(N1,1)><"" THEN      A(B10040)=DMOV(N1,1): CALL BUSCA_PRODUCTO      IF A2="X" OR A2="N" THEN        B10010=DMOV(N1,6): B10010+=(B10012*DMOV(N1,3))      ENDIF      IF A2="U" THEN        IF BUS(J,1,0,A1,H1)>0 THEN         B10010=((J8-J9)/(J5-J6))*DMOV(N1,3)         IF B10010=0 THEN B10010=J14*DMOV(N1,3): ENDIF'EN EL CASO DE VENTAS O DEVOLUCIONES Y QUE COSTO PROMEDIO SEA 0 LOS INGRESA CON ULTIMO COSTO        ELSE         B10010=0        ENDIF      ENDIF      INS(L,A1,H1,A9,A91,A2...A6,N2,DMOV(N1,3),B10010,1)      CALL ALTA_K      N2+=1     ENDIF    NEXT    CLOSE(H,I,J,K,L)  ENDIF ENDSUB			*/																								fun libCalculaEdad(fecNacimiento,fecReferencia){//Calcula la edad de una persona. 				//El parámetro fecReferencia es opcional. Si se omite considera la fecha actual.				if(fecReferencia&="")fecReferencia=sys.date();				var edad=fnDate("year",fecReferencia)-fnDate("year",fecNacimiento);				if( (fnDate("month",fecReferencia) < fnDate("month",fecNacimiento)) || (fnDate("month",fecReferencia)==fnDate("month",fecNacimiento)&& fnDate("day",fecReferencia) < fnDate("day",fecNacimiento)) )					edad--;				return edad;			}			fun libAnioTrabajo(){ //Devuelve el año a trabajar de la sesión actual				var anio;				if(frn.config("temp","k_workDate")){					anio=frn.config("temp","k_workYear");				}else{					Conexion();					kdb.kde("KDE");					kdb.exec();					anio=trim(kdb.get("KDE",14));					if(anio>=70)anio+=1900;					else anio+=2000;				}				return anio;			}						//funciona para crear el archivo xml para la cita en Outlook			fun CreaRegistroOutlook(asunto,fIni,hIni,fFin,hFin,comentarios,com2,com3,archivo){				var citaXml="";				var fechai=fIni;				var fechaf=fFin;				var horai=mid(hIni,0,2) & mid(hIni,3,2) & "00"; if (mid(hIni,3,2) &="") { horai=horai & "00"; }				var horaf=mid(hFin,0,2) & mid(hFin,3,2) & "00"; if (mid(hFin,3,2) &="") { horaf=horaf & "00"; }				var fechaActual=sys.date();				var mesI=fnDate("month",fechai); if (mesI<=9) { mesI="0"&mesI; }				var mesF=fnDate("month",fechaf); if (mesF<=9) { mesF="0"&mesF; }				var diaI=fnDate("day",fechai); if (diaI<=9) { diaI="0"&diaI; }				var diaF=fnDate("day",fechaf); if (diaF<=9) { diaF="0"&diaF; }				setXml(citaXml,"r0","BEGIN:VCALENDAR"); 				setXml(citaXml,"r1","CALSCALE:GREGORIAN");				setXml(citaXml,"r2","METHOD:PUBLISH");				setXml(citaXml,"r3","BEGIN:VEVENT");				setXml(citaXml,"r4","DTSTAMP:" & fnDate("year",fechaActual) & fnDate("month",fechaActual) &  fnDate("day",fechaActual));				setXml(citaXml,"r5","LAST-MODIFIED"  & fnDate("year",fechaActual) & fnDate("month",fechaActual) &  fnDate("day",fechaActual)); //:20090304T090405\#013";				setXml(citaXml,"r6","CREATED: "  & fnDate("year",fechaActual) & fnDate("month",fechaActual) &  fnDate("day",fechaActual)); //20090304T090405\#013";				setXml(citaXml,"r7","SEQUENCE:");				setXml(citaXml,"r8","ORGANIZER:MAILTO:servidor@kepler.com.mx");				setXml(citaXml,"r9","DTSTART:"  & fnDate("year",fechai) & mesI &  diaI & "T" & horai); //20090309T183000\#013";				setXml(citaXml,"r10","DTEND:" & fnDate("year",fechaf) & mesF &  diaF & "T" & horaf); //20090310T191500\#013";				setXml(citaXml,"r11","UID:servidor@kepler.com.mx");				setXml(citaXml,"r12","SUMMARY:" & asunto);				setXml(citaXml,"r13","LOCATION:" & com2);				setXml(citaXml,"r14","URL:http://www.kepler.com.mx");				setXml(citaXml,"r15","DESCRIPTION:'" & comentarios & "'"); //cita de prospecto kepler\#013";				setXml(citaXml,"r16","CLASS:PUBLIC");				setXml(citaXml,"r17","CATEGORIES:");				setXml(citaXml,"r18","STATUS:CONFIRMED");				setXml(citaXml,"r19","PARTSTAT:NEEDS-ACTION");				setXml(citaXml,"r20","END:VEVENT");				setXml(citaXml,"r21","END:VCALENDAR");				var ruta="_"&archivo;//"c:\crmkepler.ics"; //Nombre del archivo				//Escribe el archivo en la maquina cliente				Conexion();				kdb.file("datExistente,list,'" & ruta & "'"); 				kdb.exec(); 				var cmd="datFile,write,'" & ruta & "',EOL:13_10";//Se puede agregar: ",append" para agregar el texto a un archivo ya existente				kdb.file(cmd,citaXml);				kdb.exec(); 				if(kdb.get("datFile","ok")) { return 1; }				else { return 0; }			}							fun Triggers(gen,nat,gpo,tip,reporte,pagina)			{				Conexion();				//Obtiene la informacion que se requiere				var docto=getXml(pagina,"k_docto");				var descDocto=getXml(pagina,"k_tipoN");				var nombre=getXml(pagina,"k_datCve");				var asuntoMsj="Documento: " & descDocto & "," & docto;				//Obtiene el usuario				var userasig=frn.config("user","name"); 				userasig=strFormat("ucase",userasig);				//Busca en la BD de triggers				kdb.open("h,kdtriggers,l,kdmensajes,u,\\\\kdku");				kdb.lim("h1='" & gen & "'");				kdb.lim("h2='" & nat & "'");				kdb.lim("h3='" & gpo & "'");				kdb.lim("h4='" & tip & "'");				kdb.rel("u1=h5");				kdb.table("datejec,h,1,&,h5...h20,u9"); 				kdb.exec();				var nReg=kdb.N("datejec");				var mensaje;				var destinatario;				var userDirig;				var banderaM=1,banderaC=1;				var operador;				var valor;				for (var i=0;i<nReg;i++){					destinatario=kdb.get("datejec","r"&i,"u9");					userDirig=kdb.get("datejec","r"&i,"h5");					mensaje=kdb.get("datejec","r"&i,"h9") & "\#013" & "Datos Generales: '" & nombre;					//Revisa si existe filtro por monto					if (kdb.get("datejec","r"&i,"h10")&="S"){						banderaM=0;						operador=kdb.get("datejec","r"&i,"h11");							valor=kdb.get("datejec","r"&i,"h12");						var monto=getXml(pagina,"k_monto");						if (operador &= "=") { if (monto==valor) { banderaM=1;}}						else if (operador &= ">") { if (monto > valor) { banderaM=1;}}						else if (operador &= "<") { if (monto < valor) { banderaM=1;}}						else if (operador &= ">=") { if (monto >= valor) { banderaM=1;}}						else if (operador &= "<=") { if (monto <= valor) { banderaM=1;}}						else if (operador &= "&=") { if (monto &= valor) { banderaM=1;}}						else if (operador &= "&!") { if (monto &! valor) { banderaM=1;}}					}					//Revisa si existe filtro por Clave					if (kdb.get("datejec","r"&i,"h13")&="S"){						banderaC=0;						operador=kdb.get("datejec","r"&i,"h14");							valor=kdb.get("datejec","r"&i,"h15");						var clave=getXml(pagina,"k_clave");						if (operador &= "=") { if (clave == valor) { banderaC=1;}}						else if (operador &= ">") { if (clave > valor) { banderaC=1;}}						else if (operador &= "<") { if (clave < valor) { banderaC=1;}}						else if (operador &= ">=") { if (clave >= valor) { banderaC=1;}}						else if (operador &= "<=") { if (clave <= valor) { banderaC=1;}}						else if (operador &= "&=") { if (clave &= valor) { banderaC=1;}}						else if (operador &= "&!") { if (clave &! valor) { banderaC=1;}}					}					if (banderaM==1&&banderaC==1){						//Envia el correo solo si debe hacerlo						if (kdb.get("datejec","r"&i,"h6")&="S")							//frn.dialog("utilSendMail",asuntoMsj,destinatario,mensaje,"servidor@kepler.com.mx",reporte,"26","mail.kepler.com.mx","servidor@kepler.com.mx","server123");							frn.dialog("utilSendMail",asuntoMsj,destinatario,mensaje);						//Adicionalmente manda un mensaje al usuario que corresponde						//Primero obtiene el folio que sigue						kdb.iov("GET,FMENSAJE,a1,$,datos,$,1");kdb.exec();                  var fol=kdb.get("datos","a1");						var cmd="kdmensajes,1,'" & fol & "',&";						cmd=cmd & ",1,'" & fol&"'";						cmd=cmd & ",2,'SERVIDOR'";						cmd=cmd & ",3,'" & sys.date()&"'";						cmd=cmd & ",4,'" & sys.time()&"'";						cmd=cmd & ",5,'" & userDirig&"'";						cmd=cmd & ",6,'" & sys.date()&"'";						cmd=cmd & ",7,'" & mensaje &"\#013" & asuntoMsj&"'";						kdb.update(cmd);kdb.exec();					}				}			}		}	</script></pag>