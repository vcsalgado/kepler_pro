<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Error">	<grp dim="1,-1,10,20" brdr="2,1" clr="0,0,0" bclr="192,205,213"><br/><sp/>		<grp dim="32,6,10,20" tit="Error" clr="0,0,0" clrBrdr="75,75,75" bclr="236,240,243" brdr="0,5" fnt=",18b"><br/><sp/><txt>Servidor o p&#225;gina no encontrada</txt><br/><br/><tab n="3"/>			<bot id="but" dim="15,0" text="Regresar" default="1" brdr="5,0" OnEnter="goToIni()"/><br/>		</grp>	</grp>	<script>		class Main {			var frn,kdb;			fun Main() {				frn=new FRNT;			}						/*====================				Descripcion: llena un combo de forma manual a partir de un cubo				Parametros> cuboResultados,cmb(combo)				Autor: Luis Leal 				Fecha: 07/Jul/2022			====================				*/						fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}						/*====================				Descripcion: elige un valor del combo basandose en el número de posición(columna) que se mande 				Parametros> combo, posición en la que se quiere buscar, valor				Autor: Luis Leal 				Fecha: 07/Jul/2022			====================				*/			fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}		}	</script></pag>