<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Catalogo Tab"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="66,40,10,10" brdr="0,5" tit="Catalogo Tab" fnt="Arial,16">					<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" OnEnter="Exit" OnMouseD="Exit" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="60,22" modify="N" nren="fijo">		<col id="clave" name="Clave"/>		<col id="descr" name="Descripcion"/>		<col id="horas" name="Horas"/>				</tbl> 		<tab n="7"/>		<br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,marca,modelo;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								marca=trim(frn.param(0)); 				modelo=trim(frn.param(1)); 							Inicializa();					}											fun Inicializa() {							var xmlRequest,cmd,ok,cuboResultados, totOrd , contOrd, ref_clave, ref_desc;				cmd= "select c3 as clave,c4 as descr,c5 as horas from keplersc.kdtab where c1='" & marca & "' and c2='" & modelo & "'";							cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_tab.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.setX(cuboResultados,"tabla");								}						fun Exit(){								frP.setX( frn.get("tabla", -1, "clave"),"tabla_horas",-1,"clave_horas"); 				frP.scriptElm("tabla_horas","OnChange","clave_horas");								frP.setX( frn.get("tabla", -1, "descr"),"tabla_horas",-1,"descripcion_horas"); 				frP.scriptElm("tabla_horas","OnChange","descripcion_horas");								frP.setX( frn.get("tabla", -1, "horas"),"tabla_horas",-1,"horas"); 				frP.scriptElm("tabla_horas","OnChange","horas");				frn.exit();							}						}	</script></pag>