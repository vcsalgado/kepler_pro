<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Cargos Varios">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<grp id="grupo_crud" dim="50,20,20,10" bclr="236,240,243" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Nuevo"><tab/>			<txt id="text_id">Clave:</txt>			<tab n="2"/>			<inp id="k_clave" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  available="Y" type="capital" nc="5"/>			<br/>			<tab/>			<txt>Descripcion:</txt>			<tab/>			<inp id="k_descrip" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" available="Y" type="capital"/><br/>			<tab/>			<txt>Precio:</txt>			<tab/>			<inp id="k_precio" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" available="Y" type="number"/><br/>			<tab/>			<br/>			<tab/>			<bot id="btn_aceptar" dim="5,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/><br/>					</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP,externo,accion, clave;			var NUEVO,MODIFICAR,CONSULTAR,ELIMINAR;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();				//Constantes				NUEVO="N";				MODIFICAR="M";				CONSULTAR="C";				ELIMINAR="E";								//Parametros				if (frn.nParam() < 2){					frn.message("Acción no permitida.","Error","&Aceptar");					frn.open("redirect",2);					return;				}								accion = frn.param(0);					clave = frn.param(1);							ctlrs_off();				llenar_ctlrs_default();			}						fun ctlrs_off(){				frn.setAtt("k_clave", "available", "N" );				frn.setAtt("k_descrip", "available", "N" );				frn.setAtt("k_precio", "available", "N" );			}							fun llenar_ctlrs_default(){				frn.rst("grupo_crud");				var xmlRequest,cmd,ok, cuboResultados, k_clave;																				llenar_cmb(clave);								k_clave = frn.param(1);									if (accion &= MODIFICAR){					frn.setAtt("grupo_crud","tit","Modificar");					frn.setAtt("btn_aceptar", "available", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );					frn.setAtt("k_descrip", "available", "Y" );					frn.setAtt("k_precio", "available", "Y" );				}						if (accion &= NUEVO){					frn.setAtt("grupo_crud","tit","Nuevo");					frn.setAtt("btn_aceptar", "available", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );					frn.setAtt("k_clave", "available", "Y" );					frn.setAtt("k_descrip", "available", "Y" );					frn.setAtt("k_precio", "available", "Y" );				}								if (accion &= CONSULTAR){					frn.setAtt("grupo_crud","tit","Consultar");					frn.setAtt("btn_aceptar", "available", "N" );					frn.setAtt("btn_aceptar", "visible", "N" );				}				if (accion&= ELIMINAR){					frn.setAtt("grupo_crud","tit","Eliminar");					frn.setAtt("btn_aceptar", "available", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );				}							}										fun Execute() {				var xmlRequest,cmd,cuboResultados,ok,cmd,cubo, mensajeError, k_descrip, k_precio, k_clave, nueva_clave, nueva_desc;				var resultado_confirmacion = frn.message("¿Estas seguro?","Mensaje de Confirmacion","Aceptar");									if (resultado_confirmacion &! 1)  {					return;				}						if (accion &= NUEVO || accion &= MODIFICAR) {	//CAMBIAR CAMPOS EN PATANLLA Y AQUI 					k_clave = frn.get("k_clave");					k_descrip = frn.get("k_descrip");					k_precio = frn.get("k_precio");					var sms =  "";					if (accion &= NUEVO){  // CMD DE CREACION DE REGISTROS						if (k_clave &= ""){ 							sms = "La clave no puede estar en blanco";						}else{							cmd= "insert into keplersc.kdcartall (c1, c2, c3)							values ('"& k_clave &"', '"& k_descrip &"', '"& k_precio &"')";							frn.lib("libGeneral.kpl","EjecutarSql",cmd,"cat_crud_varios.Execute()");							sms = "Nuevo registro agregado";							}					}else { // CMD DE ACTUALIZACION DE REGISTROS						cmd = "update keplersc.kdcartall 						set c2 = '"& k_descrip &"' , c3 ='"&k_precio&"'						where c1 = '"& k_clave &"'";						frn.lib("libGeneral.kpl","EjecutarSql",cmd,"cat_crud_varios.Execute()");						sms = "Registro modificado";					}					frn.message(sms ,"Mensaje","Aceptar");					frn.exit();					}								if (accion &= ELIMINAR){ //CMD DE ELIMINACION DE REGISTROS					k_clave = frn.get("k_clave"); 					cmd = "delete from keplersc.kdcartall where c1='"& k_clave &"'";						frn.lib("libGeneral.kpl","EjecutarSql",cmd,"cat_crud_varios.Execute()");							frn.message("Registro eliminado","Mensaje","Aceptar");					frn.exit();					}				frP.script("Inicializa()");			}						fun llenar_cmb(clave){ //CMD DE LLENADO DE CAMPOS EN LA VENTANA				var strQuery, cuboXml, ok, cuboQuery, xmlDesdeAtt;				strQuery = "select c1 as k_clave,								c2 as k_descrip,								c3 as k_precio								from keplersc.KDCARTALL 								where  c1  = '"& clave &"'";															cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",strQuery,"cat_crud_varios.llenar_cmb()");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cuboXml,"native3");						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}					frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\cuboPrueballeado");				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",strQuery,"cat_crud_varios.llenar_cmb()");				xmlDesdeAtt=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");				frn.lib("libGeneral.kpl","FileSave",xmlDesdeAtt, "C:\Basura\cuboPruebaatt");				frn.setX(xmlDesdeAtt);								}				}								}	</script></pag>