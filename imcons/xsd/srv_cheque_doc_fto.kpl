<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de " scale="48">	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,16" unfont="0">			<br exe="encabezado"/>		<!-- dim="90,0" -->		<!-- dim="120,0" -->		<hLine dim="90,0" g="2" type="1"/>		<br exe="encabezado"/>				<grp dim="15,5,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>				<!-- dim="60,7,7,12" -->		<!-- dim="90,9,7,12" -->		<grp dim="60,9,7,12">			<br/>			<!-- dim="70,1" -->			<!-- dim="120,1" -->			<inp id="nombreempresa" dim="80,1" fnt="20b,20b" type="string" modify="N" bclr="249,249,249" just="C"/>			<br/>			<inp id="tituloreporte" dim="80,1" fnt="20b,18b" type="string" modify="N" bclr="249,249,249" just="C"/>			<br/>			<inp id="leyendatx" dim="80,1" type="string" fnt=",16b" modify="N" just="C" nc="-1"/>			<br/>			<!--			<inp id="fechItx" dim="7,1" type="string" fnt=",16b" modify="N" just="L" nc="-1"/>			<sp n="1"/>			<inp id="fechI" dim="10,1" type="date" fnt=",16b" modify="N" just="L" nc="-1" fmt="CCYY/MM/DD"/>			<sp n="2"/>			<inp id="fechFtx" dim="7,1" type="string" fnt=",16b" modify="N" just="L" nc="-1"/>			<sp n="1"/>			<inp id="fechF" dim="10,1" type="date" fnt=",16b" modify="N" just="L" nc="-1" fmt="CCYY/MM/DD"/>			-->						<!-- <sp n="1"/> -->			<!-- fmt="DD/MM/CCYY" -->			<!-- just="C" -->			<!-- type="date" fmt="CCYY/MM/DD" -->			<inp id="fechoper" dim="80,1" type="string" fnt=",16b"  modify="N" just="C" nc="-1"/> 			<br/>			<inp id="estatustx" dim="80,1" type="string" fnt=",16b" modify="N" just="C" nc="-1" clr="91,26,41"/>			<br exe="encabezado"/>		</grp>				<tab n="1"/>				<grp dim="15,5,7,12">			<tab n="2"/><txt>P&#225;g:</txt>			<sp/> <inp id="k_pag" dim="5,1" type="number" mcr="k_pag"/><br/><br/>			<!-- "DD-MM-CCYY" -->			<inp id="fecha" dim="10,1" type="date" fmt="CCYY/MM/DD"/>			<sp/> <inp id="hora" dim="5,1" type="time"/>		</grp>		<br exe="encabezado"/>		<br exe="encabezado"/>				<hLine dim="90,0" g="2" type="1"/>			<br exe="encabezado"/>			<!-- <txt fnt=",15b">ProvPago </txt> <sp n="4"/> -->			<sp n="1"/>			<txt fnt=",15b">Factura / Referencia </txt> <sp n="19"/>			<!-- <txt fnt=",15b">Cta. Deposito </txt> <sp n="14"/> -->			<txt fnt=",15b">Monto </txt> <sp n="7"/>			<txt fnt=",15b">Iva </txt> <sp n="8"/> 			<txt fnt=",15b">ProvOper </txt> <sp n="4"/> 			<txt fnt=",15b">Nombre </txt> <!-- <sp n="19"/> -->			<!-- <inp id="pasotx" dim="4,1" type="string" fnt=",15b" modify="N" just="L" nc="-1"/> -->			<br exe="encabezado"/>		<hLine dim="90,0" g="2" type="1"/>		<br exe="encabezado"/>		<br exe="encabezado"/>		<sp n="1"/>		<!-- <inp id="provpago" fnt=",14" dim="9,1" type="string" modify="N"/> <sp n="1"/> -->		<inp id="fact" fnt=",14" dim="30,1" type="string" modify="N" just="L"/> <sp n="1"/>		<!-- <inp id="ctadep" fnt=",14" dim="15,1" type="string" modify="N"/> <sp n="1"/> -->		<inp id="monto" fnt=",14" dim="10,1" type="number" modify="N" nd="2"/> <sp n="1"/> 		<inp id="iva" fnt=",14" dim="8,1" type="number" modify="N" nd="2"/> <sp n="2"/> 		<inp id="provoper" fnt=",14" dim="9,1" type="string" modify="N"/> <sp n="1"/> 		<inp id="nombre" fnt=",14" dim="25,1" type="string" modify="N"/> <sp n="1"/>		<!-- <inp id="paso" fnt=",14" dim="3,1" type="string" modify="N" just="C"/> -->		<br exe="detalle"/>		<br exe="linea_t1"/> 		<sp n="65"/>		<hLine dim="25,0" g="2" type="1"/> 		<!-- <br exe="linea_t1"/> -->				<br exe="total"/> 		<!-- brdr="1,0" -->		<sp n="66"/> <txt fnt=",15b">Subtotal :</txt> <sp n="4"/> <inp id="tsubt" dim="12,1" type="number" fnt=",15b" nd="2"/>		<br exe="total"/>  		<sp n="66"/> <txt fnt=",15b">Iva Acreditado :</txt> <sp n="1"/> <inp id="tiva" dim="12,1" type="number" fnt=",15b" nd="2"/>  		<br exe="total"/>		<!-- <sp n="88"/> -->		<sp n="1"/>		<txt fnt=",15b">Cantidad en Letra :</txt> <sp n="1"/> <inp id="ttottx" dim="51,1" type="string" fnt=",15b" just="L"/>		<sp n="2"/> <txt fnt=",b">Total :</txt> <sp n="6"/> <inp id="ttot" dim="12,1" type="number" fnt=",15b" nd="2"/>  		<br exe="total"/> 				<!-- <br exe="linea_t2"/> -->		<sp n="65"/>		<hLine dim="25,0" g="2" type="1"/> 		<br exe="linea_t2"/>								<br exe="comentarios"/>		<sp n="1"/>		<txt fnt=",15">Referencia  : </txt> <sp n="1"/> <inp id="ref" dim="78,1" type="string" fnt=",15" just="L"/>		<br exe="comentarios"/>		<br exe="comentarios"/>		<sp n="1"/>		<txt fnt=",15">Comentarios : </txt> <inp id="comment" dim="78,3" type="string" fnt=",15" just="L"/>		<br exe="comentarios"/>			</grp></pag>