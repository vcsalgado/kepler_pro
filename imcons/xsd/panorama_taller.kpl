<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Panorama de Taller">	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<grp dim="40,8,7,12" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Panorama de Taller">						<br/><tab/><txt>Sucursal:</txt><sp n="2"/><cmb id="cmb_sucursal" dim="50,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y"/><tab n="1"/><bot id="bot_ejecutar" dim="15,0" brdr="5" text="Ejecutar" OnEnter="Execute()" default="1"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys,suc_usuario ,perfil_usuario,asterisco ,rol_usuario  ;			fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;								kdb.connect();				kdb.open("s,kdms,i,kdini,c,kdud");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";				Inicializa();							}						fun Inicializa(){//Inicializa los valores en Pantalla				IniCombos();				IniParams();//Inicializa parámtros de impresión entre otros				frn.set("ch_incluir","1");			}									fun IniCombos(){				var cmd, cubo , xmlResQuery, ok, mensajeError, strTmp;											//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("cmb_sucursal",getXml(cubo));							kdb.exec();															//frn.lib("libGeneral.kpl","FileSave",kdb.get("datalm"),"D:\Basura\datalm");											}			fun IniParams(){//Inicializa parámetros de impresión, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Página				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}			fun setRepPage() {//Establece los parámetros finales de impresión.				//Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				//rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3)b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}												fun Execute() {				if (ValidarInfo() == 0){					return;				};				GenerarReporte();								//var val=frn.get("input");				//frn.message("Valor proporcionado:" & val,"Notificación","Aceptar");			}											fun ValidarInfo(){				return 1;			}									fun GenerarReporte(){				var compania,usuario,strValor,strCriterio, fechaImpresion, horaImpresion;				var cuboResultados, xmlRequest,sqlXmlResultados,xmlCurDocto,xmlCurMovto,cmd,ok,mensaje;				var contordenes, totordenes ;				var fecha_orden , folio_orden, nombre_cli, mano_de_obra, refacciones, tots, cargos_varios, subtotal, iva, total, dias, asesor, flujo_srv;								kdb.kde("KDE");//Configuración del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();				var incluir_salto_pagina= frn.get("salto_de_pagina");								setXml(xmlRequest,"document","sucursal_id",frn.get("cmb_sucursal",-1,1));								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");								cmd="select * from keplersc.rep_panorama_taller('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"panorama_taller.GenerarReporte()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultadostaller");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								kdb.readPage("datos","panorama_tallerfto");//se define el formato a usar				kdb.exec();				rep.source(kdb.get("datos"));				rep.rst(); 				setRepPage();//Establece los parámetros finales de impresión.(rep.page(...);)				rep.set("suc_desc",frn.get("cmb_sucursal",-1,0));				rep.set("rep_fecha",fechaImpresion);				rep.set("rep_hora",horaImpresion);				rep.exe("encabezado");				rep.exe("tit_reporte");				rep.exe("encabezadoColumnas");				rep.exe("linea_encabezados");																//ORDENES PENDIENTES -----------------------------				var cubo_pendientes ;				cubo_pendientes = getXmlAtt(cuboResultados,"r0","ords_pendientes");				cubo_pendientes = delScpScn(cubo_pendientes );				setXmlStr(cubo_pendientes ,cubo_pendientes );							var tot_ords_p = 0;				var tot_mano_de_obra_p, tot_refacciones_p, tot_tots_p, tot_c_varios_p, tot_subtotal_p, tot_iva_p, tot_total_p;								totordenes = nXml(cubo_pendientes );								rep.exe("tit_pendientes");								for (contordenes=0; contordenes<totordenes ;contordenes++){									fecha_orden = getXml(cubo_pendientes ,"r"&contordenes, "fecha_orden");					folio_orden= getXml(cubo_pendientes ,"r"&contordenes, "folio_orden");					nombre_cli = getXml(cubo_pendientes ,"r"&contordenes, "nombre_cli");					mano_de_obra= getXml(cubo_pendientes ,"r"&contordenes, "mano_de_obra");					refacciones= getXml(cubo_pendientes ,"r"&contordenes, "refacciones");					tots= getXml(cubo_pendientes ,"r"&contordenes, "tots");					cargos_varios= getXml(cubo_pendientes ,"r"&contordenes, "cargos_varios");					subtotal= getXml(cubo_pendientes ,"r"&contordenes, "subtotal");					iva= getXml(cubo_pendientes ,"r"&contordenes, "iva");					total= getXml(cubo_pendientes ,"r"&contordenes, "total");					dias= getXml(cubo_pendientes ,"r"&contordenes, "dias");					asesor= getXml(cubo_pendientes ,"r"&contordenes, "asesor");					flujo_srv= getXml(cubo_pendientes ,"r"&contordenes, "flujo_srv");										rep.set("fecha_p",fecha_orden );					rep.set("orden_p",folio_orden);					rep.set("cliente_p",nombre_cli);											rep.set("mano_de_obra_p",mano_de_obra);					rep.set("refacciones_p",refacciones);					rep.set("tots_p",tots);											rep.set("cargos_varios_p",cargos_varios);					rep.set("subtotal_p",subtotal);					rep.set("iva_p",iva);											rep.set("total_p",total);					rep.set("dias_p",dias);					rep.set("asesor_p",asesor);										rep.exe("ordenes_pendientes");																	tot_ords_p = tot_ords_p + 1;					tot_mano_de_obra_p = tot_mano_de_obra_p + mano_de_obra;					tot_refacciones_p = tot_refacciones_p + refacciones;					tot_tots_p = tot_tots_p + tots;											tot_c_varios_p = tot_c_varios_p + cargos_varios;										tot_subtotal_p = tot_subtotal_p + subtotal;											tot_iva_p = tot_iva_p + iva;											tot_total_p = tot_total_p + total;					}								rep.set("tot_ords_p",tot_ords_p );				rep.set("tot_mano_de_obra_p",tot_mano_de_obra_p );				rep.set("tot_refacciones_p",tot_refacciones_p );				rep.set("tot_tots_p",tot_tots_p );										rep.set("tot_c_varios_p",tot_c_varios_p );				rep.set("tot_subtotal_p",tot_subtotal_p );				rep.set("tot_iva_p",tot_iva_p );				rep.set("tot_total_p",tot_total_p );											rep.exe("ordenes_pendientes_totales");																				//ORDENES ACTIVAS ---------------------------------				var cubo_activas ;				cubo_activas = getXmlAtt(cuboResultados,"r0","ords_activas");				cubo_activas = delScpScn(cubo_activas );				setXmlStr(cubo_activas ,cubo_activas );				frn.lib("libGeneral.kpl","FileSave",cubo_activas ,"C:\Basura\xmlcuboactivas");								var tot_ords_a = 0;				var tot_mano_de_obra_a, tot_refacciones_a, tot_tots_a, tot_c_varios_a, tot_subtotal_a, tot_iva_a, tot_total_a;								totordenes = nXml(cubo_activas );								rep.exe("tit_activas");								for (contordenes=0; contordenes<totordenes ;contordenes++){									fecha_orden = getXml(cubo_activas ,"r"&contordenes, "fecha_orden");					folio_orden= getXml(cubo_activas ,"r"&contordenes, "folio_orden");					nombre_cli = getXml(cubo_activas ,"r"&contordenes, "nombre_cli");					mano_de_obra= getXml(cubo_activas ,"r"&contordenes, "mano_de_obra");					refacciones= getXml(cubo_activas ,"r"&contordenes, "refacciones");					tots= getXml(cubo_activas ,"r"&contordenes, "tots");					cargos_varios= getXml(cubo_activas ,"r"&contordenes, "cargos_varios");					subtotal= getXml(cubo_activas ,"r"&contordenes, "subtotal");					iva= getXml(cubo_activas ,"r"&contordenes, "iva");					total= getXml(cubo_activas ,"r"&contordenes, "total");					dias= getXml(cubo_activas ,"r"&contordenes, "dias");					asesor= getXml(cubo_activas ,"r"&contordenes, "asesor");					flujo_srv= getXml(cubo_activas ,"r"&contordenes, "flujo_srv");										rep.set("fecha_a",fecha_orden );					rep.set("orden_a",folio_orden);					rep.set("cliente_a",nombre_cli);											rep.set("mano_de_obra_a",mano_de_obra);					rep.set("refacciones_a",refacciones);					rep.set("tots_a",tots);											rep.set("cargos_varios_a",cargos_varios);					rep.set("subtotal_a",subtotal);					rep.set("iva_a",iva);											rep.set("total_a",total);					rep.set("dias_a",dias);					rep.set("asesor_a",asesor);										rep.exe("ordenes_activas");																	tot_ords_a = tot_ords_a + 1;					tot_mano_de_obra_a = tot_mano_de_obra_a + mano_de_obra;					tot_refacciones_a = tot_refacciones_a + refacciones;					tot_tots_a = tot_tots_a + tots;											tot_c_varios_a = tot_c_varios_a + cargos_varios;										tot_subtotal_a = tot_subtotal_a + subtotal;											tot_iva_a = tot_iva_a + iva;											tot_total_a = tot_total_a + total;					}								rep.set("tot_ords_a",tot_ords_a );				rep.set("tot_mano_de_obra_a",tot_mano_de_obra_a );				rep.set("tot_refacciones_a",tot_refacciones_a );				rep.set("tot_tots_a",tot_tots_a );										rep.set("tot_c_varios_a",tot_c_varios_a );				rep.set("tot_subtotal_a",tot_subtotal_a );				rep.set("tot_iva_a",tot_iva_a );				rep.set("tot_total_a",tot_total_a );											rep.exe("ordenes_activas_totales");																													//ORDENES SUSPENDIDAS ---------------------------------				var cubo_suspendidas ;				cubo_suspendidas = getXmlAtt(cuboResultados,"r0","ords_suspendidas");				cubo_suspendidas = delScpScn(cubo_suspendidas );				setXmlStr(cubo_suspendidas ,cubo_suspendidas );				frn.lib("libGeneral.kpl","FileSave",cubo_suspendidas ,"C:\Basura\xmlcubo");								var tot_ords_s = 0;				var tot_mano_de_obra_s, tot_refacciones_s, tot_tots_s, tot_c_varios_s, tot_subtotal_s, tot_iva_s, tot_total_s;								totordenes = nXml(cubo_suspendidas );								rep.exe("tit_suspendidas");								for (contordenes=0; contordenes<totordenes ;contordenes++){									fecha_orden = getXml(cubo_suspendidas ,"r"&contordenes, "fecha_orden");					folio_orden= getXml(cubo_suspendidas ,"r"&contordenes, "folio_orden");					nombre_cli = getXml(cubo_suspendidas ,"r"&contordenes, "nombre_cli");					mano_de_obra= getXml(cubo_suspendidas ,"r"&contordenes, "mano_de_obra");					refacciones= getXml(cubo_suspendidas ,"r"&contordenes, "refacciones");					tots= getXml(cubo_suspendidas ,"r"&contordenes, "tots");					cargos_varios= getXml(cubo_suspendidas ,"r"&contordenes, "cargos_varios");					subtotal= getXml(cubo_suspendidas ,"r"&contordenes, "subtotal");					iva= getXml(cubo_suspendidas ,"r"&contordenes, "iva");					total= getXml(cubo_suspendidas ,"r"&contordenes, "total");					dias= getXml(cubo_suspendidas ,"r"&contordenes, "dias");					asesor= getXml(cubo_suspendidas ,"r"&contordenes, "asesor");					flujo_srv= getXml(cubo_suspendidas ,"r"&contordenes, "flujo_srv");										rep.set("fecha_s",fecha_orden );					rep.set("orden_s",folio_orden);					rep.set("cliente_s",nombre_cli);											rep.set("mano_de_obra_s",mano_de_obra);					rep.set("refacciones_s",refacciones);					rep.set("tots_s",tots);											rep.set("cargos_varios_s",cargos_varios);					rep.set("subtotal_s",subtotal);					rep.set("iva_s",iva);											rep.set("total_s",total);					rep.set("dias_s",dias);					rep.set("asesor_s",asesor);										rep.exe("ordenes_suspendidas");																	tot_ords_s = tot_ords_s + 1;					tot_mano_de_obra_s = tot_mano_de_obra_s + mano_de_obra;					tot_refacciones_s = tot_refacciones_s + refacciones;					tot_tots_s = tot_tots_s + tots;											tot_c_varios_s = tot_c_varios_s + cargos_varios;										tot_subtotal_s = tot_subtotal_s + subtotal;											tot_iva_s = tot_iva_s + iva;											tot_total_s = tot_total_s + total;					}								rep.set("tot_ords_s",tot_ords_s );				rep.set("tot_mano_de_obra_s",tot_mano_de_obra_s );				rep.set("tot_refacciones_s",tot_refacciones_s );				rep.set("tot_tots_s",tot_tots_s );										rep.set("tot_c_varios_s",tot_c_varios_s );				rep.set("tot_subtotal_s",tot_subtotal_s );				rep.set("tot_iva_s",tot_iva_s );				rep.set("tot_total_s",tot_total_s );											rep.exe("ordenes_suspendidas_totales");																//ORDENES TERMINADAS---------------------------------				var cubo_terminadas;				cubo_terminadas = getXmlAtt(cuboResultados,"r0","ords_terminadas");				cubo_terminadas = delScpScn(cubo_terminadas);				setXmlStr(cubo_terminadas,cubo_terminadas);				frn.lib("libGeneral.kpl","FileSave",cubo_terminadas,"C:\Basura\xmlcubo");								var tot_ords_t = 0;				var tot_mano_de_obra_t, tot_refacciones_t, tot_tots_t, tot_c_varios_t, tot_subtotal_t, tot_iva_t, tot_total_t;								totordenes = nXml(cubo_terminadas);								rep.exe("tit_terminadas");								for (contordenes=0; contordenes<totordenes ;contordenes++){									fecha_orden = getXml(cubo_terminadas,"r"&contordenes, "fecha_orden");					folio_orden= getXml(cubo_terminadas,"r"&contordenes, "folio_orden");					nombre_cli = getXml(cubo_terminadas,"r"&contordenes, "nombre_cli");					mano_de_obra= getXml(cubo_terminadas,"r"&contordenes, "mano_de_obra");					refacciones= getXml(cubo_terminadas,"r"&contordenes, "refacciones");					tots= getXml(cubo_terminadas,"r"&contordenes, "tots");					cargos_varios= getXml(cubo_terminadas,"r"&contordenes, "cargos_varios");					subtotal= getXml(cubo_terminadas,"r"&contordenes, "subtotal");					iva= getXml(cubo_terminadas,"r"&contordenes, "iva");					total= getXml(cubo_terminadas,"r"&contordenes, "total");					dias= getXml(cubo_terminadas,"r"&contordenes, "dias");					asesor= getXml(cubo_terminadas,"r"&contordenes, "asesor");					flujo_srv= getXml(cubo_terminadas,"r"&contordenes, "flujo_srv");										rep.set("fecha_t",fecha_orden );					rep.set("orden_t",folio_orden);					rep.set("cliente_t",nombre_cli);											rep.set("mano_de_obra_t",mano_de_obra);					rep.set("refacciones_t",refacciones);					rep.set("tots_t",tots);											rep.set("cargos_varios_t",cargos_varios);					rep.set("subtotal_t",subtotal);					rep.set("iva_t",iva);											rep.set("total_t",total);					rep.set("dias_t",dias);					rep.set("asesor_t",asesor);										rep.exe("ordenes_terminadas");																	tot_ords_t = tot_ords_t + 1;					tot_mano_de_obra_t = tot_mano_de_obra_t + mano_de_obra;					tot_refacciones_t = tot