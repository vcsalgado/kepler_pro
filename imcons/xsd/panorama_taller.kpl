			rep.set("rep_tot_refacciones",rep_tot_refacciones);								var rep_tot_tots = tot_tots_p + tot_tots_a + tot_tots_s + tot_tots_t + tot_tots_c ; 				rep.set("rep_tot_tots",rep_tot_tots);								var rep_tot_c_varios= tot_c_varios_p + tot_c_varios_a + tot_c_varios_s + tot_c_varios_t + tot_c_varios_c ; 				rep.set("rep_tot_c_varios",rep_tot_c_varios);								var rep_tot_subtotal= tot_subtotal_p + tot_subtotal_a + tot_subtotal_s + tot_subtotal_t + tot_subtotal_c ; 				rep.set("rep_tot_subtotal",rep_tot_subtotal);									var rep_tot_iva = tot_iva_p + tot_iva_a + tot_iva_s + tot_iva_t + tot_iva_c ; 				rep.set("rep_tot_iva",rep_tot_iva);								var rep_tot_total= tot_total_p + tot_total_a + tot_total_s + tot_total_t + tot_total_c ; 				rep.set("rep_tot_total",rep_tot_total);								rep.exe("totales_reporte");								rep.win();						}																																										}	</script></pag>