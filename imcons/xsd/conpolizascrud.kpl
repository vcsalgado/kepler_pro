<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><txt fnt=",23b">Devoluciones de Compras</txt><br/>	<!-- dim="81,0" --> 	<hLine dim="85,0"/> 	<br/> <br/>		<!-- <grp dim="46,9,7,12" -->		<grp dim="48,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros"><txt>  Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>			<br/><br/>			<txt>  Tipo :        </txt>			<cmb id="k_tipon" dim="40,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo() "/>			<br/>		</grp>		<sp/>		<!-- dim="34,9,7,12" -->		<grp dim="36,9,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C"/><tab/> <br/>			<txt id="textFolio" visible="Y">  Folio :  </txt>			<edt id="k_folio" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" visible="Y" OnButton="ObtenerFolios_DEVs()" OnF9="ObtenerFolios_DEVs()" OnChange="BuscarFolio()"/> <br/>			<sp n="1"/>			<inp id="k_docto" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="C"/> <br/>			<txt>  Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N"/> 			<sp n="1"/> 			<txt>  Hora : </txt> 			<sp n="1"/> 			<edt id="k_hora" dim="15,1" type="time" nc="-1" bclr="240,240,240" modify="Y" fmt="HH:MM:SS" available="N"/> 			<br/>		</grp>		<br/>		<br/>				<!-- dim="81,14,7,12" -->		<grp dim="85,14,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Proveedor">				<sp n="1"/> <txt clr="0,58,112" hk="P">Proveedor : </txt><tab/>			<!--			<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnButton="Dialog(3,cxpcatprobus,k_clave)" OnF9="Dialog(3,cxpcatprobus,k_clave)" OnF10="Dialog(3,cxpcatpropag,k_clave,,11110)" OnChange="()" 					type="capital" nc="7" tooltip="Proveedor ( F9 b&#250;squeda; F10 cat&#225;logo )" modify="Y" hk="C" available="Y"/> 			-->						<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnButton="ObtenerProveedores()" OnF9="ObtenerProveedores()" OnF10="" OnChange="BuscarProveedor(0)" 					type="capital" nc="7" tooltip="Proveedor ( F9 b&#250;squeda; )" modify="Y" hk="C" available="N"/> 						<sp n="10"/> <txt>RFC : </txt><sp n="5"/>			<inp id="k_rfc" clr="64,64,64"  dim="18,1" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>			<br/>			<sp n="1"/> <txt>Datos del proveedor : </txt>			<br/>			<sp n="1"/>						<inp id="k_nombreprov" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>			<br/>			<sp n="1"/>			<inp id="k_calleprov" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>			<br/>			<sp n="1"/>			<inp id="k_coloniaprov" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>			<br/>			<sp n="1"/>			<inp id="k_poblacionprov" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>			<br/>						<sp n="1"/> <txt clr="0,58,112">Factura o Gu&#237;a : </txt> <tab/>			<edt id="k_refer" clr="64,64,64" clrBrdr="255,255,255"  dim="30,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="10" available = "N" modify="Y" 						OnF9="ObtenerOrdenes()" OnChange="MostrarOrden()" OnButton="ObtenerOrdenes()"/>					<sp n="5"/>				<inp id="k_fecha_exp" dim="25,1" type="string" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="N" nc="-1"/> 					</grp>		<br/>		<br/>			<!-- dim="81,18,7,12" --> 		<grp dim="85,18,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Totales ">			<sp n="1"/> 			<!-- fnt="Arial,15" dim="114,6" -->			<tbl id="k_mov" dim="119,6" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" hk="z" OnChange="CalcTotal()" Reorder="N" modify="Y" insdel="N" nren="fijo">				<col id="k_parte" name="Art&#237;culo"  type="capital" nc="18" OnF9="Dialog(3,invcatprdbus,k_mov,k_parte)" 					OnF5="Dialog(3,invrepestprod,s)"					OnF10="Dialog(3,cat_prod_crud,Nuevo,x,s)" OnF11="Dialog(3,cat_prod_crud,Modificar,x,s)" 					OnMouseL="Dialog(3,invcatprdbus,k_mov,k_parte)" OnChange="Producto()" modify="N" available="Y"/>				<col id="k_descr" name="Descripci&#243;n"  modify="N" nc="30"/>						<col id="k_qc" name="Cant."  type="number" nd="-1" min="0" modify="N" OnF9="Cantidad()" OnMouseL="Cantidad()" 					OnChange="Cantidad()" OnActive="Cantidad(1)" OnF10="Dialog(3,doc_coment,k_mov)" visible="N"/>				<col id="k_unidad" name="U.M."  type="capital" OnChange="Unidad()" OnF9="Dialog(3,doc_unidades,k_mov)" OnMouseL="Dialog(3,doc_unidades,k_mov)" modify="N" available="Y"/>				<col id="k_pc" name="Precio"  type="number" nd="2" modify="N" available="Y" visible="N"/>				<col id="k_ic" name="Importe"  type="number" nd="2" modify="N" available="Y" visible="N"/>				<col id="k_qd" name="Cant. Dev."  type="number" nd="-1" min="0" OnF9="Cantidad()" OnMouseL="Cantidad()" 					OnChange="Cantidad()" OnActive="Cantidad(1)" OnF10="Dialog(3,doc_coment,k_mov)" modify="N" visible="N"/>				<col id="k_qi" name="Cant. Inv."  type="number" nd="-1" min="0" OnF9="Cantidad()" OnMouseL="Cantidad()" 					OnChange="Cantidad()" OnActive="Cantidad(1)" OnF10="Dialog(3,doc_coment,k_mov)" modify="N" visible="N"/>				<col id="k_q" name="Cant. Movto."  type="number" nd="0" min="0" OnF9="Cantidad()" OnMouseL="Cantidad()" 					OnChange="CalculaTotales(0)" OnActive="Cantidad(1)" OnF10="Dialog(3,doc_coment,k_mov)" modify="N" available="Y"/>				<col id="k_precio" name="Precio"  type="number" nd="2" modify="N" available="Y" visible="Y"/>									<col id="k_monto" name="Importe Movto."  type="number" nd="-1" min="0" OnF9="Cantidad()" OnMouseL="Cantidad()" 					OnChange="Cantidad()" OnActive="Cantidad(1)" OnF10="Dialog(3,doc_coment,k_mov)" modify="N"/>						</tbl>			<br/>			<sp n="1"/> <txt>Plazo : </txt> 			<sp n="5"/> <inp id="k_plazo" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nd="0" min="0" OnChange="Plazo()" modify="Y" available="N"/>						<sp n="27"/> <txt>Subtotal : </txt>			<sp n="1"/><tab/> <inp id="k_subtotal" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/>						<br/>						<sp n="1"/> <txt>Fecha Pago : </txt> 			<edt id="k_vence" clr="64,64,64"  dim="15,1" brdr="2,0" bclr="255,255,255" type="date" nc="-1" fnt="Arial,0" available="N" fmt="DD/MM/CCYY" page="_ks_fecha,k_vence" OnF9="Dialog(3,_ks_fecha,k_vence)" clrBrdr="255,255,255"/><tab/>						<sp n="25"/> <txt>IVA :</txt><tab n="2"/> <inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/><txt>  (</txt>			<inp id="k_porciva" dim="5,1" bclr="240,240,240" clrBrdr="255,255,255" type="string" modify="N" available="N"/><txt> %)</txt>						<br/> 						<sp n="1"/> <txt clr="0,58,112">Condiciones : </txt>			<sp n="1"/> <inp id="k_cond" clr="64,64,64" clrBrdr="255,255,255"  dim="39,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="33" modify="N" available="N"/>						<sp n="2"/> <txt fnt=",16b">Importe : </txt>			<sp n="1"/><tab/> <inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="N"/>  						<br/>						<sp n="1"/> <txt clr="0,58,112">Comentarios:</txt>			<sp n="1"/> <inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="102,1" brdr="2,0" fnt="Arial,16" nr="3,60" modify="N" available="N" type="string"/>		</grp>				<br/>		<br/>						<sp n="15"/>		<img id="Imprimir" dim="45,45" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Reporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="N" clrBrdr="0,0,0" visible="Y" modify="Y"/>					<sp n="25"/>		<img id="Cancelar" dim="45,45" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="N"/>					<sp n="10"/>		<img id="Aceptar" dim="45,45" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>							</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal;			var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd;										fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";				//fileSavePath = "C:\Basura";				Inicializa();								ConfiguraControlesOpcion();			}			//Validacion Datos Generales y Partidas antes de Guardar.			//El resultado de cada validacion se guarda en la variable global resVal.			fun ValidarDatos() {				var totReg, subTotal=0, iva=0, total=0;				//Obtener variables				sucursal_id = frn.get("k_sucn",-1,1);				proveedor_id = frn.get("k_clave");				refer_id = frn.get("k_refer");											//Validar Proveedor				cmdQuery="SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_id & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comdevdircrud.ValidarDatos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				totReg=getXmlAtt(cuboQuery,"r0","totreg");				if(totReg==0){					frn.message("El proveedor no existe.","Error","Aceptar");					resVal=0;					return;				}								//Validar Referencia				cmdQuery = "select count(*) as totreg " &					"from keplersc.kduxg uxg inner join keplersc.kdxd xd on xd.c2 = uxg.c3 " & 					"inner join keplersc.kduxe xe on uxg.c1 = xe.c1 and uxg.c4 = xe.c3 and uxg.c3 = xe.c2 " &		 					"where uxg.c2 = 'X' and xe.c6 = 'A' and xe.c7 = 5 and " &					"uxg.c5 = 1 and uxg.c10 = 0 and uxg.c1 = '" & sucursal_id &  "' and uxg.c3='" & proveedor_id & "' " & 					"and uxg.c4 = '" & refer_id & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comdevdircrud.ValidarDatos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error DB","Aceptar"); //TO DO Homologar mensaje en todo el proyecto, agregar DB					return;				}				totReg=getXmlAtt(cuboQuery,"r0","totreg");				if(totReg==0){					frn.message("La referencia no existe.","Error","Aceptar");					resVal=0;					return;				}											//Validar Cantidades				for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {					frn.setPos("k_mov",i,"k_q");					resVal=CalculaTotales(1);					if(resVal==0){						return;					}				}							//Validar Totales				subTotal=frn.get("k_subtotal");				iva=frn.get("k_iva");				total=frn.get("k_monto");				if (total <= 0){					frn.message("El total de la operación no puede ser cero.","Error","Aceptar");					resVal=0;					return;				}							} // End ValidarDatos()						fun DetallaGRD() {				for (var i=0; i<frn.N("k_mov"); i++) {					if ( (strlen(frn.get("k_mov",i,"k_q")) == 0) || (frn.get("k_mov",i,"k_q") <= 0) ) {  						frn.setX("0","k_mov",i,"k_q"); 						frn.setX("0","k_mov",i,"k_precio"); 						frn.setX("0","k_mov",i,"k_monto"); 					} else {						frn.setX(frn.get("k_mov",i,"k_ic"),"k_mov",i,"k_precio"); 					}				}					}			fun BuscarFolio() {				var folio;				folio = frn.get("k_folio");				//frn.lib("libGeneral.kpl","PadLeft", folio, 7, "0");				folio = PadLeft(folio, 7, "0");				ArmarRefDocto();				MostrarDEV(folio);				}			fun Cancela() {				CambiaSucursal();				Inicializa();				ConfiguraControlesOpcion();			}						fun ModoBuscar() {				tip_ope = "C";				frn.set("operacion", "CONSULTA");				LimpiaEncabezado();				ConfiguraControlesOpcion();			}					fun Ejecuta() {				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg;				var resultado, mensaje, folio;								fecha = sys.date();				hora= sys.time();								if (tip_ope &= "A") { 								//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok					resVal = 1;					ValidarDatos();					if(ok &! "1" || resVal == 0){						return;					}					//Para Homologar los TAGs que envía el Grid (KMov) al XML que generará la Pantalla					DetallaGRD();										// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;												setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",						frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 						frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")/*-1*//*commented 220726*/);					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);										frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\XmlDEVCompra");					// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 								cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					rstXml(cuboQuery);					cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"comdevdircrud.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado");										// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										//resultado = "1";					//mensaje = "0000009";										resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");																				if(resultado &= "1") {											frn.message(mensaje, "Folio Generado : ", "Aceptar");											ModoBuscar(); // 220721 ... added 												//tip_ope = "C"; -- 220721 ... commented & included en ModoBuscar();						frn.set("k_folio", mensaje); 						//frn.set("operacion", "CONSULTA"); -- 220721 ... commented & included en ModoBuscar();						strTmp = frn.get("k_docto");						strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;						frn.set("k_docto", strTmp);						// //ConfiguraCamposOpcion();											//strMsg = "El Folio utilizado para esta operación fue : " & mensaje;						//ConfiguraControlesOpcion(); // TO CHECK ... Esto No se ejecuta si se pone después del Message * * *  						//frn.message(strMsg, "Mensaje", "Aceptar");						//folio = frn.get("k_folio");						//MostrarDEV(folio);							BuscarFolio();					} else {						frn.message(mensaje, "Error", "Aceptar");					}				} /*End Alta*/ else {					if (tip_ope &= "B") {						/*Ini Baja*/						frn.message("En Construcción, OPC {Baja}", "Info", "Aceptar");					} /*End Baja*/ else {						/*Ini Consulta*/						folio = frn.get("k_folio");						ModoBuscar(); // 220721 ... added						frn.set("k_folio", folio); // 220721 ... added						//MostrarDEV(folio); // 220722 ... commented 						strTmp = frn.get("k_docto");						strTmp = strSplit(strTmp,"-",0) & "-" & folio;						frn.set("k_docto", strTmp);							BuscarFolio();					}	/*End Consulta (for exception)*/ 				}							} // FIN ... Ejecuta()									fun Inicializa(){ //Inicializa los valores en Pantalla				// Our code 				// Revisa y Carga en Variables los Parámetros Recibidos en la corrida				if( frn.nParam() == 5 ){ //Se han mandado parámetros a la página                    gen_doc=trim(frn.param(0));                     nat_doc=trim(frn.param(1));                     gpo_doc=trim(frn.param(2));                    tip_doc=trim(frn.param(3));                     tip_ope=trim(frn.param(4));                    paramProd=trim(frn.param(5));                    tip_ope_original=tip_ope; /*220726*/            } else {               frn.message("Operación no válida ...", "Mensaje","&Aceptar");               //frn.open("anuncios",4);               frn.open("index",4);					return;            }            				if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					if(tip_ope &= "B"){ //Baja						frn.set("operacion","BAJA");					} else {						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} else {					      frn.message("Operación no válida ...", "Mensaje","&Aceptar");							//frn.open("anuncios",4);							frn.open("index",4);							return;									}					}				}								// Fill Combo Sucursal (Con Query de PostgreSQL)				cmdQuery = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdms";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comdevdircrud.IniCombos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",cuboQuery);									/*				// Fill Combo Tipo (Con Query de PostgreSQL)				cmdQuery = "select '['||c4||'] '||c5 as c2, c4  from keplersc.kdmm where c1 = '" & gen_doc & "'" & "and c2 = '" & nat_doc & "'" & "and c3 = '" & gpo_doc & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comdevdircrud.IniCombos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_tipon",cuboQuery);					*/				// Fill Combo Tipo (Con Query FTO Kepler) 				cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comopecompras.Inicializa()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboTipoDocto");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error BD","Aceptar");					return;				}				frn.set("k_tipon",getXml(cuboQuery));								frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());									// Fill k_docto | referencia docto				ArmarRefDocto();								LimpiaDatosProv();			}						// Armado del Docto Referencia			fun ArmarRefDocto {				var cadena,tmpFolio, tmpGrupo, tmpTipo;				tmpFolio = frn.get("k_folio");				// //tmpFolio = frn.lib("libGeneral.kpl","PadLeft",tmpFolio,"7","0");				tmpFolio = PadLeft(tmpFolio,"7","0");				tmpGrupo = PadLeft(gpo_doc,"2","0");				tmpTipo = PadLeft(tip_doc,"3","0");				//cadena = trim(gen_doc) & trim(nat_doc) & trim(gpo_doc) & trim(tip_doc) & "-" & tmpFolio;				cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;				frn.set("k_docto", cadena);			}						fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         }			fun ConfiguraControlesOff() {								frn.setAtt("textFolio", "visible", "N");				frn.setAtt("k_folio", "available", "N");				frn.setAtt("k_folio", "visible", "N");								frn.setAtt("k_fecha", "available", "N");				frn.setAtt("k_hora", "available", "N");				frn.setAtt("k_clave", "available", "N");				frn.setAtt("k_refer", "available", "N");								frn.setAtt("k_mov", "modify", "N", "k_q");				frn.setAtt("k_mov", "visible", "N", "k_qc");				frn.setAtt("k_mov", "visible", "N", "k_pc");				frn.setAtt("k_mov", "visible", "N", "k_ic");				frn.setAtt("k_mov", "visible", "N", "k_qd");				frn.setAtt("k_mov", "visible", "N", "k_qi");				frn.setAtt("k_mov", "visible", "Y", "k_precio");								frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											}						fun ConfiguraControlesOpcion() {							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta					frn.setAtt("k_fecha", "available", "Y");					frn.setAtt("k_hora", "available", "Y");					frn.setAtt("k_clave", "available", "Y");					frn.setAtt("k_refer", "available", "Y");								frn.setAtt("k_mov", "modify", "Y", "k_q");					frn.setAtt("k_mov", "visible", "Y", "k_qc");					frn.setAtt("k_mov", "visible", "Y", "k_pc");					frn.setAtt("k_mov", "visible", "Y", "k_ic");					frn.setAtt("k_mov", "visible", "Y", "k_qd");					frn.setAtt("k_mov", "visible", "Y", "k_qi");					frn.setAtt("k_mov", "visible", "N", "k_precio");									frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");													} else {					if(tip_ope &= "B"){ //Baja										frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("k_mov", "modify", "N", "k_q");						frn.setAtt("k_mov", "visible", "N", "k_qc");						frn.setAtt("k_mov", "visible", "N", "k_pc");						frn.setAtt("k_mov", "visible", "N", "k_ic");						frn.setAtt("k_mov", "visible", "N", "k_qd");						frn.setAtt("k_mov", "visible", "N", "k_qi");						frn.setAtt("k_mov", "visible", "Y", "k_precio");																frn.setAtt("Imprimir", "visible", "N");						frn.setAtt("Cancelar", "visible", "Y");						frn.setAtt("Aceptar", "visible", "Y");															} else {						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("k_mov", "modify", "N", "k_q");						frn.setAtt("k_mov", "visible", "N", "k_qc");						frn.setAtt("k_mov", "visible", "N", "k_pc");						frn.setAtt("k_mov", "visible", "N", "k_ic");						frn.setAtt("k_mov", "visible", "N", "k_qd");						frn.setAtt("k_mov", "visible", "N", "k_qi");						frn.setAtt("k_mov", "visible", "Y", "k_precio");						frn.setAtt("Imprimir", "visible", "Y");						frn.setAtt("Cancelar", "visible", "N");						frn.setAtt("Aceptar", "visible", "N");						}				}			}						/* ESTO SE VA A QUITAR, ESQUEMA DE BUSQUEDA K80*/			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    				1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 				2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 				3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				// var tip_ope; 				var tip_oper;				if(iModo==0)page=pag; 				else if(iModo==2&&(strlen(par0)>0)){					//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;					if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     			}				/* HASTA AQUI ... ESTO SE VA A QUITAR, ESQUEMA DE BUSQUEDA K80*/						/* ESTO SE VA A QUITAR, ESQUEMA DE BUSQUEDA K80*/			fun Clave(iModo){//Actualiza los datos del cliente o Proveedor 				if(iModo == 0){					var cmd_f="datos,u,1,0,'" & frn.get("k_clave") & "',&,u1...u50,v3";					kdb.rel("v2=u12"); 					kdb.search(cmd_f); 					kdb.exec(); 										// ok &! "" && !ok					//frn.lib("libGeneral.kpl","FileSave",kdb.ok("datos"), fileSavePath & "\comdevdircrud_datos");										if(kdb.ok("datos") == 0){						if(strlen(trim(frn.get("k_clave")))>0)	frn.message("La clave "&frn.get("k_clave")&" no se encontró","Error","&Aceptar");						frn.setPos("k_clave");//La clave no existe					}				}				else{					kdb.rst("datos");				}//Borra la info anterior								frn.set("k_clave",kdb.get("datos","u2"),"k_rfc",kdb.get("datos","u10"),"k_plazo",kdb.get("datos","u16"));				frn.setM("k_datCve",kdb.get("datos","u3"),kdb.get("datos","u4"),kdb.get("datos","u5"),kdb.get("datos","u6"),kdb.get("datos","u27"));			}						/* HASTA AQUI ... ESTO SE VA A QUITAR, ESQUEMA DE BUSQUEDA K80*/			fun LimpiaDatosProv {				frn.set("k_rfc", "");				frn.set("k_nombreprov", "");				frn.set("k_calleprov", "");				frn.set("k_coloniaprov", "");				frn.set("k_poblacionprov", "");				frn.set("k_fecha_exp", "");					LimpiaDatosDoc();				LimpiaTotalesDoc();						frn.set("k_refer", "");				frn.set("k_fecha_exp", "");			}						fun LimpiaDatosDoc {				//frn.set("k_refer", "");				//frn.set("k_fecha_exp", "");				frn.set("k_mov", "");				frn.set("k_plazo", "");				frn.set("k_vence", "");				frn.set("k_cond", "");				frn.set("k_coment", "");			}						fun LimpiaTotalesDoc {				frn.set("k_subtotal", "");				frn.set("k_iva", "");				frn.set("k_monto", "");			}						fun LimpiaEncabezado {				frn.set("k_folio", "");				frn.set("k_docto", "");				frn.set("k_fecha", "");				frn.set("k_hora", "");				LimpiaDatosProv();				frn.set("k_clave", "");			}						fun CambiaSucursal {				LimpiaEncabezado();				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());					ArmarRefDocto();							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						}					}								}			}						fun CambiaTipo {				LimpiaEncabezado();				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());					ArmarRefDocto();								if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						}					}								}			}			fun BuscarProveedor(iModo){  // 20220720 se incluyo PARAM iModo 				var xmlProd, flagprov;												sucursal_id = frn.get("k_sucn",-1,1);				proveedor_id = frn.get("k_clave");				if (iModo != 1) {  // 20220720					if (strlen(frn.get("k_refer")) > 0) {						refer_id = frn.get("k_refer");					} else {						refer_id = "";						frn.set("k_fecha_exp", "");					}				}				if (iModo != 2) {  // 20220722					LimpiaDatosProv();				}				//LimpiaDatosDoc(); -- 20220720				//LimpiaTotalesDoc(); -- 20220720 												if (strlen(frn.get("k_clave")) == 0) {					return;				}								/* -- 20220719				if (strlen(frn.get("k_refer")) > 0) {					refer_id = frn.get("k_refer");				} else {					frn.set("k_fecha_exp", "");				}				*/								cmdQuery = "select c10 as k_rfc, c3 as k_nombreprov, c5 as k_calleprov, c6 as k_coloniaprov, c7 as k_poblacionprov " &									"from keplersc.kdxd where c2='" & proveedor_id & "'" ;				//and c1 ='" & sucursal_id & "' ... TO DO : NO VIENE DATO DE LA SUCURSAL A NIVEL DEL PROVEEDOR AUNQUE ESTA EL CAMPO ...				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comdevdircrud.Producto()");				//frn.lib("libGeneral.kpl","FileSave",cubo, fileSavePath & "\cuboProv");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.message("El proveedor no existe","Error","Aceptar");					frn.setPos("k_clave");					return;					}					rstXml(xmlProd);				xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");				//frn.lib("libGeneral.kpl","FileSave",xmlProd, fileSavePath & "\xmlProd");				frn.setX(xmlProd);				if (iModo == 0 /*!= 1*/) { // 20220720 ... add ; 20220722 ... upd 					// /* -- 20220719 					if (strlen(refer_id) > 0) {						MostrarOrden();					}					// */				}											}			fun ObtenerProveedores() {			            proveedor_id = frn.get("k_clave");            sucursal_id = frn.get("k_sucn",-1,1);	            cmdQuery = "select c2 as k_claveprov, c3 as nombre " &                "from keplersc.kdxd ";            cmdQuery = cmdQuery & " order by c2 ";                                    // 20220804 --> frn.dialog("genlistasel","Catálogo de Proveedores",cmdQuery,"k_claveprov","k_clave","N");                        frn.dialog("genlistasel","Catálogo de Proveedores",cmdQuery,"k_claveprov","k_clave","0","","N");                    }						fun ObtenerOrdenes() {			            proveedor_id = frn.get("k_clave");            sucursal_id = frn.get("k_sucn",-1,1);	            cmdQuery = "select uxg.c3 as k_claveprov, xd.c3 as nombre, uxg.c4 as documento, uxg.c11 as fecha_exp, concat(uxg.c3,'~',uxg.c4) as llave " &                "from keplersc.kduxg uxg inner join keplersc.kdxd xd on xd.c2 = uxg.c3 " &                "inner join keplersc.kduxe xe on uxg.c1 = xe.c1 and uxg.c4 = xe.c3 and uxg.c3 = xe.c2 " &                 "where uxg.c2 = 'X' and xe.c6 = 'A' and xe.c7 = 5 and uxg.c5 = 1 and uxg.c10 = 0 and uxg.c1 = '" & sucursal_id &  "'";            if(proveedor_id &! ""){					cmdQuery = cmdQuery & " and uxg.c3='" & proveedor_id & "' ";            }            cmdQuery = cmdQuery & " order by uxg.c11 desc ";                                    // 20220804 --> frn.dialog("genlistasel","Ordenes de Compra",cmdQuery,"llave","k_refer","","N");                        frn.dialog("genlistasel","Ordenes de Compra",cmdQuery,"llave","k_refer","0","","N");                     }                           			fun ObtenerFolios_DEVs() {			            proveedor_id = frn.get("k_clave");            sucursal_id = frn.get("k_sucn",-1,1);	            cmdQuery = 						"select tuxg.c3 as clave_proveedor, txd.c3 as nombre_proveedor, tuxg.c4 as folio_devolucion, tuxg.c11 as fecha " &							", tdm1.c11 as referencia_compra " & 						"from keplersc.kdm1 tdm1 " & 						"inner join keplersc.kduxe tuxe on tdm1.c1 = tuxe.c1 and tdm1.c6 = tuxe.c9 and tdm1.c10 = tuxe.c2 " & 							"and lpad(tdm1.c11,10,'0') = tuxe.c3 " & 							"and tdm1.c2 = tuxe.c5 and tdm1.c3 = tuxe.c6 and tdm1.c4 = tuxe.c7 and tdm1.c5 = tuxe.c8 " & 						"inner join keplersc.kduxg tuxg on tuxg.c1 = tuxe.c1 and tuxg.c4 = tuxe.c9/*tuxe.c3*/ and tuxg.c3 = tuxe.c2 " & 						"inner join keplersc.kdxd txd on txd.c2 = tuxg.c3 " & 						"where /*tuxg.c2*/tuxe.c5 = 'X' and tuxe.c6 = 'D' and tuxe.c7 = 40 and tuxe.c8 = 1 ";                        cmdQuery = cmdQuery & " order by Clave_Proveedor, Folio_Devolucion";                                    // 20220804 --> frn.dialog("genlistasel","Relación de Devoluciones de Compra",cmdQuery,"folio_devolucion","k_folio","","N");                        frn.dialog("genlistasel","Relación de Devoluciones de Compra",cmdQuery,"folio_devolucion","k_folio","0","","N");                     }                  fun MostrarOrden() {					var refer, xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle;				var tmpStr, tmpXml, contDet, xmlCurDet, xmlDetConv;				var tmpvar;								frn.set("k_fecha_exp", "");				nCampos = strSplit(frn.get("k_refer"),"~",-1);				sucursal_id = frn.get("k_sucn",-1,1);												//Reset campos				LimpiaDatosDoc();				LimpiaTotalesDoc();								if (nCampos > 1) {					refer = strSplit(frn.get("k_refer"),"~",1);					proveedor_id = strSplit(frn.get("k_refer"),"~",0);									if (frn.get("k_clave") &= "") {						//proveedor_id = strSplit(frn.get("k_refer"),"~",0);  -- 20220720						frn.set("k_clave", proveedor_id);						BuscarProveedor(1); // 20220720 se incluyo PARAM 1 					} 					frn.set("k_refer", refer);				}else{					refer = frn.get("k_refer");					proveedor_id = frn.get("k_clave");				}														setXml(xmlRequest,"document","sucursal_id",sucursal_id);				setXml(xmlRequest,"document","proveedor_id",proveedor_id);				setXml(xmlRequest,"document","referencia",refer);				setXml(xmlRequest,"document","genero","X");				setXml(xmlRequest,"document","naturaleza","A");				setXml(xmlRequest,"document","grupo","5");				setXml(xmlRequest,"document","tipo","1");				setXml(xmlRequest,"document","folio","1");					cmdQuery = "select * from keplersc.comdevalta_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				frn.lib("libGeneral.kpl","FileSave",xmlRequest, fileSavePath & "\comdevdircrud_xml_RequestFromK80TOPostgreSql");								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comdevdircrud.Producto()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\comdevdircrud_xml_GottenOfPostgreSql");								ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}									//Datos de encabezado				tmpStr=getXmlAtt(cuboQuery,"r0","encabezado");				rstXml(xmlEncabezado);				rstXml(tmpXml);				tmpStr=delScpScn(tmpStr);				setXmlStr(xmlEncabezado,tmpStr);				tmpXml = getXml(xmlEncabezado,"row");				frn.lib("libGeneral.kpl","FileSave",tmpXml, fileSavePath & "\comdevdircrud_xml_Converted_Enc");								//frn.setX(tmpXml);				if(nXml(tmpXml) == 0){					frn.message("La Referencia No existe","Error","Aceptar");					return;								}				frn.setX(tmpXml); // 20220719 cambio de ubicacion 				frn.set("k_fecha_exp", "Referencia Válida");								//Datos Detalle				rstXml(xmlDetConv);				tmpStr=getXmlAtt(cuboQuery,"r0","detpartidas");				rstXml(xmlDetalle);				tmpStr=delScpScn(tmpStr);				setXmlStr(xmlDetalle,tmpStr);				contDet=nXml(xmlDetalle);				for(var y=0; y< contDet; y++){					rstXml(xmlCurDet);					xmlCurDet= getXmlX(xmlDetalle,3,y);											setXml(xmlDetConv,"k_mov","r"&y,xmlCurDet);				}					frn.setX(xmlDetConv);				frn.lib("libGeneral.kpl","FileSave",xmlDetConv, fileSavePath & "\comdevdircrud_xml_Converted_Det");								return;						   } // End MostrarOrden()		            fun MostrarDEV(nFolio) {				var folio, refer, xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle, cuboDEV;				var tmpStr, tmpXml, contDet, xmlCurDet, xmlDetConv;				// Guarda Datos para Busqueda 				frn.set("k_fecha_exp", "");				sucursal_id = frn.get("k_sucn",-1,1);								refer = frn.get("k_refer");				proveedor_id = frn.get("k_clave");				folio = nFolio;												// Limpia Pantalla				//ModoBuscar(); -- Commented -> verificar si aqui debe ir o No 									setXml(xmlRequest,"document","sucursal_id",sucursal_id);				setXml(xmlRequest,"document","proveedor_id",proveedor_id);				setXml(xmlRequest,"document","referencia",refer);				setXml(xmlRequest,"document","genero","X");				setXml(xmlRequest,"document","naturaleza","D");				setXml(xmlRequest,"document","grupo","40");				setXml(xmlRequest,"document","tipo","1");				setXml(xmlRequest,"document","folio",folio);					//frn.message("Se consultará el siguiente folio : " & folio,"Info","Aceptar");					// /*				// ... jmm_test6_comdevbusca_sel 				cmdQuery = "select * from keplersc.comdevbusca_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				frn.lib("libGeneral.kpl","FileSave",xmlRequest, fileSavePath & "\comdevdircrud_xml_RequestFromK80TOPostgreSql_buscar");								rstXml(cuboDEV);				cuboDEV = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comdevdircrud.MostrarDEV()");				frn.lib("libGeneral.kpl","FileSave",cuboDEV, fileSavePath & "\comdevdircrud_xml_GottenOfPostgreSql_buscar");								ok = getXmlAtt(cuboDEV,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboDEV,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}									//Datos de encabezado				tmpStr=getXmlAtt(cuboDEV,"r0","encabezado");				rstXml(xmlEncabezado);				tmpStr=delScpScn(tmpStr);				setXmlStr(xmlEncabezado,tmpStr);				tmpXml = getXml(xmlEncabezado,"row");				frn.lib("libGeneral.kpl","FileSave",tmpXml , fileSavePath & "\comdevdircrud_xml_Converted_Enc_buscar");								frn.setX(tmpXml);				if(nXml(tmpXml) == 0){					frn.message("La Devolución : " & folio & ", No se encontró ...","Error","Aceptar");					LimpiaDatosProv(); //220725					return;								}				//frn.set("k_fecha_exp", "Referencia Válida");								// 220722 ... Added				BuscarProveedor(2);								//Datos Detalle				rstXml(xmlDetConv);				tmpStr=getXmlAtt(cuboDEV,"r0","detpartidas");				rstXml(xmlDetalle);				tmpStr=delScpScn(tmpStr);				setXmlStr(xmlDetalle,tmpStr);				contDet=nXml(xmlDetalle);				for(var y=0; y< contDet; y++){					rstXml(xmlCurDet);					xmlCurDet= getXmlX(xmlDetalle,3,y);											setXml(xmlDetConv,"k_mov","r"&y,xmlCurDet);				}					frn.setX(xmlDetConv);				frn.lib("libGeneral.kpl","FileSave",xmlDetConv, fileSavePath & "\comdevdircrud_xml_Converted_Det_buscar");				// */								return;									   } //End MostrarDEV()		   			fun CalculaTotales(iModo) {				var subTotal = 0, iva = 0, total = 0;				var clave="", devuelto = 0, comprado = 0, inventario = 0,porDevolver = 0 ;				var cantValida = 1;				clave=frn.get("k_mov",-1,"k_parte");				comprado=frn.get("k_mov",-1,"k_qc");				devuelto=frn.get("k_mov",-1,"k_qd");				inventario=frn.get("k_mov",-1,"k_qi");				porDevolver=frn.get("k_mov",-1,"k_q");								//Validar que exista producto en el renglon				if(clave &="" || !clave){					frn.setX("","k_mov",-1,"k_q");					frn.setPos("k_mov",-1,"k_q");					return;				}									//Validar que no exceda comprado, ni devoluciones disponibles 				if(comprado<devuelto+porDevolver){					frn.setPos("k_mov",-1,"k_q");					if (porDevolver != 0 || iModo == 1) { //220721 ... add this condition  						if ( (strlen(frn.get("k_mov",-1,"k_q")) > 0) && frn.get("k_mov",-1,"k_q") > 0 ) { // 220725							frn.message("La cantidad a devolver No puede exceder a la cantidad comprada ni a la cantidad devuelta acumulada.");						} else {							frn.message("La cantidad de esta partida excede a la cantidad disponible por devolver.");						}					}					cantValida=0;				}else{									//Validar que no exceda inventario					if(inventario<porDevolver){						frn.setPos("k_mov",-1,"k_q");						if (porDevolver != 0 || iModo == 1) { //220721 ... add this condition  							if ( (strlen(frn.get("k_mov",-1,"k_q")) > 0) && frn.get("k_mov",-1,"k_q") > 0 ) { // 220725								frn.message("La cantidad a devolver no puede exceder a la cantidad en inventario.");							} else {								frn.message("La cantidad de esta partida excede a la cantidad disponible en inventario.");							}						} 						cantValida=0;					}								}								//Calcular importe del renglon actual				if(cantValida==1){					if ( strlen(frn.get("k_mov",-1,"k_q")) == 0 || frn.get("k_mov",-1,"k_q") == 0 ) { // 220801 						frn.setX("","k_mov",-1,"k_monto");					} else {						frn.setX(frn.get("k_mov",-1,"k_q") * frn.get("k_mov",-1,"k_pc"),"k_mov", -1, "k_monto") ;					}				}else{					if ( strlen(frn.get("k_mov",-1,"k_q")) > 0 ) { // 220725						frn.setX(0,"k_mov",-1,"k_monto");					} else { // 220725 						frn.setX("","k_mov",-1,"k_monto");					}				}								//Calcular totales				for (var i=0; i<frn.N("k_mov"); i++) {					subTotal = subTotal + frn.get("k_mov",i,"k_monto");					//frn.setX(frn.get("k_mov",i,"k_ic"),"k_mov",i,"k_precio"); 				}				iva = subTotal * (frn.get("k_porciva"))/100;				total = subTotal + iva;								frn.set("k_subtotal",subTotal);				frn.set("k_iva",iva);				frn.set("k_monto",total);				return cantValida;			}									} // End of class Main			</script></pag>