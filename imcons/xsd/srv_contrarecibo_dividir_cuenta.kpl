<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Divisi&#243;n de Cuentas M&#250;ltiple">    <grp dim="1,-1,10,25" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16">        <br/>        <grp dim="60,25,7,12" bclr="236,240,243" clrBrdr="0,58,112" brdr="0,5" tit="Panel de Divisi&#243;n">            <br/>            <sp n="1"/><txt fnt=",b">Cuenta Origen:</txt>            <inp id="k_cuenta_origen" dim="12,1" modify="N" bclr="240,240,240"/>            <inp id="k_descripcion_origen" dim="35,1" modify="N" bclr="240,240,240" type="string" available="N"/>            <txt> Saldo:</txt>            <inp id="k_monto_disponible" dim="12,1" modify="N" type="number" nd="2" bclr="240,240,240"/>            <inp id="k_asiento_origen" dim="2,1" visible="N"/>            <br/><br/>                       <tab/>            <tbl id="k_divisiones" dim="75,10" brdr="1,0" modify="Y" insdel="Y" OnChange="ValidarTotales()">                <col id="k_cuenta" name="Nueva Cuenta" type="capital" OnF9="selecciona_cuenta()" OnChange="valida_cuenta_renglon()" np="120"/>                <col id="k_desc" name="Descripci&#243;n" modify="N" np="250" available="N"/>                <col id="k_monto" name="Monto" type="number" nd="2" np="100"/>            </tbl>                       <br/>            <br/>            <tab/><txt fnt=",b">Total Dividido: </txt>            <inp id="k_total_dividido" dim="12,1" modify="N" type="number" nd="2" bclr="255,255,255" clr="0,0,150" fnt=",b" available="N"/>            <sp n="5"/>            <br/><br/><tab n="20"/>            <bot id="Aceptar" dim="15,0" text="Aplicar Cambios" OnEnter="Execute()" dim="20,0" brdr="5" default="1"/>        </grp>    </grp>    <script>        InstallDriver("KDB75");        class Main {            var frn, frP, sys, kdb;            var aoo, monto_max;            fun Main() {                frn=new FRNT; kdb=new KDB; frP=new FRNTP; sys=new SYS;                kdb.connect();                aoo = mid(fnDate("year",sys.date()),2);                               var cta = frP.get("k_mov",-1,"k_cuenta");                var dsc = frP.get("k_mov",-1,"k_cuentadesc");                var cargo = frP.get("k_mov",-1,"k_cargo");                var abono = frP.get("k_mov",-1,"k_abono");                               monto_max = cargo;                frn.set("k_asiento_origen", "C");                if (cargo == 0) {                    monto_max = abono;                    frn.set("k_asiento_origen", "A");                }                frn.set("k_cuenta_origen", cta);                frn.set("k_descripcion_origen", dsc);                frn.set("k_monto_disponible", monto_max);            }            fun ValidarTotales() {                var total = 0;                var nReg = frn.N("k_divisiones") - 1;                               for (var i=0; i < nReg; i++) {                    total = total + frn.get("k_divisiones", i, "k_monto");                }                               if (total > monto_max) {                    frn.message("El monto total (" & total & ") excede el saldo disponible (" & monto_max & ")", "Exceso de Monto", "Aceptar");                    frn.setX(0, "k_divisiones", -1, "k_monto");                    ValidarTotales();                    return;                }                               frn.set("k_total_dividido", total);            }        fun valida_cuenta_renglon() {            var cuenta = trim(frn.get("k_divisiones", -1, "k_cuenta"));                        if (cuenta &= "") {                frn.setX("", "k_divisiones", -1, "k_cuenta");                frn.setX("", "k_divisiones", -1, "k_desc");                frn.setX(0.00, "k_divisiones", -1, "k_monto");                ValidarTotales();                return;            }            var cmd = "SELECT c2 FROM keplersc.kdc1" & aoo & " WHERE c1 = '" & cuenta & "'";            var cuboDesc;            kdb.rst(cuboDesc);            cuboDesc = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"BuscaDesc()");                       if (nXml(cuboDesc) > 0) {                frn.setX(getXmlAtt(cuboDesc, "r0", "c2"), "k_divisiones", -1, "k_desc");            } else {                frn.message("La cuenta " & cuenta & " no existe.", "Error", "Aceptar");                frn.setX("", "k_divisiones", -1, "k_cuenta");                frn.setX("", "k_divisiones", -1, "k_desc");                frn.setX(0.00, "k_divisiones", -1, "k_monto");                ValidarTotales();             }        }        fun selecciona_cuenta() {            var tabla = "keplersc.kdc1" & aoo;            var cmd = "SELECT c1 as clave, c2 as nombre FROM " & tabla;            frn.dialog("genlistafiltrosel", "Cuentas", cmd, "clave", "k_divisiones", "", "k_cuenta", "N", "S", "valida_cuenta_renglon()");        }                          fun Execute() {            var total_div = frn.get("k_total_dividido");            var nDivisiones = frn.N("k_divisiones") - 1;                        for (var j=0; j < nDivisiones; j++) {                var ctaCheck = trim(frn.get("k_divisiones", j, "k_cuenta"));                var montoCheck = frn.get("k_divisiones", j, "k_monto");                if (ctaCheck &= "") {                    if (montoCheck <= 0.00) {                        continue;                    }                }                if (montoCheck > 0.00) {                    if (ctaCheck &= "") {                        frn.message("Error: El renglon " & (j + 1) & " tiene cantidad pero no una cuenta valida. Debe dejar el monto en 0.00 si no asignara cuenta.", "Validacion Fallida", "Aceptar");                        return;                    }                }            }            if (total_div > monto_max) {                frn.message("No puede aplicar cambios: El monto total excede el original", "Error", "Aceptar");                return;            }                       if (total_div <= 0) {                frn.message("Debe ingresar al menos una division valida con cuenta y monto mayor a cero.", "Error", "Aceptar");                return;            }            var asiento = frn.get("k_asiento_origen");            var residuo = monto_max - total_div;            var ref_uuid = frP.get("k_mov", -1, "k_referencia_uuid");                       var cta_gpo_or = frP.get("k_mov", -1, "k_cuenta_grupo_origen");            var cta_plantilla_or = frP.get("k_mov", -1, "k_campo_cuenta_plantilla_origen");            var cto_inv_or = frP.get("k_mov", -1, "k_costo_inventario_origen");            if (asiento &= "C") {                frP.setX(residuo, "k_mov", -1, "k_cargo");                frP.setX(residuo, "k_mov", -1, "k_cargo_origen");            } else {                frP.setX(residuo, "k_mov", -1, "k_abono");                frP.setX(residuo, "k_mov", -1, "k_abono_origen");            }            for (var i=0; i < nDivisiones; i++) {                var n_cta = frn.get("k_divisiones", i, "k_cuenta");                var n_monto = frn.get("k_divisiones", i, "k_monto");                var n_desc = frn.get("k_divisiones", i, "k_desc");                if (n_cta > "" && n_monto > 0) {                    var ren_p = frP.N("k_mov") - 1;                                       frP.setX(n_cta, "k_mov", ren_p, "k_cuenta");                    frP.setX(n_desc, "k_mov", ren_p, "k_cuentadesc");                                       if (asiento &= "C") {                        frP.setX(n_monto, "k_mov", ren_p, "k_cargo");                        frP.setX(n_monto, "k_mov", ren_p, "k_cargo_origen");                    } else {                        frP.setX(n_monto, "k_mov", ren_p, "k_abono");                        frP.setX(n_monto, "k_mov", ren_p, "k_abono_origen");                    }                                       frP.setX(frP.get("k_mov", -1, "k_cuenta_origen"), "k_mov", ren_p, "k_cuenta_origen");                    frP.setX(frP.get("k_mov", -1, "k_cuentadesc_origen"), "k_mov", ren_p, "k_cuentadesc_origen");                    frP.setX(cta_gpo_or, "k_mov", ren_p, "k_cuenta_grupo_origen");                                       frP.setX("N", "k_mov", ren_p, "k_cuenta_grupo");                    frP.setX("N", "k_mov", ren_p, "k_cuenta_divisible");                    frP.setX("N", "k_mov", ren_p, "k_cuenta_divisible_origen");                                       frP.setX(cta_plantilla_or, "k_mov", ren_p, "k_campo_cuenta_plantilla");                    frP.setX(cta_plantilla_or, "k_mov", ren_p, "k_campo_cuenta_plantilla_origen");                    frP.setX(cto_inv_or, "k_mov", ren_p, "k_costo_inventario");                    frP.setX(cto_inv_or, "k_mov", ren_p, "k_costo_inventario_origen");                    frP.setX(frn.get("k_cuenta_origen"), "k_mov", ren_p, "k_cuenta_base");                    frP.setX(ref_uuid, "k_mov", ren_p, "k_referencia_uuid");                                   }             }            frP.script("CalcTotal()");            frn.exit();        }        }    </script></pag>