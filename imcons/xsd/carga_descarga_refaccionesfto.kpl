			<sp/><txt fnt="Arial,0b">Subtotal</txt>
				<sp n="2"/><tab n="2"/><inp id="rep_subtotal"  dim="20,1" brdr="0,1" just="R" type="number" fnt="Arial,15" nd="2"/><br/>
