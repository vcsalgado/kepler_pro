<?xml version="1.0" encoding="UTF-8"?><pag xmlns='www.kepler.com.mx/2003/KSchema' tit='Alta Pedido Consultas' scale="48"><grp dim='1,-1,10,20' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">	<br exe="encabezado"/>	<hLine dim="90,0"/>	<br exe="encabezado"/>	<grp dim="16,8,7,12"><sp/>		<img id="img"  dim="14,80" brdr="0,1" img="logocliente.jpg"/>	</grp>		<grp dim="120,16,7,1">		<inp id="k_empresa" just="C" fnt=",20b" dim="80,1" clr="0,58,112" type="string" available = "N"/>				<br/>		<inp id="titulo"  dim="40,1" clr="0,58,112" brdr="0,1" type="string" fnt="Arial,20b"/>		<tab n="10"/><sp/><txt fnt="Arial,20" clr="255,0,0">No.</txt>		<inp id="rep_docto"  just="R" dim="25,1" brdr="0,1" type="string" fnt="Arial,18" clr="255,0,0" nc="7"/>		<br/>		<txt fnt="Arial,18">Sucursal:</txt>		<inp id="rep_suc"  just="L" dim="30,1" brdr="0,1" type="string" fnt="Arial,16" nc="20"/>		<tab n="10"/>		<sp/><txt>Ref:</txt>		<inp id="rep_refer" just= "R" dim="25,1" brdr="0,1" type="string" fnt="Arial,15" fmt="DD/MM/CCYY" nc="-1"/><br/>		<tab n="22"/><sp n="2"/><txt>Fecha:</txt>		<inp id="rep_fecha" dim="25,1" just= "R" brdr="0,1" type="date" fnt="Arial,15" fmt="DD/MM/CCYY" nc="-1"/>	</grp>		<sp/>	<br exe="encabezado"/>	<tab n="1"/>		<br exe="seccion_detalle"/>	<hLine dim="90,0"/>		<br exe="seccion_detalle"/>	<grp dim="90,25,7,14">		<txt>Clave del cliente :  </txt><sp/>		<inp id="rep_cliente"  just="C" dim="10,1" brdr="0,1" type="string" fnt="Arial,15" nc="10"/>		<inp id="rep_clientedir1" just="L" dim="60,1" brdr="0,1" type="string" fnt="Arial,15"/>		<br/><txt>RFC:</txt><sp/>		<inp id="rep_rfc"  dim="25,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>		<txt>Nombre del Cliente :</txt>		<inp id="rep_nombrecliente"   dim="100,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>				<txt>Nombre de impresi&#243;n:</txt>		<inp id="rep_nombreimpresion"   dim="100,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>		<txt>Direcci&#243;n:</txt>		<inp id="rep_clientedir2"  dim="200,1" brdr="0,1" type="string" fnt="Arial,15"/>					<br/>		<txt>Colonia :</txt>		<inp id="rep_colonia"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		<txt>Poblaci&#243;n :</txt>		<inp id="rep_poblacion"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		<txt>Tel&#233;fono :</txt><sp/>		<inp id="rep_telefono"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		<br/>				<txt>Agente: </txt><sp/>		<inp id="rep_condiciones"  dim="40,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>		<txt>Del veh&#237;culo: </txt><sp/>		<inp id="rep_usadonuevo"  dim="15,1" brdr="0,1" type="string" fnt="Arial,15"/>		<txt> que a continuaci&#243;n se especifica: </txt><sp/><br/>		<txt>N&#250;mero de Inventario: </txt><sp/>		<inp id="rep_inventario"  dim="15,1" brdr="0,1" type="string" fnt="Arial,15"/>		<txt>Anterior: </txt><sp/>		<inp id="rep_inventario_anterior"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		<tab/><txt>Serie: </txt><sp/>		<inp id="rep_serie"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		<tab n="2"/><txt>Modelo : </txt><sp/>		<inp id="rep_modelo"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>		<txt>Marca : </txt><sp/>		<inp id="rep_marca"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="2"/>		<txt>Clase : </txt><sp/>		<inp id="rep_clase"  dim="17,1" brdr="0,1" type="string" fnt="Arial,15"/><sp/>		<txt>Tipo de Operaci&#243;n: </txt><sp/>		<inp id="rep_tipooperacion"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		<txt>Transmisi&#243;n:</txt><sp/>		<inp id="rep_transmision"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		<br/>		<txt>Tipo: </txt><sp/>		<inp id="rep_tipo"  dim="40,1" brdr="0,1" type="string" fnt="Arial,15"/>		<txt>Color: </txt><sp/>		<inp id="rep_color"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		<txt>Vestiduras: </txt><sp/>		<inp id="rep_vestiduras"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>			<br/>		<tab n="3"/><txt>IMPORTE DE LA OPERACI&#211;N:</txt><tab n="10"/><txt>|</txt>		<br/>		<tab n="7"/><txt>Precio Base: </txt><tab n="4"/><txt>$</txt>		<inp id="rep_preciobase"  dim="15,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/>		<tab n="2"/>		<txt>|        G. Administrativos</txt><tab n="2"/><txt>$</txt>		<inp id="rep_ad_administrativos"  dim="15,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/><br/>		<tab n="7"/><txt>I.S.V.N.: </txt><tab n="5"/><txt>$</txt>		<inp id="rep_precioisvn"  dim="15,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/>		<tab n="2"/>		<txt>|        Accesorios</txt><tab n="4"/><txt>$</txt>		<inp id="rep_ad_accesorios"  dim="15,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/><br/>				<tab n="7"/><txt>16 % IVA de la Unidad: </txt><tab/><txt>$</txt>		<inp id="rep_precioiva"  dim="15,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/>		<tab n="2"/>		<txt>|        Garant&#237;a extendida</txt><tab n="2"/><txt>$</txt>		<inp id="rep_ad_garantiaext"  dim="15,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/><br/>				<tab n="7"/><txt>TOTAL: </txt><tab n="5"/><txt>$</txt>		<inp id="rep_preciototal"  dim="15,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/>		<tab n="2"/>		<txt>|        Seguro autom&#243;vil</txt><tab n="2"/><txt>$</txt>		<inp id="rep_ad_seguroauto"  dim="15,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/>		<br/>		<tab n="3"/><txt>FORMA DE PAGO</txt><tab n="14"/><txt>|</txt>				<br/>		<tab n="8"/><txt>Folio</txt><tab n="4"/><txt>Monto</txt><tab n="7"/>		<txt>|        Intereses</txt><tab n="4"/><txt>$</txt>		<inp id="rep_ad_intereses"  dim="15,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/><br/>		<tab n="21"/>		<txt>|        Cobranza</txt><tab n="4"/><txt>$</txt>		<inp id="rep_ad_cobranza"  dim="15,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/><br/>		<br/>		<tab n="21"/>		<txt>|        Descuentos</txt><tab n="4"/><txt>$</txt>		<inp id="rep_ad_descuentos"  dim="15,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/>	</grp>	<br exe="seccion_detalle"/>		<br exe="seccion_detalle_tres"/>	<hLine dim="90,0"/>		<br exe="seccion_detalle_tres"/>	<grp dim="110,40,7,14">		<br/>		<sp/><tab n="20"/><txt fnt="Arial,20b">RECIBO</txt><br/><br/>		<sp/><txt fnt="Arial,18b">Recib&#237; de </txt>		<inp id="rep_suc_recibi"  just="L" dim="60,1" brdr="0,1" type="string" fnt="Arial,18b"/> <br/>		<br/><sp/><txt fnt="Arial,18b">Los siguientes documentos correspondientes a la unidad antes descrita</txt>		<br/><br/><tab n="6"/><sp n="2"/><txt fnt="Arial,15b">* Carta Factura</txt><tab n="6"/><txt>*Herramienta</txt><tab n="6"/>		<br/><tab n="6"/><sp n="2"/><txt fnt="Arial,15b">* P&#243;liza de Garant&#237;a</txt><tab n="5"/><txt>*Reflejantes</txt><tab n="6"/>		<br/><tab n="6"/><sp n="2"/><txt fnt="Arial,15b">* Manual del Propietario</txt><tab n="4"/><txt>*Auto en perfectas condiciones</txt><tab n="6"/>		<br/><br/><sp/><txt fnt="Arial,18b">Recib&#237;: ______________________Nombre: ___________________________</txt>		<br/><br/><sp/><txt fnt="Arial,18b">Factura original No:___________ Fecha:___________ Recib&#237;:___________ </txt>		<br/><br/><sp/><txt fnt="Arial,10b">====================================================================================================================================================================================================</txt>		<br/><br/><sp/><txt fnt="Arial,18b">Estoy enterado de las condiciones y t&#233;rminos en que se aplica la p&#243;liza de garant&#237;a del veh&#237;culo que estoy adquiriendo las </txt>		<br/><sp/><txt fnt="Arial,18b">cuales me fueron explicadas ampliamente por el agente de ventas que me atendi&#243;.</txt>				<br/><sp/><txt fnt="Arial,18b">La venta  de unidades usadas exime a la Agencia a expedir Garant&#237;a sobre el objeto de la venta, aceptando el comprador las</txt>		<br/><sp/><txt fnt="Arial,18b">condiciones en las que se encuentre.</txt>		<br/><br/><br/><sp n="3"/><tab n="12"/><txt fnt="Arial,18b">Firma del cliente: ____________________</txt>	</grp>	<br exe="seccion_detalle_tres"/></grp><script>	/*	----------------------------------------------------------------	AUTOR						FECHA					CAMBIO	----------------------------------------------------------------	Saltiel					29-09-2022		----------------------------------------------------------------			*/	</script></pag>