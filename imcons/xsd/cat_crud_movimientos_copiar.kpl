<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<tab/><txt fnt=",22" clr="0,0,0">Copia de Movimiento</txt>		<br/><br/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp dim="50,24,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" fnt="Arial,16" tit="General"><tab/><br/>			<tab/><txt>Sucursal: </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="56,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" tooltip="Sucursal" available="Y" modify="Y"/>			<tab/><br/><br/><tab/><txt fnt=",0b">Origen: </txt><br/><tab/>			<txt>Genero:</txt>			<inp id="k_gen_or" dim="2,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="1" OnChange="ValidarGen(or)" tooltip="Genero del documento"/><tab/>			<txt>Naturaleza:</txt>			<inp id="k_nat_or" dim="2,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="1" OnChange="ValidarNat(or)" tooltip="Naturaleza del documento"/><tab/><txt>Grupo:</txt>			<inp id="k_gpo_or" dim="5,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number" nc="3" tooltip="Grupo del documento" nd="0" min="1" max="999"/><tab n="2"/>			<txt>Tipo:</txt><tab/>			<inp id="k_tipo_or" dim="3,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number" nc="2" tooltip="Tipo del documento" nd="0" min="1" max="99"/><br/><tab/>			<txt>Descripcion:</txt><tab/>			<inp id="k_desc_or" dim="53,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="50" OnChange="ValidarDesc(or)" tooltip="Descripcion del documento" modify="N" available="N"/><br/>			<tab/><br/>			<tab/><txt fnt=",b">Destino:</txt><br/><tab/>			<txt>Genero:</txt>			<inp id="k_gen_new" dim="2,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="1" OnChange="ValidarGen(new)" tooltip="Genero del documento"/><tab/>			<txt>Naturaleza:</txt>			<inp id="k_nat_new" dim="2,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="1" OnChange="ValidarNat(new)" tooltip="Naturaleza del documento"/><tab/><txt>Grupo:</txt>			<inp id="k_gpo_new" dim="5,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number" nc="3" tooltip="Grupo del documento" nd="0" min="1" max="999"/><tab n="2"/>			<txt>Tipo:</txt><tab/>			<inp id="k_tipo_new" dim="3,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number" nc="2" tooltip="Tipo del documento" nd="0" min="1" max="99"/><br/><tab/>			<txt>Descripcion:</txt><tab/>			<inp id="k_desc_new" dim="53,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="50" OnChange="ValidarDesc(new)" tooltip="Descripcion del documento"/><br/><tab n="7"/><br/><tab n="8"/>															<bot id="bot_aceptar" dim="20,0" brdr="5" text="Guardar" OnEnter="Execute()" default="1"/><br/>		</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP;			var gen_or,nat_or,gpo_or,tipo_or,desc_or;			var gen_new,nat_new,gpo_new,tipo_new,desc_new;			var cmdQuery, cubo, resultado, mensajeError,ok, totReg;						var sucursal,sucursal_or,sucursal_new, res;         var usuario, rol_usuario, asterisco, suc_usuario;						fun Main() {				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;								kdb.connect();				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				usuario = frn.config("user","name");								asterisco = "*";								Inicializa();			}						fun Inicializa(){				sucursal=frn.param(0);				gen_or=frn.param(1);				nat_or=frn.param(2);				gpo_or=frn.param(3);				tipo_or=frn.param(4);				desc_or=frn.param(5);				//Llenar combo sucursales				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";					}				}							rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_movimientos.IniCombos()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",cubo);					frn.set("k_gen_or",gen_or);				frn.set("k_nat_or",nat_or);				frn.set("k_gpo_or",gpo_or);				frn.set("k_tipo_or",tipo_or);				frn.set("k_desc_or",desc_or);				frn.set("k_gen_new",gen_or);				frn.set("k_nat_new",nat_or);				frn.set("k_gpo_new",gpo_or);				frn.set("k_tipo_new",tipo_or);				frn.set("k_desc_new",desc_or);								/*								if (gen_or &= "" || nat_or &= "" || gpo_or &= "" || tipo_or &= ""){					frn.message("Movimiento no valido.","Error","Aceptar");					frn.setAtt("btn_aceptar", "available", "N" );					frn.setAtt("btn_aceptar", "visible", "N" );										return;				}*/												frn.setAtt("btn_aceptar", "available", "Y" );				frn.setAtt("btn_aceptar", "visible", "Y" );			}						fun ValidarGen(source){				var gen=frn.get("k_gen_" & source);				res=1;				if (gen &! "U" && gen &! "N" && gen &! "X"){					frn.message("Genero no valido.","Error","Aceptar");					frn.setPos("k_gen_" & source);					res=0;				}				return res;			}			fun ValidarNat(source){				var nat=frn.get("k_nat_" & source);				res=1;				if (nat &! "D" && nat &! "A"){					frn.message("Naturaleza no valida.","Error","Aceptar");					frn.setPos("k_nat_" & source);					res=0;				}				return res;			}			fun ValidarDesc(source){				var desc=frn.get("k_desc_" & source);				res=1;				if (desc &= ""){					frn.message("Descripcion no valida.","Error","Aceptar");					frn.setPos("k_desc_" & source);					res=0;				}				return res;			}						fun Execute() {				var campo,xmlRequest ;								sucursal_or= frn.get("k_sucn",-1,1);				gen_or=frn.get("k_gen_or");				nat_or=frn.get("k_nat_or");				gpo_or=frn.get("k_gpo_or");				tipo_or=frn.get("k_tipo_or");				desc_or=frn.get("k_desc_or");				sucursal_new= frn.get("k_sucn",-1,1);				gen_new=frn.get("k_gen_new");				nat_new=frn.get("k_nat_new");				gpo_new=frn.get("k_gpo_new");				tipo_new=frn.get("k_tipo_new");				desc_new=frn.get("k_desc_new");												campo="or";				res = 1;				res=ValidarGen(campo);				if(res == 0){					return;				}								res=ValidarNat(campo);				if(res == 0){					return;				}				//Validar que movimiento origen existe				cmdQuery="select count(*) as totReg from keplersc.kdmm where col_sucursal='" & sucursal_or & "' and c1='" & gen_or & "' " &					"and c2='" & nat_or & "' and c3=" & gpo_or & " and c4=" & tipo_or;				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_movimimentos_copiar.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									totReg = getXmlAtt(cubo,"r"&0,"totreg");								if(totReg &= "0"){					mensajeError = "No existe el movimiento origen.";					frn.message(mensajeError,"Error","Aceptar");					return;				}								cmdQuery="select c5 as descripcion from keplersc.kdmm where col_sucursal='" & sucursal_or & "' and c1='" & gen_or & "' " &					"and c2='" & nat_or & "' and c3=" & gpo_or & " and c4=" & tipo_or;				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_movimimentos_copiar.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var str = getXmlAtt(cubo,"r"&0,"descripcion");				frn.set("k_desc_or",str);												campo="ne" & "w";				res=ValidarGen(campo);				if(res == 0){					return;				}								res=ValidarNat(campo);				if(res == 0){					return;				}								res=ValidarDesc(campo);				if(res == 0){					return;				}															//Validar que movimiento origen existe				cmdQuery="select count(*) as totReg from keplersc.kdmm where col_sucursal='" & sucursal_new & "' and c1='" & gen_new & "' " &					"and c2='" & nat_new & "' and c3=" & gpo_new & " and c4=" & tipo_new;				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_movimimentos_copiar.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									totReg = getXmlAtt(cubo,"r"&0,"totreg");								if(totReg &! "0"){					mensajeError = "El movimiento destino ya existe.";					frn.message(mensajeError,"Error","Aceptar");					return;				}												var resultado_confirmacion = frn.message("Desea continuar?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}				xmlRequest = getXml(frn.dataPag());				setXml(xmlRequest,"movimiento","usuario",usuario);					frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmdQuery="SELECT * FROM keplersc.cat_crud_movimientos_copiar('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_crud_movimimentos_copiar.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResMovCopiar");									resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.message("Movimiento registrado","Mensaje","Aceptar");								frP.script("carga_tabla()");				frn.exit();												}					}	</script></pag>