<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Configuracion de Presupuesto"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,15,12" bclr="192,205,213" unfont="0">	<tab/>	<br/><sp/><txt clr="0,0,0" fnt=",22">Configuracion de Presupuesto</txt>	<br/>	<sp/>	<hLine clr="0,0,0"/>	<br/><br/>	<sp/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="60,42,7,11" brdr="0,5" tit="Presupuesto" fnt="Arial,16">		<tab/>		<txt>Sucursal:</txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="50,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  			available="Y" OnChange="ResetResults()"/><tab n="2"/>		<txt>A&#241;o: </txt>		<cmb id="k_anio" clr="64,64,64" clrBrdr="192,205,213" dim="10,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 			available="Y" OnChange="ResetResults()"/>        <tab/><txt>Mes:</txt>		<cmb id="k_mes" dim="6,1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" available="Y" fnt="Arial,0" Null="N" OnChange="ResetResults()"/>			<tab n="2"/>		<img id="bot_buscar" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_Registros()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><br/>		<tab/><txt clr="250,0,0">* Click para ver detalle de gastos</txt>		<tab n="17"/><txt clr="64,64,64" fnt=",b">Limite Presupuesto Mensual:</txt>		<inp id="lim_presupuesto" clr="64,64,64" bclr="255,255,255" dim="15,1" fnt="Arial,16" type="number" nd="2" modify="Y" available="Y" OnChange="CrudLimitePpto()" tooltip="Limite Presupuesto Mensual"/>		<br/><tab/>		<tbl clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" brdr="1,0" id="results" dim="123,19" 			nren="fijo" Reorder="Y" clrCur="192,205,213" OnEnter="ConsultarMovtos()" OnMouseD="ConsultarMovtos()" OnMouseL="ConsultarMovtos()">			<col name="Clave" id="clave" modify="N"/>            <col name="Descripcion" id="descipcion" modify="N"/>            <col name="Importe Presupuesto" id="imp_presupuesto" modify="Y" OnActive="CalculaTotales()" OnChange="limitePresupuesto" type="number" nd="2"/>			<col name="Ppto anterior" id="Ppto_ini" visible="N" type="number" nd="2"/>            <col name="Importe Gastado" id="imp_gastado" modify="N" OnActive="CalculaTotales()" type="number" nd="2"/>			<col name="SG" id="sobregastado" modify="N"/>		</tbl><br/>		<tab n="18"/><txt>Total Presupuesto:</txt><tab/>        <inp id="tot_presupuesto" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N" tooltip="Total Importe Presupuesto"/>		<tab n="2"/><txt>Total Gastado:</txt><tab/>        <inp id="tot_gastado" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N" tooltip="Total Importe Gastado"/>		<br/><tab n="31"/><txt>Total Disponible:</txt><tab/>        <inp id="tot_disponible" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N" tooltip="Total Importe Disponible"/>			<br/><tab/>		<txt>SG - Sobre Gastado</txt>        <tab n="34"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar Presupuesto &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>	</grp>	<br/><br/>		<sp/>		<grp bclr="236,240,243" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="60,22,7,11"  tit="Detalle de gastos" fnt="Arial,16" unfont="0"><tab/><txt clr="250,0,0">* Doble click para ver p&#243;lza del movimiento</txt><br/>			<tab/>			<tbl id="k_movtos" dim="123,12" brdr="1,0" clrBrdr="64,64,64" bclr="255,255,255" modify="N" nren="fijo" clr="64,64,64" clrCur="192,205,213" 				OnEnter="abrir_poliza()" OnMouseD="abrir_poliza()">				<col id="fecha" name="Fecha" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="folio" name="Folio" type="string"/>				<col id="proveedor" name="Proveedor" type="string"/>				<col id="importe" name="Importe" type="number" nd="2"/>				<col id="cuenta" name="Cuenta" type="string"/>							<col id="descripcion" name="Desc. Cuenta" type="string"/>				<col id="referencia" name="Referencia" type="string"/>				<col id="gen" name="Gen" type="string"/>				<col id="nat" name="Nat" type="string"/>				<col id="gpo" name="Gpo" type="string"/>				<col id="tipo" name="Tipo" type="string"/>				<col id="desc_movto" name="Desc. Movimiento" type="string"/>			<!--	<rec id="tot_movto" fixed="Y"/> -->			</tbl><br/>		</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,usuario,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;			var accion,tipoOper,tabla,desc_ope,resVal; 			var regTotales,ultimoValorEncontrado, contGlobalResults; //variables del llenado de la tabla			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna;			var cmd,cubo,ok,mensajeError;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				//Constantes				usuario = frn.config("user","name");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";				Inicializa();			}			fun ResetResults(){				frn.rst("results");							frn.rst("k_movtos");				frn.set("lim_presupuesto",0.00);				frn.set("tot_presupuesto",0.00);				frn.set("tot_gastado",0.00);				frn.set("tot_disponible",0.00);				frn.setAtt("tot_disponible","clr","64,64,64");				frn.setAtt("tot_presupuesto","clr","64,64,64");				}			fun ConsultarMovtos(){				var clave,descripcion,anio,mes,mes_desc;				var nReg, colCriterio,criterio,expWhere,expOrder;				//anio=mid(frn.get("k_anio",-1,0),2,2);				//Funciona con el cmd anterior				anio=frn.get("k_anio",-1,0);				clave=frn.get("results",-1,"clave");				mes=frn.get("k_mes",-1,0);								if (frn.get("results",-1,"imp_presupuesto")>0){/* Anterior inf. se obtenia de kdc2										cmd="select kdc2.c1 as k_poliza, kdc2.c2 as fecha, kdc2.c8 as tipopoliza, " &						"case when kdc2.c4 = 'C' then kdc2.c5 else 0 end cargo_movto, " &						"case when kdc2.c4 = 'A' then kdc2.c5 else 0 end abono_movto, " &						"kdc2.c6 as descripcion, kdc2.c7 as referencia, " &						"kdc2.c15 as genero, " &						"kdc2.c16 as naturaleza, " &						"kdc2.c17 as grupo, " &						"kdc2.c18 as tipo, " &						"mm.c5 as desc_movto, kdc2.c19 as folio " &						"from keplersc.kdc2_view kdc2, keplersc.kdmm mm " &						"where kdc2.anio='" & anio & "' and kdc2.mes = '" & mes & "' and kdc2.c21='" & clave & "' " &						"and kdc2.c14='" & frn.get("k_sucn",-1,1) & "' and kdc2.c15=mm.c1 and kdc2.c16=mm.c2 and kdc2.c17=mm.c3 and kdc2.c18=mm.c4 and kdc2.c14=mm.col_sucursal " &						"order by k_poliza";*/					cmd="select k1.c9 as fecha, k1.c6 as folio, k1.c10 as proveedor, coalesce(sum( case when upper(k6.c10) = 'C' then k6.c11 else case when upper(k6.c10) =  'A' then k6.c11 * -1 else 0 end end ),0) as importe,						k6.c8 as cuenta, k6.c9 as descripcion, k1.c11 as referencia, mm.c1 as gen, mm.c2 as nat, mm.c3 as gpo, mm.c4 as tipo, mm.c5 as desc_movto						from keplersc.kdm6 k6 						inner join keplersc.kdm1 k1 on k6.c1 = k1.c1 and k6.c2 = k1.c2 and k6.c3 = k1.c3 and k6.c4 = k1.c4 and k6.c5 = k1.c5 and k6.c6 = k1.c6 						inner join keplersc.kdmm mm on mm.col_sucursal=k1.c1 and mm.c1=k1.c2 and mm.c2=k1.c3 and mm.c3=k1.c4 and mm.c4=k1.c5						where k6.c1 = '" & frn.get("k_sucn",-1,1) & "' and k6.c2 = 'X' and k6.c3 = 'A' and k6.c4 = 12 and k6.c5 = 1 and k6.ctopto = '" & clave & "' 						and upper(k1.c43) <> 'C' and extract(year from k1.c9)::text = '" & anio & "' and lpad(extract(month from k1.c9)::text,2,'0') = '" & mes & "'						group by k1.c9, k1.c6, k1.c10, k1.c11, k6.c8, k6.c9, mm.col_sucursal, mm.c1, mm.c2, mm.c3, mm.c4, mm.c5						union all						select k1.c9 as fecha, k1.c6 as folio, k1.c10 as proveedor, coalesce(sum( case when upper(kd.c10) = 'C'  then kd.c11 else case when upper(kd.c10) = 'A' then kd.c11 * -1 else 0 end end ),0) as importe,						kd.c8 as cuenta, kd.c9 as descripcion, k1.c11 as referencia, mm.c1 as gen, mm.c2 as nat, mm.c3 as gpo, mm.c4 as tipo, mm.c5 as desc_movto 						from keplersc.kdmdocscompr kd 						inner join keplersc.kdm1 k1 on kd.c1 = k1.c1 and kd.c2 = k1.c2 and kd.c3 = k1.c3 and kd.c4 = k1.c4 and kd.c5 = k1.c5 and kd.c6 = k1.c6						inner join keplersc.kdmm mm on mm.col_sucursal=k1.c1 and mm.c1=k1.c2 and mm.c2=k1.c3 and mm.c3=k1.c4 and mm.c4=k1.c5						where kd.c1 = '" & frn.get("k_sucn",-1,1) & "' and kd.c2 = 'X' and kd.c3 = 'A' and kd.c4 = 12 and kd.c5 = 1 and kd.ctopto = '" & clave & "'						and upper(k1.c43) <> 'C' and extract(year from k1.c9)::text = '" & anio & "' and lpad(extract(month from k1.c9)::text,2,'0') = '" & mes & "'	  						group by k1.c9, k1.c6, k1.c10, k1.c11, kd.c8, kd.c9, mm.col_sucursal, mm.c1, mm.c2, mm.c3, mm.c4, mm.c5						order by fecha desc";											frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdConsMovtos");										cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"conconsultasaldos.ConsultarMovtos()");					//frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\xmConsMovtos");					ok=getXmlAtt(cuboXml,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}						frn.set("k_movtos",cuboXml);					CalculaTotales();				}else{					frn.rst("k_movtos");				}				}										fun Inicializa(){				var resValidacion,resMensaje ;							frn.rst("gpo_2");				//Encabezados();				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";								if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR" && rol_usuario &! "Administrador Kepler 8.0" && rol_usuario &! ""){											cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",getXml(cubo));					                //Anio                cmd = "SELECT concat('20',substring(table_name,5,2)) as anio from information_schema.tables                         where table_name like 'kdc22%'                        group by anio                        order by anio desc";                rstXml(cubo);							                cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"bonosporlinea.IniCombos()");                ok=getXmlAtt(cubo,"ok");                if(ok &! "" && !ok){                    mensajeError = getXmlAtt(cubo,"native3");                    mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);                    frn.message(mensajeError,"Error","Aceptar");                    return;                }			                frn.set("k_anio",cubo);                frn.set("k_anio",mid(sys.date(),0,4));                                //Mes                cmd = "select substring(table_name,7,2) as mes from information_schema.tables                    where table_name  like 'kdc22%'  and substring(table_name,7,2) != '' and table_name not like '%view%' group  by mes";                rstXml(cubo);									                cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comdevdircrud.IniCombos()");                ok=getXmlAtt(cubo,"ok");                if(ok &! "" && !ok){                    mensajeError = getXmlAtt(cubo,"native3");                    mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);                    frn.message(mensajeError,"Error","Aceptar");                    return;                }						                frn.set("k_mes",cubo);                frn.set("k_mes",mid(sys.date(),5,2));				frn.setAtt("tot_disponible","clr","64,64,64");				frn.setAtt("tot_presupuesto","clr","64,64,64");				frn.setAtt("aceptar","visible","Y");				Buscar_Registros();			}			fun Buscar_Registros(){				var nReg, colCriterio,criterio,expWhere,expOrder;				var carppto,strMes,strAnio,nivelUsuario,fec_gastado;				kdb.rst();				ResetResults();								frn.set("lim_presupuesto",ObtenerLimitePpto());				nivelUsuario=ValNivelUsuario();				if (ValNivelUsuario()>0){									frn.setAtt("lim_presupuesto","modify","Y");					frn.setAtt("lim_presupuesto","available","Y");				}else{					frn.setAtt("lim_presupuesto","modify","N");					frn.setAtt("lim_presupuesto","available","N");				}				if (frn.get("lim_presupuesto")==0){										frn.message("Falta monto de limite de presupuesto mensual|No podrá grabar","Atencion","Aceptar");					return;				}				tabla="kdc2"&mid(frn.get("k_anio",-1,0),2,2)&frn.get("k_mes",-1,0);				//Carga presupuesto si existe				cmd = "select count(*) as existe from keplersc.kdpresupuestos							where sucursal ='" & frn.get("k_sucn",-1,1) & "' and anio ='" & frn.get("k_anio",-1,0) & "' and mes ='" & frn.get("k_mes",-1,0) &"'";				rstXml(cuboXml);				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"presupuesto.buscar_registros()");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}					frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdexiste");				frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\cuboexiste");									if (getXmlAtt(cuboXml,"r0","existe") > 0){						desc_ope ="MODIFICAR";					fec_gastado = frn.get("k_anio",-1,0) & "-" & frn.get("k_mes",-1,0) & "-01";/* Anterior se obtenia inf de kdc2												cmd = "select ct.cve_concepto,ct.descripcion,pt.importe,pt.ppto_ant,pt.gastado								from (select sucursal,cve_concepto,descripcion								from keplersc.kdcatconpres where sucursal='" & frn.get("k_sucn",-1,1) & "') as ct								left join (select tbpt.sucursal, tbpt.cve_concepto,coalesce(tbpt.importe,0) as importe,coalesce(tbpt.importe,0) as ppto_ant,coalesce(sum(kdc.c5),0) as gastado								from keplersc.kdpresupuestos tbpt								left join keplersc."& tabla &" kdc on kdc.c14=tbpt.sucursal and tbpt.cve_concepto=kdc.c21 and kdc.c6 not like 'BAJA:%'								where tbpt.sucursal ='" & frn.get("k_sucn",-1,1) & "' and tbpt.anio ='" & frn.get("k_anio",-1,0) & "' and tbpt.mes ='" & frn.get("k_mes",-1,0) &								"' group by tbpt.sucursal,tbpt.cve_concepto,tbpt.importe) as pt on pt.sucursal=ct.sucursal and pt.cve_concepto= ct.cve_concepto order by ct.cve_concepto";*/					cmd = "select ct.cve_concepto,ct.descripcion,pt.importe,pt.ppto_ant,pt.gastado							from (select sucursal,cve_concepto,descripcion							from keplersc.kdcatconpres where sucursal='" & frn.get("k_sucn",-1,1) & "') as ct							left join (select tbpt.sucursal, tbpt.cve_concepto,coalesce(tbpt.importe,0) as importe,coalesce(tbpt.importe,0) as ppto_ant,							coalesce((select * from keplersc.prspto_ejercido_periodo(tbpt.sucursal,tbpt.cve_concepto,'"& fec_gastado &"'))::decimal,0) as gastado							from keplersc.kdpresupuestos tbpt							where tbpt.sucursal ='" & frn.get("k_sucn",-1,1) & "' and tbpt.anio ='" & frn.get("k_anio",-1,0) & "' and tbpt.mes ='" & frn.get("k_mes",-1,0) &							"' ) as pt on pt.sucursal=ct.sucursal and pt.cve_concepto= ct.cve_concepto 							order by ct.cve_concepto";					rstXml(cuboXml);					cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"presupuesto.buscar_registros()");					ok=getXmlAtt(cuboXml,"ok");					if(ok &! "" && !ok){							mensajeError = getXmlAtt(cuboXml,"native3");							//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;					}						frn.set("results",cuboXml);						}else{							desc_ope ="ALTA";					carppto=frn.message("¿Desea cargar el mes anterior?","Atencion",2);					if (carppto == 0){		//No						cmd="select cve_concepto as clave,descripcion,0 as presupuesto,0 as gastado							from keplersc.kdcatconpres							where sucursal='" & frn.get("k_sucn",-1,1) & "' order by cve_concepto";						rstXml(cuboXml);						cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"presupuesto.buscar_registros()");						ok=getXmlAtt(cuboXml,"ok");						if(ok &! "" && !ok){								mensajeError = getXmlAtt(cuboXml,"native3");								//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);								frn.message(mensajeError,"Error","Aceptar");								return;						}							frn.set("results",cuboXml);							}else {					//SI						strMes=frn.get("k_mes",-1,0)-1;						strMes = frn.lib("libGeneral.kpl","PadLeft",strMes,"2","0");						strAnio = frn.get("k_anio",-1,0);						if (strMes ==0){							strMes = 12;							strAnio = frn.get("k_anio",-1,0)-1;						}						//frn.message("mes:"&strMes & " año:" & strAnio);						cmd="select ct.cve_concepto,ct.descripcion,pt.importe,0 as gastado							from (select sucursal,cve_concepto,descripcion								from keplersc.kdcatconpres								where sucursal='" & frn.get("k_sucn",-1,1) & "') as ct							left join keplersc.kdpresupuestos pt on pt.sucursal=ct.sucursal and pt.cve_concepto= ct.cve_concepto 							and pt.anio='" & strAnio & "' and pt.mes ='" & strMes & "' order by ct.cve_concepto";							rstXml(cuboXml);							cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"presupuesto.buscar_registros()");							ok=getXmlAtt(cuboXml,"ok");							if(ok &! "" && !ok){									mensajeError = getXmlAtt(cuboXml,"native3");									//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);									frn.message(mensajeError,"Error","Aceptar");									return;							}								frn.set("results",cuboXml);							}									}				CalculaTotales();			}			fun ObtenerLimitePpto(){				cmd = "select coalesce(valor,'0') as valor from keplersc.param_oper_periodo						where sucursal ='" & frn.get("k_sucn",-1,1) & "' and anio ='" & frn.get("k_anio",-1,0) & "' and mes ='" & frn.get("k_mes",-1,0) & 						"' and lower(parametro)='limite presupuesto'";				rstXml(cuboXml);				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"presupuesto.buscar_registros()");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}					return getXmlAtt(cuboXml,"r0","valor");			}			fun ValNivelUsuario(){				cmd = "select count(*) as nivel from keplersc.param_opc_usr_sec						where sucursal ='" & frn.get("k_sucn",-1,1) & "' and opcion='Modifica limite presupuesto' and lower(usuario) = lower('" & usuario & "')"; 				rstXml(cuboXml);				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"presupuesto.buscar_registros()");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}					return(getXmlAtt(cuboXml,"r0","nivel"));								}			fun CrudLimitePpto(){				var xmlPantalla,parametro,resultado,mensaje,continua,strMsg;								//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;								if (frn.get("lim_presupuesto") &= 0){					resVal = 0;					frn.setPos("lim_presupuesto");					frn.message("El Limite de presupuesto mensual no puede ser 0","Atencion","Aceptar");					return;				}				if(ok &! "1" || resVal == 0){					return;				}				continua = frn.message("¿Desea actualizar el Limite de presupuesto mensual?","Atención",2);				if (continua == 0){					frn.set("lim_presupuesto",ObtenerLimitePpto());					CalculaTotales();					return;				}													parametro ="limite presupuesto";				setXml(xmlPantalla,"sucursal",frn.get("k_sucn",-1,1));							setXml(xmlPantalla,"anio",frn.get("k_anio",-1,0));				setXml(xmlPantalla,"mes",frn.get("k_mes",-1,0));				setXml(xmlPantalla,"parametro",parametro);				setXml(xmlPantalla,"valor",frn.get("lim_presupuesto"));				cmd="SELECT * FROM keplersc.param_oper_periodo_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				rstXml(cuboXml);					cuboXml= frn.lib("libGeneral.kpl","EjecutarSql",cmd,"presupuesto.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboXml, "c:\basura\XmlResultadoPresupuesto");									resultado = getXml(cuboXml,"resultado");				mensaje = getXml(cuboXml,"mensaje");									ok = getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboXml,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					CalculaTotales();					strMsg = "Limite de presupuesto mensual registrado " & mensaje;					frn.setAtt("aceptar","visible","N");					frn.message(strMsg, "Mensaje", "Aceptar");					return;				} else {					frn.message(mensaje, "Error", "Aceptar");					return;				}			}			fun CalculaTotales(){				var totdisponible = 0,totgastado = 0, totppto = 0, renglones;				//Calcular totales				renglones = frn.N("results");				for (var i=0; i<renglones; i++) {					totppto = totppto + frn.get("results",i,"imp_presupuesto");					totgastado = totgastado + frn.get("results",i,"imp_gastado");					if (frn.get("results",i,"imp_gastado")>frn.get("results",i,"imp_presupuesto")){						frn.setX("X","results",i,"sobregastado");					}				}				totdisponible = totppto-totgastado; 				frn.set("tot_presupuesto",totppto);				frn.set("tot_gastado",totgastado);				frn.set("tot_disponible",totdisponible);				if (totdisponible<0){					frn.setAtt("tot_disponible","clr","250,0,0");				}else{					frn.setAtt("tot_disponible","clr","64,64,64");				}				if (frn.get("lim_presupuesto") < frn.get("tot_presupuesto")){					frn.setAtt("tot_presupuesto","clr","250,0,0");				}else{					frn.setAtt("tot_presupuesto","clr","64,64,64");									}			}			fun VerificaPresupuesto{			}			fun limitePresupuesto(){				var tmpPresupuesto,tmpGastado,tmpPpto_ini;				CalculaTotales();				tmpPresupuesto=frn.get("results",-1,"imp_presupuesto");				tmpGastado=frn.get("results",-1,"imp_gastado");				tmpPpto_ini=frn.get("results",-1,"Ppto_ini");				//frn.message("pres:"& tmpPresupuesto &" gast:"& tmpGastado & "ppto_ini:" & tmpPpto_ini);				if (tmpPresupuesto > 0){					if (frn.get("lim_presupuesto") - frn.get("tot_presupuesto") < 0){						frn.setPos("results",-1,"imp_presupuesto");						frn.message("El Total de presupuesto rebasa Limite de presupuesto mensual","Atencion","Aceptar");						return;					}										//imp_presupuesto no sea menor al imp_gastado					if (tmpPresupuesto < tmpGastado){						frn.setX(tmpPpto_ini,"results",-1,"imp_presupuesto");						frn.setPos("results",-1,"imp_presupuesto");						frn.message("El Importe presupuesto no puede ser menor al Importe gastado.","Atencion","Aceptar");						return;					}				}				if (tmpPresupuesto < 0){					frn.setPos("results",-1,"imp_presupuesto");					frn.message("El Importe presupuesto no puede ser menor a 0","Atencion","Aceptar");					return;				}			}				fun abrir_poliza(){				var gen,nat,gpo,tipo,sucursal_id,anio,mes,tipo_poliza,folio,folio_pol,tipo_movto,param;				cmd ="";								sucursal_id = frn.get("k_sucn",-1,1);				anio=mid(frn.get("k_anio",-1,0),2,2);				mes=frn.get("k_mes",-1,0);																gen=frn.get("k_movtos",-1,"gen");				nat=frn.get("k_movtos",-1,"nat");				gpo=frn.get("k_movtos",-1,"gpo");				tipo=frn.get("k_movtos",-1,"tipo");				folio=frn.get("k_movtos",-1,"folio");				tipo_movto = "C";				if (folio &! "" && gen &! "" && nat &! "" && gpo &! "" && tipo &! ""){						//Obtener no. de poliza					cmd = "select kdc2.c1 as foliopol,kdc2.c8 as tipopoliza					from keplersc.kdc2_view kdc2					where kdc2.anio='" & anio & "' and kdc2.mes ='" & mes & "'					and kdc2.c14='" & frn.get("k_sucn",-1,1) & "' and kdc2.c15='" & gen & "' and kdc2.c16='" & nat & "' and kdc2.c17=" & gpo & " and kdc2.c18=" & tipo & " and kdc2.c19='" & folio & "'					limit 1";										rstXml(cuboXml);					cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"presupuesto.buscar_registros()");					ok=getXmlAtt(cuboXml,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					folio_pol = getXmlAtt(cuboXml,"r0","foliopol");					tipo_poliza = getXmlAtt(cuboXml,"r0","tipopoliza");					//param=gen & "," & nat &  "," & gpo & "," & tipo & "," & tipo_movto & "," & sucursal_id & "," & anio & "," & mes & "," & tipo_poliza & "," & folio_pol;					//frn.message(param,"Mensaje","Aceptar");						frn.dialog("conpolizapag.kpl",gen,nat,gpo,tipo,tipo_movto,sucursal_id,anio,mes,tipo_poliza,folio_pol);				} else{					frn.message("No hay poliza por mostrar","Atencion","Aceptar");				}				}			fun ValidarDatos(){				var tmpPresupuesto,tmpGastado,tmpPpto_ini,renglones;				renglones = frn.N("results");				if (frn.get("lim_presupuesto") &= 0){					resVal = 0;					frn.message("Falta Limite de presupuesto mensual","Atencion","Aceptar");					return;				}				if (frn.get("lim_presupuesto") - frn.get("tot_presupuesto") < 0){					resVal = 0;					frn.message("El Total de presupuesto rebasa Limite de presupuesto mensual","Atencion","Aceptar");					return;				}				for (var i=0; i<renglones; i++) {					tmpPresupuesto=frn.get("results",i,"imp_presupuesto");					tmpGastado=frn.get("results",i,"imp_gastado");					tmpPpto_ini=frn.get("results",i,"Ppto_ini");					//frn.message("pres:"& tmpPresupuesto &" gast:"& tmpGastado & "ppto_ini:" & tmpPpto_ini);					if (tmpPresupuesto > 0){						//imp_presupuesto no sea menor al imp_gastado						if (tmpPresupuesto < tmpGastado){							resVal = 0;							frn.setX(tmpPpto_ini,"results",i,"imp_presupuesto");							frn.setPos("results",i,"imp_presupuesto");							frn.message("El Importe presupuesto no puede ser menor al Importe gastado.","Atencion","Aceptar");							return;						}					}					if (tmpPresupuesto < 0){						frn.setPos("results",i,"imp_presupuesto");						resVal = 0;						frn.message("El Importe presupuesto no puede ser menor a 0","Atencion","Aceptar");						return;					}				}				}						fun Ejecuta() {				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;				var resultado, mensaje, folio;				fecha = sys.date();				hora= sys.time();								//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;								ValidarDatos();				if(ok &! "1" || resVal == 0){					return;				}				continua = frn.message("¿Desea continuar?","Atención",2);				if (continua == 0){					return;				}								xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;				setXml(xmlPantalla,"operacion",desc_ope);							setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"results","no_partidas",frn.N("results"));													frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"c:\basura\XmlPantallaPresupuestos");				cmd="SELECT * FROM keplersc.configurapresupuesto_alta('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				rstXml(cuboXml);					cuboXml= frn.lib("libGeneral.kpl","EjecutarSql",cmd,"presupuesto.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboXml, "c:\basura\XmlResultadoPresupuesto");									resultado = getXml(cuboXml,"resultado");				mensaje = getXml(cuboXml,"mensaje");									ok = getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboXml,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					strMsg = "Presupuesto registrado " & mensaje;					frn.setAtt("aceptar","visible","N");					frn.message(strMsg, "Mensaje", "Aceptar");					return;				} else {					frn.message(mensaje, "Error", "Aceptar");					return;				}			}																fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>