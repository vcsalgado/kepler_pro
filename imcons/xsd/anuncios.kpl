<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Anuncios"><grp id="usuario" brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>	<grp dim="67,12,10,12"><sp/><br/><br/><br/><br/>		<grp dim="20,9,1,12">			<img id="logoCliente"  dim="200,100" brdr="0,0" img="ClientLogo.png" available="N" bPx="1"/>		</grp>		<tab n="2"/>		<grp dim="42,9,10,12" hSpace="4"><br/><br/><br/>			<inp id="lblUser" clr="64,64,64"  dim="42,1" brdr="0,1" type="string" modify="N" available="N" just="R" fnt="Arial,25"/>		</grp><br/>	</grp><sp/>	<grp dim="26,15,1,12">		<img id="Logo"  dim="256,193" brdr="0,0" img="_Announcements.png" available="N" OnEnter="Pagina()" bPx="1"/>	</grp>	<inp id="pagina" clr="64,64,64"  dim="1,1" available="N" modify="N" visible="N" OnEnter="Pagina()"/>	<br/><tab/>	<grp id="anuncios"  dim="95,31,7,12" brdr="0,5" fnt="Arial,16" clr="64,64,64" bclr="236,240,243" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" tit="Avisos del d&#237;a - Mi&#233;rcoles 1 de agosto de 2018"><tab n="22"/>		<inp id="remitente" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" brdr="2,0" type="string" nc="15" fnt="Arial,16" modify="N" available="N" visible="N"/><edt id="fecha_ini" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" type="date" nc="12" bclr="255,255,255" fnt=",16b" page="_ks_fecha,fecha_ini" available="N" modify="N" visible="N"/>		<tab n="3"/><edt id="fecha_fin" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" type="date" nc="12" bclr="255,255,255" fnt=",16b" page="_ks_fecha,fecha_fin" modify="N" available="N" visible="N"/><br/><tab/>		<tbl id="tabla" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="130,19" modify="N" nren="fijo" OnF9="RevisaMensaje()" OnMouseD="RevisaMensaje()">			<col id="folio" name="Folio"  type="string" OnF9="RevisaMensaje()" OnMouseL="RevisaMensaje()" OnMouseD="RevisaMensaje()"/>			<col id="remitente" name="Remitente"  type="string"/>			<col id="fenvio" name="Fecha envio"  type="date" fmt="DD/MM/YY"/>			<col id="Asunto" name="Asunto"  type="string"/>			<col id="tipo" name="Tipo"  type="string"/>			<col id="leido" name="Leido"  type="string"/>			<col id="mensaje" name="Mensaje"  type="string" visible="N"/>			<col id="opcion"  name="Opcion" type="string" visible="N"/>		</tbl>		<tab/><br/><sp/>	</grp><br/></grp><script>	InstallDriver("KDB75");	class Main {		var frn,sys,kdb;		var usuario,tipoAdm;      fun Main() { 			frn=new FRNT; 			sys=new SYS;			kdb=new KDB;			kdb.connect();			frn.setAtt("usuario","tit","");			frn.setAtt("anuncios","tit","");			//Actualiza la pantalla de mensajes			//Obtiene el usuario			kdb.sp("security","dat");kdb.exec();			usuario=kdb.get("dat","user");			tipoAdm=kdb.get("dat","tipo");			kdb.open("l,kdmensajes");			//frn.setAtt("usuario","tit",kdb.get("dat","name"));			frn.set("lblUser",kdb.get("dat","name"));			frn.setAtt("anuncios","tit","Avisos del día - " & strFormat("date",sys.date(),0,"dayweek") );			frn.set("pagina","www.ERPKepler.com");			frn.set("fecha_fin",sys.date());			var nvafecha=fnDate("add",sys.date(),-10);			frn.set("fecha_ini",nvafecha);			frn.set("remitente",usuario);			BuscaMensajes();		}				fun BuscaMensajes(){			frn.rst("tabla");			//Inicializa la tabla de noticias			var fIni=frn.get("fecha_ini");			var fFin=frn.get("fecha_fin");			var rem=frn.get("remitente");			kdb.lim("l6>='" & fIni &"'");			kdb.lim("l6<='" & fFin &"'");			if (tipoAdm &! "A") { kdb.lim("l5='" & frn.get("remitente") &"'"); }			kdb.table("datmensajes,l,3,&,l1...l11");			kdb.exec();			//Obtiene los mensajes			var j=0;			for (var ii=0,n=kdb.N("datmensajes");ii<n;ii++){				frn.setX(kdb.get("datmensajes","r" & ii,"l1"),"tabla",j,"folio");				frn.setX(kdb.get("datmensajes","r" & ii,"l2"),"tabla",j,"remitente");				frn.setX(kdb.get("datmensajes","r" & ii,"l6"),"tabla",j,"fenvio");				frn.setX(kdb.get("datmensajes","r" & ii,"l10"),"tabla",j,"Asunto");				frn.setX(kdb.get("datmensajes","r" & ii,"l9"),"tabla",j,"leido");				frn.setX(kdb.get("datmensajes","r" & ii,"l7"),"tabla",j,"mensaje");				frn.setX(kdb.get("datmensajes","r" & ii,"l11"),"tabla",j,"opcion");				frn.setX("Mensaje","tabla",j,"tipo");				j=j+1;			}		}				fun RevisaMensaje(){			Ventana("manaleleemen",frn.get("tabla",-1,"folio"));		}				fun Ventana(arch,cmp0,cmp1,cmp2,cmp3,cmp4,cmp5,cmp6,cmp7,cmp8,cmp9) {//Abre la pagina indicada como dialogo SOLO si el campo cmp0 se puede modificar(El cmp0 puede ser una tabla, y cmp1 la columna)			var b_valido=1;			if(strlen(cmp0)>0){//Se toma el cmp0 como el objeto (o columna) al que se devolverá el resultado.				if(strlen(cmp1)>0){//Se toma el cmp1 como el nombre de la columna a la que se devolverá el resultado					if( frn.getAtt(cmp0,"modify",cmp1) &= "N" ) b_valido=0;					if( frn.getAtt(cmp0,"available",cmp1) &= "N" ) b_valido=0;					if( frn.getAtt(cmp0,"visible",cmp1) &= "N" ) b_valido=0;				}else{//No se especificó una tabla.					if( frn.getAtt(cmp0,"modify") &= "N" ) b_valido=0;					if( frn.getAtt(cmp0,"available") &= "N" ) b_valido=0;					if( frn.getAtt(cmp0,"visible") &= "N" ) b_valido=0;				}			}			if(b_valido==1)frn.dialog(arch,cmp0,cmp1,cmp2,cmp3,cmp4,cmp5,cmp6,cmp7,cmp8,cmp9);		}				fun Pagina(){			sys.shell(frn.get("pagina"));		}		   }   /*   Autor			Fecha			Cambio   --------------------------------   Carlos JAM	2009-12-01	-Se agrego al grid el campo de 'opcion' para que se diferencia el 'asunto' de la 'opcion'	Arlines Alv 2011-06-10	-Se actualizó la interfaz gráfica.	Verónica C. 2018-08-01	-Se deshabilita la opción de disponible al logo.   */</script></pag>