<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Catalogo de Cuentas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,15,12" bclr="192,205,213" unfont="0">	<tab/><br/><tab/><txt clr="0,0,0" fnt=",22">Cat&#225;logo de Cuentas</txt>	<br/>	<tab n="1"/>	<hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="62,42,10,10" brdr="0,5" tit="Lista de Cuentas" fnt="Arial,16">		<tab/>		<txt>Sucursal:</txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="40,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="BorraDatos()" 			available="Y" OnChange="ResetResults"/><tab/>		<txt>A&#241;o:</txt>		<cmb id="k_anio" clr="64,64,64" clrBrdr="192,205,213" dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 			available="Y" OnChange="ResetResults"/>		<br/><tab/><txt>Columna </txt>		<cmb id="k_filtros" clr="64,64,64" clrBrdr="192,205,213"  				dim="20,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  				Null="N" available="Y" tooltip="Selecciona columna base de b&#250;squeda"/>		<tab/>		<inp id="k_busqueda" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213"				type="capital" tooltip="texto a buscar"/>		<tab n="1"/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_Registros(1)" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>						<br/>		<tab n="1"/>		<tbl clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" brdr="1,0" id="results" dim="88,18" 			modify="N" nren="fijo" Reorder="Y" OnMouseD="Execute()">			<col name="C1" id="c1"/>		</tbl>		<tab n="1"/>		<br/>		<grp id="gpo_3" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="60,3,10,10" brdr="0,5" fnt="Arial,16" visible="S">			<tab n="1"/>			<bot id="k_btn_nuevo" dim="10,10" brdr="5" text="Agregar" default="0" step="0"  OnEnter="Nuevo()" fnt="Arial,16"/>			<bot id="k_btn_modificar" dim="10,0" brdr="5" OnEnter="Modificar()" text="Modificar"/>			<bot id="k_btn_eliminar" dim="10,0" brdr="5" OnEnter="Eliminar()" text="Eliminar"/> 			<bot id="k_btn_saldo" dim="10,0" brdr="5" OnEnter="Saldo()" text="Saldo Ini."/>			<bot id="k_btn_consultar" dim="10,0" brdr="5" OnEnter="Consultar()" text="Consultar"/>		</grp>		<br/>	</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;			var accion,tipoOper; //--------------------------------------------------------------------Agregar Variables de Codigo Duro --------------------------------------------------------------------			var regTotales,ultimoValorEncontrado, contGlobalResults; //variables del llenado de la tabla			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				//Constantes								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";				ConfiguraUI();				Inicializa();			}			fun ResetResults(){				frn.rst("results");			}			fun Nuevo(){				var anio;				anio=frn.get("k_anio",-1,0);							frn.dialog("cat_cuentas_crud","NUEVO","",anio,"Buscar_Registros(1)");			}						fun Modificar(){				var anio,clave,saldo_ini,cargos,abonos;				anio=frn.get("k_anio",-1,0);				clave=frn.get("results",-1,"cuenta");				saldo_ini=frn.get("results",-1,"saldo_ini");				cargos=frn.get("results",-1,"cargos");				abonos=frn.get("results",-1,"abonos");				if (clave==""){					frn.message("No ha seleccionado una cuenta de la lista","Mensaje","&Aceptar");					return;				}				frn.dialog("cat_cuentas_crud","MODIFICAR",clave,anio,"Buscar_Registros(1)"); 			}						fun Eliminar(){				var cmd, cubo, ok,resValidacion,resMensaje;				var anio,clave,saldo_ini,cargos,abonos;				anio=frn.get("k_anio",-1,0);				clave=frn.get("results",-1,"cuenta");				saldo_ini=frn.get("results",-1,"saldo_ini");				cargos=frn.get("results",-1,"cargos");				abonos=frn.get("results",-1,"abonos");				if (clave==""){					frn.message("No ha seleccionado una cuenta de la lista","Mensaje","&Aceptar");					return;				}				if (saldo_ini!=0 || cargos!=0 || abonos!=0){					frn.message("La cuenta seleccionada tiene movimientos, imposible eliminar.","Mensaje","&Aceptar");					return;				}				//Validar que cuenta sea de ultimo nivel				cmd = "select * from keplersc.verify_cuenta_ult_nivel('" & clave & "','" & anio & "')";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_cuentas_view.Eliminar()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				//frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\xmlEliminarCtaVal");				resValidacion=getXmlAtt(cubo,"r0","resultado");				resMensaje=getXmlAtt(cubo,"r0","mensaje");				if(resValidacion &= "0"){					frn.message(resMensaje,"Error","&Aceptar");					return;				}				frn.dialog("cat_cuentas_crud","ELIMINAR",clave,anio,"Buscar_Registros(1)");			}			fun Saldo(){				var cmd, cubo, ok,resValidacion,resMensaje;							var anio,clave,saldo_ini,cargos,abonos;				anio=frn.get("k_anio",-1,0);				clave=frn.get("results",-1,"cuenta");				saldo_ini=frn.get("results",-1,"saldo_ini");				cargos=frn.get("results",-1,"cargos");				abonos=frn.get("results",-1,"abonos");				if (clave==""){					frn.message("No ha seleccionado una cuenta de la lista","Mensaje","&Aceptar");					return;				}				//Validar que cuenta sea de ultimo nivel				cmd = "select * from keplersc.verify_cuenta_ult_nivel('" & clave & "','" & anio & "')";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_cuentas_view.Eliminar()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								resValidacion=getXmlAtt(cubo,"r0","resultado");				resMensaje=getXmlAtt(cubo,"r0","mensaje");				if(resValidacion &= "0"){					frn.message(resMensaje,"Error","&Aceptar");					return;				}												frn.dialog("cat_cuentas_crud","SALDO",clave,anio,"Buscar_Registros(1)"); 			}									fun Consultar(){				var clave,anio;				anio=frn.get("k_anio",-1,0);								clave=frn.get("results",-1,"cuenta");				if (clave==""){					frn.message("No ha seleccionado una cuenta de la lista","Mensaje","&Aceptar");					return;				}				frn.dialog("cat_cuentas_crud","CONSULTAR",clave,anio,"Buscar_Registros(1)");						}						fun Encabezados(){				var colIds, totReg, colNd;				frn.rst("results");								totReg=nXml(cuboXml);				colIds=getXmlAtt(cuboXml,"k_ColName");				colNd=getXmlAtt(cuboXml,"k_ColNd");				colNd=frn.lib("libGeneral.kpl","StrReplace",colNd,"1","2");				colNd=frn.lib("libGeneral.kpl","StrReplace",colNd,"-","");				if(colIds &! ""){					frn.setX(colIds,"results","k_ColName");					frn.setX(getXmlAtt(cuboXml,"k_ColType"),"results","k_ColType");					frn.setX(colNd,"results","k_ColNd");					frn.setAtt("llave","visible","N");				}							}			fun ConfiguraUI(){							}								fun Inicializa(){				var cmd, cubo, ok,resValidacion,resMensaje ;							frn.rst("gpo_2");				Encabezados();				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";								if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR" && rol_usuario &! "Administrador Kepler 8.0" && rol_usuario &! ""){											cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"carga_refacciones.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",getXml(cubo));									cmd="SELECT concat(substring(table_name,5,2)) as anio FROM INFORMATION_SCHEMA.TABLES 					WHERE TABLE_NAME LIKE 'kdc22%'					group by anio					order by anio desc";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"conpolizasView.Inicia_Forma()");				frn.set("k_anio",getXml(cubo));								Inicia_Forma();			}				fun Inicia_Forma(){				//Etiquetas 				frn.set("inp_mensaje","No se encontraron registros...");				//frn.set("inp_titulo",strTitulo);				frn.set("inp_filtros","Búsqueda");				//Obtencion de registros				Buscar_Registros(0);			}			fun Buscar_Registros(bini){				var cmd, mensajeError,ok,nReg, colCriterio,criterio,expWhere,expOrder;				var tabla;				kdb.rst();				frn.rst("results");				if (bini == 0){					tabla="kdc1";					colCriterio="";					criterio="";				}else{					tabla="kdc1"&frn.get("k_anio",-1,0);					colCriterio=frn.get("k_filtros",-1,0);					criterio=frn.get("k_busqueda");					if (colCriterio &! "" && criterio &! ""){						expWhere = frn.get("k_filtros",-1,0);						expWhere = " where " & expWhere & "::text like '%" & frn.get("k_busqueda") & "%' ";						expOrder = " order by " & frn.get("k_filtros",-1,0);					}									}				strQuery = "select * from (select c1 as cuenta, c2 as descripcion, c14 as saldo_ini, 					c27+c28+c29+c30+c31+c32+c33+c34+c35+c36+c37+c38 as cargos,					c63+c64+c65+c66+c67+c68+c69+c70+c71+c72+c73+c74 as abonos,					c14 + c27+c28+c29+c30+c31+c32+c33+c34+c35+c36+c37+c38 -					(c63+c64+c65+c66+c67+c68+c69+c70+c71+c72+c73+c74) as saldo_fin					from keplersc." & tabla & " order by c1) as resultados ";									cmd = strQuery & expWhere & expOrder;				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_cuentas_view.buscar_registros()");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}					Encabezados();				frn.set("results",cuboXml);				nReg=nXml(cuboXml);				regTotales = nReg;				if(nReg>0){				  frn.set("inp_mensaje","");									}				if (bini == 0){									frn.rst("k_filtros");					llenar_filtro_busqueda(cuboXml,"k_filtros");				}			}			fun llenar_filtro_busqueda(cuboResultados, cmb)			{					var valor;				var encabezados = getXmlAtt(cuboXml,"k_ColName");				var len_cubo = 1000;				var pos_ini = frn.N(cmb)+1;				frn.setX("", cmb, 0,0);				for (var cont=0; cont<len_cubo ; cont++)				{										valor = strSplit(encabezados,",",cont);										if(valor &! ""){						frn.setX(valor, cmb, cont+pos_ini,0);					}					else{						cont = len_cubo;					}				}			}									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>