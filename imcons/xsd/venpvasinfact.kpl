<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="P&#243;lizas"><grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,20" bclr="192,205,213" unfont="0"	OnF1="Dialog(1,conpolizaayu)" tit="Polizas contables" clrBrdr="0,97,181"><br/>	<tab/><txt fnt=",22" clr="0,0,0">PVA sin Factura</txt>	<br/><tab/>	<hLine clr="0,0,0"/>	<br/><br/><tab/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="40,24,7,12" tit="Datos Generales" fnt="Arial,16" unfont="0">				<sp/><txt>Sucursal:</txt><sp/><cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="40,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/><br/>		<sp/><txt>Inventario: </txt>		<inp id="k_inventario" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="10" 			OnF9="SelInventario()" OnChange="ValidarInv()"/>		<br/><br/>		<sp/><txt>Gastos Administrativos:</txt><tab/>		<inp id="k_gastosadmin" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nc="12" just="R" nd="2" available="Y" modify="Y" visible="Y"/>		<br/><sp/>		<txt> Seguro:</txt><tab n="6"/>		<inp id="k_seguro" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nc="12" just="R" nd="2"/>				<br/><sp/>		<txt> Garant&#237;a Extendida:</txt><tab n="2"/>		<inp id="k_garantia" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nc="12" just="R" nd="2" available="Y" modify="Y"/>		<br/><sp/>		<txt> Subsidio:</txt><tab n="5"/>		<inp id="k_subsidio" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nc="12" just="R" nd="2"/>		<br/><sp/>		<txt> Extras 1 (OnStar):</txt><tab n="3"/>		<inp id="k_extra1" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nc="12" just="R" nd="2"/>				<br/><sp/>		<txt> Extras 2:</txt><tab n="5"/>		<inp id="k_extra2" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nc="12" just="R" nd="2"/>				<br/><sp/>		<txt> Extras 3:</txt><tab n="5"/>				<inp id="k_extra3" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nc="12" just="R" nd="2"/>				<br/><tab n="16"/>				<img id="Aceptar" dim="30,30" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" available="Y" clrBrdr="0,0,0" tooltip="Guardar cambios" visible="N"/>			</grp>	<sp/></grp>	<tools/>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,frP,sys;			var cmdQuery, cuboQuery, ok, mensajeError, asterisco ;         var gen_doc, nat_doc, gpo_doc, tip_doc, sucursal_id, inventario;			var usuario, rol_usuario, suc_usuario, anio_contable, fileSavePath; 			var editable; //Se controla si la poliza se puede editar, cancelar o dar de baja						fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				fileSavePath = "C:\Basura";//				if(frn.param(0)&= "")//				{//					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");//					frn.open("redirect",2);//					return;//				}					leeParam();				inicializa();				ConfiguraControlesOpcion();			}				fun SelInventario(){				sucursal_id=frn.get("k_sucn",-1,1);				cmdQuery = "select c2 as inventario, c3 as modelo from keplersc.kdinf where c1='" & sucursal_id & "' and c32=50"; //Sucursal, EdoVenta, Inventario				frn.dialog("genlistafiltrosel","Inventario",cmdQuery,"inventario","k_inventario",0,0,"S","S");							}						fun ValidarInv(){				var total=0, ga, ge;				sucursal_id=frn.get("k_sucn",-1,1);				inventario=frn.get("k_inventario");				cmdQuery="select count(*) as total from keplersc.kdinf where c1='" & 				sucursal_id & "' and c32=50 and c2='" & inventario & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venpvasinfact.ValidarInv()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				total=getXmlAtt(cuboQuery,"r0","total");				if (total==0){					frn.message("Inventario invalido","Mensaje","Aceptar");					frn.setAtt("Aceptar", "visible", "N");					return;				}								cmdQuery="select c17,c20,c19,c15,c43,c44,c45 from keplersc.kdpedido where c1='" & 					sucursal_id & "' and c2='" & inventario & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venpvasinfact.ValidarInv()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlCuboQuey");				frn.set("k_gastosadmin", getXmlAtt(cuboQuery,"r0","c17"));				frn.set("k_seguro", getXmlAtt(cuboQuery,"r0","c20"));				frn.set("k_garantia", getXmlAtt(cuboQuery,"r0","c19"));				frn.set("k_subsidio", getXmlAtt(cuboQuery,"r0","c15"));				frn.set("k_extra1", getXmlAtt(cuboQuery,"r0","c43"));				frn.set("k_extra2", getXmlAtt(cuboQuery,"r0","c44"));				frn.set("k_extra3", getXmlAtt(cuboQuery,"r0","c45"));								//Validar gastos previos				cmdQuery="select count(*) as total from keplersc.kdipva where c1='" & sucursal_id & "' and c2='" & inventario & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venpvasinfact.ValidarInv()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.setAtt("k_gastosadmin", "available", "Y");				frn.setAtt("k_gastosadmin", "modify", "Y");								frn.setAtt("k_garantia", "available", "Y");				frn.setAtt("k_garantia", "modify", "Y");												total= getXmlAtt(cuboQuery,"r0","total");				if(total==0){					cmdQuery="select coalesce(sga,0)+coalesce(rga,0) as ga, coalesce(sge,0)+coalesce(rge,0) as ge 						from (select case when c5='D' then sum(c24) end as sga, case when c5='D' then sum(c26) end as sge, 						case when c5<>'D' then sum(c24) end as rga, case when c5<>'D' then sum(c26) end as rge 						from keplersc.kdipva where c1='" & sucursal_id & "' and c2='" & inventario & "'group by c5) as resultado";									rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"venpvasinfact.ValidarInv()");//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlPVA");								ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					ga = getXmlAtt(cuboQuery,"r0","ga");					ge = getXmlAtt(cuboQuery,"r0","ga");					if(ga>0){						frn.setAtt("k_gastosadmin", "available", "N");						frn.setAtt("k_gastosadmin", "modify", "N");					}					if(ge>0){						frn.setAtt("k_garantia", "available", "N");						frn.setAtt("k_garantia", "modify", "N");					}				}				frn.setAtt("Aceptar", "visible", "Y");			}						fun leeParam(){			}						fun inicializa(){//Da valor a los combos y prepara la página dependiendo del tipo de Operación a realizar				kdb.date("SrvDate");	//Fecha del servidor				kdb.kde("KDE");//Configuración del servidor				kdb.exec();										//Llenar combo sucursales				var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));									}								fun BorraDatos(){ //Limpia todos los campos para generar un nuevo documento.				var dia,mes,anio;				frn.set("k_inventario","","k_descr","","k_refer","","statusCta","");			}			fun ConfiguraControlesOff() {				frn.setAtt("k_sucn","available","N");				frn.setAtt("k_sucn","modify","N");				frn.setAtt("Aceptar", "visible", "N");			}						fun ConfiguraControlesOpcion() {							ConfiguraControlesOff();				frn.setAtt("k_sucn","available","Y");				frn.setAtt("k_sucn","modify","Y");				frn.setAtt("Aceptar", "visible", "N");								frn.setAtt("k_gastosadmin", "available", "Y");				frn.setAtt("k_gastosadmin", "modify", "Y");				frn.setAtt("k_garantia", "available", "Y");				frn.setAtt("k_garantia", "modify", "Y");											}						fun Ejecuta(){				var xmlPantalla,fecha,hora,strFecha,strTmp,resultado,mensaje;				if (frn.message("¿Actualizar rregistro?", "Actualización de PVA","&Si","&No")!=1)					return;									//Actualizar registro				xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				fecha = sys.date();				hora= sys.time();				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);					//				frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\xmlPantallaPVA");				cmdQuery="SELECT * FROM keplersc.ven_pvasinfact_mod('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";																	kdb.rst(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"Alta.Alta");								ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									resultado= getXml(cuboQuery,"resultado");				mensaje= getXml(cuboQuery,"mensaje");					var adicionales = getXml(cuboQuery,"adicionales");				if(resultado &= "1"){					mensaje = "Registro actualizado. " & mensaje;					frn.message(mensaje & "-" & adicionales, "Mensaje","&Aceptar");				}else{					frn.message(mensaje, "Error","&Aceptar");				}			}					}	}				/*		Autor					Fecha			Cambio		------------------------------------------------------------------		VSALGADO			17-08-2022	Creación del programa		*/	</script></pag>