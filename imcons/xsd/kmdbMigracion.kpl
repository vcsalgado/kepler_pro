<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Migraci&#243;n de tablas a multibase de datos">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0"><br/>		<br/>		<grp dim="43,14,7,12" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="0" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos de conexi&#243;n"><tab/>			<grp dim="47,9,7,12" hSpace="4"><txt>Datasource:</txt><tab n="2"/>				<cmb id="k_datasource" dim="30,1"  brdr="2,0" bclr="255,255,255" type="capital" clrBrdr="255,255,255" clr="64,64,64"/><br/><txt>IP servidor K9:</txt><tab/>				<inp id="k_ip" dim="30,1"  brdr="2,0" bclr="255,255,255" type="string" clrBrdr="255,255,255" clr="64,64,64"/><br/><txt>Puerto K9-K75:</txt><tab/>				<inp id="k_port" dim="6,1" brdr="2,0" bclr="255,255,255" type="number" clrBrdr="255,255,255" clr="64,64,64" fmt="2" nc="8"/><br/>			</grp>			<grp dim="10,5,7,12"><br/>				<img id="k_conecta" dim="60,60" brdr="0,1" bPx="1" available="Y" tooltip="Prueba conexi&#243;n" img="_60_Export.png" OnEnter="Conecta()"/><br/><br/><br/>			</grp>		</grp><tab/>				<grp dim="40,15,7,12" tit="Opciones" bclr="236,240,243" clrBrdr="0,58,112" brdr="0,5" fntClrBrdr="255,205,0" fntBrdr="Arial,18" hSpace="4"><tab/><txt>Guarda log</txt><tab n="5"/>			<chck id="k_log" dim="3,16" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" YN="10" tooltip="Guarda el log de las inserciones, este proceso hace mas lenta la tarea de guardado"/><tab n="2"/><txt>Agregar informaci&#243;n</txt><br/><tab/><txt>Migra folios de operaci&#243;n</txt><tab/>			<chck id="k_folios" dim="3,16" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" YN="10"/><tab n="2"/><txt>de tablas a KEPLER 9</txt><br/><tab/><txt>Registros por paginado</txt><tab n="5"/>			<chck id="k_sysData" dim="3,16" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" YN="10"/><br/><tab/>			<inp id="k_pagVale" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" visible="1" modify="Y" nc="6" nd="0" min="1000" max="100000"/><br/><tab/><txt>Eliminar registros previos</txt><tab/>			<chck id="k_drop" dim="3,16" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" YN="10"/><br/><tab/><txt>Migrar una tabla especif&#237;ca.</txt><br/><tab/>			<inp id="k_unicTabla" dim="23,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" OnChange="UnaTabla"/>		</grp><sp/>		<grp dim="20,5,7,12" tit="Proceso actual" bclr="236,240,243" clrBrdr="0,58,112" brdr="0,5" fntClrBrdr="255,205,0" fntBrdr="Arial,18" hSpace="4"><tab/><txt>Tabla:</txt><br/><tab/>			<inp id="k_tabla" dim="23,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" just="C"/><br/><tab/><txt>Registros:</txt>			<inp id="k_regTotal" dim="15,1" bclr="236,243,240" clr="0,58,112" clrBrdr="255,255,255" type="string" just="C" modify="N" available="N"/><br/><tab/>			<inp id="k_min" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"/><txt>--</txt>			<inp id="k_max" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N"/><br/></grp>		<grp dim="15,5,7,12"><br/><tab/><txt>Hora de inicio</txt><tab/><br/><tab/>			<inp id="k_iniTime" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" fnt=",18" nc="-1" modify="N" available="N"/><br/><br/><tab/>			<txt>Hora de fin</txt><br/><tab/>			<inp id="k_finTime" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" fnt=",18" nc="-1" modify="N" available="N"/><br/><br/><tab/><txt>Tiempo total</txt><br/><tab/>			<inp id="k_totalTime" dim="18,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" fnt=",18" nc="-1" modify="N" available="N"/>		</grp><br/><br/>		<grp dim="105,43,7,12" tit="Tablas" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16"><tab/>			<tbl id="k_tablas" dim="143,25" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243">				<col id="c1" name="Tabla" modify="N"/>				<col id="c2" name="Descripci&#243;n" modify="N"/>				<col id="c3" name="Seleccionar" modify="N" OnMouseD="SeleccionaTabla"/>				<col id="c6" name="Registros" modify="N"/>				<col id="c8" name="Reg. migrados" modify="N"/>			</tbl><br/><tab/>			<chck id="k_all" dim="3,16" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" YN="SN" tooltip="Migrar todos" OnChange="CambiaSeleccion"/><txt> Seleccionar todas las tablas.</txt><tab n="24"/><txt>Registros mostrados por p&#225;gina</txt>			<inp id="k_pag" dim="5,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" OnChange="Refresh()"/><tab n="2"/>			<inp id="k_current" dim="3,1" bclr="236,240,243" clrBrdr="255,255,255" type="number" just="R" nd="0" min="1" available="N" modify="N"/><txt>/</txt>			<inp id="k_totales" dim="3,1" bclr="236,240,243" clrBrdr="255,255,255" type="number" just="L" nd="0" min="1" available="N" modify="N"/><br/><tab n="41"/>			<img id="k_atras" dim="60,60" brdr="0,1" bPx="1" available="Y" tooltip="Atras" img="_Sets\Buttons_60\60_Button_a-32.png" OnEnter="Pag(-1)" visible="N"/><tab/>			<img id="k_adelante" dim="60,60" brdr="0,1" bPx="1" available="Y" tooltip="Adelante" img="_Sets\Buttons_60\60_Button_a-33.png" OnEnter="Pag(1)" visible="Y"/>		</grp><tab/>		<grp dim="11,5,7,12"><br/><br/><sp n="3"/>			<img id="k_Errore" dim="60,60" bPx="1" brdr="0,1" available="Y" img="_Sets\Buttons_60\60_Button_a-16.png" tooltip="Visualiza errores previos" OnEnter="Dialog(0,kmdbMigraError)"/><br/><txt>Visualiza errores</txt><br/><tab/><sp n="2"/><txt>previos</txt><br/><br/><br/><tab/>		<img id="k_migraDef" dim="60,60" bPx="1" brdr="0,1" available="Y" img="_60_Export.png" OnEnter="MigraSysData(cubo,1)"/><br/><txt>Migra informaci&#243;n</txt><br/><txt>de DEF a tablas </txt><br/><tab n="2"/><txt>SYS</txt><br/><br/><br/><tab/>			<img id="k_MigraFol" dim="60,60" bPx="1" brdr="0,1" available="Y" img="_Sets\Buttons_60\60_Button_a-04.png" tooltip="Migra folios unicamente" OnEnter="EjecutaMigraFolio()"/><br/><txt>Migra informaci&#243;n </txt><br/><tab/><txt>de Folios</txt><br/><br/><br/><br/><sp n="2"/>			<img id="k_ejecuta" dim="60,60" brdr="0,1" bPx="1" available="Y" default="0" tooltip="Ejecutar" img="_60_Gears.png" OnEnter="Execute()"/><br/><txt>Iniciar migraci&#243;n</txt>		</grp><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb;			var kdbF,sys,maxReg; //kdbF= instancia de conexión a servidor remoto, maxReg=Numero de registros maximos a desplegar.			var xmlTablas,xmlProcesa;//xmlTablas = xml donde se almacena la infomración de todas las tablas del datasource, usada para mostrar en la pantalla. 											//xmlProcesa = xml que contiene las tablas a migrar incluyendo su estatus, registros y errores.			var kdbSys;//Instancia de conexión para KDB en el datasource de KEPLER 9 SYS, usado para la inserción de los datos sysTable, sysIndex y sysColumn			var xmlTablasParticion;			var rowIni,rowFin;			var sqlFlag;//Baandera para deteminar si se trata de un sistema que usa SQL			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdbF=new KDB;				kdbSys=new KDB;				sys=new SYS;				kdb.connect();				//Datos de conexión base				frn.set("k_port","1803");				//frn.set("k_datasource","k75repositorio");				frn.set("k_ip","127.0.0.1");				maxReg = 30;//Numero de registros desplegados default				ConectaSys();				frn.set("k_pag",maxReg);				frn.set("k_all",1);				frn.set("k_log",1);				frn.set("k_folios",1);				frn.set("k_iniTime",sys.time);				frn.set("k_current",1);				frn.set("k_drop",1);				frn.set("k_sysData",1);				ConsultaDataSource();				frn.setAtt("k_atras","visible","N");				frn.setAtt("k_adelante","visible","Y");				frn.set("k_pagVale",1000);//Default de paginado			}							fun ConsultaDataSource(){				//Validar que se ejecute de forma 'local' en el servidor 				var ip = frn.config("server","pages");				var partesIP = strSplit(ip,":",-1);//Valida si se tiene un puerto diferente				if(partesIP != 1){//Si tenemos ip:puerto, obtener solo el puerto					ip = strSplit(ip,":",0);				}				//ip = "127.0.0.1";//Use in debbug local				if(ip &! "127.0.0.1"){					if( ip &! "LOCALHOST"){						frn.message("Esta rutina, se debe ejecutar de forma local en el servidor, no es recomendable ejecutarla de forma remota.","Advertencia","&Ok");						return;					}				}				kdb.kde("datKDE");//Consultar configuración de servidor.				kdb.exec();				var out1 = getXml(kdb.get("datKDE")); //VCSS				FileSave(out1,"D:\Basura\datKDE"); //VCSS				var carpeta = kdb.get("datKDE","3");//Seleccionar la carpeta de datos				var car = "\\";				car = mid(car,0,1);				//Armar Xml de talbas particionadas.				rstXml(xmlTablasParticion);				setXmlAtt(xmlTablasParticion,"KDC1","P",1);				setXmlAtt(xmlTablasParticion,"KDC2","P",1);				setXmlAtt(xmlTablasParticion,"KDCN","P",1);				setXmlAtt(xmlTablasParticion,"KDRHCALC","P",1);				setXmlAtt(xmlTablasParticion,"KDRHDETC","P",1);				//Disponible para trabajar mas tablas.				if(strSplit(carpeta,car,1) &= "MSSQL"){//Se siguen caminos separados para cada tipo de carpeta					ConsultatablasSQL();//Si se usa MS server					sqlFlag=1;				}else{					ConsultaTablas();//Base de datos nativa					sqlFlag=0;				}			}						fun ConsultatablasSQL(){				kdb.query("datQuery","SELECT CAST(table_name as varchar)  FROM INFORMATION_SCHEMA.TABLES");//Listar tablas del esquema				//kdb.query("datQuery","SELECT CAST(table_name as varchar) FROM INFORMATION_SCHEMA.TABLES WHERE table_name = 'sqliov'");//Listar tablas del esquema para debbug				kdb.exec();				CreaXmlTablas("datQuery",0);//Envia valor del query para desplegarlo			}									fun ConsultaTablas(){					var manualPath;				var server_path = sys.path();//Dirección del server para localizar la carpeta de datos a usar				//manualPath = frn.openFile("","Archivos DAT,*.DAT",server_path,"Ubica la carpeta de datos");//Ruta de carpeta					manualPath = kdb.get("datKDE","3");				if(manualPath &= ""){return;}//En caso de no encontrar ruta sale				var nTokenServer = strSplit(manualPath,"\\",-1);//Encontrar valor de la ruta				var k75path;				for(var i=0;i<(nTokenServer-1);i++){//deteminar ruta					var token = strSplit(manualPath,"\\",i);					k75path = (k75path &= "")?token:(k75path & "\\" & token);				}				frn.set("k75path",k75path);//Variable que se guarda para usar en migración de folios.				kdb.file("dat,list,"&k75path&"\\*.DAT");//Listar las tablas encontradas en la carpeta de datos				kdb.exec();				var out1 = getXml(kdb.get("dat")); //VCSS				FileSave(out1,"D:\Basura\dat"); //VCSS				CreaXmlTablas("dat",1);//Envia valor del query para desplegarlo			}						fun CreaXmlTablas(cubo,source){//Cubo a usar,Origen(1(KDB),0(SQL))				kdb.open("b," & insScpScn("\\tablas"));//Se le la tabla local con la información de las tablas.				var nReg = kdb.N(cubo);				for(var i=0;i<nReg;i++){//Recorrer los cubos para organizarlas y obtener información.					var tabla;					if(source){						tabla = strSplit(kdb.get(cubo,"r"&i),".",0);//Si viene de un KDB, se debe obtener el nombre de la tabla					}else{						tabla = kdb.get(cubo,"r"&i,"c0");//Si es SQL se obtiene directamente en el cubo					}					var tab = mid(tabla,0,4);//Subtabla					if(getXmlAtt(xmlTablasParticion,tab,"P")){//Se separan las tablas anualizadas para obtener su def.						var len = strlen(tabla);//Validar que la tabla KDCxxxxx tenga la estructura esperada, para evitar consultar tablas basura						var sufijo = mid(tabla,4,(len-4));						var nChar = (tab &= "KDC1" || tab &= "KDCN")?2:4;						if(strlen(sufijo) == nChar){//Se valida que solo se habran tablas con el numero correcto de valores en el nombre para KDC[1][2]							var valSufi = frn.lib("FE33Lib","ValidateString",sufijo,"[0-9]");//Se valida que solo se usen numeros							if(getXml(valSufi,"ok")){								setXmlAtt(xmlTablas,tab,"subtabla",tabla,"migrado","N");								if(sqlFlag){kdb.sp("k_nreg","datNreg"&tabla,tabla);}								else{kdb.sp("k_nreg","datNreg"&tabla,tabla,"cuentaReal:N");}//En caso de ser KDB, usaremos la cuenta del encabezado de las tablas.							}						}					}else if(getXmlAtt(xmlTablasParticion,mid(tabla,0,8),"P")){//Tablas de nomina || Tablas de 8 caracteres						tab = mid(tabla,0,8);						setXmlAtt(xmlTablas,tab,"subtabla",tabla,"migrado","N");						if(sqlFlag){kdb.sp("k_nreg","datNreg"&tabla,tabla);}						else{kdb.sp("k_nreg","datNreg"&tabla,tabla,"cuentaReal:N");}//En caso de ser KDB, usaremos la cuenta del encabezado de las tablas.					}					else{						setXmlAtt(xmlTablas,tabla,"migrado","N");					}				}				nReg = nXml(xmlTablas);				for(var i=0;i<nReg;i++){					var tabla = getXmlX(xmlTablas,5,i);					kdb.def("datDef"&tabla,tabla,"descr:Y");					if(sqlFlag){kdb.sp("k_nreg","datNreg"&tabla,tabla);}					else{kdb.sp("k_nreg","datNreg"&tabla,tabla,"cuentaReal:N");}//En caso de ser KDB, usaremos la cuenta del encabezado de las tablas.				}				kdb.table("datInddes,b,1,&,b1...b12");//Consultar los indices de las tablas				kdb.exec();				var xmlTablaDes = frn.lib("FE33WS_Cancela","SetKDtoXml",kdb.get("datInddes"),"b1");//Se reordena en un XML para su uso mas eficiente.				var xmlDef;				for(var i=0;i<nReg;i++){					var tabla = getXmlX(xmlTablas,5,i);//Tabla a procesar					var registro = kdb.get("datNreg"&tabla);//Numero de registros de la tabla					var nReg2 = nXml(xmlTablas,tabla,"subtabla");//Validar si se trata de tablas anualizadas					if(registro > 0  || nReg2 >0){//KDC1 o KDC2, no tendrán datos directamente, por lo que se debe buscar en su subtabla						if(nReg2 >0){							for(var j=0;j<nReg2;j++){//por las diferentes tablas anualizadas revisar los registros 								var subTab = getXmlX(xmlTablas,tabla,"subtabla",5,j);//Subtabla (kdc112, o kdc21201)								var val = kdb.get("datNreg"&subTab);//Registros de subtabla								if(val > 0){//Si se tienen registros se incluye este valor									setXmlAtt(xmlTablas,tabla,"subtabla",subTab,"nRegistros",val);								}//if valores							}//for subtablas						}//Se trata de subtablas						var indice;						rstXml(xmlDef);						setXml(xmlDef,kdb.get("datDef"&tabla));//Obtener el DEF de una tabla y se asigna en XML						//VCSS						if(tabla == "KDINM")						{							//FileSave(xmlDef,"D:\Basura\tableDef");						}						var nCampos = nXmlAtt(xmlDef,"ind","r0");//Se usara solo el primer indice						if(nCampos == 0){							setXmlAtt(xmlTablas,tabla,"NoMigrableDef","1");//						}						for(var j=0;j<nCampos;j++){//Armar el inidice 1 de la tabla							indice = (strlen(indice)==0)?getXmlAtt(xmlDef,"ind","r0","c"&j):(indice & "," & getXmlAtt(xmlDef,"ind","r0","c"&j));						}						nCampos = nXml(xmlDef,"cmp");						for(var j=0;j<nCampos;j++){							var campo = getXmlX(xmlDef,"cmp",5,j);//campo							var tip = getXmlAtt(xmlDef,"cmp",campo,"ti");//Tipo de campo							var val = j+1;							setXml(xmlTablas,tabla,"campos",val,tip);							setXmlAtt(xmlTablas,tabla,"campos",val,"name",getXmlAtt(xmlDef,"cmp",campo,"mn"));//Agregar nombre del campo							setXmlAtt(xmlTablas,tabla,"campos",val,"ncar",getXmlAtt(xmlDef,"cmp",campo,"nc"));//Agregar numero de caracteres							setXmlAtt(xmlTablas,tabla,"campos",val,"nDecim",getXmlAtt(xmlDef,"cmp",campo,"nd"));//Agregar nombre del campo							setXmlAtt(xmlTablas,tabla,"campos",val,"tipo",tip);//Agregar tipo						}						setXmlAtt(xmlTablas,tabla,"indice",indice);//Indice 1 de la tabla (por lo regular el que asegura que un registro es unico)						setXmlAtt(xmlTablas,tabla,"desc",getXmlAtt(xmlTablaDes,tabla,"b2"));//Descripción de la tabla, para ser usado en la tabla						setXmlAtt(xmlTablas,tabla,"nCampos",nXml(xmlDef,"cmp"));//Numero de campos de la tabla						setXmlAtt(xmlTablas,tabla,"nRegistros",registro);//Numero de registros de la tabla						nCampos = nXml(xmlDef,"ind");						var r,val,ncols,col;						for(var j=0;j<nCampos;j++){							r = "r"&j;							ncols = nXmlAtt(xmlDef,"ind",r);							for(var k=0;k<ncols;k++){								col = "c"&k;								val = getXmlAtt(xmlDef,"ind",r,col);								setXmlAtt(xmlTablas,tabla,"ind",r,col,"c" & val);							}						}					}else{//En caso de no tener información se ignora						continue;					}//if registros				}//Recorres registros				rowIni = 0;				var totales = math("ceil",(nXml(xmlTablas)/maxReg));				frn.set("k_totales",totales);				LlenaTabla();				}						fun LlenaTabla(){				frn.rst("k_tablas");//Resetear la tabla				var cnt = 0;				var xmlNoMigra;rstXml(xmlNoMigra);				var flagerrorDef=0;				var nRegTablas = nXml(xmlTablas);				var i;				//for(i=rowIni;cnt<maxReg&&i<nRegTablas;i++){				for(i=rowIni;i<(rowIni+maxReg)&&i<nRegTablas;i++){					var tabla = getXmlX(xmlTablas,5,i);//Tabla a validar					if(tabla &= ""){continue;}//En caso de ser una tabla vacia, evitarla					if(getXmlAtt(xmlTablas,tabla,"nCampos") &= ""){continue;}//Si no se tienen registros					frn.setX(tabla,"k_tablas",cnt,"c1");					frn.setX(getXmlAtt(xmlTablas,tabla,"desc"),"k_tablas",cnt,"c2");					//frn.setX("N","k_tablas",cnt,"c3");					frn.setX("S","k_tablas",cnt,"c3");					frn.setX(getXmlAtt(xmlTablas,tabla,"indice"),"k_tablas",cnt,"c4");					frn.setX(getXmlAtt(xmlTablas,tabla,"migrado"),"k_tablas",cnt,"c5");					frn.setX(getXmlAtt(xmlTablas,tabla,"nRegistros"),"k_tablas",cnt,"c6");					if(getXmlAtt(xmlTablas,tabla,"NoMigrableDef")==1){						setXmlAtt(xmlNoMigra,"r"&(nXml(xmlNoMigra)),"tabla",tabla,"desc","No se encontro el DEF de esta tabla, Se ignorará en la migración");						flagerrorDef=1;						//Grabar en log de errores											}					cnt++;				}				if(flagerrorDef){					frn.set("errorMigra",xmlNoMigra);					frn.dialog("kmdbMigraError","errorMigra");				}			}						fun Pag(val){				if(val==1){//Si es para adelante se reasiga la variable rowIni					rowIni += maxReg;					frn.setAtt("k_atras","visible","Y");//Siempre que se va hacia adelante se tiene que tener el boton atras visible					frn.setAtt("k_adelante","visible","Y");					if((rowIni + maxReg) > nXml(xmlTablas)){//Si se llega al final se oculta el boton adelante						frn.setAtt("k_adelante","visible","N");					}					frn.set("k_current",(frn.get("k_current")+1));				}else{					rowIni -= maxReg;					if(rowIni == 0){//Si llega al inicio, se oculta el boton atras						frn.setAtt("k_atras","visible","N");					}					frn.setAtt("k_adelante","visible","Y");//Siempre que vas hacia atras asegurarce que se tiene el boton adelante visible					frn.set("k_current",(frn.get("k_current")-1));				}				LlenaTabla();			}												fun Conecta(){				var ip,port,datasource;				kdbF.connect();//Se establece una conexión con el servidor destino.				if(!kdbF.exec()){					frn.message("Contraseña erronea","Error","&Aceptar");					return;				}				port = frn.get("k_port");//Obtener el puerto de pantalla				port = (port != 0)?port:1803;				ip = frn.get("k_ip");				datasource = strFormat("ucase",frn.get("k_datasource",-1,1));//datasource de Kepler 9 para migrar.				if(datasource &= ""){					frn.message("No se especifico el datasource definido en KPLER 9 para realizar la migración","Error","&Aceptar");					return;				}				kdbF.setKde(3,"\\KS9\\"&ip&"," & port & "\\" & datasource & "\\");				kdbF.open("i,kdid");				kdbF.stmt("SELECT c1 FROM KDID","datConnect");//Validar que conexión opere correctamente.				kdbF.exec();				if(kdbF.get("datConnect","ok") &= ""){					frn.message("Errror en la configuración de servidor KEPLER 9| Validar contraseña y nombre del 'Datasource'.","Error","&Aceptar");					return;				}			}						fun SeleccionaTablas(){//Recorre los valores de la tabla para procesar la migración				var reg = frn.N("k_tablas");				var varRet;rstXml(varRet);				for(var i=0;i<reg;i++){					if(frn.get("k_tablas",i,"c3")&="S"){//Busca las tablas seleccionas para ser procesadas						var tabla = frn.get("k_tablas",i,"c1");//Tabla						if(getXmlAtt(xmlTablas,tabla,"NoMigrableDef")==1){							continue;						}						setXmlAtt(varRet,tabla,"procesar","1");						setXmlAtt(varRet,tabla,"indice",getXmlAtt(xmlTablas,tabla,"indice"));						setXmlAtt(varRet,tabla,"desc",getXmlAtt(xmlTablas,tabla,"desc"));						setXmlAtt(varRet,tabla,"nCampos",getXmlAtt(xmlTablas,tabla,"nCampos"));						setXmlAtt(varRet,tabla,"nRegistros",getXmlAtt(xmlTablas,tabla,"nRegistros"));						setXmlAtt(varRet,tabla,"renglonTabla",i);//Guardar el numero de renglon que corresponde para poder enviar los registros migrados.						var campos = nXml(xmlTablas,tabla,"campos");						for(var j=0;j<campos;j++){							var campo = getXmlX(xmlTablas,tabla,"campos",5,j);							setXml(varRet,tabla,"campos",campo,getXml(xmlTablas,tabla,"campos",campo));						}						var nHijos = nXml(xmlTablas,tabla,"subtabla");//En caso de ser tablas anualizadas se procesan los hijos						if(nHijos > 0){							for(var j=0;j<nHijos;j++){								var tablaHijo = getXmlX(xmlTablas,tabla,"subtabla",5,j);								var registros = getXmlAtt(xmlTablas,tabla,"subtabla",tablaHijo,"nRegistros");								if(registros > 0){//Solo si es tabla hijo y tiene registros se insertará en la migración									setXmlAtt(varRet,tablaHijo,"procesar","1");									setXmlAtt(varRet,tablaHijo,"indice",getXmlAtt(xmlTablas,tabla,"indice"));									setXmlAtt(varRet,tablaHijo,"desc",getXmlAtt(xmlTablas,tabla,"desc"));									setXmlAtt(varRet,tablaHijo,"nCampos",getXmlAtt(xmlTablas,tabla,"nCampos"));									setXmlAtt(varRet,tablaHijo,"nRegistros",registros);									for(var k=0;k<campos;k++){										var campo = getXmlX(xmlTablas,tabla,"campos",5,k);										setXml(varRet,tablaHijo,"campos",campo,getXml(xmlTablas,tabla,"campos",campo));									}									setXmlAtt(varRet,tablaHijo,"subTabla",1);								}											}						}					}				}				return varRet;//Regresa el valor del 			}						fun Execute() {				var log = frn.get("k_log");//Bandera de log				var textXml;rstXml(textXml);				frn.set("k_iniTime","");//Limpiamos los valores de tiempo				frn.set("k_finTime","");				frn.set("k_totalTime","");				frn.set("k_iniTime",sys.time());//Marcar la hora de inicio				frn.set("k_fechaIni",sys.date());				xmlProcesa = SeleccionaTablas();//Se revisa la tabla para detectar a las tablas a procesar.				if(frn.get("k_sysData")){					MigraSysData(xmlProcesa);				}				if(!kdbF.exec()){//En caso no tener la conexión al servidor remoto, se intenta reconectar					Conecta();					if(!kdbF.exec()){						frn.message("No se ha logrado la conexión al servidor destino","Error","&Aceptar");						return;					}				}								//xmlProcesa = SeleccionaTablas();//Se revisa la tabla para detectar a las tablas a procesar.				var nRegXmlTablas = nXml(xmlProcesa);				var fileName;				if(log){					fileName = GetFileName();				}				var tabla;				for(var i=0;i<nRegXmlTablas;i++){//Se recorren las tablas seleccionadas para determinar el tipo de migración que se usará					tabla = getXmlX(xmlProcesa,5,i);					//En caso de ser KDC1 o 2 no procesar directamente					if(getXmlAtt(xmlTablasParticion,tabla,"P")){continue;}//Estas tablas directamente no tinen datos.(o no deberian)					var nCampos = getXmlAtt(xmlProcesa,tabla,"nCampos");					var indice = getXmlAtt(xmlProcesa,tabla,"indice");					var regs =  getXmlAtt(xmlProcesa,tabla,"nRegistros");					//Llevar el control de la tabla a procesar					if(log){						setXmlAtt(textXml,tabla,"Estatus","Iniciado");						setXmlAtt(textXml,tabla,"RegistrosOrigen",regs);						setXmlAtt(textXml,tabla,"TiempoInicio",sys.time());						setXmlAtt(textXml,tabla,"FechaInicio",sys.date());						FileSave(textXml,fileName);					}					frn.set("k_tabla",tabla);					MigraDef(tabla,nCampos,indice,regs);					if(getXmlAtt(xmlProcesa,tabla,"ok")){						if(sqlFlag){							MigracionSQL(tabla,nCampos,indice,regs);//Se usa SQL Server						}else{							MigracionKDB(tabla,nCampos,indice,regs);						}					}					var nRegForaneo = getXmlAtt(xmlProcesa,tabla,"regsForaneo");					frn.setX(nRegForaneo,"k_tablas",getXmlAtt(xmlProcesa,tabla,"renglonTabla"),"c8");					if(log){//Guarda el archivo de log para llevar el control de las tablas procesadas						setXmlAtt(textXml,tabla,"Estatus","Completado");						setXmlAtt(textXml,tabla,"RegistrosDestino",nRegForaneo);						setXmlAtt(textXml,tabla,"TiempoFin",sys.time());						setXmlAtt(textXml,tabla,"FechaFin",sys.date());						setXmlAtt(textXml,tabla,"TiempoNecesario",Tiempo(getXmlAtt(textXml,tabla,"TiempoInicio"),getXmlAtt(textXml,tabla,"FechaInicio")));						FileSave(textXml,fileName);					}				}//Fin FOR				if(frn.get("k_folios")){//Migrar folios de operación					MigraFolios();				}								var xmlErrors;rstXml(xmlErrors);				var cnt;				var nombre,valor,regErr,i,j,k,regLoop;				var loop,insertNumber,error;				for(i=0;i<nRegXmlTablas;i++){					tabla = getXmlX(xmlProcesa,5,i);					if(getXmlAtt(xmlTablasParticion,tabla,"P")){continue;}					cnt = 0;					var ok = getXmlAtt(xmlProcesa,tabla,"ok");//Valida si la tabla tiene errores de insersión					if(!ok){//En caso de error						var nAtts = nXmlAtt(xmlProcesa,tabla);//Numero de atributos						for(j=0;j<nAtts;j++){							/*nombre = getXmlX(xmlProcesa,tabla,8,j);							valor = getXmlAtt(xmlProcesa,tabla,nombre);*/							setXmlAtt(xmlErrors,tabla,"desc",getXmlAtt(xmlProcesa,tabla,"desc"));							setXmlAtt(xmlErrors,tabla,"nRegistros",getXmlAtt(xmlProcesa,tabla,"nRegistros"));							setXmlAtt(xmlErrors,tabla,"regsForaneo",getXmlAtt(xmlProcesa,tabla,"regsForaneo"));							setXmlAtt(xmlErrors,tabla,"regsForaneo",getXmlAtt(xmlProcesa,tabla,"regsForaneo"));							setXmlAtt(xmlErrors,tabla,"Error",getXmlAtt(xmlProcesa,tabla,"Error"));						}						regErr = nXml(xmlProcesa,tabla,"Error");						for(j=0;j<regErr;j++){							loop = getXmlX(xmlProcesa,tabla,"Error",5,j);							regLoop = nXml(xmlProcesa,tabla,"Error",loop);							for(k=0;k<regLoop;k++){								insertNumber = getXmlX(xmlProcesa,tabla,"Error",loop,5,k);								setXmlAtt(xmlErrors,tabla,"Errores",cnt,"Error",getXmlAtt(xmlProcesa,tabla,"Error",loop,insertNumber,"Error"));								setXmlAtt(xmlErrors,tabla,"Errores",cnt,"Insert",getXmlAtt(xmlProcesa,tabla,"Error",loop,insertNumber,"Insert"));								cnt++;							}						}					}				}				frn.set("k_finTime",sys.time());//Hora de fin				frn.set("k_totalTime",Tiempo(frn.get("k_iniTime"),frn.get("k_fechaIni")));//Hora de fin				var nReg = nXml(xmlErrors);//Si se procesaron errores se deben mostrar				if(nReg > 0){					if(frn.message("Se tuvieron algunos problemas al migrar datos.| ¿Desea verlos ahorar?","Error en migración","&Si","&No")==1){						frn.set("xmlError",xmlErrors);						frn.dialog("kmdbMigraError","xmlError");					}				}else{					frn.message("Proceso completado sin errores.","Exito","&OK");				}							}						fun SeleccionaTabla(){				var val = frn.get("k_tablas",-1,"c3");				val = (val &= "S")?"N":"S";				frn.setX(val,"k_tablas",-1,"c3");			}						fun CambiaSeleccion(){				var val = frn.get("k_all");				var nReg = frn.N("k_tablas")-1;				for(var i=0;i<nReg;i++){					frn.setX(val,"k_tablas",i,"c3");				}			}						fun GetFileName(){//Funcion para nombre de archivo de log, importante, si se usan multiples pantallas en una migración				var time,date,user,pag;				time =frn.get("k_iniTime");				time = strSplit(time,":",0) & "_" & strSplit(time,":",1) & "_" & strSplit(time,":",2);				date = frn.get("k_fechaIni");				date = strSplit(date,"/",0) & "_" & strSplit(date,"/",1) & "_" & strSplit(date,"/",2);				user = frn.get("k_usuario");				pag = frn.get("k_current");				var name = "migracion" & "_" & time & "_" & date & "_" & ((user &= "")?"USUARIO":user) & "_" & pag;				return name;			}						fun FileSave(xmlVar,FileName){//Lectura/escritura				kdb.save("_"&FileName&".txt",getXmlStr(xmlVar,"EOF:13_10"));			}						fun MigraDef(tabla){				kdbF.open("c,"&tabla);//Abre la tabla en el servidor remoto.				kdbF.rst("datSelectDef");				kdbF.stmt("SELECT c1 FROM " & tabla &" ORDER BY c1 LIMIT 1","datSelectDef");				if(frn.get("k_drop")){//En caso que el usuario lo indique, eliminar los registros previos.					kdbF.stmt("DELETE FROM "& tabla &" WHERE 1=1","datDel");				}				kdbF.exec();				if(kdbF.get("datSelectDef","ok")){					setXmlAtt(xmlProcesa,tabla,"ok",1);				}else{//Error en la creaciónn de la tabla					setXmlAtt(xmlProcesa,tabla,"ok",0);					setXmlAtt(xmlProcesa,tabla,"ErrorN",kdbF.get("datSelectDef","native3"));					setXmlAtt(xmlProcesa,tabla,"ErrorCode",kdbF.get("datSelectDef","native2"));					setXmlAtt(xmlProcesa,tabla,"ErrorCodeK",kdbF.get("datSelectDef","A001"));					WriteLog(kdbF.get("datSelectDef","native3")); //VCSS					FileSave("D:\Basura\datSelectDef","datSelectDef");				}			}									fun Tiempo(iniTime,iniDate){				var finTime = sys.time();				var finDate = sys.date();				var horaIni,minIni,secIni;				var horaFin,minFin,secFin;				horaIni = strSplit(iniTime ,":",0) * 3600;//Volver segundos				minIni = strSplit(iniTime ,":",1) * 60;//segundos por minuto				secIni = strSplit(iniTime ,":",2);				horaFin = strSplit(finTime,":",0) * 3600;//Volver segundos				minFin = strSplit(finTime,":",1) * 60;//segundos por minuto				secFin = strSplit(finTime,":",2);				iniTime = horaIni+minIni+secIni;//Segundos totales hora inicio				finTime = horaFin + minFin + secFin;//Segundos totales hora fin				var segXDia = 86399;//segundos por día				var difDia = fnDate("dif",finDate,iniDate);//				var total,dias,hora,minuto,segundo;				if(difDia == 0){//Mismo día resta diretca					total = finTime - iniTime;				}else{//Diferente día, calcular el numero de dias * segundos por dia - el tiempo del primer dia (dia de inicio) + el tiempo del dia final 					total = ((difDia * segXDia) - iniTime) + finTime;				}				dias = math("int",(total/segXDia));				total = math("abs",(total - (dias * segXDia)));				hora = math("int",(total/3600));				total = math("abs",(total - (hora * 3600)));				minuto = math("int",(total/60));				total = math("abs",(total - (minuto * 60)));				segundo = total;				return "DD "&dias &" HH: "& hora &" MM: "& minuto &" SS: "& segundo;			}									fun Refresh(){				maxReg = frn.get("k_pag");				var totales = math("ceil",(nXml(xmlTablas)/maxReg));				frn.set("k_totales",totales);				LlenaTabla();			}									fun MigracionSQL(tabla,nCampos,indice,regs){				frn.set("k_regTotal",regs);				var parentesisAbre = "1(1";//Parentesis por código				parentesisAbre = mid(parentesisAbre,1,1);				var parentesisCierra = "1)1";//Parentesis por código				parentesisCierra = mid(parentesisCierra,1,1);				var nCamposLlave = strSplit(indice,",",-1);				var xmlCampos;rstXml(xmlCampos);//Generar Xml de campos llave				var baseXml;//Cubo que contendrá al XMl de campo llave de las tablas.				var datBaseXml;rstXml(datBaseXml);				var cnt = 0;//Contador generico				var orderByXml;rstXml(orderByXml);				var cntOrder = 0;				kdb.query("datFormat","SET DATEFORMAT YMD"); //Para que los tipo de dato fecha, ya vengan en el formato que se requiere con KS9				setXml(datBaseXml,cnt,"SELECT");cnt++;//Select base				setXml(orderByXml,cntOrder,"ORDER BY");cntOrder++;//Order by base				for(var j=0;j<nCamposLlave;j++){//Generar los datos de el select y order de los campos llave					var campo = strSplit(indice,",",j);					var val = (j==0)?("c"&campo):(", c"&campo);					//setXml(datBaseXml,cnt,val);cnt++;					setXml(orderByXml,cntOrder,val);cntOrder++;					setXmlAtt(xmlCampos,campo,"Llave","1");//Se establece este campo como campo llave				}//For campos llave				for(var i=1;i<=nCampos;i++){//Se arma el resto del select ignorando los campos llave					var fLlave = getXmlAtt(xmlCampos,i,"Llave");//flag de campo llave					//if(fLlave){continue;}					var val = (i==1)?("c"&i):(", c"&i);					setXml(datBaseXml,cnt,val);cnt++;				}				var stmtSelect = catXml(datBaseXml," ");//SELECT Base				var stmtOrder = catXml(orderByXml," "); //ORDER base				rstXml(datBaseXml);				cnt = 0;				setXml(datBaseXml,cnt,stmtSelect);cnt++;//Rearmamos el query con select from y order				//Modo SQL viejo				setXml(datBaseXml,cnt,"FROM "&parentesisAbre);cnt++;				setXml(datBaseXml,cnt,stmtSelect);cnt++;				setXml(datBaseXml,cnt,",ROW_NUMBER() OVER ( ");cnt++;				setXml(datBaseXml,cnt,stmtOrder &" ASC ) AS rowD FROM ");cnt++;				setXml(datBaseXml,cnt,tabla&parentesisCierra);cnt++;				setXml(datBaseXml,cnt,"AS TABLETEMPO ");cnt++;				//Modo SQL viejo				//Data base				var datBase = catXml(datBaseXml," ");				var regXLoop = frn.get("k_pagVale");//Registros por vuelta.				var acualMin = 0;//Registro primero actual.				var acutualMax = acualMin + regXLoop;//Set de valores iniciales				//variable usadas en la paginación				var loop = 0;				//Variables que se ocupan dentro del ciclo, se ponen afuera para evitar crear y destruitlas en cada ciclo.				var cubo = "dat"&tabla&"-";//Cubo base para select				var cuboWrite = cubo;//Cubo base para write				var insertValuesXml,insertCamposXml;//Variables XMl que contendrán los campos y valores del armado del insert				var insertBase;				var cuboLoop,cuboWriteLoop;//cubos de memoria a usar				var stmt;				var nReg;				var i,j;//Contadores usados en los ciclos				var val,tipoDato;//Variable que almacena cada valor de cada tabla,variable que toma el tipo de dato que se esta consultando				var prefijo;				var insertXml;				var r;				var reg,campo;				var xmlCamposTabla = getXml(xmlProcesa,tabla,"campos");				var XmlResult,cuboProcess;								while(acualMin < regs){					cuboLoop = cubo&loop;//Nombre completo de cubo en select y write					cuboWriteLoop = cuboWrite&loop&"-";					frn.set("k_min",acualMin);//Se mandan los valores actuales que se estan procesando					frn.set("k_max",acutualMax);					rstXml(datBaseXml);					cnt = 0;					setXml(datBaseXml,cnt,datBase);cnt++;//Modificar por subconsulta					setXml(datBaseXml,cnt," WHERE rowD BETWEEN " & ((loop==0)?(acualMin):(acualMin+1)));cnt++;//					setXml(datBaseXml,cnt," AND " & (acualMin+regXLoop));cnt++;					setXml(datBaseXml,cnt," "& stmtOrder );cnt++;					stmt = catXml(datBaseXml);					kdb.query(cuboLoop,stmt); //Se ejecuta la consulta de los datos					kdb.exec();					nReg = kdb.N(cuboLoop);//Contar registros de vuelta					insertBase = "INSERT INTO "&tabla&parentesisAbre;					for(i=0;i<nReg;i++){						rstXml(insertValuesXml);						rstXml(insertCamposXml);						cnt = 0;						r="r"&i;						reg = kdb.get(cuboLoop,r);						for(j=0;j<nCampos;j++){							val = getXmlAtt(reg,"c"&j);							campo = j+1;//El select inicia en c0							tipoDato = getXml(xmlCamposTabla,(j+1));//dejar como variable fija?							if((getXmlAtt(xmlCampos,campo,"Llave"))||((strlen(val)>0) && (val &! "  /  /  ") && (val &! " ") && (tipoDato != 2 || val != 0))){								if(tipoDato == 3){									val = GetDateFormat(val);								}								prefijo=""; if(nXml(insertCamposXml)>0)prefijo=",";								setXml(insertCamposXml,cnt,prefijo& "c"&campo);								setXml(insertValuesXml,cnt,prefijo& "'"&val&"'");//valor del campo.								cnt++;							}						}						if(nXml(insertCamposXml)==0)continue; //No debe haber un registro totalmente en blanco.						cnt = 0;						insertCamposXml = catXml(insertCamposXml);//variable con todos los campos a insertar						insertValuesXml = catXml(insertValuesXml);//Variable con los valores a insertart						rstXml(insertXml);//variable para armar el insert						setXml(insertXml,cnt,insertBase);cnt++;//Insert into tabla 						setXml(insertXml,cnt,insertCamposXml);cnt++;// ("campos"						setXml(insertXml,cnt,parentesisCierra);cnt++;//	) carater de cierre						setXml(insertXml,cnt," VALUES ");cnt++;// Values						setXml(insertXml,cnt,parentesisAbre);cnt++; //(						setXml(insertXml,cnt,insertValuesXml);cnt++;// valores 						setXml(insertXml,cnt,parentesisCierra);cnt++;// ) carater de cierre						stmt = catXml(insertXml);// String de Insert						kdbF.stmt(stmt,cuboWriteLoop&i);					}					kdbF.exec();					for(i=0;i<nReg;i++){						reg = kdbF.get(cuboWriteLoop&i);						if((getXmlAtt(reg,"ok") != 1) || (getXmlAtt(reg,"err") &! "")){//Error							r = getXmlAtt(reg,"native3");							if (r &! ""){								setXmlAtt(XmlResult,loop,i,"Error",r);							}else if(getXmlAtt(reg,"mssg") &! ""){								setXmlAtt(XmlResult,loop,i,"Error",getXmlAtt(reg,"mssg"));							}else{								setXmlAtt(XmlResult,loop,i,"Error","Error de inserción");							}						}					}					kdb.rst(); kdbF.rst();//Resetear todos los cubos usados.					//Enviar al siguiente query					acualMin = acutualMax;					acutualMax = ((acualMin + regXLoop)>regs)?regs:(acualMin + regXLoop);					loop++;				}	//Fin loop				kdbF.sp("k_nreg","datNreg"&tabla,tabla); 				kdbF.exec();				var regsDestino = kdbF.get("datNreg"&tabla);				if(regsDestino != regs){					setXmlAtt(xmlProcesa,tabla,"ok",0);					setXmlAtt(xmlProcesa,tabla,"Error","Hay menos registros de los correctos en el destino");					setXml(xmlProcesa,tabla,"Error",getXml(XmlResult));				}else{					cnt = nXml(XmlResult);//Si tiene un hijo, entro en error en algun loop					if(cnt==0){						setXmlAtt(xmlProcesa,tabla,"ok",1);//Por lo que de no tener hijos todos los registros se insertaron correctamente.					}else{						setXmlAtt(xmlProcesa,tabla,"ok",0);						setXml(xmlProcesa,tabla,"Error",getXml(XmlResult));						setXmlAtt(xmlProcesa,tabla,"Error","Hay inserts que regresaron errores");					}				}				setXmlAtt(xmlProcesa,tabla,"regsForaneo",regsDestino);			}						fun MigraFolios(){				if(sqlFlag){					/*kdb.query("datFolio","SELECT c1,c4 FROM SqlIov");					kdb.exec();					var val;					nReg = kdb.N("datFolio");					for(var i=0;i<nReg;i++){						val = kdb.get("datFolio","r"&i,"c1");//query inicia en c0						if(val != 0){							setXmlAtt(xmlFolios,kdb.get("datFolio","r"&i,"c0"),"Folio","Y");						}					}*/					return;//SQL migra la tabla y el def, lo obtiene de SQL por lo que no es necesario procesarlo				}else{					var path = frn.get("k75path");					kdb.file("dat,list,"&path&"\\*.*");//Listar las tablas encontradas en la carpeta de datos					kdb.exec();					var nReg = kdb.N("dat");					var xmlFolios;					for(var i=0;i<nReg;i++){						var file = kdb.get("dat","r"&i,);						var typeFile = strSplit(file,".",1);						if (((typeFile &! "DAT")&&(typeFile &! "SRT"))){							setXmlAtt(xmlFolios,file,"Folio","Y");						}					}					nReg = nXml(xmlFolios);					var string,archivo,folio,ext;					for(var i=0;i<nReg;i++){						archivo = getXmlX(xmlFolios,5,i);						ext = strSplit(archivo,".",1);						if(strlen(ext)>0){							string = "GET,"&archivo&",a1,$,datFolio"&i;							setXmlAtt(xmlFolios,archivo,"FolioFile","1");						}else{							string = "GET,"&archivo&",a1...a127,$,datFile"&i;	//127 es el numero maximo que se puede usar en un archivo iov							setXmlAtt(xmlFolios,archivo,"FolioFile","0");						}						kdb.iov(string);					}					kdb.exec();					for(var i=0;i<nReg;i++){						archivo = getXmlX(xmlFolios,5,i);						if(getXmlAtt(xmlFolios,archivo,"FolioFile")){							folio = kdb.get("datFolio"&i,"a1");							if(folio &! "" || folio != 0){								string = "PUT,"&archivo&","&folio;								kdbF.iov(string);							}						}else{							var dato,prefijo;							var bandera=0,;							var XmlfolioTemp;							var val=0;							var nReg1 = kdb.N("datFile"&i);							for(var j=0;j<nReg1;j++){								dato = kdb.get("datFile"&i,"a"&(j+1));								if(dato &! ""){									setXmlAtt(XmlfolioTemp,"r"&bandera,"campo",dato);									setXmlAtt(XmlfolioTemp,"r"&bandera,"nCampo",j+1);									setXmlAtt(XmlfolioTemp,"r"&bandera,"nCmpIgnore",val);									val = "";									bandera++;								}else{val++;}							}							nReg1 = nXml(XmlfolioTemp);							var tempData;							for(var j=0;j<nReg1;j++){								bandera = getXmlAtt(XmlfolioTemp,"r"&j,"nCmpIgnore");								val = getXmlAtt(XmlfolioTemp,"r"&j,"campo");								prefijo = (j==0)?"":",";								if(bandera > 0){									for(var k=0;k<bandera;k++){										tempData = tempData & ",";									}								}else{tempData = "";}								dato = dato & prefijo & tempData &  val;								tempData = "";							}							dato = trim(dato);							string = "PUT,"&archivo&","	&	dato;							kdbF.iov(string);						}					}					kdbF.exec();				}//else tipo de BD			}//funcion						fun UnaTabla(){				var tabla = frn.get("k_unicTabla");				if(tabla &= ""){					LlenaTabla();					return;				}				frn.rst("k_tablas");//Resetear la tabla				var xmlNoMigra;rstXml(xmlNoMigra);				var flagerrorDef=0;				if(getXmlAtt(xmlTablas,tabla,"nCampos") &= ""){					frn.message("La tabla seleccionada no tiene registros, o no existe","Error","&Aceptar");					frn.set("k_unicTabla","");					LlenaTabla();					return;				}//Si no se tienen registros				frn.setX(tabla,"k_tablas",0,"c1");				frn.setX(getXmlAtt(xmlTablas,tabla,"desc"),"k_tablas",0,"c2");				frn.setX("S","k_tablas",0,"c3");				frn.setX(getXmlAtt(xmlTablas,tabla,"indice"),"k_tablas",0,"c4");				frn.setX(getXmlAtt(xmlTablas,tabla,"migrado"),"k_tablas",0,"c5");				frn.setX(getXmlAtt(xmlTablas,tabla,"nRegistros"),"k_tablas",0,"c6");				if(getXmlAtt(xmlTablas,tabla,"NoMigrableDef")==1){					//setXmlAtt(xmlNoMigra,"r"&(nXml(xmlNoMigra)),"tabla",tabla);					setXmlAtt(xmlNoMigra,"r"&(nXml(xmlNoMigra)),"tabla",tabla,"desc","No se encontro el DEF de esta tabla, Se ignorará en la migración");					flagerrorDef=1;				}				if(flagerrorDef){					frn.set("errorMigra",xmlNoMigra);					frn.dialog("kmdbMigraError","errorMigra");				}			}						fun MigracionKDB(tabla,nCampos,indice,regs){				frn.set("k_regTotal",regs);				var xmlInsert;				var parentesisAbre = "1(1";//Parentesis por código				parentesisAbre = mid(parentesisAbre,1,1);				var parentesisCierra = "1)1";//Parentesis por código				parentesisCierra = mid(parentesisCierra,1,1);				var nCamposLlave = strSplit(indice,",",-1);				var xmlCampos;rstXml(xmlCampos);//Generar Xml de campos llave				var cnt = 0;//Contador generico				for(var j=0;j<nCamposLlave;j++){//Generar los datos de el select y order de los campos llave					var campo = strSplit(indice,",",j);					setXmlAtt(xmlCampos,campo,"Llave","1");//Se establece este campo como campo llave				}				var regXLoop = frn.get("k_pagVale");//Registros por vuelta.				var actualMin= 0;//Registro primero actual.				var acutualMax = actualMin+ regXLoop;//Set de valores iniciales				//variable usadas en la paginación				var loop = 0;				//Variables que se ocupan dentro del ciclo, se ponen afuera para evitar crear y destruitlas en cada ciclo.				var cubo = "dat"&tabla&"-";//Cubo base para select				var cuboWrite = cubo;//Cubo base para write				var insertValuesXml,insertCamposXml;//Variables XMl que contendrán los campos y valores del armado del insert				var insertXml,XmlResult;				var xmlCamposTabla = getXml(xmlProcesa,tabla,"campos");				var i,j,r;//Contadores usados en los ciclos				var Base,reg,prefijo,table;				var val,tipoDato;//Variable que almacena cada valor de cada tabla,variable que toma el tipo de dato que se esta consultando				var cuboLoop,cuboWriteLoop,insertBase;				setXml(insertValuesXml,cnt,",c,1,&,c1...c");cnt++;				setXml(insertValuesXml,cnt,nCampos);cnt++;				setXml(insertValuesXml,cnt,",&,max,"&regXLoop);				table= catXml(insertValuesXml);				kdb.open("c,"&tabla);//Nos aseguramos que la tabla este abierta.				var nReg,string;//Cpontador para registros de KDB.				var tempBorrar;				var logStr = ""; //VCSS				while(actualMin < regs){					cuboLoop = cubo&loop;//Nombre completo de cubo en select y write					cuboWriteLoop = cuboWrite&loop&"-";					frn.set("k_min",actualMin);//Se mandan los valores actuales que se estan procesando					frn.set("k_max",acutualMax);					string = cuboLoop&table;					//if(loop != 0){string = string & "," & (actualMin+1);}					if(loop != 0){string = string & "," & actualMin;}					kdb.table(string);					kdb.exec();					nReg = kdb.N(cuboLoop);					WriteLog(getXmlStr("dat"&tabla&"-")); //VCSS					insertBase = "INSERT INTO "&tabla&parentesisAbre;					rstXml(xmlInsert);					for(i=0;i<nReg;i++){						rstXml(insertValuesXml);						rstXml(insertCamposXml);						cnt=0;//Preparamos variable para crear write						r = "r"&i;						reg = kdb.get(cuboLoop,r);						for(j=1;j<=nCampos;j++){							val = getXmlAtt(reg,"c"&j);							tipoDato = getXml(xmlCamposTabla,(j));//dejar como variable fija?							if((getXmlAtt(xmlCampos,j,"Llave"))||((strlen(val)>0) && (val &! "   /  /    ") && (val &! " ") && (tipoDato != 2 || val != 0))){								if(tipoDato == 3){									val = GetDateFormat(val);									if(val &= ""){										val = "90/01/01";										val = GetDateFormat(val);									} //VCSS								}								prefijo=""; if(nXml(insertCamposXml)>0)prefijo=",";								setXml(insertCamposXml,cnt,prefijo& "c"&j);//El select inicia en c0								setXml(insertValuesXml,cnt,prefijo& "'"&val&"'");//valor del campo.								cnt++;							}//if valida						}//ciclo campos						if(nXml(insertCamposXml)==0)continue; //No debe haber un registro totalmente en blanco.						cnt = 0;						insertCamposXml = catXml(insertCamposXml);//variable con todos los campos a insertar						insertValuesXml = catXml(insertValuesXml);//Variable con los valores a insertart						rstXml(insertXml);//variable para armar el insert						setXml(insertXml,cnt,insertBase);cnt++;//Insert into tabla 						setXml(insertXml,cnt,insertCamposXml);cnt++;// ("campos"						setXml(insertXml,cnt,parentesisCierra);cnt++;//	) carater de cierre						setXml(insertXml,cnt," VALUES ");cnt++;// Values						setXml(insertXml,cnt,parentesisAbre);cnt++; //(						setXml(insertXml,cnt,insertValuesXml);cnt++;// valores 						setXml(insertXml,cnt,parentesisCierra);cnt++;// ) carater de cierre						Base = catXml(insertXml);// String de Insert						//setXml(tempBorrar,"r0",Base);						//kdb.file("cubo,write,'_insert"&tabla&".txt',EOL:13_10,append",tempBorrar);						kdbF.stmt(Base,cuboWriteLoop&i);						setXml(xmlInsert,"r"&i,Base);					}//ciclo renglones					kdbF.exec();					for(i=0;i<nReg;i++){						reg = kdbF.get(cuboWriteLoop&i);						setXml(tempBorrar,i,getXmlStr(kdbF.get(cuboWriteLoop&i)));						if((getXmlAtt(reg,"ok") != 1) || (getXmlAtt(reg,"err") &! "")){//Error							r = getXmlAtt(reg,"native3");							if (r &! ""){								setXmlAtt(XmlResult,loop,i,"Error",strSplit(r,";",0));							}else if(getXmlAtt(reg,"mssg") &! ""){								setXmlAtt(XmlResult,loop,i,"Error",strSplit(getXmlAtt(reg,"mssg"),";",0));							}else{								setXmlAtt(XmlResult,loop,i,"Error","Error de inserción");							}							setXmlAtt(XmlResult,loop,i,"Insert",getXml(xmlInsert,"r"&i));							logStr = r; //VCSS							WriteLog(logStr); //VCSS						}					}					//kdb.save("_cubo.xml",getXmlStr(kdb.get("dat"),"EOF:13_10"));					//frn.set("xmlData",tempBorrar);frn.dialog("manGenViewXml","xmlData");					kdb.rst(); kdbF.rst();//Resetear todos los cubos usados.					//Enviar al siguiente query					actualMin= acutualMax;					acutualMax = ((actualMin + regXLoop)>regs)?regs:(actualMin + regXLoop);					loop++;				}//loop				kdbF.sp("k_nreg","datNreg"&tabla,tabla); 				kdbF.exec();				var regsDestino = kdbF.get("datNreg"&tabla);				if(regsDestino != regs){					setXmlAtt(xmlProcesa,tabla,"ok",0);					setXmlAtt(xmlProcesa,tabla,"Error","Hay menos registros de los correctos en el destino");					setXml(xmlProcesa,tabla,"Error",getXml(XmlResult));				}else{					cnt = nXml(XmlResult);//Si tiene un hijo, entro en error en algun loop					if(cnt==0){						setXmlAtt(xmlProcesa,tabla,"ok",1);//Por lo que de no tener hijos todos los registros se insertaron correctamente.					}else{						setXmlAtt(xmlProcesa,tabla,"ok",0);						setXml(xmlProcesa,tabla,"Error",getXml(XmlResult));						setXmlAtt(xmlProcesa,tabla,"Error","Hay inserts que regresaron errores");					}				}				setXmlAtt(xmlProcesa,tabla,"regsForaneo",regsDestino);			}						fun GetDateFormat(val){				var dateTem = strSplit(val,"/");				if (val &= "  /  /  " || val &= "  /  /    "){return "";}				else{					if(sqlFlag){						return getXml(dateTem,"r2") & "-" & getXml(dateTem,"r1") & "-" & getXml(dateTem,"r0");					}else{						return getXml(dateTem,"r0") & "-" & getXml(dateTem,"r1") & "-" & getXml(dateTem,"r2");					}				}			}												fun InsertSys(cubo){//Tablas a procesar				var parAbre = mid("-(-",1,1);				var parCierra = mid("-)-",1,1);								var xmlTipos;//Genereamos un nuevo cubo con los tipos de datos a usar en kepler 9				setXmlAtt(xmlTipos,"1","k9","C");				setXmlAtt(xmlTipos,"0","k9","C");				setXmlAtt(xmlTipos,"2","k9","N");				setXmlAtt(xmlTipos,"3","k9","D");				var instCampos = "INSERT INTO sysColumn (k_table,k_col,k_type,k_nc,k_nd,k_dscr,k_cns) VALUES (";//Base de insert a columnas				var instIndex = "INSERT INTO sysIndex (k_table,k_index,k_cns,k_col) VALUES (";//Base de insert a indices				var instVal;				var xmlCamposIns;				var nReg = nXml(cubo);				var i,j,k,cnt,tabla,dscr,nReg2,tipo,val;				var nCamposIndex,r,stmt,tempBorrar;				var len,sufijo,nChar,tab;				for(i=0;i<nReg;i++){					tabla = getXmlX(cubo,5,i);										if(getXmlAtt(cubo,tabla,"subTabla")){continue;}//Las subtablas, no se estarán migrando las tablas hijo, su def no existen.										dscr = getXmlAtt(xmlTablas,tabla,"desc");					kdbSys.stmt("INSERT INTO sysTable (k_table,k_dscr) VALUES ('"&tabla&"','"&dscr&"')","datTable"&tabla);//tablas de KEPLER 9					nReg2 = nXml(cubo,tabla,"campos");					for(j=1;j<=nReg2;j++){						 cnt = 0;						 rstXml(xmlCamposIns);						 setXml(xmlCamposIns,cnt,"'"& tabla &"'");cnt++;						 setXml(xmlCamposIns,cnt,",'c"&j&"'");cnt++;						 tipo = getXmlAtt(xmlTablas,tabla,"campos",j,"tipo");						 setXml(xmlCamposIns,cnt,",'"& getXmlAtt(xmlTipos,tipo,"k9") &"'");cnt++;						 setXml(xmlCamposIns,cnt,",'"& getXmlAtt(xmlTablas,tabla,"campos",j,"ncar") &"'");cnt++;						 val = getXmlAtt(xmlTablas,tabla,"campos",j,"nDecim");						 if(tipo == 2){							if(val &= ""){val = "''";}						 }						 setXml(xmlCamposIns,cnt,",'"& val &"'");cnt++;						 val = getXmlAtt(xmlTablas,tabla,"campos",j,"name");						 if(val &= ""){continue;}						 setXml(xmlCamposIns,cnt,",'"& val &"'");cnt++;						 setXml(xmlCamposIns,cnt,",'"& j &"'");cnt++;						 val = catXml(xmlCamposIns);						 cnt = 0;						 rstXml(instVal,cnt,instCampos);cnt++;						 rstXml(instVal,cnt,val);cnt++;						 rstXml(instVal,cnt,parCierra);cnt++;						 //val = catXml(instVal);						 val = instCampos & val & parCierra;						 //setXml(tempBorrar,"r0",val );//Debbug para desarrollo.						//kdb.file("cubo,write,'_insert.txt',EOL:13_10,append",tempBorrar);						 kdbSys.stmt(val,"datCol"&tabla&j);					}//campos					nReg2 = nXml(xmlTablas,tabla,"ind");										for(j=0;j<nReg2;j++){						r = "r"&j;						nCamposIndex  = nXmlAtt(xmlTablas,tabla,"ind",r);						rstXml(xmlCamposIns);						setXml(xmlCamposIns,cnt,instIndex);cnt++;						setXml(xmlCamposIns,cnt,"'"& tabla &"'");cnt++;						setXml(xmlCamposIns,cnt,",'"& j+1 &"'");cnt++;						stmt = catXml(xmlCamposIns);						for(k=0;k<nCamposIndex;k++){							stmt = catXml(xmlCamposIns);							val = getXmlAtt(xmlTablas,tabla,"ind",r,"c"&k);							stmt = stmt & ",'"&k+1&"','"&val&"'";							stmt = stmt &parCierra;							kdbSys.stmt(stmt,"datInd"&tabla&j&k);													}//campos del indice					}//indices				}//tablas				kdbSys.exec();							}						fun ConectaSys(){				var ip,port,datasource;				kdbSys.connect();//Se establece una conexión nueva para estos datos				port = frn.get("k_port");//Obtener el puerto de pantalla				port = (port != 0)?port:1803;///Use an new connect				ip = frn.get("k_ip");				datasource = "SYS"; 				kdbSys.setKde(3,"\\KS9\\"&ip&"," & port & "\\"&datasource&"\\");				kdbSys.stmt("SELECT k_description,k_code FROM sysDataSource WHERE k_server != '' AND k_database  != '' AND k_schema != '' AND k_user  != '' AND k_password  != ''","datInsSys");//Validar que conexión opere correctamente.				kdbSys.exec();				if(kdbSys.get("datInsSys","ok") &= ""){					frn.message("Errror en la configuración de servidor KEPLER 9| Para migrar información sys.","Error","&Aceptar");					return;				}else{					frn.set("k_datasource",kdbSys.get("datInsSys"));				}			}						fun MigraSysData(cubo,demand){//Cubo a procesar, Solicitud separada, en caso que el usuario solicite expresamente solo mgracion de def				//conexión al source sys				if(demand){					cubo = SeleccionaTablas();				}				DeleteSys(cubo);				InsertSys(cubo);				FileSave(cubo,"D:\Basura\Cubo");				if(demand){					frn.message("Proceso terminando.","Exito","Aceptar");				}			}						fun DeleteSys(cubo){				var nReg= nXml(cubo);				var xmlInTabla,coma;				for(var i=0;i<nReg;i++){					setXml(xmlInTabla,i,getXmlX(cubo,5,i));				}				nReg = catXml(xmlInTabla,",");				kdbSys.stmt("DELETE FROM sysTable WHERE k_table IN ("&nReg&")","datDelSysTable");//Eliminar el registro de tabla de tablas				kdbSys.stmt("DELETE FROM sysColumn WHERE k_table IN ("&nReg&")","datDelSysCols");//Eliminar el registro de tabla de columnas				kdbSys.stmt("DELETE FROM sysIndex WHERE k_table IN ("&nReg&")","datDelSysIndex");//Eliminar el registro de tabla de indices				kdbSys.exec();							}						fun EjecutaMigraFolio(){				if(!kdbF.exec()){//En caso no tener la conexión al servidor remoto, se intenta reconectar					Conecta();					if(!kdbF.exec()){						frn.message("No se ha logrado la conexión al servidor destino","Error","&Aceptar");						return;					}				}				MigraFolios();				frn.message("Proceso de migración de folios completada","Exito","&Ok");			}						fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;					else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.					if(frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if(frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if(frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}					//VCSS Escribir a log de proceso			fun WriteLog(texto){//Anteponer "_" para indicar ruta local (m?quina cliente). De otra forma guarda en el servidor 				//kdb.save("D:\Basura\ErrorLog.log",texto);				var datXml;				setXml(datXml,"r0",delScpScn(texto));				var cmd="datFile,write,'D:\Basura\Error.log',append";				kdb.file(cmd,datXml);				kdb.exec(); 			}							fun WriteLog_bak(texto,FileName){//Lectura/escritura				//db.save("_"&FileName&".txt",getXmlStr(xmlVar,"EOF:13_10"));			}												/*			Autor							Fecha							Cambio			----------------------------------------------------------				Juan Cristobal				17-Abril-2019				-Se agrega una columna extra para registrar los valores insertados en la migración.																			-Se agrega funcionalidad de migrar el def de una tabla nuevamente, agregando un delete a las tablas de sys en KEPELR 9											29-Abril-2019				-Se corrige la inserción de los datos a las tablas SYS en KEPLER 9																			-Se agrega una conexión directa a los datasources configurados en KEPLER 9											06-Mayo-2019				-Se corrige la inserción de los archivos usados de cuentas para ser insertados.																			-Se modificael inicio de la pantalla para mostrar los datosources definidos en KEPLER 9 											07-Mayo-2019				-Se corrige la rutina de calculo de tiempo para hacer correctamente el calculo cuando se tienen fechas de inicio y termino diferentes.			Evani Moreno				13-Septiembre-2019		-Se agrega la variable xmlInsert en la funcion MigracionKDB para guardar el insert en el xml de errores ticket 3432			Juan Cristobal				17-Septiembre-2019		-Se corrige la función MigraFolio, para corregir asignación de variables durante el ciclo.														NOTAS:			----------------------------------------------------------				-Corrección	a	la rutina	de tiempo			-Migrar procesamiento de registros a DLL			-Agregar funcionalidad de rstSystemData (Ver factivilidad.)			*/			}	</script></pag>