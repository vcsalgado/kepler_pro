clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="14,1" fnt="Arial,15" type="number" nc="18" modify="N" available="N" just="R" nd="2"/>				<br/><txt clr="108,34,38" fnt=",b"> Total Retenciones (-):</txt><tab n="3"/>				<inp id="k_uuid_total_retenciones" clr="108,34,38" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="14,1" fnt="Arial,16b" type="number" nc="18" modify="N" available="N" just="R" nd="2"/>				<br/><txt clr="0,0,0"> Comp. Local Tras.:</txt><tab n="4"/>				<inp id="k_uuid_impto_adicional_A" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="14,1" fnt="Arial,15" type="number" nc="18" modify="Y" available="N" just="R" nd="2"/>				<br/><txt clr="108,34,38" fnt=","> Comp. Local Ret. (-):</txt><tab n="3"/>				<inp id="k_uuid_impto_adicional_B" clr="108,34,38" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="14,1" fnt="Arial,15" type="number" nc="18" modify="Y" available="N" just="R" nd="2"/>												<sp n="1"/>				<br/><txt clr="0,0,0" fnt=",b"> Total : </txt><tab n="7"/> 				<inp id="k_uuid_monto" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim="14,1" fnt="Arial,16b" type="number" nc="18" modify="N" available="N" just="R" nd="2"/>			</grp>			<sp n="1"/>			<grp dim="71,24,7,10" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="1,5" fnt="Arial,16">				<sp n="1"/> <txt fnt=",b">Datos del proveedor :</txt><br/>				<br/>				<sp n="1"/><txt>Clave : </txt><tab/>				<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 					OnButton="Dialog(3,cxpcatprobus,k_clave)" OnF9="Dialog(3,cxpcatprobus,k_clave)" OnChange="BuscarProveedor()" 					type="capital" nc="7" tooltip="Proveedor ( F9 b&#250;squeda )" modify="Y" hk="P" available="N"/> 				<sp n="1"/><tab/> <txt clr="0,58,112">RFC : </txt>				<inp id="k_rfc" clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" dim=