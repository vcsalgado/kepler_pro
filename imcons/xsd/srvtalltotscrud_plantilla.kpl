<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,9" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<sp n="2"/>		<txt fnt="Arial,22" clr="0,0,0">TOTs</txt>		<br/>		<sp n="2"/>		<hLine clr="0,0,0"/> 		<br/> <br/>		<sp n="2"/>		<grp dim="50,12,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">			<sp n="2"/>			<txt>Sucursal :</txt>			<sp n="2"/>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="54,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" tooltip="Sucursal" available="Y" modify="Y"/>			<br/>			<sp n="2"/>			<txt>Tipo :</txt>			<sp n="6"/>			<cmb id="k_tipon" dim="54,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo()" tooltip="Tipo de Movimiento"/>						<br/>			<sp n="2"/> <txt id="textProvPago" clr="6,31,255" hk="P" visible="Y">Proveedor de Pago :</txt>			<sp n="1"/>			<edt id="k_clave_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 				OnButton="Get_Cat(1)" OnF9="Get_Cat(1)" OnChange="BuscarProvPago()" 				type="capital" nc="7" tooltip="Proveedor de Pago" modify="Y" hk="C" available="Y" visible="Y"/> 			<br/>			<sp n="13"/>			<inp id="k_nombreprov_pago" clr="6,31,255" clrBrdr="255,255,255"  dim="54,1" fnt="Arial,16" type="capital" modify="N" available="N" nc="50" visible="Y"/>		</grp>				<sp/>		<grp dim="37,12,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="2"/>			<inp id="operacion" dim="48,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C"/><tab/> <br/>			<sp n="2"/>			<txt id="textFolio" visible="N"