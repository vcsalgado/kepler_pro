1" brdr="0,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" Null="N" OnChange="CargarCuentasConcepto()"/>					</grp> 		</grp>				<br/><br/><sp n="2"/>		<grp dim="81,30,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Movimientos">			<sp n="1"/> 			<tbl id="k_mov" dim="113,6" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" hk="z" OnChange="" Reorder="N" modify="Y" insdel="Y" available="Y">				<col id="k_tipo_orden" name="T"  type="capital" tooltip="Tipo de Orden ( F9 b&#250;squeda )" nc="2" OnF9="ObtenerTipoOrden()" OnChange="BuscarTipoOrden()"					OnMouseL="ObtenerTipoOrden()" modify="Y" available="Y" visible="Y"/>				<col id="k_desc_tipo" name="Desc. Tipo Orden" type="capital" modify="N" tooltip="Descripci&#243;n Tipo de Orden" nc="15" visible="Y" available="N"/>							<col id="k_num_orden" name="Orden" type="capital" OnF9="ObtenerNumOrden()" 					OnMouseL="ObtenerNumOrden()" modify="N" tooltip="N&#250;mero de Orden ( F9 b&#250;squeda )" nc="15" visible="Y" available="Y"/>						<col id="k_punto" name="Punto"  type="number"  modify="N" OnF9="ObtenerPunto()" OnMouseL="ObtenerPunto()" 					OnChange="ValidaPuntoOrden()" OnActive="" visible="Y" tooltip="Punto ( F9 b&#250;squeda )" nc="5" available="Y"/>				<col id="k_desc_punto" name="Desc. Punto" type="capital" modify="N" tooltip="Descripci&#243;n Punto" nc="40" visible="Y" available="N"/>							<col id="k_descriptot" name="Descripci&#243;n TOTs"  type="capital" OnChange="ValidaDescripcion()" OnF9="" OnMouseL="ValidaDescripcion()" modify="Y" available="Y" tooltip="Descripci&#243;n" nc="70" visible="Y"/>				<col id="k_costo" name="Costo"  type="number" nd="2"	OnChange="CalculaPrecio()" tooltip="Costo" modify="Y" available="Y" visible="Y"/>									<col id="k_precio" name="Precio"  type="number" nd="2" min="0" OnF9="" OnMouseL="" OnChange="" OnActive="" tooltip="Precio" modify="Y" visible="Y" available="Y"/>			</tbl>			<br/>			<sp n="1"/> <txt clr="0,58,112">Notas:</txt>			<sp n="1"/> <inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="106,1" brdr="2,0" fnt="Arial,16" modify="Y" available="Y" type="string" bclr="255,255,255"/>						<br/>			<sp/>			<grp dim="80,20,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">								<tbl id="k_mov_ctas" dim="80,8" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" 				  hk="z" Reorder="Y" modify="N" OnChange="CalcTotal()"  insdel="N" available="Y">					<col id="k_concepto" name="Concepto" visible="Y" modify="N" available="N"/>					<col id="k_cuenta" name="Cuenta"  type="capital" OnMouseD="select_cuenta()" OnF9="select_cuenta()"  OnChange="Cuenta()" visible="Y" modify="N" np="90" available="Y"/>					<col id="k_cuentadesc" name="Nombre Cuenta" type="string" nc="35" modify="N" visible="Y" available="N" np="150"/>						<col id="k_cargo" name="Cargo" type="number" nd="2" OnChange="Cargo()" nc="15" available="Y" modify="N" visible="Y" np="80"/>					<col id="k_abono" name="Abono"  type="number" nd="2" OnChange="Abono()" nc="15" available="Y" modify="N" visible="Y" np="80"/>					<col id="k_inventario" name="Inventario" visible="Y" modify="Y" available="Y" OnF9="busca_inv()" OnChange="Inventario()" np="80"/>					<col id="k_afecta" name="Afecta U / A" type="capital" visible="Y" modify="Y" available="Y" OnChange="Afecta()"  np="60" nc="1"/>					<col id="k_ctopto" name="Presupuesto" type="capital" visible="Y" modify="Y" available="Y" OnF9="busca_ctopto()" OnChange="Prspto()"  np="60" nc="10"/>					<col id="k_cuenta_grupo" name="Cta.Grupo" type="capital" nc="1" modify="N" available="N" visible="Y"/>					<col id="k_cuenta_divisible" name="Divisible" type="capital" nc="1" modify="N" available="N" visible="Y"/>					<col id="k_campo_cuenta_plantilla" name="Cta.Plantilla" type="capital" nc="3" modify="N" available="N" visible="Y"/>					<col id="k_costo_inventario" name="Costo Inv." type="capital" nc="1" modify="N" available="N" visible="Y"/>											<col id="k_cuenta_origen" name="Cta. Or."  type="capital" visible="Y" modify="N" np="90" available="N"/>					<col id="k_cuentadesc_origen" name="Nombre Or." type="string" nc="35" modify="N" visible="Y" available="N" np="150"/>						<col id="k_cargo_origen" name="Cargo Or." type="number" nd="2" nc="15" available="N" modify="N" visible="Y" np="80"/>					<col id="k_abono_origen" name="Abono Or."  type="number" nd="2" nc="15" available="N" modify="N" visible="Y" np="80"/>					<col id="k_cuenta_grupo_origen" name="Cta.Gpo.Or." type="capital" nc="1" modify="N" available="N" visible="Y"/>					<col id="k_cuenta_divisible_origen" name="Divisible" type="capital" nc="1" modify="N" available="N" visible="Y"/>					<col id="k_campo_cuenta_plantilla_origen" name="Cta.Plantilla" type="capital" nc="3" modify="N" available="N" visible="Y"/>					<col id="k_costo_inventario_origen" name="Costo Inv." type="capital" nc="1" modify="N" available="N" visible="Y"/>								<col id="k_cuenta_base" name="Cuenta base" type="capital" modify="N" available="N" visible="Y"/>					<col id="k_referencia_uuid" name="uuid" type="capital" modify="N" available="N" visible="Y"/>									</tbl>				<br/><tab/><txt>Cargos : </txt>				<inp id="k_total_cargos" dim="12,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" just="R" nd="2" modify="N" available="N"/><tab n="2"/><txt>Abonos : </txt>				<inp id="k_total_abonos" dim="12,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" just="R" nd="2" modify="N" available="N"/><tab n="10"/>				<img id="Recalcular" dim="20,20" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="RecalcularPoliza()" tooltip="Recalcular poliza" available="Y" clrBrdr="0,0,0" visible="Y"/>			</grp>				<sp n="1"/>			<grp dim="41,20,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<txt>Monto en ordenes :</txt>				<sp n="1"/><inp id="k_monto_ordenes" dim="15,1" clr="64,64,64" type="number" modify="N" available="N" visible="Y" just="R" nd="2"/>				<sp n="1"/><br/><br/><txt> Antes de Imptos.:</txt> 				<sp/> <inp id="k_subtotal" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N"/>				<br/>				<sp n="1"/> <txt>Imptos. Tras. :</txt><sp n="4"/>				<inp id="k_sumtras" dim="15,1" clr="64,64,64" type="number" modify="N" available="N" nd="2"/><tab/> 				<inp id="k_iva" clr="64,64,64"  dim="1,1" fnt="Arial,16" type="number" nd="2" modify="N" available="N" visible="N"/>				<inp id="k_porciva" dim="1,1" bclr="240,240,240" clrBrdr="255,255,255" type="string" modify="N" available="N" just="L" visible="N"/>									<br/>				<sp n="1"/> <txt fnt=",16" clr="108,34,38">Imptos. Ret. ( - ) </txt> <sp n="1"/>				<inp id="k_sumrets" clr="108,34,38" dim="15,1" fnt=",16" type="number" nd="2" modify="N" available="N"/>										<br/>				<sp n="1"/> <txt fnt=",16b">Importe : </txt>				<sp n="7"/> <inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="N"/>  				<br/>							</grp>							</grp>								<grp dim="7,10,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr=",5" fnt="Arial,16" tit=" "><br/><br/><br/><br/><br/>		<sp n="2"/>		<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="EjecReporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="N" modify="Y"/>		<br/>		<br/>		<sp n="2"/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>		<br/>		<br/>		<sp n="2"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		</grp>									</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable;			// Variables de control			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, tiporden,desc_tipo, numorden, punto, descripcion, costo, resVal, porc_iva;			var fileSavePath,asterisco;						//Variables validacion factura			var str_uuid, fecha_uuid, rfc_uuid, total_uuid;							//Added by JMM 20240111, 20240120			var nombre_uuid, regimen_uuid, folio_uuid, serie_uuid, NewProvId;			//Added by JMM 20240229			var paramProvPago, proveedor_pago_id;			var impuesto_uuid;			//Added by JMM 20240626			//VCSS 03/09/25 Impuestos			var retisr_uuid, retiva_uuid;			var trasiva_uuid, trasieps_uuid, totalimptosret_uuid, totalimptostras_uuid, subtotal_uuid,impuestosLocalRet_uuid,impuestosLocalTras_uuid; 			//Porcentajes kdmm			var prc_retencion_isr,prc_iva ,prc_retencion_iva, prc_otras_retenciones, afecta_costo_inv;			var	GAPMontoGastos;									//Variables de parametros			var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd,uen;								fun Main() {			frn=new FRNT;			kdb=new KDB;			rep=new REP;			frP=new FRNTP;			sys=new SYS;			kdb.connect();			kdb.kde("KDE");			kdb.exec();						anio_contable = mid(fnDate("year",sys.date()),2,2);			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			suc_usuario = frn.lib("libKepler","UserInfo(1)");			asterisco="*";			fileSavePath = "C:\Basura";			Inicializa();			ObtenerGAPMontoGastos();			ConfiguraControlesOpcion();		}					fun ObtenerGAPMontoGastos(){// { GAP monto Gastos }			var respfunc;			GAPMontoGastos = 0;			cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Monto Gastos'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ObtenerGAPMontoGastos()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_ObtenerGAPMontoGastos");								ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return respfunc;			}			if (nXml(cuboQuery) > 0) {				GAPMontoGastos = getXmlAtt(cuboQuery,"r0","paramvalor");			} else {				frn.message("Hubo problemas para obtener los Parametros [ObtenerGAPMontoGastos] ...","Error","Aceptar");				return respfunc;			}		}				fun Inicializa(){ //Inicializa los valores en Pantalla					paramProvPago = 0; // Added by JMM 20240229					// Revisa parametros recibidos			if( frn.nParam() == 6 ){ //Se han mandado parámetros a la página                gen_doc=trim(frn.param(0));                 nat_doc=trim(frn.param(1));                 gpo_doc=trim(frn.param(2));                tip_doc=trim(frn.param(3));                 tip_ope=trim(frn.param(4));                uen=trim(frn.param(5));				if (uen &= ""){					uen="XXX";				}			} else {				frn.message("Operación no válida ...", "Mensaje","&Aceptar");				frn.open("redirect",2);				return;			}            			if(tip_ope &= "A"){ //Alta				frn.set("operacion","ALTA");			} else {				if(tip_ope &= "B"){ //Baja					frn.set("operacion","BAJA");				} else {					if(tip_ope &= "C"){ //Consulta						frn.set("operacion","CONSULTA");					} else {						frn.message("Operación no válida ...", "Mensaje","&Aceptar");						frn.open("index",4);						return;								}				}			}							// Fill Combo Sucursal (Con Query de PostgreSQL)			cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}			}			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_sucn",cuboQuery);				sucursal_id = frn.get("k_sucn",-1,1);										// Added by JMM 20240229 ... Check Security PARAM for User to use PROV PAGO			paramProvPago = ProvPago_Sec(usuario);											// Fill Combo Tipo (Con Query FTO Kepler) 			cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.Inicializa()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error BD","Aceptar");				return;			}			frn.set("k_tipon",getXml(cuboQuery));						frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				//Llena combo de conceptos de facturas			cmdQuery="select descripcion_factura, id_tipo_factura, tipo_poliza from keplersc.conf_polizas_facturas_mst order by descripcion_factura";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}						frn.set("k_concepto_factura",cuboQuery);							// Fill k_docto | referencia docto			ArmarRefDocto();			configuraciones_kdmm();						LimpiaDatosProv();			IniParams();		}				fun configuraciones_kdmm(){			var cmd, cuboResultados ,ok,mensajeError;							cmd= " select c15,c16,c33,c75,c77 from keplersc.kdmm where col_sucursal='" & sucursal_id & "' and c1='" & gen_doc & "'" ;						cmd = cmd & " and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4='" & tip_doc & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.configuraciones_kdmm()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			afecta_costo_inv = getXmlAtt(cuboResultados , "r0","c77");						}							//Validacion Datos Generales y Partidas antes de Guardar.		//El resultado de cada validacion se guarda en la variable global resVal.		fun ValidarDatos() {			var totReg, strTotal=0,subTotal=0, iva=0, total=0, renglones, str,vdiferencia;			// New 20240121 ... To Get of PARAMs 			var gapMonto, gapDias; 						//Obtener variables			sucursal_id = frn.get("k_sucn",-1,1);			proveedor_id = frn.get("k_clave");			refer_id = frn.get("k_refer");			// Added JMM 20240229			proveedor_pago_id = trim(frn.get("k_clave_pago"));			//Obtener PARAMs (GAPs) ... 20240112 ... NEW			cmdQuery="SELECT count(*) as totreg from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro in ('GAP Dias Fecha Gastos','GAP Monto Gastos')";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				resVal=0;				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("Los Parametros [GAPs] Necesarios para la Operacion No Existen ...","Error","Aceptar");				resVal=0;				return;			} else {				if(totReg<2){					frn.message("Los Parametros [GAPs] Necesarios para la Operacion No estan Completos ...","Error","Aceptar");					resVal=0;					return;				} else {									// Obtener PARAMs 					// { GAP Dias Fecha Gastos }					cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Dias Fecha Gastos'";					rstXml(cuboQuery);									cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidarDatos()");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPDias");										ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						resVal=0;						return;					}					if (nXml(cuboQuery) > 0) {						gapDias = getXmlAtt(cuboQuery,"r0","paramvalor");					} else {						frn.message("Hubo problemas para obtener los Parametros [GAP Dias Fecha Gastos] ...","Error","Aceptar");						resVal=0;						return;					}										// { GAP Monto Gastos }					cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Monto Gastos'";					rstXml(cuboQuery);									cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidarDatos()");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPMonto");										ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						resVal=0;						return;					}					if (nXml(cuboQuery) > 0) {						gapMonto = getXmlAtt(cuboQuery,"r0","paramvalor");					} else {						frn.message("Hubo problemas para obtener los Parametros [GAP Monto Gastos] ...","Error","Aceptar");						resVal=0;						return;					}									}			}			//Validar Referencia ... Moved here 20240112 			if (refer_id &= ""){				frn.setPos("k_refer");				resVal=0;				frn.message("Es necesario seleccionar la Factura del Proveedor ...","Error","Aceptar");				return;			}									if ( strlen(/*folio_uuid*/nombre_uuid) == 0 || strlen(rfc_uuid) == 0 || strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {				frn.message("No se cuenta con todos los datos mandatorios del UUID.","Error","Aceptar");				resVal=0;				return;			}							//Validar Fecha Referencia ... 20240112 ... NEW			if ( Validar_Fecha_UUID() == 0 ) {					resVal = 0;				return;			}													//Validar Proveedor			// Added 20240112			if ( strlen(frn.get("k_clave")) == 0 || frn.get("k_clave") &= strFormat("ucase","No Existe ...") ) {				if ( strlen(frn.get("k_clave")) == 0 ) {					frn.message("No hay Proveedor Asociado a la Operacion ...","Error","Aceptar");				} else {					frn.message("El Proveedor No Existe ...","Error","Aceptar");				}				resVal=0;				return;			}						cmdQuery="SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_id & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("El Proveedor No Existe ...","Error","Aceptar");				resVal=0;				return;			}									//Validar Proveedor Pago			// Added 20240229			if ( strlen(frn.get("k_clave_pago")) == 0 || frn.get("k_nombreprov_pago") &= strFormat("ucase","No Existe ...") ) {				if ( strlen(frn.get("k_clave_pago")) == 0 ) {					frn.message("No hay Proveedor de Pago Asociado a la Operacion ...","Error","Aceptar");				} else {					frn.message("El Proveedor de Pago No Existe ...","Error","Aceptar");				}				resVal=0;				return;			}			// Added 20240229			cmdQuery = "SELECT count(*) as totreg from keplersc.kdxd where c2 = '" & proveedor_pago_id & "'";			cmdQuery = cmdQuery & " and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')"; 			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			totReg=getXmlAtt(cuboQuery,"r0","totreg");			if(totReg==0){				frn.message("El Proveedor de Pago No Existe.","Error","Aceptar");				resVal=0;				return;			}						//Validar Referencia ... Moved Up 20240112 			/*			if (refer_id &= ""){				frn.setPos("k_refer");				resVal=0;				frn.message("Es necesario seleccionar la factura del proveedor","Error","Aceptar");				return;			}			*/			//Validar datos del Punto			for (var i=1,n=frn.N("k_mov");i<n-1;i++) {				tiporden = frn.get("k_mov",i,"k_tipo_orden");				numorden = frn.get("k_mov",i,"k_num_orden");				punto = frn.get("k_mov",i,"k_punto");				descripcion = frn.get("k_mov",i,"k_descriptot");				costo = frn.get("k_mov",i,"k_costo");				if ((tiporden &! "") && (numorden &! "")) {					if (tiporden &= ""){						frn.setPos("k_mov",i,"k_tipo_orden");						resVal=0;						frn.message("Debe seleccionar tipo de órden","Error","Aceptar");					}					if (numorden &= ""){						frn.setPos("k_mov",i,"k_num_orden");						resVal=0;						frn.message("Debe seleccionar número de órden","Error","Aceptar");					}					if (punto &= ""){						frn.setPos("k_mov",i,"k_punto");						resVal=0;						frn.message("Debe seleccionar un punto","Error","Aceptar");					}					if (descripcion &= ""){						frn.setPos("k_mov",i,"k_descriptot");						resVal=0;						frn.message("Debe capturar la descripción del punto","Error","Aceptar");					}					if (costo == ""){						frn.setPos("k_mov",i,"k_costo");						resVal=0;						frn.message("Debe capturar el costo del punto","Error","Aceptar");					}					if(resVal==0){						return;					}				}			}			//Validar Costos			for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {				frn.setPos("k_mov",i,"k_costo");				CalculaTotales();							}			//Validar Margen de utilidad			if (ValidaMargenUtilidad()==0){				resVal=0;				return;			};						//Validar Totales			subTotal=frn.get("k_subtotal");			iva=frn.get("k_iva");			total=frn.get("k_monto");						var monto_ordenes = frn.get("k_monto_ordenes");			if (monto_ordenes != subTotal){				resVal=0;				frn.message("No se ha registrado el total del importe en las ordenes.","Error","Aceptar");				return;			}						if (total <= 0){				resVal=0;				frn.message("El total de la operación no puede ser cero.","Error","Aceptar");				return;			}			//Validar rfc y monto total de factura correspondan a datos de UUID			strTotal = frn.get("k_monto");			vdiferencia = (strTotal-total_uuid);			if (vdiferencia < 0){				vdiferencia = vdiferencia *(-1); 			}						// Adapted 20240112 ... Se Gestionara por PARAM {TBL : param_oper}			if ( vdiferencia > gapMonto) {				resVal=0;				frn.message("El importe total del TOT no corresponde al de la factura.","Error","Aceptar");				return;			}								if (frn.get("k_rfc") &! rfc_uuid) {				resVal=0;				frn.message("El RFC del TOT no corresponde al de la factura.","Error","Aceptar");				return;			}			//Validacion de importes capturados por orden vs subtotal factura									//Validaciones POLIZA			if(frn.N("k_mov_ctas")-1==0){				frn.message("No es posible dar de alta una Poliza sin datos. Favor de verificar", "Error","&Aceptar");				if ( frn.get("chk_pc") != 1 ) { frn.setPos("k_mov_ctas",-1,"k_cuenta"); } //Added by JMM 20241015 				resVal=0; 				return;			}									//Added by JMM 20240307 			var nreg = frn.N("k_mov_ctas")-1;//cuantos renglones hay			for(var i=0; i<nreg; i++){						var abono,cargo;								var ren_cta = trim(frn.get("k_mov_ctas",i,"k_cuenta"));				var ren_ctadscr = trim(frn.get("k_mov_ctas",i,"k_cuentadesc"));								var ren_inv = trim(frn.get("k_mov_ctas",i,"k_inventario"));				var ren_afecta = trim(frn.get("k_mov_ctas",i,"k_afecta"));				var costo_inventario=frn.get("k_mov_ctas",i,"k_costo_inventario");								var ren_num = i + 1 ;								if (frn.get("k_mov_ctas",i,"k_cuentadesc") &= "ELIMINADA"){					continue;				}								cargo = frn.get("k_mov_ctas",i,"k_cargo");				abono = frn.get("k_mov_ctas",i,"k_abono");												if (strlen(ren_cta) == 0){					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se ha especificado la Cuenta" ,"Error","&Aceptar");					if ( frn.get("chk_pc") != 1 ) { frn.setPos("k_mov_ctas",i,"k_cuenta"); }  //Condition Added by JMM 20241015					resVal=0;return;				}								if (strlen(ren_ctadscr) == 0){					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se ha especificado la Descripcion de la Cuenta" ,"Error","&Aceptar");					if ( frn.get("chk_pc") != 1 ) { frn.setPos("k_mov_ctas",i/*-1*/,"k_cuenta"); }  //Condition Added by JMM 20241015					resVal=0;return;				}								if ( strlen(cargo) > 0 && strlen(abono) > 0 ) {					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : La partida no puede ser de cargo y abono al mismo tiempo" ,"Error","&Aceptar");					frn.setPos("k_mov_ctas",i/*-1*/,"k_cargo");					resVal=0;return;				} 								if ( strlen(cargo) == 0 && strlen(abono) == 0 ) {					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se ha registrado el cargo o abono de la partida" ,"Error","&Aceptar");					frn.setPos("k_mov_ctas",i/*-1*/,"k_cargo");					resVal=0;return;				} 								if(costo_inventario &= "S"){					if ( strlen(ren_inv) == 0 ) {						frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se ha registrado el inventario." ,"Error","&Aceptar");						frn.setPos("k_mov_ctas",i,"k_afecta");						resVal=0;						return;					} 									if ( strlen(ren_afecta) == 0 ) {						frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : No se ha registrado el tipo de afectacion." ,"Error","&Aceptar");						frn.setPos("k_mov_ctas",i/*-1*/,"k_inventario");						resVal=0;						return;					}				}								// Added by JMM 20240715 				var vflag = 0;				if (cargo > 0 || abono > 0){					vflag = ManejaPresupuesto(i, 2);				}				 				if ( vflag == -0.0000001 ) {					frn.setPos("k_mov_ctas",i,"k_ctopto"); 					resVal=0;return;				}				if ( vflag == 0 && strlen( frn.get("k_mov_ctas",i, "k_ctopto") ) > 0 ) { 					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : La Cuenta No Maneja Presupuesto" ,"Error","&Aceptar");					frn.setPos("k_mov_ctas",i,"k_ctopto"); 					resVal=0;return;				}				if ( vflag == 1 && strlen( frn.get("k_mov_ctas",i, "k_ctopto") ) == 0 ) { 					frn.message("Se ha generado el siguiente error en la partida " & ren_num & " : La Cuenta Maneja Presupuesto" ,"Error","&Aceptar");					frn.setPos("k_mov_ctas",i,"k_ctopto"); 					resVal=0;return;				}								// Added by JMM 20240716				if ( vflag == 1 ) {									var vimp = PrsptoXPeriodo(i,2);					if ( vimp == -0.0000001 ) {						frn.setPos("k_mov_ctas",i,"k_ctopto");						resVal=0;return;					}					if ( vimp == 0 ) { 						frn.message("Se ha generado el siguiente error en la partida " & ren_num & "|"  						& " " & "|" & "No se ha Registrado el Presupuesto para el Concepto, dentro del periodo de la Operacion ..." ,"Error","&Aceptar");						frn.setPos("k_mov_ctas",i,"k_ctopto"); 						resVal=0;return;					}										var vejercido = PrsptoXPeriodo_Ejercido(i,2);					if ( vejercido == -0.0000001 ) {						frn.setPos("k_mov_ctas",i,"k_ctopto");						resVal=0;return;					}					if ( vejercido == -0.0000002 ) { 						frn.message("Se ha generado el siguiente error en la partida " & ren_num & "|"  						& " " & "|" & "No se pudo determinar el Presupuesto Ejercido para el Concepto ..." ,"Error","&Aceptar");						frn.setPos("k_mov_ctas",i,"k_ctopto"); 						resVal=0;return;					} else {						var vnvomonto;						vnvomonto = cargo + vejercido;						if ( strlen(cargo) > 0 ) {							if ( vnvomonto > vimp ) {								frn.message("Se ha generado el siguiente error en la partida " & ren_num & "|" & " " & "|" & 								"No puedes exceder el Presupuesto para el Concepto ... " & frn.get("k_mov_ctas", -1, "k_ctopto") & "|" & " " & "|" & 								"Presupuesto : " &vimp  & "|" & " " & "|" & 								"Monto Ejercido : " & vejercido & "|" & 								"(+) Nuevo Cargo = " & cargo & "|" & "(=) Monto Nuevo = " & vnvomonto,"Error","Aceptar");								frn.setPos("k_mov_ctas",i,"k_ctopto"); 								resVal=0;return;							}						}					}									} // End : Flag = 1 								} // End : For k_mov			//Validar	Poliza			var valPoliza = ValidarPoliza();			resVal=valPoliza;						if (resVal==0){				return resVal;			}									// Added by JMM 20240306			subTotal=frn.get("k_subtotal");			if (subTotal <= 0){				resVal=0;				frn.message("El subtotal de la operación no puede ser menor o igual a cero.","Error","Aceptar");				return;			}						// Conditions Added by JMM 20240208 ... Related to Implementing UUID Transaction						strTotal/*total*/=frn.get("k_monto");			if (strTotal/*total*/ <= 0){				resVal=0;				frn.message("El total de la operación no puede ser menor o igual a cero.","Error","Aceptar");				return;			}							// Added by JMM 20240229, Esta condicion es para discriminar validaciones relacionadas con UUID si Chk por Comprobar esta Activado			if ( frn.get("chk_pc") != 1 ) {						//Validar rfc y monto total de factura correspondan a datos de UUID				strTotal = frn.get("k_monto");				vdiferencia = (strTotal-total_uuid);				if (vdiferencia < 0){					vdiferencia = vdiferencia *(-1); 				}							// Adapted 20240112 ... Se Gestionara por PARAM {TBL : param_oper}				if ( vdiferencia > gapMonto /*0.1*/ ) {					resVal=0;					frn.message("El importe total del TOT no corresponde al de la factura.","Error","Aceptar");					return;				}								// End Conditions Added by JMM 20240208 ... Related to Implementing UUID Transaction								}			} // End ValidarDatos()			fun ValidaPuntoDuplicado() {			var renglon_id, renglones;			renglones = frn.N("k_mov")-1;			renglon_id = frn.getIdJ("k_mov");			tiporden = frn.get("k_mov",-1,"k_tipo_orden");			numorden = frn.get("k_mov",-1,"k_num_orden");			punto = frn.get("k_mov",-1,"k_punto");			for (var i=0; i<renglones; i++) {				if (renglon_id != i){					if ( (frn.get("k_mov",i,"k_tipo_orden") &= tiporden) && (frn.get("k_mov",i,"k_num_orden") &= numorden) &&						(frn.get("k_mov",i,"k_punto") &= punto)) {  						frn.message("Verifique, esta intentado dar de alta el mismo TOT","Error","Aceptar");						return;					}				}				}			}		fun BuscarFolio() {			var folio;			folio = frn.get("k_folio");			resVal = 1;			ArmarRefDocto();						//Commented by JMM 20240710 			/*ValidaFolioCancelado(folio);*/			//Added by JMM 20240710			var stDoc = ValidaFolioCancelado(folio);			frn.set( "statusDoc", stDoc );						//Commented by JMM 20240710 			/*			if(resVal == 0){				return;			}			else{				MostrarDatos(folio);			}			*/				MostrarDatos(folio);	// Adapted by JMM 20240710, Run Func Everytime 		}		fun Cancela() {			CambiaSucursal();			Inicializa();			ConfiguraControlesOpcion();		}					fun ModoBuscar() {			LimpiaEncabezado();			ConfiguraControlesOpcion();		}				fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			var resultado, mensaje, folio;							fecha = sys.date();			hora= sys.time();									if (tip_ope &= "A") {							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;				ValidarDatos();				if(ok &! "1" || resVal == 0){					return;				}				continua = frn.message("¿Desea continuar con la alta?","Atención",2);				if (continua == 0){					return;				}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;											setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				setXml(xmlPantalla,"ambiente","schema","CXP_CM_RETENCIONES");								//Added 20240112				setXml(xmlPantalla,"uuid","serie",serie_uuid);				setXml(xmlPantalla,"uuid","folio",folio_uuid);				setXml(xmlPantalla,"uuid","total",total_uuid);				setXml(xmlPantalla,"uuid","fechatimbrado",fecha_uuid);				//Added 20240229				setXml(xmlPantalla,"uuid","impuesto",impuesto_uuid);				//Added 20240704				setXml(xmlPantalla,"uuid","retisr",retisr_uuid);				setXml(xmlPantalla,"uuid","retiva",retiva_uuid);								//Added by JMM 20240626				setXml(xmlPantalla,"k_miepsret",frn.get("k_uuid_retisr"));				setXml(xmlPantalla,"k_mivaret",frn.get("k_uuid_retiva"));				setXml(xmlPantalla,"uuid","iepstras",frn.get("k_uuid_ieps_trasladado"));				setXml(xmlPantalla,"uuid","totalimptoret",frn.get("k_uuid_total_retenciones"));				setXml(xmlPantalla,"uuid","totalimptotras",frn.get("k_uuid_total_trasladado"));				setXml(xmlPantalla,"uuid","subtotal",frn.get("k_uuid_subtotal"));				setXml(xmlPantalla,"uuid","otroimptoa",frn.get("k_uuid_impto_adicional_A"));				setXml(xmlPantalla,"uuid","otroimptob",frn.get("k_uuid_impto_adicional_B"));				setXml(xmlPantalla,"uuid","concepto_factura",frn.get("k_concepto_factura",-1,1));				setXml(xmlPantalla,"uuid","tipo_poliza",frn.get("k_concepto_factura",-1,2));								// Added by JMM 20240704				setXml(xmlPantalla,"ambiente","schema","CXP_CM_RETENCIONES");				// VCSS 12/11/2025 Impuestos				setXml(xmlPantalla,"k_mov_ctas","no_partidas",frn.N("k_mov_ctas") -1);													frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudTOTs");												// For Testing ... 20240111 				/*				frn.message("La Informacion se Procesara ...","Info !!!","Aceptar");				return;				*/				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cuboQuery);				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvtalltotscrud.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudTOTs");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					tip_ope = "C";					frn.set("k_folio", mensaje); 					frn.set("operacion", "CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto", strTmp);					strMsg = "El Folio utilizado para esta operación fue : " & mensaje;					ConfiguraControlesOpcion(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");					MostrarDatos(folio);						BuscarFolio();				} else {					frn.message(mensaje, "Error", "Aceptar");					return;				}			} else {				if (tip_ope &= "B") {					resVal = 1;					ValidaBajaTot();					if(resVal == 0){					return;					}						continua = frn.message("¿Desea continuar con la baja?","Atención",2);					if (continua == 0){						return;					}					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					//Agregar usuario, fechay hora de movimiento					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;													setXml(xmlPantalla,"movimiento","usuario",usuario);					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",					frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 					frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")-1);					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);											frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaCrudTOTs");					cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					rstXml(cuboQuery);											cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvtalltotscrud.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCrudTOTs");											resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok) {						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;						}					if(resultado &= "1") {						// Commented by JMM 20240704 ... For Standar Show						/*						tip_ope = "C";						frn.set("operacion", "CONSULTA");						ConfiguraControlesOpcion();						strMsg = "El TOTs se ha dado de baja";						frn.message(strMsg, "Mensaje", "Aceptar");						*/						// Added by JMM 2024004 ... For Homologating						folio = frn.get("k_folio");						tip_ope = "C";						frn.set("operacion", "CONSULTA");						strMsg = "El Tots fue dado de Baja ...";						ConfiguraControlesOpcion(); 						frn.message(strMsg, "Mensaje", "Aceptar");						Formar_folio();						BuscarFolio();					} else {						frn.message(mensaje, "Error", "Aceptar");						return;					}				} else {					folio = frn.get("k_folio");					MostrarDatos(folio);				}	/*End Consulta*/ 			}						} // FIN ... Ejecuta()											fun CalculaPrecio(){			var precio_punto= 0, margen = 0, iva = 0, margenUtil = 0, totalcte = 0;			var msgTxt;			tiporden = frn.get("k_mov",-1,"k_tipo_orden");			porc_iva = frn.get("k_tipon",-1,6);			numorden = frn.get("k_mov",-1,"k_num_orden"); 			punto = frn.get("k_mov",-1,"k_punto"); 			if (tiporden &= "" ){				frn.set("k_mov",-1,"k_costo","");				frn.setPos("k_mov",-1,"k_tipo_orden");				frn.message("Debe seleccionar tipo de órden","Error","Aceptar");				return;			}				cmdQuery = "select c6 from keplersc.kdmargen " &						"where c1 = '" & tiporden & "'";			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.CalculaPrecio()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboMargen");					ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			margen = getXmlAtt(cuboQuery,"r0" ,"c6");							//Calcula precio del punto			precio_punto= frn.get("k_mov",-1,"k_costo")*(1+margen/100);			frn.setX(precio_punto,"k_mov",-1,"k_precio");						CalculaTotales();			if (frn.get("k_mov",-1,"k_descriptot") &= ""){				frn.setPos("k_mov",-1,"k_descriptot");				frn.message("La descripción del TOT no puede ir en blanco","Error","Aceptar");				return;				}		}		fun ValidaMargenUtilidad(){			var margenUtil = 0, margen = 0;			var descripTxt;			for (var i=0,renglones = frn.N("k_mov"); i<renglones; i++) {				tiporden = frn.get("k_mov",i,"k_tipo_orden");				margenUtil = (frn.get("k_mov",i,"k_precio")-frn.get("k_mov",i,"k_costo"))/frn.get("k_mov",i,"k_costo")*100;				cmdQuery = "select c6 from keplersc.kdmargen " &						"where c1 = '" & tiporden & "'";				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.CalculaPrecio()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboMargen");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				margen = getXmlAtt(cuboQuery,"r0" ,"c6");				//Calcula margen de utilidad				margenUtil = (frn.get("k_mov",i,"k_precio")-frn.get("k_mov",i,"k_costo"))/frn.get("k_mov",i,"k_costo")*100;				descripTxt = frn.get("k_mov",i,"k_descriptot");				if (margen>math("round",margenUtil,2)){										frn.setPos("k_mov",-1,"k_tipo_orden");					frn.message("El TOT o Refaccion: " & frn.get("k_mov",-1,"k_descriptot") & " No tiene el margen de utilidad minimo cargado","Error","Aceptar");									if (margenUtil <= 0){						resVal=0;						frn.message("El TOT o Refaccion: " & frn.get("k_mov",-1,"k_descriptot") & " El margen de utilidad no puede ser 0 o negativo","Error","Aceptar");						return;												//TO DO: PANTALLA DE PASSWORD DE AUTORIZACION Y resVal=1					}					}				return resVal;				}		}					// Armado del Docto Referencia		fun ArmarRefDocto {			var cadena,tmpFolio, tmpGrupo, tmpTipo;			tmpFolio = frn.get("k_folio");			tmpFolio = PadLeft(tmpFolio,"7","0");			tmpGrupo = PadLeft(gpo_doc,"2","0");			tmpTipo = PadLeft(tip_doc,"3","0");			cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;			frn.set("k_docto", cadena);		}					fun PadLeft(pText,pRelleno,pCaracterRelleno) {			var Resultado;			var pos_ini = pText;			var nReg = strlen(pText);			for (var cont = nReg; cont < pRelleno; cont++) {				Resultado = pCaracterRelleno & Resultado;			}			Resultado = Resultado & pText;                			return Resultado;		}		fun ConfiguraControlesOff() {							frn.setAtt("textFolio", "visible", "N");			frn.setAtt("k_folio", "available", "N");			frn.setAtt("k_folio", "visible", "N");							frn.setAtt("k_fecha", "available", "N");			frn.setAtt("k_hora", "available", "N");			frn.setAtt("k_clave", "available", "N");			frn.setAtt("k_refer", "available", "N");						// Added 20240131 by JMM 			frn.setAtt("k_plazo", "visible", "Y");			frn.setAtt("k_vence", "visible", "Y");			frn.setAtt("k_cond", "visible", "Y");			frn.setAtt("k_plazo", "available", "N");			frn.setAtt("k_vence", "available", "N");			frn.setAtt("k_cond", "available", "N");							frn.setAtt("Imprimir", "visible", "N");			frn.setAtt("Cancelar", "visible", "N");			frn.setAtt("Aceptar", "visible", "N");			frn.setAtt("BuscarFol", "visible", "N");			frn.setAtt("Buscar", "available", "N");							//Added by JMM 20240229			/*frn.setAtt("k_fecha", "available", "N");*/			frn.setAtt("Buscar", "visible", "N");			frn.setAtt("Buscar", "available", "N");						// Added by JMM 20240229			frn.setAtt("textProvPago", "visible", "Y");			frn.setAtt("k_clave_pago", "visible", "Y");			frn.setAtt("k_nombreprov_pago", "visible", "Y");			frn.setAtt("k_clave_pago", "available", "N");			frn.setAtt("k_nombreprov_pago", "available", "N");		}					fun ConfiguraControlesOpcion() {						ConfiguraControlesOff();			if(tip_ope &= "A"){ //Alta				//frn.setAtt("k_fecha", "available", "Y");				frn.setAtt("k_fecha", "available", "N"); // 20240112				//frn.setAtt("k_hora", "available", "Y");				frn.setAtt("k_hora", "available", "Y"); // 20240112								//frn.setAtt("k_clave", "available", "Y");				frn.setAtt("k_clave", "available", "N"); // 20240111								frn.setAtt("k_refer", "available", "N");				frn.setAtt("k_mov", "modify", "Y", "k_tipo_orden");				frn.setAtt("k_mov", "available", "Y", "k_tipo_orden");				frn.setAtt("k_mov", "modify", "Y", "k_descriptot");				frn.setAtt("k_mov", "modify", "Y", "k_costo");				frn.setAtt("k_mov", "available", "Y", "k_num_orden");				frn.setAtt("k_mov", "available", "Y", "k_punto");				frn.setAtt("k_mov", "available", "Y", "k_descriptot");				frn.setAtt("k_mov", "available", "Y", "k_costo");				frn.setAtt("k_mov", "available", "Y", "k_precio");				frn.setAtt("k_coment","modify", "Y");				frn.setAtt("k_coment","available", "Y");				frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "Y"/*"N"*/);				frn.setAtt("Aceptar", "visible", "Y");									frn.setAtt("BuscarFol", "visible", "N");				frn.setAtt("Buscar", "available", "Y");									// Added by JMM 20240229				frn.setAtt("Buscar", "visible", "Y");				frn.setAtt("Buscar", "available", "Y");				// Added by JMM 20240229				if ( paramProvPago /*&= "P"*/ > 0 ) {									frn.setAtt("k_clave_pago", "available", "Y");				} else {					frn.setAtt("k_clave_pago", "available", "N");				}							} else {				if(tip_ope &= "B"){ //Baja									frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");					frn.setAtt("k_fecha", "available", "Y");					frn.setAtt("k_hora", "available", "Y");					frn.setAtt("k_mov", "modify", "N", "k_descriptot");					frn.setAtt("k_mov", "modify", "N", "k_costo");					frn.setAtt("k_mov", "available", "N", "k_tipo_orden");					frn.setAtt("k_mov", "available", "N", "k_num_orden");					frn.setAtt("k_mov", "available", "N", "k_punto");					frn.setAtt("k_mov", "available", "N", "k_descriptot");					frn.setAtt("k_mov", "available", "N", "k_costo");					frn.setAtt("k_mov", "available", "N", "k_precio");					frn.setAtt("k_coment","modify", "N");					frn.setAtt("k_coment","available", "Y");															frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "N");					frn.setAtt("Aceptar", "visible", "Y");												frn.setAtt("BuscarFol", "visible", "Y");					frn.setAtt("Buscar", "available", "N");										frn.setAtt("k_clave_pago", "available", "N"); // Added by JMM, 20240229 									} else {					if(tip_ope &= "C"){ //Consulta						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("k_fecha", "available", "N");						frn.setAtt("k_hora", "available", "N");											frn.setAtt("k_mov", "available", "N", "k_tipo_orden");						frn.setAtt("k_mov", "available", "N", "k_num_orden");						frn.setAtt("k_mov", "available", "N", "k_punto");						frn.setAtt("k_mov", "available", "N", "k_descriptot");						frn.setAtt("k_mov", "available", "N", "k_costo");						frn.setAtt("k_mov", "available", "N", "k_precio");						frn.setAtt("k_coment","modify", "N");						frn.setAtt("k_coment","available", "Y");						frn.setAtt("Imprimir", "visible", "Y");						frn.setAtt("Cancelar", "visible", "N");						frn.setAtt("Aceptar", "visible", "N");						frn.setAtt("BuscarFol", "visible", "Y");						frn.setAtt("Buscar", "available", "N");												frn.setAtt("k_clave_pago", "available", "N"); // Added by JMM, 20240229 											} else {						frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");						frn.setAtt("k_fecha", "available", "Y");						frn.setAtt("k_hora", "available", "Y");													frn.setAtt("k_mov", "modify", "Y", "k_descriptot");						frn.setAtt("k_mov", "modify", "Y", "k_costo");												frn.setAtt("k_clave_pago", "available", "N"); // Added by JMM, 20240229 					}					}			}		}					fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    			1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 			2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 			3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			// var tip_ope; 			var tip_oper;			if(iModo==0)				page=pag; 			else if(iModo==2&&(strlen(par0)>0)){				//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       				if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 				if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;			}			else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     		}								fun LimpiaDatosProv() {			frn.set("k_rfc", ""); // Commented 20240111 , Descommented 20240131			frn.set("k_nombreprov", "");			frn.set("k_calleprov", "");			frn.set("k_coloniaprov", "");			frn.set("k_poblacionprov", "");			frn.set("k_cpprov", "");			LimpiaDatosDoc();			LimpiaTotalesDoc();			// Commented 20240111 ... Estos datos se gestionan al cargar UUID 			/*					frn.set("k_refer", "");			frn.set("k_fecha_exp", "");			*/		}					fun LimpiaDatosDoc() {			frn.set("k_mov", "");			frn.set("k_plazo", "");			frn.set("k_vence", "");			frn.set("k_cond", "");			frn.set("k_coment", "");		}					fun LimpiaTotalesDoc() {			frn.set("k_subtotal", "");			frn.set("k_iva", "");			frn.set("k_porciva", ""); // Added by JMM 20240229			frn.set("k_monto", "");			frn.set("k_sumtras",""); // Added by JMM 20240626 			frn.set("k_sumrets",""); // Added by JMM 20240626 		}					fun LimpiaEncabezado() {			frn.set("k_folio", "");			frn.set("k_docto", "");			frn.set("k_fecha", "");			frn.set("k_hora", "");			LimpiaDatosProv();			frn.set("k_clave", "");			//Added by JMM, 20240229			frn.set("k_clave_pago", "");			frn.set("k_nombreprov_pago", "");		}				fun LimpiaTipOrden(){			frn.setX("","k_mov",-1,"k_desc_tipo");				frn.setX("","k_mov",-1,"k_num_orden");				LimpiaNumOrden();		}					fun LimpiaNumOrden(){			frn.setX("","k_mov",-1,"k_punto");			LimpiaPunto();		}		fun LimpiaPunto(){			frn.setX("","k_mov",-1,"k_desc_punto");			frn.setX("","k_mov",-1,"k_descriptot");			frn.setX("","k_mov",-1,"k_costo");			frn.setX("","k_mov",-1,"k_precio");		}		fun CambiaSucursal() {				// Added by JMM 20240229 ... Check Security PARAM for User to use PROV PAGO			sucursal_id = frn.get("k_sucn",-1,1);			paramProvPago = ProvPago_Sec(usuario);						LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();								limpiar_datos_uuid();	// Added by JMM 20240119		}					fun CambiaTipo() {			LimpiaEncabezado();			frn.set("k_fecha",sys.date());			frn.set("k_hora",sys.time());				ArmarRefDocto();						}		//------------------------Implementing UUID, by JMM 20240111----------------------------				fun BuscarProveedor(/*imodo*/){			var xmlProd;						// Added 20240119			var NewProv, ST_FUN, continua, resultado, mensaje, xmlAlta;			// Added by JMM 20240229 			var vProvPago;							sucursal_id = frn.get("k_sucn",-1,1);						// UPD 20240111			//proveedor_id = frn.get("k_clave");			proveedor_id = frn.get("k_rfc");						LimpiaDatosProv();			// 20240111 ... Los Ejecuta en : LimpiaDatosProv()			/*			LimpiaDatosDoc();			LimpiaTotalesDoc();			*/			//Added 20240131			frn.set("k_rfc", proveedor_id);						if (strlen(frn.get("k_rfc"/*"k_clave"*/)) == 0) {				return;			}						// Commented 20240111 			/*			if (strlen(frn.get("k_refer")) > 0) {				refer_id = frn.get("k_refer");			} else {				frn.set("k_fecha_exp", "");			}			*/							cmdQuery = "select c2 as k_clave, /*c10 as k_rfc,*/ c3 as k_nombreprov, c4 as k_calleprov, c5 as k_coloniaprov, c6 as k_poblacionprov, c27 as k_cpprov, c16 as k_plazo " &									"from keplersc.kdxd where keplersc.full_replace(c10,'-','') /*c2*/='" & proveedor_id & "'" ;			//and c1 ='" & sucursal_id & "' ... TO DO : NO VIENE DATO DE LA SUCURSAL A NIVEL DEL PROVEEDOR AUNQUE ESTA EL CAMPO ...			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.BuscaProveedor()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){							// Addapted 20240111				//frn.setPos("k_clave");				frn.set("k_clave","No Existe ...");  							if (/*imodo == 1*/ strlen(NewProvId) > 0 ) { 									frn.message("El proveedor no existe","Error","Aceptar");					return;									} else {									frn.message("El Proveedor No existe ..." & "|" & " " & 					"|" & " " & "Nombre : " & nombre_uuid &					"|" & " " & "R.F.C. : " & rfc_uuid & 					"|" & " " & "Fecha Docto. Seleccionado : " & fecha_uuid & 					"|" & " " & "Total Docto. Seleccionado : " & total_uuid & 					"|" & " " & "|" & " " & 					"Puede crearse Automaticamente, se recomienda complementar los Datos.", "Info !!!","Aceptar");					continua = frn.message("¿Continuar con el Alta del Proveedor?","Atencion !!!",2);					if (continua == 0){										return;										}	else {										setXml(xmlAlta,"sucursal",sucursal_id);						setXml(xmlAlta,"nombre",nombre_uuid);						setXml(xmlAlta,"rfc",rfc_uuid);											frn.lib("libGeneral.kpl","FileSave",xmlAlta,fileSavePath & "\XmlAltaProv_To_Send");											cmdQuery="SELECT * FROM keplersc.uuid_tools_alta_proveedor('<document>" & getXmlStr(xmlAlta,"EOF:13_10") & "</document>')";						rstXml(cuboQuery);											cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"srvtalltotscrud.Alta_Proveedor");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlAltaProv_Result");											resultado = getXml(cuboQuery,"resultado");						mensaje = getXml(cuboQuery,"mensaje");											ok = getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok) {							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;							}						if(resultado &= "1") {							NewProv = mensaje;							//frn.dialog("cat_crud_proveedores","Modificar"/*accion*/, NewProv/*param1*/,"UUID" /*param2*/);							//prov_data_upd(NewProv);							return NewProv/*1*/;						} else {							// Added 20240130 (else section)							frn.set("k_clave","");							frn.message(mensaje,"Error","Aceptar");							return;						}										} // End ... If ( continua )								} // End ... If ( imodo )							}						//Plazo();				rstXml(xmlProd);			frn.lib("libGeneral.kpl","FileSave",cuboQuery/*xmlAlta*/,fileSavePath & "\XmlAltaProv_To_Get");			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");			frn.setX(xmlProd);						// Added by JMM 20240229 			vProvPago = trim(frn.get("k_clave_pago"));			if ( strlen(trim(frn.get("k_clave"))) > 0 ) {				if ( strlen( vProvPago ) == 0 ) {					frn.set("k_clave_pago", frn.get("k_clave"));					BuscarProvPago();				} else {					if ( CheckProvPago() == 0 ) {						frn.set("k_clave_pago", frn.get("k_clave"));						BuscarProvPago();						}				}			}						Plazo(); // Moved 20240131				}						// New Func 20240120 by JMM		fun prov_data_upd(Prov){			frn.dialog("cat_crud_proveedores","Modificar"/*accion*/, Prov/*IdProv*/,"UUID" /*param2 UUIDCtrl*/,"BuscarProveedor()"/*paramRutina*/);		}								// New Func 20240111 by JMM			fun limpiar_datos_uuid() {			frn.set("k_clave","");			frn.set("k_rfc","");			frn.set("k_refer","");						frn.set("k_uuid_serie","");			frn.set("k_uuid_folio","");			frn.set("k_uuid_monto","");			frn.set("k_uuid_fecha","");						// Added 20240120			NewProvId = "";			LimpiaDatosProv();						//Added 20240229			frn.set("k_uuid_impuesto","");						//Added 20240626			frn.set("k_uuid_retisr","");				frn.set("k_uuid_retiva","");						//Added 20240328 			str_uuid = "";				rfc_uuid = "";				fecha_uuid = ""; 			total_uuid = "";								nombre_uuid = "";			regimen_uuid = "";			folio_uuid = "";			serie_uuid = "";			impuesto_uuid = "";						//Added by JMM 20240626			retisr_uuid = "";			retiva_uuid = "";						//Added 20240229			if ( paramProvPago /*&= "P"*/ > 0 ) {				if ( tip_ope &= "A" ) {						frn.setAtt("k_clave_pago", "available", "Y");				} else {					frn.setAtt("k_clave_pago", "available", "N");				}				if ( CheckProvPago() == 0 ) {					frn.set("k_clave_pago","");					frn.set("k_nombreprov_pago","");				}			} else {				frn.setAtt("k_clave_pago", "available", "N");				frn.set("k_clave_pago","");				frn.set("k_nombreprov_pago","");			}		}								// New Func 20240115 by JMM		fun BuscarUUID(referencia){			var xmlProd, respfunc;											sucursal_id = frn.get("k_sucn",-1,1);			respfunc = 1;														if (strlen(str_uuid) == 0) {				frn.message("No se tiene una Referencia [UUID] para validarse ...","Error","Aceptar");				return;			}						/*			cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &				"and c2 = '" & gen_doc & "' and c3 = '" & nat_doc & "' and c4 = " & gpo_doc & " and c5 = " & tip_doc & " and c11 = '" & referencia & "'";			*/						// Query updated at { C x P } validation, 20240201 			cmdQuery = "select c11 as referencia from keplersc.kdm1 where c1 = '" & sucursal_id & "' " &				"and c2 = 'X' and c3 = 'A' and c11 = '" & referencia & "' and c43 <> 'C'";	 						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.BuscaFactura()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			/*			if ( nXml(cuboQuery) == 0 ) {				respfunc = 0;			}			*/			respfunc = nXml(cuboQuery);						return respfunc;									} // End Fun - BuscarUUID				// New Func 20240112 by JMM		fun Validar_Fecha_UUID() {			var fech_hoy, fech_ini, fech_limit, strFecha, strTmp, fech_lim_ini, fech_lim_fin, fech_buff;			var aj_dias, respfunc, gapDias,superUsuario,mensajeAdv,mensajeProceso;					respfunc = 0;			//VCSS 03/07/2024 Obtener usuario con nivel para poder hacer operaciones sin validaciones			cmdQuery="SELECT count(*) as superusuario from keplersc.param_opc_usr_sec where sucursal = '" & sucursal_id & "' and opcion = 'Operaciones Sin Validacion GAP' and usuario='" & usuario & "'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlSuperUsuario");								ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return respfunc;			}			superUsuario = getXmlAtt(cuboQuery,"r0","superusuario");			// { GAP Dias Fecha Gastos }			cmdQuery="SELECT (coalesce(valor,'0')::numeric) ParamValor from keplersc.param_oper where sucursal = '" & sucursal_id & "' and parametro = 'GAP Dias Fecha Gastos'";			rstXml(cuboQuery);							cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ValidarDatos()");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_GAPDias");								ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return respfunc;			}			if (nXml(cuboQuery) > 0) {				gapDias = getXmlAtt(cuboQuery,"r0","paramvalor");			} else {				frn.message("Hubo problemas para obtener los Parametros [GAP Dias Fecha Gastos] ...","Error","Aceptar");				return respfunc;			}							fech_hoy = sys.date();				strFecha = fnDate("year", fech_hoy) & "/" /*"-"*/;			strTmp = fnDate("month", fech_hoy);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "/" /*"-"*/ & "01";								fech_ini = strFecha;								//fech_hoy = "2024/12/05";  // For testing calc fech 			strTmp = fnDate("month", fech_hoy);			if ( strTmp == 12 ) {				strFecha = fnDate("year", fech_hoy) & "/12/31";								fech_limit = strFecha;							} else {				strFecha = fnDate("year", fech_hoy) & "/";				strTmp = fnDate("month", fech_hoy) + 1;				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "/" & "01";								fech_limit = fnDate("add",strFecha,-1);							} 						//fech_limit = fnDate("add",fech_limit,gapDias);  // Not Apply 			fech_limit = formato_fecha(fech_limit);									if ( gapDias > 0 ) { 				aj_dias = (gapDias /*+ 1*/) * (-1); 			} else {				aj_dias = gapDias /*- 1*/;			}			if ( gapDias == 0 ) {				fech_buff = fech_hoy;			} else {				fech_buff = fnDate("add", fech_hoy, aj_dias);			}			strTmp = fnDate("month", fech_buff);			if ( strTmp == 12 ) {				strFecha = fnDate("year", fech_buff) & "/12/31";								fech_lim_fin = strFecha;							} else {				strFecha = fnDate("year", fech_buff) & "/";				strTmp = fnDate("month", fech_buff) + 1;				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "/" & "01";								fech_lim_fin = fnDate("add",strFecha,-1);							} 								fech_lim_fin = formato_fecha(fech_lim_fin);										strFecha = fnDate("year", fech_lim_fin) & "/";			strTmp = fnDate("month", fech_lim_fin);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "/" /*"-"*/ & "01";						fech_lim_ini = strFecha;			fech_lim_ini = formato_fecha(fech_lim_ini);									if ( strlen( frn.get("k_uuid_fecha") ) == 0 ) {				frn.message("No hay Fecha UUID de Referencia para validar ...","Error","Aceptar");				return respfunc;			} 						strFecha = frn.get("k_uuid_fecha");			strFecha = formato_fecha(strFecha);						//VCSS	INI Validaciones para usuarios normales (no superUsuario)			if (superUsuario != "1"){				if ( fnDate("cmp", strFecha, fech_hoy) > 0 /*strFecha > fech_hoy*/ ) {					mensajeError="La Fecha del UUID, es mayor al dia de hoy ..." & "|" & " " & "|" & " " & strFecha;					mensajeAdv=mensajeAdv & "; " & mensajeError;					frn.message(mensajeError ,"Error","Aceptar");					return respfunc;				} 							if ( fnDate("cmp", strFecha, fech_limit) > 0 /*strFecha > fech_limit*/ ) {					mensajeError = "La Fecha del UUID, fuera de Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;					mensajeAdv=mensajeAdv & "; " & mensajeError;					frn.message(mensajeError ,"Error","Aceptar");					return respfunc;				} 							if ( fnDate("cmp", strFecha, fech_ini) < 0 /*strFecha < fech_ini*/ ) {					if ( fnDate("cmp", strFecha, fech_lim_ini) < 0 /*strFecha < fech_lim_ini*/ ) {						mensajeError = "La Fecha del UUID, es menor al Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;						mensajeAdv=mensajeAdv & "; " & mensajeError;						frn.message(mensajeError ,"Error","Aceptar");						return respfunc;					} else {						if ( fnDate("cmp", strFecha, fech_lim_fin) > 0 /*strFecha > fech_lim_fin*/ ) {						mensajeError = "La Fecha del UUID, fuera del Periodo Vigente ..." & "|" & " " & "|" & " " & strFecha;						mensajeAdv=mensajeAdv & "; " & mensajeError;						frn.message(mensajeError ,"Error","Aceptar");						return respfunc;						}					}				}			} 			//VCSS 17/06/2024 INI Evaluacion de fecha de transaccion, las transacciones que se realizan dentro de los primeros 			//dias del mes dentro del gap y la fecha del xml es del mes anterior o anteriores, 			//se registran el día último del mes del xml			var fechaMovto,fechaXml,fechaRefer,mesesDif; 			fechaXml= frn.get("k_uuid_fecha");			fechaXml= formato_fecha(fechaXml);										var diaMovto=fnDate("day", fech_hoy);			var mesMovto=fnDate("month",fechaXml);			//Calcular dierencia en meses del mes actual y del xml				strTmp=fnDate("month",fechaXml);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}										fechaXml=fnDate("year",fechaXml) & "/" & strTmp & "/" & "01";						strTmp=fnDate("month",fech_hoy);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}							fech_hoy=fnDate("year",fech_hoy) & "/" & strTmp & "/" & "01";			//Validar si xml es del mismo mes			if (fnDate("cmp",fechaXml,fech_hoy) == 0){ //Mismo mes				mesesDif=0;			}else{				fech_hoy=fnDate("add",fech_hoy,-1);				fech_hoy= formato_fecha(fech_hoy);				strTmp=fnDate("month",fech_hoy);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}								fech_hoy=fnDate("year",fech_hoy) & "/" & strTmp & "/" & "01";												if (fnDate("cmp",fechaXml,fech_hoy) == 0){					mesesDif=1;				}else{					mesesDif=2;				}			}							fechaMovto= frn.get("k_uuid_fecha");			if(mesesDif==2 && superUsuario==0){				mensajeError = "La Fecha del UUID, " & fechaMovto & " está fuera del Periodo Vigente.";				frn.message(mensajeError ,"Error","Aceptar");				return respfunc;			}			if (mesesDif != 0){				fechaMovto= frn.get("k_uuid_fecha");				strTmp=fnDate("month",fechaMovto);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}											fechaMovto=fnDate("year",fechaMovto) & "/" & strTmp & "/" & "31";				fechaMovto=formato_fecha(fechaMovto);				frn.set("k_fecha",fechaMovto);				frn.message("Los movimientos de meses anteriores se registrarán al último día del mismo mes.","Mensaje","Aceptar");			}			//VCSS 17/06/2024 FIN Evaluacion de fecha de transaccion...			respfunc = 1;			return respfunc;				} // End Fun - Validar_Fecha_UUID		// New Func 20240112 by JMM		fun formato_fecha(fech) {			var strFech, tmpData;						strFech = fnDate("year", fech) & "/";			tmpData = fnDate("month", fech);			if(strlen(tmpData) == 1){				tmpData = "0" & tmpData;			}			strFech = strFech & tmpData & "/";			tmpData = fnDate("day", fech);			if(strlen(tmpData) == 1){				tmpData = "0" & tmpData;			}			strFech = strFech & tmpData;						return strFech;			} // end fun - formato_fecha		fun ObtenerFactura(){			var nCampos, uuid="";			//Regresara la funcion UUID cadena con UUID, rfc, fecha, total			// Added 20240119 by JMM			var NewProv;						limpiar_datos_uuid();						uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID","k_refer", 0,"0");			// Replaced with new function, 20240111 			//uuid=frn.lib("libGeneral.kpl","funcionGetAttXMLUUID_Extended","k_refer", 0,"0");						nCampos = strSplit(uuid,"|",-1);			if (nCampos > 1) {					str_uuid = strSplit(uuid,"|",0);		  //UUID					rfc_uuid = strSplit(uuid,"|",1);		  //rfc					fecha_uuid = strSplit(uuid,"|",2);	  //fecha					total_uuid = strSplit(uuid,"|",3);	  //monto de la factura										// Added 20240111 by JMM					nombre_uuid = strSplit(uuid,"|",5);	  //nombre					regimen_uuid = strSplit(uuid,"|",6);  //regimen					folio_uuid = strSplit(uuid,"|",7);	  //folio					serie_uuid = strSplit(uuid,"|",8);	  //serie										// Added 20240224 by JMM					impuesto_uuid = strSplit(uuid,"|",9); //impuesto trasladado total					totalimptostras_uuid= strSplit(uuid,"|",9); //impuesto trasladado total															//Added by JMM 20240626					retisr_uuid = strSplit(uuid,"|",10); //retencion isr					retiva_uuid = strSplit(uuid,"|",11); //retencion iva					//VCSS 03 Jul 2025					trasiva_uuid = strSplit(uuid,"|",12); //trasladado iva					trasieps_uuid = strSplit(uuid,"|",13); //trasladado ieps										totalimptosret_uuid = strSplit(uuid,"|",14); //trasladado iva					impuestosLocalRet_uuid= strSplit(uuid,"|",15); //Local Retenido					impuestosLocalTras_uuid= strSplit(uuid,"|",16); //Local trasladdo										subtotal_uuid= strSplit(uuid,"|",17); //subtotal factura															//			var retisr_uuid, retiva_uuid;//			var trasiva_uuid, trasieps_uuid, totalimptosret_uuid, totalimptostras_uuid, subtotal_uuid;//			var valorSel = (UUID &"|"& Rfc &"|"& UuidFecha &"|"& Total &"|"& Rfc_receptor &"|"& Nombre &"|"& Regimen &"|"& Folio &"|"& Serie &"|"& ImpuestosTras &"|"& IsrRet &"|"& IvaRet &"|"& IvaTras &"|"& IepsTras &"|"& ImpuestosRet);												// Conditions Added 20240111  by JMM					if ( strlen(/*folio_uuid*/nombre_uuid) == 0 || strlen(rfc_uuid) == 0 || strlen(str_uuid) == 0 || strlen(fecha_uuid) == 0 || strlen(total_uuid) == 0 ) {											//frn.set("k_refer","");						frn.message("No se pudieron obtener todos los datos mandatorios del UUID.","Error","Aceptar");											} else {											frn.set("k_refer",str_uuid);						frn.set("k_rfc",rfc_uuid);												if ( BuscarUUID(str_uuid) > 0 ) {							//frn.set("k_rfc","");							frn.set("k_clave","");							frn.message("Este Documento [UUID] ya ha sido Asociado previamente ...","Error","Aceptar");							return;						} 													frn.set("k_uuid_fecha",mid(fecha_uuid,0,10));						if ( Validar_Fecha_UUID() == 0 ) { 							//frn.set("k_rfc","");							frn.set("k_clave","");							return;						}												NewProv = "";						NewProv = BuscarProveedor();						if (strlen(NewProv) > 0/*== 1*/) {							//BuscarProveedor(NewProv);							NewProvId = NewProv;							frn.set("k_clave",NewProvId);						} else {							NewProvId = "";						}												if ( strlen(frn.get("k_clave")) > 0 && frn.get("k_clave") &! strFormat("ucase","No Existe ...") ) {														// Validations Moved UP by JMM 20240119 ( BuscarUUID, Validar_Fecha_UUID )																			frn.set("k_uuid_serie",serie_uuid);							frn.set("k_uuid_folio",folio_uuid);							frn.set("k_uuid_subtotal",subtotal_uuid);							frn.set("k_uuid_iva_trasladado",trasiva_uuid);									frn.set("k_uuid_ieps_trasladado",trasieps_uuid);							frn.set("k_uuid_total_trasladado",totalimptostras_uuid);								// Added 20240626 by JMM							frn.set("k_uuid_retiva",retiva_uuid);							frn.set("k_uuid_retisr",retisr_uuid);							frn.set("k_uuid_total_retenciones",totalimptosret_uuid);														frn.set("k_uuid_impto_adicional_A",impuestosLocalTras_uuid);							frn.set("k_uuid_impto_adicional_B",impuestosLocalRet_uuid);							frn.set("k_uuid_monto",total_uuid);							frn.set("k_uuid_fecha",mid(fecha_uuid,0,10));											// Added 20240229 by JMM							frn.set("k_uuid_impuesto",impuesto_uuid);														//Added 20240229 by JMM							frn.set("k_iva",impuesto_uuid);														var sumtras = trasiva_uuid + trasieps_uuid + impuestosLocalTras_uuid;							frn.set("k_sumtras",sumtras);															// Added 20240626 by JMM							var sumrets = retisr_uuid + retiva_uuid+impuestosLocalRet_uuid;							frn.set("k_sumrets",sumrets);						}					}			} else{				//frn.set("k_refer","");				frn.message("Faltan datos del UUID ...","Error","Aceptar");					}		}	// End Fun - Obtener Factura		//New Fuc 20240120 by JMM		fun ProcesarFactura() {			var uuid_importes_validos;			ObtenerFactura();			uuid_importes_validos=ValidarTotalesUUID();			if(uuid_importes_validos &="N"){				frn.message("Importe de factura descuadrado.","Error","Aceptar");			}									if ( strlen(NewProvId) > 0 ) {				prov_data_upd(NewProvId);			}						// Se elimina esta parte porque l ejecuta antes de abrir el dialogo ...			// /*			if ( strlen(NewProvId) > 0 ) {				BuscarProveedor();			}			// */					} // End Fun - ProcesarFactura 						//Function Added by JMM, 202040229  		fun Get_Cat(imodo) {            				var suc_id, dato_id;				var win_tit, field_key, field_col, cmdQuery;								sucursal_id = frn.get("k_sucn",-1,1);	            				if ( imodo <= 0 || imodo > /*2*/ 1 /*7*/ ) {					// No es opcion de CAT Valida ...					return;				}								win_tit = "";				field_key = "";				field_col = "";				cmdQuery = "";				/*				if (imodo == 1) {					win_tit = "CAT Vehiculos";					field_key = "clave";					field_col = "modelo";					cmdQuery = "select C1 as clave, C2 as descripción from keplersc.kdiv";				}				*/								/*				if (imodo == 2) {					win_tit = "CAT Inventarios";					field_key = "clave";					field_col = "invent";										dato_id = "";					cmdQuery = "select C8 as campo from keplersc.kdiv where c1 = '" & frn.get("k_mov",-1,"modelo") & "'";					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comaltasigcrud.Get_Cat_kdiv_c8()");					//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\Get_Cat_Get_Cat_kdiv_c8()");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					dato_id = getXmlAtt(cuboQuery,"r0", "campo");					cmdQuery = "select d.C1 as clave, d.C2 as descripción from keplersc.kddinv d where d.c7 = '" & dato_id & "'";				}				*/				       				if (imodo == 1) {									//Added by JMM 20240516					if ( strlen( frn.get("k_clave") ) == 0 || strlen( frn.get("k_rfc") ) == 0 ) {						frn.message("Para Modificar el Proveedor de Pago primero se debe tener un Proveedor de Documento valido ...", "Error","Aceptar");						return;					}									win_tit = "CAT Proveedores de Pago";					field_key = "clave";					field_col = "k_clave_pago";					cmdQuery = "select C2 as clave, C3 as nombre from keplersc.kdxd where pagador = 1 or c2 = '" & frn.get("k_clave") & "' order by C3";				}			         	         				if (imodo == 2) {					win_tit = "CAT Proveedores";					field_key = "clave";					field_col = "k_clave";					cmdQuery = "select C2 as clave, C3 as nombre from keplersc.kdxd order by C3";				}					            if ( strlen(win_tit) > 0 && strlen(field_key) > 0 && strlen(field_col) > 0 && strlen(cmdQuery) > 0 /*&& strlen(objeto) > 0*/ ) {                                        					//frn.dialog("genlistasel", win_tit,cmdQuery, field_key, "k_mov",-1, field_col,"S");  * * *  USADO EN GRIDS					//frn.dialog("genlistasel","Catálogo de Proveedores",cmdQuery,"k_claveprov","k_clave","0","","N");  * * *  USADO EN CTRLS SIMPLES										frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");				}						} /*END Func Get_Cat()*/		//Function Added by JMM, 202040229 		fun BuscarProvPago(){			var xmlProd;											sucursal_id = frn.get("k_sucn",-1,1);			proveedor_pago_id = frn.get("k_clave_pago");			proveedor_pago_id = trim(proveedor_pago_id);					if (strlen(/*frn.get("k_clave_pago")*/ proveedor_pago_id ) == 0) {				frn.set("k_nombreprov_pago","");				return;			}							cmdQuery = "select c3 as k_nombreprov_pagos " &									"from keplersc.kdxd where  c2 = '" & proveedor_pago_id & "' ";								cmdQuery = cmdQuery & "and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')";								rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscarProvPago()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				frn.set("k_nombreprov_pago","ERROR EN BUSQUEDA ...");				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.set("k_nombreprov_pago","NO EXISTE ...");				frn.setPos("k_clave_pago");				frn.message("El Proveedor de Pago No existe ...","Error","Aceptar");				return;				} 						frn.set("k_nombreprov_pago", getXmlAtt(cuboQuery,"r0", "k_nombreprov_pagos") );					} // End : Fun BuscarProvPago()				/*		// Added by JMM, 20240229		fun Plazo(){ //Calcula la fecha de pago, y las condiciones de pago en base al plazo			frn.set("k_vence",fnDate("addC",frn.get("k_fecha"),frn.get("k_plazo")));//Suma días comerciales			var cond=frn.get("k_plazo") & " dias fecha factura";			if (frn.get("k_plazo")==0) cond="Pago de contado";				frn.set("k_cond",cond);  		}		*/				/*		// Added by JMM, 20240229		fun Change_Mode() {			limpiar_datos_uuid();			if ( frn.get("chk_pc") == 1 ) { 				//frn.message("Check Encendido ...","Info !!!","Aceptar");				frn.setAtt("Buscar", "available", "N");				frn.setAtt("Buscar", "visible", "N");				frn.setAtt("k_refer", "available", "Y");				frn.setAtt("k_clave", "available", "Y");			} else {				//frn.message("Check Apagado ...","Info !!!","Aceptar");				frn.setAtt("Buscar", "available", "Y");				frn.setAtt("Buscar", "visible", "Y");				frn.setAtt("k_refer", "available", "N");				frn.setAtt("k_clave", "available", "N");			}			return;			}		*/				// New Func 20240229 by JMM		fun ProvPago_Sec(referencia){			var respfunc;											sucursal_id = frn.get("k_sucn",-1,1);			respfunc = 0; //Default es sin Permiso 						frn.setAtt("k_clave_pago", "available", "N");														if (strlen(referencia) == 0) {				return;			}						cmdQuery = "select * from keplersc.param_opc_usr_sec where sucursal = '" & sucursal_id & "' " & 				"and upper(opcion) = upper('Proveedor Pago') and upper(usuario) = upper('" & referencia & "')";						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.ProvPagoSec()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			/*			if ( nXml(cuboQuery) == 0 ) {				respfunc = 0;			}			*/			respfunc = nXml(cuboQuery);						if ( respfunc /*paramProvPago &= "P"*/ > 0 ) {								if ( tip_ope &= "A" ) {						frn.setAtt("k_clave_pago", "available", "Y");				} else {					frn.setAtt("k_clave_pago", "available", "N");				}			} else {				frn.setAtt("k_clave_pago", "available", "N");			}						return respfunc;									} // End Fun - ProvPago_Sec 						//Function Added by JMM, 202040229  		fun CheckProvPago(){			var respfunc;											sucursal_id = frn.get("k_sucn",-1,1);			proveedor_pago_id = frn.get("k_clave_pago");			proveedor_pago_id = trim(proveedor_pago_id);						respfunc = 0; 					if (strlen(/*frn.get("k_clave_pago")*/ proveedor_pago_id ) == 0) {				frn.set("k_nombreprov_pago","");				return;			}							cmdQuery = "select c3 as k_nombreprov_pagos " &									"from keplersc.kdxd where c2 = '" & proveedor_pago_id & "' ";								cmdQuery = cmdQuery & "and (pagador = 1 or c2 = '" & frn.get("k_clave") & "')";								rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.BuscarProvPago()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				frn.set("k_nombreprov_pago","ERROR EN BUSQUEDA ...");				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(nXml(cuboQuery) == 0){				frn.set("k_nombreprov_pago","NO EXISTE ...");				// Commented by JMM 20240227				//frn.setPos("k_clave_pago");				//frn.message("El Proveedor de Pago No existe ...","Error","Aceptar");				return;				} 						respfunc = 1;						// Commented by JMM 20240227			//frn.set("k_nombreprov_pago", getXmlAtt(cuboQuery,"r0", "k_nombreprov_pagos") );						return respfunc;					} // End : Fun CheckProvPago()						//------------------------End Implementing UUID, by JMM JMM 20240111-------------------------		fun ObtenerTipoOrden() {						proveedor_id = frn.get("k_clave");			sucursal_id = frn.get("k_sucn",-1,1);				LimpiaTipOrden();			CalculaTotales();			cmdQuery = "select C1 as tipo, C3 as descripcion from keplersc.kdmargen";													frn.dialog("genlistasel","Tipos de órden",cmdQuery,"tipo","k_mov",-1,"k_tipo_orden","S");        }		fun BuscarTipoOrden(){			var xmlProd;			tiporden=frn.get("k_mov", -1,"k_tipo_orden");			cmdQuery = "select C3 as descripcion from keplersc.kdmargen " &					"where c1='" & tiporden & "'";									rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvcargosvarios.BuscarTipoOrden()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cubo");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if((nXml(cuboQuery) == 0) && (tiporden &! "")) {				frn.setPos("k_mov", -1,"k_tipo_orden");				frn.message("El tipo de orden no existe","Error","Aceptar");				return;			} else{				desc_tipo = getXmlAtt(cuboQuery,"r0","descripcion");				frn.setX(desc_tipo,"k_mov", -1,"k_desc_tipo");					}					}		fun ObtenerNumOrden() {			proveedor_id = frn.get("k_clave");			sucursal_id = frn.get("k_sucn",-1,1);			tiporden = frn.get("k_mov",-1,"k_tipo_orden"); 			if (tiporden &= ""){				frn.message("Debe seleccionar tipo de órden","Error","Aceptar");				return;			}				LimpiaNumOrden();			CalculaTotales();			cmdQuery = "select C3 as orden, C4 as fecha, C6 as serie,C11 as cliente " &						"from keplersc.kdord " & 						"where c1 = '" & sucursal_id & "' and c2= '" & tiporden & "' and c7=0";//			frn.dialog("genlistasel","Ordenes",cmdQuery,"orden","k_mov",-1,"k_num_orden","S");			frn.dialog("genlistafiltrosel","Ordenes",cmdQuery,"orden","k_mov",-1, "k_num_orden","N");					}         		fun ObtenerPunto() {			proveedor_id = frn.get("k_clave");			sucursal_id = frn.get("k_sucn",-1,1);			tiporden = frn.get("k_mov",-1,"k_tipo_orden"); 			numorden = frn.get("k_mov",-1,"k_num_orden"); 			if (tiporden &= ""){				frn.setPos("k_mov",-1,"k_tipo_orden");				frn.message("Debe seleccionar tipo de órden","Error","Aceptar");				return;			}			if (numorden &= ""){				frn.setPos("k_mov",-1,"k_num_orden");				frn.message("Debe seleccionar número de órden","Error","Aceptar");				return;			}				LimpiaPunto();			CalculaTotales();			cmdQuery = "select c4 as punto, c9 as operario, c8 Descripcion " & 						"from keplersc.kdpun " &						"where c1= '" & sucursal_id & "' and c2= '" & tiporden & "' and c3 = '" & numorden & "'";			frn.dialog("genlistasel","Puntos de órden",cmdQuery,"punto","k_mov",-1,"k_punto","S");						}		fun ObtenerFolio() {			sucursal_id = frn.get("k_sucn",-1,1);			LimpiaEncabezado();			cmdQuery = "select c6 as folio, substring(cast(c9 as VARCHAR),1,10) as fecha, c10 as cve_cliente, " &						"c11 as factura, c16 as monto, c43 as estatus " &						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc" &						" order by c9 desc, c6 desc";							frn.dialog("genlistasel","Folios de TOTs",cmdQuery,"folio","k_folio","0","","S");					}		fun ValidaFolioCancelado(folio){		var statusfolio;			cmdQuery = "select c43 as status_folio " & 						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc & " and c6= '" & folio & "'";						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidaFolioCancelado()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ValidaFolioCancelado");			ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return "Error obteniendo Estatus"; //Return Adapted by JMM 20240710			}			statusfolio = getXmlAtt(cuboQuery,"r0","status_folio");			if (statusfolio &= "C"){	// C=Cerrado				resVal=0;				//frn.message("El TOTs se encuentra cancelado","Error","Aceptar"); //Commented by JMM 20240710				return "TOTs Cancelado";  //Return Adapted by JMM 20240710			} else { return ""; } //Else Added by JMM 2020710		}		fun CambiaFolio() {			frn.set("k_docto", "");			frn.set("k_fecha", "");			frn.set("k_hora", "");			// Commented by JMM 20240131			/*			LimpiaDatosProv();			frn.set("k_clave", "");			*/			// Added by JMM 20240131			limpiar_datos_uuid();			//frn.set("k_refer", ""); // Added & Commented 20240131 by JMM			//Added by JMM, 20240301			frn.set("k_clave_pago", "");			frn.set("k_nombreprov_pago", "");		}				fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				CambiaFolio();				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvtalltotscrud.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);			}		fun ValidaPuntoOrden(){			var tipopunto, status, cerradotots, desc_punto, punto_existe, totReg; 			punto = frn.get("k_mov",-1,"k_punto"); 			cmdQuery = "select c6 as tipunto, c7 as statuspunto, c8 as descpunto, c23 as statustots " & 						"from keplersc.kdpun " &						"where c1= '" & sucursal_id & "' and c2= '" & tiporden & "' and c3 = '" & numorden & 						"' and c4 = " & punto;						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidaPuntoOrden()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\validapuntoorden");			ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			desc_punto	= getXmlAtt(cuboQuery,"r0","descpunto");			frn.setX(desc_punto,"k_mov",-1,"k_desc_punto");			tipopunto = getXmlAtt(cuboQuery,"r0","tipunto");			status = getXmlAtt(cuboQuery,"r0","statuspunto");			cerradotots = getXmlAtt(cuboQuery,"r0","statustots");						//Validar que el TOT no este dado de alta con KDTOT			ValidaExisteTot();						//Validar que no ingresen el mismo punto			ValidaPuntoDuplicado();			if (cerradotots &= "C"){	// C=Cerrado				frn.setX("","k_mov",-1,"k_punto");				LimpiaPunto(); 				frn.message("No se pueden cargar horas a un punto que esta cerrado por TOTs","Error","Aceptar");				return;			}			if (tipopunto &= "N"){ //N=No autorizados				frn.setX("","k_mov",-1,"k_punto");				LimpiaPunto();				frn.message("No puede cargar TOTs a puntos No Autorizados","Error","Aceptar");				return;			} else { 				if(tipopunto &= "P"){	//P=Por presupuestar					frn.setX("","k_mov",-1,"k_punto");					LimpiaPunto();					frn.message("No puede cargar TOTs a puntos Por Presupuestar","Error","Aceptar");					return;				} else { 					if(tipopunto &= "L"){	//L=Sin cargo al cliente						frn.setX("","k_mov",-1,"k_punto");						LimpiaPunto();						frn.message("No puede cargar TOTs a puntos Sin Cargo al Cliente","Error","Aceptar");						return;					} else{						if(tipopunto &= "S"){	//S=Paquetes de serivicios							frn.setX("","k_mov",-1,"k_punto");							LimpiaPunto();							frn.message("No puede cargar TOTs a Paquetes de Servicios","Error","Aceptar");							return;						}						}				}					}			if(status &= "P"){	//P=Pendiente				frn.setX("","k_mov",-1,"k_punto");				LimpiaPunto();				frn.message("No puede cargar TOTs a puntos pendientes","Error","Aceptar");				return;			} else{				if(status &= "S"){	//S=Suspendido					frn.setX("","k_mov",-1,"k_punto");					LimpiaPunto();					frn.message("No puede cargar TOTs a puntos suspendidos","Error","Aceptar");					return;				}			}						}		fun ValidaExisteTot(){			var punto_existe;			cmdQuery = "select count(*) as totexiste " & 						"from keplersc.kdtot " &						"where c1= '" & sucursal_id & "' and c2= '" & tiporden & "' and c3 = '" & numorden & 						"' and c4 = " & punto & " and c5= '" & gen_doc & "' and c6= '" & nat_doc & "' and c7= " & gpo_doc & " and c8= " & tip_doc; 							rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidaPuntoOrden()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\validapuntoexiste");			ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			punto_existe = getXmlAtt(cuboQuery,"r0","totexiste");			if (punto_existe > 0){				frn.setX("","k_mov",-1,"k_tipo_orden");				LimpiaTipOrden();				frn.message("No puede dar de alta un TOT que ya esta registrado||Tipo orden: "&tiporden&" Orden: "&numorden&" Punto :"&punto,"Error","Aceptar");				return;			}		}				fun ValidaDescripcion(){			punto = frn.get("k_mov",-1,"k_punto"); 			if (punto &= ""){				frn.setPos("k_mov",-1,"k_punto");				frn.message("Debe seleccionar un punto","Error","Aceptar");				return;			}							if (frn.get("k_mov",-1,"k_descriptot") &= ""){				frn.setPos("k_mov",-1,"k_descriptot");				frn.message("La descripción del TOT no puede ir en blanco","Error","Aceptar");				return;				}			}         		fun ValidaBajaTot(){			var cerradotots, renglones; 			renglones = frn.N("k_mov")-1;						for (var i=0; i<renglones; i++) {				tiporden = frn.get("k_mov",i,"k_tipo_orden");				numorden = frn.get("k_mov",i,"k_num_orden");				punto = frn.get("k_mov",i,"k_punto"); 				cmdQuery = "select c23 as statustots " & 						"from keplersc.kdpun " &						"where c1= '" & sucursal_id & "' and c2= '" & tiporden & "' and c3 = '" & numorden & 						"' and c4 = '" & punto & "'";							rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.ValidaPuntoOrden()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\validapuntoorden");				ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				cerradotots = getXmlAtt(cuboQuery,"r0","statustots");				if (cerradotots &= "C"){	// C=Cerrado					resVal=0;					frn.message("Imposible borrar un TOT de un Punto que ya esta cerrado, Orden: "&tiporden& " " &numorden& " Punto: " &punto,"Error","Aceptar");					return;				}			}		} 		fun MostrarDatos(nFolio) {			var folio, refer, xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle;			var tmpStr, tmpXml, contDet, xmlCurDet, xmlDetConv;			var totRen,contRen;						// Guarda Datos para Busqueda 			frn.set("k_fecha_exp", "");			sucursal_id = frn.get("k_sucn",-1,1);							refer = frn.get("k_refer");			proveedor_id = frn.get("k_clave");			folio = nFolio;											setXml(xmlRequest,"document","sucursal_id",sucursal_id);			setXml(xmlRequest,"document","proveedor_id",proveedor_id);			setXml(xmlRequest,"document","referencia",refer);			setXml(xmlRequest,"document","genero",gen_doc);			setXml(xmlRequest,"document","naturaleza",nat_doc);			setXml(xmlRequest,"document","grupo",gpo_doc);			setXml(xmlRequest,"document","tipo",tip_doc);			setXml(xmlRequest,"document","folio",folio);				cmdQuery = "select * from keplersc.ser_tots_alta_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";			frn.lib("libGeneral.kpl","FileSave",xmlRequest, fileSavePath & "\srvtalltotscrud_xmlRequestFromK80TOPostgreSql_buscar");							rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\srvtalltotscrud_xml_GottenOfPostgreSql_buscar");							ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}								//Datos de encabezado			tmpStr=getXmlAtt(cuboQuery,"r0","encabezado");			rstXml(xmlEncabezado);			tmpStr=delScpScn(tmpStr);			setXmlStr(xmlEncabezado,tmpStr);			tmpXml = getXml(xmlEncabezado,"row");			frn.lib("libGeneral.kpl","FileSave",tmpXml , fileSavePath & "\srvtalltotscrud_xml_Converted_Enc_buscar");							frn.setX(tmpXml);			if(nXml(tmpXml) == 0){				frn.message("El TOTs : " & folio & ", No se encontró ...","Error","Aceptar");				return;							}			/*		VCSS, temporalmente	deshabolitado por desarrollo de impuestos			--Added by JMM 20240626 			var vretisr = frn.get("k_uuid_retisr");			var vretiva = frn.get("k_uuid_retiva");						var sumrets = vretisr + vretiva;			frn.set( "k_sumrets", sumrets );			var iva = frn.get( "k_iva");			var tot = frn.get( "k_monto");			var vsubt = tot - iva + sumrets;			frn.set( "k_subtotal", vsubt );						--Added by JMM 20240710			if ( tot == 0 ) {				vsubt = 0;				sumrets = 0;				frn.set( "k_subtotal", vsubt );				frn.set( "k_sumrets", sumrets );			}						--Added by JMM 20240710 			-var porc_iva; //Commented by JMM 20240710 ... var exists as global on this KPL			if ( vsubt > 0 ) {				porc_iva = (iva * 100) / vsubt;			} else {				porc_iva = 0;			}*/						porc_iva = 16;			frn.set("k_porciva", porc_iva);										//Datos Detalle			rstXml(xmlDetConv);			tmpStr=getXmlAtt(cuboQuery,"r0","detpartidas");			rstXml(xmlDetalle);			tmpStr=delScpScn(tmpStr);			setXmlStr(xmlDetalle,tmpStr);			contDet=nXml(xmlDetalle);			for(var y=0; y< contDet; y++){				rstXml(xmlCurDet);				xmlCurDet= getXmlX(xmlDetalle,3,y);										setXml(xmlDetConv,"k_mov","r"&y,xmlCurDet);			}				frn.setX(xmlDetConv);			if (tip_ope &= "B") {				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());				}			frn.lib("libGeneral.kpl","FileSave",xmlDetConv, fileSavePath & "\srvtalltotscrud_xml_Converted_Det_buscar");						// Added by JMM 20240301			var vProvPago = trim(frn.get("k_clave_pago"));			if ( strlen(trim(frn.get("k_clave"))) > 0 ) {				if ( strlen( vProvPago ) > 0 ) { BuscarProvPago(); }			}							//Ctas en kdm6/*			cmdQuery = "select " &  				"w6.c8 k_cuenta, w6.c9 k_cuentadesc, case when w6.c10='C' then w6.c11 else 0 end as k_cargo, " &				"case when w6.c10='A' then w6.c11 else 0 end as k_abono, referencia as k_referencia_uuid " &				"from keplersc.kdm6 w6 " & 				"where w6.c1='" & sucursal_id & "' and w6.c2='" & gen_doc &"' and w6.c3='" & nat_doc & "' and w6.c4=" & gpo_doc & " " & 				"and w6.c5=" & tip_doc & " and w6.c6='" & nFolio & "' ";*/						cmdQuery = "select c8,c9,c10,c11,c13 ,c12 ,ctopto,referencia from keplersc.kdm6 where c1='" & sucursal_id & "' and c2='" & gen_doc &"' and c3='" & nat_doc & "'";			cmdQuery = cmdQuery & " and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";											frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\Query_MostrarDatosM6");						rstXml(cuboQuery);			cuboQuery= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_transfer_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboQuery,"C:\Basura\cuboResultados_MostrarDatosM6");							ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}						totRen = nXml(cuboQuery);										for(contRen=0; contRen<totRen; contRen++){				frn.setX(getXmlAtt(cuboQuery, "r"&contRen ,"c8"),"k_mov_ctas",contRen,"k_cuenta");				frn.setX(getXmlAtt(cuboQuery, "r"&contRen ,"c9"),"k_mov_ctas",contRen,"k_cuentadesc");				var cargo_abono = getXmlAtt(cuboQuery, "r"&contRen ,"c10");				var monto = getXmlAtt(cuboQuery, "r"&contRen ,"c11");								if (cargo_abono &= "C"){					frn.setX(monto ,"k_mov_ctas",contRen,"k_cargo");				}else{					frn.setX(monto ,"k_mov_ctas",contRen,"k_abono");				}								frn.setX(getXmlAtt(cuboQuery, "r"&contRen ,"c13"),"k_mov_ctas",contRen,"k_inventario");								frn.setX(getXmlAtt(cuboQuery, "r"&contRen ,"c12"),"k_mov_ctas",contRen,"k_afecta"); // Added by JMM 20240308 								frn.setX(getXmlAtt(cuboQuery, "r"&contRen ,"ctopto"),"k_mov_ctas",contRen,"k_ctopto"); // Added by JMM 20240717				frn.setX(getXmlAtt(cuboQuery, "r"&contRen ,"referencia"),"k_mov_ctas",contRen,"k_referencia_uuid"); 			}			CalcTotal();									} //End MostrarDatos()		fun CalculaTotales() {			var subTotal = 0, iva = 0, total = 0, costo = 0, renglones;			var retisr=0, retiva=0, sumrets=0, monto_ordenes;						costo = frn.get("k_mov",-1,"k_costo");						//Calcular totales			monto_ordenes=0;			renglones = frn.N("k_mov");			for (var i=0; i<renglones; i++) {				monto_ordenes = monto_ordenes + frn.get("k_mov",i,"k_costo");//				subTotal = subTotal + frn.get("k_mov",i,"k_costo");			}						frn.set("k_monto_ordenes",monto_ordenes);/*									subTotal = frn.get("k_uuid_subtotal"); 			// Commented by JMM 20240229			//iva = subTotal * (porc_iva)/100;						// Added by JMM 20240228			iva = frn.get("k_uuid_impuesto");			if ( subTotal > 0 ) {				porc_iva = (iva * 100) / subTotal;			} else {				porc_iva = 0;			}					// Added by JMM 20240626			retisr = frn.get("k_uuid_retisr");			retiva = frn.get("k_uuid_retiva");			var retlocal = frn.get("k_uuid_impto_adicional_B");			sumrets = retisr + retiva + retlocal;										// Added by JMM 20240626			if ( subTotal == 0 ) {				total = 0;			} else {				total = subTotal + iva - sumrets; // Adapted by JMM 20240619			}			frn.set("k_monto_ordenes",monto_ordenes);							frn.set("k_subtotal",subTotal);			frn.set("k_iva",iva);						// Commented by JMM 20240229 ... Un commented to check 			frn.set("k_porciva",porc_iva);						frn.set("k_monto",total);						frn.set("k_sumrets",sumrets); // Added by JMM 20240626*/						} // End : Calcula Totales 							fun Plazo(){ //Calcula la fecha de pago, y las condiciones de pago en base al plazo			frn.set("k_vence",fnDate("addC",frn.get("k_fecha"),frn.get("k_plazo")));//Suma días comerciales			var cond=frn.get("k_plazo") & " dias fecha factura"/*" días fecha factura"*/;			if (frn.get("k_plazo")==0) cond="Pago de contado";				frn.set("k_cond",cond);  			}		fun IniParams(){//Inicializa parÃ¡metros de impresiÃ³n, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar PÃ¡gina				frn.set("param_paper","letter");//	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");//	"size=18,14cm"				frn.set("param_borderL","1","param_borderT","1.5","param_borderR","1","param_borderB","1.5");//	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0","param_Fy","1.0");//			"F=1,1"				frn.set("param_landscape","Y");//	"landscape=N|Y"				frn.set("param_emp","L");//			"@emp=L|R|C"				frn.set("param_header",1);			}						fun setRepPage() {//Establece los parï¿½metros finales de impresiï¿½n.			var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";			var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";			var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");			var lndsp="landscape=" & frn.get("param_landscape");			var emp="@emp=" & frn.get("param_emp");			rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);		}			fun EjecReporte(){//Imprime el reporte del documento especificado 				if(strlen(trim(frn.get("k_folio")))==0){ 					frn.message("Es necesario especificar el documento a consultar","Error","&Aceptar");					frn.setPos("k_folio");return;				}else{					ValidaFolioCancelado(frn.get("k_folio"));					//Commented by JMM 20240710					/*					if(resVal == 0){						return;					}						*/					}				Reporte();				frn.setPos("k_folio");			}							fun Reporte(){				var compania,contProd, contDet, tmpStr;				var xmlRef, nCampos, xmlRequest, xmlEncabezado, xmlDetalle;				var tmpXml, contDet, xmlCurDet, xmlDetConv, datdoc;				var desc_sucursal, fecha, total, importe, folio, docto;				var cmd, cuboResultados , ok;								sucursal_id = frn.get("k_sucn",-1,1);				desc_sucursal = frn.get("k_sucn",-1,0);				proveedor_id = frn.get("k_clave");				refer_id = frn.get("k_refer");				folio = frn.get("k_folio");				docto = frn.get("k_docto");				//Armar xml con los parametros				setXml(xmlRequest,"document","sucursal_id",sucursal_id);				setXml(xmlRequest,"document","proveedor_id",proveedor_id);				setXml(xmlRequest,"document","referencia",refer_id);				setXml(xmlRequest,"document","genero",gen_doc);				setXml(xmlRequest,"document","naturaleza",nat_doc);				setXml(xmlRequest,"document","grupo",gpo_doc);				setXml(xmlRequest,"document","tipo",tip_doc);				setXml(xmlRequest,"document","folio",folio);				cmdQuery="select * from keplersc.ser_tots_cons_rep('"& getXmlStr(xmlRequest,"EOF:13_10") &"')";				rstXml(cuboQuery);    //xml general con todos los datos				cuboQuery= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.Reporte()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									//Procesa xml encabezado				frn.lib("libGeneral.kpl","FileSave",cuboQuery , fileSavePath & "\xmlResQueryReporteCompleto ");					tmpStr=getXmlAtt(cuboQuery,"r0","encabezado");				rstXml(xmlEncabezado);				tmpStr=delScpScn(tmpStr);					rstXml(xmlEncabezado);				setXmlStr(xmlEncabezado,tmpStr);				tmpXml = getXml(xmlEncabezado,"row");				frn.lib("libGeneral.kpl","FileSave",tmpXml , fileSavePath & "\xmlResQueryReporte");																//Obtener datos de encabezado				kdb.kde("KDE");//Configuraci??el servidor				kdb.exec();				compania = kdb.get("KDE","1");   // Se obtiene el nombre de la compania								// Se define el formato a usar y se liga a la variable del reporte "rep"				kdb.readPage("datFto","srvtalltotscrudfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				rep.rst();				setRepPage();//Establece los par?metros finales de impresi?n(rep.page(...);), pues pueden haber cambiado por el usuario 				rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");				//Da valor a los inputs del reporte(rep.set();), e indica la ejecuci?n de "grupos de renglones de impresi?n" (rep.exe();)								rep.set("titulost",frn.get("statusDoc")); //Added by JMM 20240710								rep.set("fecha",sys.date());				rep.set("hora",sys.time());				rep.set("nombreempresa",compania);				rep.set("desc_sucursal",desc_sucursal);				rep.set("docto",docto);				rep.set("folio",folio);				rep.set("proveedor_id",getXml(tmpXml,"k_clave"));				rep.set("nombre",getXml(tmpXml,"k_nombreprov"));				rep.set("direccion",getXml(tmpXml,"k_calleprov"));				rep.set("colonia",getXml(tmpXml,"k_coloniaprov"));				rep.set("cp",getXml(tmpXml,"k_cpprov"));				rep.set("rfc",getXml(tmpXml,"k_rfc"));				rep.set("referencia",getXml(tmpXml,"k_refer"));				rep.set("monto_total",getXml(tmpXml,"k_monto"));				rep.exe("encabezado");/*								//Procesa poliza contable				kdb.sp("k_getDoc","datDoc",sucursal_id,gen_doc,nat_doc,gpo_doc,tip_doc,folio); 				kdb.exec();				var nRenPol=kdb.NR("datDoc","k_poliza");				var tPoliza=kdb.get("datDoc","k_poliza","tpoliza");				var nPoliza=kdb.get("datDoc","k_poliza","npoliza");			   				if (strlen(tPoliza)>0 && strlen(nPoliza)>0 ){						rep.set("tPol",tPoliza);						rep.set("nPol",nPoliza);						rep.exe("encabezadoPol");						var tAbonosPol=0, tCargosPol=0;						for(var i=0;i<nRenPol;i++){							if (kdb.get("datDoc","k_poliza","r"&i,"k_cargo")==0){								rep.set("PolClave2",kdb.get("datDoc","k_poliza","r"&i,"k_cuenta"));								rep.set("PolDescr2",kdb.get("datDoc","k_poliza","r"&i,"k_ctaDescr"));								rep.set("PolHaber",kdb.get("datDoc","k_poliza","r"&i,"k_abono"));								tAbonosPol=tAbonosPol+kdb.get("datDoc","k_poliza","r"&i,"k_abono");								rep.exe("partPolA");							}else{								rep.set("PolClave",kdb.get("datDoc","k_poliza","r"&i,"k_cuenta"));								rep.set("PolDescr",kdb.get("datDoc","k_poliza","r"&i,"k_ctaDescr"));								rep.set("PolDebe",kdb.get("datDoc","k_poliza","r"&i,"k_cargo"));								tCargosPol=tCargosPol+kdb.get("datDoc","k_poliza","r"&i,"k_cargo");								rep.exe("partPolC");							}						}						rep.set("totCargo",tCargosPol);						rep.set("totAbono",tAbonosPol);						rep.exe("PolTotales");				}*/				//Procesa poliza contable				var tablakdc1_alta = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;				var tablakdc2_alta = " keplersc.kdc2" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) & strSplit(frn.get("k_fecha"), "-", 1);				//var tablakdc1_baja = " keplersc.kdc1" & mid(strSplit(fecha_baja, "-", 0), 2,2) ;				//var tablakdc2_baja = " keplersc.kdc2" & mid(strSplit(fecha_baja, "-", 0), 2,2) & strSplit(fecha_baja, "-", 1);				var tipo = ""; var nPolAlta = "" ;				//if (tablakdc2_baja &= tablakdc2_alta ){					tipo = "Misma_tabla";										cmd= " select c1 as num_pol from " & tablakdc2_alta & " where c14='" & sucursal_id  & "' and c15='" & gen_doc & "' and c16= '" & nat_doc & "'" ;					cmd = cmd & " and c17='" & gpo_doc & "' and c18='" & tip_doc & "' and c19='" & frn.get("k_folio")& "'";									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.GenerarReporte()");					frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");									ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}									nPolAlta =getXmlAtt(cuboResultados,"r0", "num_pol" );								//}				imprime_poliza(tablakdc1_alta , tablakdc2_alta, "Alta", tipo, nPolAlta);//hasta aqui				rep.set("desc_notas",getXml(tmpXml,"k_coment"));					rep.exe("notastitulos");								//Procesar xml detalle				rstXml(xmlDetConv);				tmpStr=getXmlAtt(cuboQuery,"r0","detpartidas");				frn.lib("libGeneral.kpl","FileSave",tmpStr , fileSavePath & "\xmlResQueryRepDetalle");					rstXml(xmlDetalle);				tmpStr=delScpScn(tmpStr);				setXmlStr(xmlDetalle,tmpStr);				contDet=nXml(xmlDetalle);				total = 0;				for(var y=0; y< contDet; y++){					rstXml(xmlCurDet);					xmlCurDet= getXmlX(xmlDetalle,3,y);						frn.lib("libGeneral.kpl","FileSave",xmlCurDet , fileSavePath & "\xmlResQueryRepCurDetalle");											rep.set("tipo_orden",getXml(xmlCurDet,"k_tipo_orden"));					rep.set("num_orden",getXml(xmlCurDet,"k_num_orden"));					rep.set("punto",getXml(xmlCurDet,"k_punto"));					rep.set("desc_tot",getXml(xmlCurDet,"k_descriptot"));					rep.set("costo",getXml(xmlCurDet,"k_costo"));					rep.set("precio",getXml(xmlCurDet,"k_precio"));					rep.set("min",getXml(xmlCurDet,"k_margtots"));					rep.set("carg",getXml(xmlCurDet,"k_marg_calc"));					rep.set("cliente",getXml(xmlCurDet,"k_cliente"));					rep.exe("detalle");				}										rep.set("subtotal",getXml(tmpXml,"k_subtotal"));				rep.set("monto_iva",getXml(tmpXml,"k_iva"));								//Added by JMM 20240710, para estandarizar ( subtotal e iva no existen en el FTO )				//... retenciones tampoco se incluyeron en el FTO 				rep.set("monto_retenciones",getXml(tmpXml,"k_sumrets"));								rep.set("monto_total",getXml(tmpXml,"k_monto"));				rep.exe("totalproducto");									rep.win(); //Muestra la vista previa de la impresi?n. A partir de la vista previa (Preprint) se decide si se imprime o no.			}						fun imprime_poliza(tablakdc1 , tablakdc2, operacion, tipo, nPolAlta ){							var cmd, cuboResultados , ok;								//Procesa poliza contable				cmd= " select kc2.c1 as num_pol, kc2.c3 as cuenta, kc2.c4 as tipo_asiento, kc2.c5 as monto, kc1.c2 as desc_pol, kc2.c7 as refer, kc2.c8 as tipo_pol from " & tablakdc2 & " as kc2 " ;				cmd = cmd & " inner join " & tablakdc1 & " as kc1 on kc1.c1=kc2.c3 ";				cmd = cmd & " where kc2.c14='" & frn.get("k_sucn", -1, 1) & "' and kc2.c15='" & gen_doc & "' and kc2.c16= '" & nat_doc & "' and kc2.c17='" & gpo_doc & "' and kc2.c18='" & tip_doc & "' and kc2.c19='" & frn.get("k_folio")& "'";				if (operacion &= "Alta" && tipo &= "Misma_tabla"){					cmd = cmd & " and kc2.c1 = " & nPolAlta ; 				}				if (operacion &= "Baja" && tipo &= "Misma_tabla"){					cmd = cmd & " and kc2.c1 <> " & nPolAlta ; 				}												//Added by JMM 20240314				cmd = cmd & " order by kc2.c1, kc2.c10 "; 				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_pago_operarios.imprime_poliza()");				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var nRenPol= nXml(cuboResultados);				var tPoliza=getXmlAtt(cuboResultados,"r0", "tipo_pol" );				var nPoliza=getXmlAtt(cuboResultados,"r0", "num_pol" );								if (strlen(tPoliza)>0 && strlen(nPoliza)>0 ){						rep.set("tPol",tPoliza);						rep.set("nPol",nPoliza);						rep.exe("encabezadoPol");						var tAbonosPol=0, tCargosPol=0;						for(var i=0;i<nRenPol;i++){							if (getXmlAtt(cuboResultados,"r"&i, "tipo_asiento" )&= "A"){								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave2",cuenta );								rep.set("PolDescr2",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolHaber",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tAbonosPol=tAbonosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								//pol_saldo_presupuesto(cuenta);								//rep.set("PolSaldo2",saldo);								//rep.set("PolPresupuesto2",presupuesto );								rep.exe("partPolA");							}else{								var cuenta = getXmlAtt(cuboResultados,"r"&i, "cuenta" );								rep.set("PolClave",cuenta );								rep.set("PolDescr",getXmlAtt(cuboResultados,"r"&i, "desc_pol" ));								rep.set("PolDebe",getXmlAtt(cuboResultados,"r"&i, "monto" ));								tCargosPol=tCargosPol+getXmlAtt(cuboResultados,"r"&i, "monto" );								//pol_saldo_presupuesto(cuenta);								//rep.set("PolSaldo",saldo );								//rep.set("PolPresupuesto",presupuesto );								rep.exe("partPolC");							}						}						rep.set("totCargo",tCargosPol);						rep.set("totAbono",tAbonosPol);						rep.exe("PolTotales");				}			}			//VCSS 24/09/25 Impuestos		//Valida que el total de la factura leida dessde el UUI cuadre cn los conceptos		fun ValidarTotalesUUID(){			var uuid_subtotal, uuid_iva_tras, uuid_ieps_tras, uuid_iva_ret, uuid_isr_ret, uuid_ada, uuid_adb, uuid_total, total,res;			var uuid_localret, uuid_localtras;			uuid_subtotal=frn.get("k_uuid_subtotal");			uuid_iva_tras=frn.get("k_uuid_iva_trasladado");			uuid_ieps_tras=frn.get("k_uuid_ieps_trasladado");			uuid_iva_ret=frn.get("k_uuid_retiva");			uuid_isr_ret=frn.get("k_uuid_retisr");			uuid_localtras=frn.get("k_uuid_impto_adicional_A");			uuid_localret=frn.get("k_uuid_impto_adicional_B");			uuid_total=frn.get("k_uuid_monto");						total=uuid_subtotal+uuid_iva_tras+uuid_ieps_tras-uuid_iva_ret-uuid_isr_ret+uuid_localtras-uuid_localret;						res="S";			var dif;			dif = total - uuid_total;			dif =math("abs",dif);			if (dif > GAPMontoGastos){				res="N";			}/*								if(total != uuid_total){				res="N";			}*/			return res;		}					fun select_cuenta(){				var modificable,grupo,divisible;					//Added by JMM 20241015				if ( frn.get("chk_pc") == 1 ) {					return;				}							//frn.setX("", "k_mov_ctas", -1, "k_cuenta");				//frn.setX("", "k_mov_ctas", -1, "k_cuentadesc");				var tbla = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2);				modificable = frn.get("k_mov_ctas",-1,"k_cuenta_grupo");				grupo = frn.get("k_mov_ctas",-1,"k_cuenta");				grupo=mid(grupo,0,3);								divisible= frn.get("k_mov_ctas",-1,"k_cuenta_divisible");				if (modificable &= "S"){					var cmdSel = "select c1 as clave_cuenta, c2 as desc_cuenta from " & tbla & " where substring(c1,1,3)='" & grupo & "'";					frn.dialog("genlistafiltrosel","Cuentas",cmdSel ,"clave_cuenta","k_mov_ctas","", "k_cuenta","N");				};								if (divisible &= "S"){					frn.dialog("srv_contrarecibo_dividir_cuenta","k_mov_ctas");				}			}			//Para el concepto factura seleccionado carga las centas 			fun EliminarCuenta(){				var cuenta, cuentaBase, montoCuenta, montoCuentaBase, montoFinal, ren, totRen, asientoCuenta;				cuentaBase=frn.get("k_mov_ctas",-1,"k_cuenta_base");				if (cuentaBase &= ""){					return;				}								totRen=frn.N("k_mov_ctas");				for(ren=0; ren<=totRen; ren++){					if(cuentaBase &= frn.get("k_mov_ctas",ren,"k_cuenta")){						montoCuentaBase=frn.get("k_mov_ctas",ren,"k_cargo");						montoCuenta=frn.get("k_mov_ctas",-1,"k_cargo");						montoFinal=montoCuentaBase + montoCuenta;						if(montoFinal == 0){							frn.setX("","k_mov_ctas",ren,"k_cargo");						}else{							frn.setX(montoFinal,"k_mov_ctas",ren,"k_cargo");						}						montoCuentaBase=frn.get("k_mov_ctas",ren,"k_abono");						montoCuenta=frn.get("k_mov_ctas",-1,"k_abono");						montoFinal=montoCuentaBase + montoCuenta;						if(montoFinal == 0){							frn.setX("","k_mov_ctas",ren,"k_abono");						}else{							frn.setX(montoFinal,"k_mov_ctas",ren,"k_abono");						}												frn.setX("","k_mov_ctas",-1,"k_cuenta");						frn.setX("ELIMINADA","k_mov_ctas",-1,"k_cuentadesc");						frn.setX("","k_mov_ctas",-1,"k_cargo");						frn.setX("","k_mov_ctas",-1,"k_cargo");						break;					}				}				CalcTotal();			}			//Added by JMM 20240325			fun clear_row(imodo) {				if (imodo != 1) {					frn.setX("", "k_mov_ctas", -1, "k_cuenta");				}				frn.setX("", "k_mov_ctas", -1, "k_cuentadesc");				frn.setX("", "k_mov_ctas", -1, "k_cuentasaldo");				frn.setX("", "k_mov_ctas", -1, "k_cargo");				frn.setX("", "k_mov_ctas", -1, "k_abono");				frn.setX("", "k_mov_ctas", -1, "k_inventario");				frn.setX("", "k_mov_ctas", -1, "k_afecta");				frn.setX("", "k_mov_ctas", -1, "k_ctopto"); /*Added by JMM 20240714*/			}						fun restore_row() {				frn.setX(frn.get("k_mov_ctas", -1, "k_cuenta_origen"), "k_mov_ctas", -1, "k_cuenta");				frn.setX(frn.get("k_mov_ctas", -1, "k_cuentadesc_origen"), "k_mov_ctas", -1, "k_cuentadesc");			}						fun Cuenta() {				var cuenta = frn.get("k_mov_ctas", -1, "k_cuenta");					var xmlRequest, cmd, cubo , ok, mensajeError ;				setXml(xmlRequest,"document","cuenta",cuenta);				setXml(xmlRequest,"document","anio",mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2));								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\requestCuenta");					cmd="select * from keplersc.caracteristicas_cuenta('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";					cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.buscar_datos()");										frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboResultadosCuenta");										ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						clear_row(); //Added by JMM 20240325						return;					}										var nivel_cuenta = getXmlAtt(cubo,"r0","nivel");					var descripcion_nivel = getXmlAtt(cubo,"r0","desc_nivel");					var tipo_cuenta = getXmlAtt(cubo,"r0","tipo");										if (descripcion_nivel &! "Menor"){						frn.message(/*"La Cuenta debe ser menor"*/"No es una Cuenta de Detalle","Error","Aceptar"); // UPD 20240229 by JMM						frn.setX("", "k_mov_ctas", -1, "k_cuenta");						frn.setX("", "k_mov_ctas", -1, "k_cuentadesc");						restore_row(); //Added by JMM 20240325						return ;				}								if (tipo_cuenta &= "Cliente"){						frn.message("La Cuenta no puede ser de cliente.","Error","Aceptar");						frn.setX("", "k_mov_ctas", -1, "k_cuenta");						frn.setX("", "k_mov_ctas", -1, "k_cuentadesc");						restore_row(); //Added by JMM 20240325						return ;				}											var tbla = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2);					cmd = "select c2 as desc_cuenta from " & tbla & " where c1='" & cuenta  &  "'";										var cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Cuenta()");					frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						clear_row(); //Added by JMM 20240325						return;					}					var descr = getXmlAtt(cuboResultados , "r0","desc_cuenta");						frn.setX(cuenta, "k_mov_ctas", -1, "k_cuenta");				frn.setX(descr , "k_mov_ctas", -1, "k_cuentadesc");								//Added by JMM 20240714				if ( strlen( frn.get("k_mov_ctas",-1,"k_cuenta") ) == 0 || strlen( frn.get("k_mov_ctas",-1,"k_cuentadesc") ) == 0 ) {						frn.message("Cuenta No Valida ...","Error","Aceptar");						clear_row();				} else {						Prspto(1);				}							}							fun Cargo() {				//Commented by JMM 20240325				/*				if(frn.getJ("k_mov_ctas")>0){ //Trae informaci?n del rengl?n anterior(descripci?n, depto, proyecto), si el rengl?n actual no tiene especificado algo					var renAnterior=frn.getJ("k_mov_ctas")-1;					if(strlen(frn.get("k_mov_ctas",-1,"k_descr"))==0)frn.setX(frn.get("k_mov_ctas",renAnterior,"k_descr"),"k_mov_ctas",-1,"k_descr");				}				*/								//Added by JMM 20240325				if ( strlen( frn.get("k_mov_ctas",-1,"k_cuenta") ) == 0 || strlen( frn.get("k_mov_ctas",-1,"k_cuentadesc") ) == 0 ) {					frn.setX("","k_mov_ctas",-1,"k_cargo");					frn.message("Debes Registrar primero una Cuenta Valida ...","Error","Aceptar");				}								frn.setX("","k_mov_ctas",-1,"k_abono");								//Added by JMM 20240715				if ( strlen( frn.get("k_mov_ctas", -1, "k_ctopto") ) > 0 ) {					Prspto(1);				}								CalcTotal();			}							fun Abono() {				//Commented by JMM 20240325				/*				if(frn.getJ("k_mov_ctas")>0){ //Trae informaci?n del rengl?n anterior(descripci?n, depto, proyecto), si el rengl?n actual no tiene especificado algo					var renAnterior=frn.getJ("k_mov_ctas")-1;					if(strlen(frn.get("k_mov_ctas",-1,"k_descr"))==0)frn.setX(frn.get("k_mov_ctas",renAnterior,"k_descr"),"k_mov_ctas",-1,"k_descr");				}				*/									//Added by JMM 20240325				if ( strlen( frn.get("k_mov_ctas",-1,"k_cuenta") ) == 0 || strlen( frn.get("k_mov_ctas",-1,"k_cuentadesc") ) == 0 ) {					frn.setX("","k_mov_ctas",-1,"k_abono");					frn.message("Debes Registrar primero una Cuenta Valida ...","Error","Aceptar");				}								frn.setX("","k_mov_ctas",-1,"k_cargo");									//Commented by JMM 20240311				/*				frn.setX("","k_mov_ctas", -1, "k_afecta"); // Added by JMM 20240308				frn.setX("","k_mov_ctas", -1, "k_inventario"); // Added by JMM 20240308				*/									CalcTotal();			}									fun CalcTotal() { 					var C=0,A=0; 					for (var i=0,n=frn.N("k_mov_ctas")-1;i<n;i++) { 						C=C+frn.get("k_mov_ctas",i,"k_cargo");						A=A+frn.get("k_mov_ctas",i,"k_abono");					}									var subt = C - A;										// Added by JMM 20240228					var iva;					if ( frn.get("chk_pc") == 1 ) {						iva = 0;					} else {						iva = frn.get("k_uuid_impuesto");					}															// Added by JMM 20240228					frn.set("k_subtotal", subt, "k_iva", iva);					var importe = subt + iva;														frn.set("k_monto", importe);							//VCSS 26/09/25 Impuestos					frn.set("k_subtotal", frn.get("k_uuid_subtotal"));					frn.set("k_monto", frn.get("k_uuid_monto"));										frn.set("k_total_cargos",C);					frn.set("k_total_abonos",A);			}			//Para el concepto factura seleccionado carga las centas 			fun CargarCuentasConcepto(){				var cuboCuenta,id_tipo_factura,noRegs,strValor,cuenta,complemento,descripcion,tipo_asiento;				var monto,campoUI,cuentaGrupo,divisible,cuentaPlantilla,costo_inventario,inventario,intValor;				var clave_vehiculo,anio_modelo,serie;				var cuboAdicional;				var concepto;								if (tip_ope &= "C" || tip_ope &= "B"){					return;				}				frn.rst("k_mov_ctas");				id_tipo_factura=frn.get("k_concepto_factura",-1,1);				cmdQuery = "select fd.id_concepto, fd.cuenta, fd.complemento_cuenta, fd.tipo_asiento,  fd.descripcion_partida, fd.referencia_partida, " & 					"coalesce(k.c2,'CUENTA NO VALIDA...') as descripcion, fc.id_campo_ui as campo_ui, fd.cuenta_grupo as cuenta_grupo,fd.cuenta_divisible, fd.campo_cuenta_plantilla, fd.costo_inventario " & 					"from keplersc.conf_polizas_facturas_det fd left outer join keplersc.kdc1" & anio_contable & " k  on  k.c1=fd.cuenta " &					"inner join keplersc.conf_polizas_facturas_conceptos fc on fc.id_concepto = fd.id_concepto " &					"where tipo_movto='PROV' and id_tipo_factura='" & id_tipo_factura & "'";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"CargarCuentasConcepto.CargarCuentasConcepto()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.lib("libGeneral.kpl","FileSave",cuboQuery,"C:\Basura\CargarCuentasConcepto");				noRegs=nXml(cuboQuery);								for(var i=0; i<noRegs; i++){					concepto=getXmlAtt(cuboQuery, "r" & i, "id_concepto");					cuenta=getXmlAtt(cuboQuery, "r" & i, "cuenta");					if (cuenta &= ""){						continue;					}					complemento=getXmlAtt(cuboQuery, "r" & i, "complemento_cuenta");					descripcion=getXmlAtt(cuboQuery, "r" & i, "descripcion");					tipo_asiento=getXmlAtt(cuboQuery, "r" & i, "tipo_asiento");					campoUI=getXmlAtt(cuboQuery, "r" & i, "campo_ui");					cuentaGrupo=getXmlAtt(cuboQuery, "r" & i, "cuenta_grupo");					divisible=getXmlAtt(cuboQuery, "r" & i, "cuenta_divisible");					cuentaPlantilla=getXmlAtt(cuboQuery, "r" & i, "campo_cuenta_plantilla");					costo_inventario=getXmlAtt(cuboQuery, "r" & i, "costo_inventario");					monto=frn.get(campoUI);														if(cuentaPlantilla &! ""){						//Obtener campo cuenta						cmdQuery = "select " & cuentaPlantilla & " as cuenta from keplersc.kdmm mm where mm.c1='" & gen_doc & "' " ;						cmdQuery = cmdQuery & " and mm.c2='" & nat_doc & "' and mm.c3=" & gpo_doc & " and mm.c4=" & tip_doc & " ";						cmdQuery = cmdQuery & " and mm.col_sucursal='" & sucursal_id & "' ";						frn.lib("libGeneral.kpl","FileSave",cmdQuery ,"C:\Basura\cmdCuentaPlantilla");																rstXml(cuboCuenta);						cuboCuenta= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"CargarCuentasConcepto.CargarCuentasConcepto()");						frn.lib("libGeneral.kpl","FileSave",cuboCuenta,"C:\Basura\cuboCuentaPlantilla");						ok=getXmlAtt(cuboCuenta,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cuboCuenta,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;						}						cuenta=getXmlAtt(cuboCuenta, "r0", "cuenta");												if (mid(cuenta,0,1) &= "V" || mid(cuenta,0,1) &= "v"){ //Cuenta de autos							//Validar inventario							inventario=frn.get("k_claveinv");							if (inventario &= ""){								frn.message("Ingresar el inventario.","Error","Aceptar");								frn.setPos("k_claveinv");								frn.rst("k_mov_ctas");								frn.set("k_concepto_factura","0");								return;							}														//Obtener clave del vehiculo							cmdQuery = "select c3 as clave_vehiculo, c15 as anio_modelo, c5 as serie from keplersc.kdinf " & 								"where c1='" & frn.get("k_sucn",-1,1) & "' and c2='" & inventario & "' ";							rstXml(cuboCuenta);							cuboCuenta= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"CargarCuentasConcepto.CargarCuentasConcepto()");							ok=getXmlAtt(cuboCuenta,"ok");							if(ok &! "" && !ok){								mensajeError = getXmlAtt(cuboCuenta,"native3");								mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);								frn.message(mensajeError,"Error","Aceptar");								return;							}							clave_vehiculo=getXmlAtt(cuboCuenta, "r0", "clave_vehiculo");							anio_modelo=getXmlAtt(cuboCuenta, "r0", "anio_modelo");							anio_modelo = mid(anio_modelo,2,2);							serie=getXmlAtt(cuboCuenta, "r0", "serie");														cmdQuery = "select count(*) as totreg from keplersc.kdivcl " & " k where c1='" & clave_vehiculo & "' " &								"and c2='" & anio_modelo & "' and c3='" & frn.get("k_sucn",-1,1) & "' ";							rstXml(cuboCuenta);							cuboCuenta= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"CargarCuentasConcepto.CargarCuentasConcepto()");								frn.lib("libGeneral.kpl","FileSave",cuboCuenta,"C:\Basura\cuboKDIVCL");														ok=getXmlAtt(cuboCuenta,"ok");							if(ok &! "" && !ok){								mensajeError = getXmlAtt(cuboCuenta,"native3");								mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);								frn.message(mensajeError,"Error","Aceptar");								return;							}							intValor=getXmlAtt(cuboCuenta, "r0", "totreg");														if (intValor==0){								frn.message("No se tiene registrada la cuenta para la clave vehicular: " & clave_vehiculo,"Error","Aceptar");								frn.setPos("k_claveinv");								frn.rst("k_mov_ctas");								frn.set("k_concepto_factura","0");								return;							}																	strValor=cuenta;							strValor="c" & mid(cuenta,1);							cmdQuery = "select " &strValor & " as cuenta from keplersc.kdivcl " & " k where c1='" & clave_vehiculo & "' " &								"and c2='" & anio_modelo & "' and c3='" & frn.get("k_sucn",-1,1) & "' ";							rstXml(cuboCuenta);							cuboCuenta= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.CargarCuentasConcepto()");							ok=getXmlAtt(cuboCuenta,"ok");							if(ok &! "" && !ok){								mensajeError = getXmlAtt(cuboCuenta,"native3");								mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);								frn.message(mensajeError,"Error","Aceptar");								return;							}											cuenta=getXmlAtt(cuboCuenta, "r0", "cuenta");						}											}									if (complemento &= "PROVEEDOR"){						cuenta=cuenta & "-" & frn.get("k_clave");						//Si la cuenta no existe, agregarla						cmdQuery = "select count(*) as totreg from keplersc.kdc1" & anio_contable & " k where c1='" & cuenta & "'";						rstXml(cuboCuenta);						cuboCuenta= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"CargarCuentasConcepto.CargarCuentasConcepto()");						ok=getXmlAtt(cuboCuenta,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cuboCuenta,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							return;						}						intValor=getXmlAtt(cuboCuenta, "r0", "totreg");												if (intValor==0){							cmdQuery = "insert into keplersc.kdc1" & anio_contable & " (c1,c2) values('" & cuenta & "','" & frn.get("k_nombreprov")  & "')";							rstXml(cuboCuenta);							cuboCuenta= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"CargarCuentasConcepto.CargarCuentasConcepto()");							var resultado= getXml(cuboCuenta,"resultado");							var mensaje= getXml(cuboCuenta,"mensaje");							if(resultado &= "0"){								frn.message(mensaje,"Error","Aceptar");								return;							}													}					}					//Obtener detalle de cuenta					cmdQuery = "select c1 as cuenta, c2 as descripcion from keplersc.kdc1" & anio_contable & " k where c1='" & cuenta & "'";					rstXml(cuboCuenta);					cuboCuenta= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srv_contrarecibo_crud.CargarCuentasConcepto()");					ok=getXmlAtt(cuboCuenta,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboCuenta,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					if(getXmlAtt(cuboCuenta, "r0", "cuenta") &= ""){						descripcion="CUENTA NO VALIDA...";					}else{						descripcion=getXmlAtt(cuboCuenta, "r0", "descripcion");					}					frn.setX(concepto, "k_mov_ctas",i,"k_concepto");					frn.setX(cuenta, "k_mov_ctas",i,"k_cuenta");					frn.setX(descripcion, "k_mov_ctas",i,"k_cuentadesc");											frn.setX(cuenta, "k_mov_ctas",i,"k_cuenta");					frn.setX(descripcion, "k_mov_ctas",i,"k_cuentadesc");					if(tipo_asiento &= "C"){						frn.setX(monto, "k_mov_ctas",i,"k_cargo");					}else{						frn.setX(monto, "k_mov_ctas",i,"k_abono");					}					frn.setX(cuentaGrupo, "k_mov_ctas",i,"k_cuenta_grupo");					frn.setX(divisible, "k_mov_ctas",i,"k_cuenta_divisible");					frn.setX(cuentaPlantilla, "k_mov_ctas",i,"k_campo_cuenta_plantilla");					frn.setX(costo_inventario, "k_mov_ctas",i,"k_costo_inventario");					//Datos originales pra reestablecer renglon					frn.setX(cuenta, "k_mov_ctas",i,"k_cuenta_origen");					frn.setX(descripcion, "k_mov_ctas",i,"k_cuentadesc_origen");					if(tipo_asiento &= "C"){						frn.setX(monto, "k_mov_ctas",i,"k_cargo_origen");					}else{						frn.setX(monto, "k_mov_ctas",i,"k_abono_origen");					}					frn.setX(cuentaGrupo, "k_mov_ctas",i,"k_cuenta_grupo_origen");					frn.setX(divisible, "k_mov_ctas",i,"k_cuenta_divisible_origen");					frn.setX(cuentaPlantilla, "k_mov_ctas",i,"k_campo_cuenta_plantilla_origen");					frn.setX(costo_inventario, "k_mov_ctas",i,"k_costo_inventario_origen");					frn.setX(frn.get("k_refer"), "k_mov_ctas",i,"k_referencia_uuid");				}								//Obtiene totales de la poliza con base en xml configurado				CalcTotal();				if (id_tipo_factura &! "SINDEF"){					ValidarPoliza();				}			}			fun ValidarPoliza(){				var concepto_cta, concepto_xml, mensajeErr;				resVal=1;				//Validar que los coneptos en la poliza correspondan a los del xml				for (var i=0,n=frn.N("k_mov_ctas")-1;i<n;i++) {					concepto_cta=frn.get("k_mov_ctas",i,"k_concepto");					if(concepto_cta &= "subtotal"){						if (frn.get("k_uuid_subtotal") == 0){							mensajeErr="El xml no contiene subtotal(" & concepto_cta  & ")";							resVal=0;						}					}else if(concepto_cta &= "iva_ret"){						if (frn.get("k_uuid_retiva") == 0){							mensajeErr="El xml no contiene IVA retenido(" & concepto_cta  & ")";							resVal=0;						}					}else if(concepto_cta &= "isr_ret"){						if (frn.get("k_uuid_retisr") == 0){							mensajeErr="El xml no contiene ISR retenido(" & concepto_cta  & ")";							resVal=0;						}					}else if(concepto_cta &= "total"){						if (frn.get("k_uuid_monto") == 0){							mensajeErr="El xml no contiene total(" & concepto_cta  & ")";							resVal=0;						}					}else if(concepto_cta &= "iva_tras"){						if (frn.get("k_uuid_iva_trasladado") == 0){							mensajeErr="El xml no contiene IVA trasladado(" & concepto_cta  & ")";							resVal=0;						}					}else if(concepto_cta &= "ieps_tras"){						if (frn.get("k_uuid_ieps_trasladado") == 0){							mensajeErr="El xml no contiene ISR trasladado(" & concepto_cta  & ")";							resVal=0;						}					}else if(concepto_cta &= "impto_ced"){						if (frn.get("k_uuid_impto_adicional_B") == 0){ //VCSS Integracion ced tras							mensajeErr="El xml no contiene impuesto cedular Ret(" & concepto_cta  & ")";							resVal=0;						}					}else if(concepto_cta &= "impto_cedT"){						if (frn.get("k_uuid_impto_adicional_A") == 0){ //VCSS Integracion ced tras							mensajeErr="El xml no contiene impuesto cedular Tras(" & concepto_cta  & ")";							resVal=0;						}					}else{						mensajeErr="Concepto no configurado (" & concepto_cta  & ")";						resVal=0;					}					if (resVal == 0){						frn.message(mensajeErr,"Error","Aceptar");						return 0;					}				}								//Validar	concepto de xml	en configuacion	de poliza				for (var contCon=0; contCon<8; contCon++){					if (contCon==0 && frn.get("k_uuid_subtotal") != 0){						concepto_xml="subtotal";					}else if (contCon==1 && frn.get("k_uuid_retiva") != 0){						concepto_xml="iva_ret";					}else if (contCon==2 && frn.get("k_uuid_retisr") != 0){						concepto_xml="isr_ret";					}else if (contCon==3 && frn.get("k_uuid_monto") != 0){						concepto_xml="total";					}else if (contCon==4 && frn.get("k_uuid_iva_trasladado") != 0){						concepto_xml="iva_tras";					}else if (contCon==5 && frn.get("ieps_tras") != 0){						concepto_xml="ieps_tras";					}else if(contCon==6&& frn.get("impto_ced") != 0){ //VCSS Integracion ced tras						concepto_xml="impto_ced";					}else if(contCon==7 && frn.get("impto_cedT") != 0){ //VCSS Integracion ced tras						concepto_xml="impto_cedT";					}else{						concepto_xml="";					}										resVal=0;					if(concepto_xml &! ""){											for (var i=0,n=frn.N("k_mov_ctas")-1;i<n;i++){							concepto_cta=frn.get("k_mov_ctas",i,"k_concepto");							if(concepto_cta &= concepto_xml){								resVal=1;							}													}						if (resVal == 0){							mensajeErr="No se tiene el configurado el concepto " & concepto_xml & " para el tipo de factura";							frn.message(mensajeErr,"Error","Aceptar");							return 0;						}											}								}				var totRen=frn.N("k_mov_ctas");				for (var renCtas=0; renCtas < totRen;  renCtas++){					if (frn.get("k_mov_ctas",renCtas,"k_cuentadesc") &= "CUENTA NO VALIDA..."){						frn.message("La cuenta " & frn.get("k_mov_ctas",renCtas,"k_cuenta") & " no es valida." ,"Error","&Aceptar");						frn.setPos("k_mov_ctas", renCtas, "k_cuenta");						return 0;									}				}											resVal=1;				var dif;				dif = frn.get("k_total_cargos") - frn.get("k_total_abonos");				dif =math("abs",dif);				if (dif > GAPMontoGastos){					frn.message("Los cargos y abonos no coinciden.","Error","Aceptar");					resVal = 0;					return 0;				}				return	resVal;			}					fun busca_inv(){				var cargo = trim(frn.get("k_mov_ctas",-1,"k_cargo"));				var abono = trim(frn.get("k_mov_ctas",-1,"k_abono"));				if ( strlen(cargo) == 0 && strlen(abono) == 0 ) { return; } 						var ctanum = trim(frn.get("k_mov_ctas",-1,"k_cuenta"));				var ctadscr = trim(frn.get("k_mov_ctas",-1,"k_cuentadesc"));				if ( strlen(ctanum) == 0 || strlen(ctadscr) == 0 ) { return; }							var cmdSel = "select c2 as inventario, c3 as clave_vehiculo, c5 as serie, c17 as marca, c4 as descripcion from keplersc.kdinf where c1='" & frn.get("k_sucn",-1,1) & "'";	       frn.dialog("genlistafiltrosel","Inventarios",cmdSel ,"inventario","k_mov_ctas","", "k_inventario","N");     			}			fun busca_ctopto(){				var cargo = trim(frn.get("k_mov_ctas",-1,"k_cargo"));				var abono = trim(frn.get("k_mov_ctas",-1,"k_abono"));				if ( strlen(cargo) == 0 && strlen(abono) == 0 ) { return; } 							var ctanum = trim(frn.get("k_mov_ctas",-1,"k_cuenta"));				var ctadscr = trim(frn.get("k_mov_ctas",-1,"k_cuentadesc"));				if ( strlen(ctanum) == 0 || strlen(ctadscr) == 0 ) { return; }							var cmdSel = "select cve_concepto, descripcion from keplersc.kdcatconpres where sucursal = '" & frn.get("k_sucn",-1,1) & "'";				frn.dialog("genlistafiltrosel","Conceptos Presupuestos",cmdSel ,"cve_concepto","k_mov_ctas","", "k_ctopto","N");			}					fun Inventario() {				var ctanum = trim(frn.get("k_mov_ctas",-1,"k_cuenta"));				var ctadscr = trim(frn.get("k_mov_ctas",-1,"k_cuentadesc"));				if ( strlen(ctanum) == 0 || strlen(ctadscr) == 0 ) { 					frn.message("Debes Registrar primero una Cuenta Valida ...","Error","Aceptar");					frn.setX("", "k_mov_ctas", -1, "k_inventario");					frn.setX("","k_mov_ctas", -1, "k_afecta"); 					return; 				}				var cargo = trim(frn.get("k_mov_ctas",-1,"k_cargo"));				var abono = trim(frn.get("k_mov_ctas",-1,"k_abono"));				if ( strlen(cargo) == 0 && strlen(abono) == 0 ) { 					frn.message("Debes Registrar primero el monto del Cargo o Abono ...","Error","Aceptar");					frn.setX("", "k_mov_ctas", -1, "k_inventario");					frn.setX("","k_mov_ctas", -1, "k_afecta");					return; 				} 								if ( strlen(trim(frn.get("k_mov_ctas", -1, "k_inventario"))) == 0 ) {					frn.setX("", "k_mov_ctas", -1, "k_inventario");					frn.setX("","k_mov_ctas", -1, "k_afecta"); 					return;				}				var cmd, ok, mensajeError ;				cmd = "select c2 from keplersc.kdinf where c1='" & frn.get("k_sucn",-1,1) & "' and c2='" & frn.get("k_mov_ctas", -1, "k_inventario") & "'";								var cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Inventario()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					frn.setX("", "k_mov_ctas", -1, "k_inventario"); //Added by JMM 20240308					frn.setX("","k_mov_ctas", -1, "k_afecta"); //Added by JMM 20240308 					return;				}								if (nXml(cuboResultados ) < 1){					frn.message("Inventario no existe","Error","Aceptar");					frn.setX("", "k_mov_ctas", -1, "k_inventario");					frn.setX("","k_mov_ctas", -1, "k_afecta"); //Added by JMM 20240308					return;				}				} // End : Fun Inventario 			fun Afecta() {				var valor_afecta = trim ( frn.get("k_mov_ctas", -1, "k_afecta") );				if ( strlen( trim ( frn.get("k_mov_ctas", -1, "k_inventario") ) ) == 0 ) { frn.setX("","k_mov_ctas", -1, "k_afecta"); }				if ( valor_afecta &! "U" && valor_afecta &! "A" ) { frn.setX("","k_mov_ctas", -1, "k_afecta"); }				return;			}					fun Prspto(imodo) {				var irow;				irow = frn.getJ("k_mov_ctas");					var ctanum = trim(frn.get("k_mov_ctas",-1,"k_cuenta"));				var ctadscr = trim(frn.get("k_mov_ctas",-1,"k_cuentadesc"));				if ( strlen(ctanum) == 0 || strlen(ctadscr) == 0 ) { 					frn.message("Debes Registrar primero una Cuenta Valida ...","Error","Aceptar");					frn.setX("", "k_mov_ctas", -1, "k_ctopto");					return; 				}								var cargo = trim(frn.get("k_mov_ctas",-1,"k_cargo"));				var abono = trim(frn.get("k_mov_ctas",-1,"k_abono"));				if ( strlen(cargo) == 0 && strlen(abono) == 0 ) { 					if ( imodo != 1 ) {						frn.message("Debes Registrar primero el monto del Cargo o Abono ...","Error","Aceptar");					}					frn.setX("", "k_mov_ctas", -1, "k_ctopto");					return; 				} 								if ( strlen(trim(frn.get("k_mov_ctas", -1, "k_ctopto"))) == 0 ) {					frn.setX("", "k_mov_ctas", -1, "k_ctopto");					return;				}				var cmd, ok, mensajeError, cuboResultados ; //Para todos los Queries de la Funcion 								//Added by JMM 20240715				var vflag;				vflag = "";								vflag = ManejaPresupuesto(irow, imodo);				if ( vflag == -0.0000001 ) {					return;				}												// Verifica CAT Conceptos Presupuesto para validar si existe  								cmd = "select descripcion from keplersc.kdcatconpres where sucursal = '" & frn.get("k_sucn",-1,1) & "' and cve_concepto = '" & frn.get("k_mov_ctas", -1, "k_ctopto") & "'";								rstXml(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Cat_Concept_Prsto()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_CatCptoPrsto");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					frn.setX("", "k_mov_ctas", -1, "k_ctopto");  					return;				}								if (nXml(cuboResultados ) < 1){					frn.message("Concepto del Presupuesto No existe","Error","Aceptar");					frn.setX("", "k_mov_ctas", -1, "k_ctopto");					return;				}								var vimp;				vimp = 0;				vimp = PrsptoXPeriodo(irow);				if ( vimp == -0.0000001 ) {					return;				}															// Validar TBLs para determinar monto ejercido en el periodo ...								var vejercido, vnvomonto;				vejercido = PrsptoXPeriodo_Ejercido(irow); 				vnvomonto = cargo + vejercido;				if ( vejercido != -0.0000001 ) {					/*frn.message("Monto Ejercido del Concepto en el Periodo ... " & vejercido,"Info !!!","Aceptar");*/					if ( strlen(cargo) > 0 ) {						if ( vnvomonto > vimp ) {							frn.message("No puedes exceder el Presupuesto para el Concepto ... " & frn.get("k_mov_ctas", -1, "k_ctopto") & "|" & " " & "|" & 								"Presupuesto : " &vimp  & "|" & " " & "|" & 								"Monto Ejercido : " & vejercido & "|" & 								"(+) Nuevo Cargo = " & cargo & "|" & "(=) Monto Nuevo = " & vnvomonto,"Error","Aceptar");							frn.setX("", "k_mov_ctas", -1, "k_ctopto");						}					}				}								} // End : Fun Prspto 							fun ManejaPresupuesto(irow, imodo) {						var cmd, ok, mensajeError, cuboResultados ; //Para todos los Queries de la Funcion 				var vflag;				var regs;				var vanio;													// Validar TBLs para verificar si la CTA maneja presupuesto ...								sucursal_id = frn.get("k_sucn",-1,1); 				vanio = fnDate("year",frn.get("k_fecha")); 								var tablakdc1 = " keplersc.kdc1" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;				var tablakdc2 = " keplersc.kdc2" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) & strSplit(frn.get("k_fecha"), "-", 1);				cmd = "select count(*) as regs from keplersc.cat_ctas_ppto ccp where '" & frn.get("k_mov_ctas",irow, "k_cuenta") & "' between ccp.rango_ini and ccp.rango_fin";							cmd = cmd & " and sucursal = '" & sucursal_id & "' and anio = '" & vanio & "'";							rstXml(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Presupuesto()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_CtaContPrsto");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					frn.setX("", "k_mov_ctas",irow, "k_ctopto"); 					return -0.0000001;				}								if (nXml(cuboResultados ) < 1){					if ( imodo != 1 && imodo != 2 ) {						frn.message("La Cuenta No Maneja Presupuesto","Error","Aceptar");					}					frn.setX("", "k_mov_ctas",irow, "k_ctopto");					if ( imodo != 2 ) {						return -0.0000001;					} else {						return 0;					}				} 				else {					regs = getXmlAtt(cuboResultados , "r0","regs");					if ( regs > 0 ) {						return 1;					} else {						if ( imodo != 1 && imodo != 2 ) {							frn.message("La Cuenta No Maneja Presupuesto","Error","Aceptar");						}						frn.setX("", "k_mov_ctas",irow/*-1*/, "k_ctopto");						if ( imodo != 2 ) {							return -0.0000001;						} else {							return 0;						}					}									}									} // End : Fun ManejaPresupuesto					fun PrsptoXPeriodo(irow, imodo) {					var cmd, ok, mensajeError, cuboResultados ; //Para todos los Queries de la Funcion 				var vimp;													// Validar TBLs para determinar monto ejercido en el periodo ...								vimp = -0.0000001;								var vanio = "20" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;				var vmes = strSplit(frn.get("k_fecha"), "-", 1);								cmd = "select importe from keplersc.kdpresupuestos where sucursal = '" & frn.get("k_sucn",-1,1) & "' and cve_concepto = '" & frn.get("k_mov_ctas",irow, "k_ctopto") & "'";								cmd = cmd & " and anio = '" & vanio & "' and mes = '" & vmes & "'";								rstXml(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Res_Prsto()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_Prsto");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					frn.setX("", "k_mov_ctas",irow/*-1*/, "k_ctopto");  					return -0.0000001;				}				if (nXml(cuboResultados ) < 1){					if ( imodo != 2 ) {						frn.message("No se ha Registrado el Presupuesto para el Concepto, dentro del periodo de la Operacion ...","Error","Aceptar");						frn.setX("", "k_mov_ctas",irow/*-1*/, "k_ctopto");						return -0.0000001;					} else {						return 0;					}				}	else	{					vimp = getXmlAtt(cuboResultados , "r0","importe");					/*frn.message("Monto Presupuestado del Periodo ... " & vimp,"Info !!!","Aceptar");*/					return vimp;				}									} // End : Fun PrsptoXPeriodo							fun PrsptoXPeriodo_Ejercido(irow, imodo) {					var cmd, ok, mensajeError, cuboResultados ; //Para todos los Queries de la Funcion 				var vimp, vsuc;													// Validar TBLs para determinar monto ejercido en el periodo ...								vimp = -0.0000001;								vsuc = frn.get("k_sucn",-1,1);								var vanio = "20" & mid(strSplit(frn.get("k_fecha"), "-", 0), 2,2) ;				var vmes = strSplit(frn.get("k_fecha"), "-", 1);											cmd = "select sum(importe) importe from ( select * from ( ";				cmd =	cmd & "select coalesce( " &						"( " &						"select sum( case when upper(k6.c10) = 'C' then k6.c11 else case when upper(k6.c10) = 'A' then k6.c11 * -1 else 0 end end ) importe " &						"from keplersc.kdm6 k6 " &						"inner join keplersc.kdm1 k1 on k6.c1 = k1.c1 and k6.c2 = k1.c2 and k6.c3 = k1.c3 and k6.c4 = k1.c4 and k6.c5 = k1.c5 and k6.c6 = k1.c6 " &						"where k6.c1 = '" & vsuc & "' and k6.c2 = 'X' and k6.c3 = 'A' and k6.c4 = 12 and k6.c5 = 1 and k6.ctopto = '" & frn.get("k_mov_ctas",irow, "k_ctopto") & "' " & 						"and upper(k1.c43) <> 'C' and extract(year from k1.c9)::text = '" & vanio & "' and lpad(extract(month from k1.c9)::text,2,'0') = '" & vmes & "' " &						"and upper(k1.st_x_comprobar) in ('S','','I') " & 						") " &  					", 0) as importe ";				cmd =	cmd & "union all ";				cmd =	cmd &	"select coalesce( " &						"( " &						"select sum( case when upper(kd.c10) = 'C' then kd.c11 else case when upper(kd.c10) = 'A' then kd.c11 * -1 else 0 end end ) importe " &						"from keplersc.kdmdocscompr kd " & 						"inner join keplersc.kdm1 k1 on kd.c1 = k1.c1 and kd.c2 = k1.c2 and kd.c3 = k1.c3 and kd.c4 = k1.c4 and kd.c5 = k1.c5 and kd.c6 = k1.c6 " & 						"where kd.c1 = '" & vsuc & "' and kd.c2 = 'X' and kd.c3 = 'A' and kd.c4 = 12 and kd.c5 = 1 and kd.ctopto = '" & frn.get("k_mov_ctas",irow, "k_ctopto") & "' " &						"and upper(k1.c43) <> 'C' and extract(year from k1.c9)::text = '" & vanio & "' and lpad(extract(month from k1.c9)::text,2,'0') = '" & vmes & "' " &						") " &					", 0) as importe ";													cmd =	cmd & "union all ";									cmd =	cmd &	"select coalesce( " &						"( " &						"select sum( case when upper(kd.c10) = 'C' then kd.c11 else case when upper(kd.c10) = 'A' then kd.c11 * -1 else 0 end end ) importe " &						"from keplersc.kdmdocsnodeduc kd " & 						"inner join keplersc.kdm1 k1 on kd.c1 = k1.c1 and kd.c2 = k1.c2 and kd.c3 = k1.c3 and kd.c4 = k1.c4 and kd.c5 = k1.c5 and kd.c6 = k1.c6 " & 						"where kd.c1 = '" & vsuc & "' and kd.c2 = 'X' and kd.c3 = 'A' and kd.c4 = 12 and kd.c5 = 1 and kd.ctopto = '" & frn.get("k_mov_ctas",irow, "k_ctopto") & "' " &						"and upper(k1.c43) <> 'C' and extract(year from k1.c9)::text = '" & vanio & "' and lpad(extract(month from k1.c9)::text,2,'0') = '" & vmes & "' " &						") " &					", 0) as importe ";					cmd =	cmd & ") rf ) t_sum ";								rstXml(cuboResultados);				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srv_contrarecibo_crud.Prsto_Ejercido()");				frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados_PrstoEjercido");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					frn.setX("", "k_mov_ctas",irow/*-1*/, "k_ctopto");  					return -0.0000001;				}							if (nXml(cuboResultados ) < 1){					if ( imodo != 2 ) {						frn.message("No se pudo determinar el Presupuesto Ejercido para el Concepto ...","Error","Aceptar");						frn.setX("", "k_mov_ctas",irow, "k_ctopto");						return -0.0000001;					} else {						return -0.0000002;					}					}	else	{					vimp = getXmlAtt(cuboResultados , "r0","importe");					return vimp;				}								} // End : Fun PrsptoXPeriodo_Ejercido								} // End of class Main							</script></pag>