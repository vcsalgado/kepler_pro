<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Catalogo de Color Exterior">
<grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,10,10" bclr="192,205,213" unfont="0">
	<tab/><inp id="k_titulo" dim="40,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"
				type="string" modify="N" available="N" fnt="Arial,25"/>
	<br/>
	<br/>
		<hLine clr="0,0,0"/>
		<br/><br/>
		<tab/>
		<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" OnF5="calculadora()" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="60,15,10,15" brdr="0,5" tit="Catalogo de Color exterior Alta Nuevo" fnt="Arial,16">
			<tab/>
			<sp/>
				<inp id="clave" dim="25,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 
					type="string" modify="N" available="N" fnt="Arial,18"/>
			<sp/>
				<inp id="k_clave" dim="25,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 
					type="number" modify="Y" available="Y" fnt="Arial,18"  OnF9="consultaModelo()" nc="18" nd="2"/>
            <br/>
			<tab/>
			<sp/>
				<inp id="clave_2" dim="25,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 
					type="string" modify="N" available="N" fnt="Arial,18"/>
			<sp/>
				<inp id="k_clave_2" dim="25,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 
					type="capital" modify="Y" available="Y" fnt="Arial,18" OnF9="consultaClaveColor()" nc="18"/>
            <br/>
			<tab/>
			<sp/>
				<inp id="desc" dim="25,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 
					type="string" modify="N" available="N" fnt="Arial,18"/>
			<sp/>
				<inp id="k_desc" dim="25,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 
					type="capital" modify="Y" available="Y" fnt="Arial,18" nc="50"/><br/>
			<sp/>
				<tbl id="table" dim="40,7" brdr="1,0" clr="64,64,64" 
				bclr="236,240,243" clrCur="255,255,255" clrBrdr="64,64,64" 
				clrHead="0,58,112" bclrHead="236,240,243" OnF5="calculadora(table)">
					<col id="col1" name="Col1" type="number" modify="Y" available="Y" visible="Y" nd="2"/>
					<col id="col2" name="Col2" type="string"/>
				</tbl>
			<tab n="4"/>
			<br/>
		<tab n="12"/>
		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Guardar" hk="K" default="1" step="0"  OnEnter="guardar()" fnt="Arial,16"/>
        <br/>
		</grp>
</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;
			var tipoOper,consPlantilla, accion; //Variables relacionadas con parametros (colsulta , eliminar, baja)
			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna, clave, modelo, clave_2; 
			fun Main(){
				frn=new FRNT;
				kdb=new KDB;
				frP=new FRNTP;
				sys=new SYS;
				kdb.connect();
				
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				perfil_usuario = frn.lib("libKepler","UserInfo(2)");
				rol_usuario = frn.config("user","role");
				asterisco = "*";
				
                tipoOper = frn.param(0);
				clave = frn.param(1);
				clave_2 = frn.param(3);
	
				
				
				Inicializa();
			
			}
//==================================================================================================================
			//====================
			//Descripcion: Se agrega como OnF5="calculadora()" o OnF5="calculadora(table)"
			//En el grupo general y cuando se presione F5 en cualquier input
			//que cumpla con los parametros, abrira una calculadora 
			//si se agrega a un elemento tabla funciona igual 
			//Parametros: table = nombre del elemento grafico tabla
			//Condiciones: Elemento Grafico Input o Tabla
			//	Input: type="number" modify="Y" available="Y"
			//	Tabla: type="number" modify="Y" available="Y"
			//Recomendacion: El elemento grafico input/celda pueda contener 2 decimales
			// si no lo redondea el sistema por defecto, la calculadora da 2 decimales
			//Salida: Resultado operacion que se agrega a el elemento grafico
			//Depende: xsd/calculadora.kpl
			//Autor: Gad Miranda
			//Fecha: 17/Enero/2023
			//====================
        
			fun calculadora(tabla){
				var id_ele_grafic, ele_available, ele_modify, ele_tipo, ele_tabla, col_tabla, ren_tabla
				,t_ele_modify, t_ele_available, t_ele_tipo
				,t_ele_valor, ele_valor;
				id_ele_grafic = frn.getPos();
				ele_available = frn.getAtt(id_ele_grafic,"available");
				ele_modify = frn.getAtt(id_ele_grafic,"modify");
				ele_tipo = frn.getAtt(id_ele_grafic,"type");
				ele_tabla = tabla;
				if (ele_tabla &! ""){
					col_tabla = frn.getIdI(ele_tabla);
					ren_tabla = frn.getIdJ(ele_tabla);
					t_ele_modify = frn.getAtt(ele_tabla,"modify",col_tabla);
					t_ele_available = frn.getAtt(ele_tabla,"available",col_tabla);
					t_ele_tipo = frn.getAtt(ele_tabla,"type",col_tabla);

					if(t_ele_available&="Y" && t_ele_modify &="Y" && t_ele_tipo &="number"){
						t_ele_valor = frn.get(ele_tabla,ren_tabla,col_tabla);
						frn.dialog("calculadora",t_ele_valor,"",ele_tabla,ren_tabla,col_tabla);
					}
				}
				
				if (ele_available &= "Y" && ele_modify &= "Y" && ele_tipo &="number"){
					ele_valor=frn.get(id_ele_grafic);
					frn.dialog("calculadora",ele_valor,id_ele_grafic);
				}
			}
					
//==================================================================================================================
			fun Inicializa(){
				frn.rst("gpo_2");
				Inicia_Forma();
				}
	

			fun activaCampos(){
                if(tipoOper&="Nuevo"){
                    frn.set("k_clave","");
					frn.set("k_clave_2","");
                    frn.set("k_desc","");
                }
                
				frn.setAtt("k_clave", "available", "Y");
				frn.setAtt("k_clave", "bclr", "255,255,255");
				frn.setAtt("k_clave_2", "available", "Y");
				frn.setAtt("k_clave_2", "bclr", "255,255,255");
				frn.setAtt("k_desc", "available", "Y");
				frn.setAtt("k_desc", "bclr", "255,255,255");
				if(tipoOper&="Modificar"){
					frn.setAtt("k_clave", "available", "N");
					frn.setAtt("k_clave", "bclr", "236,240,243");
					frn.setAtt("k_clave_2", "available", "N");
					frn.setAtt("k_clave_2", "bclr", "236,240,243");
				}
			}

			fun Inicia_Forma(){
				var cmd,ok,mensajeError, cubo;
				//Etiquetas 
				frn.set("clave","Clave Modelo");
				frn.set("clave_2","Clave Color");
				frn.set("desc","Descripción ");

				frn.setAtt("k_clave", "available", "Y");
				frn.setAtt("k_clave", "bclr", "255,255,255");
				frn.setAtt("k_clave_2", "available", "Y");
				frn.setAtt("k_clave_2", "bclr", "255,255,255");
				frn.setAtt("k_desc", "available", "Y");
				frn.setAtt("k_desc", "bclr", "255,255,255");
				//Obtencion de registros
			}
		
//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------GAD fl4r30n
						
			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){
				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO
							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana
							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)
							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje
				*/
				var prefix=frn.lib("libKepler","langPrefix");
				var page=prefix&pag;
				var b_valido=1;
				if(iModo==0)page=pag;
				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.
					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;
				}
				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);
			}
		}
	</script>
</pag>