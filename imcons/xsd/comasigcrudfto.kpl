<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de " scale="48">	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,16" unfont="0">			<br exe="encabezado"/>		<hLine dim="90,0" g="2" type="1"/>		<br exe="encabezado"/>				<grp dim="15,5,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>				<grp dim="60,7,7,12">			<br/>			<inp id="nombreempresa" dim="70,1" fnt="20b,20b" type="string" modify="N" bclr="249,249,249"/>			<br/>			<inp id="tituloreporte" dim="70,1" fnt="20b,18b" type="string" modify="N" bclr="249,249,249"/>			<br/>			<inp id="leyendatx" dim="70,1" type="string" fnt=",16b" modify="N" just="L" nc="-1"/>			<br/>			<inp id="fechItx" dim="7,1" type="string" fnt=",16b" modify="N" just="L" nc="-1"/>			<sp n="1"/>			<inp id="fechI" dim="10,1" type="date" fnt=",16b" modify="N" just="L" nc="-1" fmt="CCYY/MM/DD"/>			<sp n="2"/>			<inp id="fechFtx" dim="7,1" type="string" fnt=",16b" modify="N" just="L" nc="-1"/>			<sp n="1"/>			<inp id="fechF" dim="10,1" type="date" fnt=",16b" modify="N" just="L" nc="-1" fmt="CCYY/MM/DD"/>						<!-- <sp n="1"/> -->			<!-- <inp id="fechoper" dim="12,1" type="date" fnt=",16b" fmt="DD/MM/CCYY" modify="N" just="L" nc="-1"/> -->			<br exe="encabezado"/>		</grp>				<tab n="1"/>				<grp dim="15,5,7,12">			<tab n="2"/><txt>P&#225;g:</txt>			<sp/> <inp id="k_pag" dim="5,1" type="number" mcr="k_pag"/><br/><br/>			<inp id="fecha" dim="10,1" type="date" fmt="DD-MM-CCYY"/>			<sp/> <inp id="hora" dim="5,1" type="time"/>		</grp>		<br exe="encabezado"/>		<br exe="encabezado"/>				<hLine dim="90,0" g="2" type="1"/>			<br exe="encabezado"/>			<txt fnt=",b"> Inventario </txt> <sp n="2"/>			<txt fnt=",b"> Clave </txt> <sp n="3"/>			<txt fnt=",b"> A&#241;o </txt> <sp n="1"/>			<txt fnt=",b"> Descripcion </txt> <sp n="22"/>			<txt fnt=",0b"> Serie </txt> <sp n="15"/>			<txt fnt=",b"> Color </txt> <sp n="1"/> 			<txt fnt=",b"> Vest. </txt> <sp n="1"/>			<inp id="suctx" dim="4,1" type="string" modify="N" fnt=",0b"/>			<br exe="encabezado"/>		<hLine dim="90,0" g="2" type="1"/>		<br exe="encabezado"/>		<br exe="encabezado"/>		<inp id="invent" dim="9,1" type="string" modify="N"/> <sp n="1"/>		<inp id="modelo" dim="8,1" type="string" modify="N"/>		<inp id="anio" dim="4,1" type="string" modify="N" just="R"/> <sp n="1"/>		<inp id="descrip" dim="30,1" type="string" modify="N"/> <sp n="1"/>		<inp id="serie" dim="20,1" type="string" modify="N"/> <sp n="1"/> 		<inp id="color" dim="4,1" type="string" modify="N"/> <sp n="1"/> 		<inp id="vest" dim="4,1" type="string" modify="N"/> <sp n="1"/> 		<inp id="suc" dim="4,1" type="string" modify="N"/> 		<br exe="detalle"/>				<!-- <hLine dim="35,0" g="2" type="1"/> -->		<!-- <br exe="linea"/> -->				<!-- <br exe="total"/> -->		<!-- <tab n="5"/><txt fnt=",-1bi">Total:</txt><tab/><inp id="input3" dim="10,1" type="number" brdr="1,0" fnt=",0b"/>  -->		<!-- <br exe="total"/>  -->			</grp></pag>