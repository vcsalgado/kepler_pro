<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Esquemas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">	<tab/><txt fnt=",22" clr="0,0,0"> ESQUEMA DE PAQUETES</txt><tab/>	<br/>		<tab/><hLine clr="0,0,0"	dim="45,0,0,0"/>	<br/>	<br/><tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="45,25,10,17" brdr="0,5" tit="Paquetes" fnt="Arial,16">		<br/>		<sp/>		<tbl id="k_mov" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="88,20" modify="Y" Reorder="Y" available="Y" insdel="N">			<col name="Clave" id="k_clave"  modify="N" visible="Y" available="N"/>			<col name="Descripcion" id="k_descripcion"  modify="N" visible="Y" available="N"/>			<col name="Porc. Actual" id="k_porcentaje_actual"  nc="5" modify="N" visible="Y" type="number" nd="2" available="N"/>			<col name="Porc. Nuevo" id="k_porcentaje_nuevo"  nc="5" visible="Y" type="number" nd="2" modify="Y" available="Y"/>		</tbl>		<br/><sp/><br/><tab/>		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Guardar" hk="K" default="1" step="0"  OnEnter="Guardar()" fnt="Arial,16"/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, asterisco  ;		var cmdQuery, cuboQuery, ok, mensajeError;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			rol_usuario = frn.config("user","role");			asterisco = "*";						llena_combos();			ConfiguraUI();			Inicializa();		}            		fun llena_combos(){			ResetDetalle();		}				fun ResetDetalle(){			frn.rst("k_mov");		}				fun ObtenerEsquema(){			var xmlPantalla;			frn.rst("k_mov");			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			cmdQuery = "select paq.c1 as clave, coalesce(paq.c2,'NO ESTA EN CATALOGO') as descripcion, coalesce(ap.c2,0) as porcentaje_actual, " &				"coalesce(ap.c2,0) as porcentaje_nuevo from keplersc.kdcatpaq paq " &				"left outer join keplersc.kdesqasepaq ap on ap.c1 = paq.c1 order by paq.c1";						rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_tipos.ObtenerEsquema()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_mov",cuboQuery);					}				fun Guardar(){			var xmlPantalla,no_partidas,resultado,mensaje,adicionales;			//Validaciones			no_partidas=frn.N("k_mov")-1;			if (no_partidas==0) {				frn.message("Error, no se tiene registros de configuración","Error","Aceptar");				return;			}			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;						setXml(xmlPantalla ,"k_partidas","no_partidas",no_partidas);						frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaAsepaq");			cmdQuery="select * from keplersc.cat_esqasepaq_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						kdb.rst(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_recep_comis_esqasepaq.Alta");			resultado= getXml(cuboQuery,"resultado");			mensaje= getXml(cuboQuery,"mensaje");							if(resultado &= "0"){				frn.message(mensaje,"Error","Aceptar");				return;			}			frn.message("Registros modificados","Mensaje","Aceptar");			ObtenerEsquema();		}				fun ConfiguraUI(){		}				fun Inicializa(){			ObtenerEsquema();		}	}	</script></pag>