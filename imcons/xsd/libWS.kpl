cmd=cmd&",i56";//Fecha de inicio de la estación 2					else if	(getXml(xmlInput,"add["&i&"]")&="k_minstation3")		cmd=cmd&",i57";//Mínimo en la estación 3					else if	(getXml(xmlInput,"add["&i&"]")&="k_maxstation3")		cmd=cmd&",i58";//Máximo en la estación 3					else if	(getXml(xmlInput,"add["&i&"]")&="k_reorder3")			cmd=cmd&",i59";//Punto de reorden de la estación 3					else if	(getXml(xmlInput,"add["&i&"]")&="k_inistationdate3")	cmd=cmd&",i60";//Fecha de inicio de la estación 3					else if	(getXml(xmlInput,"add["&i&"]")&="k_minstation4")		cmd=cmd&",i61";//Mínimo en la estación 4					else if	(getXml(xmlInput,"add["&i&"]")&="k_maxstation4")		cmd=cmd&",i62";//Máximo en la estación 4					else if	(getXml(xmlInput,"add["&i&"]")&="k_reorder4")			cmd=cmd&",i63";//Punto de reorden de la estación 4					else if	(getXml(xmlInput,"add["&i&"]")&="k_inistationdate4")	cmd=cmd&",i64";//Fecha de inicio de la estación 4					else if	(getXml(xmlInput,"add["&i&"]")&="k_inistationdate1")	cmd=cmd&",i65";//Fecha de inicio de la estación 1					else if	(getXml(xmlInput,"add["&i&"]")&="k_waste")				cmd=cmd&",i66";//Porcentaje de merma					else if	(getXml(xmlInput,"add["&i&"]")&="k_smc")					cmd=cmd&",i67";//0=No 1=control x talla 2=Tll-Modelo 3=Tll-Mdl-Color					else if	(getXml(xmlInput,"add["&i&"]")&="k_lottrans")			cmd=cmd&",i68";//Lote de Transferencia					else if	(getXml(xmlInput,"add["&i&"]")&="k_image")				cmd=cmd&",i70";//Nombre Completo de la Imagen EJ. imagenA1.jpg					else if	(getXml(xmlInput,"add["&i&"]")&="k_costtype")			cmd=cmd&",i100";//Tipo de Costo (E) Estandar (P) Promedio					else if	(getXml(xmlInput,"add["&i&"]")&="k_barcode2")			cmd=cmd&",i101";//codigo de barras 2					else if	(getXml(xmlInput,"add["&i&"]")&="k_price20")				cmd=cmd&",i179";//precio 20				}				cmd=cmd&max;				kdb.table(cmd);				kdb.exec();				for(var i=0,n=kdb.N("dat");i<n;i++) {					setXml(xmlOutput,"Item["&i&"]","k_code",kdb.get("dat","r"&i,"i1"));//Clave del producto					setXml(xmlOu