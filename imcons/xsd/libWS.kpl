<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="libWS">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>	<br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var kdb;			fun Main() {				kdb=new KDB;							}//B  R  A  N  C  H  E  S			fun BranchSearch(xmlInput) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<searchRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<Search>							<text>...</text>							<searchBy>...</searchBy>							<max>...</max>							<add>...</add>							</Search>					</searchRequest>				</soap:Body>			</soap:Envelope>							*/				var xmlOutput;				var cmd="dat,b,";				var text=getXml(xmlInput,"text");				var searchBy=getXml(xmlInput,"searchBy");/*code,dscr or extended*/				var max=(getXml(xmlInput,"max")&!"") ? (",&,max,"&getXml(xmlInput,"max")):"";				kdb.connect();				kdb.open("b,kdms");				if(searchBy&="extended" && text&!"")	kdb.lim("'"&text&"' inside b1,b2");				else if(searchBy&="dscr" && text&!"")	kdb.lim("'"&text&"' inside b2");				else if(searchBy&="code" && text&!"")	kdb.lim("'"&text&"' inside b1");																	if(searchBy&="dscr")		cmd=cmd&"2,&,b1,b2";				else							cmd=cmd&"1,&,b1,b2";				for(var i=0,n=nXml(xmlInput);i<n;i++) {					if			(getXml(xmlInput,"add["&i&"]")&="k_id")				cmd=cmd&",b3";//Identificación					else if	(getXml(xmlInput,"add["&i&"]")&="k_addr")				cmd=cmd&",b4";//Calle y el número de la dirección					else if	(getXml(xmlInput,"add["&i&"]")&="k_addr2")			cmd=cmd&",b5";//Colonia o población de la dirección					else if	(getXml(xmlInput,"add["&i&"]")&="k_country")			cmd=cmd&",b6";//Clave del país					else if	(getXml(xmlInput,"add["&i&"]")&="k_state")			cmd=cmd&",b7";//Clave del estado					else if	(getXml(xmlInput,"add["&i&"]")&="k_municipality")	cmd=cmd&",b8";//Clave del municipo					else if	(getXml(xmlInput,"add["&i&"]")&="k_zipcode")			cmd=cmd&",b9";//Código postal					else if	(getXml(xmlInput,"add["&i&"]")&="k_tel1")				cmd=cmd&",b10";//Número de su teléfono					else if	(getXml(xmlInput,"add["&i&"]")&="k_tel2")				cmd=cmd&",b11";//Segundo número telefónico					else if	(getXml(xmlInput,"add["&i&"]")&="k_website")			cmd=cmd&",b12";//Sitio web				}				cmd=cmd&max;				kdb.table(cmd);				kdb.exec();				for(var i=0,n=kdb.N("dat");i<n;i++) {					setXml(xmlOutput,"Branch["&i&"]","k_code",kdb.get("dat","r"&i,"b1"));//Clave de la sucursal					setXml(xmlOutput,"Branch["&i&"]","k_dscr",kdb.get("dat","r"&i,"b2"));//Nombre de la sucursal					if(kdb.get("dat","r"&i,"b3")&!"")	setXml(xmlOutput,"Branch["&i&"]","k_id",kdb.get("dat","r"&i,"b3"));//Identificación					if(kdb.get("dat","r"&i,"b4")&!"")	setXml(xmlOutput,"Branch["&i&"]","k_addr",kdb.get("dat","r"&i,"b4"));//Calle y el número de la dirección					if(kdb.get("dat","r"&i,"b5")&!"")	setXml(xmlOutput,"Branch["&i&"]","k_addr2",kdb.get("dat","r"&i,"b5"));//Colonia o población de la dirección					if(kdb.get("dat","r"&i,"b6")&!"")	setXml(xmlOutput,"Branch["&i&"]","k_country",kdb.get("dat","r"&i,"b6"));//Clave del país					if(kdb.get("dat","r"&i,"b7")&!"")	setXml(xmlOutput,"Branch["&i&"]","k_state",kdb.get("dat","r"&i,"b7"));//Clave del estado					if(kdb.get("dat","r"&i,"b8")&!"")	setXml(xmlOutput,"Branch["&i&"]","k_municipality",kdb.get("dat","r"&i,"b8"));//Clave del municipo					if(kdb.get("dat","r"&i,"b9")&!"")	setXml(xmlOutput,"Branch["&i&"]","k_zipcode",kdb.get("dat","r"&i,"b9"));//Código postal					if(kdb.get("dat","r"&i,"b10")&!"")	setXml(xmlOutput,"Branch["&i&"]","k_tel1",kdb.get("dat","r"&i,"b10"));//Número de su teléfono					if(kdb.get("dat","r"&i,"b11")&!"")	setXml(xmlOutput,"Branch["&i&"]","k_tel2",kdb.get("dat","r"&i,"b11"));//Segundo número telefónico					if(kdb.get("dat","r"&i,"b12")&!"")	setXml(xmlOutput,"Branch["&i&"]","k_website",kdb.get("dat","r"&i,"b12"));//Sitio web				}				kdb.close();							return xmlOutput;			}						fun GetBranch(code) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<getBranchRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<k_code>...</k_code>					</getBranchRequest>									</soap:Body>			</soap:Envelope>					*/				var xmlOutput;				kdb.connect();				kdb.open("b,kdms");				kdb.search("dat,b,1,0,'"&code&"',&,b1...b12");				kdb.exec();				if(kdb.ok("dat")) {					setXml(xmlOutput,"ok","1");					setXml(xmlOutput,"Branch","k_code",					kdb.get("dat","b1"));//Clave de la sucursal					setXml(xmlOutput,"Branch","k_dscr",					kdb.get("dat","b2"));//Nombre de la sucursal					setXml(xmlOutput,"Branch","k_id",					kdb.get("dat","b3"));//Identificación					setXml(xmlOutput,"Branch","k_addr",					kdb.get("dat","b4"));//Calle y el número de la dirección					setXml(xmlOutput,"Branch","k_addr2",				kdb.get("dat","b5"));//Colonia o población de la dirección					setXml(xmlOutput,"Branch","k_country",				kdb.get("dat","b6"));//Clave del país					setXml(xmlOutput,"Branch","k_state",				kdb.get("dat","b7"));//Clave del estado					setXml(xmlOutput,"Branch","k_municipality",		kdb.get("dat","b8"));//Clave del municipo					setXml(xmlOutput,"Branch","k_zipcode",				kdb.get("dat","b9"));//Código postal					setXml(xmlOutput,"Branch","k_tel1",					kdb.get("dat","b10"));//Número de su teléfono					setXml(xmlOutput,"Branch","k_tel2",					kdb.get("dat","b11"));//Segundo número telefónico					setXml(xmlOutput,"Branch","k_website",				kdb.get("dat","b12"));//Sitio web				} else {setXml(xmlOutput,"ok","0"); setXml(xmlOutput,"err","Branch not found");}				kdb.close();							return xmlOutput;							}			//S  T  O  R  E  S			fun StoreSearch(xmlInput) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<searchRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<Search>							<text>...</text>							<searchBy>...</searchBy>							<max>...</max>						</Search>					</searchRequest>				</soap:Body>			</soap:Envelope>							*/				var xmlOutput;				var cmd="dat,s,";				var text=getXml(xmlInput,"text");				var searchBy=getXml(xmlInput,"searchBy");/*code,dscr,branch or extended*/				var max=(getXml(xmlInput,"max")&!"") ? (",&,max,"&getXml(xmlInput,"max")):"";				kdb.connect();				kdb.open("s,kdiq");				if(searchBy&="extended" && text&!"")		kdb.lim("'"&text&"' inside s2,s3");				else if(searchBy&="dscr" && text&!"")		kdb.lim("'"&text&"' inside s3");				else if(searchBy&="code" && text&!"")		kdb.lim("'"&text&"' inside s2");				else if(searchBy&="branch" && text&!"")	kdb.lim("'"&text&"' inside s1");																	if(searchBy&="dscr")		cmd=cmd&"2,&,s1...s4";				else							cmd=cmd&"1,&,s1...s4";				cmd=cmd&max;				kdb.table(cmd);				kdb.exec();				for(var i=0,n=kdb.N("dat");i<n;i++) {					setXml(xmlOutput,"Store["&i&"]","k_branch",kdb.get("dat","r"&i,"s1"));//Clave de la sucursal					setXml(xmlOutput,"Store["&i&"]","k_code",kdb.get("dat","r"&i,"s2"));//Clave del almacén					setXml(xmlOutput,"Store["&i&"]","k_dscr",kdb.get("dat","r"&i,"s3"));//Descripción					setXml(xmlOutput,"Store["&i&"]","k_type",kdb.get("dat","r"&i,"s4"));//S=almacén de mercancía apartada N=mercancía normal				}				kdb.close();							return xmlOutput;			}						fun GetStore(branch,code) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<getStoreRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<k_branch>...</k_branch>						<k_code>...</k_code>					</getStoreRequest>									</soap:Body>			</soap:Envelope>					*/				var xmlOutput;				kdb.connect();				kdb.open("s,kdiq");				kdb.search("dat,s,1,0,'"&branch&"','"&code&"',&,s1...s4");				kdb.exec();				if(kdb.ok("dat")) {					setXml(xmlOutput,"ok","1");					setXml(xmlOutput,"Branch","k_branch",				kdb.get("dat","s1"));//Clave de la sucursal					setXml(xmlOutput,"Branch","k_code",					kdb.get("dat","s2"));//Clave del almacén					setXml(xmlOutput,"Branch","k_dscr",					kdb.get("dat","s3"));//Descripción					setXml(xmlOutput,"Branch","k_type",					kdb.get("dat","s4"));//S=almacén de mercancía apartada N=mercancía normal				} else {setXml(xmlOutput,"ok","0"); setXml(xmlOutput,"err","Store not found");}				kdb.close();							return xmlOutput;							}			// C	U	S	T	O	M	E	R	S			fun CustomerSearch(xmlInput) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<searchRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<Search>							<text>...</text>							<searchBy>...</searchBy>							<max>...</max>							<add>...</add>							</Search>					</searchRequest>				</soap:Body>			</soap:Envelope>							*/				var xmlOutput;				var cmd="dat,c,";				var text=getXml(xmlInput,"text");				var searchBy=getXml(xmlInput,"searchBy");/*code,dscr or extended*/				var max=(getXml(xmlInput,"max")&!"") ? (",&,max,"&getXml(xmlInput,"max")):"";				kdb.connect();				kdb.open("c,kdud");				if(searchBy&="extended" && text&!"")	kdb.lim("'"&text&"' inside c2,c3");				else if(searchBy&="dscr" && text&!"")	kdb.lim("'"&text&"' inside c3");				else if(searchBy&="code" && text&!"")	kdb.lim("'"&text&"' inside c2");																	if(searchBy&="dscr")		cmd=cmd&"2,&,c2,c3";				else							cmd=cmd&"1,&,c2,c3";				for(var i=0,n=nXml(xmlInput);i<n;i++) {					if			(getXml(xmlInput,"add["&i&"]")&="k_branch")			cmd=cmd&",c1";//Sucursal donde está dado de alta					else if	(getXml(xmlInput,"add["&i&"]")&="k_addr")				cmd=cmd&",c4";//Calle y el número de la dirección					else if	(getXml(xmlInput,"add["&i&"]")&="k_addr2")			cmd=cmd&",c5";//Colonia donde está el cliente					else if	(getXml(xmlInput,"add["&i&"]")&="k_addr3")			cmd=cmd&",c6";//Calle y el número de la dirección					else if	(getXml(xmlInput,"add["&i&"]")&="k_tel1")				cmd=cmd&",c7";//Número de su teléfono					else if	(getXml(xmlInput,"add["&i&"]")&="k_tel2")				cmd=cmd&",c8";//Segundo número telefónico					else if	(getXml(xmlInput,"add["&i&"]")&="k_tel3")				cmd=cmd&",c9";//Número del FAX					else if	(getXml(xmlInput,"add["&i&"]")&="k_tin")				cmd=cmd&",c10";//RFC					else if	(getXml(xmlInput,"add["&i&"]")&="k_web")				cmd=cmd&",c11";//Dirección de Internet					else if	(getXml(xmlInput,"add["&i&"]")&="k_trader")			cmd=cmd&",c12";//Clave del vendedor que lo atiende					else if	(getXml(xmlInput,"add["&i&"]")&="k_group")			cmd=cmd&",c13";//Clave del grupo al que pertenece					else if	(getXml(xmlInput,"add["&i&"]")&="k_zone")				cmd=cmd&",c14";//Clave de la zona donde se ubica					else if	(getXml(xmlInput,"add["&i&"]")&="k_crdlimit")		cmd=cmd&",c15";//Límite de crédito asignado					else if	(getXml(xmlInput,"add["&i&"]")&="k_dayscred")		cmd=cmd&",c16";//Plazo de crédito que se le dá					else if	(getXml(xmlInput,"add["&i&"]")&="k_discount1")		cmd=cmd&",c17";//Descuento que ordinariamente se le dá (%)					else if	(getXml(xmlInput,"add["&i&"]")&="k_discount2")		cmd=cmd&",c18";//Segundo descuento porcentual					else if	(getXml(xmlInput,"add["&i&"]")&="k_discount3")		cmd=cmd&",c19";//Tercer descuento porcentual					else if	(getXml(xmlInput,"add["&i&"]")&="k_revday")			cmd=cmd&",c20";//Día de revisión					else if	(getXml(xmlInput,"add["&i&"]")&="k_revhour")			cmd=cmd&",c21";//Hora de revisión					else if	(getXml(xmlInput,"add["&i&"]")&="k_payday")			cmd=cmd&",c22";//Día de pago					else if	(getXml(xmlInput,"add["&i&"]")&="k_payhour")			cmd=cmd&",c23";//Hora de pago					else if	(getXml(xmlInput,"add["&i&"]")&="k_delivery1")		cmd=cmd&",c24";//Lugar de entrega de mercancía					else if	(getXml(xmlInput,"add["&i&"]")&="k_delivery2")		cmd=cmd&",c25";//Lugar de entrega de mercancía					else if	(getXml(xmlInput,"add["&i&"]")&="k_delivery3")		cmd=cmd&",c26";//Lugar de entrega de mercancía					else if	(getXml(xmlInput,"add["&i&"]")&="k_zipcode")			cmd=cmd&",c27";//Código postal					else if	(getXml(xmlInput,"add["&i&"]")&="k_commission")		cmd=cmd&",c28";//Comisión porcentual					else if	(getXml(xmlInput,"add["&i&"]")&="k_commission2")	cmd=cmd&",c29";//Comisión porcentual sobre cobranza					else if	(getXml(xmlInput,"add["&i&"]")&="k_id")				cmd=cmd&",c30";//Teclee el CURP del Cliente				}				cmd=cmd&max;				kdb.table(cmd);				kdb.exec();				for(var i=0,n=kdb.N("dat");i<n;i++) {					setXml(xmlOutput,"Customer["&i&"]","k_code",kdb.get("dat","r"&i,"c2"));//Clave del cliente					setXml(xmlOutput,"Customer["&i&"]","k_dscr",kdb.get("dat","r"&i,"c3"));//Nombre del cliente					if(kdb.get("dat","r"&i,"c1")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_branch",kdb.get("dat","r"&i,"c1"));//Sucursal donde está dado de alta					if(kdb.get("dat","r"&i,"c4")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_addr",kdb.get("dat","r"&i,"c4"));//Calle y el número de la dirección					if(kdb.get("dat","r"&i,"c5")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_addr2",kdb.get("dat","r"&i,"c5"));//Colonia donde está el cliente					if(kdb.get("dat","r"&i,"c6")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_addr3",kdb.get("dat","r"&i,"c6"));//Calle y el número de la dirección					if(kdb.get("dat","r"&i,"c7")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_tel1",kdb.get("dat","r"&i,"c7"));//Número de su teléfono					if(kdb.get("dat","r"&i,"c8")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_tel2",kdb.get("dat","r"&i,"c8"));//Segundo número telefónico					if(kdb.get("dat","r"&i,"c9")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_tel3",kdb.get("dat","r"&i,"c9"));//Número del FAX					if(kdb.get("dat","r"&i,"c10")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_tin",kdb.get("dat","r"&i,"c10"));//RFC					if(kdb.get("dat","r"&i,"c11")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_web",kdb.get("dat","r"&i,"c11"));//Dirección de Internet					if(kdb.get("dat","r"&i,"c12")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_trader",kdb.get("dat","r"&i,"c12"));//Clave del vendedor que lo atiende					if(kdb.get("dat","r"&i,"c13")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_group",kdb.get("dat","r"&i,"c13"));//Clave del grupo al que pertenece					if(kdb.get("dat","r"&i,"c14")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_zone",kdb.get("dat","r"&i,"c14"));//Clave de la zona donde se ubica					if(kdb.get("dat","r"&i,"c15")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_crdlimit",kdb.get("dat","r"&i,"c15"));//Límite de crédito asignado					if(kdb.get("dat","r"&i,"c16")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_dayscred",kdb.get("dat","r"&i,"c16"));//Plazo de crédito que se le dá					if(kdb.get("dat","r"&i,"c17")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_discount1",kdb.get("dat","r"&i,"c17"));//Descuento que ordinariamente se le dá (%)					if(kdb.get("dat","r"&i,"c18")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_discount2",kdb.get("dat","r"&i,"c18"));//Segundo descuento porcentual					if(kdb.get("dat","r"&i,"c19")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_discount3",kdb.get("dat","r"&i,"c19"));//Tercer descuento porcentual					if(kdb.get("dat","r"&i,"c20")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_revday",kdb.get("dat","r"&i,"c20"));//Día de revisión					if(kdb.get("dat","r"&i,"c21")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_revhour",kdb.get("dat","r"&i,"c21"));//Hora de revisión					if(kdb.get("dat","r"&i,"c22")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_payday",kdb.get("dat","r"&i,"c22"));//Día de pago					if(kdb.get("dat","r"&i,"c23")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_payhour",kdb.get("dat","r"&i,"c23"));//Hora de pago					if(kdb.get("dat","r"&i,"c24")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_delivery1",kdb.get("dat","r"&i,"c24"));//Lugar de entrega de mercancía					if(kdb.get("dat","r"&i,"c25")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_delivery2",kdb.get("dat","r"&i,"c25"));//Lugar de entrega de mercancía					if(kdb.get("dat","r"&i,"c26")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_delivery3",kdb.get("dat","r"&i,"c26"));//Lugar de entrega de mercancía					if(kdb.get("dat","r"&i,"c27")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_zipcode",kdb.get("dat","r"&i,"c27"));//Código postal					if(kdb.get("dat","r"&i,"c28")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_commission",kdb.get("dat","r"&i,"c28"));//Comisión porcentual					if(kdb.get("dat","r"&i,"c29")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_commission2",kdb.get("dat","r"&i,"c29"));//Comisión porcentual sobre cobranza					if(kdb.get("dat","r"&i,"c30")&!"")	setXml(xmlOutput,"Customer["&i&"]","k_id",kdb.get("dat","r"&i,"c30"));//Teclee el CURP del Cliente				}				kdb.close();							return xmlOutput;			}						fun GetCustomer(code) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<getCustomerRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<k_code>...</k_code>					</getCustomerRequest>									</soap:Body>			</soap:Envelope>					*/				var xmlOutput;				kdb.connect();				kdb.open("c,kdud");				kdb.search("dat,c,1,0,'"&code&"',&,c1...c30");				kdb.exec();				if(kdb.ok("dat")) {					setXml(xmlOutput,"ok","1");					setXml(xmlOutput,"Customer","k_branch",		kdb.get("dat","c1"));//Sucursal donde está dado de alta					setXml(xmlOutput,"Customer","k_code",			kdb.get("dat","c2"));//Clave del cliente					setXml(xmlOutput,"Customer","k_dscr",			kdb.get("dat","c3"));//Nombre del cliente					setXml(xmlOutput,"Customer","k_addr",			kdb.get("dat","c4"));//Calle y el número de la dirección					setXml(xmlOutput,"Customer","k_addr2",			kdb.get("dat","c5"));//Colonia donde está el cliente					setXml(xmlOutput,"Customer","k_addr3",			kdb.get("dat","c6"));//Calle y el número de la dirección					setXml(xmlOutput,"Customer","k_tel1",			kdb.get("dat","c7"));//Número de su teléfono					setXml(xmlOutput,"Customer","k_tel2",			kdb.get("dat","c8"));//Segundo número telefónico					setXml(xmlOutput,"Customer","k_tel3",			kdb.get("dat","c9"));//Número del FAX					setXml(xmlOutput,"Customer","k_tin",			kdb.get("dat","c10"));//RFC					setXml(xmlOutput,"Customer","k_web",			kdb.get("dat","c11"));//Dirección de Internet					setXml(xmlOutput,"Customer","k_trader",		kdb.get("dat","c12"));//Clave del vendedor que lo atiende					setXml(xmlOutput,"Customer","k_group",			kdb.get("dat","c13"));//Clave del grupo al que pertenece					setXml(xmlOutput,"Customer","k_zone",			kdb.get("dat","c14"));//Clave de la zona donde se ubica					setXml(xmlOutput,"Customer","k_crdlimit",		kdb.get("dat","c15"));//Límite de crédito asignado					setXml(xmlOutput,"Customer","k_dayscred",		kdb.get("dat","c16"));//Plazo de crédito que se le dá					setXml(xmlOutput,"Customer","k_discount1",	kdb.get("dat","c17"));//Descuento que ordinariamente se le dá (%)					setXml(xmlOutput,"Customer","k_discount2",	kdb.get("dat","c18"));//Segundo descuento porcentual					setXml(xmlOutput,"Customer","k_discount3",	kdb.get("dat","c19"));//Tercer descuento porcentual					setXml(xmlOutput,"Customer","k_revday",		kdb.get("dat","c20"));//Día de revisión					setXml(xmlOutput,"Customer","k_revhour",		kdb.get("dat","c21"));//Hora de revisión					setXml(xmlOutput,"Customer","k_payday",		kdb.get("dat","c22"));//Día de pago					setXml(xmlOutput,"Customer","k_payhour",		kdb.get("dat","c23"));//Hora de pago					setXml(xmlOutput,"Customer","k_delivery1",	kdb.get("dat","c24"));//Lugar de entrega de mercancía					setXml(xmlOutput,"Customer","k_delivery2",	kdb.get("dat","c25"));//Lugar de entrega de mercancía					setXml(xmlOutput,"Customer","k_delivery3",	kdb.get("dat","c26"));//Lugar de entrega de mercancía					setXml(xmlOutput,"Customer","k_zipcode",		kdb.get("dat","c27"));//Código postal					setXml(xmlOutput,"Customer","k_commission",	kdb.get("dat","c28"));//Comisión porcentual					setXml(xmlOutput,"Customer","k_commission2",	kdb.get("dat","c29"));//Comisión porcentual sobre cobranza					setXml(xmlOutput,"Customer","k_id",				kdb.get("dat","c30"));//Teclee el CURP del Cliente				} else {setXml(xmlOutput,"ok","0"); setXml(xmlOutput,"err","Customer not found");}				kdb.close();							return xmlOutput;							}						fun SetCustomer(customer) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<setCustomerRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<Customer>							<k_branch>...</k_branch>							<k_code>...</k_code>							<k_dscr>...</k_dscr>							<k_addr>...</k_addr>							<k_addr2>...</k_addr2>							<k_addr3>...</k_addr3>							<k_tel1>...</k_tel1>							<k_tel2>...</k_tel2>							<k_tel3>...</k_tel3>							<k_tin>...</k_tin>							<k_web>...</k_web>							<k_trader>...</k_trader>							<k_group>...</k_group>							<k_zone>...</k_zone>							<k_crdlimit>...</k_crdlimit>							<k_dayscred>...</k_dayscred>							<k_discount1>...</k_discount1>							<k_discount2>...</k_discount2>							<k_discount3>...</k_discount3>							<k_revday>...</k_revday>							<k_revhour>...</k_revhour>							<k_payday>...</k_payday>							<k_payhour>...</k_payhour>							<k_delivery1>...</k_delivery1>							<k_delivery2>...</k_delivery2>							<k_delivery3>...</k_delivery3>							<k_zipcode>...</k_zipcode>							<k_commission>...</k_commission>							<k_commission2>...</k_commission2>							<k_id>...</k_id>						</Customer>					</setCustomerRequest>				</soap:Body>			</soap:Envelope>					*/				var cmd="dat,c,1,'"&getXml(customer,"k_code")&"',&";				var xmlOutput;				kdb.connect();				kdb.open("c,kdud");							var values;				if(getXml(customer,"k_branch")&!"")			values=values&",1,'"&getXml(customer,"k_branch")&"'";				if(getXml(customer,"k_dscr")&!"")			values=values&",3,'"&getXml(customer,"k_dscr")&"'";				if(getXml(customer,"k_addr")&!"")			values=values&",4,'"&getXml(customer,"k_addr")&"'";				if(getXml(customer,"k_addr2")&!"")			values=values&",5,'"&getXml(customer,"k_addr2")&"'";				if(getXml(customer,"k_addr3")&!"")			values=values&",6,'"&getXml(customer,"k_addr3")&"'";				if(getXml(customer,"k_tel1")&!"")			values=values&",7,'"&getXml(customer,"k_tel1")&"'";				if(getXml(customer,"k_tel2")&!"")			values=values&",8,'"&getXml(customer,"k_tel2")&"'";				if(getXml(customer,"k_tel3")&!"")			values=values&",9,'"&getXml(customer,"k_tel3")&"'";				if(getXml(customer,"k_tin")&!"")				values=values&",10,'"&getXml(customer,"k_tin")&"'";				if(getXml(customer,"k_web")&!"")				values=values&",11,'"&getXml(customer,"k_web")&"'";				if(getXml(customer,"k_trader")&!"")			values=values&",12,'"&getXml(customer,"k_trader")&"'";				if(getXml(customer,"k_group")&!"")			values=values&",13,'"&getXml(customer,"k_group")&"'";				if(getXml(customer,"k_zone")&!"")			values=values&",14,'"&getXml(customer,"k_zone")&"'";				if(getXml(customer,"k_crdlimit")&!"")		values=values&",15,'"&getXml(customer,"k_crdlimit")&"'";				if(getXml(customer,"k_dayscred")&!"")		values=values&",16,'"&getXml(customer,"k_dayscred")&"'";				if(getXml(customer,"k_discount1")&!"")		values=values&",17,'"&getXml(customer,"k_discount1")&"'";				if(getXml(customer,"k_discount2")&!"")		values=values&",18,'"&getXml(customer,"k_discount2")&"'";				if(getXml(customer,"k_discount3")&!"")		values=values&",19,'"&getXml(customer,"k_discount3")&"'";				if(getXml(customer,"k_revday")&!"")			values=values&",20,'"&getXml(customer,"k_revday")&"'";				if(getXml(customer,"k_revhour")&!"")		values=values&",21,'"&getXml(customer,"k_revhour")&"'";				if(getXml(customer,"k_payday")&!"")			values=values&",22,'"&getXml(customer,"k_payday")&"'";				if(getXml(customer,"k_payhour")&!"")		values=values&",23,'"&getXml(customer,"k_payhour")&"'";				if(getXml(customer,"k_delivery1")&!"")		values=values&",24,'"&getXml(customer,"k_delivery1")&"'";				if(getXml(customer,"k_delivery2")&!"")		values=values&",25,'"&getXml(customer,"k_delivery2")&"'";				if(getXml(customer,"k_delivery3")&!"")		values=values&",26,'"&getXml(customer,"k_delivery3")&"'";				if(getXml(customer,"k_zipcode")&!"")		values=values&",27,'"&getXml(customer,"k_zipcode")&"'";				if(getXml(customer,"k_commission")&!"")	values=values&",28,'"&getXml(customer,"k_commission")&"'";				if(getXml(customer,"k_commission2")&!"")	values=values&",29,'"&getXml(customer,"k_commission2")&"'";				if(getXml(customer,"k_id")&!"")				values=values&",30,'"&getXml(customer,"k_id")&"'";				cmd=cmd&values;				kdb.write(cmd);				kdb.exec();						kdb.close();				setXml(xmlOutput,"ok","1");				setXml(xmlOutput,"message","Successful update");				return xmlOutput;				}						fun CustomerBalance(xmlInput) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<customerBalanceRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<Balance>							<k_branch>...</k_branch>							<k_code>...</k_code>													<k_date>...</k_date>							<k_advance>...</k_advance>						</Balance>					</customerBalanceRequest>								</soap:Body>			</soap:Envelope>							*/				var xmlOutput;				kdb.connect();				kdb.sp("k_cxc","datDocBalance",getXml(xmlInput,"k_branch"),getXml(xmlInput,"k_code"),(getXml(xmlInput,"k_advance")&="")?0:getXml(xmlInput,"k_advance"),getXml(xmlInput,"k_date"));				kdb.sp("k_SaldoCli","datCustBalance",getXml(xmlInput,"k_code"));				kdb.exec();				setXml(xmlOutput,"k_limC",kdb.get("datCustBalance","k_limC"));				setXml(xmlOutput,"k_saldoC",kdb.get("datCustBalance","k_saldoC"));				setXml(xmlOutput,"k_disp",kdb.get("datCustBalance","k_limC")-kdb.get("datCustBalance","k_saldoC"));				for(var i=0,n=kdb.N("datDocBalance");i<n;i++) {					setXml(xmlOutput,"Doc["&i&"]",kdb.get("datDocBalance","r"&i));				}				kdb.close();				return xmlOutput;			}						fun UpdateCustomer(xmlInput) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<Login>						<user>...</user>						<pass>...</pass>						<datasource>...</datasource>					</Login>					<Update>						<k_date>...</k_date>						<k_code>...</k_code>												<field>...</field>					</Update>								</soap:Body>			</soap:Envelope>							*/				var xmlOutput;				var lim="";				var comma="";				kdb.connect();				kdb.open("c,kdlogmov");				for(var i=0,n=nXml(xmlInput);i<n;i++) {					if			(getXml(xmlInput,"field["&i&"]")&="k_branch")			{lim=lim&comma&"1"; comma=",";}//Sucursal donde está dado de alta										else if	(getXml(xmlInput,"field["&i&"]")&="k_code")				{lim=lim&comma&"2"; comma=",";}//Clave del cliente					else if	(getXml(xmlInput,"field["&i&"]")&="k_dscr")				{lim=lim&comma&"3"; comma=",";}//Nombre del cliente					else if	(getXml(xmlInput,"field["&i&"]")&="k_addr")				{lim=lim&comma&"4"; comma=",";}//Calle y el número de la dirección					else if	(getXml(xmlInput,"field["&i&"]")&="k_addr2")				{lim=lim&comma&"5"; comma=",";}//Colonia donde está el cliente					else if	(getXml(xmlInput,"field["&i&"]")&="k_addr3")				{lim=lim&comma&"6"; comma=",";}//Calle y el número de la dirección					else if	(getXml(xmlInput,"field["&i&"]")&="k_tel1")				{lim=lim&comma&"7"; comma=",";}//Número de su teléfono					else if	(getXml(xmlInput,"field["&i&"]")&="k_tel2")				{lim=lim&comma&"8"; comma=",";}//Segundo número telefónico					else if	(getXml(xmlInput,"field["&i&"]")&="k_tel3")				{lim=lim&comma&"9"; comma=",";}//Número del FAX					else if	(getXml(xmlInput,"field["&i&"]")&="k_tin")				{lim=lim&comma&"10"; comma=",";}//RFC					else if	(getXml(xmlInput,"field["&i&"]")&="k_web")				{lim=lim&comma&"11"; comma=",";}//Dirección de Internet					else if	(getXml(xmlInput,"field["&i&"]")&="k_trader")			{lim=lim&comma&"12"; comma=",";}//Clave del vendedor que lo atiende					else if	(getXml(xmlInput,"field["&i&"]")&="k_group")				{lim=lim&comma&"13"; comma=",";}//Clave del grupo al que pertenece					else if	(getXml(xmlInput,"field["&i&"]")&="k_zone")				{lim=lim&comma&"14"; comma=",";}//Clave de la zona donde se ubica					else if	(getXml(xmlInput,"field["&i&"]")&="k_crdlimit")			{lim=lim&comma&"15"; comma=",";}//Límite de crédito asignado					else if	(getXml(xmlInput,"field["&i&"]")&="k_dayscred")			{lim=lim&comma&"16"; comma=",";}//Plazo de crédito que se le dá					else if	(getXml(xmlInput,"field["&i&"]")&="k_discount1")		{lim=lim&comma&"17"; comma=",";}//Descuento que ordinariamente se le dá (%)					else if	(getXml(xmlInput,"field["&i&"]")&="k_discount2")		{lim=lim&comma&"18"; comma=",";}//Segundo descuento porcentual					else if	(getXml(xmlInput,"field["&i&"]")&="k_discount3")		{lim=lim&comma&"19"; comma=",";}//Tercer descuento porcentual					else if	(getXml(xmlInput,"field["&i&"]")&="k_revday")			{lim=lim&comma&"20"; comma=",";}//Día de revisión					else if	(getXml(xmlInput,"field["&i&"]")&="k_revhour")			{lim=lim&comma&"21"; comma=",";}//Hora de revisión					else if	(getXml(xmlInput,"field["&i&"]")&="k_payday")			{lim=lim&comma&"22"; comma=",";}//Día de pago					else if	(getXml(xmlInput,"field["&i&"]")&="k_payhour")			{lim=lim&comma&"23"; comma=",";}//Hora de pago					else if	(getXml(xmlInput,"field["&i&"]")&="k_delivery1")		{lim=lim&comma&"24"; comma=",";}//Lugar de entrega de mercancía					else if	(getXml(xmlInput,"field["&i&"]")&="k_delivery2")		{lim=lim&comma&"25"; comma=",";}//Lugar de entrega de mercancía					else if	(getXml(xmlInput,"field["&i&"]")&="k_delivery3")		{lim=lim&comma&"26"; comma=",";}//Lugar de entrega de mercancía					else if	(getXml(xmlInput,"field["&i&"]")&="k_zipcode")			{lim=lim&comma&"27"; comma=",";}//Código postal					else if	(getXml(xmlInput,"field["&i&"]")&="k_commission")		{lim=lim&comma&"28"; comma=",";}//Comisión porcentual					else if	(getXml(xmlInput,"field["&i&"]")&="k_commission2")		{lim=lim&comma&"29"; comma=",";}//Comisión porcentual sobre cobranza					else if	(getXml(xmlInput,"field["&i&"]")&="k_id")					{lim=lim&comma&"30"; comma=",";}//Teclee el CURP del Cliente				}				if(lim&!"")									kdb.lim("c6 in "&lim);				if(getXml(xmlInput,"k_date")&!"")	kdb.lim("c2>='"&getXml(xmlInput,"k_date")&"'");				if(getXml(xmlInput,"k_code")&!"")	kdb.lim("c9='"&getXml(xmlInput,"k_code")&"'");				kdb.table("dat,c,4,'kdud',&,c5,c6,c9");				kdb.exec();				for(var i=0,n=kdb.N("dat");i<n;i++) {					if(kdb.get("dat","r"&i,"c5")&="1")				setXml(xmlOutput,"Customer["&i&"]","k_branch",kdb.get("dat","r"&i,"c6"));//Sucursal donde está dado de alta					else if(kdb.get("dat","r"&i,"c5")&="2")		setXml(xmlOutput,"Customer["&i&"]","k_code",kdb.get("dat","r"&i,"c6"));//Clave del cliente					else if(kdb.get("dat","r"&i,"c5")&="3")		setXml(xmlOutput,"Customer["&i&"]","k_dscr",kdb.get("dat","r"&i,"c6"));//Nombre del cliente					else if(kdb.get("dat","r"&i,"c5")&="4")		setXml(xmlOutput,"Customer["&i&"]","k_addr",kdb.get("dat","r"&i,"c6"));//Calle y el número de la dirección					else if(kdb.get("dat","r"&i,"c5")&="5")		setXml(xmlOutput,"Customer["&i&"]","k_addr2",kdb.get("dat","r"&i,"c6"));//Colonia donde está el cliente					else if(kdb.get("dat","r"&i,"c5")&="6")		setXml(xmlOutput,"Customer["&i&"]","k_addr3",kdb.get("dat","r"&i,"c6"));//Calle y el número de la dirección					else if(kdb.get("dat","r"&i,"c5")&="7")		setXml(xmlOutput,"Customer["&i&"]","k_tel1",kdb.get("dat","r"&i,"c6"));//Número de su teléfono					else if(kdb.get("dat","r"&i,"c5")&="8")		setXml(xmlOutput,"Customer["&i&"]","k_tel2",kdb.get("dat","r"&i,"c6"));//Segundo número telefónico					else if(kdb.get("dat","r"&i,"c5")&="9")		setXml(xmlOutput,"Customer["&i&"]","k_tel3",kdb.get("dat","r"&i,"c6"));//Número del FAX					else if(kdb.get("dat","r"&i,"c5")&="10")		setXml(xmlOutput,"Customer["&i&"]","k_tin",kdb.get("dat","r"&i,"c6"));//RFC					else if(kdb.get("dat","r"&i,"c5")&="11")		setXml(xmlOutput,"Customer["&i&"]","k_web",kdb.get("dat","r"&i,"c6"));//Dirección de Internet					else if(kdb.get("dat","r"&i,"c5")&="12")		setXml(xmlOutput,"Customer["&i&"]","k_trader",kdb.get("dat","r"&i,"c6"));//Clave del vendedor que lo atiende					else if(kdb.get("dat","r"&i,"c5")&="13")		setXml(xmlOutput,"Customer["&i&"]","k_group",kdb.get("dat","r"&i,"c6"));//Clave del grupo al que pertenece					else if(kdb.get("dat","r"&i,"c5")&="14")		setXml(xmlOutput,"Customer["&i&"]","k_zone",kdb.get("dat","r"&i,"c6"));//Clave de la zona donde se ubica					else if(kdb.get("dat","r"&i,"c5")&="15")		setXml(xmlOutput,"Customer["&i&"]","k_crdlimit",kdb.get("dat","r"&i,"c6"));//Límite de crédito asignado					else if(kdb.get("dat","r"&i,"c5")&="16")		setXml(xmlOutput,"Customer["&i&"]","k_dayscred",kdb.get("dat","r"&i,"c6"));//Plazo de crédito que se le dá					else if(kdb.get("dat","r"&i,"c5")&="17")		setXml(xmlOutput,"Customer["&i&"]","k_discount1",kdb.get("dat","r"&i,"c6"));//Descuento que ordinariamente se le dá (%)					else if(kdb.get("dat","r"&i,"c5")&="18")		setXml(xmlOutput,"Customer["&i&"]","k_discount2",kdb.get("dat","r"&i,"c6"));//Segundo descuento porcentual					else if(kdb.get("dat","r"&i,"c5")&="19")		setXml(xmlOutput,"Customer["&i&"]","k_discount3",kdb.get("dat","r"&i,"c6"));//Tercer descuento porcentual					else if(kdb.get("dat","r"&i,"c5")&="20")		setXml(xmlOutput,"Customer["&i&"]","k_revday",kdb.get("dat","r"&i,"c6"));//Día de revisión					else if(kdb.get("dat","r"&i,"c5")&="21")		setXml(xmlOutput,"Customer["&i&"]","k_revhour",kdb.get("dat","r"&i,"c6"));//Hora de revisión					else if(kdb.get("dat","r"&i,"c5")&="22")		setXml(xmlOutput,"Customer["&i&"]","k_payday",kdb.get("dat","r"&i,"c6"));//Día de pago					else if(kdb.get("dat","r"&i,"c5")&="23")		setXml(xmlOutput,"Customer["&i&"]","k_payhour",kdb.get("dat","r"&i,"c6"));//Hora de pago					else if(kdb.get("dat","r"&i,"c5")&="24")		setXml(xmlOutput,"Customer["&i&"]","k_delivery1",kdb.get("dat","r"&i,"c6"));//Lugar de entrega de mercancía					else if(kdb.get("dat","r"&i,"c5")&="25")		setXml(xmlOutput,"Customer["&i&"]","k_delivery2",kdb.get("dat","r"&i,"c6"));//Lugar de entrega de mercancía					else if(kdb.get("dat","r"&i,"c5")&="26")		setXml(xmlOutput,"Customer["&i&"]","k_delivery3",kdb.get("dat","r"&i,"c6"));//Lugar de entrega de mercancía					else if(kdb.get("dat","r"&i,"c5")&="27")		setXml(xmlOutput,"Customer["&i&"]","k_zipcode",kdb.get("dat","r"&i,"c6"));//Código postal					else if(kdb.get("dat","r"&i,"c5")&="28")		setXml(xmlOutput,"Customer["&i&"]","k_commission",kdb.get("dat","r"&i,"c6"));//Comisión porcentual					else if(kdb.get("dat","r"&i,"c5")&="29")		setXml(xmlOutput,"Customer["&i&"]","k_commission2",kdb.get("dat","r"&i,"c6"));//Comisión porcentual sobre cobranza					else if(kdb.get("dat","r"&i,"c5")&="30")		setXml(xmlOutput,"Customer["&i&"]","k_id",kdb.get("dat","r"&i,"c6"));//Teclee el CURP del Cliente				}				kdb.close();							return xmlOutput;			}			// S  E  L  L  E  R  S			fun SellerSearch(xmlInput) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<searchRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<Search>							<text>...</text>							<searchBy>...</searchBy>							<max>...</max>							<add>...</add>							</Search>					</searchRequest>				</soap:Body>			</soap:Envelope>							*/				var xmlOutput;				var cmd="dat,s,";				var text=getXml(xmlInput,"text");				var searchBy=getXml(xmlInput,"searchBy");/*code,dscr or extended*/				var max=(getXml(xmlInput,"max")&!"") ? (",&,max,"&getXml(xmlInput,"max")):"";				kdb.connect();				kdb.open("s,kduv");				if(searchBy&="extended" && text&!"")	kdb.lim("'"&text&"' inside s2,s3");				else if(searchBy&="dscr" && text&!"")	kdb.lim("'"&text&"' inside s3");				else if(searchBy&="code" && text&!"")	kdb.lim("'"&text&"' inside s2");																	if(searchBy&="dscr")		cmd=cmd&"2,&,s2,s3";				else							cmd=cmd&"1,&,s2,s3";				for(var i=0,n=nXml(xmlInput);i<n;i++) {					if			(getXml(xmlInput,"add["&i&"]")&="k_branch")			cmd=cmd&",s1";//Sucursal donde está dado de alta					else if	(getXml(xmlInput,"add["&i&"]")&="k_comms")			cmd=cmd&",s4";//Comisión procentual sobre venta					else if	(getXml(xmlInput,"add["&i&"]")&="k_comme")			cmd=cmd&",s5";//Comisión procentual sobre utilidad					else if	(getXml(xmlInput,"add["&i&"]")&="k_commc")			cmd=cmd&",s6";//Comisión procentual sobre cobro					else if	(getXml(xmlInput,"add["&i&"]")&="k_commp")			cmd=cmd&",s7";//Comisión procentual sobre producto					else if	(getXml(xmlInput,"add["&i&"]")&="k_tel1")				cmd=cmd&",s9";//Número de su teléfono					else if	(getXml(xmlInput,"add["&i&"]")&="k_tel2")				cmd=cmd&",s10";//Segundo número telefónico					else if	(getXml(xmlInput,"add["&i&"]")&="k_mobile")			cmd=cmd&",s11";//Celular					else if	(getXml(xmlInput,"add["&i&"]")&="k_nextel")			cmd=cmd&",s12";//Nextel					else if	(getXml(xmlInput,"add["&i&"]")&="k_mail")				cmd=cmd&",s14";//Correo electrónico					else if	(getXml(xmlInput,"add["&i&"]")&="k_mail2")			cmd=cmd&",s15";//Correo electrónico2					else if	(getXml(xmlInput,"add["&i&"]")&="k_user")				cmd=cmd&",s16";//Usuario KEPLER					else if	(getXml(xmlInput,"add["&i&"]")&="k_supervisor")		cmd=cmd&",s17";//Supervisor					else if	(getXml(xmlInput,"add["&i&"]")&="k_supervisorf")	cmd=cmd&",s18";//Bandera de supervisor					else if	(getXml(xmlInput,"add["&i&"]")&="k_twitter")			cmd=cmd&",s19";//Twitter					else if	(getXml(xmlInput,"add["&i&"]")&="k_facebook")		cmd=cmd&",s20";//Facebook					else if	(getXml(xmlInput,"add["&i&"]")&="k_linkedin")		cmd=cmd&",s21";//Linkedin				}				cmd=cmd&max;				kdb.table(cmd);				kdb.exec();				for(var i=0,n=kdb.N("dat");i<n;i++) {					setXml(xmlOutput,"Seller["&i&"]","k_code",kdb.get("dat","r"&i,"s2"));//Clave del vendedor					setXml(xmlOutput,"Seller["&i&"]","k_dscr",kdb.get("dat","r"&i,"s3"));//Nombre del vendedor					if(kdb.get("dat","r"&i,"c1")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_branch",kdb.get("dat","r"&i,"s1"));//Sucursal donde está dado de alta					if(kdb.get("dat","r"&i,"c4")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_comms",kdb.get("dat","r"&i,"s4"));//Comisión procentual sobre venta					if(kdb.get("dat","r"&i,"c5")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_comme",kdb.get("dat","r"&i,"s5"));//Comisión procentual sobre utilidad					if(kdb.get("dat","r"&i,"c6")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_commc",kdb.get("dat","r"&i,"s6"));//Comisión procentual sobre cobro					if(kdb.get("dat","r"&i,"c7")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_commp",kdb.get("dat","r"&i,"s7"));//Comisión procentual sobre producto					if(kdb.get("dat","r"&i,"c9")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_tel1",kdb.get("dat","r"&i,"s9"));//Número de su teléfono					if(kdb.get("dat","r"&i,"c10")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_tel2",kdb.get("dat","r"&i,"s10"));//Segundo número telefónico					if(kdb.get("dat","r"&i,"c11")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_mobile",kdb.get("dat","r"&i,"s11"));//Celular					if(kdb.get("dat","r"&i,"c12")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_nextel",kdb.get("dat","r"&i,"s12"));//Nextel					if(kdb.get("dat","r"&i,"c14")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_mail",kdb.get("dat","r"&i,"s14"));//Correo electrónico					if(kdb.get("dat","r"&i,"c15")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_mail2",kdb.get("dat","r"&i,"s15"));//Correo electrónico2					if(kdb.get("dat","r"&i,"c16")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_user",kdb.get("dat","r"&i,"s16"));//Usuario KEPLER					if(kdb.get("dat","r"&i,"c17")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_supervisor",kdb.get("dat","r"&i,"s17"));//Supervisor					if(kdb.get("dat","r"&i,"c18")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_supervisorf",kdb.get("dat","r"&i,"s18"));//Bandera de supervisor					if(kdb.get("dat","r"&i,"c19")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_twitter",kdb.get("dat","r"&i,"s19"));//Twitter					if(kdb.get("dat","r"&i,"c20")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_facebook",kdb.get("dat","r"&i,"s20"));//Facebook					if(kdb.get("dat","r"&i,"c21")&!"")	setXml(xmlOutput,"Seller["&i&"]","k_linkedin",kdb.get("dat","r"&i,"s21"));//Linkedin				}				kdb.close();							return xmlOutput;			}						fun GetSeller(code) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<getSellerRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<k_code>...</k_code>					</getSellerRequest>									</soap:Body>			</soap:Envelope>					*/				var xmlOutput;				kdb.connect();				kdb.open("s,kduv");				kdb.search("dat,s,1,0,'"&code&"',&,s1...s21");				kdb.exec();				if(kdb.ok("dat")) {					setXml(xmlOutput,"ok","1");					setXml(xmlOutput,"Seller","k_branch",			kdb.get("dat","s1"));//Sucursal donde está dado de alta					setXml(xmlOutput,"Seller","k_code",				kdb.get("dat","s2"));//Clave del vendedor					setXml(xmlOutput,"Seller","k_dscr",				kdb.get("dat","s3"));//Nombre del vendedor					setXml(xmlOutput,"Seller","k_comms",			kdb.get("dat","s4"));//Comisión procentual sobre venta					setXml(xmlOutput,"Seller","k_comme",			kdb.get("dat","s5"));//Comisión procentual sobre utilidad					setXml(xmlOutput,"Seller","k_commc",			kdb.get("dat","s6"));//Comisión procentual sobre cobro					setXml(xmlOutput,"Seller","k_commp",			kdb.get("dat","s7"));//Comisión procentual sobre producto					setXml(xmlOutput,"Seller","k_tel1",				kdb.get("dat","s9"));//Número de su teléfono					setXml(xmlOutput,"Seller","k_tel2",				kdb.get("dat","s10"));//Segundo número telefónico					setXml(xmlOutput,"Seller","k_mobile",			kdb.get("dat","s11"));//Celular					setXml(xmlOutput,"Seller","k_nextel",			kdb.get("dat","s12"));//Nextel					setXml(xmlOutput,"Seller","k_mail",				kdb.get("dat","s14"));//Correo electrónico					setXml(xmlOutput,"Seller","k_mail2",			kdb.get("dat","s15"));//Correo electrónico2					setXml(xmlOutput,"Seller","k_user",				kdb.get("dat","s16"));//Usuario KEPLER					setXml(xmlOutput,"Seller","k_supervisor",		kdb.get("dat","s17"));//Supervisor					setXml(xmlOutput,"Seller","k_supervisorf",	kdb.get("dat","s18"));//Bandera de supervisor					setXml(xmlOutput,"Seller","k_twitter",			kdb.get("dat","s19"));//Twitter					setXml(xmlOutput,"Seller","k_facebook",		kdb.get("dat","s20"));//Facebook					setXml(xmlOutput,"Seller","k_linkedin",		kdb.get("dat","s21"));//Linkedin				} else {setXml(xmlOutput,"ok","0"); setXml(xmlOutput,"err","Seller not found");}				kdb.close();							return xmlOutput;							}			//	I	T	E	M	S						fun ItemSearch(xmlInput) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<searchRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<Search>							<text>...</text>							<searchBy>...</searchBy>							<max>...</max>							<add>...</add>							</Search>					</searchRequest>								</soap:Body>			</soap:Envelope>							*/				var xmlOutput;				var cmd="dat,i,";				var text=getXml(xmlInput,"text");				var searchBy=getXml(xmlInput,"searchBy");/*code,dscr or extended*/				var max=(getXml(xmlInput,"max")&!"") ? (",max,"&getXml(xmlInput,"max")):"";				kdb.connect();				kdb.open("i,kdii");				if(searchBy&="extended" && text&!"")	kdb.lim("'"&text&"' inside i1,i2");				else if(searchBy&="dscr" && text&!"")	kdb.lim("'"&text&"' inside i2");				else if(searchBy&="code" && text&!"")	kdb.lim("'"&text&"' inside i1");													if(searchBy&="dscr")		cmd=cmd&"2,&,i1,i2";				else							cmd=cmd&"1,&,i1,i2";				for(var i=0,n=nXml(xmlInput);i<n;i++) {					if			(getXml(xmlInput,"add["&i&"]")&="k_line")					cmd=cmd&",i3";//Línea al que pertenece el producto					else if	(getXml(xmlInput,"add["&i&"]")&="k_type")					cmd=cmd&",i4";//Tipo al que pertenece el producto					else if	(getXml(xmlInput,"add["&i&"]")&="k_grp")					cmd=cmd&",i5";//Grupo al que pertenece el producto					else if	(getXml(xmlInput,"add["&i&"]")&="k_suppliercode")		cmd=cmd&",i6";//Código del proveedor					else if	(getXml(xmlInput,"add["&i&"]")&="k_barcode")				cmd=cmd&",i7";//Código de barras					else if	(getXml(xmlInput,"add["&i&"]")&="k_supplier")			cmd=cmd&",i8";//Clave del proveedor principal					else if	(getXml(xmlInput,"add["&i&"]")&="k_supplier2")			cmd=cmd&",i9";//Clave del proveedor secundario					else if	(getXml(xmlInput,"add["&i&"]")&="k_location")			cmd=cmd&",i10";//Clave de la ubicación dentro del almacén					else if	(getXml(xmlInput,"add["&i&"]")&="k_unit")					cmd=cmd&",i11";//Unidad de medida					else if	(getXml(xmlInput,"add["&i&"]")&="k_unit2")				cmd=cmd&",i12";//Unidad alternativa					else if	(getXml(xmlInput,"add["&i&"]")&="k_factor")				cmd=cmd&",i13";//Factor de conversión=# unidades/unidad alternativa					else if	(getXml(xmlInput,"add["&i&"]")&="k_price")				cmd=cmd&",i14";//Primer precio del producto					else if	(getXml(xmlInput,"add["&i&"]")&="k_price2")				cmd=cmd&",i15";//Segundo precio del producto					else if	(getXml(xmlInput,"add["&i&"]")&="k_price3")				cmd=cmd&",i16";//Tercer precio del producto					else if	(getXml(xmlInput,"add["&i&"]")&="k_price4")				cmd=cmd&",i17";//Cuarto precio del producto					else if	(getXml(xmlInput,"add["&i&"]")&="k_tax")					cmd=cmd&",i18";//IVA porcentual del producto					else if	(getXml(xmlInput,"add["&i&"]")&="k_tax2")					cmd=cmd&",i19";//Impuesto especial sobre bienes y servicios (%)					else if	(getXml(xmlInput,"add["&i&"]")&="k_currency")			cmd=cmd&",i20";//La clave de la moneda de los precios de venta					else if	(getXml(xmlInput,"add["&i&"]")&="k_serial")				cmd=cmd&",i21";//S si requiere número de serie ó N si nó					else if	(getXml(xmlInput,"add["&i&"]")&="k_lot")					cmd=cmd&",i22";//S=control de lotes; F=con fecha; N=no requiere					else if	(getXml(xmlInput,"add["&i&"]")&="k_cost")					cmd=cmd&",i23";//Precio de lista del proveedor					else if	(getXml(xmlInput,"add["&i&"]")&="k_discount")			cmd=cmd&",i24";//Descuento que ordinariamente dá el proveedor					else if	(getXml(xmlInput,"add["&i&"]")&="k_replaces")			cmd=cmd&",i25";//Clave del producto que lo substituye (si es el caso					else if	(getXml(xmlInput,"add["&i&"]")&="k_equivalent")			cmd=cmd&",i26";//Clave del producto equivalente					else if	(getXml(xmlInput,"add["&i&"]")&="k_import")				cmd=cmd&",i27";//S si el producto es de importación					else if	(getXml(xmlInput,"add["&i&"]")&="k_haramtariffcode")	cmd=cmd&",i28";//Fracción arancelaria					else if	(getXml(xmlInput,"add["&i&"]")&="k_dta")					cmd=cmd&",i29";//Porcentaje de DTA					else if	(getXml(xmlInput,"add["&i&"]")&="k_country")				cmd=cmd&",i30";//Clave del pais de origen					else if	(getXml(xmlInput,"add["&i&"]")&="k_costcurr")			cmd=cmd&",i31";//Clave de la moneda de compra					else if	(getXml(xmlInput,"add["&i&"]")&="k_langdscr")			cmd=cmd&",i32";//Descripción del producto en el idioma de origen					else if	(getXml(xmlInput,"add["&i&"]")&="k_invmin")				cmd=cmd&",i33";//Nivel de inventario mínimo					else if	(getXml(xmlInput,"add["&i&"]")&="k_minpurchord")		cmd=cmd&",i34";//Cantidad mínima antes de orden de compra					else if	(getXml(xmlInput,"add["&i&"]")&="k_invmax")				cmd=cmd&",i35";//Nivel de inventario máximo					else if	(getXml(xmlInput,"add["&i&"]")&="k_size")					cmd=cmd&",i36";//Medida ó talla del producto (ó tipo de insumo prod)					else if	(getXml(xmlInput,"add["&i&"]")&="k_smc5")					cmd=cmd&",i37";//Quinta clave de clasificación (talla model color)					else if	(getXml(xmlInput,"add["&i&"]")&="k_smc6