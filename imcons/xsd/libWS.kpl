tem,"k_nsmc")&"'";					//No. de campos del modelo Talla, Modelo y Color				if(getXml(item,"k_draw")&!"")						values=values&",45,'"&getXml(item,"k_draw")&"'";					//Clave del dibujo				if(getXml(item,"k_path")&!"")						values=values&",46,'"&getXml(item,"k_path")&"'";					//Clave de ruta de fabricación				if(getXml(item,"k_englevel")&!"")				values=values&",47,'"&getXml(item,"k_englevel")&"'";				//Nivel de ingenieria				if(getXml(item,"k_nat")&!"")						values=values&",48,'"&getXml(item,"k_nat")&"'";						//F=Fabricación M=Maquila C=Compra A=FyC N=NoInventar				if(getXml(item,"k_mov")&!"")						values=values&",49,'"&getXml(item,"k_mov")&"'";						//A=Alto Movimiento B=Mediano C=Bajo				if(getXml(item,"k_inidate")&!"")					values=values&",50,'"&getXml(item,"k_inidate")&"'";				//Fecha de inicio de vigencia				if(getXml(item,"k_status")&!"")					values=values&",51,'"&getXml(item,"k_status")&"'";					//Estatus: A=Activo I=Inactivo				if(getXml(item,"k_delivery")&!"")				values=values&",52,'"&getXml(item,"k_delivery")&"'";				//Tiempo de entrega				if(getXml(item,"k_minstation2")&!"")			values=values&",53,'"&getXml(item,"k_minstation2")&"'";			//Mínimo en la estación 2				if(getXml(item,"k_maxstation2")&!"")			values=values&",54,'"&getXml(item,"k_maxstation2")&"'";			//Máximo en la estación 2				if(getXml(item,"k_reorder2")&!"")				values=values&",55,'"&getXml(item,"k_reorder2")&"'";				//Punto de reorden de la estación 2				if(getXml(item,"k_inistationdate2")&!"")		values=values&",56,'"&getXml(item,"k_inistationdate2")&"'";		//Fecha de inicio de la estación 2				if(getXml(item,"k_minstation3")&!"")			values=values&",57,'"&getXml(item,"k_minstation3")&"'";			//Mínimo en la estación 3				if(getXml(item,"k_maxstation3")&!"")			values=values&",58,'"&getXml(item,"k_maxstation3")&"'";			//Máximo en la estación 3				if(getXml(item,"k_reorder3")&!"")				values=values&",59,'"&getXml(item,"k_reorder3")&"'";				//Punto de reorden de la estación 3				if(getXml(item,"k_inistationdate3")&!"")		values=values&",60,'"&getXml(item,"k_inistationdate3")&"'";		//Fecha de inicio de la estación 3				if(getXml(item,"k_mixstation4")&!"")			values=values&",61,'"&getXml(item,"k_mixstation4")&"'";			//Mínimo en la estación 4				if(getXml(item,"k_maxstation4")&!"")			values=values&",62,'"&getXml(item,"k_maxstation4")&"'";			//Máximo en la estación 4				if(getXml(item,"k_reorder4")&!"")				values=values&",63,'"&getXml(item,"k_reorder4")&"'";				//Punto de reorden de la estación 4				if(getXml(item,"k_inistationdate4")&!"")		values=values&",64,'"&getXml(item,"k_inistationdate4")&"'";		//Fecha de inicio de la estación 4				if(getXml(item,"k_inistationdate1")&!"")		values=values&",65,'"&getXml(item,"k_inistationdate1")&"'";		//Fecha de inicio de la estación 1				if(getXml(item,"k_waste")&!"")					values=values&",66,'"&getXml(item,"k_waste")&"'";					//Porcentaje de merma				if(getXml(item,"k_smc")&!"")						values=values&",67,'"&getXml(item,"k_smc")&"'";						//0=No 1=control x talla 2=Tll-Modelo 3=Tll-Mdl-Color				if(getXml(item,"k_lottrans")&!"")				values=values&",68,'"&getXml(item,"k_lottrans")&"'";				//Lote de Transferencia				if(getXml(item,"k_image")&!"")					values=values&",70,'"&getXml(item,"k_image")&"'";					//Nombre Completo de la Imagen EJ. imagenA1.jpg				if(getXml(item,"k_costtype")&!"")				values=values&",100,'"&getXml(item,"k_costtype")&"'";				//Tipo de Costo (E) Estandar (P) Promedio				if(getXml(item,"k_barcode2")&!"")				values=values&",101,'"&getXml(item,"k_barcode2")&"'";				//codigo de barras 2				if(getXml(item,"k_price20")&!"")					values=values&",179,'"&getXml(item,"k_price20")&"'";				//precio 20						cmd=cmd&values;				kdb.write(cmd);				kdb.exec();						kdb.close();				setXml(xmlOutput,"ok","1");				setXml(xmlOutput,"message","Successful update");				return xmlOutput;				}						fun ItemStock(GetStock) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<stockRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<GetStock>							<k_code>...</k_code>			            <k_branch>...</k_branch>			            <k_store>...</k_store>						</GetStock>					</stockRequest>									</soap:Body>			</soap:Envelope>					*/				var xmlOutput,cmd="datStore,s,1,";				var k_code=getXml(GetStock,"k_code");				var k_branch=getXml(GetStock,"k_branch");				var k_store=getXml(GetStock,"k_store");							kdb.connect();				kdb.open("s,kdiq");				if(k_branch&!"")	cmd=cmd&"'"&k_branch&"',";				if(k_store&!"")	cmd=cmd&"'"&k_store&"',";				cmd=cmd&"&,s1,s2";				kdb.table(cmd);				kdb.exec();				var n=kdb.N("datStore");				if(n<=0) {					setXml(xmlOutput,"ok",0);					setXml(xmlOutput,"err","Branch/Store not found");					return xmlOutput;				}				var dat;									for(var i=0,b,s;i<n;i++) {					b=kdb.get("datStore","r"&i,"s1");					s=kdb.get("datStore","r"&i,"s2");					setXmlAtt(dat,"dat"&i,"branch",b);					setXmlAtt(dat,"dat"&i,"store",s);										kdb.sp("k_inv","dat"&i,k_code,b,s);				}				kdb.exec();								var countB=0,sumB=0,branch="",b="";				var countS=0,store="";				var total=0,stock=0;				setXml(xmlOutput,"ok",1);				setXmlAtt(xmlOutput,"Stock","k_code",k_code);				for(var i=0;i<n;i++) {					branch=getXmlAtt(dat,"dat"&i,"branch");					store=getXmlAtt(dat,"dat"&i,"store");					stock=kdb.get("dat"&i,"inv");									if(b&!branch && b&!"" && sumB!=0) {						setXmlAtt(xmlOutput,"Stock","Branch["&countB&"]","k_branch",b);						setXmlAtt(xmlOutput,"Stock","Branch["&countB&"]","k_stock",sumB);						sumB=0;						countS=0;						countB++;					}					if(stock!=0) {						setXmlAtt(xmlOutput,"Stock","Branch["&countB&"]","Store["&countS&"]","k_store",store);						setXmlAtt(xmlOutput,"Stock","Branch["&countB&"]","Store["&countS&"]","k_stock",stock);						sumB=sumB+stock;						total=total+stock;						countS++;					}									b=getXmlAtt(dat,"dat"&i,"branch");								}				if(sumB!=0) {					setXmlAtt(xmlOutput,"Stock","Branch["&countB&"]","k_branch",b);					setXmlAtt(xmlOutput,"Stock","Branch["&countB&"]","k_stock",sumB);				}				setXmlAtt(xmlOutput,"Stock","k_stock",total);				kdb.close();				return xmlOutput;			}			//	D	O	C	U	M	E	N	T	S			fun ListDoc(xmlInput) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">			   <soap:Header/>					<soap:Body>						<listDocRequest>							<Login>								<user>...</user>								<pass>...</pass>								<datasource>...</datasource>							</Login>							<Search>								<k_sucursal>...</k_sucursal>				//OBLIGATORIO								<k_doc>											//Doacumento									<k_genero>...</k_genero>				//Genero del documento (OBLIGATORIO si se envia k_naturaleza)									<k_naturaleza>...</k_naturaleza>		//Naturaleza del documento (OBLIGATORIO si se envia k_grupo)									<k_grupo>...</k_grupo>					//Grupo del documento (OBLIGATORIO si se envia k_tipo)									<k_tipo>...</k_tipo>						//Tipo del documento								</k_doc>								<k_startDate>...</k_startDate>			//Filtro de búsqueda de documento fecha inicial								<k_endDate>...</k_endDate>					//Filtro de búsqueda de documento fecha final								<k_clave>...</k_clave>						//Clave del cliente								<k_agente>...</k_agente>					//Agente de ventas (Vendedor)								<add>...</add>									//Agrega información adicional al resultado de la búsqueda.							</Search>					</listDocRequest>				</soap:Body>			</soap:Envelope>							Campos permitidos con add:				k_moneda:				Agrega la moneda del documento al resultado de la búsqueda.				k_almacen:				Agrega el almacén del documento al resultado de la búsqueda.				k_refer:					Agrega la referencia del documento al resultado de la búsqueda.				k_agente:				Agrega el agente del documento al resultado de la búsqueda.				k_desc:					Agrega el decuento del documento al resultado de la búsqueda.				k_iva:					Agrega el IVA del documento al resultado de la búsqueda.				k_ieps:					Agrega el IEPS del documento al resultado de la búsqueda.				k_plazo:					Agrega los dias de plazo del documento al resultado de la búsqueda.				k_vence:					Agrega la fecha de vencimiento del documento al resultado de la búsqueda.				k_desc1:					Agrega el descuento1 del documento al resultado de la búsqueda.				k_desc2:					Agrega el descuento2 del documento al resultado de la búsqueda.				k_desc3:					Agrega el descuento3 del documento al resultado de la búsqueda.				k_cond:					Agrega la condición de pago del documento al resultado de la búsqueda. 				k_nombre:				Agrega el nombre del cliente al resultado de la búsqueda. 				k_calle:					Agrega la calle del cliente al resultado de la búsqueda.				k_colonia:				Agrega la colonia del cliente al resultado de la búsqueda.				k_poblacion:			Agrega la población del cliente al resultado de la búsqueda.				k_natA:					Agrega la naturaleza del documento al resultado de la búsqueda.				k_grpA:					Agrega el grupo del documento al resultado de la búsqueda.				k_tipA:					Agrega el tipo del documento al resultado de la búsqueda.				k_folA:					Agrega el folio del documento al resultado de la búsqueda.				k_paridad:				Agrega la paridad del documento al resultado de la búsqueda.				k_fecharefer:			Agrega la fecha de la referencia del documento al resultado de la búsqueda.				k_saldo:					Agrega el saldo del documento al resultado de la búsqueda.				k_status:				Agrega el status del documento al resultado de la búsqueda.				k_usuario:				Agrega el usuario que dió de alta el documento al resultado de la búsqueda.				k_fechacaptura:		Agrega la fecha de captura del documento al resultado de la búsqueda.				k_horacaptura:			Agrega la hora de captura del documento al resultado de la búsqueda.						*/				var xmlOutput;				var k_clave=getXml(xmlInput,"k_clave");				var k_sucursal=getXml(xmlInput,"k_sucursal");				var k_agente=getXml(xmlInput,"k_agente");				var k_startDate=getXml(xmlInput,"k_startDate");				var k_endDate=getXml(xmlInput,"k_endDate");				var k_genero=getXml(xmlInput,"k_doc","k_genero");				var k_naturaleza=getXml(xmlInput,"k_doc","k_naturaleza");				var k_grupo=getXml(xmlInput,"k_doc","k_grupo");				var k_tipo=getXml(xmlInput,"k_doc","k_tipo");				var cmd="dat,d,";				kdb.connect();				kdb.open("d,kdm1");				if(k_clave&!"")	cmd=cmd&"2,'"&k_sucursal&"','"&k_clave&"',";				else					cmd=cmd&"1,'"&k_sucursal&"',";				if(k_genero&!"") {					cmd=cmd&k_genero&",";					if(k_naturaleza&!"") {						cmd=cmd&k_naturaleza&",";						if(k_grupo&!"") {							cmd=cmd&k_grupo&",";							if(k_tipo&!"") 								cmd=cmd&k_tipo&",";						}					}				}				if(k_startDate&!"")	kdb.lim("d9>='"&k_startDate&"'");				if(k_endDate&!"")		kdb.lim("d9<='"&k_endDate&"'");				if(k_agente&!"")		kdb.lim("d12='"&k_agente&"'");				cmd=cmd&"&,d1...d6,d9,d10,d16";				for(var i=0,n=nXml(xmlInput);i<n;i++) {					var add=getXml(xmlInput,"add["&i&"]");					if(add&="k_moneda")					cmd=cmd&",d7";					else if(add&="k_almacen")			cmd=cmd&",d8";					else if(add&="k_refer")				cmd=cmd&",d11";					else if(add&="k_agente")			cmd=cmd&",d12";					else if(add&="k_desc")				cmd=cmd&",d13";					else if(add&="k_iva")				cmd=cmd&",d14";					else if(add&="k_ieps")				cmd=cmd&",d15";					else if(add&="k_plazo")				cmd=cmd&",d17";					else if(add&="k_vence")				cmd=cmd&",d18";					else if(add&="k_desc1")				cmd=cmd&",d19";					else if(add&="k_desc2")				cmd=cmd&",d20";					else if(add&="k_desc3")				cmd=cmd&",d21";					else if(add&="k_rfc")				cmd=cmd&",d22";					else if(add&="k_coment")			cmd=cmd&",d24...d26";					else if(add&="k_cond")				cmd=cmd&",d30";					else if(add&="k_nombre")			cmd=cmd&",d32";					else if(add&="k_calle")				cmd=cmd&",d33";					else if(add&="k_colonia")			cmd=cmd&",d34";					else if(add&="k_poblacion")		cmd=cmd&",d35";					else if(add&="k_natA")				cmd=cmd&",d36";					else if(add&="k_grpA")				cmd=cmd&",d37";					else if(add&="k_tipA")				cmd=cmd&",d38";					else if(add&="k_folA")				cmd=cmd&",d39";					else if(add&="k_paridad")			cmd=cmd&",d40";					else if(add&="k_fecharefer")		cmd=cmd&",d41";					else if(add&="k_saldo")				cmd=cmd&",d42";					else if(add&="k_status")			cmd=cmd&",d43";					else if(add&="k_usuario")			cmd=cmd&",d67";					else if(add&="k_fechacaptura")	cmd=cmd&",d68";					else if(add&="k_horacaptura")		cmd=cmd&",d69";				}				kdb.table(cmd);				kdb.exec();				for(var i=0,n=kdb.N("dat");i<n;i++) {					if(kdb.get("dat","r"&i,"d1")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_sucursal",kdb.get("dat","r"&i,"d1"));					if(kdb.get("dat","r"&i,"d2")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_genero",kdb.get("dat","r"&i,"d2"));					if(kdb.get("dat","r"&i,"d3")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_naturaleza",kdb.get("dat","r"&i,"d3"));					if(kdb.get("dat","r"&i,"d4")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_grupo",kdb.get("dat","r"&i,"d4"));					if(kdb.get("dat","r"&i,"d5")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_tipo",kdb.get("dat","r"&i,"d5"));					if(kdb.get("dat","r"&i,"d6")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_folio",kdb.get("dat","r"&i,"d6"));					if(kdb.get("dat","r"&i,"d7")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_moneda",kdb.get("dat","r"&i,"d7"));					if(kdb.get("dat","r"&i,"d8")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_almacen",kdb.get("dat","r"&i,"d8"));					if(kdb.get("dat","r"&i,"d9")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_fecha",kdb.get("dat","r"&i,"d9"));					if(kdb.get("dat","r"&i,"d10")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_clave",kdb.get("dat","r"&i,"d10"));					if(kdb.get("dat","r"&i,"d11")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_refer",kdb.get("dat","r"&i,"d11"));										if(kdb.get("dat","r"&i,"d12")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_agente",kdb.get("dat","r"&i,"d12"));										if(kdb.get("dat","r"&i,"d13")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_desc",kdb.get("dat","r"&i,"d13"));										if(kdb.get("dat","r"&i,"d14")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_iva",kdb.get("dat","r"&i,"d14"));										if(kdb.get("dat","r"&i,"d15")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_ieps",kdb.get("dat","r"&i,"d15"));										if(kdb.get("dat","r"&i,"d16")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_monto",kdb.get("dat","r"&i,"d16"));										if(kdb.get("dat","r"&i,"d17")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_plazo",kdb.get("dat","r"&i,"d17"));										if(kdb.get("dat","r"&i,"d18")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_vence",kdb.get("dat","r"&i,"d18"));										if(kdb.get("dat","r"&i,"d19")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_desc1",kdb.get("dat","r"&i,"d19"));					if(kdb.get("dat","r"&i,"d20")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_desc2",kdb.get("dat","r"&i,"d20"));					if(kdb.get("dat","r"&i,"d21")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_desc3",kdb.get("dat","r"&i,"d21"));										if(kdb.get("dat","r"&i,"d22")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_rfc",kdb.get("dat","r"&i,"d22"));										if(kdb.get("dat","r"&i,"d24")&!""||kdb.get("dat","r"&i,"d25")&!""||kdb.get("dat","r"&i,"d26")&!"")						setXml(xmlOutput,"Doc["&i&"]","k_coment",kdb.get("dat","r"&i,"d24")&" "&kdb.get("dat","r"&i,"d25")&" "&kdb.get("dat","r"&i,"d26"));										if(kdb.get("dat","r"&i,"d30")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_cond",kdb.get("dat","r"&i,"d30"));										if(kdb.get("dat","r"&i,"d32")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_nombre",kdb.get("dat","r"&i,"d32"));										if(kdb.get("dat","r"&i,"d33")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_calle",kdb.get("dat","r"&i,"d33"));					if(kdb.get("dat","r"&i,"d34")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_colonia",kdb.get("dat","r"&i,"d34"));					if(kdb.get("dat","r"&i,"d35")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_poblacion",kdb.get("dat","r"&i,"d35"));					if(kdb.get("dat","r"&i,"d36")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_natA",kdb.get("dat","r"&i,"d36"));					if(kdb.get("dat","r"&i,"d37")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_grpA",kdb.get("dat","r"&i,"d37"));					if(kdb.get("dat","r"&i,"d38")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_tipA",kdb.get("dat","r"&i,"d38"));					if(kdb.get("dat","r"&i,"d39")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_folA",kdb.get("dat","r"&i,"d39"));										if(kdb.get("dat","r"&i,"d40")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_paridad",kdb.get("dat","r"&i,"d40"));										if(kdb.get("dat","r"&i,"d41")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_fecharefer",kdb.get("dat","r"&i,"d41"));					if(kdb.get("dat","r"&i,"d42")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_saldo",kdb.get("dat","r"&i,"d42"));					if(kdb.get("dat","r"&i,"d43")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_status",kdb.get("dat","r"&i,"d43"));					if(kdb.get("dat","r"&i,"d67")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_usuario",kdb.get("dat","r"&i,"d67"));					if(kdb.get("dat","r"&i,"d68")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_fechacaptura",kdb.get("dat","r"&i,"d68"));					if(kdb.get("dat","r"&i,"d69")&!"")	setXml(xmlOutput,"Doc["&i&"]","k_horacaptura",kdb.get("dat","r"&i,"d69"));					}				kdb.close();				return xmlOutput;			}						fun NewDoc(wsDoc,param1,param2,param3,param4,param5,param6,param7,param8,param9,param10,param11) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<newDocRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<Doc>							<k_sucursal>...</k_sucursal>							<k_almacen>...</k_almacen>							<k_genero>...</k_genero>							<k_naturaleza>...</k_naturaleza>							<k_grupo>...</k_grupo>							<k_tipo>...</k_tipo>							<k_fecha>...</k_fecha>							<k_clave>...</k_clave>							<k_rfc>...</k_rfc>							<k_nombre>...</k_nombre>							<k_calle>...</k_calle>							<k_colonia>...</k_colonia>							<k_poblacion>...</k_poblacion>							<k_natA>...</k_natA>							<k_grpA>...</k_grpA>							<k_tipA>...</k_tipA>							<k_folA>...</k_folA>							<k_desc1>...</k_desc1>							<k_desc2>...</k_desc2>							<k_desc3>...</k_desc3>							<k_agente>...</k_agente>							<k_moneda>...</k_moneda>							<k_paridad>...</k_paridad>							<k_refer>...</k_refer>							<k_plazo>...</k_plazo>							<k_vence>...</k_vence>							<k_cond>...</k_cond>							<k_coment>...</k_coment>							<k_desc>...</k_desc>							<k_extra3>...</k_extra3>							<k_ieps>...</k_ieps>							<k_iva>...</k_iva>							<k_monto>...</k_monto>							<k_items>								<item>									<k_parte>...</k_parte>									<k_Q>...</k_Q>									<k_descr>...</k_descr>									<k_unidad>...</k_unidad>									<k_precio>...</k_precio>									<k_monto>...</k_monto>									<k_iva>...</k_iva>									<k_ieps>...</k_ieps>									<k_itemAux>										<aux>											<k_serie>...</k_serie>											<k_Q>...</k_Q>											<k_caduca>...</k_caduca>										</aux>									</k_itemAux>								</item>								<item>									.									.									.								</item>									.									.									.							</k_items>							<k_cobros>								<cobro>									<k_moneda>...</k_moneda>									<k_vence>...</k_vence>									<k_refer>...</k_refer>									<k_iva>...</k_iva>									<k_docto>...</k_docto>									<k_saldom>...</k_saldom>									<k_descr>...</k_descr>									<k_paridad>...</k_paridad>									<k_par_orig>...</k_par_orig>									<k_monto_orig>...</k_monto_orig>									<k_saldo>...</k_saldo>									<k_monto>...</k_monto>									<k_naturaleza>...</k_naturaleza>									<k_grupo>...</k_grupo>									<k_tipo>...</k_tipo>									<k_folio>...</k_folio>									<k_fecha>...</k_fecha>								</cobro>								<cobro>									.									.									.								</cobro>									.									.									.							</k_cobros>						</Doc>					</newDocRequest>				</soap:Body>			</soap:Envelope>			*/				var xmlDoc,res;				if(getXml(wsDoc,"k_sucursal")&!"")		setXml(xmlDoc,"k_sucursal",getXml(wsDoc,"k_sucursal")); //se establece la sucursal en donde se hace el documento. OBLIGATORIO				if(getXml(wsDoc,"k_almacen")&!"")		setXml(xmlDoc,"k_almacen",getXml(wsDoc,"k_almacen")); //se establece el almacen en donde se hace el documento. OBLIGATORIO				if(getXml(wsDoc,"k_genero")&!"")			setXml(xmlDoc,"k_genero",getXml(wsDoc,"k_genero")); //se establece el género del documento. OBLIGATORIO				if(getXml(wsDoc,"k_naturaleza")&!"")	setXml(xmlDoc,"k_naturaleza",getXml(wsDoc,"k_naturaleza")); //se establece la naturaleza del documento. OBLIGATORIO				if(getXml(wsDoc,"k_grupo")&!"")			setXml(xmlDoc,"k_grupo",getXml(wsDoc,"k_grupo")); //se establece el grupo del documento. OBLIGATORIO				if(getXml(wsDoc,"k_tipo")&!"")			setXml(xmlDoc,"k_tipo",getXml(wsDoc,"k_tipo"));//se establece el tipo de documento que se esta haciendo. OBLIGATORIO				if(getXml(wsDoc,"k_fecha")&!"")			setXml(xmlDoc,"k_fecha",getXml(wsDoc,"k_fecha"));//se establece la fecha en que se da de alta el documento (AAAA-MM-DD). OBLIGATORIO				if(getXml(wsDoc,"k_clave")&!"")			setXml(xmlDoc,"k_clave",getXml(wsDoc,"k_clave"));//se establece la clave del cliente de quien se esta haciendo la operación. OBLIGATORIO				if(getXml(wsDoc,"k_rfc")&!"")				setXml(xmlDoc,"k_rfc",getXml(wsDoc,"k_rfc"));//se establece el RFC del cliente de quien se esta haciendo la operación				if(getXml(wsDoc,"k_nombre")&!"")			setXml(xmlDoc,"k_nombre",getXml(wsDoc,"k_nombre"));//se establece el nombre del cliente de quien se esta haciendo la operación				if(getXml(wsDoc,"k_calle")&!"")			setXml(xmlDoc,"k_calle",getXml(wsDoc,"k_calle"));//se establece la dirección del cliente de quien se esta haciendo la operación				if(getXml(wsDoc,"k_colonia")&!"")		setXml(xmlDoc,"k_colonia",getXml(wsDoc,"k_colonia"));//se establece la dirección del cliente de quien se esta haciendo la operación				if(getXml(wsDoc,"k_poblacion")&!"")		setXml(xmlDoc,"k_poblacion",getXml(wsDoc,"k_poblacion"));//se establece la dirección del cliente de quien se esta haciendo la operación				if(getXml(wsDoc,"k_natA")&!"")			setXml(xmlDoc,"k_natA",getXml(wsDoc,"k_natA"));//se establece el documento previo (en caso de tenerlo)				if(getXml(wsDoc,"k_grpA")&!"")			setXml(xmlDoc,"k_grpA",getXml(wsDoc,"k_grpA"));//se establece el documento previo (en caso de tenerlo)				if(getXml(wsDoc,"k_tipA")&!"")			setXml(xmlDoc,"k_tipA",getXml(wsDoc,"k_tipA"));//se establece el documento previo (en caso de tenerlo)				if(getXml(wsDoc,"k_folA")&!"")			setXml(xmlDoc,"k_folA",getXml(wsDoc,"k_folA"));//se establece el documento previo (en caso de tenerlo)   				if(getXml(wsDoc,"k_desc1")&!"")			setXml(xmlDoc,"k_desc1",getXml(wsDoc,"k_desc1"));//se establece el descuento (en caso de tenerlo)				if(getXml(wsDoc,"k_desc2")&!"")			setXml(xmlDoc,"k_desc2",getXml(wsDoc,"k_desc2"));//se establece el descuento (en caso de tenerlo)				if(getXml(wsDoc,"k_desc3")&!"")			setXml(xmlDoc,"k_desc3",getXml(wsDoc,"k_desc3"));//se establece el descuento (en caso de tenerlo)				if(getXml(wsDoc,"k_agente")&!"")			setXml(xmlDoc,"k_agente",getXml(wsDoc,"k_agente"));//se establece la clave del agente (vendedor)				if(getXml(wsDoc,"k_moneda")&!"")			setXml(xmlDoc,"k_moneda",getXml(wsDoc,"k_moneda"));//se establece la moneda del documento. OBLIGATORIO				if(getXml(wsDoc,"k_paridad")&!"")		setXml(xmlDoc,"k_paridad",getXml(wsDoc,"k_paridad"));//se establece la paridad del documento. OBLIGATORIO				if(getXml(wsDoc,"k_refer")&!"")			setXml(xmlDoc,"k_refer",getXml(wsDoc,"k_refer"));//se establece la referencia del documento				if(getXml(wsDoc,"k_plazo")&!"")			setXml(xmlDoc,"k_plazo",getXml(wsDoc,"k_plazo"));//se establece el plazo				if(getXml(wsDoc,"k_vence")&!"")			setXml(xmlDoc,"k_vence",getXml(wsDoc,"k_vence"));//se establece la fecha de vencimiento				if(getXml(wsDoc,"k_cond")&!"")			setXml(xmlDoc,"k_cond",getXml(wsDoc,"k_cond"));//se establece la condición de pago				if(getXml(wsDoc,"k_coment")&!"")			setXml(xmlDoc,"k_coment",getXml(wsDoc,"k_coment"));//se establece los comentarios del documento				if(getXml(wsDoc,"k_desc")&!"")			setXml(xmlDoc,"k_desc",getXml(wsDoc,"k_desc"));//se establece el descuento				if(getXml(wsDoc,"k_extra3")&!"")			setXml(xmlDoc,"k_extra3",getXml(wsDoc,"k_extra3"));//se establece el extra3 (flete)				if(getXml(wsDoc,"k_ieps")&!"")			setXml(xmlDoc,"k_ieps",getXml(wsDoc,"k_ieps"));//se establece el ieps				if(getXml(wsDoc,"k_iva")&!"")				setXml(xmlDoc,"k_iva",getXml(wsDoc,"k_iva"));//se establece el iva				if(getXml(wsDoc,"k_monto")&!"")			setXml(xmlDoc,"k_monto",getXml(wsDoc,"k_monto"));//se establece el monto total del documento. OBLIGATORIO				for(var i=0,n=nXml(wsDoc,"k_items");i<n;i++) {				//--Items					if(getXml(wsDoc,"k_items","item["&i&"]","k_parte")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_parte",getXml(wsDoc,"k_items","item["&i&"]","k_parte"));//se establece la clave del producto. OBLIGATORIO					if(getXml(wsDoc,"k_items","item["&i&"]","k_Q")&!"")			setXml(xmlDoc,"k_mov","r"&i,"k_Q",getXml(wsDoc,"k_items","item["&i&"]","k_Q"));//se establece la cantidad del producto. OBLIGATORIO					if(getXml(wsDoc,"k_items","item["&i&"]","k_descr")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_descr",getXml(wsDoc,"k_items","item["&i&"]","k_descr"));//se establece la descripcion del producto					if(getXml(wsDoc,"k_items","item["&i&"]","k_unidad")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_unidad",getXml(wsDoc,"k_items","item["&i&"]","k_unidad"));//se establece la unidad del producto. OBLIGATORIO					if(getXml(wsDoc,"k_items","item["&i&"]","k_precio")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_precio",getXml(wsDoc,"k_items","item["&i&"]","k_precio"));//se establece el precio de lista del producto. OBLIGATORIO					if(getXml(wsDoc,"k_items","item["&i&"]","k_monto")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_monto",getXml(wsDoc,"k_items","item["&i&"]","k_monto"));//se establece el monto de la partida. OBLIGATORIO					if(getXml(wsDoc,"k_items","item["&i&"]","k_iva")&!"")			setXml(xmlDoc,"k_mov","r"&i,"k_iva",getXml(wsDoc,"k_items","item["&i&"]","k_iva"));//se establece el IVA del producto					if(getXml(wsDoc,"k_items","item["&i&"]","k_ieps")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_ieps",getXml(wsDoc,"k_items","item["&i&"]","k_ieps"));//se establece el IEPS del producto					if(getXml(wsDoc,"k_items","item["&i&"]","k_coment")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_coment",getXml(wsDoc,"k_items","item["&i&"]","k_coment"));//se establece el comentario de la partida   					if(getXml(wsDoc,"k_items","item["&i&"]","k_sucursal")&!"")	setXml(xmlDoc,"k_mov","r"&i,"k_sucursal",getXml(wsDoc,"k_items","item["&i&"]","k_sucursal"));//Sucursal previa  					if(getXml(wsDoc,"k_items","item["&i&"]","k_genero")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_genero",getXml(wsDoc,"k_items","item["&i&"]","k_genero"));//Género previo  					if(getXml(wsDoc,"k_items","item["&i&"]","k_natPrv")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_natPrv",getXml(wsDoc,"k_items","item["&i&"]","k_natPrv"));//Naturaleza previa  					if(getXml(wsDoc,"k_items","item["&i&"]","k_grpPrv")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_grpPrv",getXml(wsDoc,"k_items","item["&i&"]","k_grpPrv"));//Grupo previo  					if(getXml(wsDoc,"k_items","item["&i&"]","k_tipPrv")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_tipPrv",getXml(wsDoc,"k_items","item["&i&"]","k_tipPrv"));//Tipo previo  					if(getXml(wsDoc,"k_items","item["&i&"]","k_folPrv")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_folPrv",getXml(wsDoc,"k_items","item["&i&"]","k_folPrv"));//Folio previo  					if(getXml(wsDoc,"k_items","item["&i&"]","k_parPrv")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_parPrv",getXml(wsDoc,"k_items","item["&i&"]","k_parPrv"));//Número de partida previa 					if(getXml(wsDoc,"k_items","item["&i&"]","k_QO")&!"")			setXml(xmlDoc,"k_mov","r"&i,"k_QO",getXml(wsDoc,"k_items","item["&i&"]","k_QO"));//Cantidad previa original 					//---Control Auxiliar					for(var j=0,n2=nXml(wsDoc,"k_items","item["&i&"]","k_itemAux");j<n2;j++) {						if(getXml(wsDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_serie")&!"")			setXml(xmlDoc,"k_mov","r"&i,"k_recAuxReal","r"&j,"k_serie",getXml(wsDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_serie"));//se establece la serie/lote						if(getXml(wsDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_Q")&!"")				setXml(xmlDoc,"k_mov","r"&i,"k_recAuxReal","r"&j,"k_Q",getXml(wsDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_Q"));//se establece la cantidad						if(getXml(wsDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_caduca")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_recAuxReal","r"&j,"k_caduca",getXml(wsDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_caduca"));//se establece la fecha de caducidad					}				}				for(var i=0,n=nXml(wsDoc,"k_cobros");i<n;i++) {				//--Cobros					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_moneda")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_moneda",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_moneda"));//Se establece la clave de la moneda del documento que se va a cobrar. OBLIGATORIO					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_vence")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_vence",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_vence"));//Fecha de vencimiento del documento que se va a cobrar. 					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_refer")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_refer",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_refer"));//Referencia del documento que se va a cobrar. 					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_iva")&!"")			setXml(xmlDoc,"k_movcartera","r"&i,"k_iva",			getXml(wsDoc,"k_cobros","cobro["&i&"]","k_iva"));//IVA del documento que se va a cobrar.					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_docto")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_docto",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_docto"));//se establece el precio de lista del producto. OBLIGATORIO					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_saldom")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_saldom",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_saldom"));//Saldo en la moneda original del documento que se va a cobrar. OBLIGATORIO					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_descr")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_descr",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_descr"));//Descripción del documento que se va a cobrar					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_paridad")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_paridad",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_paridad"));//Paridad actual de la moneda en que se hizo el documento que se va a cobrar. OBLIGATORIO					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_par_orig")&!"")	setXml(xmlDoc,"k_movcartera","r"&i,"k_par_orig",	getXml(wsDoc,"k_cobros","cobro["&i&"]","k_par_orig"));//Paridad original en el momento que se hizo el documento que se va a cobrar.  OBLIGATORIO   					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_monto_orig")&!"")	setXml(xmlDoc,"k_movcartera","r"&i,"k_monto_orig",	getXml(wsDoc,"k_cobros","cobro["&i&"]","k_monto_orig"));//Monto original del documento que se va a cobrar. OBLIGATORIO   					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_saldo")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_saldo",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_saldo"));//Saldo del documento que se va a cobrar. OBLIGATORIO 					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_monto")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_monto",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_monto"));//Monto que se va a cobrar.  OBLIGATORIO    					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_naturaleza")&!"")	setXml(xmlDoc,"k_movcartera","r"&i,"k_naturaleza",	getXml(wsDoc,"k_cobros","cobro["&i&"]","k_naturaleza"));//Naturaleza del documento que se va a cobrar.  OBLIGATORIO   					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_grupo")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_grupo",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_grupo"));//Grupo del documento que se va a cobrar.  OBLIGATORIO   					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_tipo")&!"")			setXml(xmlDoc,"k_movcartera","r"&i,"k_tipo",			getXml(wsDoc,"k_cobros","cobro["&i&"]","k_tipo"));//Tipo del documento que se va a cobrar.  OBLIGATORIO  					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_folio")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_folio",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_folio"));//Folio del documento que se va a cobrar.  OBLIGATORIO 					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_fecha")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_fecha",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_fecha"));//Fecha del documento que se va a cobrar.    OBLIGATORIO				}				//----Se usa el SP opeIns para dar de alta el documento				kdb.connect();				kdb.sp("k_opeIns",xmlDoc,"res:res","getDoc:datDoc",param1,param2,param3,param4,param5,param6,param7,param8,param9,param10,param11);				kdb.exec();				if(kdb.get("res","ok")==1){					setXml(res,"ok",1);					setXml(res,"message","Documento creado");					setXml(res,"doc",kdb.get("res","doc"));					setXml(res,"folio",kdb.get("res","folio"));				}else{					setXml(res,"ok",0);					setXml(res,"err",kdb.get("res","err"));					setXml(res,"nErr",kdb.get("res","n"));									}				kdb.close();				return res;							}						fun GetDoc(DocID,param1,param2,param3) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<getDocRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<DocID>							<k_sucursal>...</k_sucursal>							<k_genero>...</k_genero>							<k_naturaleza>...</k_naturaleza>							<k_grupo>...</k_grupo>							<k_tipo>...</k_tipo>							<k_folio>...</k_folio>						</DocID>					</getDocRequest>				</soap:Body>			</soap:Envelope>			*/				var xmlOutput;				kdb.connect();				kdb.sp("k_getDoc","datDoc",getXml(DocID,"k_sucursal"),getXml(DocID,"k_genero"),getXml(DocID,"k_naturaleza"),getXml(DocID,"k_grupo"),getXml(DocID,"k_tipo"),getXml(DocID,"k_folio"),param1,param2,param3);				kdb.exec();				var status=kdb.get("datDoc","err");				if(status==1002) {					setXml(xmlOutput,"ok","0");					setXml(xmlOutput,"err","Document not found");					setXml(xmlOutput,"nErr",status);					return xmlOutput;				}				var xmlDoc;				if(kdb.get("datDoc","k_sucursal")&!"")		setXml(xmlDoc,"k_sucursal",kdb.get("datDoc","k_sucursal")); //La sucursal en donde se hace el documento				if(kdb.get("datDoc","k_almacen")&!"")		setXml(xmlDoc,"k_almacen",kdb.get("datDoc","k_almacen")); //El almacen del documento.				if(kdb.get("datDoc","k_genero")&!"")		setXml(xmlDoc,"k_genero",kdb.get("datDoc","k_genero")); //El genero del documento.				if(kdb.get("datDoc","k_naturaleza")&!"")	setXml(xmlDoc,"k_naturaleza",kdb.get("datDoc","k_naturaleza")); //La naturaleza del documento.				if(kdb.get("datDoc","k_grupo")&!"")			setXml(xmlDoc,"k_grupo",kdb.get("datDoc","k_grupo")); //El grupo del documento.				if(kdb.get("datDoc","k_tipo")&!"")			setXml(xmlDoc,"k_tipo",kdb.get("datDoc","k_tipo"));//El tipo de documento.				if(kdb.get("datDoc","k_folio")&!"")			setXml(xmlDoc,"k_fecha",kdb.get("datDoc","k_folio"));//El folio del documento.				if(kdb.get("datDoc","k_fecha")&!"")			setXml(xmlDoc,"k_fecha",kdb.get("datDoc","k_fecha"));//La fecha en que se da de alta el documento (AAAA-MM-DD). 				if(kdb.get("datDoc","k_clave")&!"")			setXml(xmlDoc,"k_clave",kdb.get("datDoc","k_clave"));//La clave del cliente de quien se esta haciendo la operación. 				if(kdb.get("datDoc","k_rfc")&!"")			setXml(xmlDoc,"k_rfc",kdb.get("datDoc","k_rfc"));//El RFC del cliente de quien se esta haciendo la operación				if(kdb.get("datDoc","k_nombre")&!"")		setXml(xmlDoc,"k_nombre",kdb.get("datDoc","k_nombre"));//El nombre del cliente de quien se esta haciendo la operación				if(kdb.get("datDoc","k_calle")&!"")			setXml(xmlDoc,"k_calle",kdb.get("datDoc","k_calle"));//La dirección del cliente de quien se esta haciendo la operación				if(kdb.get("datDoc","k_colonia")&!"")		setXml(xmlDoc,"k_colonia",kdb.get("datDoc","k_colonia"));//La dirección del cliente de quien se esta haciendo la operación				if(kdb.get("datDoc","k_poblacion")&!"")	setXml(xmlDoc,"k_poblacion",kdb.get("datDoc","k_poblacion"));//La dirección del cliente de quien se esta haciendo la operación				if(kdb.get("datDoc","k_natA")&!"")			setXml(xmlDoc,"k_natA",kdb.get("datDoc","k_natA"));//El documento previo (en caso de tenerlo)				if(kdb.get("datDoc","k_grpA")&!"")			setXml(xmlDoc,"k_grpA",kdb.get("datDoc","k_grpA"));//El documento previo (en caso de tenerlo)				if(kdb.get("datDoc","k_tipA")&!"")			setXml(xmlDoc,"k_tipA",kdb.get("datDoc","k_tipA"));//El documento previo (en caso de tenerlo)				if(kdb.get("datDoc","k_folA")&!"")			setXml(xmlDoc,"k_folA",kdb.get("datDoc","k_folA"));//El documento previo (en caso de tenerlo)   				if(kdb.get("datDoc","k_desc1")&!"")			setXml(xmlDoc,"k_desc1",kdb.get("datDoc","k_desc1"));//El descuento (en caso de tenerlo)				if(kdb.get("datDoc","k_desc2")&!"")			setXml(xmlDoc,"k_desc2",kdb.get("datDoc","k_desc2"));//El descuento (en caso de tenerlo)				if(kdb.get("datDoc","k_desc3")&!"")			setXml(xmlDoc,"k_desc3",kdb.get("datDoc","k_desc3"));//El descuento (en caso de tenerlo)				if(kdb.get("datDoc","k_agente")&!"")		setXml(xmlDoc,"k_agente",kdb.get("datDoc","k_agente"));//La clave del agente (vendedor)				if(kdb.get("datDoc","k_moneda")&!"")		setXml(xmlDoc,"k_moneda",kdb.get("datDoc","k_moneda"));//La moneda del documento.				if(kdb.get("datDoc","k_paridad")&!"")		setXml(xmlDoc,"k_paridad",kdb.get("datDoc","k_paridad"));//La paridad del documento.				if(kdb.get("datDoc","k_refer")&!"")			setXml(xmlDoc,"k_refer",kdb.get("datDoc","k_refer"));//La referencia del documento				if(kdb.get("datDoc","k_plazo")&!"")			setXml(xmlDoc,"k_plazo",kdb.get("datDoc","k_plazo"));//El plazo del documento				if(kdb.get("datDoc","k_vence")&!"")			setXml(xmlDoc,"k_vence",kdb.get("datDoc","k_vence"));//La fecha de vencimiento del documento				if(kdb.get("datDoc","k_cond")&!"")			setXml(xmlDoc,"k_cond",kdb.get("datDoc","k_cond"));//La condición de pago				if(kdb.get("datDoc","k_coment")&!"")		setXml(xmlDoc,"k_coment",kdb.get("datDoc","k_coment"));//Los comentarios del documento				if(kdb.get("datDoc","k_desc")&!"")			setXml(xmlDoc,"k_desc",kdb.get("datDoc","k_desc"));//El descuento				if(kdb.get("datDoc","k_extra3")&!"")		setXml(xmlDoc,"k_extra3",kdb.get("datDoc","k_extra3"));//El extra3 del documento(flete).				if(kdb.get("datDoc","k_ieps")&!"")			setXml(xmlDoc,"k_ieps",kdb.get("datDoc","k_ieps"));//El ieps del documento.				if(kdb.get("datDoc","k_iva")&!"")			setXml(xmlDoc,"k_iva",kdb.get("datDoc","k_iva"));//El iva del documento.				if(kdb.get("datDoc","k_monto")&!"")			setXml(xmlDoc,"k_monto",kdb.get("datDoc","k_monto"));//El monto total del documento.				for(var i=0,n=kdb.N("datDoc","k_mov");i<n;i++) {				//--Items					if(kdb.get("datDoc","k_mov","r"&i,"k_parte")&!"")		setXml(xmlDoc,"k_items","item["&i&"]","k_parte",kdb.get("datDoc","k_mov","r"&i,"k_parte"));//La clave del producto.					if(kdb.get("datDoc","k_mov","r"&i,"k_Q")&!"")			setXml(xmlDoc,"k_items","item["&i&"]","k_Q",kdb.get("datDoc","k_mov","r"&i,"k_Q"));//La cantidad del producto.					if(kdb.get("datDoc","k_mov","r"&i,"k_descr")&!"")		setXml(xmlDoc,"k_items","item["&i&"]","k_descr",kdb.get("datDoc","k_mov","r"&i,"k_descr"));//La descripcion del producto					if(kdb.get("datDoc","k_mov","r"&i,"k_unidad")&!"")		setXml(xmlDoc,"k_items","item["&i&"]","k_unidad",kdb.get("datDoc","k_mov","r"&i,"k_unidad"));//La unidad del producto.					if(kdb.get("datDoc","k_mov","r"&i,"k_precio")&!"")		setXml(xmlDoc,"k_items","item["&i&"]","k_precio",kdb.get("datDoc","k_mov","r"&i,"k_precio"));//El precio de lista del producto.					if(kdb.get("datDoc","k_mov","r"&i,"k_monto")&!"")		setXml(xmlDoc,"k_items","item["&i&"]","k_monto",kdb.get("datDoc","k_mov","r"&i,"k_monto"));//El monto de la partida.					if(kdb.get("datDoc","k_mov","r"&i,"k_iva")&!"")			setXml(xmlDoc,"k_items","item["&i&"]","k_iva",kdb.get("datDoc","k_mov","r"&i,"k_iva"));//El IVA del producto					if(kdb.get("datDoc","k_mov","r"&i,"k_ieps")&!"")		setXml(xmlDoc,"k_items","item["&i&"]","k_ieps",kdb.get("datDoc","k_mov","r"&i,"k_ieps"));//El IEPS del producto					if(kdb.get("datDoc","k_mov","r"&i,"k_coment")&!"")		setXml(xmlDoc,"k_items","item["&i&"]","k_coment",kdb.get("datDoc","k_mov","r"&i,"k_coment"));//El comentario de la partida   					if(kdb.get("datDoc","k_mov","r"&i,"k_sucursal")&!"")	setXml(xmlDoc,"k_items","item["&i&"]","k_sucursal",kdb.get("datDoc","k_mov","r"&i,"k_sucursal"));//Sucursal previa     					if(kdb.get("datDoc","k_mov","r"&i,"k_genero")&!"")		setXml(xmlDoc,"k_items","item["&i&"]","k_genero",kdb.get("datDoc","k_mov","r"&i,"k_genero"));//Género previo   					if(kdb.get("datDoc","k_mov","r"&i,"k_natPrv")&!"")		setXml(xmlDoc,"k_items","item["&i&"]","k_natPrv",kdb.get("datDoc","k_mov","r"&i,"k_natPrv"));//Naturaleza previa   					if(kdb.get("datDoc","k_mov","r"&i,"k_grpPrv")&!"")		setXml(xmlDoc,"k_items","item["&i&"]","k_grpPrv",kdb.get("datDoc","k_mov","r"&i,"k_grpPrv"));//Grupo previo    					if(kdb.get("datDoc","k_mov","r"&i,"k_tipPrv")&!"")		setXml(xmlDoc,"k_items","item["&i&"]","k_tipPrv",kdb.get("datDoc","k_mov","r"&i,"k_tipPrv"));//Tipo previo  					if(kdb.get("datDoc","k_mov","r"&i,"k_folPrv")&!"")		setXml(xmlDoc,"k_items","item["&i&"]","k_folPrv",kdb.get("datDoc","k_mov","r"&i,"k_folPrv"));//Folio previo  					if(kdb.get("datDoc","k_mov","r"&i,"k_parPrv")&!"")		setXml(xmlDoc,"k_items","item["&i&"]","k_parPrv",kdb.get("datDoc","k_mov","r"&i,"k_parPrv"));//Número de partida previa   					if(kdb.get("datDoc","k_mov","r"&i,"k_QO")&!"")			setXml(xmlDoc,"k_items","item["&i&"]","k_QO",kdb.get("datDoc","k_mov","r"&i,"k_QO"));//Cantidad previa original					//---Control Auxiliar					for(var j=0,n2=kdb.N("datDoc","k_mov","r"&i,"k_recAuxReal");j<n2;j++) {						if(kdb.get("datDoc","k_mov","r"&i,"k_recAuxReal","r"&j,"k_serie")&!"")			setXml(xmlDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_serie",kdb.get("datDoc","k_mov","r"&i,"k_itemAux","r"&j,"k_serie"));//La serie/lote del producto.						if(kdb.get("datDoc","k_mov","r"&i,"k_recAuxReal","r"&j,"k_Q")&!"")				setXml(xmlDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_Q",kdb.get("datDoc","k_mov","r"&i,"k_itemAux","r"&j,"k_Q"));//La cantidad del producto.						if(kdb.get("datDoc","k_mov","r"&i,"k_recAuxReal","r"&j,"k_caduca")&!"")			setXml(xmlDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_caduca",kdb.get("datDoc","k_mov","r"&i,"k_itemAux","r"&j,"k_caduca"));//La fecha de caducidad del producto.					}				}				for(var i=0,n=kdb.N("datDoc","k_movcartera");i<n;i++) {				//--Cobros					if(kdb.get("datDoc","k_movcartera","r"&i,"k_moneda")&!"")		setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_moneda",		kdb.get("datDoc","k_movcartera","r"&i,"k_moneda"));//La clave de la moneda del documento que se va a cobrar.					if(kdb.get("datDoc","k_movcartera","r"&i,"k_vence")&!"")			setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_vence",			kdb.get("datDoc","k_movcartera","r"&i,"k_vence"));//Fecha de vencimiento del documento que se va a cobrar. 					if(kdb.get("datDoc","k_movcartera","r"&i,"k_refer")&!"")			setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_refer",			kdb.get("datDoc","k_movcartera","r"&i,"k_refer"));//Referencia del documento que se va a cobrar. 					if(kdb.get("datDoc","k_movcartera","r"&i,"k_iva")&!"")			setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_iva",			kdb.get("datDoc","k_movcartera","r"&i,"k_iva"));//IVA del documento que se va a cobrar.					if(kdb.get("datDoc","k_movcartera","r"&i,"k_docto")&!"")			setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_docto",			kdb.get("datDoc","k_movcartera","r"&i,"k_docto"));//El precio de lista del producto. 					if(kdb.get("datDoc","k_movcartera","r"&i,"k_saldom")&!"")		setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_saldom",		kdb.get("datDoc","k_movcartera","r"&i,"k_saldom"));//Saldo en la moneda original del documento que se va a cobrar.					if(kdb.get("datDoc","k_movcartera","r"&i,"k_descr")&!"")			setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_descr",			kdb.get("datDoc","k_movcartera","r"&i,"k_descr"));//Descripción del documento que se va a cobrar					if(kdb.get("datDoc","k_movcartera","r"&i,"k_paridad")&!"")		setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_paridad",		kdb.get("datDoc","k_movcartera","r"&i,"k_paridad"));//Paridad actual de la moneda en que se hizo el documento que se va a cobrar.					if(kdb.get("datDoc","k_movcartera","r"&i,"k_par_orig")&!"")		setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_par_orig",		kdb.get("datDoc","k_movcartera","r"&i,"k_par_orig"));//Paridad original en el momento que se hizo el documento que se va a cobrar.     					if(kdb.get("datDoc","k_movcartera","r"&i,"k_monto_orig")&!"")	setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_monto_orig",	kdb.get("datDoc","k_movcartera","r"&i,"k_monto_orig"));//Monto original del documento que se va a cobrar.   					if(kdb.get("datDoc","k_movcartera","r"&i,"k_saldo")&!"")			setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_saldo",			kdb.get("datDoc","k_movcartera","r"&i,"k_saldo"));//Saldo del documento que se va a cobrar.  					if(kdb.get("datDoc","k_movcartera","r"&i,"k_monto")&!"")			setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_monto",			kdb.get("datDoc","k_movcartera","r"&i,"k_monto"));//Monto que se va a cobrar.    					if(kdb.get("datDoc","k_movcartera","r"&i,"k_naturaleza")&!"")	setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_naturaleza",	kdb.get("datDoc","k_movcartera","r"&i,"k_naturaleza"));//Naturaleza del documento que se va a cobrar.   					if(kdb.get("datDoc","k_movcartera","r"&i,"k_grupo")&!"")			setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_grupo",			kdb.get("datDoc","k_movcartera","r"&i,"k_grupo"));//Grupo del documento que se va a cobrar.   					if(kdb.get("datDoc","k_movcartera","r"&i,"k_tipo")&!"")			setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_tipo",			kdb.get("datDoc","k_movcartera","r"&i,"k_tipo"));//Tipo del documento que se va a cobrar.  					if(kdb.get("datDoc","k_movcartera","r"&i,"k_folio")&!"")			setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_folio",			kdb.get("datDoc","k_movcartera","r"&i,"k_folio"));//Folio del documento que se va a cobrar.					if(kdb.get("datDoc","k_movcartera","r"&i,"k_fecha")&!"")			setXml(xmlDoc,"k_cobros","cobro["&i&"]","k_fecha",			kdb.get("datDoc","k_movcartera","r"&i,"k_fecha"));//Fecha del documento que se va a cobrar. 				}				setXml(xmlOutput,"ok","1");				if (status==1001)			setXml(xmlOutput,"err","Referenced document");				else if (status==1003)	setXml(xmlOutput,"err","Canceled document");				if(status&!"")				setXml(xmlOutput,"nErr",status);				setXml(xmlOutput,"Doc",xmlDoc);				kdb.close();				return xmlOutput;				}						fun UpdateDoc(wsDoc,param1,param2,param3,param4,param5,param6,param7,param8,param9,param10,param11) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<updateDocRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<Doc>							<k_sucursal>...</k_sucursal>							<k_almacen>...</k_almacen>							<k_genero>...</k_genero>							<k_naturaleza>...</k_naturaleza>							<k_grupo>...</k_grupo>							<k_tipo>...</k_tipo>							<k_folio>...</k_folio>							<k_fecha>...</k_fecha>							<k_clave>...</k_clave>							<k_rfc>...</k_rfc>							<k_nombre>...</k_nombre>							<k_calle>...</k_calle>							<k_colonia>...</k_colonia>							<k_poblacion>...</k_poblacion>							<k_natA>...</k_natA>							<k_grpA>...</k_grpA>							<k_tipA>...</k_tipA>							<k_folA>...</k_folA>							<k_desc1>...</k_desc1>							<k_desc2>...</k_desc2>							<k_desc3>...</k_desc3>							<k_agente>...</k_agente>							<k_moneda>...</k_moneda>							<k_paridad>...</k_paridad>							<k_refer>...</k_refer>							<k_plazo>...</k_plazo>							<k_vence>...</k_vence>							<k_cond>...</k_cond>							<k_coment>...</k_coment>							<k_desc>...</k_desc>							<k_extra3>...</k_extra3>							<k_ieps>...</k_ieps>							<k_iva>...</k_iva>							<k_monto>...</k_monto>							<k_items>								<item>									<k_parte>...</k_parte>									<k_Q>...</k_Q>									<k_descr>...</k_descr>									<k_unidad>...</k_unidad>									<k_precio>...</k_precio>									<k_monto>...</k_monto>									<k_iva>...</k_iva>									<k_ieps>...</k_ieps>									<k_itemAux>										<aux>											<k_serie>...</k_serie>											<k_Q>...</k_Q>											<k_caduca>...</k_caduca>										</aux>									</k_itemAux>								</item>								<item>									.									.									.								</item>									.									.									.							</k_items>							<k_cobros>								<cobro>									<k_moneda>...</k_moneda>									<k_vence>...</k_vence>									<k_refer>...</k_refer>									<k_iva>...</k_iva>									<k_docto>...</k_docto>									<k_saldom>...</k_saldom>									<k_descr>...</k_descr>									<k_paridad>...</k_paridad>									<k_par_orig>...</k_par_orig>									<k_monto_orig>...</k_monto_orig>									<k_saldo>...</k_saldo>									<k_monto>...</k_monto>									<k_naturaleza>...</k_naturaleza>									<k_grupo>...</k_grupo>									<k_tipo>...</k_tipo>									<k_folio>...</k_folio>									<k_fecha>...</k_fecha>								</cobro>								<cobro>									.									.									.								</cobro>									.									.									.							</k_cobros>						</Doc>					</updateDocRequest>				</soap:Body>			</soap:Envelope>			*/				var xmlDoc,res;				if(getXml(wsDoc,"k_sucursal")&!"")		setXml(xmlDoc,"k_sucursal",getXml(wsDoc,"k_sucursal")); //se establece la sucursal en donde se hace el documento. OBLIGATORIO				if(getXml(wsDoc,"k_almacen")&!"")		setXml(xmlDoc,"k_almacen",getXml(wsDoc,"k_almacen")); //se establece el almacen en donde se hace el documento. OBLIGATORIO				if(getXml(wsDoc,"k_genero")&!"")			setXml(xmlDoc,"k_genero",getXml(wsDoc,"k_genero")); //se establece el género del documento. OBLIGATORIO				if(getXml(wsDoc,"k_naturaleza")&!"")	setXml(xmlDoc,"k_naturaleza",getXml(wsDoc,"k_naturaleza")); //se establece la naturaleza del documento. OBLIGATORIO				if(getXml(wsDoc,"k_grupo")&!"")			setXml(xmlDoc,"k_grupo",getXml(wsDoc,"k_grupo")); //se establece el grupo del documento. OBLIGATORIO				if(getXml(wsDoc,"k_tipo")&!"")			setXml(xmlDoc,"k_tipo",getXml(wsDoc,"k_tipo"));//se establece el tipo de documento que se esta haciendo. OBLIGATORIO				if(getXml(wsDoc,"k_folio")&!"")			setXml(xmlDoc,"k_folio",getXml(wsDoc,"k_folio"));//se establece el folio del documento que se esta haciendo. OBLIGATORIO				if(getXml(wsDoc,"k_fecha")&!"")			setXml(xmlDoc,"k_fecha",getXml(wsDoc,"k_fecha"));//se establece la fecha en que se da de alta el documento (AAAA-MM-DD). OBLIGATORIO				if(getXml(wsDoc,"k_clave")&!"")			setXml(xmlDoc,"k_clave",getXml(wsDoc,"k_clave"));//se establece la clave del cliente de quien se esta haciendo la operación. OBLIGATORIO				if(getXml(wsDoc,"k_rfc")&!"")				setXml(xmlDoc,"k_rfc",getXml(wsDoc,"k_rfc"));//se establece el RFC del cliente de quien se esta haciendo la operación				if(getXml(wsDoc,"k_nombre")&!"")			setXml(xmlDoc,"k_nombre",getXml(wsDoc,"k_nombre"));//se establece el nombre del cliente de quien se esta haciendo la operación				if(getXml(wsDoc,"k_calle")&!"")			setXml(xmlDoc,"k_calle",getXml(wsDoc,"k_calle"));//se establece la dirección del cliente de quien se esta haciendo la operación				if(getXml(wsDoc,"k_colonia")&!"")		setXml(xmlDoc,"k_colonia",getXml(wsDoc,"k_colonia"));//se establece la dirección del cliente de quien se esta haciendo la operación				if(getXml(wsDoc,"k_poblacion")&!"")		setXml(xmlDoc,"k_poblacion",getXml(wsDoc,"k_poblacion"));//se establece la dirección del cliente de quien se esta haciendo la operación				if(getXml(wsDoc,"k_natA")&!"")			setXml(xmlDoc,"k_natA",getXml(wsDoc,"k_natA"));//se establece el documento previo (en caso de tenerlo)				if(getXml(wsDoc,"k_grpA")&!"")			setXml(xmlDoc,"k_grpA",getXml(wsDoc,"k_grpA"));//se establece el documento previo (en caso de tenerlo)				if(getXml(wsDoc,"k_tipA")&!"")			setXml(xmlDoc,"k_tipA",getXml(wsDoc,"k_tipA"));//se establece el documento previo (en caso de tenerlo)				if(getXml(wsDoc,"k_folA")&!"")			setXml(xmlDoc,"k_folA",getXml(wsDoc,"k_folA"));//se establece el documento previo (en caso de tenerlo)   				if(getXml(wsDoc,"k_desc1")&!"")			setXml(xmlDoc,"k_desc1",getXml(wsDoc,"k_desc1"));//se establece el descuento (en caso de tenerlo)				if(getXml(wsDoc,"k_desc2")&!"")			setXml(xmlDoc,"k_desc2",getXml(wsDoc,"k_desc2"));//se establece el descuento (en caso de tenerlo)				if(getXml(wsDoc,"k_desc3")&!"")			setXml(xmlDoc,"k_desc3",getXml(wsDoc,"k_desc3"));//se establece el descuento (en caso de tenerlo)				if(getXml(wsDoc,"k_agente")&!"")			setXml(xmlDoc,"k_agente",getXml(wsDoc,"k_agente"));//se establece la clave del agente (vendedor)				if(getXml(wsDoc,"k_moneda")&!"")			setXml(xmlDoc,"k_moneda",getXml(wsDoc,"k_moneda"));//se establece la moneda del documento. OBLIGATORIO				if(getXml(wsDoc,"k_paridad")&!"")		setXml(xmlDoc,"k_paridad",getXml(wsDoc,"k_paridad"));//se establece la paridad del documento. OBLIGATORIO				if(getXml(wsDoc,"k_refer")&!"")			setXml(xmlDoc,"k_refer",getXml(wsDoc,"k_refer"));//se establece la referencia del documento				if(getXml(wsDoc,"k_plazo")&!"")			setXml(xmlDoc,"k_plazo",getXml(wsDoc,"k_plazo"));//se establece el plazo				if(getXml(wsDoc,"k_vence")&!"")			setXml(xmlDoc,"k_vence",getXml(wsDoc,"k_vence"));//se establece la fecha de vencimiento				if(getXml(wsDoc,"k_cond")&!"")			setXml(xmlDoc,"k_cond",getXml(wsDoc,"k_cond"));//se establece la condición de pago				if(getXml(wsDoc,"k_coment")&!"")			setXml(xmlDoc,"k_coment",getXml(wsDoc,"k_coment"));//se establece los comentarios del documento				if(getXml(wsDoc,"k_desc")&!"")			setXml(xmlDoc,"k_desc",getXml(wsDoc,"k_desc"));//se establece el descuento				if(getXml(wsDoc,"k_extra3")&!"")			setXml(xmlDoc,"k_extra3",getXml(wsDoc,"k_extra3"));//se establece el extra3 (flete)				if(getXml(wsDoc,"k_ieps")&!"")			setXml(xmlDoc,"k_ieps",getXml(wsDoc,"k_ieps"));//se establece el ieps				if(getXml(wsDoc,"k_iva")&!"")				setXml(xmlDoc,"k_iva",getXml(wsDoc,"k_iva"));//se establece el iva				if(getXml(wsDoc,"k_monto")&!"")			setXml(xmlDoc,"k_monto",getXml(wsDoc,"k_monto"));//se establece el monto total del documento. OBLIGATORIO				for(var i=0,n=nXml(wsDoc,"k_items");i<n;i++) {				//--Items					if(getXml(wsDoc,"k_items","item["&i&"]","k_parte")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_parte",getXml(wsDoc,"k_items","item["&i&"]","k_parte"));//se establece la clave del producto. OBLIGATORIO					if(getXml(wsDoc,"k_items","item["&i&"]","k_Q")&!"")			setXml(xmlDoc,"k_mov","r"&i,"k_Q",getXml(wsDoc,"k_items","item["&i&"]","k_Q"));//se establece la cantidad del producto. OBLIGATORIO					if(getXml(wsDoc,"k_items","item["&i&"]","k_descr")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_descr",getXml(wsDoc,"k_items","item["&i&"]","k_descr"));//se establece la descripcion del producto					if(getXml(wsDoc,"k_items","item["&i&"]","k_unidad")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_unidad",getXml(wsDoc,"k_items","item["&i&"]","k_unidad"));//se establece la unidad del producto. OBLIGATORIO					if(getXml(wsDoc,"k_items","item["&i&"]","k_precio")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_precio",getXml(wsDoc,"k_items","item["&i&"]","k_precio"));//se establece el precio de lista del producto. OBLIGATORIO					if(getXml(wsDoc,"k_items","item["&i&"]","k_monto")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_monto",getXml(wsDoc,"k_items","item["&i&"]","k_monto"));//se establece el monto de la partida. OBLIGATORIO					if(getXml(wsDoc,"k_items","item["&i&"]","k_iva")&!"")			setXml(xmlDoc,"k_mov","r"&i,"k_iva",getXml(wsDoc,"k_items","item["&i&"]","k_iva"));//se establece el IVA del producto					if(getXml(wsDoc,"k_items","item["&i&"]","k_ieps")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_ieps",getXml(wsDoc,"k_items","item["&i&"]","k_ieps"));//se establece el IEPS del producto					if(getXml(wsDoc,"k_items","item["&i&"]","k_coment")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_coment",getXml(wsDoc,"k_items","item["&i&"]","k_coment"));//se establece el comentario de la partida   					if(getXml(wsDoc,"k_items","item["&i&"]","k_sucursal")&!"")	setXml(xmlDoc,"k_mov","r"&i,"k_sucursal",getXml(wsDoc,"k_items","item["&i&"]","k_sucursal"));//Sucursal previa  					if(getXml(wsDoc,"k_items","item["&i&"]","k_genero")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_genero",getXml(wsDoc,"k_items","item["&i&"]","k_genero"));//Género previo  					if(getXml(wsDoc,"k_items","item["&i&"]","k_natPrv")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_natPrv",getXml(wsDoc,"k_items","item["&i&"]","k_natPrv"));//Naturaleza previa  					if(getXml(wsDoc,"k_items","item["&i&"]","k_grpPrv")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_grpPrv",getXml(wsDoc,"k_items","item["&i&"]","k_grpPrv"));//Grupo previo  					if(getXml(wsDoc,"k_items","item["&i&"]","k_tipPrv")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_tipPrv",getXml(wsDoc,"k_items","item["&i&"]","k_tipPrv"));//Tipo previo  					if(getXml(wsDoc,"k_items","item["&i&"]","k_folPrv")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_folPrv",getXml(wsDoc,"k_items","item["&i&"]","k_folPrv"));//Folio previo  					if(getXml(wsDoc,"k_items","item["&i&"]","k_parPrv")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_parPrv",getXml(wsDoc,"k_items","item["&i&"]","k_parPrv"));//Número de partida previa 					if(getXml(wsDoc,"k_items","item["&i&"]","k_QO")&!"")			setXml(xmlDoc,"k_mov","r"&i,"k_QO",getXml(wsDoc,"k_items","item["&i&"]","k_QO"));//Cantidad previa original 					//---Control Auxiliar					for(var j=0,n2=nXml(wsDoc,"k_items","item["&i&"]","k_itemAux");j<n2;j++) {						if(getXml(wsDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_serie")&!"")			setXml(xmlDoc,"k_mov","r"&i,"k_recAuxReal","r"&j,"k_serie",getXml(wsDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_serie"));//se establece la serie/lote						if(getXml(wsDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_Q")&!"")				setXml(xmlDoc,"k_mov","r"&i,"k_recAuxReal","r"&j,"k_Q",getXml(wsDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_Q"));//se establece la cantidad						if(getXml(wsDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_caduca")&!"")		setXml(xmlDoc,"k_mov","r"&i,"k_recAuxReal","r"&j,"k_caduca",getXml(wsDoc,"k_items","item["&i&"]","k_itemAux","aux["&j&"]","k_caduca"));//se establece la fecha de caducidad					}				}				for(var i=0,n=nXml(wsDoc,"k_cobros");i<n;i++) {				//--Cobros					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_moneda")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_moneda",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_moneda"));//Se establece la clave de la moneda del documento que se va a cobrar. OBLIGATORIO					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_vence")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_vence",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_vence"));//Fecha de vencimiento del documento que se va a cobrar. 					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_refer")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_refer",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_refer"));//Referencia del documento que se va a cobrar. 					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_iva")&!"")			setXml(xmlDoc,"k_movcartera","r"&i,"k_iva",			getXml(wsDoc,"k_cobros","cobro["&i&"]","k_iva"));//IVA del documento que se va a cobrar.					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_docto")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_docto",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_docto"));//se establece el precio de lista del producto. OBLIGATORIO					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_saldom")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_saldom",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_saldom"));//Saldo en la moneda original del documento que se va a cobrar. OBLIGATORIO					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_descr")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_descr",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_descr"));//Descripción del documento que se va a cobrar					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_paridad")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_paridad",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_paridad"));//Paridad actual de la moneda en que se hizo el documento que se va a cobrar. OBLIGATORIO					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_par_orig")&!"")	setXml(xmlDoc,"k_movcartera","r"&i,"k_par_orig",	getXml(wsDoc,"k_cobros","cobro["&i&"]","k_par_orig"));//Paridad original en el momento que se hizo el documento que se va a cobrar.  OBLIGATORIO   					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_monto_orig")&!"")	setXml(xmlDoc,"k_movcartera","r"&i,"k_monto_orig",	getXml(wsDoc,"k_cobros","cobro["&i&"]","k_monto_orig"));//Monto original del documento que se va a cobrar. OBLIGATORIO   					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_saldo")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_saldo",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_saldo"));//Saldo del documento que se va a cobrar. OBLIGATORIO 					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_monto")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_monto",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_monto"));//Monto que se va a cobrar.  OBLIGATORIO    					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_naturaleza")&!"")	setXml(xmlDoc,"k_movcartera","r"&i,"k_naturaleza",	getXml(wsDoc,"k_cobros","cobro["&i&"]","k_naturaleza"));//Naturaleza del documento que se va a cobrar.  OBLIGATORIO   					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_grupo")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_grupo",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_grupo"));//Grupo del documento que se va a cobrar.  OBLIGATORIO   					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_tipo")&!"")			setXml(xmlDoc,"k_movcartera","r"&i,"k_tipo",			getXml(wsDoc,"k_cobros","cobro["&i&"]","k_tipo"));//Tipo del documento que se va a cobrar.  OBLIGATORIO  					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_folio")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_folio",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_folio"));//Folio del documento que se va a cobrar.  OBLIGATORIO 					if(getXml(wsDoc,"k_cobros","cobro["&i&"]","k_fecha")&!"")		setXml(xmlDoc,"k_movcartera","r"&i,"k_fecha",		getXml(wsDoc,"k_cobros","cobro["&i&"]","k_fecha"));//Fecha del documento que se va a cobrar.    OBLIGATORIO				}				//----Se usa el SP k_opeUpdate para dar de alta el documento				kdb.connect();				kdb.sp("k_opeUpdate",xmlDoc,"res:res","getDoc:datDoc",param1,param2,param3,param4,param5,param6,param7,param8,param9,param10,param11);				kdb.exec();				if(kdb.get("res","ok")==1){					setXml(res,"ok",1);					setXml(res,"message","Documento Actualizado");					setXml(res,"doc",kdb.get("res","doc"));					setXml(res,"folio",kdb.get("res","folio"));				}else{					setXml(res,"ok",0);					setXml(res,"err",kdb.get("res","err"));					setXml(res,"nErr",kdb.get("res","n"));									}				kdb.close();				return res;							}						fun GetCurrency(xmlInput) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<getCurrencyRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<SearchCurrency>							<k_moneda>...</k_moneda>							<k_fechaIni>...</k_fechaIni>							<k_fechaFin>...</k_fechaFin>						</SearchCurrency>					</getCurrencyRequest>				</soap:Body>			</soap:Envelope>							*/				var xmlOutput;				var k_moneda=getXml(xmlInput,"k_moneda");				var k_fechaIni=getXml(xmlInput,"k_fechaIni");				var k_fechaFin=getXml(xmlInput,"k_fechaFin");				kdb.connect();				kdb.open("m,kdmy,p,kdmz");				if(k_moneda&!"")		kdb.lim("m1='"&k_moneda&"'");				if(k_fechaIni&!"")	kdb.lim("p2>='"&k_fechaIni&"'");				if(k_fechaFin&!"")	kdb.lim("p2<='"&k_fechaFin&"'");				kdb.tableX("0,dat1,m,1,&,m1...m7");				kdb.tableX("1,dat2,p,1,m1,&,p1...p4");				kdb.exec();				for(var i=0,n=kdb.N("dat1");i<n;i++) {					setXml(xmlOutput,"Moneda["&i&"]","k_id",kdb.get("dat1","r"&i,"m1"));					setXml(xmlOutput,"Moneda["&i&"]","k_dscr",kdb.get("dat1","r"&i,"m2"));					setXml(xmlOutput,"Moneda["&i&"]","k_name",kdb.get("dat1","r"&i,"m3"));					setXml(xmlOutput,"Moneda["&i&"]","k_divisa",kdb.get("dat1","r"&i,"m4"));					setXml(xmlOutput,"Moneda["&i&"]","k_complementaria",kdb.get("dat1","r"&i,"m5"));					setXml(xmlOutput,"Moneda["&i&"]","k_utilidad",kdb.get("dat1","r"&i,"m6"));					setXml(xmlOutput,"Moneda["&i&"]","k_perdida",kdb.get("dat1","r"&i,"m7"));					for(var i2=0,n2=kdb.N("dat1","r"&i,"dat2");i2<n2;i2++) {						setXml(xmlOutput,"Moneda["&i&"]","Paridad["&i2&"]","k_fecha",kdb.get("dat1","r"&i,"dat2","r"&i2,"p2"));						setXml(xmlOutput,"Moneda["&i&"]","Paridad["&i2&"]","k_hora",kdb.get("dat1","r"&i,"dat2","r"&i2,"p3"));						setXml(xmlOutput,"Moneda["&i&"]","Paridad["&i2&"]","k_paridad",kdb.get("dat1","r"&i,"dat2","r"&i2,"p4"));					}				}				kdb.close();				return xmlOutput;							}						fun GetDocConfig(xmlInput) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<docConfigRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<SearchConfig>							<k_genero>...</k_genero>							<k_naturaleza>...</k_naturaleza>							<k_grupo>...</k_grupo>							<k_tipo>...</k_tipo>							<add>...</add>							</SearchConfig>					</docConfigRequest>				</soap:Body>			</soap:Envelope>							*/				var xmlOutput,cmd;				var k_genero=getXml(xmlInput,"k_genero");				var k_naturaleza=getXml(xmlInput,"k_naturaleza");				var k_grupo=getXml(xmlInput,"k_grupo");				var k_tipo=getXml(xmlInput,"k_tipo");								kdb.connect();				kdb.open("m,kdmm");				if(k_genero&!"")		kdb.lim("m1='"&k_genero&"'");				if(k_naturaleza&!"")	kdb.lim("m2='"&k_naturaleza&"'");				if(k_grupo&!"")		kdb.lim("m3='"&k_grupo&"'");				if(k_tipo&!"")			kdb.lim("m4='"&k_tipo&"'");				cmd="dat,m,1,&,m1...m5";				for(var i=0,n=nXml(xmlInput);i<n;i++) {					if			(getXml(xmlInput,"add["&i&"]")&="k_contabilidad")			cmd=cmd&",m6";//S=Afecta Contabilidad General					else if	(getXml(xmlInput,"add["&i&"]")&="k_cxccxp")					cmd=cmd&",m7";//S=Afecta Cuentas x Cobrar ó Ctas x Pagar					else if	(getXml(xmlInput,"add["&i&"]")&="k_inventarios")			cmd=cmd&",m8";//S=Afecta Inventarios					else if	(getXml(xmlInput,"add["&i&"]")&="k_estadisticas")			cmd=cmd&",m9";//S=Afecta estadística de ventas brutas ó N=No afecta					else if	(getXml(xmlInput,"add["&i&"]")&="k_bonificaciones")		cmd=cmd&",m10";//S=Afecta estadística de bonificaciones ó N=No afecta					else if	(getXml(xmlInput,"add["&i&"]")&="k_devoluciones")			cmd=cmd&",m11";//S=Afecta estadística de devoluciones ó N=No afecta					else if	(getXml(xmlInput,"add["&i&"]")&="k_ncredito")				cmd=cmd&",m12";//S=Afecta estadística de Notas de crédito ó N=No afecta					else if	(getXml(xmlInput,"add["&i&"]")&="k_ncargo")					cmd=cmd&",m13";//S=Afecta estadística de Notas de cargo ó N=No afect					else if	(getXml(xmlInput,"add["&i&"]")&="k_fcobpag")					cmd=cmd&",m14";//S=Afecta fecha del último cobro ó N=No afecta					else if	(getXml(xmlInput,"add["&i&"]")&="k_isr")						cmd=cmd&",m15";//Porcentaje de retención del ISR					else if	(getXml(xmlInput,"add["&i&"]")&="k_iva")						cmd=cmd&",m16";//IVA porcentual (99 toma IVA del producto)					else if	(getXml(xmlInput,"add["&i&"]")&="k_folio")					cmd=cmd&",m17";//Nombre del archivo que contiene el folio					else if	(getXml(xmlInput,"add["&i&"]")&="k_tpoliza")					cmd=cmd&",m18";//El tipo de póliza a producir: E/I/D					else if	(getXml(xmlInput,"add["&i&"]")&="k_cargo")					cmd=cmd&",m19";//Cuenta contable del Cargo					else if	(getXml(xmlInput,"add["&i&"]")&="k_abono")					cmd=cmd&",m20";//Cuenta contable del Abono					else if	(getXml(xmlInput,"add["&i&"]")&="k_civa")						cmd=cmd&",m21";//Cuenta contable del IVA					else if	(getXml(xmlInput,"add["&i&"]")&="k_cieps")					cmd=cmd&",m22";//Cuenta contable del IEPS					else if	(getXml(xmlInput,"add["&i&"]")&="k_cContExtra1")			cmd=cmd&",m23";//Cuenta contable extra 1					else if	(getXml(xmlInput,"add["&i&"]")&="k_cContExtra2")			cmd=cmd&",m24";//Cuenta contable extra 2					else if	(getXml(xmlInput,"add["&i&"]")&="k_ncampoCPrincipal")		cmd=cmd&",m25";//Número del campo a añadir a la cuenta principal					else if	(getXml(xmlInput,"add["&i&"]")&="k_ncampoCSecundaria")	cmd=cmd&",m26";//Número del campo a añadir a la cuenta secundaria					else if	(getXml(xmlInput,"add["&i&"]")&="k_movRojo")					cmd=cmd&",m27";//S=Restinge a no facturar en rojo					else if	(getXml(xmlInput,"add["&i&"]")&="k_ctaCompPrincipal")		cmd=cmd&",m28";//S=Divide la cta princiapl en cuentas complemetarias					else if	(getXml(xmlInput,"add["&i&"]")&="k_ctaCompSecundaria")	cmd=cmd&",m29";//S=Divide la cta secundaria en cuentas complemetaria					else if	(getXml(xmlInput,"add["&i&"]")&="k_ctaCompIva")				cmd=cmd&",m30";//S=Divide la cta de IVA en cuentas complemetarias					else if	(getXml(xmlInput,"add["&i&"]")&="k_ctaCompIeps")			cmd=cmd&",m31";//S=Divide la cta de IEPS en cuentas complemetarias					else if	(getXml(xmlInput,"add["&i&"]")&="k_ncampoFol")				cmd=cmd&",m32";//No. de campo a añadir al nombre del archivo de folio					else if	(getXml(xmlInput,"add["&i&"]")&="k_ivaret")					cmd=cmd&",m33";//Porciento de IVA retenido					else if	(getXml(xmlInput,"add["&i&"]")&="k_cContExtra3")			cmd=cmd&",m34";//Cuenta contable extra 3					else if	(getXml(xmlInput,"add["&i&"]")&="k_cContExtra4")			cmd=cmd&",m35";//Cuenta contable extra 4					else if	(getXml(xmlInput,"add["&i&"]")&="k_cContExtra5")			cmd=cmd&",m36";//Cuenta contable extra 5					else if	(getXml(xmlInput,"add["&i&"]")&="k_cContExtra6")			cmd=cmd&",m37";//Cuenta contable extra 6					else if	(getXml(xmlInput,"add["&i&"]")&="k_cContExtra7")			cmd=cmd&",m38";//Cuenta contable extra 7					else if	(getXml(xmlInput,"add["&i&"]")&="k_cContExtra8")			cmd=cmd&",m39";//Cuenta contable extra 8					else if	(getXml(xmlInput,"add["&i&"]")&="k_cContExtra9")			cmd=cmd&",m40";//Cuenta contable extra 9					else if	(getXml(xmlInput,"add["&i&"]")&="k_cContExtra10")			cmd=cmd&",m41";//Cuenta contable extra 10					else if	(getXml(xmlInput,"add["&i&"]")&="k_cliExtra1")				cmd=cmd&",m50";//Campo que contiene la clave del cliente extra 1					else if	(getXml(xmlInput,"add["&i&"]")&="k_cliExtra2")				cmd=cmd&",m51";//Campo que contiene la clave del cliente extra 2					else if	(getXml(xmlInput,"add["&i&"]")&="k_cliExtra3")				cmd=cmd&",m52";//Campo que contiene la clave del cliente extra 3					else if	(getXml(xmlInput,"add["&i&"]")&="k_cliExtra4")				cmd=cmd&",m53";//Campo que contiene la clave del cliente extra 4					else if	(getXml(xmlInput,"add["&i&"]")&="k_cliExtra5")				cmd=cmd&",m54";//Campo que contiene la clave del cliente extra 5					else if	(getXml(xmlInput,"add["&i&"]")&="k_cliExtra6")				cmd=cmd&",m55";//Campo que contiene la clave del cliente extra 6					else if	(getXml(xmlInput,"add["&i&"]")&="k_cliExtra7")				cmd=cmd&",m56";//Campo que contiene la clave del cliente extra 7					else if	(getXml(xmlInput,"add["&i&"]")&="k_cliExtra8")				cmd=cmd&",m57";//Campo que contiene la clave del cliente extra 8					else if	(getXml(xmlInput,"add["&i&"]")&="k_cliExtra9")				cmd=cmd&",m58";//Campo que contiene la clave del cliente extra 9					else if	(getXml(xmlInput,"add["&i&"]")&="k_cliExtra10")				cmd=cmd&",m59";//Campo que contiene la clave del cliente extra 10					else if	(getXml(xmlInput,"add["&i&"]")&="k_provExtra1")				cmd=cmd&",m60";//Campo que contiene la clave del proveedor extra 1					else if	(getXml(xmlInput,"add["&i&"]")&="k_provExtra2")				cmd=cmd&",m61";//Campo que contiene la clave del proveedor extra 2					else if	(getXml(xmlInput,"add["&i&"]")&="k_provExtra3")				cmd=cmd&",m62";//Campo que contiene la clave del proveedor extra 3					else if	(getXml(xmlInput,"add["&i&"]")&="k_provExtra4")				cmd=cmd&",m63";//Campo que contiene la clave del proveedor extra 4					else if	(getXml(xmlInput,"add["&i&"]")&="k_provExtra5")				cmd=cmd&",m64";//Campo que contiene la clave del proveedor extra 5					else if	(getXml(xmlInput,"add["&i&"]")&="k_provExtra6")				cmd=cmd&",m65";//Campo que contiene la clave del proveedor extra 6					else if	(getXml(xmlInput,"add["&i&"]")&="k_provExtra7")				cmd=cmd&",m66";//Campo que contiene la clave del proveedor extra 7					else if	(getXml(xmlInput,"add["&i&"]")&="k_provExtra8")				cmd=cmd&",m67";//Campo que contiene la clave del proveedor extra 8					else if	(getXml(xmlInput,"add["&i&"]")&="k_provExtra9")				cmd=cmd&",m68";//Campo que contiene la clave del proveedor extra 9					else if	(getXml(xmlInput,"add["&i&"]")&="k_provExtra10")			cmd=cmd&",m69";//Campo que contiene la clave del proveedor extra 10				}				kdb.table(cmd);				kdb.exec();				for(var i=0,n=kdb.N("dat");i<n;i++) {					setXml(xmlOutput,"DocInfo["&i&"]","k_genero",kdb.get("dat","r"&i,"m1"));//Genero del documento					setXml(xmlOutput,"DocInfo["&i&"]","k_naturaleza",kdb.get("dat","r"&i,"m2"));//Naturaleza del documento					setXml(xmlOutput,"DocInfo["&i&"]","k_grupo",kdb.get("dat","r"&i,"m3"));//Grupo del documento					setXml(xmlOutput,"DocInfo["&i&"]","k_tipo",kdb.get("dat","r"&i,"m4"));//Tipo del documento					setXml(xmlOutput,"DocInfo["&i&"]","k_dscr",kdb.get("dat","r"&i,"m5"));//Descripción del documento					if(kdb.get("dat","r"&i,"m6")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_contabilidad",kdb.get("dat","r"&i,"m6"));//S=Afecta Contabilidad General					if(kdb.get("dat","r"&i,"m7")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_cxccxp",kdb.get("dat","r"&i,"m7"));//S=Afecta Cuentas x Cobrar ó Ctas x Pagar					if(kdb.get("dat","r"&i,"m8")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_inventarios",kdb.get("dat","r"&i,"m8"));//S=Afecta Inventarios					if(kdb.get("dat","r"&i,"m9")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_estadisticas",kdb.get("dat","r"&i,"m9"));//S=Afecta estadística de ventas brutas ó N=No afecta					if(kdb.get("dat","r"&i,"m10")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_bonificaciones",kdb.get("dat","r"&i,"m10"));//S=Afecta estadística de bonificaciones ó N=No afecta					if(kdb.get("dat","r"&i,"m11")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_devoluciones",kdb.get("dat","r"&i,"m11"));//S=Afecta estadística de devoluciones ó N=No afecta					if(kdb.get("dat","r"&i,"m12")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_ncredito",kdb.get("dat","r"&i,"m12"));//S=Afecta estadística de Notas de crédito ó N=No afecta					if(kdb.get("dat","r"&i,"m13")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_ncargo",kdb.get("dat","r"&i,"m13"));//S=Afecta estadística de Notas de cargo ó N=No afect					if(kdb.get("dat","r"&i,"m14")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_fcobpag",kdb.get("dat","r"&i,"m14"));//S=Afecta fecha del último cobro ó N=No afecta					if(kdb.get("dat","r"&i,"m15")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_isr",kdb.get("dat","r"&i,"m15"));//Porcentaje de retención del ISR					if(kdb.get("dat","r"&i,"m16")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_iva",kdb.get("dat","r"&i,"m16"));//IVA porcentual (99 toma IVA del producto)					if(kdb.get("dat","r"&i,"m17")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_folio",kdb.get("dat","r"&i,"m17"));//Nombre del archivo que contiene el folio					if(kdb.get("dat","r"&i,"m18")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_tpoliza",kdb.get("dat","r"&i,"m18"));//El tipo de póliza a producir: E/I/D					if(kdb.get("dat","r"&i,"m19")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_cargo",kdb.get("dat","r"&i,"m19"));//Cuenta contable del Cargo					if(kdb.get("dat","r"&i,"m20")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_abono",kdb.get("dat","r"&i,"m20"));//Cuenta contable del Abono					if(kdb.get("dat","r"&i,"m21")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_civa",kdb.get("dat","r"&i,"m21"));//Cuenta contable del IVA					if(kdb.get("dat","r"&i,"m22")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_cieps",kdb.get("dat","r"&i,"m22"));//Cuenta contable del IEPS					if(kdb.get("dat","r"&i,"m23")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_cContExtra1",kdb.get("dat","r"&i,"m23"));//Cuenta contable extra 1					if(kdb.get("dat","r"&i,"m24")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_cContExtra2",kdb.get("dat","r"&i,"m24"));//Cuenta contable extra 2					if(kdb.get("dat","r"&i,"m25")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_ncampoCPrincipal",kdb.get("dat","r"&i,"m25"));//Número del campo a añadir a la cuenta principal					if(kdb.get("dat","r"&i,"m26")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_ncampoCSecundaria",kdb.get("dat","r"&i,"m26"));//Número del campo a añadir a la cuenta secundaria					if(kdb.get("dat","r"&i,"m27")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_movRojo",kdb.get("dat","r"&i,"m27"));//S=Restinge a no facturar en rojo					if(kdb.get("dat","r"&i,"m28")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_ctaCompPrincipal",kdb.get("dat","r"&i,"m28"));//S=Divide la cta princiapl en cuentas complemetarias					if(kdb.get("dat","r"&i,"m29")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_ctaCompSecundaria",kdb.get("dat","r"&i,"m29"));//S=Divide la cta secundaria en cuentas complemetaria					if(kdb.get("dat","r"&i,"m30")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_ctaCompIva",kdb.get("dat","r"&i,"m30"));//S=Divide la cta de IVA en cuentas complemetarias					if(kdb.get("dat","r"&i,"m31")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_ctaCompIeps",kdb.get("dat","r"&i,"m31"));//S=Divide la cta de IEPS en cuentas complemetarias					if(kdb.get("dat","r"&i,"m32")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_ncampoFol",kdb.get("dat","r"&i,"m32"));//No. de campo a añadir al nombre del archivo de folio					if(kdb.get("dat","r"&i,"m33")&!"")	setXml(xmlOutput,"DocInfo["&i&"]","k_ivaret",kdb.get("dat","r"&i,"m33"));//Porciento de IVA retenido					if(kdb.get("dat","r"&i,"m34")&!"")	setXml(xmlOutput,"DocInfo["&i&"]"