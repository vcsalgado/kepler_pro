t","i70"));//Nombre Completo de la Imagen EJ. imagenA1.jpg					setXml(xmlOutput,"Item","k_costtype",			kdb.get("dat","i100"));//Tipo de Costo (E) Estandar (P) Promedio					setXml(xmlOutput,"Item","k_barcode2",			kdb.get("dat","i101"));//codigo de barras 2					setXml(xmlOutput,"Item","k_price20",			kdb.get("dat","i179"));//precio 20									} else {setXml(xmlOutput,"ok","0"); setXml(xmlOutput,"err","Item not found");}				kdb.close();							return xmlOutput;							}						fun SetItem(item) {			/*			<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">				<soap:Body>					<setItemRequest>						<Login>							<user>...</user>							<pass>...</pass>							<datasource>...</datasource>						</Login>						<Item>							<k_code>...</k_code>										//Clave del producto							<k_dscr>...</k_dscr>										//Descripción del producto							<k_line>...</k_line>										//Línea al que pertenece el producto							<k_type>...</k_type>										//Tipo al que pertenece el producto							<k_grp>...</k_grp>										//Grupo al que pertenece el producto							<k_suppliercode>...</k_suppliercode>				//Código del proveedor							<k_barcode>...</k_barcode>								//Código de barras							<k_supplier>...</k_supplier>							//Clave del proveedor principal							<k_supplier2>...</k_supplier2>						//Clave del proveedor secundario							<k_location>...</k_location>							//Clave de la ubicación dentro del almacén							<k_unit>...</k_unit>										//Unidad de medida							<k_unit2>...</k_unit2>									//Unidad alternativa							<k_factor>...</k_factor>								//Factor de conversión=# unidades/unidad alternativa							<k_price>...</k_price>									//Primer precio del producto							<k_price2>...</k_price2>								//Segundo precio del producto							<k_price3>...</k_price3>								//Tercer precio del producto							<k_price4>...</k_price4>								//Cuarto precio del producto							<k_tax>...</k_tax>										//IVA porcentual del producto							<k_tax2>...</k_tax2>										//Impuesto especial sobre bienes y servicios (%)							<k_currency>...</k_currency>							//La clave de la moneda de los precios de venta							<k_serial>...</k_serial>								//S si requiere número de serie ó N si nó							<k_lot>...</k_lot>										//S=control de lotes; F=con fecha; N=no requiere							<k_cost>...</k_cost>										//Precio de lista del proveedor							<k_discount>...</k_discount>								//Descuento que ordinariamente dá el proveedor							<k_replaces>...</k_replaces>							//Clave del producto que lo substituye (si es el caso							<k_equivalent>...</k_equivalent>						//Clave del producto equivalente							<k_import>...</k_import>								//S si el producto es de importación							<k_haramtariffcode>...</k_haramtariffcode>		//Fracción arancelaria							<k_dta>...</k_dta>										//Porcentaje de DTA							<k_country>...</k_country>								//Clave del pais de origen							<k_costcurr>...</k_costcurr>							//Clave de la moneda de compra							<k_langdscr>...</k_langdscr>							//Descripción del producto en el idioma de origen							<k_invmin>...</k_invmin>								//Nivel de inventario mínimo							<k_minpurchord>...</k_minpurchord>					//Cantidad mínima antes de orden de compra							<k_invmax>...</k_invmax>								//Nivel de inventario máximo							<k_size>...</k_size>										//Medida ó talla del producto (ó tipo de insumo prod)							<k_smc5>...</k_smc5>										//Quinta clave de clasificación (talla model color)							<k_smc6>...</k_smc6>										//Sexta clave de clasificación (talla model color)							<k_comment1>...</k_comment1>							//Renglón de comentarios al producto 1							<k_comment2>...</k_comment2>							//Renglón de comentarios al producto 2							<k_comment3>...</k_comment3>							//Renglón de comentarios al producto 3							<k_lot2>...</k_lot2>										//Lote de compra ó fabricación							<k_location2>...</k_location2>						//S si el producto requiere control por ubicación							<k_nsmc>...</k_nsmc>										//No. de campos del modelo Talla, Modelo y Color							<k_draw>...</k_draw>										//Clave del dibujo							<k_path>...</k_path>										//Clave de ruta de fabricación							<k_englevel>...</k_englevel>							//Nivel de ingenieria							<k_nat>...</k_nat>										//F=Fabricación M=Maquila C=Compra A=FyC N=NoInventar							<k_mov>...</k_mov>										//A=Alto Movimiento B=Mediano C=Bajo							<k_inidate>...</k_inidate>								//Fecha de inicio de vigencia							<k_status>...</k_status>								//Estatus: A=Activo I=Inactivo							<k_delivery>...</k_delivery>							//Tiempo de entrega							<k_minstation2>...</k_minstation2>					//Mínimo en la estación 2							<k_maxstation2>...</k_maxstation2>					//Máximo en la estación 2							<k_reorder2>...</k_reorder2>							//Punto de reorden de la estación 2							<k_inistationdate2>...</k_inistationdate2>		//Fecha de inicio de la estación 2							<k_minstation3>...</k_minstation3>					//Mínimo en la estación 3							<k_maxstation3>...</k_maxstation3>					//Máximo en la estación 3							<k_reorder3>...</k_reorder3>							//Punto de reorden de la estación 3							<k_inistationdate3>...</k_inistationdate3>		//Fecha de inicio de la estación 3							<k_mixstation4>...</k_mixstation4>					//Mínimo en la estación 4							<k_maxstation4>...</k_maxstation4>					//Máximo en la estación 4							<k_reorder4>...</k_reorder4>							//Punto de reorden de la estación 4							<k_inistationdate4>...</k_inistationdate4>		//Fecha de inicio de la estación 4							<k_inistationdate1>...</k_inistationdate1>		//Fecha de inicio de la estación 1							<k_waste>...</k_waste>									//Porcentaje de merma							<k_smc>...</k_smc>										//0=No 1=control x talla 2=Tll-Modelo 3=Tll-Mdl-Color							<k_lottrans>...</k_lottrans>							//Lote de Transferencia							<k_image>...</k_image>									//Nombre Completo de la Imagen EJ. imagenA1.jpg							<k_costtype>...</k_costtype>							//Tipo de Costo (E) Estandar (P) Promedio							<k_barcode2>...</k_barcode2>							//codigo de barras 2							<k_price20>...</k_price20>								//precio 20						</Item>					</setItemRequest>				</soap:Body>			</soap:Envelope>				*/				var cmd="dat,c,1,'"&getXml(item,"k_code")&"',&";																				//Clave del producto				var xmlOutput;				kdb.connect();				kdb.open("i,kdii");							var values;				if(getXml(item,"k_dscr")&!"")						values=values&",2,'"&getXml(item,"k_dscr")&"'";						//Descripción del producto				if(getXml(item,"k_line")&!"")						values=values&",3,'"&getXml(item,"k_line")&"'";						//Línea al que pertenece el producto				if(getXml(item,"k_type")&!"")						values=values&",4,'"&getXml(item,"k_type")&"'";						//Tipo al que pertenece el producto				if(getXml(item,"k_grp")&!"")						values=values&",5,'"&getXml(item,"k_grp")&"'";						//Grupo al que pertenece el producto				if(getXml(item,"k_suppliercode")&!"")			values=values&",6,'"&getXml(item,"k_suppliercode")&"'";			//Código del proveedor				if(getXml(item,"k_barcode")&!"")					values=values&",7,'"&getXml(item,"k_barcode")&"'";					//Código de barras				if(getXml(item,"k_supplier")&!"")				values=values&",8,'"&getXml(item,"k_supplier")&"'";				//Clave del proveedor principal				if(getXml(item,"k_supplier2")&!"")				values=values&",9,'"&getXml(item,"k_supplier2")&"'";				//Clave del proveedor secundario				if(getXml(item,"k_location")&!"")				values=values&",10,'"&getXml(item,"k_location")&"'";				//Clave de la ubicación dentro del almacén				if(getXml(item,"k_unit")&!"")						values=values&",11,'"&getXml(item,"k_unit")&"'";					//Unidad de medida				if(getXml(item,"k_unit2")&!"")					values=values&",12,'"&getXml(item,"k_unit2")&"'";					//Unidad alternativa				if(getXml(item,"k_factor")&!"")					values=values&",13,'"&getXml(item,"k_factor")&"'";					//Factor de conversión=# unidades/unidad alternativa				if(getXml(item,"k_price")&!"")					values=values&",14,'"&getXml(item,"k_price")&"'";					//Primer precio del producto				if(getXml(item,"k_price2")&!"")					values=values&",15,'"&getXml(item,"k_price2")&"'";					//Segundo precio del producto				if(getXml(item,"k_price3")&!"")					values=values&",16,'"&getXml(item,"k_price3")&"'";					//Tercer precio del producto				if(getXml(item,"k_price4")&!"")					values=values&",17,'"&getXml(item,"k_price4")&"'";					//Cuarto precio del producto				if(getXml(item,"k_tax")&!"")						values=values&",18,'"&getXml(item,"k_tax")&"'";						//IVA porcentual del producto				if(getXml(item,"k_tax2")&!"")						values=values&",19,'"&getXml(item,"k_tax2")&"'";					//Impuesto especial sobre bienes y servicios (%)				if(getXml(item,"k_currency")&!"")				values=values&",20,'"&getXml(item,"k_currency")&"'";				//La clave de la moneda de los precios de venta				if(getXml(item,"k_serial")&!"")					values=values&",21,'"&getXml(item,"k_serial")&"'";					//S si requiere número de serie ó N si nó				if(getXml(item,"k_lot")&!"")						values=values&",22,'"&getXml(item,"k_lot")&"'";						//S=control de lotes; F=con fecha; N=no requiere				if(getXml(item,"k_cost")&!"")						values=values&",23,'"&getXml(item,"k_cost")&"'";					//Precio de lista del proveedor				if(getXml(item,"k_discount")&!"")				values=values&",24,'"&getXml(item,"k_discount")&"'";				//Descuento que ordinariamente dá el proveedor				if(getXml(item,"k_replaces")&!"")				values=values&",25,'"&getXml(item,"k_replaces")&"'";				//Clave del producto que lo substituye (si es el caso				if(getXml(item,"k_equivalent")&!"")				values=values&",26,'"&getXml(item,"k_equivalent")&"'";			//Clave del producto equivalente				if(getXml(item,"k_import")&!"")					values=values&",27,'"&getXml(item,"k_import")&"'";					//S si el producto es de importación				if(getXml(item,"k_haramtariffcode")&!"")		values=values&",28,'"&getXml(item,"k_haramtariffcode")&"'";		//Fracción arancelaria				if(getXml(item,"k_dta")&!"")						values=values&",29,'"&getXml(item,"k_dta")&"