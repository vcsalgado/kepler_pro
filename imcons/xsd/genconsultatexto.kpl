<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">
<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0">
<!--<grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,35,15" bclr="192,205,213" unfont="0">-->

	<br/>
	<br/>
		<tab/>
		 
<!--	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="18,12,20,8" brdr="0,5" tit="Texto Emergente" fnt="Arial,16">-->
        <grp id="gpo_general" bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="70,11,7,11" brdr="0,5" fnt="Arial,16">
			<tab/><br/><tab/>
				<inp id="k_texto" dim="65,2" brdr="1,0" clr="64,64,64" clrBrdr="255,255,255"
					type="capital" modify="Y" available="Y" nc="300" OnEnter="cierra_calc(k_btn_cons)" bclr="255,255,255"/>
            <br/>


		<br/>
		<tab n="9"/>
		<bot id="k_btn_cons" dim="14,0" brdr="5" text="Aceptar" hk="K" step="0" OnEnter="cierra_calc(k_btn_cons)"/>
        <br/>
		</grp>
</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, externo, cuboXml;
			//var strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna, clave, modelo, clave_2; 
			var texto_padre, id_ele_grafic, ele_tabla, ren_tabla, col_tabla, strTitulo, accion;
			fun Main(){
				frn=new FRNT;
				kdb=new KDB;
				frP=new FRNTP;
				sys=new SYS;
				kdb.connect();
				
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				perfil_usuario = frn.lib("libKepler","UserInfo(2)");
				rol_usuario = frn.config("user","role");
				
				texto_padre = frn.param(0);         //Texto a mostrar en la pantalla
				id_ele_grafic = frn.param(1);       //Nombre input

				ele_tabla = frn.param(2);           //Nombre tabla
				ren_tabla = frn.param(3);           //renglon
				col_tabla = frn.param(4);           //nombre columna
                strTitulo = frn.param(5);           //titulo
                accion = frn.param(6);              //M-Modificar  C-Consultar

				Inicializa();
				frn.setPos("k_btn_cons");

			}

			fun cierra_calc(){
				var resultado = frn.get("k_texto");
                if (accion &= "M"){
                    if (ele_tabla&!""){
                        frP.setX(resultado, ele_tabla,ren_tabla,col_tabla);
                        frn.exit();
                    }else{
                        frP.set(id_ele_grafic,resultado);
                        frn.exit();
                    }
				} else {
                    frn.exit();
                }
			}

					
			fun Inicializa(){
				frn.rst("gpo_general");
				Inicia_Forma();	

				}

			fun Inicia_Forma(){
				var cmd,ok,mensajeError, cubo;
				//Etiquetas 
                frn.set();
                frn.setAtt("gpo_general","tit",strTitulo);
				frn.set("k_texto",texto_padre);
                if (accion &= "M"){
                    frn.setAtt("k_texto","modify","Y");
                } else{
                    frn.setAtt("k_texto","modify","N");
                }

			}
		
//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------GAD fl4r30n
						
			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){
				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO
							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana
							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)
							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje
				*/
				var prefix=frn.lib("libKepler","langPrefix");
				var page=prefix&pag;
				var b_valido=1;
				if(iModo==0)page=pag;
				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.
					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;
				}
				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);
			}
		}
	</script>
</pag>