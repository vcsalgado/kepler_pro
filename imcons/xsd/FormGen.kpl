<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<tab/><br/><tab/><txt fnt=",22" clr="14,14,17">Formulario General</txt>		<br/>		<tab/><hLine clr="0,0,0"/>		<br/><tab/>		<grp id="grupo_crud" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112"  dim="35,9,10,30" brdr="0,5" tit="Nuevo" fnt="Arial,16">			<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/>			<br/><br/>			<tab/><txt>Clave:</txt><tab/><inp id="clave" dim="5,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital"/>			<br/><tab/><txt>Nombre : </txt><inp id="nombre" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="20"/>			<br/><tab/><txt>Edad:</txt><tab/><inp id="edad" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" fmt="5" nd="0" nc="3"/>			<br/><tab/><txt>Tasa:</txt><tab/><inp id="tasa" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" nd="2" nc="12"/>			<br/><txt>|</txt><tab/><txt>Fecha:</txt><tab/><inp id="fecha" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="date" fmt="DD/MM/CCYY" nc="-1"/>			<br/><br/>			<tab/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" visible="Y" available="Y"/><br/>		</grp>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, asterisco,resVal  ;			var cmdQuery, cuboQuery, ok, mensajeError, cubo, accion,straccion,sucursal;			var k_clave, k_nomombre, k_edad, k_tasa, k_fecha;				fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";				accion = frn.param(0);				sucursal = frn.param(1);							ConfiguraUI();				Inicializa();							}			fun Inicializa(){				ctlrs_opcion();			}														fun vacia_campos(){				frn.rst("clave");				frn.rst("nombre");				frn.rst("edad");				frn.rst("tasa");				frn.rst("fecha");			}			fun salir(){				accion="NUEVO";				vacia_campos();				Inicializa();				frn.exit();						}			fun carga_datos(){				cmdQuery = "select * from keplersc.formgenwhere c1 = '"& sucursal&"'";				rstXml(cuboQuery);				cuboQuery= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_sucursal_crud.IniCombos()");				var xml_cubo_cata=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");				frn.lib("libGeneral.kpl","FileSave",cuboQuery,"C:\Basura\cubo");						frn.setX(xml_cubo_cata);			}			fun ValidarDatos(){				if (frn.get("clave") &= "") {											frn.setPos("clave");					resVal=0;					frn.message("Debe especificar la clave","Error","Aceptar");					return;				}			}			fun Execute() {				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}							var resultado_confirmacion = frn.message("Desea continuar?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}							var xmlRequest = getXml(frn.dataPag());					frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmdQuery="SELECT * FROM keplersc.formgen_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_sucursales.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cuboQuery,"resultado");							if(resultado &= "0"){					mensajeError = getXml(cuboQuery,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frP.script("Inicia_Forma()");				if (accion &= "NUEVO" || accion &= "MODIFICAR") {						var sms =  "";					if (accion &= "NUEVO"){						sms = "Registro guardado";					}else {						sms = "Registro modificado";					}					accion="CONSULTAR";					ctlrs_opcion();					frn.message(sms ,"Mensaje","Aceptar");					}				if (accion &= "ELIMINAR"){					frn.message("Registro eliminado","Mensaje","Aceptar");					frn.exit();							}			}				fun ctrls_off(){				var strVal;				strVal="N";				frn.setAtt("clave", "available",strVal);				frn.setAtt("clave", "modify",strVal);				frn.setAtt("nombre", "available",strVal);				frn.setAtt("nombre", "modify",strVal);				frn.setAtt("edad", "available",strVal);				frn.setAtt("edad", "modify",strVal);				frn.setAtt("tasa", "available",strVal);				frn.setAtt("tasa", "modify",strVal);				frn.setAtt("fecha", "available",strVal);				frn.setAtt("fecha", "modify",strVal);				frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );			}							fun ctlrs_opcion(){				var strVal;				strVal="S";				frn.set("input_crud", accion);				frn.rst("grupo_crud");				if (accion &= "NUEVO"){					frn.setAtt("clave", "available",strVal);					frn.setAtt("clave", "modify",strVal);					frn.setAtt("nombre", "available",strVal);					frn.setAtt("nombre", "modify",strVal);					frn.setAtt("edad", "available",strVal);					frn.setAtt("edad", "modify",strVal);					frn.setAtt("tasa", "available",strVal);					frn.setAtt("tasa", "modify",strVal);					frn.setAtt("fecha", "available",strVal);					frn.setAtt("fecha", "modify",strVal);					frn.setAtt("btn_aceptar", "available",strVal);					frn.setAtt("btn_aceptar", "visible",strVal);				}				if (accion &= "MODIFICAR") {					carga_datos();					frn.setAtt("nombre", "available",strVal);					frn.setAtt("nombre", "modify",strVal);					frn.setAtt("edad", "available",strVal);					frn.setAtt("edad", "modify",strVal);					frn.setAtt("tasa", "available",strVal);					frn.setAtt("tasa", "modify",strVal);					frn.setAtt("fecha", "available",strVal);					frn.setAtt("fecha", "modify",strVal);					frn.setAtt("btn_aceptar", "available",strVal);					frn.setAtt("btn_aceptar", "visible",strVal);				}				if (accion &= "CONSULTAR"){					frn.setAtt("btn_aceptar", "available", "N" );					frn.setAtt("btn_aceptar", "visible", "N" );				}			}							fun ConfiguraUI(){				if (frn.nParam() == 0){					frn.message("Accion no permitida.","Error","&Aceptar");//					frn.open("redirect",2);					return;				}			}		}	</script></pag>