d="c56" dim="5,1" type="number" nc="3" nd="0" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="" available="Y"/>			<tab n="2"/><txt>4</txt><tab/>			<inp id="c35" dim="18,1" type="capital" nc="16" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="" available="Y"/>			<tab/>			<inp id="c57" dim="5,1" type="number" nc="3" nd="0" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="" available="Y"/>			<br/><tab/><txt>IVA Anticipos</txt><tab n="4"/><txt>5</txt><tab/>			<inp id="c72" dim="18,1" type="capital" nc="16" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="" available="Y"/>			<tab n="4"/><txt>5</txt><tab/>			<inp id="c73" dim="18,1" type="capital" nc="16" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="" available="Y"/>			<br/>			<hLine clr="0,0,0"/>            <br/><tab/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" visible="N" available="N"/>			<tab/>			<bot id="btn_cancelar" dim="12,0" brdr="5" text="Cancelar" OnEnter="cancelar()" visible="N" available="N"/>		</grp>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP,sys,accion,externo, clave_sel,sucursal_id,cve_color,resVal,straccion,xml_inicial;         var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError;         var usuario, rol_usuario, suc_usuario,asterisco,anio_contable;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				kdb.connect();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";				suc_usuario = frn.lib("libKepler","UserInfo(1)");			   Inicializa();				ctlrs_off();				insertar_datos();				ctlrs_opcion();				carga_tabla();				consulta();			}			fun ValidarValor(campoIn,valores){				var strCur,strSalong,valIn;				strSalong = strSplit(valores,",",-1);				valIn = frn.get(campoIn);				for(var i=0; i<strSalong; i++){					strCur = strSplit(valores,",",i);					if (strCur &= valIn){						return;					}				}				frn.set(campoIn,getXml(xml_inicial,campoIn ));				frn.message("Valor " & valIn & "  invalido, utilizar(" & valores & ")","Error","Aceptar");				frn.setPos(campoIn);			}			fun copiar(){				var gen, nat, gpo, tipo, desc;				if (usuario &! "ADMIN80"){					frn.message("No tiene privilegios para copiar movimientos.");					return;				}				gen=frn.get("k_genero_crud");				nat=frn.get("k_naturaleza_crud");				gpo=frn.get("k_grupo_crud");				tipo=frn.get("k_tipo_crud");				desc=frn.get("k_desc_mov_crud");  				if (gen &= "" || nat &= "" || gpo &= "" || tipo &= ""){					frn.message("No ha seleccionado un movimiento de la lista.","Error","Aceptar");					return;				}				frn.dialog("cat_crud_movimientos_copiar",frn.get("k_sucn",-1,1),gen,nat,gpo,tipo,desc);			}									fun carga_datos(click){				var genero, naturaleza, grupo, tipo, xml_cubo_cata, ren, uen;				ren= frn.getJ("tabla");				if (click &=""){					genero = frn.get("tabla",-1, "c1");										naturaleza = frn.get("tabla",-1, "c2");					grupo = frn.get("tabla",-1, "c3");					tipo = frn.get("tabla",-1,"c4");				}				else{					genero = frn.get("tabla", ren, "c1");					naturaleza = frn.get("tabla",ren , "c2");					grupo = frn.get("tabla",ren, "c3");					tipo = frn.get("tabla",ren,"c4");				}				cmdQuery = "select *, c1 as k_genero_crud, c2 as k_naturaleza_crud, c3 as k_grupo_crud, c4 as k_tipo_crud, c5 as k_desc_mov_crud				,c17 as k_folio_crud, c6 as k_afecta_conta, c7 as k_afecta_cxc				from keplersc.kdmm where col_sucursal='" & frn.get("k_sucn",-1,1) & "' and c1  = '"& genero &"' and c2  = '"& naturaleza &"' and c3 = '"& grupo &"' and c4 = '"& tipo &"'";				rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_movimientos.kpl.carga_datos()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cubo");				frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\cmdQuery");				rstXml(xml_cubo_cata);				xml_cubo_cata=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cubo,"r0");				xml_inicial=xml_cubo_cata;				frn.setX(xml_cubo_cata);								frn.lib("libGeneral.kpl","FileSave",xml_cubo_cata,"C:\Basura\cubo_cata");				frn.setX(getXmlAtt(cubo,"r"&0,"c1"),"k_genero_crud",0,0);				frn.setX(getXmlAtt(cubo,"r"&0,"c2"),"k_naturaleza_crud",0,0);				uen = getXmlAtt(cubo,"r"&0,"c95");								frn.set("c95",descr_combo("c95",1,uen));								}			fun carga_tabla(){				var strQuery, cmd, cuboXml, k_genero, k_naturaleza, k_grupo, k_tipo;				k_genero=frn.get("k_genero");				k_naturaleza=frn.get("k_naturaleza");				k_grupo=frn.get("k_grupo");				k_tipo=frn.get("k_tipo");								if(k_genero &=""){					k_genero = "%%";				}				if(k_naturaleza &=""){					k_naturaleza = "%%";				}				if (k_grupo &= "0"){					k_grupo = ">" & "0";				}else{					k_grupo = "=" & k_grupo;				}				if (k_tipo &= "0"){					k_tipo = ">" & "0";				}else{					k_tipo = "=" & k_tipo;				}					strQuery = "select c1 as k_genero,						c2 as k_naturaleza, c3 as k_grupo, c4 as k_tipo,						c5 as k_desc						from keplersc.kdmm						where col_sucursal='" & frn.get("k_sucn",-1,1) & "' and c1 like '"& k_genero &"' and c2 like '"& k_naturaleza &"' and 						c3 "& k_grupo &" and c4 "& k_tipo &"						 order by c1,c2,c3,c4";				cmd = "select * from (" & strQuery & ") as resultado " ;				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_crud_movimientos.carga_tabla()");				frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\cuboPrueba");				frn.set("tabla",cuboXml);				carga_datos();			}			fun cancelar(){				consulta();				carga_datos();			}			fun consulta(){				accion="CONSULTAR";				straccion = "Consultar";				frn.set("input_crud", accion);				frn.setAtt("grupo_crud", "tit", straccion );				frn.setAtt("grupo_tabla", "available", "Y" );				frn.setAtt("grupo_crud", "available", "N" );				frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );				frn.setAtt("btn_cancelar", "available", "N" );				frn.setAtt("btn_cancelar", "visible", "N" );			}			fun agregar(){				accion = "NUEVO";				straccion = "Nuevo";				frn.set("input_crud", accion);				frn.setAtt("grupo_crud", "tit", straccion );				frn.setAtt("grupo_tabla", "available", "N" );				frn.setAtt("grupo_crud", "available", "Y" );				frn.setAtt("btn_aceptar", "available", "Y" );				frn.setAtt("btn_aceptar", "visible", "Y" );				frn.setAtt("btn_cancelar", "available", "Y" );				frn.setAtt("btn_cancelar", "visible", "Y" );				frn.setAtt("k_genero_crud","available","Y");				frn.setAtt("k_genero_crud", "modify", "Y" );				frn.setAtt("k_naturaleza_crud","available","Y");				frn.setAtt("k_naturaleza_crud", "modify", "Y" );				frn.setAtt("k_grupo_crud","available","Y");				frn.setAtt("k_grupo_crud", "modify", "Y" );				frn.setAtt("k_tipo_crud","available","Y");				frn.setAtt("k_tipo_crud", "modify", "Y" );				frn.setAtt("k_folio_crud", "available", "Y" );				frn.setAtt("c8", "available", "Y" );				frn.setAtt("c76", "available", "Y" );				frn.setAtt("c65", "available", "Y" );				frn.setAtt("k_afecta_conta", "available", "Y" );				frn.setAtt("c71", "available", "Y" );				frn.setAtt("k_afecta_cxc", "available", "Y" );				frn.setAtt("c47", "available", "Y" );				frn.setAtt("c11", "available", "Y" );				frn.setAtt("c14", "available", "Y" );								frn.setAtt("c51", "available", "Y" );				frn.setAtt("c9", "available", "Y" );				frn.setAtt("c92", "available", "Y" );				frn.setAtt("c10", "available", "Y" );				frn.setAtt("c77", "available", "Y" );				frn.setAtt("c67", "available", "Y" );				frn.setAtt("c66", "available", "Y" );				frn.setAtt("folio_manual", "available", "Y" );			//MSS 02032026 Permitir Modificacion, cambie C93 por folio_manual				frn.setAtt("c80", "available", "Y" );				frn.setAtt("c87", "available", "Y" );				frn.setAtt("c86", "available", "Y" );				frn.setAtt("c88", "available", "Y" );				frn.setAtt("c89", "available", "Y" );				frn.setAtt("c15", "available", "Y" );				frn.setAtt("c16", "available", "Y" );				frn.setAtt("c33", "available", "Y" );				frn.setAtt("c75", "available", "Y" );								insertar_datos();			}			fun modificar(){				accion="MODIFICAR";				straccion = "Modificar";				frn.set("input_crud", accion);				frn.setAtt("grupo_tabla", "available", "N" );				frn.setAtt("grupo_crud", "available", "Y" );				frn.setAtt("k_genero_crud", "available", "N" );				frn.setAtt("k_naturaleza_crud", "available", "N" );				frn.setAtt("k_grupo_crud", "available", "N" );				frn.setAtt("k_tipo_crud", "available", "N" );				frn.setAtt("k_desc_mov_crud", "available", "Y" );				frn.setAtt("k_desc_mov_crud", "modify", "Y" );						frn.setAtt("k_folio_crud", "available", "N" );				frn.setAtt("c95", "available", "N" );				frn.setAtt("c8", "available", "N" );				frn.setAtt("c76", "available", "N" );				frn.setAtt("c65", "available", "N" );				frn.setAtt("k_afecta_conta", "available", "N" );				frn.setAtt("c71", "available", "N" );				frn.setAtt("k_afecta_cxc", "available", "N" );				frn.setAtt("c47", "available", "N" );				frn.setAtt("c11", "available", "N" );				frn.setAtt("c14", "available", "N" );								frn.setAtt("c51", "available", "N" );				frn.setAtt("c9", "available", "N" );				frn.setAtt("c92", "available", "N" );				frn.setAtt("c10", "available", "N" );				frn.setAtt("c77", "available", "N" );				frn.setAtt("c67", "available", "N" );				frn.setAtt("c66", "available", "N" );				frn.setAtt("folio_manual", "available", "N" );			//MSS 02032026 Permitir Modificacion, cambie C93 por folio_manual				frn.setAtt("c80", "available", "N" );				frn.setAtt("c87", "available", "N" );				frn.setAtt("c86", "available", "N" );				frn.setAtt("c88", "available", "N" );				frn.setAtt("c89", "available", "N" );				frn.setAtt("c15", "available", "N" );				frn.setAtt("c16", "available", "Y" );				frn.setAtt("c33", "available", "N" );				frn.setAtt("c75", "available", "N" );				frn.setAtt("k_tipo_mov_copia","available","N");				frn.setAtt("k_tipo_mov_copia", "modify", "N" );				frn.setAtt("k_tipo_mov_copia", "visible", "N" );				frn.set("k_tipo_mov_copia_text","");				frn.setAtt("k_tipo_mov_copia_text", "visible", "N" );				frn.setAtt("grupo_crud", "tit", straccion );				frn.setAtt("grupo_crud", "available", "Y" );				frn.setAtt("btn_aceptar", "available", "Y" );				frn.setAtt("btn_aceptar", "visible", "Y" );				frn.setAtt("btn_cancelar", "available", "Y" );				frn.setAtt("btn_cancelar", "visible", "Y" );            if (usuario &="ADMIN80"){					frn.setAtt("k_desc_mov_crud", "available", "Y" );					frn.setAtt("k_desc_mov_crud", "modify", "Y" );									frn.setAtt("k_folio_crud", "available", "Y" );					frn.setAtt("c94", "available", "Y" );							//MSS 02032026 Permitir Modificacion					frn.setAtt("c95", "available", "Y" );					frn.setAtt("c8", "available", "Y" );					frn.setAtt("c76", "available", "Y" );					frn.setAtt("c65", "available", "Y" );					frn.setAtt("k_afecta_conta", "available", "Y" );					frn.setAtt("c71", "available", "Y" );					frn.setAtt("k_afecta_cxc", "available", "Y" );					frn.setAtt("c47", "available", "Y" );					frn.setAtt("c11", "available", "Y" );					frn.setAtt("c14", "available", "Y" );									frn.setAtt("c51", "available", "Y" );					frn.setAtt("c9", "available", "Y" );					frn.setAtt("c92", "available", "Y" );					frn.setAtt("c10", "available", "Y" );					frn.setAtt("c77", "available", "Y" );					frn.setAtt("c67", "available", "Y" );					frn.setAtt("c66", "available", "Y" );					frn.setAtt("folio_manual", "available", "Y" );				//MSS 02032026 Permitir Modificacion, cambie C93 por folio_manual					frn.setAtt("c80", "available", "Y" );					frn.setAtt("c87", "available", "Y" );					frn.setAtt("c86", "available", "Y" );					frn.setAtt("c88", "available", "Y" );					frn.setAtt("c89", "available", "Y" );					frn.setAtt("c15", "available", "Y" );					frn.setAtt("c16", "available", "Y" );					frn.setAtt("c33", "available", "Y" );					frn.setAtt("c75", "available", "Y" );					frn.setAtt("c18", "available", "Y" );					frn.setAtt("c19", "available", "Y" );					frn.setAtt("c25", "available", "Y" );					frn.setAtt("c20", "available", "Y" );					frn.setAtt("c26", "available", "Y" );					frn.setAtt("c21", "available", "Y" );					frn.setAtt("c30", "available", "Y" );					frn.setAtt("c22", "available", "Y" );					frn.setAtt("c64", "available", "Y" );					frn.setAtt("c74", "available", "Y" );					frn.setAtt("c36", "available", "Y" );					frn.setAtt("c58", "available", "Y" );					frn.setAtt("c37", "available", "Y" );					frn.setAtt("c59", "available", "Y" );					frn.setAtt("c38", "available", "Y" );					frn.setAtt("c60", "available", "Y" );					frn.setAtt("c39", "available", "Y" );					frn.setAtt("c61", "available", "Y" );					frn.setAtt("c40", "available", "Y" );					frn.setAtt("c62", "available", "Y" );					frn.setAtt("c41", "available", "Y" );					frn.setAtt("c63", "available", "Y" );					frn.setAtt("c23", "available", "Y" );					frn.setAtt("c54", "available", "Y" );					frn.setAtt("c34", "available", "Y" );					frn.setAtt("c56", "available", "Y" );					frn.setAtt("c72", "available", "Y" );					frn.setAtt("c24", "available", "Y" );					frn.setAtt("c55", "available", "Y" );					frn.setAtt("c35", "available", "Y" );					frn.setAtt("c57", "available", "Y" );					frn.setAtt("c73", "available", "Y" );									}			}			fun Inicializa(){				accion = frn.param(0);				frn.set("input_crud", accion);				frn.rst("grupo_crud");				externo	= frn.param(2);                if (accion &= "NUEVO"){                    straccion = "Nuevo" ;                   }else if (accion &= "CONSULTAR"){                    straccion = "Consultar";                }else if (accion &= "MODIFICAR"){                    straccion = "Modificar";                }else if (accion &= "ELIMINAR"){                    straccion = "Eliminar";                }     								frn.setAtt("grupo_crud", "tit", straccion );				clave_sel = frn.param(1);				sucursal_id = frn.param(3);				if (accion &! "NUEVO"){					frn.set("k_clave", clave_sel);				}								//Llenar combo sucursales				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";					}				}							rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_crud_movimientos.IniCombos()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",cubo);									//Llenar combo unidades de negocio				frn.setX("","c95",0,0);				frn.setX("S-Servicio","c95",1,0);				frn.setX("S","c95",1,1);				frn.setX("V-Ventas","c95",2,0);				frn.setX("V","c95",2,1);				frn.setX("R-Refacciones","c95",3,0);				frn.setX("R","c95",3,1);						frn.setX("X-General","c95",4,0);				frn.setX("X","c95",4,1);					}						fun ctlrs_off(){				frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );			}							fun ctlrs_opcion(){				if (accion &= "NUEVO"){					frn.setAtt("k_genero_crud","available","Y");					frn.setAtt("k_genero_crud", "modify", "Y" );					frn.setAtt("k_naturaleza_crud","available","Y");					frn.setAtt("k_naturaleza_crud", "modify", "Y" );					frn.setAtt("k_grupo_crud","available","Y");					frn.setAtt("k_grupo_crud", "modify", "Y" );					frn.setAtt("k_tipo_crud","available","Y");					frn.setAtt("k_tipo_crud", "modify", "Y" );				   frn.set("k_titulo","Nuevo Movimiento");								}else { 					if (accion &= "MODIFICAR") {						frn.setAtt("k_genero_crud","available","N");						frn.setAtt("k_genero_crud", "modify", "N" );						frn.setAtt("k_naturaleza_crud","available","N");						frn.setAtt("k_naturaleza_crud", "modify", "N" );						frn.setAtt("k_grupo_crud","available","N");						frn.setAtt("k_grupo_crud", "modify", "N" );						frn.setAtt("k_tipo_crud","available","N");						frn.setAtt("k_tipo_crud", "modify", "N" );                  frn.setAtt("grupo_crud", "available","N");                  if (usuario &="ADMIN80"){							frn.setAtt("k_desc_mov_crud", "available", "Y" );							frn.setAtt("k_desc_mov_crud", "modify", "Y" );											frn.setAtt("k_folio_crud", "available", "Y" );							frn.setAtt("c94", "available", "Y" );					//MSS 02032026 Permitir Modificacion							frn.setAtt("c95", "available", "Y" );							frn.setAtt("c8", "available", "Y" );							frn.setAtt("c76", "available", "Y" );							frn.setAtt("c65", "available", "Y" );							frn.setAtt("k_afecta_conta", "available", "Y" );							frn.setAtt("c71", "available", "Y" );							frn.setAtt("k_afecta_cxc", "available", "Y" );							frn.setAtt("c47", "available", "Y" );							frn.setAtt("c11", "available", "Y" );							frn.setAtt("c14", "available", "Y" );											frn.setAtt("c51", "available", "Y" );							frn.setAtt("c9", "available", "Y" );							frn.setAtt("c92", "available", "Y" );							frn.setAtt("c10", "available", "Y" );							frn.setAtt("c77", "available", "Y" );							frn.setAtt("c67", "available", "Y" );							frn.setAtt("c66", "available", "Y" );							frn.setAtt("folio_manual", "available", "Y" );		//MSS 02032026 Permitir Modificacion, cambie C93 por folio_manual							frn.setAtt("c80", "available", "Y" );							frn.setAtt("c87", "available", "Y" );							frn.setAtt("c86", "available", "Y" );							frn.setAtt("c88", "available", "Y" );							frn.setAtt("c89", "available", "Y" );							frn.setAtt("c15", "available", "Y" );							frn.setAtt("c16", "available", "Y" );							frn.setAtt("c33", "available", "Y" );							frn.setAtt("c75", "available", "Y" );							frn.setAtt("c18", "available", "Y" );							frn.setAtt("c19", "available", "Y" );							frn.setAtt("c25", "available", "Y" );							frn.setAtt("c20", "available", "Y" );							frn.setAtt("c26", "available", "Y" );							frn.setAtt("c21", "available", "Y" );							frn.setAtt("c30", "available", "Y" );							frn.setAtt("c22", "available", "Y" );							frn.setAtt("c64", "available", "Y" );							frn.setAtt("c74", "available", "Y" );							frn.setAtt("c36", "available", "Y" );							frn.setAtt("c58", "available", "Y" );							frn.setAtt("c37", "available", "Y" );							frn.setAtt("c59", "available", "Y" );							frn.setAtt("c38", "available", "Y" );							frn.setAtt("c60", "available", "Y" );							frn.setAtt("c39", "available", "Y" );							frn.setAtt("c61", "available", "Y" );							frn.setAtt("c40", "available", "Y" );							frn.setAtt("c62", "available", "Y" );							frn.setAtt("c41", "available", "Y" );							frn.setAtt("c63", "available", "Y" );							frn.setAtt("c23", "available", "Y" );							frn.setAtt("c54", "available", "Y" );							frn.setAtt("c34", "available", "Y" );							frn.setAtt("c56", "available", "Y" );							frn.setAtt("c72", "available", "Y" );							frn.setAtt("c24", "available", "Y" );							frn.setAtt("c55", "available", "Y" );							frn.setAtt("c35", "available", "Y" );							frn.setAtt("c57", "available", "Y" );							frn.setAtt("c73", "available", "Y" );	                  }else{							frn.setAtt("k_afecta_conta", "available", "N" );							frn.setAtt("k_afecta_conta", "modify", "N" );							frn.setAtt("k_afecta_cxc", "available", "N" );							frn.setAtt("k_afecta_cxc", "modify", "N" );                  }               }else{						frn.setAtt("k_genero_crud","available","N");						frn.setAtt("k_genero_crud", "modify", "N" );						frn.setAtt("k_naturaleza_crud","available","N");						frn.setAtt("k_naturaleza_crud", "modify", "N" );						frn.setAtt("k_grupo_crud","available","N");						frn.setAtt("k_grupo_crud", "modify", "N" );						frn.setAtt("k_tipo_crud","available","N");						frn.setAtt("k_tipo_crud", "modify", "N" );                  frn.setAtt("grupo_crud", "available","N");						frn.setAtt("btn_aceptar", "visible", "N" );               }									}				if (accion &! "CONSULTAR"){					frn.setAtt("btn_aceptar", "available", "N" );					frn.setAtt("btn_aceptar", "visible", "N" );					frn.setAtt("btn_cancelar", "available", "N" );					frn.setAtt("btn_cancelar", "visible", "N" );				}			}							fun insertar_datos(){					frn.rst("k_grupo_crud");				frn.rst("k_tipo_crud");				frn.rst("k_folio_crud");				frn.rst("k_afecta_conta");				frn.rst("k_afecta_cxc");				frn.rst("k_desc_mov_crud");				frn.rst("c65");				frn.rst("c15");				frn.rst("c16");				frn.rst("c33");				frn.rst("c75");				frn.rst("c19");				frn.rst("c25");				frn.rst("c36");				frn.rst("c58");				frn.rst("c20");				frn.rst("c26");				frn.rst("c37");				frn.rst("c59");				frn.rst("c21");				frn.rst("c30");				frn.rst("c38");				frn.rst("c60");				frn.rst("c22");				frn.rst("c39");				frn.rst("c61");				frn.rst("c64");				frn.rst("c40");				frn.rst("c62");				frn.rst("c74");				frn.rst("c41");				frn.rst("c63");				frn.rst("c23");				frn.rst("c54");				frn.rst("c24");				frn.rst("c55");				frn.rst("c65");				frn.rst("c34");				frn.rst("c56");				frn.rst("c35");				frn.rst("c57");				frn.rst("c72");				frn.rst("c73");				//Define genero				frn.setX("", "k_genero_crud",0,0);				frn.setX("", "k_genero_crud",0,1);				frn.setX("[N]OTROS", "k_genero_crud",1,0);				frn.setX("N", "k_genero_crud",1,1);				frn.setX("[X]CXP", "k_genero_crud",2,0);				frn.setX("X", "k_genero_crud",2,1);				frn.setX("[U]CXC", "k_genero_crud",3,0);				frn.setX("U", "k_genero_crud",3,1);				//Define grupo				frn.setX("", "k_naturaleza_crud",0,0);				frn.setX("", "k_naturaleza_crud",0,1);				frn.setX("[D]DEUDORA", "k_naturaleza_crud",1,0);				frn.setX("D", "k_naturaleza_crud",1,1);				frn.setX("[A]ACREDORA", "k_naturaleza_crud",2,0);				frn.setX("A", "k_naturaleza_crud",2,1);			}						fun ValidarDatos(){				if (frn.get("k_genero_crud") &= "") {											frn.setPos("k_genero_crud");					resVal=0;					frn.message("Debe especificar el genero, verificar","Error","Aceptar");					return;				}				if (frn.get("k_naturaleza_crud") &= "") {											frn.setPos("k_naturaleza_crud");					resVal=0;					frn.message("Debe especificar la naturaleza, verificar","Error","Aceptar");					return;				}				if (frn.get("k_grupo_crud") &= "") {											frn.setPos("k_grupo_crud");					resVal=0;					frn.message("Debe especificar el grupo, verificar","Error","Aceptar");					return;				}				if (frn.get("k_tipo_crud") &= "") {											frn.setPos("k_tipo_crud");					resVal=0;					frn.message("Debe especificar el tipo, verificar","Error","Aceptar");					return;				}				if (frn.get("k_desc_mov_crud") &= "") {											frn.setPos("k_desc_mov_crud");					resVal=0;					frn.message("Debe especificar descripcion, verificar","Error","Aceptar");					return;				}			}			fun Execute() {				var strFecha, fecha, hora, strTmp;				fecha = sys.date();				hora= sys.time();								resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}								var resultado_confirmacion = frn.message("Desea continuar?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}								//MSS 03032026 Agregar datos para guardar en bitacora				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;								xmlRequest = getXml(frn.dataPag());					frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");				setXml(xmlRequest,"movimiento","usuario",usuario);				setXml(xmlRequest,"movimiento","fecha",strFecha);				setXml(xmlRequest,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));								frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest_movto");											cmdQuery="SELECT * FROM keplersc.cat_crud_movimientos('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_exteriores_crud.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}				if (accion &= "NUEVO" || accion &= "MODIFICAR") {						var sms =  "";					if (accion &= "NUEVO"){						sms = "Registro guardado";						carga_tabla();					}else {						sms = "Registro modificado";						frn.setX(frn.get("k_desc_mov_crud"),"tabla",-1,"c5");					}					accion="CONSULTAR";					ctlrs_opcion();					frn.message(sms ,"Mensaje","Aceptar");						consulta();				}				if (accion &= "ELIMINAR"){					frn.message("Registro eliminado","Mensaje","Aceptar");							}			}						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}							}	</script></pag>