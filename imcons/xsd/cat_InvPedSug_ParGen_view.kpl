<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">
<grp dim="40,20,15,15" 
	  brdr="0,0" 
	  clr="0,58,112" 
	  bclr="192,205,213" 
	  fnt="Arial,16" 
	  unfont="0" id="Principal"><br/>
			<tab/>
			<grp bclr="236,240,243" 
			fntClrBrdr="255,206,0" 
			fntBrdr="Arial,18" 
			hSpace="4" 
			clrBrdr="0,58,112" 
			brdr="0,5" 
			dim="40,40,9,9" 
			tit="Par&#225;metros Generales"
			fnt="Arial,16">
				<br/>			
				<tab n="3"/><txt>Esta opci&#243;n permite establecer los valores predeterminados de ciclo de reorden,</txt><br/>
				<tab n ="2"/><txt>leadtime, m&#225;xima fluctuaci&#243;n, de leadtime y porcentaje de tasa de servicio para</txt><br/> 
				<tab n ="2"/><txt>todas las refacciones.</txt><br/><br/><br/>
								
				<tab n="6"/><txt>Ciclo de reorden : </txt>
				<inp id="k_cicloreorden_a1" dim="5,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="Y"/><txt> d&#237;as</txt><br/>
				
				<tab n="7"/><txt>   Leadtime : </txt>
				<inp id="k_leadtime_a2" dim="5,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="Y"/><txt> d&#237;as</txt><br/>
				
				<tab n="2"/><txt>  M&#225;xima Fluctuaci&#243;n de Leadtime : </txt>
				<inp id="k_maxfluletime_a3" dim="5,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="Y"/><txt> d&#237;as</txt><br/>
								
				<tab n="5"/><txt>  Stock de seguridad : </txt>
				<inp id="k_stockseg_a5" dim="5,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="Y"/><txt> d&#237;as</txt><br/>
				
				<tab n="6"/><txt>Tasa de servicio : </txt>
				<inp id="k_tasaservicio_a4" dim="5,1" brdr="1,1" bclr="255,255,255" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="Y"/><txt> %</txt><br/>
				<br/>				
				<tab n="1"/><txt>NOTA: Al hacer un cambio en estos par&#225;metros DEBER&#193; REGENERAR el Listado MAD / MIP</txt><br/>				
				<br/>
				<tab n="9"/><bot id="btn_aceptar_A100" dim="9,0" brdr="5" text="Aceptar" OnEnter="Execute(0)" default="1" visible="Y" available="Y"/>
				<br/>
			<br/>
			</grp>
</grp>
	<script>
		InstallDriver("KDB75");
		class Main {			
			var frn,kdb,frP,externo,accion,suc_usuario,perfil_usuario,asterisco ;
			fun Main() {
				frn=new FRNT;
				frP=new FRNTP;
				kdb=new KDB;
				kdb.connect();
				ctlrs_off();
				llenar_ctlrs_default();				
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				perfil_usuario = frn.lib("libKepler","UserInfo(2)");
				asterisco="*";
				Inicializa();
			}
			fun Inicializa()
			{
				frn.setX(1,"k_cicloreorden_a1");
				frn.setX(2,"k_leadtime_a2");
				frn.setX(3,"k_maxfluletime_a3");
				frn.setX(95,"k_tasaservicio_a4");
				frn.setX(1,"k_stockseg_a5");			
				
				/*frn.setX("S", "k_DesvEst",0,0);
				frn.setX("N", "k_DesvEst",1,0);*/
				
			}
			
			
			fun ctlrs_off()
			{				
				frn.setAtt("btn_cancelar", "visible", "Y" );
				//frn.setAtt("btn_cancelar", "visible", "Y" );
				frn.setAtt("btn_aceptar", "visible", "Y" );
			}
			fun llenar_ctlrs_default()
			{
				frn.rst("principal");
				accion = frn.param(0);
				var xmlRequest,
					 cmd,
					 ok, 
					 cuboResultados,
					 mensajeError;				
				frn.setAtt("principal", "tit", accion );
				
				/*
				//Llenar combo sucursales
				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";
				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){
					cmd = cmd & " where c1='" & suc_usuario & "'";
				}else {
					if (suc_usuario &! asterisco && suc_usuario &! "" ){
						cmd = cmd & " where c1='" & suc_usuario & "'";
					}
				}

				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_InvPedSug.llenar_ctlrs_default()");
				ok = getXmlAtt(cuboResultados ,"ok");
				if(ok &! "" && !ok)
				{
				   mensajeError = getXmlAtt(cuboResultados ,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				frn.set("k_sucN",getXml(cuboResultados));
				*/
			}
			
			fun Validaciones(psOpcion)
			{
				var v_cicloReorden_A1,
					v_leadTime_A2,
					v_MaxFluleTime_A3,
					v_TasaServicio_A4,
					v_StockSeg_A5;
					
					v_cicloReorden_A1 = frn.get("k_cicloreorden_a1");					 
					if(v_cicloReorden_A1 < 1)
					{
						frn.message("El ciclo de ordenamiento no puede ser menor a 1 dia.", "ADVERTENCIA","&Aceptar");
						return 0;
					}
					v_leadTime_A2 = frn.get("k_leadtime_a2");
					if(v_leadTime_A2 < v_cicloReorden_A1)
					{
						frn.message("El lead time no puede ser menor al ciclo de ordenamiento dia", "ADVERTENCIA","&Aceptar");
						return 0;
					}
					v_MaxFluleTime_A3= frn.get("k_maxfluletime_a3");
					if(v_MaxFluleTime_A3< v_leadTime_A2)
					{
						frn.message("La fluctuacion maxima de lead time ciclo de ordenamiento no puede ser menor al lead time", "ADVERTENCIA","&Aceptar");
						return 0;
					}
					v_TasaServicio_A4= frn.get("k_tasaservicio_a4");
					if(v_TasaServicio_A4 < 1 || v_TasaServicio_A4 > 100)
					{
						frn.message("La tasa de servicio debe estar en el rango de 1 a 100 %", "ADVERTENCIA","&Aceptar");
						return 0;
					}
					v_StockSeg_A5 = frn.get("k_stockseg_a5");
					if(v_StockSeg_A5 < 1 )
					{
						frn.message("Los días del stock de seguridad no pueden ser menores a cero.", "ADVERTENCIA","&Aceptar");
						return 0;
					}
					
				
					
				return 1;
			}//end fun Validaciones
						
			fun Execute(pIOpcion)
			{
				var xmlRequest,
						cmd,
						ok, 
						cuboResultados,
						mensajeError,
						sucursal,
						fecha_r1, //fecha
						fechames_r2 = 0, //mes
						fechaanio_r3 = 0, //año
						strTmp,
						xmlPantalla,
						cubo,
						resultado,
						mensaje,
						tip_ope,
						mensaje,
						k_cicloReorden_A1,
						k_leadTime_A2,
						k_MaxFluleTime_A3,
						k_TasaServicio_A4,
						k_StockSeg_A5;
					
					
				if(pIOpcion == 0) // GUARDAR
				{				
					if(Validaciones()<=0)
					{
						return;
					}
					// SE OBTIENE LA FECHA DE LA TABLA KDPEDIDOSUGERIDOCONF Y SE VALIDA QUE SEA DE LA SUC 02
					// SE ACTUALIZA LA TABLA 
					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
					
					kdb.rst(cuboResultados);					
					cuboResultados  = getXml(frn.dataPag()); //Obtener el xml de la pantalla;
					setXml(cuboResultados,"k_nocatalogo",1); //se define con base a la lista de opciones de Kepler... 0,1,2,3,4,5
					//setXml(cuboResultados,"k_sucn",frn.get("k_sucn", -1, 1));
					
						// obtención de datos en plantilla general
					k_cicloReorden_A1 = frn.get("k_cicloreorden_a1");
					k_leadTime_A2 = frn.get("k_leadtime_a2");
					k_MaxFluleTime_A3= frn.get("k_maxfluletime_a3");
					k_TasaServicio_A4= frn.get("k_tasaservicio_a4");					
					k_StockSeg_A5 = frn.get("k_stockseg_a5");
					
					setXml(cuboResultados,"k_cicloreorden_a1",k_cicloReorden_A1 );
					setXml(cuboResultados,"k_leadtime_a2",k_leadTime_A2);
					setXml(cuboResultados,"k_maxfluletime_a3",k_MaxFluleTime_A3);
					setXml(cuboResultados,"k_tasaservicio_a4",k_TasaServicio_A4);
					setXml(cuboResultados,"k_stockseg_a5",k_StockSeg_A5);
										
					frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\sqlXmlResultado");					
					
					cmd = "SELECT * FROM keplersc.cat_pedidosugerido_validaciones_crud('<document>" & getXmlStr(cuboResultados,"EOF:13_10") & "</document>')";
					kdb.rst(cuboResultados);
					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"cat_InvPedSugParaGen.Execute");
				
					ok = getXmlAtt(cuboResultados,"ok");
					if(ok &! "" && !ok)
					{					
						mensajeError = getXmlAtt(cuboResultados,"native3");
						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
						frn.message(mensajeError,"Error","Aceptar");
						return;
					}					
					resultado= getXml(cuboResultados,"resultado");
					mensaje= getXml(cuboResultados,"mensaje");					
					if(resultado &= "1")
					{
						frn.message(mensaje, "Registro actualizado.","&Aceptar");
					}else{
						frn.message(mensaje, "Error","&Aceptar");
					}
				}	//end opcion 0
			}//end fun Execute
		}
	</script>
</pag>