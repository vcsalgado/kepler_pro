<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Actualiza Descuentos"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,20,20" bclr="192,205,213" unfont="0">	<tab/><txt fnt=",22" clr="0,0,0">Actualiza Descuentos</txt><tab/>	<br/>		<tab/><hLine clr="0,0,0"	dim="45,0,0,0"/>	<br/>	<br/><tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="44,25,10,17" brdr="0,5" tit="Tabla Descuentos Paquetes" fnt="Arial,16">		<tab n="27"/>		<img id="img_buscar" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="ObtenerPaquetes()"/>			<br/>		<sp/>				<tbl id="k_mov" clr="64,64,64" clrBrdr="64,64,64" bclr="236,240,243" brdr="1,0" dim="85,20" modify="Y" Reorder="Y" available="Y" insdel="Y">			<col name="Paquete" id="paquete"  type="capital"  nc="5" visible="Y" modify="N"/>			<col name="Descripcion" id="descripcion"  type="capital"  nc="50" visible="Y"  modify="N"/>			<col name="Descuento Agencia" id="descuento_agencia"  type="number"  nd="5" visible="Y"/>			<col name="Descuento Otra Agencia" id="descuento_otra_agencia"  type="number"  nd="5" visible="Y"/>		</tbl>		<br/><sp/>		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Guardar" hk="K" default="1" step="0"  OnEnter="Guardar()" fnt="Arial,16"/>	</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys;		var cmdQuery, cuboQuery, ok, mensajeError;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();				ConfiguraUI();			Inicializa();		}     				fun ObtenerPaquetes(){			var xmlPantalla;			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;						cmdQuery = "select paq.c1 as paquete ,paq.c2 as descripcion, coalesce(le.c2, 0) as descuento_agencia ,coalesce(le.c3,0) as descuento_otra_agencia ";			cmdQuery  = cmdQuery  & " from keplersc.kdcatpaq as paq left outer join keplersc.kdcatpaqlealtad as le on le.c1=paq.c1 ";					rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"actualiza_descuentos.ObtenerPaquetes");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_mov",cuboQuery);					}				fun Guardar(){			var xmlPantalla,no_partidas,resultado,mensaje,adicionales;			//Validaciones			no_partidas=frn.N("k_mov")-1;			if (no_partidas==0) {				frn.message("Error, no se tiene registros de configuracion","Error","Aceptar");				return;			}			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;						setXml(xmlPantalla ,"k_partidas","no_partidas",no_partidas);						frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\xmlPantallaisan");			cmdQuery="select * from keplersc.actualiza_descuentos('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						kdb.rst(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"actualiza_descuentos.Guardar");			resultado= getXml(cuboQuery,"resultado");			mensaje= getXml(cuboQuery,"mensaje");							if(resultado &= "0"){				frn.message(mensaje,"Error","Aceptar");				return;			}			frn.message("Modificacion registrada","Mensaje","Aceptar");		}				fun ConfiguraUI(){			if (frn.nParam() == 0){				frn.message("Accion no permitida.","Error","&Aceptar");				frn.open("redirect",2);				return;			}		}				fun Inicializa(){			frn.rst("gpo_2");				frn.rst("k_mov");			ObtenerPaquetes();		}				}				</script></pag>