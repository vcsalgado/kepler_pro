<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Catalogo kdtvr2">
<grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,30,20" bclr="192,205,213" unfont="0">
	<txt fnt=",22" clr="0,0,0">Catalogo kdtvr2</txt><tab/>
	<br/>
	<hLine clr="0,0,0"	dim="25,0,0,0"/>
	<br/>
	<br/>
	<grp id="grupo_crud" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 
		dim="25,9,15,50" brdr="0,5" tit="Nuevo" fnt="Arial,16">
		<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/>
		<br/>

		<tab/>
						
			<txt>Numero de parte: </txt>
			<tab n="5"/><sp/>
			<inp id="k_n_parte_crud" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="15" available="Y" modify="Y"/>
		<sp/>
		<br/>

	<tab/>
						
			<txt>Descripcion: </txt>
			<tab n="5"/><sp/>

			<inp id="k_desc_crud" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="20" available="Y" modify="Y"/>
		<sp/>

		<br/>
		<tab/>
						
			<txt>Clasificacion por Movimientos: </txt>
			<tab n="3"/><sp/>

			<inp id="k_clas_mov_crud" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="2" available="Y" modify="Y"/>
		<sp/>

		<br/>
		<tab/>
						
			<txt>Codigo de Accesorio: </txt>
			<tab n="4"/><sp/>

			<inp id="k_cod_accesorio_crud" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="1" available="Y" modify="Y"/>
		<sp/>
		<br/>
		<tab/>
						
			<txt>Costo Distribuidor: </txt>
			<tab n="5"/><sp/>

			<inp id="k_costo_dist_crud" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number" nc="15" available="Y" modify="Y" nd="2" max="999999999"/>
		<sp/>

		<br/>
		<tab/>
						
			<txt>Precio Mayoreo: </txt>
			<tab n="5"/><sp/>

			<inp id="k_precio_mayoreo_crud" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number" nc="15" available="Y" modify="Y" nd="2"/>
		<sp/>

		<br/>
		<tab/>
						
			<txt>Precio Publico: </txt>
			<tab n="5"/><sp/>

			<inp id="k_precio_publico_crud" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number" nc="15" available="Y" modify="Y" nd="2" min="0"/>
		<sp/>

		<br/>
		<tab/>
						
			<txt>Cantidad por Unidad: </txt>
			<tab n="4"/><sp/>

			<inp id="k_cantidad_unidad_crud" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number" nc="5" available="Y" modify="Y" nd="0"/>
		<sp/>

		<br/>
		<tab/>
						
			<txt>Cargo por pieza remanufacturada: </txt>
			<tab n="3"/><sp/>

			<inp id="k_cargo_pieza_remanu_crud" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number" nc="8" available="Y" modify="Y" nd="2"/>
		<sp/>

		<br/>
		<tab/>
						
			<txt>Parte a cambkok de precios por volumen: </txt>
			<tab n="2"/><sp/>

			<inp id="k_camb_precio_vol_crud" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="2" available="Y" modify="Y"/>
		<sp/>

		<br/>
		<tab/>
						
			<txt>No usado: </txt>
			<tab n="6"/><sp/>

			<inp id="k_no_usado_crud" dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="2" available="Y" modify="Y"/>
		<sp/>


		<br/>		<tab/>
		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Guardar" hk="K" default="0" step="0"  OnEnter="Execute()" fnt="Arial,16" visible="Y" available="Y"/>
		<tab/>
		<bot id="btn_aceptar" dim="10,10" brdr="5" text="Aceptar" hk="K" default="0" step="0"  OnEnter="salir()" fnt="Arial,16" available="N" visible="N"/>
	</grp>
</grp>
<script>
	InstallDriver("KDB75");
	class Main {
		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, asterisco  ;
		var cmdQuery, cuboQuery, ok, mensajeError, xml_cubo_cata, accion, externo, straccion, clave_sel, sucursal_id, resVal;
		var k_n_parte_crud, k_desc_crud, k_clave;
		fun Main(){
			frn=new FRNT;
			kdb=new KDB;
			frP=new FRNTP;
			sys=new SYS;
			kdb.connect();
			
			suc_usuario = frn.lib("libKepler","UserInfo(1)");
			perfil_usuario = frn.lib("libKepler","UserInfo(2)");
			rol_usuario = frn.config("user","role");
			asterisco = "*";
			accion = frn.param(0);
			k_clave = frn.param(1);
			
			ConfiguraUI();
			Inicializa();
			
			
		}

		fun vacia_campos(){
			frn.rst("k_n_parte_crud");
			frn.rst("k_desc_crud");
			frn.rst("k_clas_mov_crud");
			frn.rst("k_cod_accesorio_crud");
			frn.rst("k_costo_dist_crud");
			frn.rst("k_precio_mayoreo_crud");
			frn.rst("k_precio_publico_crud");
			frn.rst("k_cantidad_unidad_crud");
			frn.rst("k_cargo_pieza_remanu_crud");
			frn.rst("k_no_usado_crud");
			frn.rst("k_costo_dist_crud");

		}
            


		fun salir(){
			accion="NUEVO";
			vacia_campos();
			Inicializa();
			frn.exit();			
		}


//		fun llenar_cmb(){
//			frn.setX("[A]ctivo","k_estatus_crud","1","0");
//			frn.setX("A","k_estatus_crud","1","1");
//			frn.setX("[I]nactivo","k_estatus_crud","2","0");
//			frn.setX("I","k_estatus_crud","2","1");
//		}

		fun carga_datos(){


			cmdQuery = "select c1 as k_n_parte_crud, c3 as k_desc_crud
			, c4 as k_clas_mov_crud, c5 as k_cod_accesorio_crud
			, c6 as k_costo_dist_crud, c7 as k_precio_mayoreo_crud
			, c8 as k_precio_publico_crud, c9 as k_cantidad_unidad_crud
			, c10 as k_cargo_pieza_remanu_crud, c11 as k_camb_precio_vol_crud
			, c12 as k_no_usado_crud
			 from keplersc.kdtvr2
				 where c1 = '"& k_clave &"'";
			rstXml(cuboQuery);
			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"kdtvr2.IniCombos()");
			xml_cubo_cata=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");
			frn.lib("libGeneral.kpl","FileSave",cuboQuery,"C:\Basura\cubo");		
			frn.setX(xml_cubo_cata);

//			var estatus = getXmlAtt(cuboQuery,"r"&0,"k_estatus_crud");
//			frn.setX(estatus,"k_estatus_crud","0","0");
//			frn.setX(estatus,"k_estatus_crud","0","1");

		}


		fun ValidarDatos(){


			if (frn.get("k_n_parte_crud") &= "") {						
				frn.setPos("k_n_parte_crud");
				resVal=0;
				frn.message("Debe especificar clave, verificar","Error","Aceptar");
				return;
			}
			
/*			
			if (frn.get("k_desc_crud") &= "") {						
				frn.setPos("k_desc_crud");
				resVal=0;
				frn.message("Debe especificar descripcion, verificar","Error","Aceptar");
				return;
			}
			if (frn.get("k_clas_mov_crud") &= "") {						
				frn.setPos("k_clas_mov_crud");
				resVal=0;
				frn.message("Debe especificar clasificacion por Movimientos, verificar","Error","Aceptar");
				return;
			}

			if (frn.get("k_cod_accesorio_crud") &= "") {						
				frn.setPos("k_cod_accesorio_crud");
				resVal=0;
				frn.message("Debe especificar Codigo de Accesorio, verificar","Error","Aceptar");
				return;
			}

			if (frn.get("k_costo_dist_crud") &= "") {						
				frn.setPos("k_costo_dist_crud");
				resVal=0;
				frn.message("Debe especificar Costo Distribuidor, verificar","Error","Aceptar");
				return;
			}

			if (frn.get("k_precio_mayoreo_crud") &= "") {						
				frn.setPos("k_precio_mayoreo_crud");
				resVal=0;
				frn.message("Debe especificar Precio Mayoreo, verificar","Error","Aceptar");
				return;
			}

			if (frn.get("k_cantidad_unidad_crud") &= "") {						
				frn.setPos("k_cantidad_unidad_crud");
				resVal=0;
				frn.message("Debe especificar Cantidad por Unidad, verificar","Error","Aceptar");
				return;
			}

			if (frn.get("k_cargo_pieza_remanu_crud") &= "") {						
				frn.setPos("k_cargo_pieza_remanu_crud");
				resVal=0;
				frn.message("Debe especificar Cargo por pieza remanufacturada, verificar","Error","Aceptar");
				return;
			}

			if (frn.get("k_camb_precio_vol_crud") &= "") {						
				frn.setPos("k_camb_precio_vol_crud");
				resVal=0;
				frn.message("Debe especificar Parte a cambkok de precios por volumen, verificar","Error","Aceptar");
				return;
			}

			if (frn.get("k_no_usado_crud") &= "") {						
				frn.setPos("k_no_usado_crud");
				resVal=0;
				frn.message("Debe especificar No usado, verificar","Error","Aceptar");
				return;
			}
*/
			if (frn.get("k_precio_publico_crud") &= "") {								
				frn.setPos("k_precio_publico_crud");
				resVal=0;
				frn.message("Debe especificar Precio Publico, verificar","Error","Aceptar");
				return;
			}else{
				if (frn.get("k_precio_publico_crud") == 0.00) {								
					frn.setPos("k_precio_publico_crud");
					resVal=0;
					frn.message("El precio publico no puede ser 0.00, verificar","Error","Aceptar");
					return;
				}			
			}
		}

		fun Execute() {
			resVal = 1;
			ValidarDatos();
			if(resVal == 0){
				return;
			}
			
			var resultado_confirmacion = frn.message("Desea continuar?","Mensaje de Confirmacion", 2);
			if (resultado_confirmacion &! 1)  {
				return;
			}
			
			var xmlRequest = getXml(frn.dataPag());	
			frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");
					cmdQuery="SELECT * FROM keplersc.cat_crud_kdtvr2('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";
			var cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_crud_kdtvr2.Execute()");	
			frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");					
			var resultado=getXml(cubo ,"resultado");
			
			if(resultado &= "0"){
				mensajeError = getXml(cubo ,"mensaje");
				frn.message(mensajeError,"Error","Aceptar");
				return;
			}
			frP.script("Inicia_Forma()");
			if (accion &= "NUEVO" || accion &= "MODIFICAR") {	
				var sms =  "";
				if (accion &= "NUEVO"){
					sms = "Registro guardado";
				}else {
					sms = "Registro modificado";
				}
				accion="CONSULTAR";
				k_clave = frn.get("k_n_parte_crud");
				ctlrs_opcion();
				frn.message(sms ,"Mensaje","Aceptar");	


			}
			if (accion &= "ELIMINAR"){
				frn.message("Registro eliminado","Mensaje","Aceptar");
				frn.exit();			
			}
		}	
		
		fun ctlrs_opcion(){
			frn.set("input_crud", accion);
			frn.rst("grupo_crud");
			if (accion &= "NUEVO"){

				frn.setAtt("k_n_parte_crud", "available", "Y" );
				frn.setAtt("k_n_parte_crud", "modify", "Y" );

				frn.setAtt("k_desc_crud", "available", "Y" );
				frn.setAtt("k_desc_crud", "modify", "Y" );

				frn.setAtt("k_clas_mov_crud", "available", "Y" );
				frn.setAtt("k_clas_mov_crud", "modify", "Y" );

				frn.setAtt("k_cod_accesorio_crud", "available", "Y" );
				frn.setAtt("k_cod_accesorio_crud", "modify", "Y" );

				frn.setAtt("k_costo_dist_crud", "available", "Y" );
				frn.setAtt("k_costo_dist_crud", "modify", "Y" );

				frn.setAtt("k_precio_mayoreo_crud", "available", "Y" );
				frn.setAtt("k_precio_mayoreo_crud", "modify", "Y" );

				frn.setAtt("k_precio_publico_crud", "available", "Y" );
				frn.setAtt("k_precio_publico_crud", "modify", "Y" );

				frn.setAtt("k_cantidad_unidad_crud", "available", "Y" );
				frn.setAtt("k_cantidad_unidad_crud", "modify", "Y" );

				frn.setAtt("k_cargo_pieza_remanu_crud", "available", "Y" );
				frn.setAtt("k_cargo_pieza_remanu_crud", "modify", "Y" );

				frn.setAtt("k_camb_precio_vol_crud", "available", "Y" );
				frn.setAtt("k_camb_precio_vol_crud", "modify", "Y" );

				frn.setAtt("k_no_usado_crud", "available", "Y" );
				frn.setAtt("k_no_usado_crud", "modify", "Y" );


			    frn.set("k_titulo","Nuevo kdtvr2");
				frn.setAtt("grupo_crud", "tit", "Nuevo" );
				frn.setAtt("k_btn_cons", "visible", "Y" );
				frn.setAtt("btn_aceptar", "available", "N" );
				frn.setAtt("btn_aceptar", "visible", "N" );
			
			}else { 

					if (accion &= "MODIFICAR") {
					carga_datos();

					frn.setAtt("k_n_parte_crud", "available", "N" );
					frn.setAtt("k_n_parte_crud", "modify", "N" );
					
					frn.setAtt("k_precio_publico_crud", "available", "Y" );
					frn.setAtt("k_precio_publico_crud", "modify", "Y" );					

/*
					frn.setAtt("k_desc_crud", "available", "Y" );
					frn.setAtt("k_desc_crud", "modify", "Y" );
	
					frn.setAtt("k_clas_mov_crud", "available", "Y" );
					frn.setAtt("k_clas_mov_crud", "modify", "Y" );
	
					frn.setAtt("k_cod_accesorio_crud", "available", "Y" );
					frn.setAtt("k_cod_accesorio_crud", "modify", "Y" );
	
					frn.setAtt("k_costo_dist_crud", "available", "Y" );
					frn.setAtt("k_costo_dist_crud", "modify", "Y" );
	
					frn.setAtt("k_precio_mayoreo_crud", "available", "Y" );
					frn.setAtt("k_precio_mayoreo_crud", "modify", "Y" );
	
					frn.setAtt("k_precio_publico_crud", "available", "Y" );
					frn.setAtt("k_precio_publico_crud", "modify", "Y" );
	
					frn.setAtt("k_cantidad_unidad_crud", "available", "Y" );
					frn.setAtt("k_cantidad_unidad_crud", "modify", "Y" );
	
					frn.setAtt("k_cargo_pieza_remanu_crud", "available", "Y" );
					frn.setAtt("k_cargo_pieza_remanu_crud", "modify", "Y" );
	
					frn.setAtt("k_camb_precio_vol_crud", "available", "Y" );
					frn.setAtt("k_camb_precio_vol_crud", "modify", "Y" );
	
					frn.setAtt("k_no_usado_crud", "available", "Y" );
					frn.setAtt("k_no_usado_crud", "modify", "Y" );
*/

					frn.set("k_titulo","Modifica kdtvr2");

					frn.setAtt("grupo_crud", "tit", "Modifica" );
                    frn.setAtt("grupo_crud", "available","Y");
					frn.setAtt("k_btn_cons", "visible", "Y" );
					frn.setAtt("btn_aceptar", "available", "N" );
					frn.setAtt("btn_aceptar", "visible", "N" );
					
                   }else{

						carga_datos();

						frn.setAtt("k_n_parte_crud", "available", "N" );
						frn.setAtt("k_n_parte_crud", "modify", "N" );

						frn.setAtt("k_desc_crud", "available", "N" );
						frn.setAtt("k_desc_crud", "modify", "N" );

						frn.setAtt("k_clas_mov_crud", "available", "N" );
						frn.setAtt("k_clas_mov_crud", "modify", "N" );

						frn.setAtt("k_cod_accesorio_crud", "available", "N" );
						frn.setAtt("k_cod_accesorio_crud", "modify", "N" );

						frn.setAtt("k_costo_dist_crud", "available", "N" );
						frn.setAtt("k_costo_dist_crud", "modify", "N" );

						frn.setAtt("k_precio_mayoreo_crud", "available", "N" );
						frn.setAtt("k_precio_mayoreo_crud", "modify", "N" );

						frn.setAtt("k_precio_publico_crud", "available", "N" );
						frn.setAtt("k_precio_publico_crud", "modify", "N" );

						frn.setAtt("k_cantidad_unidad_crud", "available", "N" );
						frn.setAtt("k_cantidad_unidad_crud", "modify", "N" );

						frn.setAtt("k_cargo_pieza_remanu_crud", "available", "N" );
						frn.setAtt("k_cargo_pieza_remanu_crud", "modify", "N" );

						frn.setAtt("k_camb_precio_vol_crud", "available", "N" );
						frn.setAtt("k_camb_precio_vol_crud", "modify", "N" );

						frn.setAtt("k_no_usado_crud", "available", "N" );
						frn.setAtt("k_no_usado_crud", "modify", "N" );


						frn.set("k_titulo","Consulta kdtvr2");

						frn.setAtt("grupo_crud", "tit", "Colsulta" );
						frn.setAtt("btn_aceptar", "available", "Y" );
						frn.setAtt("btn_aceptar", "visible", "Y" );
						frn.setAtt("k_btn_cons", "available", "N" );
						frn.setAtt("k_btn_cons", "visible", "N" );


				   }
				
			}
			if (accion &! "CONSULTAR"){

				frn.setAtt("btn_aceptar", "available", "N" );
				frn.setAtt("btn_aceptar", "visible", "N" );
				frn.setAtt("k_btn_cons", "available", "Y" );
				frn.setAtt("k_btn_cons", "visible", "Y" );
			}
		}		

		
		fun ConfiguraUI(){
			if (frn.nParam() == 0){
				frn.message("Accion no permitida.","Error","&Aceptar");
//				frn.open("redirect",2);
				return;
			}
		}		

		fun Inicializa(){
	
			ctlrs_opcion();
			
		}						
           
				
	}
	
		
	</script>
</pag>
