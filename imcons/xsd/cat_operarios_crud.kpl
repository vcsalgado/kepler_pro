<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit=""><grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<br/>	<tab/>	<inp id="k_titulo" dim="65,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"				type="string" modify="N" available="N" fnt="Arial,22"/>	<br/>	<br/>	<hLine clr="0,0,0"/>	<br/> <br/>	<tab/>		<grp id="grupo_crud" dim="97,45,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="Nuevo" available="Y">				<grp id="grupo_enc1" dim="62,7,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="" available="Y"> 			<br/>					<sp n="1"/> <txt>Clave : </txt> <sp n="2"/>			<inp id="k_clave" dim="8,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="6" available="Y" OnChange="" tooltip="Clave Operario" modify="Y"/>			<br/>			<sp n="1"/> <txt>Nombre :  </txt>			<inp id="k_nombre" dim="50,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="40" clrBrdr="255,255,255" tooltip="Nombre" available="Y"/>					<br/>					</grp>				<grp id="grupo_enc2" dim="33,7,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="" available="Y"> 						<br/>			<sp n="1"/> <txt>Activo : </txt> 			<cmb id="cmb_activo" dim="7,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Sel_Activo()" available="Y"/>			<sp n="1"/> <inp id="k_activo" dim="2,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="1" available="N" OnChange="" tooltip="Activo" modify="Y"/> 			<br/>			<sp n="1"/> <txt>Usuario KPL : </txt> 			<inp id="k_usuario" dim="21,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="18" clrBrdr="255,255,255" tooltip="Usuario" available="Y"/>						<br/>					</grp>				<br/> 				<grp id="grupo_datospers" dim="62,29,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="Datos Personales" available="Y"> 					<br/>			<sp n="1"/> <txt>Direccion : </txt>			<inp id="k_dir" dim="50,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="40" clrBrdr="255,255,255" tooltip="Direccion" available="Y"/>			<br/>			<sp n="1"/> <txt>Colonia : </txt> <sp n="2"/>			<inp id="k_col" dim="50,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="40" clrBrdr="255,255,255" tooltip="Colonia" available="Y"/>			<br/>			<sp n="1"/> <txt>Poblacion : </txt>			<inp id="k_pobl" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="20" clrBrdr="255,255,255" tooltip="Poblacion" available="Y"/>			<br/>			<br/>			<sp n="1"/> <txt>TEL Casa : </txt> <sp n="2"/>			<inp id="k_telcasa" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="10" clrBrdr="255,255,255" tooltip="TEL Casa" fmt="5" nd="0" available="Y"/> 			<sp n="3"/> <txt>CEL Personal : </txt>			<inp id="k_celpers" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="10" clrBrdr="255,255,255" tooltip="CEL Personal" fmt="5" nd="0" available="Y"/>			<br/>						<br/>			<sp n="1"/> <txt fnt=",b">Comentarios : </txt>			<br/>			<sp n="1"/> <inp id="k_comms1" dim="50,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="40" clrBrdr="255,255,255" tooltip="Comentarios Ren1" available="Y"/>			<br/>			<sp n="1"/> <inp id="k_comms2" dim="50,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="40" clrBrdr="255,255,255" tooltip="Comentarios Ren1" available="Y"/>			<br/>			<sp n="1"/> <inp id="k_comms3" dim="50,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="40" clrBrdr="255,255,255" tooltip="Comentarios Ren1" available="Y"/>		</grp>				<grp id="grupo_params" dim="62,29,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="Parametros" available="Y"> 					<sp n="1"/> <txt fnt=",b">Asignacion de Trabajo : </txt>			<br/>			<sp n="1"/> <txt>Tipo : </txt> <sp n="4"/>			<inp id="k_tipo" dim="7,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="5" available="Y" OnF9="Get_Cat(1)" OnChange="Get_Cat_Data(1)" tooltip="Tipo" modify="Y"/>			<br/>			<sp n="1"/> <inp id="c_tipo" dim="33,1" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="30" modify="N" available="N"/>			<br/>			<sp n="1"/> <txt>Lavador : </txt> <sp n="2"/>			<inp id="k_lava" dim="7,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="5" available="Y" OnF9="Get_Cat(2)" OnChange="Get_Cat_Data(2)" tooltip="Lavador" modify="Y"/>			<br/>			<sp n="1"/> <inp id="c_lava" dim="33,1" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="30" modify="N" available="N"/>			<br/>			<sp n="1"/> <txt>Ayudante : </txt> 			<inp id="k_ayud" dim="7,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="5" available="Y" OnF9="Get_Cat(3)" OnChange="Get_Cat_Data(3)" tooltip="Ayudante" modify="Y"/>			<br/>			<sp n="1"/> <inp id="c_ayud" dim="33,1" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="30" modify="N" available="N"/>			<br/>			<sp n="1"/> <txt>Jefe Taller : </txt> 			<inp id="k_jefe" dim="7,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="5" available="Y" OnF9="Get_Cat(4)" OnChange="Get_Cat_Data(4)" tooltip="Jefe Taller" modify="Y"/>			<br/>			<sp n="1"/> <inp id="c_jefe" dim="33,1" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="30" modify="N" available="N"/>			<br/>			<br/>			<sp n="1"/> <txt fnt=",b">Pagos : </txt>			<br/>			<sp n="1"/> <txt>Clasificacion : </txt> 			<inp id="k_clasif" dim="7,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="5" available="Y" OnF9="Get_Cat(5)" OnChange="Get_Cat_Data(5)" tooltip="Clasificacion Pago" modify="Y"/>			<br/>			<sp n="1"/> <inp id="c_clasif" dim="33,1" clr="64,64,64" clrBrdr="255,255,255" type="string" nc="30" modify="N" available="N"/>			<br/>						<sp n="1"/> <txt>Incluir Nomina : </txt> 			<cmb id="cmb_nomina" dim="7,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="Sel_Nomina()" available="Y"/>			<sp n="1"/> <inp id="k_nomina" dim="2,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="1" available="Y" OnChange="" tooltip="Incluir en Nomina" modify="Y" fmt="5" nd="0"/>					</grp>		<br/><br/>      <sp n="40"/> <bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/>      <br/> 		<sp n="40"/> <inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/>					</grp>	</grp>	<script>	InstallDriver("KDB75");	class Main {				var frn,kdb,frP, accion,externo, clave_sel,sucursal_id,cve_color,resVal,straccion;      var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError;      var fileSavePath;      		fun Main() {			frn = new FRNT;			frP = new FRNTP;			kdb = new KDB;			kdb.connect();						// Added by JMM 20230131			//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";			fileSavePath = "C:\Basura";							Inicializa();			ctlrs_off();			insertar_datos();			ctlrs_opcion();		}					fun Inicializa(){					accion = frn.param(0);			frn.set("input_crud", accion);			frn.rst("grupo_crud");			externo = frn.param(2);         if (accion &= "NUEVO") {				straccion = "Nuevo" ;            } else if (accion &= "CONSULTAR") {				straccion = "Consultar";			} else if (accion &= "MODIFICAR") {				straccion = "Modificar";         } else if (accion &= "ELIMINAR") {				straccion = "Eliminar";         }     							frn.setAtt("grupo_crud", "tit", straccion );			clave_sel = frn.param(1);			sucursal_id = frn.param(3);			if (accion &! "NUEVO") {				frn.set("k_clave", clave_sel);			}						// Fill Combo Activo (Manual)			frn.setX("Si ","cmb_activo",0,0);			frn.setX("S","cmb_activo",0,1);			frn.setX("No ","cmb_activo",1,0);			frn.setX("N","cmb_activo",1,1);				frn.setX(" ","cmb_activo",2,0);			frn.setX("","cmb_activo",2,1);				// End Our Code						if (accion &= "NUEVO") {				frn.set("cmb_activo","Si ");			} else {				frn.set("cmb_activo"," ");			}			frn.set("k_activo", frn.get("cmb_activo",-1,1));			// Fill Combo Nomina (Manual)			frn.setX("Si ","cmb_nomina",0,0);			frn.setX("S","cmb_nomina",0,1);			frn.setX("No ","cmb_nomina",1,0);			frn.setX("N","cmb_nomina",1,1);				frn.setX(" ","cmb_nomina",2,0);			frn.setX("","cmb_nomina",2,1);				// End Our Code						if (accion &= "NUEVO") {				frn.set("cmb_nomina"," ");			} else {				frn.set("cmb_nomina"," ");			}			frn.set("k_nomina", frn.get("cmb_nomina",-1,1));		}						fun Sel_Activo() { frn.set("k_activo", frn.get("cmb_activo",-1,1)); }				fun Sel_Nomina() { frn.set("k_nomina", frn.get("cmb_nomina",-1,1)); }				fun Get_Cat(imodo) {            			var suc_id, dato_id;			var win_tit, field_key, field_col, cmdQuery;            			if ( imodo <= 0 || imodo > 5 /*|| tip_ope &! "A"*/ ) {				// No es opcion de CAT Valida ...				return;			}							win_tit = "";			field_key = "";			field_col = "";			cmdQuery = "";			if (imodo == 1) {				win_tit = "CAT Tipos Operarios";				field_key = "tipo";				field_col = "k_tipo";				cmdQuery = "select c1 tipo, c2 descrip from keplersc.kdtoper " &					"order by c1";			}								if (imodo == 2) {				win_tit = "CAT Operarios";				field_key = "clave";				field_col = "k_lava";				cmdQuery = "select c1 clave, c3 as nombre from keplersc.kdoper " &				"order by c2";			}							if (imodo == 3) {				win_tit = "CAT Operarios";				field_key = "clave";				field_col = "k_ayud";				cmdQuery = "select c1 clave, c3 as nombre from keplersc.kdoper " & 				"order by c2";			}				if (imodo == 4) {				win_tit = "Catalogo Jefes de Taller";				field_key = "clave";				field_col = "k_jefe";				cmdQuery = "select c1 clave, c2 nombre from keplersc.kdcatjefetaller " & 				"order by c2";			}								if (imodo == 5) {				win_tit = "Catalogo Clasificaciones Pagos";				field_key = "clave";				field_col = "k_clasif";				cmdQuery = "select c1 clave, c2 descripcion from keplersc.kdclaspag " & 				"order by c1";			}												                   if ( strlen(win_tit) > 0 && strlen(field_key) > 0 && strlen(field_col) > 0 && strlen(cmdQuery) > 0 /*&& strlen(objeto) > 0*/ ) {                                        				//frn.dialog("genlistasel", win_tit,cmdQuery, field_key, "k_mov",-1, field_col,"S");  * * *  USADO EN GRIDS				//frn.dialog("genlistasel","Catálogo de Proveedores",cmdQuery,"k_claveprov","k_clave","0","","N");  * * *  USADO EN CTRLS SIMPLES									frn.lib("libGeneral.kpl","FileSave",cmdQuery, fileSavePath & "\comvshusdcrud_genlist");									frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");			}						} /*END Func Get_Cat()*/		fun Get_Cat_Data(imodo, ireturn, iforced) {			var suc_id, dato_id;			var field_ori,field_dest, tbl, field_dscr;			var field_add, dato_id_add;			var field_dest_2, dato_id_2;			var cuboQuery;						if ( imodo < 0 || imodo > 5 ) {				// No es opcion de CAT Valida ...				return;			}							field_dscr = "";			field_ori = "";			field_dest = "";			tbl = "";			cmdQuery = "";						dato_id = "";						//if ( accion/*tip_ope*/ &= "NUEVO"/*"A"*/ ) {				if (imodo == 1) {					field_dscr = "Tipo Operario";					field_ori = "k_tipo";					field_dest = "c_tipo"; 					tbl = "kdtoper";					cmdQuery = "select c2 " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get(field_ori) & "'";				}			//}											//if ( accion/*tip_ope*/ &= "NUEVO"/*"A"*/ ) {				if (imodo == 2) {					field_dscr = "Lavador";					field_ori = "k_lava";					field_dest = "c_lava";					tbl = "kdoper";					cmdQuery = "select c3 " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get(field_ori) & "'";				}			//}				//if ( accion/*tip_ope*/ &= "NUEVO"/*"A"*/ ) {				if (imodo == 3) {					field_dscr = "Ayudante";					field_ori = "k_ayud";					field_dest = "c_ayud";					tbl = "kdoper";					cmdQuery = "select c3 " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get(field_ori) & "'";				}			//}				//if ( accion/*tip_ope*/ &= "NUEVO"/*"A"*/ ) {				if (imodo == 4) {					field_dscr = "Jefe Taller";					field_ori = "k_jefe";					field_dest = "c_jefe";					tbl = "kdcatjefetaller";					cmdQuery = "select c2 " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get(field_ori) & "'";				}			//}				//if ( accion/*tip_ope*/ &= "NUEVO"/*"A"*/ ) {				if (imodo == 5) {					field_dscr = "Clasificacion";					field_ori = "k_clasif";					field_dest = "c_clasif";					tbl = "kdclaspag";					cmdQuery = "select c2 " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get(field_ori) & "'";				}			//}											field_add = "";										if ( strlen(field_dscr) > 0 && strlen(field_ori) > 0 && strlen(field_dest) > 0 && strlen(tbl) > 0 && strlen(cmdQuery) > 0 ) {								rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_operarios.Get_Cat_" & tbl & "()");					frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cat_operarios_Get_Cat_" & tbl);					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						//dato_id = "--";						dato_id = "[ERR] verificando " &  field_dscr & " ...";						//frn.setX(dato_id,"k_mov",-1, field_dest);						frn.setX(dato_id, field_dest);						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					dato_id = "";					dato_id = getXmlAtt(cuboQuery,"r0", field_dest);					if( strlen(dato_id) == 0 ){											// Code Adapted for this option						frn.setX(trim(frn.get(field_ori)), field_ori);												if ( strlen(frn.get(field_ori)) > 0 ) {							//dato_id = "--";							dato_id = field_dscr & " No existe ...";						} else {							dato_id = "";						}														frn.setX(dato_id, field_dest);						if ( iforced == 1 ) { 							if ( ireturn == 1) { frn.message(field_dscr & " No existe , " & "o No puede estar Vacio ...","Error","Aceptar"); } 							return 0; 						} else {							if ( strlen(frn.get(field_ori)) > 0 ) {								if ( ireturn == 1) { frn.message(dato_id,"Error","Aceptar"); } 								return 0;							} else {								return 1;							}						}																} else {											frn.setX(dato_id, field_dest);												return 1;										}			}					} /*END Fun Get_Cat_Data()*/					fun ctlrs_off(){			frn.setAtt("btn_aceptar", "available", "N" );			frn.setAtt("btn_aceptar", "visible", "N" );						frn.setAtt("k_clave", "available","N");			frn.setAtt("k_nombre", "available","N");						frn.setAtt("cmb_activo", "available","N");			frn.setAtt("k_usuario", "available","N");			frn.setAtt("k_dir", "available","N");         frn.setAtt("k_col", "available","N");         frn.setAtt("k_pobl", "available","N");         frn.setAtt("k_telcasa", "available","N");         frn.setAtt("k_celpers", "available","N");         frn.setAtt("k_comms1", "available","N");         frn.setAtt("k_comms2", "available","N");         frn.setAtt("k_comms3", "available","N");                  frn.setAtt("k_tipo", "available","N");         frn.setAtt("k_lava", "available","N");         frn.setAtt("k_ayud", "available","N");         frn.setAtt("k_jefe", "available","N");         frn.setAtt("k_clasif", "available","N");         frn.setAtt("cmb_nomina", "available","N");			frn.setAtt("k_nomina", "available","N");		}						fun ctlrs_opcion(){					if (accion &= "NUEVO") {				frn.set("k_titulo","Catálogo de Operarios");								frn.setAtt("k_clave","available","Y");				frn.setAtt("k_clave", "modify", "Y" );				frn.setAtt("k_nombre", "available", "Y" );								frn.setAtt("cmb_activo", "available","Y");				frn.setAtt("k_usuario", "available","Y");				frn.setAtt("k_dir", "available","Y");				frn.setAtt("k_col", "available","Y");				frn.setAtt("k_pobl", "available","Y");				frn.setAtt("k_telcasa", "available","Y");				frn.setAtt("k_celpers", "available","Y");				frn.setAtt("k_comms1", "available","Y");				frn.setAtt("k_comms2", "available","Y");				frn.setAtt("k_comms3", "available","Y");								frn.setAtt("k_tipo", "available","Y");				frn.setAtt("k_lava", "available","Y");				frn.setAtt("k_ayud", "available","Y");				frn.setAtt("k_jefe", "available","Y");				frn.setAtt("k_clasif", "available","Y");				frn.setAtt("cmb_nomina", "available","Y");				frn.setAtt("k_nomina", "available","Y");										} else { 				frn.set("k_titulo","Catálogo de Operarios"); // Added by JMM ... 20230131				frn.setAtt("k_clave", "available", "Y" );            frn.setAtt("k_clave", "modify", "N" );				if (accion &= "MODIFICAR") {					frn.setAtt("grupo_crud", "available","Y");					frn.setAtt("k_nombre", "available", "Y" );									frn.setAtt("cmb_activo", "available","Y");					frn.setAtt("k_usuario", "available","Y");					frn.setAtt("k_dir", "available","Y");					frn.setAtt("k_col", "available","Y");					frn.setAtt("k_pobl", "available","Y");					frn.setAtt("k_telcasa", "available","Y");					frn.setAtt("k_celpers", "available","Y");					frn.setAtt("k_comms1", "available","Y");					frn.setAtt("k_comms2", "available","Y");					frn.setAtt("k_comms3", "available","Y");						frn.setAtt("k_tipo", "available","Y");					frn.setAtt("k_lava", "available","Y");					frn.setAtt("k_ayud", "available","Y");					frn.setAtt("k_jefe", "available","Y");					frn.setAtt("k_clasif", "available","Y");					frn.setAtt("cmb_nomina", "available","Y");					frn.setAtt("k_nomina", "available","Y");									} else {					frn.setAtt("k_clave", "available","Y");               frn.setAtt("k_clave", "modify", "N" );					//frn.setAtt("btn_aceptar", "visible", "N" );            }			}						if (accion &! "CONSULTAR"){				frn.setAtt("btn_aceptar", "available", "Y" );				frn.setAtt("btn_aceptar", "visible", "Y" );			}					}						fun insertar_datos(){			var v_activo, v_activo_cmb;			var v_nomina, v_nomina_cmb;						if (accion &= "MODIFICAR"){			//llamada externa(padre)				if (externo &= "s"){					if (clave_sel &= ""){						frn.message("selecciona una clave con F9 para modificar","Error","Aceptar");						frn.setAtt("btn_aceptar", "visible", "N" );						return;					}				}			}							if (accion &! "NUEVO") {							cmdQuery="select * /*c2*/ from keplersc.kdoper where c1='" & clave_sel & "'"; 				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_operarios_crud.insertar_datos()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cat_operarios");									ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");						return;				}									frn.set("k_nombre",getXmlAtt(cuboResultados,"r"&0,"c3"));								frn.set("k_activo",getXmlAtt(cuboResultados,"r"&0,"c12"));				frn.set("k_usuario",getXmlAtt(cuboResultados,"r"&0,"c20"));				frn.set("k_dir",getXmlAtt(cuboResultados,"r"&0,"c4"));				frn.set("k_col",getXmlAtt(cuboResultados,"r"&0,"c5"));				frn.set("k_pobl",getXmlAtt(cuboResultados,"r"&0,"c6"));				frn.set("k_telcasa",getXmlAtt(cuboResultados,"r"&0,"c7"));				frn.set("k_celpers",getXmlAtt(cuboResultados,"r"&0,"c8"));				frn.set("k_comms1",getXmlAtt(cuboResultados,"r"&0,"c9"));				frn.set("k_comms2",getXmlAtt(cuboResultados,"r"&0,"c10"));				frn.set("k_comms3",getXmlAtt(cuboResultados,"r"&0,"c11")); 								frn.set("k_tipo",getXmlAtt(cuboResultados,"r"&0,"c2")); 				frn.set("k_lava",getXmlAtt(cuboResultados,"r"&0,"c19")); 				frn.set("k_ayud",getXmlAtt(cuboResultados,"r"&0,"c22")); 				frn.set("k_jefe",getXmlAtt(cuboResultados,"r"&0,"c21")); 				frn.set("k_clasif",getXmlAtt(cuboResultados,"r"&0,"c17")); 				frn.set("k_nomina",getXmlAtt(cuboResultados,"r"&0,"c18")); 								v_activo = frn.get("k_activo");				v_activo = strFormat("ucase", v_activo);								if ( v_activo &= "S" ) { 					v_activo_cmb = "Si "; 				} else if ( v_activo &= "N" ) { 					v_activo_cmb = "No "; 				} else { v_activo_cmb = " "; } 								frn.set("cmb_activo", v_activo_cmb);								v_nomina = frn.get("k_nomina");				v_nomina = strFormat("ucase", v_nomina);								if ( v_nomina &= "S" ) { 					v_nomina_cmb = "Si "; 				} else if ( v_nomina &= "N" ) { 					v_nomina_cmb = "No "; 				} else { v_nomina_cmb = " "; } 								frn.set("cmb_nomina", v_nomina_cmb);											         } else {         				frn.setAtt("grupo_crud", "available","Y");            frn.setPos("k_clave");                			}						}				   	   fun Valida_Usuario(imodo) {	   			var dato_id, err_msg;			var cuboQuery;						err_msg = "";			dato_id = "";							cmdQuery = "select count(c3) count_usrs from keplersc.kdoper where c20 = '" & frn.get("k_usuario") & "' and c1 <> '" & frn.get("k_clave") & "'"; 			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_operarios.valida_usuario()");			//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cat_operarios.valida_usuario");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");					return 0;			}			dato_id = getXmlAtt(cuboQuery,"r0", "count_usrs");							if ( dato_id > 0 ) {				frn.message("El Usuario Registrado esta asignado a otro(s) "  & dato_id & " Usuario(s)" ,"Error","Aceptar");				return 0;			} else {				return 1;			}						}	// END -	Fun - Valida_Usuario 	   	   		fun ValidarDatos() {					var verify_cats, flag_data, verify_usr;					frn.setX(trim(frn.get("k_clave")), "k_clave");			frn.setX(trim(frn.get("k_nombre")), "k_nombre");			frn.setX(trim(frn.get("k_activo")), "k_activo");			frn.setX(trim(frn.get("k_usuario")), "k_usuario");						frn.setX(trim(frn.get("k_tipo")), "k_tipo");			frn.setX(trim(frn.get("k_lava")), "k_lava");			frn.setX(trim(frn.get("k_ayud")), "k_ayud");			frn.setX(trim(frn.get("k_jefe")), "k_jefe");			frn.setX(trim(frn.get("k_clasif")), "k_clasif");						verify_cats = 1;			verify_usr = 1;			flag_data = 1;						if (frn.get("k_clave") &= "") {										frn.setPos("k_clave");				flag_data/*resVal*/ = 0;				frn.message("Debe especificar la clave del operario, verificar","Error","Aceptar");			}						if (frn.get("k_nombre") &= "") {										frn.setPos("k_nombre");				flag_data/*resVal*/ = 0;				frn.message("Debe especificar el nombre del operario, verificar","Error","Aceptar");			}			if (frn.get("k_activo") &= "") {										frn.setPos("cmb_activo");				flag_data/*resVal*/ = 0;				frn.message("Debe especificar el Estatus de Activo [Si / No], verificar","Error","Aceptar");			}								if (frn.get("k_usuario") &= "") {										frn.setPos("k_usuario");				flag_data/*resVal*/ = 0;				frn.message("Debe especificar el Usuario KPL, verificar","Error","Aceptar");			}						if (frn.get("k_nomina") &= "") {										frn.setPos("cmb_nomina");				flag_data/*resVal*/ = 0;				frn.message("Debe especificar si se Incluye en Nomina [Si / No], verificar","Error","Aceptar");			}						if ( strlen(frn.get("k_usuario")) > 0 ) { verify_usr = Valida_Usuario(); } 			if (verify_usr == 0) { flag_data = 0; }						verify_cats = Get_Cat_Data(1,1,1);			if (verify_cats == 0) { flag_data = 0; }			verify_cats = Get_Cat_Data(2,1,0);			if (verify_cats == 0) { flag_data = 0; }			verify_cats = Get_Cat_Data(3,1,0);			if (verify_cats == 0) { flag_data = 0; }			verify_cats = Get_Cat_Data(4,1,0);			if (verify_cats == 0) { flag_data = 0; }			verify_cats = Get_Cat_Data(5,1,1);			if (verify_cats == 0) { flag_data = 0; }						resVal = flag_data;  										}		fun Execute() {					resVal = 1;			ValidarDatos();			if(resVal == 0) {				return;			}							var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);			if (resultado_confirmacion &! 1) {				return;			}							xmlRequest = getXml(frn.dataPag());				frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest_Cat_Operarios");					//frn.message("El Registro sera procesado en Postgresql ... ","Info","Aceptar");			//return;					cmdQuery = "SELECT * FROM keplersc.cat_operarios_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";			cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_operarios_crud.Execute()");							frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados_Cat_Operarios");											var resultado = getXml(cubo ,"resultado");							if(resultado &= "0"){				mensajeError = getXml(cubo ,"mensaje");				frn.message(mensajeError,"Error","Aceptar");				return;			}						frP.script("Inicia_Forma()");						if (accion &= "NUEVO" || accion &= "MODIFICAR") {								var sms = "";								if (accion &= "NUEVO"){					sms = "Registro guardado";				} else {					sms = "Registro modificado";				}								accion = "CONSULTAR";				ctlrs_opcion();				frn.message(sms ,"Mensaje","Aceptar");					frn.exit();								}						if (accion &= "ELIMINAR"){				frn.message("Registro eliminado","Mensaje","Aceptar");				frn.exit();						}						}						} // End Class Main		</script></pag>