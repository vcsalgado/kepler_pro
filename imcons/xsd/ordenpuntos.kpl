<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Puntos"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="90,50,10,10" brdr="0,5" tit="Puntos" fnt="Arial,16">		<tab n="1"/><inp id="k_F0" clr="64,64,64"  dim="6,1" available="N" type="string" fnt="Arial,16">Orden:</inp>				<inp id="input_orden" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><sp n="2"/>					<tab/><txt clr="0,58,112" hk="S">Tipo</txt>		<cmb id="tipo" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><tab n="1"/>		<txt clr="0,58,112" hk="S">Sucursal</txt>		<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><tab n="1"/>				<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>	<br/>			<tab/><tbl id="tabla" bclr="236,240,243" dim="84,26" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"   modify="N" nren="fijo">		<col id="punto" name="Punto"  modify="Y"/>		<col id="operario" name="Operario"  modify="Y"/>		<col id="descripcion" name="Descripcion"  modify="Y"/>		<col id="kit" name="Kit"  modify="Y"/>		<col id="autorizacion" name="Autorizacion"  modify="Y"/>		<col id="status" name="Status"  modify="Y"/>		<col id="orden" name="Orden"  modify="Y"/>		</tbl> 		<tab n="7"/>		<br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario ,asterisco, externo ;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();						externo = frn.param(0);								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				asterisco = "*";								Inicializa();								if (externo &= "s"){					Buscar();				}									}						fun Inicializa(){							var cmd,cubo,ok,mensajeError ;																		//Llenar combo tipo orden				cmd = "select '['||c1||'] '||c3 as descripcion, c1 as clave  from keplersc.kdmargen";								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"puntos.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){				   mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}						   var cmd_tipo_orden = "tipo";									frn.setX("", cmd_tipo_orden ,0,0);				frn.setX("", cmd_tipo_orden , 0, 1);									llenar_cmb(cubo ,cmd_tipo_orden );								frn.set(cmd_tipo_orden, frP.get("k_tipo_orden"));																			//Llenar combo sucursales								var combo_suc = "k_sucN";								cmd = "select '['||c1||'] '||c2 as descripcion, c1 as clave from keplersc.kdms";								if (perfil_usuario &! "ADMINISTRADOR"  && perfil_usuario &! "ADMINISTRATOR" && perfil_usuario &! "Administrador Kepler 8.0" && perfil_usuario &! ""){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {									if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}else{						frn.setX("", combo_suc ,0,0);						frn.setX("", combo_suc , 0, 1);					}				}											cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"puntos.Inicializa()");								ok=getXmlAtt(cubo ,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo ,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}										llenar_cmb(cubo ,combo_suc );								if (externo &= "s"){									frn.set("input_orden", frP.get("k_orden"));					frn.set(combo_suc , frP.get("k_sucN"));								}			}						fun Buscar() {							var xmlRequest,cmd,ok,cuboResultados, totpun , contpun, ref_clave, ref_desc;						var criterio = frn.get("input_orden");				var suc_bus = frn.get("k_sucN", -1, 1);				var tipo_bus = frn.get("tipo", -1, 1);							cmd= "select c4,c9,c8,c5,c6,c7,c3 from keplersc.kdpun where c3 like upper('%" & criterio & "%')";							if (suc_bus &! ""){					cmd = cmd & " and c1='" & suc_bus & "'";				}									if (tipo_bus &! ""){					cmd = cmd & " and c2='" & tipo_bus & "'";				}							cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"puntos.Buscar()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								totpun = nXml(cuboResultados);							frn.rst("tabla");				for (contpun=0; contpun<totpun ; contpun++){							frn.setX( getXmlAtt(cuboResultados,"r"&contpun,"c4"),"tabla",contpun,"punto");					frn.setX( getXmlAtt(cuboResultados,"r"&contpun,"c9"),"tabla",contpun,"operario");					frn.setX( getXmlAtt(cuboResultados,"r"&contpun,"c8"),"tabla",contpun,"descripcion");					frn.setX( getXmlAtt(cuboResultados,"r"&contpun,"c5"),"tabla",contpun,"kit");					frn.setX( getXmlAtt(cuboResultados,"r"&contpun,"c6"),"tabla",contpun,"autorizacion");					frn.setX( getXmlAtt(cuboResultados,"r"&contpun,"c7"),"tabla",contpun,"status");					frn.setX( getXmlAtt(cuboResultados,"r"&contpun,"c3"),"tabla",contpun,"orden");				}							}											fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}													}	</script></pag>