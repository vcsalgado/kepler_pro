<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Esquema por Punto"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0">	<br/>		<tab/><inp id="k_titulo" dim="50,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"			type="string" modify="N" available="N" fnt="Arial,22"/>	<br/><tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp dim="32,27,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Esquema por Punto">					<tab/><br/><tab/><txt>Tipo de Punto :  </txt>			<cmb id="cmb_tipo" dim="17,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" modify="Y" OnChange="ResetResults()"/>			<br/><tab/><br/><tab/><txt fnt=",b">Hasta</txt><tab n="4"/><txt fnt=",b">Porcentaje</txt><br/><tab/>			<inp id="k_util_1" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213" type="number" modify="Y" just="R" nd="2" min="0" max="999999999"/>				<tab/>			<inp id="k_por_1" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213" type="number"  modify="Y" just="R" nd="2" min="0" max="100"/>				<br/><tab/>			<inp id="k_util_2" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213" type="number" modify="Y" just="R" nd="2" min="0" max="999999999"/>				<tab/>			<inp id="k_por_2" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213" type="number"  modify="Y" just="R" nd="2" min="0" max="100"/>				<br/><tab/>			<inp id="k_util_3" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213" type="number" modify="Y" just="R" nd="2" min="0" max="999999999"/>				<tab/>			<inp id="k_por_3" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213" type="number"  modify="Y" just="R" nd="2" min="0" max="100"/>				<br/><tab/>			<inp id="k_util_4" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213" type="number" modify="Y" just="R" nd="2" min="0" max="999999999"/>				<tab/>			<inp id="k_por_4" dim="12,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213" type="number"  modify="Y" just="R" nd="2" min="0" max="100"/>				<br/><br/><tab n="2"/>			<br/>			<tab n="1"/><bot id="bot_guardar" dim="14,0" brdr="5" text="Guardar" default="0" OnEnter="Guardar()"/>		</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco, externo ;			var tipoOper; //Variables relacionadas con parametros			var consAdmin, consControl, consPlantilla, consCargarHorasTab,consCierraAbrePuntosTab ,consCargos,consCargosSel,consRefsCierra,consRefsAbre,				consIniciarTerminarTrabajo,consCargosAbre,consTotsCierra,consCargosCierra ,consTotsAbre,consCalidadAlta, resVal,				consCalidadBaja,consAutorizaCierre,consAbreOrdenGeneral,consCierraOrdenGeneral;			var consCuestPre, consCuestEnt, consCuestWlka ; //CUEST			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";				Inicializa();				Buscar();						}			fun Inicializa(){				var cmd,cubo,ok,mensajeError ;				frn.set("k_titulo","Esquema por Punto");								//Llena combo tipo de punto				frn.setX("Fallas","cmb_tipo",0,0);								frn.setX("F","cmb_tipo",0,1);				frn.setX("Garantias","cmb_tipo",1,0);								frn.setX("G","cmb_tipo",1,1);					frn.setX("Hojalateria","cmb_tipo",2,0);								frn.setX("H","cmb_tipo",2,1);				frn.setX("Servicio","cmb_tipo",3,0);								frn.setX("S","cmb_tipo",3,1);			}			fun ResetResults(){				frn.rst("k_util_1");				frn.rst("k_por_1");				frn.rst("k_util_2");				frn.rst("k_por_2");				frn.rst("k_util_3");				frn.rst("k_por_3");				frn.rst("k_util_4");				frn.rst("k_por_4");												Buscar();			}					fun ValidarDatos(){				var	val1, val2;				val1=frn.get("k_util_1");				val2=frn.get("k_util_2");				if (val1 >= val2) {					frn.setPos("k_util_1");					resVal=0;					frn.message("El importe del escalon de utilidad 1 debe ser menor al escalon 2","Error","Aceptar");					return;				}				val1=frn.get("k_util_2");				val2=frn.get("k_util_3");				if (val1 >= val2) {					frn.setPos("k_util_2");					resVal=0;					frn.message("El importe del escalon de utilidad 2 debe ser menor al escalon  3","Error","Aceptar");					return;				}				val1=frn.get("k_util_3");				val2=frn.get("k_util_4");				if (val1 >= val2) {					frn.setPos("k_util_3");					resVal=0;					frn.message("El importe del escalon de utilidad 3 debe ser menor al escalon  4","Error","Aceptar");					return;				}			}			fun Guardar() {				var cmdQuery, mensajeError;				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}							var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}				var xmlRequest = getXml(frn.dataPag());					setXml(xmlRequest ,"usuario",usuario);				frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");				cmdQuery="SELECT * FROM keplersc.cat_esqasepun_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				var cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_esqasepun_crud.Guardar()");	//				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");				if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.message("Registro Guardado","Mensaje","Aceptar");				Buscar();			}				fun Buscar() {				var xmlRequest,cmd,ok,cuboResultados, totOrd , contOrd, ref_clave, ref_desc;				var anio;				//llena datos de la orden				cmd= "select c2 as k_util_1, c3 as k_por_1, c4 as k_util_2, c5 as k_por_2,					c6 as k_util_3, c7 as k_por_3, c8 as k_util_4, c9 as k_por_4 ";				cmd=cmd & "from keplersc.kdesqasepun where c1='" & frn.get("cmb_tipo",-1,1) & "'";				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRequest");				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ordenentsaluni.Buscar()");				ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}//				frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cubocliente");				xmlRequest=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboResultados,"r0");				frn.setX(xmlRequest);				frn.setPos("k_util_1");				frn.setPos("cmb_tipo");			}											fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>