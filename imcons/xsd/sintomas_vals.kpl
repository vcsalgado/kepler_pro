<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Sintomas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="55,40,10,10" brdr="0,5" tit="Sintomas" fnt="Arial,16">					<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" OnEnter="Exit" OnMouseD="Exit" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="49,22" modify="N" nren="fijo">		<col id="clave" name="Clave"/>		<col id="desc" name="Descripcion"/>		</tbl> 		<tab n="7"/>		<br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,sys,tipo_sintoma ;			fun Main(){				frn=new FRNT;				frP=new FRNTP;				sys=new SYS;				tipo_sintoma = frP.get("tabla_sintomas" , -1, "tipo_sintoma");					Inicializa();					}						fun Inicializa() {							var xmlRequest,cmd,ok,cuboResultados, totOrd , contOrd, ref_clave, ref_desc;									cmd= "select c2,c3 from keplersc.kdvaltipsin where c1='" & tipo_sintoma & "'";							cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sintomas_vals.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								totOrd = nXml(cuboResultados);							frn.rst("tabla");				for (contOrd=0; contOrd<totOrd ; contOrd++){								frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c2"),"tabla",contOrd,"clave");					frn.setX( getXmlAtt(cuboResultados,"r"&contOrd,"c3"),"tabla",contOrd,"desc");									}						}						fun Exit(){									var clave_sin = frn.get("tabla", -1, "clave");						frP.setX(clave_sin ,"tabla_sintomas",-1,"clave_sintoma"); 				frP.scriptElm("tabla_sintomas","OnChange","clave_sintoma");												var des_sintoma = frn.get("tabla", -1, "desc");						frP.setX(des_sintoma ,"tabla_sintomas",-1,"desc_sintoma"); 				frP.scriptElm("tabla_sintomas","OnChange","desc_sintoma");								frn.exit();							}						}	</script></pag>