<inp id="det_telcasa" dim="20,1" type="string" modify="N" fnt=",15"/>		<sp n="6"/> <txt fnt=",15">Tel. Movil : </txt>		<sp n="2"/> <inp id="det_movil" dim="15,1" type="string" modify="N" fnt=",15"/>		<br exe="detalle"/>				<sp n="1"/> <txt fnt=",15">Tel. Oficina : </txt> 		<sp n="2"/> <inp id="det_telofic" dim="20,1" type="string" modify="N" fnt=",15"/>		<sp n="6"/> <txt fnt=",15">Ext. : </txt>		<sp n="5"/> <inp id="det_telext" dim="15,1" type="string" modify="N" fnt=",15"/>		<sp n="4"/> <txt fnt=",15">Radio : </txt>		<sp n="2"/><tab/> <inp id="det_radio" dim="15,1" type="string" modify="N" fnt=",15"/>		<br exe="detalle"/>				<sp n="1"/> <txt fnt=",15">Contacto : </txt> 		<sp n="3"/> <inp id="det_contac" dim="77,1" type="string" modify="N" fnt=",15"/>		<br exe="detalle"/>				<sp n="1"/> <txt fnt=",15">R.F.C. : </txt> 		<sp n="4"/> <inp id="det_rfc" dim="20,1" type="string" modify="N" fnt=",15"/>		<br exe="detalle"/>				<br exe="detalle"/>				<sp n="1"/> <txt fnt=",15">Recepcionista : </txt> 		<inp id="det_recep" dim="20,1" type="string" modify="N" fnt=",15"/>		<br exe="detalle"/> 				<!-- <sp n="1"/> -->  		<sp n="1"/> <txt fnt=",15">Bonete : </txt> 		<sp n="4"/> <inp id="det_bonete" dim="20,1" type="string" modify="N" fnt=",15"/>		<sp n="6"/> <txt fnt=",15">Siniestro : </txt>		<!-- <sp n="2"/> --> 		<inp id="det_siniestro" dim="20,1" type="string" modify="N" fnt=",15"/>		<br exe="detalle"/>				<sp n="1"/> <txt fnt=",15">Comentarios : </txt> 		<br exe="detalle"/>				<sp n="1"/> 		<inp id="det_cmnt1" dim="87,1" type="string" modify="N" fnt=",14"/> 		<br exe="detalle"/> 				<sp n="1"/> 		<inp id="det_cmnt2" dim="87,1" type="string" modify="N" fnt=",14"/>		<br exe="detalle"/>  				<sp n="1"/> 		<inp id="det_cmnt3" dim="87,1" type="string" modify="N" fnt=",13"/>		<br exe="detalle"/>				<sp n="1"/> 		<inp id="det_cmnt4" dim="87,1" type="string" modify="N" fnt=",13"/> 		<br exe="detalle"/> 				<sp n="1"/> 		<inp id="d