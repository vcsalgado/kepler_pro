ezado"/>		<sp n="1"/>		<txt fnt=",15">Fecha Recepcion : </txt> <sp n="1"/>		<!-- bclr="249,249,249" -->		<inp id="fechrec" dim="12,1" fnt=",15" type="date" modify="N"  fmt="DD/MM/CCYY" nc="-1"/>		<sp n="11"/> <txt fnt=",15">Hora Recepcion : </txt> 		<!-- bclr="249,249,249" -->		<sp n="6"/> <inp id="horarec" dim="10,1" fnt=",15" type="string" modify="N"/>				<br exe="section-dates"/>		<sp n="1"/>		<txt fnt=",15">Fecha Cita : </txt> <sp n="5"/>		<inp id="fechcit" dim="12,1" fnt=",15" type="date" modify="N" fmt="DD/MM/CCYY" nc="-1"/>		<sp n="11"/>		<txt fnt=",15">Hora Cita : </txt> <sp n="9"/> <inp id="horacit" dim="10,1" fnt=",15" type="string" modify="N"/>		<sp n="7"/>		<txt fnt=",15">Folio : </txt> <sp n="1"/>		<!-- bclr="249,249,249" -->		<inp id="foliocit" dim="10,1" fnt=",15" type="string" modify="N"/>				<br exe="section-dates"/>		<br exe="section-dates"/>				<sp n="1"/>		<txt fnt=",15">Fecha Promesa Original : </txt> <sp n="1"/>		<inp id="fechproo" dim="12,1" fnt=",15" type="date" modify="N" fmt="DD/MM/CCYY" nc="-1"/>		<sp n="7"/>		<txt fnt=",15">Hora Promesa Original : </txt> 		<sp n="2"/> <inp id="horaproo" dim="10,1" fnt=",15" type="string" modify="N"/>				<br exe="section-dates"/>						<sp n="1"/>		<txt fnt=",15">Fecha Promesa : </txt> <sp n="6"/>		<inp id="fechpro" dim="12,1" fnt=",15" type="date" modify="N" fmt="DD/MM/CCYY" nc="-1"/>		<sp n="7"/>		<txt fnt=",16">Hora Promesa : </txt> <sp n="6"/>		<inp id="horapro" dim="10,1" fnt=",15" type="string" modify="N"/>				<br exe="section-dates"/>				<sp n="1"/>		<txt fnt=",15">Fecha Cierre : </txt> <sp n="8"/>		<inp id="fechcie" dim="12,1" fnt=",15" type="date" modify="N" fmt="DD/MM/CCYY" nc="-1"/>		<sp n="7"/>		<txt fnt=",15">Hora Cierre : </txt> <sp n="8"/>		<inp id="horacie" dim="10,1" fnt=",15" type="string" modify="N"/>				<br exe="section-dates"/>						<br exe="section-wlka"/>		<hLine dim="89,0" g="1" type="1"/>		<br exe="section-wlka"/>				<sp n="1