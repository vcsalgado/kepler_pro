<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<grp id="grupo_crud" dim="50,20,20,10" bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16"><tab/>					<inp id="input_abrv_ant" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255"  visible="N" clrBrdr="255,255,255" available="N"/><br/><tab/>			<txt id="text_id">Abreviatura:</txt><tab/>			<inp id="input_abrv" dim="10,1" brdr="2,0" nc="5" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt id="text_id">Nombre:</txt><tab/>			<inp id="input_nombre" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt id="text_id">Tipo:</txt><tab n="2"/>			<inp id="input_tipo" dim="10,1" brdr="2,0" nc="1" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>			<txt id="text_id">Sucursal:</txt><tab n="1"/>			<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="10,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  Null="N"  available="Y"/><br/><tab/>								<br/>			<tab n="5"/><bot id="btn_aceptar" dim="5,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/><br/>						<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>											</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP,sys,accion,externo,suc_usuario,perfil_usuario,asterisco,nombre_usuario,abrv  ;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();																									suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");			   nombre_usuario = frn.lib("libKepler","UserInfo(3)");				asterisco = "*";												ctlrs_off();				llenar_ctlrs_default();				//config_ctrls_perfil();								}						fun ctlrs_off(){							frn.setAtt("btn_aceptar", "visible", "N" );											}							fun llenar_ctlrs_default(){							frn.rst("grupo_crud");							accion = frn.param(0);									externo	= frn.param(2);							var xmlRequest,cmd,ok, cuboResultados;								frn.set("input_crud", accion);							frn.setAtt("grupo_crud", "tit", accion );																				//Llenar combo sucursales								var combo_suc = "k_sucN";								cmd = "select '['||c1||'] '||c2 as descripcion, c1 as clave from keplersc.kdms";								if (perfil_usuario &! "ADMINISTRADOR"  && perfil_usuario &! "ADMINISTRATOR" && perfil_usuario &! "Administrador Kepler 8.0"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {									if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}else{						frn.setX("", combo_suc ,0,0);						frn.setX("", combo_suc , 0, 1);					}				}							cuboResultados= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_venref_crud.Inicializa()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}										llenar_cmb(cuboResultados,combo_suc );																				if (accion &= "Modificar"){									//llamada externa(padre)					if (externo &= "s"){											abrv =frP.get(frn.param(3));												if (abrv &= ""){													frn.message("selecciona un vendedor con F9 para modificar","Error","Aceptar");							return;						}											}else {											abrv = frn.param(1);					}				}																			if (accion &! "Nuevo") {														if (accion &! "Modificar"){											abrv = frn.param(1);										}													cmd="select vr.c2,vr.c3,'['||s.c1||'] '||s.c2 as sucursal from keplersc.kdvenref as vr left outer join keplersc.kdms as s on vr.c4=s.c1 where vr.c1 ='" & abrv & "'"; 																					if (suc_usuario &! "" && suc_usuario &! asterisco){						cmd = cmd & " and vr.c4='"& suc_usuario &"'";  					}													cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_venref_crud.llenar_ctlrs_default()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}										frn.set("input_abrv",abrv);					frn.set("input_abrv_ant",abrv);					frn.set("input_nombre",getXmlAtt(cuboResultados,"r"&0,"c2"));					frn.set("input_tipo",getXmlAtt(cuboResultados,"r"&0,"c3"));					frn.set("k_sucN",getXmlAtt(cuboResultados,"r"&0,"sucursal"));										}												if (accion &! "Consultar"){					frn.setAtt("btn_aceptar", "available", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );				}							}								fun Execute() {						var xmlRequest,cmd,cuboResultados,ok,cmd,cubo, mensajeError ;								var resultado_confirmacion = frn.message("¿Estas seguro?","Mensaje de Confirmacion","Aceptar");									if (resultado_confirmacion &! 1)  {					return;				}																	xmlRequest = getXml(frn.dataPag()); 							frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmd="SELECT * FROM keplersc.venref_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";					cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"cat_venref_crud.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");													var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;						}												if (accion &= "Nuevo" || accion &= "Modificar") {										var abrv_nueva = getXml(cubo ,"mensaje");										if (externo &= "n"){										frP.setX(abrv_nueva ,"tabla",-1,"abreviatura"); 						frP.scriptElm("tabla","OnChange","abreviatura");												frP.setX(frn.get("input_nombre"),"tabla",-1,"nombre"); 						frP.scriptElm("tabla","OnChange","nombre");													frP.setX(frn.get("input_tipo"),"tabla",-1,"tipo"); 						frP.scriptElm("tabla","OnChange","tipo");														}else {											frP.set(frn.param(3),abrv_nueva); 						frP.scriptElm(frn.param(3),"OnChange");														}										var sms =  "";										if (accion &= "Nuevo"){						sms = "Vendedor registrado";					}else {						sms = "Vendedor modificado";					}											frn.message(sms ,"Mensaje","Aceptar");					frn.exit();										}								if (accion &= "Eliminar"){									frP.setX("","tabla",-1,"abreviatura"); 					frP.scriptElm("tabla","OnChange","abreviatura");											frP.setX("","tabla",-1,"nombre"); 					frP.scriptElm("tabla","OnChange","nombre");												frP.setX("","tabla",-1,"tipo"); 					frP.scriptElm("tabla","OnChange","tipo");										frn.message("Vendedor eliminado","Mensaje","Aceptar");					frn.exit();									}										}						fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave_cli = getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave_cli , cmb, cont+pos_ini ,1);								}				}													}	</script></pag>