<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Diario de Movimientos" scale="48">	<grp dim="1,-1,10,20" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,15" unfont="0">		<br exe="encabezado"/>		<hLine dim="110,0" g="2" type="1"/>		<br exe="encabezado"/>		<grp dim="10,7,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>		<tab n="1"/>		<grp dim="62,5,7,12">			<br/>			<inp id="k_empresa" fnt=",20b" dim="80,1" clr="0,58,112" type="string" available = "N"/>			<br/>			<txt fnt=",16b" clr="0,58,112">Diario de Movimientos</txt>			<inp id="k_fecha_ini" fnt=",16b" dim="10,1" clr="0,58,112" type="date" just="C" fmt="DD/MM/CCYY" available = "N" nc="-1"/><txt fnt=",16b" clr="0,58,112"> al </txt>			<inp id="k_fecha_fin" fnt=",16b" dim="10,1" clr="0,58,112" type="date" just="C" fmt="DD/MM/CCYY" available = "N" nc="-1"/>			<br/>				<inp id="k_sucursal" fnt=",16b" dim="80,1" clr="0,58,112" type="string" available = "N"/>			<br/>		</grp>		<tab n="1"/>		<grp dim="20,5,7,12">			<br/>			<txt>P&#225;g:</txt><tab/><inp id="k_pag" dim="4,1" type="number" just="L" mcr="k_pag"/>			<br/>			<txt>Fecha:</txt><tab/><inp id="k_fecha_imp" dim="10,1" type="date" just="L" fmt="DD-MM-CCYY"/>			<br/>			<txt>Hora:</txt><sp/><tab n="1"/><inp id="K_hora_imp" dim="5,1" type="time" just="L"/>		</grp>		<br exe="encabezado"/>		<sp/><txt fnt=",-1b">Clave</txt>		<tab n="4"/><txt fnt=",-1b">Producto</txt>		<tab n="4"/><txt fnt=",-1b">Fecha</txt>		<tab n="4"/><txt fnt=",-1b">Documento</txt>		<tab n="4"/><txt fnt=",-1b">Descripci&#243;n</txt>		<tab n="3"/><txt fnt=",-1b">Tipo</txt>		<tab n="1"/><txt fnt=",-1b">Ctd</txt>		<tab n="2"/><txt fnt=",-1b">Unidad</txt>			<tab/><txt fnt=",-1b">Entrada</txt>			<tab/><txt fnt=",-1b">Salida</txt>			<br exe="encabezado"/>		<hLine dim="110,0" g="2" type="1"/>		<br exe="encabezado"/>										<sp/><inp id="clave" dim="10,1" type="string"/>		<tab n="1"/><inp id="producto" dim="20,1" type="string"/>		<tab n="1"/><inp id="fecha" dim="7,1" type="date" just="L" fmt="DD/MM/CCYY"/>				<tab n="1"/><inp id="documento" dim="15,1" type="string" just="R"/>		<tab n="1"/><inp id="descripcion" dim="15,1" type="string" just="R"/>		<tab n="2"/><inp id="tipo" dim="3,1" type="string"/>		<tab n="1"/><inp id="cantidad" dim="4,1" type="string"/><inp id="unidad" dim="4,1" type="string" just="R"/><tab/><inp id="entrada" dim="5,1" type="string" just="R"/>		<tab n="1"/><inp id="salida" dim="5,1" type="string" just="R"/>		<br exe="seccion_detalle"/>						<hLine dim="110,0" g="2" type="1"/>		<br exe="seccion_total_reporte"/>		<sp/><br/><tab n="31"/><txt fnt=",b">Total</txt><inp id="total_entrada" dim="5,1" type="string" just="R"/><tab/><inp id="total_salida" dim="5,1" type="string" just="R"/>		<br exe="seccion_total_reporte"/>	</grp></pag>