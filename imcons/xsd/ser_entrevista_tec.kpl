<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<!-- <txt fnt=",22" clr="0,0,0">Entrevista Tecnica</txt><br/> -->	<!-- dim="85,0" -->	<!-- <hLine dim="93,0" clr="0,0,0"/> -->	<!-- <br/> <br/> -->			<!-- dim="85,17,7,13" -->		<grp dim="51,36,7,13" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Entrevista Tecnica al Cliente ">						<!-- 			<sp n="1"/> <txt>Sucursal :</txt> 			<sp n="1"/> <inp id="c_suc" dim="5,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/>			<sp n="1"/> <inp id="k_suc" dim="38,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N"/> 			-->						<sp n="1"/>			<inp id="operacion" dim="16,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="L" available="N"/>			<!-- <br/> -->			<sp n="1"/> <txt>Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="44,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>			<br/>			<sp n="1"/> <txt>Encuesta :</txt>			<sp n="1"/> <edt id="k_folio" dim="11,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" visible="Y" OnButton="ObtenerFolios()" OnF9="ObtenerFolios()" OnChange="MostrarDatos()" nc="7"/> 			<sp n="2"/> <txt>Asesor :</txt>			<sp n="1"/> <edt id="k_asesor" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" visible="Y" OnButton="Get_Cat(2)" OnF9="Get_Cat(2)" OnChange="Get_Cat_Data(2,2)" nc="5"/> 			<sp n="1"/>	<inp id="c_asesor" dim="26,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="20"/>			<br/>			<sp n="1"/> <txt>Fecha : </txt> 			<!-- <sp n="1"/> -->			<edt id="k_fecha" dim="14,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N"/> 			<sp n="2"/> <txt>Hora Inicio : </txt>			<inp id="k_hora_i" dim="6,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="time" modify="Y" available="Y" visible="Y" nc="-1"/> 			<sp n="2"/> <txt>Hora Fin : </txt>			<inp id="k_hora_f" dim="6,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="time" modify="Y" available="Y" visible="Y" nc="-1"/> 			<sp n="2"/>	<inp id="c_folio" dim="4,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" visible="N" available="N" nc="3"/>			<br/>			<sp n="1"/> <txt>Tipo :</txt>			<sp n="2"/> <cmb id="k_tipon" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="CambiaTipo()" available="N" modify="Y"/>			<sp n="2"/> <txt>Orden : </txt>			<!-- OnButton="ObtenerOrden()" OnF9="ObtenerOrden()" OnChange="Valida_Orden(1)" -->			<edt id="k_orden" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" visible="Y" OnButton="Get_Cat(1)" OnF9="Get_Cat(1)" OnChange="Get_Cat_Data(1,2)" nc="10"/> 			<sp n="1"/> <txt>VIN : </txt> 			<inp id="c_vin" dim="13,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="10"/>			<br/>						<sp n="1"/> <txt>Descripcion del problema con las palabras del Cliente : </txt> 			<br/>			<!-- <sp n="1"/> <txt>[1]</txt> -->			<sp n="1"/> <inp id="c_dscr1" dim="70,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="80" bclr="250,250,250"/>				<br/>			<!-- <sp n="1"/> <txt>[2]</txt> -->			<sp n="1"/> <inp id="c_dscr2" dim="70,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="80" bclr="250,250,250"/>						<br/>			<!-- <sp n="1"/> <txt>[3]</txt> --> 			<sp n="1"/> <inp id="c_dscr3" dim="70,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="80" bclr="250,250,250"/>						<br/>			<!-- <sp n="1"/> <txt>[4]</txt> -->			<sp n="1"/> <inp id="c_dscr4" dim="70,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="80" bclr="250,250,250"/>						<br/>			<!-- <sp n="1"/> <txt>[5]</txt> -->			<sp n="1"/> <inp id="c_dscr5" dim="70,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="80" bclr="250,250,250"/>						<br/>			<sp n="1"/> <txt>Cuando percibio el cliente el sintoma por 1ra vez ?  ...  [ desde ] : </txt>			<br/>			<sp n="1"/> <txt clr="132,20,7">Nuevo</txt> 			<sp n="1"/> <inp id="c_nuevo" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y" available="Y" nc="1" bclr="250,250,250" OnChange="Valida_Campos_SN(1,c_nuevo)"/>				<sp n="2"/> <txt>KM</txt> 			<sp n="1"/> <inp id="c_km" dim="7,1" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="Y" available="Y" nc="6" bclr="250,250,250" fmt="5" min="0"/>				<sp n="2"/> <txt>Fecha</txt> 			<sp n="1"/> <edt id="c_fecha" dim="13,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,c_fecha" OnF9="Dialog(3,_ks_fecha,c_fecha)" clrBrdr="255,255,255" available="Y"/> 			<sp n="2"/> <txt>Que Frecuencia ?</txt> 			<sp n="1"/> <inp id="c_frecuencia" dim="9,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="7" bclr="250,250,250"/>				<br/>						<sp n="1"/> <txt>Otros, describe brevemente : </txt> 			<br/>			<!-- <sp n="1"/> <txt>[1]</txt> -->			<sp n="1"/> <inp id="c_otros1" dim="70,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="80" bclr="250,250,250"/>				<br/>			<!-- <sp n="1"/> <txt>[2]</txt> -->			<sp n="1"/> <inp id="c_otros2" dim="70,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="80" bclr="250,250,250"/>						<br/>						<sp n="1"/> <txt>Condicion(es) de manejo cuando se presenta el sintoma ? [ marque las aplicables ]</txt>			<br/>			<sp n="1"/> <txt>Velocidad (rango)</txt> 			<sp n="1"/> <inp id="c_vel_rango" dim="30,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="30" bclr="250,250,250"/>				<sp n="1"/> <txt>Condicion Clima</txt> 			<sp n="1"/> <inp id="c_cond_clima" dim="8,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="7" bclr="250,250,250"/>				<br/>			<sp n="1"/> <txt>Velocidad Motor (rpm)</txt> 			<sp n="1"/> <inp id="c_vel_motor" dim="30,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="30" bclr="250,250,250"/>				<sp n="2"/> <txt>Temp. Exterior</txt> 			<sp n="1"/> <inp id="c_temp_ext" dim="4,1" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="Y" available="Y" nc="3" bclr="250,250,250"/>				<br/>			<sp n="1"/> <txt>Posicion Transmision (PNDR12345)</txt> 			<sp n="1"/> <inp id="c_pos_trans" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y" available="Y" nc="1" bclr="250,250,250" OnChange="Valida_Trans(1)"/>				<sp n="2"/> <txt>Peso Carga</txt> 			<sp n="1"/> <inp id="c_peso_carga" dim="4,1" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="Y" available="Y" nc="3" bclr="250,250,250" fmt="5" min="0"/>				<sp n="3"/> <txt>Peso Arrastre</txt> 			<sp n="1"/> <inp id="c_peso_arrastre" dim="4,1" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="Y" available="Y" nc="3" bclr="250,250,250" fmt="5" min="0"/>				<br/>			<sp n="1"/> <txt>Num Pasajeros</txt> 			<sp n="1"/> <inp id="c_num_pasajeros" dim="3,1" clr="64,64,64" clrBrdr="255,255,255" type="number" modify="Y" available="Y" nc="2" bclr="250,250,250" fmt="5" min="0"/>				<sp n="3"/> <txt clr="132,20,7">Recto</txt> 			<sp n="1"/> <inp id="c_recto" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y" available="Y" nc="1" bclr="250,250,250" OnChange="Valida_Campos_SN(1,c_recto)"/>				<sp n="3"/> <txt clr="132,20,7">Giro Izq.</txt> 			<sp n="1"/> <inp id="c_giroi" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y" available="Y" nc="1" bclr="250,250,250" OnChange="Valida_Campos_SN(1,c_giroi)"/>				<sp n="3"/> <txt clr="132,20,7">Giro Der.</txt> 			<sp n="1"/> <inp id="c_girod" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y" available="Y" nc="1" bclr="250,250,250" OnChange="Valida_Campos_SN(1,c_girod)"/>				<sp n="3"/> <txt clr="132,20,7">Piloto Aut.</txt> 			<sp n="1"/> <inp id="c_pilotoa" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y" available="Y" nc="1" bclr="250,250,250" OnChange="Valida_Campos_SN(1,c_pilotoa)"/>				<br/>			<sp n="1"/> <txt clr="132,20,7">Acelerando</txt> 			<sp n="1"/> <inp id="c_acelera" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y" available="Y" nc="1" bclr="250,250,250" OnChange="Valida_Campos_SN(1,c_acelera)"/>				<sp n="7"/> <txt clr="132,20,7">Frenando</txt> 			<sp n="1"/> <inp id="c_frena" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y" available="Y" nc="1" bclr="250,250,250" OnChange="Valida_Campos_SN(1,c_frena)"/>				<sp n="13"/> <txt clr="132,20,7">Subida</txt> 			<sp n="1"/> <inp id="c_subir" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y" available="Y" nc="1" bclr="250,250,250" OnChange="Valida_Campos_SN(1,c_subir)"/>				<sp n="5"/> <txt clr="132,20,7">Bajada</txt> 			<sp n="1"/> <inp id="c_bajar" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y" available="Y" nc="1" bclr="250,250,250" OnChange="Valida_Campos_SN(1,c_bajar)"/>				<br/>								</grp>		<!-- <sp n="1"/> -->				<grp dim="50,36,7,13" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit=" ">						<sp n="1"/> <txt>Detalles Adicionales  -  [ Sintomas relacionados con ] : </txt>			<br/>						<sp n="1"/> <txt>[ A/C ] </txt>			<sp n="5"/> <txt clr="132,20,7">Recirculacion</txt> 			<sp n="2"/> <inp id="c_ac_recirculacion" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y" available="Y" nc="1" bclr="250,250,250" OnChange="Valida_Campos_SN(1,c_ac_recirculacion)"/>				<sp n="12"/> <txt>Velocidad Ventilador</txt> 			<sp n="2"/> <inp id="c_ac_ventilador" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y" available="Y" nc="1" bclr="250,250,250"/>					<br/>			<sp n="12"/> <txt>Temperatura</txt> 			<sp n="3"/> <inp id="c_ac_temp" dim="35,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="30" bclr="250,250,250"/>				<br/>						<sp n="1"/> <txt>[ Audio ] </txt>			<sp n="3"/> <txt>Estacion Radio</txt> 			<sp n="1"/> <inp id="c_audio_estacion" dim="35,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="30" bclr="250,250,250"/>				<br/>			<sp n="12"/> <txt>Ajuste Sonido</txt> 			<sp n="2"/> <inp id="c_audio_sonido" dim="35,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="30" bclr="250,250,250"/>				<br/>							<sp n="1"/> <txt>[ Ruidos ] </txt>			<sp n="2"/> <txt>Tipo de Ruido</txt> 			<sp n="2"/> <inp id="c_ruido_tipo" dim="9,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="7" bclr="250,250,250"/>				<sp n="5"/> <txt>Ubicacion</txt> 			<sp n="3"/> <inp id="c_ruido_ubica" dim="9,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="7" bclr="250,250,250"/>					<br/>					<br/>			<sp n="1"/> <txt>Comentarios Asesor Tecnico  -  [ despues de despedir al cliente ] : </txt> 			<br/>			<!-- <sp n="1"/> <txt>[1]</txt> -->			<sp n="1"/> <inp id="c_cmnt_1" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="80" bclr="250,250,250"/>				<br/>			<!-- <sp n="1"/> <txt>[2]</txt> -->			<sp n="1"/> <inp id="c_cmnt_2" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="80" bclr="250,250,250"/>						<br/>			<!-- <sp n="1"/> <txt>[2]</txt> -->			<sp n="1"/> <inp id="c_cmnt_3" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="80" bclr="250,250,250"/>						<br/>						<br/>					<sp n="1"/> <txt>S E C C I O N   [ B ]   -  Confirmar Reparacion en la Entrega : </txt> 			<br/>					<sp n="1"/> <txt>Hora Inicio :</txt>			<sp n="2"/> <inp id="k_hora_i_conf" dim="6,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="time" modify="Y" available="Y" visible="Y" nc="-1"/> 			<sp n="3"/> <txt>Hora Fin :</txt>			<sp n="2"/> <inp id="k_hora_f_conf" dim="6,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="time" modify="Y" available="Y" visible="Y" nc="-1"/> 			<sp n="2"/> <txt clr="132,20,7">Se confirmo el sintoma</txt> 			<sp n="1"/> <inp id="c_sint_conf" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="capital" modify="Y" available="Y" nc="1" bclr="250,250,250" OnChange="Valida_Campos_SN(1,c_sint_conf)"/>			<br/>			<sp n="1"/> <txt>Que se detecto</txt> 			<sp n="1"/> <inp id="c_sint_dscr" dim="55,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="50" bclr="250,250,250"/>				<br/>					<sp n="1"/> <txt>Informacion Adicional del Cliente sobre la ocurrencia de la condicion : </txt> 			<br/>			<!-- <sp n="1"/> <txt>[1]</txt> -->			<sp n="1"/> <inp id="c_info_1" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="80" bclr="250,250,250"/>				<br/>			<!-- <sp n="1"/> <txt>[2]</txt> -->			<sp n="1"/> <inp id="c_info_2" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="80" bclr="250,250,250"/>						<br/>			<!-- <sp n="1"/> <txt>[2]</txt> -->			<sp n="1"/> <inp id="c_info_3" dim="69,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" nc="80" bclr="250,250,250"/>						<br/>									<br/>				<sp n="1"/> <txt>S E C C I O N   [ C ]   -  Explicacion al Cliente : </txt> 			<br/>					<sp n="1"/> <txt>Hora Inicio :</txt>			<sp n="2"/> <inp id="k_hora_i_expl" dim="6,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="time" modify="Y" available="Y" visible="Y" nc="-1"/> 			<sp n="3"/> <txt>Hora Fin :</txt>			<sp n="2"/> <inp id="k_hora_f_expl" dim="6,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="time" modify="Y" available="Y" visible="Y" nc="-1"/> 			<br/>							<!-- 			<br/>					<sp n="1"/> <txt>Serie :</txt> 			<sp n="1"/> <inp id="c_serie" dim="25,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" OnChange="Valida_Serie(1)" OnF10="Recupera_Serie()" nc="20" bclr="250,250,250"/>			<br/>				<sp n="1"/> <txt>Color Exterior : </txt>			<sp n="1"/> <inp id="c_color_ext" dim="10,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" visible="Y" OnF9="Get_Cat(3)" OnChange="Get_Cat_Data(3,2)" nc="10" bclr="250,250,250"/>			<br/>			<sp n="1"/> <inp id="k_color_ext" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" fnt="Arial,16" type="string" modify="N" available="N" nc="40" visible="Y"/>			<br/>			<sp n="1"/> <txt>Existe Eje Trasero ( N {vacio}, S ):</txt>			<sp n="1"/> <inp id="c_eje" dim="2,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" OnChange="Valida_Eje(1)" nc="1" bclr="250,250,250"/>			<br/>			<sp n="1"/> <txt>Clase : </txt>			<sp n="1"/> <inp id="c_clase" dim="7,1" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" OnF9="Get_Cat(6)" OnChange="Get_Cat_Data(6,2)" nc="5" bclr="250,250,250"/>			<sp n="1"/> <inp id="k_clase" clr="64,64,64" clrBrdr="255,255,255"  dim="30,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>			<br/>			--> 			</grp>				<br/>		<!-- Mensajes de Error en Datos : --> 		<!-- dim="76,5,7,13" --> 		<grp dim="78,6,7,13" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,17" hSpace="3" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Campos en rojo de la seccion [ Entrevista Tecnica al cliente ] solo pueden ser :  S / N o vacios ...">						<sp n="1"/> <txt clr="132,20,7">[Faltantes]  :</txt>			<sp n="1"/> <inp id="k_err" dim="97,1" clr="132,20,7" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="97"/>			<br/>			<sp n="1"/> <txt clr="132,20,7">[No Validos]:</txt>			<sp n="1"/> <inp id="k_err_d" dim="97,2" clr="132,20,7" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="180"/>						</grp>		<!-- <sp n="1"/> --> 		<grp dim="23,6,7,13" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="3" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="">					<sp/><tab n="2"/><sp/>		<!-- tooltip="Imprimir Documento &lt;Ctrl&gt;&lt;T&gt;" -->		<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Ejecuta_Reporte()" tooltip="Imprimir Documento ..." available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>				<sp n="3"/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Cancelar ..." available="Y" clrBrdr="0,0,0" visible="Y"/>					<!-- modify="Y" -->		<sp n="2"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Actualizar Registro ..." available="Y" clrBrdr="0,0,0" visible="N"/>									</grp>				</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable,asterisco ;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal;			var fileSavePath, tip_ope_original, tip_ope;												// Vars Parameters         var row_grid, err_data, err_empty, fech_original, view_adicionales, serie_original, descrip_original;                  var paramInv, paramOper, paramRutina, paramST, paramUEN;										fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";				fileSavePath = "C:\Basura";								err_empty = 0;				err_data = 0;								Inicializa();								// Un-commented 20231020						ConfiguraControlesOpcion();				} /* END Func Main() */			/*			fun ObtenerOrden() {			            sucursal_id = frn.get("k_sucn",-1,1);	            cmdQuery = "" &						"select i.c3 as orden, i.c11 as cliente, i.c4 as fecha from keplersc.kdord i " & 						"where i.c1 = '" & sucursal_id & "' and i.c2 = '" & frn.get("k_tipon",-1,1)  & "' order by i.c3 desc";						                                    frn.dialog("genlistasel","Relacion de Ordenes",cmdQuery,"orden","k_orden","0","","N");                     }			*/						/*			fun BuscarOrden() {				var folio, folio2;				folio = frn.get("k_orden");				folio2 = PadLeft(folio, 10, "0");				frn.set("k_orden", folio2);				Valida_Orden(folio2);				}			*/						/*			fun Valida_Orden(imodo) {							var v_tipoorden, v_folio, folio;								folio = frn.get("k_orden");				if ( strlen(folio) > 0 ) {					//folio = frn.get("k_orden");					folio = PadLeft(folio, 10, "0");					frn.set("k_orden", folio);				}								sucursal_id = frn.get("k_sucn",-1,1);				v_tipoorden = frn.get("k_tipon",-1,1);				v_folio = folio;								cmdQuery = "" &				"select i.c3 folio, i.c4 fecha, i.c5 hora, i.c6 vin " &				"from keplersc.kdord i where i.c1 = '" & sucursal_id & "' and i.c2 = '" & v_tipoorden & "' and i.c3 = '" & v_folio  & "'";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_entrevistatec.upd()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\entrevista_orden");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					//frn.set("c_vin", "");					frn.set("c_vin", "Error"); // "--"					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return "Error";					}				if(nXml(cuboQuery) == 0){					//frn.set("c_vin", "");					frn.set("c_vin", "Invalida"); // "--"					if ( imodo == 1 ) {						frn.message("La Orden No Existe (verifique el Tipo seleccionado) ...","Info","Aceptar");						Eval_Data_Row();						return;					} else {						return "Invalida";							}				}	else {					// Ok ...					frn.set("c_vin", getXmlAtt(cuboQuery,"r0", "vin"));					if ( imodo == 1 ) {						Eval_Data_Row();					}				}						}			*/						fun ObtenerFolios() {			            sucursal_id = frn.get("k_sucn",-1,1);	            cmdQuery = "" &						"select c2 as encuesta, c7 as fecha, " & 						"( case when length(c6) > 0 then '[' || c5 || '] ' || lpad(c6,10,'0') || ' ' || c3 else '' end ) as orden " &   						"from keplersc.kdenttec order by c2 desc";						                                   frn.dialog("genlistasel","Relacion de Encuestas",cmdQuery,"encuesta"/*"folio"*/,"k_folio","0","","N");                     }			fun CambiaSucursal {				LimpiaDatosDoc();				//LimpiaTotalesDoc();				//LimpiaEncabezado();				if(tip_ope &= "A"){					frn.set("k_fecha",sys.date());				} else {					frn.set("k_fecha","");				}				//frn.set("k_fecha",sys.date());				//frn.set("k_hora",sys.time());					//ArmarRefDocto();							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						/*if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {*/							if(tip_ope &= "M"/*"C"*/){ //Consulta								frn.set("operacion","MODIFICACION"/*"CONSULTA"*/);							}						/*}*/					}								}			}						fun CambiaTipo {				if ( tip_ope &= "A" ) {					LimpiaDatosDoc();				}				//LimpiaTotalesDoc();				//LimpiaEncabezado();				if(tip_ope &= "A"){					frn.set("k_fecha",sys.date());				} else {					//frn.set("k_fecha","");				}				//frn.set("k_fecha",sys.date());				//frn.set("k_hora",sys.time());					//ArmarRefDocto();								if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						/*if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {*/							if(tip_ope &= "M"/*"C"*/){ //Consulta								frn.set("operacion","MODIFICACION"/*"CONSULTA"*/);							}						/*}*/					}								}			}			fun LimpiaDatosDoc {							frn.set("k_folio", "");				frn.set("c_folio", "");								frn.set("k_asesor", "");				frn.set("c_asesor", "");				frn.set("k_fecha", "");				frn.set("k_hora_i","");				frn.set("k_hora_f","");				frn.set("k_orden","");				frn.set("c_vin","");								frn.set("c_dscr1","");				frn.set("c_dscr2","");				frn.set("c_dscr3","");				frn.set("c_dscr4","");				frn.set("c_dscr5","");								frn.set("c_nuevo","");				frn.set("c_km","");				frn.set("c_fecha","");				frn.set("c_frecuencia","");				frn.set("c_otros1","");				frn.set("c_otros2","");								frn.set("c_vel_rango","");				frn.set("c_cond_clima","");				frn.set("c_vel_motor","");				frn.set("c_temp_ext","");				frn.set("c_pos_trans","");				frn.set("c_peso_carga","");				frn.set("c_peso_arrastre","");				frn.set("c_num_pasajeros","");				frn.set("c_recto","");				frn.set("c_giroi","");				frn.set("c_girod","");				frn.set("c_pilotoa","");				frn.set("c_acelera","");				frn.set("c_frena","");				frn.set("c_subir","");				frn.set("c_bajar","");								frn.set("c_ac_recirculacion","");				frn.set("c_ac_ventilador","");				frn.set("c_ac_temp","");								frn.set("c_audio_estacion","");				frn.set("c_audio_sonido","");								frn.set("c_ruido_tipo","");				frn.set("c_ruido_ubica","");								frn.set("c_cmnt_1","");				frn.set("c_cmnt_2","");				frn.set("c_cmnt_3","");								//Seccion B ...				frn.set("k_hora_i_conf","");				frn.set("k_hora_f_conf","");				frn.set("c_sint_conf","");				frn.set("c_sint_dscr","");				frn.set("c_info_1","");				frn.set("c_info_2","");				frn.set("c_info_3","");								//Seccion C ...				frn.set("k_hora_i_expl","");				frn.set("k_hora_f_expl","");								//Ctrl Errs Objs				frn.setX("", "k_err");				frn.setX("", "k_err_d");							}			fun TrimDatosDoc {							frn.setX(trim(frn.get("k_folio")), "k_folio");				frn.setX(trim(frn.get("c_folio")), "c_folio");								frn.setX(trim(frn.get("k_asesor")), "k_asesor");				frn.setX(trim(frn.get("c_asesor")), "c_asesor");				frn.setX(trim(frn.get("k_orden")), "k_orden");				frn.setX(trim(frn.get("c_vin")), "c_vin");							frn.setX(trim(frn.get("c_dscr1")), "c_dscr1");				frn.setX(trim(frn.get("c_dscr2")), "c_dscr2");				frn.setX(trim(frn.get("c_dscr3")), "c_dscr3");				frn.setX(trim(frn.get("c_dscr4")), "c_dscr4");				frn.setX(trim(frn.get("c_dscr5")), "c_dscr5");								frn.setX(trim(frn.get("c_nuevo")), "c_nuevo");				frn.setX(trim(frn.get("c_frecuencia")), "c_frecuencia");				frn.setX(trim(frn.get("c_otros1")), "c_otros1");				frn.setX(trim(frn.get("c_otros2")), "c_otros2");								frn.setX(trim(frn.get("c_vel_rango")), "c_vel_rango");				frn.setX(trim(frn.get("c_cond_clima")), "c_cond_clima");				frn.setX(trim(frn.get("c_vel_motor")), "c_vel_motor");				frn.setX(trim(frn.get("c_pos_trans")), "c_pos_trans");								frn.setX(trim(frn.get("c_recto")), "c_recto");				frn.setX(trim(frn.get("c_giroi")), "c_giroi");				frn.setX(trim(frn.get("c_girod")), "c_girod");				frn.setX(trim(frn.get("c_pilotoa")), "c_pilotoa");				frn.setX(trim(frn.get("c_acelera")), "c_acelera");				frn.setX(trim(frn.get("c_frena")), "c_frena");				frn.setX(trim(frn.get("c_subir")), "c_subir");				frn.setX(trim(frn.get("c_bajar")), "c_bajar");							frn.setX(trim(frn.get("c_ac_recirculacion")), "c_ac_recirculacion");				frn.setX(trim(frn.get("c_ac_ventilador")), "c_ac_ventilador");				frn.setX(trim(frn.get("c_ac_temp")), "c_ac_temp");								frn.setX(trim(frn.get("c_audio_estacion")), "c_audio_estacion");				frn.setX(trim(frn.get("c_audio_sonido")), "c_audio_sonido");								frn.setX(trim(frn.get("c_ruido_tipo")), "c_ruido_tipo");				frn.setX(trim(frn.get("c_ruido_ubica")), "c_ruido_ubica");								frn.setX(trim(frn.get("c_cmnt_1")), "c_cmnt_1");				frn.setX(trim(frn.get("c_cmnt_2")), "c_cmnt_2");				frn.setX(trim(frn.get("c_cmnt_3")), "c_cmnt_3");				//Seccion B ...				frn.setX(trim(frn.get("c_sint_conf")), "c_sint_conf");				frn.setX(trim(frn.get("c_sint_dscr")), "c_sint_dscr");				frn.setX(trim(frn.get("c_info_1")), "c_info_1");				frn.setX(trim(frn.get("c_info_2")), "c_info_2");				frn.setX(trim(frn.get("c_info_3")), "c_info_3");											//Seccion C ...							}			/*			fun Valida_Pedimento(){				var strTmp;				strTmp=frn.get("c_pedimento");				strTmp = trim(frn.lib("libGeneral.kpl","StrReplace",strTmp," ",""));				frn.set("c_pedimento",strTmp);			}			*/						fun Valida_Trans(imodo) {				var dato_id, err_msg;							err_msg = "";							dato_id = trim(frn.get("c_pos_trans"));				dato_id = strFormat("ucase", dato_id);				if ( strlen(dato_id) > 0 && dato_id &! "P" && dato_id &! "N" && dato_id &! "D" && dato_id &! "R" && dato_id &! "1" && dato_id &! "2" && dato_id &! "3" && dato_id &! "4" && dato_id &! "5") {					if ( imodo == 1 ) {						frn.message("Valor de campo [ Posicion Transmision ] No valido ... " & dato_id & "|" & "" & "|" & "Debe ser : (PNDR12345) o vacio","Error","Aceptar");						//frn.setX("-", "c_pos_trans");						Eval_Data_Row();						return;					} else {						err_msg = "c_pos_trans Invalido";						return err_msg;					}					}	else	{					frn.setX(dato_id, "c_pos_trans");					if ( imodo == 1 ) { Eval_Data_Row(); } 				}										} // END -	Fun - Valida_Trans						fun Valida_Campos_SN(imodo, campo) {				var dato_id, err_msg;							err_msg = "";							dato_id = trim(frn.get(campo));				dato_id = strFormat("ucase", dato_id);				if ( strlen(dato_id) > 0 && dato_id &! "S" && dato_id &! "N") {					if ( imodo == 1 ) {						frn.message("Valor de campo [ " & campo & " ] No valido ... " & dato_id & "|" & "" & "|" & "Debe ser : S / N (o vacio)","Error","Aceptar");						//frn.setX("-", campo);						Eval_Data_Row();						return;					} else {						err_msg = campo;						return err_msg;					}					}	else	{					frn.setX(dato_id, campo);					if ( imodo == 1 ) { Eval_Data_Row(); } 				}										} // END -	Fun - Valida_Campos_SN						fun Valida_Serie(imodo) {				var dato_id, err_msg;							err_msg = "";							dato_id = "";				//cmdQuery = "select C8 as campo from keplersc.kdiv where c1 = '" & frn.get("k_mov",-1,"modelo") & "'";				if ( frn.get("k_tipo_auto") &= "USADO" ) {					cmdQuery = "select max(c2) max_invent from keplersc.kdinf where c5 = '" & frn.get("c_serie") & "' and c2 <> '" & frn.get("c_invent") & "' /*and c31 = 10*/ " & 						" and ( c31 = 10 or ( c31 > 0 and c32 < 60 ) ) ";						//Se actualizo la consideracion de Estatus para la discriminacion de Registros a Evaluar, por JMM 20230213					//				} else {					cmdQuery = "select max(c2) max_invent from keplersc.kdinf where c5 = '" & frn.get("c_serie") & "' and c2 <> '" & frn.get("c_invent") & "' and c31 <> 0" & 						" and c2 not in (select c2 from keplersc.kdinf where c31 = 20 and c32 = 70) ";						//2nd Linea Agregada por JMM para discriminar operaciones de Traspasos de Autos, 20230213 				}				rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"tbl_kdinf_upd.Valida_Serie()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\tbl_kdinf_upd_Valida_Serie");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "max_invent");								if ( strlen(dato_id) > 0 ) {					if ( imodo == 1 ) {						frn.message("La Serie que registraste ya esta asignada a otro Numero de Inventario : " & dato_id & "|" & "Teclea F10 sobre el campo [serie] para recuperar el ultimo Num. de Serie guardado en este Num. Inventario.","Error","Aceptar");						//frn.setX("--", "c_serie");							Eval_Data_Row();						return;					} else {						err_msg = dato_id;						return err_msg;					}				} else {					if ( imodo == 1 ) { 						if ( strlen( trim(frn.get("c_serie")) ) == 0 ) {							frn.message("La Serie No puede estar vacia ... " & "|" & "Teclea F10 sobre el campo [serie] para recuperar el ultimo Num. de Serie guardado en este Num. Inventario.","Error","Aceptar");						}						Eval_Data_Row(); 					}				}							}	// END -	Fun - Valida_Serie 									/*			fun Recupera_Serie() {				frn.setX(serie_original, "c_serie");				Eval_Data_Row();			}			*/																	fun Get_Cat(imodo) {            				var suc_id, dato_id;				var win_tit, field_key, field_col, cmdQuery;            				if ( imodo <= 0 || imodo > 7 /*|| tip_ope &! "A"*/ ) {					// No es opcion de CAT Valida ...					return;				}								win_tit = "";				field_key = "";				field_col = "";				cmdQuery = "";								/*				if (imodo == 2) {					win_tit = "CAT Inventarios";					field_key = "clave";					field_col = "invent";										dato_id = "";					cmdQuery = "select C8 as campo from keplersc.kdiv where c1 = '" & frn.get("k_mov",-1,"modelo") & "'";					rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comaltasigcrud.Get_Cat_kdiv_c8()");					//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\Get_Cat_Get_Cat_kdiv_c8()");					ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					dato_id = getXmlAtt(cuboQuery,"r0", "campo");					cmdQuery = "select d.C1 as clave, d.C2 as descripción from keplersc.kddinv d where d.c7 = '" & dato_id & "'";				}				*/								if (imodo == 1) {					win_tit = "Listado de Ordenes";					field_key = "orden";					field_col = "k_orden";					cmdQuery = "" &						"select i.c3 as orden, i.c11 as cliente, to_char(i.c4, 'dd/mm/yyyy') as fecha from keplersc.kdord i " & 						"where i.c1 = '" & /*"02"*/sucursal_id & "' and i.c2 = '" & frn.get("k_tipon",-1,1)  & "' order by i.c3 desc";				}								if (imodo == 2) {					win_tit = "CAT Asesores";					field_key = "clave";					field_col = "k_asesor";					cmdQuery = "select c1 clave, (c2 || ' ' || c3) nombre from keplersc.kdcatasesortec";				}									/*				if (imodo == 3) {					win_tit = "CAT Colores Exteriores";					field_key = "clave";					field_col = "c_color_ext";					cmdQuery = "select C3 as clave, C4 as descripción from keplersc.kdice2 where c1 =  '" & frn.get("c_modelo") & "'";				}			         				*/								/*				if (imodo == 4) {					win_tit = "CAT Colores Vestiduras";					field_key = "clave";					field_col = "c_color_vest";					cmdQuery = "select C3 as clave, C4 as descripción from keplersc.kdice3 where c1 =  '" & frn.get("c_modelo") & "'";				}					         				*/								/*				if (imodo == 5) {					win_tit = "CAT Sucursales";					field_key = "clave";					field_col = "c_suc";					cmdQuery = "select C1 as clave, C2 as descripción from keplersc.kdms";					objeto = "c_suc";				}					*/								/*				if (imodo == 6) {					win_tit = "CAT Clases Vehiculares";					field_key = "clave";					field_col = "c_clase";					cmdQuery = "select C1 as clave, C2 as descripción from keplersc.kdic";				}					*/								/*				if (imodo == 7) {					win_tit = "CAT Marcas Vehiculares";					field_key = "clave";					field_col = "c_marca";					cmdQuery = "select C1 as clave, C2 as descripción from keplersc.kdmarca";				}					*/								                      if ( strlen(win_tit) > 0 && strlen(field_key) > 0 && strlen(field_col) > 0 && strlen(cmdQuery) > 0 /*&& strlen(objeto) > 0*/ ) {                                        					//frn.dialog("genlistasel", win_tit,cmdQuery, field_key, "k_mov",-1, field_col,"S");  * * *  USADO EN GRIDS					//frn.dialog("genlistasel","Catálogo de Proveedores",cmdQuery,"k_claveprov","k_clave","0","","N");  * * *  USADO EN CTRLS SIMPLES										frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");				}							} /*END Func Get_Cat()*/		   fun Get_Cat_Data(imodo, icall) {						var suc_id, dato_id;				var field_ori,field_dest, tbl, field_dscr;				var field_add, dato_id_add;				var field_dest_2, dato_id_2;								if ( imodo < 0 || imodo > 7  /*|| ( tip_ope &! "A" && icall != 2 )*/ ) {					// No es opcion de CAT Valida ...					return;				}				 				field_dscr = "";				field_ori = "";				field_dest = "";				tbl = "";				cmdQuery = "";								dato_id = "";								sucursal_id = frn.get("k_sucn",-1,1);								/*						if (imodo == 1) {					field_dscr = "Modelo";					field_ori = "modelo";					field_dest = "descrip";					tbl = "kdiv";					//cmdQuery = "select C2 as " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'";					cmdQuery = "select k.c1 as cve, k.c2 as " & field_dest & ", k.c4 as clase, tcl.c2 as clase_descr, k.c5 as marca, tmr.c2 as marca_descr, " & 						"k.c6 as codISAN, tis.c2 as codISAN_descr, k.c8 as tipo_auto from keplersc.kdiv k " & 						"left join keplersc.kdic tcl on k.c4 = tcl.c1 " & 						"left join keplersc.kdmarca tmr on k.c5 = tmr.c1 " &  						"left join keplersc.kdtisan tis on k.c6 = tis.c1 " & 						"where k.c1 = '" & frn.get("k_mov",-1,"modelo") & "'";				}				*/								/*				if ( tip_ope &= "A" ) {					if (imodo == 2) {						field_dscr = "Inventario";						field_ori = "invent";						field_dest = "anio";						tbl = "kddinv";						//cmdQuery = "select C3 as " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'"; 						cmdQuery = "select i.C3 as anio from keplersc.kddinv i inner join keplersc.kdiv k on k.c8 = i.c7 and k.c1 = '" & frn.get("k_mov",-1,"modelo") & "'" & 							" where i.c1 = '" & frn.get("k_mov",-1,field_ori) & "'";					}				}								*/												//if ( tip_ope &= "A" ) {					if (imodo == 1) {											frn.set("k_orden", trim(frn.get("k_orden")));						if ( strlen(frn.get("k_orden")) == 0 ) {													frn.set("c_vin", "");							Eval_Data_Row();												} else {											var v_tipoorden, v_folio, folio;						folio = frn.get("k_orden");						if ( strlen(folio) > 0 ) {							//folio = frn.get("k_orden");							folio = PadLeft(folio, 10, "0");							frn.set("k_orden", folio);						}						sucursal_id = frn.get("k_sucn",-1,1);						v_tipoorden = frn.get("k_tipon",-1,1);						v_folio = folio;												field_dscr = "Orden";						field_ori = "k_orden";						field_dest = "c_vin";						//field_dest_2 = "descrip";						tbl = "kdord";						//cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '" & frn.get("k_mov",-1,"modelo") & "' and c3 = '" & frn.get("k_mov",-1,field_ori) & "'";												/*						cmdQuery = "select C4 as " & field_dest & " from keplersc." & tbl & " where c1 =  '" & frn.get("c_modelo") & "' and c3 = '" & frn.get(field_ori) & "'";						cmdQuery = "select (c2 || ' ' || c3) as " & field_dest & " from keplersc."  & tbl & " where c1 = '" & frn.get(field_ori) & "'";						*/												cmdQuery = "" &							"select i.c3 folio, i.c6 as " & field_dest &  " " &							"from keplersc." & tbl &" i where i.c1 = '" & /*"02"*/sucursal_id & "' and i.c2 = '" & v_tipoorden & "' and i.c3 = '" & v_folio  & "'";										}									} // End ... if modo == 1 				//}								if (imodo == 2) {					field_dscr = "Asesor";					field_ori = "k_asesor";					field_dest = "c_asesor";					//field_dest_2 = "descrip";					tbl = "kdcatasesortec";					//cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '" & frn.get("k_mov",-1,"modelo") & "' and c3 = '" & frn.get("k_mov",-1,field_ori) & "'";					cmdQuery = "select (c2 || ' ' || c3) as " & field_dest & " from keplersc."  & tbl & " where c1 = '" & frn.get(field_ori) & "'";				}																/*				if (imodo == 3) {					field_dscr = "Color Exterior";					field_ori = "c_color_ext";					field_dest = "k_color_ext";					//field_dest_2 = "descrip";					tbl = "kdice2";					//cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '" & frn.get("k_mov",-1,"modelo") & "' and c3 = '" & frn.get("k_mov",-1,field_ori) & "'";					cmdQuery = "select C4 as " & field_dest & " from keplersc." & tbl & " where c1 =  '" & frn.get("c_modelo") & "' and c3 = '" & frn.get(field_ori) & "'";				}								*/				/*				if (imodo == 4) {					field_dscr = "Color Vestidura";					field_ori = "c_color_vest";					field_dest = "k_color_vest";					//field_dest_2 = "descrip";					tbl = "kdice3";					//cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '" & frn.get("k_mov",-1,"modelo") & "' and c3 = '" & frn.get("k_mov",-1,field_ori) & "'";					cmdQuery = "select c4 as " & field_dest & " from keplersc." & tbl & " where c1 =  '" & frn.get("c_modelo") & "' and c3 = '" & frn.get(field_ori) & "'";				}								*/								/*				if (imodo == 5) {					field_dscr = "Sucursal";					field_ori = "c_suc";					field_dest = "k_suc";					//field_dest_2 = "descrip";					tbl = "kdms";					//cmdQuery = "select C1 as " & field_dest & ", c2 as " & field_dest_2 &" from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'";					cmdQuery = "select c2 as " & field_dest &" from keplersc." & tbl & " where c1 = '" & frn.get(field_ori) & "'";				}				*/				/*				if (imodo == 6) {					field_dscr = "Clase Vehiculo";					field_ori = "c_clase";					field_dest = "k_clase";					//field_dest_2 = "descrip";					tbl = "kdic";					//cmdQuery = "select C1 as " & field_dest & ", c2 as " & field_dest_2 &" from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'";					cmdQuery = "select c2 as " & field_dest &" from keplersc." & tbl & " where c1 = '" & frn.get(field_ori) & "'";				}				*/				/*				if (imodo == 7) {					field_dscr = "Marca Vehiculo";					field_ori = "c_marca";					field_dest = "k_marca";					//field_dest_2 = "descrip";					tbl = "kdmarca";					//cmdQuery = "select C1 as " & field_dest & ", c2 as " & field_dest_2 &" from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'";					cmdQuery = "select c2 as " & field_dest &" from keplersc." & tbl & " where c1 = '" & frn.get(field_ori) & "'";				}				*/								if (imodo == 0 && icall == 1) {					Eval_Data_Row();				}								field_add = "";				//if (imodo == 1) { field_add = "k_descrip"; }				if (imodo == 1) { field_add = "c_vin"; }								// This segment commented 20231023				/*				if (imodo == 3) { field_add = "k_color_ext"; }				if (imodo == 4) { field_add = "k_color_vest"; }					if (imodo == 5) { field_add = "k_suc"; }					if (imodo == 6) { field_add = "k_clase"; }				if (imodo == 7) { field_add = "k_marca"; }				*/											if ( strlen(field_dscr) > 0 && strlen(field_ori) > 0 && strlen(field_dest) > 0 && strlen(tbl) > 0 && strlen(cmdQuery) > 0 ) {					//if ( strlen(frn.get("k_mov",-1,field_ori)) != 0 ) {						//dato_id = frn.get("k_mov",-1,field_ori);						//cmdQuery = "select C2 as descrip from keplersc.kdiv where c1 = '" & dato_id & "'";						rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comaltasigcrud.Get_Cat_" & tbl & "()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\Get_Cat_" & tbl);						ok=getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok){							dato_id = "--";							if (imodo == 1) {								//dato_id = "[ERR] verificando " &  field_dscr & " ...";								dato_id = "Error";							}							frn.setX(dato_id,"k_mov",-1, field_dest);							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							dato_id_add = "";														// This segment adapted 20231023							/*							if (imodo == 1) { dato_id_add = dato_id; }							if (imodo == 3 || imodo == 4 || imodo == 5) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							*/							dato_id_add = dato_id;														//if (imodo == 4) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							//if (imodo == 5) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							if ( strlen(field_add) != 0 ) { frn.setX(dato_id_add, field_add); }							return;						}						dato_id = "";						dato_id = getXmlAtt(cuboQuery,"r0", field_dest);					   if( strlen(dato_id) == 0 ){					   							// Code Adapted for this option							frn.setX(trim(frn.get(field_ori)), field_ori);							if (imodo == 5) {								dato_id = "--";							} else {								if ( strlen(frn.get(field_ori)) > 0 ) {									dato_id = "--";								} else {									dato_id = "";								}							}														//dato_id = "--";							if (imodo == 1 /*&& icall ==1*/) {								/*								frn.setX("", "k_marca");								frn.setX("", "k_clase");								frn.setX("", "k_tipo_auto");								*/								dato_id = "Invalida" /*"--"*/ /*field_dscr & " No existe ..."*/;							}														frn.setX(dato_id, field_dest);										if (icall == 2 ) { Eval_Data_Row(); }									return;												} else {													frn.setX(dato_id,field_dest);														if (icall == 2 ) { Eval_Data_Row(); }												}										}					} /*END Fun Get_Cat_Data()*/			fun Get_Data_Row(imodo) {				for (var i=0; i<=7; i++) {					Get_Cat_Data(i);				}								Eval_Data_Row(imodo);						} /*END Func Get_Data_Row()*/			fun Eval_Data_Row(/*nRow,*/ imodo) {							var ColIni, ColEnd, EvalCols, ErrText, ErrTextData;				var FieldsList, FieldListData, FlagErr;				var campo;								ErrText = "";				ErrTextData = "";							err_empty = 0;				err_data = 0;								FieldsList = "";				FieldListData = "";								campo = "";								// Evaluando vacios ...								TrimDatosDoc();							if ( strlen( frn.get("k_folio") ) == 0 && tip_ope &= "M" ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "encuesta | "; 				}								if ( imodo == 1 ) {					var v_fech;					v_fech = frn.get("k_fecha");					if ( strlen( v_fech /*frn.get("k_fecha")*/ ) == 0 ) { 						err_empty = err_empty + 1; 						FieldsList = FieldsList & "fecha | "; 					}				}								if ( strlen( frn.get("k_orden") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "orden | "; 				}				if ( strlen( frn.get("c_vin") ) == 0 ) { 					err_empty = err_empty + 1; 					FieldsList = FieldsList & "vin | "; 				}																							EvalCols = strlen(FieldsList) - 1;				if ( err_empty > 0 ) { FieldsList = mid(FieldsList, 0, EvalCols); } 												// Evaluando datos ...								if ( strlen( frn.get("k_folio") ) > 0 && tip_ope &= "M" ) {					if ( frn.get("c_folio") &= "Err" || frn.get("c_folio") &= "--" ) { 						err_data = err_data + 1;						FieldListData = FieldListData & "encuesta | ";					} 				}								/*				FlagErr = "";				FlagErr = Valida_Orden();				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "Num Orden [" & FlagErr &  "] | ";				} 				*/				if ( frn.get("c_vin") &= "Invalida" || frn.get("c_vin") &= "Error" || frn.get("c_vin") &= "--" /*"--"*/ ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "orden - vin | ";				} 								/*				if ( frn.get("k_color_ext") &= "--" ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "color_ext | ";				} 				*/								if ( frn.get("c_asesor") &= "--" ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "asesor | ";				} 								/*				FlagErr = "";				FlagErr = Valida_Serie();				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "Invent.Serie [" & FlagErr &  "] | ";				} 				*/								/*				FlagErr = "";				FlagErr = Valida_Eje();				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "tiene_eje_tr | ";				} 				*/								campo = "c_nuevo";				FlagErr = "";				FlagErr = Valida_Campos_SN(0, campo);				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & FlagErr & " | " /*"tiene_eje_tr | "*/;				} 								FlagErr = "";				FlagErr = Valida_Trans();				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & "Pos. Trans. | ";				}								campo = "c_recto";				FlagErr = "";				FlagErr = Valida_Campos_SN(0, campo);				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & FlagErr & " | ";				} 												campo = "c_giroi";				FlagErr = "";				FlagErr = Valida_Campos_SN(0, campo);				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & FlagErr & " | ";				} 												campo = "c_girod";				FlagErr = "";				FlagErr = Valida_Campos_SN(0, campo);				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & FlagErr & " | ";				} 								campo = "c_pilotoa";				FlagErr = "";				FlagErr = Valida_Campos_SN(0, campo);				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & FlagErr & " | ";				} 								campo = "c_acelera";				FlagErr = "";				FlagErr = Valida_Campos_SN(0, campo);				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & FlagErr & " | ";				}								campo = "c_frena";				FlagErr = "";				FlagErr = Valida_Campos_SN(0, campo);				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & FlagErr & " | ";				}								campo = "c_subir";				FlagErr = "";				FlagErr = Valida_Campos_SN(0, campo);				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & FlagErr & " | ";				}								campo = "c_bajar";				FlagErr = "";				FlagErr = Valida_Campos_SN(0, campo);				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & FlagErr & " | ";				}								campo = "c_ac_recirculacion";				FlagErr = "";				FlagErr = Valida_Campos_SN(0, campo);				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & FlagErr & " | ";				}								campo = "c_sint_conf";				FlagErr = "";				FlagErr = Valida_Campos_SN(0, campo);				if ( strlen( FlagErr )  > 0 ) { 					err_data = err_data + 1;					FieldListData = FieldListData & FlagErr & " | ";				}																if ( err_data > 0 ) { ErrTextData = "| " & FieldListData; }					if ( err_empty > 0 ) { ErrText = "| " & FieldsList; }								frn.setX(ErrText, "k_err");				frn.setX(ErrTextData, "k_err_d");								if ( strlen( ErrText ) == 0 && strlen( ErrTextData ) == 0 ) {					return -1;				}								return 1;							} /*END Func Eval_Data_Row()*/			fun Cancela() {							LimpiaDatosDoc();								CambiaSucursal();								//frn.exit();							} /* END Func Cancela() */									fun Ejecuta() {				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg;				var resultado, mensaje, adicionales, folio;				var RowErr, iLim;											Get_Data_Row(1);											if ( strlen(trim(frn.get("k_err"))) > 0 || strlen(trim(frn.get("k_err_d"))) > 0 ) {					frn.message("Existen Errores en los Datos, No se podra Registrar y/o Actualizar la Informacion ... ", "Alto !!! ", "Aceptar");					return;				}					//fecha = sys.date();				//hora = sys.time();								resultado = "";				mensaje = "";				adicionales = "";								xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;									frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\XmltoPostgres_ENTR_TEC");								/*				frn.message("Los Datos se Procesaran ...","Test Info !!!","Aceptar");				return;				*/													// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 							cmdQuery="SELECT * FROM keplersc.tbl_kdenttec_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				rstXml(cuboQuery);				cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"tbl_kdenttec_crud.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_ENTR_TEC");									// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 																// /*				resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");				adicionales = getXml(cuboQuery,"adicionales");				// */																	if( resultado &= "1" ) {									if ( strlen(adicionales ) == 0 ) {						frn.message(/*"Resultado [" & resultado & "] ; " & */mensaje, "Info !!! ", "Aceptar");					} else {						frn.message(/*"Resultado [" & resultado & "] ; " & */mensaje & "|" & adicionales, "Info !!! ", "Aceptar");					}										if ( tip_ope &= "A" ){ frn.set("k_folio", adicionales); } 					tip_ope = "M";					if ( tip_ope_original &! tip_ope ) { ConfiguraControlesOpcion(); } 					tip_ope_original = tip_ope;										MostrarDatos();					//Get_Data_Row();					//frn.setPos("c_pq01");									} else {									if ( strlen(adicionales) == 0 ) {						frn.message(mensaje, "Error", "Aceptar");					} else {						frn.message(mensaje & "|" & adicionales, "Error", "Aceptar");					}									}			} /* END Func Ejecuta() */									fun Inicializa(){ //Inicializa los valores en Pantalla				// Our code				var fech_init, strFecha, strTmp,fecha; 				ConfiguraControlesOff();				/*				paramInv = "";            paramOper = "";				paramRutina = "";				*/				paramUEN = "";								// Revisa y Carga en Variables los Parámetros Recibidos en la corrida				//if( frn.nParam() == 5 ){ //Se han mandado parámetros a la página				if( frn.nParam() >= 1 /*2*/ ){ //Se han mandado parámetros a la página	            	            /*                 paramInv = "0107-IRN21";               paramOper = "C";                              paramInv = trim(frn.param(0));                paramOper = trim(frn.param(1));					if ( frn.nParam() > 2 ) { paramRutina = trim(frn.param(2)); }               */                              paramUEN = trim(frn.param(0));               tip_ope = trim(frn.param(1));                              tip_ope_original = tip_ope;                              if (paramUEN != "SER"/*&= ""*/) {						//uen="SER";						frn.message("Esta acción no está permitida.","Info !!!","&Aceptar");						frn.open("redirect",2);						return;					}									} else {									// To testing after including parameter(s)					/*					paramInv = "0136-IRN22"; // 0100-IRU21 ; 0097-IRU21 ; 0107-IRN21 ; 0095-IRU21 ; 0106-IRU21					paramOper = "C";					paramRutina = "";					*/					//tip_ope = "M"/*"C"*/;					//paramUEN = "SER";										// /*					frn.message("Operación no válida [ sin Parametros ] ...", "Mensaje","&Aceptar");					//frn.open("anuncios",4);					//frn.open("index",4);					frn.open("redirect",2);					return;					// */									}                           if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					/*if(tip_ope &= "B"){ //Baja						frn.set("operacion","BAJA");					} else {*/						if(tip_ope &= "M"/*"C"*/){ //Consulta							frn.set("operacion","MODIFICACION"/*"CONSULTA"*/);						} else {					      frn.message("Operación no válida ...", "Mensaje","&Aceptar");							//frn.open("anuncios",4);							frn.open("index",4);							return;									}					/*}*/				}                 					//Llenar combo sucursales				var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));											// Fill Combo Tipo (Con Query FTO Kepler) 				/*				cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm " &				"where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4 = '" & tip_doc & "'" ;				*/				rstXml(cuboQuery);				cmdQuery = "select c1||'-'||c3 as c2, c1 from keplersc.kdmargen";				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_ordenrpt.Inicializa()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboTipoDocto");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error BD","Aceptar");					return;				}				frn.set("k_tipon",getXml(cuboQuery));								//frn.set("k_fecha",sys.date());            				LimpiaDatosDoc();										//MostrarDatos();				Get_Data_Row();								if(tip_ope &= "M"){					frn.set("k_fecha","");					frn.setPos("k_folio");				} else {					frn.set("k_fecha",sys.date());					frn.setPos("k_asesor");				}							//frn.message("Parameters : " & frn.nParam() & " ; tip_ope : " & tip_ope, "Info Parameters", "Aceptar");								} /* END Func Inicializa() */									fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         } /* END Func PadLeft() */			fun ConfiguraControlesOff() {								frn.setAtt("k_folio", "available", "N");				frn.setAtt("k_fecha", "available", "N");								frn.setAtt("k_tipon", "available", "N");			   frn.setAtt("k_orden", "available", "N");			 				frn.setAtt("Imprimir", "available", "N");				frn.setAtt("Cancelar", "available", "N");				frn.setAtt("Aceptar", "available", "N");														frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											} /* END Func ConfiguraControlesOff() */									fun ConfiguraControlesOpcion(imodo) {							ConfiguraControlesOff();								if (tip_ope &= "A") {					frn.setAtt("k_tipon", "available", "Y");					frn.setAtt("k_orden", "available", "Y");										frn.setAtt("Imprimir", "available", "N");					frn.setAtt("Cancelar", "available", "Y");					frn.setAtt("Aceptar", "available", "Y");																frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");				} 								if (tip_ope &= "M") {					frn.setAtt("k_folio", "available", "Y");										frn.setAtt("Imprimir", "available", "Y");					frn.setAtt("Cancelar", "available", "Y");					frn.setAtt("Aceptar", "available", "Y");																frn.setAtt("Imprimir", "visible", "Y");					frn.setAtt("Cancelar", "visible", "Y");					//frn.setAtt("Aceptar", "visible", "Y");				} 			} /* END Func ConfiguraControlesOpcion() */			   fun MostrarDatos() {		   				var flagErr, folio, v_tipo, v_orden;												flagErr = 0;												if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					/*if(tip_ope &= "B"){ //Baja						frn.set("operacion","BAJA");					} else {*/						if(tip_ope &= "M"/*"C"*/){ //Consulta							frn.set("operacion","MODIFICACION"/*"CONSULTA"*/);						} 						// New for this Opc ... 20231024 						else { frn.set("operacion",""); }					/*}*/				}								frn.setX(trim(frn.get("k_folio")), "k_folio");								sucursal_id = frn.get("k_sucn",-1,1);				folio = frn.get("k_folio");								LimpiaDatosDoc();								frn.set("k_folio", folio);				cmdQuery = "select coalesce(m.c3,'') as tipdscr, k.* " & 						"from keplersc.kdenttec k left join keplersc.kdmargen m on m.c1 = k.c5 " &						"where k.c1 = '" & sucursal_id & "'" & " and k.c2 = " & folio;								//frn.message(cmdQuery,"Info !","Aceptar");								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"entrevista_tec.upd()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatos_entrevista");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					frn.setX("Err", "c_folio");					frn.setAtt("Aceptar", "visible", "N");					mensajeError = getXmlAtt(cuboQuery,"native3");					if ( strlen( frn.get("k_folio") ) == 0 ) {						mensajeError = "Debe Registrar un Numero de Encuesta ...";					} else {						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					}					frn.message(mensajeError,"Error","Aceptar");					flagErr = 1;					Eval_Data_Row();					return;					}				if(nXml(cuboQuery) == 0){					frn.setX("--", "c_folio");					frn.setAtt("Aceptar", "visible", "N");					//ConfiguraControlesOff();					frn.message("Encuesta No Existe ...","Info","Aceptar");					flagErr = 1;					Eval_Data_Row();					return;					//Cancela();					}	else {					frn.setX("", "c_folio");					frn.setAtt("Aceptar", "visible", "Y");				}				//frn.set(cuboQuery);								//if ( flagErr == 1 ) { Cancela(); }				//ConfiguraControlesOpcion();								//frn.setX(getXmlAtt(cuboQuery,"r0", "c7"), "k_fecha");								frn.set("k_asesor", getXmlAtt(cuboQuery,"r0", "c4"));				frn.set("k_fecha", getXmlAtt(cuboQuery,"r0", "c7"));				frn.set("k_hora_i", getXmlAtt(cuboQuery,"r0", "c8"));				frn.set("k_hora_f", getXmlAtt(cuboQuery,"r0", "c9"));												// Topic about Investigated by JMM 20231023 2300				//frn.setAtt("k_tipon", "available", "Y");				v_tipo = getXmlAtt(cuboQuery,"r0", "c5") & "-" & getXmlAtt(cuboQuery,"r0", "tipdscr");				//v_tipo = "T" & "-" & "Orden Normal";				frn.set("k_tipon",v_tipo /*getXmlAtt(cuboQuery,"r0", "c5")*/);				//frn.setX(/*getXmlAtt(cuboQuery,"r0", "c5")*/v_tipo, "k_tipon");				//frn.setAtt("k_tipon", "available", "N");												v_orden = getXmlAtt(cuboQuery,"r0", "c6");				if ( strlen(v_orden) > 0 ) {					v_orden = PadLeft(v_orden, 10, "0");					frn.set("k_orden", v_orden);				}				//frn.set("k_orden", v_orden /*getXmlAtt(cuboQuery,"r0", "c6")*/);												frn.set("c_dscr1", getXmlAtt(cuboQuery,"r0", "c10"));				frn.set("c_dscr2", getXmlAtt(cuboQuery,"r0", "c11"));				frn.set("c_dscr3", getXmlAtt(cuboQuery,"r0", "c12"));				frn.set("c_dscr4", getXmlAtt(cuboQuery,"r0", "c13"));				frn.set("c_dscr5", getXmlAtt(cuboQuery,"r0", "c14"));								frn.set("c_nuevo", getXmlAtt(cuboQuery,"r0", "c15"));				frn.set("c_km", getXmlAtt(cuboQuery,"r0", "c16"));				frn.set("c_fecha", getXmlAtt(cuboQuery,"r0", "c17"));				frn.set("c_frecuencia", getXmlAtt(cuboQuery,"r0", "c18"));				frn.set("c_otros1", getXmlAtt(cuboQuery,"r0", "c19"));				frn.set("c_otros2", getXmlAtt(cuboQuery,"r0", "c20"));								frn.set("c_vel_rango", getXmlAtt(cuboQuery,"r0", "c21"));				frn.set("c_cond_clima", getXmlAtt(cuboQuery,"r0", "c24"));				frn.set("c_vel_motor", getXmlAtt(cuboQuery,"r0", "c22"));				frn.set("c_temp_ext", getXmlAtt(cuboQuery,"r0", "c28"));				frn.set("c_pos_trans", getXmlAtt(cuboQuery,"r0", "c23"));				frn.set("c_peso_carga", getXmlAtt(cuboQuery,"r0", "c26"));				frn.set("c_peso_arrastre", getXmlAtt(cuboQuery,"r0", "c27"));				frn.set("c_num_pasajeros", getXmlAtt(cuboQuery,"r0", "c25"));				frn.set("c_recto", getXmlAtt(cuboQuery,"r0", "c29"));				frn.set("c_giroi", getXmlAtt(cuboQuery,"r0", "c31"));				frn.set("c_girod", getXmlAtt(cuboQuery,"r0", "c32"));				frn.set("c_pilotoa", getXmlAtt(cuboQuery,"r0", "c36"));				frn.set("c_acelera", getXmlAtt(cuboQuery,"r0", "c30"));				frn.set("c_frena", getXmlAtt(cuboQuery,"r0", "c35"));				frn.set("c_subir", getXmlAtt(cuboQuery,"r0", "c33"));				frn.set("c_bajar", getXmlAtt(cuboQuery,"r0", "c34"));								frn.set("c_ac_recirculacion", getXmlAtt(cuboQuery,"r0", "c37"));				frn.set("c_ac_ventilador", getXmlAtt(cuboQuery,"r0", "c38"));				frn.set("c_ac_temp", getXmlAtt(cuboQuery,"r0", "c39"));								frn.set("c_audio_estacion", getXmlAtt(cuboQuery,"r0", "c40"));				frn.set("c_audio_sonido", getXmlAtt(cuboQuery,"r0", "c41"));								frn.set("c_ruido_tipo", getXmlAtt(cuboQuery,"r0", "c42"));				frn.set("c_ruido_ubica", getXmlAtt(cuboQuery,"r0", "c43"));								frn.set("c_cmnt_1", getXmlAtt(cuboQuery,"r0", "c44"));				frn.set("c_cmnt_2", getXmlAtt(cuboQuery,"r0", "c45"));				frn.set("c_cmnt_3", getXmlAtt(cuboQuery,"r0", "c46"));												// Seccion B 				frn.set("k_hora_i_conf", getXmlAtt(cuboQuery,"r0", "c47"));				frn.set("k_hora_f_conf", getXmlAtt(cuboQuery,"r0", "c48"));				frn.set("c_sint_conf", getXmlAtt(cuboQuery,"r0", "c49"));				frn.set("c_sint_dscr", getXmlAtt(cuboQuery,"r0", "c50"));								frn.set("c_info_1", getXmlAtt(cuboQuery,"r0", "c51"));				frn.set("c_info_2", getXmlAtt(cuboQuery,"r0", "c52"));				frn.set("c_info_3", getXmlAtt(cuboQuery,"r0", "c53"));												// Seccion C 				frn.set("k_hora_i_expl", getXmlAtt(cuboQuery,"r0", "c54"));				frn.set("k_hora_f_expl", getXmlAtt(cuboQuery,"r0", "c55"));								//Eval_Data_Row();				Get_Data_Row(1);		   } /* END Func MostrarDatosGrd() */					   								// ZONA	CODIGO REPORTE(S) 						fun IniParams(){//Inicializa parámetros de impresión. Pueden ser cambiados por el usuario final mediante menú: Archivo -> Configurar Página				frn.set("param_paper","letter");	//Tamaño de papel predefinido:	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tamaño de papel personalizado	"size=21.59,27.94cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//Márgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0");	//Escala de impresión (1=100 por ciento)	"F=1,1"				frn.set("param_landscape","N"/*"Y"*/);	//Orientación	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"				frn.set("param_emp","L");	//Posición de "Razón social"(izq,der,cen)	@emp=L|R|C"			}						fun setRepPage() {//Establece los parámetros finales de impresión.				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Ejecuta_Reporte() {										if (  ( /*frn.N("k_mov") == 0*/ frn.get("c_folio") &= "Err" || frn.get("c_folio") &= "--" ) || ( strlen( trim(frn.get("k_folio")/*frn.get("k_mov",-1,"folio")*/) ) == 0 )  ) {					frn.message("Debe filtrar un Folio Valido para mostrar los Registros ...","Info","Aceptar");					return;				}											// Commented 20221208 				//IniParams(); //Inicializa parámtros de impresión entre otros							//Code Added 20121208 				/*				//rstXml(xmlPar);				*/								/*				if ( tip_ope_original &= "C" && tip_ope &= "C" ) {					CambiaSucursal(3); 				}				*/									// fech_original = "2022-11-03"; // 4 Testing				// tip_ope_original = "A"; // 4 Testing								//...(cubos de datos e información necesaria)				//sucursal = frn.get("k_sucn",-1,1);				/*				if ( tip_ope_original &= "A" && tip_ope &= "C" ) {					fech_oper = fech_original; // frn.get("k_fecha");				}				tipo_auto = "NUEVO";				*/								/*				// setXml(xmlPar,"document","sucursal_id",sucursal);				*/								/*				if ( tip_ope_original &= "A" && tip_ope &= "C" ) {					setXml(xmlPar,"document","fech_oper", fech_oper); 				}				setXml(xmlPar,"document","tipo_auto", tipo_auto);				*/								//code Added 20221208 by JMM				/*				if ( strlen(frn.get("k_fecha")) > 0 ) { 					setXml(xmlPar,"document","fech_I", frn.get("k_fecha"));				}				if ( strlen(frn.get("k_fecha_F")) > 0 ) { 					setXml(xmlPar,"document","fech_F", frn.get("k_fecha_F"));				}					*/								/*				//setXml(xmlPar,"document","folio",frn.get("k_folio"));				//setXml(xmlPar,"document","fecha",frn.get("k_fecha"));				*/								/*				frn.lib("libGeneral.kpl","FileSave",xmlPar, fileSavePath & "\refalatapedcrud_rpt_xmlPar");												cmd="select * from keplersc.autos_com_asig_rpt('"& getXmlStr(xmlPar,"EOF:13_10") &"')";				rstXml(xmlResQuery);				xmlResQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comaltasigcrudN_rpt.Ejecuta_Reporte()");				ok=getXmlAtt(xmlResQuery ,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlResQuery ,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						frn.lib("libGeneral.kpl","FileSave",xmlResQuery, fileSavePath & "\comaltasigcrudN_rpt_xmlResQuery");								*/								Reporte();						} /* END Func Ejecuta_Reporte() */						fun Reporte() {							// Our Vars				var compania, titrep;				var contDet, tmpStr;								var dato_id; 								var sucursal, sucursaltx, fech_oper, xmlAlt ,xmlDet;							var v_folio, v_tipoorden, v_orden;								var p_fecha, var_fecha;				var p_subtotal, p_utilidad, p_perce, p_costo, p_total, p_iva;				var gt_subtotal, gt_utilidad, gt_perce, gt_costo, gt_total, gt_iva;								sucursal_id = frn.get("k_sucn",-1,1);				v_tipoorden = frn.get("k_tipon",-1,1);				v_folio = frn.get("k_folio");								sucursal = frn.get("k_sucn",-1,1);				sucursaltx = frn.get("k_sucn",-1,0);								//Obtener datos generales				kdb.kde("KDE");//Configuracion del servidor				kdb.exec();				compania = kdb.get("KDE","1");									// Se define el formato a usar y se liga a la variable del reporte "rep"	// Se define el formato a usar y se liga a la variable del reporte "rep"				rep.rst(); // 20121208				IniParams(); // 20121208				kdb.readPage("datFto","ser_entrevista_tec_fto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				//rep.rst(); // 20121208				setRepPage();//Establece los parámetros finales de impresión(rep.page(...);), pues pueden haber cambiado por el usuario 				//Da valor a los inputs del reporte(rep.set();), e indica la ejecución de "grupos de renglones de impresión" (rep.exe();)												titrep = "H O J A   D E   E N T R E V I S T A   T E C N I C A   A L   C L I E N T E";												rep.set("fecha",sys.date());				rep.set("hora",sys.time());				rep.set("nombreempresa",compania);				rep.set("tituloreporte",titrep);								rep.set("suctx",sucursaltx);								dato_id = "";								cmdQuery = "select coalesce(m.c3,'') as tipdscr, (coalesce(a.c2,'No Existe ...') || ' ' || coalesce(a.c3,'')) asesor, k.* " & 					"from keplersc.kdenttec k left join keplersc.kdmargen m on m.c1 = k.c5 " &					"left join keplersc.kdcatasesortec a on a.c1 = k.c4 " & 					"where k.c1 = '" & sucursal_id & "'" & " and k.c2 = " & v_folio;									rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ser_entrevista_tec.data_rpt()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\ser_entrevista_tec_rpt");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				dato_id = getXmlAtt(cuboQuery,"r0", "c2");				if ( strlen(dato_id) == 0 ) {					// Not records found				} else {									rep.set("k_folio",getXmlAtt(cuboQuery,"r0", "c2"));					rep.set("k_tipon",frn.get("k_tipon",-1,1));					rep.set("k_orden",frn.get("k_orden"));					rep.set("c_vin",frn.get("c_vin"));									rep.exe("encabezado");									rep.set("k_asesor", getXmlAtt(cuboQuery,"r0", "c4"));					rep.set("c_asesor", getXmlAtt(cuboQuery,"r0", "asesor"));					rep.set("k_fecha", getXmlAtt(cuboQuery,"r0", "c7"));					rep.set("k_hora_i", getXmlAtt(cuboQuery,"r0", "c8"));					rep.set("k_hora_f", getXmlAtt(cuboQuery,"r0", "c9"));									rep.set("c_dscr1", getXmlAtt(cuboQuery,"r0", "c10"));					rep.set("c_dscr2", getXmlAtt(cuboQuery,"r0", "c11"));					rep.set("c_dscr3", getXmlAtt(cuboQuery,"r0", "c12"));					rep.set("c_dscr4", getXmlAtt(cuboQuery,"r0", "c13"));					rep.set("c_dscr5", getXmlAtt(cuboQuery,"r0", "c14"));										rep.set("c_nuevo", getXmlAtt(cuboQuery,"r0", "c15"));					rep.set("c_km", getXmlAtt(cuboQuery,"r0", "c16"));					rep.set("c_fecha", getXmlAtt(cuboQuery,"r0", "c17"));					rep.set("c_frecuencia", getXmlAtt(cuboQuery,"r0", "c18"));					rep.set("c_otros1", getXmlAtt(cuboQuery,"r0", "c19"));					rep.set("c_otros2", getXmlAtt(cuboQuery,"r0", "c20"));					rep.set("c_vel_rango", getXmlAtt(cuboQuery,"r0", "c21"));					rep.set("c_cond_clima", getXmlAtt(cuboQuery,"r0", "c24"));					rep.set("c_vel_motor", getXmlAtt(cuboQuery,"r0", "c22"));					rep.set("c_temp_ext", getXmlAtt(cuboQuery,"r0", "c28"));					rep.set("c_pos_trans", getXmlAtt(cuboQuery,"r0", "c23"));					rep.set("c_peso_carga", getXmlAtt(cuboQuery,"r0", "c26"));					rep.set("c_peso_arrastre", getXmlAtt(cuboQuery,"r0", "c27"));					rep.set("c_num_pasajeros", getXmlAtt(cuboQuery,"r0", "c25"));					rep.set("c_recto", getXmlAtt(cuboQuery,"r0", "c29"));					rep.set("c_giroi", getXmlAtt(cuboQuery,"r0", "c31"));					rep.set("c_girod", getXmlAtt(cuboQuery,"r0", "c32"));					rep.set("c_pilotoa", getXmlAtt(cuboQuery,"r0", "c36"));					rep.set("c_acelera", getXmlAtt(cuboQuery,"r0", "c30"));					rep.set("c_frena", getXmlAtt(cuboQuery,"r0", "c35"));					rep.set("c_subir", getXmlAtt(cuboQuery,"r0", "c33"));					rep.set("c_bajar", getXmlAtt(cuboQuery,"r0", "c34"));					rep.set("c_ac_recirculacion", getXmlAtt(cuboQuery,"r0", "c37"));					rep.set("c_ac_ventilador", getXmlAtt(cuboQuery,"r0", "c38"));					rep.set("c_ac_temp", getXmlAtt(cuboQuery,"r0", "c39"));									rep.set("c_audio_estacion", getXmlAtt(cuboQuery,"r0", "c40"));					rep.set("c_audio_sonido", getXmlAtt(cuboQuery,"r0", "c41"));									rep.set("c_ruido_tipo", getXmlAtt(cuboQuery,"r0", "c42"));					rep.set("c_ruido_ubica", getXmlAtt(cuboQuery,"r0", "c43"));									rep.set("c_cmnt_1", getXmlAtt(cuboQuery,"r0", "c44"));					rep.set("c_cmnt_2", getXmlAtt(cuboQuery,"r0", "c45"));					rep.set("c_cmnt_3", getXmlAtt(cuboQuery,"r0", "c46"));									// Seccion B 					rep.set("k_hora_i_conf", getXmlAtt(cuboQuery,"r0", "c47"));					rep.set("k_hora_f_conf", getXmlAtt(cuboQuery,"r0", "c48"));					rep.set("c_sint_conf", getXmlAtt(cuboQuery,"r0", "c49"));					rep.set("c_sint_dscr", getXmlAtt(cuboQuery,"r0", "c50"));									rep.set("c_info_1", getXmlAtt(cuboQuery,"r0", "c51"));					rep.set("c_info_2", getXmlAtt(cuboQuery,"r0", "c52"));					rep.set("c_info_3", getXmlAtt(cuboQuery,"r0", "c53"));									// Seccion C 					rep.set("k_hora_i_expl", getXmlAtt(cuboQuery,"r0", "c54"));					rep.set("k_hora_f_expl", getXmlAtt(cuboQuery,"r0", "c55"));					rep.exe("section-detalle");									}												/*				rep.exe("endrep");				*/														//Modos de impresión 				rep.win(); //Muestra la vista previa de la impresión. A partir de la vista previa (Preprint) se decide si se imprime o no.				//rep.print("\\192.168.1.100\HPLaserJet"); //Envía el reporte directamente a una impresora, sin mostrar la vista previa.				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresión. No muestra la vista previa.				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardará el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html										} /* END Func Reporte() */									// END : ZONA	CODIGO REPORTE(S) 																		} // End of class Main			</script></pag>