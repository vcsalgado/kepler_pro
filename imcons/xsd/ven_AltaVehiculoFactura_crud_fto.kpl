<?xml version="1.0" encoding="UTF-8"?><pag xmlns='www.kepler.com.mx/2003/KSchema' tit='Consulta Factura Veh&#237;culo' scale="48"><grp dim='1,-1,10,20' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">	<br exe="encabezado"/>	<hLine dim="180,0"/>	<br exe="encabezado"/>	<grp dim="16,8,7,12"><sp/>		<img id="img"  dim="14,80" brdr="0,1" img="logocliente.jpg"/>	</grp>		<grp dim="180,16,7,1">		<inp id="k_empresa" just="C" fnt=",20b" dim="80,1" clr="0,58,112" type="string" available = "N"/>				<br/>		<inp id="titulo"  dim="40,1" clr="0,58,112" brdr="0,1" type="string" fnt="Arial,20b"/>		<tab n="5"/><sp/><txt fnt="Arial,20" clr="255,0,0">No.</txt>		<inp id="rep_docto"  just="R" dim="30,1" brdr="0,1" type="string" fnt="Arial,18" clr="255,0,0" nc="7"/>		<br/>		<txt fnt="Arial,18">Sucursal:</txt>		<inp id="rep_suc"  just="L" dim="30,1" brdr="0,1" type="string" fnt="Arial,16" nc="20"/>		<tab n="5"/>		<sp/><txt>Ref:</txt>		<inp id="rep_refer" just= "R" dim="30,1" brdr="0,1" type="string" fnt="Arial,15" fmt="DD/MM/CCYY" nc="-1"/><br/>		<tab n="17"/><sp n="2"/><txt>Fecha:</txt>		<inp id="rep_fecha" dim="20,1" just= "R" brdr="0,1" type="date" fnt="Arial,15" fmt="DD/MM/CCYY" nc="-1"/>	</grp>		<sp/>	<br exe="encabezado"/>	<tab n="1"/>		<br exe="seccion_detalle"/>	<hLine dim="180,0"/>		<br exe="seccion_detalle"/>	<grp dim="180,40,7,14">		<txt>Nombre del Cliente :</txt>		<inp id="rep_nombrecliente"   dim="100,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>				<txt>Nombre de impresi&#243;n:</txt>		<inp id="rep_nombreimpresion"   dim="100,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>		<txt>Direcci&#243;n:</txt>		<inp id="rep_clientedir2"  dim="90,1" brdr="0,1" type="string" fnt="Arial,15"/>					<br/>		<txt>Colonia :</txt>		<inp id="rep_colonia"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		<txt>Poblaci&#243;n :</txt>		<inp id="rep_poblacion"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		<txt>Tel&#233;fono :</txt><sp/>		<inp id="rep_telefono"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		<br/>		<br/><txt>RFC:</txt><sp/>		<inp id="rep_rfc"  dim="25,1" brdr="0,1" type="string" fnt="Arial,15"/><br/>		<br/>		<txt>N&#250;mero de Inventario: </txt><sp/>		<inp id="rep_inventario"  dim="15,1" brdr="0,1" type="string" fnt="Arial,15"/>				<tab/><txt>Serie: </txt><sp/>		<inp id="rep_serie"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		<tab/><sp/>		<inp id="rep_credito_contado"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		<tab/><sp/>		<inp id="rep_importado"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/>		<br/>		<tab n="2"/><sp/>		<inp id="rep_c17"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="2"/>		<inp id="rep_c18"  dim="24,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="2"/>		<inp id="rep_c15"  dim="8,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="2"/>		<inp id="rep_c4"  dim="45,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="2"/>				<br/>		<tab n="2"/><sp/>		<inp id="rep_H50"  dim="20,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="2"/>		<inp id="rep_H51"  dim="20,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="2"/>		<inp id="rep_H53"  dim="20,1" brdr="0,1" type="string" fnt="Arial,15"/><tab/>		<inp id="rep_c6"  dim="20,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="2"/>		<inp id="rep_c54"  dim="20,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="3"/>		<br/><br/>		<tab/><inp id="rep_1"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="2"/><br/>				<tab/><inp id="rep_2"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="2"/><br/>		<tab/><inp id="rep_3"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="2"/><br/>		<tab/><inp id="rep_4"  dim="80,1" brdr="0,1" type="string" fnt="Arial,15"/>				<tab n="5"/><inp id="rep_4a"  dim="18,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/><br/>		<br/><br/><br/>		<tab/><inp id="rep_5"  dim="100,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="2"/><br/>		<tab/><inp id="rep_6"  dim="100,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="2"/><br/>		<tab/><inp id="rep_7"  dim="100,1" brdr="0,1" type="string" fnt="Arial,15"/><tab n="2"/><br/>		<br/><br/><br/>		<tab/><inp id="rep_8"  dim="70,1" brdr="0,1" type="string" fnt="Arial,15"/><tab/><inp id="rep_8a"  dim="40,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/><tab/><br/>		<tab/><inp id="rep_9"  dim="70,1" brdr="0,1" type="string" fnt="Arial,15"/><tab/><inp id="rep_9a"  dim="40,1" brdr="0,1" type="string" fnt="Arial,15" just="R"/><tab/><br/>		<tab/><inp id="rep_10"  dim="70,1" brdr="0,1" type="string" fnt="Arial,15"/><tab/><inp id="rep_10a"  dim="40,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/><tab/><br/>		<tab/><inp id="rep_11"  dim="70,1" brdr="0,1" type="string" fnt="Arial,15"/><tab/><inp id="rep_11a"  dim="40,1" brdr="0,1" type="string" fnt="Arial,15" just="R"/><tab/><br/>		<tab/><inp id="rep_12"  dim="70,1" brdr="0,1" type="string" fnt="Arial,15"/><tab/><inp id="rep_12a"  dim="40,1" brdr="0,1" type="number" fnt="Arial,15" just="R" nd="2"/><tab/><br/>		<tab/><inp id="rep_13"  dim="110,1" brdr="0,1" type="string" fnt="Arial,15" just="R"/>				<br/>			<br/>				<tab/><inp id="rep_14"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15" just="C"/><br/>		<tab/><inp id="rep_15"  dim="120,1" brdr="0,1" type="string" fnt="Arial,15" just="C"/><br/>					</grp>	<br exe="seccion_detalle"/>			</grp><script>	/*	----------------------------------------------------------------	AUTOR						FECHA					CAMBIO	----------------------------------------------------------------	Saltiel					29-11-2022			ajuste de campos	----------------------------------------------------------------			*/	</script></pag>