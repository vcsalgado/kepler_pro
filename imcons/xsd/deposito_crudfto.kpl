<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns='www.kepler.com.mx/2003/KSchema' tit='Orden' scale="48">
<grp dim='1,-1,10,20' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">
<br/>
	<grp dim="15,8,7,12"><sp/>
		<img id="img"  dim="14,80" brdr="0,1" img="logocliente.jpg"/>
	</grp>
	<grp dim="50,8,7,1">
		<inp id="titulo"  dim="50,1" brdr="0,1" type="string" fnt="Arial,30b"/><br/><tab n="4"/><sp/>
		<br/>
		<txt fnt="Arial,18">Sucursal:</txt>
		<inp id="suc_desc"  just="L" dim="60,1" brdr="0,1" type="string" fnt="Arial,17" nc="20"/><br/>
	</grp>
	<tab n="2"/>
	<grp id="tipo" dim="60,5,7,2"><br/>
		<sp/><txt>Fecha:</txt>
			<tab n="2"/><inp id="rep_fecha" dim="20,1" brdr="0,1" type="date" fnt="Arial,15" fmt="DD/MM/CCYY" nc="-1"/><br/>
			<br/><br/>
		<sp/><txt>Hora:</txt>
			<tab n="2"/><inp id="rep_hora" dim="20,1" brdr="0,1" type="string" fnt="Arial,15"  nc="-1"/><br/><br/><br/>
		<sp/><txt>Pagina:</txt><tab n="2"/><inp id="k_pag" dim="4,1" type="number" just="L" mcr="k_pag"/>
	</grp>
	<br exe="encabezado"/>

<grp dim='100,5,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">
	<br/>
	<tab n="1"/><txt fnt="Arial,18b">COMPROBANTE DE DEPOSITO A BANCOS</txt>
</grp>
<br exe="encabezado"/><hLine dim="120,0" g="2"/><br exe="encabezado"/>





<grp dim='140,20,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">
	<br/>
	<tab n="1"/><txt fnt="Arial,18b"> FAVOR DE ENGRAPAR ESTE RECIBO A CADA FICHA DE DEPOSITO SELLADA POR EL BANCO </txt>	<br/>
	<tab n="1"/><txt fnt="Arial,18b"> ANTES DE ENTREGAR A CONTABILIDAD.</txt>
	<br/>	<br/>
	<tab n="1"/><txt fnt="Arial,18b">FECHA:  </txt>
	<sp/><inp id="fecha_recibo"  type="text" dim="8,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>
	
	<tab n="8"/><txt fnt="Arial,18b">FOLIO:   </txt><sp/>
	<sp/><inp id="folio"  type="text" dim="8,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/>
	
	<tab n="1"/><txt fnt="Arial,18b">BANCO:  </txt>
	<sp/><inp id="banco"  type="text"  dim="8,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/>
	
	<tab n="1"/><txt fnt="Arial,18b">REFERENCIA: </txt>
	<sp/><inp id="refer"  type="text" dim="8,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/>
	
		
	<tab n="1"/><txt fnt="Arial,18b">DEPOSITO: </txt>
	<sp/><inp id="deposito"  type="text"  dim="8,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>
		
	<tab n="7"/><txt fnt="Arial,18b">MONTO:  </txt>
	<sp/><txt fnt="Arial,15b">$</txt><inp id="monto"  type="number" nd="2" dim="8,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/>
	
</grp>
<br exe="recibo"/>
<br/>



<grp dim='150,20,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">


<tab n="1"/>
<inp id="coment"  dim="50,3" brdr="0,1" type="text" nd="2" bclr="255,255,255" fnt="Arial,15b"/>

</grp>

<br exe="coment"/>

<br/>
	
</grp>
</pag>