<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Selecci&#243;n de Registro"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,15,12" bclr="192,205,213" unfont="0">	<tab/>	<inp id="inp_titulo" dim="50,1" clr="0,0,0"  type="string" modify="N" available="N" fnt="Arial,22"/>	<br/>	<tab n="1"/>	<hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="58,40,10,10" brdr="0,5" tit="Resultado de b&#250;squeda" fnt="Arial,16">		<tab n="1"/>		<inp id="inp_filtros" dim="8,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213" 				type="string" modify="N" available="N" fnt="Arial,18"/>		<tab/>		<cmb id="k_filtros" clr="64,64,64" clrBrdr="192,205,213"  				dim="20,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  				Null="N" available="Y" tooltip="Selecciona columna base de b&#250;squeda"/>		<tab/>		<inp id="k_busqueda" dim="30,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="192,205,213"				type="capital"  just="L" tooltip="texto a buscar"/>		<tab n="1"/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_Registros()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>				<br/>		<tab n="1"/>		<tbl clr="64,64,64" clrBrdr="64,64,64" bclr="255,255,255" brdr="1,0" id="results" dim="80,18" 			modify="N" nren="fijo" Reorder="Y" OnMouseD="Execute()" insdel="N">			<col name="Sucursal" id="sucursal"/><col id="clave_actual" name="Clave Utilizar" type="string"/><col id="clave_original" name="Clave Original" type="string"/><col id="clave_ultima" name="Clave &#218;ltima" type="string"/><col id="descripcion" name="Descripci&#243;n" type="string"/><col id="cadena_reemplazo" name="Reemplazos" type="string"/><col id="existencias" name="Existencias" type="number" nd="2"/>		</tbl>		<tab n="1"/>		<br/>		<grp id="gpo_3" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="50,5,10,10" brdr="0,5" fnt="Arial,16" visible="S">			<tab n="1"/>			<img id="k_btn_selec" dim="40,40" bPx="1" brdr="0,1" available="Y" img="_60_DocNew.png" OnEnter="Execute()" tooltip="Seleccionar"/><tab/>			<img id="Exportar" dim="40,40" bPx="1" brdr="0,1" available="Y" img="_60_Save.png" OnEnter="guardar_tabla(results)"/> 		</grp>		<br/>	</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,cuboXml;			var expSql,titulo,mostrarRegs,asterisco;			var accion,tipoOper; //Variables relacionadas con parametros			var regTotales; //variables del llenado de la tabla			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna;			var textIni,sucursal_id,criterioIni;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();								//Constantes				titulo=frn.param(0);				expSql=frn.param(1);				strColValor=trim(frn.param(2)); //Columna con el valor de retorno				strCtrlSet=trim(frn.param(3)); //Control que recibira el valor en la forma que llama esta funcion				//parámetros de columan, campo 				strRenglon=trim(frn.param(4));//renglon de grid parent				strColumna=trim(frn.param(5));//columna de grid parent				strMostrarLlave=trim(frn.param(6));//Inidica (S)i se muestra o (N)o la columna con el valor llave				mostrarRegs=frn.param(7); //Indica si al cargar el formulario se muestran o no los registros				sucursal_id=frn.param(8); //Texto inicial de busqueda				textIni=frn.param(9); //Sucursal				criterioIni=frn.param(10); //Criterio 				asterisco = "*";				ConfiguraUI();				Inicializa();				mostrarRegs="S"; //Habilita consulta de registros			}						fun ConfiguraUI(){				frn.set("inp_titulo",titulo); //EL TITULO DEL REPORTE EN PANTALLA				frn.setAtt("gpo_2","Resultados de búsqueda"); //TITULO DE GRUPO EN PANTALLA								//Etiquetas 				frn.set("inp_mensaje","No se encontraron registros...");				//frn.set("inp_titulo",strTitulo);				frn.set("inp_filtros","Búsqueda");								//Filtro de busqueda				frn.setX("Clave", "k_filtros", 0,0);				frn.setX("Descripcion", "k_filtros", 1,0);						}								fun Inicializa(){				frn.rst("gpo_2");				if (textIni &! ""){					if(criterioIni &! ""){						if(criterioIni &= "Descripcion"){							frn.setPos("k_filtros","val:'Descripcion'");						}else{							frn.setPos("k_filtros","val:'Clave'");						}					}					frn.set("k_busqueda",textIni);				}			}							fun Buscar_Registros(){				var cmd, mensajeError,ok,nReg,xmlRequest,cuboXml;				var tabla,expSelect,expWhere,expOrder;				var colCriterio, criterio;				kdb.rst();				frn.rst("results");				colCriterio=frn.get("k_filtros",-1,0);				criterio=frn.get("k_busqueda");				cmd="select * from keplersc.prod_consulta_lista(";				cmd=cmd & "'" & sucursal_id & "', " ;				cmd=cmd & "'" & criterio& "', " ; 				cmd=cmd & "'" & strFormat("ucase",colCriterio) & "') " ;frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdProd");								rstXml(cuboXml);				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"prodfiltrosel.uscar_Registros()");frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\cuboXml");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						//mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}					frn.set("results",cuboXml);				nReg=nXml(cuboXml);				regTotales = nReg;				if(nReg>0){				  frn.set("inp_mensaje","");									}							}					fun Execute(){				var valorSel, renSel,mensaje;				valorSel = "";				mensaje="Opcion Normal";				renSel = frn.getJ("results");				if(renSel > -1){					valorSel = frn.get("results",renSel,strColValor);				}				if(strRenglon &= "0" )				{					frP.set(strCtrlSet,valorSel);					frP.scriptElm(strCtrlSet,"OnChange");				}				else				{//	valor | ID_elemento | strRenglon (o puede ser -1 actual)| strColumna					frP.setX(valorSel,strCtrlSet,-1,strColumna);														frP.scriptElm(strCtrlSet,"OnChange",strColumna);				}								frn.exit();			}						fun guardar_tabla(tabla){				var save = frn.saveFile("tabla","Todos los archivos,*.*","_C:","Para guardar archivo");				frn.dialog("guarda_tabla",tabla,save); 			}						//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------						fun llenar_cmb(cuboResultados, cmb){				var len_cubo = nXml(cuboResultados);				var pos_ini = frn.N(cmb);				for (var cont=0; cont<len_cubo ; cont++){					var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");					frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);				}				}						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}		}	</script></pag>