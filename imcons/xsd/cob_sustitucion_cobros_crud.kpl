<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<tab/><txt fnt=",22" clr="0,0,0">Sustitucion</txt><br/>	<!-- dim="81,0" --> 	<tab/><hLine dim="-1,0"/> 	<br/> <br/>		<!-- <grp dim="46,9,7,12" -->	<tab/><grp dim="48,11,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros"><txt>  Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>			<br/>			<txt>  Tipo :        </txt>			<cmb id="k_tipon" dim="52,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo()"/>			<br/>			<txt>  Fecha : </txt> <sp n="3"/> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" clrBrdr="255,255,255" available="Y" modify="N"/> 			<sp n="1"/> <tab n="1"/><inp id="statusdoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/>							<br/>									  <txt id="textFolio_cobro">  Folio cobro:  </txt>						<edt id="k_foliodocto" dim="22,1" brdr="2,0" nc="10" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string"  available="Y" visible="Y" OnF9="ObtenerFolioCobro()" OnChange="Formar_folio_cobro()" OnButton="ObtenerFolioCobro()" modify="Y"/> 			<sp n="1"/><img dim="20,20" id="bot_folio_cobro" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="BuscarFolioCobro()" available="Y" clrBrdr="0,0,0" visible="Y"/>			<sp/><inp id="datcfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="3,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="1" modify="Y" available="Y" visible="N"/>						<br/>				</grp>			<grp dim="36,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle Documento">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="Y" fnt=",18b" just="C"/><tab/> <br/>			<txt id="textFolio" visible="N">  Folio :  </txt>					<edt id="k_folio" dim="30,1" brdr="2,0" nc="10" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" visible="N" OnF9="ObtenerFolio()" OnChange="Formar_folio()" OnButton="ObtenerFolio()"/> 			<tab n="2"/><img id="buscar" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="BuscarFolio()" available="N" clrBrdr="0,0,0" visible="N"/>						<br/>			<sp n="1"/>			<inp id="k_docto" dim="37,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="Y" fnt=",16b" just="C"/>						<sp n="3"/>								<br/>					</grp>		<br/>		<tab/>		<grp dim="84,25,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">				<br/> 			<sp n="1"/> <txt clr="0,58,112" hk="P">Cliente: </txt><tab/>			<edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  available="Y" dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16"	OnChange="BuscarCliente()"	type="capital" nc="7"  modify="N" hk="C"/> 			<sp n="5"/> <inp id="c_dias" clr="64,64,64"  dim="4,1" fnt="Arial,16" type="string" nc="4" modify="N" available="N" visible="N"/>			<sp n="1"/> <txt>RFC : </txt> <sp n="5"/>			<inp id="k_rfc" clr="64,64,64"  dim="18,1" fnt="Arial,16" type="string" nc="16" modify="N" available="N"/>						<br/>					<tab/>			<sp n="9"/> <txt>C.P. : </txt> <sp n="1"/>			<inp id="k_cp" clr="64,64,64"  dim="7,1" fnt="Arial,16" type="string" nc="5" modify="N" available="N"/>			<br/>			<sp n="9"/>			<inp id="k_nombrecli" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>			<br/>			<sp n="9"/>			<inp id="k_callecli" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>			<br/>			<sp n="9"/>			<inp id="k_coloniacli" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>			<br/>			<sp n="9"/>			<inp id="k_poblacioncli" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>			<br/>			<grp id="grpconceptosextras" tit="" dim="160,12,7,12" bclr="236,240,243" brdr="0,5" 			clrBrdr="0,58,112" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" fnt=",0"><tab/>				<tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" 				bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="65,7"  hk="z"  Reorder="N" modify="N" available="Y">										<col id="k_factura" name="Factura"  type="string" modify="N"/> 					<col id="k_monto_factura" name="Monto" OnChange="monto()"  nd="2" modify="N" type="number"/>					<col id="k_iva_factura" name="IVA"  type="number" nd="6" min="0" modify="N"/>							</tbl>				<sp n="1"/> <txt clr="0,58,112">N O T A S:</txt>				<sp n="1"/> <inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="30,8" brdr="2,0" fnt="Arial,16" nr="3,60"  type="capital" nc="60" bclr="255,255,255" available="Y" modify="Y"/>										    </grp><br/>		</grp>		<br/>		<tab/>			<grp dim="84,15,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">			<br/>						<grp dim="80,12,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">							<sp n="1"/> <txt>M&#233;todo de Pago: </txt> 				<sp n="2"/> <inp id="k_m_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="18,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16"   modify="N" available="Y" type="string"/>				<sp n="2"/> <inp id="k_vence" clr="64,64,64" clrBrdr="255,255,255"  dim="18,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16"   visible="N" type="string" available="N" modify="N"/>				<br/>				<sp n="1"/> <txt>Forma de Pago: </txt> 				<sp n="3"/>		<cmb id="k_f_pago" dim="18,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="Y"  modify="N"/>						<sp n="10"/> <txt>Antes de IVA : </txt><sp n="1"/> <inp id="subt" clr="64,64,64"  dim="15,1" nd="2" fnt="Arial,16" type="number"  modify="N" available="Y"/>								<br/>				<sp n="1"/> <txt>Cuenta : </txt> 				<sp n="4"/><tab/><sp/><tab/> <inp id="k_cuenta" clr="64,64,64" clrBrdr="255,255,255"  dim="18,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="number" nd="0" min="0" OnChange="Plazo()" modify="N" available="Y"/>				<sp n="10"/><txt>IVA : </txt> <sp n="9"/> 				<inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="6" modify="N" available="Y" OnChange="CalculaTotales(1)"/>				<br/>				<sp n="1"/> <txt>Uso del CFDI : </txt> 				<sp n="2"/><tab/> <inp id="k_cfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="18,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  modify="N" available="Y" type="string"/>				<sp n="10"/> <txt fnt=",16b">Importe : </txt>				<sp n="5"/> <inp id="k_monto" clr="64,64,64"  dim="15,1" fnt=",16b" type="number" nd="2" modify="N" available="Y" clrBrdr="255,255,255"/>				<br/>				<sp n="1"/> <txt>Correo Electr&#243;nico :</txt> <inp id="k_correoelectronico" clr="64,64,64" clrBrdr="255,255,255"  dim="35,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  modify="N" available="Y"/>			</grp>			<tab/>			<grp dim="80,12,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">							<tab n="3"/><br/><br/><tab n="5"/><br/><br/><br/><tab n="5"/>				<img id="Cancelar" dim="35,35" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="borrar_datos()" tooltip="Cancelar / Limpiar" available="Y" clrBrdr="0,0,0" visible="Y"/>				<sp n="3"/>				<img id="Aceptar" dim="35,35" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			</grp>						<br/>						<sp n="1"/> <inp id="k_err" dim="109,1" clr="132,20,7" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="140" fnt="Arial,16" visible = "N"/>					   		</grp>		<br/>		<br/>							</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario,asterisco,anio_contable;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, cliente_id , refer_id, resVal;			var str_uuid, fecha_uuid, rfc_uuid, total_uuid, rfc_receptor_uuid ;					var  saldo, cargos_factura, abonos_factura, cargos_iva_factura, abonos_iva_factura;			var fecha_baja, estatus_doc  ;						var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, uen;                  var row_grid, err_data, err_empty;			// Vart Reports			var cmd, xmlResQuery, strTmp;			var sucursal, fech_oper, tipo_auto, xmlPar;													fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();frn.message("Opcion no disponible","Mensaje","Aceptar");				frn.open("redirect",2);								anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";				suc_usuario = frn.lib("libKepler","UserInfo(1)");								fileSavePath = "C:\Basura";				Inicializa();								ConfiguraControlesOpcion();			}												fun Inicializa(){			var tmpval;				// Our code 				// Revisa y Carga en Variables los Parametros Recibidos en la corrida				if( frn.nParam() == 6 ){ //Se han mandado par?metros a la p?gina                    gen_doc=trim(frn.param(0));                     nat_doc=trim(frn.param(1));                     gpo_doc=trim(frn.param(2));                    tip_doc=trim(frn.param(3));                     tip_ope=trim(frn.param(4));                    uen=trim(frn.param(5));                    tip_ope_original=tip_ope; /*220726*/            } else {               frn.message("Operacion no valida ...", "Mensaje","&Aceptar");               //frn.open("anuncios",4);               frn.open("redirect",2);			      return;            }            				if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					if(tip_ope &= "C"){ //CONSULTA						frn.set("operacion","CONSULTA");					} else {											frn.message("Operacion no valida ...", "Mensaje","&Aceptar");						//frn.open("anuncios",4);						frn.open("index",4);						return;					}				}								//Llenar combo sucursales				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";					}				}				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cob_AltadeCobros_crud.IniCombos()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",cuboQuery);									// Fill Combo Tipo (Con Query FTO Kepler) 				LlenaCmbTipo();									// Fill Combo forma de pago(Con Query de PostgreSQL)				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3fp";				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cob_AltadeCobros_crud.Inicializa()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_f_pago",cuboQuery);													frn.set("k_fecha",sys.date());									tip_doc = frn.get("k_tipon",-1,4); // 221005								// Fill k_docto | referencia docto				ArmarRefDocto();								LimpiaDatosCli();				frn.set("datcfdi","N");		//Pantalla validacion CFDI			}						fun LlenaCmbTipo(){				cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm 								where col_sucursal='" & frn.get("k_sucn",-1,1) & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "'" ;				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cob_AltadeCobros_crud.Inicializa()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboTipoDocto");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error BD","Aceptar");					return;				}				frn.set("k_tipon",getXml(cuboQuery));			}							// Armado del Docto Referencia			fun ArmarRefDocto {				var cadena,tmpFolio, tmpGrupo, tmpTipo;				tmpFolio = frn.get("k_folio");				// //tmpFolio = frn.lib("libGeneral.kpl","PadLeft",tmpFolio,"7","0");				tmpFolio = PadLeft(tmpFolio,"7","0");				tmpGrupo = PadLeft(gpo_doc,"2","0");				tmpTipo = PadLeft(tip_doc,"3","0");				//cadena = trim(gen_doc) & trim(nat_doc) & trim(gpo_doc) & trim(tip_doc) & "-" & tmpFolio;				cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;				frn.set("k_docto", cadena);			}						fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         }                           fun borrar_datos(){				frn.set("k_clave", "");				LimpiaDatosCli();				frn.rst("k_mov");				LimpiaDatosDoc();				LimpiaTotalesDoc();				}											         fun LimpiaDatosCli() {         				frn.set("k_rfc", "");				frn.set("k_cp", "");				frn.set("k_nombrecli", "");				frn.set("k_callecli", "");				frn.set("k_coloniacli", "");				frn.set("k_poblacioncli", "");				frn.set("k_m_pago", "");				frn.set("k_cuenta", "");				frn.set("k_cfdi", "");				frn.set("k_correoelectronico", "");				frn.set("k_coment", "");				frn.set("k_vence", "");							}									fun LimpiaDatosDoc() {				frn.set("k_plazo", "");				frn.set("k_f_pago",descr_combo("k_f_pago",1, "01"));				frn.set("k_coment", "");			}						fun LimpiaTotalesDoc() {				frn.set("subt", "");				frn.set("k_iva", "");				frn.set("k_monto", "");			}									fun ConfiguraControlesOff() {								frn.setAtt("textFolio", "visible", "N");				frn.setAtt("k_folio", "available", "N");				frn.setAtt("k_folio", "visible", "N");				frn.setAtt("buscar", "available", "N");				frn.setAtt("buscar", "visible", "N");				frn.setAtt("k_coment", "available", "N");				frn.setAtt("k_coment", "modify", "N");							frn.setAtt("bot_folio_cobro", "visible", "N");								frn.setAtt("k_foliodocto", "modify", "N");											frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											}						fun ConfiguraControlesOpcion() {							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta									frn.setAtt("k_foliodocto", "modify", "Y");					frn.setAtt("bot_folio_cobro", "visible", "Y");					frn.setAtt("k_coment", "available", "Y");					frn.setAtt("k_coment", "modify", "Y");					frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");													} else {								frn.setAtt("buscar", "available", "Y");					frn.setAtt("buscar", "visible", "Y");												frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");					frn.setAtt("k_coment", "available", "Y");				}			}									fun LimpiaEncabezado {				if(tip_ope &= "A"){ 					frn.set("k_folio", "");					frn.set("k_foliodocto", "");					frn.set("k_docto", "");				}				frn.set("k_fecha", "");				LimpiaDatosCli();				frn.set("k_clave", "");				frn.set("k_err", "");			}									fun CambiaSucursal {							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} 					}								}								LimpiaEncabezado();				borrar_datos();				LlenaCmbTipo();				frn.set("k_fecha",sys.date());									tip_doc = frn.get("k_tipon",-1,4); // 221005								ArmarRefDocto();										} // END -	Fun - CambiaSucursal 									fun CambiaTipo {							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} 					}								}								LimpiaEncabezado();				borrar_datos();								frn.set("k_fecha",sys.date());									tip_doc = frn.get("k_tipon",-1,4); 								ArmarRefDocto();											} // END -	Fun - CambiaTipo 															fun BuscarCliente(){				var xmlCli;												sucursal_id = frn.get("k_sucn",-1,1);				cliente_id = frn.get("k_clave");				LimpiaDatosCli();						if (strlen(frn.get("k_clave")) == 0) {					return;				}								if (strlen(frn.get("k_refer")) > 0) {					refer_id = frn.get("k_refer");				} else {					frn.set("k_fecha_exp", "");				}								cmdQuery = "select c10 as k_rfc, c3 as k_nombrecli, c4 as k_callecli, c5 as k_coloniacli, c6 as k_poblacioncli, c27 as k_cpcli, c16 as k_plazo, c52 as k_m_pago, c53 as k_cfdi, c11 as k_correoelectronico " &									"from keplersc.kdud where c2='" & cliente_id & "'" ;									frn.lib("libGeneral.kpl","FileSave",cmdQuery , fileSavePath & "\cmdQuery");									rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"srvtalltotscrud.BuscarCliente()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.setPos("k_clave");					frn.message("El cliente no existe","Error","Aceptar");					return;					}				rstXml(xmlCli);				xmlCli=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");				frn.setX(xmlCli);									}									//---------------------------------------EJECUTA---------------------------------			fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			var resultado, mensaje, folio;							fecha = sys.date();			hora= sys.time();							if (tip_ope &= "A") {							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok							//Pantalla validacion CFDI				if (frn.get("datcfdi") &= "N"){					frn.dialog("icfdreview",frn.get("k_sucn",-1,1),frn.get("k_clave"),"Alta","cmb",frn.get("k_f_pago",-1,1),frn.get("k_cuenta"),frn.get("k_m_pago"), "inp", frn.get("k_cfdi"));					return;				}					continua = frn.message(" Desea continuar con la alta?","Atencion",2);				if (continua == 0){ 					frn.set("datcfdi","N");	//Pantalla validacion CFDI					return;				}													xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;											setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov") -1);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);				//PARAMETRO NECESARIO PARA FUNCION cxcp_alta_conmov()				setXml(xmlPantalla,"k_tabla_mov","kdm5");				//SUSTITUCION				setXml(xmlPantalla,"k_natdocto","A");				setXml(xmlPantalla,"k_gpodocto",29);				setXml(xmlPantalla,"k_tipodocto",frn.get("k_tipon",-1,4));										frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaSustitucion");				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cuboQuery);				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cob_sustitucion_cobros_crud.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCobros");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					tip_ope = "C";					frn.set("k_folio", mensaje); 					frn.set("operacion", "CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto", strTmp);					strMsg = "El Folio utilizado para esta operacion fue : " & mensaje;					ConfiguraControlesOpcion(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");					//MostrarDatos(folio);						//BuscarFolio();				} else {					frn.message(mensaje, "Error", "Aceptar");					frn.set("datcfdi","N");	//Pantalla validacion CFDI				}			 						}						}		//--------------------------------------------------------------CONSULTA FOLIO SUSTITUCION--------------------------------				fun BuscarFolio() {			var folio;			folio = frn.get("k_folio");			//folio = PadLeft(folio, 7, "0");			ArmarRefDocto();			borrar_datos();			MostrarDatos(folio);								}							fun ObtenerFolio() {			sucursal_id = frn.get("k_sucn",-1,1);			cmdQuery = "select c6 as folio, to_char(c9, 'DD/MM/YYYY') as fecha, c10 as cve_cliente, " &						" c16 as monto, c43 estatus ,c39 as folio_sustituido " &						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4 =" &gpo_doc& " and c5= " & tip_doc						& " order by c9 desc, c6 desc ";									frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryfoliomov");							frn.dialog("genlistafiltrosel","Folios de Documentos",cmdQuery,"folio","k_folio","0","","S");					}						fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);		}											fun MostrarDatos(nFolio) {					var xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError,   ;						sucursal_id = frn.get("k_sucn",-1,1);						cmd= " select c10 as k_clave, c24 as k_coment,c39 as k_foliodocto,  c43 as estatus_doc , c197 as fecha_baja " ;				cmd=	cmd & " , c160 as k_f_pago, c161 as k_cuenta, c162 as k_m_pago, c164 as k_cfdi, c165 as k_correoelectronico ";			cmd = cmd & " from keplersc.kdm1 where c1='" & sucursal_id  & "' and c2='" & gen_doc  &"' and c3='" & nat_doc & "' and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdQueryMostrarDatos");						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_AltadeCobros_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultadosMostrarDatos");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			var xml_kdm1  = getXml(cuboResultados,"r0" );						frn.set("k_foliodocto",getXmlAtt(xml_kdm1   ,"k_foliodocto") );			frn.set("k_clave",getXmlAtt(xml_kdm1  ,"k_clave") );			BuscarCliente();			frn.set("k_coment",getXmlAtt(xml_kdm1   ,"k_coment") );						var f_pago = getXmlAtt(xml_kdm1   ,"k_f_pago");			frn.set("k_f_pago",descr_combo("k_f_pago",1, f_pago ));						frn.set("k_cuenta",getXmlAtt(xml_kdm1   ,"k_cuenta") );			frn.set("k_m_pago",getXmlAtt(xml_kdm1   ,"k_m_pago") );			frn.set("k_cfdi",getXmlAtt(xml_kdm1   ,"k_cfdi") );			frn.set("k_correoelectronico",getXmlAtt(xml_kdm1   ,"k_correoelectronico") );			fecha_baja = getXmlAtt(xml_kdm1  ,"fecha_baja");			estatus_doc = getXmlAtt(xml_kdm1  ,"estatus_doc");							if (estatus_doc &= "C"){	// C=Cancelado				frn.message("El Documento se encuentra cancelado","Error","Aceptar");				frn.set("statusdoc", "CANCELADO");			}else{				frn.set("statusdoc", "");			}			rstXml(cmd);							cmd = "select c14 as k_factura from keplersc.kdm5 where c1='" & sucursal_id & "' and c2='" & gen_doc &"' and c3='" & nat_doc & "'";			cmd = cmd & " and c4='" & gpo_doc & "' and c5='" & tip_doc & "' and c6='" & nFolio & "'";						frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboquerykdm5");			cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_AltadeCobros_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}									var ctd_mov = nXml(cuboResultados);						for (var i=0,n=ctd_mov ;i<n;i++) {							frn.setX(getXmlAtt(cuboResultados, "r0","k_factura" ) ,"k_mov", i, "k_factura");				frn.setX(0.01 ,"k_mov", i, "k_monto_factura");				frn.setX(0.01 ,"k_mov", i, "k_iva_factura");					} 			CalcTotal();																} //End MostrarDatos()										//----------------------------------------CONSULTA FOLIO COBRO---------------------------------				fun BuscarFolioCobro() {			var folio;			folio = frn.get("k_foliodocto");			borrar_datos();			MostrarDatosCobro(folio);								}					fun ObtenerFolioCobro() {					borrar_datos();			sucursal_id = frn.get("k_sucn",-1,1);			cmdQuery = "select c6 as folio, to_char(c9, 'DD/MM/YYYY') as fecha, c10 as cve_cliente, " &						" c16 as monto, c43 estatus " &						"from keplersc.kdm1 " &						"where c1='" &sucursal_id& "' and c2='" &gen_doc& "' and c3='" &nat_doc& "' and c4=29 and c5= " & tip_doc						& " order by c9 desc, c6 desc ";									frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryfoliomov");							frn.dialog("genlistafiltrosel","Folios de Cobros",cmdQuery,"folio","k_foliodocto","0","","S");					}						fun Formar_folio_cobro(){						 borrar_datos();					var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","folio_id",frn.get("k_foliodocto"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",29);				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comopecompras.Formar_folio_cobro()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_foliodocto", fol);		} 								fun MostrarDatosCobro(nFolio) {					var xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError,   ;						sucursal_id = frn.get("k_sucn",-1,1);			//MSS 27/09/2024 Obtener fecha vencimiento para que se grabe en el movimiento			cmd= " select c10 as k_clave, c18 as k_vence, c24 as k_coment, c43 as estatus_doc , c197 as fecha_baja " ;				cmd=	cmd & " , c160 as k_f_pago, c161 as k_cuenta, c162 as k_m_pago, c164 as k_cfdi, c165 as k_correoelectronico ";			cmd = cmd & " from keplersc.kdm1 where c1='" & sucursal_id  & "' and c2='" & gen_doc  &"' and c3='" & nat_doc & "' and c4=29 and c5='" & tip_doc & "' and c6='" & nFolio & "'";				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdQuery");						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_AltadeCobros_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			var xml_kdm1  = getXml(cuboResultados,"r0" );			frn.set("k_clave",getXmlAtt(xml_kdm1  ,"k_clave") );			BuscarCliente();			frn.set("k_coment",getXmlAtt(xml_kdm1   ,"k_coment") );						var f_pago = getXmlAtt(xml_kdm1   ,"k_f_pago");			frn.set("k_f_pago",descr_combo("k_f_pago",1, f_pago ));						frn.set("k_cuenta",getXmlAtt(xml_kdm1   ,"k_cuenta") );			frn.set("k_m_pago",getXmlAtt(xml_kdm1   ,"k_m_pago") );			frn.set("k_cfdi",getXmlAtt(xml_kdm1   ,"k_cfdi") );			frn.set("k_correoelectronico",getXmlAtt(xml_kdm1   ,"k_correoelectronico") );			frn.set("k_vence",getXmlAtt(xml_kdm1,"k_vence") );	//MSS 27/09/2024			fecha_baja = getXmlAtt(xml_kdm1  ,"fecha_baja");			estatus_doc = getXmlAtt(xml_kdm1  ,"estatus_doc");							if (estatus_doc &= "C"){	// C=Cancelado				frn.message("El Documento se encuentra cancelado","Error","Aceptar");				frn.set("statusdoc", "CANCELADO");			}else{				frn.set("statusdoc", "");			}			rstXml(cmd);							cmd = "select c14 as k_factura from keplersc.kdm5 where c1='" & sucursal_id & "' and c2='" & gen_doc &"' and c3='" & nat_doc & "'";			cmd = cmd & " and c4=29 and c5='" & tip_doc & "' and c6='" & nFolio & "'";						frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cuboquerykdm5");			cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_AltadeCobros_crud.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}									var ctd_mov = nXml(cuboResultados);						for (var i=0,n=ctd_mov ;i<n;i++) {							frn.setX(getXmlAtt(cuboResultados, "r" & i ,"k_factura" ) ,"k_mov", i, "k_factura");				frn.setX(0.01 ,"k_mov", i, "k_monto_factura");				frn.setX(0.01 ,"k_mov", i, "k_iva_factura");					} 			CalcTotal();																} //End MostrarDatos()						//-----------------------------------------------------------TOTALES-------------------------------------------				fun CalcTotal() { 					var monto_facturas =0, iva_facturas=0; 							for (var i=0,n=frn.N("k_mov")-1;i<n;i++) { 				monto_facturas=monto_facturas +frn.get("k_mov",i,"k_monto_factura");				iva_facturas=iva_facturas+frn.get("k_mov",i,"k_iva_factura");			}						frn.set("subt", monto_facturas - iva_facturas, "k_iva" ,iva_facturas, "k_monto", monto_facturas);				}				//--------------------------------------------------------------EXTRAS---------------------------------------------------							fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    				1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 				2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 				3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				// var tip_ope; 				var tip_oper;				if(iModo==0)					page=pag; 				else if(iModo==2&&(strlen(par0)>0)){					//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     			}													} // End of class Main			</script></pag>