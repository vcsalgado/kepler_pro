<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">
	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>

<tab/><inp id="k_titulo" dim="65,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"
				type="string" modify="N" available="N" fnt="Arial,22"/>
	<br/>
	<br/>
		<tab/><hLine clr="0,0,0"/>
		<br/><br/>
		<tab/>
		<grp id="grupo_crud" dim="80,20,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 
			brdr="0,5" fntBrdr="Arial,18" available="Y" tit="Nuevo"><tab/>
			<br/><tab n="3"/><txt>Sucursal:</txt><tab n="2"/>
			<cmb id="k_sucn" dim="50,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" Null="N" available="Y"/><br/><tab n="3"/><txt>Esquema:</txt><tab/>
			<cmb id="k_esquema" dim="50,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="Y"/>
			<br/><sp/><tab n="3"/><txt>Operaci&#243;n: </txt><tab/>
			<cmb id="k_oper" dim="50,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="Y" modify="Y"/>
			<br/><sp/><tab n="2"/><txt>Tipo Veh&#237;culo:</txt><tab/>
			<cmb id="k_tipove" dim="50,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="Y"/>
			<br/><tab n="3"/><txt> Comisi&#243;n:</txt><tab/>
			<cmb id="k_tipo_comis" dim="50,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="Y"/><tab/><br/><sp/><tab/>
			<br/>
            <tab n="11"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/><br/>
			<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>
		</grp><br/><br/>
	</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,kdb,frP, accion,sucursal,esquema, operacion,tipove,tipocomis,externo,resVal,straccion;
            var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError, rol_usuario, suc_usuario  ,asterisco ;
			fun Main() {			
				frn=new FRNT;
				frP=new FRNTP;
				kdb=new KDB;
				kdb.connect();
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				rol_usuario = frn.config("user","role");
				asterisco = "*";
				accion = frn.param(0);
				sucursal = frn.param(1);
				esquema= frn.param(2);
				operacion=frn.param(3);
				tipove=frn.param(4);
				tipocomis=frn.param(5);
				externo=frn.param(6);
//frn.message(esquema,"Esquema","Aceptar");				
				
				frn.set("k_titulo","Esquemas de comisiones de vehiculos");	
				llena_combos();
				ctlrs_config();
			}
			
			fun ctlrs_config(){
//frn.message(accion,"Mensaje","Aceptar");			
				//Deshabilitar controles
				frn.setAtt("btn_aceptar", "available", "N" );
				frn.setAtt("btn_aceptar", "visible", "N" );
				frn.setAtt("k_sucn", "available", "N" );
				frn.setAtt("k_esquema", "available", "N" );
				frn.setAtt("k_oper", "available", "N" );
				frn.setAtt("k_tipove", "available", "N" );
				frn.setAtt("k_tipo_comis", "available", "N" );
			
				frn.set("input_crud", accion);
				frn.rst("grupo_crud");

				if (accion &= "NUEVO"){
                    straccion = "Nuevo" ;   
                }else if (accion &= "CONSULTAR"){
                    straccion = "Consultar";
                }else if (accion &= "MODIFICAR"){
                    straccion = "Modificar";
                }else if (accion &= "ELIMINAR"){
                    straccion = "Eliminar";
            }     
				frn.setAtt("grupo_crud", "tit", straccion );

				if (accion &= "NUEVO"){
					frn.setAtt("btn_aceptar", "available", "Y" );
					frn.setAtt("btn_aceptar", "visible", "Y" );
					frn.setAtt("k_sucn", "available", "Y" );
					frn.setAtt("k_esquema", "available", "Y" );
					frn.setAtt("k_oper", "available", "Y" );
					frn.setAtt("k_tipove", "available", "Y" );
					frn.setAtt("k_tipo_comis", "available", "Y" );
				}
				if (accion &= "MODIFICAR"){					
					frn.setAtt("btn_aceptar", "available", "Y" );
					frn.setAtt("btn_aceptar", "visible", "Y" );
					frn.setAtt("k_tipo_comis", "available", "Y" );
				}
				if (accion &= "ELIMINAR"){
					frn.setAtt("btn_aceptar", "available", "Y" );
					frn.setAtt("btn_aceptar", "visible", "Y" );
				}				
				if (accion &! "CONSULTAR"){
					frn.setAtt("btn_aceptar", "available", "Y" );
					frn.setAtt("btn_aceptar", "visible", "Y" );
				}
			
			}


			fun llena_combos(){
			
        
				//Llenar combo sucursales
				var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";
				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){
					cmd = cmd & " where c1='" & suc_usuario & "'";
				}else {
					if (suc_usuario &! asterisco && suc_usuario &! "" ){
						cmd = cmd & " where c1='" & suc_usuario & "'";
					}
				}
				
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");		
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
					
				frn.set("k_sucn",getXml(cubo));
			
								
				// Combo esquema
            cmdQuery = "select c1||'--'||c2 as c2, c1  from keplersc.kdvesq";
            rstXml(cubo);
            cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_comis_ven_esqveh_crud.llena_combos()");
            ok=getXmlAtt(cubo,"ok");
            if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
               mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
               frn.message(mensajeError,"Error","Aceptar");
               return;
				}
            frn.set("k_esquema",cubo);

				//Tipo operacion
            cmdQuery = "select c1||'--'||c2 as c2, c1  from keplersc.kdtop";
            rstXml(cubo);
            cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_comis_ven_esqveh_crud.llena_combos()");
            ok=getXmlAtt(cubo,"ok");
            if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
               mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
               frn.message(mensajeError,"Error","Aceptar");
               return;
				}
            frn.set("k_oper",cubo);
				
				//Tipo vehiculo
				frn.setX("N--Nuevo","k_tipove",0,0);
				frn.setX("N","k_tipove",0,1);
				frn.setX("U--Usado","k_tipove",1,0);
				frn.setX("U","k_tipove",1,1);
				frn.setX("D--Demo","k_tipove",2,0);
				frn.setX("D","k_tipove",2,1);
				
				//Tipo comision
            cmdQuery = "select c1||'--'||c2 as c2, c1  from keplersc.kdtipocomis";
            rstXml(cubo);
            cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_comis_ven_esqveh_crud.llena_combos()");
            ok=getXmlAtt(cubo,"ok");
            if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
               mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
               frn.message(mensajeError,"Error","Aceptar");
               return;
				}
				

            frn.set("k_tipo_comis",cubo);

				//Inicia combos dependiendo del tipo de operacion
				if (accion &! "NUEVO"){
				
					ubica_clave_combo("k_sucn",sucursal);
					ubica_clave_combo("k_esquema",esquema);
					ubica_clave_combo("k_oper",operacion);
					ubica_clave_combo("k_tipove",tipove);
					ubica_clave_combo("k_tipo_comis",tipocomis);
				}
		   }
				
			fun ubica_clave_combo(combo,valor){
				var cont,ren;
//frn.message(combo & "-" &valor,"Mensaje","Aceptar");
				for(cont=0; cont<frn.N(combo); cont++){
					if(frn.get(combo,cont,1) &= valor){
						ren="ren:" & cont;
						frn.setPos(combo,"ren:"&cont);
						break;
					}
				}								
			} 
			
			
			fun ValidarDatos(){
				var total;
				sucursal=frn.get("k_sucn",-1,1);
				esquema=frn.get("k_esquema",-1,1);
				operacion=frn.get("k_oper",-1,1);
				tipove=frn.get("k_tipove",-1,1);
				tipocomis=frn.get("k_tipo_comis",-1,1);
				
				if (accion &= "NUEVO"){
					cmdQuery="select count(*) as total from keplersc.kdvesqveh where c1='" & sucursal & "' and c2='" & esquema & 
						"' and c3='" & operacion & "' and c4='" & tipove& "' ";  // &"and c5='" & tipocomis & "'"; 
					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_comis_ven_esqveh_crud.ValidarDatos()");
//					frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");
				
					ok=getXmlAtt(cuboResultados,"ok");
					if(ok &! "" && !ok){
						mensajeError = getXmlAtt(cuboResultados,"native3");
						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
						frn.message(mensajeError,"Error","Aceptar");
						return 0;
					}
					total=getXmlAtt(cuboResultados,"r0","total");
					if (total&= "1"){
						mensajeError = "El esquema ya existe.";
						frn.message(mensajeError,"Error","Aceptar");
						return 0;						
					}
				}
				return 1;
			}

			fun Execute() {
				resVal=ValidarDatos();
					
				if(resVal == 0){
					return;
				}
				
				var resultado_confirmacion = frn.message("Desea continuar?","Mensaje de Confirmacion", 2);
				if (resultado_confirmacion &! 1)  {
					return;
				}
				
				xmlRequest = getXml(frn.dataPag());	
				setXml(xmlRequest,"input_crud",accion);
				frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");
		
		
				cmdQuery="SELECT * FROM keplersc.cat_comis_ven_esqveh_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";
				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_exteriores_crud.Execute()");	
//				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");					
				var resultado=getXml(cubo ,"resultado");
			
				if(resultado &= "0"){
					mensajeError = getXml(cubo ,"mensaje");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				frP.script("Inicia_Forma()");
				if (accion &= "NUEVO" || accion &= "MODIFICAR") {	
					var sms =  "";
					if (accion &= "NUEVO"){
						sms = "Registro guardado";
					}else {
						sms = "Registro modificado";
					}
					//frn.setAtt("btn_aceptar", "available", "N" );
					frn.message(sms ,"Mensaje","Aceptar");	
					frn.exit();	
				}
				if (accion &= "ELIMINAR"){
					frn.message("Registro eliminado","Mensaje","Aceptar");
					frn.exit();			
				}

			}		
					
		fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 
			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    
			1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 
			2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 
			3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 
			*/
			var prefix=frn.lib("libKepler","langPrefix");
			var page=prefix&pag;
			var b_valido=1;
			// var tip_ope; 
			var tip_oper;
			if(iModo==0)
				page=pag; 
			else if(iModo==2&&(strlen(par0)>0)){
				//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       
				if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;
				if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 
				if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;
			}
			else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;
				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     
		}	

		}
	</script>
</pag>