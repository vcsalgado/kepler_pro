<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte Lista Inventario ">	<grp dim="1,-1,10,10" brdr="2,1" bclr="192,205,213" clr="0,58,112" fnt="Arial,16" unfont="0"		OnF1="Ventana(rep_Hlp)"><br/>			<tab/><txt fnt=",22" clr="0,0,0">Reporte  Lista inventario</txt><tab/>	<br/><tab/><hLine clr="0,0,0"/>	<br/>	<br/>	<tab/>		<grp dim="50,30,15,3" bclr="236,240,243" tit="Reporte Lista inventario" brdr="0,5" clrBrdr="0,58,112"  fntBrdr="Arial,18" hSpace="4">			<sp n="1"/><txt>Sucursal:</txt><sp n="2"/>			<cmb id="cmb_sucursal" dim="25,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 			      Null="N" modify="Y" available="Y"/><tab/><br/><br/>						<tab n="4"/><bot id="bot_ejecutar" dim="7,0" brdr="5,0" text="Ejecutar" OnEnter="Ejecuta()" default="1"/><br/>		</grp>			</grp>	<tools>		<tool name="ejecuta" OnMouseL="Ejecuta()" tooltip="Ejecutar(Ctrl+T)" scut="Ctrl+T" img="_TL_execute.png"/>	</tools>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys;			var suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco;						fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;				kdb.connect();				kdb.open("i,kdini");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";				Inicializa();			}							fun Inicializa(){//Inicializa los valores en Pantalla				frn.set("fecIni",fnDate(sys.date("year"),sys.date("month"),1));				frn.set("fecFin",fnDate(sys.date("year"),sys.date("month"),31));				//... (Llena Combos, e inputs en pantalla)				IniParams();//Inicializa par�mtros de impresi�n entre otros				IniCombos();			}									fun IniCombos(){				var cmd, cubo , ok, mensajeError;								//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("cmb_sucursal",getXml(cubo));																}						fun IniParams(){//Inicializa par�metros de impresi�n. Pueden ser cambiados por el usuario final mediante men�: Archivo -> Configurar P�gina				frn.set("param_paper","letter");	//Tama�o de papel predefinido:	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tama�o de papel personalizado	"size=21.59,27.94cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//M�rgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0");	//Escala de impresi�n (1=100 por ciento)	"F=1,1"				frn.set("param_landscape","N");	//Orientaci�n	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"				frn.set("param_emp","L");	//Posici�n de "Raz�n social"(izq,der,cen)	@emp=L|R|C"			}						fun Ejecuta(){//Prepara datos del reporte 				//...(cubos de datos e informaci�n necesaria)				var sucursal, fecha, cubo, ok, cmd, mensajeError ;/*				sucursal= frn.get("cmb_sucursal", -1, 1);				fecha= frn.get("k_fecha", -1, 0);				cmd = "SELECT j.c2 AS clave,'No de reemplazo' AS reemplazo,h.c2 AS descripcion,' ' AS existencia,' ' AS costo_promedio ";				cmd = cmd & "FROM keplersc.kdinl j INNER JOIN keplersc.kdini h ON h.c1 = j.c2 ";				cmd = cmd & "WHERE j.c1 = '" & sucursal & "' ORDER BY j.c2";												cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"vcssprod.Ejecuta()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboPrueba");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}*/				Reporte();			}						fun Reporte(){//Ejecuta el Reporte				// Se define el formato a usar y se liga a la variable del reporte "rep"				var diferencia;				var cubo, ok, cmd, mensajeError ;				var compania, usuario, strValor, fechaImpresion, horaImpresion;				var k_clave, k_reemplazo, k_desc, k_existencia, k_costo_prom;				kdb.readPage("datFto","list_inv_fto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				kdb.kde("KDE");//Configuraci�n del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();				k_clave = "6 VDE";				k_reemplazo = "S  0000124959";				k_desc = "HILUX / ROJA / 2016";				k_existencia = "K87AKX";				k_costo_prom = "206,555.00";								rep.rst();				setRepPage();//Establece los par�metros finales de impresi�n(rep.page(...);), pues pueden haber cambiado por el usuario 				//Da valor a los inputs del reporte(rep.set();), e indica la ejecuci�n de "grupos de renglones de impresi�n" (rep.exe();)				rep.set("fecha",sys.date());rep.set("hora",sys.time());							rep.set("k_empresa",compania);				rep.set("k_sucursal",frn.get("cmb_sucursal",-1,0)); 				rep.set("k_fecha",frn.get("k_fecha"));				rep.set("k_fecha_imp",fechaImpresion);				rep.set("K_hora_imp",horaImpresion);				rep.exe("encabezado");								//Esto es un ejemplo:				var acum=0,val=0;				var sucursal= frn.get("cmb_sucursal", -1, 1);				var fecha= frn.get("k_fecha", -1, 0);				cmd = "SELECT j.c2 AS clave,'No de reemplazo' AS reemplazo,h.c2 AS descripcion,' ' AS existencia,' ' AS costo_promedio ";				cmd = cmd & "FROM keplersc.kdinl j INNER JOIN keplersc.kdini h ON h.c1 = j.c2 ";				cmd = cmd & "WHERE j.c1 = '" & sucursal & "' ORDER BY j.c2";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"list_inv.Ejecuta()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboPrueba");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				for(var ren=0;ren<nXml(cubo);ren++){					var clave = getXmlAtt(cubo,"r"&ren,"clave");					var reemplazo= getXmlAtt(cubo,"r"&ren,"reemplazo");					var descripcion= getXmlAtt(cubo,"r"&ren,"descripcion");					var existencia= "____________________";					var costo_promedio= "____________________";					rep.set("clave",clave);					rep.set("reemplazo", reemplazo);					rep.set("descripcion", descripcion);					rep.set("diferencia", diferencia);					rep.set("existencia", existencia);					rep.exe("detalle");					rep.exe("salto");					val = ren + 1 ; 				}					acum = val;				rep.set("input3",acum);				rep.exe("linea");				rep.exe("hola");				rep.exe("total");								//Modos de impresi�n 				rep.win(); //Muestra la vista previa de la impresi�n. A partir de la vista previa (Preprint) se decide si se imprime o no.				//rep.print("\\192.168.1.100\HPLaserJet"); //Env�a el reporte directamente a una impresora, sin mostrar la vista previa.				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresi�n. No muestra la vista previa.				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardar� el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html			}						fun setRepPage() {//Establece los par�metros finales de impresi�n.				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}			fun CombinaCombo(combo,colClave,colDesc,posFinal){//Combina el contenido de 2 columnas de un combo y lo pone en la columna visble. Ej: para mostrar "Clave - Descripci�n". 				//NOTA: Por default posiciona el combo con el primer elemento. Se puede pasar como parametro "posicionaFinal" un 1 para que se posicione en el ultimo registro				var clavecombinada="";				for(var i=0,n=frn.N(combo);i<n;i++){					clavecombinada=frn.get(combo,i,colClave) & " - " & frn.get(combo,i,colDesc);					frn.setX(clavecombinada,combo, i, 0);				}				if(posFinal==1&&frn.N(combo)>0) frn.setPos(combo,frn.N(combo)-1,0,"internal:Y");//Lo posiciona en el �ltimo renglon				else frn.setPos(combo,0,0,"internal:Y"); 			}						fun Ventana(arch,cmp0,cmp1,cmp2,cmp3,cmp4,cmp5,cmp6,cmp7,cmp8,cmp9){ //Abre pagina indicada como dialogo SOLO si el campo cmp0 se puede modificar(El cmp0 puede ser una tabla, y cmp1 la columna)				var b_valido=1;				if(strlen(cmp0)>0){//Se toma el cmp0 como el objeto (o grid) al que se devolver� el resultado.					if( frn.getAtt(cmp0,"modify",cmp1) &= "N" ) b_valido=0;					if( frn.getAtt(cmp0,"available",cmp1) &= "N" ) b_valido=0;					if( frn.getAtt(cmp0,"visible",cmp1) &= "N" ) b_valido=0;				}				if(b_valido==1)frn.dialog(arch,cmp0,cmp1,cmp2,cmp3,cmp4,cmp5,cmp6,cmp7,cmp8,cmp9);			}		}	</script></pag>