<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de Lista de inventario" scale="48">	<grp dim="1,-1,10,10" brdr="0,1" bclr="255,255,255" clr="0,0,0" fnt="Arial,16" unfont="0">		<br exe="encabezado"/>		<hLine dim="90,0" g="2" type="1"/>		<br exe="encabezado"/>		<grp dim="10,7,7,12">			<br/><img id="img" dim="12,50" brdr="0,1" img="logocliente.jpg"/>		</grp>		<tab n="1"/>		<grp dim="62,7,7,12" brdr="0,0">			<br/>			<inp id="k_empresa" fnt=",20b" dim="80,1" clr="0,58,112" type="string" available = "N"/>			<br/>			<inp id="k_sucursal" fnt=",16b" dim="40,1" clr="0,58,112" type="string" available = "N"/>			<br/>			<txt fnt=",16b" clr="0,58,112">Reporte de Lista de inventario</txt>			<br/>			</grp>		<tab n="1"/>		<grp dim="20,5,7,12">			<br/>			<txt>P&#225;g:</txt><tab/><inp id="k_pag" dim="4,1" type="number" just="L" mcr="k_pag"/>			<br/>			<txt>Fecha:</txt><tab/><inp id="k_fecha_imp" dim="10,1" type="date" just="L" fmt="DD-MM-CCYY"/>			<br/>			<txt>Hora:</txt><sp/><tab n="1"/><inp id="K_hora_imp" dim="5,1" type="time" just="L"/>		</grp>		<br exe="encabezado"/>		<hLine dim="90,0" g="1" type="1"/>		<br exe="encabezado"/>		<hLine dim="90,0" g="1" type="1"/>		<br exe="encabezado"/>		<txt fnt=",-1b">CLAVE</txt>		<tab n="3"/><txt fnt=",-1b">REEMPLAZO</txt>		<tab n="2"/><txt fnt=",-1b">DESCRIPCION</txt>		<tab n="7"/><txt fnt=",-1b">EXISTENCIA</txt>		<tab n="4"/><txt fnt=",-1b">COSTO PROM</txt>		<br exe="encabezado"/>		<hLine dim="90,0" g="1" type="1"/>		<br exe="encabezado"/>		<hLine dim="90,0" g="1" type="1"/>		<br exe="encabezado"/>				<inp id="clave" dim="10,1" type="string"/>		<tab/><inp id="reemplazo" dim="10,1" type="string"/>		<tab/>		<inp id="descripcion" dim="25,1" type="string"/>		<txt fnt=",16b" clr="0,58,112">_______________________</txt>		<tab/>		<txt fnt=",16b" clr="0,58,112">_______________________</txt>		<br exe="detalle"/>				<br exe="salto"/>				<br exe="total"/>		<tab n="5"/><txt fnt=",-1bi">Total:</txt><tab/><inp id="input3" dim="10,1" type="number" brdr="0,0" fnt=",0b"/>		<br exe="total"/>	</grp></pag>