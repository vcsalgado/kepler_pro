<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">
	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>
		<grp id="grupo_crud" dim="80,20,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18"><tab/>
			<br/><br/><tab/>
            <txt>Año :</txt><sp/>
			<inp id="k_anio" dim="8,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="2" available="N" tooltip="Año"/><br/><sp/><tab/>
			<txt>Mes :</txt><tab/>
			<inp id="k_mes" dim="8,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="2" available="N" tooltip="Mes"/><br/><sp/><tab/>
			<txt>SSI Planta Servicio :</txt><tab/>
			<inp id="k_csi_servicio" dim="15,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nd="5" clrBrdr="255,255,255" tooltip="SSI Planta Servicio"/><br/><sp/><tab/>
			<txt>CSI Planta Ventas :</txt><tab/>
			<inp id="k_csi_ventas" dim="15,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nd="5" clrBrdr="255,255,255" tooltip="CSI Planta Ventas"/><br/><sp/><tab/>
			<br/>
            <tab n="11"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="0" visible="Y" available="Y"/><br/>
			<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>
		
		
			
		</grp><br/><br/>
	</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,kdb,frP, accion,externo, clave_sel,sucursal_id,mes,s_csi,v_csi;
            var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError;
			fun Main() {
				frn=new FRNT;
				frP=new FRNTP;
				kdb=new KDB;
				kdb.connect();
			
				ctlrs_off();
				insertar_datos();	
			}
			
			fun ctlrs_off(){
			
				accion = frn.param(0);
				frn.set("input_crud", accion);
				frn.rst("grupo_crud");
				externo	= frn.param(2);
				frn.setAtt("grupo_crud", "tit", accion );
				clave_sel = frn.param(1);
                sucursal_id = frn.param(3);
                mes = frn.param(4);
                s_csi = frn.param(5);
                v_csi = frn.param(6);
				frn.setAtt("btn_aceptar", "available", "N" );
				frn.setAtt("btn_aceptar", "visible", "N" );
				if (accion &= "Nuevo"){
					frn.setAtt("k_anio", "available", "Y" );
                    frn.setAtt("k_mes", "available", "Y" );
				}else{
					frn.set("k_anio", clave_sel);
                    frn.set("k_mes", mes);
                    frn.set("k_csi_servicio", s_csi);
                     frn.set("k_csi_ventas", v_csi);
				}

				
				if (accion &! "Consultar"){
					frn.setAtt("btn_aceptar", "available", "Y" );
					frn.setAtt("btn_aceptar", "visible", "Y" );
				}
			
			}
				
			fun insertar_datos(){	
				if (accion &= "Modificar"){
					//llamada externa(padre)
					if (externo &= "s"){
						if (clave_sel &= ""){
							frn.message("selecciona una clave con F9 para modificar","Error","Aceptar");
							frn.setAtt("btn_aceptar", "visible", "N" );
							return;
						}
					}
				}
				if (accion &! "Nuevo") {
                    if (accion &= "Modificar") {
                        frn.setAtt("grupo_crud", "available","Y");
                    }else{
                        frn.setAtt("k_anio", "available","N");
                        frn.setAtt("k_mes", "available","N");
                        frn.setAtt("k_csi_servicio", "available","N");
                        frn.setAtt("k_csi_ventas", "available","N");
                        frn.setAtt("btn_aceptar", "available", "Y" );
                    }
                }else{
                    frn.setAtt("grupo_crud", "available","Y");
                    frn.setPos("k_anio");    
				}
			}
		
			fun Execute() {
				var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);
				if (resultado_confirmacion &! 1)  {
					return;
				}
		
				xmlRequest = getXml(frn.dataPag());	
                setXml(xmlRequest,"k_sucn",sucursal_id);	
				frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");
		
				cmdQuery="SELECT * FROM keplersc.com_datos_csi_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";
				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_coaches_crud.Execute()");	
				frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");					
				var resultado=getXml(cubo ,"resultado");
				
				if(resultado &= "0"){
					mensajeError = getXml(cubo ,"mensaje");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				frP.scriptElm("bot","OnEnter");	
				if (accion &= "Nuevo" || accion &= "Modificar") {	
					var sms =  "";
					if (accion &= "Nuevo"){
						sms = "Registro guardado";
					}else {
						sms = "Registro modificado";
					}
					frn.message(sms ,"Mensaje","Aceptar");
					frn.exit();	
				}
				if (accion &= "Eliminar"){
					frn.message("Registro eliminado","Mensaje","Aceptar");
					frn.exit();			
				}
			}		
			
		}
	</script>
</pag>