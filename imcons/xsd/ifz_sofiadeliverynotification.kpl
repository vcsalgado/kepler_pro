<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Delivery Notification"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0">	<br/>	<tab/><inp id="inp_titulo" dim="80,1" clr="0,0,0" clrBrdr="255,255,255" type="string" modify="N" available="N" fnt=",22"/>	<br/><tab/><hLine clr="0,0,0"/>	<br/><br/>	<tab/>	<grp dim="80,39,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">        <tab n="1"/><txt clr="0,58,112" hk="S">Sucursal:</txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><sp/><br/>				<br/><tab/>      <txt clr="132,20,7">Codigo BAC del distribuidor :</txt><tab n="2"/>		<inp id="delnot_dealerbac" dim="12,1"  type="number" nc="9" fmt="5" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="Y" available="N" modify="Y" tooltip="Codigo BAC del distribuidor"/><sp/>		<br/><tab/>		<txt clr="132,20,7">Identificador del documento : </txt><tab n="2"/>				<inp id="delnot_identificadordocumento" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="capital" nc="10" fmt="5" fnt="Arial,0" OnF9="ObtenerFolio()" OnChange="Formar_folio()" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Identificador del documento ( F9 b&#250;squeda )"/>		<tab/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y" tooltip="Buscar"/>		<br/><br/><tab/>		<txt clr="0,58,112" fnt=",b">Datos de la persona que recibe el vehiculo</txt>				<br/><tab/>		<txt clr="132,20,7">Nombre : </txt><tab/><sp n="2"/>				<inp id="delnot_nombreclienterecibe" dim="40,1" type="capital" nc="30" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" modify="Y" available="Y" visible="Y" tooltip="Nombre del cliente que recibe el vehiculo"/>        <br/><tab/>        <txt clr="132,20,7">Apellido paterno :</txt>				<inp id="delnot_apellidopaternoclienterecibe" clr="64,64,64"  dim="25,1" brdr="2,0" bclr="255,255,255" type="capital" nc="30" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Apellido paterno del cliente que recibe el vehiculo"/><tab/>        <txt clr="132,20,7">Apellido materno :</txt>				<inp id="delnot_apellidomaternoclienterecibe" clr="64,64,64"  dim="25,1" brdr="2,0" bclr="255,255,255" type="capital" nc="30" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Apellido materno del cliente que recibe el vehiculo"/>		<br/><tab/>        <txt clr="132,20,7">Telefono : </txt>				<inp id="delnot_ladatelefonoclienterecibe" clr="64,64,64"  dim="3,1" brdr="2,0" bclr="255,255,255" type="number" nc="3" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Lada del telefono del cliente que recibe el vehiculo" just="L"/>		<sp/>		<inp id="delnot_telefonoclienterecibe" clr="64,64,64"  dim="10,1" brdr="2,0" bclr="255,255,255" type="number" nc="10" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Telefono del cliente que recibe el vehiculo" just="L"/>		<tab/><sp n="2"/>		<txt>Telefono oficina :</txt>				<inp id="delnot_ladatelefonooficinaclienterecibe" clr="64,64,64"  dim="3,1" brdr="2,0" bclr="255,255,255" type="number" nc="3" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Lada del telefono de oficina del cliente que recibe el vehiculo" just="L"/>		<sp/>		<inp id="delnot_telefonooficinaclienterecibe" clr="64,64,64"  dim="10,1" brdr="2,0" bclr="255,255,255" type="number" nc="10" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Telefono de oficina del cliente que recibe el vehiculo" just="L"/>		<tab/><sp n="2"/>		<txt>Telefono celular : </txt>				<inp id="delnot_ladatelefonocelularclienterecibe" clr="64,64,64"  dim="3,1" brdr="2,0" bclr="255,255,255" type="number" nc="3" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Lada del telefono celular del cliente que recibe el vehiculo" just="L"/>		<sp/>		<inp id="delnot_telefonocelularclienterecibe" clr="64,64,64"  dim="10,1" brdr="2,0" bclr="255,255,255" type="number" nc="10" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Telefono celular del cliente que recibe el vehiculo" just="L"/>		<br/><tab/>        <txt clr="132,20,7">Correo electronico : </txt><tab/>				<inp id="delnot_emailclienterecibe" clr="64,64,64"  dim="35,1" brdr="2,0" bclr="255,255,255" type="string" nc="50" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Correo electronico del cliente que recibe el vehiculo"/><tab n="2"/>		<txt>Permite ser contactado :  </txt>		<cmb id="delnot_permitecontactoclienterecibe" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" OnChange="" modify="Y" available="Y" visible="Y" tooltip="El cliente desea ser contactado SI/NO"/>		<br/><br/><tab/>		<txt clr="0,58,112" fnt=",b">Datos del vehiculo</txt>				<br/><tab/>		<txt clr="132,20,7">Numero de serie : </txt><tab n="2"/>				<inp id="delnot_numeroserie" clr="64,64,64"  dim="25,1" brdr="2,0" bclr="255,255,255" type="capital" nc="17" fnt="Arial,0" OnF9="" OnChange="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Numero de serie de la unidad que se entrega"/>		<br/><tab/>		<txt clr="132,20,7">Fecha de entrega :</txt><tab n="2"/>		<edt id="delnot_fechaentrega" dim="10,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnChange="" page="_ks_fecha,delnot_fechaentrega" OnF9="Dialog(3,_ks_fecha,delnot_fechaentrega)" modify="Y" available="Y" tooltip="Fecha de entrega de la unidad"/><tab n="5"/>		<txt clr="132,20,7">Folio de entrega : </txt>				<inp id="delnot_folioentrega" clr="64,64,64"  dim="12,1" brdr="2,0" bclr="255,255,255" type="capital" nc="12" fmt="5" fnt="Arial,0" OnF9="" clrBrdr="255,255,255" visible="Y" available="Y" modify="Y" tooltip="Folio de entrega de la unidad" just="L"/>		<br/>        <br/>			<tab n="15"/>		<txt clr="132,20,7">Datos obligatorios en color &lt;Rojo&gt;</txt>			<tab/>		<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="BorraDatos()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>		<sp n="2"/>		<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>				</grp></grp><script>	InstallDriver("KDB75");	class Main {		var frn,frP,kdb,sys,suc_usuario,perfil_usuario,usuario ,rol_usuario  ,asterisco, externo ;		var cmdQuery, cuboQuery, ok, mensajeError, fileSavePath;		var tipoOper; //Variables relacionadas con parametros		var accion,straccion,resVal,suc_bus,genero,naturaleza,grupo,tipo,folio, id_docto;		fun Main(){			frn=new FRNT;			kdb=new KDB;			frP=new FRNTP;			sys=new SYS;			kdb.connect();						suc_usuario = frn.lib("libKepler","UserInfo(1)");			perfil_usuario = frn.lib("libKepler","UserInfo(2)");			usuario = frn.config("user","name");			rol_usuario = frn.config("user","role");			asterisco = "*";			fileSavePath = "C:\Basura";			ConfiguraUI();			Inicializa();		}					fun ConfiguraUI(){			var nparam;			tipoOper = strFormat("ucase",frn.param(0));			nparam = frn.nParam();			accion = strFormat("ucase",frn.param(1));			id_docto = strFormat("ucase",frn.param(2));			if (frn.nParam() == 0){				frn.message("Accion no permitida.","Error","&Aceptar");				frn.open("redirect",2);				return;			}			//Establecer titulo de la ventana			if (accion &= "ALTA"){				straccion = "Alta " ;            }else if (accion &= "CONSULTA"){				straccion = "Consulta ";         }     			if (tipoOper &= "DELIVERYNOTIFICATION"){				frn.set("inp_titulo",straccion & "Delivery Notification");											}					}						fun Inicializa(){			var cmd,cubo;							//Llenar combo sucursales			cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";			if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){				cmd = cmd & " where c1='" & suc_usuario & "'";			}else {				if (suc_usuario &! asterisco && suc_usuario &! "" ){					cmd = cmd & " where c1='" & suc_usuario & "'";				}			}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ifz_sofiadeliverynotification.Inicializa()");					ok=getXmlAtt(cubo,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cubo,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set("k_sucn",getXml(cubo));			frn.set("k_sucn",descr_combo("k_sucn",1,suc_usuario));							//Llena combo desea ser contactado			frn.setX("","delnot_permitecontactoclienterecibe",0,0);			frn.setX("SI","delnot_permitecontactoclienterecibe",1,0);			frn.setX("SI","delnot_permitecontactoclienterecibe",1,1);			frn.setX("NO","delnot_permitecontactoclienterecibe",2,0);			frn.setX("NO","delnot_permitecontactoclienterecibe",2,1);												frn.set("delnot_dealerbac", "320134");			genero = "N";			naturaleza = "A";			grupo = 13;			tipo = 1;			if (id_docto &! ""){			//Se envia el folio desde otra pantalla				frn.set("delnot_identificadordocumento",id_docto);				Buscar();				}		}					fun IniCombos(ctrl_combo, query){			cmdQuery = query;			rstXml(cuboQuery);			cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ifz_sofiadeliverynotification.IniCombos()");			ok=getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			frn.set(ctrl_combo,cuboQuery);		}		fun ObtenerFolio() {			suc_bus = frn.get("k_sucn",-1,1);			LimpiarInf();			cmdQuery = "select m1.c6 as folio, to_char(m1.c9, 'DD/MM/YYYY') as fecha, m1.c100 as inventario, m1.c10 as cve_cte, m1.c32 as nombre_cliente 						from keplersc.kdm1 m1						inner join keplersc.kdcomismov cm on cm.c1 = m1.c1 and cm.c2 = m1.c2 and cm.c3 = m1.c3 and cm.c4 = m1.c4 and cm.c5 = m1.c5 and cm.c6 = m1.c6						where m1.c1='" &suc_bus& "' and m1.c2='" &genero& "' and m1.c3='" &naturaleza& "' and m1.c4 =" & grupo & " and m1.c5=" & tipo & " and cm.c10='0' 						order by m1.c9 desc";			frn.dialog("genlistafiltrosel","Folios",cmdQuery,"folio","delnot_identificadordocumento","0","0","N","N");					}		fun Buscar() {			var xmlRequest,cmd,ok,cuboResultados, xmlProd,vfmov,vfreg;			suc_bus = frn.get("k_sucn", -1, 1);			folio = frn.get("delnot_identificadordocumento");						if (folio &=""){				frn.message("Debe seleccionar un folio","Error","Aceptar");				return;			} 						cmd = "select u.c35 delnot_nombreclienterecibe, u.c33 delnot_apellidopaternoclienterecibe, u.c34 delnot_apellidomaternoclienterecibe, case when (length(u.c7))=10 then substring(u.c7,1,3)  else '' end as delnot_ladatelefonoclienterecibe, 				case when (length(u.c7))=10 then substring(u.c7,4,7) else u.c7 end as delnot_telefonoclienterecibe, case when (length(u.c8))=10 then substring(u.c8,1,3) else '' end as delnot_ladatelefonooficinaclienterecibe, 				case when (length(u.c8))=10 then substring(u.c8,4,7) else u.c8 end as delnot_telefonooficinaclienterecibe, case when (length(u.c9))=10 then substring(u.c9,1,3) else '' end as delnot_ladatelefonocelularclienterecibe, 				case when (length(u.c9))=10 then substring(u.c9,3,7) else u.c9 end as delnot_telefonocelularclienterecibe, case when (length(u.c11))=0 then 'noproporciona@correoelectronico.com' else u.c11 end as delnot_emailclienterecibe,				i.c5 delnot_numeroserie, c.c7 delnot_fechaentrega, c.c6 delnot_folioentrega				from keplersc.kdcomismov c				inner join keplersc.kdm1 k on k.c1 = c.c1 and k.c2 = c.c2 and k.c3 = c.c3 and k.c4 = c.c4 and k.c5 = c.c5 and k.c6 = c.c6				inner join keplersc.kdud u on u.c2 = k.c10				inner join keplersc.kdinf i on i.c2 = k.c100				where c.c1 = '" & suc_bus & "' and c.c2 = '" & genero & "' and c.c3 = '" & naturaleza & "' and c.c4 = " & grupo & " and c.c5 = " & tipo & " and c.c6 = '" & folio & "' and c.c10 = '0'";			frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRequestdeliverynot");								cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ifz_sofiadeliverynotification.Buscar()");			ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			if(nXml(cuboResultados) == 0){				frn.setPos("delnot_identificadordocumento");				frn.message("El folio no existe","Error","Aceptar");				return;			}								rstXml(xmlProd);			xmlProd=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboResultados,"r0");			LimpiarInf();			frn.setX(xmlProd);				}		fun Formar_folio(){			var xmlReqEst, cubofol, cmd, ok, mensajeError ;			setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));			setXml(xmlReqEst,"document","folio_id",frn.get("delnot_identificadordocumento"));			setXml(xmlReqEst,"document","k_tipon","r1",genero);			setXml(xmlReqEst,"document","k_tipon","r2",naturaleza);			setXml(xmlReqEst,"document","k_tipon","r3",grupo);			setXml(xmlReqEst,"document","k_tipon","r4",tipo);			setXml(xmlReqEst,"document","uen","V");			cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";			cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venaltanticipo.Formar_folio()");			var resultado =getXmlAtt(cubofol,"r0", "resultado");			if(resultado &= "0"){				mensajeError = getXmlAtt(cubofol,"r0", "mensaje");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}			var fol = getXmlAtt(cubofol,"r0", "mensaje");			frn.set("delnot_identificadordocumento", fol);			LimpiarInf();		}		fun LimpiarInf(){			frn.set("delnot_nombreclienterecibe", "");			frn.set("delnot_apellidopaternoclienterecibe", "");			frn.set("delnot_apellidomaternoclienterecibe", "");			frn.set("delnot_ladatelefonoclienterecibe", "");			frn.set("delnot_telefonoclienterecibe", "");			frn.set("delnot_ladatelefonooficinaclienterecibe", "");			frn.set("delnot_telefonooficinaclienterecibe", "");			frn.set("delnot_ladatelefonocelularclienterecibe", "");			frn.set("delnot_telefonocelularclienterecibe", "");			frn.set("delnot_emailclienterecibe", "");			frn.set("delnot_permitecontactoclienterecibe", "");			frn.set("delnot_numeroserie", "");			frn.set("delnot_fechaentrega", "");			frn.set("delnot_folioentrega", "");		}			fun BorraDatos(){			frn.set("delnot_identificadordocumento", "");			frn.set("delnot_nombreclienterecibe", "");			frn.set("delnot_apellidopaternoclienterecibe", "");			frn.set("delnot_apellidomaternoclienterecibe", "");			frn.set("delnot_ladatelefonoclienterecibe", "");			frn.set("delnot_telefonoclienterecibe", "");			frn.set("delnot_ladatelefonooficinaclienterecibe", "");			frn.set("delnot_telefonooficinaclienterecibe", "");			frn.set("delnot_ladatelefonocelularclienterecibe", "");			frn.set("delnot_telefonocelularclienterecibe", "");			frn.set("delnot_emailclienterecibe", "");			frn.set("delnot_permitecontactoclienterecibe", "");			frn.set("delnot_numeroserie", "");			frn.set("delnot_fechaentrega", "");			frn.set("delnot_folioentrega", "");		}				fun Ejecuta(){			var xmlPantalla,resultado,mensaje,folio,continua;			var strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			fecha = sys.date();			hora= sys.time();			strFecha = fnDate("year",fecha) & "-";			strTmp = fnDate("month",fecha);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp & "-";			strTmp = fnDate("day",fecha);			if(strlen(strTmp) == 1){				strTmp = "0" & strTmp;			}			strFecha = strFecha & strTmp;			resVal = 1;			ValidarDatos();			if(resVal == 0){				return;			}			continua = frn.message("Desea continuar ?","Atencion",2);			if (continua == 0){				return;			}						xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			setXml(xmlPantalla,"delnot_identificadordocumento",mid(frn.get("delnot_identificadordocumento"),3,7));			setXml(xmlPantalla,"sucursal",frn.get("k_sucn",-1,1));			setXml(xmlPantalla,"genero",genero);			setXml(xmlPantalla,"naturaleza",naturaleza);			setXml(xmlPantalla,"grupo",grupo);			setXml(xmlPantalla,"tipo",tipo);			setXml(xmlPantalla,"folio",frn.get("delnot_identificadordocumento"));			setXml(xmlPantalla,"serie",frn.get("delnot_numeroserie"));			setXml(xmlPantalla,"fecha",fecha);			setXml(xmlPantalla,"movto_sofia","Delivery Notification");			setXml(xmlPantalla,"tip_ope",tipoOper);			setXml(xmlPantalla,"movimiento","usuario",usuario);			setXml(xmlPantalla,"movimiento","fecha",strFecha);			setXml(xmlPantalla,"movimiento","hora",			frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 			frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaifz_sofiadeliverynotification");			cmdQuery="SELECT * FROM keplersc.ifz_sofiadeliverynotification('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";			rstXml(cuboQuery);								cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"ifz_sofiadeliverynotification.Ejecuta");							frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadifz_sofiadeliverynotification");								resultado = getXml(cuboQuery,"resultado");			mensaje = getXml(cuboQuery,"mensaje");								ok = getXmlAtt(cuboQuery,"ok");			if(ok &! "" && !ok) {				mensajeError = getXmlAtt(cuboQuery,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;				}			if(resultado &= "1") {				strMsg = "Se guardo correctamente la informacion para SOFIA";				frn.message(strMsg, "Mensaje", "Aceptar");				 frn.setAtt("bot_seleccionar", "visible", "N" );			} else {				frn.message(mensaje, "Error", "Aceptar");				return;			}			frn.exit();		}        fun validaDatoVacio(dato,msg){			if (frn.get(dato) &= ""){				resVal= 0;				frn.setPos(dato);				frn.message("Debe especificar " & msg & "|El dato no puede estar vacio","Error","Aceptar");				return;			}		}		fun ValidarDatos(){			validaDatoVacio("delnot_dealerbac","Codigo BAC del distribuidor");			validaDatoVacio("delnot_identificadordocumento","Identificador del documento");			validaDatoVacio("delnot_nombreclienterecibe","Nombre");			validaDatoVacio("delnot_apellidopaternoclienterecibe","Apellido paterno");			validaDatoVacio("delnot_apellidomaternoclienterecibe","Apellido materno");			validaDatoVacio("delnot_telefonoclienterecibe","Telefono");			validaDatoVacio("delnot_emailclienterecibe","Correo electronico");			validaDatoVacio("delnot_numeroserie","Numero de serie");			validaDatoVacio("delnot_fechaentrega","Fecha de entrega");			validaDatoVacio("delnot_folioentrega","Folio de entrega");			if (strlen(frn.get("delnot_numeroserie")) != 17){				resVal= 0;				frn.setPos("delnot_numeroserie");				frn.message("La serie debe ser de 17 digitos","Error","Aceptar");				return;			}        }//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------		fun descr_combo(combo,posicion,valor){			var descr, valor_actual;			var len_combo = frn.N(combo);			for (var cont=0; cont<len_combo ; cont++){				valor_actual= frn.get(combo,cont,posicion);				if (valor_actual &=  valor){					descr = frn.get(combo,cont,0);					return descr;				}			}		}					fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){			/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO						1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana						2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)						3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje			*/			var prefix=frn.lib("libKepler","langPrefix");			var page=prefix&pag;			var b_valido=1;			if(iModo==0)				page=pag;			else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.				if( frn.getAtt(par0,"modify",par1) &= "N" ) 					b_valido=0;				if( frn.getAtt(par0,"available",par1) &= "N" ) 					b_valido=0;				if( frn.getAtt(par0,"visible",par1) &= "N" ) 					b_valido=0;			}			if(iModo==3)				frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>