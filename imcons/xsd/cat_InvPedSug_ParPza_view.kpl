<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo"><grp dim="40,20,15,15" 	  brdr="0,0" 	  clr="0,58,112" 	  bclr="192,205,213" 	  fnt="Arial,16" 	  unfont="0" id="Principal"><br/>			<tab/>			<grp bclr="236,240,243" 			fntClrBrdr="255,206,0" 			fntBrdr="Arial,18" 			hSpace="4" 			clrBrdr="0,58,112" 			brdr="0,5" 			dim="45,55,9,9" 			tit="Par&#225;metros Pieza"			fnt="Arial,16">				<br/>							<tab n="3"/><txt>Esta opci&#243;n permite establecer los valores predeterminados de ciclo	de reorden,</txt><br/>				<tab n ="2"/><txt>leadtime, m&#225;xima fluctuaci&#243;n, de leadtime, stock de seguridad, porcentaje</txt><br/> 				<tab n ="2"/><txt>de tasa de servicio, m&#250;ltiplos de empaque y clasificaci&#243;n para una sola pieza.</txt><br/><br/>								<tab n="8"/><txt>  Pieza : </txt>				<inp id="k_pieza_a1"  dim="12,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" OnEnter="Execute(2)" available="Y"/><tab/>				<inp id="k_pieza_desc_a1"  dim="25,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="N"/>				<br/>								<tab n="6"/><txt>Ciclo de reorden : </txt>				<inp id="k_cicloreorden_a2" dim="5,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="Y"/><txt> d&#237;as</txt><br/>								<tab n="7"/><txt>   Leadtime : </txt>				<inp id="k_leadtime_a3" dim="5,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="Y"/><txt> d&#237;as</txt><br/>								<tab n="2"/><txt>  M&#225;xima Fluctuaci&#243;n de Leadtime : </txt>				<inp id="k_maxfluletime_a4" dim="5,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="Y"/><txt> d&#237;as</txt><br/>												<tab n="5"/><txt>  Stock de seguridad : </txt>				<inp id="k_stockseg_a6" dim="5,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="Y"/><txt> d&#237;as</txt><br/>								<tab n="6"/><txt>Tasa de servicio : </txt>				<inp id="k_tasaservicio_a5" dim="5,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="Y"/><txt> %</txt>				<br/>				<br/>					<tab n="6"/><txt>    Clasificaci&#243;n : </txt>				<cmb id="k_clasificacion_a7" clr="64,64,64" clrBrdr="255,255,255"						dim="10,15" bclr="255,255,255" brdr="2,0" fnt="Arial,16"						Null="N"  available="Y" OnChange="CargarClasificacion()"/><tab n="2"/>				<inp id="k_clasificacion_a7_desc" dim="25,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="N"/>				<br/>				<br/>				<tab n="6"/><txt>Phase Out : </txt>				<inp id="k_phaseout_g2" dim="12,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="N"/>				<br/>				<br/>				<tab n="4"/><txt>    M&#250;ltiplos de empaque : </txt>				<inp id="k_multempa_a8" dim="5,1" brdr="1,1" bclr="236,240,243" clr="64,64,64" clrBrdr="236,240,243" type="string" modify="Y" available="Y"/><br/>				<br/>				<tab n="1"/><txt>NOTA: Al hacer un cambio en estos par&#225;metros DEBER&#193; REGENERAR el Listado &quot;MAD / MIP&quot;</txt><br/>				<tab n="1"/><txt>Los m&#250;ltiplos de empaque pueden usarse o considerarse como las unidaddes m&#237;nimas a solicitar, </txt><br/>				<tab n="1"/><txt>por ejemplo un auto requiere al menos 4 buj&#237;as. </txt><br/>				<br/>				<tab n="9"/><bot id="btn_aceptar_A100" dim="9,0" brdr="5" text="Aceptar" OnEnter="Execute(0)" default="1" visible="Y" available="Y"/>				<br/>			<br/>			</grp></grp>	<script>		InstallDriver("KDB75");		class Main {						var frn,kdb,frP,externo,accion,suc_usuario,perfil_usuario ;			fun Main() {				frn = new FRNT;				frP = new FRNTP;				kdb = new KDB;				kdb.connect();				ctlrs_off();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				Inicializa();			}			fun Inicializa()			{				frn.setX(1,"k_cicloreorden_a2");				frn.setX(2,"k_leadtime_a3");				frn.setX(3,"k_maxfluletime_a4");				frn.setX(95,"k_tasaservicio_a5");				frn.setX(1,"k_stockseg_a6");								//cargar Combo de Clasificaciones	// evitar una consulta							frn.setX(" ", "k_clasificacion_a7", 0,0);					frn.setX(" ", "k_clasificacion_a7", 0,1);					frn.setX("ACCES", "k_clasificacion_a7", 1,0);					frn.setX("ACCESORIOS", "k_clasificacion_a7", 1,1);										frn.setX("S", "k_clasificacion_a7", 1,2);					frn.setX("ACCNO", "k_clasificacion_a7", 2,0);					frn.setX("ACCESORIOS NO ORIGINALES", "k_clasificacion_a7", 2,1);														frn.setX("S", "k_clasificacion_a7", 2,2);										frn.setX("CAMP", "k_clasificacion_a7", 3,0);					frn.setX("CAMPAÑAS", "k_clasificacion_a7", 3,1);										frn.setX("S", "k_clasificacion_a7", 3,2);					frn.setX("LLANT", "k_clasificacion_a7", 4,0);					frn.setX("LLANTAS", "k_clasificacion_a7", 4,1);					frn.setX("S", "k_clasificacion_a7", 4,2);										frn.setX("MTTO", "k_clasificacion_a7", 5,0);					frn.setX("MANTENIMIENTO", "k_clasificacion_a7", 5,1);					frn.setX("N", "k_clasificacion_a7", 5,2);					frn.setX("PCOLI", "k_clasificacion_a7", 6,0);					frn.setX("PARTES COLISION H&P", "k_clasificacion_a7", 6,1);										frn.setX("S", "k_clasificacion_a7", 6,2);					frn.setX("REPMA", "k_clasificacion_a7", 7,0);					frn.setX("REPARACION MAYOR", "k_clasificacion_a7", 7,1);										frn.setX("S", "k_clasificacion_a7", 7,2);					frn.setX("REPME", "k_clasificacion_a7", 8,0);					frn.setX("REPARACION MENOR", "k_clasificacion_a7", 8,1);										frn.setX("N", "k_clasificacion_a7", 8,2);			}									fun ctlrs_off()			{					frn.setAtt("btn_aceptar", "visible", "Y" );			}						fun Validaciones(psOpcion)			{				var v_CicloReorden_A2,					 v_leadtime_A3,					 v_MaxFluleTime_A4,					 v_TasaServicio_A5,					 v_Clasificacion_A7,					 v_MultEmpa_A8;														v_CicloReorden_A2= frn.get("k_cicloreorden_a2");					 					if(v_CicloReorden_A2 <= 0)					{						frn.message("El ciclo de ordenamiento no puede ser menor a 0 días.", "ADVERTENCIA","&Aceptar");						return 0;					}										v_leadtime_A3= frn.get("k_leadtime_a3");					if(v_leadtime_A3 <= 0 )					{						frn.message("El lead time no puede ser menor a 0 días", "ADVERTENCIA","&Aceptar");						return 0;					}										v_MaxFluleTime_A4 = frn.get("k_maxfluletime_a4");					if(v_MaxFluleTime_A4 < v_leadtime_A3 )					{						frn.message("La fluctuación máxima de lead time no puede ser menor al lead time", "ADVERTENCIA","&Aceptar");						return 0;					}										v_TasaServicio_A5= frn.get("k_tasaservicio_a5");					if(v_TasaServicio_A5< 0 || v_TasaServicio_A5 > 100 )					{						frn.message("La tasa de servicio debe estar en el rango de 0 a 100 %", "ADVERTENCIA","&Aceptar");						return 0;					}										v_Clasificacion_A7 = frn.get("k_clasificacion_a7", -1, 0);					if(v_Clasificacion_A7  &= "" )					{						frn.message("Debe indicar una clasificación para la pieza, es requerido.", "ADVERTENCIA","&Aceptar");						return 0;					}										v_MultEmpa_A8 = frn.get("k_multempa_a8");										if(v_MultEmpa_A8 <= 0)					{						frn.message("Los múltiplos de empaque no pueden ser menor a cero.", "ADVERTENCIA","&Aceptar");						return 0;					}				return 1;			}//end fun Validaciones			fun CargarClasificacion()			{								frn.setX(frn.get("k_clasificacion_a7", -1, 2),"k_phaseout_g2");				frn.setX(frn.get("k_clasificacion_a7", -1, 1),"k_clasificacion_a7_desc");			}						fun Execute(pIOpcion)			{				var xmlRequest,						cmd,						ok, 						cuboResultados,						mensajeError,						xmlPantalla,						resultado,						mensaje,						tip_ope,						mensaje;													if(pIOpcion == 0) // GUARDAR				{									if(Validaciones()<=0)					{						return;					}					//					xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;										kdb.rst(cuboResultados);										cuboResultados  = getXml(frn.dataPag()); //Obtener el xml de la pantalla;					setXml(cuboResultados,"k_nocatalogo",2); //se define con base a la lista de opciones de Kepler... 0,1,2,3,4,5					setXml(cuboResultados,"k_sucn","02");											// obtención de datos en plantilla general										setXml(cuboResultados,"k_cicloreorden_a2",frn.get("k_cicloreorden_a2"));					setXml(cuboResultados,"k_leadtime_a3",frn.get("k_leadtime_a3"));					setXml(cuboResultados,"k_maxfluletime_a4",frn.get("k_maxfluletime_a4"));					setXml(cuboResultados,"k_tasaservicio_a5",frn.get("k_tasaservicio_a5"));					setXml(cuboResultados,"k_stockseg_a6",frn.get("k_stockseg_a6"));										setXml(cuboResultados,"k_clasificacion_a7",frn.get("k_clasificacion_a7"));					setXml(cuboResultados,"k_multempa_a8",frn.get("k_multempa_a8"));					setXml(cuboResultados,"k_pieza_a1",frn.get("k_pieza_a1"));															frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\sqlXmlParPza");															cmd = "SELECT * FROM keplersc.cat_pedidosugerido_validaciones_crud('<document>" & getXmlStr(cuboResultados,"EOF:13_10") & "</document>')";					kdb.rst(cuboResultados);					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"cat_InvPedSugParaGen.Execute");									ok = getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok)					{											mensajeError = getXmlAtt(cuboResultados,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										resultado= getXml(cuboResultados,"resultado");					mensaje= getXml(cuboResultados,"mensaje");										if(resultado &= "1")					{						frn.message(mensaje, "Registro actualizado.","&Aceptar");					}else{						frn.message(mensaje, "Error","&Aceptar");					}				}	//end opcion 0				if(pIOpcion == 2) // Consultar				{					// obtener k_pieza_a1					cmd = "select * from keplersc.KDINI where c1='" & frn.get("k_pieza_a1") & "'";					cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_InvPedSug_ParPza_view.Execute(2)");					ok = getXmlAtt(cuboResultados ,"ok");					if(ok &! "" && !ok)					{					   mensajeError = getXmlAtt(cuboResultados ,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}					frn.set("k_pieza_desc_a1", getXmlAtt(cuboResultados,"r0","c2"));					frn.set("k_cicloreorden_a2", getXmlAtt(cuboResultados,"r0","c26"));					frn.set("k_leadtime_a3", getXmlAtt(cuboResultados,"r0","c27"));					frn.set("k_maxfluletime_a4", getXmlAtt(cuboResultados,"r0","c28"));					frn.set("k_tasaservicio_a5", getXmlAtt(cuboResultados,"r0","c29"));					frn.set("k_stockseg_a6", getXmlAtt(cuboResultados,"r0","c30"));					frn.set("k_clasificacion_a7", getXmlAtt(cuboResultados,"r0","c32"));										frn.set("k_multempa_a8", getXmlAtt(cuboResultados,"r0","c31"));					CargarClasificacion();									}			}//end fun Execute				}	</script></pag>