<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Catalogo vendedores"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="82,50,10,10" brdr="0,5" tit="Vendedores" fnt="Arial,16">				<tab/><txt clr="0,58,112" hk="S">Vendedor:</txt>		<inp id="input" dim="23,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/>		<tab/><txt clr="0,58,112" hk="S">Sucursal</txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="30,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/><tab n="1"/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><br/>			<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255"  OnEnter="Exit" OnMouseD="Exit" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="76,22" modify="N" nren="fijo">		<col id="abreviatura" name="Abreviatura"/>		<col id="nombre" name="Nombre"/>		<col id="tipo" name="Tipo"/>						</tbl>  <br/>		<tab n="7"/>		<bot id="k_btn_nvo" dim="10,10" brdr="5" text="Nuevo" hk="K" default="0" step="0"  OnEnter="abrir_curd(Nuevo)" fnt="Arial,16" visible="Y"/> 		<bot id="k_btn_mod" dim="10,10" brdr="5" text="Modificar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Modificar)" fnt="Arial,16" visible="Y"/> 		<bot id="k_btn_elimnr" dim="10,10" brdr="5" text="Eliminar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Eliminar)" fnt="Arial,16" visible="Y"/> 		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Consultar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Consultar)" fnt="Arial,16" visible="Y"/> <br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys, suc_usuario,perfil_usuario,asterisco ,externo,rol_usuario  ;			fun Main(){				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				kdb.connect();										suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				asterisco = "*";				rol_usuario = frn.config("user","role");								ctrls_off();				Inicializa();						}									fun ctrls_off(){						frn.setAtt("k_btn_nvo", "visible", "N");				frn.setAtt("k_btn_mod", "visible", "N");				frn.setAtt("k_btn_elimnr", "visible", "N");				frn.setAtt("k_btn_cons", "visible", "N");						}									fun Inicializa(){							externo = frn.param(0);												if (externo &! "s"){					frn.setAtt("k_btn_nvo", "visible", "Y");					frn.setAtt("k_btn_mod", "visible", "Y");					frn.setAtt("k_btn_elimnr", "visible", "Y");					frn.setAtt("k_btn_cons", "visible", "Y");				}														var cmd,cuboResultados,ok;																		cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucn",getXml(cubo));										}												fun Buscar() {							var xmlRequest,cmd,ok,cuboResultados, tot , cont, abrv, nombre, tipo;						var criterio = frn.get("input");							cmd= "select c1,c2,c3 from keplersc.kdvenref where (c1 like upper('%" & criterio & "%') or c2 like upper('%" & criterio & "%'))";												if (suc_usuario &! "" && suc_usuario &! asterisco){					cmd = cmd & " and c4='"& suc_usuario &"'";  				}												cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_venref_view.Buscar()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								tot = nXml(cuboResultados);							frn.rst("tabla");				for (cont=0; cont<tot; cont++){								abrv= getXmlAtt(cuboResultados,"r"&cont,"c1");					nombre= getXmlAtt(cuboResultados,"r"&cont,"c2");					tipo= getXmlAtt(cuboResultados,"r"&cont,"c3");													frn.setX(abrv,"tabla",cont,"abreviatura");					frn.setX(nombre,"tabla",cont,"nombre");								frn.setX(tipo,"tabla",cont,"tipo");												}							}									fun abrir_curd(accion){							if (accion &! "Nuevo"){									var param = frn.get("tabla", -1, "abreviatura");													if (param &= ""){										frn.message("No has seleccionado vendedor","Error","Aceptar");									}else{										frn.dialog("cat_venref_crud",accion, param,"n");					}				}else {									frn.dialog("cat_venref_crud", accion, "x","n");									}							}									fun Exit(){							var abvr_seleccionada = frn.get("tabla", -1, "abreviatura");								if (externo &= "s"){									frP.set(frn.param(1),abvr_seleccionada ); 					frP.scriptElm(frn.param(1),"OnChange");					frn.exit();									}					}						fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave_cli = getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave_cli , cmb, cont+pos_ini ,1);								}				}										}	</script></pag>