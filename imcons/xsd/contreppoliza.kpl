<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Polizas Contables">
	<grp dim="1,-1,15,30" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">
		<tab/><txt fnt=",22" clr="0,0,0">P&#243;lizas Contables</txt><br/>
		<tab/><hLine clr="0,0,0"/>
		<br/><br/>
		<tab/>
		<grp dim="40,24,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="8" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Criterio de selecci&#243;n">
			<tab/><txt>Sucursal:</txt><tab n="5"/><sp n="2"/><cmb id="cmb_sucursal" dim="50,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 
			  Null="N" modify="Y" available="Y" OnChange="ResetRango()"/><tab/><br/>
			<tab/><txt>A&#241;o   :</txt><tab n="5"/>
			<sp n="2"/><cmb id="cmb_anio" dim="10,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="ResetRango()"/>
			<br/>
			<tab/><txt>Mes:</txt><tab n="6"/><sp n="2"/>
			<cmb id="cmb_mes" dim="10,10" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 
			  Null="N" modify="Y" available="Y" OnChange="ResetRango()"/><tab/><br/>
			<tab/><txt>Tipo de poliza:</txt><tab n="3"/><sp n="2"/><cmb id="cmb_tipo_poliza" dim="10,10" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 
			  Null="N" modify="Y" available="Y" OnChange="ResetRango()"/><tab/><br/>	      
			<tab/><txt>Del No. de p&#243;liza:</txt><tab n="2"/><sp n="2"/><inp id="poliza_inicial" type="number" dim="10,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" 
			  modify="Y" available="Y" fmt="5"/><tab/><br/>  
			<tab/><txt>Al No. de P&#243;liza:</txt><tab n="3"/><sp n="2"/><inp id="poliza_final" type="number"  dim="10,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0"  
			  modify="Y" available="Y" fmt="5"/><tab/><br/>				      
			<tab/><txt>Hacer Salto de Pagina? </txt><tab/>
			<chck id="salto_de_pagina" dim="3,16" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><br/>			
			<tab n="1"/><bot id="bot_ejecutar" dim="20,0" brdr="5" text="Ejecutar" OnEnter="Execute()" default="1"/><br/>
		</grp><br/><br/>
	</grp>
	<script>
		InstallDriver("KDB75");class Main {
			var frn,kdb,rep,sys,suc_usuario,rol_usuario,perfil_usuario,usuario,asterisco  ;
			fun Main() {
				frn=new FRNT;
				kdb=new KDB;
				rep=new REP;
				sys=new SYS;
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				perfil_usuario = frn.lib("libKepler","UserInfo(2)");
				usuario = frn.config("user","name");
				rol_usuario = frn.config("user","role");
				asterisco = "*";
			
				Inicializa();				
			}
			
			fun Inicializa(){//Inicializa los valores en Pantalla
				IniCombos();
				ResetRango();
				frn.set("ch_incluir","1");
			}			
			
			fun IniCombos(){
				var cmd, cuboQuery, xmlResQuery, ok, mensajeError, strTmp;
				var cont;
				cuboQuery="datDoc";			
			
			//Llenar combo sucursales
				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";
				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){
					cmd = cmd & " where c1='" & suc_usuario & "'";
				}else {
					if (suc_usuario &! asterisco && suc_usuario &! "" ){
						cmd = cmd & " where c1='" & suc_usuario & "'";
					}
				}
			
				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"contreppoliza.IniCombos()");
				
				ok=getXmlAtt(cuboQuery,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboQuery,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				frn.set("cmb_sucursal",getXml(cuboQuery));	
				
				//Llenar cmb_anio
				for(cont=2020; cont <= 2040; cont++)
				{
					frn.setX(cont,"cmb_anio",cont-2020,0);
					frn.setX(cont-2000,"cmb_anio",cont-2020,1);
				}
				var anio = fnDate("year",sys.date());
				frn.set("cmb_anio",anio);
				
				//llenar cmb_meses
				frn.setX("01","cmb_mes",0,0);
				frn.setX("02","cmb_mes",1,0);
				frn.setX("03","cmb_mes",2,0);
				frn.setX("04","cmb_mes",3,0);	
				frn.setX("05","cmb_mes",4,0);
				frn.setX("06","cmb_mes",5,0);
				frn.setX("07","cmb_mes",6,0);
				frn.setX("08","cmb_mes",7,0);	
				frn.setX("09","cmb_mes",8,0);
				frn.setX("10","cmb_mes",9,0);
				frn.setX("11","cmb_mes",10,0);
				frn.setX("12","cmb_mes",11,0);
	
				var mes=fnDate("month",sys.date());
				
				frn.set("cmb_mes",mes);
				
				//llenar cmb_tipo_poliza
				frn.setX("Diario","cmb_tipo_poliza",0,0);
				frn.setX("D","cmb_tipo_poliza",0,1);
				frn.setX("Ingreso","cmb_tipo_poliza",1,0);
				frn.setX("I","cmb_tipo_poliza",1,1);
				frn.setX("Egreso","cmb_tipo_poliza",2,0);
				frn.setX("E","cmb_tipo_poliza",2,1);
			}
			
			fun ResetRango(){
				var cmd, cuboQuery, xmlResQuery, ok, mensajeError, strTmp;
				var folioIni, folioFin, tabla, anio, mes, tipo, sucursal_id ;
				anio=frn.get("cmb_anio",-1,1);
				mes=frn.get("cmb_mes",-1,0);
				sucursal_id=frn.get("cmb_sucursal",-1,1);
				
				tabla="keplersc.kdc2" & anio & mes;
				tipo = frn.get("cmb_tipo_poliza",-1,1);
				
				cmd="select max(c1) as maximo from " & tabla & "  where c14='" & sucursal_id & "' and c8= '" & tipo & "'";			
				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"contreppoliza.IniCombos()");
//frn.lib("libGeneral.kpl","FileSave",cuboQuery, "C:\Basura\XmlMaxFol");				

				ok=getXmlAtt(cuboQuery,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboQuery,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}	
								
				folioIni=1;
				folioFin=getXmlAtt(cuboQuery,"r0","maximo");
				frn.set("poliza_inicial",folioIni);			
				frn.set("poliza_final",folioFin);	
			}
				
			fun Execute() {
				frn.dialog("repcontpoliza",frn.get("cmb_sucursal",-1,1),frn.get("cmb_anio",-1,1),frn.get("cmb_mes",-1,0),
				frn.get("cmb_tipo_poliza",-1,1),frn.get("poliza_inicial",-1,0),frn.get("poliza_final",-1,0),frn.get("salto_de_pagina"));
			}
		}
	</script>
</pag>