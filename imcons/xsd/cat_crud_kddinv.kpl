<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Cat&#225;logo de Inventario">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/><tab/><inp id="k_titulo" dim="65,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"				type="string" modify="N" available="N" fnt="Arial,22"/>	<br/>	<br/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grupo_crud" dim="50,18,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18"><tab n="2"/>			<txt>Clave :  </txt><tab n="3"/>			<inp id="k_clave" dim="8,1" brdr="2,0" clr="64,64,64" bclr="255,255,255"  type="number" clrBrdr="255,255,255" tooltip="Clave " available="N" modify="N"/><sp/>			<br/>			<tab n="2"/>			<txt>Inv :  </txt><tab n="4"/>			<inp id="k_inv" dim="8,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="5" clrBrdr="255,255,255" tooltip="Inventario" available="Y" modify="Y"/><sp/>			<br/><sp/><tab n="2"/>			<txt>Anio:  </txt><tab n="3"/>			<inp id="k_anio" dim="6,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="4" clrBrdr="255,255,255" tooltip="Anio" available="Y" modify="Y"/><sp/>			<br/><sp/><tab n="2"/>			<txt>ID:  </txt><tab n="4"/>			<inp id="k_id" dim="6,1" brdr="2,0" clr="64,64,64" bclr="255,255,255"  type="capital" nc="3" clrBrdr="255,255,255" tooltip="Digitos ID" available="Y" modify="Y"/><sp/>			<br/>	<sp/><tab n="2"/><txt>Nuevo/Usado:  </txt><tab n="1"/>			<inp id="k_nuevo_usado" dim="4,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="1" clrBrdr="255,255,255" tooltip="N(nuevo) U(usado)" available="Y" modify="Y"/><sp/>			<br/>						<br/><sp/><tab n="7"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="N" available="N"/><br/>			<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>							</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP, accion,externo, clave_sel,sucursal_id,cve_color,resVal,straccion,suc_usuario,perfil_usuario,rol_usuario,asterisco    ;            var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError,cuboQuery,suc;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();				suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";			    Inicializa();				ctlrs_off();				insertar_datos();				ctlrs_opcion();			}						fun Inicializa(){				accion = frn.param(0);				frn.set("input_crud", accion);				frn.rst("grupo_crud");				externo	= frn.param(6);                if (accion &= "NUEVO"){                    straccion = "Nuevo" ;                   }else if (accion &= "CONSULTAR"){                    straccion = "Consultar";                }else if (accion &= "MODIFICAR"){                    straccion = "Modificar";                }else if (accion &= "ELIMINAR"){                    straccion = "Eliminar";                }     								frn.setAtt("grupo_crud", "tit", straccion );																				var cmd= "select c1 from keplersc.kddinv order by c1 desc limit 1 ";							cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_modelos.Inicializa()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}										frn.set("k_clave", getXmlAtt(cuboResultados,"r0","c1") + 1);																	}						fun ctlrs_off(){				frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );				frn.setAtt("k_clave", "available", "N" );            frn.setAtt("k_clave", "modify", "N" );           			}							fun ctlrs_opcion(){				frn.set("k_titulo","Inventario");				if (accion &= "NUEVO"){					frn.set("k_titulo","Nuevo");					frn.setAtt("k_clave", "available", "Y" );					frn.setAtt("k_clave", "modify", "Y" );				   frn.setAtt("btn_aceptar", "visible", "Y" );					frn.setAtt("btn_aceptar", "available", "Y" );						}								if (accion &= "MODIFICAR"){					frn.set("k_titulo","Modificar");					frn.setAtt("btn_aceptar", "visible", "Y" );					frn.setAtt("btn_aceptar", "available", "Y" );								}					}												fun insertar_datos(){					if (accion &! "NUEVO") {									frn.set("k_clave", frn.param(1));					frn.set("k_inv",frn.param(2));					frn.set("k_anio",frn.param(3));					frn.set("k_id",frn.param(4));					frn.set("k_nuevo_usado",frn.param(5));											            }			}						fun ValidarDatos(){				if (frn.get("k_clave") &= "") {											frn.setPos("k_clave");					resVal=0;					frn.message("Debe especificar la Clave, verificar","Error","Aceptar");				}				if (frn.get("k_inv") &= "") {											frn.setPos("k_inv");					resVal=0;					frn.message("Debe especificar el Inventario, verificar","Error","Aceptar");				}				if (frn.get("k_anio") &= "") {											frn.setPos("k_anio");					resVal=0;					frn.message("Debe especificar el anio, verificar","Error","Aceptar");				}				if (frn.get("k_id") &= "") {											frn.setPos("k_id");					resVal=0;					frn.message("Debe especificar el ID, verificar","Error","Aceptar");				}				if (frn.get("k_nuevo_usado") &= "") {											frn.setPos("k_nuevo_usado");					resVal=0;					frn.message("Debe especificar si es nuevo o usado, verificar","Error","Aceptar");				}else {									if (frn.get("k_nuevo_usado") &! "N" && frn.get("k_nuevo_usado") &! "U" ) {								frn.setPos("k_nuevo_usado");						resVal=0;						frn.message("Solo se permiten los valores N(nuevo) o U(usado), verificar","Error","Aceptar");					}				}						}			fun Execute() {				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}								var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}								xmlRequest = getXml(frn.dataPag());					frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmdQuery="SELECT * FROM keplersc.cat_crud_kddinv('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_crud_tmkt.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frP.script("Inicia_Forma()");				if (accion &= "NUEVO" || accion &= "MODIFICAR") {						var sms =  "";					if (accion &= "NUEVO"){						sms = "Registro guardado";					}else {						sms = "Registro modificado";					}					accion="CONSULTAR";					ctlrs_opcion();					frn.message(sms ,"Mensaje","Aceptar");						frn.exit();					}				if (accion &= "ELIMINAR"){					frn.message("Registro eliminado","Mensaje","Aceptar");					frn.exit();							}			}													fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}												}							</script></pag>