<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	    <tab/><txt fnt=",22" clr="0,0,0">Traspaso de Inventario entre Sucursales</txt><br/>	    <tab/><hLine clr="0,0,0"/> 	    <br/> <br/>		<!-- <grp dim="46,9,7,12" -->	    <tab/>        <grp dim="48,10,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros">            <tab/><txt>Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>			<br/><tab/><txt>Tipo :       </txt>			<cmb id="k_tipon" dim="52,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange=""/>						<sp n="1"/> <tab n="1"/><inp id="statusdoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/><tab/><inp id="datcfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="3,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="1" modify="Y" available="Y" visible="N"/>					</grp>        <sp/>			<grp dim="36,10,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle Documento">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="Y" fnt=",18b" just="C"/><tab/> <br/>			<txt>  Folio Entrada :  </txt>					<inp id="k_folio" clr="64,64,64"  dim="20,1" fnt="Arial,16" type="string" modify="N" available="N" brdr="2,0" clrBrdr="255,255,255" bclr="255,255,255"/>			<br/>			<sp n="1"/><txt>Folio Salida:</txt><tab/>			<inp id="k_docto" clr="64,64,64"  dim="20,1" fnt="Arial,16" type="string" modify="N" available="N" brdr="2,0" clrBrdr="255,255,255" bclr="255,255,255"/>						<sp n="2"/>            <br/><tab/><txt>Fecha : </txt> <sp n="2"/> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" clrBrdr="255,255,255" available="Y" modify="N"/>             <br/><tab/><br/>						<br/>					</grp>		<br/><br/>		<tab/>		<grp dim="85,22,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle Traspaso">				<br/>			<tab/><txt>Sucursal Origen:</txt><sp n="2"/>            <cmb id="k_sucn_origen" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="" available="Y" modify="Y"/>            <br/>            <tab/><txt>Sucursal Destino:</txt><sp n="1"/>            <cmb id="k_sucn_destino" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="" available="Y" modify="Y"/>            <br/><br/><tab/><txt>Inventario:</txt><tab/>			<edt id="k_claveinv" dim="22,1" brdr="2,0" nc="10" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital"  available="Y" visible="Y" OnF9="ObtenerInventario()" OnButton="ObtenerInventario()" modify="Y"/> 			<sp n="1"/><img dim="20,20" id="bot_inventario" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="MostrarInventario()" available="Y" clrBrdr="0,0,0" visible="Y"/>			<br/>            <tab/><txt>Datos del vehiculo : </txt>            <br/>            <tab/><txt clr="0,58,112" hk="P">Serie: </txt>            <sp n="1"/><tab n="2"/>            <inp id="k_serievehiculo" clr="64,64,64"  dim="35,1" fnt="Arial,16" type="string" modify="N" available="N" brdr="2,0" clrBrdr="255,255,255" bclr="255,255,255"/>            <tab/><txt clr="0,58,112" hk="P">Clave: </txt>            <sp n="1"/>            <inp id="k_clavevehiculo" clr="64,64,64"  dim="20,1" fnt="Arial,16" type="string" modify="N" available="N" brdr="2,0" clrBrdr="255,255,255" bclr="255,255,255"/>            <tab/><txt>A&#241;o : </txt>            <inp id="k_anio" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="string" modify="N" available="N" brdr="2,0" clrBrdr="255,255,255" bclr="255,255,255"/>            <br/>             <sp n="1"/><tab/><txt>Descripcion : </txt>            <inp id="k_descripcion" clr="64,64,64"  dim="63,1" fnt="Arial,16" type="string" modify="N" available="N" brdr="2,0" clrBrdr="255,255,255" bclr="255,255,255"/><br/>						            <tab n="33"/>            <img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="borrar_datos()" tooltip="Cancelar / Limpiar" available="Y" clrBrdr="0,0,0" visible="Y"/>			<sp n="4"/>			<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>                      </grp>  			</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario,asterisco,anio_contable;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, suc_destino, suc_origen, resVal, k_monto, k_iva, monto_extra4;			var fecha_baja, estatus_doc;									var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, uen;                  var row_grid, err_data, err_empty;			// Vart Reports			var cmd, xmlResQuery, strTmp;			var sucursal, fech_oper, tipo_auto, xmlPar;													fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";				suc_usuario = frn.lib("libKepler","UserInfo(1)");								fileSavePath = "C:\Basura";				Inicializa();								ConfiguraControlesOpcion();			}												fun Inicializa(){			var tmpval;				// Our code 				// Revisa y Carga en Variables los Parametros Recibidos en la corrida				if( frn.nParam() == 6 ){ //Se han mandado par?metros a la p?gina                    gen_doc=trim(frn.param(0));                     nat_doc=trim(frn.param(1));                     gpo_doc=trim(frn.param(2));                    tip_doc=trim(frn.param(3));                     tip_ope=trim(frn.param(4));                    uen=trim(frn.param(5));                    tip_ope_original=tip_ope; /*220726*/            } else {               frn.message("Operacion no valida ...", "Mensaje","&Aceptar");               //frn.open("anuncios",4);               frn.open("redirect",2);			      return;            }            				if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					if(tip_ope &= "C"){ //CONSULTA						frn.set("operacion","CONSULTA");					} else {											frn.message("Operacion no valida ...", "Mensaje","&Aceptar");						//frn.open("anuncios",4);						frn.open("index",4);						return;					}				}								//Llenar combo sucursales				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";					}				}				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ven_traspasoinventariosucursales.Inicializa()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",cuboQuery);				//Llenar combo sucursales origen y destino				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";								cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ven_traspasoinventariosucursales.Inicializa()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_sucn_origen",cuboQuery);				frn.set("k_sucn_destino",cuboQuery);                rstXml(cuboQuery);								// Fill Combo Tipo (Con Query FTO Kepler) 				frn.setX("Traspaso de Inventario entre Sucursales","k_tipon",0,0);								frn.set("k_fecha",sys.date());									// Fill k_docto | referencia docto	//			ArmarRefDocto();			}						// Armado del Docto Referencia			fun ArmarRefDocto {				var cadena,tmpFolio, tmpGrupo, tmpTipo;				tmpFolio = frn.get("k_folio");				// //tmpFolio = frn.lib("libGeneral.kpl","PadLeft",tmpFolio,"7","0");				tmpFolio = PadLeft(tmpFolio,"7","0");				tmpGrupo = PadLeft(gpo_doc,"2","0");				tmpTipo = PadLeft(tip_doc,"3","0");				//cadena = trim(gen_doc) & trim(nat_doc) & trim(gpo_doc) & trim(tip_doc) & "-" & tmpFolio;				cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;				frn.set("k_docto", cadena);			}						fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;                var nReg = strlen(pText);                for (var cont = nReg; cont < pRelleno; cont++) {                        Resultado = pCaracterRelleno & Resultado;                }                Resultado = Resultado & pText;                                return Resultado;         }                  fun ObtenerInventario(){				suc_origen = frn.get("k_sucn_origen",-1,1);				cmdQuery = "select c2 as inventario, c4 as Descripcion, c5 as Serie from keplersc.kdinf where c1 = '" & suc_origen &  "' and c31 =20 and c32 = 0 ";				cmdQuery = cmdQuery & " order by c2 asc ";									borrar_datos_vehiculo();									frn.dialog("genlistafiltrosel","Inventarios",cmdQuery,"inventario","k_claveinv","0","","N");			}         fun MostrarInventario(){				var xmlRequest,inventario,cmd,ok,cuboResultados,mensajeError,tipo_compra,folio_compra;					 			   suc_origen = frn.get("k_sucn_origen",-1,1);				inventario = frn.get("k_claveinv");				resVal = 1;				borrar_datos_vehiculo();				ValidaInventario();				if(resVal == 0){					return;				} 			   cmd = "select c3,c4,c5,c15,c87 from keplersc.kdinf where c1 = '" & suc_origen &  "' and c2 = '" & frn.get("k_claveinv") & "' and c31 =20 and c32 = 0 ";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspasoinventariosucursales.MostrarInventrio()");					if (nXml(cuboResultados) == 0 ){					frn.message("Criterios no encontrados","Criterios no encontrados","Aceptar");					frn.rst("k_claveinv");					return;				}						frn.set("k_serievehiculo",getXmlAtt(cuboResultados,"r0","c5"));				frn.set("k_clavevehiculo",getXmlAtt(cuboResultados,"r0","c3"));				frn.set("k_descripcion",getXmlAtt(cuboResultados,"r0","c4"));                            if (mid(inventario,7,1) &= "N"){					frn.set("k_anio",getXmlAtt(cuboResultados,"r0","c15"));            } else{               frn.set("k_anio",getXmlAtt(cuboResultados,"r0","c87"));            } 								rstXml(cuboResultados);								//Obtiene folio de compras		--MSS 30042025 no considerar la sucursal para obtener datos de la compra				cmd = "select c8 as tipo_compra, c9 as folio_compra from keplersc.kdeinv where c2 = '" & frn.get("k_claveinv") & 					"' and c5 ='X' and c6='A' and c7=6 order by c1,c2,c3 desc limit 1";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspasoinventariosucursales.MostrarInventrio()");				if (nXml(cuboResultados) == 0 ){					frn.message("No se encontro informacion del folio de compra en KDEINV","Criterios no encontrados","Aceptar");					return;				}						tipo_compra = getXmlAtt(cuboResultados,"r0","tipo_compra");				folio_compra = getXmlAtt(cuboResultados,"r0","folio_compra");								rstXml(cuboResultados);				cmd = "select c14 as k_iva,c16 as k_monto,c54 as monto_extra4 from keplersc.kdm1 where c2 ='X' and c3='A' and c4=6 and " &					"c5 =" & tipo_compra & " and c6 ='" & folio_compra & "' and c100='" & frn.get("k_claveinv") & "'";				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspasoinventariosucursales.MostrarInventrio()");				if (nXml(cuboResultados) == 0 ){					frn.message("No se encontro informacion en KDM1","Criterios no encontrados","Aceptar");					return;				}						k_iva = getXmlAtt(cuboResultados,"r0","k_iva");				k_monto = getXmlAtt(cuboResultados,"r0","k_monto");				monto_extra4 = getXmlAtt(cuboResultados,"r0","monto_extra4");				         }        			         fun borrar_datos(){				frn.set("k_sucn_origen",1,1);				frn.set("k_sucn_destino",1,1);				frn.set("k_claveinv", "");				borrar_datos_vehiculo();			}			fun borrar_datos_vehiculo(){				frn.set("k_serievehiculo", "");            frn.set("k_clavevehiculo", "");				frn.set("k_descripcion", "");            frn.set("k_anio", "");			}									fun ConfiguraControlesOff() {				frn.setAtt("k_sucn_origen", "modify", "N");				frn.setAtt("k_sucn_destino", "modify", "N");				frn.setAtt("bot_inventario", "visible", "N");								frn.setAtt("k_claveinv", "modify", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											}						fun ConfiguraControlesOpcion() {							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta					frn.setAtt("k_sucn_origen", "modify", "Y");					frn.setAtt("k_sucn_destino", "modify", "Y");								frn.setAtt("k_claveinv", "modify", "Y");					frn.setAtt("bot_inventario", "visible", "Y");					frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");													}			}									fun LimpiaEncabezado {				if(tip_ope &= "A"){ 					frn.set("k_folio", "");					frn.set("k_docto", "");				}				frn.set("k_fecha", "");			}									fun CambiaSucursal {							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} 					}								}								LimpiaEncabezado();				borrar_datos();				frn.set("k_fecha",sys.date());							//				ArmarRefDocto();										} // END -	Fun - CambiaSucursal 									fun CambiaTipo {							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} 					}								}								LimpiaEncabezado();				borrar_datos();								frn.set("k_fecha",sys.date());				//				ArmarRefDocto();											} // END -	Fun - CambiaTipo 			         fun ValidarDatos() {            var totReg,str,nReg,CveInv;            //Obtener variables            suc_origen = frn.get("k_sucn_origen",-1,1);            suc_destino = frn.get("k_sucn_destino",-1,1);            CveInv = frn.get("k_claveinv");                         //Validar sucursal            if (suc_origen &=suc_destino){					frn.setPos("k_sucn_destino");               resVal=0;               frn.message("La sucursal origen y destino no puede ser la misma","Error","Aceptar");               return;	            }            //Validar inventario            if (CveInv &=""){					frn.setPos("k_claveinv");               resVal=0;               frn.message("Es necesario seleccionar un inventario","Error","Aceptar");               return;	            } else {               ValidaInventario();            }					if (frn.get("k_serievehiculo") &=""){					frn.setPos("k_claveinv");                    resVal=0;                    frn.message("Falta el no. de serie del inventario","Error","Aceptar");                    return;				}				if (k_monto ==0){					frn.setPos("k_claveinv");                    resVal=0;                    frn.message("No se obtuvo el valor del inventario, reporte a sistemas","Error","Aceptar");                    return;				}			}				fun ValidaInventario(){					cmdQuery="select c31,c32 from keplersc.kdinf where c1 = '" & suc_origen &  "' and c2 = '" & frn.get("k_claveinv") & "' and c31 =20 ";                    rstXml(cuboQuery);				                    cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"ven_traspasoinventariosucursales.ValidarDatos()");                    ok=getXmlAtt(cuboQuery,"ok");                    if(ok &! "" && !ok){                        mensajeError = getXmlAtt(cuboQuery,"native3");                        mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);                        frn.message(mensajeError,"Error","Aceptar");                        return;                    }                    if (nXml(cuboQuery) == 0 ){                        frn.message("El inventario no esta disponible o no existe.","Error","Aceptar");                        resVal=0;                        return;                    }                    if(getXmlAtt(cuboQuery,"r0","c32") &= "10"){                        frn.message("El inventario ya tiene registrado un pedido, imposible realizar traspaso","Error","Aceptar");                        resVal=0;                        return;                    }					if(getXmlAtt(cuboQuery,"r0","c32") &= "20"){                        frn.message("El inventario ya tiene registrada una factura, imposible realizar traspaso","Error","Aceptar");                        resVal=0;                        return;                    }					if(getXmlAtt(cuboQuery,"r0","c32") &= "30"){                        frn.message("El inventario ya tiene registrada una factura de PVA, imposible realizar traspaso","Error","Aceptar");                        resVal=0;                        return;                    }					if(getXmlAtt(cuboQuery,"r0","c32") &= "40"){                        frn.message("El inventario tiene documentos registrados, imposible realizar traspaso","Error","Aceptar");                        resVal=0;                        return;                    }					if(getXmlAtt(cuboQuery,"r0","c32") &= "50"){                        frn.message("El inventario tiene una nota de descuento registrada, imposible realizar traspaso","Error","Aceptar");                        resVal=0;                        return;                    }					if(getXmlAtt(cuboQuery,"r0","c32") &= "60"){                        frn.message("El inventario tiene un vale de salida registrado, imposible realizar traspaso","Error","Aceptar");                        resVal=0;                        return;                    }					if(getXmlAtt(cuboQuery,"r0","c32") &= "70"){                        frn.message("El inventario tiene un traspaso a otra agencia externa, imposible realizar traspaso","Error","Aceptar");                        resVal=0;                        return;                    }			}			//---------------------------------------EJECUTA---------------------------------			fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			var resultado, mensaje, adicionales, folio;							fecha = sys.date();			hora= sys.time();							if (tip_ope &= "A") {							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok				resVal = 1;				ValidarDatos();				if(ok &! "1" || resVal == 0){					return;				}				continua = frn.message(" Desea continuar?","Atencion",2);				if (continua == 0){ 					return;				}													xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;				setXml(xmlPantalla,"k_tipon","r1",gen_doc);				setXml(xmlPantalla,"k_tipon","r2","naturaleza_reemplazable");				setXml(xmlPantalla,"k_tipon","r3",gpo_doc);				setXml(xmlPantalla,"k_tipon","r4",tip_doc);				setXml(xmlPantalla,"k_iva",k_iva);				setXml(xmlPantalla,"k_monto",k_monto);				setXml(xmlPantalla,"k_montoext4",monto_extra4);								setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);														//DETALLE GRABARLOS EN KDUSRACCESS				setXml(xmlPantalla,"detalle_movto",CadenaMovto());										frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaTraspInv"); 				cmdQuery="SELECT * FROM  keplersc.ven_cambio_sucursal_inventario('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cuboQuery);				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"ven_traspasoinventariosucursales.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCobros");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");				adicionales = getXml(cuboQuery,"adicionales");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					frn.set("k_folio", mensaje); //					frn.set("operacion", "CONSULTA");					frn.set("k_docto", adicionales);					strMsg = "El Folio de entrada de inventario fue: " & mensaje & "|El Folio de salida de inventario fue: " & adicionales;					ConfiguraControlesOff(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");               				} else {					frn.message(mensaje, "Error", "Aceptar");				}			}						}				fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"ven_traspasoinventariosucursales.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);		}									fun CadenaMovto(){			var strTraspaso,CveInv;			suc_origen = frn.get("k_sucn_origen",-1,1);            suc_destino = frn.get("k_sucn_destino",-1,1);            CveInv = frn.get("k_claveinv");			strTraspaso= "Realizo movto Suc:"& frn.get("k_sucn",-1,1) & " Suc. origen:" & suc_origen & " Suc. destino:" & suc_destino & " No. Inventario: " & CveInv;						return strTraspaso;		}		//--------------------------------------------------------------EXTRAS---------------------------------------------------							fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    				1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 				2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 				3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				// var tip_ope; 				var tip_oper;				if(iModo==0)					page=pag; 				else if(iModo==2&&(strlen(par0)>0)){					//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     			}													} // End of class Main			</script></pag>