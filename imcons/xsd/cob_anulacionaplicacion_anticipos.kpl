<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	    <tab/><txt fnt=",22" clr="0,0,0">Anulacion Aplicacion de Anticipos</txt><br/>	    <tab/><hLine clr="0,0,0"/> 	    <br/> <br/>		<!-- <grp dim="46,9,7,12" -->	    <tab/>        <grp dim="48,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros"><tab/><txt>Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>			<br/><tab/><txt>Tipo :       </txt>			<cmb id="k_tipon" dim="52,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="CambiaTipo()"/>			<br/><tab/><txt>Fecha : </txt> <sp n="2"/> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" clrBrdr="255,255,255" available="Y" modify="N"/> 			<sp n="1"/> <tab n="1"/><inp id="statusdoc" clr="64,64,64"  dim="25,1" brdr="0,1" fnt=",16b" available="N"/><tab/><inp id="datcfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="3,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" nc="1" modify="Y" available="Y" visible="N"/>					</grp>			<grp dim="36,8,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle Documento">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="Y" fnt=",18b" just="C"/><tab/> <br/>			<txt id="textFolio" visible="N">  Folio :  </txt>					<edt id="k_folio" dim="30,1" brdr="2,0" nc="10" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" visible="N"                 OnF9="ObtenerFolio()" OnChange="Formar_folio()" OnButton="ObtenerFolio()"/> 			<tab n="2"/><img id="buscar" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="BuscarFolio()" available="N" clrBrdr="0,0,0" visible="N"/>						<br/>			<sp n="1"/>			<inp id="k_docto" dim="37,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="N" visible="Y" fnt=",16b" just="C"/>						<br/>					</grp>	    <br/><br/><tab/>		<grp dim="84,5,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Documento a anexar">				<sp n="2"/><tab/> <txt>Folio aplicacion anticipo : </txt> 			<sp n="1"/> 			<edt id="k_foliodocto" clr="64,64,64" clrBrdr="255,255,255"  dim="20,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "Y" modify="Y" 				OnF9="ObtenerFolioAplicacion()" OnButton="ObtenerFolioAplicacion()" OnChange="Formar_folio_aplicacion()" tooltip="Folio de la aplicacion de anticipo"/>   			<tab n="1"/>			<img id="BuscarFolAntic" dim="20,20" bPx="1" brdr="0,1" available="Y" img="_20_Find.png" OnEnter="BuscarFolioAplicacion()" visible="Y"/>			<sp n="3"/>			<inp id="strfolioanticipo" clr="64,64,64" clrBrdr="255,255,255"  dim="7,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "N" modify="Y" visible="N"						OnChange="SeparaFolio(strfolioanticipo)"/>			<sp n="2"/>			<inp id="k_natdocto" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "Y" modify="Y" visible="N"					 tooltip="Naturaleza del documento a anexar"/>			 			<sp n="2"/>		 			<inp id="k_gpodocto" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "Y" modify="Y" visible="N"					 tooltip="Grupo del documento a anexar"/>					 			<sp n="2"/>		 			<inp id="k_tipodocto" clr="64,64,64" clrBrdr="255,255,255"  dim="5,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="capital" available = "Y" modify="Y" visible="N"					 tooltip="Tipo del documento a anexar"/>				 		</grp>			 		<br/>		<br/>		<tab/>		<grp dim="84,15,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Factura">            <tab/><txt>Factura:   </txt>			<edt id="k_facturaini" dim="20,1" brdr="2,0" nc="10" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string"  available="Y" visible="Y" OnF9="ObtenerFactura()" OnChange="Formar_folio_factura()" OnButton="ObtenerFactura()" modify="Y"/> 			<!--<sp n="1"/><img dim="20,20" id="bot_folio_cobro" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="BuscarFactura()" available="Y" clrBrdr="0,0,0" visible="Y"/>-->			<tab n="3"/><txt>Importe:</txt>                <inp id="k_total_factura" clr="64,64,64"  dim="15,1" nd="2" fnt="Arial,16" type="number"  modify="N" available="Y"/><sp/>						<br/>             <grp dim="39,11,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">                <sp n="1"/><tab/> <txt clr="0,58,112" hk="P">Cliente: </txt><tab/>                <edt id="k_clave" clr="64,64,64" clrBrdr="255,255,255"  available="Y" dim="20,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16"	OnChange="BuscarCliente()"	type="capital" nc="7"  modify="N" hk="C"/>                 <sp n="5"/> <inp id="c_dias" clr="64,64,64"  dim="4,1" fnt="Arial,16" type="string" nc="4" modify="N" available="N" visible="N"/>                <br/>                <sp n="1"/><tab/> <txt>RFC : </txt> <sp n="3"/>                <inp id="k_rfc" clr="64,64,64"  dim="20,1" fnt="Arial,16" type="string" nc="16" modify="N" available="N" brdr="2,0" clrBrdr="255,255,255" bclr="255,255,255"/>			                <br/>			            </grp>            <grp dim="75,11,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" hSpace="4" clrBrdr="0,58,112" brdr="1,5" fnt="Arial,16">                <sp n="2"/><txt>Datos del cliente : </txt>                <br/>                <sp n="2"/>                <inp id="k_nombrecli" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>                <br/>                <sp n="2"/>                <inp id="k_callecli" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>                <br/>                <sp n="2"/>                <inp id="k_coloniacli" clr="64,64,64" clrBrdr="255,255,255"  dim="70,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/>                <br/>                <sp n="2"/>                <inp id="k_poblacioncli" clr="64,64,64" clrBrdr="255,255,255"  dim="50,1" fnt="Arial,16" type="string" modify="N" available="N" nc="70" visible="Y"/><tab/>                <inp id="k_cp" clr="64,64,64"  dim="10,1" fnt="Arial,16" type="string" nc="5" modify="N" available="N"/>            </grp>         </grp>  		<br/><br/>	        <tab/>			<grp id="grpconceptosextras" dim="84,13,7,12" bclr="236,240,243" brdr="0,5" 			clrBrdr="0,58,112" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" fnt=",0" tit="Datos Anticipos"><tab/>            <grp dim="70,11,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">							<tbl id="k_mov" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" 				bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="67,7"  hk="z"  Reorder="N" modify="N" available="Y">										<col id="gen_anticipo" name="G"  type="string"  visible="N"/> 			        <col id="nat_anticipo" name="N"  type="string"  visible="N"/> 			        <col id="gpo_anticipo" name="Gpo"  type="string"  visible="N"/>			        <col id="tpo_anticipo" name="Tpo"  type="string"  visible="N"/>                    <col id="k_factura" name="Folio"  type="string"  modify="N" OnActive="consulta_comentarios()"/>                    <col id="k_vencimiento_factura" name="Fecha"  type="date"  modify="N" OnActive="consulta_comentarios()" nc="-1" fmt="DD/MM/CCYY"/>	                    <col id="k_monto_factura" name="Monto" nd="2"  type="number" OnActive="consulta_comentarios()"/>                    <col id="k_iva_factura" name="IVA"  type="number" nd="6" min="0" modify="N" OnActive="consulta_comentarios()"/>                    <col id="referencia" name="Referencia"  type="string"  modify="N" OnActive="consulta_comentarios()"/>                    <col id="estatus" name="Estatus"  type="string"  modify="N" visible="Y" OnActive="consulta_comentarios()"/>                     <col id="cmnts_anticipo" name="Observaciones"  type="string"  visible="N" modify="N" OnActive="consulta_comentarios()"/>						</tbl>            </grp>            <grp dim="46,11,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16"> <txt clr="0,58,112">Notas Anticipo:</txt><br/>				<sp n="1"/> <inp id="comentarios_anticipo" clr="64,64,64" clrBrdr="255,255,255"  dim="44,5" brdr="2,0" fnt="Arial,16" nr="3,60"  type="capital" nc="60" bclr="255,255,255" available="Y" modify="N"/>								            </grp>    		</grp><br/>		<tab/>			<grp dim="84,14,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">						<grp dim="70,14,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">							<sp n="1"/><tab/> <txt>M&#233;todo de Pago: </txt> 				<sp n="2"/> <inp id="k_m_pago" clr="64,64,64" clrBrdr="255,255,255"  dim="8,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16"   modify="N" available="Y" type="string"/>				<sp n="2"/> <inp id="k_vence" clr="64,64,64" clrBrdr="255,255,255"  dim="18,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16"   visible="N" type="string" available="N" modify="N"/>				<br/>				<sp n="1"/><tab/>                <txt>Forma de Pago: </txt> 				<sp n="3"/>		                <cmb id="k_f_pago" dim="35,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="Y"  modify="N"/>				<br/>                <sp n="1"/><tab/><txt>Uso del CFDI : </txt>                <tab/><sp n="2"/>                <inp id="k_cfdi" clr="64,64,64" clrBrdr="255,255,255"  dim="8,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  modify="N" available="Y" type="string"/>								<br/>				<sp n="1"/><tab/> <txt>Correo Electr&#243;nico :</txt>                 <inp id="k_correoelectronico" clr="64,64,64" clrBrdr="255,255,255"  dim="60,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16"  modify="N" available="Y"/>                <br/>                <tab/><txt> N O T A S : </txt><sp n="1"/><inp id="k_err" dim="50,1" clr="132,20,7" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="140" fnt="Arial,16" visible = "N"/>				<br/>				<sp n="1"/><tab/><inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="66,2" brdr="2,0" fnt="Arial,16" modify="Y" available="Y" type="capital" bclr="255,255,255"/>	                			</grp>			<tab/>			<grp dim="80,13,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16">                <tab n="3"/> <txt>Antes de IVA : </txt><sp n="1"/><tab/>                <inp id="subt" clr="64,64,64"  dim="15,1" nd="2" fnt="Arial,16" type="number"  modify="N" available="Y"/>				<br/>				<tab n="3"/><txt>IVA :</txt> <sp n="3"/><tab n="3"/> 				<inp id="k_iva" clr="64,64,64"  dim="15,1" fnt="Arial,16" type="number" nd="6" modify="N" available="Y" OnChange="CalculaTotales(1)"/>				<br/>                <tab n="3"/> <txt fnt=",16b">Importe :</txt><tab n="2"/>                 <inp id="k_monto" clr="64,64,64"  dim="15,1" fnt=",16b" type="number" nd="2" modify="N" available="Y" clrBrdr="255,255,255"/>                <br/><br/><tab n="3"/>                <txt>Saldo actual:</txt><tab n="2"/>                 <inp id="k_saldo" clr="64,64,64"  dim="15,1" fnt=",16" type="number" nd="2" modify="N" available="Y" clrBrdr="255,255,255"/><br/><br/><tab n="8"/>				<img id="Cancelar" dim="35,35" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="borrar_datos()" tooltip="Cancelar / Limpiar" available="Y" clrBrdr="0,0,0" visible="Y"/>				<sp n="3"/>				<img id="Aceptar" dim="35,35" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Aceptar documento &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			</grp>						<br/>											   		</grp>			<br/>		<br/>							</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario,asterisco,anio_contable;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, cliente_id , refer_id, resVal;			var str_uuid, fecha_uuid, rfc_uuid, total_uuid, rfc_receptor_uuid ;					var  saldo, cargos_factura, abonos_factura, cargos_iva_factura, abonos_iva_factura;			var fecha_baja, estatus_doc,gendocto,natdocto,gpodocto,tipdocto  ;						var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, uen;                  var row_grid, err_data, err_empty;			// Vart Reports			var cmd, xmlResQuery, strTmp;			var sucursal, fech_oper, tipo_auto, xmlPar;													fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";				suc_usuario = frn.lib("libKepler","UserInfo(1)");								fileSavePath = "C:\Basura";				Inicializa();								ConfiguraControlesOpcion();			}												fun Inicializa(){			var tmpval;				// Our code 				// Revisa y Carga en Variables los Parametros Recibidos en la corrida				if( frn.nParam() == 6 ){ //Se han mandado par?metros a la p?gina                    gen_doc=trim(frn.param(0));                     nat_doc=trim(frn.param(1));                     gpo_doc=trim(frn.param(2));                    tip_doc=trim(frn.param(3));                     tip_ope=trim(frn.param(4));                    uen=trim(frn.param(5));                    tip_ope_original=tip_ope; /*220726*/            } else {               frn.message("Operacion no valida ...", "Mensaje","&Aceptar");               //frn.open("anuncios",4);               frn.open("redirect",2);			      return;            }            //Tipo de docto de aplicacion            gendocto = "U";            natdocto = "A";            gpodocto = "81";            				if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					if(tip_ope &= "C"){ //CONSULTA						frn.set("operacion","CONSULTA");					} else {											frn.message("Operacion no valida ...", "Mensaje","&Aceptar");						//frn.open("anuncios",4);						frn.open("index",4);						return;					}				}								//Llenar combo sucursales				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmdQuery = cmdQuery & " where c1='" & suc_usuario & "'";					}				}				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cob_aplicacion_anticipos.Inicializa()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",cuboQuery);									// Fill Combo Tipo (Con Query FTO Kepler) 				LlenaCmbTipo();									// Fill Combo forma de pago(Con Query de PostgreSQL)				cmdQuery = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdf3fp";				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cob_AltadeCobros_crud.Inicializa()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_f_pago",cuboQuery);					frn.set("k_f_pago",descr_combo("k_f_pago",1, "30"));								frn.set("k_fecha",sys.date());									tip_doc = frn.get("k_tipon",-1,4); // 221005								// Fill k_docto | referencia docto				ArmarRefDocto();								LimpiaDatosCli();				frn.set("datcfdi","N");		//Pantalla validacion CFDI			}						fun LlenaCmbTipo(){				cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm 								where col_sucursal='" & frn.get("k_sucn",-1,1) & "' and c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' order by c4" ;				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cob_AltadeCobros_crud.Inicializa()");				//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboTipoDocto");						ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error BD","Aceptar");					return;				}				frn.set("k_tipon",getXml(cuboQuery));			}							// Armado del Docto Referencia			fun ArmarRefDocto {				var cadena,tmpFolio, tmpGrupo, tmpTipo;				tmpFolio = frn.get("k_folio");				tmpFolio = PadLeft(tmpFolio,"7","0");				tmpGrupo = PadLeft(gpo_doc,"2","0");				tmpTipo = PadLeft(tip_doc,"3","0");				//cadena = trim(gen_doc) & trim(nat_doc) & trim(gpo_doc) & trim(tip_doc) & "-" & tmpFolio;				cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;				frn.set("k_docto", cadena);			}						fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         }                           fun borrar_datos(){				frn.set("k_clave", "");				frn.set("k_facturaini", "");				frn.set("k_saldo", "");				frn.set("k_total_factura", "");				LimpiaDatosCli();				frn.rst("k_mov");                frn.set("comentarios_anticipo", "");				LimpiaDatosDoc();				LimpiaTotalesDoc();				}											         fun LimpiaDatosCli() {         				frn.set("k_rfc", "");				frn.set("k_cp", "");				frn.set("k_nombrecli", "");				frn.set("k_callecli", "");				frn.set("k_coloniacli", "");				frn.set("k_poblacioncli", "");				frn.set("k_m_pago", "");				frn.set("k_cuenta", "");				frn.set("k_cfdi", "");				frn.set("k_correoelectronico", "");				frn.set("k_coment", "");				frn.set("k_vence", "");							}									fun LimpiaDatosDoc() {				frn.set("k_plazo", "");				frn.set("k_f_pago",descr_combo("k_f_pago",1, "30"));				frn.set("k_coment", "");			}						fun LimpiaTotalesDoc() {				frn.set("subt", "");				frn.set("k_iva", "");				frn.set("k_monto", "");			}									fun ConfiguraControlesOff() {								frn.setAtt("textFolio", "visible", "N");				frn.setAtt("k_folio", "available", "N");				frn.setAtt("k_folio", "visible", "N");				frn.setAtt("buscar", "available", "N");				frn.setAtt("buscar", "visible", "N");				frn.setAtt("k_coment", "available", "N");				frn.setAtt("k_coment", "modify", "N");                frn.setAtt("comentarios_anticipo", "modify", "N");                frn.setAtt("comentarios_anticipo", "available", "N");							frn.setAtt("bot_folio_cobro", "visible", "N");								frn.setAtt("k_foliodocto", "modify", "N");											frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											}						fun ConfiguraControlesOpcion() {							ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta									frn.setAtt("k_foliodocto", "modify", "Y");					frn.setAtt("bot_folio_cobro", "visible", "Y");					frn.setAtt("k_coment", "available", "Y");					frn.setAtt("k_coment", "modify", "Y");					frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");					                    frn.setAtt("comentarios_anticipo", "available", "Y");							} else {								frn.setAtt("buscar", "available", "Y");					frn.setAtt("buscar", "visible", "Y");												frn.setAtt("textFolio", "visible", "Y");					frn.setAtt("k_folio", "available", "Y");					frn.setAtt("k_folio", "visible", "Y");					frn.setAtt("k_coment", "available", "Y");                    frn.setAtt("comentarios_anticipo", "available", "Y");				}			}									fun LimpiaEncabezado {				if(tip_ope &= "A"){ 					frn.set("k_folio", "");					frn.set("k_foliodocto", "");					frn.set("k_docto", "");				}				frn.set("k_fecha", "");				LimpiaDatosCli();				frn.set("k_clave", "");				frn.set("k_err", "");			}									fun CambiaSucursal {							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} 					}								}								LimpiaEncabezado();				borrar_datos();				LlenaCmbTipo();				frn.set("k_fecha",sys.date());									tip_doc = frn.get("k_tipon",-1,4); // 221005								ArmarRefDocto();										} // END -	Fun - CambiaSucursal 									fun CambiaTipo {							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","CONSULTA");						} 					}								}								LimpiaEncabezado();				borrar_datos();								frn.set("k_fecha",sys.date());									tip_doc = frn.get("k_tipon",-1,4); 								ArmarRefDocto();											} // END -	Fun - CambiaTipo 															fun BuscarCliente(){				var xmlCli;												sucursal_id = frn.get("k_sucn",-1,1);				cliente_id = frn.get("k_clave");				LimpiaDatosCli();						if (strlen(frn.get("k_clave")) == 0) {					return;				}								if (strlen(frn.get("k_refer")) > 0) {					refer_id = frn.get("k_refer");				} else {					frn.set("k_fecha_exp", "");				}								cmdQuery = "select c10 as k_rfc, c3 as k_nombrecli, c4 as k_callecli, c5 as k_coloniacli, c6 as k_poblacioncli, c27 as k_cp, c16 as k_plazo, c52 as k_m_pago, c53 as k_cfdi, c11 as k_correoelectronico " &									"from keplersc.kdud where c2='" & cliente_id & "'" ;									frn.lib("libGeneral.kpl","FileSave",cmdQuery , fileSavePath & "\cmdQuery");									rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cob_aplicacion_anticipos.BuscarCliente()");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.setPos("k_clave");					frn.message("El cliente no existe","Error","Aceptar");					return;					}				rstXml(xmlCli);				xmlCli=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");				frn.setX(xmlCli);									}							//---------------------------------------EJECUTA---------------------------------			fun Ejecuta() {			var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg, continua;			var resultado, mensaje, folio;							fecha = sys.date();			hora= sys.time();							if (tip_ope &= "A") {							//Validar datos, se inicia variable de modulo resVal, donde se asume que 1 es ok							//Pantalla validacion CFDI				if (frn.get("datcfdi") &= "N"){                    //se le pine objeto de f_pago incorrecto para que no lo cambie					frn.dialog("icfdreview",frn.get("k_sucn",-1,1),frn.get("k_clave"),"Ejecuta","cmb",frn.get("k_f_pago",-1,1),frn.get("k_cuenta"),frn.get("k_m_pago"), "inp", frn.get("k_cfdi"));					return;				}					continua = frn.message(" Desea continuar con la alta?","Atencion",2);				if (continua == 0){ 					frn.set("datcfdi","N");	//Pantalla validacion CFDI					return;				}													xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;				//Agregar usuario, fechay hora de movimiento				strFecha = fnDate("year",fecha) & "-";				strTmp = fnDate("month",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp & "-";				strTmp = fnDate("day",fecha);				if(strlen(strTmp) == 1){					strTmp = "0" & strTmp;				}				strFecha = strFecha & strTmp;											setXml(xmlPantalla,"movimiento","usuario",usuario);				setXml(xmlPantalla,"movimiento","fecha",strFecha);				setXml(xmlPantalla,"movimiento","hora",				frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 				frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));				setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov") -1);				setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);				setXml(xmlPantalla,"ambiente","uen",uen);								//PARAMETRO NECESARIO PARA LA APLICACION DE ANTICIPOS				setXml(xmlPantalla,"ambiente","flag_cobros","ANULACION_APLICA_ANTICIPO");				setXml(xmlPantalla,"k_tabla_mov","kdm5");				//SUSTITUCION				setXml(xmlPantalla,"k_natdocto",natdocto);				setXml(xmlPantalla,"k_gpodocto",gpodocto);				setXml(xmlPantalla,"k_tipodocto",frn.get("k_tipon",-1,4));								//DETALLE DE ANTICIPOS PARA GRABARLOS EN KDUSRACCESS				setXml(xmlPantalla,"detalle_movto",CadenaAnticipos());						frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantallaAnulAplicaAnt"); 				cmdQuery="SELECT * FROM keplersc.docdis('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				//kdb.rst(cuboQuery);				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cob_aplicacion_anticipos.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoCobros");									resultado = getXml(cuboQuery,"resultado");				mensaje = getXml(cuboQuery,"mensaje");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(resultado &= "1") {					tip_ope = "C";					frn.set("k_folio", mensaje); 					frn.set("operacion", "CONSULTA");					strTmp = frn.get("k_docto");					strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;					frn.set("k_docto", strTmp);					strMsg = "El Folio utilizado para esta operacion fue : " & mensaje;					ConfiguraControlesOpcion(); 					frn.message(strMsg, "Mensaje", "Aceptar");					folio = frn.get("k_folio");                    MostrarDatos(folio);				} else {					frn.message(mensaje, "Error", "Aceptar");					frn.set("datcfdi","N");	//Pantalla validacion CFDI				}			 						}						}		//--------------------------------------------------------------CONSULTA FOLIO DOCTO--------------------------------				fun BuscarFolio() {			var folio;			folio = frn.get("k_folio");			ArmarRefDocto();			borrar_datos();			MostrarDatos(folio);								}		fun ObtenerFolio() {			sucursal_id = frn.get("k_sucn",-1,1);			borrar_datos();			frn.set("k_folio","");				cmdQuery = "select dm1.c6 as folio,to_char(dm1.c9, 'DD/MM/YYYY') as fecha, dm1.c16 monto,dm1.c10 as cve_cliente,dm1.c32 as nombre,dm1.c43 as estatus,dm1.c39 folio_aplicacion " &                        "from keplersc.kdm1 dm1 " &                        "where dm1.c1='" & sucursal_id & "' and dm1.c2='" & gen_doc & "' and dm1.c3='" & nat_doc & "' and dm1.c4='" & gpo_doc & "' and dm1.c5 ='" & frn.get("k_tipon",-1,4) & "' " &                        "order by to_char(dm1.c9, 'DD/MM/YYYY') desc";            			frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryfoliomov");							frn.dialog("genlistafiltrosel","Folios de Documentos",cmdQuery,"folio","k_folio","0","","S");					}						fun Formar_folio(){				var xmlReqEst, cubofol, cmd, ok, mensajeError ;				setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_folio"));				setXml(xmlReqEst,"document","k_tipon","r1",frn.get("k_tipon",-1,1));				setXml(xmlReqEst,"document","k_tipon","r2",frn.get("k_tipon",-1,2));				setXml(xmlReqEst,"document","k_tipon","r3",frn.get("k_tipon",-1,3));				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);								cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_aplicacion_anticipos.Formar_folio()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_folio", fol);		}									fun MostrarDatos(nFolio) {					var xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError,   ;			var tmpXml, contDet, xmlCurDet, xmlDetConv, xmlDetalle;						sucursal_id = frn.get("k_sucn",-1,1);						cmd= " select m1.c14 as k_iva, m1.c16-m1.c14 as subt,m1.c16 as k_monto, m1.c18 as k_vence, m1.c10 as k_clave, m1.c24 as k_coment,m1.c39 as k_foliodocto, m1.c43 as estatus_doc, m1.c197 as fecha_baja, " &			    "m1.c160 as k_f_pago, m1.c162 as k_m_pago, m1.c164 as k_cfdi, m1.c165 as k_correoelectronico, fac.c6 as k_facturaini,fac.c16 as total_factura " &                "from keplersc.kdm1 m1 " &                "inner join keplersc.kdm1 apl on apl.c1=m1.c1 and apl.c2=m1.c2 and apl.c3=m1.c36 and apl.c4=m1.c37 and apl.c5=m1.c38 and apl.c6=m1.c39 " &				"inner join keplersc.kdm1 fac on fac.c1=m1.c1 and fac.c2=m1.c2 and fac.c3=apl.c36 and fac.c4=apl.c37 and fac.c5=apl.c38 and fac.c6=apl.c39 " &                "where m1.c1='" & sucursal_id  & "' and m1.c2='" & gen_doc  &"' and m1.c3='" & nat_doc & "' and m1.c4='" & gpo_doc & "' and m1.c5='" & frn.get("k_tipon",-1,4) & "' and m1.c6='" & nFolio & "'";				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdQueryMostrarDatos");						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_aplicacion_anticipos.MostrarDatos()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultadosMostrarDatos");					ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			var xml_kdm1  = getXml(cuboResultados,"r0" );						frn.set("k_foliodocto",getXmlAtt(xml_kdm1,"k_foliodocto"));			frn.set("k_facturaini",getXmlAtt(xml_kdm1,"k_facturaini"));			frn.set("k_clave",getXmlAtt(xml_kdm1,"k_clave"));			BuscarCliente();			frn.set("k_coment",getXmlAtt(xml_kdm1,"k_coment"));						var f_pago = getXmlAtt(xml_kdm1,"k_f_pago");			frn.set("k_f_pago",descr_combo("k_f_pago",1, f_pago ));						frn.set("k_m_pago",getXmlAtt(xml_kdm1,"k_m_pago"));			frn.set("k_cfdi",getXmlAtt(xml_kdm1,"k_cfdi"));			frn.set("k_correoelectronico",getXmlAtt(xml_kdm1,"k_correoelectronico"));			frn.set("k_vence",getXmlAtt(xml_kdm1,"k_vence"));			frn.set("k_iva",getXmlAtt(xml_kdm1,"k_iva"));			frn.set("subt",getXmlAtt(xml_kdm1,"subt"));			frn.set("k_monto",getXmlAtt(xml_kdm1,"k_monto"));             frn.set("k_total_factura",getXmlAtt(xml_kdm1,"total_factura"));			fecha_baja = getXmlAtt(xml_kdm1,"fecha_baja");			estatus_doc = getXmlAtt(xml_kdm1,"estatus_doc");							if (estatus_doc &= "C"){	// C=Cancelado				frn.message("El Documento se encuentra cancelado","Error","Aceptar");				frn.set("statusdoc", "CANCELADO");			}else{				frn.set("statusdoc", "");												}			//Consulta anticipos			xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;			frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlConsultaAnulAplicaAnt"); 				cmdQuery="SELECT * FROM keplersc.ven_consanulacion_aplicacion_anticipos('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>','" & frn.get("k_folio") & "')";				frn.lib("libGeneral.kpl","FileSave",cmdQuery, fileSavePath & "\cmdxmlConsAnt");				rstXml(cuboQuery);									cuboQuery= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cob_anulacionaplicacion_anticipos.Ejecuta");								frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\XmlResultadoConsAnt");									ok = getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok) {					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}								rstXml(xmlDetConv);				tmpStr=getXmlAtt(cuboQuery,"r0","ven_consanulacion_aplicacion_anticipos");				rstXml(xmlDetalle);				tmpStr=delScpScn(tmpStr);				setXmlStr(xmlDetalle,tmpStr);				contDet=nXml(xmlDetalle);				for(var y=0; y< contDet; y++){					rstXml(xmlCurDet);					xmlCurDet= getXmlX(xmlDetalle,3,y);											setXml(xmlDetConv,"k_mov","r"&y,xmlCurDet);				}					frn.setX(xmlDetConv);				frn.set("k_saldo",frn.get("k_total_factura"));				frn.set("comentarios_anticipo",frn.get("k_mov",-1,"cmnts_anticipo"));		} //End MostrarDatos()					//----------------------------------------CONSULTA FOLIO APLICACION---------------------------------		fun BuscarFolioAplicacion() {			var factura;			factura = frn.get("k_foliodocto");			borrar_datos();			MostrarDatosFolioAplicacion(factura);								}					fun ObtenerFolioAplicacion() {            var factura;            factura = frn.get("k_foliodocto");			borrar_datos();			sucursal_id = frn.get("k_sucn",-1,1);			cmdQuery = "select dm1.c6 as folio,to_char(dm1.c9, 'DD/MM/YYYY') as fecha, dm1.c16 monto,dm1.c10 as cve_cliente,dm1.c32 as nombre,dm1.c39 as factura, dm1.c43 as estatus " &                        "from keplersc.kdm1 dm1 " &                        "where dm1.c1='" & sucursal_id & "' and dm1.c2='" & gendocto & "' and dm1.c3='" & natdocto & "' and dm1.c4='" & gpodocto & "' and dm1.c5 ='" & frn.get("k_tipon",-1,4) & "' " &                        "order by to_char(dm1.c9, 'DD/MM/YYYY') desc";			frn.lib("libGeneral.kpl","FileSave",cmdQuery ,fileSavePath & "\cmdQueryfoliomov");							frn.dialog("genlistafiltrosel","Folios de anticipos aplicados",cmdQuery,"folio","k_foliodocto","0","","S");					}				fun Formar_folio_aplicacion(){						borrar_datos();					var xmlReqEst, cubofol, cmd, ok, mensajeError ;                setXml(xmlReqEst,"document","k_sucn","r1",frn.get("k_sucn",-1,1));				setXml(xmlReqEst,"document","folio_id",frn.get("k_foliodocto"));				setXml(xmlReqEst,"document","k_tipon","r1",gendocto);				setXml(xmlReqEst,"document","k_tipon","r2",natdocto);				setXml(xmlReqEst,"document","k_tipon","r3",gpodocto);				setXml(xmlReqEst,"document","k_tipon","r4",frn.get("k_tipon",-1,4));				setXml(xmlReqEst,"document","uen",uen);						cmd="select * from keplersc.consulta_folio('" & getXmlStr(xmlReqEst,"EOF:13_10") & "')";				cubofol=  frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_aplicacion_anticipos.Formar_folio_factura()");				var resultado =getXmlAtt(cubofol,"r0", "resultado");				if(resultado &= "0"){					mensajeError = getXmlAtt(cubofol,"r0", "mensaje");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				var fol = getXmlAtt(cubofol,"r0", "mensaje");				frn.set("k_foliodocto", fol);		} 								fun MostrarDatosFolioAplicacion(nFolio) {           //Datos folio aplicacion gendocto=U natdocto=A gpodocto=81					var xmlPoliza,xmlPartidas,totRen,contRen,xmlPantalla,tmpStr, cuboResultados,mensajeError;						sucursal_id = frn.get("k_sucn",-1,1);			cmd= "select dm1.c14 as k_iva, dm1.c16- dm1.c14 as subt, dm1.c16 as k_monto, dm1.c10 as k_clave, dm1.c18 as k_vence, dm1.c24 as k_coment, dm1.c39 as k_facturaini, dm1.c43 as estatus_doc , dm1.c197 as fecha_baja, fact.c16 as total_factura, " &				"dm1.c164 as k_cfdi, dm1.c165 as k_correoelectronico " &				"from keplersc.kdm1 dm1 " &				"inner join keplersc.kdm1 fact on fact.c1=dm1.c1 and fact.c2=dm1.c2 and fact.c3=dm1.c36 and fact.c4=dm1.c37 and fact.c5=dm1.c38 and fact.c6=dm1.c39 " &				"where dm1.c1='" & sucursal_id  & "' and dm1.c2='" & gendocto  &"' and dm1.c3='"& natdocto &"' and dm1.c4='" & gpodocto &"' and dm1.c5='" & tip_doc & "' and dm1.c6='" & nFolio & "'";				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmdQuery");						cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_aplicacion_anticipos.MostrarDatosFactura()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados ,"C:\Basura\cuboResultados");							ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				frn.message(mensajeError,"Error","Aceptar");				return;			}			var xml_kdm1  = getXml(cuboResultados,"r0");			frn.set("k_facturaini",getXmlAtt(xml_kdm1,"k_facturaini"));			frn.set("k_clave",getXmlAtt(xml_kdm1,"k_clave"));			BuscarCliente();			frn.set("k_coment",getXmlAtt(xml_kdm1,"k_coment"));						frn.set("k_f_pago",descr_combo("k_f_pago",1, "30"));						frn.set("k_m_pago","PUE");			frn.set("k_cfdi",getXmlAtt(xml_kdm1,"k_cfdi"));			frn.set("k_correoelectronico",getXmlAtt(xml_kdm1,"k_correoelectronico"));			frn.set("k_vence",getXmlAtt(xml_kdm1,"k_vence"));			frn.set("k_iva",getXmlAtt(xml_kdm1,"k_iva"));			frn.set("subt",getXmlAtt(xml_kdm1,"subt"));			frn.set("k_monto",getXmlAtt(xml_kdm1,"k_monto"));            frn.set("k_total_factura",getXmlAtt(xml_kdm1,"total_factura"));			fecha_baja = getXmlAtt(xml_kdm1,"fecha_baja");			estatus_doc = getXmlAtt(xml_kdm1,"estatus_doc");							if (estatus_doc &= "C"){	// C=Cancelado				frn.message("El Documento se encuentra cancelado","Error","Aceptar");				frn.set("statusdoc", "CANCELADO");			}else{				frn.set("statusdoc", "");			}			rstXml(cmd);			            cmd = "select ant.c2,ant.c3,ant.c4,ant.c5,ant.c6,ant.c9,ant.c16,ant.c14,ant.c11,case when nca.c8=10 and nca.c12 <> '' then 'APLICADO' else 'SELECCIONADO' end ,concat(ant.c24,' ',ant.c25,' ',ant.c26) " &								"from keplersc.kdm1 dm1 " & 								"inner join keplersc.kdf3ncant nca on nca.c1=dm1.c1 and nca.c2 =dm1.c2 and nca.c9 =dm1.c3 and nca.c10 =dm1.c4 and nca.c11 =dm1.c5 and nca.c12=dm1.c6 and nca.c8=10 " &								"inner join keplersc.kdm1 ant on ant.c1=dm1.c1 and ant.c2 =nca.c2 and ant.c3 =nca.c3 and ant.c4 =nca.c4 and ant.c5 =nca.c5 and ant.c6=nca.c6 " &								"where dm1.c1='"&sucursal_id&"' and dm1.c2='"&gendocto&"' and dm1.c3='"&natdocto&"' and dm1.c4='"&gpodocto&"' and dm1.c5='"&frn.get("k_tipon",-1,4)&"' and dm1.c6='"&frn.get("k_foliodocto")&"' "&								"order by dm1.c9 desc";								frn.lib("libGeneral.kpl","FileSave",cmd,"c:\basura\cmdselanticipos");			rstXml(cuboResultados);			cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cob_aplicacion_anticipos.MostrarDatosFactura()");			frn.lib("libGeneral.kpl","FileSave",cuboResultados,"c:\basura\selanticipos");			ok=getXmlAtt(cuboResultados,"ok");			if(ok &! "" && !ok){				mensajeError = getXmlAtt(cuboResultados,"native3");				mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);				frn.message(mensajeError,"Error","Aceptar");				return;			}						if (nXml(cuboResultados) == 0){				frn.message("No hay anticipos seleccionados/aplicados", "Error", "Aceptar");				return;							} else{				frn.setX(cuboResultados,"k_mov");                frn.set("comentarios_anticipo",frn.get("k_mov",-1,"cmnts_anticipo"));			}	            frn.set("k_saldo",frn.get("k_total_factura")-frn.get("k_monto"));										} //End MostrarDatos()        fun consulta_comentarios(){				frn.set("comentarios_anticipo",frn.get("k_mov",-1,"cmnts_anticipo"));			}		fun CadenaAnticipos(){			var strAnticipos;			for (var i=0,n=frn.N("k_mov")-1;i<n;i++) { 				strAnticipos=strAnticipos & frn.get("k_mov",i,"gen_anticipo") & frn.get("k_mov",i,"nat_anticipo") & frn.lib("libGeneral.kpl","PadLeft",frn.get("k_mov",i,"gpo_anticipo"),2,"0") & frn.lib("libGeneral.kpl","PadLeft",frn.get("k_mov",i,"tpo_anticipo"),2,"0") & frn.get("k_mov",i,"k_factura") & " | ";			}			return strAnticipos;		}		//-----------------------------------------------------------TOTALES-------------------------------------------				fun CalcTotal() { 					var monto_facturas =0, iva_facturas=0; 							for (var i=0,n=frn.N("k_mov")-1;i<n;i++) { 				monto_facturas=monto_facturas +frn.get("k_mov",i,"k_monto_factura");				iva_facturas=iva_facturas+frn.get("k_mov",i,"k_iva_factura");			}						frn.set("subt", monto_facturas - iva_facturas, "k_iva" ,iva_facturas, "k_monto", monto_facturas);				}		//--------------------------------------------------------------EXTRAS---------------------------------------------------							fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}									fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){ 				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO    				1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana 				2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna) 				3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje 				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				// var tip_ope; 				var tip_oper;				if(iModo==0)					page=pag; 				else if(iModo==2&&(strlen(par0)>0)){					//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.       					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0; 					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				else if(iModo==3&&(tip_oper>=1)&&(tip_oper<=3))b_valido=0;				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);     			}													} // End of class Main			</script></pag>