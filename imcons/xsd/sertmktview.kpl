<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,15" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<tab/><txt clr="0,0,0" fnt="Arial,22" id="textTmkt">Telemarketing</txt><br/>		<tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/><txt fnt=",18b">Sucursal: </txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="35,36" bclr="255,255,255" 			brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y" OnChange="borrar()"/>		<br/><br/><tab/>			<br/>		<tab/>							<grp id="grpContactos" dim="120,30,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16"		 tit="Contactos asignados sin atender                                                                                                                                           Citas pendientes del dia">			<tab n="23"/><sp n="1"/>			<txt clr="0,58,112">Ultimos 8 d&#237;gitos de la Serie</txt>			<inp id="inp_serie" dim="15,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" nc="8" OnChange="LimpiaCriterio(serie)" modify="Y" available="Y"/>			<br/>			<sp/><hLine dim="108,1,0," clr="0,0,0"/>			<sp n="1"/>			<img id="img_buscar_asignados" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_Registros()" available="Y" clrBrdr="0,0,0"  modify="Y"/>			<sp n="3"/><tab n="16"/>			<img id="buscar_citas_pendientes" dim="20,20" bPx="Y" brdr="0,1"   img="_60_DocRst.png"  OnEnter="buscar_citas_pendientes()" tooltip="actualiza citas pendientes" available="Y" clrBrdr="0,0,0"  modify="Y"/><br/>			<sp/>			<txt clr="0,58,112" hk="S">Motivo</txt>			<cmb id="motivo" clr="64,64,64" clrBrdr="255,255,255"  dim="32,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="LimpiaCriterio(otro)" available="Y" modify="Y"/>						<sp/>						<txt clr="0,58,112" hk="S">Tipo N</txt>			<cmb id="tipo_n" clr="64,64,64" clrBrdr="255,255,255"  dim="10,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="LimpiaCriterio(otro)" available="Y" modify="Y"/>												<tab n="1"/>			<txt>Fecha prog ini:</txt>			<edt id="fecha_prog_ini" dim="12,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_prog_ini" OnF9="Dialog(3,_ks_fecha,fecha_prog_ini)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2" OnChange="LimpiaCriterio(otro)"/>							<tab n="1"/>			<txt>Fecha prog fin:</txt>			<edt id="fecha_prog_fin" dim="12,1"  fmt="DD/MM/CCYY" page="_ks_fecha,fecha_prog_fin" OnF9="Dialog(3,_ks_fecha,fecha_prog_fin)"  bclr="255,255,255" clr="64,64,64" type="date" clrBrdr="255,255,255" type="string" brdr="0,2" OnChange="LimpiaCriterio(otro)"/>			<br/>			<sp/>			<tbl id="tbl_asignados" dim="110,13" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" 				clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" insdel="N" modify="N" Reorder="Y"				OnEnter="AtenderContacto()"  OnMouseD="AtenderContacto()" OnF9="modifica_serie()">								<col id="folio_tmkt" name="Folio tmkt" type="string" nc="10"/>				<col id="fecha_prog" name="Fecha prog" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="serie" name="Serie" type="string" nc="18"/>								<col id="cliente" name="Cliente" type="string" nc="20"/>				<col id="motivo" name="Motivo" type="string" nc="50"/>				<col id="tipo_n" name="Tipo N" type="string" nc="10"/>				<col id="medio_contacto" name="Medio Contacto" type="string" nc="10"/>				<col id="vale_salida_ult_srv" name="Vale_salida/Ult_serv" type="string" fmt="DD/MM/YYYY"/>				<col id="obs1" name="Obs1" type="string"/>				<col id="obs2" name="Obs2" type="string"/>				<col id="folio_cita" name="Folio Cita" type="string" nc="10"/>				<col id="fecha_cita" name="Fecha Cita" type="string"  fmt="DD/MM/YYYY"/>				<col id="hora_cita" name="Hora Cita" type="string" nc="10"/>							</tbl>						<sp n="4"/><tbl id="tbl_citas_pendientes" dim="55,12" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" Reorder="Y" nren="fijo" insdel="N">							<col id="estatus" name="Estatus" type="string"/>				<col id="folio_cita" name="Folio Cita" type="string" nc="10"/>				<col id="fecha" name="Fecha" type="string"  fmt="DD/MM/CCYY"/>				<col id="hora" name="Hora" type="string" nc="8"/>				<col id="serie" name="Serie" type="string" nc="15"/>					<col id="cliente" name="Cliente" type="string"/>					</tbl>							<br/>			<sp/><bot id="bot_contacto" dim="18,0" brdr="5" text="Atender" OnEnter="AtenderContacto()"/>					<tab n="28"/>				<img id="Exportar" dim="35,35" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(tbl_asignados)" available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Guardar tabla"/>																<tab n="18"/>				<img id="Exportar" dim="35,35" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(tbl_citas_pendientes)" available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Guardar tabla"/>										</grp>		<br/><br/>		<tab/>					<grp id="grpAtendidos" dim="120,26,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" 		tit="Contactos atendidos                                                                        Citas Concretadas                                                             Panorama Equipo">			<br/>			<sp/><txt>Semana del: </txt>			<edt id="fec_ini" dim="12,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" 				fnt="Arial,16" type="date" page="_ks_fecha,fec_ini" OnF9="Dialog(3,_ks_fecha,fec_ini)"/><txt>Al:</txt>			<edt id="fec_fin" dim="12,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" 				fnt="Arial,16" type="date" page="_ks_fecha,fec_fin" OnF9="Dialog(3,_ks_fecha,fec_fin)"/>							<sp n="2"/>			<img id="img_buscar_atendidos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="MostrarHistorico()" available="Y" clrBrdr="0,0,0"  modify="Y"/>			<br/>			<sp/><tbl id="tbl_atendidos" dim="61,12" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" Reorder="Y" nren="fijo" insdel="N">				<col id="folio_tmkt" name="Folio tmkt" type="string" nc="10"/>				<col id="fecha" name="Fecha" type="string"  fmt="DD/MM/CCYY"/>				<col id="hora" name="Hora" type="string" nc="8"/>				<col id="serie" name="Serie" type="string" nc="15"/>					<col id="cliente" name="Cliente" type="string" nc="20"/>						<col id="motivo" name="Motivo" type="string"/>				<col id="resultado" name="Resultado" type="string"/>				<col id="accion" name="Acci&#243;n" type="string"/>				<col id="obs1" name="Obs1" type="string"/>				<col id="obs2" name="Obs2" type="string"/>				<col id="folio_cita" name="Folio Cita" type="string" nc="10"/><col id="tipo_orden" name="Tipo Orden" type="string" nc="4"/><col id="orden" name="Orden" type="string" nc="10"/>							</tbl>								<sp n="2"/><tbl id="tbl_citas_concretadas" dim="52,12" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" Reorder="Y" nren="fijo" insdel="N">							<col id="folio_cita" name="Folio Cita" type="string" nc="10"/>				<col id="orden" name="Orden" type="string"/>				<col id="fecha" name="Fecha" type="string"  fmt="DD/MM/CCYY"/>				<col id="hora" name="Hora" type="string" nc="8"/>				<col id="serie" name="Serie" type="string" nc="15"/>						</tbl>									<sp n="2"/><tbl id="tbl_panorama_equipo" dim="52,12" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" Reorder="Y" nren="fijo" insdel="N">							<col id="asesor" name="Asesor" type="string"/>				<col id="contactos_atendidos" name="Contactos Atendidos"/>				<col id="citas_concretadas" name="Citas Concretadas"/>				</tbl>										<br/>							<tab n="18"/>				<img id="Exportar" dim="35,35" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(tbl_atendidos)" available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Guardar tabla"/>										<tab n="16"/>				<img id="Exportar" dim="35,35" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(tbl_citas_concretadas)" available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Guardar tabla"/>										<tab n="16"/>				<img id="Exportar" dim="35,35" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(tbl_panorama_equipo)" available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Guardar tabla"/>							</grp>		<br/>			</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,sys;			var usuario,suc_usuario,rol_usuario,asterisco;			var resMensaje, cubo, cmd, ok,mensajeError;			var selOperacion;			fun Main() {				frn=new FRNT;				kdb=new KDB;				sys=new SYS;				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";								Inicializa();			}									fun Inicializa(){				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmktview.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_sucn",getXml(cubo));								//Llenar combo motivo				cmd = "select '['||motivo_id||'] '||descripcion as descripcion, motivo_id as clave from keplersc.kdtmktmotivo where motivo_id <> 60 order by motivo_id";						cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmktview.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									var combo = "motivo";					frn.setX("", combo ,0,0);				llenar_cmb(cubo ,combo );								//Llenar combo tipo_n				cmd = "select '['||c2||'] '||c3 as descripcion, c2 as clave from keplersc.kd_tipo_n where c1='" & frn.get("k_sucn",-1,1) & "'";							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmktview.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}					combo = "tipo_n";			   frn.setX("", combo ,0,0);				llenar_cmb(cubo ,combo );								var fechaJul, semTot, semInt, semDec, diasExc, diasAdd;							//Calcular primer dia de la semana, las comisiones se calculan por semana								fechaJul=fnDate("julian",sys.date);				semTot=fechaJul/7;				semInt=math("int",fechaJul/7);				semDec=semTot-semInt;				diasExc=math("round",semDec*7,0);				diasAdd=(diasExc-1) * (-1);				frn.set("fec_ini",fnDate("add",sys.date(),diasAdd));				diasAdd=5+diasAdd;				frn.set("fec_fin",fnDate("add",sys.date(),diasAdd));								frn.set("fecha_prog_fin", sys.date() );								Buscar_Registros();				buscar_citas_pendientes();				MostrarHistorico();			}			fun actualiza_pantalla(){				Buscar_Registros();				buscar_citas_pendientes();				MostrarHistorico();			}			fun borrar(){					frn.rst("tbl_asignados");					frn.rst("tbl_atendidos");			}                     							fun Buscar_Registros(){				var cuboXml, contDet;				frn.rst("tbl_asignados");				cmd="";				var asesor_tmkt = usuario;				var serie_sel = frn.get("inp_serie");				if (serie_sel &!"") {					//En busqueda por serie mostrar el asesor tmkt en columna de serie, s�lo cambiar etiqueta//					cmd="select tmkt.c2 as folio_tmkt, to_char(tmkt.c5, 'DD/MM/YYYY') as fecha_prog, tmkt.c3 as serie, dud.c3 as cliente," 					cmd="select tmkt.c2 as folio_tmkt, tmkt.c5 as fecha_prog, tmkt.c3 as serie, dud.c3 as cliente," & 					"mot.descripcion as motivo, tmkt.c22 as tipo_n, case when tmkt.c23 =0 then 'Llamada' when tmkt.c23 =10 then 'Correo'					when tmkt.c23 =20 then 'Whatsapp' when tmkt.c23 =30 then 'Sms' else 'XX' end as medio_contacto, to_char(tmkt.c26, 'DD/MM/YYYY') as vale_salida_ult_srv, 					tmkt.c11 as obs1, tmkt.c12 as obs2, tmkt.c15 as folio_cita, to_char(ctas.c12, 'DD/MM/YYYY') as fecha_cita,ctas.c13 as hora_cita " & 					"from keplersc.kdtmktser2 tmkt inner join keplersc.kdtmktmotivo mot on mot.motivo_id = tmkt.c7 " &					"left outer join keplersc.kdctasser ctas on ctas.c1='" & frn.get("k_sucn",-1,1) & "' and ctas.c2=tmkt.c15 " &					"left outer join keplersc.kdud dud on dud.c2=tmkt.c20 " &					"where tmkt.c1='" & frn.get("k_sucn",-1,1) & "' and tmkt.c14='" & serie_sel & "' and tmkt.c23=0 and tmkt.c8=0 ";					//Cambiar etiqueta					frn.setAtt("tbl_asignados", "name", "Asesor Tmkt", "serie");									} else {//					cmd="select tmkt.c2 as folio_tmkt, to_char(tmkt.c5, 'DD/MM/YYYY') as fecha_prog, tmkt.c14 as serie, dud.c3 as cliente," &						cmd="select tmkt.c2 as folio_tmkt, tmkt.c5 as fecha_prog, tmkt.c14 as serie, dud.c3 as cliente," & 					"mot.descripcion as motivo, tmkt.c22 as tipo_n, case when tmkt.c23 =0 then 'Llamada' when tmkt.c23 =10 then 'Correo'					when tmkt.c23 =20 then 'Whatsapp' when tmkt.c23 =30 then 'Sms' else 'XX' end as medio_contacto, to_char(tmkt.c26, 'DD/MM/YYYY') as vale_salida_ult_srv, 					tmkt.c11 as obs1, tmkt.c12 as obs2, tmkt.c15 as folio_cita, to_char(ctas.c12, 'DD/MM/YYYY') as fecha_cita,ctas.c13 as hora_cita " & 					"from keplersc.kdtmktser2 tmkt inner join keplersc.kdtmktmotivo mot on mot.motivo_id = tmkt.c7 " &					"left outer join keplersc.kdctasser ctas on ctas.c1='" & frn.get("k_sucn",-1,1) & "' and ctas.c2=tmkt.c15 " &					"left outer join keplersc.kdud dud on dud.c2=tmkt.c20 " &					"where tmkt.c1='" & frn.get("k_sucn",-1,1) & "' and tmkt.c3='" & asesor_tmkt & "' and tmkt.c23=0 and tmkt.c8=0 ";										//Cambiar etiqueta					frn.setAtt("tbl_asignados", "name", "Serie", "serie");					var sel_motivo =  frn.get("motivo",-1,1);					if (sel_motivo &! ""){						cmd = cmd & " and tmkt.c7='" & sel_motivo  & "'";					}					var sel_tipo_n =  frn.get("tipo_n",-1,1); 					if (sel_tipo_n &! ""){						cmd = cmd & " and tmkt.c22='" & sel_tipo_n & "'";					}																var fecha_prog_ini = frn.get("fecha_prog_ini");						if (fecha_prog_ini &! ""){						cmd = cmd & " and tmkt.c5>='" & fecha_prog_ini & "'";					}										var fecha_prog_fin = frn.get("fecha_prog_fin");						if (fecha_prog_fin &! ""){						cmd = cmd & " and tmkt.c5<='" & fecha_prog_fin & "'";					}				}				cmd = cmd & " order by tmkt.c5 desc, tmkt.c26 desc ";				frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmd_queryBUSCAR");				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmkt.buscar_registros()");				frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\cuboAsignados");												ok=getXmlAtt(cuboXml,"ok");												if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;				}											frn.set("tbl_asignados",cuboXml);							contDet = frn.N("tbl_asignados");				for (var contOrd=0; contOrd<contDet ; contOrd++){					if (frn.get("tbl_asignados",contOrd,"folio_tmkt")&!"" && frn.get("tbl_asignados",contOrd,"folio_cita")&=""){						frn.setX("","tbl_asignados",contOrd,"fecha_cita");					}				}								}						fun MostrarHistorico(){					frn.rst("tbl_atendidos");				var asesor_tmkt = usuario ;								var suc = frn.get("k_sucn",-1,1);				var fec_ini = frn.get("fec_ini");				var fec_fin = frn.get("fec_fin");								if (fec_ini &= "" || fec_fin &= ""){					frn.message("Debes seleccionar un rango de fechas","Error","Aceptar");					return;				}							//Mostrar registros				cmd="select tmkt.c2 as folio_tmkt, to_char(tmkt.c10, 'DD/MM/YYYY') as fecha, tmkt.c10::time::text as hora, tmkt.c14 as serie, " &				"dud.c3 as cliente,  coalesce(motivo.descripcion,'---') as motivo, " &				"coalesce(resultado.descripcion,'---') as resultado, " &				"coalesce(accion.descripcion ,'---') as accion,  tmkt.c11 as obs1, tmkt.c12 as obs2, tmkt.c15 as folio_cita, tmkt.c16 as tipo_orden, tmkt.c17 as orden " &				"from keplersc.kdtmktser2 tmkt " &				"left outer join keplersc.kdtmktmotivo motivo on motivo.motivo_id = tmkt.c7 " &				"left outer join keplersc.kdtmktresult resultado on resultado.resultado_id  = tmkt.c8 " &				"left outer join keplersc.kdtmktaccion accion  on accion.accion_id = tmkt.c9 " &				"left outer join keplersc.kdud dud on dud.c2=tmkt.c20 " &				"where tmkt.c1='"& suc & "' " &				"and tmkt.c3 = '" & asesor_tmkt & "' " &				"and tmkt.c8 <> 0 and tmkt.c10>='" & fec_ini & "' and left(tmkt.c10::text,10)<='" & fec_fin & "' and tmkt.c23=0 order by tmkt.c26 desc ";															frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmd_queryATENDIDOS");									rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmktview.MostrarHistorico()");				frn.lib("libGeneral.kpl","FileSave",cubo,"c:\Basura\cuboProgs");										ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("tbl_atendidos",getXml(cubo));														//llenar grid citas concretadas				frn.rst("tbl_citas_concretadas");								cmd  = "select cta.c2 as folio_cita, ord.c2 || '-' || ord.c3 as orden, " &				//" (select string_agg(concat(pn.c5, '(' ,pn.c6 , ')'),',') from keplersc.kdpun as pn where pn.c1=ord.c1 and pn.c2=ord.c2 and pn.c3=ord.c3) as puntos, " &				" to_char(ord.c4, 'DD/MM/YYYY') as fecha, " &				" ord.c5::time::text as hora,cta.c6 as serie from keplersc.kdctasser as cta " &				" inner join keplersc.kdord as ord on ord.c1=cta.c1 and ord.c2=cta.c21 and ord.c3=cta.c22 " &				" where cta.c1='"& suc  & "' " &				" and cta.c3 = '" & asesor_tmkt & "' " &				" and cta.c20= 20 and cta.c12>='" & fec_ini & "' and left(cta.c12::text,10)<='" & fec_fin & "' order by ord.c4 desc, ord.c5 desc";								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmd_cts_concretadas");									rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmktview.MostrarHistorico()");				frn.lib("libGeneral.kpl","FileSave",cubo,"c:\Basura\cuboProgs");										ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("tbl_citas_concretadas",getXml(cubo));																			//llenar grid panorama equipo				frn.rst("tbl_panorama_equipo");								cmd = " select astmkt.c1, " & 			   " (select count(*) from keplersc.kdtmktser2 as cntc " &				" where cntc.c8 <> 0 and cntc.c10  >='" & fec_ini & "' and cntc.c10 <='" & fec_fin & "' " &				" and cntc.c3=astmkt.c1 and cntc.c23=0 ) as contactos_atendidos, " &				" (select count(*) from keplersc.kdctasser as cta " &				" where cta.c20=20 and cta.c12 >='" & fec_ini & "' and cta.c12 <='" & fec_fin & "' " &				" and cta.c3=astmkt.c1 ) as citas_concretadas " &				/*",(select count(*) from keplersc.kdctasser as cta " &				" inner join keplersc.kdpun as pn on pn.c1=cta.c1 and pn.c2=cta.c21 and pn.c3=cta.c22 and pn.c6 = 'S' " &				" where cta.c20=20 and cta.c12 >='" & fec_ini & "' and cta.c12 <='" & fec_fin & "' and cta.c3=astmkt.c1 ) as puntos_s, " &				" (select count(*) from keplersc.kdctasser as cta " &				" inner join keplersc.kdpun as pn on pn.c1=cta.c1 and pn.c2=cta.c21 and pn.c3=cta.c22 and pn.c6 <> 'S' " &				" where cta.c20=20 and cta.c12 >='" & fec_ini & "' and cta.c12 <='" & fec_fin & "' and cta.c3=astmkt.c1 ) as otros_puntos " &*/				" from keplersc.kdsercattmkt as astmkt where c3='A' and c1 <> 'CITASENLINEA' and col_sucursal='" & suc & "' ";								frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\tbl_panorama_equipo");									rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmktview.MostrarHistorico()");				frn.lib("libGeneral.kpl","FileSave",cubo,"c:\Basura\cuboProgs");										ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("tbl_panorama_equipo",getXml(cubo));									}									fun buscar_citas_pendientes(){							var asesor_tmkt = usuario ;							//llenar grid citas pendientes				frn.rst("tbl_citas_pendientes");								cmd  = " ( select 'ON TIME' as estatus,cta.c2 as folio_cita, to_char(cta.c12, 'DD/MM/YYYY') as fecha, " &				" cta.c13::time::text as hora,cta.c6 as serie, ud.c3 as cliente  from keplersc.kdctasser as cta  " &				" inner join keplersc.kdud as ud on ud.c2=cta.c4 " &				" where cta.c1='"& frn.get("k_sucn",-1,1) & "' " &				" and cta.c3 = '" & asesor_tmkt & "' " &				" and cta.c20 <= 10 and (cta.c12 = current_date and cta.c13 >= substring( (current_timestamp - (interval '14 minute'))::text , 12, 5) )  " &				" order by cta.c13 desc )" &				" union " &				" ( select 'LATE' as estatus,cta.c2 as folio_cita, to_char(cta.c12, 'DD/MM/YYYY') as fecha, " &				" cta.c13::time::text as hora,cta.c6 as serie, ud.c3 as cliente  from keplersc.kdctasser as cta  " &				" inner join keplersc.kdud as ud on ud.c2=cta.c4 " &				" where cta.c1='"& frn.get("k_sucn",-1,1) & "' " &				" and cta.c3 = '" & asesor_tmkt & "' " &				" and cta.c20 <= 10 and (cta.c12 = current_date and (cta.c13 >= substring( (current_timestamp - (interval '29 minute'))::text , 12, 5) and  " &				" cta.c13 <= substring( (current_timestamp - (interval '15 minute'))::text , 12, 5)) ) " &				" order by cta.c13 desc )" &				" union " &				" ( select 'NO SHOW' as estatus,cta.c2 as folio_cita, to_char(cta.c12, 'DD/MM/YYYY') as fecha, " &				" cta.c13::time::text as hora,cta.c6 as serie, ud.c3 as cliente  from keplersc.kdctasser as cta  " &				" inner join keplersc.kdud as ud on ud.c2=cta.c4 " &				" where cta.c1='"& frn.get("k_sucn",-1,1) & "' " &				" and cta.c3 = '" & asesor_tmkt & "' " &				" and cta.c20 <= 10  and (cta.c12 = current_date and cta.c13 <= substring( (current_timestamp - (interval '30 minute'))::text , 12, 5) ) " &				" order by cta.c13 desc ) order by hora desc ";												frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\citas_pendientes");									rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmktview.buscar_citas_pendientes()");				frn.lib("libGeneral.kpl","FileSave",cubo,"c:\Basura\cuboProgs");										ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("tbl_citas_pendientes",getXml(cubo));								frn.timer(0,10,"buscar_citas_pendientes()");						}						fun AtenderContacto(){				var foliosel,parametros, continua, xmlPantalla,resultado, mensaje;							foliosel=frn.get("tbl_asignados",-1,"folio_tmkt");				resultado="1";				if(foliosel &= ""){					frn.message("No ha seleccionado un registro v�lido","Mensaje","Aceptar");					return;				}				if (frn.get("inp_serie") &!""){					if (frn.get("tbl_asignados",-1,"serie") &! usuario){						continua = frn.message("La serie seleccionada la tiene asignado: "& frn.get("tbl_asignados",-1,"serie")&"..... Se le asignaran todos los contactos de la serie. Desea continuar?","Advertencia",2);						if (continua == 0){							return;						} else{							//Actualiza asesor_tmkt							xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;							setXml(xmlPantalla,"tbl_asignados","no_partidas",frn.N("tbl_asignados"));							setXml(xmlPantalla,"movimiento","usuario",usuario);													frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\Basura\XmlPantallaContactos");							cmd="SELECT * FROM keplersc.ser_tmkt_reasigna_serie_asesor('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";							rstXml(cubo);								cubo= frn.lib("libGeneral.kpl","EjecutarSql",cmd,"sertmktview.AtenderContacto");											frn.lib("libGeneral.kpl","FileSave",cubo, "C:\Basura\XmlResultadoCambiaAsesor");															resultado = getXml(cubo,"resultado");							mensaje = getXml(cubo,"mensaje");												ok = getXmlAtt(cubo,"ok");							if(ok &! "" && !ok) {								mensajeError = getXmlAtt(cubo,"native3");								mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);								frn.message(mensajeError,"Error","Aceptar");								return;								}							if(resultado &! "1") {								frn.message(mensaje, "Error", "Aceptar");								return;							}																}											}				}				if (resultado &= "1"){					parametros="S," & frn.get("k_sucn",-1,1)&","&foliosel; //Accion de Seguimiento					//frn.configSet("temp","parametros",parametros);					//frn.open("sertmkt",4);						frn.dialog("sertmkt",parametros);				}												}									fun LimpiaCriterio(criterio){				if (criterio &= "serie"){					frn.set("motivo","");					frn.set("tipo_n","");					frn.set("fecha_prog_ini","");					frn.set("fecha_prog_fin","");				} else{					frn.set("inp_serie","");				}			}									fun modifica_serie(accion){							var cmd_ser ="select c4 from keplersc.kdserie where c1='" & frn.get("tbl_asignados", -1, "serie") & "'"; 								var cubo_ser  = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd_ser ,"sertmktview.modifica_serie()");											var ser =getXmlAtt(cubo_ser  ,"r0", "c4");								frn.dialog("cat_serie_crud","Modificar", ser , "n");						}												fun guardar_tabla(tabla){				var nombre_archivo;				if (tabla &= "tbl_asignados"){					nombre_archivo = "asignados_sin_atender";				}else if(tabla &= "tbl_atendidos" ) {					nombre_archivo = "atendidos";				}else if(tabla &= "tbl_citas_pendientes" ) {					nombre_archivo = "citas_pendientes";				}else if(tabla &= "tbl_citas_concretadas" ) {					nombre_archivo = "citas_concretadas";				}else if(tabla &= "tbl_panorama_equipo" ) {					nombre_archivo = "panorama_equipo";				}								var save = frn.saveFile(nombre_archivo ,"Todos los archivos,*.*","_C:","Para guardar archivo");				frn.dialog("guarda_tabla",tabla,save); 			}							fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}										fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}							}	</script></pag>