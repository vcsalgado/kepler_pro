		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="17,10,7,12"	  tit="Comercio exterior"				fnt="Arial,16"><tab n="2"/>
				<img id="bt_Dir3"  dim="60,60" brdr="0,1" img="_60_Doc.png" OnEnter="AddDirCCE" tooltip="Direcci&#243;n fiscal comercio exterior del cliente" available="Y" clrBrdr="0,0,0" bPx="1"/><br/><tab/>
			<txt fnt="Arial,16" clr="0,58,112">Direcci&#243;n fiscal</txt><br/><br/><tab n="2"/>
				<img id="bt_Dir4"  dim="60,60" brdr="0,1" img="_60_Delivery.png" OnEnter="AddDirEntregaCCE" tooltip="Direcci&#243;n de entrega comercio exterior" available="Y" clrBrdr="0,0,0" bPx="1"/><br/><tab/>
			<txt fnt="Arial,16" clr="0,58,112">Direcci&#243;n de entrega</txt><br/><br/>
		</grp><br/><br/><br/>
<!--	Termina	ARN 2016-11-03 -->
	</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,frP,kdb,sys;
			var usuario;
			/* PARÁMETROS (Tienen sentido cuando la opción se ha ejecutado como diálogo.)
			param(0) = Nombre del campo (o tabla) al que se devolverá la clave o descripción en la pantalla padre
			param(1) = (Opcional) Nombre de la columna al que se devolverá la clave en la pantalla padre(Se debe especificar el grid en el parametro anterior)
			param(2) = (Opcional) Bandera binaria de control. Es un string que indica ciertos parámetros de funcionamiento de la opción
							Los caracteres se toman de izquierda a derecha y tienen el siguiente significado:
							Bit 1= Si toma valor de 1, se devuelve la clave. Si toma valor de 0, se devuelve la descripción. Por default se toma valor de 1.
							Bit 2= Si toma valor de 1, permite modificar el catálogo. Si toma valor de 0, no permite modificación. Por default se toma valor de 1.
							Bit 3= Si toma valor de 1, permite insertar/borrar registros. Si toma valor de 0, no permite insertar/borrar. Por default se toma valor de 1.
							Bit 4= Si toma valor de 1, permite cambiar de registro. Si toma valor de 0, no permite cambiar de registro. Por default se toma valor de 1.
							Bit 5= Si toma valor de 1, regresa un cubo de memoria con campos principales de TODOS los registros(para guardar la info en un combo). Si toma valor de 0, solo regresa la clave o descripción. Por default se toma valor de 1.
			param(3) = (Opcional) Función de la pantalla padre a ejecutar antes de regresarle el control.
							
			Valor de retorno = clave o descripción del producto
			*/
			var bit1,bit2,bit3,bit4,bit5;//Banderas de comportamiento (Ver descripción arriba)
			var tabla_base;//Tabla base del catalogo (Se abre con el alias "a")
			var camposDeseados;//Campos de la tabla que se requieren(Ej: a1...a4)
			fun Main(){
				//Recibe como parametros el combo del almacen(strDlg0), y el combo de la sucursal(strDlg1)
				frn=new FRNT; 
				frP=new FRNTP; 
				kdb=new KDB;
				sys=new SYS;
				bit1=1;bit2=1;bit3=1;bit4=1;bit5=1;//Inicializa las banderas con los valores default.
				var bCtrl=trim(frn.param(2));
				if (strlen(bCtrl)>0){ //Se especificó una bandera de control.
					bit1=mid(bCtrl,0,1);bit2=mid(bCtrl,1,1);bit3=mid(bCtrl,2,1);
					bit4=mid(bCtrl,3,1);bit5=mid(bCtrl,4,1);
				}
				if (strlen(trim(frn.param(1)))>0){ bit5=0;}//Si se especifica una columna, no se devolverán todos los registros, solo el actual
				kdb.connect();
				tabla_base="kdud";//Clientes
				
				//kdfedir kdudent 
				camposDeseados="a2...a30";//Ver el comando kdb.rel de abajo para entender s2
				kdb.open("a," & tabla_base);
				kdb.open("v,kduv,j,kduj,k,kduk,e,kdue,s,kdms,f,kdfedir,t,kdudent");
				kdb.open("w,kdlogmov");
				kdb.table("vendedor,v,1,&,v3,v2");
				kdb.table("zona,k,1,&,k2,k1");
				kdb.table("grupo,j,1,&,j2,j1");
				kdb.sp("security","dat");
				kdb.exec();
				usuario=kdb.get("dat","user");
				frn.set("vendedor",kdb.get("vendedor"));
				frn.set("zona",kdb.get("zona"));
				frn.set("grupo",kdb.get("grupo"));
				var valor_inicial=(bit1==1)? frP.get(frn.param(0),-1,0): frP.get(frn.param(0),-1,1);
				if (strlen(trim(frn.param(1)))>0){ 
					valor_inicial=frP.get(frn.param(0),-1,frn.param(1)); 
				}//Se devolverá el valor a una tabla 
				frn.set("clave",valor_inicial);//Se llena la clave si es ventana de diálogo.
				Bus(1);
				if(bit2==0)deshabilita_campos();
			}
			fun camposLlave(){//Campos que forman la llave. Puede ser una llave combinada
				var llave="'" & frn.get("clave") & "'"; 
				if (bit4==0){ setmfy("clave"); } //Desactiva los campos de la llave para que no pueda cambiarse de registro
				return llave;
			}
			fun setData() {
				set("clave","a2"); set("nombre","a3"); set("direccion","a4"); set("colonia","a5"); set("poblacion","a6"); set("tel1","a7"); set("tel2","a8"); set("fax","a9");
				set("rfc","a10"); set("internet","a11");set("limcredito","a15"); set("plazo","a16"); set("desc1","a17"); set("desc2","a18"); set("desc3","a19");
				set("revdia","a20"); set("revhora","a21");set("cp","a27");	set("curp","a30"); set("sventa","a28"); set("scobro","a29");
				set("diapago","a22");set("horapago","a23");
				var gpo="a" & kdb.get("datos","a13") & "b";
				frn.setPos("grupo",-1,1,"internal:Y","val:'" & kdb.get("datos","a13") &"'");
				frn.setPos("vendedor",-1,1,"internal:Y","val:'" & kdb.get("datos","a12") &"'");
				frn.setPos("zona",-1,1,"internal:Y","val:'" & kdb.get("datos","a14") &"'");
				frn.setM("mercancia",kdb.get("datos","a24"),kdb.get("datos","a25"),kdb.get("datos","a26"),);
			}
			fun verifica_borrar(){//Esta función valida si el registro actual se puede borrar. Ej. Un producto NO se puede borrar si hay facturas con ese produccto.
				var cve=camposLlave();
				kdb.table("tmp2,s,1,&,s1");
				kdb.table("cubDirEnt,t,1,'"&frn.get("clave")&"',&,t1,t2");// Traer la informacion de KDUDENT
				
				kdb.exec();
				var num_suc=kdb.n("tmp2");
				for(var i=0;i<num_suc;i++){
					var cmd="tmp,e,1,1,'" & kdb.get("tmp2","r" & i,"s1") & "'," & cve & ",&,e1,e2";
					kdb.search(cmd); kdb.exec();
					if(kdb.get("tmp","e2") &= strSplit(cve,"'",1)){
						Error("Existe al menos un movimiento con este cliente, NO es posible borrarlo");
						return 0;
					}
				}
				return frn.message("Está a punto de borrar el cliente " & frn.get("nombre") & ". ¿Desea Continuar?","Precaución",1);//Regresa 1 si se puede borrar. 0 si no.
			}
			fun deshabilita_campos(){//Deshabilita todos los campos que no sean parte de la llave. Pone invisibles los botones
				setmfy("nombre"); setmfy("direccion"); setmfy("colonia"); 
				setmfy("poblacion"); setmfy("cp"); setmfy("tel1"); setmfy("tel2"); setmfy("fax"); 
				setmfy("rfc"); setmfy("internet"); setmfy("vendedor"); setmfy("grupo"); setmfy("zona"); 
				setmfy("limcredito"); setmfy("plazo"); setmfy("desc1"); setmfy("desc2"); setmfy("desc3"); setmfy("sventa"); 
				setmfy("scobro"); setmfy("revdia"); setmfy("revhora"); setmfy("diapago");setmfy("dia"); setmfy("horapago"); setmfy("mercancia"); setmfy("curp"); 
				//Invisbles los botones
				setvbl("V");setvbl("G");setvbl("Z");
			}
			fun Exit() {
				kdb.exec(); //Ejecuta instrucciones pendientes (Cambios)
				if (strlen(trim(frn.param(0)))>0){ //Solo si se especificó un campo a devolver los datos 
					if(bit5==1){//Se regresará un cubo de memoria con todos los registros (para llenar un combo o una lista)
						var cmd="dat1,a,1,&,a2,a3";//Por default se ordena por clave, y el campo visible es la clave(bit1=1)
						if(bit1==0) cmd="dat1,a,2,&,a3,a2";//Se ordena por descripción, y el campo visible es la descripción
						kdb.table(cmd);kdb.exec();
						frP.set(frn.param(0),kdb.get("dat1"));//Se llenan los combos
					}
					var valor_retorno=frn.get("clave");//Por default se devuelve la clave(bit1=1)
					if( bit1==0 ){
						valor_retorno=frn.get("nombre");//Se devuelve el nombre
					}
					if (strlen(trim(frn.param(1)))>0){ //Se devolverá el valor a una tabla 
						frP.setX(valor_retorno,trim(frn.param(0)),-1,trim(frn.param(1))); 
						frP.scriptElm(frn.param(0),"OnChange",frn.param(1));
					}else{ //se devolverá el valor a un campo
						frP.set(frn.param(0),valor_retorno); 
						frP.scriptElm(frn.param(0),"OnChange");
					}
				}
				if (strlen(trim(frn.param(3)))>0){ //Se ejecutará la función indicada en la ventana padre.
					frP.script(frn.param(3));
				}
				frn.exit();
			}
			fun valoresDefault(){
				return "";
			}
			fun CambiaComentarios(objeto){
				var numero_campo1="24"; //se definen que campos contienen los comentarios
				var numero_campo2="25";
				var numero_campo3="26";
				//se crean las diferentes busquedas
				var cmd1=tabla_base & ",1," & camposLlave() & ",&," & numero_campo1 & "," & frn.getM(objeto,0); 
				var cmd2=tabla_base & ",1," & camposLlave() & ",&," & numero_campo2 & "," & frn.getM(objeto,1); 
				var cmd3=tabla_base & ",1," & camposLlave() & ",&," & numero_campo3 & "," & frn.getM(objeto,2); 
				kdb.update(cmd1); //se efecuta el comando UPDATE para actualizar la tabla
				kdb.update(cmd2);
				kdb.update(cmd3);
			}
			
			//Funciones Auxiliares Para Catálogos(Genericas). 
			//Necesitan las variable globales tabla_base y camposDeseados. 
			//tabla_base especifíca el nombre de la tabla del catálogo que se está editando
			//camposDeseados indica los campos que se modificaran de la tabla. Ej a1...a70
			//Ademas de una funcion camposLlave que devuleva los campos que forman la clave
			//Una funcion setData que establece en pantalla los valores de la base de datos. (Cubo de información: "datos")
			//Una funcion verifica_borrar() que regresa 1 si se puede borrar el registro, 0 si no se debe borrar.
			fun set(objeto,campo) { frn.set(objeto,kdb.get("datos",campo));}//Establece el valor de un campo de la BD al objeto indicado
			fun Busca() {if(bit4==1) Bus(0);}
			fun PgUp() {if(bit4==1) Bus(6);}
			fun PgDn() {if(bit4==1) Bus(5);}
			fun CtrIni() {if(bit4==1) Bus(7);}
			fun CtrEnd() {if(bit4==1) Bus(8);}
			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){
				/*iModo: 0)No hace mayor validación. Siempre despliega la ventana. NO CONCATENA PREFIJO
							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validación. Siempre despliega la ventana
							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)
							3)Modo especial para páginas de operacion:Solo si se está en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje
				*/
				var prefix=frn.lib("libKepler","langPrefix");
				var page=prefix&pag;
				var b_valido=1;
				if(iModo==0)page=pag;
				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolverá el resultado.
					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;
				}
				else if(iModo==3)b_valido=0;
				if(b_valido==1)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);
			}
			
			fun Error(string){frn.messageBar(string,1); frn.sound(1);}//Establece un mensaje de error en la barra de estado. Y emite un sonido de alerta.
			fun Bus(relacional) { //1:>=	2:<=		3:>	 4:<		 5:Siguiente		6:Anterior		7:Primero		8:Ultimo
				frn.messageBar("");
				var cmd="datos,a,1," & relacional & "," & camposLlave() & ",&," & camposDeseados;
				kdb.search(cmd); kdb.exec(); setData();
			}
			fun Cambio(numero_campo,objeto,desplazamiento) { //Realiza un cambio de valor en la BD
				if(bit3==0){//No permite insertar nuevos registros
					if(kdb.ok("datos")==0){frn.message("No es posible dar de alta nuevos registros","Permisos restringidos");break;}
				}
				var cmd="datos,a,1," & camposLlave() & ",&," & numero_campo & ",'" & frn.get(objeto,-1,desplazamiento) & "',&," & valoresDefault() & ",&," & camposDeseados;
				//Agrega el LOG
				kdb.write("logmov,w,1,'"&strFormat("ucase",frn.config("user","name"))&"','"&sys.date()&"','"&sys.time()&"','"&frn.FileName()&"',&,1,'"&strFormat("ucase",frn.config("user","name"))&"',2,'"&sys.date()&"',3,'"&sys.time()&"',4,'"&frn.FileName()&"',5,'"&numero_campo&"',6,'"&frn.get(objeto,-1,desplazamiento)&"',7,'"&frn.getPrv(objeto,-1,desplazamiento)&"',8,'"&tabla_base&"',9,'"&camposLlave()&"'");
				kdb.write(cmd);kdb.exec();setData();
			}
			fun CtrDel() {//Borra el registro actual y devuelve el siguiente
				if(bit3==1){
					if ( verifica_borrar()==1 ){//Solo borrará el registro si la funcion verifica_borrar devuelve 1. Cada catálogo define su validacion para borrar.
						var i,nRegCub;
						nRegCub=	kdb.N("cubDirEnt");
				
						for (i=0;i<nRegCub;i++){
							var cmd2="datos2"&i&",t,1,'" &frn.get("clave")&"','"&kdb.get("cubDirEnt","r"&i,"t2")&"',& ,t1...t3";
							kdb.del(cmd2);
						}
								
						var cmd="datos,a,1," & camposLlave() & ",&," & camposDeseados;
						var cmd1="datos1,f,1,'3','" &frn.get("clave")&"','1',& ,f1...f3";   
						//Agrega LOG
						kdb.write("logmov,w,1,'"&strFormat("ucase",frn.config("user","name"))&"','"&sys.date()&"','"&sys.time()&"','"&frn.FileName()&"',&,1,'"&strFormat("ucase",frn.config("user","name"))&"',2,'"&sys.date()&"',3,'"&sys.time()&"',4,'"&frn.FileName()&"',5,BORR,6,'"&camposLlave()&"',8,'"&tabla_base&"'");
			
						kdb.del(cmd);	kdb.del(cmd1);kdb.exec(); 
						if(bit4==1)setData();else frn.exit();//Si no se puede posicionar en otro registro, se sale de la opción después de borrar.
					}
				}
			}
			fun setmfy(campo,valor){//Modifica el atrbuto modify de cierto objeto(0=no permite modificacion. 1=Permite modificacion)
				var atrib=(valor==1)?"Y":"N";
				frn.setAtt(campo,"modify",atrib);
			}
			fun setvbl(campo,valor){//Modifica el atrbuto visible de cierto objeto(0=no lo muestra. 1=si lo muestra)
				var atrib=(valor==1)?"Y":"N";
				frn.setAtt(campo,"visible",atrib);
			}
			
			//-----Inicio. Funcion AddDir
				//---mandara a llamar a la pagina FEcatdir2 para llenar la direccion
				//---se le pasan los parametros:
					//----3 >> Entidad, estatico
					//----clave del cliente >> se obtiene de pantalla
					//----1 >> consecutivo, estatico
			fun AddDir(par){
				if(par==1){
					Dialog(1,"FECatdir2",3,frn.get("clave"),"0"&bit2&bit3&bit4&bit5,1);
				}else{
					Dialog(1,"FE33Dir",3,frn.get("clave"),"0"&bit2&bit3&bit4&bit5,1);
				}
				
			}
			//-----Fin. Funcion AddDir
			fun AddDirEntrega(){
				Dialog(1,"crmembentpag",frn.get("clave"),,"1"&bit2&"120");
			}
			//-----Fin. Funcion AddDir
// Inicia ARN 2016-11-03
			fun AddDirCCE(){
				//Dialog(1,"FECCECatdir2",3,frn.get("clave"),,1);
				Dialog(1,"FE33CEDirFiscal",3,frn.get("clave"),"0"&bit2&bit3&bit4&bit5,1);
			}
			//-----Fin. Funcion AddDir
			fun AddDirEntregaCCE(){
				//Dialog(1,"FECCEcrmembentpag",frn.get("clave"),,"11120");
				Dialog(1,"FE33CEDirEntrega",frn.get("clave"),,"1"&bit2&"120");
			}
// Termina ARN 2016-11-03
		fun Version(){ return 1.1; } 
		}
