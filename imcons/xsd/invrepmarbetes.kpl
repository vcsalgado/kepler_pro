<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Impresion Marbetes"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0">	<br/>	<tab/>	<txt fnt="Arial,25" clr="0,0,0">Impresion Marbetes</txt><br/>	<sp/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>			<grp dim="90,45,10,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Folios de Marbetes">			<sp/><tab/><txt>Sucursal: </txt>			<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="40,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"				OnChange="reset_tabla()"/>			<br/>					<tab n="1"/>            <txt>Registros: </txt>			<cmb id="cmb_registros" dim="12,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" modify="Y" OnChange="ValRegistros()" tooltip="Registros"/><tab/>			<txt>Folio Inicial: </txt>			<inp id="folio_ini" dim="15,1" nc="5" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" OnF9="ObtenerFolios(folio_ini)" OnChange="BuscarFolio(folio_ini)" tooltip="Folio Inicial"/>            <tab/>			<txt>Folio final: </txt>			<inp id="folio_fin" dim="15,1" nc="5" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" OnF9="ObtenerFolios(folio_fin)" OnChange="BuscarFolio(folio_fin)" tooltip="Folio Final"/>            <br/><tab/><txt>No. parte inicial: </txt>			<inp id="num_parte_ini" dim="25,1" nc="18" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" OnF9="ObtenerPartes(num_parte_ini)" OnChange="BuscarPartes(num_parte_ini)" tooltip="Numero de parte inicial"/>            <sp/>			<txt>No. parte final:</txt>			<inp id="num_parte_fin" dim="25,1" nc="18" type="capital" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" OnF9="ObtenerPartes(num_parte_fin)" OnChange="BuscarPartes(num_parte_fin)" tooltip="Numero de parte final"/>            <tab n="4"/>			<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			<br/>			<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="84,18" nren="fijo" OnMouseD="Seleccionar()" Reorder="Y" modify="N" insdel="N">				<col id="seleccionar" name="S/N" type="capital" OnMouseD="SoN()" OnChange="ValidaSoN(tabla,seleccionar)" tooltip="S &#243; N (Doble click para cambiar)"/>				<col id="folio" name="Folio"/>				<col id="num_parte" name="Numero de Parte"/>				<col id="descripcion" name="Descripcion"/>				<col id="ubicacion" name="Ubicacion"/>				<col id="unidad" name="Unidad"/>			</tbl> 			<tab n="7"/>			<br/>			<tab n="1"/>            <sp/><bot id="bot_sel" dim="12,0" brdr="5" text="Sel. Todos" OnEnter="SeleccTodos()" tooltip="Seleccionar todos los registros"/>			<sp/><bot id="bot_des" dim="12,0" brdr="5" text="Des. Todos" OnEnter="DeseleccTodos()" tooltip="Deseleccionar todos los registros"/>			<tab n="3"/><txt>Registros seleccionados:</txt><sp/>			<inp id="inp_registros_sel" dim="10,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="number" just="R" modify="N" available="N" tooltip="No. registros seleccionados"/>			<sp/>            <tab n="6"/>            <img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Reporte()" tooltip="Imprimir Marbetes" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>            <!--            <bot id="bot_seleccionar" dim="14,0" brdr="5" text="Imprimir" default="0" OnEnter="Reporte()"/>            -->		</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,rep;			var suc_usuario,perfil_usuario,usuario,rol_usuario,asterisco,externo;			var cubo,cmdQuery, cuboQuery, ok, mensajeError, fileSavePath, continua, xmlRequest,cuboResultados,cmd;			var tipoOper; //Variables relacionadas con parametros			var consCfdi;						fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				rep=new REP;				kdb.connect();								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				asterisco = "*";				fileSavePath = "C:\Basura";				Inicializa();			}						fun Inicializa(){				IniParams();				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invgenerarmarbets.Inicializa()");						ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));												//Llenar cmb_registros				frn.setX("","cmb_registros",0,0);				frn.setX("Todos","cmb_registros",1,0);	            frn.setX("T","cmb_registros",1,1);				frn.set("cmb_registros","Todos");									}						fun reset_tabla(){				frn.rst("tabla");			}						fun ValRegistros(){				if (frn.get("cmb_registros",-1,1) &= "T"){	//Todos               frn.rst("tabla");					frn.set("folio_ini","");					frn.set("folio_fin","");               frn.set("num_parte_ini","");					frn.set("num_parte_fin","");               frn.set("inp_registros_sel",0);				}			}         fun ObtenerFolios(campo){				cmdQuery="select c1 as folio, c2 as num_parte, c3 as descripcion from keplersc.kdmarb where col_sucursal= '" & frn.get("k_sucN",-1,1) & "' order by c1";				frn.dialog("genlistafiltrosel","Folios de Marbetes",cmdQuery,"folio",campo,"0","0","N","S");								}         fun ObtenerPartes(campo){				cmdQuery="select c1 as folio, c2 as num_parte, c3 as descripcion from keplersc.kdmarbe  where col_sucursal= '" & frn.get("k_sucN",-1,1) & "' order by c2";				frn.dialog("genlistafiltrosel","Folios de Marbetes",cmdQuery,"num_parte",campo,"0","0","N","S");								}         fun BuscarDato(cmdQuery,clave,msg){				var cve_valor;				cve_valor=frn.get(clave);				//frn.lib("libGeneral.kpl","FileSave",cmdQuery,"C:\Basura\query"&msg);										rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_serie_crud.BuscarDato"&msg&"()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery,"C:\Basura\cubo"&msg);				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if((nXml(cuboQuery) == 0) && (cve_valor &! "")) {					frn.setPos(cve_valor);					frn.set(clave,"");					frn.message(msg & " no existe","Error","Aceptar");					return;   				}					}         fun BuscarFolio(campo){				var vfolio;            frn.rst("tabla");            frn.set("cmb_registros","");            frn.set("num_parte_ini","");                            frn.set("num_parte_fin","");            frn.set("inp_registros_sel",0);				vfolio=frn.get(campo);				cmdQuery = "select c1 as folio from keplersc.kdmarbe  where col_sucursal= '" & frn.get("k_sucN",-1,1) & "' and c1='" & vfolio & "'";				BuscarDato(cmdQuery,campo,"El folio");			}         fun BuscarPartes(campo){				var vparte;            frn.rst("tabla");            frn.set("cmb_registros","");            frn.set("folio_ini","");            frn.set("folio_fin","");            frn.set("inp_registros_sel",0);				vparte=frn.get(campo);				cmdQuery = "select c2 as numparte from keplersc.kdmarbe  where col_sucursal= '" & frn.get("k_sucN",-1,1) & "'  and c2='" & vparte & "'";				BuscarDato(cmdQuery,campo,"La parte");			}         fun SoN() {				if (frn.get("tabla",-1,"seleccionar") &= "S"){					frn.setX("N","tabla",-1,"seleccionar");            } else {					frn.setX("S","tabla",-1,"seleccionar");            }				CuentaSel("tabla","seleccionar","inp_registros_sel");         }         fun CuentaSel(tabla,campo,actualiza){				var renglones, cuentaS, cuentaN;				cuentaS=0;				cuentaN=0;				renglones = frn.N(tabla);				for (var i=0; i<renglones; i++) {					if (frn.get(tabla,i,campo) &="S"){						cuentaS = cuentaS + 1;					}					if (frn.get(tabla,i,campo) &="N"){						cuentaN = cuentaN + 1;					}									}				frn.set(actualiza,cuentaS);				}            fun ValidaSoN(tabla,campo){				if (frn.get(tabla,-1,campo) &! "S" && frn.get(tabla,-1,campo) &! "N"){					frn.setPos("tabla",-1,campo);					frn.message("Sólo puede ser S o N","Error","&Aceptar");				return;				}  			}    			fun SeleccTodos(){				var renglones, cuenta;				renglones = frn.N("tabla");				for (var i=0; i<renglones; i++) {					frn.setX("S","tabla",i,"seleccionar");					cuenta = cuenta + 1;									}				frn.set("inp_registros_sel",cuenta);			}			fun DeseleccTodos(){				var renglones, cuenta;				renglones = frn.N("tabla");				for (var i=0; i<renglones; i++) {					frn.setX("N","tabla",i,"seleccionar");				}				frn.set("inp_registros_sel",0);			}			fun Buscar() {				var registros, folio_ini, folio_fin, num_parte_ini, num_parte_fin;				folio_ini = frn.get("folio_ini");                folio_fin = frn.get("folio_fin");				num_parte_ini = frn.get("num_parte_ini");                num_parte_fin = frn.get("num_parte_fin");				registros = frn.get("cmb_registros",-1,1);            if (registros &="T"){					cmd = "select 'S' as seleccionar, c1 as folio, c2 as num_parte, c3 as descripcion, c4 as ubicacion, c7 as unidad " &						"from keplersc.kdmarbe where col_sucursal= '" & frn.get("k_sucN",-1,1) & "' order by c1";            } else if (folio_ini &! "" && folio_fin &! ""){					cmd = "select 'S' as seleccionar, c1 as folio, c2 as num_parte, c3 as descripcion, c4 as ubicacion, c7 as unidad " &						"from keplersc.kdmarbe where col_sucursal= '" & frn.get("k_sucN",-1,1) & "' and c1 >= " & folio_ini  & " and c1 <= " & folio_fin  &                   " order by c1";				} else if (num_parte_ini &! "" && num_parte_fin &! ""){					cmd = "select 'S' as seleccionar, c1 as folio, c2 as num_parte, c3 as descripcion, c4 as ubicacion, c7 as unidad " &						"from keplersc.kdmarbe  where col_sucursal= '" & frn.get("k_sucN",-1,1) & "' and c2 >= '" & num_parte_ini  & "' and c2 <= '" & num_parte_fin  &                         "' order by c2";				}				frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdRequest");									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepmarbetes.Buscar()");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				                frn.setX(cuboResultados,"tabla");                CuentaSel("tabla","seleccionar","inp_registros_sel");			}            			fun llenar_cmb(cuboResultados, cmb){				var len_cubo = nXml(cuboResultados);				var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){					var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");					frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);					}				}						fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}         fun IniParams(){//Inicializa parámetros de impresión, que pueden ser cambiados por el usuario final mediante: Archivo / Configurar Página                frn.set("param_paper","letter");//    "paper=letter|legal|size"                frn.set("param_sizeX","21.59","param_sizeY","27.94");//    "size=18,14cm"                frn.set("param_borderL","0.7","param_borderT","0.7","param_borderR","0","param_borderB","0.0");//    "border=1.5,1.5,1.5,1.5cm"                frn.set("param_Fx","1.0","param_Fy","1.0");//            "F=1,1"                frn.set("param_landscape","N");//    "landscape=N|Y"                //frn.set("param_emp","L");//            "@emp=L|R|C"                frn.set("param_header",1);         }         fun setRepPage() {//Establece los parámetros finales de impresión.             //Tipo de hoja, ancho, alto,margen iz, margen derecho, margen arriba, margen abajo, factor de escala en x, factor de escala en y,orientacion, color, ventana de ajuste, etc				 //rep.page("paper=letter|legal|size","size=18,14cm","border=1.5,1.5,1.5,1.5cm","F=1,1","landscape=N|Y","color=Y|N","prompt=N|Y","@emp=L|R|C");             var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";             var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";             var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fy");             var lndsp="landscape=" & frn.get("param_landscape");             var emp="@emp=" & frn.get("param_emp");             rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);         }         fun Reporte(){//Ejecuta el Reporte				// Se define el formato a usar y se liga a la variable del reporte "rep"				var renglones;				var folio, num_parte, descripcion, ubicacion, unidad;				            kdb.readPage("datFto","invrepmarbetesfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				kdb.kde("KDE");				kdb.exec();								rep.rst();				setRepPage();							renglones = frn.N("tabla");				for (var i=0; i<renglones; i++) {					if (frn.get("tabla",i,"seleccionar") &= "S"){						folio = frn.get("tabla",i,"folio");                  num_parte = frn.get("tabla",i,"num_parte");                  descripcion = frn.get("tabla",i,"descripcion");                  ubicacion = frn.get("tabla",i,"ubicacion");                  unidad = frn.get("tabla",i,"unidad");                  rep.set("folio",folio);                  rep.set("fecha",sys.date());                  rep.set("num_parte",num_parte);                  rep.set("descripcion",descripcion);                   rep.set("ubicacion",ubicacion);                   rep.set("unidad",unidad);						rep.set("folioBis",folio);                  rep.set("fechaBis",sys.date());                  rep.set("num_parteBis",num_parte);                  rep.set("descripcionBis",descripcion);                   rep.set("ubicacionBis",ubicacion);                   rep.set("unidadBis",unidad);                  rep.exe("linea");					}            }				//Modos de impresiOn 				rep.win(); //Muestra la vista previa de la impresiOn. A partir de la vista previa (Preprint) se decide si se imprime o no.				//rep.print("\\192.168.1.100\HPLaserJet"); //EnvIa el reporte directamente a una impresora, sin mostrar la vista previa.				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresiOn. No muestra la vista previa.				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardara el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html			}								fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>