<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit=""><grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<br/>	<tab/>	<inp id="k_titulo" dim="65,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"				type="string" modify="N" available="N" fnt="Arial,22"/>	<br/>	<br/>	<hLine clr="0,0,0"/>	<br/> <br/>	<tab/>		<grp id="grupo_crud" dim="97,35,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="Nuevo" available="Y">				<grp id="grupo_enc1" dim="55,7,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="" available="Y"> 			<br/>					<sp n="1"/> <txt>Clave : </txt> <sp n="5"/>			<inp id="k_clave" dim="8,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="6" available="Y" OnChange="" tooltip="Clave Clasificacion" modify="Y"/>			<br/>			<sp n="1"/> <txt>Descripcion : </txt>			<inp id="k_descrip" dim="40,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="30" clrBrdr="255,255,255" tooltip="Descripcion" available="Y"/>					<br/>					</grp>				<grp id="grupo_enc2" dim="40,7,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="" available="Y"> 						<br/>			<sp n="1"/> <txt>Horas Base : </txt> 			<sp n="1"/> <inp id="k_base_hrs" dim="24,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="number" nc="16" available="Y" OnChange="" tooltip="Hrs. Base" modify="Y" nd="5" just="R" min="0"/> 			<br/>			<sp n="1"/> <txt>Sueldo Base : </txt> 			<inp id="k_base_sueldo" dim="24,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="18" clrBrdr="255,255,255" tooltip="Sueldo Base" available="Y" just="R" nd="2" min="0"/>						<br/>					</grp>				<br/> 				<grp id="grupo_pagosperce" dim="45,18,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="Pago x Porcentajes" available="Y"> 					<br/>			<sp n="1"/> <txt>% Normales : </txt> <sp n="6"/>			<inp id="k_p_nor" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="16" clrBrdr="255,255,255" tooltip="% normales" available="Y" just="R" nd="5" min="0"/>			<br/>			<sp n="1"/> <txt>% Garantias : </txt> <sp n="6"/>			<inp id="k_p_gar" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="16" clrBrdr="255,255,255" tooltip="% garantias" available="Y" just="R" nd="5" min="0"/>			<br/>			<sp n="1"/> <txt>% Internas : </txt> <sp n="7"/>			<inp id="k_p_int" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="16" clrBrdr="255,255,255" tooltip="% internas" available="Y" just="R" nd="5" min="0"/>			<br/>			<sp n="1"/> <txt>% Previas : </txt> <sp n="8"/>			<inp id="k_p_pre" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="16" clrBrdr="255,255,255" tooltip="% previas" available="Y" just="R" nd="5" min="0"/>			<br/>			<sp n="1"/> <txt>% Reclamaciones : </txt> <sp n="1"/>			<inp id="k_p_rec" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="16" clrBrdr="255,255,255" tooltip="% reclamaciones" available="Y" just="R" nd="5" min="0"/>			<br/>		</grp>				<grp id="grupo_pagoshoras" dim="52,18,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="Pago x Horas" available="Y"> 					<br/>						<sp n="1"/> <txt fnt=",b">Escalafon </txt> <sp n="1"/> <txt fnt=",b">Tarifa x Hora </txt> <sp n="7"/> <txt fnt=",b">Hasta </txt>			<br/>			<sp n="4"/> <txt>1er </txt> <sp n="4"/> 			<inp id="k_tarifa1" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="16" clrBrdr="255,255,255" tooltip="Tarifa x Hr" available="Y" just="R" nd="5" min="0"/>			<sp n="2"/>			<inp id="k_escalon1" dim="11,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="10" clrBrdr="255,255,255" tooltip="Escalon 1" available="Y" just="R" nd="0" min="0" fmt="5"/>			<sp n="1"/> <txt>Hrs </txt>			<br/>			<sp n="4"/> <txt>2do </txt> <sp n="4"/> 			<inp id="k_tarifa2" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="16" clrBrdr="255,255,255" tooltip="Tarifa 2" available="Y" just="R" nd="5" min="0"/>			<sp n="2"/>			<inp id="k_escalon2" dim="11,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="10" clrBrdr="255,255,255" tooltip="Escalon 2" available="Y" just="R" nd="0" min="0" fmt="5"/>			<sp n="1"/> <txt>Hrs </txt>			<br/>					<sp n="4"/> <txt>3er </txt> <sp n="4"/> 			<inp id="k_tarifa3" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="16" clrBrdr="255,255,255" tooltip="Tarifa 3" available="Y" just="R" nd="5" min="0"/>			<sp n="2"/>			<inp id="k_escalon3" dim="11,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="10" clrBrdr="255,255,255" tooltip="Escalon 3" available="Y" just="R" nd="0" min="0" fmt="5"/>			<sp n="1"/> <txt>Hrs </txt>			<br/>			<sp n="4"/> <txt>4to </txt> <sp n="4"/> 			<inp id="k_tarifa4" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" nc="16" clrBrdr="255,255,255" tooltip="Tarifa 4" available="Y" just="R" nd="5" min="0"/>						<br/>					</grp>		<br/><br/>      <sp n="40"/> <bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/>      <br/> 		<sp n="40"/> <inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/>					</grp>	</grp>	<script>	InstallDriver("KDB75");	class Main {				var frn,kdb,frP, accion,externo, clave_sel,sucursal_id,cve_color,resVal,straccion;      var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError;      var fileSavePath;      		fun Main() {			frn = new FRNT;			frP = new FRNTP;			kdb = new KDB;			kdb.connect();						// Added by JMM 20230131			//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";			fileSavePath = "C:\Basura";							Inicializa();			ctlrs_off();			insertar_datos();			ctlrs_opcion();		}					fun Inicializa(){					accion = frn.param(0);			frn.set("input_crud", accion);			frn.rst("grupo_crud");			externo = frn.param(2);         if (accion &= "NUEVO") {				straccion = "Nuevo" ;            } else if (accion &= "CONSULTAR") {				straccion = "Consultar";			} else if (accion &= "MODIFICAR") {				straccion = "Modificar";         } else if (accion &= "ELIMINAR") {				straccion = "Eliminar";         }     							frn.setAtt("grupo_crud", "tit", straccion );			clave_sel = frn.param(1);			sucursal_id = frn.param(3);			if (accion &! "NUEVO") {				frn.set("k_clave", clave_sel);			}						}					fun ctlrs_off(){			frn.setAtt("btn_aceptar", "available", "N" );			frn.setAtt("btn_aceptar", "visible", "N" );						frn.setAtt("k_clave", "available","N");			frn.setAtt("k_descrip", "available","N");						frn.setAtt("k_base_hrs", "available","N");			frn.setAtt("k_base_sueldo", "available","N");						frn.setAtt("k_p_nor", "available","N");         frn.setAtt("k_p_gar", "available","N");         frn.setAtt("k_p_int", "available","N");         frn.setAtt("k_p_pre", "available","N");         frn.setAtt("k_p_rec", "available","N");                  frn.setAtt("k_tarifa1", "available","N");         frn.setAtt("k_escalon1", "available","N");         frn.setAtt("k_tarifa2", "available","N");         frn.setAtt("k_escalon2", "available","N");         frn.setAtt("k_tarifa3", "available","N");         frn.setAtt("k_escalon3", "available","N");         frn.setAtt("k_tarifa4", "available","N");     		}						fun ctlrs_opcion(){					if (accion &= "NUEVO") {				frn.set("k_titulo","Catálogo Clasificacion de Pagos");								frn.setAtt("k_clave","available","Y");				frn.setAtt("k_clave", "modify", "Y" );				frn.setAtt("k_descrip", "available", "Y" );								frn.setAtt("k_base_hrs", "available","Y");				frn.setAtt("k_base_sueldo", "available","Y");							frn.setAtt("k_p_nor", "available","Y");				frn.setAtt("k_p_gar", "available","Y");				frn.setAtt("k_p_int", "available","Y");				frn.setAtt("k_p_pre", "available","Y");				frn.setAtt("k_p_rec", "available","Y");         				frn.setAtt("k_tarifa1", "available","Y");				frn.setAtt("k_escalon1", "available","Y");				frn.setAtt("k_tarifa2", "available","Y");				frn.setAtt("k_escalon2", "available","Y");				frn.setAtt("k_tarifa3", "available","Y");				frn.setAtt("k_escalon3", "available","Y");				frn.setAtt("k_tarifa4", "available","Y");										} else { 				frn.set("k_titulo","Catálogo Clasificacion de Pagos"); // Added by JMM ... 20230131				frn.setAtt("k_clave", "available", "Y" );            frn.setAtt("k_clave", "modify", "N" );				if (accion &= "MODIFICAR") {					frn.setAtt("grupo_crud", "available","Y");					frn.setAtt("k_descrip", "available", "Y" );									frn.setAtt("k_base_hrs", "available","Y");					frn.setAtt("k_base_sueldo", "available","Y");								frn.setAtt("k_p_nor", "available","Y");					frn.setAtt("k_p_gar", "available","Y");					frn.setAtt("k_p_int", "available","Y");					frn.setAtt("k_p_pre", "available","Y");					frn.setAtt("k_p_rec", "available","Y");         					frn.setAtt("k_tarifa1", "available","Y");					frn.setAtt("k_escalon1", "available","Y");					frn.setAtt("k_tarifa2", "available","Y");					frn.setAtt("k_escalon2", "available","Y");					frn.setAtt("k_tarifa3", "available","Y");					frn.setAtt("k_escalon3", "available","Y");					frn.setAtt("k_tarifa4", "available","Y");											} else {					frn.setAtt("k_clave", "available","Y");               frn.setAtt("k_clave", "modify", "N" );					//frn.setAtt("btn_aceptar", "visible", "N" );            }			}						if (accion &! "CONSULTAR"){				frn.setAtt("btn_aceptar", "available", "Y" );				frn.setAtt("btn_aceptar", "visible", "Y" );			}					}						fun insertar_datos(){			var v_activo, v_activo_cmb;						if (accion &= "MODIFICAR"){			//llamada externa(padre)				if (externo &= "s"){					if (clave_sel &= ""){						frn.message("selecciona una clave con F9 para modificar","Error","Aceptar");						frn.setAtt("btn_aceptar", "visible", "N" );						return;					}				}			}							if (accion &! "NUEVO") {							cmdQuery="select * /*c2*/ from keplersc.kdclaspag where c1='" & clave_sel & "'"; 				cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_claspag_crud.insertar_datos()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cat_claspag");									ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");						return;				}									frn.set("k_descrip",getXmlAtt(cuboResultados,"r"&0,"c2"));								frn.set("k_base_hrs",getXmlAtt(cuboResultados,"r"&0,"c3"));				frn.set("k_base_sueldo",getXmlAtt(cuboResultados,"r"&0,"c5"));												frn.set("k_p_nor",getXmlAtt(cuboResultados,"r"&0,"c6"));				frn.set("k_p_gar",getXmlAtt(cuboResultados,"r"&0,"c7"));				frn.set("k_p_int",getXmlAtt(cuboResultados,"r"&0,"c8"));				frn.set("k_p_pre",getXmlAtt(cuboResultados,"r"&0,"c9"));				frn.set("k_p_rec",getXmlAtt(cuboResultados,"r"&0,"c10"));								frn.set("k_tarifa1",getXmlAtt(cuboResultados,"r"&0,"c4"));				frn.set("k_escalon1",getXmlAtt(cuboResultados,"r"&0,"c11"));				frn.set("k_tarifa2",getXmlAtt(cuboResultados,"r"&0,"c12"));				frn.set("k_escalon2",getXmlAtt(cuboResultados,"r"&0,"c13"));				frn.set("k_tarifa3",getXmlAtt(cuboResultados,"r"&0,"c14"));				frn.set("k_escalon3",getXmlAtt(cuboResultados,"r"&0,"c15"));				frn.set("k_tarifa4",getXmlAtt(cuboResultados,"r"&0,"c16"));				         } else {         				frn.setAtt("grupo_crud", "available","Y");            frn.setPos("k_clave");                			}						}				   		fun ValidarDatos() {					var flag_data;					frn.setX(trim(frn.get("k_clave")), "k_clave");			frn.setX(trim(frn.get("k_descrip")), "k_descrip");						flag_data = 1;					if (frn.get("k_clave") &= "") {										frn.setPos("k_clave");				flag_data/*resVal*/ = 0;				frn.message("Debe especificar la clave de la clasificacion, verificar","Error","Aceptar");			}						if (frn.get("k_descrip") &= "") {										frn.setPos("k_descrip");				flag_data/*resVal*/ = 0;				frn.message("Debe especificar la descripcion de la clasificacion, verificar","Error","Aceptar");			}					resVal = flag_data; 										}		fun Execute() {					resVal = 1;			ValidarDatos();			if(resVal == 0) {				return;			}							var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);			if (resultado_confirmacion &! 1) {				return;			}							xmlRequest = getXml(frn.dataPag());				frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest_Cat_ClasPag");					cmdQuery = "SELECT * FROM keplersc.cat_clasifpag_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";			cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_claspag_crud.Execute()");							frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados_Cat_ClasPag");											var resultado = getXml(cubo ,"resultado");							if(resultado &= "0"){				mensajeError = getXml(cubo ,"mensaje");				frn.message(mensajeError,"Error","Aceptar");				return;			}						frP.script("Inicia_Forma()");						if (accion &= "NUEVO" || accion &= "MODIFICAR") {								var sms = "";								if (accion &= "NUEVO"){					sms = "Registro guardado";				} else {					sms = "Registro modificado";				}								accion = "CONSULTAR";				ctlrs_opcion();				frn.message(sms ,"Mensaje","Aceptar");					frn.exit();								}						if (accion &= "ELIMINAR"){				frn.message("Registro eliminado","Mensaje","Aceptar");				frn.exit();						}						}						} // End Class Main		</script></pag>