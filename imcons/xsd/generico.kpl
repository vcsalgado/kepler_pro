<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte de Back Order ">
	<grp dim="1,-1,10,20" brdr="2,1" bclr="192,205,213" clr="0,58,112" fnt="Arial,16" unfont="0"
		OnF1="Ventana(rep_Hlp)"><br/>
		<grp dim="70,30,15,5" bclr="236,240,243" tit="Reporte Back Order" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4">
			<tab/><txt>Sucursal:</txt><sp n="2"/><cmb id="cmb_sucursal" dim="25,36" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255"  brdr="2,0" fnt="Arial,16" 
			      Null="N" modify="Y" available="Y"/><tab/><br/><br/>
			<tab/><txt>Producto inicial:</txt>
			<edt id="edt_prod_ini" dim="20,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" fnt="Arial,15"
				page="invcatprdbus,edt_prod_ini" OnF9="Dialog(1,invcatprdbus,edt_prod_ini)"/><br/>
			<tab/><txt>Producto final:</txt><sp/>
			<edt id="edt_prod_fin" dim="20,1" brdr="2,1" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="capital" fnt="Arial,15"
				page="invcatprdbus,edt_prod_fin" OnF9="Dialog(1,invcatprdbus,edt_prod_fin)"/><br/><br/>
			
			<tab n="5"/><bot id="bot_ejecutar" dim="20,0" brdr="5" text="Ejecutar" OnEnter="Ejecuta()" default="1"/><br/>
		</grp>
		
	</grp>
	<tools>
		<tool name="ejecuta" OnMouseL="Ejecuta()" tooltip="Ejecutar(Ctrl+T)" scut="Ctrl+T" img="_TL_execute.png"/>
	</tools>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,kdb,rep,sys;
			
			fun Main() {
				frn=new FRNT;
				kdb=new KDB;
				rep=new REP;
				sys=new SYS;
				kdb.connect();
				kdb.open("i,kdini");
				Inicializa();
			}	
			
			fun Inicializa(){//Inicializa los valores en Pantalla
				frn.set("fecIni",fnDate(sys.date("year"),sys.date("month"),1));
				frn.set("fecFin",fnDate(sys.date("year"),sys.date("month"),31));
				//... (Llena Combos, e inputs en pantalla)
				IniParams();//Inicializa par�mtros de impresi�n entre otros
				IniCombos();
			}
						
			fun IniCombos(){
				var cmd, cuboQuery, ok, mensajeError;
				cuboQuery="datDoc";			
				//Llenar combo de Sucursales				
				cmd = "select '['||c1||'] '||c2 as c2, c1  from keplersc.kdms";
				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invrepestprod.IniCombos()");
				
				ok=getXmlAtt(cuboQuery,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cuboQuery,"native3");
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				
				frn.set("cmb_sucursal",cuboQuery);				
				
				//Llenar combos de productos
				kdb.search("datosI,i,1,7,&,i1");
				kdb.search("datosF,i,1,8,&,i1");
				kdb.exec();
				frn.set("edt_prod_ini",kdb.get("datosI","i1"));
				frn.set("edt_prod_fin",kdb.get("datosF","i1"));
	
				//frn.lib("libGeneral.kpl","FileSave",kdb.get("datalm"),"C:\Basura\datalm");								
			}
			
			fun IniParams(){//Inicializa par�metros de impresi�n. Pueden ser cambiados por el usuario final mediante men�: Archivo -> Configurar P�gina
				frn.set("param_paper","letter");	//Tama�o de papel predefinido:	"paper=letter|legal|size"
				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tama�o de papel personalizado	"size=21.59,27.94cm"
				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//M�rgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"
				frn.set("param_Fx","1.0");	//Escala de impresi�n (1=100 por ciento)	"F=1,1"
				frn.set("param_landscape","N");	//Orientaci�n	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"
				frn.set("param_emp","L");	//Posici�n de "Raz�n social"(izq,der,cen)	@emp=L|R|C"
			}
			
			fun Ejecuta(){//Prepara datos del reporte 
				//...(cubos de datos e informaci�n necesaria)
				var producto_ini, producto_fin, cubo, ok, cmd, mensajeError ;
				producto_ini= frn.get("edt_prod_ini", -1, 0);
				producto_fin= frn.get("edt_prod_fin", -1, 0);
				cmd = "select ini.c1 as clave_producto,
					ini.c2 descripcion,
					bol.c3 entradas,
					bol.c4 salidas,
					bol.c3-bol.c4 diferencia
					from keplersc.kdini ini
					inner join keplersc.kdbol bol
					on ini.c1 = bol.c2 
					where ini.c1 >='"& producto_ini &"' and ini.c1 <='"& producto_fin &"' and bol.c3-bol.c4>0
					order by clave_producto";
				
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"vcssprod.Ejecuta()");
				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboPrueba");
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}
				Reporte();
			}
			
			fun Reporte(){//Ejecuta el Reporte
				// Se define el formato a usar y se liga a la variable del reporte "rep"
				var clave_producto, descripcion, diferencia;
				var producto_ini, producto_fin, cubo, ok, cmd, mensajeError ;
				var compania, usuario, strValor, fechaImpresion, horaImpresion;

				var k_bonete, k_orden, k_unidad, k_placas, k_km, k_punto, k_status, k_auto, k_trabajo_1, k_trabajo_2, k_trabajo_3, k_serie, k_fventa, k_recep, k_operario, k_cliente;
				kdb.readPage("datFto","genericofto.kpl");
				kdb.exec();
				rep.source(kdb.get("datFto")); 


				kdb.kde("KDE");//Configuraci�n del servidor
				kdb.exec();
				compania = kdb.get("KDE","1");
				usuario = kdb.get("KDE","14");
				strValor = sys.date();	
				fechaImpresion = sys.date();
				horaImpresion = sys.time();

				k_bonete = "6 VDE";
				k_orden = "S  0000124959";
				k_unidad = "HILUX / ROJA / 2016";
				k_placas = "K87AKX";
				k_km = "206,555.00";
				k_serie = "MR0EX8DD6G0169724";
				k_fventa = "08/09/16";
				k_recep = "LUIS FELIPE HERNANDEZ ALMANZA";
				k_operario = "AC    ALBERTO LEON CARDENAS";
				k_cliente = "CONSTRUCCIONES ELECTROMECANICA";
				k_punto = "1";
				k_status = "SUSPENDIDO";
				k_auto = "AUTORIZA";
				k_trabajo_1 = "SERVICIO DE 200,000";
				k_trabajo_2 = "AUTORIZA LIMPIEZA CUERPO ACELERACION ";
				k_trabajo_3 = "AUTORIZA LIMPIEZA CAMAPA DE COMBUSTION";

				producto_ini= frn.get("edt_prod_ini", -1, 0);
				producto_fin= frn.get("edt_prod_fin", -1, 0);

				rep.rst();
				setRepPage();//Establece los par�metros finales de impresi�n(rep.page(...);), pues pueden haber cambiado por el usuario 
				//Da valor a los inputs del reporte(rep.set();), e indica la ejecuci�n de "grupos de renglones de impresi�n" (rep.exe();)
				rep.set("fecha",sys.date());rep.set("hora",sys.time());

				
				rep.set("k_empresa",compania);
				rep.set("k_sucursal",frn.get("cmb_sucursal",-1,0)); 
				rep.set("k_fecha",frn.get("edt_fecha"));
				rep.set("k_fecha_imp",fechaImpresion);
				rep.set("K_hora_imp",horaImpresion);

				rep.set("k_bonete",k_bonete);
				rep.set("k_orden", k_orden);
				rep.set("k_unidad",k_unidad);
				rep.set("k_placas",k_placas);
				rep.set("k_km",k_km);
				rep.set("k_serie",k_serie);
				rep.set("k_fventa",k_fventa);
				rep.set("k_recep", k_recep);
				rep.set("k_operario", k_operario);
				rep.set("k_cliente",k_cliente);

				rep.set("producto_ini",producto_ini);
				rep.set("producto_fin",producto_fin);
				rep.exe("encabezado");

				
				//Esto es un ejemplo:
				var acum=0,val=0;

				cmd = "select ini.c1 as clave_producto,
					ini.c2 descripcion,
					bol.c3 entradas,
					bol.c4 salidas,
					bol.c3-bol.c4 diferencia
					from keplersc.kdini ini
					inner join keplersc.kdbol bol
					on ini.c1 = bol.c2 
					where ini.c1 >='"& producto_ini &"' and ini.c1 <='"& producto_fin &"' and bol.c3-bol.c4>0
					order by clave_producto";
				
				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"vcssprod.Ejecuta()");
				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboPrueba");
				ok=getXmlAtt(cubo,"ok");
				if(ok &! "" && !ok){
					mensajeError = getXmlAtt(cubo,"native3");
					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);
					frn.message(mensajeError,"Error","Aceptar");
					return;
				}


				for(var ren=0;ren<nXml(cubo);ren++){
					clave_producto = getXmlAtt(cubo,"r"&ren,"clave_producto");
					descripcion= getXmlAtt(cubo,"r"&ren,"descripcion");
					diferencia= getXmlAtt(cubo,"r"&ren,"diferencia");

					rep.set("clave_producto",clave_producto);
					rep.set("descripcion", descripcion);
					rep.set("diferencia", diferencia);

					rep.set("k_punto",k_punto);
					rep.set("k_status",k_status);
					rep.set("k_auto",k_auto);
					rep.set("k_trabajo_1",k_trabajo_1);

					rep.exe("detalle");
					rep.set("k_trabajo_2",k_trabajo_2);
					rep.set("k_trabajo_3",k_trabajo_3);
					rep.exe("trabajo_1");
					rep.exe("salto");

					val = ren + 1 ; 

				}	

				acum = val;
				rep.set("input3",acum);

				rep.exe("linea");
				rep.set("k_orden_2", k_orden);
				rep.set("k_operario_2", k_operario);
				rep.set("k_unidad_2",k_unidad);
				rep.set("k_placas_2",k_placas);
				rep.set("k_fecha_2",fechaImpresion);
				rep.exe("hola");
				rep.exe("total");
				
				//Modos de impresi�n 
				rep.win(); //Muestra la vista previa de la impresi�n. A partir de la vista previa (Preprint) se decide si se imprime o no.
				//rep.print("\\192.168.1.100\HPLaserJet"); //Env�a el reporte directamente a una impresora, sin mostrar la vista previa.
				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresi�n. No muestra la vista previa.
				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardar� el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html
			}
			
			fun setRepPage() {//Establece los par�metros finales de impresi�n.
				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";
				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";
				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");
				var lndsp="landscape=" & frn.get("param_landscape");
				var emp="@emp=" & frn.get("param_emp");
				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);
			}
			fun CombinaCombo(combo,colClave,colDesc,posFinal){//Combina el contenido de 2 columnas de un combo y lo pone en la columna visble. Ej: para mostrar "Clave - Descripci�n". 
				//NOTA: Por default posiciona el combo con el primer elemento. Se puede pasar como parametro "posicionaFinal" un 1 para que se posicione en el ultimo registro
				var clavecombinada="";
				for(var i=0,n=frn.N(combo);i<n;i++){
					clavecombinada=frn.get(combo,i,colClave) & " - " & frn.get(combo,i,colDesc);
					frn.setX(clavecombinada,combo, i, 0);
				}
				if(posFinal==1&&frn.N(combo)>0) frn.setPos(combo,frn.N(combo)-1,0,"internal:Y");//Lo posiciona en el �ltimo renglon
				else frn.setPos(combo,0,0,"internal:Y"); 
			}			
			fun Ventana(arch,cmp0,cmp1,cmp2,cmp3,cmp4,cmp5,cmp6,cmp7,cmp8,cmp9){ //Abre pagina indicada como dialogo SOLO si el campo cmp0 se puede modificar(El cmp0 puede ser una tabla, y cmp1 la columna)
				var b_valido=1;
				if(strlen(cmp0)>0){//Se toma el cmp0 como el objeto (o grid) al que se devolver� el resultado.
					if( frn.getAtt(cmp0,"modify",cmp1) &= "N" ) b_valido=0;
					if( frn.getAtt(cmp0,"available",cmp1) &= "N" ) b_valido=0;
					if( frn.getAtt(cmp0,"visible",cmp1) &= "N" ) b_valido=0;
				}
				if(b_valido==1)frn.dialog(arch,cmp0,cmp1,cmp2,cmp3,cmp4,cmp5,cmp6,cmp7,cmp8,cmp9);
			}
		}
	</script>
</pag>