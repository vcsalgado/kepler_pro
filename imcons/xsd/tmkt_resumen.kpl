<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="TMKT RESUMEN"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="70,58,10,10" brdr="0,5" tit="TMKT RESUMEN" fnt="Arial,16">			<tab/><txt clr="0,58,112">Sucursal</txt>		<cmb id="k_sucN" clr="64,64,64" clrBrdr="255,255,255"  dim="10,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N"/>				<sp/><txt clr="0,58,112">Asesor</txt>		<cmb id="asesores" clr="64,64,64" clrBrdr="255,255,255"  dim="10,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N"/>				<sp/><txt clr="0,58,112">Serie:</txt>		<inp id="input_serie"  nc="8" dim="10,1" brdr="2,0" clr="64,64,64"   bclr="255,255,255" clrBrdr="255,255,255"/>						<tab n="1"/><txt clr="0,58,112">Clave Cliente:</txt>		<inp id="input_cliente"  nc="7" dim="7,1" brdr="2,0" clr="64,64,64"   bclr="255,255,255" clrBrdr="255,255,255"/>							<br/>	<tab n="1"/>		<txt clr="0,58,112" hk="S">Fecha Inicial:</txt>		<edt id="fecha_inicial" dim="12,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" page="_ks_fecha,fecha_inicial" OnF9="Dialog(3,_ks_fecha,fecha_inicial)"/><tab n="2"/><txt clr="0,58,112" hk="S">Fecha Final:</txt>		<edt id="fecha_final" dim="12,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" page="_ks_fecha,fecha_final" OnF9="Dialog(3,_ks_fecha,fecha_final)"/><tab n="1"/>						<sp/><txt clr="0,58,112">Accion:</txt>		<cmb id="accion" clr="64,64,64" clrBrdr="255,255,255"  dim="12,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N"/>			<sp/>		<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>		<br/>			<tab/><tbl id="tabla" dim="63,15" bclr="236,240,243" clr="64,64,64" OnMouseD="detalles" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" modify="N" nren="fijo">			<col name="Folio" id="folio"  type="text" nc="10" modify="N" visible="Y"/>			<col name="Asesor" id="asesor"   modify="N" visible="Y"/>			<col name="Fecha Programacion" id="fecha_programada"   modify="N" visible="Y"/>			<col name="Serie" id="serie" modify="N"  visible="Y"/>			<col name="Cliente" id="nombre_cliente" modify="N"  visible="Y"/>			<col name="Telefono" id="telefono" modify="N"  visible="Y"/>			<col name="Cita" id="cita" modify="N"  visible="Y"/>			<col name="Orden" id="orden" modify="N"  visible="Y"/>			<col name="Motivo" id="motivo" modify="N"  visible="N"/>			<col name="Resultado" id="resultado" modify="N"  visible="N"/>			<col name="Accion" id="accion" modify="N"  visible="N"/>		</tbl>						<br/><br/>									<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="40,30,10,10" brdr="0,5" tit="" fnt="Arial,16">						<tab n="1"/><txt fnt=",bs">TMKT DETALLES:</txt><br/>			<br/>						<tab/><txt>Esta en Pantalla: </txt>			<inp id="esta_en_pantalla" dim="14,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" brdr="0,2" modify="N" available="Y"/><br/>					<tab/><txt>Fecha Contacto Real: </txt>			<inp id="fecha_contacto_real" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="Y" brdr="0,2"/>			<br/>						<tab/><txt>Tipo Contacto: </txt>			<inp id="tipo_contacto" dim="25,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="Y" brdr="0,2"/>			<br/><sp/>						<tab/><txt>Motivo Contacto:</txt>			<inp id="motivo_contacto" dim="24,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="Y" brdr="0,2"/>			<br/><sp/>									<tab/><txt>Resultado Contacto:</txt>			<inp id="resultado_contacto" dim="22,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="Y" brdr="0,2"/>			<br/><sp/>									<tab/><txt>Accion Contacto:</txt>			<inp id="accion_contacto" dim="24,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="Y" brdr="0,2"/>			<br/><sp/>												<tab/><txt>Tipo Servicio TMKT:</txt>			<inp id="tipo_servicio_tmkt" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="Y" brdr="0,2"/>			<br/><sp/>									<tab/><txt>Tipo Trabajo:</txt>			<inp id="tipo_trabajo" dim="16,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="Y" brdr="0,2"/>			<br/><sp/>									<tab/><txt>Nombre de la persona con la que se tuvo contacto:</txt>			<inp id="nombre_contacto" dim="12,1" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" available="Y" brdr="0,2"/>			<br/>						</grp>						<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="40,30,10,10" brdr="0,5" tit="" fnt="Arial,16">				<br/>				<tab/><txt fnt=",bs">Observaciones:</txt><br/> 							<tab/><inp id="observaciones" dim="25,9" bclr="192,205,213" clr="64,64,64" clrBrdr="255,255,255"  modify="N" available="Y" type="string" brdr="0,2"/>							<br/>				<tab n="7"/>					<img id="Exportar" dim="40,40" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(tabla)" available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Guardar tabla"/>			</grp>					</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario ,asterisco, rol_usuario;			var serie_ext, sucursal_ext,suc_seleccionada ;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.open("s,KDMS");								serie_ext = frn.param(0);				sucursal_ext = frn.param(1);								rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				Inicializa();										}											fun Inicializa(){								var cmd,cubo,ok,mensajeError ;				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"serhistorialorden.Inicializa()");									ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}									frn.set("k_sucN",getXml(cubo));																//Asesores				cmd = "select c2 as descripcion,c1 as clave from keplersc.kdsercattmkt ";				rstXml(cubo );				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd ,"tmkt_resumen.llena_combos()");				ok=getXmlAtt(cubo ,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo ,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						frn.setX("", "asesores",0,0);				frn.setX("SIN ASIGNAR", "asesores",1,0);				frn.setX("SA", "asesores",1,1);				llenar_cmb(cubo ,"asesores");																	//accion				cmd = "select descripcion, accion_id as clave from keplersc.kdtmktaccion ";				rstXml(cubo );				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd ,"tmkt_resumen.llena_combos()");				ok=getXmlAtt(cubo ,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo ,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.setX("", "accion",0,0);				frn.setX("", "accion",0,1);				llenar_cmb(cubo ,"accion");																						}						fun Buscar() {							var xmlRequest,cmd,ok,cuboResultados, totOrd , contOrd, ref_clave, ref_desc;						var serie= frn.get("input_serie");				var fecha_inicial = frn.get("fecha_inicial");				var fecha_final = frn.get("fecha_final");				suc_seleccionada= frn.get("k_sucN", -1, 1);				var cli= frn.get("input_cliente");				var asesor= frn.get("asesores", -1, 1);				var accion= frn.get("accion", -1, 1);								borrar_datos();				//formar query sql				cmd= "select tmkt.c2,tmkt.c3,tmkt.c5,tmkt.c14,tmkt.c20,tmkt.c15, tmkt.c16 ||'-'|| tmkt.c17 as orden, ud.c3 as nombre_cli, ud.c7,mot.descripcion as motivo, res.descripcion as result, acc.descripcion as accion ";				cmd = cmd & "  from keplersc.kdtmktser2 as tmkt  left outer join keplersc.kdud as ud on tmkt.c1=ud.c1 and tmkt.c20=ud.c2  inner join keplersc.kdtmktmotivo as mot on tmkt.c7=mot.motivo_id ";				cmd = cmd  & "  inner join keplersc.kdtmktresult as res on tmkt.c8=res.resultado_id  inner join keplersc.kdtmktaccion as acc on tmkt.c9=acc.accion_id  ";											cmd = cmd & " where tmkt.c1='" & suc_seleccionada & "'";								if (asesor &! ""){					cmd = cmd & " and tmkt.c3 = '" & asesor & "'";				}								if (serie &! ""){					cmd = cmd & " and tmkt.c14 = '" & serie & "'";				}								if (cli &! ""){					cmd = cmd & " and tmkt.c20 = '" & cli & "'";				}							if (fecha_inicial &! ""){					cmd = cmd & " and tmkt.c5 >= '" & fecha_inicial & "'";				}				if (fecha_final &! ""){					cmd = cmd & " and tmkt.c5 <= '" & fecha_final & "'";				}								if (accion &! ""){					cmd = cmd & " and tmkt.c9 = '" & accion& "'";				}										cmd = cmd & " order by tmkt.c2 desc";									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_prod_view.Buscar()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var totres = nXml(cuboResultados);							frn.rst("tabla");				for (var contRes=0; contRes<totres ; contRes++){								frn.setX( getXmlAtt(cuboResultados,"r"&contRes,"c2"),"tabla",contRes,"folio");					frn.setX( getXmlAtt(cuboResultados,"r"&contRes,"c3"),"tabla",contRes,"asesor");					frn.setX( getXmlAtt(cuboResultados,"r"&contRes,"c5"),"tabla",contRes,"fecha_programada");					frn.setX( getXmlAtt(cuboResultados,"r"&contRes,"c14"),"tabla",contRes,"serie");					frn.setX( getXmlAtt(cuboResultados,"r"&contRes,"nombre_cli"),"tabla",contRes,"nombre_cliente");					frn.setX( getXmlAtt(cuboResultados,"r"&contRes,"c7"),"tabla",contRes,"telefono");					frn.setX( getXmlAtt(cuboResultados,"r"&contRes,"c15"),"tabla",contRes,"cita");										var orden = getXmlAtt(cuboResultados,"r"&contRes,"orden");										if (strlen(orden) > 10 ){ 						frn.setX(orden,"tabla",contRes,"orden");										}											frn.setX( getXmlAtt(cuboResultados,"r0","motivo"),"tabla",contRes,"motivo");					frn.setX( getXmlAtt(cuboResultados,"r0","result"),"tabla",contRes,"resultado");					frn.setX( getXmlAtt(cuboResultados,"r0","accion"),"tabla",contRes,"accion");					}						}			fun borrar_datos(){							frn.rst("esta_en_pantalla");				frn.rst("fecha_contacto_real");				frn.rst("tipo_contacto");				frn.rst("motivo_contacto");				frn.rst("resultado_contacto");				frn.rst("accion_contacto");				frn.rst("tipo_servicio_tmkt");				frn.rst("tipo_trabajo");				frn.rst("nombre_contacto");				frn.rst("observaciones");			}						fun detalles(){							borrar_datos();							var xmlRequest,cmd,ok,cubo;				var suc = frn.get("k_sucN", -1, 1);				var folio= frn.get("tabla", -1, "folio");				var asesor= frn.get("tabla", -1, "asesor");								cmd= "select mot.descripcion as motivo, res.descripcion as result, acc.descripcion as accion ,  tmkt.c11 || ' ' || tmkt.c12 || ' ' || tmkt.c13 as observaciones, tmkt.c21, tmkt.c10 ,";				cmd = cmd & " case when tmkt.c4=0 then 'Si' else 'No' end as pantalla, tmkt.c10, case when tmkt.c6=0 then 'Recontacto Programado' else 'Contacto Nuevo' end as tipo ";				cmd = cmd & " ,case when tmkt.c18=0 then 'Servicio' else 'Ventas' end as servicio_tmkt, case when tmkt.c19='P' then 'Proactivo' else 'Reactivo' end as tipo_trabajo  ";				cmd = cmd  & " from keplersc.kdtmktser2 as tmkt inner join keplersc.kdtmktmotivo as mot on tmkt.c7=mot.motivo_id inner join keplersc.kdtmktresult as res on tmkt.c8=res.resultado_id  ";				cmd = cmd  & " inner join keplersc.kdtmktaccion as acc on tmkt.c9=acc.accion_id where tmkt.c1='" & suc_seleccionada & "' and tmkt.c2='" & folio & "' and tmkt.c3='" & asesor & "'";											frn.lib("libGeneral.kpl","FileSave",cmd ,"C:\Basura\cmd ");													var cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_prod_view.Buscar()");								frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								var tot_res = nXml(cuboResultados);								if (tot_res &= 0){					frn.message("Sin resultados","Error","Aceptar");					return;				}								frn.set("esta_en_pantalla" ,getXmlAtt(cuboResultados,"r0","pantalla"));								frn.set("tipo_contacto" ,getXmlAtt(cuboResultados,"r0","tipo"));				frn.set("fecha_contacto_real" ,getXmlAtt(cuboResultados,"r0","c10"));								frn.set("motivo_contacto" ,getXmlAtt(cuboResultados,"r0","motivo"));				frn.set("resultado_contacto" ,getXmlAtt(cuboResultados,"r0","result"));				frn.set("accion_contacto", getXmlAtt(cuboResultados,"r0","accion"));								frn.set("tipo_servicio_tmkt", getXmlAtt(cuboResultados,"r0","servicio_tmkt"));				frn.set("tipo_trabajo", getXmlAtt(cuboResultados,"r0","tipo_trabajo"));								frn.set("nombre_contacto", getXmlAtt(cuboResultados,"r0","c21"));				frn.set("observaciones", getXmlAtt(cuboResultados,"r0","observaciones"));								}										fun guardar_tabla(tabla){				var save = frn.saveFile("tabla","Todos los archivos,*.*","_C:","Para guardar archivo");				frn.dialog("guarda_tabla",tabla,save); 		}									fun llenar_cmb(cuboResultados, cmb){									var len_cubo = nXml(cuboResultados);								var pos_ini = frn.N(cmb);									for (var cont=0; cont<len_cubo ; cont++){								var desc= getXmlAtt(cuboResultados,"r"&cont,"descripcion");					var clave= getXmlAtt(cuboResultados,"r"&cont,"clave");										frn.setX(desc, cmb, cont+pos_ini ,0);					frn.setX(clave, cmb, cont+pos_ini ,1);								}				}											}	</script></pag>