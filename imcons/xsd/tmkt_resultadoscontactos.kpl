<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="0,0,10,10" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">		<tab/><txt fnt="Arial,22" clr="0,0,0">Resultados Contactos</txt><br/>		<tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/><txt>Sucursal: </txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="35,36" bclr="255,255,255" 			brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y" OnChange="borrar()" tooltip="Sucursal"/>				<tab/><txt>Mes: </txt>		<cmb id="cmb_mes" clr="64,64,64" clrBrdr="255,255,255"  dim="18,36" bclr="255,255,255" 			brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y" OnChange="borrar()" tooltip="Mes"/>		<tab/><txt>A&#241;o: </txt>		<inp id="anio" dim="5,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string"  modify="Y" available="Y" tooltip="A&#241;o"/>					<tab n="3"/>		<img id="img_buscar" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0"  modify="Y"  tooltip="Consultar Resultados Contactos"/>		<tab/>		<edt id="fecha_ini" dim="8,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213"				type="date" modify="Y" available="Y" visible="N" fnt="Arial,16" OnF9="Dialog(3,_ks_fecha,fecha_ini)" page="_ks_fecha,fecha_ini" fmt="DD/MM/CCYY" nc="-1"/><tab/>		 <edt id="fecha_fin" dim="8,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213"				type="date" modify="Y" available="Y" visible="N" fnt="Arial,16" OnF9="Dialog(3,_ks_fecha,fecha_fin)" page="_ks_fecha,fecha_fin" fmt="DD/MM/CCYY" nc="-1"/><tab/>		<br/>		<br/>		<tab/>		<grp id="grp_contactos" dim="115,50,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Resultados Contactos">					<sp n="3"/>			<tbl id="tbl_contactos" dim="155,30" brdr="1,0" clr="64,64,64" bclr="236,240,243" clrCur="255,255,255" 				clrBrdr="64,64,64" clrHead="0,58,112" bclrHead="236,240,243" insdel="N" modify="N" Reorder="Y">								<col id="vin_8" name="Vin_8"/> 				<col id="serie" name="Serie"/>				<col id="cve_cliente" name="Cve Cliente"/>				<col id="fec_vale_ultserv" name="Fec vale/ultserv" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="folio_tmkt_n30" name="Folio N-30"/>				<col id="asesor_n30" name="Asesor N-30"/>				<col id="fec_prog_n30" name="Fec Prog N-30" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="mot_n30" name="Mot N-30"/>				<col id="descmot_n30" name="Motivo N-30"/>				<col id="tipo_n30" name="Tipo N-30"/>				<col id="fec_contacto_n30" name="Fec Contacto N-30" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="res_n30" name="Res N-30"/>				<col id="descres_n30" name="Resultado N-30"/>				<col id="acc_n30" name="Acc N-30"/>				<col id="descacc_n30" name="Accion N-30"/>				<col id="m_contacto_n30" name="Medio Cont N-30"/>				<col id="obs_n30" name="Observaciones N-30"/>				<col id="fec_creacion_n30" name="Fec Creacion N-30" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="folio_cita_n30" name="Fol Cita N-30"/>				<col id="estatus_cita_n30" name="EstCit N-30"/>				<col id="descestatus_cita_n30" name="Estatus Cita N-30"/>				<col id="tipo_orden_n30" name="T Orden N-30"/>				<col id="folio_orden_n30" name="Fol Orden N-30"/>				<col id="origen_n30" name="Origen N-30"/>				<col id="folio_tmkt_n15" name="Folio N-15"/>				<col id="asesor_n15" name="Asesor N-15"/>				<col id="fec_prog_n15" name="Fec Prog N-15" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="mot_n15" name="Mot N-15"/>				<col id="descmot_n15" name="Motivo N-15"/>				<col id="tipo_n15" name="Tipo N-15"/>				<col id="fec_contacto_n15" name="Fec Contacto N-15" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="res_n15" name="Res N-15"/>				<col id="descres_n15" name="Resultado N-15"/>				<col id="acc_n15" name="Acc N-15"/>				<col id="descacc_n15" name="Accion N-15"/>				<col id="m_contacto_n15" name="Medio Cont N-15"/>				<col id="obs_n15" name="Observaciones N-15"/>				<col id="fec_creacion_n15" name="Fec Creacion N-15" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="folio_cita_n15" name="Fol Cita N-15"/>				<col id="estatus_cita_n15" name="EstCit N-15"/>				<col id="descestatus_cita_n15" name="Estatus Cita N-15"/>				<col id="tipo_orden_n15" name="T Orden N-15"/>				<col id="folio_orden_n15" name="Fol Orden N-15"/>				<col id="origen_n15" name="Origen N-15"/>				<col id="folio_tmkt_n7" name="Folio N-7"/>				<col id="asesor_n7" name="Asesor N-7"/>				<col id="fec_prog_n7" name="Fec Prog N-7" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="mot_n7" name="Mot N-7"/>				<col id="descmot_n7" name="Motivo N-7"/>				<col id="tipo_n7" name="Tipo N-7"/>				<col id="fec_contacto_n7" name="Fec Contacto N-7" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="res_n7" name="Res N-7"/>				<col id="descres_n7" name="Resultado N-7"/>				<col id="acc_n7" name="Acc N-7"/>				<col id="descacc_n7" name="Accion N-7"/>				<col id="m_contacto_n7" name="Medio Cont N-7"/>				<col id="obs_n7" name="Observaciones N-7"/>				<col id="fec_creacion_n7" name="Fec Creacion N-7" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="folio_cita_n7" name="Fol Cita N-7"/>				<col id="estatus_cita_n7" name="EstCit N-7"/>				<col id="descestatus_cita_n7" name="Estatus Cita N-7"/>				<col id="tipo_orden_n7" name="T Orden N-7"/>				<col id="folio_orden_n7" name="Fol Orden N-7"/>				<col id="origen_n7" name="Origen N-7"/>				<col id="folio_tmkt_n3" name="Folio N-3"/>				<col id="asesor_n3" name="Asesor N-3"/>				<col id="fec_prog_n3" name="Fec Prog N-3" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="mot_n3" name="Mot N-3"/>				<col id="descmot_n3" name="Motivo N-3"/>				<col id="tipo_n3" name="Tipo N-3"/>				<col id="fec_contacto_n3" name="Fec Contacto N-3" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="res_n3" name="Res N-3"/>				<col id="descres_n3" name="Resultado N-3"/>				<col id="acc_n3" name="Acc N-3"/>				<col id="descacc_n3" name="Accion N-3"/>				<col id="m_contacto_n3" name="Medio Cont N-3"/>				<col id="obs_n3" name="Observaciones N-3"/>				<col id="fec_creacion_n3" name="Fec Creacion N-3" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="folio_cita_n3" name="Fol Cita N-3"/>				<col id="estatus_cita_n3" name="EstCit N-3"/>				<col id="descestatus_cita_n3" name="Estatus Cita N-3"/>				<col id="tipo_orden_n3" name="T Orden N-3"/>				<col id="folio_orden_n3" name="Fol Orden N-3"/>				<col id="origen_n3" name="Origen N-3"/>				<col id="folio_tmkt_n1" name="Folio N-1"/>				<col id="asesor_n1" name="Asesor N-1"/>				<col id="fec_prog_n1" name="Fec Prog N-1" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="mot_n1" name="Mot N-1"/>				<col id="descmot_n1" name="Motivo N-1"/>				<col id="tipo_n1" name="Tipo N-1"/>				<col id="fec_contacto_n1" name="Fec Contacto N-1" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="res_n1" name="Res N-1"/>				<col id="descres_n1" name="Resultado N-1"/>				<col id="acc_n1" name="Acc N-1"/>				<col id="descacc_n1" name="Accion N-1"/>				<col id="m_contacto_n1" name="Medio Cont N-1"/>				<col id="obs_n1" name="Observaciones N-1"/>				<col id="fec_creacion_n1" name="Fec Creacion N-1" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="folio_cita_n1" name="Fol Cita N-1"/>				<col id="estatus_cita_n1" name="EstCit N-1"/>				<col id="descestatus_cita_n1" name="Estatus Cita N-1"/>				<col id="tipo_orden_n1" name="T Orden N-1"/>				<col id="folio_orden_n1" name="Fol Orden N-1"/>				<col id="origen_n1" name="Origen N-1"/>				<col id="folio_tmkt_nu" name="Folio NU"/>				<col id="asesor_nu" name="Asesor NU"/>				<col id="fec_prog_nu" name="Fec Prog NU" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="mot_nu" name="Mot NU"/>				<col id="descmot_nu" name="Motivo NU"/>				<col id="tipo_nu" name="Tipo NU"/>				<col id="fec_contacto_nu" name="Fec Contacto NU" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="res_nu" name="Res NU"/>				<col id="descres_nu" name="Resultado NU"/>				<col id="acc_nu" name="Acc NU"/>				<col id="descacc_nu" name="Accion NU"/>				<col id="m_contacto_nu" name="Medio Cont NU"/>				<col id="obs_nu" name="Observaciones NU"/>				<col id="fec_creacion_nu" name="Fec Creacion NU" type="date" nc="-1" fmt="DD/MM/CCYY"/>				<col id="folio_cita_nu" name="Fol Cita NU"/>				<col id="estatus_cita_nu" name="EstCit NU"/>				<col id="descestatus_cita_nu" name="Estatus Cita NU"/>				<col id="tipo_orden_nu" name="T Orden NU"/>				<col id="folio_orden_nu" name="Fol Orden NU"/>				<col id="origen_nu" name="Origen NU"/>			</tbl>					<br/><tab/><txt clr="244,3,51" fnt=",b">* La exportaci&#243;n de registros puede durar varios minutos (&gt;20).</txt><br/>			<tab n="50"/>			<img id="Exportar" dim="40,40" bPx="Y" brdr="0,1" img="60_Save.png" OnEnter="guardar_tabla(tbl_contactos)" available="Y" clrBrdr="0,0,0" visible="Y" 					modify="Y" tooltip="Guardar tabla"/>					</grp>				</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,sys;			var usuario,suc_usuario,rol_usuario,asterisco;			var resMensaje,cubo,cmd,ok,mensajeError,fileSavePath,xmlRequest,cuboResultados,xmlPantalla;			var resultado,mensaje;						fun Main() {				frn=new FRNT;				kdb=new KDB;				sys=new SYS;				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				fileSavePath = "C:\Basura";				asterisco = "*";								Inicializa();			}									fun Inicializa(){				var fecha, strMes, strAnio;;								//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){					cmd = cmd & " where c1='" & suc_usuario & "'";				}else {					if (suc_usuario &! asterisco && suc_usuario &! "" ){						cmd = cmd & " where c1='" & suc_usuario & "'";					}				}				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"sertmktview.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_sucn",getXml(cubo));					//Lenar combo mes				frn.setX("Enero","cmb_mes",0,0);				frn.setX("1","cmb_mes",0,1);				frn.setX("Febrero","cmb_mes",1,0);				frn.setX("2","cmb_mes",1,1);				frn.setX("Marzo","cmb_mes",2,0);				frn.setX("3","cmb_mes",2,1);				frn.setX("Abril","cmb_mes",3,0);				frn.setX("4","cmb_mes",3,1);				frn.setX("Mayo","cmb_mes",4,0);				frn.setX("5","cmb_mes",4,1);				frn.setX("Junio","cmb_mes",5,0);				frn.setX("6","cmb_mes",5,1);				frn.setX("Julio","cmb_mes",6,0);				frn.setX("7","cmb_mes",6,1);				frn.setX("Agosto","cmb_mes",7,0);				frn.setX("8","cmb_mes",7,1);				frn.setX("Septiembre","cmb_mes",8,0);				frn.setX("9","cmb_mes",8,1);					frn.setX("Octubre","cmb_mes",9,0);				frn.setX("10","cmb_mes",9,1);				frn.setX("Noviembre","cmb_mes",10,0);				frn.setX("11","cmb_mes",10,1);				frn.setX("Diciembre","cmb_mes",11,0);				frn.setX("12","cmb_mes",11,1);				//Inicializa mes				fecha = sys.date();								strMes = sys.date("month")-1;				strAnio = sys.date("year");				if (strMes ==0){					strMes = 12;					strAnio = sys.date("year")-1;				}								frn.set("cmb_mes",descr_combo("cmb_mes",1,strMes));				frn.set("anio",strAnio);				frn.set("fecha_ini",sys.date(strAnio,strMes,1));				frn.set("fecha_fin",sys.date(strAnio,strMes,31));			}						fun borrar(){				frn.rst("tbl_contactos");				}                     										fun Buscar() {				var criterio,xmlDetConv, xmlDetalle, strTmp,contDet,xmlCurDet;				frn.set("fecha_ini",sys.date(frn.get("anio"),frn.get("cmb_mes",-1,1),1));				frn.set("fecha_fin",sys.date(frn.get("anio"),frn.get("cmb_mes",-1,1),31));								setXml(xmlPantalla,"sucursal_id",frn.get("k_sucn",-1,1));				setXml(xmlPantalla,"mes",frn.get("cmb_mes",-1,1));				setXml(xmlPantalla,"anio",frn.get("anio"));				setXml(xmlPantalla,"fecha_ini",frn.get("fecha_ini"));				setXml(xmlPantalla,"fecha_fin",frn.get("fecha_fin"));//				frn.lib("libGeneral.kpl","FileSave",xmlPantalla,fileSavePath & "\XmlPantalla");							cmd="SELECT * FROM keplersc.ser_tmkt_cons_resultados_contactos('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";				rstXml(cubo);									cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"tmkt_resultadoscontactos.Buscar");				//				frn.lib("libGeneral.kpl","FileSave",cubo, fileSavePath & "\XmlResultado");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				rstXml(xmlDetConv);				strTmp=getXmlAtt(cubo,"r0","ser_tmkt_cons_resultados_contactos");//				frn.lib("libGeneral.kpl","FileSave",strTmp,fileSavePath & "\strTmp");				rstXml(xmlDetalle);				strTmp=delScpScn(strTmp);				setXmlStr(xmlDetalle,strTmp);				contDet=nXml(xmlDetalle);				for(var y=0; y< contDet; y++){					rstXml(xmlCurDet);					xmlCurDet= getXmlX(xmlDetalle,3,y);						setXml(xmlDetConv,"tbl_contactos","r"&y,xmlCurDet);				}					frn.lib("libGeneral.kpl","FileSave",xmlDetConv,fileSavePath & "\cuboRowsContactos");									//Llena la tabla automatico					if (nXml(xmlDetConv) == 0){					frn.message("Sin Resultados","Error","Aceptar");				} else {					frn.setX(xmlDetConv);				}							}			fun descr_combo(combo,posicion,valor){				var descr, valor_actual;				var len_combo = frn.N(combo);				for (var cont=0; cont<len_combo ; cont++){					valor_actual= frn.get(combo,cont,posicion);					if (valor_actual &=  valor){						descr = frn.get(combo,cont,0);						return descr;					}				}			}						fun guardar_tabla(tabla){				var save = frn.saveFile("resultado_contactos","Todos los archivos,*.*","_C:","Para guardar archivo");				frn.dialog("guarda_tabla",tabla,save,"Resultados de Contactos","","",124); 			}										fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}									}	</script></pag>