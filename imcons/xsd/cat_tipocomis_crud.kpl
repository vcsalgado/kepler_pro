<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<grp id="grupo_crud" dim="50,26,20,10" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18"><tab/>			<br/><br/>			<tab/><txt id="text_id">Clave:</txt><tab n="2"/>	<sp/>			<inp id="clave_com" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" available="N"/><br/><tab/>						<txt id="text_id">Descripcion:</txt><tab n="1"/><sp/>			<inp id="desc_com" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><tab/>						<txt id="text_id">Tipo:</txt><tab n="2"/><sp/>			<inp id="tipo_com" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number"  clrBrdr="255,255,255"/><br/><tab n="2"/><txt fnt=",15">0 Importe; 10 Utilidad; 20 Precio (Importe-IVA-ISAN); 30 Cuota Fija</txt><tab/><br/><tab/>									<txt>Limite Superior edad 1:</txt>			<inp id="limite_sup_edad_1" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" clrBrdr="255,255,255"/><br/><tab/>										<txt>Limite Superior edad 2:</txt>			<inp id="limite_sup_edad_2" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number" clrBrdr="255,255,255"/><br/><tab/>										<txt>Limite Superior edad 3:</txt>			<inp id="limite_sup_edad_3" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="number"  clrBrdr="255,255,255"/><br/><tab/>					<br/>			<tab n="5"/><bot id="btn_aceptar" dim="5,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="0" visible="Y" available="Y"/><br/>						<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>									</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP, accion,externo, clave_sel ;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();							ctlrs_off();				insertar_datos();											}						fun ctlrs_off(){							accion = frn.param(0);				frn.set("input_crud", accion);				frn.rst("grupo_crud");				externo	= frn.param(2);				frn.setAtt("grupo_crud", "tit", accion );				clave_sel = frn.param(1);										frn.setAtt("clave_com", "available", "N" );				frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );								if (accion &= "Nuevo"){					frn.setAtt("clave_com", "available", "Y" );								}else{					frn.set("clave_com", clave_sel );				}								if (accion &! "Consultar"){					frn.setAtt("btn_aceptar", "available", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );				}						}							fun insertar_datos(){							var xmlRequest,cmd,ok, cuboResultados;								if (accion &= "Modificar"){									//llamada externa(padre)					if (externo &= "s"){							if (clave_sel &= ""){													frn.message("selecciona una clave con F9 para modificar","Error","Aceptar");							frn.setAtt("btn_aceptar", "visible", "N" );							return;						}											}				}										if (accion &! "Nuevo") {													cmd="select c2,c3,c4,c5,c6 from keplersc.kdtipocomis where c1 ='" & clave_sel & "'"; 									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_tipocomis_crud.insertar_datos()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						var mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}											frn.set("desc_com",getXmlAtt(cuboResultados,"r"&0,"c2"));					frn.set("tipo_com",getXmlAtt(cuboResultados,"r"&0,"c3"));					frn.set("limite_sup_edad_1",getXmlAtt(cuboResultados,"r"&0,"c4"));					frn.set("limite_sup_edad_2",getXmlAtt(cuboResultados,"r"&0,"c5"));					frn.set("limite_sup_edad_3",getXmlAtt(cuboResultados,"r"&0,"c6"));					}			}								fun Execute() {						var xmlRequest,cmd,cuboResultados,ok,cmd,cubo, mensajeError ;								var resultado_confirmacion = frn.message("�Estas seguro?","Mensaje de Confirmacion", 2);									if (resultado_confirmacion &! 1)  {					return;				}																	xmlRequest = getXml(frn.dataPag()); 							frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmd="SELECT * FROM keplersc.tipocomis_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";					cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmd,"cat_tipocomis_crud.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");													var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;						}												if (accion &= "Nuevo" || accion &= "Modificar") {																		var clave_nueva= frn.get("clave_com");					var desc_nueva = frn.get("desc_com");																		if (externo &= "n"){											frP.setX(clave_nueva,"tabla",-1,"clave"); 						frP.scriptElm("tabla","OnChange","clave");												frP.setX(desc_nueva ,"tabla",-1,"desc"); 						frP.scriptElm("tabla","OnChange","desc");															}else {									//TODO, insertar registros en pantalla externa									}										var sms =  "";										if (accion &= "Nuevo"){						sms = "Registro guardado";					}else {						sms = "Registro modificado";					}											frn.message(sms ,"Mensaje","Aceptar");					frn.exit();										}								if (accion &= "Eliminar"){						frP.setX("","tabla",-1,"clave"); 					frP.scriptElm("tabla","OnChange","clave");											frP.setX("","tabla",-1,"desc"); 					frP.scriptElm("tabla","OnChange","desc");									frn.message("Registro eliminado","Mensaje","Aceptar");					frn.exit();									}						}													}	</script></pag>