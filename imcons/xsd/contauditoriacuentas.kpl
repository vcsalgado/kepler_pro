<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Catalogo de Cuentas"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,15,12" bclr="192,205,213" unfont="0">	<tab/>	<br/><sp/><txt clr="0,0,0" fnt=",22">Auditor&#237;a de Cuentas</txt>	<br/>	<sp/>	<hLine clr="0,0,0"/>	<br/><br/>	<sp/>	<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" 		dim="50,6,10,10" brdr="0,5" tit="Criterio de proceso" fnt="Arial,16">		<sp/>		<txt>Sucursal:</txt>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="40,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="BorraDatos()" 			available="Y" OnChange="ResetResults()"/><tab/>		<txt>A&#241;o:</txt>		<cmb id="k_anio" clr="64,64,64" clrBrdr="192,205,213" dim="7,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" 			available="Y" OnChange="ResetResults()" Null="N"/><tab/>		<img id="bot_buscar" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar_Registros()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>					</grp>			<br/><br/>		<sp/>			<grp id="gpoIntPolDes" bclr="236,240,243" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" 		dim="50,20,7,12"  tit="P&#243;lizas descuadradas" fnt="Arial,16" unfont="0" visible="Y">		<sp/>		<tbl id="k_movtos" dim="104,12" brdr="1,0" clrBrdr="64,64,64" bclr="255,255,255" modify="N" nren="fijo" clr="64,64,64" clrCur="192,205,213" 			OnEnter="abrir_poliza(DF)" OnMouseD="abrir_poliza(DF)">			<col id="anio" name="A&#241;o" type="string"/>			<col id="mes" name="Mes" type="string"/>						<col id="k_poliza" name="P&#243;liza"/>						<col id="tipopoliza" name="Tipo" type="string"/>			<col id="cargo_movto" name="Cargos" type="number" nd="2"/>			<col id="abono_movto" name="Abonos" type="number" nd="2"/>							<col id="Diferencia" name="Diferencia" type="number" nd="2"/>			<col id="gen" name="Genero" type="string"/>			<col id="nat" name="Ntza" type="string"/>			<col id="gpo" name="Gpo" type="string"/>			<col id="tipo" name="Tipo" type="string"/><col id="folio" name="Folio" type="string"/>		</tbl><br/><txt clr="250,0,0">* Doble click para consultar p&#243;liza</txt>	</grp>		<sp/>		<grp id="gpoIntPolDes" bclr="236,240,243" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" 		dim="50,20,7,12"  tit="P&#243;lizas descuadradas Int" fnt="Arial,16" unfont="0" visible="Y">		<sp/>		<tbl id="k_movtos_int" dim="104,12" brdr="1,0" clrBrdr="64,64,64" bclr="255,255,255" modify="N" nren="fijo" clr="64,64,64" clrCur="192,205,213" 			OnEnter="abrir_poliza(DI)" OnMouseD="abrir_poliza(DI)" visible="Y">			<col id="anio" name="A&#241;o" type="string"/>			<col id="mes" name="Mes" type="string"/>						<col id="k_poliza" name="P&#243;liza"/>						<col id="tipopoliza" name="Tipo" type="string"/>			<col id="cargo_movto" name="Cargos" type="number" nd="2"/>			<col id="abono_movto" name="Abonos" type="number" nd="2"/>							<col id="Diferencia" name="Diferencia" type="number" nd="2"/>			<col id="gen" name="Genero" type="string"/>			<col id="nat" name="Ntza" type="string"/>			<col id="gpo" name="Gpo" type="string"/>			<col id="tipo" name="Tipo" type="string"/><col id="folio" name="Folio" type="string"/>		</tbl><br/><txt clr="250,0,0">* Doble click para consultar p&#243;liza</txt>	</grp>		<br/><br/>	<sp/>			<grp id="gpoIntCtasErr" bclr="236,240,243" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" 		dim="50,20,7,12"  tit="Cuentas con errores" fnt="Arial,16" unfont="0" visible="Y">		<sp/>		<tbl id="k_ctaserr" dim="104,12" brdr="1,0" clrBrdr="64,64,64" bclr="255,255,255" modify="N" nren="fijo" clr="64,64,64" clrCur="192,205,213" 			OnEnter="abrir_poliza(EF)" OnMouseD="abrir_poliza(EF)">			<col id="anio" name="A&#241;o" type="string"/>			<col id="mes" name="Mes" type="string"/>						<col id="k_poliza" name="P&#243;liza"/>						<col id="tipopoliza" name="Tipo" type="string"/>			<col id="cuenta" name="Tipo" type="string"/>				<col id="error" name="Error" type="string"/>				<col id="gen" name="Genero" type="string"/>			<col id="nat" name="Ntza" type="string"/>			<col id="gpo" name="Gpo" type="string"/>			<col id="tipo" name="Tipo" type="string"/><col id="folio" name="Folio" type="string"/>		</tbl><br/><txt clr="250,0,0">* Doble click para consultar p&#243;liza</txt>	</grp>		<sp/>			<grp id="gpoIntCtasErr" bclr="236,240,243" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" 		dim="50,20,7,12"  tit="Cuentas con errores Int" fnt="Arial,16" unfont="0">		<sp/>		<tbl id="k_ctaserr_int" dim="104,12" brdr="1,0" clrBrdr="64,64,64" bclr="255,255,255" modify="N" nren="fijo" clr="64,64,64" clrCur="192,205,213" 			OnEnter="abrir_poliza(EI)" OnMouseD="abrir_poliza(EI)">			<col id="anio" name="A&#241;o" type="string"/>			<col id="mes" name="Mes" type="string"/>						<col id="k_poliza" name="P&#243;liza"/>						<col id="tipopoliza" name="Tipo" type="string"/>			<col id="cuenta" name="Tipo" type="string"/>				<col id="error" name="Error" type="string"/>				<col id="gen" name="Genero" type="string"/>			<col id="nat" name="Ntza" type="string"/>			<col id="gpo" name="Gpo" type="string"/>			<col id="tipo" name="Tipo" type="string"/><col id="folio" name="Folio" type="string"/>		</tbl><br/><txt clr="250,0,0">* Doble click para consultar p&#243;liza</txt>	</grp>			</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario,asterisco, externo, cuboXml;			var accion,tipoOper; 			var regTotales,ultimoValorEncontrado, contGlobalResults; //variables del llenado de la tabla			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				//Constantes								suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";				ConfiguraUI();				Inicializa();			}			fun Inicializa(){				var cmd, cubo, ok,resValidacion,resMensaje ;							frn.rst("gpo_2");				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"contauditoriacuentas.Inicializa()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frn.set("k_sucn",getXml(cubo));									//Combo de anios				rstXml(cubo);				cmd="select anio from keplersc.kdccuentas group by anio order by anio desc";				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"contauditoriacuentas.Inicia_Forma()");				frn.set("k_anio",getXml(cubo));				var lonx = nXml(cubo);								frn.setX("Todos","k_anio",lonx,0);			}			fun ResetResults(){				frn.rst("k_movtos");				frn.rst("k_movtos_int");				frn.rst("k_ctaserr");				frn.rst("k_ctaserr_int");			}			fun ConfiguraUI(){				frn.setAtt("gpoIntPolDes","visible","N");				frn.setAtt("gpoIntCtasErr","visible","N");				if (rol_usuario &= "ADMINISTRADOR"){					frn.setAtt("gpoIntPolDes","visible","Y");					frn.setAtt("gpoIntCtasErr","visible","Y");				}			}								fun Inicia_Forma(){				//Etiquetas 				frn.set("inp_mensaje","No se encontraron registros...");				//frn.set("inp_titulo",strTitulo);				frn.set("inp_filtros","Búsqueda");			}			fun Buscar_Registros(){				Polizas_Desc();				Cuentas_Error();								//Tablas integradas							Polizas_Desc_Int();				Cuentas_Error_Int();			}			fun Polizas_Desc(){				var clave,descripcion,anio,mes,sucursal;				var cmd, mensajeError,ok,nReg, colCriterio,criterio,expWhere,expOrder;				anio=frn.get("k_anio",-1,0);				sucursal=frn.get("k_sucn",-1,1);				expWhere="where c14='" & sucursal & "' ";				if(anio &! "Todos"){					expWhere = expWhere & "and anio='" & anio & "' ";				}												cmd="select * from 					(select anio,mes,no_poliza,tipo_pol,sum(cargos) as cargos, sum(abonos) as abonos, sum(cargos)-sum(abonos) as total,					gen,nat,gpo,tipo,folio from					(select anio,mes,c1 as no_poliza, c8 as tipo_pol,					case when c4='C' then sum(c5) else 0 end as cargos ,					case when c4='A' then sum(c5) else 0 end as abonos,					c15 as gen, c16 as nat, c17 as gpo, c18 as tipo, c19 as folio 					from keplersc.kdc2_view ";				cmd = cmd & expWhere;				cmd = cmd &	"group by anio,mes,c1,c4,c8,c15,c16,c17,c18,c19					order by anio,mes,c1) as movimientos 					group by anio,mes,no_poliza,tipo_pol,gen,nat,gpo,tipo,folio) as sumas					where total <> 0 					order by sumas desc ";					//frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdConsMovtos");										cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"contauditoriacuentas.ConsultarMovtos()");//frn.lib("libGeneral.kpl","FileSave",cuboXml,"C:\Basura\xmConsMovtos");					ok=getXmlAtt(cuboXml,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}						frn.set("k_movtos",cuboXml);			}			fun Polizas_Desc_Int(){				var clave,descripcion,anio,mes,sucursal;				var cmd, mensajeError,ok,nReg, colCriterio,criterio,expWhere,expOrder;				anio=frn.get("k_anio",-1,0);				sucursal=frn.get("k_sucn",-1,1);				expWhere="where c14='" & sucursal & "' ";				if(anio &! "Todos"){					expWhere = expWhere & "and anio='" & anio & "' ";				}												cmd="select * from 					(select anio,mes,no_poliza,tipo_pol,sum(cargos) as cargos, sum(abonos) as abonos, sum(cargos)-sum(abonos) as total,					gen,nat,gpo,tipo,folio from					(select anio,mes,c1 as no_poliza, c8 as tipo_pol,					case when c4='C' then sum(c5) else 0 end as cargos ,					case when c4='A' then sum(c5) else 0 end as abonos,					c15 as gen, c16 as nat, c17 as gpo, c18 as tipo, c19 as folio 					from keplersc.kdcpolizas ";				cmd = cmd & expWhere;				cmd = cmd &	"group by anio,mes,c1,c4,c8,c15,c16,c17,c18,c19					order by anio,mes,c1) as movimientos 					group by anio,mes,no_poliza,tipo_pol,gen,nat,gpo,tipo,folio) as sumas					where total <> 0 					order by sumas desc ";										cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"contauditoriacuentas.ConsultarMovtos()");					ok=getXmlAtt(cuboXml,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboXml,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}						frn.set("k_movtos_int",cuboXml);						}			fun Cuentas_Error(){				var clave,descripcion,anio,mes,sucursal;				var cmd, mensajeError,ok,nReg, colCriterio,criterio,expWhere,expOrder;				anio=frn.get("k_anio",-1,0);				sucursal=frn.get("k_sucn",-1,1);				expWhere="where c14='" & sucursal & "' ";				if(anio &! "Todos"){					expWhere = expWhere & "and anio='" & anio & "' ";				}								cmd="select polizas.anio,polizas.mes,c1 as k_poliza,c8 as tipopoliza,c3 as cuenta, resultados.error, c15 as gen, c16 as nat, c17 as gpo, c18 as tipo, c19 as folio from				(select * from				(select distinct anio, pol.c3 as cuenta, 'No es último nivel' as error from keplersc.kdc2_view pol " & expWhere & " order by c3) as polcta				where 				(select count(*) from keplersc.kdc1_view ctas where ctas.anio= polcta.anio and position(polcta.cuenta in ctas.c1)>0 and substring(ctas.c1,1,1)=substring(polcta.cuenta,1,1) and ctas.c1<>polcta.cuenta) > 0 				union				select * from 				(select distinct anio, pol.c3 as cuenta, 'Sin nivel superior' as error from keplersc.kdc2_view pol  " & expWhere & " order by c3) as polcta				where 				(select count(*) from keplersc.kdc1_view ctas where ctas.anio= polcta.anio and position(ctas.c1 in polcta.cuenta)>0 and substring(ctas.c1,1,1)=substring(polcta.cuenta,1,1) and ctas.c1<>polcta.cuenta)=0				union 				select * from 				(select distinct anio, pol.c3 as cuenta, 'Sin registro en catálogo de cuentas' as error from keplersc.kdc2_view pol " & expWhere & " order by c3) as polcta				where 				(select count(*) from keplersc.kdc1_view ctas where ctas.anio= polcta.anio and position(ctas.c1 in polcta.cuenta)>0 and substring(ctas.c1,1,1)=substring(polcta.cuenta,1,1) and ctas.c1<>polcta.cuenta)=0) as resultados				inner join keplersc.kdc2_view polizas on resultados.cuenta=polizas.c3				order by polizas.anio,polizas.mes,polizas.c3";								cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"Cuentas_Error.ConsultarMovtos()");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboXml,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}					frn.set("k_ctaserr",cuboXml);						}			fun Cuentas_Error_Int(){				var clave,descripcion,anio,mes,sucursal;				var cmd, mensajeError,ok,nReg, colCriterio,criterio,expWhere,expOrder;				anio=frn.get("k_anio",-1,0);				sucursal=frn.get("k_sucn",-1,1);				expWhere="where c14='" & sucursal & "' ";				if(anio &! "Todos"){					expWhere = expWhere & "and anio='" & anio & "' ";				}								cmd="select polizas.anio,polizas.mes,c1 as k_poliza,c8 as tipopoliza,c3 as cuenta, resultados.error, c15 as gen, c16 as nat, c17 as gpo, c18 as tipo, c19 as folio from				(select * from				(select distinct anio,mes, pol.c3 as cuenta, 'No es último nivel' as error from keplersc.kdcpolizas pol " & expWhere & " order by c3) as polcta				where 				(select count(*) from keplersc.kdccuentas ctas where ctas.anio= polcta.anio and position(polcta.cuenta in ctas.c1)>0 and substring(ctas.c1,1,1)=substring(polcta.cuenta,1,1) and ctas.c1<>polcta.cuenta) > 0 				union				select * from 				(select distinct anio,mes, pol.c3 as cuenta, 'Sin nivel superior' as error from keplersc.kdcpolizas pol  " & expWhere & " order by c3) as polcta				where 				(select count(*) from keplersc.kdccuentas ctas where ctas.anio= polcta.anio and position(ctas.c1 in polcta.cuenta)>0 and substring(ctas.c1,1,1)=substring(polcta.cuenta,1,1) and ctas.c1<>polcta.cuenta)=0				union 				select * from 				(select distinct anio,mes, pol.c3 as cuenta, 'Sin registro en catálogo de cuentas' as error from keplersc.kdcpolizas pol " & expWhere & " order by c3) as polcta				where 				(select count(*) from keplersc.kdccuentas ctas where ctas.anio= polcta.anio and position(ctas.c1 in polcta.cuenta)>0 and substring(ctas.c1,1,1)=substring(polcta.cuenta,1,1) and ctas.c1<>polcta.cuenta)=0) as resultados				inner join keplersc.kdcpolizas polizas on resultados.cuenta=polizas.c3 and resultados.anio=polizas.anio and resultados.mes=polizas.mes				order by polizas.anio,polizas.mes,polizas.mes,polizas.c3";				//frn.lib("libGeneral.kpl","FileSave",cmd,"C:\Basura\cmdCuentas_Error_Int");				cuboXml= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"Cuentas_Error_Int.ConsultarMovtos()");				ok=getXmlAtt(cuboXml,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboXml,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}					frn.set("k_ctaserr_int",cuboXml);						}			fun abrir_poliza(tipotbl){				var cmd ="",v_strTmp,v_anio, v_mes,cuboProd,ok,mensajeError;				var gen,nat,gpo,tipo,sucursal_id,anio,mes,tipo_poliza,folio,tipo_movto,param;				var tabla_origen;				sucursal_id = frn.get("k_sucn",-1,1);				tipo_movto = "C";				if(tipotbl &= "DF"){					tabla_origen="F";					anio =frn.get("k_movtos",-1,"anio");					mes=frn.get("k_movtos",-1,"mes");					gen=frn.get("k_movtos",-1,"gen");					nat=frn.get("k_movtos",-1,"nat");					gpo=frn.get("k_movtos",-1,"gpo");					tipo=frn.get("k_movtos",-1,"tipo");					tipo_poliza=frn.get("k_movtos",-1,"tipopoliza");									folio=frn.get("k_movtos",-1,"k_poliza");				}												if(tipotbl &= "DI"){					tabla_origen="I";					anio =frn.get("k_movtos_int",-1,"anio");					mes=frn.get("k_movtos_int",-1,"mes");					gen=frn.get("k_movtos_int",-1,"gen");					nat=frn.get("k_movtos_int",-1,"nat");					gpo=frn.get("k_movtos_int",-1,"gpo");					tipo=frn.get("k_movtos_int",-1,"tipo");					tipo_poliza=frn.get("k_movtos_int",-1,"tipopoliza");									folio=frn.get("k_movtos_int",-1,"k_poliza");				}				if(tipotbl &= "EF"){					tabla_origen="F";					anio =frn.get("k_ctaserr",-1,"anio");					mes=frn.get("k_ctaserr",-1,"mes");					gen=frn.get("k_ctaserr",-1,"gen");					nat=frn.get("k_ctaserr",-1,"nat");					gpo=frn.get("k_ctaserr",-1,"gpo");					tipo=frn.get("k_ctaserr",-1,"tipo");					tipo_poliza=frn.get("k_ctaserr",-1,"tipopoliza");									folio=frn.get("k_ctaserr",-1,"k_poliza");				}								if(tipotbl &= "EI"){					tabla_origen="I";					anio =frn.get("k_ctaserr_int",-1,"anio");					mes=frn.get("k_ctaserr_int",-1,"mes");					gen=frn.get("k_ctaserr_int",-1,"gen");					nat=frn.get("k_ctaserr_int",-1,"nat");					gpo=frn.get("k_ctaserr_int",-1,"gpo");					tipo=frn.get("k_ctaserr_int",-1,"tipo");					tipo_poliza=frn.get("k_ctaserr_int",-1,"tipopoliza");									folio=frn.get("k_ctaserr_int",-1,"k_poliza");				}				//param=gen & "," & nat &  "," & gpo & "," & tipo & "," & tipo_movto & "," & sucursal_id & "," & anio & "," & mes & "," & tipo_poliza & "," & folio & "," & tabla_origen;//frn.message(param,"Mensaje","Aceptar");									frn.dialog("conpolizapag.kpl",gen,nat,gpo,tipo,tipo_movto,sucursal_id,anio,mes,tipo_poliza,folio,tabla_origen);			}												fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}		}	</script></pag>