<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<tab/><inp id="k_titulo" dim="65,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"				type="string" modify="N" available="N" fnt="Arial,22"/>		<br/>		<br/>		<tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>        <grp id="grupo_crud" dim="105,20,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="Nuevo" available="Y"><tab/>			<br/><br/><tab/>            <txt>Clave Cargo :</txt><tab/>			<inp id="k_clave" dim="15,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="10" available="Y" tooltip="Clave del Cargo"/><br/><sp/><tab/>			<txt>Clave  SAT :</txt><tab/>			<inp id="k_sat" dim="15,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="10" tooltip="Clave del SAT"/><br/><sp/><tab/>			<txt>Descripcion :</txt><tab/>			<inp id="k_descripcion" dim="88,3" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="300" clrBrdr="255,255,255" tooltip="Descripci&#243;n"/><br/><sp/><tab/>			<txt>Unidad :</txt><tab n="2"/>			<inp id="k_unidad" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="5" clrBrdr="255,255,255" tooltip="Unidad"/><br/><sp/>            <tab n="15"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="1" visible="Y" available="Y"/>			<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><br/><tab/>			</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP, accion,externo, clave_sel,sucursal_id,resVal,straccion;            var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();							ctlrs_off();				insertar_datos();											}						fun ctlrs_off(){							accion = frn.param(0);				frn.set("input_crud", accion);				frn.rst("grupo_crud");				externo	= frn.param(2);                if (accion &= "NUEVO"){                    straccion = "Nuevo" ;                   }else if (accion &= "CONSULTAR"){                    straccion = "Consultar";                }else if (accion &= "MODIFICAR"){                    straccion = "Modificar";                }else if (accion &= "ELIMINAR"){                    straccion = "Eliminar";                }     				frn.setAtt("grupo_crud", "tit", straccion );				clave_sel = frn.param(1);                sucursal_id = frn.param(3);						frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );				if (accion &= "NUEVO"){					frn.setAtt("k_clave", "available", "Y" );                    frn.set("k_titulo","Catalogo de Notas de Cargo");								}else{					frn.set("k_clave", clave_sel );                    frn.setAtt("k_clave", "available", "Y" );                    frn.setAtt("k_clave", "modify", "N" );				}								if (accion &! "CONSULTAR"){					frn.setAtt("btn_aceptar", "available", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );				}						}							fun insertar_datos(){					if (accion &= "MODIFICAR"){					//llamada externa(padre)					if (externo &= "s"){						if (clave_sel &= ""){							frn.message("selecciona una clave con F9 para modificar","Error","Aceptar");							frn.setAtt("btn_aceptar", "visible", "N" );							return;						}					}				}				if (accion &! "NUEVO") {					cmdQuery="select c2,c3,c4 from keplersc.kdncargocat where c1='" & clave_sel & "'"; 									cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_notacargo_crud.insertar_datos()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");										ok=getXmlAtt(cuboResultados,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboResultados,"native3");						frn.message(mensajeError,"Error","Aceptar");						return;					}						frn.set("k_sat",getXmlAtt(cuboResultados,"r"&0,"c2"));					frn.set("k_descripcion",getXmlAtt(cuboResultados,"r"&0,"c3"));					frn.set("k_unidad",getXmlAtt(cuboResultados,"r"&0,"c4"));                    if (accion &= "MODIFICAR") {                        frn.setAtt("grupo_crud", "available","Y");                    }else{                        frn.setAtt("k_clave", "available","Y");                        frn.setAtt("k_clave", "modify", "N" );                        frn.setAtt("k_sat", "available","N");                        frn.setAtt("k_descripcion", "available","N");                        frn.setAtt("k_unidad", "available","N");                        frn.setAtt("btn_aceptar", "available", "Y" );                    }                }else{                    frn.setAtt("grupo_crud", "available","Y");                    frn.setPos("k_clave");    				}			}            fun ValidarDatos(){				if (frn.get("k_clave") &= "") {											frn.setPos("k_clave");					resVal=0;					frn.message("Debe especificar la clave, verificar","Error","Aceptar");				} 				if (frn.get("k_sat") &= "") {											frn.setPos("k_sat");					resVal=0;					frn.message("Debe especificar la clave del SAT, verificar","Error","Aceptar");				}				if (frn.get("k_descripcion") &= "") {											frn.setPos("k_descripcion");					resVal=0;					frn.message("Debe especificar la descripcion, verificar","Error","Aceptar");				}                if (frn.get("k_unidad") &= "") {											frn.setPos("k_unidad");					resVal=0;					frn.message("Debe especificar la unidad, verificar","Error","Aceptar");				}			}					fun Execute() {                resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}				var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}						xmlRequest = getXml(frn.dataPag());	                frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmdQuery="SELECT * FROM keplersc.cat_notacargo_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"cat_notacargo_crud.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}				frP.script("Inicia_Forma()");				if (accion &= "NUEVO" || accion &= "MODIFICAR") {						var sms =  "";					if (accion &= "NUEVO"){						sms = "Registro guardado";					}else {						sms = "Registro modificado";					}                    frn.setAtt("btn_aceptar", "available", "N" );					frn.setAtt("k_clave", "available","N");                    frn.setAtt("k_sat", "available","N");                    frn.setAtt("k_descripcion", "available","N");                    frn.setAtt("k_unidad", "available","N");					frn.message(sms ,"Mensaje","Aceptar");					frn.exit();					}				if (accion &= "ELIMINAR"){					frn.message("Registro eliminado","Mensaje","Aceptar");					frn.exit();							}			}				}	</script></pag>