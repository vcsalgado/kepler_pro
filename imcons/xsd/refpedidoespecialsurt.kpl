<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="T&#237;tulo">	<grp dim="1,-1,10,20" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()">	<tab/><txt fnt=",22" clr="0,0,0">Pedidos Especiales  -  Surtir</txt><br/>	<!-- dim="81,0" --> 	<tab/><hLine clr="0,0,0"/> 	<br/> 	<br/> 	<tab/>		<grp dim="47,6,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Par&#225;metros"><txt>  Sucursal : </txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255" dim="52,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" OnChange="CambiaSucursal()" available="Y" modify="Y"/>			<br/>			<sp n="1"/> <inp id="c_st" dim="62,1" bclr="240,240,240" clr="167,23,37" clrBrdr="255,255,255" type="string" fnt=",17" modify="N" available="N" just="L" visible="Y"/> 			<br/>		</grp>				<sp/>				<!-- dim="34,9,7,12" -->		<grp dim="37,6,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Detalle">			<sp n="1"/>			<inp id="operacion" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",18b" just="C" available="N"/> <br/>			<txt id="textFolio" visible="Y">  Folio :  </txt>			<edt id="k_folio" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="Y" visible="Y" OnButton="ObtenerFolios()" OnF9="ObtenerFolios()" OnChange="BuscarFolio()"/> 				<!--			<sp n="1"/>			<inp id="k_docto" dim="40,1" bclr="240,240,240" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="N" fnt=",16b" just="C"/> <br/>			-->			<txt>  Fecha : </txt> 			<edt id="k_fecha" dim="15,1" type="date" fmt="DD/MM/CCYY" brdr="2,0" bclr="255,255,255" clr="64,64,64" page="_ks_fecha,k_fecha" OnF9="Dialog(3,_ks_fecha,k_fecha)" clrBrdr="255,255,255" available="N"/> 			<!-- 			<sp n="1"/> <txt>  Hora : </txt> 			<sp n="1"/> <edt id="k_hora" dim="15,1" type="string" nc="-1" bclr="240,240,240" modify="N" fmt="HH:MM:SS" available="N"/> 			-->			<br/>		</grp>		<br/>		<br/>				<!-- dim="81,14,7,12" -->		<tab/>		<grp dim="85,10,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Datos Referencia">							<sp n="1"/> <txt clr="0,58,112">VIN : </txt> <sp n="6"/>			<edt id="k_serie" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" visible="Y" OnButton="ObtenerVin()" OnF9="ObtenerVin()" OnChange="MostrarVin()"/> 			<sp n="2"/> <inp id="k_modelo" dim="37,1" type="string" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="N" nc="-1"/> 			<sp n="2"/> <inp id="k_clien" dim="11,1" type="string" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="N" nc="-1"/> 			<br/>						<sp n="1"/> <txt clr="0,58,112">Anticipo : </txt> <sp n="2"/>			<edt id="k_refer" clr="64,64,64" clrBrdr="255,255,255"  dim="30,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="string" nc="10" available = "N" modify="Y" 						OnF9="ObtenerRef()" OnChange="MostrarRef()" OnButton="ObtenerRef()"/>					<sp n="2"/>	<inp id="k_ref_fech" dim="16,1" type="string" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="N" nc="-1"/>			<sp n="2"/>	<inp id="k_ref_monto" dim="19,1" type="number" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="N" nc="-1" visible="N"/>  			<sp n="2"/>	<inp id="k_ref_clien" dim="11,1" type="string" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="N" nc="-1"/> 			<br/>						<sp n="1"/> <txt>Tipo Orden : </txt>			<edt id="k_tipon" dim="7,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnButton="ObtenerTipo()" OnF9="ObtenerTipo()" OnChange="MostrarTipo()" available="N" modify="Y" type="capital"/>			<sp n="2"/>	<inp id="c_tipo_dscr" dim="21,1" type="string" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="N" nc="-1"/> 			<sp n="2"/> <txt id="textOrden" visible="Y">Orden : </txt>			<edt id="k_orden" dim="30,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" type="string" modify="Y" available="N" visible="Y" OnButton="ObtenerOrden()" OnF9="ObtenerOrden()" OnChange="MostrarOrden()"/> 			<sp n="2"/> <inp id="ord_serie" dim="20,1" type="string" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="N" nc="-1"/> 			<br/>						<sp n="1"/> <txt>Cliente : </txt> 			<sp n="3"/>	<inp id="c_clien" dim="11,1" type="string" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="N" nc="-1"/> 			<sp n="2"/>	<inp id="c_nombr" dim="44,1" type="string" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" available="N" nc="-1"/> 			<br/>							</grp>		<br/>		<br/> 				<!-- dim="81,18,27,12" --> 		<tab/>		<grp id="grid" dim="85,23,7,12" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,16" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fnt="Arial,16" tit="Registro de Productos  /  [ Doble Click  o  F10 ]  Marcar como Surtido">					<sp n="1"/> 			<!-- fnt="Arial,15" dim="114,6" -->			<!-- OnMouseD="ToDel()" -->			<tbl id="k_mov" dim="119,11" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,15" hk="z" OnF9="Get_Cat(1)" OnF10="ToSurt()" OnMouseD="ToSurt()" Reorder="N" modify="Y" insdel="N" visible="Y" available="Y">							<col id="c_reemplazo" name="Reemplazo"  type="capital" nc="18" modify="N" available="N" visible="Y"/>				<col id="c_original" name="Original"  type="capital" nc="18" modify="N" available="N" visible="N"/>									<col id="borrar" name="Borrar" OnActive="Get_Data_Row()" type="capital" nc="1" modify="N" available="N" visible="N"/>				<col id="ctrlerr" name="ERR" OnActive="Get_Data_Row()" type="capital" nc="1" modify="N" available="N" visible="N"/>				<col id="k_parte" name="Producto"  OnActive="Get_Data_Row()" type="capital" nc="18" modify="N" available="Y" visible="Y" OnF9="Get_Cat(1)" OnChange="Get_Cat_Data(1, 1)"/>				<col id="k_descr" name="Descripcion" OnActive="Get_Data_Row()" type="string" nc="30" OnChange="" OnF9="" OnMouseL="" modify="N" available="N" visible="Y"/>				<col id="k_q" name="Cantidad" OnActive="Get_Data_Row()" type="number" nd="2" modify="N" available="Y" visible="Y" OnChange="Get_Cat_Data(0,1)"/> 				<col id="k_unidad" name="U.M." OnActive="Get_Data_Row()" type="capital" nc="10" modify="N" available="N" visible="Y" OnChange="Get_Cat_Data(0,1)" nc="1"/> 											<col id="k_surt" name="Surtido" OnActive="Get_Data_Row()" type="date" nc="-1" modify="N" available="N" visible="Y" OnChange="Get_Cat_Data(0,1)" nc="1" fmt="DD/MM/CCYY"/> 								<col id="k_st_surt" name="ST"  type="string" modify="N" available="N" visible="N"/>									   </tbl>		   		   <!--		   			<br/>			<sp n="1"/> <txt fnt=",16b">Importe : </txt>			<sp n="1"/><tab/> <inp id="k_monto" clr="64,64,64" clrBrdr="255,255,255"  dim="15,1" fnt=",16b" bclr="255,255,255" brdr="2,0" type="number" nd="2" modify="N" available="N"/>  						<br/>						<sp n="1"/> <txt clr="0,58,112">Comentarios:</txt>			<sp n="1"/> <inp id="k_coment" clr="64,64,64" clrBrdr="255,255,255"  dim="107,3" brdr="2,0" fnt="Arial,16" nr="3,100" modify="Y" available="Y" type="string" nc="300" bclr="255,255,255" visible="Y"/>			<br/>			<sp n="13"/> <inp id="k_coment2" clr="64,64,64" clrBrdr="255,255,255"  dim="107,1" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="string" bclr="255,255,255" nc="60" visible="Y"/>			<br/>			<sp n="13"/> <inp id="k_coment3" clr="64,64,64" clrBrdr="255,255,255"  dim="107,1" brdr="2,0" fnt="Arial,16" nr="3,60" modify="Y" available="Y" type="string" bclr="255,255,255" nc="60" visible="Y"/>						-->						<br/>						<sp/><txt clr="132,20,7">Mensaje : </txt> 			<inp id="k_err" dim="110,1" clr="132,20,7" clrBrdr="255,255,255" type="string" modify="N" available="N" nc="-1"/>			<br/>			<br/>					<tab n="31"/>			<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Ejecuta_Reporte()" tooltip="Imprimir documento &lt;Ctrl&gt;&lt;T&gt;" available="N" clrBrdr="0,0,0" visible="N" modify="Y"/>						<sp n="3"/>			<img id="Cancelar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocRst.png" OnEnter="Cancela()" tooltip="Borrar datos" available="Y" clrBrdr="0,0,0" visible="Y"/>						<sp n="3"/>			<img id="Aceptar" dim="40,40" bPx="Y" brdr="0,1"  img="_60_DocNew.png" OnEnter="Ejecuta()" tooltip="Crear registros &lt;Ctrl&gt;&lt;T&gt;" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>				</grp>					</grp>		<script>		InstallDriver("KDB75");				class Main {			var frn,kdb, sys, rep, frP;			var usuario, rol_usuario, suc_usuario, anio_contable, asterisco ;			// Our Ctrl Vars			var cmdQuery, cuboQuery, ok, mensajeError, sucursal_id, proveedor_id, refer_id, resVal;			var fileSavePath, tip_ope_original/*220726*/;												// Vars Parameters         var gen_doc, nat_doc, gpo_doc, tip_doc, tip_ope, paramProd, uen;         var row_grid, err_data, err_empty, fech_original, view_adicionales;                  // Vars Reports			var cmd, xmlResQuery, strTmp;			var sucursal, fech_oper, tipo_auto, xmlPar;										fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				frP=new FRNTP;				sys=new SYS;				kdb.connect();				kdb.kde("KDE");				kdb.exec();				anio_contable = kdb.get("KDE","14");				usuario = frn.config("user","name");				rol_usuario = frn.config("user","role");				suc_usuario = frn.lib("libKepler","UserInfo(1)");				asterisco = "*";				//fileSavePath = "C:\KE\JMM\TEST_DEVELOPS\K80";				fileSavePath = "C:\Basura";								row_grid = 0;				err_empty = 0;				err_data = 0;								Inicializa();								ConfiguraControlesOpcion();							} /* END Func Main() */						/*			fun ToDel() {							var irow, icol;							if (tip_ope &= "B") {					if ( strlen(frn.get("k_mov",-1,"modelo")) != 0 ) {						if ( strlen(frn.get("k_mov",-1,"borrar")) == 0 || frn.get("k_mov",-1,"borrar") &= "" ) {							frn.setX("X","k_mov",-1,"borrar");						} else {							frn.setX("","k_mov",-1,"borrar");						}					}							}									}			*/			/* END Func ToDel() */			fun ToSurt() {							var irow, icol;							if (tip_ope &= "C") {					if ( strlen(frn.get("k_mov",-1,"k_parte")) > 0 ) { 						if ( strlen(frn.get("k_mov",-1,"k_st_surt")) > 0 && frn.get("k_mov",-1,"k_st_surt") &= "0" ) { 							if ( strlen(frn.get("k_mov",-1,"k_surt")) == 0 || frn.get("k_mov",-1,"k_surt") &= "" ) {								frn.setX(sys.date(),"k_mov",-1,"k_surt");							} else {								frn.setX("","k_mov",-1,"k_surt");							}						}					}				}									}						//Validacion Datos Generales y Partidas antes de Guardar.			//El resultado de cada validacion se guarda en la variable global resVal.			fun ValidarDatos(iModo) {				var totReg, totSurt, subTotal=0, iva=0, total=0;				var no_part=0;				var folio, dato_num, dato_txt, dato1, dato2, dato3;				var surtidos;								//Obtener variables				sucursal_id = frn.get("k_sucn",-1,1);				//refer_id = frn.get("k_refer");								folio = frn.get("k_folio");								if (iModo != 1) {   									//Validar VIN [Serie]										dato_txt = trim(frn.get("k_serie"));									if ( strlen(dato_txt) == 0 ) {						frn.message("El VIN [Serie] No puede ser vacio ...","Error","Aceptar");						resVal=0;						return;					}										dato1 = trim(frn.get("k_modelo"));					dato2 = trim(frn.get("k_clien"));										if ( dato_txt &= "--" || dato1 &= "--" || dato2 &= "--" ) {						frn.message("El VIN [Serie] No es valido ...","Error","Aceptar");						resVal=0;						return;					}										//Validar Referencia - Anticipo										dato_txt = trim(frn.get("k_refer"));										if ( strlen(dato_txt) > 0 ) { 											dato1 = trim(frn.get("k_ref_fech"));						dato2 = trim(frn.get("k_ref_clien"));												if ( dato1 &= "--" || dato2 &= "--" ) {							frn.message("La Referencia [Anticipo] No es valida ...","Error","Aceptar");							resVal=0;							return;						}										}									//Validar Referencia - Tipo, Orden 										dato_txt = trim(frn.get("k_tipon"));										if ( strlen(dato_txt) > 0 ) { 											dato1 = trim(frn.get("c_tipo_dscr"));												if ( dato1 &= "--" ) {							frn.message("El Tipo de Orden No es valido ...","Error","Aceptar");							resVal=0;							return;						}												dato_txt = trim(frn.get("k_orden"));												if ( strlen(dato_txt) == 0 ) {							frn.message("No ha Registrado la Orden correspondiente al Tipo seleccionado ...","Error","Aceptar");							resVal=0;							return;						} else {							dato1 = trim(frn.get("ord_serie"));							if ( dato1 &= "--" ) {								frn.message("La Orden No es valida ...","Error","Aceptar");								resVal=0;								return;							}							}										}													//Validaciones Adicionales - Comparativas 															dato1 = trim(frn.get("k_refer"));					dato2 = trim(frn.get("k_orden"));										if ( strlen(dato1) == 0 && strlen(dato2) == 0 ) {						frn.message("Debes registrar un Anticipo y/o una Orden valido(s) para realizar esta Operacion ...","Error","Aceptar");						resVal=0;						return;					}															dato1 = trim(frn.get("k_serie"));					dato2 = trim(frn.get("ord_serie"));										dato_txt = trim(frn.get("k_orden"));										if ( strlen(dato_txt) > 0 ) {											dato_num = strlen(dato1) - 8;						dato_txt = mid(dato1, dato_num, 8);											if ( dato_txt &! dato2 ) {							frn.message("La Serie del VIN no corresponde a la Serie de la Orden ...","Error","Aceptar");							resVal=0;							return;						}											}															dato1 = trim(frn.get("k_clien"));					dato2 = trim(frn.get("k_ref_clien"));										dato_txt = trim(frn.get("k_refer"));										if ( strlen(dato_txt) > 0 ) {												if ( dato1 &! dato2 ) {							frn.message("El Cliente del VIN no corresponde al del Anticipo ...","Error","Aceptar");							resVal=0;							return;						}											}																	dato_txt = trim(frn.get("c_clien"));										if ( strlen(dato_txt) == 0 || dato_txt &= "--" ) {						frn.message("No se ha determinado un Cliente valido en la Operacion ...","Error","Aceptar");						resVal=0;						return;					}																		} else { // imodo 														//Validar Existencia Documento					cmdQuery = "" & 						"select count(c1) totreg from keplersc.kdserped where c1 = '" & sucursal_id & "' and c2 = '" & folio & "' ";												rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refpedidoespecialcrud.ValidarDatos_Baja()");					ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error DB","Aceptar"); //TO DO Homologar mensaje en todo el proyecto, agregar DB						return;					}					totReg = getXmlAtt(cuboQuery,"r0","totreg");					if(totReg==0){						frn.message("El Pedido Especial No existe ...","Error","Aceptar");						resVal=0;						return;					}																	if ( frn.get("c_st") &= "Totalmente Surtido" ) {						frn.message("El Pedido Especial ya ha sido Surtido ...","Error","Aceptar");						resVal=0;						return;					}															//Validar Datos del Documento y Transacciones Asociadas ...										/*					cmdQuery = "" & 						"select count(c1) totreg from keplersc.kdserpedmov where c1 = '" & sucursal_id & "' and c2 = '" & folio & "' " &							"and (c8 <> 0 or c10 <> 0) ";					*/												cmdQuery = "" & 						"select sum(1) as totregs, sum(case when c8 = 10 then 1 else 0 end) totsurt from keplersc.kdserpedmov where c1 = '" & sucursal_id & "' and c2 = '" & folio & "' ";																			rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.ValidarDatos_Baja()");					ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error DB","Aceptar"); //TO DO Homologar mensaje en todo el proyecto, agregar DB						return;					}										// Valida si Query arrojo datos (no lo haria si no encontra el DOC) 					if (nXml(cuboQuery) > 0) { 											totReg = 0;						totSurt = 0;						totReg = getXmlAtt(cuboQuery,"r0","totregs");						totSurt = getXmlAtt(cuboQuery,"r0","totsurt");												/*						totReg = getXmlAtt(cuboQuery,"r0","totreg");						if(totReg > 0){							frn.message("El Pedido no se puede Eliminar, tiene piezas que ya estan surtidas o entregadas ...","Error","Aceptar");							resVal=0;							return;						}						*/												if(totReg <= totSurt){							frn.message("El Pedido No tiene partidas disponibles por surtir ...","Error","Aceptar");							resVal=0;							return;						}										}												} // End Else iModo ... 													no_part = frn.N("k_mov") - 1;								/*				if (iModo != 1) {  // 20220814  					//Validar Cantidades					//for (var i=0,n=frn.N("k_mov")-1;i<n;i++) {					for (var i=0,n=frn.N("k_mov");i<n;i++) { 						frn.setPos("k_mov",i,"k_q");						resVal=CalculaTotales(1);						if(resVal==0){							return;						}					}				} else { 				*/					if (no_part/*frn.N("k_mov")*/ == 0) {						frn.message("No hay registro de productos a procesar ...","Error","Aceptar");						resVal=0;						return;					}					/*else { CalculaTotales(); } */				/*}*/							surtidos = 0;				// Validar si hay seleccionado algun articulo para surtir ...				for (var i = 0, n = no_part; i < n; i++) { 					if ( strlen(frn.get("k_mov",i,"k_surt")) != 0 ) {						surtidos = surtidos + 1;					}				}								if (surtidos == 0) {					frn.message("No hay nuevos registros marcados como surtidos ...","Error","Aceptar");					resVal=0;					return;				}										//Validar Totales				//subTotal = frn.get("k_subtotal");				//iva  =frn.get("k_iva");				/*				total = frn.get("k_monto");				if (total <= 0){					frn.message("El total de la operación no puede ser cero.","Error","Aceptar");					resVal = 0;					return;				}				*/							} // End ValidarDatos()						fun Clean_Ctrls_Panel() {				frn.setX("", "k_err");				} /* END Func Clean_Ctrls_Panel() */									fun Get_Cat(imodo) {            				var suc_id, dato_id;				var win_tit, field_key, field_col, cmdQuery;            				if ( imodo <= 0 || imodo > 5 || tip_ope &! "A" ) {					// No es opcion de CAT Valida ...					return;				} 				win_tit = "";				field_key = "";				field_col = "";				cmdQuery = "";				if (imodo == 1) {						win_tit = "CAT Productos";						field_key = "clave";						field_col = "k_parte";						cmdQuery = "select C1 as clave, C2 as descripción from keplersc.kdini"; /* where c8 = 'N' */				}																							                      if ( strlen(win_tit) > 0 && strlen(field_key) > 0 && strlen(field_col) > 0 && strlen(cmdQuery) > 0 ) {                            					frn.dialog("genlistasel", win_tit,cmdQuery, field_key,"k_mov",-1, field_col,"S");				}							} /*END Func Get_Cat()*/		   fun Get_Cat_Data(imodo, icall/*, icalc*/, iprod) {						var dato_id;				var field_ori,field_dest, tbl, field_dscr;				var field_add, dato_id_add;				var field_dest_2, dato_id_2;				var prod; // New 20231210 								if ( imodo < 0 || imodo > 1/*5*/  || ( tip_ope &! "A" /*&& icall != 2*/ ) ) {					// No es opcion de CAT Valida ...					return;				}								/*				if ( icalc == 1 ) { 					//CalculaTotales(); 				}				*/								sucursal_id = frn.get("k_sucn",-1,1);								field_dscr = "";				field_ori = "";				field_dest = "";				tbl = "";				cmdQuery = "";								dato_id = "";												/*				if (imodo == 1) {					field_dscr = "Producto";					field_ori = "k_parte";					field_dest = "k_descr";					tbl = "kdini";					cmdQuery = "select i.c2 as " & field_dest & ", i.c19 as unidad, l.c14 as costo from keplersc." & tbl & 					" i left join keplersc.kdinl l on l.c2 = i.c1 and l.c1 = '" & sucursal_id  & "' " & 					" where i.c1 = '" & frn.get("k_mov",-1,field_ori) & "'";										}				*/									if (imodo == 1) {									field_dscr = "Producto";					field_ori = "k_parte";					field_dest = "k_descr";					tbl = "kdini";										prod = frn.get("k_mov",-1,field_ori);										/*					if ( strlen(frn.get("k_mov",-1,"c_original")) > 0 ) {						prod = frn.get("k_mov",-1,"c_original");					}					*/					if ( trim(frn.get("k_mov",-1,"c_reemplazo")) &= trim(prod) && strlen(frn.get("k_mov",-1,"c_reemplazo")) > 0 ) {						// Condition added 20231212 						if ( tip_ope &= "A" ) {							prod = frn.get("k_mov",-1,"c_original");							iprod = "reemplazo";						} 					}															cmdQuery = "select i.c2 as " & field_dest & ", i.c19 as unidad, i.c1 as prod_ori from keplersc." & tbl & " i ";										if ( strlen(iprod) == 0 /*|| strlen(frn.get("k_mov",-1,"c_original")) > 0*/ ) {						cmdQuery = cmdQuery & " where i.c1 = '" & prod  & "'";						} else {						cmdQuery = cmdQuery & " where i.c1 = keplersc.prod_obtener_original('" & prod & "')";					}											}				if ( tip_ope &= "A" ) {					if (imodo == 2) {						field_dscr = "Inventario";						field_ori = "invent";						field_dest = "anio";						tbl = "kddinv";						//cmdQuery = "select C3 as " & field_dest & " from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'"; 						cmdQuery = "select i.C3 as anio from keplersc.kddinv i inner join keplersc.kdiv k on k.c8 = i.c7 and k.c1 = '" & frn.get("k_mov",-1,"modelo") & "'" & 							" where i.c1 = '" & frn.get("k_mov",-1,field_ori) & "' and i.c7 = 'N'";					}				}											if (imodo == 3) {					field_dscr = "Color Exterior";					field_ori = "color";					field_dest = "color";					field_dest_2 = "descrip";					tbl = "kdice2";					if ( frn.get("k_mov",-1,"anio") &! "--" && trim(frn.get("k_mov",-1,"anio")) &! "" ) {						cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '" & frn.get("k_mov",-1,"modelo") & "' and c3 = '" & frn.get("k_mov",-1,field_ori) & "'";					} else {						cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '' and c3 = ''";					}				}											if (imodo == 4) {					field_dscr = "Color Vestidura";					field_ori = "vest";					field_dest = "vest";					field_dest_2 = "descrip";					tbl = "kdice3";					if ( frn.get("k_mov",-1,"anio") &! "--" && trim(frn.get("k_mov",-1,"anio")) &! "" ) {						cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '" & frn.get("k_mov",-1,"modelo") & "' and c3 = '" & frn.get("k_mov",-1,field_ori) & "'";					} else {						cmdQuery = "select C3 as " & field_dest & ", c4 as " & field_dest_2 & " from keplersc." & tbl & " where c1 =  '' and c3 = ''";					}				}								if (imodo == 5) {					field_dscr = "Sucursal";					field_ori = "suc";					field_dest = "suc";					field_dest_2 = "descrip";					tbl = "kdms";					if ( frn.get("k_mov",-1,"anio") &! "--" && trim(frn.get("k_mov",-1,"anio")) &! "" ) {						cmdQuery = "select C1 as " & field_dest & ", c2 as " & field_dest_2 &" from keplersc." & tbl & " where c1 = '" & frn.get("k_mov",-1,field_ori) & "'";					} else {						cmdQuery = "select C1 as " & field_dest & ", c2 as " & field_dest_2 &" from keplersc." & tbl & " where c1 = 'none!@?'";					}				}								if (imodo == 0 && icall == 1) {					Eval_Data_Row(frn.getJ("k_mov"));				}								// commented 20231210 0130				/*				if (icall == 2 && tip_ope &! "A") {					frn.setX(frn.get("k_mov",-1,"fech"), "k_fecha_asig");				}				*/											field_add = "";				/*				if (imodo == 1) { field_add = "k_descrip"; }				if (imodo == 3) { field_add = "k_color_ext"; }				if (imodo == 4) { field_add = "k_color_vest"; }					if (imodo == 5) { field_add = "k_suc"; }					*/											if ( strlen(field_dscr) > 0 && strlen(field_ori) > 0 && strlen(field_dest) > 0 && strlen(tbl) > 0 && strlen(cmdQuery) > 0 ) {					if ( strlen(frn.get("k_mov",-1,field_ori)) != 0 ) {						//dato_id = frn.get("k_mov",-1,field_ori);						//cmdQuery = "select C2 as descrip from keplersc.kdiv where c1 = '" & dato_id & "'";						rstXml(cuboQuery);						cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"comaltasigcrud.Get_Cat_" & tbl & "()");						frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\Get_Cat_" & tbl);						ok=getXmlAtt(cuboQuery,"ok");						if(ok &! "" && !ok){							dato_id = "--";							if (imodo == 1) {								dato_id = "[ERR] verificando " &  field_dscr & " ...";							}							frn.setX(dato_id,"k_mov",-1, field_dest);							mensajeError = getXmlAtt(cuboQuery,"native3");							mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);							frn.message(mensajeError,"Error","Aceptar");							dato_id_add = "";							if (imodo == 1) { dato_id_add = dato_id; }							if (imodo == 3 || imodo == 4 || imodo == 5) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							//if (imodo == 4) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							//if (imodo == 5) { dato_id_add = "[ERR] verificando " &  field_dscr & " ..."; }							if ( strlen(field_add) != 0 ) { frn.setX(dato_id_add, field_add); }							return;						}						dato_id = "";						dato_id = getXmlAtt(cuboQuery,"r0", field_dest);					   if( strlen(dato_id) == 0 ){							//dato_id = "--";							dato_id = "";							if (imodo == 1 /*&& icall ==1*/) {								/*								if ( strlen(frn.get("k_mov",-1,"invent")) > 0 ) {									frn.setX(dato_id, "k_mov",-1, "invent");									frn.setX(dato_id, "k_mov",-1, "anio");								}								if ( strlen(frn.get("k_mov",-1,"color")) > 0 ) {									frn.setX(dato_id, "k_mov",-1, "color");									frn.setX("Color Exterior No Valido ...", "k_color_ext");								}								if ( strlen(frn.get("k_mov",-1,"vest")) > 0 ) {									frn.setX(dato_id, "k_mov",-1, "vest");									frn.setX("Color Vestidura No Valido ...", "k_color_vest");								}								if ( strlen(frn.get("k_mov",-1,"suc")) > 0 ) {									frn.setX(dato_id, "k_mov",-1, "suc");									frn.setX("Sucursal No Valido ...", "k_suc");								}								if ( strlen(frn.get("k_mov",-1,"serie")) > 0 ) {									frn.setX("", "k_mov",-1, "serie");								}								if ( strlen(frn.get("k_mov",-1,"ref")) > 0 ) {									frn.setX("", "k_mov",-1, "ref");								}								*/																// New Code 20230907								/*								frn.setX(dato_id, "k_mov",-1, "ctrlerr");								frn.setX(dato_id, "k_mov",-1, "k_q");								frn.setX(dato_id, "k_mov",-1, "k_precio");								frn.setX(dato_id, "k_mov",-1, "k_monto");								frn.setX(dato_id, "k_mov",-1, "k_unidad");								*/																//frn.setX("", "k_mov",-1, "ctrlerr");								/*								frn.setX("", "k_marca");								frn.setX("", "k_clase");								frn.setX("", "k_tipo_auto");								frn.setX("", "k_fecha_asig");								*/																// Added 20231210 								// Verificar que no sea un reemplazo ... select keplersc.prod_obtener_original('123047'), keplersc.prod_obtener_original('NotExist')								// Se tratara de hacer recursivo usando la variable iprod ...								if ( strlen(iprod) == 0 ) {									Get_Cat_Data(1, 1, "Reemplazo");									return;								} 																frn.setX("", "k_err");												dato_id = field_dscr & " No existe ...";							}							frn.setX(dato_id, "k_mov",-1, field_dest);										/*							dato_id_add = "";						   if (imodo == 1) { dato_id_add = dato_id; }							if (imodo == 3 || imodo == 4 || imodo == 5) { dato_id_add = field_dscr & " No Existe ..."; }							if ( strlen(field_add) != 0 ) { frn.setX(dato_id_add, field_add); }							*/														Eval_Data_Row(frn.getJ("k_mov"));									return;												} else {													frn.setX(dato_id,"k_mov",-1,field_dest);							if (imodo == 1 && icall == 1) {								dato_id_2 = ""; 								//frn.setX(dato_id_2, "k_mov",-1, "k_descr");								frn.setX(dato_id_2, "k_mov",-1, "k_q");								//frn.setX(dato_id_2, "k_mov",-1, "k_precio");								//frn.setX(dato_id_2, "k_mov",-1, "k_monto");								frn.setX(dato_id_2, "k_mov",-1, "k_unidad");								frn.setX(dato_id_2, "k_mov",-1, "k_eta");								frn.setX(dato_id_2, "k_mov",-1, "c_original");								frn.setX(dato_id_2, "k_mov",-1, "c_reemplazo");								Clean_Ctrls_Panel();							}														// Fill Data Panel of OBJs Adds 							if (imodo == 3 || imodo == 4 || imodo == 5  || imodo == 6) {								dato_id_2 = "";								dato_id_2 = getXmlAtt(cuboQuery,"r0", field_dest_2); 							}							/*							if (imodo == 1) { dato_id_add = dato_id; }							if (imodo == 3 || imodo == 4 || imodo == 5) { dato_id_add = dato_id_2; }							if ( imodo == 1 || imodo == 3 || imodo == 4 || imodo == 5 ) { frn.setX(dato_id_add, field_add); }							*/							// Fill Other Data of OBJs Adds related to field : Producto							// /*							if (imodo == 1) { 								frn.setX(getXmlAtt(cuboQuery,"r0", "unidad"), "k_mov",-1, "k_unidad");								//frn.setX(getXmlAtt(cuboQuery,"r0", "costo"), "k_mov",-1, "k_precio");								frn.setX(fnDate("add",sys.date(),1), "k_mov",-1, "k_eta");																// Added 20231210								if ( strlen(iprod) > 0 ) {									frn.setX(getXmlAtt(cuboQuery,"r0", "prod_ori"), "k_mov",-1, "c_original");									frn.setX(frn.get("k_mov",-1,"k_parte"), "k_mov",-1, "c_reemplazo");								}							}							// */														Eval_Data_Row(frn.getJ("k_mov"));												}					} else {											frn.setX(dato_id,"k_mov",-1,field_dest);							dato_id_add = dato_id;												if ( imodo == 1 ) {							// /*							frn.setX(dato_id, "k_mov",-1, "ctrlerr");							frn.setX(dato_id, "k_mov",-1, "k_q");							//frn.setX(dato_id, "k_mov",-1, "k_precio");							//frn.setX(dato_id, "k_mov",-1, "k_monto");							frn.setX(dato_id, "k_mov",-1, "k_unidad");							frn.setX(dato_id, "k_mov",-1, "k_eta");							frn.setX(dato_id, "k_mov",-1, "c_original");							frn.setX(dato_id, "k_mov",-1, "c_reemplazo");							//Clean_Ctrls_Panel();											// */							}												/*if ( imodo == 1 || imodo == 3 || imodo == 4 || imodo == 5 ) { frn.setX(dato_id_add, field_add); }*/																	Eval_Data_Row(frn.getJ("k_mov"));											}				}					} /*END Fun Get_Cat_Data()*/			fun Get_Data_Row() {								var irow, icol;				var rows, evalrow;								rows = frn.N("k_mov") - 1;								icol = frn.getI("k_mov");				irow = frn.getJ("k_mov");								if ( row_grid != frn.getJ("k_mov") /*rows - 1*/ ) {									//Eval_Data_Row(row_grid); // was commented										// code added 20230907										/*					if ( irow == rows ) {						return;					}					*/										evalrow = Eval_Data_Row(row_grid);					if ( evalrow >= 0 ) {						if ( row_grid != rows ) {							frn.setPos("k_mov",row_grid, icol); // -1						} else {							row_grid = frn.getJ("k_mov");						}						return;					}										row_grid = frn.getJ("k_mov"); // commented									if ( strlen(frn.get("k_mov",-1,"k_parte")) == 0 ) {						Clean_Ctrls_Panel();					} else { 						for (var i=0; i<=5; i++) {							if ( tip_ope &! "A" ) {								Get_Cat_Data(i,2);							} else {								Get_Cat_Data(i);							}						}						Eval_Data_Row(row_grid); // commented						//row_grid = frn.getJ("k_mov"); // New 											}						}								//frn.setX("REN " & irow + 1 & " , COL " & icol, "k_err");			   //frn.setPos("k_mov",-1, icol);								} /*END Func Get_Data_Row()*/			fun Eval_Data_Row(nRow, imodo) {				var ColIni, ColEnd, EvalCols, ErrText;				var FieldsListData, FieldListEmpty;				var monto;								if ( nRow == imodo && nRow != 0 ) { 					return -1; 				}								if ( tip_ope &! "A" ) { 					//return; 					return -1; // UPD 20231211 				}												// New code 20231010 ...				if ( ( nRow == frn.N("k_mov") - 1 ) /*&& nRow != 0*/ ) {					frn.setX("", "k_err");					return;				}												ColEnd = 6/*7*/; /*10*/				ColIni = 2;				EvalCols = ColEnd - ColIni + 1;				ErrText = "";							err_empty = 0;				err_data = 0;								FieldsListData = "";				FieldListEmpty = "";						// New code 20230907				/*				if ( strlen(frn.get("k_mov", nRow, "k_parte")) != 0 ) {					monto = frn.get("k_mov", nRow, "k_q") * frn.get("k_mov", nRow, "k_precio");					frn.setX(monto, "k_mov", nRow, "k_monto");				} else {					frn.setX("", "k_mov", nRow, "k_monto");				}				*/								// Evaluando vacios ...				for (var i=ColIni; i<=ColEnd; i++) {					if ( strlen( frn.get("k_mov", nRow, Get_Column(i) )) == 0 ) { 						err_empty = err_empty + 1;						FieldListEmpty = FieldListEmpty & Get_Column_Dscr(i) & " | "; 					} 				}								// Evaluando datos ...				for (var i=ColIni; i<=ColEnd; i++) {									if ( strlen( frn.get("k_mov", nRow, Get_Column(i) )) != 0 ) { // New condition 20230907											if ( (i == 3 || i == 4 /*|| i == 6 || i == 7*/ ) && frn.get("k_mov", nRow, Get_Column(i)) &= "--"  ) { err_data = err_data + 1; } 											if ( i == 3/*5*/ && frn.get("k_mov", nRow, Get_Column(i)) &= "Producto No existe ..."  ) { 							err_data = err_data + 1; 							//if ( i == 3) {								FieldsListData = FieldsListData & Get_Column_Dscr(2) & " No Existe | ";							//} else {							//	FieldsListData = FieldsListData & Get_Column_Dscr(i) & " No Existe | ";							//}						} 					}										if ( i == 4 /*|| i == 6 || i == 7*/ ) {						if ( /*i == 4 &&*/ frn.get("k_mov", nRow, "k_q") <= 0 ) {							err_data = err_data + 1;							FieldsListData = FieldsListData & Get_Column_Dscr(4) & " <= 0 | ";						}												}															//if ( i == 6 && frn.get("k_mov", nRow, "k_eta") < /*=*/ sys.date() ) {					if ( i == 6 && fnDate("cmp",sys.date(),frn.get("k_mov", nRow, "k_eta")) > 0 ) {						err_data = err_data + 1;						FieldsListData = FieldsListData & Get_Column_Dscr(6) & " < Hoy | " /*" <= 0 | "*/ ;					}																			/*					if ( i == 7 && frn.get("k_mov", nRow, "k_monto") <= 0 ) {						err_data = err_data + 1;						FieldsListData = FieldsListData & Get_Column_Dscr(7) & " <= 0 | ";					}						*/										}				 								if ( err_data > 0 ) { ErrText = ErrText & "[No Validos] : " & FieldsListData; }					if ( err_empty > 0 /*&& err_empty < EvalCols*/ ) { ErrText = ErrText & "[Sin Registrar] : " & FieldListEmpty; }								//if ( err_empty == EvalCols && err_data == 0 ) { return; }				if ( strlen( ErrText ) == 0 ) { 					frn.setX("", "k_err");					frn.setX("", "k_mov", nRow, "ctrlerr");					return -1; 				}								frn.setX(ErrText, "k_err");				frn.setX("X", "k_mov", nRow, "ctrlerr");				return nRow;						} /*END Func Eval_Data_Row()*/			fun Get_Column(imodo) {				var colName;				switch(imodo) { 					case 2: colName = "k_parte";break; 					case 3: colName = "k_descr";break;					case 4: colName = "k_q";break;					case 5: colName = "k_unidad";break;					case 6: colName = "k_eta";break;					/*					case 6: colName = "k_precio";break;					case 7: colName = "k_monto";break;					*/					default: colName = "";break;				}				return colName;			} /*END Func Get_Column()*/			fun Get_Column_Dscr(imodo) {				var colName;				switch(imodo) { 					case 2: colName = "Producto";break; 					case 3: colName = "Descripcion";break;					case 4: colName = "Cantidad";break;					case 5: colName = "U.M.";break;					case 6: colName = "ETA";break;					/*					case 6: colName = "Unitario";break;					case 7: colName = "Importe";break;					*/					default: colName = "";break;				}				return colName;			} /*END Func Get_Column()*/			fun Cancela() {				CambiaSucursal();				Inicializa();				ConfiguraControlesOpcion();			} /* END Func Cancela() */									/*			fun ModoBuscar(imodo, iview) {				tip_ope = "C";				frn.set("operacion", "CONSULTA");				if ( ( imodo == 1 || imodo == 2 ) && tip_ope_original &= "A" ) {					frn.set("k_fecha", fech_original);  				} else { 					LimpiaEncabezado();				}				ConfiguraControlesOpcion(imodo);				CambiaSucursal(imodo);			} 			*/			/*END Func ModoBuscar()*/						fun ModoBuscar() {				tip_ope = "C";				frn.set("operacion", "SURTIDO"/*"CONSULTA"*/);				LimpiaEncabezado();				ConfiguraControlesOpcion();			}									fun ObtenerFolios() {			            sucursal_id = frn.get("k_sucn",-1,1);	            cmdQuery = "" &						"select w.c2 as folio, to_char(w.c3, 'dd/mm/yyyy') as fecha from keplersc.kdserped w " & 						"where w.c1 = '" & /*"02"*/sucursal_id & "'" & " order by w.c3 desc, w.c2 desc";						                                    frn.dialog("genlistasel","Relacion de Pedidos",cmdQuery,"folio","k_folio","0","","N");                     }									fun BuscarFolio() {				var folio;				folio = frn.get("k_folio");				//frn.lib("libGeneral.kpl","PadLeft", folio, 7, "0");				folio = PadLeft(folio, 10/*7*/, "0");				//ArmarRefDocto();				MostrarDOC(folio);				}									fun Ejecuta() {				var xmlPantalla, strFecha, fecha, hora, strTmp, strHora, strMin, strMsg;				var resultado, mensaje, adicionales, folio;				var RowErr, iLim;								//fecha = sys.date();				//hora = sys.time();								resultado = "";				mensaje = "";				adicionales = "";				view_adicionales = "";								if (tip_ope &= "C" /*"A"*/) { 								// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ...															//Validar Campos [ Encabezado ] , se inicia variable de modulo resVal, donde se asume que 1 es ok										resVal = 1;					ValidarDatos(1);   // ValidarDatos();					if(ok &! "1" || resVal == 0){						return;					}										// Validando Detalle [ GRID ]					RowErr = -1;					iLim = frn.N("k_mov") - 1;					if ( iLim == 0 ) {						frn.message("No hay registro de productos a procesar ...", "Info !!! ", "Aceptar");						return;							}					/*					for (var i=0; i<=iLim ; i++) {						RowErr = Eval_Data_Row(i, iLim);						if ( RowErr != -1 ) { break; }					}					if ( RowErr != -1 ) {						frn.setPos("k_mov", RowErr, "ctrlerr");						frn.message("Se encontraron errores en el registro de los productos ...", "Info !!! ", "Aceptar");						return;					}					*/					// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ...																// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;										//Agregar usuario, fechay hora de movimiento					/*					strFecha = fnDate("year",fecha) & "-";					strTmp = fnDate("month",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp & "-";					strTmp = fnDate("day",fecha);					if(strlen(strTmp) == 1){						strTmp = "0" & strTmp;					}					strFecha = strFecha & strTmp;					*/										setXml(xmlPantalla,"movimiento","usuario",usuario);										/*					setXml(xmlPantalla,"movimiento","fecha",strFecha);					setXml(xmlPantalla,"movimiento","hora",						frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 						frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));					*/										setXml(xmlPantalla,"anticipo","gen_doc",gen_doc);					setXml(xmlPantalla,"anticipo","nat_doc",nat_doc);					setXml(xmlPantalla,"anticipo","gpo_doc",gpo_doc);					setXml(xmlPantalla,"anticipo","tip_doc",tip_doc);										//setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")/*-1*//*commented 220726*/);					setXml(xmlPantalla,"k_mov","no_partidas", iLim);										/*					setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);					*/					setXml(xmlPantalla,"ambiente","uen",uen);					frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\XmlSurtir_PedidoEspecial");											// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ...															// FOR TESTING 					/*					mensaje = "La Transaccion se Procesara ...";					frn.message(mensaje, "Testing !!!", "Aceptar");					return;					*/										// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 					cmdQuery="SELECT * FROM keplersc.pedidoespecial_surt('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";					//kdb.rst(cuboQuery);					rstXml(cuboQuery);					cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"refpedidoespecialsurt.Ejecuta");									frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_Surtir_PedidoEspecial");										// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 										//resultado = "1";					//mensaje = "0000009";										resultado = getXml(cuboQuery,"resultado");					mensaje = getXml(cuboQuery,"mensaje");					adicionales = getXml(cuboQuery,"adicionales");																				if(resultado &= "1") {											frn.message(adicionales/*mensaje*/, "Folio Actualizado : ", "Aceptar");											ModoBuscar(); // 220721 ... added 												//tip_ope = "C"; -- 220721 ... commented & included en ModoBuscar();						frn.set("k_folio", mensaje); 						//frn.set("operacion", "CONSULTA"); -- 220721 ... commented & included en ModoBuscar();						/*						strTmp = frn.get("k_docto");								strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;						frn.set("k_docto", strTmp);						*/						// //ConfiguraCamposOpcion();											//strMsg = "El Folio utilizado para esta operación fue : " & mensaje;						//ConfiguraControlesOpcion(); // TO CHECK ... Esto No se ejecuta si se pone después del Message * * *  						//frn.message(strMsg, "Mensaje", "Aceptar");						//folio = frn.get("k_folio");						//MostrarDOC(folio);							BuscarFolio();					} else {						frn.message(mensaje, "Error", "Aceptar");					}				} /*End Alta*/ else {					if (tip_ope &= "B") {						/*Ini Baja*/													frn.message("Opcion No Valida ...", "Info", "Aceptar");						return;															folio = frn.get("k_folio");																		//Validar Campos [ Encabezado ] , se inicia variable de modulo resVal, donde se asume que 1 es ok						resVal = 1;						ValidarDatos(1);						if(ok &! "1" || resVal == 0){							return;						}											// Validando Detalle [ GRID ]						RowErr = -1;						iLim = frn.N("k_mov") - 1;						if ( iLim == 0 ) {							frn.message("No hay registro de productos a procesar ...", "Info !!! ", "Aceptar");							return;								}						for (var i=0; i<=iLim ; i++) {							RowErr = Eval_Data_Row(i, iLim);							if ( RowErr != -1 ) { break; }						}						if ( RowErr != -1 ) {							frn.setPos("k_mov", RowErr, "ctrlerr");							frn.message("Se encontraron errores en el registro de los productos ...", "Info !!! ", "Aceptar");							return;						}																		xmlPantalla = getXml(frn.dataPag()); //Obtener el xml de la pantalla;												//Agregar usuario, fecha y hora de movimiento						/*						strFecha = fnDate("year",fecha) & "-";						strTmp = fnDate("month",fecha);						if(strlen(strTmp) == 1){							strTmp = "0" & strTmp;						}						strFecha = strFecha & strTmp & "-";						strTmp = fnDate("day",fecha);						if(strlen(strTmp) == 1){							strTmp = "0" & strTmp;						}						strFecha = strFecha & strTmp;						*/												setXml(xmlPantalla,"movimiento","usuario",usuario);												/*						setXml(xmlPantalla,"movimiento","fecha",strFecha);						setXml(xmlPantalla,"movimiento","hora",							frn.lib("libGeneral.kpl","PadLeft",sys.time("hour",hora),2,"0") & ":" & 							frn.lib("libGeneral.kpl","PadLeft",sys.time("min",hora) ,2,"0"));						*/												setXml(xmlPantalla,"anticipo","gen_doc",gen_doc);						setXml(xmlPantalla,"anticipo","nat_doc",nat_doc);						setXml(xmlPantalla,"anticipo","gpo_doc",gpo_doc);						setXml(xmlPantalla,"anticipo","tip_doc",tip_doc);											//setXml(xmlPantalla,"k_mov","no_partidas",frn.N("k_mov")/*-1*//*commented 220726*/);						setXml(xmlPantalla,"k_mov","no_partidas", iLim);												/*						setXml(xmlPantalla,"ambiente","anio_contable",anio_contable);						*/						setXml(xmlPantalla,"ambiente","uen",uen);												frn.lib("libGeneral.kpl","FileSave",xmlPantalla, fileSavePath & "\XmlBaja_PedidoEspecial");						// /* COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 									cmdQuery="SELECT * FROM keplersc.pedidoespecial_crud('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";						//kdb.rst(cuboQuery);						rstXml(cuboQuery);						cuboQuery= frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"refaltapedcrud.Ejecuta_Baja");										frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\xmlResultado_Baja_PedidoEspecial");											// */ // END COMMMENTED TO TESTING BUSCAR AFTER ADD RECORD ... 											//resultado = "1";						//mensaje = folio /*"0000009"*/;											resultado = getXml(cuboQuery,"resultado");						mensaje = getXml(cuboQuery,"mensaje");						adicionales = getXml(cuboQuery,"adicionales");										// /*																	if(resultado &= "1") {												frn.message(adicionales/*mensaje*/, "Folio Eliminado : ", "Aceptar");												ModoBuscar(); // 220721 ... added 													//tip_ope = "C"; -- 220721 ... commented & included en ModoBuscar();							frn.set("k_folio", mensaje); 							//frn.set("operacion", "CONSULTA"); -- 220721 ... commented & included en ModoBuscar();							/*							strTmp = frn.get("k_docto");							strTmp = strSplit(strTmp,"-",0) & "-" & mensaje;							frn.set("k_docto", strTmp);							*/							// //ConfiguraCamposOpcion();												//strMsg = "El Folio utilizado para esta operación fue : " & mensaje;							//ConfiguraControlesOpcion(); // TO CHECK ... Esto No se ejecuta si se pone después del Message * * *  							//frn.message(strMsg, "Mensaje", "Aceptar");							//folio = frn.get("k_folio");							//MostrarDOC(folio);								BuscarFolio();						} else {							frn.message(mensaje, "Error", "Aceptar");						}						// */												//frn.message("En Construcción, OPC {Baja}", "Info", "Aceptar");																	} /*End Baja*/ else {						frn.message("Opcion No Desarrollada ...", "Info", "Aceptar");						return;						/*Ini Consulta*/						folio = frn.get("k_folio");						ModoBuscar(); // 220721 ... added						frn.set("k_folio", folio); // 220721 ... added						//MostrarDOC(folio); // 220722 ... commented 						/*						strTmp = frn.get("k_docto");						strTmp = strSplit(strTmp,"-",0) & "-" & folio;						frn.set("k_docto", strTmp);							*/						BuscarFolio();					}	/*End Consulta (for exception)*/ 				}							} /* END Func Ejecuta() */									fun Inicializa(){ //Inicializa los valores en Pantalla				// Our code				var fech_init, strFecha, strTmp,fecha; 			   // Revisa y Carga en Variables los Parámetros Recibidos en la corrida				if( frn.nParam() == 2 /*>= 5*/ ){ //Se han mandado parámetros a la página					/*					gen_doc = trim(frn.param(0));                nat_doc = trim(frn.param(1));                gpo_doc = trim(frn.param(2));               tip_doc = trim(frn.param(3));                tip_ope = trim(frn.param(4));               uen = trim(frn.param(5));					*/					tip_ope = trim(frn.param(0));               uen = trim(frn.param(1));               tip_ope_original = tip_ope; /*220726*/			   					if (uen &! "REF") {						//uen="REF";						frn.message("La UEN No es Valida ...","Inf0 !!!","&Aceptar");						// /*						frn.open("redirect",2);						return;						// */					}										// Atributos DOC - Anticipo (posible referencia)					gen_doc = "U";                nat_doc = "D";                gpo_doc = "79";               tip_doc = "1"; 				} else {					frn.message("Esta acción no está permitida.","Estimado Usuario","&Aceptar");					// /*					//frn.open("index",4);					frn.open("redirect",2);					return;					// */				}							// Testing Code //				/*				gen_doc = "U"; //"N"				nat_doc = "D"; 				gpo_doc = "79"; //"22"				tip_doc = "1"; 				tip_ope = "C"; // "A" "C" "B"				uen = "REF";				tip_ope_original = tip_ope;				*/				//frn.message("Parameters : " & frn.nParam() & " ; tip_ope : " & tip_ope, "Info Parameters", "Aceptar");								/*if(tip_ope &= "A"){ //Alta					frn.set("operacion","ALTA");				} else {					if(tip_ope &= "B"){ //Baja						frn.set("operacion","BAJA");					} else {*/						if(tip_ope &= "C"){ //Consulta							frn.set("operacion","SURTIDO");						} else {					      frn.message("Operación no válida ...", "Mensaje","&Aceptar");							//frn.open("anuncios",4);							frn.open("index",4);							return;									}					/*}				}*/												LimpiaDatosDoc(1); // imodo - 20231207 														//Llenar combo sucursales					cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";					if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){						cmd = cmd & " where c1='" & suc_usuario & "'";					}else {						if (suc_usuario &! asterisco && suc_usuario &! "" ){							cmd = cmd & " where c1='" & suc_usuario & "'";						}					}									var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");							ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										frn.set("k_sucn",getXml(cubo));														/*					// Fill Combo Tipo (Con Query FTO Kepler) 					cmdQuery = "select c5 as c0,c1,c2,c3,c4,c1||c2||lpad(c3::text,2,'0')||lpad(c4::text,3,'0')||'-'||'0000000' as c5, c16 as c6 from keplersc.kdmm " &					"where c1='" & gen_doc & "' and c2='" & nat_doc & "' and c3='" & gpo_doc & "' and c4 = '" & tip_doc & "'" ;					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"fefaltapedcrud.Inicializa()");					//frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\cuboTipoDocto");							ok=getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error BD","Aceptar");						return;					}					frn.set("k_tipon",getXml(cuboQuery));					*/									/*} else {*/					row_grid = -1 /*0*/;					err_empty = 0;					err_data = 0;							/*}*/								frn.set("k_fecha",sys.date());				//frn.set("k_hora",sys.time());									// Fill k_docto | referencia docto				//ArmarRefDocto();								/*				strFecha = sys.date();				fech_init = strFecha;				frn.set("k_fecha", fech_init);				fech_original = frn.get("k_fecha");				*/							} /* END Func Inicializa() */									// Armado del Docto Referencia			/*			fun ArmarRefDocto {				var cadena,tmpFolio, tmpGrupo, tmpTipo;				tmpFolio = frn.get("k_folio");				// //tmpFolio = frn.lib("libGeneral.kpl","PadLeft",tmpFolio,"7","0");				tmpFolio = PadLeft(tmpFolio,"7","0");				tmpGrupo = PadLeft(gpo_doc,"2","0");				tmpTipo = PadLeft(tip_doc,"3","0");				//cadena = trim(gen_doc) & trim(nat_doc) & trim(gpo_doc) & trim(tip_doc) & "-" & tmpFolio;				cadena = trim(gen_doc) & trim(nat_doc) & trim(tmpGrupo) & trim(tmpTipo) & "-" & tmpFolio;				frn.set("k_docto", cadena);			}			*/									fun PadLeft(pText,pRelleno,pCaracterRelleno) {				var Resultado;				var pos_ini = pText;            var nReg = strlen(pText);            for (var cont = nReg; cont < pRelleno; cont++) {					Resultado = pCaracterRelleno & Resultado;            }            Resultado = Resultado & pText;                            return Resultado;         } /* END Func PadLeft() */			fun ConfiguraControlesOff() {								frn.setAtt("textFolio", "visible", "N");				frn.setAtt("k_folio", "available", "N");				frn.setAtt("k_folio", "visible", "N");								frn.setAtt("k_fecha", "available", "N");				frn.setAtt("k_serie", "available", "N");				frn.setAtt("k_modelo", "available", "N");				frn.setAtt("k_clien", "available", "N");								frn.setAtt("k_refer", "available", "N");				frn.setAtt("k_ref_fech", "available", "N");				frn.setAtt("k_ref_monto", "available", "N");				frn.setAtt("k_ref_monto", "visible", "N");				frn.setAtt("k_ref_clien", "available", "N");								frn.setAtt("k_tipon", "available", "N");				frn.setAtt("c_tipo_dscr", "available", "N");				frn.setAtt("k_orden", "available", "N");				frn.setAtt("ord_serie", "available", "N");								frn.setAtt("k_mov", "visible", "N", "c_reemplazo");				frn.setAtt("k_mov", "visible", "N", "c_original");								frn.setAtt("grid", "tit", "Registro de Articulos : ");								//frn.setAtt("suctxt", "visible", "N");				//frn.setAtt("k_sucn", "visible", "N");															//frn.setAtt("k_mov", "available", "N");											frn.setAtt("k_mov", "modify", "N");				frn.setAtt("k_mov", "insdel", "N");				//frn.setAtt("k_mov", "nren", "fijo");								//modify="Y" insdel="N" nren="fijo"												frn.setAtt("k_mov", "available", "N", "c_reemplazo");				frn.setAtt("k_mov", "modify", "N", "c_reemplazo");				frn.setAtt("k_mov", "visible", "N", "c_reemplazo");								frn.setAtt("k_mov", "available", "N", "c_original");				frn.setAtt("k_mov", "modify", "N", "c_original");				frn.setAtt("k_mov", "visible", "N", "c_original");								frn.setAtt("k_mov", "modify", "N", "borrar");				frn.setAtt("k_mov", "visible", "N", "borrar");				frn.setAtt("k_mov", "modify", "N", "ctrlerr");				frn.setAtt("k_mov", "visible", "N", "ctrlerr");					frn.setAtt("k_mov", "modify", "N", "k_parte");				frn.setAtt("k_mov", "visible", "Y", "k_parte");								frn.setAtt("k_mov", "modify", "N", "k_descr");				frn.setAtt("k_mov", "visible", "Y", "k_descr");					frn.setAtt("k_mov", "modify", "N", "k_q");				frn.setAtt("k_mov", "visible", "Y", "k_q");							frn.setAtt("k_mov", "modify", "N", "k_unidad");				frn.setAtt("k_mov", "visible", "Y", "k_unidad");								frn.setAtt("k_mov", "available", "N", "k_surt");					frn.setAtt("k_mov", "modify", "N", "k_surt");				frn.setAtt("k_mov", "visible", "Y", "k_surt");								frn.setAtt("k_mov", "available", "N", "k_st_surt");				frn.setAtt("k_mov", "modify", "N", "k_st_surt");				frn.setAtt("k_mov", "visible", "N", "k_st_surt");																								frn.setAtt("Imprimir", "visible", "N");				frn.setAtt("Cancelar", "visible", "N");				frn.setAtt("Aceptar", "visible", "N");											} /* END Func ConfiguraControlesOff() */									fun ConfiguraControlesOpcion(imodo) {				var text_grid;								ConfiguraControlesOff();				if(tip_ope &= "A"){ //Alta									/*					text_grid = "Registro de Productos  /  [F9] Catalogo Productos  /  CTRL + DEL Borrar Linea";								frn.setAtt("k_fecha", "available", "N");										frn.setAtt("k_serie", "available", "Y");					frn.setAtt("k_refer", "available", "Y");					frn.setAtt("k_tipon", "available", "Y");					frn.setAtt("k_orden", "available", "Y");										frn.setAtt("grid", "tit", text_grid);				   // " [ F9 ] obtener valores de Catalogos ");										//frn.setAtt("k_mov", "available", "Y");					frn.setAtt("k_mov", "modify", "Y");					frn.setAtt("k_mov", "insdel", "Y");					//frn.setAtt("k_mov", "nren", "");										frn.setAtt("k_mov", "available", "N", "c_reemplazo");					frn.setAtt("k_mov", "modify", "N", "c_reemplazo");					frn.setAtt("k_mov", "visible", "N", "c_reemplazo");										frn.setAtt("k_mov", "available", "N", "c_original");					frn.setAtt("k_mov", "modify", "N", "c_original");					frn.setAtt("k_mov", "visible", "N", "c_original");										frn.setAtt("k_mov", "modify", "N", "borrar");					frn.setAtt("k_mov", "visible", "N", "borrar");					frn.setAtt("k_mov", "modify", "N", "ctrlerr");					frn.setAtt("k_mov", "visible", "Y", "ctrlerr");										frn.setAtt("k_mov", "modify", "Y", "k_parte");					frn.setAtt("k_mov", "visible", "Y", "k_parte");									frn.setAtt("k_mov", "modify", "N", "k_descr");					frn.setAtt("k_mov", "visible", "Y", "k_descr");						frn.setAtt("k_mov", "modify", "Y", "k_q");					frn.setAtt("k_mov", "visible", "Y", "k_q");											frn.setAtt("k_mov", "modify", "N", "k_unidad");					frn.setAtt("k_mov", "visible", "Y", "k_unidad");					frn.setAtt("k_mov", "modify", "Y", "k_eta");					frn.setAtt("k_mov", "visible", "Y", "k_eta");																				frn.setAtt("Imprimir", "visible", "N");					frn.setAtt("Cancelar", "visible", "Y");					frn.setAtt("Aceptar", "visible", "Y");										*/									} else {														if(tip_ope &= "B"){ //Baja											/*						text_grid = "Registro de Productos";											frn.setAtt("textFolio", "visible", "Y");						frn.setAtt("k_folio", "available", "Y");						frn.setAtt("k_folio", "visible", "Y");												frn.setAtt("k_fecha", "available", "N");											frn.setAtt("grid", "tit", text_grid);												//frn.setAtt("k_mov", "available", "Y");						frn.setAtt("k_mov", "modify", "N");						frn.setAtt("k_mov", "insdel", "N");						//frn.setAtt("k_mov", "nren", "fijo");								frn.setAtt("k_mov", "available", "N", "c_reemplazo");						frn.setAtt("k_mov", "modify", "N", "c_reemplazo");						frn.setAtt("k_mov", "visible", "Y", "c_reemplazo");												frn.setAtt("k_mov", "available", "N", "c_original");						frn.setAtt("k_mov", "modify", "N", "c_original");						frn.