inal");							frn.setAtt("k_mov", "visible", "N", "c_original");													frn.setAtt("k_mov", "modify", "N", "borrar");							frn.setAtt("k_mov", "visible", "N", "borrar");							frn.setAtt("k_mov", "modify", "N", "ctrlerr");							frn.setAtt("k_mov", "visible", "N", "ctrlerr");									frn.setAtt("k_mov", "modify", "N", "k_parte");							frn.setAtt("k_mov", "visible", "Y", "k_parte");											frn.setAtt("k_mov", "modify", "N", "k_descr");							frn.setAtt("k_mov", "visible", "Y", "k_descr");								frn.setAtt("k_mov", "modify", "N", "k_q");							frn.setAtt("k_mov", "visible", "Y", "k_q");								frn.setAtt("k_mov", "modify", "N", "k_unidad");							frn.setAtt("k_mov", "visible", "Y", "k_unidad");														frn.setAtt("k_mov", "available", "N", "k_surt");							frn.setAtt("k_mov", "modify", "N", "k_surt");							frn.setAtt("k_mov", "visible", "Y", "k_surt");														frn.setAtt("k_mov", "available", "N", "k_st_surt");							frn.setAtt("k_mov", "modify", "N", "k_st_surt");							frn.setAtt("k_mov", "visible", "N", "k_st_surt");														frn.setAtt("Imprimir", "available", "N");							frn.setAtt("Imprimir", "visible", "N");							frn.setAtt("Cancelar", "visible", "Y");							frn.setAtt("Aceptar", "visible", "Y");						}						}				}			} /* END Func ConfiguraControlesOpcion() */						/*			fun LimpiaDatosDoc {				//frn.set("k_refer", "");				//frn.set("k_fecref", "");				frn.setX("", "k_err"); // Added 20231010				frn.set("k_mov", "");				frn.set("k_coment", "");				frn.set("k_coment2", "");				frn.set("k_coment3", "");			}						fun LimpiaTotalesDoc {				//frn.set("k_subtotal", "");				//frn.set("k_iva", "");				frn.set("k_monto", "");			}						fun LimpiaEncabezado {				frn.set("k_folio", "");				frn.set("k_docto", "");				frn.set("k_fecha", "");				frn.set("k_hora", "");			}			*/												fun LimpiaDatosDoc(imodo) {							frn.set("k_modelo", "");				frn.set("k_clien", "");								frn.set("k_tipon", "");				frn.set("c_tipo_dscr", "");				frn.set("k_orden", "");				frn.set("ord_serie", "");								if ( imodo == 1 ) { 					frn.set("k_refer", "");					frn.set("k_ref_fech", "");					frn.set("k_ref_monto", "");					frn.set("k_ref_clien", "");										frn.set("k_serie", "");										LimpiaDetalle();				}								frn.set("c_clien", "");				frn.set("c_nombr", "");				//frn.set("k_mov", "");			}						// New section for this option 20231205 			fun LimpiaDetalle {				frn.set("k_mov", "");			}						fun LimpiaTotalesDoc {				/*				//frn.set("k_subtotal", "");				//frn.set("k_iva", "");				frn.set("k_monto", "");				*/			}						fun LimpiaEncabezado {				frn.set("k_folio", "");				//frn.set("k_docto", "");				frn.set("k_fecha", "");				//frn.set("k_hora", "");				frn.set("c_st", "");			}									/*			fun CambiaSucursal(imodo) {				if (imodo != 1 && imodo != 2) {					LimpiaEncabezado();					frn.set("k_fecha",sys.date());				}				//frn.set("k_hora",sys.time());					//ArmarRefDocto();				row_grid = -1;							if (tip_ope &! tip_ope_original && imodo != 1 && imodo != 2) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						// if(tip_ope &= "B"){ //Baja						//	frn.set("operacion","BAJA");						//} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						// }					}				} 								if(tip_ope &! "A" || imodo == 1 || imodo == 2){					if (imodo != 1 && imodo != 2) {						frn.set("k_fecha","");					}					MostrarDatosGrd(imodo);					frn.setPos("k_mov", 0, "modelo");					Get_Data_Row();				}							} 			*/			/* END Func CambiaSucursal() */						fun CambiaSucursal {				LimpiaDatosDoc(1); // imodo - 20231207				LimpiaTotalesDoc();				LimpiaEncabezado();				frn.set("k_fecha",sys.date());				//frn.set("k_hora",sys.time());					//ArmarRefDocto();				row_grid = -1;							if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					/*					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						if(tip_ope &= "B"){ //Baja							frn.set("operacion","BAJA");						} else {					*/							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","SURTIDO"/*"CONSULTA"*/);							}						/*}					}*/								}			}									/*			fun CambiaTipo {				LimpiaDatosDoc();				LimpiaTotalesDoc();				LimpiaEncabezado();				frn.set("k_fecha",sys.date());				frn.set("k_hora",sys.time());					ArmarRefDocto();				row_grid = -1;								if (tip_ope &! tip_ope_original) {					tip_ope = tip_ope_original;					ConfiguraControlesOpcion(); 					if(tip_ope &= "A"){ //Alta						frn.set("operacion","ALTA");					} else {						//if(tip_ope &= "B"){ //Baja						//	frn.set("operacion","BAJA");						//} else {							if(tip_ope &= "C"){ //Consulta								frn.set("operacion","CONSULTA");							}						//}					}								}			}			*/		   		   		   		   fun ObtenerRef() {							var win_tit, field_key, field_col, cmdQuery;				            //proveedor_id = frn.get("k_clave");            sucursal_id = frn.get("k_sucn",-1,1);	                        win_tit = "Anticipos";				field_key = "folio";				field_col = "k_refer";            cmdQuery = "select  m.c6 folio, m.c9 fecha, m.c16 monto, m.c10 cliente, e.c3 nombre " & 					"from keplersc.kdm1 m inner join keplersc.kdud e on e.c2 = m.c10 " &                 "where m.c1 = '" & sucursal_id &  "' and m.c2 = '" & gen_doc & "' and m.c3 = '" & nat_doc & "' and m.c4 = " & gpo_doc & " and m.c5 = " & tip_doc & " ";            cmdQuery = cmdQuery & " order by m.c6 desc ";                        	         frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");                     }         			fun ObtenerVin() {							var win_tit, field_key, field_col, cmdQuery;				            //proveedor_id = frn.get("k_clave");            sucursal_id = frn.get("k_sucn",-1,1);	                        win_tit = "Series Autos";				field_key = "vin";				field_col = "k_serie";            cmdQuery = "select h.c4 vin, h.c3 modelo, h.c9 contacto, h.c16 /*e.c3*/ nombre " & 					"from keplersc.kdserie h /*inner join keplersc.kdud e on e.c2 = m.c10*/ " & 					"where length(h.c4) > 0 "; 					             cmdQuery = cmdQuery & " order by h.c4 ";                        	         frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");                     }                  fun ObtenerTipo() {							var win_tit, field_key, field_col, cmdQuery;				            proveedor_id = frn.get("k_clave");            sucursal_id = frn.get("k_sucn",-1,1);	                        win_tit = "Tipos de Ordenes";				field_key = "clave";				field_col = "k_tipon";            cmdQuery = "select c1 as clave, c3 as descripcion from keplersc.kdmargen ";                        cmdQuery = cmdQuery & " order by c1";                        	         frn.dialog("genlistasel", win_tit,cmdQuery, field_key, field_col /*objeto*/, 0, "","N");                     }                       			fun ObtenerOrden() {			            sucursal_id = frn.get("k_sucn",-1,1);	            cmdQuery = "" &						"select i.c3 as folio, i.c11 as cliente, i.c4 as fecha from keplersc.kdord i " & 						"where i.c1 = '" & /*"02"*/sucursal_id & "' and i.c2 = '" & frn.get("k_tipon")  & "' order by i.c3 desc";						                                    frn.dialog("genlistasel","Relacion de Ordenes",cmdQuery,"folio","k_orden","0","","N");                     }         						fun MostrarTipo() {					var refer, dato_id, ;																	sucursal_id = frn.get("k_sucn",-1,1);				refer = trim(frn.get("k_tipon"));				frn.set("k_tipon", refer);									if ( strlen(refer) == 0 ) {								frn.set("c_tipo_dscr", "");					frn.set("k_orden", "");					frn.set("ord_serie", "");					if ( strlen(frn.get("k_refer")) == 0 ) {						frn.set("c_clien", "");						frn.set("c_nombr", "");					} else {						if(tip_ope &= "A"){							MostrarRef();						}					}					return;				}								cmdQuery = "" &					"select h.c3 as descripcion from keplersc.kdmargen h " &					"where h.c1 = '" & refer & "'";									rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refpedidoespecialcrud.mostrartipo()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrartipo");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.message("Tipo No Valido ...","Info","Aceptar");					//frn.set("c_tipo_dscr", "No Valido ...");					frn.set("c_tipo_dscr", "--");					frn.set("k_orden", "");					frn.set("ord_serie", "");					frn.setPos("k_tipon");					return;					}					//frn.set(cuboQuery);								dato_id = getXmlAtt(cuboQuery,"r0", "descripcion");				frn.set("c_tipo_dscr", dato_id);											return;						   } // End MostrarTipo()		   		   			fun MostrarVin() {							var flagErr, v_folio;												flagErr = 0;								sucursal_id = frn.get("k_sucn",-1,1);				v_folio = trim(frn.get("k_serie"));				frn.set("k_serie", v_folio);								if ( strlen(v_folio) == 0 ) {								frn.set("k_modelo", "");					frn.set("k_clien", "");					if ( strlen(frn.get("k_refer")) != 0 ) { 						if(tip_ope &= "A"){							MostrarRef();						} 					}					return;				}								if(tip_ope &= "A"){					LimpiaDatosDoc(); // Verificar si esta opcion de limpiar campos es la mejor opcion 				}									cmdQuery = "select h.c4 vin, h.c3 modelo, h.c9 contacto, h.c16 /*e.c3*/ nombre " & 					"from keplersc.kdserie h /*inner join keplersc.kdud e on e.c2 = m.c10*/ " & 					"where length(h.c4) > 0 and ( h.c4 = '" & v_folio  & "' or h.c1 = '" & v_folio  & "' )";				//frn.message(cmdQuery,"Info !","Aceptar");								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refpedidoespecial.upd()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosorden");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.set("k_modelo", "--");					frn.set("k_clien", "--");					if ( strlen(frn.get("k_orden")) != 0 ) { MostrarOrden(); }					frn.message("El VIN [Serie] No Existe ...","Info","Aceptar");					flagErr = 1;					return;				}	else {					// Ok ...				}				//frn.set(cuboQuery);								frn.set("k_serie", getXmlAtt(cuboQuery,"r0", "vin"));				frn.set("k_modelo", getXmlAtt(cuboQuery,"r0", "modelo"));				frn.set("k_clien", getXmlAtt(cuboQuery,"r0", "contacto"));				if ( strlen(frn.get("c_nombr")) == 0 ) { frn.set("c_nombr", getXmlAtt(cuboQuery,"r0", "nombre")); }								if ( strlen(frn.get("k_refer")) != 0 ) { 					if(tip_ope &= "A"){						MostrarRef();					} 				}				if ( strlen(frn.get("k_orden")) != 0 ) { 					if(tip_ope &= "A"){						MostrarOrden(); 					}				}						} // End - MostrarVin				   			fun MostrarRef() {							var flagErr, v_folio;												flagErr = 0;								sucursal_id = frn.get("k_sucn",-1,1);				v_folio = trim(frn.get("k_refer"));				frn.set("k_refer", v_folio);								frn.setAtt("k_ref_monto", "visible", "N");								if ( strlen(v_folio) == 0 ) {								frn.set("k_ref_fech", "");					frn.set("k_ref_monto", "");					frn.set("k_ref_clien", "");					if ( strlen(frn.get("k_orden")) == 0 ) {						frn.set("c_clien", "");						frn.set("c_nombr", "");					} else {						if(tip_ope &= "A"){							MostrarOrden();						}					}					return;				}												cmdQuery = "" &				"select m.c6 folio, m.c10 cliente, e.c3 nombclie, m.c9 fecha, m.c16 monto from keplersc.kdm1 m " & 				"inner join keplersc.kdud e on e.c2 = m.c10 " & 				"where m.c1 = '" & sucursal_id & "' and m.c2 = '" & gen_doc & "' and m.c3 = '" & nat_doc & "' and m.c4 = " & gpo_doc & " and m.c5 = " & tip_doc  & " " &				"and m.c6 = '" & v_folio  & "'";				//frn.message(cmdQuery,"Info !","Aceptar");								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refpedidoespecial.upd()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosorden");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.set("c_clien", "--");					frn.set("c_nombr", "");					frn.set("k_ref_fech", "--");					frn.set("k_ref_monto", "");					frn.set("k_ref_clien", "--");					frn.message("El Anticipo No Existe ...","Info","Aceptar");					flagErr = 1;					return;				}	else {					// Ok ...				}				//frn.set(cuboQuery);								frn.set("k_refer", getXmlAtt(cuboQuery,"r0", "folio"));				frn.set("c_clien", getXmlAtt(cuboQuery,"r0", "cliente"));				frn.set("c_nombr", getXmlAtt(cuboQuery,"r0", "nombclie"));				frn.set("k_ref_fech", getXmlAtt(cuboQuery,"r0", "fecha"));				frn.set("k_ref_monto", getXmlAtt(cuboQuery,"r0", "monto"));				frn.set("k_ref_clien", getXmlAtt(cuboQuery,"r0", "cliente"));								frn.setAtt("k_ref_monto", "visible", "Y");						} // End - MostrarOrden		            			fun MostrarOrden(/*nFolio*/) {							var flagErr, v_tipoorden, v_folio;				var folio2;												flagErr = 0;								sucursal_id = frn.get("k_sucn",-1,1);				v_tipoorden = frn.get("k_tipon");				v_folio = /*nFolio*/ trim(frn.get("k_orden"));				frn.set("k_orden", v_folio);								if ( strlen(v_folio) == 0 ) {								frn.set("ord_serie", "");					if ( strlen(frn.get("k_refer")) == 0 ) {						frn.set("c_clien", "");						frn.set("c_nombr", "");					} else {						if(tip_ope &= "A"){							MostrarRef();						}					}					return;				}								folio2 = PadLeft(v_folio, 10, "0");				v_folio = folio2;				frn.set("k_orden", v_folio);																cmdQuery = "" &				"select u.c3 folio, u.c10 cliente, u.c6 serie, e.c3 nombclie, h.c4 vin, h.c3 modelo, h.c9 contacto from keplersc.kdord u " & 				"inner join keplersc.kdud e on e.c2 = u.c10 " & 				"inner join keplersc.kdserie h on h.c1 = u.c6 " & 				"where u.c1 = '" & /*"02"*/sucursal_id & "' and u.c2 = '" & v_tipoorden & "' and u.c3 = '" & v_folio  & "'";								//frn.message(cmdQuery,"Info !","Aceptar");								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refpedidoespecial.upd()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosorden");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.set("c_clien", "--");					frn.set("c_nombr", "");					frn.set("ord_serie", "--");					frn.set("k_serie", "--"); // To check what is best option  					frn.set("k_modelo", "");					frn.set("k_clien", "");					frn.message("La Orden No Existe (verifique el Tipo seleccionado) ...","Info","Aceptar");					flagErr = 1;					return;				}	else {					// Ok ...				}				//frn.set(cuboQuery);												/*				frn.setX(getXmlAtt(cuboQuery,"r0", "folio"), "k_folio");				frn.setX(getXmlAtt(cuboQuery,"r0", "fecha"), "k_fecha");				frn.setX(getXmlAtt(cuboQuery,"r0", "hora"), "k_hora");				*/								frn.set("k_orden", getXmlAtt(cuboQuery,"r0", "folio"));				frn.set("c_clien", getXmlAtt(cuboQuery,"r0", "cliente"));				frn.set("c_nombr", getXmlAtt(cuboQuery,"r0", "nombclie"));				frn.set("ord_serie", getXmlAtt(cuboQuery,"r0", "serie"));				frn.set("k_serie", getXmlAtt(cuboQuery,"r0", "vin"));				frn.set("k_modelo", getXmlAtt(cuboQuery,"r0", "modelo"));				frn.set("k_clien", getXmlAtt(cuboQuery,"r0", "contacto"));						} // End - MostrarRef			      		   fun MostrarDOC(nFolio) {							var xmlData, flagErr;												flagErr = 0;								sucursal_id = frn.get("k_sucn",-1,1);								LimpiaDatosDoc(1); // to check imodo param 				//LimpiaTotalesDoc();				LimpiaEncabezado();								if(tip_ope &! "C"){						frn.setAtt("Aceptar", "visible", "N");				}								cmdQuery = "" & 					"select w.c2 as folio, w.c3 as fecha, w.c4 as serie, w.c5 as cliente, coalesce(e.c3,'No es Cliente ...') as nombre, w.c10 as refer, w.c11 as tipo, w.c12 as orden, w.c13 st_surt " & 					"from keplersc.kdserped w left join keplersc.kdud e on e.c2 = w.c5 " & 					"where w.c1 = '" & sucursal_id & "' and w.c2 = '" & nFolio & "'";				//frn.message(cmdQuery,"Info !","Aceptar");								rstXml(xmlData);				xmlData = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refaltapedcrud.upd()");				frn.lib("libGeneral.kpl","FileSave",xmlData, fileSavePath & "\mostrardoc_refpedidoespecial");				ok=getXmlAtt(xmlData,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlData,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(xmlData) == 0){					//frn.setAtt("Aceptar", "visible", "N");					//ConfiguraControlesOff();					frn.message("Sin Datos por mostrar ...","Info","Aceptar");					flagErr = 1;					//ArmarRefDocto();					return;					//Cancela();					}	else {					/*					if(tip_ope &! "C"){						frn.setAtt("Aceptar", "visible", "Y");					}					*/				}				//frn.set(cuboQuery);								//if ( flagErr == 1 ) { Cancela(); }				ConfiguraControlesOpcion();								/*				frn.setX(getXmlAtt(cuboQuery,"r0", "folio"), "k_folio");				frn.setX(getXmlAtt(cuboQuery,"r0", "fecha"), "k_fecha");				frn.setX(getXmlAtt(cuboQuery,"r0", "refer"), "k_refer");				frn.setX(getXmlAtt(cuboQuery,"r0", "fechref"), "k_fecref");				frn.setX(getXmlAtt(cuboQuery,"r0", "hora"), "k_hora");				*/								frn.set("k_folio", getXmlAtt(xmlData,"r0", "folio"));				frn.set("k_fecha", getXmlAtt(xmlData,"r0", "fecha"));				frn.set("k_serie", getXmlAtt(xmlData,"r0", "serie"));				frn.set("k_refer", getXmlAtt(xmlData,"r0", "refer"));				frn.set("k_tipon", getXmlAtt(xmlData,"r0", "tipo"));				frn.set("k_orden", getXmlAtt(xmlData,"r0", "orden"));									MostrarVin();				MostrarRef();				MostrarTipo();				MostrarOrden();								frn.set("c_clien", getXmlAtt(xmlData,"r0", "cliente"));				frn.set("c_nombr", getXmlAtt(xmlData,"r0", "nombre"));								if ( getXmlAtt(xmlData,"r0", "st_surt") == 10 ) {					frn.set("c_st","Totalmente Surtido");				} else {					frn.set("c_st", "");				}								//ArmarRefDocto();								MostrarDOCDet(nFolio);						}			fun MostrarDOCDet(nFolio) {					var refer;				var xmlGrd;				var totReg, totSurt;																	sucursal_id = frn.get("k_sucn",-1,1);								//Reset campos				frn.set("k_mov", "");							//CalculaTotales();								cmdQuery = "" &				"select x.c4 k_parte, i.c2 k_descr, x.c5 k_q, x.c6 k_unidad, x.c9 k_surt, x.c8 k_st_surt " &				", (select * from keplersc.reemplazo_prod_text(x.c4)) as c_reemplazo " & 				"from keplersc.kdserpedmov x " & 				"inner join keplersc.kdini i on x.c4 = i.c1 " & 				"where x.c1 = '" & sucursal_id & "' and x.c2 = '" & nFolio & "' order by x.c3";								rstXml(cuboQuery);				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refpedidoespecial.mostrardatosgrid()");				frn.lib("libGeneral.kpl","FileSave",cuboQuery, fileSavePath & "\mostrardatosdocgrid_pedidoespecial");				ok=getXmlAtt(cuboQuery,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboQuery,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;					}				if(nXml(cuboQuery) == 0){					frn.message("Sin Registros por mostrar ...","Info","Aceptar");					return;					}					//frn.set(cuboQuery);							rstXml(xmlGrd);				xmlGrd=frn.lib("libGeneral.kpl","CreaXmlDesdeTagRow",cuboQuery,"r","k_mov");				frn.lib("libGeneral.kpl","FileSave",xmlGrd, fileSavePath & "\mostrardatosdocgrid_pedidoespecial_parsed");				frn.setX(xmlGrd);												//CalculaTotales();												//Validar Estatus Documento				if ( strlen(frn.get("c_st")) == 0 ) {									cmdQuery = "" & 						"select sum(1) as totregs, sum(case when c8 = 10 then 1 else 0 end) totsurt from keplersc.kdserpedmov where c1 = '" & sucursal_id & "' and c2 = '" & nFolio & "' ";												rstXml(cuboQuery);					cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"refpedidoespecialcrud.ValidarDatos_Surtir()");					ok = getXmlAtt(cuboQuery,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cuboQuery,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error DB","Aceptar"); //TO DO Homologar mensaje en todo el proyecto, agregar DB						return;					}										totReg = 0;					totSurt = 0;					totReg = getXmlAtt(cuboQuery,"r0","totregs");					totSurt = getXmlAtt(cuboQuery,"r0","totsurt");										if(totReg==0){						frn.message("El Pedido Especial No existe ...","Error","Aceptar");						resVal=0;						return;					} else {						if ( totReg > totSurt ) {							if ( totSurt > 0 ) {								frn.set("c_st","Parcialmente Surtido");							} else {								frn.set("c_st","Sin Surtir");							}						} else {							if ( totReg == totSurt ) {								frn.set("c_st","Surtido");							}						}					}								} // End IF Len.c_st									return;						   } // End MostrarDOCDet()		   		   		   /*			fun CalculaTotales(iModo) {				var monto = 0, monto_acum = 0;				var cantValida = 1, rows;								rows = frn.N("k_mov") - 1; 				//Calcular totales				for (var i=0; i < rows; i++) {  // frn.N("k_mov")					if ( strlen(frn.get("k_mov",i,"k_parte")) != 0 ) {						monto = frn.get("k_mov",i,"k_q") * frn.get("k_mov",i,"k_precio");						monto_acum = monto_acum + monto;						frn.setX(monto, "k_mov", i, "monto");					} else {						frn.setX("", "k_mov", i, "monto");					}				}								//frn.set("k_subtotal",subTotal);				//frn.set("k_iva",iva);								frn.set("k_monto",monto_acum);								return cantValida;			}			*/		   					// ZONA	CODIGO REPORTE(S) 						fun IniParams(){//Inicializa parámetros de impresión. Pueden ser cambiados por el usuario final mediante menú: Archivo -> Configurar Página				frn.set("param_paper","letter");	//Tamaño de papel predefinido:	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tamaño de papel personalizado	"size=21.59,27.94cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//Márgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0");	//Escala de impresión (1=100 por ciento)	"F=1,1"				frn.set("param_landscape","N");	//Orientación	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"				frn.set("param_emp","L");	//Posición de "Razón social"(izq,der,cen)	@emp=L|R|C"			}						fun setRepPage() {//Establece los parámetros finales de impresión.				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}						fun Ejecuta_Reporte() {							if (  ( frn.N("k_mov") == 0 ) || ( strlen( trim(frn.get("k_folio")) ) == 0 )  ) {					frn.message("Sin Registros por mostrar ...","Info","Aceptar");					return;				}							// Commented 20221208 				//IniParams(); //Inicializa parámtros de impresión entre otros							//Code Added 20121208 				/*				//rstXml(xmlPar);				*/								/*				if ( tip_ope_original &= "C" && tip_ope &= "C" ) {					CambiaSucursal(3); 				}				*/									// fech_original = "2022-11-03"; // 4 Testing				// tip_ope_original = "A"; // 4 Testing								//...(cubos de datos e información necesaria)				sucursal = frn.get("k_sucn",-1,1);				/*				if ( tip_ope_original &= "A" && tip_ope &= "C" ) {					fech_oper = fech_original; // frn.get("k_fecha");				}				tipo_auto = "NUEVO";				*/								/*				// setXml(xmlPar,"document","sucursal_id",sucursal);				*/								/*				if ( tip_ope_original &= "A" && tip_ope &= "C" ) {					setXml(xmlPar,"document","fech_oper", fech_oper); 				}				setXml(xmlPar,"document","tipo_auto", tipo_auto);				*/								//code Added 20221208 by JMM				/*				if ( strlen(frn.get("k_fecha")) > 0 ) { 					setXml(xmlPar,"document","fech_I", frn.get("k_fecha"));				}				if ( strlen(frn.get("k_fecha_F")) > 0 ) { 					setXml(xmlPar,"document","fech_F", frn.get("k_fecha_F"));				}					*/								/*				//setXml(xmlPar,"document","folio",frn.get("k_folio"));				//setXml(xmlPar,"document","fecha",frn.get("k_fecha"));				*/								/*				frn.lib("libGeneral.kpl","FileSave",xmlPar, fileSavePath & "\refalatapedcrud_rpt_xmlPar");												cmd="select * from keplersc.autos_com_asig_rpt('"& getXmlStr(xmlPar,"EOF:13_10") &"')";				rstXml(xmlResQuery);				xmlResQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"comaltasigcrudN_rpt.Ejecuta_Reporte()");				ok=getXmlAtt(xmlResQuery ,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(xmlResQuery ,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}						frn.lib("libGeneral.kpl","FileSave",xmlResQuery, fileSavePath & "\comaltasigcrudN_rpt_xmlResQuery");								*/								Reporte();						} /* END Func Ejecuta_Reporte() */						fun Reporte() {							// Our Vars				var compania, titrep;				var contProd, contDet, tmpStr ,xmlDet, xmlCurDocto;				//var folio;				var p_fecha, var_fecha;				var p_subtotal, p_utilidad, p_perce, p_costo, p_total, p_iva;				var gt_subtotal, gt_utilidad, gt_perce, gt_costo, gt_total, gt_iva;								//Obtener datos generales				kdb.kde("KDE");//Configuracion del servidor				kdb.exec();				compania = kdb.get("KDE","1");									// Se define el formato a usar y se liga a la variable del reporte "rep"	// Se define el formato a usar y se liga a la variable del reporte "rep"				rep.rst(); // 20121208				IniParams(); // 20121208				kdb.readPage("datFto","refbackordercrudfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				//rep.rst(); // 20121208				setRepPage();//Establece los parámetros finales de impresión(rep.page(...);), pues pueden haber cambiado por el usuario 				//Da valor a los inputs del reporte(rep.set();), e indica la ejecución de "grupos de renglones de impresión" (rep.exe();)												titrep = "ENTRADA A BACKORDER";												rep.set("fecha",sys.date());				rep.set("hora",sys.time());				rep.set("nombreempresa",compania);				rep.set("tituloreporte",titrep);								rep.set("suc",sucursal);				rep.set("foldoc",frn.get("k_folio"));				rep.set("fechdoc",frn.get("k_fecha"));								//contProd=nXml(xmlResQuery);				contProd=frn.N("k_mov")-1;				rep.exe("encabezado");														for(var x=0; x<contProd; x++){									/*					rep.set("invent",getXmlAtt(xmlResQuery,"r"&x,"c_cveinv"));					rep.set("modelo",getXmlAtt(xmlResQuery,"r"&x,"c_cvemod"));					rep.set("anio",getXmlAtt(xmlResQuery,"r"&x,"c_anio"));					rep.set("descrip",getXmlAtt(xmlResQuery,"r"&x,"c_descrip"));					rep.set("serie",getXmlAtt(xmlResQuery,"r"&x,"c_serie"));					rep.set("color",getXmlAtt(xmlResQuery,"r"&x,"c_color"));					rep.set("vest",getXmlAtt(xmlResQuery,"r"&x,"c_vest"));					if ( tip_ope_original &= "A" && tip_ope &= "C" ) {						rep.set("suc",getXmlAtt(xmlResQuery,"r"&x,"c_suc"));					}					*/											rep.set("reemplazo",frn.get("k_mov",x,"c_reemplazo"));					rep.set("producto",frn.get("k_mov",x,"k_parte"));					rep.set("descrip",frn.get("k_mov",x,"k_descr"));					rep.set("cantidad",frn.get("k_mov",x,"k_q"));					rep.set("um",frn.get("k_mov",x,"k_unidad"));					rep.set("importe",frn.get("k_mov",x,"k_monto"));					/*					rep.set("stock",frn.get("k_mov",x,"c_stock"));					rep.set("especial",frn.get("k_mov",x,"c_especial"));					*/										rep.exe("detalle");				}						rep.set("c_subt",frn.get("k_monto"));				rep.set("c_iva",0);				rep.set("c_tot",frn.get("k_monto"));								rep.exe("total");										rep.set("c_cmnt1",frn.get("k_coment"));				rep.set("c_cmnt2",frn.get("k_coment2"));				rep.set("c_cmnt3",frn.get("k_coment3"));								rep.exe("coments");								//Modos de impresión 				rep.win(); //Muestra la vista previa de la impresión. A partir de la vista previa (Preprint) se decide si se imprime o no.				//rep.print("\\192.168.1.100\HPLaserJet"); //Envía el reporte directamente a una impresora, sin mostrar la vista previa.				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresión. No muestra la vista previa.				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardará el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html										} /* END Func Reporte() */									// END : ZONA	CODIGO REPORTE(S) 											} // End of class Main			</script></pag>