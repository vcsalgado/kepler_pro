<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Detalle Refaccion"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="236,240,243" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="35,20,10,10" brdr="0,5" tit="Detalle Refaccion" fnt="Arial,16">				<tab n="1"/><txt clr="0,58,112">Pieza:</txt>		<inp id="clave_ref"  dim="10,1" brdr="2,0" clr="64,64,64" OnF9="Dialog(3,cat_refacciones)" bclr="255,255,255" clrBrdr="255,255,255"  available="S"/>	<sp/>		<img id="buscar_datos" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="buscar_datos()" available="Y" clrBrdr="0,0,0"/>		<br/><br/>		<tab n="1"/><txt clr="0,58,112">Descripcion:</txt>		<inp id="desc_ref"  dim="20,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"  available="S"/>	<br/><br/>		<tab n="1"/><txt clr="0,58,112">Existencia:</txt>		<inp id="existencia"  dim="7,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/>	<br/><br/>		<tab n="1"/><txt clr="0,58,112">Precio al Publico:</txt>		<inp id="importe_ref"  dim="7,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><br/><br/>		<tab n="1"/><txt clr="0,58,112">Precio al Publico no incluye IVA</txt>					</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,sucursal  ;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();							suc_usuario = frn.lib("libKepler","UserInfo(1)");				sucursal = frP.get("k_sucN", -1, 1);					if (sucursal &= ""){					sucursal = suc_usuario ;				}						}											fun buscar_datos(){							var xmlRequest,cmd,ok,cubo, totresults , cubo_ref  , strTmp, xmlRes,contresults,mensajeError ;							borrar_datos();							setXml(xmlRequest,"document","clave_ref",frn.get("clave_ref"));				setXml(xmlRequest,"document","sucursal_id",sucursal );							frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequestref");								cmd="select * from keplersc.detalles_refaccion('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";				cubo= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"detalles_ref.buscar_datos()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuborefdet");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}												//inserta regitros				strTmp = getXmlAtt(cubo,"r0","refaccion");				strTmp = delScpScn(strTmp);				setXmlStr(cubo_ref   ,strTmp);								frn.lib("libGeneral.kpl","FileSave",cubo_ref  ,"C:\Basura\cubo_ref   ");				frn.setX(cubo_ref);							}									fun borrar_datos(){							frn.rst("desc_ref");				frn.rst("existencia");				frn.rst("importe_ref");						}											 fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje				*/				var prefix=frn.lib("libKepler","langPrefix");				var page=prefix&pag;				var b_valido=1;				if(iModo==0)page=pag;				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;				}				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);			}						}	</script></pag>