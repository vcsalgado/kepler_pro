<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Calculadora">
<grp  brdr="0,0" clr="0,58,112" fnt="Arial,14"  dim="0,0,10,12" bclr="192,205,213" unfont="0">
	<br/>
	<br/>
		<hLine clr="0,0,0"/>
		<br/><br/>
		<tab/>
		<grp id="gpo_2" bclr="236,240,243" fntClrBrdr="255,255,255" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="21,15,10,12" brdr="0,5" tit="Calculadora" fnt="Arial,16">
			<tab/>
				<inp id="k_historial" dim="25,1" brdr="0,0" bclr="236,240,243" clr="0,0,0" clrBrdr="192,205,213" 
					type="capital" modify="N" available="N" fnt="Arial,18"/>
            <br/>
			<tab/>
				<inp id="k_numero_1" dim="15,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 
					type="number" modify="N" available="N" fnt="Arial,18" nd="2"/>
            <br/>
			<tab n="3"/><sp/>
				<inp id="k_operador" nc="1" dim="1,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 
					type="capital" modify="Y" available="Y" fnt="Arial,18" 
					OnEnter="valida_operador(k_operador)"/>
            <br/>
			<tab/>
				<inp id="k_numero_2" dim="15,1" brdr="0,0" bclr="255,255,255" clr="0,0,0" clrBrdr="192,205,213" 
					type="number" modify="Y" available="Y" fnt="Arial,18" nd="2"
					OnEnter="valida_operador(k_numero_2)"/>
            <tab n="4"/>
		<br/>
		<tab n="2"/>
		<bot id="k_btn_cons" dim="10,10" brdr="5" text="Aceptar" hk="K" step="0" OnEnter="valida_operador(k_btn_cons)" fnt="Arial,16"/>
        <br/>
		</grp>
</grp>
	<script>
		InstallDriver("KDB75");
		class Main {
			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,rol_usuario, externo, cuboXml;
			var tipoOper,consPlantilla, accion; //Variables relacionadas con parametros (colsulta , eliminar, baja)
			var strTitulo, strQuery, strColValor, strCtrlSet, strMostrarLlave, strRenglon, strColumna, clave, modelo, clave_2; 
			var numero_ini, asterisco, div, suma, resta, operador, id_ele_grafic, ele_tabla, ren_tabla, col_tabla;
			fun Main(){
				frn=new FRNT;
				kdb=new KDB;
				frP=new FRNTP;
				sys=new SYS;
				kdb.connect();
				
				suc_usuario = frn.lib("libKepler","UserInfo(1)");
				perfil_usuario = frn.lib("libKepler","UserInfo(2)");
				rol_usuario = frn.config("user","role");
				asterisco = "*";
				div = "/";
				suma = "+";
				resta = "-";
				
				numero_ini = frn.param(0);
				id_ele_grafic = frn.param(1);

				ele_tabla = frn.param(2);
				ren_tabla = frn.param(3);
				col_tabla = frn.param(4);

				Inicializa();
			
			}

			fun cierra_calc(){
				var resultado = frn.get("k_numero_1");
				if (ele_tabla&!""){
					frP.setX(resultado, ele_tabla,ren_tabla,col_tabla);
					frn.exit();
				}else{
					frP.set(id_ele_grafic,resultado);
					frn.exit();
				}
			}

			fun realiza_op(){
				var xmlPantalla, cmdQuery, cuboQuery, resultado, mensaje, xml_cuboQuery;
				xmlPantalla = getXml(frn.dataPag());
				//frn.lib("libGeneral.kpl","FileSave",xmlPantalla,"C:\basura\xmlPantallaLineas");
				cmdQuery="select * from keplersc.calculadora('<document>" & getXmlStr(xmlPantalla,"EOF:13_10") & "</document>')";
				kdb.rst(cuboQuery);
				cuboQuery = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"calculadora.realiza_op");
				resultado= getXml(cuboQuery,"resultado");
				//frn.lib("libGeneral.kpl","FileSave",cuboQuery,"C:\basura\cuboQuery2");
				mensaje= getXml(cuboQuery,"mensaje");
				
				if(resultado &= "0"){
					frn.message(mensaje,"Error","Aceptar");
					return;
				}else{
					xml_cuboQuery=frn.lib("libGeneral.kpl","CreaXmlDesdeAtt",cuboQuery,"r0");
					//frn.lib("libGeneral.kpl","FileSave",xml_cuboQuery,"C:\Basura\xml_cuboQuery");
					frn.setX(xml_cuboQuery);
				}
			}
        
			fun valida_operador(elemento){
				operador = frn.get("k_operador");
				if (elemento&="k_operador"){
					if(operador &= asterisco || operador &= div || operador &= suma || operador &= resta){
						frn.setPos("k_numero_2");
					}else{
						frn.message("Operador no Valido","Error");
						frn.setPos("k_operador");
					}
				}else if(elemento&="k_numero_2"){
					if(operador &= asterisco || operador &= div || operador &= suma || operador &= resta){
						realiza_op();
						frn.setPos("k_btn_cons");
					}else{
						frn.message("Operador no Valido","Error");
						frn.setPos("k_operador");
					}
				}else if(elemento&="k_btn_cons"){
					if(operador &= asterisco || operador &= div || operador &= suma || operador &= resta){
						cierra_calc();
					}else{
						frn.message("Operador no Valido","Error");
						frn.setPos("k_operador");
					}
				}
			}
					
			fun Inicializa(){
				frn.rst("gpo_2");
				Inicia_Forma();	
				}
	
			fun activaCampos(){               
				frn.setAtt("numero_1", "modify", "N");
				frn.setAtt("numero_1", "bclr", "255,255,255");
				frn.setAtt("k_clave_2", "available", "Y");
				frn.setAtt("k_clave_2", "bclr", "255,255,255");
				frn.setAtt("k_desc", "available", "Y");
				frn.setAtt("k_desc", "bclr", "255,255,255");
				if(tipoOper&="Modificar"){
					frn.setAtt("k_clave", "available", "N");
					frn.setAtt("k_clave", "bclr", "236,240,243");
					frn.setAtt("k_clave_2", "available", "N");
					frn.setAtt("k_clave_2", "bclr", "236,240,243");
					}
			}

			fun Inicia_Forma(){
				var cmd,ok,mensajeError, cubo;
				//Etiquetas 
				frn.set("historia","Historial");
				frn.set("numero_1","Numero 1");
				frn.set("operador","Operador");
				frn.set("numero_2","Numero 2 ");

				frn.set("k_numero_1",numero_ini);

				frn.setAtt("k_historia", "available", "N");
				frn.setAtt("k_historia", "modify", "N");
				frn.setAtt("k_historia", "bclr", "236,240,243");

				frn.setAtt("k_numero_1", "available", "N");
				frn.setAtt("k_numero_1", "modify", "N");
				frn.setAtt("k_clave", "bclr", "236,240,243");

			}
		
//---------------------------------------------------------------EXTRAS-------------------------------------------------------------------GAD fl4r30n
						
			fun Dialog(iModo,pag,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15){
				/*iModo: 0)No hace mayor validaci?n. Siempre despliega la ventana. NO CONCATENA PREFIJO
							1)Solo concatena el prefijo de la carpeta del lenguaje, no hace mayor validaci?n. Siempre despliega la ventana
							2)Modo especial. Se valida que el campo indicado en par0 se puede modificar(El par0 puede ser una tabla, y par1 la columna)
							3)Modo especial para p?ginas de operacion:Solo si se est? en alta o modifica despliega la pagina. Simpre agrega el prefijo del lenguaje
				*/
				var prefix=frn.lib("libKepler","langPrefix");
				var page=prefix&pag;
				var b_valido=1;
				if(iModo==0)page=pag;
				else if(iModo==2&&(strlen(par0)>0)){//Se toma el par0 como el objeto (o grid) al que se devolver? el resultado.
					if( frn.getAtt(par0,"modify",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"available",par1) &= "N" ) b_valido=0;
					if( frn.getAtt(par0,"visible",par1) &= "N" ) b_valido=0;
				}
				if(iModo==3)frn.dialog(page,par0,par1,par2,par3,par4,par5,par6,par7,par8,par9,par10,par11,par12,par13,par14,par15);
			}
		}
	</script>
</pag>