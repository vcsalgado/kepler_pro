<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="">	<grp dim="1,-1,7,11" brdr="0,0" clr="0,58,112" bclr="192,205,213" fnt="Arial,16" unfont="0" OnEnter="Exit()"><br/>		<tab/><inp id="k_titulo" dim="65,1" brdr="0,0" bclr="192,205,213" clr="0,0,0" clrBrdr="192,205,213"				type="string" modify="N" available="N" fnt="Arial,22"/>		<br/><br/>		<hLine clr="0,0,0"/>		<br/><br/>		<tab/>		<grp id="grupo_crud" dim="95,14,7,11" bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" fntBrdr="Arial,18" tit="Nuevo" available="Y"><tab/>			<br/><tab n="2"/><txt>Producto original : </txt>			<inp id="k_clave_original" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="18" available="Y" 				OnF9="consulta_originales()" OnChange="validar_original()" tooltip="Clave del producto origen" modify="Y"/>			<sp/>			<inp id="k_descripcion" dim="50,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" type="capital" nc="30" clrBrdr="255,255,255" tooltip="Descripci&#243;n de la l&#237;nea" modify="N" available="N"/>			<br/><br/><tab/><txt>Producto reemplazo : </txt>			<inp id="k_clave_reemplazo" dim="18,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" type="capital" nc="18" available="Y" 				OnChange="validar_reemplazo" tooltip="Clave del producto origen" modify="Y"/>			<br/><tab/>			<br/>            <tab n="13"/><bot id="btn_aceptar" dim="12,0" brdr="5" text="Aceptar" OnEnter="Execute()" default="0" visible="Y" available="Y"/><br/>			<inp id="input_crud" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255" visible="N"/><tab/>									</grp><br/><br/>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,frP, accion,externo, clave_sel,sucursal_id,cve_color,resVal,straccion;            var cmdQuery,xmlRequest,ok,cuboResultados,cubo,mensajeError;			fun Main() {				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				kdb.connect();			    Inicializa();				ctlrs_off();				ctlrs_opcion();			}						fun Inicializa(){				accion = frn.param(0);				frn.set("input_crud", accion);				frn.rst("grupo_crud");				externo	= frn.param(2);                if (accion &= "NUEVO"){                    straccion = "Nuevo" ;                   }else if (accion &= "CONSULTAR"){                    straccion = "Consultar";                }else if (accion &= "MODIFICAR"){                    straccion = "Modificar";                }else if (accion &= "ELIMINAR"){                    straccion = "Eliminar";                }     								frn.setAtt("grupo_crud", "tit", straccion );				clave_sel = frn.param(1);				sucursal_id = frn.param(3);				if (accion &! "NUEVO"){					frn.set("k_clave", clave_sel);				}				}						fun ctlrs_off(){				frn.setAtt("btn_aceptar", "available", "N" );				frn.setAtt("btn_aceptar", "visible", "N" );			}							fun ctlrs_opcion(){				if (accion &= "NUEVO"){					frn.setAtt("k_clave","available","Y");					frn.setAtt("k_clave", "modify", "Y" );				    frn.set("k_titulo","Reemplazos");								}else { 					frn.setAtt("k_clave", "available", "Y" );                    frn.setAtt("k_clave", "modify", "N" );					if (accion &= "MODIFICAR") {                        frn.setAtt("grupo_crud", "available","Y");						frn.setAtt("k_descripcion", "available", "Y" );						                    }else{                        frn.setAtt("k_clave", "available","Y");                        frn.setAtt("k_clave", "modify", "N" );                        frn.setAtt("k_descripcion", "available","N");						frn.setAtt("btn_aceptar", "visible", "N" );                    }									}				if (accion &! "CONSULTAR"){					frn.setAtt("btn_aceptar", "available", "Y" );					frn.setAtt("btn_aceptar", "visible", "Y" );				}			}			fun consulta_originales() {				cmdQuery = "select c1 as clave_original, c2 as descripcion from keplersc.kdini order by c1 ";				frn.dialog("genlistafiltrosel","Refacciones",cmdQuery,"clave_original","k_clave_original","0","","N","N");			}			fun validar_reemplazo(){				var clave,total;								clave=frn.get("k_clave_reemplazo");								//Valida reemplazo como original				if (clave &! ""){					cmdQuery="SELECT count(*) as total FROM keplersc.kdini where c1='" & clave & "' "; ;					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_reemplazos_crud.validar_reemplazo()");	frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");										var resultado=getXml(cubo ,"resultado");									if(resultado &= "0"){						mensajeError = getXml(cubo ,"mensaje");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					total=getXmlAtt(cubo,"r0","total");					if(total > 0){						frn.message("El producto " & clave & " ya existe como original.","Error","Aceptar");						resVal=0;						return 0;					}				}								//Valida reemplazo ya como reemplazo				if (clave &! ""){					cmdQuery="SELECT count(*) as total FROM keplersc.kdinr where c1='" & clave & "' "; ;					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_reemplazos_crud.validar_reemplazo()");	frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");										var resultado=getXml(cubo ,"resultado");									if(resultado &= "0"){						mensajeError = getXml(cubo ,"mensaje");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						resVal=0;						return 0;					}					total=getXmlAtt(cubo,"r0","total");					if(total > 0){						frn.message("El producto " & clave & " ya existe como reemplazo.","Error","Aceptar");						return;					}				}								return 1;						}			fun validar_original(){				var clave,clave_bd,descripcion_bd;				frn.set("k_descripcion","");				clave=frn.get("k_clave_original");				if (clave &! ""){					cmdQuery="SELECT c1, c2 FROM keplersc.kdini where c1='" & clave & "' "; ;					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmdQuery,"cat_reemplazos_crud.validar_original()");	frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");										var resultado=getXml(cubo ,"resultado");									if(resultado &= "0"){						mensajeError = getXml(cubo ,"mensaje");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}					clave_bd=getXmlAtt(cubo,"r0","c1");					descripcion_bd=getXmlAtt(cubo,"r0","c2");					if(clave_bd &! clave){						frn.message("El producto " & clave & " no existe como original.","Error","Aceptar");						resVal=0;						return 0;					}else{						frn.set("k_descripcion",descripcion_bd);					}				}				return 1;			}						fun ValidarDatos(){				if (frn.get("k_clave_original") &= "") {											frn.setPos("k_clave_original");					resVal=0;					frn.message("Debe especificar la clave original.","Error","Aceptar");					return;				}				if (frn.get("k_clave_reemplazo") &= "") {											frn.setPos("k_clave_reemplazo");					resVal=0;					frn.message("Debe especificar la clave de reemplazo.","Error","Aceptar");					return;				}								validar_original();				if (resVal ==0){					return;				}				validar_reemplazo();				if (resVal ==0){					return;				}							}			fun Execute() {				resVal = 1;				ValidarDatos();				if(resVal == 0){					return;				}								var resultado_confirmacion = frn.message("¿Desea continuar?","Mensaje de Confirmacion", 2);				if (resultado_confirmacion &! 1)  {					return;				}				xmlRequest = getXml(frn.dataPag());	//				frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmdQuery="SELECT * FROM keplersc.cat_reemplazos_crud('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";				cubo = frn.lib("libGeneral.kpl","EjecutarSql",cmdQuery,"keplersc.cat_reemplazos_crud.Execute()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cuboResultados");									var resultado=getXml(cubo ,"resultado");								if(resultado &= "0"){					mensajeError = getXml(cubo ,"mensaje");					frn.message(mensajeError,"Error","Aceptar");					return;				}				var sms =  "";				sms = "Registro guardado";				frn.message(sms ,"Mensaje","Aceptar");						frn.exit();					}			}							}	</script></pag>