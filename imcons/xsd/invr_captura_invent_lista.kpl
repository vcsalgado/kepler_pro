<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Registro de Inventario"><grp brdr="0,0" clr="0,58,112" fnt="Arial,16" dim="1,-1,10,10" bclr="192,205,213" unfont="0"	OnF1="Dialog(1,invEntSalAyu)" clrBrdr="0,97,181" tit=""><br/>		<tab/><txt fnt=",22" clr="0,0,0">Registro de Inventario</txt><br/><tab/><hLine clr="0,0,0"/><br/><tab n="2"/>	<br/><tab/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="58,10,7,10" tit="Datos generales"  fnt="Arial,16"><tab/><br/>		<txt clr="0,58,112" hk="S">Sucursal</txt><tab n="2"/>		<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="60,36" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S" available="Y"/>	</grp>	<tab/>	<grp bclr="236,240,243" fntClrBrdr="236,240,243" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" brdr="0,5" dim="55,10,7,10" tit="Carga archivo csv"  fnt="Arial,16">		<br/><tab/>		<bot id="bot_cargarcsv" dim="12,0" brdr="5" text="Cargar CSV" OnEnter="CargarCSV()"/><br/>	</grp><tab/>			<br/><br/><tab/>	<grp  bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="0" clrBrdr="0,58,112" dim="115,63,7,10" brdr="1,5"  fnt="Arial,16">		<br/><txt fnt=",b">  Aplicar filtro.  </txt><tab/><txt>Estatus: </txt>		<cmb id="cmb_filtro" dim="20,1" brdr="2,0" bclr="255,255,255" clr="64,64,64" clrBrdr="255,255,255" OnChange="CargarInventarioFisico"/><tab/><br/><br/><sp/>		<tbl id="tabla" bclr="236,240,243"  clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" dim="162,30" OnChange="" Reorder="Y" fntHead=",15" insdel="N">			<col id="estatus" name="Estatus" type="string" modify="N" available="N" visible="Y"/>			<col id="producto" name="Producto"  modify="N" available="Y" visible="Y"/>			<col id="descripcion" name="Descripcion" type="string" modify="N" visible="Y" available="N" nc="20"/>						<col id="inv_teorico" name="Inv Teorico" modify="N" type="number" visible="Y" available="N"/>			<col id="costo_teorico" name="Costo Teorico" modify="N" type="number" visible="Y" available="N"/>			<col id="inv_fisico" name="Inv Fisico" modify="N" type="number" visible="Y" available="N" nd="2"/>			<col id="costo_fisico" name="C.U. Fisico" modify="N" type="number" visible="Y" available="N" nd="2"/>			<col id="costo_invent_real" name="C.T. Fisico" modify="N" type="number" visible="Y" available="N" nd="2"/>			<col id="inv_dif" name="Inv Diferencia" modify="N" type="number" visible="Y" available="N"/>			<col id="costo_dif" name="Costo Diferencia" modify="N" type="number" visible="Y" available="N"/>		</tbl>	</grp></grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb, sys, rep;			var usuario,suc_usuario, perfil_usuario,asterisco;			var monto_total,uen;			var folio, sucursal_id , cmdQuery;			var cmd, cubo, ok,resValidacion,resMensaje,mensajeError ;			fun Main() {				frn=new FRNT;				kdb=new KDB;				kdb.connect();				sys=new SYS;				rep=new REP;							suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				asterisco = "*";				Inicializa();						}			fun Inicializa(){				kdb.kde("KDE");//								Configuraci�n del servidor				kdb.exec();				usuario = frn.config("user","name");				//Llenar combo sucursales				cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"venfactdirecta.Inicializa()");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("k_sucn",getXml(cubo));								frn.setX("TODOS","cmb_filtro",0,0);				frn.setX("E","cmb_filtro",0,1);				frn.setX("ERROR","cmb_filtro",1,0);				frn.setX("ERR","cmb_filtro",1,1);				frn.setX("PENDIENTES","cmb_filtro",2,0);				frn.setX("PENDIENTE","cmb_filtro",2,1);				frn.setX("REGISTRADOS","cmb_filtro",3,0);					frn.setX("REGISTRADO","cmb_filtro",3,1);												CargarInventarioFisico();			}			fun CargarCSV(){				var cuboCsv, regs,cont,curRen,curParte,curDesc,curTeorico,curFisico,curValor,curUnitario,curPromedio;				var nTok,conTok,totRegs;				var suc = frn.get("k_sucn", -1, 1);									IniciarInventarioFisico();								var path = frn.openFile("","Archivos CSV,*.csv",sys.path(),"Ubicar el archivo CSV.");//Ruta de carpeta				rstXml(cubo);				kdb.file("dat,read,_" & path);								kdb.exec();				cuboCsv=getXml(kdb.get("dat"));frn.lib("libGeneral.kpl","FileSave",cuboCsv,"C:\Basura\cuboCSV");				regs=nXml(cuboCsv);								for (cont=1; cont<regs; cont++){					curRen=getXml(cuboCsv,"r"&cont);					nTok= strSplit(curRen,",",-1);					if (nTok==6){//						frn.message(curRen,nTok,"Aceptar");						curParte=strSplit(curRen,",",0);						if (curParte &= ""){							continue;						} 						curDesc=strSplit(curRen,",",1);						curTeorico=strSplit(curRen,",",2);						curFisico=strSplit(curRen,",",3);						curUnitario=strSplit(curRen,",",4);						curPromedio=strSplit(curRen,",",5);						//Insertar registro de parte si no se tiene												cmd="select count(*) as totReg from keplersc.kdifis where c1='" & suc & "' and c2='" & curParte & "'";						rstXml(cubo);						cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_captura_invent_lista.CargarCSV");						frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTotResIfis");										ok=getXmlAtt(cubo,"ok");						if(ok &! "" && !ok){							mensajeError = getXmlAtt(cubo,"native3");							frn.message(mensajeError,"Error","Aceptar");							return;						}												totRegs=getXmlAtt(cubo,"r0","totreg");												if (totRegs==0){							//Verificar si existe en catalogo y tiene estadistica							cmd="select count(*) as totReg from keplersc.kdinl where c1='" & suc & "' and c2='" & curParte & "'";							rstXml(cubo);							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_captura_invent_lista.CargarCSV");							frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboTotResInl");											ok=getXmlAtt(cubo,"ok");							if(ok &! "" && !ok){								mensajeError = getXmlAtt(cubo,"native3");								frn.message(mensajeError,"Error","Aceptar");								return;							}							totRegs=getXmlAtt(cubo,"r0","totreg");							if (totRegs==1){								//Existe en estadistica, se puede agregar								cmd="insert into keplersc.kdifis "; 								cmd= cmd & "select inl.c1,inl.c2,coalesce(ini.c2,''),'1800-01-01 00:00:00','',0,0,coalesce(ini.c19,''),0,0,0,inl.c5-inl.c6,inl.c8-inl.c9,0, "; 								cmd= cmd & "case when coalesce(ini.c2,'')='' then 'ERR:NO EXISTE' else 'PENDIENTE' end ";								cmd= cmd & "from keplersc.kdinl inl "; 								cmd= cmd & "left outer join keplersc.kdini ini on ini.c1=inl.c2 ";								cmd= cmd & "where inl.c2='" & curParte& "'";								rstXml(cubo);								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_captura_invent_lista.CargarCSV()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboInvFis");												ok=getXmlAtt(cubo,"ok");								if(ok &! "" && !ok){									mensajeError = getXmlAtt(cubo,"native3");									frn.message(mensajeError,"Error","Aceptar");									return;								}																						}else{								cmd="insert into keplersc.kdifis (c1,c2,estatus) values('" & suc & "', '" & curParte & "', 'ERR:NO EXISTE')" ;								rstXml(cubo);								cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_captura_invent_lista.CargarCSV()");								frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboInvFis");												ok=getXmlAtt(cubo,"ok");								if(ok &! "" && !ok){									mensajeError = getXmlAtt(cubo,"native3");									frn.message(mensajeError,"Error","Aceptar");									return;								}							}							}												//Actualizar regsitro						if (totRegs==1){							cmd="update keplersc.kdifis set c6=" & curFisico & ", c7=" & curUnitario & ", costo_invent_real=" & curPromedio & ", c9=" & curFisico & " - cantidad_sis" & ", ";							cmd=cmd & "c10=" & curPromedio &  " - costo_invent_sis, estatus='REGISTRADO' ";								cmd=cmd & "where c1='" & suc & "' and c2='" & curParte & "' ";							rstXml(cubo);							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_captura_invent_lista.CargarCSV()");							frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboInvFis");											ok=getXmlAtt(cubo,"ok");							if(ok &! "" && !ok){								mensajeError = getXmlAtt(cubo,"native3");								frn.message(mensajeError,"Error","Aceptar");								return;							}						}											}else{						if (nTok > 1){							cmd="insert into kplersc.kdifis (c1,c2,c3,estatus) values('" & suc & "', '" & curParte & "','" & curRen& "','ERR:FORMATO NO VALIDO'" ;							rstXml(cubo);							cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_captura_invent_lista.CargarCSV()");							frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboInvFis");											ok=getXmlAtt(cubo,"ok");							if(ok &! "" && !ok){								mensajeError = getXmlAtt(cubo,"native3");								frn.message(mensajeError,"Error","Aceptar");								return;							}													}else{							//Ignorar, es fin de archivo						}					}				}									CargarInventarioFisico();			}			fun IniciarInventarioFisico(){				cmd="truncate table keplersc.kdifis";				rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_captura_invent_lista.IniciarInventarioFisico()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboInvFis");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}											cmd="insert into keplersc.kdifis "; 				cmd= cmd & "select inl.c1,inl.c2,coalesce(ini.c2,''),'1800-01-01 00:00:00','',0,0,coalesce(ini.c19,''),0,0,0,inl.c5-inl.c6,inl.c8-inl.c9,0, "; 				cmd= cmd & "case when coalesce(ini.c2,'')='' then 'ERR:NO EXISTE' else 'PENDIENTE' end ";				cmd= cmd & "from keplersc.kdinl inl "; 				cmd= cmd & "left outer join keplersc.kdini ini on ini.c1=inl.c2 ";				cmd= cmd & "where inl.c5-inl.c6 <> 0 or inl.c8-inl.c9 <> 0 ";				rstXml(cubo);				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_captura_invent_lista.IniciarInventarioFisico()");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboInvFis");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}							}						fun CargarInventarioFisico(){				var filtro,suc;				filtro=frn.get("cmb_filtro", -1, 1);				suc = frn.get("k_sucn", -1, 1);								cmd="select ifis.estatus, "; 				cmd=cmd & "ifis.c2 as producto, ifis.c3 as descripcion, ifis.cantidad_sis as inv_teorico, ifis.costo_invent_sis as costo_teorico, "; 				cmd=cmd & "ifis.c6 as inv_fisico, ifis.c7 as costo_fisico, ifis.costo_invent_real, ifis.c9 as inv_dif, ifis.c10 as costo_dif, ";				cmd=cmd & "ini.c1 as prod_ini ";				cmd=cmd & "from keplersc.kdifis ifis left outer join keplersc.kdini ini on ini.c1 = ifis.c2 ";				cmd=cmd & "where ifis.c1='" & suc & "' and ifis.estatus like '%" & filtro & "%' order by ifis.c2";											cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"invr_captura_invent_lista.CargarCSV");frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboInvFis");								ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								frn.set("tabla",getXml(cubo));							}								}	</script></pag>