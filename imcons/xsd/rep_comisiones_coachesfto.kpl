<?xml version="1.0" encoding="UTF-8"?>
<pag xmlns='www.kepler.com.mx/2003/KSchema' tit='Orden' scale="48">
<grp dim='1,-1,10,20' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">
<br/>
	<grp dim="15,8,7,12"><sp/>
		<img id="img"  dim="14,80" brdr="0,1" img="logocliente.jpg"/>
	</grp>
	<grp dim="40,8,7,1">
		<inp id="titulo"  dim="50,1" brdr="0,1" type="string" fnt="Arial,30b"/><br/><tab n="4"/><sp/>
		<br/>
		<txt fnt="Arial,18">Sucursal:</txt>
		<inp id="suc_desc"  just="L" dim="60,1" brdr="0,1" type="string" fnt="Arial,17" nc="20"/><br/>
	</grp>
	
	<tab n="15"/>
	<grp id="tipo" dim="20,5,7,2"><br/>
		<sp/><txt>Fecha:</txt>
			<tab n="2"/><inp id="rep_fecha" dim="20,1" brdr="0,1" type="date" fnt="Arial,15" fmt="DD/MM/CCYY" nc="-1"/><br/>
			<br/><br/>
		<sp/><txt>Hora:</txt>
			<tab n="2"/><inp id="rep_hora" dim="20,1" brdr="0,1" type="string" fnt="Arial,15"  nc="-1"/><br/><br/><br/>
		<sp/><txt>Pagina:</txt><tab n="2"/><inp id="k_pag" dim="4,1" type="number" just="L" mcr="k_pag"/>
		
	</grp>
	<br exe="encabezado"/>

<grp dim='100,5,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">
	<br/>
	<tab n="5"/><txt fnt="Arial,18b">REPORTE DE COMISIONES PARA EL COACH</txt>
	<inp id="coach"  dim="50,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>
	<br/>
	<tab n="7"/><txt fnt="Arial,18b">ENTRE </txt>
	<inp id="fecha_1"  dim="8,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>
	<tab n="1"/><txt fnt="Arial,18b">Y </txt>
	<inp id="fecha_2"  dim="8,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/>
</grp>
<br exe="encabezado"/>


<tab n="18"/><sp n="4"/><txt>Objetivo</txt><sp/><tab n="3"/><txt>Real</txt><sp/><tab n="2"/><txt>Porcentaje</txt><sp/><tab n="2"/>
<sp n="1"/><txt>Bono</txt><sp/><tab n="2"/><sp n="1"/><txt>Descuento</txt><sp n="3"/><txt>Comision</txt>

<br exe="encabezado"/><hLine dim="120,0" g="2"/><br exe="encabezado"/>

<br/>
<br/>


<grp dim='140,5,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">
	<br/>
	<tab n="2"/><txt fnt="Arial,16b">Utilidad Bruta de Autos Nuevos sin PVA:</txt>
	<sp/><inp id="utilidad_bruta_nuevos_sin_pva"  type="number" nd="2" dim="8,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/>
	<tab n="2"/><txt fnt="Arial,16b">Utilidad Bruta de Autos Seminuevos sin PVA:</txt>
	<sp/><inp id="utilidad_bruta_seminuevos_sin_pva"  type="number" nd="2" dim="8,1" brdr="0,1" bclr="255,255,255" fnt="Arial,15b"/><br/><br/>
	
</grp>
<br exe="utilidad_bruta"/>

<grp dim='180,2,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">

<sp/><inp id="desc"  dim="50,1" brdr="0,1" bclr="255,255,255" fnt="Arial,16b"/>

<sp/>
<inp id="objetivo"  dim="10,1" brdr="0,1" type="number" nd="2" bclr="255,255,255" fnt="Arial,16b"/>
<tab n="2"/>
<inp id="real"  dim="9,1" brdr="0,1" type="number" nd="2" bclr="255,255,255" fnt="Arial,16b"/>
<sp/>

<inp id="porcentaje"  dim="9,1" brdr="0,1" type="number" nd="2" bclr="255,255,255" fnt="Arial,16b"/>
<sp n="4"/>

<inp id="bono"  dim="9,1" brdr="0,1" type="number" nd="2" bclr="255,255,255" fnt="Arial,16b"/>
<sp/>

<inp id="descuento"  dim="9,1" brdr="0,1" type="number" nd="2" bclr="255,255,255" fnt="Arial,16b"/>
<sp/> 

<inp id="comision"  dim="9,1" brdr="0,1" type="number" nd="2"  bclr="255,255,255" fnt="Arial,16b"/>
<sp/>


</grp>

<br exe="datos"/>







<grp dim='150,7,10,10' brdr='0,1' clr='0,0,0' bclr='255,255,255' fnt="Arial,15b" unfont="0">

<tab n="21"/><sp/><txt>TOTAL DE COMISIONES</txt>


<tab n="4"/><sp n="2"/>
<inp id="bonos_total"  dim="6,1" brdr="0,1" type="number" nd="2" bclr="255,255,255" fnt="Arial,15b"/>

<tab n="5"/><sp/>
<inp id="comision_total"  dim="6,1" brdr="0,1" type="number" nd="2" bclr="255,255,255" fnt="Arial,15b"/>


</grp>

<br exe="comision_totales"/>

<br/>
	
</grp>
</pag>