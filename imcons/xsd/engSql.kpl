<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Direct SQL Query execution" roles="">	<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" clrBrdr="0,97,181" bclr="192,205,213" unfont="0" dim="1,-1,10,20" tit="Direct SQL Query execution"><br/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="84,19,7,12" tit="Query and Parameters"><tab/><txt>SQL Statement:</txt><br/><tab/>			<inp clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" id="query" dim="115,7" type="string" OnF9="Dialog(sysQueryFactS,query)" OnF5="Execute()"/><br/><tab/><txt>Native SQL Statement?</txt><tab/>			<chck clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" id="NativeStatement" dim="2,16" YN="10"/><tab n="4"/><txt dim="20">Execute on System Data Source?</txt><tab/>			<chck clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" id="System" dim="2,16" YN="10" tooltip="Executes the SQL statement on the SYS datasource"/><br/><tab/><txt>Visualiza Raw Data?</txt><tab/>			<chck clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" id="ViewRawData" dim="2,16" YN="10"/><tab n="4"/><txt dim="25">Debug SQL</txt><tab n="2"/>			<chck clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" id="Debug" dim="2,16" YN="10" tooltip="Executes the SQL statement on the SYS datasource"/><sp/>			<br/><tab/><br/>		</grp><br/><br/><tab n="25"/><img bPx="Y" id="bot" dim="60,60" available="Y" img="_60_Execute.png" OnEnter="Execute()" tooltip="Execute" hk="t"/><br/><br/>		<grp brdr="0,0" clr="0,58,112" fnt="Arial,16" clrBrdr="0,97,181" bclr="192,205,213" unfont="0"  dim="84,30,7,12" tit="Results"><br/><tab/>			<tbl clr="64,64,64" clrBrdr="255,255,255" bclr="255,255,255" brdr="2,0" id="results" dim="115,18" modify="N" nren="fijo" Reorder="Y">				<col name="C1" id="c1"/>				<col name="C2" id="c2"/>			</tbl>		</grp><br/>	</grp>		<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,sys,cubo;			fun Main() {				frn=new FRNT;				kdb=new KDB;				sys=new SYS;				kdb.connect();				cubo="dat";				frn.set("query","SELECT * FROM keplersc.kdms LIMIT 100");				Encabezados();			}						fun Execute(){				kdb.rst();				frn.rst("results");				var cmd=frn.get("query");				cmd = delScpScn(cmd);				if(frn.get("NativeStatement")){//Native DBMS query.					kdb.native(cmd,cubo);				}else{					var src=frn.get("System")?"src:sys":"";					var debug=frn.get("Debug")?"debugSQL:Y":"";					kdb.stmt(cmd,cubo,src,debug);				}								var okCnc=kdb.exec();								if(!okCnc){					frn.message("Error al intentar ejecutar la transacción","Sin conexión","&Accept");					kdb.connect();				}else{					FileSave(kdb.get(cubo),"D:\Basura\xmlCubo"); //VCSS					var ok=kdb.get(cubo,"ok");					if(ok &! "" && !ok){						var err=kdb.get(cubo,"err"),ierr=kdb.get(cubo,"ierr"),mssg=kdb.get(cubo,"mssg");						var native1=kdb.get(cubo,"native1"),native2=kdb.get(cubo,"native2"),native3=kdb.get(cubo,"native3");						frn.message("The following error occurred:" & "'" & mssg & "'|" & err & "|" & ierr & "|" & native1 & "|" & native2 & "|" & native3 & "|" ,"Error","&Accept");						return;					}					else					{						var resultado=kdb.get(cubo,"r0","resultado");						var cres = strSplit(resultado,"|",0);						var cdet = strSplit(resultado,"|",1);						if(cres &= "OK"){							frn.message("Resultado: " &  cdet, "Resultado","&Accept");						}else{							frn.message("Error: " &  cdet, "Error","&Accept");							}											}						}								FileSave(kdb.get(cubo),"D:\Basura\cuboUtil"); //VCSS				Encabezados();				frn.set("results",kdb.get(cubo));			}						fun Encabezados(){				frn.rst("results");				var colIds=kdb.get(cubo,"k_ColName");				if(colIds &! ""){					frn.setX(colIds,"results","k_ColName");//Special "atributes" that change grid columns.					frn.setX(kdb.get(cubo,"k_ColType"),"results","k_ColType");					frn.setX(kdb.get(cubo,"k_ColNd"),"results","k_ColNd");				}			}			fun Dialog(pag,prm0,prm1,prm2,prm3,prm4,prm5,prm6,prm7,prm8,prm9,prm10){				frn.dialog(pag,prm0,prm1,prm2,prm3,prm4,prm5,prm6,prm7,prm8,prm9,prm10);			}									fun Exec(dat1,dat2,dat3,dat4,dat5,dat6,dat7,dat8,dat9,dat10){				var okCnc=kdb.exec();				if(!okCnc){					frn.message("Server not found/Connection Lost|An attempt will be made to reestablish the connection.|Please try again","Connection Lost","&Accept");					kdb.connect();				}else{					var datSets;					if(dat1 &! "")setXml(datSets,"r" & nXml(datSets),dat1); if(dat2 &! "")setXml(datSets,"r" & nXml(datSets),dat2);					if(dat3 &! "")setXml(datSets,"r" & nXml(datSets),dat3); if(dat4 &! "")setXml(datSets,"r" & nXml(datSets),dat4);					if(dat5 &! "")setXml(datSets,"r" & nXml(datSets),dat5); if(dat6 &! "")setXml(datSets,"r" & nXml(datSets),dat6);					if(dat7 &! "")setXml(datSets,"r" & nXml(datSets),dat7); if(dat8 &! "")setXml(datSets,"r" & nXml(datSets),dat8);					if(dat9 &! "")setXml(datSets,"r" & nXml(datSets),dat9); if(dat10 &! "")setXml(datSets,"r" & nXml(datSets),dat10);					for(var i=0,n=nXml(datSets);i<n;i++){						var dati=getXml(datSets,"r"&i);						var ok=kdb.get(dati,"ok");						if(ok &! "" && !ok){							var err=kdb.get(dati,"err"),ierr=kdb.get(dati,"ierr"),mssg=kdb.get(dati,"mssg");							var native1=kdb.get(dati,"native1"),native2=kdb.get(dati,"native2"),native3=kdb.get(dati,"native3");							frn.message("The following error occurred:" & "'" & mssg & "'|" & err & "|" & ierr & "|" & native1 & "|" & native2 & "|" & native3 & "|" ,"Error","&Accept");							return 0;						}					}				}				return okCnc;			}						fun FileSave(xmlVar,FileName){//Lectura/escritura				var documentXml = getXmlStr(xmlVar,"EOF:13_10")				kdb.save("_"&FileName&".txt",documentXml);			}						}				</script></pag>