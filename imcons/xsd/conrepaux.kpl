<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" tit="Reporte Auxiliar">	<grp dim="1,-1,10,20" brdr="0,0" bclr="192,205,213" clr="0,58,112" fnt="Arial,16" unfont="0" OnF1="Ventana(rep_Hlp)">	<tab n="1"/>	<txt fnt=",22" clr="0,0,0">Reporte Auxiliar</txt><br/><tab/>	<hLine dim="0,1" clr="0,0,0"/> 	<br/> 	<br/><tab n="1"/>		<grp dim="40,30,10,5" bclr="255,255,255" tit="Reporte Auxiliar" brdr="0,5" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">			<tab/><txt>Cuenta incial</txt><tab n="2"/>						<edt id="cta_ini" clr="64,64,64" clrBrdr="255,255,255"  dim="22,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" OnF9="Ventana(concatcuebus,cta_ini)" page="concatcuebus,cta_ini" OnF10="Ventana(concatcuepag,cta_ini,,10010)" type="capital"/>			<br/><tab/><txt>Cuenta final</txt><tab n="2"/>			<edt id="cta_fin" clr="64,64,64" clrBrdr="255,255,255"  dim="22,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" OnF9="Ventana(concatcuebus,cta_fin)" page="concatcuebus,cta_fin" OnF10="Ventana(concatcuepag,cta_fin,,10010)" type="capital"/>						<br/>			<grp dim="30,10,10,5" bclr="255,255,255" tit="" brdr="0,0" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">        				<tab/><txt>Fecha inicial</txt><tab n="2"/>				<edt id="fecha_ini" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnButton="Dialog(0,_ks_fecha,fecha_ini)" nc="11" OnChange="AjustaFechaFin(I)"/>				<br/><tab/><txt>Fecha final</txt><tab n="2"/>				<edt id="fecha_fin" dim="14,1" fmt="DD/MM/CCYY" clr="64,64,64" clrBrdr="255,255,255"  bclr="255,255,255" brdr="2,0" fnt="Arial,16" type="date" OnButton="Dialog(0,_ks_fecha,fecha_fin)" nc="11" OnChange="AjustaFechaFin(F)"/>			</grp>			<tab/>							<grp dim="10,10,10,5" bclr="255,255,255" tit="" brdr="0,0" clrBrdr="0,58,112" fntClrBrdr="255,255,255" fntBrdr="Arial,18" hSpace="4">										<img id="Imprimir" dim="40,40" bPx="Y" brdr="0,1"  img="_60_Print.png" OnEnter="Ejecuta()"  available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>			</grp>			<br/><br/>			<txt clr="249,35,3">* Consultar rangos cortos de cuentas</txt>		</grp>			</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,kdb,rep,sys, year;						fun Main() {				frn=new FRNT;				kdb=new KDB;				rep=new REP;				sys=new SYS;				kdb.connect();				kdb.open("i,kdini");				Inicializa();			}				fun AjustaFechaFin(origen){				var fecha_ini, fecha_fin, dif, mes_fin, mes_ini, anio_ini, anio_fin;				fecha_ini = frn.get("fecha_ini");				fecha_fin=frn.get("fecha_fin");				mes_ini = mid(fecha_ini,5,2);				mes_fin = mid(fecha_fin,5,2);				anio_ini = mid(fecha_ini,2,2);				anio_fin = mid(fecha_fin,2,2);												dif=fnDate("dif",fecha_fin,fecha_ini);				if (origen&="I"){						frn.set("fecha_fin",sys.date(anio_ini,mes_ini,31));				}else{					if (dif < 0){						frn.set("fecha_fin",sys.date(anio_ini,mes_ini,31));										}						}			}						fun valida(){				var cta_ini, cta_fin, cubo, ok, cmd, mensajeError, fecha_ini, fecha_fin, mes_fin, mes_ini, anio_ini, anio_fin;				cta_ini= frn.get("edt_prod_ini", -1, 0);				cta_fin= frn.get("edt_prod_fin", -1, 0);				fecha_ini = frn.get("fecha_ini");				fecha_fin = frn.get("fecha_fin");				cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"vcssprod.Ejecuta()");				ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cubo,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}				mes_ini = mid(fecha_ini,5,2);				mes_fin = mid(fecha_fin,5,2);				anio_ini = mid(fecha_ini,2,2);				anio_fin = mid(fecha_fin,2,2);								if(anio_fin&!anio_ini){					frn.message("El año de ambas fechas es diferente se mostraran resultados solo del mes " & fecha_ini,"Error","Aceptar");					frn.set("fecha_fin",sys.date(anio_ini,mes_ini,31));				}			}			fun Inicializa(){//Inicializa los valores en Pantalla				if(frn.config("temp","k_workDate")){					year=mid(frn.config("temp","k_workYear"),2,2);				}else {					kdb.kde("yr");kdb.exec();					year=kdb.get("yr",14);				}					frn.set("fecha_ini",sys.date(year,sys.date("month"),1));				frn.set("fecha_fin",sys.date(year,sys.date("month"),31));                				//... (Llena Combos, e inputs en pantalla)				IniParams();//Inicializa parï¿½mtros de impresiï¿½n entre otros				IniCombos();			}									fun IniCombos(){				var cmd, cuboQuery, ok, mensajeError;								frn.set("cmb_sucursal",cuboQuery);												//Llenar combos de productos				kdb.search("datosI,i,1,7,&,i1");				kdb.search("datosF,i,1,8,&,i1");				kdb.exec();				frn.set("edt_prod_ini",kdb.get("datosI","i1"));				frn.set("edt_prod_fin",kdb.get("datosF","i1"));				kdb.open("c,kdc1" & year);								kdb.search("ctaini,c,1,7,&,c1");				kdb.search("ctafin,c,1,8,&,c1");				kdb.exec();				frn.set("cta_ini",kdb.get("ctaini","c1"));				frn.set("cta_fin",kdb.get("ctafin","c1"));				//frn.lib("libGeneral.kpl","FileSave",kdb.get("datalm"),"C:\Basura\datalm");											}						fun Ejecuta(){//Prepara datos del reporte 				Reporte();			}						fun Reporte(){//Ejecuta el Reporte				valida();				// Se define el formato a usar y se liga a la variable del reporte "rep"				var clave_producto, descripcion, diferencia;				var fecha_ini, fecha_fin, cubo, ok, cmd, mensajeError, mes_saldo_ini, cadena_saldo_ini, t_kdc1, t_kdc2, cta_ini, cta_fin; //variables de calculos locales				var compania, usuario, strValor, fechaImpresion, horaImpresion;				var xmlRequest, tmpCubo, cuboCuentas;				var cuenta_ant;				var k_numero_cuenta, k_desc_cuenta, k_saldo_ini; // variables de kdc1				var k_tipo_poliza, k_n_poliza, k_fecha_poliza, k_ref_poliza, k_suc_poliza, k_folio_poliza, k_monto, k_desc_poliza; // variables de kdc2				var k_desc_mov, k_usuario, k_saldo, k_debe, k_haber, k_saldo_fin; 				var k_cargo_abono, k_suma_cargo, k_suma_abono, k_suma_saldo; //variables de calculos locales				kdb.readPage("datFto","conRepAuxfto.kpl");				kdb.exec();				rep.source(kdb.get("datFto")); 				fecha_ini = frn.get("fecha_ini");				fecha_fin = frn.get("fecha_fin");				cta_ini = frn.get("cta_ini",-1,0);				cta_fin = frn.get("cta_fin");				setXml(xmlRequest,"document","fecha_ini",fecha_ini);				setXml(xmlRequest,"document","fecha_fin",fecha_fin);				setXml(xmlRequest,"document","cta_ini",cta_ini);				setXml(xmlRequest,"document","cta_fin",cta_fin);frn.lib("libGeneral.kpl","FileSave",xmlRequest,"C:\Basura\xmlRequest");																cmd="select * from keplersc.cont_rep_auxiliar_sel('" & getXmlStr(xmlRequest,"EOF:13_10") & "')";					cuboCuentas= frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"conrepaux.Reporte()");				ok=getXmlAtt(cuboCuentas,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboCuentas,"native3");					mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);					frn.message(mensajeError,"Error","Aceptar");					return;				}//frn.lib("libGeneral.kpl","FileSave",cuboCuentas,"C:\Basura\xmlRepAux");				rstXml(tmpCubo);				var strTmp=getXmlAtt(cuboCuentas,"r0","cont_rep_auxiliar_sel");				strTmp= delScpScn(strTmp);				setXmlStr(tmpCubo,strTmp);				frn.setX(tmpCubo);				rstXml(cubo);								cubo=frn.lib("libGeneral.kpl","FormateaXmlNoRowId",tmpCubo,"r","datos");				frn.lib("libGeneral.kpl","FileSave",cubo,"C:\Basura\cuboReporteFmt");								rep.rst();				setRepPage();//Establece los parï¿½metros finales de impresiï¿½n(rep.page(...);), pues pueden haber cambiado por el usuario 				//Da valor a los inputs del reporte(rep.set();), e indica la ejecuciï¿½n de "grupos de renglones de impresiï¿½n" (rep.exe();)				rep.set("fecha",sys.date());rep.set("hora",sys.time());				rep.set("k_fecha_ini",fecha_ini);				rep.set("k_fecha_fin",fecha_fin);				rep.set("k_empresa",compania);				rep.set("k_sucursal",frn.get("cmb_sucursal",-1,0)); 				rep.set("k_fecha",frn.get("edt_fecha"));				rep.set("k_fecha_imp",fechaImpresion);				rep.set("K_hora_imp",horaImpresion);				kdb.kde("KDE");//Configuraciï¿½n del servidor				kdb.exec();				compania = kdb.get("KDE","1");				usuario = kdb.get("KDE","14");				strValor = sys.date();					fechaImpresion = sys.date();				horaImpresion = sys.time();								cuenta_ant="";				rep.exe("encabezado");				var cont,cuboDet;				cuboDet=getXml(cubo,"datos");				cont=nXml(cuboDet);				for(var ren=0;ren<cont;ren++){					k_numero_cuenta =  getXml(cubo,"datos","r"&ren,"k_numero_cuenta");					k_desc_cuenta = getXml(cubo,"datos","r"&ren,"k_desc_cuenta");					k_tipo_poliza = getXml(cubo,"datos","r"&ren,"k_tipo_poliza");					k_n_poliza = getXml(cubo,"datos","r"&ren,"k_n_poliza");					k_fecha_poliza = getXml(cubo,"datos","r"&ren,"k_fecha_poliza");					k_ref_poliza = getXml(cubo,"datos","r"&ren,"k_ref_poliza");					k_suc_poliza = getXml(cubo,"datos","r"&ren,"k_suc_poliza");					k_folio_poliza = getXml(cubo,"datos","r"&ren,"k_folio_poliza");					k_desc_poliza = getXml(cubo,"datos","r"&ren,"k_desc_poliza");					k_debe = getXml(cubo,"datos","r"&ren,"k_cargo");					k_haber = getXml(cubo,"datos","r"&ren,"k_abono");					k_saldo_ini = getXml(cubo,"datos","r"&ren,"k_saldo_ini");					k_saldo_fin = getXml(cubo,"datos","r"&ren,"k_saldo_fin");					k_usuario = getXml(cubo,"datos","r"&ren,"k_usuario");					k_desc_mov = getXml(cubo,"datos","r"&ren,"k_desc_mov");										if (cuenta_ant &! k_numero_cuenta){						if(cuenta_ant &! ""){							rep.set("k_suma_cargo",k_suma_cargo);							rep.set("k_suma_abono",k_suma_abono);							rep.set("k_suma_saldo",k_suma_saldo);							rep.exe("detalle_fin");						}						cuenta_ant = k_numero_cuenta;						rep.set("k_numero_cuenta",k_numero_cuenta);						rep.set("k_desc_cuenta",k_desc_cuenta);						rep.set("k_saldo_ini",k_saldo_ini);												rep.exe("encabezado_cuenta");						k_suma_cargo=0;						k_suma_abono=0;						k_suma_saldo=0;							continue;					}					rep.set("k_tipo_poliza",k_tipo_poliza);					rep.set("k_n_poliza",k_n_poliza);					rep.set("k_fecha_poliza",k_fecha_poliza);					rep.set("k_ref_poliza",k_ref_poliza);					rep.set("k_suc_poliza",k_suc_poliza);					rep.set("k_folio_poliza",k_folio_poliza);					rep.set("k_desc_poliza",k_desc_poliza);					rep.set("k_desc_mov",k_desc_mov);					rep.set("k_usuario",k_usuario);					rep.set("k_debe",k_debe);					rep.set("k_haber",k_haber);					rep.set("k_saldo_fin",k_saldo_fin);					k_suma_cargo=k_suma_cargo + k_debe;					k_suma_abono=k_suma_abono + k_haber;					k_suma_saldo=k_saldo_fin;						rep.exe("detalle");				}					if (k_numero_cuenta &! ""){						rep.set("k_suma_cargo",k_suma_cargo);						rep.set("k_suma_abono",k_suma_abono);						rep.set("k_suma_saldo",k_suma_saldo);						rep.exe("detalle_fin");				}												//Modos de impresiï¿½n 				rep.win(); //Muestra la vista previa de la impresiï¿½n. A partir de la vista previa (Preprint) se decide si se imprime o no.				//rep.print("\\192.168.1.100\HPLaserJet"); //Envï¿½a el reporte directamente a una impresora, sin mostrar la vista previa.				//frn.dialog("_ks_printdlg"); //Permite seleccionar impresora destino y manda el reporte a impresiï¿½n. No muestra la vista previa.				//rep.export("file:Reportes\\reporteHTML.html","format:html","inputs:N");//Guardarï¿½ el reporte en la carpeta local k80\Reportes, con el nombre reporteHTML.html			}//-------------------------------------------------------------------------fuciones dependencias del reporte----------------------------------------------------------------------------			fun setRepPage() {//Establece los parï¿½metros finales de impresiï¿½n.				var paper="paper=" & frn.get("param_paper");var size="size=" & frn.get("param_sizeX") & "," & frn.get("param_sizeY") & "cm";				var brdr="border=" & frn.get("param_borderL") & "," & frn.get("param_borderT") & "," & frn.get("param_borderR") & "," & frn.get("param_borderB") & "cm";				var fact="F=" & frn.get("param_Fx") & "," & frn.get("param_Fx");				var lndsp="landscape=" & frn.get("param_landscape");				var emp="@emp=" & frn.get("param_emp");				rep.page(paper,size,brdr,fact,lndsp,"color=Y","collate=Y","copies=1","pages=1,999","prompt=N",emp);			}			fun CombinaCombo(combo,colClave,colDesc,posFinal){//Combina el contenido de 2 columnas de un combo y lo pone en la columna visble. Ej: para mostrar "Clave - Descripciï¿½n". 				//NOTA: Por default posiciona el combo con el primer elemento. Se puede pasar como parametro "posicionaFinal" un 1 para que se posicione en el ultimo registro				var clavecombinada="";				for(var i=0,n=frn.N(combo);i<n;i++){					clavecombinada=frn.get(combo,i,colClave) & " - " & frn.get(combo,i,colDesc);					frn.setX(clavecombinada,combo, i, 0);				}				if(posFinal==1&&frn.N(combo)>0) frn.setPos(combo,frn.N(combo)-1,0,"internal:Y");//Lo posiciona en el ï¿½ltimo renglon				else frn.setPos(combo,0,0,"internal:Y"); 			}						fun Ventana(arch,cmp0,cmp1,cmp2,cmp3,cmp4,cmp5,cmp6,cmp7,cmp8,cmp9){ //Abre pagina indicada como dialogo SOLO si el campo cmp0 se puede modificar(El cmp0 puede ser una tabla, y cmp1 la columna)				var b_valido=1;				if(strlen(cmp0)>0){//Se toma el cmp0 como el objeto (o grid) al que se devolverï¿½ el resultado.					if( frn.getAtt(cmp0,"modify",cmp1) &= "N" ) b_valido=0;					if( frn.getAtt(cmp0,"available",cmp1) &= "N" ) b_valido=0;					if( frn.getAtt(cmp0,"visible",cmp1) &= "N" ) b_valido=0;				}				if(b_valido==1)frn.dialog(arch,cmp0,cmp1,cmp2,cmp3,cmp4,cmp5,cmp6,cmp7,cmp8,cmp9);			}            fun IniParams(){//Inicializa parï¿½metros de impresiï¿½n. Pueden ser cambiados por el usuario final mediante menï¿½: Archivo -> Configurar Pï¿½gina				frn.set("param_paper","letter");	//Tamaï¿½o de papel predefinido:	"paper=letter|legal|size"				frn.set("param_sizeX","21.59","param_sizeY","27.94");	//Tamaï¿½o de papel personalizado	"size=21.59,27.94cm"				frn.set("param_borderL","1.5","param_borderT","1.5","param_borderR","1.5","param_borderB","1.5");	//Mï¿½rgenes Izq,Arr,Der,Aba:	"border=1.5,1.5,1.5,1.5cm"				frn.set("param_Fx","1.0");	//Escala de impresiï¿½n (1=100 por ciento)	"F=1,1"				frn.set("param_landscape","N");	//Orientaciï¿½n	de la hoja (Vertical="N", Horizontal="Y")	"landscape=N|Y"				frn.set("param_emp","L");	//Posiciï¿½n de "Razï¿½n social"(izq,der,cen)	@emp=L|R|C"			}		}	</script></pag>