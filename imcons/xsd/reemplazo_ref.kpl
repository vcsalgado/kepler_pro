<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Reemplazo refaccion"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab/>		<grp bclr="236,240,243" fntClrBrdr="255,206,0" unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="82,50,10,10" brdr="0,5" tit="Reemplazo refaccion" fnt="Arial,16">		<tab n="1"/><inp id="k_F0" clr="64,64,64"  dim="12,1" available="N" type="string" fnt="Arial,16">Clave Original:</inp>				<inp id="input_clave_original" dim="10,1" brdr="2,0" clr="64,64,64" bclr="255,255,255" clrBrdr="255,255,255"/><sp n="2"/>				<img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/>	<br/>			<tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" OnEnter="Exit" OnMouseD="Exit" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16"  dim="76,22" modify="N" nren="fijo">		<col id="reemplazo" name="Reemplazo"/>		<col id="fecha" name="Fecha"/>		</tbl> 		<tab n="7"/>		<br/>				</grp>		</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys, externo ;			fun Main(){				frn=new FRNT;				kdb=new KDB;				frP=new FRNTP;				sys=new SYS;				kdb.connect();						externo = frn.param(0);						Inicializa();								if (externo &= "s"){					Buscar();				}									}						fun Inicializa(){							if (externo &= "s"){									var clave_producto = frP.get("k_mov",-1,"k_parte");										frn.set("input_clave_original",clave_producto);					}									}						fun Buscar() {							var xmlRequest,cmd,ok,cubo, totremp , contremp, ref_clave, ref_desc;						var clave_original = frn.get("input_clave_original");								setXml(xmlRequest ,"clave_original", clave_original);								frn.lib("libGeneral.kpl","FileSave",xmlRequest ,"C:\Basura\xmlRequest ");						cmd="SELECT * FROM keplersc.reemplazo_prod('<document>" & getXmlStr(xmlRequest ,"EOF:13_10") & "</document>')";					cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"reemplazo_prod.Buscar()");					frn.lib("libGeneral.kpl","FileSave",cubo ,"C:\Basura\cubo");													ok=getXmlAtt(cubo,"ok");				if(ok &! "" && !ok){					var mensajeError = getXmlAtt(cubo,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}												cubo = getXmlAtt(cubo ,"r0","reemplazo_prod");				cubo = delScpScn(cubo);								var xml_filtrado;				setXmlStr(xml_filtrado,cubo);								frn.lib("libGeneral.kpl","FileSave",xml_filtrado,"C:\Basura\xmlcubo");								totremp = nXml(xml_filtrado);							frn.rst("tabla");				for (contremp=0; contremp<totremp ; contremp++){								frn.setX( getXml(xml_filtrado,"r"&contremp,"clave_reemplazo"),"tabla",contremp,"reemplazo");					frn.setX( getXml(xml_filtrado,"r"&contremp,"fecha"),"tabla",contremp,"fecha");								}							}										}	</script></pag>