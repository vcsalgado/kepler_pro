<?xml version="1.0" encoding="UTF-8"?><pag xmlns="www.kepler.com.mx/2003/KSchema" roles="" tit="Administraci&#243;n de Coaches"><grp  brdr="0,0" clr="0,58,112" fnt="Arial,16"  dim="0,0,10,12" bclr="192,205,213" unfont="0"><br/><br/><tab n="2"/>	<txt fnt=",22" clr="0,0,0">Administraci&#243;n de Coaches</txt><tab/>        <br/><tab/><hLine clr="0,0,0"/>		<br/><br/>		<tab/>        <grp  bclr="236,240,243" fntClrBrdr="236,240,243"  unfont="0" fntBrdr="Arial,18" hSpace="4" clrBrdr="0,58,112" dim="82,50,10,10" brdr="0,5" tit="Coaches" fnt="Arial,16">			<tab n="1"/><txt clr="0,58,112" hk="S">Sucursal</txt>			<cmb id="k_sucn" clr="64,64,64" clrBrdr="255,255,255"  dim="25,1" bclr="255,255,255" brdr="2,0" fnt="Arial,16" Null="N" hk="S"  available="Y"/>             <tab/>            <img id="bot" dim="20,20" bPx="Y" brdr="0,1"  img="_20_Find.png" OnEnter="Buscar()" available="Y" clrBrdr="0,0,0" visible="Y" modify="Y"/><br/>                    <tab/><tbl id="tabla" bclr="236,240,243" clr="64,64,64" clrCur="255,255,255" clrHead="0,58,112" bclrHead="236,240,243" brdr="1,0" clrBrdr="64,64,64" fnt="Arial,16" OnEnter="Exit" OnMouseD="Exit" dim="76,22" modify="N" nren="fijo">				<col id="clave" name="Clave"/>				<col id="nombre" name="Nombre"/>				<col id="usuario" name="Usuario" visible="Y"/>				<col id="status" name="Status"/>				<col id="esquema" name="Esquema" visible="Y"/>            </tbl>  <br/>            <tab n="7"/>            <bot id="k_btn_nvo" dim="10,10" brdr="5" text="Nuevo" hk="K" default="0" step="0"  OnEnter="abrir_curd(Nuevo)" fnt="Arial,16b" visible="Y"/>             <bot id="k_btn_mod" dim="10,10" brdr="5" text="Modificar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Modificar)" fnt="Arial,16b" visible="Y"/>             <bot id="k_btn_elimnr" dim="10,10" brdr="5" text="Eliminar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Eliminar)" fnt="Arial,16b" visible="N"/>             <bot id="k_btn_cons" dim="10,10" brdr="5" text="Consultar" hk="K" default="0" step="0"  OnEnter="abrir_curd(Consultar)" fnt="Arial,16b" visible="Y"/> <br/>				</grp>	</grp>	<script>		InstallDriver("KDB75");		class Main {			var frn,frP,kdb,sys,suc_usuario,perfil_usuario,asterisco ,externo,rol_usuario  ;	      var cmdQuery, cuboQuery, ok, mensajeError, suc;	        			fun Main(){				frn=new FRNT;				frP=new FRNTP;				kdb=new KDB;				sys=new SYS;				kdb.connect();					suc_usuario = frn.lib("libKepler","UserInfo(1)");				perfil_usuario = frn.lib("libKepler","UserInfo(2)");				rol_usuario = frn.config("user","role");				asterisco = "*";								ctrls_off();								Inicializa();			}						fun ctrls_off(){				frn.setAtt("k_btn_nvo", "visible", "N");				frn.setAtt("k_btn_mod", "visible", "N");				frn.setAtt("k_btn_elimnr", "visible", "N");				frn.setAtt("k_btn_cons", "visible", "N");						}            fun llena_combos(){               														//Llenar combo sucursales					var cmd = "select '['||c1||'] '||c2 as c2, c1 from keplersc.kdms";					if (rol_usuario &! "ADMINISTRADOR"  && rol_usuario &! "ADMINISTRATOR"){						cmd = cmd & " where c1='" & suc_usuario & "'";					}else {						if (suc_usuario &! asterisco && suc_usuario &! "" ){							cmd = cmd & " where c1='" & suc_usuario & "'";						}					}									var cubo = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"srvcitacrud.Inicializa()");							ok=getXmlAtt(cubo,"ok");					if(ok &! "" && !ok){						mensajeError = getXmlAtt(cubo,"native3");						mensajeError = frn.lib("libGeneral.kpl","ErrorBD",mensajeError);						frn.message(mensajeError,"Error","Aceptar");						return;					}										frn.set("k_sucn",getXml(cubo));							    }						fun Inicializa(){				externo = frn.param(0);				if (externo &! "s"){					frn.setAtt("k_btn_nvo", "visible", "Y");					frn.setAtt("k_btn_mod", "visible", "Y");					//frn.setAtt("k_btn_elimnr", "visible", "Y");					frn.setAtt("k_btn_cons", "visible", "Y");				}            llena_combos();        			}						fun Buscar() {				var xmlRequest,cmd,ok,cuboResultados,tot,cont;						suc = frn.get("k_sucn",-1,1);					cmd= "select c1,c2,c3,c4,c6 from keplersc.kdcatcoach " &					"where c5='" & suc &"'";							cuboResultados = frn.lib("libGeneral.kpl","EjecutarSqlSel",cmd,"cat_coaches_view.Buscar()");									frn.lib("libGeneral.kpl","FileSave",cuboResultados,"C:\Basura\cuboResultados");								ok=getXmlAtt(cuboResultados,"ok");				if(ok &! "" && !ok){					mensajeError = getXmlAtt(cuboResultados,"native3");					frn.message(mensajeError,"Error","Aceptar");					return;				}								tot = nXml(cuboResultados);							frn.rst("tabla");				for (cont=0; cont<tot; cont++){					frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c1"),"tabla",cont,"clave");					frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c2"),"tabla",cont,"nombre");					frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c3"),"tabla",cont,"usuario");								frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c4"),"tabla",cont,"status");						frn.setX(getXmlAtt(cuboResultados,"r"&cont,"c6"),"tabla",cont,"esquema");					}				}									fun abrir_curd(accion){				suc = frn.get("k_sucn",-1,1);					if (accion &! "Nuevo"){					var param = frn.get("tabla", -1, "clave");					if (param &= ""){						frn.message("No has seleccionado un Coach","Error","Aceptar");					}else{						frn.dialog("cat_coaches_crud",accion, param, "n",suc);					}				}else {					frn.dialog("cat_coaches_crud", accion, "x", "n",suc);				}			}					}	</script></pag>